+/* Nothing for a tick to do: no ready or worklet backlog, no worker out
+ * of its park (running / spinning), no growth episode, no park deadline,
+ * and the pool already settled to the eager cap (or pinned). Parked
+ * fibers alone do not keep sysmon ticking (the stall / deadlock
+ * diagnostics then wait for the next work). */
+static int sched_v2_quiescent(void) {
+    int n, idle;
+    if (atomic_load_explicit(&g_v2_grow_pending, memory_order_relaxed)) return 0;
+    if (atomic_load_explicit(&g_v2.ready_queue.count, memory_order_relaxed)) return 0;
+    if (atomic_load_explicit(&g_v2.worklets.count, memory_order_relaxed)) return 0;
+    if (atomic_load_explicit(&g_v2_worklets_live, memory_order_relaxed)) return 0;
+    if (atomic_load_explicit(&g_v2_running_workers, memory_order_relaxed)) return 0;
+    if (atomic_load_explicit(&g_v2_park_deadlines, memory_order_relaxed)) return 0;
+    n = atomic_load_explicit(&g_v2.num_threads, memory_order_relaxed);
+    idle = atomic_load_explicit(&g_v2.idle_workers, memory_order_relaxed);
+    if (idle > 0 && n > g_v2_eager_threads &&
+        !atomic_load_explicit(&g_v2_noblock_pool_pinned, memory_order_relaxed))
+        return 0;
+    return 1;
+}
+
+/* Wait with no timeout while quiescent. `val` is the wake word sampled
+ * before the checks, so a poke or shutdown after it returns at once.
+ * Returns 0 (without waiting) when there is work to watch. */
+static int sched_v2_sysmon_try_sleep(uint32_t val) {
+    static int off = -1;
+    if (off < 0) {
+        const char* e = getenv("CC_V2_SYSMON_SLEEP");
+        off = (e && e[0] == '0') ? 1 : 0;
+    }
+    if (off) return 0;
+    atomic_store_explicit(&g_v2_sysmon_asleep, 1, memory_order_relaxed);
+    atomic_thread_fence(memory_order_seq_cst);
+    if (!sched_v2_quiescent() ||
+        !atomic_load_explicit(&g_v2.running, memory_order_acquire)) {
+        atomic_store_explicit(&g_v2_sysmon_asleep, 0, memory_order_relaxed);
+        return 0;
+    }
+    wake_primitive_wait(&g_v2.sysmon_wake, val);
+    atomic_store_explicit(&g_v2_sysmon_asleep, 0, memory_order_relaxed);
+    return 1;
+}
