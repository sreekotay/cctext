# ThreadSanitizer suppressions for @smoke_tsan (make.shcc adds this file to
# TSAN_OPTIONS). Only reports whose racing accesses are both inside the ccc
# runtime (concurrent-c at the commit pinned in .github/workflows) belong
# here. A report with a cctext frame (core/, frontend/, tests/) on either
# access is a cctext race: fix it, do not list it.
#
# Both compiler-rt and GCC libtsan parse `race:<function>`; `fun:` / `src:`
# forms differ between them, so these are bare function names.

# --- concurrent-c scripts/tsan_fiber.supp ---------------------------------
# TSan follows OS threads, not CC fibers: nursery teardown (free / last-child
# notify / end_state load) is ordered by alive_count, which TSan does not see.
race:cc_nursery_release
race:cc_nursery_free
race:cc_nursery_last_exit
race:cc_nursery_notify_child_done
race:cc_nursery_abandon

# --- runtime lazy init ------------------------------------------------------
# runtime/nursery.c: g_nursery_timing_enabled caches getenv("CC_SPAWN_TIMING")
# on first spawn without synchronization (-1 -> 0/1, same value from every
# thread).
race:nursery_timing_enabled

# --- exclusive gate cell retire (turnstile @stage) ------------------------
# runtime/exclusive.c: the second toucher of a turnstile gate cell
# (cc__exclusive_gate_touch_done) clears the entry's name and returns it to
# the free list (cc_exclusive_mutex_free) right after its own guard release,
# while the releasing thread is still inside cc_exclusive_unlock_contended
# reading that entry's wait queue; the next cc__exclusive_install memsets
# the recycled entry against that same spin lock. Every frame is runtime.
# Reported upstream with the ASan finding below; not a cctext race.
race:cc__exclusive_gate_touch_done
race:cc_exclusive_mutex_free
race:cc__exclusive_install

# --- sched_v2 sysmon diagnostics --------------------------------------------
# sysmon's stall scan (sched_v2_diag_scan_fibers) reads fiber slots without
# the owner's lock while a worker (thread_v2_run_fiber) publishes them. Debug
# telemetry only.
race:sched_v2_diag_scan_fibers
