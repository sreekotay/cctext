# UndefinedBehaviorSanitizer suppressions for @smoke_ubsan (make.shcc adds
# this file to UBSAN_OPTIONS). Same rule as scripts/tsan.supp: only reports
# whose faulting frame is inside the ccc runtime (concurrent-c at the commit
# pinned in .github/workflows) belong here. A report in core/, frontend/ or
# tests/ is cctext UB: fix it, do not list it.
#
# Format: <check>:<source file>. The file is the report's own location
# (matched before any symbolization), so a pattern here names a ccc runtime
# source and can never cover a cctext frame.
# The build is recoverable (no -fno-sanitize-recover) with halt_on_error=1:
# the *_abort handlers Die() even when a report is suppressed.

# --- CCTask payload alignment (concurrent-c, not yet filed upstream) -------
# cc/include/ccc/cc_sched.h: `struct CCTask { CCTaskKind kind; char
# _data[124]; }` is 4-byte aligned and _data sits at offset 4, but
# runtime/task.c casts it to CCTaskFiberV2Internal / CCTaskFutureInternal /
# ... (pointer members, 8-byte alignment) via TASK_FIBER_V2() etc. Every
# @parallel spawn (cc_parallel_spawn_admit -> cc_fiber_spawn_task_v2) stores
# the fiber pointer misaligned. Harmless on x86-64 / arm64, UB by the
# standard; the fix is `_Alignas(max_align_t) char _data[...]` upstream.
alignment:ccc/runtime/task.c

# --- CCChan over-aligned struct from malloc (concurrent-c, not yet filed) --
# runtime/channel.c cc_chan_create_internal: CCChan has 128-byte aligned
# (cache-line padded) members but is allocated with plain malloc (16-byte
# aligned); every member access through the channel is then reported. The
# fix is aligned_alloc / posix_memalign upstream.
alignment:ccc/runtime/channel.c
