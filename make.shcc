#!/usr/bin/env -S ccc --as=shcc
/*
 *   ./make.shcc @              - list tasks
 *   ./make.shcc @smoke
 *   ./make.shcc @smoke_inline
 *   ./make.shcc @smoke_asan
 *   ./make.shcc @smoke_tsan
 *   ./make.shcc @cctext
 *   ./make.shcc @cctext_asan
 *   ./make.shcc @cctext_tsan
 *   ./make.shcc @cctext_prof     - release + -g + frame pointers → bin-prof/
 *   ./make.shcc @cctext_ui
 *   ./make.shcc @cctext_ui_asan
 *   ./make.shcc @cctext_ui_tsan
 *
 * Recipes live here. DEBUG=1 keeps asserts (-g); else --release.
 */

static int large(void);
static int giant(void);
static int cctext(void);
static int cctext_san(const char *san);
static int cctext_ui(void);
static int cctext_ui_san(const char *san);
static int ensure_large(void);

static void pin_lowerer(void);
static const char *ccc_flavor(void);

static void pin_lowerer(void) {
    char cwd[4096];
    char path[4600];
    /* ccc 0.4.0-415 passes --root as the compiler install. Local headers
     * then fail the clean lowerer's placement check. */
    if (!getcwd(cwd, sizeof(cwd))) return;
    snprintf(path, sizeof(path), "%s/scripts/cclower_root.py", cwd);
    setenv("CC_CLEAN_TOOL", path, 1);
}

static const char *ccc_flavor(void) {
    const char *d = getenv("DEBUG");
    pin_lowerer();
    if (d && d[0] && d[0] != '0') return "-g";
    return "--release";
}

/* build.cc is at ccc's 64-target cap; later tests are in build_tests.cc. */
static const char *build_file_of(const char *name) {
    if (!strcmp(name, "replace_smoke")) return "build_tests.cc";
    if (!strcmp(name, "replace_perf")) return "build_tests.cc";
    if (!strcmp(name, "style_cur_smoke")) return "build_tests.cc";
    if (!strcmp(name, "md_edit_smoke")) return "build_tests.cc";
    if (!strcmp(name, "md_block_smoke")) return "build_tests.cc";
    if (!strcmp(name, "slides_smoke")) return "build_tests.cc";
    if (!strcmp(name, "cmd_table_smoke")) return "build_tests.cc";
    if (!strcmp(name, "workspace_smoke")) return "build_tests.cc";
    if (!strcmp(name, "proj_smoke")) return "build_tests.cc";
    if (!strcmp(name, "lf_smoke")) return "build_tests.cc";
    if (!strcmp(name, "lf_perf")) return "build_tests.cc";
    if (!strcmp(name, "scroll_smoke")) return "build_tests.cc";
    if (!strcmp(name, "rx_perf")) return "build_tests.cc";
    if (!strcmp(name, "wb_smoke")) return "build_tests.cc";
    if (!strcmp(name, "wb_perf")) return "build_tests.cc";
    if (!strcmp(name, "rx_conform")) return "build_tests.cc";
    return "build.cc";
}

static int run_named(const char *name) {
    const char *opt = ccc_flavor();
    const char *bf = build_file_of(name);
    return cc_script_ccc(@string(`${opt} build --build-file ${bf} run ${name}`, @scratch));
}

/* Tree TU with small line-index knobs (stride / soft min / island budget)
 * so a property smoke crosses every threshold. Own out/bin dirs: the
 * objects differ from the product build. */
static int run_named_lix(const char *name) {
    const char *opt = ccc_flavor();
    return cc_script_ccc(@string(`${opt} --out-dir out-lix --bin-dir bin-lix --cc-flags '-DRTX_LINE_STRIDE=4 -DRTX_LINE_SOFT_MIN=4096 -DRTX_LINE_ISLE_BUDGET=512' build --build-file build.cc run ${name}`, @scratch));
}

static int run_named_asan(const char *name) {
    pin_lowerer();
    const char *bf = build_file_of(name);
    return cc_script_ccc(@string(`-g --out-dir out-asan --bin-dir bin-asan --cc-flags '-fsanitize=address -fno-omit-frame-pointer' --ld-flags '-fsanitize=address' build --build-file ${bf} run ${name}`, @scratch));
}

static int run_named_tsan(const char *name) {
    pin_lowerer();
    const char *bf = build_file_of(name);
    return cc_script_ccc(@string(`-g --out-dir out-tsan --bin-dir bin-tsan --cc-flags '-fsanitize=thread' --ld-flags '-fsanitize=thread' build --build-file ${bf} run ${name}`, @scratch));
}

static int smoke_asan_list(void) {
    const char *names[] = {
        "lf_smoke",
        "piece_tree_smoke",
        "utf8_cluster_smoke",
        "layout_measure_smoke",
        "relayout_smoke",
        "edit_session_smoke",
        "batch_smoke",
        "find_smoke",
        "find_opts_smoke",
        "replace_smoke",
        "style_cur_smoke",
        "md_edit_smoke",
        "scan_race_smoke",
        "host_turn_smoke",
        "draw_diff_smoke",
        "hex_view_smoke",
        "grid_view_smoke",
        "md_table_smoke",
        "md_block_smoke",
        "slides_smoke",
        "workspace_smoke",
        "safe_smoke",
        "edit_group_smoke",
        "line_index_prop_smoke",
        "line_index_file_prop_smoke",
        "rx_smoke",
        "rx_conform",
        "tm_grammar_smoke",
        "tm_rx_diff_smoke",
        "tm_lookback_probe",
        "incr_smoke",
        "scroll_smoke",
        "large_file_smoke",
        "ws_mem_smoke",
        "dup_scale_smoke",
        "key_decode_smoke",
        "term_safe_smoke",
        "browse_walk_smoke",
        "tui_pane_smoke",
        "cmd_table_smoke",
        "proj_smoke",
        "wb_smoke",
        NULL,
    };
    size_t i;
    int rc;
    for (i = 0; names[i]; i++) {
        rc = run_named_asan(names[i]);
        if (rc != 0) return rc;
    }
    return 0;
}

