#!/usr/bin/env -S ccc --as=shcc
/*
 *   ./make.shcc @              - list tasks
 *   ./make.shcc @smoke
 *   ./make.shcc @cctext
 *   ./make.shcc @cctext_ray
 *
 * Recipes live here. GNU Make is optional (`Makefile` still works).
 */

static int large(void);

static const char *ccc_flavor(void) {
    const char *d = getenv("DEBUG");
    if (d && d[0] && d[0] != '0') return "-g";
    return "--release";
}

static int ensure_large(void) {
    if (cc_script_path_exists(@slice("testdata/generated/large.txt"))) return 0;
    return large();
}

/**
 * @task Headless smokes (piece tree, layout, edit, find, large file).
 */
static int smoke() {
    int rc = ensure_large();
    if (rc != 0) return rc;
    const char *names[] = {
        "piece_tree_smoke",
        "layout_measure_smoke",
        "edit_session_smoke",
        "find_smoke",
        "tm_grammar_smoke",
        "tm_lookback_probe",
        "large_file_smoke",
        NULL,
    };
    const char *opt = ccc_flavor();
    for (size_t i = 0; names[i]; i++) {
        cc_arena_stack(scratch, 256);
        CCString line = @string(`${opt} build --build-file build.cc run ${names[i]}`, &scratch);
        rc = cc_script_ccc(line);
        if (rc != 0) return rc;
    }
    return 0;
}

/**
 * @task Same as @smoke.
 */
static int test() { return smoke(); }

/**
 * @task Write testdata/generated/large.txt (LARGE_BYTES=).
 */
static int large() {
    const char *n = getenv("LARGE_BYTES");
    if (!n || !n[0]) n = "3M";
    cc_arena_stack(scratch, 256);
    CCString line = @string(`./testdata/gen_large.sh --bytes ${n} testdata/generated/large.txt`, &scratch);
    return cc_script_sh(line);
}

/**
 * @task Build the POSIX TTY editor into bin/cctext.
 */
static int cctext() {
    const char *opt = ccc_flavor();
    cc_arena_stack(scratch, 256);
    CCString line = @string(`${opt} build --build-file build.cc cctext`, &scratch);
    return cc_script_ccc(line);
}

/**
 * @task Build the Raylib GUI into bin/cctext-ray (needs brew raylib).
 */
static int cctext_ray() {
    CCArena a = cc_arena_heap(kilobytes(4)) @destroy;
    CCString brew = @string(`brew --prefix raylib`, &a);
    CCString prefix = cc_script_sh_read_at(brew, &a) !>;
    const char *opt = ccc_flavor();
    CCString line = @string(`${opt} --cc-flags -I${prefix}/include --ld-flags '-L${prefix}/lib -lraylib -lobjc -framework Foundation -framework AppKit' build --build-file build.cc cctext_ray`, &a);
    int rc = cc_script_ccc(line);
    if (rc) return rc;
    cc_arena_stack(mv, 64);
    return cc_script_sh(@string(`mv -f bin/cctext_ray bin/cctext-ray`, &mv));
}

/**
 * @task Check ccc (and optional Raylib); generate the large fixture if missing.
 */
static int setup() {
    cc_arena_stack(scratch, 32);
    CCString line = @string(`./setup.sh`, &scratch);
    return cc_script_sh(line);
}

/**
 * @task Remove out/, bin/, and testdata/generated.
 */
static int clean() {
    cc_arena_stack(scratch, 64);
    CCString line = @string(`rm -rf out bin testdata/generated`, &scratch);
    return cc_script_sh(line);
}

"make.shcc: use @smoke, @test, @large, @cctext, @cctext_ray, @setup, @clean (or @ to list)".println() !>;
return 2;
