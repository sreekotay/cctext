/* halt_on_error=1 unless TSAN_OPTIONS says otherwise, plus
 * scripts/tsan.supp (ccc runtime-internal reports only; see that file). */
static void tsan_options(void) {
    char cwd[4096];
    char opts[8192];
    const char *cur = getenv("TSAN_OPTIONS");
    if (!cur || !cur[0]) cur = "halt_on_error=1";
    if (strstr(cur, "suppressions=") || !getcwd(cwd, sizeof(cwd))) {
        setenv("TSAN_OPTIONS", cur, 1);
        return;
    }
    snprintf(opts, sizeof(opts), "%s:suppressions=%s/scripts/tsan.supp", cur, cwd);
    setenv("TSAN_OPTIONS", opts, 1);
}

static int smoke_sanitize(const char *san) {
    int rc = ensure_large();
    if (rc != 0) return rc;
    if (!getenv("RTX_TARGETS"))
        setenv("RTX_TARGETS", "256", 0);
    if (strcmp(san, "address") == 0) {
#if defined(__APPLE__)
        setenv("ASAN_OPTIONS", "abort_on_error=1:print_legend=0:fast_unwind_on_fatal=1", 0);
#else
        setenv("ASAN_OPTIONS", "detect_leaks=1:abort_on_error=1:print_legend=0:fast_unwind_on_fatal=1", 0);
#endif
        return smoke_asan_list();
    }
    if (strcmp(san, "thread") == 0) {
        tsan_options();
        return smoke_tsan_list();
    }
    return 1;
}

static int ensure_large(void) {
    if (cc_script_path_exists(@slice("testdata/generated/large.txt"))) return 0;
    return large();
}

static const char *giant_bytes(void) {
    const char *n = getenv("GIANT_BYTES");
    if (!n || !n[0]) return "8G";
    return n;
}

static int ensure_giant(void) {
    const char *n = giant_bytes();
    if (cc_script_sh(@string(`test -f testdata/generated/large_${n}.txt`, @scratch)) == 0)
        return 0;
    return giant();
}

/**
 * @task Headless smokes (tree, utf8 clusters, layout, edit, find, scan race, hex, grid, line-index, regex, tm, large, dup-scale).
 */
static int smoke() {
    int rc = ensure_large();
    if (rc != 0) return rc;
    const char *names[] = {
        "lf_smoke",
        "piece_tree_smoke",
        "utf8_cluster_smoke",
        "layout_measure_smoke",
        "relayout_smoke",
        "edit_session_smoke",
        "batch_smoke",
        "find_smoke",
        "find_opts_smoke",
        "replace_smoke",
        "style_cur_smoke",
        "md_edit_smoke",
        "scan_race_smoke",
        "host_turn_smoke",
        "draw_diff_smoke",
        "hex_view_smoke",
        "grid_view_smoke",
        "md_table_smoke",
        "md_block_smoke",
        "slides_smoke",
        "workspace_smoke",
        "safe_smoke",
        "edit_group_smoke",
        "line_index_prop_smoke",
        "line_index_file_prop_smoke",
        "rx_smoke",
        "rx_conform",
        "tm_grammar_smoke",
        "tm_rx_diff_smoke",
        "tm_lookback_probe",
        "incr_smoke",
        "scroll_smoke",
        "large_file_smoke",
        "ws_mem_smoke",
        "dup_scale_smoke",
        "key_decode_smoke",
        "term_safe_smoke",
        "browse_walk_smoke",
        "tui_pane_smoke",
        "cmd_table_smoke",
        "proj_smoke",
        "wb_smoke",
        NULL,
    };
    size_t i;
    for (i = 0; names[i]; i++) {
        rc = run_named(names[i]);
        if (rc != 0) return rc;
    }
    return run_named_lix("line_index_file_prop_smoke");
}

/**
 * @task Same as @smoke.
 */
static int test() { return smoke(); }

/**
 * @task Headless smokes with dest-live kicks forced onto the caller
 * (RTX_PARALLEL_INLINE=1). Catches keep-after-kick / scanning races.
 */
static int smoke_inline() {
    setenv("RTX_PARALLEL_INLINE", "1", 1);
    return smoke();
}

/**
 * @task Headless smokes with AddressSanitizer (RTX_TARGETS=256 unless set).
 */
static int smoke_asan() {
    return smoke_sanitize("address");
}

/**
 * @task Headless smokes with ThreadSanitizer (RTX_TARGETS=256 unless set).
 */
static int smoke_tsan() {
    return smoke_sanitize("thread");
}

/**
 * @task Write testdata/generated/large.txt (LARGE_BYTES=).
 */
static int large() {
    const char *n = getenv("LARGE_BYTES");
    if (!n || !n[0]) n = "3M";
    return cc_script_sh(@string(`./testdata/gen_large.sh --bytes ${n} testdata/generated/large.txt`, @scratch));
}

/**
 * @task Write testdata/generated/large_8G.txt (GIANT_BYTES=; slow).
 */
static int giant() {
    const char *n = giant_bytes();
    return cc_script_sh(@string(`./testdata/gen_large.sh --bytes ${n} testdata/generated/large_${n}.txt`, @scratch));
}

/**
 * @task Write testdata/generated/large_2G.json (GIANT_JSON_BYTES=; slow).
 */
static int giant_json() {
    const char *n = getenv("GIANT_JSON_BYTES");
    if (!n || !n[0]) n = "2G";
    return cc_script_sh(@string(`./testdata/gen_large.sh --bytes ${n} --json testdata/generated/large_${n}.json`, @scratch));
}

/**
 * @task Open the 8G fixture through the page store.
 */
static int giant_smoke() {
    const char *n = giant_bytes();
    const char *opt = ccc_flavor();
    int rc = ensure_giant();
    if (rc != 0) return rc;
    return cc_script_ccc(@string(`${opt} build --build-file build.cc run giant_open_smoke -- testdata/generated/large_${n}.txt`, @scratch));
}

/**
 * @task Ops×sizes + binary/RSS table (needs large.txt; 8G if present).
 */
static int perf() {
    int rc = ensure_large();
    if (rc != 0) return rc;
    return cc_script_sh(@string(`./scripts/perf_baseline.sh`, @scratch));
}

/**
 * @task Same table and refresh testdata/perf/baseline.env pins.
 */
static int perf_record() {
    int rc = ensure_large();
    if (rc != 0) return rc;
    return cc_script_sh(@string(`./scripts/perf_baseline.sh record`, @scratch));
}

/**
 * @task Fail if 8G open/scroll/jump/insert regress (writes the 8G fixture if missing).
 */
static int perf_check() {
    int rc = ensure_giant();
    if (rc != 0) return rc;
    return cc_script_sh(@string(`./scripts/perf_baseline.sh check`, @scratch));
}

/**
 * @task Replace-all probe: RTX_PERF_MB (100) file, fox -> FOXES; time + peak RSS.
 */
static int replace_perf() {
    return run_named("replace_perf");
}

/**
 * @task Dup-scale checkpoints at 1 GiB and 8 GiB.
 */
static int dup_scale_8g() {
    int rc = ensure_large();
    if (rc != 0) return rc;
    setenv("RTX_TARGETS", "1000,8192", 1);
    setenv("RTX_DUP_ROUNDS", "24", 1);
    return run_named("dup_scale_smoke");
}

/**
 * @task Dup-scale checkpoints at 1 → 8 → 64 GiB.
 */
static int dup_scale_64g() {
    int rc = ensure_large();
    if (rc != 0) return rc;
    setenv("RTX_TARGETS", "1000,8192,65536", 1);
    setenv("RTX_DUP_ROUNDS", "24", 1);
    return run_named("dup_scale_smoke");
}

/**
 * @task Build the POSIX TTY editor into bin/cctext.
 */
static int cctext() {
    const char *opt = ccc_flavor();
#if defined(__APPLE__)
    return cc_script_ccc(@string(`${opt} --ld-flags '-framework ApplicationServices' build --build-file build.cc cctext`, @scratch));
#else
    return cc_script_ccc(@string(`${opt} build --build-file build.cc cctext`, @scratch));
#endif
}

/**
 * @task Profiling build: release (-O2 -DNDEBUG) + -g + frame pointers → bin-prof/cctext (PROF_TARGET=find_perf etc.).
 */
static int cctext_prof() {
    const char *t = getenv("PROF_TARGET");
    const char *bf;
    if (!t || !t[0]) t = "cctext";
    bf = build_file_of(t);
    pin_lowerer();
    /* perf record -g walks frame pointers; own out/bin: the objects differ. */
#if defined(__APPLE__)
    return cc_script_ccc(@string(`--release --out-dir out-prof --bin-dir bin-prof --cc-flags '-g -fno-omit-frame-pointer' --ld-flags '-framework ApplicationServices' build --build-file ${bf} ${t}`, @scratch));
#else
    return cc_script_ccc(@string(`--release --out-dir out-prof --bin-dir bin-prof --cc-flags '-g -fno-omit-frame-pointer' build --build-file ${bf} ${t}`, @scratch));
#endif
}

/* Same out/bin split as @smoke_asan / @smoke_tsan. ASAN and TSAN cannot share objects. */
static int cctext_san(const char *san) {
    const char *ccflags;
    const char *ldsan;
    const char *outdir;
    const char *bindir;
    pin_lowerer();
    if (san && strcmp(san, "thread") == 0) {
        ccflags = "-fsanitize=thread";
        ldsan = "-fsanitize=thread";
        outdir = "out-tsan";
        bindir = "bin-tsan";
    } else {
        ccflags = "-fsanitize=address -fno-omit-frame-pointer";
        ldsan = "-fsanitize=address";
        outdir = "out-asan";
        bindir = "bin-asan";
    }
#if defined(__APPLE__)
    return cc_script_ccc(@string(`-g --out-dir ${outdir} --bin-dir ${bindir} --cc-flags '${ccflags}' --ld-flags '${ldsan} -framework ApplicationServices' build --build-file build.cc cctext`, @scratch));
#else
    return cc_script_ccc(@string(`-g --out-dir ${outdir} --bin-dir ${bindir} --cc-flags '${ccflags}' --ld-flags '${ldsan}' build --build-file build.cc cctext`, @scratch));
#endif
}

/**
 * @task AddressSanitizer cctext → bin-asan/cctext.
 */
static int cctext_asan() {
    return cctext_san("address");
}

/**
 * @task ThreadSanitizer cctext → bin-tsan/cctext.
 */
static int cctext_tsan() {
    return cctext_san("thread");
}

/**
 * @task Binary + grammars/ → dist/cctext-<os>-<arch>.tar.gz (cctext + cctext-ui; NO_UI=1 skips the GUI).
 */
static int dist_cctext() {
    const char *no_ui = getenv("NO_UI");
    int rc = cctext();
    if (rc != 0) return rc;
    if (!(no_ui && no_ui[0] && no_ui[0] != '0')) {
        rc = cctext_ui();
        if (rc != 0) return rc;
    }
    return cc_script_sh(@string(`./scripts/dist_cctext.sh`, @scratch));
}

/*
 * cctext-ui: libui-ng + ui_plat.c (portable) + one ui_os_* shim.
 *   macOS: ui_os_darwin.m, AppKit frameworks.
 *   Linux: ui_os_gtk.c, GTK 3 via pkg-config (libgtk-3-dev, meson, ninja).
 * libui and the platform objects are outside ccc, so they take `cflags`
 * into `outdir`; a sanitizer build must not link a normal out/libui.a.
 * The GTK link line needs $(pkg-config …), so Linux runs ccc under sh.
 */
static int cctext_ui_build(const char *ccopt, const char *cflags,
                           const char *ccsan, const char *ldsan,
                           const char *outdir, const char *bindir) {
    int rc;
    rc = cc_script_sh(@string(`mkdir -p ${outdir} ${bindir}`, @scratch));
    if (rc) return rc;
    rc = cc_script_sh(@string(`env 'COPT=${cflags}' OUTDIR=${outdir} ./scripts/build_libui.sh`, @scratch));
    if (rc) return rc;
#if defined(__APPLE__)
    rc = cc_script_sh(@string(`clang ${cflags} -Ifrontend -Ithird_party/libui-ng -c frontend/ui_plat.c -o ${outdir}/ui_plat.o`, @scratch));
    if (rc) return rc;
    rc = cc_script_sh(@string(`clang ${cflags} -fobjc-arc -Ifrontend -Ithird_party/libui-ng -c frontend/ui_os_darwin.m -o ${outdir}/ui_os.o`, @scratch));
    if (rc) return rc;
    rc = cc_script_ccc(@string(`${ccopt} --out-dir ${outdir} --bin-dir ${bindir} --cc-flags '-Ifrontend ${ccsan}' --ld-flags '${ldsan} ${outdir}/ui_plat.o ${outdir}/ui_os.o ${outdir}/libui.a -lobjc -framework Cocoa -framework QuartzCore -framework CoreText -framework CoreGraphics -framework Foundation' build --build-file build.cc cctext_ui`, @scratch));
    if (rc) return rc;
#else
    const char *ccc = getenv("CCC");
    if (!ccc || !ccc[0]) ccc = "ccc";
    rc = cc_script_sh(@string(`cc ${cflags} -Ifrontend -Ithird_party/libui-ng -c frontend/ui_plat.c -o ${outdir}/ui_plat.o`, @scratch));
    if (rc) return rc;
    rc = cc_script_sh(@string(`sh -c 'cc ${cflags} -Ifrontend -Ithird_party/libui-ng $(pkg-config --cflags gtk+-3.0) -c frontend/ui_os_gtk.c -o ${outdir}/ui_os.o'`, @scratch));
    if (rc) return rc;
    rc = cc_script_sh(@string(`sh -c '${ccc} ${ccopt} --out-dir ${outdir} --bin-dir ${bindir} --cc-flags "-Ifrontend ${ccsan}" --ld-flags "${ldsan} ${outdir}/ui_plat.o ${outdir}/ui_os.o ${outdir}/libui.a $(pkg-config --libs gtk+-3.0) -lm -ldl" build --build-file build.cc cctext_ui'`, @scratch));
    if (rc) return rc;
#endif
    return cc_script_sh(@string(`mv -f ${bindir}/cctext_ui ${bindir}/cctext-ui`, @scratch));
}

/**
 * @task Build the libui-ng GUI into bin/cctext-ui (macOS: AppKit; Linux: GTK 3).
 */
static int cctext_ui() {
    const char *opt = ccc_flavor();
    const char *copt = (opt[0] == '-' && opt[1] == 'g') ? "-g" : "-O2";
    return cctext_ui_build(opt, copt, "", "", "out", "bin");
}

static int cctext_ui_san(const char *san) {
    const char *ccflags;
    const char *cflags;
    const char *ldsan;
    const char *outdir;
    const char *bindir;
    pin_lowerer();
    if (san && strcmp(san, "thread") == 0) {
        ccflags = "-fsanitize=thread";
        cflags = "-g -fsanitize=thread";
        ldsan = "-fsanitize=thread";
        outdir = "out-tsan";
        bindir = "bin-tsan";
    } else {
        ccflags = "-fsanitize=address -fno-omit-frame-pointer";
        cflags = "-g -fsanitize=address -fno-omit-frame-pointer";
        ldsan = "-fsanitize=address";
        outdir = "out-asan";
        bindir = "bin-asan";
    }
    return cctext_ui_build("-g", cflags, ccflags, ldsan, outdir, bindir);
}

/**
 * @task AddressSanitizer cctext-ui → bin-asan/cctext-ui.
 */
static int cctext_ui_asan() {
    return cctext_ui_san("address");
}

/**
 * @task ThreadSanitizer cctext-ui → bin-tsan/cctext-ui.
 */
static int cctext_ui_tsan() {
    return cctext_ui_san("thread");
}

/**
 * @task Check ccc; generate the large fixture if missing.
 */
static int setup() {
    return cc_script_sh(@string(`./setup.sh`, @scratch));
}

/**
 * @task Remove build outputs: out/, bin/, out-lix/, bin-lix/, dist/. Leaves testdata/generated.
 */
static int clean() {
    return cc_script_sh(@string(`rm -rf out bin out-asan bin-asan out-tsan bin-tsan out-lix bin-lix out-prof bin-prof dist`, @scratch));
}

"make.shcc: use @smoke, @smoke_asan, @smoke_tsan, @test, @large, @giant, @giant_json, @giant_smoke, @perf, @perf_record, @perf_check, @dup_scale_8g, @dup_scale_64g, @cctext, @cctext_asan, @cctext_tsan, @cctext_prof, @cctext_ui, @cctext_ui_asan, @cctext_ui_tsan, @dist_cctext, @setup, @clean (or @ to list)".println();
return 2;
