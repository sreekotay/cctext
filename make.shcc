    const char *names[] = {
        "lf_smoke",
        "piece_tree_smoke",
        "utf8_cluster_smoke",
        "layout_measure_smoke",
        "relayout_smoke",
        "edit_session_smoke",
        "batch_smoke",
        "find_smoke",
        "find_opts_smoke",
        "replace_smoke",
        "style_cur_smoke",
        "md_edit_smoke",
        "scan_race_smoke",
        "host_turn_smoke",
        "draw_diff_smoke",
        "hex_view_smoke",
        "grid_view_smoke",
        "md_table_smoke",
        "md_block_smoke",
        "slides_smoke",
        "workspace_smoke",
        "safe_smoke",
        "edit_group_smoke",
        "line_index_prop_smoke",
        "line_index_file_prop_smoke",
        "rx_smoke",
        "rx_conform",
        "tm_grammar_smoke",
        "tm_rx_diff_smoke",
        "tm_lookback_probe",
        "incr_smoke",
