#!/usr/bin/env -S ccc --as=shcc
/*
 *   ./make.shcc @              - list tasks
 *   ./make.shcc @smoke
 *   ./make.shcc @smoke_inline
 *   ./make.shcc @smoke_asan
 *   ./make.shcc @smoke_tsan
 *   ./make.shcc @cctext
 *   ./make.shcc @cctext_gui
 *
 * Recipes live here. DEBUG=1 keeps asserts (-g); else --release.
 */

static int large(void);
static int giant(void);
static int cctext(void);
static int cctext_gui(void);
static int ensure_large(void);

static const char *ccc_flavor(void) {
    const char *d = getenv("DEBUG");
    if (d && d[0] && d[0] != '0') return "-g";
    return "--release";
}

static int run_named(const char *name) {
    const char *opt = ccc_flavor();
    return cc_script_ccc(@string(`${opt} build --build-file build.cc run ${name}`, @scratch));
}

static int run_named_asan(const char *name) {
    return cc_script_ccc(@string(`-g --out-dir out-asan --bin-dir bin-asan --cc-flags '-fsanitize=address -fno-omit-frame-pointer' --ld-flags '-fsanitize=address' build --build-file build.cc run ${name}`, @scratch));
}

static int run_named_tsan(const char *name) {
    return cc_script_ccc(@string(`-g --out-dir out-tsan --bin-dir bin-tsan --cc-flags '-fsanitize=thread' --ld-flags '-fsanitize=thread' build --build-file build.cc run ${name}`, @scratch));
}

static int smoke_asan_list(void) {
    const char *names[] = {
        "piece_tree_smoke",
        "layout_measure_smoke",
        "edit_session_smoke",
        "batch_smoke",
        "find_smoke",
        "hex_view_smoke",
        "grid_view_smoke",
        "safe_smoke",
        "line_index_prop_smoke",
        "tm_grammar_smoke",
        "tm_lookback_probe",
        "large_file_smoke",
        "dup_scale_smoke",
        NULL,
    };
    size_t i;
    int rc;
    for (i = 0; names[i]; i++) {
        rc = run_named_asan(names[i]);
        if (rc != 0) return rc;
    }
    return 0;
}

static int smoke_tsan_list(void) {
    const char *names[] = {
        "piece_tree_smoke",
        "layout_measure_smoke",
        "edit_session_smoke",
        "batch_smoke",
        "find_smoke",
        "hex_view_smoke",
        "grid_view_smoke",
        "safe_smoke",
        "line_index_prop_smoke",
        "tm_grammar_smoke",
        "tm_lookback_probe",
        "large_file_smoke",
        "dup_scale_smoke",
        NULL,
    };
    size_t i;
    int rc;
    for (i = 0; names[i]; i++) {
        rc = run_named_tsan(names[i]);
        if (rc != 0) return rc;
    }
    return 0;
}

static int smoke_sanitize(const char *san) {
    int rc = ensure_large();
    if (rc != 0) return rc;
    if (!getenv("RTX_TARGETS"))
        setenv("RTX_TARGETS", "256", 0);
    if (strcmp(san, "address") == 0) {
#if defined(__APPLE__)
        setenv("ASAN_OPTIONS", "abort_on_error=1:print_legend=0", 0);
#else
        setenv("ASAN_OPTIONS", "detect_leaks=1:abort_on_error=1:print_legend=0", 0);
#endif
        return smoke_asan_list();
    }
    if (strcmp(san, "thread") == 0) {
        setenv("TSAN_OPTIONS", "halt_on_error=1", 0);
        return smoke_tsan_list();
    }
    return 1;
}

static int ensure_large(void) {
    if (cc_script_path_exists(@slice("testdata/generated/large.txt"))) return 0;
    return large();
}

static const char *giant_bytes(void) {
    const char *n = getenv("GIANT_BYTES");
    if (!n || !n[0]) return "8G";
    return n;
}

static int ensure_giant(void) {
    const char *n = giant_bytes();
    if (cc_script_sh(@string(`test -f testdata/generated/large_${n}.txt`, @scratch)) == 0)
        return 0;
    return giant();
}

/**
 * @task Headless smokes (tree, layout, edit, find, hex, grid, line-index, tm, large, dup-scale).
 */
static int smoke() {
    int rc = ensure_large();
    if (rc != 0) return rc;
    const char *names[] = {
        "piece_tree_smoke",
        "layout_measure_smoke",
        "edit_session_smoke",
        "batch_smoke",
        "find_smoke",
        "hex_view_smoke",
        "grid_view_smoke",
        "safe_smoke",
        "line_index_prop_smoke",
        "tm_grammar_smoke",
        "tm_lookback_probe",
        "large_file_smoke",
        "dup_scale_smoke",
        NULL,
    };
    size_t i;
    for (i = 0; names[i]; i++) {
        rc = run_named(names[i]);
        if (rc != 0) return rc;
    }
    return 0;
}

/**
 * @task Same as @smoke.
 */
static int test() { return smoke(); }

/**
 * @task Headless smokes with dest-live kicks forced onto the caller
 * (RTX_PARALLEL_INLINE=1). Catches keep-after-kick / scanning races.
 */
static int smoke_inline() {
    setenv("RTX_PARALLEL_INLINE", "1", 1);
    return smoke();
}

/**
 * @task Headless smokes with AddressSanitizer (RTX_TARGETS=256 unless set).
 */
static int smoke_asan() {
    return smoke_sanitize("address");
}

/**
 * @task Headless smokes with ThreadSanitizer (RTX_TARGETS=256 unless set).
 */
static int smoke_tsan() {
    return smoke_sanitize("thread");
}

/**
 * @task Write testdata/generated/large.txt (LARGE_BYTES=).
 */
static int large() {
    const char *n = getenv("LARGE_BYTES");
    if (!n || !n[0]) n = "3M";
    return cc_script_sh(@string(`./testdata/gen_large.sh --bytes ${n} testdata/generated/large.txt`, @scratch));
}

/**
 * @task Write testdata/generated/large_8G.txt (GIANT_BYTES=; slow).
 */
static int giant() {
    const char *n = giant_bytes();
    return cc_script_sh(@string(`./testdata/gen_large.sh --bytes ${n} testdata/generated/large_${n}.txt`, @scratch));
}

/**
 * @task Write testdata/generated/large_2G.json (GIANT_JSON_BYTES=; slow).
 */
static int giant_json() {
    const char *n = getenv("GIANT_JSON_BYTES");
    if (!n || !n[0]) n = "2G";
    return cc_script_sh(@string(`./testdata/gen_large.sh --bytes ${n} --json testdata/generated/large_${n}.json`, @scratch));
}

/**
 * @task Open the 8G fixture through the page store.
 */
static int giant_smoke() {
    const char *n = giant_bytes();
    const char *opt = ccc_flavor();
    int rc = ensure_giant();
    if (rc != 0) return rc;
    return cc_script_ccc(@string(`${opt} build --build-file build.cc run giant_open_smoke -- testdata/generated/large_${n}.txt`, @scratch));
}

/**
 * @task Ops×sizes + binary/RSS table (needs large.txt; 8G if present).
 */
static int perf() {
    int rc = ensure_large();
    if (rc != 0) return rc;
    return cc_script_sh(@string(`./scripts/perf_baseline.sh`, @scratch));
}

/**
 * @task Same table and refresh testdata/perf/baseline.env pins.
 */
static int perf_record() {
    int rc = ensure_large();
    if (rc != 0) return rc;
    return cc_script_sh(@string(`./scripts/perf_baseline.sh record`, @scratch));
}

/**
 * @task Fail if 8G open/scroll/jump/insert regress (writes the 8G fixture if missing).
 */
static int perf_check() {
    int rc = ensure_giant();
    if (rc != 0) return rc;
    return cc_script_sh(@string(`./scripts/perf_baseline.sh check`, @scratch));
}

/**
 * @task Dup-scale checkpoints at 1 GiB and 8 GiB.
 */
static int dup_scale_8g() {
    int rc = ensure_large();
    if (rc != 0) return rc;
    setenv("RTX_TARGETS", "1000,8192", 1);
    setenv("RTX_DUP_ROUNDS", "24", 1);
    return run_named("dup_scale_smoke");
}

/**
 * @task Dup-scale checkpoints at 1 → 8 → 64 GiB.
 */
static int dup_scale_64g() {
    int rc = ensure_large();
    if (rc != 0) return rc;
    setenv("RTX_TARGETS", "1000,8192,65536", 1);
    setenv("RTX_DUP_ROUNDS", "24", 1);
    return run_named("dup_scale_smoke");
}

/**
 * @task Build the POSIX TTY editor into bin/cctext.
 */
static int cctext() {
    const char *opt = ccc_flavor();
#if defined(__APPLE__)
    return cc_script_ccc(@string(`${opt} --ld-flags '-framework ApplicationServices' build --build-file build.cc cctext`, @scratch));
#else
    return cc_script_ccc(@string(`${opt} build --build-file build.cc cctext`, @scratch));
#endif
}

/**
 * @task Binary + grammars/ → dist/cctext-<os>-<arch>.tar.gz (macOS also packs cctext-gui).
 */
static int dist_cctext() {
    int rc = cctext();
    if (rc != 0) return rc;
#if defined(__APPLE__)
    rc = cctext_gui();
    if (rc != 0) return rc;
#endif
    return cc_script_sh(@string(`./scripts/dist_cctext.sh`, @scratch));
}

/**
 * @task Build the Cocoa+CoreText GUI into bin/cctext-gui (macOS).
 */
static int cctext_gui() {
#if !defined(__APPLE__)
    "cctext-gui is macOS-only (Cocoa + Core Text)".println();
    return 1;
#else
    const char *opt = ccc_flavor();
    const char *copt = (opt[0] == '-' && opt[1] == 'g') ? "-g" : "-O2";
    int rc;
    rc = cc_script_sh(@string(`mkdir -p out bin`, @scratch));
    if (rc) return rc;
    rc = cc_script_sh(@string(`clang ${copt} -fobjc-arc -Ifrontend -c frontend/gui_plat.m -o out/gui_plat.o`, @scratch));
    if (rc) return rc;
    rc = cc_script_ccc(@string(`${opt} --cc-flags '-Ifrontend' --ld-flags 'out/gui_plat.o -lobjc -framework Cocoa -framework CoreText -framework CoreGraphics -framework Foundation' build --build-file build.cc cctext_gui`, @scratch));
    if (rc) return rc;
    return cc_script_sh(@string(`mv -f bin/cctext_gui bin/cctext-gui`, @scratch));
#endif
}

/**
 * @task Check ccc; generate the large fixture if missing.
 */
static int setup() {
    return cc_script_sh(@string(`./setup.sh`, @scratch));
}

/**
 * @task Remove build outputs: out/, bin/, dist/. Leaves testdata/generated.
 */
static int clean() {
    return cc_script_sh(@string(`rm -rf out bin out-asan bin-asan out-tsan bin-tsan dist`, @scratch));
}

"make.shcc: use @smoke, @smoke_asan, @smoke_tsan, @test, @large, @giant, @giant_json, @giant_smoke, @perf, @perf_record, @perf_check, @dup_scale_8g, @dup_scale_64g, @cctext, @cctext_gui, @dist_cctext, @setup, @clean (or @ to list)".println();
return 2;
