#!/usr/bin/env -S ccc --as=shcc
/*
 *   ./make.shcc @              - list tasks
 *   ./make.shcc @smoke
 *   ./make.shcc @cctext
 *
 * Recipes live here. GNU Make is optional (`Makefile` still works).
 */

static int large(void);

static int ensure_large(void) {
    if (cc_script_path_exists(@slice("testdata/generated/large.txt"))) return 0;
    return large();
}

/**
 * @task Headless smokes (piece tree, layout, edit, find, large file).
 */
static int smoke() {
    int rc = ensure_large();
    if (rc != 0) return rc;
    const char *names[] = {
        "piece_tree_smoke",
        "layout_measure_smoke",
        "edit_session_smoke",
        "find_smoke",
        "large_file_smoke",
        NULL,
    };
    for (size_t i = 0; names[i]; i++) {
        CCString line = @string(`build --build-file build.cc run ${names[i]}`, @scratch);
        rc = cc_script_ccc(line);
        if (rc != 0) return rc;
    }
    return 0;
}

/**
 * @task Same as @smoke.
 */
static int test() { return smoke(); }

/**
 * @task Write testdata/generated/large.txt (LARGE_LINES=).
 */
static int large() {
    const char *n = getenv("LARGE_LINES");
    if (!n || !n[0]) n = "100000";
    CCString line = @string(`./testdata/gen_large.sh ${n} testdata/generated/large.txt`, @scratch);
    return cc_script_sh(line);
}

/**
 * @task Build the POSIX TTY editor into bin/cctext.
 */
static int cctext() {
    CCString line = @string(`build --build-file build.cc cctext`, @scratch);
    return cc_script_ccc(line);
}

/**
 * @task Build the Raylib GUI into bin/raytext (needs brew raylib).
 */
static int raytext() {
    CCArena a = cc_arena_heap(kilobytes(4)) @destroy;
    CCString brew = @string(`brew --prefix raylib`, &a);
    CCString prefix = cc_script_sh_read_at(brew, &a) !>;
    CCString line = @string(`--cc-flags -I${prefix}/include --ld-flags '-L${prefix}/lib -lraylib -lobjc -framework Foundation' build --build-file build.cc raytext`, &a);
    return cc_script_ccc(line);
}

/**
 * @task Check ccc (and optional Raylib); generate the large fixture if missing.
 */
static int setup() {
    CCString line = @string(`./setup.sh`, @scratch);
    return cc_script_sh(line);
}

/**
 * @task Remove out/, bin/, and testdata/generated.
 */
static int clean() {
    CCString line = @string(`rm -rf out bin testdata/generated`, @scratch);
    return cc_script_sh(line);
}

"make.shcc: use @smoke, @test, @large, @cctext, @raytext, @setup, @clean (or @ to list)".println() !>;
return 2;
