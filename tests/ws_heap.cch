/* Test helper: an RtxWs on the heap.
 *
 * RtxWs is ~400 KiB (eight browse-preview panes, each with a staging and a
 * shown RtxDoc). A smoke that declares one per case block in main() piles
 * them up in one frame: at -O0 the blocks do not share stack slots, and
 * under ASan (use-after-scope redzones) safe_smoke's main needed ~28 MiB
 * and overflowed the 8 MiB main stack. Case blocks write
 *
 *     RtxWsHeap w_h = rtx_ws_heap() @destroy;
 *     RtxWs *w = w_h.p;
 *
 * and scope exit runs RtxWs_destroy + free, as `RtxWs w = {0} @destroy`
 * did. */
#ifndef RTX_TESTS_WS_HEAP_CCH
#define RTX_TESTS_WS_HEAP_CCH

#include <stdio.h>
#include <stdlib.h>
#include "../core/workspace.cch"

typedef struct {
    RtxWs *p;
} RtxWsHeap;

static inline RtxWsHeap rtx_ws_heap(void) {
    RtxWsHeap h;
    h.p = (RtxWs *)calloc(1, sizeof(RtxWs));
    if (!h.p) {
        fprintf(stderr, "rtx_ws_heap: out of memory\n");
        abort();
    }
    return h;
}

static inline void RtxWsHeap_destroy(RtxWsHeap *h) {
    if (!h || !h->p) return;
    RtxWs_destroy(h->p);
    free(h->p);
    h->p = NULL;
}

#endif
