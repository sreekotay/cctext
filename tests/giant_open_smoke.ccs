#!ccc ccs
/*
 * Open a multi-GiB on-disk fixture through the page store.
 * Open, first screen, mid jump, and edits must stay cheap (progressive index).
 * Edits must not finish a full-file newline scan / suffix rebuild.
 *
 *   make giant && make giant-smoke
 */
#include <ccc/std/prelude.cch>
#include <ccc/script/stdio.cch>
#include <stdio.h>
#include <string.h>
#include <time.h>
#include <unistd.h>
#include "../core/document.cch"

static int fails = 0;

static void expect(int cond, const char *msg) {
    if (!cond) {
        fprintf(stderr, "FAIL: %s\n", msg);
        fails++;
    }
}

static double mono_ms(void) {
    struct timespec ts;
    if (clock_gettime(CLOCK_MONOTONIC, &ts) != 0) return 0.0;
    return (double)ts.tv_sec * 1000.0 + (double)ts.tv_nsec / 1.0e6;
}

int main(int argc, char **argv) {
    const char *src = "testdata/generated/large_8G.txt";
    RtxDoc d = {0} @destroy;
    size_t n, mid_off, screen;
    char buf[64];
    size_t got, i;
    char mark = 'Z';
    char nl = '\n';
    double t0, open_ms, screen_ms, jump_ms, edit_ms, nl_ms;

    screen = 40;

    if (argc > 1) src = argv[1];
    if (access(src, R_OK) != 0) {
        fprintf(stderr, "giant_open_smoke: missing %s (run: make giant)\n", src);
        return 1;
    }

    @errhandler(CCError e) {
        fprintf(stderr, "giant_open_smoke: %s\n", e.message ? e.message : "?");
        return 1;
    }

    t0 = mono_ms();
    d.from_path(src) !>;
    open_ms = mono_ms() - t0;
    n = d.len();
    expect(n >= (size_t)8 * 1024 * 1024 * 1024, "at least 8 GiB");
    expect(d.tree.store.orig_open, "page-store original");
    expect(!d.tree.lf_ready, "lf deferred at open");
    expect(open_ms < 500.0, "open under 500ms");
    printf("  open       %8.3f ms  bytes=%zu  lf_ready=%d\n", open_ms, n,
           d.tree.lf_ready);

    t0 = mono_ms();
    expect(d.line_count() > screen, "soft line_count");
    for (i = 0; i <= screen; i++) {
        size_t a = d.line_start(i);
        expect(a < n || i == 0, "screen line_start");
        (void)a;
    }
    screen_ms = mono_ms() - t0;
    expect(!d.tree.lf_ready, "still progressive after first screen");
    expect(screen_ms < 200.0, "first screen under 200ms");
    printf("  screen     %8.3f ms  scan_line=%zu\n", screen_ms, d.tree.scan_line);

    t0 = mono_ms();
    mid_off = d.line_start(100000);
    jump_ms = mono_ms() - t0;
    expect(mid_off > 0 && mid_off < n, "jump line");
    expect(d.line_of(mid_off) == 100000, "line_of jump");
    printf("  jump100k   %8.3f ms  off=%zu\n", jump_ms, mid_off);

    got = d.read_at(mid_off, buf, 1) !>;
    expect(got == 1, "mid read");

    t0 = mono_ms();
    d.insert(mid_off, cc_slice_from_buffer(&mark, 1)) !>;
    edit_ms = mono_ms() - t0;
    expect(d.len() == n + 1, "insert grew");
    expect(!d.tree.lf_ready, "insert keeps progressive");
    expect(edit_ms < 500.0, "insert under 500ms");
    got = d.read_at(mid_off, buf, 1) !>;
    expect(got == 1 && buf[0] == 'Z', "mid insert readable");
    printf("  insert     %8.3f ms  lf_ready=%d\n", edit_ms, d.tree.lf_ready);

    t0 = mono_ms();
    d.insert(mid_off + 1, cc_slice_from_buffer(&nl, 1)) !>;
    nl_ms = mono_ms() - t0;
    expect(!d.tree.lf_ready, "newline keeps progressive");
    expect(nl_ms < 500.0, "newline under 500ms");
    printf("  newline    %8.3f ms\n", nl_ms);

    printf("PERF open_ms=%.3f screen_ms=%.3f jump100k_ms=%.3f insert_ms=%.3f "
           "newline_ms=%.3f bytes=%zu\n",
           open_ms, screen_ms, jump_ms, edit_ms, nl_ms, d.len());
    printf("giant_open_smoke ok  path=%s\n", src);
    fflush(stdout);
    return fails ? 1 : 0;
}
