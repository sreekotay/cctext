#!ccc ccs
/*
 * Markdown block pass (core/md_block.ccs) and the lex that plants it.
 *
 * 1. CommonMark 0.31 / GFM spec examples, per construct: each line's
 *    class from rtx_mdb_line, as a signature — containers open after the
 *    line (`q` quote, `l` list item), `+` per list marker on the line, `^`
 *    when a leaf ended at the line's start, then the leaf: B blank, P
 *    paragraph, Z lazy continuation, H1-H6 ATX, S1/S2 setext underline,
 *    T thematic break, F / f / E fence open / body / close, I indented
 *    code, M HTML block, $ math, Y front matter, R link definition, N
 *    footnote definition, D / W table delimiter row / body row. A `gap`
 *    row is the spec's answer the pass does not give yet: it is printed,
 *    counted, and does not fail.
 * 2. The Markdown lex over documents: runs, hints, guests, outline.
 * 3. A window lex over > RTX_HL_FULL_MAX bytes whose fence opened above
 *    the lookback: the anchor finds it, and without one the window is
 *    leftover text — never prose painted as code.
 */
#include <ccc/std/prelude.cch>
#include <ccc/stdio.cch>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include "../core/document.cch"
#include "../core/md_block.cch"

static int fails = 0;

static void expect(int cond, const char *msg) {
    if (!cond) {
        fprintf(stderr, "FAIL: %s\n", msg);
        fails++;
    }
}

typedef struct {
    const char *what; /* construct */
    const char *id;   /* spec example */
    const char *md;
    const char *want;
    int gap;          /* known miss: printed, not failed */
} MdbCase;

