#!ccc ccs
/*
 * Incremental find: all hits, one wave per step, invalidate on edit.
 */
#include <ccc/std/prelude.cch>
#include <ccc/script/stdio.cch>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include "../core/document.cch"
#include "../core/layout.cch"
#include "../core/workspace.cch"
#include "../core/find.cch"
#include "../core/ui.cch"
#include "../core/browse.cch"

static int fails = 0;

static void expect(int cond, const char *msg) {
    if (!cond) {
        fprintf(stderr, "FAIL: %s\n", msg);
        fails++;
    }
}

int main(void) {
    @errhandler(CCError e) { cc_error_log(e); return 1; }

    {
        RtxDoc d = {0} @destroy;
        d.from_buffer("alpha\nbeta\nalpha\ngamma alpha\n") !>;
        d.find_set("alpha") !>;
        d.find_step(RTX_FIND_BUDGET) !>;
        expect(d.find.done, "small scan done");
        expect(d.find.len == 3, "three alpha");
        expect(!d.find.truncated, "not capped");
        d.find_goto(1);
        expect(d.caret == 11, "second alpha offset");
        expect(d.sel_anchor == 16, "selects the hit");
        d.find_next();
        expect(d.find.cur == 2, "wrap next");
        d.find_next();
        expect(d.find.cur == 0, "wrap to first");
        d.find_prev();
        expect(d.find.cur == 2, "wrap prev");
    }

    {
        RtxDoc d = {0} @destroy;
        d.from_buffer("aaa") !>;
        d.find_set("aa") !>;
        d.find_step(RTX_FIND_BUDGET) !>;
        expect(d.find.done && d.find.len == 2, "overlapping aa in aaa");
        expect(d.find.offs[0] == 0 && d.find.offs[1] == 1, "overlap offsets");
    }

    {
        RtxDoc d = {0} @destroy;
        d.from_buffer("hello") !>;
        d.find_set("") !>;
        expect(d.find.done && d.find.len == 0, "empty query");
        d.find_set("nope") !>;
        d.find_step(RTX_FIND_BUDGET) !>;
        expect(d.find.done && d.find.len == 0, "no matches");
    }

    {
        RtxDoc d = {0} @destroy;
        d.from_buffer("xx y xx y xx\n") !>;
        d.find_set("xx") !>;
        d.find_step(RTX_FIND_BUDGET) !>;
        expect(d.find.len == 3, "three xx");
        d.caret = 0;
        d.sel_anchor = 0;
        d.type("z") !>;
        expect(d.find.len == 0 && !d.find.done, "invalidate on type");
        expect(d.find.query.len == 2, "query kept");
        d.find_step(RTX_FIND_BUDGET) !>;
        expect(d.find.done && d.find.len == 3, "rescan after edit");
        expect(d.find.offs[0] == 1, "hits shifted");
    }

    {
        RtxDoc d = {0} @destroy;
        cc_arena_stack(scratch, RTX_FRAME_SCRATCH);
        RtxFindHitView v;
        d.from_buffer("one match here\n") !>;
        d.find_set("match") !>;
        d.find_step(RTX_FIND_BUDGET) !>;
        expect(d.find.len == 1, "one match");
        d.find_hit_view(0, &scratch, 40, &v) !>;
        expect(v.line1 == 1, "context line");
        expect(v.col == 4, "match col in line");
        expect(v.ctx.len >= 5, "context bytes");
    }

    /* Default budget is the ordered parallel loop (one ticket per block). */
    {
        RtxDoc d = {0} @destroy;
        size_t n = (size_t)RTX_FIND_BLOCK + 64;
        CCArena body = cc_arena_heap(n + 64) @destroy;
        char[:] big;
        big = body.alloc_slice_bytes(n);
        expect(big.ptr != NULL && big.len >= n, "parallel find arena");
        if (big.ptr && big.len >= n) {
            memset(big.ptr, 'x', n);
            memcpy(big.ptr + (size_t)RTX_FIND_BLOCK + 8, "needle", 6);
            d.from_buffer(big) !>;
            d.find_set("needle") !>;
            d.find_step(RTX_FIND_BUDGET) !>;
            expect(d.find.done, "parallel scan done");
            expect(d.find.len == 1, "one needle in second block");
            expect(d.find.offs[0] == (size_t)RTX_FIND_BLOCK + 8, "hit at block+8");
        }
    }

    /* A wave commits; host cancel is a written bit, not a body poll. */
    {
        RtxDoc d = {0} @destroy;
        size_t n = 4 * (size_t)RTX_FIND_WAVE * (size_t)RTX_FIND_BLOCK + 64;
        CCArena body = cc_arena_heap(n + 64) @destroy;
        char[:] big;
        size_t got;
        big = body.alloc_slice_bytes(n);
        expect(big.ptr != NULL && big.len >= n, "wave find arena");
        if (big.ptr && big.len >= n) {
            memset(big.ptr, 'x', n);
            memcpy(big.ptr + (size_t)RTX_FIND_WAVE * (size_t)RTX_FIND_BLOCK,
                   "needle", 6);
            d.from_buffer(big) !>;
            d.find_set("needle") !>;
            got = d.find_step(RTX_FIND_BUDGET) !>;
            expect(got > 0, "wave committed");
            expect(!d.find.done && !d.find.idle, "more file remains");
            expect(d.find.len == 0, "needle is past the first wave");
            {
                size_t kept = d.find.scan_off;
                RtxUi ui = {0};
                ui.find = 1;
                d.find.cancel = 1;
                rtx_ui_find_pump(&ui, &d) !>;
                expect(d.find.cancel, "host wrote cancel");
                expect(d.find.scan_off == kept, "pump did not enter");
                d.find.cancel = 0;
                d.find.idle = 0;
                rtx_ui_find_pump(&ui, &d) !>;
                expect(d.find.scan_off > kept || d.find.done,
                       "pump enters");
                expect(d.find.done ||
                       d.find.scan_off >= kept +
                           2 * (size_t)RTX_FIND_WAVE * (size_t)RTX_FIND_BLOCK,
                       "pump may enter several waves");
            }
            d.find_set("zzz") !>;
            expect(!d.find.cancel && !d.find.idle, "new query clears cancel");
            expect(d.find.scan_off == 0, "rescan from start");
        }
    }

    /* Longer prefix filters; keeps the scan. Shorter query rewinds. */
    {
        RtxDoc d = {0} @destroy;
        size_t kept;
        d.from_buffer("alpha\nbeta\nalpha\ngamma alpha\n") !>;
        d.find_set("al") !>;
        d.find_step(RTX_FIND_BUDGET) !>;
        expect(d.find.done && d.find.len == 3, "three al");
        kept = d.find.scan_off;
        d.find_set("alp") !>;
        expect(d.find.done && d.find.len == 3, "alp is the same three");
        expect(d.find.scan_off == kept, "extend keeps scan_off");
        d.find_set("alpx") !>;
        expect(d.find.done && d.find.len == 0, "alpx filters to none");
        expect(d.find.scan_off == kept, "still no rewind");
        d.find_set("al") !>;
        expect(d.find.scan_off == 0 && !d.find.done, "shorter query restarts");
        d.find_step(RTX_FIND_BUDGET) !>;
        expect(d.find.done && d.find.len == 3, "al after restart");
    }

    /* Cap: extend resumes at the last accepted hit, not byte 0. */
    {
        size_t n = (size_t)RTX_FIND_MAX + 32;
        CCArena body = cc_arena_heap(n + 8) @destroy;
        char[:] big;
        big = body.alloc_slice_bytes(n);
        expect(big.ptr != NULL && big.len >= n, "refine cap arena");
        if (big.ptr && big.len >= n) {
            RtxDoc d = {0} @destroy;
            memset(big.ptr, 'a', n);
            memcpy(big.ptr + (size_t)RTX_FIND_MAX, "xab", 3);
            d.from_buffer(big) !>;
            d.find_set("a") !>;
            d.find_step(RTX_FIND_BUDGET) !>;
            expect(d.find.truncated && d.find.len == (size_t)RTX_FIND_MAX,
                   "cap before refine");
            expect(d.find.offs[d.find.len - 1] == (size_t)RTX_FIND_MAX - 1,
                   "last capped a");
            d.find_set("ab") !>;
            expect(!d.find.done && !d.find.truncated, "cap is live again");
            expect(d.find.scan_off == (size_t)RTX_FIND_MAX, "resume after last a");
            expect(d.find.len == 0, "no ab in the capped prefix");
            d.find_step(RTX_FIND_BUDGET) !>;
            expect(d.find.done && d.find.len == 1, "ab after the cap");
            expect(d.find.offs[0] == (size_t)RTX_FIND_MAX + 1, "ab at MAX+1");
        }
    }

    /* Dense block: collect cap is MAX. Two blocks so use_par is on.
     * Parallel and seq-construct must agree. */
    {
        size_t n = (size_t)RTX_FIND_BLOCK + 64;
        CCArena body = cc_arena_heap(n + 8) @destroy;
        char[:] big;
        big = body.alloc_slice_bytes(n);
        expect(big.ptr != NULL && big.len >= n, "dense find arena");
        if (big.ptr && big.len >= n) {
            RtxDoc par = {0} @destroy;
            memset(big.ptr, 'a', n);
            par.from_buffer(big) !>;
            par.find_set("a") !>;
            par.find_step(RTX_FIND_BUDGET) !>;
            expect(par.find.done && par.find.truncated, "par capped");
            expect(par.find.len == (size_t)RTX_FIND_MAX, "par MAX hits");
            expect(par.find.offs[0] == 0, "par first");
            expect(par.find.offs[par.find.len - 1] == (size_t)RTX_FIND_MAX - 1,
                   "par last is prefix");
            {
                RtxDoc seq = {0} @destroy;
                seq.from_buffer(big) !>;
                seq.find_set("a") !>;
                setenv("RTX_FIND_SEQ", "1", 1);
                seq.find_step(RTX_FIND_BUDGET) !>;
                unsetenv("RTX_FIND_SEQ");
                expect(seq.find.len == par.find.len, "seq construct same len");
                expect(seq.find.truncated, "seq construct capped");
                expect(seq.find.offs[seq.find.len - 1] ==
                           par.find.offs[par.find.len - 1],
                       "seq construct last");
            }
        }
    }

    {
        RtxWs w = {0} @destroy;
        RtxUi ui = {0};
        RtxField f;
        RtxDoc *d;
        w.open_files(0, NULL) !>;
        d = &w.bufs[0].doc;
        d->type("one two one\n") !>;
        rtx_ui_start_find(&ui);
        expect(rtx_ui_find_char(&ui, 'o'), "type o");
        expect(rtx_ui_find_char(&ui, 'n'), "type n");
        expect(rtx_ui_find_char(&ui, 'e'), "type e");
        expect(ui.find_len == 3 && ui.find_caret == 3, "query one at end");
        rtx_ui_find_apply(&ui, d) !>;
        expect(d->find.len == 2, "two one hits");
        f = rtx_ui_find_field(&ui);
        rtx_field_select_all(f);
        expect(rtx_field_has_sel(f) && rtx_field_lo(f) == 0 &&
               rtx_field_hi(f) == 3, "select all query");
        expect((rtx_field_copy(&w, f) !>) == 1, "copy query");
        expect(w.clip.len == 3 && w.clip.ptr && memcmp(w.clip.ptr, "one", 3) == 0,
               "clip is one");
        expect(rtx_ui_find_char(&ui, 'x'), "type replaces selection");
        expect(ui.find_len == 1 && ui.find_buf[0] == 'x', "query is x");
        rtx_field_paste(&w, f) !>;
        expect(ui.find_len == 4 && memcmp(ui.find_buf, "xone", 4) == 0,
               "paste after x");
        rtx_field_click(f, 1, 0, 0);
        rtx_field_click(f, 4, 1, 0);
        expect(rtx_field_lo(f) == 1 && rtx_field_hi(f) == 4, "shift-click one");
        rtx_field_cut(&w, f) !>;
        expect(ui.find_len == 1 && ui.find_buf[0] == 'x', "cut leaves x");
        rtx_field_paste(&w, f) !>;
        expect(ui.find_len == 4 && memcmp(ui.find_buf, "xone", 4) == 0,
               "paste restores one");
        rtx_ui_find_apply(&ui, d) !>;
        expect(d->find.len == 0, "xone has no hits");
    }

    if (fails) {
        fprintf(stderr, "%d failure(s)\n", fails);
        return 1;
    }
    printf("find_smoke ok\n");
    return 0;
}
