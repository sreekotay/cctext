#!ccc ccs
/*
 * Incremental find: all hits, budgeted scan, invalidate on edit.
 */
#include <ccc/std/prelude.cch>
#include <ccc/script/stdio.cch>
#include <stdio.h>
#include <string.h>
#include "../core/document.cch"
#include "../core/layout.cch"
#include "../core/workspace.cch"

static int fails = 0;

static void expect(int cond, const char *msg) {
    if (!cond) {
        fprintf(stderr, "FAIL: %s\n", msg);
        fails++;
    }
}

int main(void) {
    @errhandler(CCError e) { cc_error_log(e); return 1; }

    {
        RtxDoc d = {0} @destroy;
        d.from_buffer("alpha\nbeta\nalpha\ngamma alpha\n") !>;
        d.find_set("alpha") !>;
        d.find_step(RTX_FIND_BUDGET) !>;
        expect(d.find.done, "small scan done");
        expect(d.find.len == 3, "three alpha");
        expect(!d.find.truncated, "not capped");
        d.find_goto(1);
        expect(d.caret == 11, "second alpha offset");
        expect(d.sel_anchor == 16, "selects the hit");
        d.find_next();
        expect(d.find.cur == 2, "wrap next");
        d.find_next();
        expect(d.find.cur == 0, "wrap to first");
        d.find_prev();
        expect(d.find.cur == 2, "wrap prev");
    }

    {
        RtxDoc d = {0} @destroy;
        d.from_buffer("aaa") !>;
        d.find_set("aa") !>;
        d.find_step(RTX_FIND_BUDGET) !>;
        expect(d.find.done && d.find.len == 2, "overlapping aa in aaa");
        expect(d.find.offs[0] == 0 && d.find.offs[1] == 1, "overlap offsets");
    }

    {
        RtxDoc d = {0} @destroy;
        d.from_buffer("hello") !>;
        d.find_set("") !>;
        expect(d.find.done && d.find.len == 0, "empty query");
        d.find_set("nope") !>;
        d.find_step(RTX_FIND_BUDGET) !>;
        expect(d.find.done && d.find.len == 0, "no matches");
    }

    {
        RtxDoc d = {0} @destroy;
        d.from_buffer("xx y xx y xx\n") !>;
        d.find_set("xx") !>;
        d.find_step(RTX_FIND_BUDGET) !>;
        expect(d.find.len == 3, "three xx");
        d.caret = 0;
        d.sel_anchor = 0;
        d.type("z") !>;
        expect(d.find.len == 0 && !d.find.done, "invalidate on type");
        expect(d.find.query.len == 2, "query kept");
        d.find_step(RTX_FIND_BUDGET) !>;
        expect(d.find.done && d.find.len == 3, "rescan after edit");
        expect(d.find.offs[0] == 1, "hits shifted");
    }

    {
        RtxDoc d = {0} @destroy;
        cc_arena_stack(scratch, RTX_FRAME_SCRATCH);
        RtxFindHitView v;
        d.from_buffer("one match here\n") !>;
        d.find_set("match") !>;
        d.find_step(RTX_FIND_BUDGET) !>;
        expect(d.find.len == 1, "one match");
        d.find_hit_view(0, &scratch, 40, &v) !>;
        expect(v.line1 == 1, "context line");
        expect(v.col == 4, "match col in line");
        expect(v.ctx.len >= 5, "context bytes");
    }

    /* Default budget is the ordered parallel loop (one ticket per block). */
    {
        RtxDoc d = {0} @destroy;
        size_t n = (size_t)RTX_FIND_BLOCK + 64;
        CCArena body = cc_arena_heap(n + 64) @destroy;
        char[:] big;
        big = body.alloc_slice_bytes(n);
        expect(big.ptr != NULL && big.len >= n, "parallel find arena");
        if (big.ptr && big.len >= n) {
            memset(big.ptr, 'x', n);
            memcpy(big.ptr + (size_t)RTX_FIND_BLOCK + 8, "needle", 6);
            d.from_buffer(big) !>;
            d.find_set("needle") !>;
            d.find_step(RTX_FIND_BUDGET) !>;
            expect(d.find.done, "parallel scan done");
            expect(d.find.len == 1, "one needle in second block");
            expect(d.find.offs[0] == (size_t)RTX_FIND_BLOCK + 8, "hit at block+8");
        }
    }

    /* A wave commits; host cancel is a written bit, not a body poll. */
    {
        RtxDoc d = {0} @destroy;
        size_t n = (size_t)RTX_FIND_WAVE * (size_t)RTX_FIND_BLOCK + 64;
        CCArena body = cc_arena_heap(n + 64) @destroy;
        char[:] big;
        size_t got;
        big = body.alloc_slice_bytes(n);
        expect(big.ptr != NULL && big.len >= n, "wave find arena");
        if (big.ptr && big.len >= n) {
            memset(big.ptr, 'x', n);
            memcpy(big.ptr + (size_t)RTX_FIND_WAVE * (size_t)RTX_FIND_BLOCK,
                   "needle", 6);
            d.from_buffer(big) !>;
            d.find_set("needle") !>;
            got = d.find_step(RTX_FIND_BUDGET) !>;
            expect(got > 0 && d.find.wave_commit == got, "wave committed");
            expect(!d.find.done && !d.find.idle, "more file remains");
            expect(d.find.len == 0, "needle is past the first wave");
            {
                size_t kept = d.find.scan_off;
                d.find.cancel = 1;
                /* Host gate: cancel means do not enter. find_step is the
                 * interval, not the place that forges a 0-commit abort. */
                expect(d.find.cancel, "host wrote cancel");
                expect(d.find.scan_off == kept, "no step after cancel");
            }
            d.find_set("zzz") !>;
            expect(!d.find.cancel && !d.find.idle, "new query clears cancel");
            expect(d.find.scan_off == 0, "rescan from start");
        }
    }

    if (fails) {
        fprintf(stderr, "%d failure(s)\n", fails);
        return 1;
    }
    printf("find_smoke ok\n");
    return 0;
}
