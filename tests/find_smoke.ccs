#!ccc ccs
/*
 * Incremental find: dest-live scan. The list covers [0, scan_off).
 * An edit shifts that prefix. A seam that does not fit, or a stale
 * list, wipes. Tests wait via finish.
 */
#include <ccc/std/prelude.cch>
#include <ccc/stdio.cch>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#if defined(__APPLE__)
#include <malloc/malloc.h>
#elif defined(__linux__)
#include <malloc.h>
#endif
#include "../core/document.cch"
#include "../core/layout.cch"
#include "../core/workspace.cch"
#include "../core/find.cch"
#include "../core/ui.cch"
#include "../core/browse.cch"

static int fails = 0;

static void expect(int cond, const char *msg) {
    if (!cond) {
        fprintf(stderr, "FAIL: %s\n", msg);
        fails++;
    }
}

/* Live malloc in-use. Peak RSS does not drop on free, so it cannot see
 * the find-step wave leak (@destroy skipped through @parallel). */
static size_t heap_in_use(void) {
#if defined(__APPLE__)
    malloc_statistics_t s = {0};
    malloc_zone_statistics(NULL, &s);
    return (size_t)s.size_in_use;
#elif defined(__linux__)
#if defined(__GLIBC__) && defined(__GLIBC_PREREQ) && __GLIBC_PREREQ(2, 33)
    return (size_t)mallinfo2().uordblks;
#else
    return (size_t)mallinfo().uordblks;
#endif
#else
    return 0;
#endif
}

int main(void) {
    rtx_safe_test_isol();
    @errhandler(CCError e) { cc_error_log(e); return 1; }

    {
        RtxDoc d = {0} @destroy;
        d.from_buffer("alpha\nbeta\nalpha\ngamma alpha\n") !>;
        d.find_set("alpha") !>;
        d.find_finish() !>;
        expect(d.find.done, "small scan done");
        expect(d.find.len == 3, "three alpha");
        expect(!d.find.truncated, "not capped");
        expect(d.find.hits[0].off == 0 && d.find.hits[0].line == 0,
               "first alpha is line 1");
        expect(d.find.hits[1].off == 11 && d.find.hits[1].line == 2,
               "second alpha is line 3");
        expect(d.find.hits[2].off == 23 && d.find.hits[2].line == 3,
               "third alpha is line 4");
        d.find_goto(1);
        expect(d.caret == 11, "second alpha offset");
        expect(d.sel_anchor == 16, "selects the hit");
        d.find_next();
        expect(d.find.cur == 2, "wrap next");
        d.find_next();
        expect(d.find.cur == 0, "wrap to first");
        d.find_prev();
        expect(d.find.cur == 2, "wrap prev");
    }

    {
        RtxDoc d = {0} @destroy;
        d.from_buffer("aaa") !>;
        d.find_set("aa") !>;
        d.find_finish() !>;
        expect(d.find.done && d.find.len == 2, "overlapping aa in aaa");
        expect(d.find.hits[0].off == 0 && d.find.hits[1].off == 1, "overlap offsets");
        expect(d.find.hits[0].line == 0 && d.find.hits[1].line == 0,
               "overlap stays on one line");
    }

    {
        RtxDoc d = {0} @destroy;
        d.from_buffer("hello") !>;
        d.find_set("") !>;
        expect(d.find.done && d.find.len == 0, "empty query");
        d.find_set("nope") !>;
        d.find_finish() !>;
        expect(d.find.done && d.find.len == 0, "no matches");
    }

    {
        RtxDoc d = {0} @destroy;
        d.from_buffer("xx y xx y xx\n") !>;
        d.find_set("xx") !>;
        d.find_finish() !>;
        expect(d.find.len == 3, "three xx");
        d.find.cur = 1;
        d.find.pinned = 1;
        d.caret = 0;
        d.sel_anchor = 0;
        d.type("z") !>;
        expect(d.find.done && !d.find.truncated, "edit keeps a closed list");
        expect(d.find.len == 3, "three xx after insert");
        expect(d.find.query.len == 2, "query kept");
        expect(d.find.pinned, "pin survives the splice");
        expect(d.find.cur == 1, "cur follows the shifted hit");
        expect(d.find.hits[0].off == 1 && d.find.hits[1].off == 6 &&
               d.find.hits[2].off == 11, "hits shifted");
        expect(d.find.scan_off == d.len(), "scan cursor at end");
    }

    /* Prefix [0, 4) is "xx y". The insert shifts that prefix; resume
     * finds the hits that were never scanned. */
    {
        RtxDoc d = {0} @destroy;
        char got[2];
        size_t nr;
        d.from_buffer("xx y xx y xx\n") !>;
        d.find_set("xx") !>;
        d.find_finish() !>;
        d.find.len = 1;
        d.find.scan_off = 4;
        d.find.scan_line = 0;
        d.find.scan_base = 4;
        d.find.scan_bytes = 4;
        d.find.done = 0;
        d.find.truncated = 0;
        d.find.cancel = 0;
        d.replace(0, 0, "z") !>;
        expect(!d.find.done && !d.find.truncated, "prefix edit stays open");
        expect(d.find.scan_off == 5, "prefix cursor shifts with the insert");
        expect(d.find.len == 1 && d.find.hits[0].off == 1, "prefix hit shifts");
        nr = d.read_at(d.find.hits[0].off, got, 2) !>;
        expect(nr == 2 && got[0] == 'x' && got[1] == 'x', "prefix hit is still xx");
        d.find_finish() !>;
        expect(d.find.done && d.find.len == 3, "resume finds the unread hits");
        expect(d.find.hits[0].off == 1 && d.find.hits[1].off == 6 &&
               d.find.hits[2].off == 11, "resume does not repeat the prefix");
        expect(d.find.scan_off == d.len(), "resume finishes the file");
    }

    {
        RtxDoc d = {0} @destroy;
        d.from_buffer("xx y xx y xx\n") !>;
        d.find_set("xx") !>;
        d.find_finish() !>;
        d.find.len = 1;
        d.find.scan_off = 4;
        d.find.scan_line = 0;
        d.find.scan_base = 4;
        d.find.scan_bytes = 4;
        d.find.done = 1;
        d.find.truncated = 1;
        d.find.cancel = 0;
        d.replace(0, 0, "z") !>;
        expect(d.find.done && d.find.truncated, "cap stays a cap");
        expect(d.find.scan_off == 5, "cap cursor shifts");
        expect(d.find.len == 1 && d.find.hits[0].off == 1, "cap keeps the prefix hit");
        d.find_step() !>;
        expect(d.find.scan_off == 5 && d.find.truncated, "step does not resume a cap");
    }

    {
        RtxDoc d = {0} @destroy;
        d.from_buffer("xx y xx y xx\n") !>;
        d.find_set("xx") !>;
        d.find_finish() !>;
        d.find.scan_off = 4;
        d.find.scan_line = 0;
        d.find.done = 0;
        d.find.truncated = 0;
        d.insert(d.len(), "Q") !>;
        expect(d.find.len == 0 && d.find.scan_off == 0, "hit past the prefix wipes");
        expect(!d.find.done && d.find.query.len == 2, "query kept after stale wipe");
    }

    {
        RtxDoc d = {0} @destroy;
        RtxFindHit tmp;
        d.from_buffer("xx y xx") !>;
        d.find_set("xx") !>;
        d.find_finish() !>;
        expect(d.find.len == 2, "two xx before the swap");
        tmp = d.find.hits[0];
        d.find.hits[0] = d.find.hits[1];
        d.find.hits[1] = tmp;
        d.replace(0, 0, "z") !>;
        expect(d.find.len == 0 && d.find.scan_off == 0, "unsorted hits wipe");
    }

    {
        RtxDoc d = {0} @destroy;
        d.from_buffer("xx") !>;
        d.find_set("xx") !>;
        d.find_finish() !>;
        d.find.scan_off = d.len() + 10;
        d.replace(0, 0, "z") !>;
        expect(d.find.len == 0 && d.find.scan_off == 0, "scan_off past eof wipes");
    }

    {
        RtxDoc d = {0} @destroy;
        d.from_buffer("a\na") !>;
        d.find_set("a") !>;
        d.find_finish() !>;
        expect(d.find.len == 2, "two a");
        expect(d.find.hits[0].off == 0 && d.find.hits[0].line == 0, "first a");
        expect(d.find.hits[1].off == 2 && d.find.hits[1].line == 1, "second a");
        d.replace(1, 0, "\n") !>;
        expect(d.find.done && d.find.len == 2, "newline edit keeps both");
        expect(d.find.hits[0].off == 0 && d.find.hits[0].line == 0,
               "hit before the splice stays");
        expect(d.find.hits[1].off == 3 && d.find.hits[1].line == 2,
               "tail line follows the newline");
        expect(d.find.scan_line == 2, "scan line counts the new newline");
        d.replace(1, 1, cc_slice_empty()) !>;
        expect(d.find.done && d.find.len == 2, "deleting the newline keeps both");
        expect(d.find.hits[0].off == 0 && d.find.hits[0].line == 0, "first a again");
        expect(d.find.hits[1].off == 2 && d.find.hits[1].line == 1, "line restored");
        expect(d.find.scan_line == 1, "scan line drops the newline");
    }

    {
        RtxDoc d = {0} @destroy;
        d.from_buffer("x y") !>;
        d.find_set("xy") !>;
        d.find_finish() !>;
        expect(d.find.done && d.find.len == 0, "xy not yet");
        d.replace(1, 1, cc_slice_empty()) !>;
        expect(d.find.done && d.find.len == 1, "deleting the space creates xy");
        expect(d.find.hits[0].off == 0 && d.find.hits[0].line == 0, "xy at 0");
    }

    {
        RtxDoc d = {0} @destroy;
        d.from_buffer("abcd") !>;
        d.find_set("bc") !>;
        d.find_finish() !>;
        expect(d.find.len == 1 && d.find.hits[0].off == 1, "bc at 1");
        d.replace(2, 0, "X") !>;
        expect(d.find.done && d.find.len == 0, "splice destroys bc");
        d.undo() !>;
        expect(d.find.done && d.find.len == 1 && d.find.hits[0].off == 1,
               "undo restores bc");
        d.redo() !>;
        expect(d.find.done && d.find.len == 0, "redo destroys bc again");
    }

    {
        RtxDoc d = {0} @destroy;
        d.from_buffer("aaa") !>;
        d.find_set("aa") !>;
        d.find_finish() !>;
        d.replace(1, 1, cc_slice_empty()) !>;
        expect(d.find.done && d.find.len == 1, "overlap collapses to one aa");
        expect(d.find.hits[0].off == 0 && d.find.hits[0].line == 0, "aa at 0");
    }

    {
        RtxDoc d = {0} @destroy;
        CCArena body = cc_arena_heap((size_t)RTX_FRAME_SCRATCH + 8) @destroy;
        char[:] big;
        big = body.alloc_slice_bytes((size_t)RTX_FRAME_SCRATCH + 1);
        expect(big.ptr != NULL && big.len > (size_t)RTX_FRAME_SCRATCH, "seam cap arena");
        if (big.ptr && big.len > (size_t)RTX_FRAME_SCRATCH) {
            char[:] paste = big.sub(0, (size_t)RTX_FRAME_SCRATCH + 1);
            paste.fill('z') !>;
            d.from_buffer("aa") !>;
            d.find_set("a") !>;
            d.find_finish() !>;
            expect(d.find.done && d.find.len == 2, "two a before paste");
            d.insert(0, paste) !>;
            expect(!d.find.done && d.find.len == 0, "paste bigger than the seam wipes");
            expect(d.find.scan_off == 0, "oversized seam restarts at 0");
            expect(d.find.query.len == 1, "query kept after wipe");
        }
    }

    /* Same paste, but the cursor has not reached it. The insert is tail. */
    {
        RtxDoc d = {0} @destroy;
        CCArena body = cc_arena_heap((size_t)RTX_FRAME_SCRATCH + 8) @destroy;
        char[:] big;
        big = body.alloc_slice_bytes((size_t)RTX_FRAME_SCRATCH + 1);
        expect(big.ptr != NULL && big.len > (size_t)RTX_FRAME_SCRATCH, "tail paste arena");
        if (big.ptr && big.len > (size_t)RTX_FRAME_SCRATCH) {
            char[:] paste = big.sub(0, (size_t)RTX_FRAME_SCRATCH + 1);
            paste.fill('z') !>;
            d.from_buffer("xx y yy y yy\n") !>;
            d.find_set("xx") !>;
            d.find_finish() !>;
            d.find.len = 1;
            d.find.scan_off = 4;
            d.find.scan_line = 0;
            d.find.scan_base = 4;
            d.find.scan_bytes = 4;
            d.find.done = 0;
            d.find.truncated = 0;
            d.find.cancel = 0;
            d.insert(8, paste) !>;
            expect(d.find.len == 1 && d.find.hits[0].off == 0, "paste past prefix keeps the hit");
            expect(d.find.scan_off == 4, "paste past prefix leaves the cursor");
            expect(!d.find.done, "paste past prefix stays open");
            expect(d.find.query.len == 2, "query kept");
        }
    }

    /* Same paste inside the covered prefix. The seam does not fit. */
    {
        RtxDoc d = {0} @destroy;
        CCArena body = cc_arena_heap((size_t)RTX_FRAME_SCRATCH + 8) @destroy;
        char[:] big;
        big = body.alloc_slice_bytes((size_t)RTX_FRAME_SCRATCH + 1);
        expect(big.ptr != NULL && big.len > (size_t)RTX_FRAME_SCRATCH, "mid paste arena");
        if (big.ptr && big.len > (size_t)RTX_FRAME_SCRATCH) {
            char[:] paste = big.sub(0, (size_t)RTX_FRAME_SCRATCH + 1);
            paste.fill('z') !>;
            d.from_buffer("xx y yy y yy\n") !>;
            d.find_set("xx") !>;
            d.find_finish() !>;
            d.find.len = 1;
            d.find.scan_off = 4;
            d.find.scan_line = 0;
            d.find.scan_base = 4;
            d.find.scan_bytes = 4;
            d.find.done = 0;
            d.find.truncated = 0;
            d.find.cancel = 0;
            d.insert(1, paste) !>;
            expect(d.find.len == 0 && d.find.scan_off == 0, "paste inside the prefix wipes");
            expect(!d.find.done && d.find.query.len == 2, "query kept after mid paste");
        }
    }

    /* Insert between two covered hits. Small enough for the seam. */
    {
        RtxDoc d = {0} @destroy;
        CCArena body = cc_arena_heap(128) @destroy;
        char[:] mid;
        char got[2];
        size_t nr;
        mid = body.alloc_slice_bytes(100);
        expect(mid.ptr != NULL && mid.len >= 100, "seam insert arena");
        if (mid.ptr && mid.len >= 100) {
            char[:] paste = mid.sub(0, 100);
            paste.fill('z') !>;
            d.from_buffer("xx aaa xx") !>;
            d.find_set("xx") !>;
            d.find_finish() !>;
            expect(d.find.len == 2 && d.find.hits[0].off == 0 &&
                   d.find.hits[1].off == 7, "xx on both sides");
            d.insert(3, paste) !>;
            expect(d.find.done && d.find.scan_off == d.len(), "seam insert stays closed");
            expect(d.find.len == 2, "both hits survive the seam");
            expect(d.find.hits[0].off == 0 && d.find.hits[1].off == 107,
                   "tail hit shifts by the insert");
            nr = d.read_at(0, got, 2) !>;
            expect(nr == 2 && got[0] == 'x' && got[1] == 'x', "head hit bytes");
            nr = d.read_at(107, got, 2) !>;
            expect(nr == 2 && got[0] == 'x' && got[1] == 'x', "tail hit bytes");
        }
    }

    {
        RtxDoc d = {0} @destroy;
        cc_arena_stack(scratch, RTX_FRAME_SCRATCH);
        RtxFindHitView v;
        d.from_buffer("one match here\n") !>;
        d.find_set("match") !>;
        d.find_finish() !>;
        expect(d.find.len == 1, "one match");
        d.find_hit_view(0, scratch, 40, &v) !>;
        expect(v.line1 == 1, "context line");
        expect(v.col == 4, "match col in line");
        expect(v.ctx.len >= 5, "context bytes");
    }

    /* Hits across blocks publish in file order. */
    {
        RtxDoc d = {0} @destroy;
        size_t n = 4 * (size_t)RTX_FIND_BLOCK;
        CCArena body = cc_arena_heap(n + 64) @destroy;
        char[:] big;
        big = body.alloc_slice_bytes(n);
        expect(big.ptr != NULL && big.len >= n, "lane find arena");
        if (big.ptr && big.len >= n) {
            size_t i;
            char[:] win = big.sub(0, n);
            char[:] nd = cc_slice_from_buffer((void *)"needle", 6);
            win.fill('x') !>;
            for (i = 0; i < 4; i++) {
                char[:] hole = win.sub(i * (n / 4) + 8, i * (n / 4) + 14);
                hole.copy(nd) !>;
            }
            d.from_buffer(big) !>;
            d.find_set("needle") !>;
            d.find_finish() !>;
            expect(d.find.done && d.find.len == 4, "four lane hits");
            for (i = 0; i < 4 && i < d.find.len; i++)
                expect(d.find.hits[i].off == i * (n / 4) + 8, "lane hit order");
        }
    }

    /* Hit in the second block. */
    {
        RtxDoc d = {0} @destroy;
        size_t n = (size_t)RTX_FIND_BLOCK + 64;
        CCArena body = cc_arena_heap(n + 64) @destroy;
        char[:] big;
        big = body.alloc_slice_bytes(n);
        expect(big.ptr != NULL && big.len >= n, "two-block find arena");
        if (big.ptr && big.len >= n) {
            {
                char[:] win = big.sub(0, n);
                char[:] nd = cc_slice_from_buffer((void *)"needle", 6);
                char[:] hole = win.sub((size_t)RTX_FIND_BLOCK + 8,
                                       (size_t)RTX_FIND_BLOCK + 14);
                win.fill('x') !>;
                hole.copy(nd) !>;
            }
            d.from_buffer(big) !>;
            d.find_set("needle") !>;
            d.find_finish() !>;
            expect(d.find.done, "two-block scan done");
            expect(d.find.len == 1, "one needle in second block");
            expect(d.find.hits[0].off == (size_t)RTX_FIND_BLOCK + 8, "hit at block+8");
        }
    }

    /* A newline at the end of a block belongs to that block's count.
     * The hit in the next block must not use the density guess (0 when
     * the index has no scan frontier). */
    {
        RtxDoc d = {0} @destroy;
        cc_arena_stack(scratch, RTX_FRAME_SCRATCH);
        size_t n = (size_t)RTX_FIND_BLOCK + 64;
        CCArena body = cc_arena_heap(n + 64) @destroy;
        char[:] big;
        RtxFindHitView v;
        big = body.alloc_slice_bytes(n);
        expect(big.ptr != NULL && big.len >= n, "line count arena");
        if (big.ptr && big.len >= n) {
            size_t i;
            char[:] win = big.sub(0, n);
            char[:] nd = cc_slice_from_buffer((void *)"needle", 6);
            char[:] hole = win.sub((size_t)RTX_FIND_BLOCK + 8,
                                   (size_t)RTX_FIND_BLOCK + 14);
            win.fill('x') !>;
            for (i = 0; i < 1000; i++) win.ptr[i] = '\n';
            win.ptr[(size_t)RTX_FIND_BLOCK - 1] = '\n';
            hole.copy(nd) !>;
            d.from_buffer(big) !>;
            d.find_set("needle") !>;
            d.find_finish() !>;
            expect(d.find.done && d.find.len == 1, "needle past the block");
            expect(d.find.hits[0].off == (size_t)RTX_FIND_BLOCK + 8,
                   "needle offset");
            expect(d.find.hits[0].line == 1001,
                   "lines counted across the block, including its last byte");
            expect(d.line_guess(d.find.hits[0].off) == 0,
                   "the index guess is not this number");
            d.find_hit_view(0, scratch, 40, &v) !>;
            expect(v.line1 == 1002, "list shows the counted line");
        }
    }

    /* New query drops old hits. */
    {
        RtxDoc d = {0} @destroy;
        size_t n = 8 * (size_t)RTX_FIND_BLOCK + 64;
        CCArena body = cc_arena_heap(n + 64) @destroy;
        char[:] big;
        big = body.alloc_slice_bytes(n);
        expect(big.ptr != NULL && big.len >= n, "rescan find arena");
        if (big.ptr && big.len >= n) {
            {
                char[:] win = big.sub(0, n);
                char[:] nd = cc_slice_from_buffer((void *)"needle", 6);
                char[:] hole = win.sub((size_t)RTX_FIND_BLOCK + 8,
                                       (size_t)RTX_FIND_BLOCK + 14);
                win.fill('x') !>;
                hole.copy(nd) !>;
            }
            d.from_buffer(big) !>;
            d.find_set("needle") !>;
            rtx_find_pause(&d);
            if (!d.find.done) {
                char st[96];
                rtx_ui_find_stats(&d, st, sizeof(st));
                expect(strstr(st, "scanning...") != NULL, "find lists scanning");
                expect(strchr(st, '%') != NULL, "find lists %");
                expect(strchr(st, 'B') != NULL, "find lists bytes");
            }
            d.find_set("zzz") !>;
            expect(!d.find.cancel, "new query clears cancel");
            expect(d.find.len == 0, "new query drops hits");
            d.find_finish() !>;
            expect(d.find.done && d.find.len == 0, "zzz has no hits");
        }
    }

    /* Longer prefix filters; keeps the scan. Shorter query rewinds. */
    {
        RtxDoc d = {0} @destroy;
        size_t kept;
        d.from_buffer("alpha\nbeta\nalpha\ngamma alpha\n") !>;
        d.find_set("al") !>;
        d.find_finish() !>;
        expect(d.find.done && d.find.len == 3, "three al");
        expect(d.find.hits[0].line == 0 && d.find.hits[1].line == 2 &&
               d.find.hits[2].line == 3, "al lines");
        kept = d.find.scan_off;
        d.find_set("alp") !>;
        expect(d.find.done && d.find.len == 3, "alp is the same three");
        expect(d.find.scan_off == kept, "extend keeps scan_off");
        expect(d.find.hits[0].line == 0 && d.find.hits[2].line == 3,
               "extend keeps the counted lines");
        d.find_set("alpx") !>;
        expect(d.find.done && d.find.len == 0, "alpx filters to none");
        expect(d.find.scan_off == kept, "still no rewind");
        d.find_set("al") !>;
        d.find_finish() !>;
        expect(d.find.done && d.find.len == 3, "al after restart");
    }

    /* Cap: extend resumes at the last accepted hit, not byte 0. */
    {
        size_t n = (size_t)RTX_FIND_MAX + 32;
        CCArena body = cc_arena_heap(n + 8) @destroy;
        char[:] big;
        big = body.alloc_slice_bytes(n);
        expect(big.ptr != NULL && big.len >= n, "refine cap arena");
        if (big.ptr && big.len >= n) {
            RtxDoc d = {0} @destroy;
            {
                char[:] win = big.sub(0, n);
                char[:] xab = cc_slice_from_buffer((void *)"xab", 3);
                char[:] hole = win.sub((size_t)RTX_FIND_MAX,
                                       (size_t)RTX_FIND_MAX + 3);
                win.fill('a') !>;
                hole.copy(xab) !>;
            }
            d.from_buffer(big) !>;
            d.find_set("a") !>;
            d.find_finish() !>;
            expect(d.find.truncated && d.find.len == (size_t)RTX_FIND_MAX,
                   "cap before refine");
            expect(d.find.hits[d.find.len - 1].off == (size_t)RTX_FIND_MAX - 1,
                   "last capped a");
            d.find_set("ab") !>;
            if (!d.find.done) {
                expect(!d.find.truncated, "cap is live again");
                expect(d.find.scan_off == (size_t)RTX_FIND_MAX, "resume after last a");
                expect(d.find.len == 0, "no ab in the capped prefix");
            }
            d.find_finish() !>;
            expect(d.find.done && d.find.len == 1, "ab after the cap");
            expect(d.find.hits[0].off == (size_t)RTX_FIND_MAX + 1, "ab at MAX+1");
        }
    }

    /* Dense block: collect cap is MAX. */
    {
        size_t n = (size_t)RTX_FIND_BLOCK + 64;
        CCArena body = cc_arena_heap(n + 8) @destroy;
        char[:] big;
        big = body.alloc_slice_bytes(n);
        expect(big.ptr != NULL && big.len >= n, "dense find arena");
        if (big.ptr && big.len >= n) {
            RtxDoc d = {0} @destroy;
            {
                char[:] win = big.sub(0, n);
                win.fill('a') !>;
            }
            d.from_buffer(big) !>;
            d.find_set("a") !>;
            d.find_finish() !>;
            expect(d.find.done && d.find.truncated, "capped");
            expect(d.find.len == (size_t)RTX_FIND_MAX, "MAX hits");
            expect(d.find.hits[0].off == 0, "first");
            expect(d.find.hits[d.find.len - 1].off == (size_t)RTX_FIND_MAX - 1,
                   "last is prefix");
        }
    }

    {
        RtxWs w = {0} @destroy;
        RtxUi ui = {0};
        RtxField f;
        RtxDoc *d;
        rtx_safe_ws_drop();
        w.open_files(0, NULL) !>;
        d = &w.bufs[0]->doc;
        d->type("one two one\n") !>;
        {
            size_t caret0 = d->caret;
            rtx_ui_start_find(&ui, d);
            expect(rtx_ui_find_char(&ui, 'o'), "type o");
            expect(rtx_ui_find_char(&ui, 'n'), "type n");
            expect(rtx_ui_find_char(&ui, 'e'), "type e");
            expect(ui.find_len == 3 && ui.find_caret == 3, "query one at end");
            rtx_ui_find_apply(&ui, d) !>;
            d->find_finish() !>;
            expect(d->find.len == 2, "two one hits");
            expect(d->caret == caret0, "apply does not jump");
            expect(!d->find.pinned, "apply is not a select");
            d->find_next();
            expect(d->find.pinned, "next selects");
            expect(d->caret == d->find.hits[d->find.cur].off, "next lands");
        }
        f = rtx_ui_find_field(&ui);
        rtx_field_select_all(f);
        expect(rtx_field_has_sel(f) && rtx_field_lo(f) == 0 &&
               rtx_field_hi(f) == 3, "select all query");
        {
            int _v = rtx_field_copy(&w, f) !>;
            expect(_v == 1, "copy query");
        }
        expect(w.clip.eq_cstr("one"), "clip is one");
        expect(rtx_ui_find_char(&ui, 'x'), "type replaces selection");
        expect(ui.find_len == 1 && ui.find_buf[0] == 'x', "query is x");
        rtx_field_paste(&w, f) !>;
        expect(ui.find_len == 4 &&
               ({ char[:] __s = cc_slice_from_buffer(ui.find_buf, 4); __s.eq_cstr("xone"); }),
               "paste after x");
        rtx_field_click(f, 1, 0, 0);
        rtx_field_click(f, 4, 1, 0);
        expect(rtx_field_lo(f) == 1 && rtx_field_hi(f) == 4, "shift-click one");
        rtx_field_cut(&w, f) !>;
        expect(ui.find_len == 1 && ui.find_buf[0] == 'x', "cut leaves x");
        rtx_field_paste(&w, f) !>;
        expect(ui.find_len == 4 &&
               ({ char[:] __s = cc_slice_from_buffer(ui.find_buf, 4); __s.eq_cstr("xone"); }),
               "paste restores one");
        rtx_ui_find_apply(&ui, d) !>;
        d->find_finish() !>;
        expect(d->find.len == 0, "xone has no hits");
    }

    /* Multi-block scan. cache (slot) reuses the 2 MiB window. */
    {
        size_t waves = 3;
        size_t n = waves * (size_t)RTX_FIND_BLOCK;
        CCArena body = cc_arena_heap(n + 64) @destroy;
        char[:] big;
        size_t base;
        size_t live;
        size_t after;
        size_t slack = megabytes(3);
        big = body.alloc_slice_bytes(n);
        expect(big.ptr != NULL && big.len >= n, "wave leak arena");
        if (big.ptr && big.len >= n) {
            {
                char[:] win = big.sub(0, n);
                win.fill('x') !>;
            }
            base = heap_in_use();
            expect(base > 0, "heap_in_use");
            {
                RtxDoc d = {0} @destroy;
                d.from_buffer(big) !>;
                d.find_set("zz") !>;
                d.find_finish() !>;
                expect(d.find.done, "three-wave scan done");
                live = heap_in_use();
                if (base) {
                    expect(live < base + slack, "find wave freed each step");
                    if (live >= base + slack)
                        fprintf(stderr, "  live-base=%zu (limit %zu)\n",
                                live - base, slack);
                }
            }
            after = heap_in_use();
            if (base) {
                expect(after < base + slack, "find wave gone after destroy");
                if (after >= base + slack)
                    fprintf(stderr, "  after-base=%zu (limit %zu)\n",
                            after - base, slack);
            }
        }
    }

    /* Above the line-index soft min, so the edit does not scan the body.
     * The paste sits past the prefix. Resume must read the tail, not
     * the already-scanned prefix. */
    {
        RtxDoc d = {0} @destroy;
        size_t n = (size_t)RTX_LINE_SOFT_MIN + 256;
        size_t paste_n = (size_t)RTX_FRAME_SCRATCH + 1;
        size_t cover = n - 128;
        CCArena body = cc_arena_heap(n + paste_n + 64) @destroy;
        char[:] big;
        big = body.alloc_slice_bytes(n + paste_n);
        expect(big.ptr != NULL && big.len >= n + paste_n, "unread tail arena");
        if (big.ptr && big.len >= n + paste_n) {
            char[:] win = big.sub(0, n);
            char[:] nd = cc_slice_from_buffer((void *)"needle", 6);
            char[:] paste = big.sub(n, n + paste_n);
            char[:] hole;
            char got[6];
            size_t rd;
            size_t nr;
            size_t at;
            win.fill('x') !>;
            hole = win.sub(8, 14);
            hole.copy(nd) !>;
            hole = win.sub(n - 40, n - 34);
            hole.copy(nd) !>;
            paste.fill('z') !>;
            d.from_buffer(win) !>;
            d.find_set("needle") !>;
            d.find_finish() !>;
            expect(d.find.done && d.find.len == 2, "two needles before the trim");
            d.find.len = 1;
            d.find.scan_off = cover;
            d.find.scan_line = 0;
            d.find.scan_base = cover;
            d.find.scan_bytes = cover;
            d.find.done = 0;
            d.find.truncated = 0;
            d.find.cancel = 0;
            at = cover + 16;
            (void)rtx_read_account_take();
            d.insert(at, paste) !>;
            rd = rtx_read_account_take();
            expect(rd < 4096, "paste past the prefix does not read the file");
            expect(rd < n / 4, "paste past the prefix is not a rescan");
            expect(d.find.scan_off == cover, "huge paste leaves the cursor");
            expect(!d.find.done && d.find.len == 1 && d.find.hits[0].off == 8,
                   "prefix hit stays put");
            nr = d.read_at(8, got, 6) !>;
            expect(nr == 6 && memcmp(got, "needle", 6) == 0, "prefix bytes still needle");
            (void)rtx_read_account_take();
            d.find_finish() !>;
            rd = rtx_read_account_take();
            expect(rd < (size_t)RTX_LINE_SOFT_MIN / 2, "resume reads the tail, not the prefix");
            expect(d.find.done && d.find.len == 2, "resume finds the tail needle");
            expect(d.find.hits[0].off == 8, "prefix hit still first");
            expect(d.find.hits[1].off == (n - 40) + paste_n, "tail needle shifted by the paste");
        }
    }

    if (fails) {
        fprintf(stderr, "%d failure(s)\n", fails);
        return 1;
    }
    printf("find_smoke ok\n");
    return 0;
}
