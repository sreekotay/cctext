#!ccc ccs
/*
 * Differential: the retired TM regex (tests/tm_re_old.cch) vs the engine
 * the lexer uses now (core/rx.ccs), for every REGEX / RE_SPAN pattern of
 * every loaded grammar, at every offset of the in-tree fixtures
 * (testdata/rich/**, testdata/samples, testdata/*.csv, docs/*.md).
 *
 * Old side: whole-file window (what the old lexer handed it). New side:
 * the offset's line with its newline (what the lexer hands it now).
 * Every disagreement must be explained by a known defect of the old
 * engine or by the TextMate line contract; anything else fails.
 *
 *   C  class escape: old read `\t` `\n` … inside [ ] as the letter
 *   A  anchor: old read `^` / `$`-before-EOL differently (`^` was literal)
 *   L  line: old match ran past the offset's line end
 *   R  repeat cap: a match longer than the old 63-iteration cap
 *   U  unexplained (fails)
 *
 * Also a whole-lex spot check: yaml keys now plant entity.name.tag.
 */
#include <ccc/std/prelude.cch>
#include <ccc/stdio.cch>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <dirent.h>
#include "../core/document.cch"
#include "tm_re_old.cch"

typedef struct {
    const char *pat;
    size_t plen;
    const RtxRx *rx;
    const char *lang;
    size_t n[5]; /* C A L R U */
    size_t same;
    char ex[3][200];
    int nex;
} DiffPat;

#define DIFF_MAX 256
static DiffPat pats[DIFF_MAX];
static size_t npats;

static void add_pat(const char *lang, const char *p, size_t plen, const RtxRx *rx) {
    size_t k;
    if (!p || !plen || !rx || npats >= DIFF_MAX) return;
    /* end patterns with backrefs read begin captures: not comparable;
     * groups the retired engine never parsed (`(?:`, lookaround) neither */
    for (k = 0; k + 1 < plen; k++) {
        if (p[k] == '\\' && p[k + 1] >= '1' && p[k + 1] <= '9') return;
        if (p[k] == '(' && p[k + 1] == '?') return;
        if (p[k] == '\\') k++;
    }
    for (k = 0; k < npats; k++)
        if (pats[k].plen == plen && !memcmp(pats[k].pat, p, plen)) return;
    memset(&pats[npats], 0, sizeof(pats[npats]));
    pats[npats].pat = p;
    pats[npats].plen = plen;
    pats[npats].rx = rx;
    pats[npats].lang = lang;
    npats++;
}

static void add_rules(const char *lang, const RtxTmRule *rs, size_t n) {
    size_t i;
    for (i = 0; i < n; i++) {
        const RtxTmRule *r = &rs[i];
        if (r->op == RTX_TM_REGEX || r->op == RTX_TM_RE_SPAN) add_pat(lang, r->a, r->alen, r->ra);
        if (r->op == RTX_TM_RE_SPAN) add_pat(lang, r->b, r->blen, r->rb);
    }
}

/* Pattern features. */
static int has_class_esc(const char *p, size_t n) {
    size_t i;
    int in = 0;
    for (i = 0; i < n; i++) {
        if (p[i] == '\\' && i + 1 < n) {
            char e = p[i + 1];
            if (in && (e == 't' || e == 'n' || e == 'r' || e == 'f' || e == 'v')) return 1;
            i++;
            continue;
        }
        if (!in && p[i] == '[') in = 1;
        else if (in && p[i] == ']') in = 0;
    }
    return 0;
}

static int has_anchor(const char *p, size_t n) {
    size_t i;
    int in = 0;
    for (i = 0; i < n; i++) {
        if (p[i] == '\\') {
            i++;
            continue;
        }
        if (!in && p[i] == '[') {
            in = 1;
            continue;
        }
        if (in && p[i] == ']') in = 0;
        if (!in && (p[i] == '^' || p[i] == '$')) return 1;
    }
    return 0;
}

static char *read_all(const char *path, size_t *n) {
    FILE *fp = fopen(path, "rb");
    char *buf;
    long len;
    if (!fp) return NULL;
    fseek(fp, 0, SEEK_END);
    len = ftell(fp);
    fseek(fp, 0, SEEK_SET);
    buf = (char *)malloc((size_t)len + 1);
    if (buf && fread(buf, 1, (size_t)len, fp) != (size_t)len) {
        free(buf);
        buf = NULL;
    }
    fclose(fp);
    if (buf) buf[len] = 0;
    *n = (size_t)len;
    return buf;
}

static size_t positions;

static void diff_file(const char *path, RtxRxScratch *s) {
    size_t n = 0, i, k, eol = 0, eol_from = 1;
    char *buf = read_all(path, &n);
    if (!buf) return;
    for (i = 0; i < n; i++) {
        if (i >= eol || i < eol_from) {
            const char *nl = (const char *)memchr(buf + i, '\n', n - i);
            eol = nl ? (size_t)(nl - buf) + 1 : n;
            eol_from = i;
        }
        positions++;
        for (k = 0; k < npats; k++) {
            DiffPat *d = &pats[k];
            size_t oe = 0, ne = 0;
            int of, nf, first;
            RtxRxIn in;
            first = rtx_re_first(d->pat, d->plen);
            of = (first < 0 || (unsigned char)buf[i] == (unsigned char)first) &&
                 rtx_re_match(d->pat, d->plen, buf, i, n, &oe);
            memset(&in, 0, sizeof(in));
            in.s = buf;
            in.n = eol;
            in.gpos = RTX_RX_UNSET;
            in.ctx = RTX_RX_CTX_BOL0 | RTX_RX_CTX_BOT0;
            nf = rtx_rx_at(d->rx, &in, i, s, &ne, NULL) == RTX_RX_MATCH && ne > i;
            if (of == nf && (!of || oe == ne)) {
                d->same++;
                continue;
            }
            {
                int cat = 4;
                if (has_class_esc(d->pat, d->plen)) cat = 0;
                else if (has_anchor(d->pat, d->plen)) cat = 1;
                else if (of && oe > eol) cat = 2;
                else if ((of && oe - i >= 63) || (nf && ne - i >= 63)) cat = 3;
                d->n[cat]++;
                if (d->nex < 3) {
                    size_t ls = i, le = eol;
                    while (ls > 0 && buf[ls - 1] != '\n') ls--;
                    if (le > ls + 60) le = ls + 60;
                    snprintf(d->ex[d->nex], sizeof(d->ex[0]),
                             "%s@%zu old=%s%zu new=%s%zu line=\"%.*s\"", path, i,
                             of ? "" : "-", of ? oe - i : 0, nf ? "" : "-", nf ? ne - i : 0,
                             (int)(le - ls - (le > ls && buf[le - 1] == '\n')), buf + ls);
                    d->nex++;
                }
            }
        }
    }
    free(buf);
}

static void diff_dir(const char *dir, const char *suffix, RtxRxScratch *s, size_t *nfiles) {
    DIR *dp = opendir(dir);
    struct dirent *de;
    char path[512];
    if (!dp) return;
    while ((de = readdir(dp)) != NULL) {
        size_t ln = strlen(de->d_name), ls = suffix ? strlen(suffix) : 0;
        if (de->d_name[0] == '.') continue;
        if (suffix && (ln < ls || strcmp(de->d_name + ln - ls, suffix))) continue;
        snprintf(path, sizeof(path), "%s/%s", dir, de->d_name);
        diff_file(path, s);
        (*nfiles)++;
    }
    closedir(dp);
}

static int yaml_keys_plant(void) {
    RtxDoc d = {0} @destroy;
    size_t k, keys = 0;
    @errhandler(CCError e) {
        (void)e;
        return 0;
    }
    d.from_path(cc_slice_cstr("testdata/rich/code/embeds.yaml")) !>;
    for (k = 0; k < d.runs.len; k++) {
        const char *sc = rtx_scope_name(d.runs.data[k].style.scope);
        if (sc && !strcmp(sc, "entity.name.tag.yaml")) keys++;
    }
    printf("yaml keys planted: %zu\n", keys);
    return keys >= 4;
}

int main(void) {
    static const char *exts[] = {"x.c", "x.css", "x.csv", "x.html", "x.js",
                                 "x.json", "x.md", "x.py", "x.sh", "x.yaml", NULL};
    RtxRxScratch s = {0};
    size_t i, nfiles = 0, fails = 0, total[5] = {0, 0, 0, 0, 0};
    for (i = 0; exts[i]; i++) {
        const RtxTmRt *rt = rtx_tm_for_path(exts[i]);
        if (!rt) {
            fprintf(stderr, "FAIL: no grammar for %s\n", exts[i]);
            fails++;
            continue;
        }
        add_rules(exts[i] + 2, rt->rules.data, rt->rules.len);
        add_rules(exts[i] + 2, rt->inners.data, rt->inners.len);
    }
    if (rtx_tm_rx_errors) {
        fprintf(stderr, "FAIL: %zu grammar patterns refused: %s\n", rtx_tm_rx_errors,
                rtx_tm_rx_err);
        fails++;
    }
    diff_dir("testdata/rich/code", NULL, &s, &nfiles);
    diff_dir("testdata/rich/md", NULL, &s, &nfiles);
    diff_dir("testdata/samples", NULL, &s, &nfiles);
    diff_dir("testdata", ".csv", &s, &nfiles);
    diff_dir("docs", ".md", &s, &nfiles);
    for (i = 0; i < npats; i++) {
        DiffPat *d = &pats[i];
        size_t c, nd = d->n[0] + d->n[1] + d->n[2] + d->n[3] + d->n[4];
        for (c = 0; c < 5; c++) total[c] += d->n[c];
        if (!nd) continue;
        printf("%-5s /%.*s/  same=%zu  C=%zu A=%zu L=%zu R=%zu U=%zu\n", d->lang,
               (int)d->plen, d->pat, d->same, d->n[0], d->n[1], d->n[2], d->n[3], d->n[4]);
        for (c = 0; c < (size_t)d->nex; c++) printf("        %s\n", d->ex[c]);
        if (d->n[4]) fails++;
    }
    if (!yaml_keys_plant()) {
        fprintf(stderr, "FAIL: yaml keys (^) do not plant\n");
        fails++;
    }
    printf("tm_rx_diff: %zu patterns x %zu offsets in %zu files; diffs C=%zu A=%zu L=%zu R=%zu U=%zu\n",
           npats, positions, nfiles, total[0], total[1], total[2], total[3], total[4]);
    rtx_rx_scratch_drop(&s);
    if (fails) {
        fprintf(stderr, "tm_rx_diff_smoke: %zu failures\n", fails);
        return 1;
    }
    printf("tm_rx_diff_smoke ok\n");
    return 0;
}
