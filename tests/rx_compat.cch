/*
 * Test shim: the retired tm_re names, answered by the regex engine
 * (core/rx.cch) the TM lexer now uses. Anchored, window-bounded,
 * zero-length hits rejected — the old contract these smokes assert.
 * Single-threaded tests only (one shared scratch / arena).
 */
#ifndef RTX_RX_COMPAT_H
#define RTX_RX_COMPAT_H

#include "../core/rx.cch"

typedef RtxRxCaps RtxReCaps;

static CCArena rtx_compat_a;
static RtxRxScratch rtx_compat_s;

static const RtxRx *rtx_compat_rx(const char *pat, size_t plen) {
    RtxRx *rx;
    if (!rtx_compat_a.base) rtx_compat_a = cc_arena_heap(kilobytes(256));
    if (!rtx_compat_a.base) return NULL;
    rx = rtx_rx_compile(cc_slice_from_buffer((void *)pat, plen), 0, rtx_compat_a) !>(e) {
        (void)e;
        return NULL;
    };
    return rx;
}

static int rtx_re_match_caps(const char *pat, size_t plen, const char *t, size_t at,
                             size_t n, size_t *end, RtxReCaps *caps) {
    const RtxRx *rx = rtx_compat_rx(pat, plen);
    RtxRxIn in;
    size_t e = 0;
    if (!rx || !t || !end) return 0;
    memset(&in, 0, sizeof(in));
    in.s = t;
    in.n = n;
    in.gpos = RTX_RX_UNSET;
    in.ctx = RTX_RX_CTX_BOL0 | RTX_RX_CTX_BOT0;
    if (rtx_rx_at(rx, &in, at, &rtx_compat_s, &e, caps) != RTX_RX_MATCH || e <= at)
        return 0;
    *end = e;
    return 1;
}

static int rtx_re_match(const char *pat, size_t plen, const char *t, size_t at, size_t n,
                        size_t *end) {
    return rtx_re_match_caps(pat, plen, t, at, n, end, NULL);
}

static int rtx_re_first(const char *pat, size_t plen) {
    const RtxRx *rx = rtx_compat_rx(pat, plen);
    return rx ? rtx_rx_first_byte(rx) : -1;
}

#endif /* RTX_RX_COMPAT_H */
