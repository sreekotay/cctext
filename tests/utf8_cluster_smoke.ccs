#!ccc ccs
/*
 * UAX #29 extended grapheme clusters: rtx_utf8_cluster / next / prev / align
 * plus the official GraphemeBreakTest.txt fixture (Unicode 17.0.0).
 */
#include <ccc/std/prelude.cch>
#include <ccc/stdio.cch>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include "../core/utf8.cch"
#include "../core/document.cch"

static int fails = 0;

static void expect(int cond, const char *msg) {
    if (!cond) {
        fprintf(stderr, "FAIL: %s\n", msg);
        fails++;
    }
}

static FILE *open_gbt(void) {
    const char *paths[] = {
        "testdata/unicode/GraphemeBreakTest.txt",
        "../testdata/unicode/GraphemeBreakTest.txt",
        NULL,
    };
    int i;
    for (i = 0; paths[i]; i++) {
        FILE *f = fopen(paths[i], "r");
        if (f) return f;
    }
    return NULL;
}

static int is_div(const char *s) {
    return (unsigned char)s[0] == 0xC3 && (unsigned char)s[1] == 0xB7;
}

static int is_mul(const char *s) {
    return (unsigned char)s[0] == 0xC3 && (unsigned char)s[1] == 0x97;
}

/* One GBT data line → code points + break-before (including sot, excluding eot). */
static int parse_gbt(const char *line, uint32_t *cps, int *brk, int cap, int *ncp) {
    const char *s = line;
    int n = 0;
    int want_mark = 1;
    *ncp = 0;
    while (*s && *s != '#' && *s != '\n' && *s != '\r') {
        while (*s == ' ' || *s == '\t') s++;
        if (!*s || *s == '#' || *s == '\n' || *s == '\r') break;
        if (want_mark) {
            if (is_div(s)) {
                if (n < cap) brk[n] = 1;
                s += 2;
            } else if (is_mul(s)) {
                if (n < cap) brk[n] = 0;
                s += 2;
            } else {
                return 0;
            }
            want_mark = 0;
        } else {
            char *end = NULL;
            unsigned long v = strtoul(s, &end, 16);
            if (end == s || v > 0x10FFFFul) return 0;
            if (n >= cap) return 0;
            cps[n++] = (uint32_t)v;
            s = end;
            want_mark = 1;
        }
    }
    /* Ended after the final ÷ (want_mark == 0). n code points, n+1 marks. */
    if (want_mark || n < 1) return 0;
    *ncp = n;
    return 1;
}

static int run_gbt(void) {
    FILE *f = open_gbt();
    char line[2048];
    int lineno = 0, cases = 0, skipped = 0;
    if (!f) {
        expect(0, "open testdata/unicode/GraphemeBreakTest.txt");
        return 0;
    }
    while (fgets(line, sizeof(line), f)) {
        uint32_t cps[64];
        int brk[65];
        char buf[512];
        size_t off[65];
        size_t nbytes = 0;
        int ncp = 0, i, enc_ok;
        char[:] bytes;
        lineno++;
        if (!parse_gbt(line, cps, brk, 64, &ncp)) continue;
        enc_ok = 1;
        off[0] = 0;
        for (i = 0; i < ncp; i++) {
            char tmp[4];
            int nb = rtx_utf8_encode(cps[i], tmp);
            if (nb <= 0 || nbytes + (size_t)nb > sizeof(buf)) {
                enc_ok = 0;
                break;
            }
            {
                int b;
                for (b = 0; b < nb; b++) buf[nbytes + (size_t)b] = tmp[b];
            }
            nbytes += (size_t)nb;
            off[i + 1] = nbytes;
        }
        if (!enc_ok) {
            skipped++;
            continue;
        }
        cases++;
        bytes = buf.to_slice_n(nbytes);
        {
            size_t k = 0;
            int ci = 0;
            expect(brk[0], "GBT sot ÷");
            while (k < nbytes) {
                RtxUtf8Cl cl;
                size_t a, mid;
                while (ci < ncp && off[ci] < k) ci++;
                if (ci >= ncp || off[ci] != k || !brk[ci]) {
                    fprintf(stderr, "FAIL: GBT line %d extra/missing break at byte %zu\n",
                            lineno, k);
                    fails++;
                    break;
                }
                cl = rtx_utf8_cluster(bytes, k);
                if (cl.n == 0) {
                    fprintf(stderr, "FAIL: GBT line %d empty cluster at %zu\n", lineno, k);
                    fails++;
                    break;
                }
                a = k;
                k += cl.n;
                if (k > nbytes) {
                    fprintf(stderr, "FAIL: GBT line %d cluster overruns\n", lineno);
                    fails++;
                    break;
                }
                for (mid = a + 1; mid < k; mid++) {
                    if (rtx_utf8_align(bytes, mid) != a) {
                        fprintf(stderr, "FAIL: GBT line %d align(%zu) != %zu\n",
                                lineno, mid, a);
                        fails++;
                        break;
                    }
                }
            }
            if (k == nbytes) {
                int last = ncp;
                while (last > 0 && !brk[last]) last--;
                if (off[ncp] != k) {
                    expect(0, "GBT eot byte");
                }
            }
        }
        {
            size_t k = 0;
            while (k < nbytes) {
                size_t nx = rtx_utf8_next(bytes, k);
                if (nx <= k) {
                    expect(0, "GBT next stuck");
                    break;
                }
                k = nx;
            }
            expect(k == nbytes, "GBT next walks to end");
            k = nbytes;
            while (k > 0) {
                size_t pr = rtx_utf8_prev(bytes, k);
                if (pr >= k) {
                    expect(0, "GBT prev stuck");
                    break;
                }
                k = pr;
            }
            expect(k == 0, "GBT prev walks to start");
        }
    }
    fclose(f);
    fprintf(stderr, "GraphemeBreakTest: %d cases (%d skipped encode)\n", cases, skipped);
    expect(cases > 700, "GBT loaded enough cases");
    expect(skipped == 0, "GBT skipped none (no surrogates)");
    return cases;
}

int main(void) {
    @errhandler(CCError e) { cc_error_log(e); return 1; }
    {
        char comb[3];
        RtxUtf8Cl cl;
        comb[0] = 'e';
        comb[1] = (char)0xCC;
        comb[2] = (char)0x81;
        cl = rtx_utf8_cluster(comb.to_slice_n(3), 0);
        expect(cl.n == 3 && cl.cols == 1 && cl.cp == 'e', "e + U+0301");
    }
    {
        char zwj[11];
        RtxUtf8Cl cl;
        zwj[0] = (char)0xF0; zwj[1] = (char)0x9F; zwj[2] = (char)0x91;
        zwj[3] = (char)0xA9;
        zwj[4] = (char)0xE2; zwj[5] = (char)0x80; zwj[6] = (char)0x8D;
        zwj[7] = (char)0xF0; zwj[8] = (char)0x9F; zwj[9] = (char)0x92;
        zwj[10] = (char)0xBB;
        cl = rtx_utf8_cluster(zwj.to_slice_n(11), 0);
        expect(cl.n == 11 && cl.cols == 2, "woman technologist");
        expect(rtx_utf8_align(zwj.to_slice_n(11), 6) == 0, "align mid-ZWJ");
    }
    {
        char flag[8];
        RtxUtf8Cl cl;
        flag[0] = (char)0xF0; flag[1] = (char)0x9F; flag[2] = (char)0x87;
        flag[3] = (char)0xBA;
        flag[4] = (char)0xF0; flag[5] = (char)0x9F; flag[6] = (char)0x87;
        flag[7] = (char)0xB8;
        cl = rtx_utf8_cluster(flag.to_slice_n(8), 0);
        expect(cl.n == 8 && cl.cols == 2, "US flag");
        expect(rtx_utf8_align(flag.to_slice_n(8), 3) == 0, "align mid-flag");
    }
    {
        char vs[6];
        RtxUtf8Cl cl;
        /* U+2601 CLOUD + VS16 */
        vs[0] = (char)0xE2; vs[1] = (char)0x98; vs[2] = (char)0x81;
        vs[3] = (char)0xEF; vs[4] = (char)0xB8; vs[5] = (char)0x8F;
        cl = rtx_utf8_cluster(vs.to_slice_n(6), 0);
        expect(cl.n == 6 && cl.cols == 2, "VS16 emoji presentation cols 2");
    }
    {
        char inv[1];
        RtxUtf8Cl cl;
        inv[0] = (char)0xFF;
        cl = rtx_utf8_cluster(inv.to_slice_n(1), 0);
        expect(cl.n == 1 && cl.cp == RTX_UTF8_FFFD && cl.cols == 1,
               "invalid byte");
    }
    {
        RtxDoc d = {0} @destroy;
        d.from_buffer("\xF0\x9F\x91\xA9\xE2\x80\x8D\xF0\x9F\x92\xBB") !>;
        {
            size_t _v = d.cluster_next(0) !>;
            expect(_v == 11, "doc cluster_next ZWJ");
        }
        {
            size_t _v = d.cluster_prev(11) !>;
            expect(_v == 0, "doc cluster_prev ZWJ");
        }
        {
            size_t _v = d.cluster_align(4) !>;
            expect(_v == 0, "doc cluster_align mid-ZWJ");
        }
    }
    run_gbt();
    if (fails) {
        printf("utf8_cluster_smoke failed (%d)\n", fails);
        return 1;
    }
    printf("utf8_cluster_smoke ok\n");
    return 0;
}
