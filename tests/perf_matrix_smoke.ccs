#!ccc ccs
/*
 * Timed ops across a path-backed fixture for perf results tables.
 *
 *   ./bin/perf_matrix_smoke path [size_label]
 *
 * Each op is isolated: destroy + from_path, then only that op. A prior
 * jump must not cheapen insert_mid (prepare_edit scans to the offset).
 * RTX_PERF_TRIALS (default 5) repeats each op; RESULT is the minimum ms.
 *
 * Emits RESULT lines:
 *   RESULT size=8G op=open ms=0.031
 *   RESULT size=8G op=rss_open bytes=8601600
 *   RESULT size=8G op=rss_peak bytes=9543680
 */
#include <ccc/std/prelude.cch>
#include <ccc/script/stdio.cch>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <sys/resource.h>
#include <time.h>
#include <unistd.h>
#include "../core/document.cch"
#include "../core/layout.cch"

#define RTX_PERF_WRAP_WIDTH 40.0

static double perf_meas(void *ctx, char[:] bytes, RtxStyle style, RtxSectionKind sec) {
    (void)ctx;
    (void)style;
    (void)sec;
    return (double)bytes.len;
}

static double perf_lh(void *ctx, RtxStyle style, RtxSectionKind sec) {
    (void)ctx;
    (void)style;
    (void)sec;
    return 1.0;
}

#define RTX_PERF_DEFAULT_TRIALS 5
/* Same byte distance on every fixture. line 100000 was EOF on the ~3 MiB
 * text file and a prefix on 8G — that made RSS and jump times incomparable. */
#define RTX_PERF_JUMP_BYTES (1024 * 1024)

static double mono_ms(void) {
    struct timespec ts;
    if (clock_gettime(CLOCK_MONOTONIC, &ts) != 0) return 0.0;
    return (double)ts.tv_sec * 1000.0 + (double)ts.tv_nsec / 1.0e6;
}

static void emit(const char *size, const char *op, double ms) {
    printf("RESULT size=%s op=%s ms=%.3f\n", size, op, ms);
    fflush(stdout);
}

static size_t peak_rss_bytes(void) {
    struct rusage ru;
    if (getrusage(RUSAGE_SELF, &ru) != 0) return 0;
#if defined(__APPLE__)
    return (size_t)ru.ru_maxrss;
#else
    return (size_t)ru.ru_maxrss * 1024;
#endif
}

static void emit_bytes(const char *size, const char *op, size_t bytes) {
    printf("RESULT size=%s op=%s bytes=%zu\n", size, op, bytes);
    fflush(stdout);
}

static int trials_from_env(void) {
    const char *e = getenv("RTX_PERF_TRIALS");
    int n;
    if (!e || !e[0]) return RTX_PERF_DEFAULT_TRIALS;
    n = atoi(e);
    if (n < 1) return 1;
    if (n > 32) return 32;
    return n;
}

static void best_note(double *best, double ms, size_t *rss_peak) {
    size_t r;
    if (ms < *best) *best = ms;
    r = peak_rss_bytes();
    if (r > *rss_peak) *rss_peak = r;
}

static void !>(CCError) fresh_open(RtxDoc *d, const char *src) {
    d->destroy();
    d->from_path(src) !>(e) { return cc_err(e); };
    return cc_ok();
}

int main(int argc, char **argv) {
    const char *src = "testdata/generated/large.txt";
    const char *size = "large";
    RtxDoc d = {0};
    size_t n, jump_at, screen, rss_open, rss_peak;
    char ch = 'x';
    char nl = '\n';
    double t0, ms, best;
    size_t i;
    int trials, trial;

    screen = 40;
    if (argc > 1) src = argv[1];
    if (argc > 2) size = argv[2];
    if (access(src, R_OK) != 0) {
        fprintf(stderr, "perf_matrix_smoke: missing %s\n", src);
        return 1;
    }
    trials = trials_from_env();

    @errhandler(CCError e) {
        fprintf(stderr, "perf_matrix_smoke: %s\n", e.message ? e.message : "?");
        return 1;
    }
    @errhandler(RtxIndexErr e) {
        fprintf(stderr, "%s\n", e.message ? e.message : "index");
        return 1;
    }

    /* Length only. Do not scan — a line_start probe would pull the whole
     * small fixture into the page cache and inflate rss_peak. */
    d.from_path(src) !>;
    n = d.len();
    rss_open = peak_rss_bytes();
    rss_peak = rss_open;
    jump_at = (size_t)RTX_PERF_JUMP_BYTES;
    if (n <= jump_at) jump_at = n / 2;
    d.destroy();

    best = 1e300;
    for (trial = 0; trial < trials; trial++) {
        d.destroy();
        t0 = mono_ms();
        d.from_path(src) !>;
        ms = mono_ms() - t0;
        best_note(&best, ms, &rss_peak);
    }
    emit(size, "open", best);
    emit_bytes(size, "rss_open", rss_open);

    best = 1e300;
    for (trial = 0; trial < trials; trial++) {
        fresh_open(&d, src) !>;
        t0 = mono_ms();
        for (i = 0; i <= screen; i++) {
            size_t warm = d.line_start(i) !>;
            (void)warm;
        }
        ms = mono_ms() - t0;
        best_note(&best, ms, &rss_peak);
    }
    emit(size, "scroll_40", best);

    best = 1e300;
    for (trial = 0; trial < trials; trial++) {
        RtxLayout L = {0};
        RtxMeasure m;
        m.measure = perf_meas;
        m.line_height = perf_lh;
        m.ctx = NULL;
        fresh_open(&d, src) !>;
        rtx_layout_set_view(&L, RTX_VIEW_WRAP);
        t0 = mono_ms();
        L.fill(&d, &m, RTX_PERF_WRAP_WIDTH, 0, screen) !>;
        ms = mono_ms() - t0;
        L.destroy();
        best_note(&best, ms, &rss_peak);
    }
    emit(size, "wrap_40", best);

    best = 1e300;
    for (trial = 0; trial < trials; trial++) {
        fresh_open(&d, src) !>;
        t0 = mono_ms();
        {
            size_t ln = d.line_of(jump_at) !>;
            (void)ln;
        }
        ms = mono_ms() - t0;
        best_note(&best, ms, &rss_peak);
    }
    emit(size, "jump_1m", best);

    best = 1e300;
    for (trial = 0; trial < trials; trial++) {
        RtxLayout L = {0};
        RtxMeasure m;
        m.measure = perf_meas;
        m.line_height = perf_lh;
        m.ctx = NULL;
        fresh_open(&d, src) !>;
        rtx_layout_set_view(&L, RTX_VIEW_WRAP);
        t0 = mono_ms();
        L.fill_off(&d, &m, RTX_PERF_WRAP_WIDTH, jump_at, screen) !>;
        ms = mono_ms() - t0;
        L.destroy();
        best_note(&best, ms, &rss_peak);
    }
    emit(size, "wrap_1m", best);

    best = 1e300;
    for (trial = 0; trial < trials; trial++) {
        fresh_open(&d, src) !>;
        t0 = mono_ms();
        d.insert(0, cc_slice_from_buffer(&ch, 1)) !>;
        ms = mono_ms() - t0;
        best_note(&best, ms, &rss_peak);
    }
    emit(size, "insert_bof", best);

    best = 1e300;
    for (trial = 0; trial < trials; trial++) {
        fresh_open(&d, src) !>;
        t0 = mono_ms();
        d.insert(d.len(), cc_slice_from_buffer(&ch, 1)) !>;
        ms = mono_ms() - t0;
        best_note(&best, ms, &rss_peak);
    }
    emit(size, "insert_eof", best);

    if (jump_at > 0 && jump_at < n) {
        best = 1e300;
        for (trial = 0; trial < trials; trial++) {
            fresh_open(&d, src) !>;
            t0 = mono_ms();
            d.insert(jump_at, cc_slice_from_buffer(&ch, 1)) !>;
            ms = mono_ms() - t0;
            best_note(&best, ms, &rss_peak);
        }
        emit(size, "insert_mid", best);

        best = 1e300;
        for (trial = 0; trial < trials; trial++) {
            fresh_open(&d, src) !>;
            t0 = mono_ms();
            d.insert(jump_at, cc_slice_from_buffer(&nl, 1)) !>;
            ms = mono_ms() - t0;
            best_note(&best, ms, &rss_peak);
        }
        emit(size, "newline_mid", best);
    }

    emit_bytes(size, "rss_peak", rss_peak);

    best = 1e300;
    for (trial = 0; trial < trials; trial++) {
        fresh_open(&d, src) !>;
        t0 = mono_ms();
        d.destroy();
        ms = mono_ms() - t0;
        best_note(&best, ms, &rss_peak);
    }
    emit(size, "close", best);

    printf("perf_matrix_smoke ok  path=%s  size=%s  bytes=%zu  trials=%d  "
           "best_of=min isolated=1\n",
           src, size, n, trials);
    return 0;
}
