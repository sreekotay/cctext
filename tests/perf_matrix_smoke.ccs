#!ccc ccs
/*
 * Timed ops across a path-backed fixture for perf results tables.
 *
 *   ./bin/perf_matrix_smoke path [size_label]
 *
 * Emits RESULT lines:
 *   RESULT size=8G op=open ms=0.031
 *   RESULT size=8G op=rss_open bytes=8601600
 *   RESULT size=8G op=rss_peak bytes=9543680
 */
#include <ccc/std/prelude.cch>
#include <ccc/script/stdio.cch>
#include <stdio.h>
#include <string.h>
#include <sys/resource.h>
#include <time.h>
#include <unistd.h>
#include "../core/document.cch"

static double mono_ms(void) {
    struct timespec ts;
    if (clock_gettime(CLOCK_MONOTONIC, &ts) != 0) return 0.0;
    return (double)ts.tv_sec * 1000.0 + (double)ts.tv_nsec / 1.0e6;
}

static void emit(const char *size, const char *op, double ms) {
    printf("RESULT size=%s op=%s ms=%.3f\n", size, op, ms);
    fflush(stdout);
}

static size_t peak_rss_bytes(void) {
    struct rusage ru;
    if (getrusage(RUSAGE_SELF, &ru) != 0) return 0;
#if defined(__APPLE__)
    return (size_t)ru.ru_maxrss;
#else
    return (size_t)ru.ru_maxrss * 1024;
#endif
}

static void emit_bytes(const char *size, const char *op, size_t bytes) {
    printf("RESULT size=%s op=%s bytes=%zu\n", size, op, bytes);
    fflush(stdout);
}

int main(int argc, char **argv) {
    const char *src = "testdata/generated/large.txt";
    const char *size = "large";
    RtxDoc *d;
    size_t n, mid, screen;
    char ch = 'x';
    char nl = '\n';
    double t0, ms;
    size_t i;

    screen = 40;
    if (argc > 1) src = argv[1];
    if (argc > 2) size = argv[2];
    if (access(src, R_OK) != 0) {
        fprintf(stderr, "perf_matrix_smoke: missing %s\n", src);
        return 1;
    }

    @errhandler(CCError e) {
        fprintf(stderr, "perf_matrix_smoke: %s\n", e.message ? e.message : "?");
        return 1;
    }
    @errhandler(RtxIndexErr e) {
        fprintf(stderr, "%s\n", e.message ? e.message : "index");
        return 1;
    }

    d = (RtxDoc *)calloc(1, sizeof(RtxDoc));
    if (!d) return 1;

    t0 = mono_ms();
    d->from_path(src) !>;
    ms = mono_ms() - t0;
    emit(size, "open", ms);
    emit_bytes(size, "rss_open", peak_rss_bytes());
    n = d->len();

    t0 = mono_ms();
    for (i = 0; i <= screen; i++) {
        size_t warm = d->line_start(i) !>;
        (void)warm;
    }
    ms = mono_ms() - t0;
    emit(size, "scroll_40", ms);

    t0 = mono_ms();
    mid = d->line_start(100000) !>;
    ms = mono_ms() - t0;
    if (mid > 0 && mid < n) emit(size, "jump_100k", ms);
    else emit(size, "jump_100k", ms); /* still report; may clamp on small files */

    t0 = mono_ms();
    d->insert(0, cc_slice_from_buffer(&ch, 1)) !>;
    ms = mono_ms() - t0;
    emit(size, "insert_bof", ms);

    t0 = mono_ms();
    d->insert(d->len(), cc_slice_from_buffer(&ch, 1)) !>;
    ms = mono_ms() - t0;
    emit(size, "insert_eof", ms);

    if (mid > 0 && mid < d->len()) {
        t0 = mono_ms();
        d->insert(mid, cc_slice_from_buffer(&ch, 1)) !>;
        ms = mono_ms() - t0;
        emit(size, "insert_mid", ms);

        t0 = mono_ms();
        d->insert(mid + 1, cc_slice_from_buffer(&nl, 1)) !>;
        ms = mono_ms() - t0;
        emit(size, "newline_mid", ms);
    }

    emit_bytes(size, "rss_peak", peak_rss_bytes());

    t0 = mono_ms();
    d->destroy();
    ms = mono_ms() - t0;
    emit(size, "close", ms);
    free(d);

    printf("perf_matrix_smoke ok  path=%s  size=%s  bytes=%zu\n", src, size, n);
    return 0;
}
