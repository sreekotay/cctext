#!ccc ccs
/*
 * Phase breakdown for a path-backed insert (why 2M insert_mid is ~2ms).
 *
 *   ./bin/insert_profile [path]
 */
#include <ccc/std/prelude.cch>
#include <ccc/script/stdio.cch>
#include <stdio.h>
#include <string.h>
#include <time.h>
#include <unistd.h>
#include "../core/document.cch"
#include "../core/find.cch"

static double mono_ms(void) {
    struct timespec ts;
    if (clock_gettime(CLOCK_MONOTONIC, &ts) != 0) return 0.0;
    return (double)ts.tv_sec * 1000.0 + (double)ts.tv_nsec / 1.0e6;
}

static void dump_prof(const char *label, double wall, const RtxInsertProf *p) {
    printf("%-22s  wall=%7.3f  prepare=%7.3f  split=%6.3f  add=%6.3f  "
           "note=%6.3f  lf %d→%d  huge=%d  ext=%d  scan %zu→%zu  slots %zu→%zu\n",
           label, wall, p->prepare_ms, p->split_ms, p->add_ms, p->note_ms,
           p->lf_ready0, p->lf_ready1, p->huge, p->extended,
           p->scan0, p->scan1, p->line_off0, p->line_off1);
}

int main(int argc, char **argv) {
    const char *src = "testdata/generated/large.txt";
    RtxDoc d = {0};
    size_t n, mid, jump;
    char ch = 'x';
    char nl = '\n';
    double t0, wall;
    RtxInsertProf p;
    int i;
    char label[40];

    if (argc > 1) src = argv[1];
    if (access(src, R_OK) != 0) {
        fprintf(stderr, "insert_profile: missing %s\n", src);
        return 1;
    }

    @errhandler(CCError e) {
        fprintf(stderr, "insert_profile: %s\n", e.message ? e.message : "?");
        return 1;
    }
    @errhandler(RtxIndexErr e) {
        fprintf(stderr, "%s\n", e.message ? e.message : "index");
        return 1;
    }

    d.from_path(src) !>;
    n = d.len();
    mid = (size_t)(1024 * 1024);
    if (mid >= n) mid = n / 2;
    d.destroy();
    printf("path=%s  bytes=%zu  mid=%zu  soft_min=%d  huge=%d\n",
           src, n, mid, (int)RTX_LINE_SOFT_MIN, n > (size_t)RTX_LINE_SOFT_MIN);

    d.from_path(src) !>;
    RtxPieceTree_profile_insert(&d.tree, 1);
    t0 = mono_ms();
    d.insert(0, cc_slice_from_buffer(&ch, 1)) !>;
    wall = mono_ms() - t0;
    p = RtxPieceTree_insert_prof(&d.tree);
    dump_prof("cold insert_bof", wall, &p);
    d.destroy();

    d.from_path(src) !>;
    RtxPieceTree_profile_insert(&d.tree, 1);
    t0 = mono_ms();
    d.insert(mid, cc_slice_from_buffer(&ch, 1)) !>;
    wall = mono_ms() - t0;
    p = RtxPieceTree_insert_prof(&d.tree);
    dump_prof("cold insert_mid", wall, &p);
    d.destroy();

    d.from_path(src) !>;
    RtxPieceTree_profile_insert(&d.tree, 1);
    t0 = mono_ms();
    d.insert(mid, cc_slice_from_buffer(&nl, 1)) !>;
    wall = mono_ms() - t0;
    p = RtxPieceTree_insert_prof(&d.tree);
    dump_prof("cold newline_mid", wall, &p);
    d.destroy();

    d.from_path(src) !>;
    t0 = mono_ms();
    jump = d.line_of(mid) !>;
    wall = mono_ms() - t0;
    (void)jump;
    printf("%-22s  wall=%7.3f  (line_of 1MiB only)\n", "jump_1m", wall);
    RtxPieceTree_profile_insert(&d.tree, 1);
    t0 = mono_ms();
    d.insert(mid, cc_slice_from_buffer(&ch, 1)) !>;
    wall = mono_ms() - t0;
    p = RtxPieceTree_insert_prof(&d.tree);
    dump_prof("after-jump insert_mid", wall, &p);
    RtxPieceTree_profile_insert(&d.tree, 1);
    t0 = mono_ms();
    d.insert(mid + 1, cc_slice_from_buffer(&ch, 1)) !>;
    wall = mono_ms() - t0;
    p = RtxPieceTree_insert_prof(&d.tree);
    dump_prof("2nd insert_mid", wall, &p);
    d.destroy();

    d.from_path(src) !>;
    jump = d.line_of(mid) !>;
    (void)jump;
    RtxPieceTree_profile_insert(&d.tree, 1);
    t0 = mono_ms();
    d.insert(mid, cc_slice_from_buffer(&nl, 1)) !>;
    wall = mono_ms() - t0;
    p = RtxPieceTree_insert_prof(&d.tree);
    dump_prof("after-jump newline", wall, &p);
    d.destroy();

    for (i = 0; i < 3; i++) {
        d.from_path(src) !>;
        RtxPieceTree_profile_insert(&d.tree, 1);
        t0 = mono_ms();
        d.insert(mid, cc_slice_from_buffer(&ch, 1)) !>;
        wall = mono_ms() - t0;
        p = RtxPieceTree_insert_prof(&d.tree);
        snprintf(label, sizeof(label), "cold mid #%d", i + 1);
        dump_prof(label, wall, &p);
        d.destroy();
    }

    return 0;
}
