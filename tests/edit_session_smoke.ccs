        expect(cli.nfiles == 1, "cli --backup keeps files");
        av[1] = (char *)"--stats-json";
        av[2] = (char *)"testdata/small.txt";
        expect(rtx_cli_parse(3, av, files, 4, &cli) == 0 && cli.stats_json,
               "cli --stats-json");
        expect(cli.nfiles == 1, "cli --stats-json keeps files");
        {
            RtxWs w = {0} @destroy;
            char *paths[1];
            char jpath[128];
            FILE *jf;
            char got[2048];
            size_t n;
            paths[0] = (char *)"testdata/small.txt";
            w.open_files(1, paths) !>;
            snprintf(jpath, sizeof(jpath),
                     "testdata/generated/stats_json_smoke.json");
            jf = fopen(jpath, "w");
            expect(jf != NULL, "stats-json file");
            if (jf) {
                rtx_ui_write_stats_json(jf, w.active());
                fclose(jf);
            }
            jf = fopen(jpath, "r");
            expect(jf != NULL, "stats-json reread");
            n = jf ? fread(got, 1, sizeof(got) - 1, jf) : 0;
            if (jf) fclose(jf);
            got[n] = 0;
            expect(n > 0 && strstr(got, "\"file\"") && strstr(got, "\"lines\"") &&
                       strstr(got, "\"grammar\"") && strstr(got, "\"pair\""),
                   "stats-json shape");
            expect(strstr(got, "\"bytes\":12") != NULL, "stats-json small.txt bytes");
            expect(strstr(got, "\"find\":null") != NULL, "stats-json no find");
            unlink(jpath);
        }
        av[1] = (char *)"--view";
        av[2] = (char *)"nope";
        expect(rtx_cli_parse(3, av, files, 4, &cli) != 0, "cli bad view");
        av[1] = (char *)"--wrap";
        av[2] = (char *)"testdata/small.txt";
        av[3] = (char *)"--hex";
        av[4] = (char *)"testdata/mixed.txt";
        expect(rtx_cli_parse(5, av, files, 4, &cli) == 0, "cli per-file view");
        expect(cli.nfiles == 2, "cli two files");
        expect(cli.file_view[0] == RTX_VIEW_WRAP && cli.file_view[1] == RTX_VIEW_HEX,
               "each file keeps its view flag");
        expect(cli.file_view_set[0] && cli.file_view_set[1],
               "view flags mark those files");
        av[1] = (char *)"testdata/small.txt";
        expect(rtx_cli_parse(2, av, files, 4, &cli) == 0, "cli file only");
        expect(!cli.view_set && !cli.file_view_set[0],
               "no --view leaves the journal view");
    }

