        d.empty() !>;
        d.type("a") !>;
        RtxPieceTree_fail_next_replace(&d.tree, 1);
        {
            CCError e = {0};
            saw = try_type(&d, "b", &e);
            expect(saw, "type b unrestorable");
            expect(rtx_err_is_unrestorable(e), "unrestorable kind");
        }
        expect(d.broken, "doc copies unrestorable onto broken");
        {
            CCError e = {0};
            saw = try_type(&d, "c", &e);
            expect(saw, "edit refused");
            expect(e.kind == CC_ERR_INTERNAL, "broken refuses edits");
        }
        expect_text(&d, "a", "unrestorable one-shot does not mutate");
    }

    {
