        expect(w.nav[0].boot, "no-file browse is boot");
        expect(w.browse_close() == 1, "closing boot browse without a pick quits");
        w.browse_start() !>;
        w.open_in_pane("testdata/small.txt") !>;
        expect(!w.untitled() && w.len == 1, "pick replaces untitled");
        expect(!w.browsing(), "pick closes the browser");
