#!ccc ccs
/*
 * Save, undo/redo, selection, incremental layout, multifile workspace.
 */
#include <ccc/std/prelude.cch>
#include <ccc/stdio.cch>
#include <fcntl.h>
#include <stdint.h>
#include <stdio.h>
#include <string.h>
#include <sys/stat.h>
#include <sys/time.h>
#include <unistd.h>
#include "../core/document.cch"
#include "../core/layout.cch"
#include "../core/workspace.cch"
#include "../core/find.cch"
#include "../core/ui.cch"
#include "../core/browse.cch"

static int fails = 0;

static void expect(int cond, const char *msg) {
    if (!cond) {
        fprintf(stderr, "FAIL: %s\n", msg);
        fails++;
    }
}

static void expect_text(RtxDoc *d, const char *want, const char *msg) {
    size_t n = d->len();
    char buf[4096];
    size_t got;
    expect(n == strlen(want), msg);
    if (n >= sizeof(buf)) {
        expect(0, "expect_text buffer");
        return;
    }
    got = d->read_at(0, buf, n) !>;
    expect(got == n, msg);
    buf[n] = 0;
    expect(({ char[:] __s = cc_slice_from_buffer(buf, n); __s.eq_cstr(want); }), msg);
    if (n != strlen(want) || !({ char[:] __s = cc_slice_from_buffer(buf, n); __s.eq_cstr(want); })) {
        fprintf(stderr, "  got '%s' want '%s' (%s)\n", buf, want, msg);
    }
}

static double meas(void *ctx, char[:] bytes, RtxStyle style, RtxSectionKind sec) {
    (void)ctx;
    (void)style;
    (void)sec;
    return (double)bytes.len;
}

static double lh(void *ctx, RtxStyle style, RtxSectionKind sec) {
    (void)ctx;
    (void)style;
    (void)sec;
    return 1.0;
}

static void !>(CCError) browse_wait(RtxBrowse *br) {
    if (!br) return cc_ok();
    return rtx_browse_finish(br);
}

static int try_type(RtxDoc *d, char[:] s, CCError *out) {
    @errhandler(CCError e) {
        if (out) *out = e;
        return 1;
    }
    d->type(s) !>;
    return 0;
}

static int try_save(RtxDoc *d, CCError *out) {
    @errhandler(CCError e) {
        if (out) *out = e;
        return 1;
    }
    d->save() !>;
    return 0;
}

static void bump_mtime(const char *path) {
    struct timeval tv[2];
    tv[0].tv_sec = 1;
    tv[0].tv_usec = 0;
    tv[1] = tv[0];
    expect(utimes(path, tv) == 0, "utimes bump");
}

static uint32_t test_u32le(const unsigned char *p) {
    return (uint32_t)p[0] | ((uint32_t)p[1] << 8) | ((uint32_t)p[2] << 16) |
           ((uint32_t)p[3] << 24);
}

static uint64_t test_u64le(const unsigned char *p) {
    return (uint64_t)p[0] | ((uint64_t)p[1] << 8) | ((uint64_t)p[2] << 16) |
           ((uint64_t)p[3] << 24) | ((uint64_t)p[4] << 32) | ((uint64_t)p[5] << 40) |
           ((uint64_t)p[6] << 48) | ((uint64_t)p[7] << 56);
}

static void write_cstr_path(const char *path, const char *s) {
    FILE *f = fopen(path, "w");
    expect(f != NULL, "write_cstr_path");
    if (f) {
        fputs(s, f);
        fclose(f);
    }
}

static size_t read_path_bytes(const char *path, unsigned char *buf, size_t cap) {
    FILE *f = fopen(path, "rb");
    size_t n;
    if (!f) return (size_t)-1;
    n = fread(buf, 1, cap, f);
    fclose(f);
    return n;
}

static void expect_rtxb(const unsigned char *got, size_t n, uint64_t old_len,
                        uint64_t lo, const char *payload, const char *msg) {
    size_t pn = strlen(payload);
    expect(n == 24 + pn, msg);
    if (n < 24) return;
    expect(test_u32le(got) == 0x42585452u && test_u32le(got + 4) == 1, msg);
    expect(test_u64le(got + 8) == old_len && test_u64le(got + 16) == lo, msg);
    expect(n >= 24 + pn &&
               ({ char[:] __s = cc_slice_from_buffer((char *)got + 24, pn);
                  __s.eq_cstr(payload); }),
           msg);
}

static unsigned char pattern_at(size_t i) {
    return (unsigned char)(i & 0xff);
}

static void write_pattern_path(const char *path, size_t n) {
    FILE *f = fopen(path, "wb");
    size_t i;
    expect(f != NULL, "write_pattern_path");
    if (!f) return;
    for (i = 0; i < n; i++) {
        unsigned char c = pattern_at(i);
        if (fwrite(&c, 1, 1, f) != 1) {
            expect(0, "write_pattern byte");
            break;
        }
    }
    fclose(f);
}

static void expect_pattern_insert(const char *path, size_t oldn, size_t off,
                                  const char *ins, const char *msg) {
    FILE *f = fopen(path, "rb");
    size_t i, inslen = strlen(ins), newn = oldn + inslen;
    expect(f != NULL, msg);
    if (!f) return;
    for (i = 0; i < newn; i++) {
        int c = fgetc(f);
        unsigned char want;
        if (i < off) want = pattern_at(i);
        else if (i < off + inslen) want = (unsigned char)ins[i - off];
        else want = pattern_at(i - inslen);
        if (c != (int)want) {
            expect(0, msg);
            fprintf(stderr, "  %s at %zu got %d want %u\n", msg, i, c,
                    (unsigned)want);
            break;
        }
    }
    if (i == newn) expect(fgetc(f) == EOF, msg);
    fclose(f);
}

static void expect_pattern_delete(const char *path, size_t oldn, size_t off,
                                  size_t del, const char *msg) {
    FILE *f = fopen(path, "rb");
    size_t i, newn = oldn - del;
    expect(f != NULL, msg);
    if (!f) return;
    for (i = 0; i < newn; i++) {
        int c = fgetc(f);
        unsigned char want = pattern_at(i < off ? i : i + del);
        if (c != (int)want) {
            expect(0, msg);
            fprintf(stderr, "  %s at %zu got %d want %u\n", msg, i, c,
                    (unsigned)want);
            break;
        }
    }
    if (i == newn) expect(fgetc(f) == EOF, msg);
    fclose(f);
}

static int restore_rtxb(const char *path, const unsigned char *bak, size_t n) {
    uint64_t old_len, lo;
    size_t payload, off = 0;
    int fd;
    if (n < 24) return -1;
    old_len = test_u64le(bak + 8);
    lo = test_u64le(bak + 16);
    payload = n - 24;
    fd = open(path, O_WRONLY);
    if (fd < 0) return -1;
    if (lo && lseek(fd, (off_t)lo, SEEK_SET) < 0) {
        close(fd);
        return -1;
    }
    while (off < payload) {
        ssize_t w = write(fd, bak + 24 + off, payload - off);
        if (w <= 0) {
            close(fd);
            return -1;
        }
        off += (size_t)w;
    }
    if (ftruncate(fd, (off_t)old_len) != 0) {
        close(fd);
        return -1;
    }
    close(fd);
    return 0;
}

static int try_undo(RtxDoc *d, CCError *out) {
    @errhandler(CCError e) {
        if (out) *out = e;
        return 1;
    }
    d->undo() !>;
    return 0;
}

int main(void) {
    rtx_safe_test_isol();
    @errhandler(CCError e) { cc_error_log(e); return 1; }
    @errhandler(RtxIndexErr e) {
        fprintf(stderr, "%s\n", e.message ? e.message : "index");
        return 1;
    }
    RtxMeasure m;
    m.measure = meas;
    m.line_height = lh;
    m.ctx = NULL;

    {
        RtxDoc d = {0} @destroy;
        d.from_buffer("ab") !>;
        expect(!d.dirty(), "clean at open");
        d.caret = d.len();
        d.sel_anchor = d.caret;
        d.type("X") !>;
        expect_text(&d, "abX", "type at end");
        expect(d.caret == 3, "caret after type");
        expect(d.dirty(), "dirty after type");
        d.undo() !>;
        expect_text(&d, "ab", "undo type");
        expect(d.caret == 2, "caret restored");
        expect(!d.dirty(), "clean after undo to save point");
        d.redo() !>;
        expect_text(&d, "abX", "redo");
        expect(d.dirty(), "dirty after redo");
    }

    {
        RtxDoc d = {0} @destroy;
        const char *hello = "hello";
        size_t i;
        d.from_buffer("") !>;
        for (i = 0; i < 5; i++) {
            char s[2];
            s[0] = hello[i];
            s[1] = 0;
            d.type(s.to_slice_n(1)) !>;
        }
        expect_text(&d, "hello", "coalesced type");
        expect(d.hist.head == 1, "one hist rec for hello");
        d.undo() !>;
        expect_text(&d, "", "one undo removes hello");
        d.redo() !>;
        expect_text(&d, "hello", "redo hello");
    }

    {
        RtxDoc d = {0} @destroy;
        d.from_buffer("abcdef") !>;
        d.caret = 2;
        d.sel_anchor = 5;
        expect(d.has_sel(), "has sel");
        expect(d.sel_lo() == 2 && d.sel_hi() == 5, "sel range");
        d.type("Z") !>;
        expect_text(&d, "abZf", "type over sel");
        d.undo() !>;
        expect_text(&d, "abcdef", "undo replace sel");
        expect(d.caret == 2 && d.sel_anchor == 5, "sel restored");
    }

    {
        RtxDoc d = {0} @destroy;
        const char *path = "testdata/generated/save_roundtrip.txt";
        FILE *f;
        char got[64];
        size_t n;
        if (system("mkdir -p testdata/generated") != 0) expect(0, "mkdir");
        d.from_buffer("orig") !>;
        d.caret = d.len();
        d.sel_anchor = d.caret;
        d.type("-edit") !>;
        d.save_as(path) !>;
        expect(!d.dirty(), "clean after save");
        expect(d.path.eq_cstr(path), "path set");
        f = fopen(path, "r");
        expect(f != NULL, "saved file");
        n = f ? fread(got, 1, sizeof(got), f) : 0;
        if (f) fclose(f);
        expect(n == 9 && ({ char[:] __s = cc_slice_from_buffer(got, 9); __s.eq_cstr("orig-edit"); }), "file bytes");
        d.undo() !>;
        expect(d.dirty(), "dirty after undo past save");
        d.redo() !>;
        expect(!d.dirty(), "clean after redo to save");
        {
            RtxDoc d2 = {0} @destroy;
            d2.from_path(path) !>;
            expect_text(&d2, "orig-edit", "reopen saved");
        }
        unlink(path);
    }

    {
        RtxDoc d = {0} @destroy;
        const char *real = "testdata/generated/save_backup_real.txt";
        const char *link = "testdata/generated/save_backup_link.txt";
        const char *bak = "testdata/generated/save_backup_link.txt~";
        FILE *f;
        char got[64];
        size_t n;
        struct stat st;
        int prev = rtx_doc_save_backup();
        if (system("mkdir -p testdata/generated") != 0) expect(0, "mkdir");
        unlink(link);
        unlink(bak);
        unlink(real);
        f = fopen(real, "w");
        expect(f != NULL, "backup real create");
        if (f) {
            fputs("old", f);
            fclose(f);
        }
        expect(symlink("save_backup_real.txt", link) == 0, "backup symlink");
        rtx_doc_set_save_backup(1);
        d.from_path(link) !>;
        d.caret = d.len();
        d.sel_anchor = d.caret;
        d.type("-new") !>;
        d.save() !>;
        expect(lstat(link, &st) == 0 && S_ISLNK(st.st_mode), "link stays symlink");
        f = fopen(real, "r");
        expect(f != NULL, "target after backup save");
        n = f ? fread(got, 1, sizeof(got), f) : 0;
        if (f) fclose(f);
        expect(n == 7 && ({ char[:] __s = cc_slice_from_buffer(got, 7); __s.eq_cstr("old-new"); }),
               "target updated in place");
        expect(access(bak, F_OK) != 0, "append writes no path~");
        rtx_doc_set_save_backup(prev);
        unlink(link);
        unlink(bak);
        unlink(real);
    }

    {
        /* Same-length mid replace: path~ is RTXB + the overwritten old bytes. */
        RtxDoc d = {0} @destroy;
        const char *path = "testdata/generated/save_backup_span.txt";
        const char *bak = "testdata/generated/save_backup_span.txt~";
        FILE *f;
        unsigned char got[64];
        size_t n;
        int prev = rtx_doc_save_backup();
        uint32_t magic, ver;
        uint64_t old_len, lo;
        if (system("mkdir -p testdata/generated") != 0) expect(0, "mkdir");
        unlink(path);
        unlink(bak);
        f = fopen(path, "w");
        expect(f != NULL, "span dest create");
        if (f) {
            fputs("hello world", f);
            fclose(f);
        }
        rtx_doc_set_save_backup(1);
        d.from_path(path) !>;
        d.replace(6, 5, "there") !>;
        d.save() !>;
        f = fopen(path, "r");
        expect(f != NULL, "span dest after save");
        n = f ? fread(got, 1, sizeof(got), f) : 0;
        if (f) fclose(f);
        expect(n == 11 && ({ char[:] __s = cc_slice_from_buffer((char *)got, 11); __s.eq_cstr("hello there"); }),
               "span dest mid replace");
        f = fopen(bak, "r");
        expect(f != NULL, "span path~ written");
        n = f ? fread(got, 1, sizeof(got), f) : 0;
        if (f) fclose(f);
        expect(n == 24 + 5, "span path~ is header + dirty old bytes");
        magic = (uint32_t)got[0] | ((uint32_t)got[1] << 8) |
                ((uint32_t)got[2] << 16) | ((uint32_t)got[3] << 24);
        ver = (uint32_t)got[4] | ((uint32_t)got[5] << 8) |
              ((uint32_t)got[6] << 16) | ((uint32_t)got[7] << 24);
        old_len = (uint64_t)got[8] | ((uint64_t)got[9] << 8) |
                  ((uint64_t)got[10] << 16) | ((uint64_t)got[11] << 24) |
                  ((uint64_t)got[12] << 32) | ((uint64_t)got[13] << 40) |
                  ((uint64_t)got[14] << 48) | ((uint64_t)got[15] << 56);
        lo = (uint64_t)got[16] | ((uint64_t)got[17] << 8) |
             ((uint64_t)got[18] << 16) | ((uint64_t)got[19] << 24) |
             ((uint64_t)got[20] << 32) | ((uint64_t)got[21] << 40) |
             ((uint64_t)got[22] << 48) | ((uint64_t)got[23] << 56);
        expect(magic == 0x42585452u && ver == 1, "span RTXB header");
        expect(old_len == 11 && lo == 6, "span header offsets");
        expect(({ char[:] __s = cc_slice_from_buffer((char *)got + 24, 5); __s.eq_cstr("world"); }),
               "span payload is overwritten old bytes");
        rtx_doc_set_save_backup(prev);
        unlink(path);
        unlink(bak);
    }

    {
        /* Shrink: write the new tail and ftruncate; path~ keeps the old suffix. */
        RtxDoc d = {0} @destroy;
        const char *path = "testdata/generated/save_backup_shrink.txt";
        const char *bak = "testdata/generated/save_backup_shrink.txt~";
        FILE *f;
        unsigned char got[64];
        size_t n;
        int prev = rtx_doc_save_backup();
        uint32_t magic;
        uint64_t old_len, lo;
        if (system("mkdir -p testdata/generated") != 0) expect(0, "mkdir");
        unlink(path);
        unlink(bak);
        f = fopen(path, "w");
        expect(f != NULL, "shrink dest create");
        if (f) {
            fputs("hello world", f);
            fclose(f);
        }
        rtx_doc_set_save_backup(1);
        d.from_path(path) !>;
        d.replace(5, 6, cc_slice_empty()) !>;
        d.save() !>;
        f = fopen(path, "r");
        expect(f != NULL, "shrink dest after save");
        n = f ? fread(got, 1, sizeof(got), f) : 0;
        if (f) fclose(f);
        expect(n == 5 && ({ char[:] __s = cc_slice_from_buffer((char *)got, 5); __s.eq_cstr("hello"); }),
               "shrink dest truncated");
        f = fopen(bak, "r");
        expect(f != NULL, "shrink path~ written");
        n = f ? fread(got, 1, sizeof(got), f) : 0;
        if (f) fclose(f);
        expect(n == 24 + 6, "shrink path~ is header + old suffix");
        magic = (uint32_t)got[0] | ((uint32_t)got[1] << 8) |
                ((uint32_t)got[2] << 16) | ((uint32_t)got[3] << 24);
        old_len = (uint64_t)got[8] | ((uint64_t)got[9] << 8) |
                  ((uint64_t)got[10] << 16) | ((uint64_t)got[11] << 24) |
                  ((uint64_t)got[12] << 32) | ((uint64_t)got[13] << 40) |
                  ((uint64_t)got[14] << 48) | ((uint64_t)got[15] << 56);
        lo = (uint64_t)got[16] | ((uint64_t)got[17] << 8) |
             ((uint64_t)got[18] << 16) | ((uint64_t)got[19] << 24) |
             ((uint64_t)got[20] << 32) | ((uint64_t)got[21] << 40) |
             ((uint64_t)got[22] << 48) | ((uint64_t)got[23] << 56);
        expect(magic == 0x42585452u && old_len == 11 && lo == 5, "shrink RTXB");
        expect(({ char[:] __s = cc_slice_from_buffer((char *)got + 24, 6); __s.eq_cstr(" world"); }),
               "shrink payload is old suffix");
        rtx_doc_set_save_backup(prev);
        unlink(path);
        unlink(bak);
    }

    {
        /* Mid insert: dest grows; path~ is the old suffix only. */
        RtxDoc d = {0} @destroy;
        const char *path = "testdata/generated/save_backup_insert.txt";
        const char *bak = "testdata/generated/save_backup_insert.txt~";
        unsigned char got[64];
        size_t n;
        int prev = rtx_doc_save_backup();
        if (system("mkdir -p testdata/generated") != 0) expect(0, "mkdir");
        unlink(path);
        unlink(bak);
        write_cstr_path(path, "hello world");
        rtx_doc_set_save_backup(1);
        d.from_path(path) !>;
        d.replace(5, 0, "XX") !>;
        d.save() !>;
        n = read_path_bytes(path, got, sizeof(got));
        expect(n == 13 &&
                   ({ char[:] __s = cc_slice_from_buffer((char *)got, 13);
                      __s.eq_cstr("helloXX world"); }),
               "insert dest");
        n = read_path_bytes(bak, got, sizeof(got));
        expect_rtxb(got, n, 11, 5, " world", "insert path~");
        rtx_doc_set_save_backup(prev);
        unlink(path);
        unlink(bak);
    }

    {
        /* Insert into an unread tail page. Streaming that tail through the
         * dest inode used to double the insert (XYZZYXYZZY…) whenever the
         * page store missed. */
        RtxDoc d = {0} @destroy;
        const char *path = "testdata/generated/save_backup_alias.txt";
        const char *bak = "testdata/generated/save_backup_alias.txt~";
        size_t oldn = (size_t)RTX_PAGE_SIZE * 3 + 1000;
        size_t off = 1000;
        int prev = rtx_doc_save_backup();
        unlink(path);
        unlink(bak);
        write_pattern_path(path, oldn);
        rtx_doc_set_save_backup(1);
        d.from_path(path) !>;
        d.replace(off, 0, "XYZZY") !>;
        d.save() !>;
        expect_pattern_insert(path, oldn, off, "XYZZY", "alias insert dest");
        rtx_doc_set_save_backup(prev);
        unlink(path);
        unlink(bak);
    }

    {
        /* Reporter case: insert near EOF without a prior %/page touch. */
        RtxDoc d = {0} @destroy;
        const char *path = "testdata/generated/save_backup_alias_eof.txt";
        const char *bak = "testdata/generated/save_backup_alias_eof.txt~";
        size_t oldn = (size_t)RTX_PAGE_SIZE * 3 + 2000;
        size_t off = oldn - 1000;
        int prev = rtx_doc_save_backup();
        unlink(path);
        unlink(bak);
        write_pattern_path(path, oldn);
        rtx_doc_set_save_backup(1);
        d.from_path(path) !>;
        d.replace(off, 0, "XYZZY") !>;
        d.save() !>;
        expect_pattern_insert(path, oldn, off, "XYZZY", "alias eof insert dest");
        rtx_doc_set_save_backup(prev);
        unlink(path);
        unlink(bak);
    }

    {
        /* Mid delete also shifts an unread original tail left. */
        RtxDoc d = {0} @destroy;
        const char *path = "testdata/generated/save_backup_alias_del.txt";
        const char *bak = "testdata/generated/save_backup_alias_del.txt~";
        size_t oldn = (size_t)RTX_PAGE_SIZE * 3 + 1000;
        size_t off = 1000;
        int prev = rtx_doc_save_backup();
        unlink(path);
        unlink(bak);
        write_pattern_path(path, oldn);
        rtx_doc_set_save_backup(1);
        d.from_path(path) !>;
        d.replace(off, 5, cc_slice_empty()) !>;
        d.save() !>;
        expect_pattern_delete(path, oldn, off, 5, "alias delete dest");
        rtx_doc_set_save_backup(prev);
        unlink(path);
        unlink(bak);
    }

    {
        /* BOF same-length: only the first dirty byte is in path~. */
        RtxDoc d = {0} @destroy;
        const char *path = "testdata/generated/save_backup_bof.txt";
        const char *bak = "testdata/generated/save_backup_bof.txt~";
        unsigned char got[64];
        size_t n;
        int prev = rtx_doc_save_backup();
        unlink(path);
        unlink(bak);
        write_cstr_path(path, "hello world");
        rtx_doc_set_save_backup(1);
        d.from_path(path) !>;
        d.replace(0, 1, "H") !>;
        d.save() !>;
        n = read_path_bytes(path, got, sizeof(got));
        expect(n == 11 &&
                   ({ char[:] __s = cc_slice_from_buffer((char *)got, 11);
                      __s.eq_cstr("Hello world"); }),
               "bof dest");
        n = read_path_bytes(bak, got, sizeof(got));
        expect_rtxb(got, n, 11, 0, "h", "bof path~");
        rtx_doc_set_save_backup(prev);
        unlink(path);
        unlink(bak);
    }

    {
        /* Restore: write RTXB payload at lo and ftruncate to old_len. */
        RtxDoc d = {0} @destroy;
        const char *path = "testdata/generated/save_backup_restore.txt";
        const char *bak = "testdata/generated/save_backup_restore.txt~";
        unsigned char got[64];
        size_t n;
        int prev = rtx_doc_save_backup();
        unlink(path);
        unlink(bak);
        write_cstr_path(path, "hello world");
        rtx_doc_set_save_backup(1);
        d.from_path(path) !>;
        d.replace(5, 6, cc_slice_empty()) !>;
        d.save() !>;
        n = read_path_bytes(path, got, sizeof(got));
        expect(n == 5 &&
                   ({ char[:] __s = cc_slice_from_buffer((char *)got, 5);
                      __s.eq_cstr("hello"); }),
               "restore pre");
        n = read_path_bytes(bak, got, sizeof(got));
        expect(n != (size_t)-1 && restore_rtxb(path, got, n) == 0, "restore apply");
        n = read_path_bytes(path, got, sizeof(got));
        expect(n == 11 &&
                   ({ char[:] __s = cc_slice_from_buffer((char *)got, 11);
                      __s.eq_cstr("hello world"); }),
               "restore dest");
        rtx_doc_set_save_backup(prev);
        unlink(path);
        unlink(bak);
    }

    {
        /* Large same-length mid replace: path~ stays header + 4 bytes. */
        RtxDoc d = {0} @destroy;
        const char *path = "testdata/generated/save_backup_large.txt";
        const char *bak = "testdata/generated/save_backup_large.txt~";
        FILE *f;
        unsigned char got[32];
        size_t i, n;
        int prev = rtx_doc_save_backup();
        struct stat st;
        unlink(path);
        unlink(bak);
        f = fopen(path, "w");
        expect(f != NULL, "large dest create");
        if (f) {
            for (i = 0; i < 65536; i++) fputc('A', f);
            fputs("MARK", f);
            for (i = 0; i < 65536; i++) fputc('B', f);
            fclose(f);
        }
        rtx_doc_set_save_backup(1);
        d.from_path(path) !>;
        d.replace(65536, 4, "mark") !>;
        d.save() !>;
        expect(stat(path, &st) == 0 && st.st_size == 65536 + 4 + 65536, "large dest size");
        expect(stat(bak, &st) == 0 && st.st_size == 24 + 4, "large path~ is span only");
        f = fopen(path, "rb");
        expect(f != NULL, "large dest reopen");
        if (f) {
            expect(fseek(f, 0, SEEK_SET) == 0 && fgetc(f) == 'A', "large prefix");
            expect(fseek(f, 65536, SEEK_SET) == 0 && fread(got, 1, 4, f) == 4 &&
                       ({ char[:] __s = cc_slice_from_buffer((char *)got, 4);
                          __s.eq_cstr("mark"); }),
                   "large mid");
            expect(fseek(f, 65536 + 4 + 65535, SEEK_SET) == 0 && fgetc(f) == 'B',
                   "large suffix");
            fclose(f);
        }
        n = read_path_bytes(bak, got, sizeof(got));
        expect_rtxb(got, n, 65536 + 4 + 65536, 65536, "MARK", "large path~");
        rtx_doc_set_save_backup(prev);
        unlink(path);
        unlink(bak);
    }

    {
        /* save_as another existing path: full raw copy of that dest, not RTXB. */
        RtxDoc d = {0} @destroy;
        const char *src = "testdata/generated/save_backup_src.txt";
        const char *dst = "testdata/generated/save_backup_other.txt";
        const char *bak = "testdata/generated/save_backup_other.txt~";
        unsigned char got[64];
        size_t n;
        int prev = rtx_doc_save_backup();
        unlink(src);
        unlink(dst);
        unlink(bak);
        write_cstr_path(src, "opened");
        write_cstr_path(dst, "DESTDATA");
        rtx_doc_set_save_backup(1);
        d.from_path(src) !>;
        d.caret = d.len();
        d.sel_anchor = d.caret;
        d.type("!") !>;
        d.save_as(dst) !>;
        n = read_path_bytes(dst, got, sizeof(got));
        expect(n == 7 &&
                   ({ char[:] __s = cc_slice_from_buffer((char *)got, 7);
                      __s.eq_cstr("opened!"); }),
               "other dest");
        n = read_path_bytes(bak, got, sizeof(got));
        expect(n == 8 &&
                   ({ char[:] __s = cc_slice_from_buffer((char *)got, 8);
                      __s.eq_cstr("DESTDATA"); }),
               "other path~ is raw dest copy");
        rtx_doc_set_save_backup(prev);
        unlink(src);
        unlink(dst);
        unlink(bak);
    }

    {
        /* Dest size drifted: refuse, then overwrite is a full raw copy. */
        RtxDoc d = {0} @destroy;
        const char *path = "testdata/generated/save_backup_drift.txt";
        const char *bak = "testdata/generated/save_backup_drift.txt~";
        unsigned char got[64];
        size_t n;
        int prev = rtx_doc_save_backup();
        FILE *ext;
        CCError e = {0};
        int saw;
        unlink(path);
        unlink(bak);
        write_cstr_path(path, "hello");
        rtx_doc_set_save_backup(1);
        d.from_path(path) !>;
        ext = fopen(path, "a");
        expect(ext != NULL, "drift append");
        if (ext) {
            fputs("XXXX", ext);
            fclose(ext);
        }
        d.replace(0, 1, "H") !>;
        expect(d.disk_changed(), "size drift is a conflict");
        saw = try_save(&d, &e);
        expect(saw && e.message && strstr(e.message, "changed"),
               "drift save refuses");
        d.save_overwrite();
        d.save() !>;
        n = read_path_bytes(path, got, sizeof(got));
        expect(n == 5 &&
                   ({ char[:] __s = cc_slice_from_buffer((char *)got, 5);
                      __s.eq_cstr("Hello"); }),
               "drift dest is editor bytes");
        n = read_path_bytes(bak, got, sizeof(got));
        expect(n == 9 &&
                   ({ char[:] __s = cc_slice_from_buffer((char *)got, 9);
                      __s.eq_cstr("helloXXXX"); }),
               "drift path~ is raw drifted copy");
        rtx_doc_set_save_backup(prev);
        unlink(path);
        unlink(bak);
    }

    {
        /* Buffer-backed doc: dest is not the opened original, so path~ is raw. */
        RtxDoc d = {0} @destroy;
        const char *path = "testdata/generated/save_backup_buf.txt";
        const char *bak = "testdata/generated/save_backup_buf.txt~";
        unsigned char got[64];
        size_t n;
        int prev = rtx_doc_save_backup();
        unlink(path);
        unlink(bak);
        write_cstr_path(path, "zzz");
        rtx_doc_set_save_backup(1);
        d.from_buffer("abc") !>;
        d.save_as(path) !>;
        n = read_path_bytes(path, got, sizeof(got));
        expect(n == 3 &&
                   ({ char[:] __s = cc_slice_from_buffer((char *)got, 3);
                      __s.eq_cstr("abc"); }),
               "buf dest");
        n = read_path_bytes(bak, got, sizeof(got));
        expect(n == 3 &&
                   ({ char[:] __s = cc_slice_from_buffer((char *)got, 3);
                      __s.eq_cstr("zzz"); }),
               "buf path~ is raw dest copy");
        rtx_doc_set_save_backup(prev);
        unlink(path);
        unlink(bak);
    }

    {
        /* Default save replaces a symlink with a regular file. */
        RtxDoc d = {0} @destroy;
        const char *real = "testdata/generated/save_rename_real.txt";
        const char *link = "testdata/generated/save_rename_link.txt";
        FILE *f;
        char got[64];
        size_t n;
        struct stat st;
        int prev = rtx_doc_save_backup();
        if (system("mkdir -p testdata/generated") != 0) expect(0, "mkdir");
        unlink(link);
        unlink(real);
        f = fopen(real, "w");
        expect(f != NULL, "rename real create");
        if (f) {
            fputs("old", f);
            fclose(f);
        }
        expect(symlink("save_rename_real.txt", link) == 0, "rename symlink");
        rtx_doc_set_save_backup(0);
        d.from_path(link) !>;
        d.caret = d.len();
        d.sel_anchor = d.caret;
        d.type("-new") !>;
        d.save() !>;
        expect(lstat(link, &st) == 0 && !S_ISLNK(st.st_mode),
               "default save replaces symlink");
        f = fopen(link, "r");
        expect(f != NULL, "replaced path readable");
        n = f ? fread(got, 1, sizeof(got), f) : 0;
        if (f) fclose(f);
        expect(n == 7 && ({ char[:] __s = cc_slice_from_buffer(got, 7); __s.eq_cstr("old-new"); }),
               "replaced path has new bytes");
        f = fopen(real, "r");
        expect(f != NULL, "old target untouched");
        n = f ? fread(got, 1, sizeof(got), f) : 0;
        if (f) fclose(f);
        expect(n == 3 && ({ char[:] __s = cc_slice_from_buffer(got, 3); __s.eq_cstr("old"); }),
               "symlink target unchanged by rename save");
        rtx_doc_set_save_backup(prev);
        unlink(link);
        unlink(real);
    }

    {
        RtxUi ui = {0};
        ui.no_blink = 1;
        rtx_ui_blink_show(&ui);
        expect(rtx_ui_blink(&ui) == 1, "no-blink visible");
        expect(rtx_ui_blink_step(&ui) == 0, "no-blink step idle");
        ui.blink = 0;
        ui.blink_at = rtx_ui_now_ms() - (long)RTX_UI_BLINK_MS - 1;
        expect(rtx_ui_blink_step(&ui) == 0, "no-blink ignores timer");
        expect(rtx_ui_blink(&ui) == 1, "no-blink stays on");
    }

    {
        RtxDoc d = {0} @destroy;
        RtxLayout L = {0} @destroy;
        size_t i;
        uint8_t body_buf[2048];
        CCArena body_arena = cc_arena_fixed_buffer(body_buf, sizeof(body_buf)) @destroy;
        char[:] body;
        size_t n = 0;
        size_t row10_start;
        size_t tail_start;
        body = body_arena.alloc_slice_bytes(sizeof(body_buf));
        expect(body.ptr != NULL, "body arena");
        if (!body.ptr) return 1;
        for (i = 0; i < 40; i++) {
            n += (size_t)snprintf(body.ptr + n, body.len - n, "line-%02zu xxxx\n", i);
        }
        d.from_buffer(body.sub(0, n)) !>;
        d.secs.data[0].kind = RTX_SEC_CODE;
        L.doc(&d, &m, 80) !>;
        expect(L.rows.len == 40, "40 visual rows");
        row10_start = L.rows.data[10].byte_start;
        tail_start = L.rows.data[30].byte_start;
        d.caret = row10_start + 5;
        d.sel_anchor = d.caret;
        d.type("Z") !>;
        L.view_after_edit(&d, &m, 80) !>;
        expect(L.rows.len == 40, "row count unchanged after mid insert");
        expect(L.rows.data[10].byte_start == row10_start, "edited row start");
        expect(L.rows.data[30].byte_start == tail_start + 1, "later row start after insert");
        expect(L.rows.data[5].byte_start < row10_start, "head unshifted");
    }

    {
        RtxWs w = {0} @destroy;
        char *paths[2];
        paths[0] = (char *)"testdata/small.txt";
        paths[1] = (char *)"testdata/mixed.txt";
        w.open_files(2, paths) !>;
        expect(w.len == 2, "two buffers");
        expect(w.npanes == 2, "split on two files");
        expect(w.doc() == &w.bufs[0].doc, "focus first");
        w.focus_other();
        expect(w.doc() == &w.bufs[1].doc, "focus second");
        w.next_buf();
        expect(w.pane[1] == 0, "cycle pane buffer");
    }

    {
        RtxWs w = {0} @destroy;
        char *paths[1];
        paths[0] = (char *)"testdata/small.txt";
        w.open_files(1, paths) !>;
        w.toggle_split();
        expect(w.npanes == 2 && RtxWs_same_split(&w), "same-file split has two cameras");
        w.bufs[0].top = 0;
        w.side.top = 0;
        {
            RtxBuf *act = RtxWs_active(&w);
            act->top = 2;
            expect(w.bufs[0].top == 2, "focus camera is on the buf");
            w.focus_other();
            act = RtxWs_active(&w);
            expect(act->top == 0, "other pane kept its own top");
        }
        expect(w.side.top == 2, "unfocused top is stashed");
        w.toggle_split();
        expect(w.npanes == 1 && !RtxWs_same_split(&w), "unsplit drops the side camera");
    }

    {
        RtxWs w = {0} @destroy;
        RtxBuf *act;
        char *paths[1];
        size_t i, n;
        paths[0] = (char *)"testdata/small.txt";
        w.open_files(1, paths) !>;
        w.toggle_split();
        act = RtxWs_active(&w);
        act->ensure_view(&m, 40, 4) !>;
        w.focus_other();
        act = RtxWs_active(&w);
        act->ensure_view(&m, 40, 4) !>;
        expect(w.side.live && w.side.layout.rows.len > 0, "unfocused camera has rows");
        w.side.layout.rows.data[0].byte_start = 100000;
        w.side.layout.rows.data[0].byte_len = 50;
        act->doc.caret = 0;
        act->doc.sel_anchor = 0;
        act->doc.delete_forward() !>;
        w.after_edit(w.pane[w.focus], &m, 40, 40, 4) !>;
        n = act->len();
        expect(w.side.layout.rows.len > 0, "unfocused camera rebuilt after edit");
        for (i = 0; i < w.side.layout.rows.len; i++) {
            expect(w.side.layout.rows.data[i].byte_start + w.side.layout.rows.data[i].byte_len <= n,
                   "unfocused row in range after edit");
        }
        for (i = 0; i < act->layout.rows.len; i++) {
            expect(act->layout.rows.data[i].byte_start + act->layout.rows.data[i].byte_len <= n,
                   "focused row in range after edit");
        }
    }

    {
        RtxWs w = {0} @destroy;
        RtxBrowse *br;
        size_t i;
        int saw_txt = 0;
        char *paths[1];
        paths[0] = (char *)"testdata/small.txt";
        w.open_files(1, paths) !>;
        w.browse_start() !>;
        br = RtxWs_browse(&w);
        expect(br && (br->scanning || br->len > 1),
               "kick planted a listing");
        browse_wait(br) !>;
        expect(br && br->len > 1, "listing lists more than ..");
        expect(br && br->on, "browse opens in the focused view");
        expect(!br->boot, "browse on an open file is not boot");
        expect(br->dir[0] == '/', "browse dir is absolute");
        expect(strstr(br->dir, "testdata") != NULL, "starts in the file's directory");
        {
            char here[RTX_BROWSE_DIR];
            snprintf(here, sizeof(here), "%s", br->dir);
            w.browse_backspace() !>;
            br = RtxWs_browse(&w);
            expect(strcmp(br->dir, here) == 0, "backspace does not leave the directory");
            w.browse_parent() !>;
            br = RtxWs_browse(&w);
            browse_wait(br) !>;
            expect(strcmp(br->dir, here) != 0, "parent leaves the file's directory");
            expect(br->dir[0] == '/', "parent stays absolute");
            {
                size_t n = strlen(br->dir);
                expect(n < 8 || strcmp(br->dir + n - 8, "testdata") != 0,
                       "parent is not still testdata");
            }
        }
        w.browse_start() !>;
        br = RtxWs_browse(&w);
        browse_wait(br) !>;
        expect(br->len && strcmp(br->ents[br->cur].name, "small.txt") == 0,
               "browse preselects the open file");
        rtx_browse_select(br, 0, 20);
        expect(strcmp(br->ents[br->cur].name, "..") == 0, "select ..");
        rtx_browse_keep_set(br, "small.txt");
        expect(strcmp(br->ents[br->cur].name, "small.txt") == 0,
               "keep_set reapplies after drain");
        if (geteuid() != 0) {
            char abs[RTX_BROWSE_DIR];
            const char *rel = "testdata/generated/browse_denied";
            (void)system("mkdir -p testdata/generated/browse_denied");
            expect(chmod(rel, 0) == 0, "chmod 000 browse_denied");
            expect(rtx_browse_abs(abs, sizeof(abs), rel) && abs[0],
                   "abs browse_denied");
            snprintf(br->dir, sizeof(br->dir), "%s", abs);
            rtx_browse_kick(br) !>;
            browse_wait(br) !>;
            expect(br->denied, "unreadable dir is denied");
            expect(strstr(rtx_browse_scan_msg(br), "denied") != NULL,
                   "status says denied");
            expect(br->len == 1 && strcmp(br->ents[0].name, "..") == 0,
                   "denied listing keeps ..");
            {
                char parent[RTX_BROWSE_DIR];
                char shown[12];
                size_t di;
                rtx_browse_dirname(parent, sizeof(parent), abs);
                snprintf(br->dir, sizeof(br->dir), "%s", parent);
                rtx_browse_kick(br) !>;
                browse_wait(br) !>;
                di = br->len;
                for (i = 0; i < br->len; i++) {
                    if (br->ents[i].is_dir &&
                        strcmp(br->ents[i].name, "browse_denied") == 0)
                        di = i;
                }
                expect(di < br->len, "parent lists browse_denied");
                if (di < br->len) {
                    rtx_browse_select(br, di, 20);
                    browse_wait(br) !>;
                    expect(br->ents[di].size_denied,
                           "unreadable folder size is denied");
                    expect(rtx_browse_size_face(br, &br->ents[di]) ==
                           RTX_BROWSE_FACE_DENY,
                           "denied folder size uses the deny face");
                    rtx_browse_fmt_size(shown, sizeof(shown), &br->ents[di]);
                    expect(strstr(shown, "denied") != NULL,
                           "size column says denied");
                }
            }
            chmod(rel, 0700);
            rmdir(rel);
            w.browse_start() !>;
            br = RtxWs_browse(&w);
            browse_wait(br) !>;
        }
        {
            char peer[256];
            char sel[RTX_BROWSE_DIR];
            int is_dir = 1;
            expect(!rtx_host_is_ray("cctext"), "cctext is not gui");
            expect(rtx_host_is_ray("cctext-gui"), "cctext-gui is gui");
            expect(rtx_host_is_ray("/opt/bin/cctext_gui"), "cctext_gui is gui");
            expect(rtx_host_peer_path("/opt/bin/cctext", 0, peer, sizeof(peer)) &&
                   strcmp(peer, "/opt/bin/cctext") == 0, "self keeps this exe");
            expect(rtx_host_peer_path("/opt/bin/cctext", 1, peer, sizeof(peer)) &&
                   strcmp(peer, "/opt/bin/cctext-gui") == 0, "peer of cctext is gui");
            expect(rtx_host_peer_path("/opt/bin/cctext-gui", 1, peer, sizeof(peer)) &&
                   strcmp(peer, "/opt/bin/cctext") == 0, "peer of gui is cctext");
            expect(rtx_host_peer_path("cctext", 1, peer, sizeof(peer)) &&
                   strcmp(peer, "cctext-gui") == 0, "bare peer has no dir");
#ifdef __APPLE__
            {
                char *old_term = getenv("TERM_PROGRAM");
                char *old_trace = getenv("CURSOR_TRACE_ID");
                char term_save[64];
                char trace_save[64];
                term_save[0] = 0;
                trace_save[0] = 0;
                if (old_term) snprintf(term_save, sizeof(term_save), "%s", old_term);
                if (old_trace) snprintf(trace_save, sizeof(trace_save), "%s", old_trace);
                setenv("TERM_PROGRAM", "vscode", 1);
                setenv("CURSOR_TRACE_ID", "1", 1);
                expect(strcmp(rtx_host_tty_app(), "Cursor") == 0,
                       "Cursor terminal stays in Cursor");
                unsetenv("CURSOR_TRACE_ID");
                setenv("TERM_PROGRAM", "iTerm.app", 1);
                expect(strcmp(rtx_host_tty_app(), "iTerm") == 0, "iTerm host");
                setenv("TERM_PROGRAM", "Apple_Terminal", 1);
                expect(strcmp(rtx_host_tty_app(), "Terminal") == 0,
                       "Terminal.app host");
                if (term_save[0]) setenv("TERM_PROGRAM", term_save, 1);
                else unsetenv("TERM_PROGRAM");
                if (trace_save[0]) setenv("CURSOR_TRACE_ID", trace_save, 1);
                else unsetenv("CURSOR_TRACE_ID");
            }
#else
            expect(strcmp(rtx_host_tty_app(), "Terminal") == 0,
                   "non-Apple host has no tty app");
#endif
            expect(rtx_browse_sel_path(br, sel, sizeof(sel), &is_dir) &&
                   !is_dir && strstr(sel, "small.txt"),
                   "browse sel is the highlighted file");
        }
        {
            struct stat st;
            char size[12];
            char when[24];
            expect(stat("testdata/small.txt", &st) == 0, "stat small.txt");
            expect(br->ents[br->cur].has_stat, "browse has size/mtime");
            expect(!br->ents[br->cur].is_dir, "small.txt is a file");
            expect(br->ents[br->cur].size == (uint64_t)st.st_size,
                   "browse size matches stat");
            expect(br->ents[br->cur].mtime == st.st_mtime,
                   "browse mtime matches stat");
            rtx_browse_fmt_size(size, sizeof(size), &br->ents[br->cur]);
            rtx_browse_fmt_mtime(when, sizeof(when), &br->ents[br->cur]);
            {
                char want[16];
                snprintf(want, sizeof(want), "%llu", (unsigned long long)st.st_size);
                expect(strstr(size, want) != NULL, "fmt size shows the byte count");
            }
            expect(strlen(when) == (size_t)RTX_BROWSE_MTIME_W, "fmt mtime is YYYY-MM-DD HH:MM");
            expect(when[4] == '-' && when[7] == '-' && when[10] == ' ' && when[13] == ':',
                   "fmt mtime separators");
            {
                size_t j;
                int saw_dir_meta = 0;
                for (j = 0; j < br->len; j++) {
                    if (!br->ents[j].is_dir) continue;
                    expect(br->ents[j].has_stat || strcmp(br->ents[j].name, "..") == 0,
                           "dirs carry mtime when stat works");
                    if (br->ents[j].has_stat) {
                        char dsize[12];
                        rtx_browse_fmt_size(dsize, sizeof(dsize), &br->ents[j]);
                        if (!br->ents[j].sized)
                            expect(strspn(dsize, " ") == strlen(dsize),
                                   "unsized dir size column is blank");
                        saw_dir_meta = 1;
                    }
                }
                expect(saw_dir_meta, "listing includes a directory with mtime");
            }
            {
                size_t si;
                size_t samples;
                size_t filei;
                uint64_t parked;
                char shown[12];
                samples = br->len;
                filei = br->len;
                for (si = 0; si < br->len; si++) {
                    if (br->ents[si].is_dir &&
                        strcmp(br->ents[si].name, "samples") == 0)
                        samples = si;
                    if (!br->ents[si].is_dir &&
                        strcmp(br->ents[si].name, "small.txt") == 0)
                        filei = si;
                }
                expect(samples < br->len && filei < br->len,
                       "samples and small.txt are in testdata");
                if (samples < br->len) {
                    expect(!RtxWs_browse_busy(&w),
                           "idle listing on a file is not busy");
                    rtx_browse_select(br, samples, 20);
                    expect(RtxWs_browse_busy(&w),
                           "an unsized folder keeps the host pumping");
                    RtxWs_browse_pump(&w) !>;
                    expect(br->ents[samples].sized, "current folder starts a du");
                    parked = br->ents[samples].size;
                    if (filei < br->len) {
                        rtx_browse_select(br, filei, 20);
                        expect(!br->sizing, "leaving a folder pauses du");
                        expect(br->ents[samples].sized &&
                               br->ents[samples].size == parked,
                               "paused folder keeps its running total");
                        expect(rtx_browse_size_face(br, &br->ents[samples]) ==
                               (br->ents[samples].size_done
                                    ? RTX_BROWSE_FACE_DIR
                                    : RTX_BROWSE_FACE_DATE),
                               "paused incomplete size is gray");
                        rtx_browse_select(br, samples, 20);
                        expect(br->ents[samples].size == parked,
                               "coming back does not restart from zero");
                    }
                    browse_wait(br) !>;
                    expect(!br->sizing, "folder du finishes");
                    expect(br->ents[samples].sized && br->ents[samples].size > 0,
                           "samples has a folder total");
                    expect(br->ents[samples].size_done,
                           "finished folder is complete");
                    expect(rtx_browse_size_face(br, &br->ents[samples]) ==
                           RTX_BROWSE_FACE_DIR,
                           "finished folder size uses the dir face");
                    rtx_browse_fmt_size(shown, sizeof(shown), &br->ents[samples]);
                    expect(strspn(shown, " ") != strlen(shown),
                           "sized folder shows a size");
                    if (filei < br->len) {
                        rtx_browse_select(br, filei, 20);
                        expect(strcmp(br->ents[0].name, "..") == 0 &&
                               !br->ents[0].sized,
                               ".. is not sized");
                        expect(rtx_browse_size_face(br, &br->ents[samples]) ==
                               RTX_BROWSE_FACE_DIR,
                               "complete folder size stays the dir face after leave");
                    }
                    {
                        uint64_t keep_sz = br->ents[samples].size;
                        char testdir[RTX_BROWSE_DIR];
                        snprintf(testdir, sizeof(testdir), "%s", br->dir);
                        rtx_browse_kick(br) !>;
                        browse_wait(br) !>;
                        samples = br->len;
                        for (si = 0; si < br->len; si++) {
                            if (br->ents[si].is_dir &&
                                strcmp(br->ents[si].name, "samples") == 0)
                                samples = si;
                        }
                        expect(samples < br->len, "kick still lists samples");
                        expect(br->ents[samples].size_done &&
                               br->ents[samples].size == keep_sz,
                               "finished folder size survives kick");
                    }
                }
            }
            {
                char abs[RTX_BROWSE_DIR];
                char parent[RTX_BROWSE_DIR];
                char path[160];
                const char *rel = "testdata/generated/browse_du_wide";
                int k;
                size_t di;
                (void)system("rm -rf testdata/generated/browse_du_wide");
                (void)system("mkdir -p testdata/generated/browse_du_wide");
                for (k = 0; k < 40; k++) {
                    snprintf(path, sizeof(path), "%s/d%02d", rel, k);
                    expect(mkdir(path, 0755) == 0, "mkdir wide child");
                }
                expect(rtx_browse_abs(abs, sizeof(abs), rel) && abs[0],
                       "abs browse_du_wide");
                rtx_browse_dirname(parent, sizeof(parent), abs);
                snprintf(br->dir, sizeof(br->dir), "%s", parent);
                rtx_browse_kick(br) !>;
                browse_wait(br) !>;
                di = br->len;
                for (i = 0; i < br->len; i++) {
                    if (br->ents[i].is_dir &&
                        strcmp(br->ents[i].name, "browse_du_wide") == 0)
                        di = i;
                }
                expect(di < br->len, "parent lists browse_du_wide");
                if (di < br->len) {
                    rtx_browse_select(br, di, 20);
                    rtx_browse_pump(br) !>;
                    expect(br->ents[di].sized && br->sizing,
                           "wide folder stays live after one pump");
                    browse_wait(br) !>;
                    expect(!br->sizing && br->ents[di].size_done,
                           "wide folder du finishes");
                }
                (void)system("rm -rf testdata/generated/browse_du_wide");
                w.browse_start() !>;
                br = RtxWs_browse(&w);
                browse_wait(br) !>;
            }
        }
        w.browse_glob_set("sma") !>;
        br = RtxWs_browse(&w);
        expect(br->flat, "typed fragment starts flattened search");
        browse_wait(br) !>;
        expect(br->len && strcmp(br->ents[br->cur].name, "small.txt") == 0,
               "fragment glob keeps the open file selected");
        {
            int saw_small = 0, saw_unrelated_dir = 0;
            for (i = 0; i < br->len; i++) {
                if (!br->ents[i].is_dir) {
                    if (strcmp(br->ents[i].name, "small.txt") == 0) saw_small = 1;
                } else if (strcmp(br->ents[i].name, "generated") == 0) {
                    saw_unrelated_dir = 1;
                }
            }
            expect(saw_small, "fragment glob lists matching files");
            expect(!saw_unrelated_dir, "fragment flatten hides directories");
            {
                int saw_sep = 0;
                size_t sepi = br->len, smalli = br->len;
                for (i = 0; i < br->len; i++) {
                    if (br->ents[i].sep && sepi == br->len) sepi = i;
                    if (br->ents[i].sep) saw_sep = 1;
                    if (strcmp(br->ents[i].name, "small.txt") == 0) smalli = i;
                }
                expect(saw_sep, "typed fragment plants a flatten row");
                expect(smalli < sepi, "local hit stays above the flatten row");
                expect(sepi + 1 < br->len && br->ents[sepi].sep &&
                       br->ents[sepi + 1].sep &&
                       strstr(br->ents[sepi + 1].name, "Flattened"),
                       "blank row sits above > Flattened search");
            }
        }
        w.browse_glob_set("SMA") !>;
        br = RtxWs_browse(&w);
        browse_wait(br) !>;
        expect(br->len && strcmp(br->ents[br->cur].name, "small.txt") == 0,
               "fragment match is case-insensitive");
        {
            size_t off = 0, n = 0;
            expect(rtx_browse_hit_span(br, "small.txt", &off, &n) &&
                   off == 0 && n == 3, "fragment hit is sma");
        }
        {
            int saw_dir = 0;
            int saw_dot = 0;
            size_t off = 0, n = 0;
            FILE *dot = fopen("testdata/.rtx_dot_smoke", "w");
            if (dot) {
                fputc('x', dot);
                fclose(dot);
            }
            w.browse_glob_set("") !>;
            br = RtxWs_browse(&w);
            browse_wait(br) !>;
            for (i = 0; i < br->len; i++) {
                if (strcmp(br->ents[i].name, ".rtx_dot_smoke") == 0) saw_dot = 1;
            }
            expect(!saw_dot, "empty glob hides dotfiles");
            w.browse_glob_set(".") !>;
            br = RtxWs_browse(&w);
            browse_wait(br) !>;
            saw_dot = 0;
            for (i = 0; i < br->len; i++) {
                if (br->ents[i].is_dir && strcmp(br->ents[i].name, "generated") == 0)
                    saw_dir = 1;
                if (strcmp(br->ents[i].name, ".rtx_dot_smoke") == 0) saw_dot = 1;
            }
            expect(saw_dir, ". is not a fragment; listing stays unfiltered");
            expect(saw_dot, ". reveals dotfiles");
            expect(!rtx_browse_hit_span(br, "small.txt", &off, &n),
                   ". does not highlight every extension dot");
            w.browse_glob_set(".rtx") !>;
            br = RtxWs_browse(&w);
            browse_wait(br) !>;
            saw_dot = 0;
            saw_txt = 0;
            for (i = 0; i < br->len; i++) {
                if (strcmp(br->ents[i].name, ".rtx_dot_smoke") == 0) saw_dot = 1;
                if (strcmp(br->ents[i].name, "small.txt") == 0) saw_txt = 1;
            }
            expect(saw_dot && !saw_txt, ".rtx is hidden + fragment rtx");
            expect(rtx_browse_hit_span(br, ".rtx_dot_smoke", &off, &n) &&
                   off == 1 && n == 3, "leading dot is not the hit");
            unlink("testdata/.rtx_dot_smoke");
            w.browse_glob_set("") !>;
            br = RtxWs_browse(&w);
            browse_wait(br) !>;
            for (i = 0; i < br->len; i++) {
                if (strcmp(br->ents[i].name, "small.txt") == 0) br->cur = i;
            }
        }
        w.browse_glob_set("*.txt") !>;
        br = RtxWs_browse(&w);
        expect(!br->flat, "*.txt stays a local walkable glob");
        browse_wait(br) !>;
        expect(br->len && strcmp(br->ents[br->cur].name, "small.txt") == 0,
               "glob keeps the open file selected");
        {
            int saw_dir = 0;
            saw_txt = 0;
            for (i = 0; i < br->len; i++) {
                if (!br->ents[i].is_dir && strstr(br->ents[i].name, ".txt"))
                    saw_txt = 1;
                if (br->ents[i].is_dir && strcmp(br->ents[i].name, "..") != 0)
                    saw_dir = 1;
            }
            expect(saw_txt, "glob *.txt lists text files");
            expect(saw_dir, "real glob still lists directories");
        }
        {
            size_t off = 0, n = 0;
            expect(rtx_browse_hit_span(br, "small.txt", &off, &n) &&
                   off == 5 && n == 4, "glob hit is .txt");
        }
        {
            RtxThemeColor dirc = rtx_browse_face(RTX_BROWSE_FACE_DIR);
            RtxThemeColor filec = rtx_browse_face(RTX_BROWSE_FACE_FILE);
            RtxThemeColor sizec = rtx_browse_face(RTX_BROWSE_FACE_SIZE);
            RtxThemeColor datec = rtx_browse_face(RTX_BROWSE_FACE_DATE);
            RtxThemeColor hitc = rtx_browse_face(RTX_BROWSE_FACE_HIT);
            RtxThemeColor extc = rtx_browse_face(RTX_BROWSE_FACE_EXT);
            expect(dirc.ansi && filec.ansi && strcmp(dirc.ansi, filec.ansi) != 0,
                   "dir and file faces differ");
            expect(sizec.ansi && datec.ansi && strcmp(sizec.ansi, datec.ansi) != 0,
                   "size and date faces differ");
            expect(hitc.ansi && strcmp(hitc.ansi, filec.ansi) != 0,
                   "hit face differs from file");
            expect(extc.ansi && strcmp(extc.ansi, filec.ansi) != 0,
                   "known-ext face differs from file");
            {
                size_t eoff = 0, en = 0;
                setenv("RTX_GRAMMARS", "testdata/grammars", 0);
                expect(rtx_tm_ext_span("piece_tree.ccs", &eoff, &en) &&
                       eoff == 10 && en == 4, ".ccs is a known suffix");
                expect(rtx_tm_ext_span("samples/readme.md", &eoff, &en) &&
                       eoff == 14 && en == 3, "flattened .md is known");
                expect(!rtx_tm_ext_span("small.txt", &eoff, &en),
                       ".txt is not a grammar suffix");
                expect(rtx_browse_name_face(0, 10, 0, 0, 0, 10, 4) ==
                       RTX_BROWSE_FACE_EXT, "name face paints the suffix");
                expect(rtx_browse_name_face(0, 0, 0, 0, 0, 10, 4) ==
                       RTX_BROWSE_FACE_FILE, "stem stays the file face");
            }
        }
        {
            RtxField gf = rtx_browse_field(br);
            rtx_field_select_all(gf);
            expect(rtx_field_has_sel(gf), "glob select all");
            {
                int _v = rtx_field_copy(&w, gf) !>;
                expect(_v == 1, "copy glob");
            }
            expect(w.clip.eq_cstr("*.txt"), "clip is *.txt");
            expect(rtx_field_type_cp(gf, 'x'), "type replaces glob sel");
            expect(br->glob_len == 1 && br->glob[0] == 'x', "glob is x");
            rtx_field_paste(&w, gf) !>;
            expect(br->glob_len == 6 &&
                   ({ char[:] __s = cc_slice_from_buffer(br->glob, 6); __s.eq_cstr("x*.txt"); }),
                   "paste into glob");
            rtx_field_click(gf, 1, 0, 0);
            rtx_field_click(gf, 6, 1, 0);
            rtx_field_cut(&w, gf) !>;
            expect(br->glob_len == 1 && br->glob[0] == 'x', "cut glob tail");
            rtx_browse_kick(br) !>;
            browse_wait(br) !>;
        }
        w.browse_glob_set("*.txt") !>;
        br = RtxWs_browse(&w);
        browse_wait(br) !>;
        {
            size_t j;
            int saw_child = 0;
            expect(br->glob_len > 0, "glob is set before enter");
            for (j = 0; j < br->len; j++) {
                if (br->ents[j].is_dir && strcmp(br->ents[j].name, "..") != 0) {
                    br->cur = j;
                    saw_child = 1;
                    break;
                }
            }
            expect(saw_child, "listing has a child directory");
            w.browse_enter() !>;
            br = RtxWs_browse(&w);
            browse_wait(br) !>;
            expect(br->on, "enter on a directory stays in browse");
            expect(br->glob_len == 0 && br->glob[0] == 0,
                   "enter on a directory resets the glob");
        }
        w.open_in_pane("testdata/mixed.txt") !>;
        expect(!w.browsing(), "open closes the browser");
        expect(w.len == 2, "new file is a new buf");
        expect(w.pane[0] == 1, "focused view shows the opened file");
    }

    {
        RtxWs w = {0} @destroy;
        RtxBrowse *br;
        size_t i;
        char *paths[1];
        paths[0] = (char *)"testdata/small.txt";
        w.open_files(1, paths) !>;
        w.browse_start() !>;
        w.browse_glob_set("readme") !>;
        br = RtxWs_browse(&w);
        expect(br->scanning || br->len > 0, "flatten listing kicked");
        w.browse_glob_set("zzz") !>;
        br = RtxWs_browse(&w);
        browse_wait(br) !>;
        expect(!br->scanning, "cancel+kick then wait");
        {
            int readme = 0;
            for (i = 0; i < br->len; i++) {
                if (br->ents[i].is_dir) continue;
                if (strstr(br->ents[i].name, "readme")) readme = 1;
            }
            expect(!readme, "new glob cancels old flatten hits");
        }
    }

    {
        RtxWs w = {0} @destroy;
        RtxBrowse *br;
        size_t i;
        char *paths[1];
        paths[0] = (char *)"testdata/small.txt";
        w.open_files(1, paths) !>;
        w.browse_start() !>;
        w.browse_glob_set(">") !>;
        br = RtxWs_browse(&w);
        expect(br->scanning || br->len >= 1, "glob set kicks");
        expect(br->len >= 1 && strcmp(br->ents[0].name, "..") == 0,
               ".. planted at kick");
        browse_wait(br) !>;
        expect(!br->scanning, "finish drains");
        {
            int saw_nested = 0, saw_small = 0, saw_dir = 0;
            for (i = 0; i < br->len; i++) {
                if (br->ents[i].is_dir) {
                    if (strcmp(br->ents[i].name, "..") != 0) saw_dir = 1;
                    continue;
                }
                if (strcmp(br->ents[i].name, "small.txt") == 0) saw_small = 1;
                if (strcmp(br->ents[i].name, "samples/readme.md") == 0) saw_nested = 1;
            }
            expect(saw_small, "> flatten still lists top-level files");
            expect(saw_nested, "> flatten lists files from subfolders");
            expect(!saw_dir, "> flatten does not list directories");
            expect(rtx_browse_dir_prefix("samples/readme.md") == 8,
                   "flattened name keeps the subfolder prefix");
            expect(!br->truncated, "small tree is not capped");
        }
        w.browse_glob_set(">*.md") !>;
        br = RtxWs_browse(&w);
        browse_wait(br) !>;
        {
            int saw_md = 0, saw_txt = 0;
            for (i = 0; i < br->len; i++) {
                if (br->ents[i].is_dir) continue;
                if (strstr(br->ents[i].name, ".md")) saw_md = 1;
                if (strstr(br->ents[i].name, ".txt")) saw_txt = 1;
            }
            expect(saw_md, ">*.md lists markdown under subfolders");
            expect(!saw_txt, ">*.md hides non-markdown files");
        }
        w.browse_glob_set(">*.txt") !>;
        br = RtxWs_browse(&w);
        browse_wait(br) !>;
        {
            int saw_txt = 0, saw_md = 0, saw_small = 0;
            for (i = 0; i < br->len; i++) {
                if (br->ents[i].is_dir) continue;
                if (strstr(br->ents[i].name, ".txt")) saw_txt = 1;
                if (strstr(br->ents[i].name, ".md")) saw_md = 1;
                if (strcmp(br->ents[i].name, "small.txt") == 0) saw_small = 1;
            }
            expect(saw_small && saw_txt, ">*.txt lists text files in the tree");
            expect(!saw_md, ">*.txt hides non-text files");
        }
        expect(!br->flat, "> flatten is not the typed-fragment chrome");
        w.browse_glob_set("readme") !>;
        br = RtxWs_browse(&w);
        expect(br->flat, "typed fragment starts flattened search");
        browse_wait(br) !>;
        expect(rtx_browse_head(br) == RTX_BROWSE_HEAD,
               "flatten row lives in the list, not the chrome");
        expect(rtx_browse_hit(br, RTX_BROWSE_HEAD - 1, 20) < 0,
               "glob row is not a list hit");
        expect(rtx_browse_hit(br, RTX_BROWSE_HEAD, 20) >= 0,
               "first list row sits under the chrome");
        {
            int saw_nested = 0, saw_small = 0, saw_sep = 0;
            size_t sepi = br->len, nest = br->len;
            for (i = 0; i < br->len; i++) {
                if (br->ents[i].sep) {
                    saw_sep = 1;
                    sepi = i;
                }
                if (strcmp(br->ents[i].name, "samples/readme.md") == 0) {
                    saw_nested = 1;
                    nest = i;
                }
                if (strcmp(br->ents[i].name, "small.txt") == 0) saw_small = 1;
            }
            expect(saw_sep, "typed flatten plants the divider");
            expect(saw_nested && nest > sepi, "nested readme is below the flatten row");
            expect(!saw_small, "typed flatten still filters");
        }
        w.browse_glob_set("small") !>;
        br = RtxWs_browse(&w);
        expect(br->flat, "a local hit still flattens");
        browse_wait(br) !>;
        expect(rtx_browse_head(br) == RTX_BROWSE_HEAD,
               "typed flatten does not steal a chrome row");
        {
            int saw_small = 0;
            for (i = 0; i < br->len; i++) {
                if (strcmp(br->ents[i].name, "small.txt") == 0) saw_small = 1;
            }
            expect(saw_small, "typed flatten still lists a local hit");
        }
        w.browse_glob_set(">readme") !>;
        br = RtxWs_browse(&w);
        browse_wait(br) !>;
        {
            int saw_nested = 0;
            for (i = 0; i < br->len; i++) {
                if (strcmp(br->ents[i].name, "samples/readme.md") == 0) {
                    saw_nested = 1;
                    br->cur = i;
                }
            }
            expect(saw_nested, "> fragment matches a nested basename");
        }
        w.browse_enter() !>;
        expect(!w.browsing(), "enter on a flattened path opens the file");
        expect(w.bufs[w.pane[0]].doc.path.ptr &&
               strstr(w.bufs[w.pane[0]].doc.path.ptr, "samples/readme.md"),
               "flattened enter joins the subfolder");
    }

    {
        /* /code-shaped flatten: many siblings + a vendor tree + make.shcc.
         * A wave of every remaining dir made Enter/kick join the whole
         * walk. node_modules must not be descended. */
        RtxWs w = {0} @destroy;
        RtxBrowse *br;
        char *paths[1];
        char abs[RTX_BROWSE_DIR];
        char path[192];
        char row[80];
        FILE *fp;
        int k;
        size_t i;
        int saw_hit = 0, saw_vendor = 0;
        struct timeval t0, t1;
        long ms;
        const char *rel = "testdata/generated/browse_flat_wide";
        RtxBrowseEnt sep, deep;
        paths[0] = (char *)"testdata/small.txt";
        (void)system("rm -rf testdata/generated/browse_flat_wide");
        expect(system("mkdir -p testdata/generated/browse_flat_wide/node_modules") == 0,
               "mkdir flatten vendor");
        expect(system("mkdir -p testdata/generated/browse_flat_wide/proj") == 0,
               "mkdir flatten proj");
        fp = fopen("testdata/generated/browse_flat_wide/node_modules/make.shcc", "w");
        expect(fp != NULL, "write vendor shcc");
        if (fp) {
            fputs("vendor\n", fp);
            fclose(fp);
        }
        fp = fopen("testdata/generated/browse_flat_wide/proj/make.shcc", "w");
        expect(fp != NULL, "write proj shcc");
        if (fp) {
            fputs("ok\n", fp);
            fclose(fp);
        }
        for (k = 0; k < 48; k++) {
            snprintf(path, sizeof(path), "%s/d%02d", rel, k);
            expect(mkdir(path, 0755) == 0, "mkdir flatten sibling");
            snprintf(path, sizeof(path), "%s/d%02d/sub", rel, k);
            expect(mkdir(path, 0755) == 0, "mkdir flatten nested");
        }
        sep = (RtxBrowseEnt){0};
        sep.sep = 1;
        snprintf(sep.name, sizeof(sep.name), "> Flattened search");
        rtx_browse_fmt_row(row, sizeof(row), 44, &sep);
        expect(strstr(row, "Flattened search") != NULL,
               "divider keeps 'search' when size columns would clip it");
        deep = (RtxBrowseEnt){0};
        snprintf(deep.name, sizeof(deep.name), "concurrent-c/test/make.shcc");
        rtx_browse_fmt_row(row, sizeof(row), 44, &deep);
        expect(strstr(row, "make.shcc") != NULL,
               "a long flatten path keeps the basename");
        w.open_files(1, paths) !>;
        w.browse_start() !>;
        br = RtxWs_browse(&w);
        expect(rtx_browse_abs(abs, sizeof(abs), rel) && abs[0],
               "abs flatten wide");
        snprintf(br->dir, sizeof(br->dir), "%s", abs);
        gettimeofday(&t0, NULL);
        w.browse_glob_set("shcc") !>;
        gettimeofday(&t1, NULL);
        ms = (t1.tv_sec - t0.tv_sec) * 1000L + (t1.tv_usec - t0.tv_usec) / 1000L;
        expect(ms < 2000, "flatten kick returns; wave is not the whole tree");
        br = RtxWs_browse(&w);
        browse_wait(br) !>;
        for (i = 0; i < br->len; i++) {
            if (strstr(br->ents[i].name, "proj/make.shcc")) saw_hit = 1;
            if (strstr(br->ents[i].name, "node_modules")) saw_vendor = 1;
        }
        expect(saw_hit, "flatten finds proj/make.shcc");
        expect(!saw_vendor, "flatten does not descend node_modules");
        gettimeofday(&t0, NULL);
        w.browse_glob_set("shcc") !>;
        w.browse_glob_set("zzz") !>;
        gettimeofday(&t1, NULL);
        ms = (t1.tv_sec - t0.tv_sec) * 1000L + (t1.tv_usec - t0.tv_usec) / 1000L;
        expect(ms < 2000, "cancel+kick during flatten joins a wave, not the tree");
        br = RtxWs_browse(&w);
        browse_wait(br) !>;
        (void)system("rm -rf testdata/generated/browse_flat_wide");
    }

    {
        RtxWs w = {0} @destroy;
        RtxBrowse *br;
        RtxBrowsePrev *pv;
        char *paths[1];
        size_t i;
        int saw_dir = 0;
        paths[0] = (char *)"testdata/small.txt";
        w.open_files(1, paths) !>;
        w.browse_start() !>;
        br = RtxWs_browse(&w);
        browse_wait(br) !>;
        expect(br->len && strcmp(br->ents[br->cur].name, "small.txt") == 0,
               "preview smoke starts on small.txt");
        w.browse_prev_sync(0, &m, 40.0, 8) !>;
        pv = &w.prev[0];
        expect(pv->live && pv->kind == RTX_BROWSE_PREV_FILE,
               "selected file opens a preview doc");
        expect(strstr(pv->path, "small.txt") != NULL, "preview path is the selection");
        expect(pv->layout.view == RTX_VIEW_DEFAULT, "preview starts in default");
        expect(pv->layout.rows.len > 0, "preview fills the first window");
        expect(pv->doc.dirty() == 0, "preview is not a dirty buf");
        {
            RtxScrollRail rail = rtx_browse_prev_rail(pv, 8);
            expect(rail.len == pv->doc.len(), "preview rail matches the doc");
            expect(rail.vis > 0, "preview rail has a window");
        }
        w.browse_prev_cycle(0);
        expect(pv->layout.view == RTX_VIEW_WRAP, "Ctrl-L preview -> wrap");
        w.browse_prev_sync(0, &m, 40.0, 8) !>;
        expect(pv->live && pv->layout.view == RTX_VIEW_WRAP,
               "wrap refill keeps the same doc");
        w.browse_prev_cycle(0);
        expect(pv->layout.view == RTX_VIEW_HEX, "Ctrl-L preview -> hex");
        w.browse_prev_cycle(0);
        expect(pv->layout.view == RTX_VIEW_GRID, "Ctrl-L preview -> grid");
        w.browse_prev_cycle(0);
        expect(pv->layout.view == RTX_VIEW_DEFAULT, "Ctrl-L preview wraps around");
        for (i = 0; i < br->len; i++) {
            if (br->ents[i].is_dir && strcmp(br->ents[i].name, "..") != 0) {
                rtx_browse_select(br, i, 20);
                saw_dir = 1;
                break;
            }
        }
        expect(saw_dir, "listing has a directory for the placeholder");
        w.browse_prev_sync(0, &m, 40.0, 8) !>;
        pv = &w.prev[0];
        expect(!pv->live && pv->kind == RTX_BROWSE_PREV_DIR,
               "directory selection drops the preview doc");
        expect(pv->layout.view == RTX_VIEW_DEFAULT,
               "preview view survives a directory selection");
        w.browse_close();
        expect(!w.prev[0].live && w.prev[0].kind == RTX_BROWSE_PREV_NONE,
               "closing browse drops the preview");
    }

    {
        RtxWs w = {0} @destroy;
        RtxBrowse *br;
        RtxBrowsePrev *pv;
        char *paths[1];
        paths[0] = (char *)"testdata/grid_rfc.csv";
        w.open_files(1, paths) !>;
