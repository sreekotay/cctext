#!ccc ccs
/*
 * Save, undo/redo, selection, incremental layout, multifile workspace.
 */
#include <ccc/std/prelude.cch>
#include <ccc/script/stdio.cch>
#include <stdio.h>
#include <string.h>
#include <unistd.h>
#include "../core/document.cch"
#include "../core/layout.cch"
#include "../core/workspace.cch"

static int fails = 0;

static void expect(int cond, const char *msg) {
    if (!cond) {
        fprintf(stderr, "FAIL: %s\n", msg);
        fails++;
    }
}

static void expect_text(RtxDoc *d, const char *want, const char *msg) {
    size_t n = d->len();
    char buf[4096];
    size_t got;
    expect(n == strlen(want), msg);
    if (n >= sizeof(buf)) {
        expect(0, "expect_text buffer");
        return;
    }
    got = d->read_at(0, buf, n) !>;
    expect(got == n, msg);
    buf[n] = 0;
    expect(memcmp(buf, want, n) == 0, msg);
    if (n != strlen(want) || memcmp(buf, want, n) != 0) {
        fprintf(stderr, "  got '%s' want '%s' (%s)\n", buf, want, msg);
    }
}

static double meas(void *ctx, char[:] bytes, RtxStyle style, RtxSectionKind sec) {
    (void)ctx;
    (void)style;
    (void)sec;
    return (double)bytes.len;
}

static double lh(void *ctx, RtxStyle style, RtxSectionKind sec) {
    (void)ctx;
    (void)style;
    (void)sec;
    return 1.0;
}

int main(void) {
    @errhandler(CCError e) { cc_error_log(e); return 1; }
    @errhandler(RtxIndexErr e) {
        fprintf(stderr, "%s\n", e.message ? e.message : "index");
        return 1;
    }
    RtxMeasure m;
    m.measure = meas;
    m.line_height = lh;
    m.ctx = NULL;

    {
        RtxDoc d = {0} @destroy;
        d.from_buffer("ab") !>;
        expect(!d.dirty(), "clean at open");
        d.caret = d.len();
        d.sel_anchor = d.caret;
        d.type("X") !>;
        expect_text(&d, "abX", "type at end");
        expect(d.caret == 3, "caret after type");
        expect(d.dirty(), "dirty after type");
        d.undo() !>;
        expect_text(&d, "ab", "undo type");
        expect(d.caret == 2, "caret restored");
        expect(!d.dirty(), "clean after undo to save point");
        d.redo() !>;
        expect_text(&d, "abX", "redo");
        expect(d.dirty(), "dirty after redo");
    }

    {
        RtxDoc d = {0} @destroy;
        const char *hello = "hello";
        size_t i;
        d.from_buffer("") !>;
        for (i = 0; i < 5; i++) {
            char s[2];
            s[0] = hello[i];
            s[1] = 0;
            d.type(s.to_slice_n(1)) !>;
        }
        expect_text(&d, "hello", "coalesced type");
        expect(d.hist.head == 1, "one hist rec for hello");
        d.undo() !>;
        expect_text(&d, "", "one undo removes hello");
        d.redo() !>;
        expect_text(&d, "hello", "redo hello");
    }

    {
        RtxDoc d = {0} @destroy;
        d.from_buffer("abcdef") !>;
        d.caret = 2;
        d.sel_anchor = 5;
        expect(d.has_sel(), "has sel");
        expect(d.sel_lo() == 2 && d.sel_hi() == 5, "sel range");
        d.type("Z") !>;
        expect_text(&d, "abZf", "type over sel");
        d.undo() !>;
        expect_text(&d, "abcdef", "undo replace sel");
        expect(d.caret == 2 && d.sel_anchor == 5, "sel restored");
    }

    {
        RtxDoc d = {0} @destroy;
        const char *path = "testdata/generated/save_roundtrip.txt";
        FILE *f;
        char got[64];
        size_t n;
        if (system("mkdir -p testdata/generated") != 0) expect(0, "mkdir");
        d.from_buffer("orig") !>;
        d.caret = d.len();
        d.sel_anchor = d.caret;
        d.type("-edit") !>;
        d.save_as(path) !>;
        expect(!d.dirty(), "clean after save");
        expect(d.path.eq_cstr(path), "path set");
        f = fopen(path, "r");
        expect(f != NULL, "saved file");
        n = f ? fread(got, 1, sizeof(got), f) : 0;
        if (f) fclose(f);
        expect(n == 9 && memcmp(got, "orig-edit", 9) == 0, "file bytes");
        d.undo() !>;
        expect(d.dirty(), "dirty after undo past save");
        d.redo() !>;
        expect(!d.dirty(), "clean after redo to save");
        {
            RtxDoc d2 = {0} @destroy;
            d2.from_path(path) !>;
            expect_text(&d2, "orig-edit", "reopen saved");
        }
        unlink(path);
    }

    {
        RtxDoc d = {0} @destroy;
        RtxLayout L = {0} @destroy;
        size_t i;
        uint8_t body_buf[2048];
        CCArena body_arena = cc_arena_fixed_buffer(body_buf, sizeof(body_buf)) @destroy;
        char[:] body;
        size_t n = 0;
        size_t row10_start;
        size_t tail_start;
        body = body_arena.alloc_slice_bytes(sizeof(body_buf));
        expect(body.ptr != NULL, "body arena");
        if (!body.ptr) return 1;
        for (i = 0; i < 40; i++) {
            n += (size_t)snprintf(body.ptr + n, body.len - n, "line-%02zu xxxx\n", i);
        }
        d.from_buffer(body.sub(0, n)) !>;
        d.secs[0].kind = RTX_SEC_CODE;
        L.doc(&d, &m, 80) !>;
        expect(L.len == 40, "40 visual rows");
        row10_start = L.rows[10].byte_start;
        tail_start = L.rows[30].byte_start;
        d.caret = row10_start + 5;
        d.sel_anchor = d.caret;
        d.type("Z") !>;
        L.view_after_edit(&d, &m, 80) !>;
        expect(L.len == 40, "row count unchanged after mid insert");
        expect(L.rows[10].byte_start == row10_start, "edited row start");
        expect(L.rows[30].byte_start == tail_start + 1, "later row start after insert");
        expect(L.rows[5].byte_start < row10_start, "head unshifted");
    }

    {
        RtxWs w = {0} @destroy;
        char *paths[2];
        paths[0] = (char *)"testdata/small.txt";
        paths[1] = (char *)"testdata/mixed.txt";
        w.open_files(2, paths) !>;
        expect(w.len == 2, "two buffers");
        expect(w.npanes == 2, "split on two files");
        expect(w.doc() == &w.bufs[0].doc, "focus first");
        w.focus_other();
        expect(w.doc() == &w.bufs[1].doc, "focus second");
        w.next_buf();
        expect(w.pane[1] == 0, "cycle pane buffer");
    }

    {
        RtxWs w = {0} @destroy;
        char *paths[1];
        paths[0] = (char *)"testdata/small.txt";
        w.open_files(1, paths) !>;
        w.toggle_split();
        expect(w.npanes == 2 && RtxWs_same_split(&w), "same-file split has two cameras");
        w.bufs[0].top = 0;
        w.side.top = 0;
        {
            RtxBuf *act = RtxWs_active(&w);
            act->top = 2;
            expect(w.bufs[0].top == 2, "focus camera is on the buf");
            w.focus_other();
            act = RtxWs_active(&w);
            expect(act->top == 0, "other pane kept its own top");
        }
        expect(w.side.top == 2, "unfocused top is stashed");
        w.toggle_split();
        expect(w.npanes == 1 && !RtxWs_same_split(&w), "unsplit drops the side camera");
    }

    {
        RtxWs w = {0} @destroy;
        RtxBuf *act;
        char *paths[1];
        size_t i, n;
        paths[0] = (char *)"testdata/small.txt";
        w.open_files(1, paths) !>;
        w.toggle_split();
        act = RtxWs_active(&w);
        act->ensure_view(&m, 40, 4) !>;
        w.focus_other();
        act = RtxWs_active(&w);
        act->ensure_view(&m, 40, 4) !>;
        expect(w.side.live && w.side.layout.len > 0, "unfocused camera has rows");
        w.side.layout.rows[0].byte_start = 100000;
        w.side.layout.rows[0].byte_len = 50;
        act->doc.caret = 0;
        act->doc.sel_anchor = 0;
        act->doc.delete_forward() !>;
        w.after_edit(w.pane[w.focus], &m, 40, 40, 4) !>;
        n = act->len();
        expect(w.side.layout.len > 0, "unfocused camera rebuilt after edit");
        for (i = 0; i < w.side.layout.len; i++) {
            expect(w.side.layout.rows[i].byte_start + w.side.layout.rows[i].byte_len <= n,
                   "unfocused row in range after edit");
        }
        for (i = 0; i < act->layout.len; i++) {
            expect(act->layout.rows[i].byte_start + act->layout.rows[i].byte_len <= n,
                   "focused row in range after edit");
        }
    }

    {
        RtxWs w = {0} @destroy;
        RtxBrowse *br;
        size_t i;
        int saw_txt = 0;
        char *paths[1];
        paths[0] = (char *)"testdata/small.txt";
        w.open_files(1, paths) !>;
        w.browse_start() !>;
        br = RtxWs_browse(&w);
        expect(br && br->on, "browse opens in the focused view");
        expect(strstr(br->dir, "testdata") != NULL, "starts in the file's directory");
        expect(br->len && strcmp(br->ents[br->cur].name, "small.txt") == 0,
               "browse preselects the open file");
        w.browse_glob_set("*.txt") !>;
        br = RtxWs_browse(&w);
        expect(br->len && strcmp(br->ents[br->cur].name, "small.txt") == 0,
               "glob keeps the open file selected");
        for (i = 0; i < br->len; i++) {
            if (!br->ents[i].is_dir && strstr(br->ents[i].name, ".txt"))
                saw_txt = 1;
        }
        expect(saw_txt, "glob *.txt lists text files");
        w.open_in_pane("testdata/mixed.txt") !>;
        expect(!w.browsing(), "open closes the browser");
        expect(w.len == 2, "new file is a new buf");
        expect(w.pane[0] == 1, "focused view shows the opened file");
    }

    {
        RtxWs w = {0} @destroy;
        char *paths[1];
        paths[0] = (char *)"testdata/small.txt";
        w.open_files(1, paths) !>;
        w.toggle_split();
        expect(RtxWs_same_split(&w), "same-file split before open");
        w.open_in_pane("testdata/mixed.txt") !>;
        expect(!RtxWs_same_split(&w), "other view keeps the old file");
        expect(w.npanes == 2 && w.pane[0] != w.pane[1], "split now shows two files");
    }

    {
        RtxDoc d = {0} @destroy;
        d.from_buffer("ab\ncd\nef") !>;
        d.caret = 4;
        d.sel_anchor = 4;
        d.select_all();
        expect(d.sel_anchor == 0 && d.caret == 8, "select all");
        d.caret = 4;
        d.sel_anchor = 4;
        d.move_line_edge(0, 0) !>;
        expect(d.caret == 3 && d.sel_anchor == 3, "line start");
        d.move_line_edge(1, 0) !>;
        expect(d.caret == 5 && d.sel_anchor == 5, "line end before nl");
        d.caret = 4;
        d.sel_anchor = 4;
        d.move_line_edge(0, 1) !>;
        expect(d.caret == 3 && d.sel_anchor == 4, "shift to line start");
    }

    {
        RtxWs w = {0} @destroy;
        RtxUi ui;
        char *paths[1];
        paths[0] = (char *)"testdata/small.txt";
        memset(&ui, 0, sizeof(ui));
        w.open_files(1, paths) !>;
        expect(rtx_ui_offer_quit(&w, &ui) == 1, "clean quits now");
        expect(!ui.ask_quit, "no prompt when clean");
        {
            RtxDoc *d = w.doc();
            d->type("Z") !>;
            expect(w.any_dirty(), "dirty after type");
            expect(rtx_ui_offer_quit(&w, &ui) == 0, "dirty asks");
            expect(ui.ask_quit, "prompt open");
            ui.ask_quit = 0;
            expect(!ui.ask_quit, "cancel closes the prompt");
            expect(w.any_dirty(), "cancel does not save");
        }
    }

    {
        char *av[6];
        char *files[4];
        RtxCli cli;
        av[0] = (char *)"cctext";
        av[1] = (char *)"--wrap";
        av[2] = (char *)"--";
        av[3] = (char *)"--not-a-flag.txt";
        av[4] = (char *)"testdata/wrap.txt";
        expect(rtx_cli_parse(5, av, files, 4, &cli) == 0, "cli parse");
        expect(cli.view == RTX_VIEW_WRAP && !cli.help, "cli --wrap");
        expect(cli.nfiles == 2, "cli -- ends options");
        av[1] = (char *)"--view=hex";
        av[2] = (char *)"testdata/small.txt";
        expect(rtx_cli_parse(3, av, files, 4, &cli) == 0, "cli --view=");
        expect(cli.view == RTX_VIEW_HEX && cli.nfiles == 1, "cli hex file");
        av[1] = (char *)"--help";
        expect(rtx_cli_parse(2, av, files, 4, &cli) == 0 && cli.help, "cli help");
        av[1] = (char *)"--view";
        av[2] = (char *)"nope";
        expect(rtx_cli_parse(3, av, files, 4, &cli) != 0, "cli bad view");
        av[1] = (char *)"--wrap";
        av[2] = (char *)"testdata/small.txt";
        av[3] = (char *)"--hex";
        av[4] = (char *)"testdata/mixed.txt";
        expect(rtx_cli_parse(5, av, files, 4, &cli) == 0, "cli per-file view");
        expect(cli.nfiles == 2, "cli two files");
        expect(cli.file_view[0] == RTX_VIEW_WRAP && cli.file_view[1] == RTX_VIEW_HEX,
               "each file keeps its view flag");
    }

    {
        RtxWs w = {0} @destroy;
        char *paths[2];
        int views[2];
        paths[0] = (char *)"testdata/small.txt";
        paths[1] = (char *)"testdata/mixed.txt";
        views[0] = RTX_VIEW_WRAP;
        views[1] = RTX_VIEW_HEX;
        w.open_files(2, paths) !>;
        w.set_views(views, 2);
        expect(w.npanes == 2 && w.pane[0] != w.pane[1], "two files split");
        expect(w.bufs[0].layout.wrap, "first pane wrap");
        expect(rtx_layout_is_hex(&w.bufs[1].layout), "second pane hex");
    }

    if (fails) {
        fprintf(stderr, "%d failure(s)\n", fails);
        return 1;
    }
    printf("edit_session_smoke ok\n");
    return 0;
}
