            expect(!ui.ask_quit, "cancel closes the prompt");
            expect(w.any_dirty(), "cancel does not save");
        }
        w.safe_discard_dirty();
    }

    {
        /* External change: save refuses; overwrite writes our buffer. */
        RtxDoc d = {0} @destroy;
        const char *path = "testdata/generated/save_conflict.txt";
        CCError e = {0};
        int saw;
        FILE *f;
        char got[32];
        size_t n;
        RtxUi ui = {0};
        if (system("mkdir -p testdata/generated") != 0) expect(0, "mkdir");
        unlink(path);
        write_cstr_path(path, "hello");
        d.from_path(path) !>;
        expect(!d.disk_changed(), "open matches disk");
        d.caret = d.len();
        d.sel_anchor = d.caret;
        d.type("!") !>;
        write_cstr_path(path, "hello-ext");
        bump_mtime(path);
        expect(d.disk_changed(), "external write is a conflict");
        saw = try_save(&d, &e);
        expect(saw && e.message && strstr(e.message, "changed"),
               "save refuses a drifted path");
        expect_text(&d, "hello!", "buffer stays ours after refuse");
        f = fopen(path, "r");
        n = f ? fread(got, 1, sizeof(got), f) : 0;
        if (f) fclose(f);
        expect(n == 9 && ({ char[:] __s = cc_slice_from_buffer(got, 9);
                            __s.eq_cstr("hello-ext"); }),
               "disk stays the external bytes");
        rtx_ui_offer_conflict(&ui);
        expect(ui.ask_conflict, "conflict prompt open");
        expect(rtx_ui_conflict_letter('s') == 1, "s overwrites");
        expect(rtx_ui_conflict_letter('c') == 0, "c cancels");
        ui.ask_conflict = 0;
        d.save_overwrite();
        d.save() !>;
        expect(!d.dirty() && !d.disk_changed(), "overwrite restamps");
        f = fopen(path, "r");
        n = f ? fread(got, 1, sizeof(got), f) : 0;
        if (f) fclose(f);
        expect(n == 6 && ({ char[:] __s = cc_slice_from_buffer(got, 6);
                            __s.eq_cstr("hello!"); }),
               "overwrite writes our buffer");
        unlink(path);
        d.type("x") !>;
        expect(!d.disk_changed(), "deleted dest is not a conflict");
        d.save() !>;
        expect(!d.dirty(), "save recreates a missing path");
        unlink(path);
    }

    {
        /* --backup + same-size external edit: overwrite is a full write. */
        RtxDoc d = {0} @destroy;
        const char *path = "testdata/generated/save_conflict_backup.txt";
        int prev = rtx_doc_save_backup();
        CCError e = {0};
        int saw;
        FILE *f;
        char got[32];
        size_t n;
        if (system("mkdir -p testdata/generated") != 0) expect(0, "mkdir");
        unlink(path);
        write_cstr_path(path, "hello world");
        rtx_doc_set_save_backup(1);
        d.from_path(path) !>;
        d.caret = 0;
        d.sel_anchor = 5;
        d.type("HELLO") !>;
        write_cstr_path(path, "hello WORLD");
        bump_mtime(path);
        expect(d.disk_changed(), "same-size external is a conflict");
        saw = try_save(&d, &e);
        expect(saw && e.message && strstr(e.message, "changed"),
               "backup save refuses a drifted path");
        d.save_overwrite();
        d.save() !>;
        f = fopen(path, "r");
        n = f ? fread(got, 1, sizeof(got), f) : 0;
        if (f) fclose(f);
        expect(n == 11 && ({ char[:] __s = cc_slice_from_buffer(got, 11);
                             __s.eq_cstr("HELLO world"); }),
               "overwrite does not splice the drifted tail");
        rtx_doc_set_save_backup(prev);
        unlink(path);
        unlink("testdata/generated/save_conflict_backup.txt~");
    }

    {
        RtxDoc d = {0} @destroy;
        size_t used;
        int saw;
        d.empty() !>;
        d.type("a") !>;
        d.type("b") !>;
        expect_text(&d, "ab", "coalesce type");
        expect(d.hist.head == 1, "one coalesced rec");
        used = d.hist.recs[0].ins.len;
        expect(used == 2, "hist has ab");
        RtxPieceTree_fail_next_replace(&d.tree, 0);
        {
            CCError e = {0};
            saw = try_type(&d, "c", &e);
            expect(saw, "type c failed");
            expect(e.kind == CC_ERR_INTERNAL, "failed type is INTERNAL");
            expect(!rtx_err_is_unrestorable(e), "failed type is not unrestorable");
        }
        expect_text(&d, "ab", "tree unchanged after failed coalesce");
        expect(d.hist.recs[0].ins.len == used, "hist unused until replace commits");
        expect(!d.broken, "failed replace is unchanged, not broken");
        d.undo() !>;
        expect_text(&d, "", "undo coalesced types");
    }

    {
        RtxDoc d = {0} @destroy;
        int saw;
        d.empty() !>;
        d.type("a") !>;
        RtxPieceTree_fail_next_replace(&d.tree, 1);
        {
            CCError e = {0};
            saw = try_type(&d, "b", &e);
            expect(saw, "type b unrestorable");
            expect(rtx_err_is_unrestorable(e), "unrestorable kind");
        }
        expect(d.broken, "doc copies unrestorable onto broken");
        {
            CCError e = {0};
            saw = try_type(&d, "c", &e);
            expect(saw, "edit refused");
            expect(e.kind == CC_ERR_INTERNAL, "broken refuses edits");
        }
        expect_text(&d, "a", "unrestorable one-shot does not mutate");
    }

    {
        RtxDoc d = {0} @destroy;
        size_t used;
        int saw;
        d.empty() !>;
        d.type("a") !>;
        d.type("b") !>;
        expect_text(&d, "ab", "coalesce before commit fault");
        expect(d.hist.head == 1, "one coalesced rec before fault");
        used = d.hist.recs[0].ins.len;
        expect(used == 2, "hist still ab before commit fault");
        rtx_hist_fail_next_coalesce_commit();
        {
            CCError e = {0};
            saw = try_type(&d, "c", &e);
            expect(saw, "type c commit failed");
            expect(rtx_err_is_unrestorable(e), "commit-after-replace unrestorable");
        }
        expect(d.broken, "commit fault sets broken");
        expect_text(&d, "abc", "tree advanced before commit failed");
        expect(d.hist.recs[0].ins.len == used, "hist still pre-commit");
        {
            CCError e = {0};
            saw = try_type(&d, "d", &e);
            expect(saw, "edit refused when broken");
            expect(e.kind == CC_ERR_INTERNAL, "broken refuses edits");
        }
        {
            CCError e = {0};
            saw = try_undo(&d, &e);
            expect(saw, "undo refused when broken");
            expect(e.kind == CC_ERR_INTERNAL, "broken refuses undo");
        }
        expect_text(&d, "abc", "broken leaves tree as after replace");
    }

