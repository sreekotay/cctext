        d.empty() !>;
        d.type("a") !>;
        d.type("b") !>;
        expect_text(&d, "ab", "coalesce type");
        expect(d.hist.head == 1, "one coalesced rec");
        used = d.hist.recs[0].ins_used;
        expect(used == 2, "hist has ab");
        RtxPieceTree_fail_next_replace(&d.tree, 0);
        {
            CCError e = {0};
            saw = try_type(&d, "c", &e);
            expect(saw, "type c failed");
            expect(e.kind == CC_ERR_INTERNAL, "failed type is INTERNAL");
            expect(!rtx_err_is_unrestorable(e), "failed type is not unrestorable");
        }
        expect_text(&d, "ab", "tree unchanged after failed coalesce");
        expect(d.hist.recs[0].ins_used == used, "hist unused until replace commits");
        expect(!d.broken, "failed replace is unchanged, not broken");
        d.undo() !>;
        expect_text(&d, "", "undo coalesced types");
    }

    {
        RtxDoc d = {0} @destroy;
