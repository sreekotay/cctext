    {
        /* > 256 KiB: hist stores piece refs, not omitted bytes. */
        RtxDoc d = {0} @destroy;
        CCArena body = {0} @destroy;
        char[:] big;
        size_t n = 300 * 1024;
        size_t i;
        char c;
        body = cc_arena_heap(n + 64);
        expect(body.base != NULL, "large del body arena");
        if (!body.base) return 1;
        big = body.alloc_slice_bytes(n);
        expect(big.ptr != NULL && big.len >= n, "large del body");
        if (!big.ptr) return 1;
        for (i = 0; i < n; i++) {
            big.ptr[i] = (i % 64 == 63) ? '\n' : (char)('a' + (i % 26));
        }
        big.ptr[0] = 'S';
        big.ptr[n / 2] = 'M';
        big.ptr[n - 1] = 'E';
        d.from_buffer(big) !>;
        d.select_all();
        d.backspace() !>;
        expect(d.len() == 0, "select-all delete 300KiB");
        expect(d.hist.recs[d.hist.head - 1].del_ref_n >= 1, "hist kept piece refs");
        expect(d.hist.recs[d.hist.head - 1].del_n == n, "hist del_n");
        d.undo() !>;
        expect(d.len() == n, "undo restore 300KiB");
        expect((d.read_at(0, &c, 1) !>) == 1 && c == 'S', "undo start");
        expect((d.read_at(n / 2, &c, 1) !>) == 1 && c == 'M', "undo mid");
        expect((d.read_at(n - 1, &c, 1) !>) == 1 && c == 'E', "undo end");
        d.redo() !>;
        expect(d.len() == 0, "redo delete 300KiB");
        d.undo() !>;
        expect(d.len() == n, "undo after redo 300KiB");
        d.select_all();
        d.type("Z") !>;
        expect(d.len() == 1, "type over 300KiB sel");
        d.undo() !>;
        expect(d.len() == n, "undo type-over-sel");
        expect((d.read_at(0, &c, 1) !>) == 1 && c == 'S', "undo type-over-sel start");
        d.redo() !>;
        expect(d.len() == 1, "redo type-over-sel");
    }

    {
        /* Fragmented tree: insert then delete the whole buffer. */
        RtxDoc d = {0} @destroy;
        CCArena body = {0} @destroy;
        char[:] big;
        size_t n = 300 * 1024;
        size_t i;
        char c;
        body = cc_arena_heap(n + 64);
        expect(body.base != NULL, "frag del body arena");
        if (!body.base) return 1;
        big = body.alloc_slice_bytes(n);
        expect(big.ptr != NULL, "frag del body");
        if (!big.ptr) return 1;
        for (i = 0; i < n; i++) big.ptr[i] = 'a';
        big.ptr[0] = 'S';
        big.ptr[n - 1] = 'E';
        d.from_buffer(big) !>;
        d.caret = n / 2;
        d.sel_anchor = n / 2;
        d.type("MID") !>;
        d.select_all();
        d.backspace() !>;
        expect(d.len() == 0, "frag select-all delete");
        expect(d.hist.recs[d.hist.head - 1].del_ref_n >= 2, "frag hist several refs");
        d.undo() !>;
        expect(d.len() == n + 3, "frag undo len");
        expect((d.read_at(0, &c, 1) !>) == 1 && c == 'S', "frag undo start");
        expect((d.read_at(n / 2, &c, 1) !>) == 1 && c == 'M', "frag undo MID");
        expect((d.read_at(n + 2, &c, 1) !>) == 1 && c == 'E', "frag undo end");
    }

    {
        /* Path-backed 16 KiB: above frame scratch, below inline hist cap. */
        RtxDoc d = {0} @destroy;
        const char *path = "testdata/generated/sel_del_16k.txt";
        FILE *f;
        char buf[1024];
        size_t n = 16 * 1024;
        size_t i;
        char c;
        if (system("mkdir -p testdata/generated") != 0) expect(0, "mkdir 16k");
        memset(buf, 'a', sizeof(buf));
        buf[0] = 'S';
        buf[sizeof(buf) - 1] = '\n';
        f = fopen(path, "w");
        expect(f != NULL, "16k write");
        if (f) {
            for (i = 0; i < n / sizeof(buf); i++) {
                if (i == 0) buf[0] = 'S';
                else buf[0] = 'a';
                fwrite(buf, 1, sizeof(buf), f);
            }
            fclose(f);
        }
        d.from_path(path) !>;
        expect(d.len() == n, "16k path len");
        d.select_all();
        d.backspace() !>;
        expect(d.len() == 0, "16k path delete");
        d.undo() !>;
        expect(d.len() == n, "16k path undo");
        expect((d.read_at(0, &c, 1) !>) == 1 && c == 'S', "16k undo start");
        d.redo() !>;
        expect(d.len() == 0, "16k path redo");
        unlink(path);
    }

    {
        RtxWs w = {0} @destroy;
        const char *path = "testdata/generated/clip_16k.txt";
        FILE *f;
        char buf[1024];
        size_t n = 16 * 1024;
        size_t i;
        char *paths[1];
        if (system("mkdir -p testdata/generated") != 0) expect(0, "mkdir clip");
        memset(buf, 'x', sizeof(buf));
        f = fopen(path, "w");
        expect(f != NULL, "clip 16k write");
        if (f) {
            for (i = 0; i < n / sizeof(buf); i++) {
                buf[0] = (i == 0) ? 'C' : 'x';
                fwrite(buf, 1, sizeof(buf), f);
            }
            fclose(f);
        }
        paths[0] = (char *)path;
        w.open_files(1, paths) !>;
        {
            RtxDoc *d = w.doc();
            d->select_all();
        }
        expect((w.copy() !>) == 1, "copy 16k");
        expect(w.clip.len == n && w.clip.ptr && w.clip.ptr[0] == 'C', "clip 16k");
        unlink(path);
    }

    if (fails) {
        fprintf(stderr, "%d failure(s)\n", fails);
        return 1;
    }
    printf("edit_session_smoke ok\n");
    return 0;
}
