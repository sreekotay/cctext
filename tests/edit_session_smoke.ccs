#!ccc ccs
/*
 * Save, undo/redo, selection, incremental layout, multifile workspace.
 */
#include <ccc/std/prelude.cch>
#include <ccc/script/stdio.cch>
#include <fcntl.h>
#include <stdio.h>
#include <string.h>
#include <sys/stat.h>
#include <unistd.h>
#include "../core/document.cch"
#include "../core/layout.cch"
#include "../core/workspace.cch"
#include "../core/find.cch"
#include "../core/ui.cch"
#include "../core/browse.cch"

static int fails = 0;

static void expect(int cond, const char *msg) {
    if (!cond) {
        fprintf(stderr, "FAIL: %s\n", msg);
        fails++;
    }
}

static void expect_text(RtxDoc *d, const char *want, const char *msg) {
    size_t n = d->len();
    char buf[4096];
    size_t got;
    expect(n == strlen(want), msg);
    if (n >= sizeof(buf)) {
        expect(0, "expect_text buffer");
        return;
    }
    got = d->read_at(0, buf, n) !>;
    expect(got == n, msg);
    buf[n] = 0;
    expect(memcmp(buf, want, n) == 0, msg);
    if (n != strlen(want) || memcmp(buf, want, n) != 0) {
        fprintf(stderr, "  got '%s' want '%s' (%s)\n", buf, want, msg);
    }
}

static double meas(void *ctx, char[:] bytes, RtxStyle style, RtxSectionKind sec) {
    (void)ctx;
    (void)style;
    (void)sec;
    return (double)bytes.len;
}

static double lh(void *ctx, RtxStyle style, RtxSectionKind sec) {
    (void)ctx;
    (void)style;
    (void)sec;
    return 1.0;
}

static void !>(CCError) browse_wait(RtxBrowse *br) {
    if (!br) return cc_ok();
    return rtx_browse_finish(br);
}

static int try_type(RtxDoc *d, char[:] s, CCError *out) {
    @errhandler(CCError e) {
        if (out) *out = e;
        return 1;
    }
    d->type(s) !>;
    return 0;
}

int main(void) {
    @errhandler(CCError e) { cc_error_log(e); return 1; }
    @errhandler(RtxIndexErr e) {
        fprintf(stderr, "%s\n", e.message ? e.message : "index");
        return 1;
    }
    RtxMeasure m;
    m.measure = meas;
    m.line_height = lh;
    m.ctx = NULL;

    {
        RtxDoc d = {0} @destroy;
        d.from_buffer("ab") !>;
        expect(!d.dirty(), "clean at open");
        d.caret = d.len();
        d.sel_anchor = d.caret;
        d.type("X") !>;
        expect_text(&d, "abX", "type at end");
        expect(d.caret == 3, "caret after type");
        expect(d.dirty(), "dirty after type");
        d.undo() !>;
        expect_text(&d, "ab", "undo type");
        expect(d.caret == 2, "caret restored");
        expect(!d.dirty(), "clean after undo to save point");
        d.redo() !>;
        expect_text(&d, "abX", "redo");
        expect(d.dirty(), "dirty after redo");
    }

    {
        RtxDoc d = {0} @destroy;
        const char *hello = "hello";
        size_t i;
        d.from_buffer("") !>;
        for (i = 0; i < 5; i++) {
            char s[2];
            s[0] = hello[i];
            s[1] = 0;
            d.type(s.to_slice_n(1)) !>;
        }
        expect_text(&d, "hello", "coalesced type");
        expect(d.hist.head == 1, "one hist rec for hello");
        d.undo() !>;
        expect_text(&d, "", "one undo removes hello");
        d.redo() !>;
        expect_text(&d, "hello", "redo hello");
    }

    {
        RtxDoc d = {0} @destroy;
        d.from_buffer("abcdef") !>;
        d.caret = 2;
        d.sel_anchor = 5;
        expect(d.has_sel(), "has sel");
        expect(d.sel_lo() == 2 && d.sel_hi() == 5, "sel range");
        d.type("Z") !>;
        expect_text(&d, "abZf", "type over sel");
        d.undo() !>;
        expect_text(&d, "abcdef", "undo replace sel");
        expect(d.caret == 2 && d.sel_anchor == 5, "sel restored");
    }

    {
        RtxDoc d = {0} @destroy;
        const char *path = "testdata/generated/save_roundtrip.txt";
        FILE *f;
        char got[64];
        size_t n;
        if (system("mkdir -p testdata/generated") != 0) expect(0, "mkdir");
        d.from_buffer("orig") !>;
        d.caret = d.len();
        d.sel_anchor = d.caret;
        d.type("-edit") !>;
        d.save_as(path) !>;
        expect(!d.dirty(), "clean after save");
        expect(d.path.eq_cstr(path), "path set");
        f = fopen(path, "r");
        expect(f != NULL, "saved file");
        n = f ? fread(got, 1, sizeof(got), f) : 0;
        if (f) fclose(f);
        expect(n == 9 && memcmp(got, "orig-edit", 9) == 0, "file bytes");
        d.undo() !>;
        expect(d.dirty(), "dirty after undo past save");
        d.redo() !>;
        expect(!d.dirty(), "clean after redo to save");
        {
            RtxDoc d2 = {0} @destroy;
            d2.from_path(path) !>;
            expect_text(&d2, "orig-edit", "reopen saved");
        }
        unlink(path);
    }

    {
        RtxDoc d = {0} @destroy;
        RtxLayout L = {0} @destroy;
        size_t i;
        uint8_t body_buf[2048];
        CCArena body_arena = cc_arena_fixed_buffer(body_buf, sizeof(body_buf)) @destroy;
        char[:] body;
        size_t n = 0;
        size_t row10_start;
        size_t tail_start;
        body = body_arena.alloc_slice_bytes(sizeof(body_buf));
        expect(body.ptr != NULL, "body arena");
        if (!body.ptr) return 1;
        for (i = 0; i < 40; i++) {
            n += (size_t)snprintf(body.ptr + n, body.len - n, "line-%02zu xxxx\n", i);
        }
        d.from_buffer(body.sub(0, n)) !>;
        d.secs[0].kind = RTX_SEC_CODE;
        L.doc(&d, &m, 80) !>;
        expect(L.len == 40, "40 visual rows");
        row10_start = L.rows[10].byte_start;
        tail_start = L.rows[30].byte_start;
        d.caret = row10_start + 5;
        d.sel_anchor = d.caret;
        d.type("Z") !>;
        L.view_after_edit(&d, &m, 80) !>;
        expect(L.len == 40, "row count unchanged after mid insert");
        expect(L.rows[10].byte_start == row10_start, "edited row start");
        expect(L.rows[30].byte_start == tail_start + 1, "later row start after insert");
        expect(L.rows[5].byte_start < row10_start, "head unshifted");
    }

    {
        RtxWs w = {0} @destroy;
        char *paths[2];
        paths[0] = (char *)"testdata/small.txt";
        paths[1] = (char *)"testdata/mixed.txt";
        w.open_files(2, paths) !>;
        expect(w.len == 2, "two buffers");
        expect(w.npanes == 2, "split on two files");
        expect(w.doc() == &w.bufs[0].doc, "focus first");
        w.focus_other();
        expect(w.doc() == &w.bufs[1].doc, "focus second");
        w.next_buf();
        expect(w.pane[1] == 0, "cycle pane buffer");
    }

    {
        RtxWs w = {0} @destroy;
        char *paths[1];
        paths[0] = (char *)"testdata/small.txt";
        w.open_files(1, paths) !>;
        w.toggle_split();
        expect(w.npanes == 2 && RtxWs_same_split(&w), "same-file split has two cameras");
        w.bufs[0].top = 0;
        w.side.top = 0;
        {
            RtxBuf *act = RtxWs_active(&w);
            act->top = 2;
            expect(w.bufs[0].top == 2, "focus camera is on the buf");
            w.focus_other();
            act = RtxWs_active(&w);
            expect(act->top == 0, "other pane kept its own top");
        }
        expect(w.side.top == 2, "unfocused top is stashed");
        w.toggle_split();
        expect(w.npanes == 1 && !RtxWs_same_split(&w), "unsplit drops the side camera");
    }

    {
        RtxWs w = {0} @destroy;
        RtxBuf *act;
        char *paths[1];
        size_t i, n;
        paths[0] = (char *)"testdata/small.txt";
        w.open_files(1, paths) !>;
        w.toggle_split();
        act = RtxWs_active(&w);
        act->ensure_view(&m, 40, 4) !>;
        w.focus_other();
        act = RtxWs_active(&w);
        act->ensure_view(&m, 40, 4) !>;
        expect(w.side.live && w.side.layout.len > 0, "unfocused camera has rows");
        w.side.layout.rows[0].byte_start = 100000;
        w.side.layout.rows[0].byte_len = 50;
        act->doc.caret = 0;
        act->doc.sel_anchor = 0;
        act->doc.delete_forward() !>;
        w.after_edit(w.pane[w.focus], &m, 40, 40, 4) !>;
        n = act->len();
        expect(w.side.layout.len > 0, "unfocused camera rebuilt after edit");
        for (i = 0; i < w.side.layout.len; i++) {
            expect(w.side.layout.rows[i].byte_start + w.side.layout.rows[i].byte_len <= n,
                   "unfocused row in range after edit");
        }
        for (i = 0; i < act->layout.len; i++) {
            expect(act->layout.rows[i].byte_start + act->layout.rows[i].byte_len <= n,
                   "focused row in range after edit");
        }
    }

    {
        RtxWs w = {0} @destroy;
        RtxBrowse *br;
        size_t i;
        int saw_txt = 0;
        char *paths[1];
        paths[0] = (char *)"testdata/small.txt";
        w.open_files(1, paths) !>;
        w.browse_start() !>;
        br = RtxWs_browse(&w);
        rtx_browse_pump(br) !>;
        expect(br && br->len > 1, "one shallow pump lists more than ..");
        browse_wait(br) !>;
        expect(br && br->on, "browse opens in the focused view");
        expect(!br->boot, "browse on an open file is not boot");
        expect(br->dir[0] == '/', "browse dir is absolute");
        expect(strstr(br->dir, "testdata") != NULL, "starts in the file's directory");
        {
            char here[RTX_BROWSE_DIR];
            snprintf(here, sizeof(here), "%s", br->dir);
            w.browse_backspace() !>;
            br = RtxWs_browse(&w);
            expect(strcmp(br->dir, here) == 0, "backspace does not leave the directory");
            w.browse_parent() !>;
            br = RtxWs_browse(&w);
            browse_wait(br) !>;
            expect(strcmp(br->dir, here) != 0, "parent leaves the file's directory");
            expect(br->dir[0] == '/', "parent stays absolute");
            {
                size_t n = strlen(br->dir);
                expect(n < 8 || strcmp(br->dir + n - 8, "testdata") != 0,
                       "parent is not still testdata");
            }
        }
        w.browse_start() !>;
        br = RtxWs_browse(&w);
        browse_wait(br) !>;
        expect(br->len && strcmp(br->ents[br->cur].name, "small.txt") == 0,
               "browse preselects the open file");
        {
            char peer[256];
            char sel[RTX_BROWSE_DIR];
            int is_dir = 1;
            expect(!rtx_host_is_ray("cctext"), "cctext is not ray");
            expect(rtx_host_is_ray("cctext-ray"), "cctext-ray is ray");
            expect(rtx_host_is_ray("/opt/bin/cctext_ray"), "cctext_ray is ray");
            expect(rtx_host_peer_path("/opt/bin/cctext", 0, peer, sizeof(peer)) &&
                   strcmp(peer, "/opt/bin/cctext") == 0, "self keeps this exe");
            expect(rtx_host_peer_path("/opt/bin/cctext", 1, peer, sizeof(peer)) &&
                   strcmp(peer, "/opt/bin/cctext-ray") == 0, "peer of cctext is ray");
            expect(rtx_host_peer_path("/opt/bin/cctext-ray", 1, peer, sizeof(peer)) &&
                   strcmp(peer, "/opt/bin/cctext") == 0, "peer of ray is cctext");
            expect(rtx_host_peer_path("cctext", 1, peer, sizeof(peer)) &&
                   strcmp(peer, "cctext-ray") == 0, "bare peer has no dir");
#ifdef __APPLE__
            {
                char *old_term = getenv("TERM_PROGRAM");
                char *old_trace = getenv("CURSOR_TRACE_ID");
                char term_save[64];
                char trace_save[64];
                term_save[0] = 0;
                trace_save[0] = 0;
                if (old_term) snprintf(term_save, sizeof(term_save), "%s", old_term);
                if (old_trace) snprintf(trace_save, sizeof(trace_save), "%s", old_trace);
                setenv("TERM_PROGRAM", "vscode", 1);
                setenv("CURSOR_TRACE_ID", "1", 1);
                expect(strcmp(rtx_host_tty_app(), "Cursor") == 0,
                       "Cursor terminal stays in Cursor");
                unsetenv("CURSOR_TRACE_ID");
                setenv("TERM_PROGRAM", "iTerm.app", 1);
                expect(strcmp(rtx_host_tty_app(), "iTerm") == 0, "iTerm host");
                setenv("TERM_PROGRAM", "Apple_Terminal", 1);
                expect(strcmp(rtx_host_tty_app(), "Terminal") == 0,
                       "Terminal.app host");
                if (term_save[0]) setenv("TERM_PROGRAM", term_save, 1);
                else unsetenv("TERM_PROGRAM");
                if (trace_save[0]) setenv("CURSOR_TRACE_ID", trace_save, 1);
                else unsetenv("CURSOR_TRACE_ID");
            }
#else
            expect(strcmp(rtx_host_tty_app(), "Terminal") == 0,
                   "non-Apple host has no tty app");
#endif
            expect(rtx_browse_sel_path(br, sel, sizeof(sel), &is_dir) &&
                   !is_dir && strstr(sel, "small.txt"),
                   "browse sel is the highlighted file");
        }
        {
            struct stat st;
            char size[12];
            char when[24];
            expect(stat("testdata/small.txt", &st) == 0, "stat small.txt");
            expect(br->ents[br->cur].has_stat, "browse has size/mtime");
            expect(!br->ents[br->cur].is_dir, "small.txt is a file");
            expect(br->ents[br->cur].size == (uint64_t)st.st_size,
                   "browse size matches stat");
            expect(br->ents[br->cur].mtime == st.st_mtime,
                   "browse mtime matches stat");
            rtx_browse_fmt_size(size, sizeof(size), &br->ents[br->cur]);
            rtx_browse_fmt_mtime(when, sizeof(when), &br->ents[br->cur]);
            {
                char want[16];
                snprintf(want, sizeof(want), "%llu", (unsigned long long)st.st_size);
                expect(strstr(size, want) != NULL, "fmt size shows the byte count");
            }
            expect(strlen(when) == (size_t)RTX_BROWSE_MTIME_W, "fmt mtime is YYYY-MM-DD HH:MM");
            expect(when[4] == '-' && when[7] == '-' && when[10] == ' ' && when[13] == ':',
                   "fmt mtime separators");
            {
                size_t j;
                int saw_dir_meta = 0;
                for (j = 0; j < br->len; j++) {
                    if (!br->ents[j].is_dir) continue;
                    expect(br->ents[j].has_stat || strcmp(br->ents[j].name, "..") == 0,
                           "dirs carry mtime when stat works");
                    if (br->ents[j].has_stat) {
                        char dsize[12];
                        rtx_browse_fmt_size(dsize, sizeof(dsize), &br->ents[j]);
                        if (!br->ents[j].sized)
                            expect(strspn(dsize, " ") == strlen(dsize),
                                   "unsized dir size column is blank");
                        saw_dir_meta = 1;
                    }
                }
                expect(saw_dir_meta, "listing includes a directory with mtime");
            }
            {
                size_t si;
                size_t samples;
                size_t filei;
                uint64_t parked;
                char shown[12];
                samples = br->len;
                filei = br->len;
                for (si = 0; si < br->len; si++) {
                    if (br->ents[si].is_dir &&
                        strcmp(br->ents[si].name, "samples") == 0)
                        samples = si;
                    if (!br->ents[si].is_dir &&
                        strcmp(br->ents[si].name, "small.txt") == 0)
                        filei = si;
                }
                expect(samples < br->len && filei < br->len,
                       "samples and small.txt are in testdata");
                if (samples < br->len) {
                    expect(!RtxWs_browse_busy(&w),
                           "idle listing on a file is not busy");
                    rtx_browse_select(br, samples, 20);
                    expect(RtxWs_browse_busy(&w),
                           "an unsized folder keeps the host pumping");
                    RtxWs_browse_pump(&w) !>;
                    expect(br->ents[samples].sized, "current folder starts a du");
                    parked = br->ents[samples].size;
                    if (filei < br->len) {
                        br->cur = filei;
                        rtx_browse_move(br, 0, 20);
                        expect(!br->sizing, "leaving a folder pauses du");
                        expect(br->ents[samples].sized &&
                               br->ents[samples].size == parked,
                               "paused folder keeps its running total");
                        expect(rtx_browse_size_face(br, &br->ents[samples]) ==
                               (br->ents[samples].size_done
                                    ? RTX_BROWSE_FACE_DIR
                                    : RTX_BROWSE_FACE_DATE),
                               "paused incomplete size is gray");
                        br->cur = samples;
                        rtx_browse_move(br, 0, 20);
                        expect(br->ents[samples].size == parked,
                               "coming back does not restart from zero");
                    }
                    browse_wait(br) !>;
                    expect(!br->sizing, "folder du finishes");
                    expect(br->ents[samples].sized && br->ents[samples].size > 0,
                           "samples has a folder total");
                    expect(br->ents[samples].size_done,
                           "finished folder is complete");
                    expect(rtx_browse_size_face(br, &br->ents[samples]) ==
                           RTX_BROWSE_FACE_DIR,
                           "finished folder size uses the dir face");
                    rtx_browse_fmt_size(shown, sizeof(shown), &br->ents[samples]);
                    expect(strspn(shown, " ") != strlen(shown),
                           "sized folder shows a size");
                    if (filei < br->len) {
                        br->cur = filei;
                        rtx_browse_move(br, 0, 20);
                        expect(strcmp(br->ents[0].name, "..") == 0 &&
                               !br->ents[0].sized,
                               ".. is not sized");
                        expect(rtx_browse_size_face(br, &br->ents[samples]) ==
                               RTX_BROWSE_FACE_DIR,
                               "complete folder size stays the dir face after leave");
                    }
                }
            }
        }
        w.browse_glob_set("sma") !>;
        br = RtxWs_browse(&w);
        expect(br->flat, "typed fragment starts flattened search");
        browse_wait(br) !>;
        expect(br->len && strcmp(br->ents[br->cur].name, "small.txt") == 0,
               "fragment glob keeps the open file selected");
        {
            int saw_small = 0, saw_unrelated_dir = 0;
            for (i = 0; i < br->len; i++) {
                if (!br->ents[i].is_dir) {
                    if (strcmp(br->ents[i].name, "small.txt") == 0) saw_small = 1;
                } else if (strcmp(br->ents[i].name, "generated") == 0) {
                    saw_unrelated_dir = 1;
                }
            }
            expect(saw_small, "fragment glob lists matching files");
            expect(!saw_unrelated_dir, "fragment flatten hides directories");
        }
        w.browse_glob_set("SMA") !>;
        br = RtxWs_browse(&w);
        browse_wait(br) !>;
        expect(br->len && strcmp(br->ents[br->cur].name, "small.txt") == 0,
               "fragment match is case-insensitive");
        {
            size_t off = 0, n = 0;
            expect(rtx_browse_hit_span(br, "small.txt", &off, &n) &&
                   off == 0 && n == 3, "fragment hit is sma");
        }
        {
            int saw_dir = 0;
            int saw_dot = 0;
            size_t off = 0, n = 0;
            FILE *dot = fopen("testdata/.rtx_dot_smoke", "w");
            if (dot) {
                fputc('x', dot);
                fclose(dot);
            }
            w.browse_glob_set("") !>;
            br = RtxWs_browse(&w);
            browse_wait(br) !>;
            for (i = 0; i < br->len; i++) {
                if (strcmp(br->ents[i].name, ".rtx_dot_smoke") == 0) saw_dot = 1;
            }
            expect(!saw_dot, "empty glob hides dotfiles");
            w.browse_glob_set(".") !>;
            br = RtxWs_browse(&w);
            browse_wait(br) !>;
            saw_dot = 0;
            for (i = 0; i < br->len; i++) {
                if (br->ents[i].is_dir && strcmp(br->ents[i].name, "generated") == 0)
                    saw_dir = 1;
                if (strcmp(br->ents[i].name, ".rtx_dot_smoke") == 0) saw_dot = 1;
            }
            expect(saw_dir, ". is not a fragment; listing stays unfiltered");
            expect(saw_dot, ". reveals dotfiles");
            expect(!rtx_browse_hit_span(br, "small.txt", &off, &n),
                   ". does not highlight every extension dot");
            w.browse_glob_set(".rtx") !>;
            br = RtxWs_browse(&w);
            browse_wait(br) !>;
            saw_dot = 0;
            saw_txt = 0;
            for (i = 0; i < br->len; i++) {
                if (strcmp(br->ents[i].name, ".rtx_dot_smoke") == 0) saw_dot = 1;
                if (strcmp(br->ents[i].name, "small.txt") == 0) saw_txt = 1;
            }
            expect(saw_dot && !saw_txt, ".rtx is hidden + fragment rtx");
            expect(rtx_browse_hit_span(br, ".rtx_dot_smoke", &off, &n) &&
                   off == 1 && n == 3, "leading dot is not the hit");
            unlink("testdata/.rtx_dot_smoke");
            w.browse_glob_set("") !>;
            br = RtxWs_browse(&w);
            browse_wait(br) !>;
            for (i = 0; i < br->len; i++) {
                if (strcmp(br->ents[i].name, "small.txt") == 0) br->cur = i;
            }
        }
        w.browse_glob_set("*.txt") !>;
        br = RtxWs_browse(&w);
        expect(!br->flat, "*.txt stays a local walkable glob");
        browse_wait(br) !>;
        expect(br->len && strcmp(br->ents[br->cur].name, "small.txt") == 0,
               "glob keeps the open file selected");
        {
            int saw_dir = 0;
            saw_txt = 0;
            for (i = 0; i < br->len; i++) {
                if (!br->ents[i].is_dir && strstr(br->ents[i].name, ".txt"))
                    saw_txt = 1;
                if (br->ents[i].is_dir && strcmp(br->ents[i].name, "..") != 0)
                    saw_dir = 1;
            }
            expect(saw_txt, "glob *.txt lists text files");
            expect(saw_dir, "real glob still lists directories");
        }
        {
            size_t off = 0, n = 0;
            expect(rtx_browse_hit_span(br, "small.txt", &off, &n) &&
                   off == 5 && n == 4, "glob hit is .txt");
        }
        {
            RtxThemeColor dirc = rtx_browse_face(RTX_BROWSE_FACE_DIR);
            RtxThemeColor filec = rtx_browse_face(RTX_BROWSE_FACE_FILE);
            RtxThemeColor sizec = rtx_browse_face(RTX_BROWSE_FACE_SIZE);
            RtxThemeColor datec = rtx_browse_face(RTX_BROWSE_FACE_DATE);
            RtxThemeColor hitc = rtx_browse_face(RTX_BROWSE_FACE_HIT);
            RtxThemeColor extc = rtx_browse_face(RTX_BROWSE_FACE_EXT);
            expect(dirc.ansi && filec.ansi && strcmp(dirc.ansi, filec.ansi) != 0,
                   "dir and file faces differ");
            expect(sizec.ansi && datec.ansi && strcmp(sizec.ansi, datec.ansi) != 0,
                   "size and date faces differ");
            expect(hitc.ansi && strcmp(hitc.ansi, filec.ansi) != 0,
                   "hit face differs from file");
            expect(extc.ansi && strcmp(extc.ansi, filec.ansi) != 0,
                   "known-ext face differs from file");
            {
                size_t eoff = 0, en = 0;
                setenv("RTX_GRAMMARS", "testdata/grammars", 0);
                expect(rtx_tm_ext_span("piece_tree.ccs", &eoff, &en) &&
                       eoff == 10 && en == 4, ".ccs is a known suffix");
                expect(rtx_tm_ext_span("samples/readme.md", &eoff, &en) &&
                       eoff == 14 && en == 3, "flattened .md is known");
                expect(!rtx_tm_ext_span("small.txt", &eoff, &en),
                       ".txt is not a grammar suffix");
                expect(rtx_browse_name_face(0, 10, 0, 0, 0, 10, 4) ==
                       RTX_BROWSE_FACE_EXT, "name face paints the suffix");
                expect(rtx_browse_name_face(0, 0, 0, 0, 0, 10, 4) ==
                       RTX_BROWSE_FACE_FILE, "stem stays the file face");
            }
        }
        {
            RtxField gf = rtx_browse_field(br);
            rtx_field_select_all(gf);
            expect(rtx_field_has_sel(gf), "glob select all");
            expect((rtx_field_copy(&w, gf) !>) == 1, "copy glob");
            expect(w.clip.len == 5 && w.clip.ptr &&
                   memcmp(w.clip.ptr, "*.txt", 5) == 0, "clip is *.txt");
            expect(rtx_field_type_cp(gf, 'x'), "type replaces glob sel");
            expect(br->glob_len == 1 && br->glob[0] == 'x', "glob is x");
            rtx_field_paste(&w, gf) !>;
            expect(br->glob_len == 6 && memcmp(br->glob, "x*.txt", 6) == 0,
                   "paste into glob");
            rtx_field_click(gf, 1, 0, 0);
            rtx_field_click(gf, 6, 1, 0);
            rtx_field_cut(&w, gf) !>;
            expect(br->glob_len == 1 && br->glob[0] == 'x', "cut glob tail");
            rtx_browse_kick(br) !>;
            browse_wait(br) !>;
        }
        w.browse_glob_set("*.txt") !>;
        br = RtxWs_browse(&w);
        browse_wait(br) !>;
        {
            size_t j;
            int saw_child = 0;
            expect(br->glob_len > 0, "glob is set before enter");
            for (j = 0; j < br->len; j++) {
                if (br->ents[j].is_dir && strcmp(br->ents[j].name, "..") != 0) {
                    br->cur = j;
                    saw_child = 1;
                    break;
                }
            }
            expect(saw_child, "listing has a child directory");
            w.browse_enter() !>;
            br = RtxWs_browse(&w);
            browse_wait(br) !>;
            expect(br->on, "enter on a directory stays in browse");
            expect(br->glob_len == 0 && br->glob[0] == 0,
                   "enter on a directory resets the glob");
        }
        w.open_in_pane("testdata/mixed.txt") !>;
        expect(!w.browsing(), "open closes the browser");
        expect(w.len == 2, "new file is a new buf");
        expect(w.pane[0] == 1, "focused view shows the opened file");
    }

    {
        RtxWs w = {0} @destroy;
        RtxBrowse *br;
        size_t i;
        char *paths[1];
        paths[0] = (char *)"testdata/small.txt";
        w.open_files(1, paths) !>;
        w.browse_start() !>;
        w.browse_glob_set(">") !>;
        br = RtxWs_browse(&w);
        expect(br->scanning, "glob set kicks, does not drain");
        expect(br->len >= 1 && strcmp(br->ents[0].name, "..") == 0,
               ".. planted at kick");
        rtx_browse_pump(br) !>;
        browse_wait(br) !>;
        expect(!br->scanning, "finish drains");
        {
            int saw_nested = 0, saw_small = 0, saw_dir = 0;
            for (i = 0; i < br->len; i++) {
                if (br->ents[i].is_dir) {
                    if (strcmp(br->ents[i].name, "..") != 0) saw_dir = 1;
                    continue;
                }
                if (strcmp(br->ents[i].name, "small.txt") == 0) saw_small = 1;
                if (strcmp(br->ents[i].name, "samples/readme.md") == 0) saw_nested = 1;
            }
            expect(saw_small, "> flatten still lists top-level files");
            expect(saw_nested, "> flatten lists files from subfolders");
            expect(!saw_dir, "> flatten does not list directories");
            expect(rtx_browse_dir_prefix("samples/readme.md") == 8,
                   "flattened name keeps the subfolder prefix");
            expect(!br->truncated, "small tree is not capped");
        }
        w.browse_glob_set(">*.md") !>;
        br = RtxWs_browse(&w);
        browse_wait(br) !>;
        {
            int saw_md = 0, saw_txt = 0;
            for (i = 0; i < br->len; i++) {
                if (br->ents[i].is_dir) continue;
                if (strstr(br->ents[i].name, ".md")) saw_md = 1;
                if (strstr(br->ents[i].name, ".txt")) saw_txt = 1;
            }
            expect(saw_md, ">*.md lists markdown under subfolders");
            expect(!saw_txt, ">*.md hides non-markdown files");
        }
        w.browse_glob_set(">*.txt") !>;
        br = RtxWs_browse(&w);
        browse_wait(br) !>;
        {
            int saw_txt = 0, saw_md = 0, saw_small = 0;
            for (i = 0; i < br->len; i++) {
                if (br->ents[i].is_dir) continue;
                if (strstr(br->ents[i].name, ".txt")) saw_txt = 1;
                if (strstr(br->ents[i].name, ".md")) saw_md = 1;
                if (strcmp(br->ents[i].name, "small.txt") == 0) saw_small = 1;
            }
            expect(saw_small && saw_txt, ">*.txt lists text files in the tree");
            expect(!saw_md, ">*.txt hides non-text files");
        }
        expect(!br->flat, "> flatten is not the typed-fragment chrome");
        w.browse_glob_set("readme") !>;
        br = RtxWs_browse(&w);
        expect(br->flat, "typed fragment starts flattened search");
        browse_wait(br) !>;
        expect(rtx_browse_head(br) == RTX_BROWSE_HEAD + 1,
               "flattened search adds a header row");
        expect(rtx_browse_hit(br, RTX_BROWSE_HEAD, 20) < 0,
               "header row is not a list hit");
        expect(rtx_browse_hit(br, RTX_BROWSE_HEAD + 1, 20) >= 0,
               "first list row is below the flattened header");
        {
            int saw_nested = 0, saw_small = 0;
            for (i = 0; i < br->len; i++) {
                if (strcmp(br->ents[i].name, "samples/readme.md") == 0)
                    saw_nested = 1;
                if (strcmp(br->ents[i].name, "small.txt") == 0) saw_small = 1;
            }
            expect(saw_nested, "typed flatten lists nested readme");
            expect(!saw_small, "typed flatten still filters");
        }
        w.browse_glob_set("small") !>;
        br = RtxWs_browse(&w);
        expect(br->flat, "a local hit still flattens");
        browse_wait(br) !>;
        expect(rtx_browse_head(br) == RTX_BROWSE_HEAD + 1,
               "typed flatten keeps the header");
        {
            int saw_small = 0;
            for (i = 0; i < br->len; i++) {
                if (strcmp(br->ents[i].name, "small.txt") == 0) saw_small = 1;
            }
            expect(saw_small, "typed flatten still lists a local hit");
        }
        w.browse_glob_set(">readme") !>;
        br = RtxWs_browse(&w);
        browse_wait(br) !>;
        {
            int saw_nested = 0;
            for (i = 0; i < br->len; i++) {
                if (strcmp(br->ents[i].name, "samples/readme.md") == 0) {
                    saw_nested = 1;
                    br->cur = i;
                }
            }
            expect(saw_nested, "> fragment matches a nested basename");
        }
        w.browse_enter() !>;
        expect(!w.browsing(), "enter on a flattened path opens the file");
        expect(w.bufs[w.pane[0]].doc.path.ptr &&
               strstr(w.bufs[w.pane[0]].doc.path.ptr, "samples/readme.md"),
               "flattened enter joins the subfolder");
    }

