        w.browse_prev_cycle(0);
        w.browse_prev_cycle(0);
        w.browse_prev_cycle(0);
        expect(pv->layout.view == RTX_VIEW_GRID, "Ctrl-L preview -> grid");
        w.browse_prev_sync(0, &m, 40.0, 8) !>;
