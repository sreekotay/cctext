#!ccc ccs
/*
 * Parse testdata/grammars/c.tmLanguage.json with @grammar(schema),
 * lower each pattern, and agree with the hand-lowered C runtime.
 */
#include <ccc/std/prelude.cch>
#include <ccc/stdio.cch>
#include <stdio.h>
#include <string.h>
#include <ccc/std/json.cch>
#include "../core/document.cch"
#include "../core/nav.cch"
#include "../core/find.cch"
#include "../core/nav_pair.cch"

@grammar(rules) Json {~~~~
    include JsonKeep
    string:  [#'"' keep/decode(jstr)/encode(jstr_enc) any [some strchar | esc] #'"']
~~~~}

@grammar(schema) TmPattern {~~~~
    use Json
    Json.object [
        "name"    name:    Json.string
        "match"   match:   Json.string
        "begin"   begin:   Json.string
        "end"     end:     Json.string
        "include" include: Json.string
    ]
~~~~}

@grammar(schema) TmGrammar {~~~~
    use Json
    Json.ws
    Json.object [
        "name"      name:      Json.string
        "scopeName" scopeName: Json.string
        "patterns"  patterns:  Json.array of TmPattern
    ]
    Json.ws
~~~~}

static int fails = 0;

static void expect(int cond, const char *msg) {
    if (!cond) {
        fprintf(stderr, "FAIL: %s\n", msg);
        fails++;
    }
}

static int slice_eq(CCSlice s, const char *lit) {
    size_t n = strlen(lit);
    return s.eq_cstr(lit);
}

static void slice_cpy(CCSlice s, char *dst, size_t cap) {
    size_t n = s.len < cap - 1 ? s.len : cap - 1;
    if (s.ptr && n) {
        char[:] d = cc_slice_from_buffer(dst, n);
        char[:] src = s.sub(0, n);
        d.copy(src) !>(e) { (void)e; return; };
    }
    dst[n] = 0;
}

static int join2(char *dst, size_t cap, const char *a, const char *b) {
    int n = snprintf(dst, cap, "%s/%s", a, b);
    return n > 0 && (size_t)n < cap;
}

static int write_file(const char *path, const char *text) {
    FILE *fp = fopen(path, "w");
    if (!fp) return 0;
    fputs(text, fp);
    fclose(fp);
    return 1;
}

static const RtxRun *smoke_path_run(const RtxDoc *d, size_t start, int dest) {
    size_t k;
    if (!d) return NULL;
    for (k = 0; k < d->runs.len; k++) {
        const RtxRun *r = &d->runs.data[k];
        if (r->start != start) continue;
        if (rtx_run_arity(r) != RTX_ARITY_PATH) continue;
        if (dest ? rtx_run_dest(r) : !rtx_run_dest(r)) return r;
    }
    return NULL;
}

#define MK_GRAMMAR_DIR "testdata/generated/markup_grammars"
#define MK_DOC "testdata/generated/markup_doc.mk"

/* File scope on purpose: ccc silently truncates a concatenated string
 * literal past 511 source bytes when it initializes a *local* declaration
 * (see CLAUDE.md). File-scope initializers lower intact. */
static const char *const mk_grammar =
    "{\n"
    "  \"name\": \"Mk\",\n"
    "  \"scopeName\": \"text.mk\",\n"
    "  \"fileTypes\": [\"mk\"],\n"
    "  \"cctext\": { \"kind\": \"markup\", \"future\": [1, {\"x\": null}] },\n"
    "  \"patterns\": [\n"
    "    { \"include\": \"#head\" },\n"
    "    { \"include\": \"#em\" }\n"
    "  ],\n"
    "  \"repository\": {\n"
    "    \"head\": {\n"
    "      \"name\": \"markup.heading.mk\",\n"
    "      \"match\": \"#{1,6}\\\\s.*\",\n"
    "      \"cctext\": { \"bold\": true, \"apply\": \"heading\", \"mono\": false }\n"
    "    },\n"
    "    \"em\": {\n"
    "      \"name\": \"markup.italic.mk\",\n"
    "      \"begin\": \"*\",\n"
    "      \"end\": \"*\",\n"
    "      \"cctext\": { \"italic\": true }\n"
    "    }\n"
    "  }\n"
    "}\n";

/* Child process: the grammar registry loads once per process, so a grammar
 * that declares `"cctext": { "kind": "markup" }` is exercised with
 * RTX_GRAMMARS pointing at a temp dir (see markup_parent). */
static int markup_child(void) {
    @errhandler(CCError e) { cc_error_log(e); return 1; }
    const RtxTmRt *rt = rtx_tm_for_path("x.mk");
    size_t k;
    int saw_bold_apply = 0, saw_italic = 0;
    expect(rt != NULL, "markup: temp grammar loaded via RTX_GRAMMARS");
    expect(rtx_tm_nlangs == 1, "markup: only the temp grammar");
    if (!rt) return fails ? 1 : 0;
    expect(rt->markup == 1, "markup: grammar-level cctext.kind = markup");
    expect(rtx_tm_for_path("x.md") == NULL, "markup: md not loaded in temp dir");
    for (k = 0; k < rt->rules.len; k++) {
        const RtxTmRule *r = &rt->rules.data[k];
        if (r->sc_bold && r->sc_apply && strcmp(r->sc_apply, "heading") == 0 &&
            !r->sc_italic && !r->sc_mono) {
            saw_bold_apply = 1;
        }
        if (r->sc_italic && !r->sc_bold && r->sc_apply == NULL) saw_italic = 1;
    }
    expect(saw_bold_apply, "markup: rule carries cctext.bold + apply");
    expect(saw_italic, "markup: rule carries cctext.italic, apply NULL");
    {
        RtxDoc d = {0} @destroy;
        size_t i;
        int all_tm = 1, saw_head = 0;
        d.from_path(MK_DOC) !>;
        expect(d.secs.len >= 1 && d.section_at(0) == RTX_SEC_MARKUP,
               "markup: root section is MARKUP");
        expect(d.runs.len > 0, "markup: TM runs present");
        for (i = 0; i < d.runs.len; i++) {
            const char *s = rtx_scope_name(d.runs.data[i].style.scope);
            /* Scope runs are TM-planted; open-time `*` bits are PROSE-planted. */
            if (d.runs.data[i].style.scope != RTX_SCOPE_NONE &&
                d.runs.data[i].planter != RTX_RUN_TM)
                all_tm = 0;
            if (d.runs.data[i].style.scope == RTX_SCOPE_NONE &&
                d.runs.data[i].planter != RTX_RUN_PROSE)
                all_tm = 0;
            if (s && strstr(s, "heading")) saw_head = 1;
        }
        expect(all_tm, "markup: scope runs planted by TM");
        expect(saw_head, "markup: heading lexed");
        expect(d.style_at(0).scope != RTX_SCOPE_NONE, "markup: style_at keeps scope");
        {
            const char *s = rtx_scope_name(d.style_at(0).scope);
            expect(s && strstr(s, "heading"), "markup: style_at(0) is heading");
        }
        /* A letter re-lexes the MARKUP section like CODE: heading survives. */
        d.caret = d.len();
        d.sel_anchor = d.caret;
        d.type("z") !>;
        d.reparse_edit(d.last_off, d.last_markup) !>;
        expect(d.section_at(0) == RTX_SEC_MARKUP, "markup: stays MARKUP after type");
        saw_head = 0;
        for (i = 0; i < d.runs.len; i++) {
            const char *s = rtx_scope_name(d.runs.data[i].style.scope);
            if (s && strstr(s, "heading")) saw_head = 1;
        }
        expect(saw_head, "markup: heading survives a letter");
    }
    return fails ? 1 : 0;
}

static void markup_parent(const char *exe) {
    char cmd[1200];
    int n;
    if (system("mkdir -p " MK_GRAMMAR_DIR) != 0) expect(0, "mkdir markup grammars");
    expect(strstr(mk_grammar, "\"italic\": true }") != NULL &&
               mk_grammar[strlen(mk_grammar) - 2] == '}',
           "markup grammar literal intact");
    expect(write_file(MK_GRAMMAR_DIR "/mk.tmLanguage.json", mk_grammar),
           "write markup grammar");
    expect(write_file(MK_DOC, "# Title\nsome *it* text\n"), "write markup doc");
    n = snprintf(cmd, sizeof cmd, "RTX_GRAMMARS='%s' '%s' --markup-child",
                 MK_GRAMMAR_DIR, exe);
    expect(n > 0 && (size_t)n < sizeof cmd, "markup child cmd");
    expect(system(cmd) == 0, "markup child process passed");
    remove(MK_DOC);
    remove(MK_GRAMMAR_DIR "/mk.tmLanguage.json");
}

int main(int argc, char **argv) {
    @errhandler(CCError e) { cc_error_log(e); return 1; }
    char path[512];
    if (argc > 1 && strcmp(argv[1], "--markup-child") == 0) {
        int rc = markup_child();
        if (fails) fprintf(stderr, "%d markup child failure(s)\n", fails);
        return rc;
    }
    FILE *fp;
    char *buf = NULL;
    long sz = 0;
    CCArena arena = {0};
    TmGrammar g;
    RtxTmRt *want;
    size_t i;

    want = rtx_tm_c_rt();
    expect(rtx_tm_load_dir[0] == '/', "grammar dir is absolute");
    expect(rtx_tm_load_files == 10 && rtx_tm_nlangs == 10, "runtime loaded 10");
    if (!want) {
        fprintf(stderr, "no C grammar (dir=%s files=%zu us=%zu)\n",
                rtx_tm_load_dir, rtx_tm_load_files, rtx_tm_load_us);
        return 1;
    }
    expect(join2(path, sizeof path, rtx_tm_load_dir, "c.tmLanguage.json"),
           "c grammar path");
    fp = fopen(path, "rb");
    expect(fp != NULL, "open c.tmLanguage.json");
    if (!fp) return 1;
    if (fseek(fp, 0, SEEK_END) != 0) return 1;
    sz = ftell(fp);
    if (sz <= 0) return 1;
    rewind(fp);
    buf = (char *)malloc((size_t)sz + 1);
    if (!buf) return 1;
    if (fread(buf, 1, (size_t)sz, fp) != (size_t)sz) return 1;
    buf[sz] = 0;
    fclose(fp);

    arena = cc_arena_create(1 << 20);
    g = (TmGrammar){0};
    expect(TmGrammar_parse(buf, (size_t)sz, arena, &g), "parse TmGrammar");
    expect(slice_eq(g.name, "C"), "name C");
    expect(slice_eq(g.scopeName, "source.c"), "scopeName source.c");
    expect(g.patterns_n == 7, "seven top-level patterns");

    expect(want && want->rules.len >= 6, "flattened rules");
    expect(want->n_exts >= 8, "fileTypes loaded");
    {
        int saw_inc = 0, saw_kw = 0, saw_re = 0;
        for (i = 0; i < g.patterns_n; i++) {
            char incl[64];
            slice_cpy(g.patterns[i].include, incl, sizeof incl);
            if (incl[0] == '#') saw_inc = 1;
        }
        expect(saw_inc, "schema saw include");
        for (i = 0; i < want->rules.len; i++) {
            if (want->rules.data[i].op == RTX_TM_KEYWORDS) saw_kw = 1;
            if (want->rules.data[i].op == RTX_TM_REGEX) saw_re = 1;
        }
        expect(saw_kw, "lowered keywords");
        expect(saw_re, "leftover regex directive");
        {
            int saw_hash = 0, saw_quot = 0;
            for (i = 0; i < want->rules.len; i++) {
                if (want->rules.data[i].op == RTX_TM_REGEX &&
                    want->rules.data[i].first == '#') {
                    saw_hash = 1;
                }
                if (want->rules.data[i].op == RTX_TM_LIT_SPAN &&
                    want->rules.data[i].first == '"') {
                    saw_quot = 1;
                }
            }
            expect(saw_hash && saw_quot, "C first-byte # and \"");
            {
                size_t k;
                int saw_esc_dot = 0;
                for (k = 0; k < want->inners.len; k++) {
                    if (want->inners.data[k].op == RTX_TM_ESC_DOT &&
                        want->inners.data[k].first == '\\') {
                        saw_esc_dot = 1;
                    }
                }
                expect(saw_esc_dot, "C string \\\\. is ESC_DOT");
            }
        }
        {
            int saw_inner = 0;
            for (i = 0; i < want->rules.len; i++) {
                if (want->rules.data[i].op == RTX_TM_LIT_SPAN &&
                    want->rules.data[i].innern > 0) {
                    saw_inner = 1;
                }
            }
            expect(saw_inner, "string has nested patterns");
        }
    }
    {
        size_t end = 0;
        const char *line = "#include <stdio.h>";
        const char *pat = "#[ \\t]*(include|define)\\b";
        expect(rtx_re_match(pat, strlen(pat), line, 0, strlen(line), &end),
               "re match #include");
        expect(end == 8, "#include length");
        {
            const char *p2 = "a*ab";
            const char *t2 = "aaab";
            end = 0;
            expect(rtx_re_match(p2, 4, t2, 0, 4, &end) && end == 4,
                   "re backtrack a*ab");
        }
        {
            const char *pk = "\"([^\"]+)\"\\s*:";
            const char *tk = "\"n\": -2.5";
            RtxReCaps caps;
            end = 0;
            expect(rtx_re_match_caps(pk, strlen(pk), tk, 0, strlen(tk), &end,
                                     &caps) &&
                   end == 4 && caps.s[1] == 1 && caps.e[1] == 2,
                   "re capture JSON key");
        }
        {
            const char *pa = "(a)|(b)";
            const char *tb = "b";
            RtxReCaps caps;
            end = 0;
            expect(rtx_re_match_caps(pa, 7, tb, 0, 1, &end, &caps) &&
                   end == 1 && caps.e[1] <= caps.s[1] && caps.s[2] == 0 &&
                   caps.e[2] == 1,
                   "re alt keeps winning group");
        }
        {
            const char *ph = "#{1,6}\\s.*";
            const char *th = "### title";
            const char *t1 = "# x";
            const char *t7 = "####### x";
            end = 0;
            expect(rtx_re_match(ph, strlen(ph), th, 0, strlen(th), &end) &&
                       end == 9,
                   "re {1,6} heading");
            end = 0;
            expect(rtx_re_match(ph, strlen(ph), t1, 0, strlen(t1), &end) &&
                       end == 3,
                   "re {1,6} one hash");
            expect(!rtx_re_match(ph, strlen(ph), t7, 0, strlen(t7), &end),
                   "re {1,6} rejects 7 hashes");
        }
        {
            const char *ph = "#{1,6}[ \t]*";
            const char *t0 = "#";
            const char *t3 = "### title";
            const char *pt = "[ \t]+#+$";
            const char *ok = "title ##";
            const char *no = "title ## x";
            end = 0;
            expect(rtx_re_match(ph, strlen(ph), t0, 0, 1, &end) && end == 1,
                   "re heading empty #");
            end = 0;
            expect(rtx_re_match(ph, strlen(ph), t3, 0, strlen(t3), &end) &&
                       end == 4,
                   "re heading opener ### ");
            end = 0;
            expect(rtx_re_match(pt, strlen(pt), ok, 5, strlen(ok), &end) &&
                       end == 8,
                   "re heading trail $");
            expect(!rtx_re_match(pt, strlen(pt), no, 5, strlen(no), &end),
                   "re heading trail rejects mid-line hashes");
        }
        {
            const char *pq = "[ \\t]{0,3}>([ \\t]*>)*[ \\t]*";
            const char *pl = "[ \\t]*[-*+][ \\t]+";
            const char *pn = "[ \\t]*[0-9]{1,9}[.][ \\t]+";
            const char *pp = "[ \\t]*[0-9]{1,9}[)][ \\t]+";
            const char *q1 = "> single";
            const char *q2 = "> > nested";
            const char *ld = "- dash";
            const char *ls = "* star";
            const char *lo = "1. first";
            const char *lp = "2) paren";
            const char *hr = "---";
            const char *st = "***";
            end = 0;
            expect(rtx_re_match(pq, strlen(pq), q1, 0, strlen(q1), &end) &&
                       end == 2,
                   "re quote opener");
            end = 0;
            expect(rtx_re_match(pq, strlen(pq), q2, 0, strlen(q2), &end) &&
                       end == 4,
                   "re nested quote opener");
            end = 0;
            expect(rtx_re_match(pl, strlen(pl), ld, 0, strlen(ld), &end) &&
                       end == 2,
                   "re list dash");
            end = 0;
            expect(rtx_re_match(pl, strlen(pl), ls, 0, strlen(ls), &end) &&
                       end == 2,
                   "re list star");
            end = 0;
            expect(rtx_re_match(pn, strlen(pn), lo, 0, strlen(lo), &end) &&
                       end == 3,
                   "re list 1.");
            end = 0;
            expect(rtx_re_match(pp, strlen(pp), lp, 0, strlen(lp), &end) &&
                       end == 3,
                   "re list 2)");
            expect(!rtx_re_match(pl, strlen(pl), hr, 0, strlen(hr), &end),
                   "re list rejects ---");
            expect(!rtx_re_match(pl, strlen(pl), st, 0, strlen(st), &end),
                   "re list rejects ***");
            {
                const char *pg = "([-*+]|[0-9]{1,9}[.)])[ \\t]+";
                end = 0;
                expect(rtx_re_match(pg, strlen(pg), ld, 0, strlen(ld), &end) &&
                           end == 2,
                       "re group class may contain )");
            }
        }
        {
            const char *ph = "[0-9A-Fa-f]{2}";
            const char *tok = "A3zz";
            const char *shortn = "A";
            end = 0;
            expect(rtx_re_match(ph, strlen(ph), tok, 0, 4, &end) && end == 2,
                   "re {n} hex pair");
            expect(!rtx_re_match(ph, strlen(ph), shortn, 0, 1, &end),
                   "re {2} needs two");
        }
        {
            const char *pu = "a{2,}";
            const char *tu = "aaaa";
            end = 0;
            expect(rtx_re_match(pu, 5, tu, 0, 4, &end) && end == 4,
                   "re {n,} greedy");
            expect(!rtx_re_match(pu, 5, "a", 0, 1, &end), "re {2,} needs two");
        }
        {
            const char *bad = "a{x}";
            expect(!rtx_re_match(bad, 4, "a{x}", 0, 4, &end),
                   "re bare { is not literal");
            expect(rtx_re_match("\\{[0-9]", 7, "{3", 0, 2, &end) && end == 2,
                   "re \\{ is a brace");
        }
        {
            const char *inc = "#[ \\t]*(include|define)\\b";
            const char *esc = "\\\\.";
            expect(rtx_re_first(inc, strlen(inc)) == '#', "re first #include");
            expect(rtx_re_first("-?[0-9]+", 8) == -1, "re first optional -");
            expect(rtx_re_first(esc, 3) == '\\', "re first \\\\.");
            {
                const char *pk = "\"([^\"]+)\"\\s*:";
                expect(rtx_re_first(pk, strlen(pk)) == '"',
                       "re first JSON key");
            }
        }
        {
            const char *ps = "<style\\b[^>]*>";
            const char *pe = "</script\\s*>";
            const char *tag = "<style type=\"x\">";
            end = 0;
            expect(rtx_re_match(ps, strlen(ps), "<style>", 0, 7, &end) &&
                       end == 7,
                   "re <style> begin");
            end = 0;
            expect(rtx_re_match(ps, strlen(ps), tag, 0, strlen(tag), &end) &&
                       end == strlen(tag),
                   "re <style attrs> begin");
            end = 0;
            expect(rtx_re_match(pe, strlen(pe), "</script>", 0, 9, &end) &&
                       end == 9,
                   "re </script> end");
            expect(!rtx_re_match(pe, strlen(pe), "</scr", 0, 5, &end),
                   "re </scr is not a closer");
        }
    }

    {
        RtxDoc d = {0} @destroy;
        size_t k;
        int saw_kw = 0, saw_cmt = 0;
        expect(join2(path, sizeof path, rtx_tm_load_dir, "../mixed.txt"),
               "mixed path");
        d.from_path(path) !>;
        expect(d.path.ptr == NULL || !rtx_tm_for_path(d.path.ptr),
               "txt uses spike");
        d.destroy();
        d.from_buffer("=== code ===\nint x; /* c */\n") !>;
        expect(d.secs.len >= 2, "sections");
        for (k = 0; k < d.runs.len; k++) {
            if (rtx_scope_kind(d.runs.data[k].style.scope) == RTX_HL_KEYWORD) {
                saw_kw = 1;
            }
            if (rtx_scope_kind(d.runs.data[k].style.scope) == RTX_HL_COMMENT) {
                saw_cmt = 1;
            }
        }
        expect(saw_kw && saw_cmt, "spike scopes on from_buffer");
    }

    /* CODE then === prose ===: digits in the paragraph are not C numbers. */
    {
        RtxDoc d = {0} @destroy;
        size_t code_off, prose_off;
        char ch;
        expect(join2(path, sizeof path, rtx_tm_load_dir, "../code_then_prose.txt"),
               "code_then_prose path");
        d.from_path(path) !>;
        expect(d.section_at(0) == RTX_SEC_CODE, "code_then_prose starts CODE");
        {
            char buf[160];
            size_t n, k, bold_off, mono_off;
            const char *p;
            int code_hl = 0, prose_hl = 0, saw_ital = 0, saw_mono = 0;
            int planter_ok = 1;
            n = d.read_at(0, buf, sizeof(buf) - 1) !>;
            buf[n] = 0;
            p = strstr(buf, "int x = ");
            expect(p != NULL, "code_then_prose has int x");
            code_off = (size_t)(p - buf) + strlen("int x = ");
            p = strstr(buf, "Block ");
            expect(p != NULL, "code_then_prose has Block");
            prose_off = (size_t)(p - buf) + strlen("Block ");
            p = strstr(buf, "*bold*");
            expect(p != NULL, "code_then_prose has *bold*");
            bold_off = (size_t)(p - buf) + 1;
            p = strstr(buf, "`mono`");
            expect(p != NULL, "code_then_prose has `mono`");
            mono_off = (size_t)(p - buf) + 1;
            {
                size_t got = d.read_at(code_off, &ch, 1) !>;
                expect(got == 1 && ch == '1', "code digit");
            }
            {
                size_t got = d.read_at(prose_off, &ch, 1) !>;
                expect(got == 1 && ch == '1', "prose digit");
            }
            expect(d.section_at(prose_off) == RTX_SEC_PROSE, "Block N is prose");
            for (k = 0; k < d.runs.len; k++) {
                RtxRun r = d.runs.data[k];
                int num = rtx_scope_kind(r.style.scope) == RTX_HL_NUMBER;
                if (num && r.start <= code_off && code_off < r.start + r.len) {
                    code_hl = 1;
                }
                if (num && r.start <= prose_off && prose_off < r.start + r.len) {
                    prose_hl = 1;
                }
                /* Single `*` is italic in prose; `**` is bold. */
                if (r.style.italic && r.start <= bold_off &&
                    bold_off < r.start + r.len) {
                    saw_ital = 1;
                }
                if (r.style.bold) planter_ok = 0;
                if (r.style.mono && r.start <= mono_off &&
                    mono_off < r.start + r.len) {
                    saw_mono = 1;
                }
                /* Planter tag: scope runs come from the lexer, bit runs from
                 * the prose scanner. */
                if (r.style.scope != RTX_SCOPE_NONE && r.planter != RTX_RUN_TM) {
                    planter_ok = 0;
                }
                if ((r.style.italic || r.style.mono) && r.planter != RTX_RUN_PROSE) {
                    planter_ok = 0;
                }
                if (r.style.scope == RTX_SCOPE_NONE && (r.hint_a || r.hint_b)) {
                    planter_ok = 0;
                }
            }
            expect(code_hl, "code 16 is numeric");
            expect(!prose_hl, "prose 17 is not numeric");
            expect(saw_ital && saw_mono, "prose *italic* and `mono`");
            expect(planter_ok, "runs tagged by planter, no bold for single *");
        }
    }

    /* Prose scanner: `**` bold, `*` italic, `` ` `` mono; all RTX_RUN_PROSE. */
    {
        RtxDoc d = {0} @destroy;
        size_t k;
        int nb = 0, ni = 0, nm = 0, prose_ok = 1;
        /* offsets: **bb** 0-5, *ii* 7-10, `mm` 12-15; then unclosed spans */
        d.from_buffer("**bb** *ii* `mm` *a\n*b `q\n") !>;
        expect(d.section_at(0) == RTX_SEC_PROSE, "buffer root is prose");
        for (k = 0; k < d.runs.len; k++) {
            RtxRun r = d.runs.data[k];
            if (r.planter != RTX_RUN_PROSE || r.style.scope != RTX_SCOPE_NONE)
                prose_ok = 0;
            if (r.style.bold) {
                nb++;
                if (!(r.start == 2 && r.len == 2)) prose_ok = 0;
            }
            if (r.style.italic) {
                ni++;
                if (!(r.start == 8 && r.len == 2)) prose_ok = 0;
            }
            if (r.style.mono) {
                nm++;
                if (!(r.start == 13 && r.len == 2)) prose_ok = 0;
            }
        }
        expect(nb == 1 && ni == 1 && nm == 1, "one bold, one italic, one mono");
        expect(prose_ok, "prose runs at **bb** *ii* `mm`; unclosed spans skipped");
        expect(d.style_at(2).bold && !d.style_at(2).italic, "style_at bold");
        expect(d.style_at(8).italic && !d.style_at(8).bold, "style_at italic");
        expect(d.style_at(13).mono, "style_at mono");
    }

    /* Clip by planter: a TM-planted run that also carries a style bit is
     * still dropped by the section re-lex (bit shape used to exempt it). */
    {
        RtxDoc d = {0} @destroy;
        RtxScope inv = RTX_SCOPE_NONE;
        RtxStyle st = {0};
        size_t k, at;
        int saw_bold = 0;
        d.from_buffer("=== code ===\nint x;\n") !>;
        expect(rtx_scope_put(&inv, "invalid.illegal"), "intern invalid (clip)");
        at = strlen("=== code ===\n");
        st.scope = inv;
        st.bold = 1;
        expect(rtx_doc_add_run(&d, at, 3, st, RTX_RUN_TM), "plant scope+bold TM run");
        for (k = 0; k < d.runs.len; k++) {
            if (d.runs.data[k].style.bold) saw_bold = 1;
        }
        expect(saw_bold, "planted run present before re-lex");
        d.caret = d.len();
        d.sel_anchor = d.caret;
        d.type("y") !>;
        d.reparse_edit(d.last_off, d.last_markup) !>;
        saw_bold = 0;
        for (k = 0; k < d.runs.len; k++) {
            if (d.runs.data[k].style.bold) saw_bold = 1;
        }
        expect(!saw_bold, "TM re-lex clips a TM run that carries a bit");
    }

    {
        char cpath[512];
        RtxDoc d = {0} @destroy;
        size_t k;
        int saw_kw = 0, saw_dir = 0, saw_esc = 0;
        const char *nm = NULL;
        expect(join2(cpath, sizeof cpath, rtx_tm_load_dir, "../samples/hello.c"),
               "hello.c path");
        d.from_path(cpath) !>;
        expect(rtx_tm_for_path(d.path.ptr) == want, "c sample uses C TM");
        for (k = 0; k < d.runs.len; k++) {
            const char *s = rtx_scope_name(d.runs.data[k].style.scope);
            if (rtx_scope_kind(d.runs.data[k].style.scope) == RTX_HL_KEYWORD) {
                saw_kw = 1;
                if (s && strstr(s, "directive")) saw_dir = 1;
                else nm = s;
            }
            if (s && strstr(s, "escape")) saw_esc = 1;
        }
        expect(saw_kw, "TM lexed int");
        expect(saw_dir, "TM leftover #include");
        expect(saw_esc, "nested string escape");
        expect(nm && strncmp(nm, "keyword", 7) == 0, "keyword.control.c");
    }

    {
        char jpath[512];
        FILE *jf;
        expect(join2(jpath, sizeof jpath, rtx_tm_load_dir, "json.tmLanguage.json"),
               "json grammar path");
        jf = fopen(jpath, "rb");
        char *jbuf = NULL;
        long jsz = 0;
        TmGrammar jg;
        RtxTmRt *jrt;
        expect(jf != NULL, "open json.tmLanguage.json");
        if (jf) {
            if (fseek(jf, 0, SEEK_END) != 0) return 1;
            jsz = ftell(jf);
            if (jsz <= 0) return 1;
            rewind(jf);
            jbuf = (char *)malloc((size_t)jsz + 1);
            if (!jbuf) return 1;
            if (fread(jbuf, 1, (size_t)jsz, jf) != (size_t)jsz) return 1;
            jbuf[jsz] = 0;
            fclose(jf);
            jg = (TmGrammar){0};
            expect(TmGrammar_parse(jbuf, (size_t)jsz, arena, &jg),
                   "parse JSON TmGrammar");
            expect(slice_eq(jg.name, "JSON"), "name JSON");
            expect(slice_eq(jg.scopeName, "source.json"), "scopeName source.json");
            expect(jg.patterns_n == 4, "four top-level JSON patterns");
            jrt = rtx_tm_json_rt();
            expect(jrt && jrt->rules.len >= 4, "flattened JSON rules");
            {
                int saw_cap = 0;
                int saw_num = 0;
                for (i = 0; i < jrt->rules.len; i++) {
                    if (jrt->rules.data[i].op == RTX_TM_REGEX &&
                        jrt->rules.data[i].cap[1] != RTX_SCOPE_NONE) {
                        saw_cap = 1;
                        expect(jrt->rules.data[i].has_cap, "JSON key has_cap");
                        expect(jrt->rules.data[i].first == '"',
                               "JSON key first-byte \"");
                    }
                    if (jrt->rules.data[i].op == RTX_TM_REGEX &&
                        !jrt->rules.data[i].has_cap) {
                        saw_num = 1;
                        expect(jrt->rules.data[i].first == -1,
                               "JSON number first is any");
                    }
                }
                {
                    size_t k;
                    int saw_esc_dot = 0;
                    for (k = 0; k < jrt->inners.len; k++) {
                        if (jrt->inners.data[k].op == RTX_TM_ESC_DOT) {
                            saw_esc_dot = 1;
                        }
                    }
                    expect(saw_esc_dot, "JSON \\\\. is ESC_DOT");
                }
                expect(saw_cap, "JSON key captures interned");
                expect(saw_num, "JSON number is leftover regex");
            }
            expect(jrt->n_exts >= 1, "json fileTypes");
            expect(rtx_tm_for_path("x.json") == jrt, "json path uses JSON TM");
            expect(rtx_tm_for_path("x.c") == want, "c path still C TM");
            expect(rtx_tm_for_path("x.cc") == want, "cc uses C TM");
            expect(rtx_tm_for_path("x.shcc") == want, "shcc uses C TM");
            expect(rtx_tm_for_path("x.hpp") == want, "hpp uses C TM");
            expect(rtx_tm_for_path("x.cpp") == want, "cpp uses C TM");
            expect(rtx_tm_for_path("x.css") != NULL &&
                   rtx_tm_for_path("x.css") != want, "css has its own TM");
            expect(rtx_tm_for_path("a.csv") == rtx_tm_for_path("b.tsv") &&
                   rtx_tm_for_path("a.csv") == rtx_tm_for_path("c.pipe") &&
                   rtx_tm_for_path("a.csv") == rtx_tm_for_path("d.psv"),
                   "csv/tsv/pipe share TM");
            expect(rtx_tm_for_path("x.html") && rtx_tm_for_path("x.htm"),
                   "html/htm");
            expect(rtx_tm_for_path("x.yml") == rtx_tm_for_path("x.yaml"),
                   "yml/yaml share TM");
            expect(rtx_tm_for_path("x.sh") == rtx_tm_for_path("x.bash"),
                   "sh/bash share TM");
            expect(rtx_tm_for_path("x.py") != NULL, "python TM");
            expect(rtx_tm_for_path("x.js") == rtx_tm_for_path("x.ts") &&
                   rtx_tm_for_path("x.js") == rtx_tm_for_path("x.mjs"),
                   "js/ts/mjs share TM");
            free(jbuf);
        }
    }

    {
        char spath[512];
        RtxDoc d = {0} @destroy;
        size_t k;
        int saw_str = 0, saw_num = 0, saw_kw = 0, saw_esc = 0, saw_prop = 0;
        expect(join2(spath, sizeof spath, rtx_tm_load_dir,
                     "../samples/config.json"),
               "config.json path");
        d.from_path(spath) !>;
        expect(rtx_tm_for_path(d.path.ptr) == rtx_tm_json_rt(),
               "json sample uses JSON TM");
        expect(d.secs.len >= 1 && d.secs.data[0].kind == RTX_SEC_CODE, "json is code");
        for (k = 0; k < d.runs.len; k++) {
            const char *s = rtx_scope_name(d.runs.data[k].style.scope);
            if (rtx_scope_kind(d.runs.data[k].style.scope) == RTX_HL_STRING) {
                saw_str = 1;
            }
            if (rtx_scope_kind(d.runs.data[k].style.scope) == RTX_HL_NUMBER) {
                saw_num = 1;
            }
            if (rtx_scope_kind(d.runs.data[k].style.scope) == RTX_HL_KEYWORD) {
                saw_kw = 1;
            }
            if (s && strstr(s, "escape")) saw_esc = 1;
            if (s && strstr(s, "variable")) saw_prop = 1;
        }
        expect(saw_str, "JSON string");
        expect(saw_num, "JSON number leftover regex");
        expect(saw_kw, "JSON true");
        expect(saw_esc, "JSON string escape");
        expect(saw_prop, "JSON key capture");
    }

    {
        char mpath[512];
        FILE *mf;
        expect(join2(mpath, sizeof mpath, rtx_tm_load_dir,
                     "markdown.tmLanguage.json"),
               "md grammar path");
        mf = fopen(mpath, "rb");
        char *mbuf = NULL;
        long msz = 0;
        TmGrammar mg;
        RtxTmRt *mrt;
        expect(mf != NULL, "open markdown.tmLanguage.json");
        if (mf) {
            if (fseek(mf, 0, SEEK_END) != 0) return 1;
            msz = ftell(mf);
            if (msz <= 0) return 1;
            rewind(mf);
            mbuf = (char *)malloc((size_t)msz + 1);
            if (!mbuf) return 1;
            if (fread(mbuf, 1, (size_t)msz, mf) != (size_t)msz) return 1;
            mbuf[msz] = 0;
            fclose(mf);
            mg = (TmGrammar){0};
            expect(TmGrammar_parse(mbuf, (size_t)msz, arena, &mg),
                   "parse Markdown TmGrammar");
            expect(slice_eq(mg.name, "Markdown"), "name Markdown");
            expect(slice_eq(mg.scopeName, "text.markdown"),
                   "scopeName text.markdown");
            expect(mg.patterns_n == 12, "twelve top-level Markdown patterns");
            mrt = rtx_tm_md_rt();
            expect(mrt && mrt->rules.len >= 6, "flattened Markdown rules");
            {
                size_t ri;
                int saw_h = 0, saw_q = 0, saw_l = 0;
                int saw_b = 0, saw_i = 0, saw_c = 0, saw_a = 0;
                RtxApplyEnt ents[RTX_APPLY_MAX];
                size_t an, ai;
                int uh = 0, uq = 0, ul = 0, ub = 0, ui = 0, uc = 0, uk = 0,
                    ua = 0, ut = 0;
                for (ri = 0; ri < mrt->rules.len; ri++) {
                    const RtxTmRule *rr = &mrt->rules.data[ri];
                    if (!rr->sc_apply) continue;
                    if (rr->sc_insert && strcmp(rr->sc_apply, "heading") == 0 &&
                        strcmp(rr->sc_insert, "#") == 0 && rr->sc_max == 6)
                        saw_h = 1;
                    if (rr->sc_insert && strcmp(rr->sc_apply, "quote") == 0 &&
                        strcmp(rr->sc_insert, ">") == 0 && rr->sc_max == 6)
                        saw_q = 1;
                    if (rr->sc_insert && strcmp(rr->sc_apply, "list") == 0 &&
                        strcmp(rr->sc_insert, "- ") == 0 && rr->sc_max == 1)
                        saw_l = 1;
                    if (strcmp(rr->sc_apply, "bold") == 0) saw_b = 1;
                    if (strcmp(rr->sc_apply, "italic") == 0) saw_i = 1;
                    if (strcmp(rr->sc_apply, "code") == 0) saw_c = 1;
                    if (strcmp(rr->sc_apply, "autolink") == 0 && rr->sc_wrap == 1 &&
                        rr->sc_insert && strcmp(rr->sc_insert, "<>") == 0)
                        saw_a = 1;
                }
                expect(saw_h && saw_q && saw_l,
                       "prefix apply insert/max from sidecar");
                expect(saw_b && saw_i && saw_c && saw_a,
                       "pair apply tags from sidecar");
                an = rtx_tm_apply_list(mrt, ents, RTX_APPLY_MAX);
                expect(an == 9, "md apply table is 9 unique names");
                for (ai = 0; ai < an; ai++) {
                    if (!ents[ai].name) continue;
                    if (strcmp(ents[ai].name, "heading") == 0 &&
                        ents[ai].kind == RTX_APPLY_PREFIX)
                        uh = 1;
                    if (strcmp(ents[ai].name, "quote") == 0 &&
                        ents[ai].kind == RTX_APPLY_PREFIX)
                        uq = 1;
                    if (strcmp(ents[ai].name, "list") == 0 &&
                        ents[ai].kind == RTX_APPLY_PREFIX)
                        ul = 1;
                    if (strcmp(ents[ai].name, "bold") == 0 &&
                        ents[ai].kind == RTX_APPLY_PAIR)
                        ub = 1;
                    if (strcmp(ents[ai].name, "italic") == 0 &&
                        ents[ai].kind == RTX_APPLY_PAIR)
                        ui = 1;
                    if (strcmp(ents[ai].name, "code") == 0 &&
                        ents[ai].kind == RTX_APPLY_PAIR)
                        uc = 1;
                    if (strcmp(ents[ai].name, "link") == 0 &&
                        ents[ai].kind == RTX_APPLY_PATH)
                        uk = 1;
                    if (strcmp(ents[ai].name, "autolink") == 0 &&
                        ents[ai].kind == RTX_APPLY_PAIR)
                        ua = 1;
                    if (strcmp(ents[ai].name, "toggle") == 0 &&
                        ents[ai].kind == RTX_APPLY_TOGGLE)
                        ut = 1;
                }
                expect(uh && uq && ul && ub && ui && uc && uk && ua && ut,
                       "apply list kinds: prefix / pair / path / toggle");
                expect(rtx_tm_apply_list(want, ents, RTX_APPLY_MAX) == 0,
                       "C grammar has an empty apply table");
                {
                    RtxDoc md = {0} @destroy;
                    RtxDoc raw = {0} @destroy;
                    md.from_path("testdata/rich/md/headings.md") !>;
                    expect(RtxDoc_apply_list(&md, ents, RTX_APPLY_MAX) == 9,
                           "doc apply list is the path grammar");
                    raw.from_buffer("# scratch\n") !>;
                    expect(RtxDoc_apply_list(&raw, ents, RTX_APPLY_MAX) == 0,
                           "untitled has no apply table");
                }
            }
            expect(rtx_tm_for_path("x.md") == mrt, "md path uses Markdown TM");
            expect(rtx_tm_for_path("x.markdown") == mrt,
                   "markdown path uses Markdown TM");
            expect(rtx_tm_for_path("x.c") == want, "c path still C after md");
            free(mbuf);
        }
    }

    {
        char spath[512];
        RtxDoc d = {0} @destroy;
        size_t k;
        int saw_h = 0, saw_bold = 0, saw_code = 0, saw_q = 0, saw_link = 0;
        expect(join2(spath, sizeof spath, rtx_tm_load_dir, "../samples/readme.md"),
               "readme.md path");
        d.from_path(spath) !>;
        expect(rtx_tm_for_path(d.path.ptr) == rtx_tm_md_rt(),
               "md sample uses Markdown TM");
        expect(d.secs.len >= 1 && d.secs.data[0].kind == RTX_SEC_MARKUP, "md is markup");
        for (k = 0; k < d.runs.len; k++) {
            const char *s = rtx_scope_name(d.runs.data[k].style.scope);
            if (s && strstr(s, "heading")) saw_h = 1;
            if (s && strstr(s, "bold")) saw_bold = 1;
            if (s && strstr(s, "raw")) saw_code = 1;
            if (s && strstr(s, "quote")) saw_q = 1;
            if (s && strstr(s, "link")) saw_link = 1;
        }
        expect(saw_h, "Markdown heading");
        expect(saw_bold, "Markdown bold");
        expect(saw_code, "Markdown code");
        expect(saw_q, "Markdown quote");
        expect(saw_link, "Markdown link");
        /* Letter and `*` are style, not section edits. TM color must stay. */
        d.caret = 2;
        d.sel_anchor = 2;
        d.type("x") !>;
        d.reparse_edit(d.last_off, d.last_markup) !>;
        expect(!d.last_markup, "letter is not a section edit");
        expect(d.secs.data[0].kind == RTX_SEC_MARKUP, "md stays markup after type");
        saw_h = 0;
        for (k = 0; k < d.runs.len; k++) {
            const char *s = rtx_scope_name(d.runs.data[k].style.scope);
            if (s && strstr(s, "heading")) saw_h = 1;
        }
        expect(saw_h, "heading survives a letter");
        d.type("*") !>;
        d.reparse_edit(d.last_off, d.last_markup) !>;
        expect(!d.last_markup, "star is not a section edit");
        expect(d.secs.data[0].kind == RTX_SEC_MARKUP, "md stays markup after star");
        saw_h = saw_bold = 0;
        for (k = 0; k < d.runs.len; k++) {
            const char *s = rtx_scope_name(d.runs.data[k].style.scope);
            if (s && strstr(s, "heading")) saw_h = 1;
            if (s && strstr(s, "bold")) saw_bold = 1;
        }
        expect(saw_h && saw_bold, "TM scopes survive a star");
        d.caret = d.len();
        d.sel_anchor = d.caret;
        d.type("=") !>;
        expect(d.last_markup, "equals is a section edit");
        d.reparse_edit(d.last_off, d.last_markup) !>;
        expect(d.secs.data[0].kind == RTX_SEC_MARKUP, "md stays markup after section rescan");
        saw_h = 0;
        for (k = 0; k < d.runs.len; k++) {
            const char *s = rtx_scope_name(d.runs.data[k].style.scope);
            if (s && strstr(s, "heading")) saw_h = 1;
        }
        expect(saw_h, "heading survives section rescan");
    }

    /* Paste of * / ` must not drop README color. */
    {
        char rpath[512];
        RtxDoc d = {0} @destroy;
        size_t k;
        int saw_h = 0;
        expect(join2(rpath, sizeof rpath, rtx_tm_load_dir, "../../README.md"),
               "README.md path");
        d.from_path(rpath) !>;
        expect(d.secs.data[0].kind == RTX_SEC_MARKUP, "README is TM markup");
        d.caret = d.len();
        d.sel_anchor = d.caret;
        d.type("**paste** and `code`\n") !>;
        expect(!d.last_markup, "style-only paste is not a section edit");
        d.reparse_edit(d.last_off, d.last_markup) !>;
        expect(d.secs.data[0].kind == RTX_SEC_MARKUP, "README stays markup after paste");
        for (k = 0; k < d.runs.len; k++) {
            const char *s = rtx_scope_name(d.runs.data[k].style.scope);
            if (s && strstr(s, "heading")) saw_h = 1;
        }
        expect(saw_h, "README heading survives paste");
    }

    /* Span hints: a closed ``` fence records both literal lengths; an
     * unclosed one (window end) records hint_b = 0. Non-span runs are 0/0. */
    {
        const char *fpath = "testdata/generated/fence.md";
        RtxDoc d = {0} @destroy;
        size_t k;
        int closed_ok = 0, others_ok = 1;
        if (system("mkdir -p testdata/generated") != 0) expect(0, "mkdir fence");
        expect(write_file(fpath, "# H\n```\nint x;\n```\ntail `c` *i*\n"),
               "write fence.md");
        d.from_path(fpath) !>;
        expect(d.section_at(0) == RTX_SEC_MARKUP, "md fence doc is MARKUP");
        for (k = 0; k < d.runs.len; k++) {
            RtxRun r = d.runs.data[k];
            const char *s = rtx_scope_name(r.style.scope);
            if (r.style.scope != RTX_SCOPE_NONE && r.planter != RTX_RUN_TM)
                others_ok = 0;
            if (r.style.scope == RTX_SCOPE_NONE && (r.hint_a || r.hint_b))
                others_ok = 0;
            if (s && strstr(s, "raw.block")) {
                if (r.start == 4 && r.hint_a == 3 && r.hint_b == 3) closed_ok = 1;
            } else if (s && strstr(s, "heading")) {
                if (r.hint_a != 2 || r.hint_b) others_ok = 0;
            } else if (s && strstr(s, "raw.inline")) {
                if (!(r.hint_a == 1 && r.hint_b == 1)) others_ok = 0;
            }
        }
        expect(closed_ok, "closed fence hint_a == 3 && hint_b == 3");
        expect(others_ok, "regex runs 0/0, inline code 1/1, scope runs TM planted");
        d.destroy();
        expect(write_file(fpath, "# H\n```\nint x;\nno closer\n"), "write open fence");
        d.from_path(fpath) !>;
        closed_ok = 0;
        for (k = 0; k < d.runs.len; k++) {
            RtxRun r = d.runs.data[k];
            const char *s = rtx_scope_name(r.style.scope);
            if (s && strstr(s, "raw.block") && r.start == 4 &&
                r.start + r.len == d.len() && r.hint_a == 3 && r.hint_b == 0) {
                closed_ok = 1;
            }
        }
        expect(closed_ok, "unclosed fence hint_a == 3 && hint_b == 0");
        remove(fpath);
    }

    /* Shipped Markdown grammar declares `kind: markup`: the doc is MARKUP,
     * TM runs carry style bits from the default scope map (heading / bold →
     * bold, italic → italic, raw → mono), and the prose scanner plants
     * nothing in a grammared section. Fixture: testdata/rich/md/inline.md. */
    {
        const char *fpath = "testdata/rich/md/inline.md";
        RtxDoc d = {0} @destroy;
        CCArena frame = cc_arena_heap(kilobytes(8));
        char[:] all;
        const char *p, *q;
        size_t k, off;
        int prose_runs = 0;
        expect(frame.base != NULL, "inline.md frame");
        d.from_path(fpath) !>;
        expect(rtx_tm_for_path(d.path.ptr) == rtx_tm_md_rt(), "inline.md uses Markdown TM");
        expect(rtx_tm_md_rt()->markup == 1, "shipped markdown grammar declares markup");
        expect(d.section_at(0) == RTX_SEC_MARKUP, "inline.md is MARKUP");
        all = d.scratch_span(0, d.len(), frame) !>;
        for (k = 0; k < d.runs.len; k++) {
            if (d.runs.data[k].planter == RTX_RUN_PROSE) prose_runs++;
        }
        expect(prose_runs == 0, "no prose-scanner runs in a grammared doc");
        /* L1: `# Inline marks` — heading is bold, not mono, keeps scope. */
        expect(d.style_at(2).bold && !d.style_at(2).mono &&
               rtx_scope_is_heading(d.style_at(2).scope),
               "heading run is bold with scope");
        /* L3: `**bold**` / `*italic*` — content bits, neighbors plain. */
        p = strstr(all.ptr, "**bold**");
        q = strstr(all.ptr, "*italic*");
        expect(p != NULL && q != NULL, "inline.md L3 marks present");
        if (p && q) {
            off = (size_t)(p - all.ptr);
            expect(d.style_at(off + 2).bold && !d.style_at(off + 2).italic,
                   "**bold** content is bold");
            expect(!d.style_at(off - 1).bold, "byte before **bold** is plain");
            expect(!d.style_at(off + 9).bold, "byte after **bold** is plain");
            off = (size_t)(q - all.ptr);
            expect(d.style_at(off + 1).italic && !d.style_at(off + 1).bold,
                   "*italic* content is italic");
            expect(!d.style_at(off + 9).italic, "byte after *italic* is plain");
        }
        /* `cctext.inline` on bold / italic / code: a span unclosed at EOL is
         * plain text, so L5's code spans are whole and mono, the `*` inside
         * them is not italic (README L5), and L10's `**bold at EOL` plants
         * nothing (README L10). */
        p = strstr(all.ptr, "`a * b`");
        expect(p != NULL, "inline.md L5 code span present");
        if (p) {
            off = (size_t)(p - all.ptr);
            expect(d.style_at(off + 1).mono && !d.style_at(off + 3).italic,
                   "L5: `a * b` is mono, star inside is not italic");
            expect(d.style_at(off + 6).mono && !d.style_at(off + 7).mono,
                   "L5: code span closes at its own backtick");
        }
        p = strstr(all.ptr, "`**not bold**`");
        if (p) {
            off = (size_t)(p - all.ptr);
            expect(d.style_at(off + 3).mono && !d.style_at(off + 3).bold,
                   "L5: ** inside a code span is not bold");
        }
        p = strstr(all.ptr, "Unterminated **bold");
        if (p) {
            off = (size_t)(p - all.ptr) + 13;
            expect(!d.style_at(off).bold && !d.style_at(off + 2).bold &&
                       !d.style_at(off + 12).bold,
                   "L10: unclosed ** at EOL plants nothing");
            expect(!RtxDoc_hint_at(&d, off, NULL, NULL), "L10: unclosed ** is not a hint");
        }
        /* `cctext.flank`: `2 * 3` opens nothing (README L11); `*italic.*`
         * still closes after punctuation (README L7). */
        p = strstr(all.ptr, "Math: 2 * 3");
        if (p) {
            off = (size_t)(p - all.ptr);
            expect(!d.style_at(off + 8).italic && !d.style_at(off + 20).italic,
                   "L11: spaced stars are not italic");
        }
        p = strstr(all.ptr, "*italic.*");
        if (p) {
            off = (size_t)(p - all.ptr);
            expect(d.style_at(off + 7).italic && !d.style_at(off + 9).italic,
                   "L7: *italic.* closes after punctuation");
        }
        p = strstr(all.ptr, "**bold**");
        /* Hints ride the same runs. */
        for (k = 0; k < d.runs.len; k++) {
            RtxRun r = d.runs.data[k];
            if (p && r.start == (size_t)(p - all.ptr)) {
                expect(r.hint_a == 2 && r.hint_b == 2 && r.style.bold, "**bold** run hints 2/2");
            }
        }
        /* hint_at / mark_at over `**bold**` at off: hints [off,off+2) and
         * [off+6,off+8); content is not a hint; the mark is [off,off+8]
         * inclusive of the caret position just past the closer. */
        if (p) {
            size_t lo = 0, hi = 0;
            int h;
            off = (size_t)(p - all.ptr);
            h = RtxDoc_hint_at(&d, off, &lo, &hi);
            expect(h && lo == off && hi == off + 2, "hint_at begin hint");
            h = RtxDoc_hint_at(&d, off + 1, &lo, &hi);
            expect(h && lo == off && hi == off + 2, "hint_at 2nd byte of begin");
            h = RtxDoc_hint_at(&d, off + 2, &lo, &hi);
            expect(h == 0, "hint_at content is 0");
            h = RtxDoc_hint_at(&d, off + 6, &lo, &hi);
            expect(h && lo == off + 6 && hi == off + 8, "hint_at end hint");
            h = RtxDoc_hint_at(&d, off + 8, &lo, &hi);
            expect(h == 0, "hint_at past the mark is 0");
            h = RtxDoc_hint_at(&d, off - 1, &lo, &hi);
            expect(h == 0, "hint_at before the mark is 0");
            h = RtxDoc_mark_at(&d, off, &lo, &hi);
            expect(h && lo == off && hi == off + 8, "mark_at start");
            h = RtxDoc_mark_at(&d, off + 4, &lo, &hi);
            expect(h && lo == off && hi == off + 8, "mark_at content");
            h = RtxDoc_mark_at(&d, off + 8, &lo, &hi);
            expect(h && lo == off && hi == off + 8, "mark_at inclusive end");
            h = RtxDoc_mark_at(&d, off - 1, &lo, &hi);
            expect(h == 0, "mark_at before is 0");
            h = RtxDoc_mark_at(&d, off + 9, &lo, &hi);
            expect(h == 0, "mark_at after is 0");
        }
        /* Nested marks (stack depth 2): L4 `***both***` is bold wrapping
         * italic; `**outer *inner* outer**` is italic inside bold; L13
         * `` `code` `` inside bold stays mono and not italic. */
        p = strstr(all.ptr, "***both***");
        if (p) {
            off = (size_t)(p - all.ptr);
            expect(d.style_at(off + 3).bold && d.style_at(off + 3).italic,
                   "L4: ***both*** content is bold+italic");
            expect(d.style_at(off + 3).bold && !d.style_at(off + 10).bold,
                   "L4: ***both*** does not leak past the closer");
        }
        p = strstr(all.ptr, "**outer *inner* outer**");
        if (p) {
            off = (size_t)(p - all.ptr);
            expect(d.style_at(off + 2).bold && !d.style_at(off + 2).italic,
                   "L4: outer content is bold only");
            expect(d.style_at(off + 9).bold && d.style_at(off + 9).italic,
                   "L4: *inner* is bold+italic");
            expect(d.style_at(off + 16).bold && !d.style_at(off + 16).italic,
                   "L4: trailing outer is bold only");
        }
        p = strstr(all.ptr, "*outer **inner** outer*");
        if (p) {
            off = (size_t)(p - all.ptr);
            expect(d.style_at(off + 1).italic && !d.style_at(off + 1).bold,
                   "L4: italic wrapper content is italic only");
            expect(d.style_at(off + 8).italic && d.style_at(off + 8).bold,
                   "L4: **inner** is italic+bold");
        }
        p = strstr(all.ptr, "**bold with `code` inside**");
        if (p) {
            off = (size_t)(p - all.ptr);
            expect(d.style_at(off + 13).mono && d.style_at(off + 13).bold,
                   "L13: code inside bold is mono+bold");
            expect(!d.style_at(off + 13).italic, "L13: code inside bold is not italic");
        }
        frame.destroy();
    }

    /* `cctext.bol` on the fence: a ``` that is not at line start (inside a
     * docstring on nested.md:11) is body, not the closer. The python fence
     * runs from its opener to the BOL ``` on line 14, and the heading after
     * it is still a heading. */
    {
        const char *fpath = "testdata/rich/code/nested.md";
        RtxDoc d = {0} @destroy;
        CCArena frame = cc_arena_heap(kilobytes(8));
        char[:] all;
        const char *open_p, *fake_p, *close_p, *h2_p;
        size_t k;
        int fence_ok = 0, h2_ok = 0;
        expect(frame.base != NULL, "nested.md frame");
        d.from_path(fpath) !>;
        expect(d.section_at(0) == RTX_SEC_MARKUP, "nested.md is MARKUP");
        all = d.scratch_span(0, d.len(), frame) !>;
        open_p = strstr(all.ptr, "```python");
        fake_p = strstr(all.ptr, "marker ``` and");
        close_p = fake_p ? strstr(fake_p, "\n```\n") : NULL;
        h2_p = strstr(all.ptr, "## HTML fence");
        expect(open_p && fake_p && close_p && h2_p, "nested.md landmarks");
        if (open_p && fake_p && close_p && h2_p) {
            size_t so = (size_t)(open_p - all.ptr);
            size_t eo = (size_t)(close_p + 1 - all.ptr) + 3; /* past BOL ``` */
            for (k = 0; k < d.runs.len; k++) {
                RtxRun r = d.runs.data[k];
                const char *s = rtx_scope_name(r.style.scope);
                if (s && strstr(s, "raw.block") && r.start == so) {
                    fence_ok = (r.start + r.len == eo && r.hint_a == 3 && r.hint_b == 3 &&
                                r.style.mono);
                }
                if (s && strstr(s, "heading") && r.start == (size_t)(h2_p - all.ptr)) {
                    h2_ok = 1;
                }
            }
            expect(fence_ok, "python fence closes at the BOL ```, not the docstring one");
            expect(h2_ok, "heading after the fence is a heading run");
            expect(RtxDoc_style_at(&d, (size_t)(fake_p - all.ptr) + 8).mono,
                   "docstring ``` is fence body");
            {
                const char *def_p = strstr(open_p, "def greet");
                const char *doc_p = strstr(open_p, "\"\"\"Return");
                expect(rtx_tm_rt_for_scope("source.python") != NULL,
                       "scopeName source.python is registered");
                expect(rtx_tm_rt_for_info("python", 6) == rtx_tm_rt_for_scope("source.python"),
                       "info string python → source.python");
                expect(rtx_tm_md_rt()->scope &&
                       strcmp(rtx_tm_md_rt()->scope, "text.markdown") == 0,
                       "markdown grammar stores scopeName");
                if (def_p && def_p < close_p) {
                    size_t dof = (size_t)(def_p - all.ptr);
                    const char *sn = rtx_scope_name(d.style_at(dof).scope);
                    expect(d.style_at(dof).mono, "fence body stays mono");
                    expect(sn && strstr(sn, "keyword"),
                           "python fence injects keyword on def");
                }
                if (doc_p && doc_p < close_p) {
                    size_t qof = (size_t)(doc_p - all.ptr);
                    const char *sn = rtx_scope_name(d.style_at(qof + 3).scope);
                    expect(sn && strstr(sn, "string"),
                           "python fence docstring is a string span");
                }
                for (k = 0; k < d.runs.len; k++) {
                    RtxRun r = d.runs.data[k];
                    const char *s = rtx_scope_name(r.style.scope);
                    if (s && strstr(s, "keyword") && r.start > so && r.start < eo) {
                        expect(r.planter == RTX_RUN_INJECT,
                               "guest keyword run is RTX_RUN_INJECT");
                        break;
                    }
                }
            }
            {
                const char *html_p = strstr(all.ptr, "```html");
                const char *const_p = html_p ? strstr(html_p, "const s") : NULL;
                const char *html_close = html_p ? strstr(html_p + 7, "\n```\n")
                                                : NULL;
                expect(html_p && const_p && html_close, "nested.md html fence");
                if (const_p && html_close && const_p < html_close) {
                    size_t cof = (size_t)(const_p - all.ptr);
                    const char *sn =
                        rtx_scope_name(RtxDoc_style_at(&d, cof).scope);
                    expect(sn && strstr(sn, "keyword"),
                           "html fence injects JS keyword on const");
                    for (k = 0; k < d.runs.len; k++) {
                        RtxRun r = d.runs.data[k];
                        if (r.start == cof &&
                            rtx_scope_name(r.style.scope) &&
                            strstr(rtx_scope_name(r.style.scope), "keyword")) {
                            expect(r.planter == RTX_RUN_INJECT,
                                   "html-fence JS keyword is RTX_RUN_INJECT");
                            break;
                        }
                    }
                }
            }
        }
        frame.destroy();
    }

    /* Explicit `"""` / `'''` spans: embeds.py is one docstring, not the
     * `""`+`"…"`+`""` accident. */
    {
        const char *fpath = "testdata/rich/code/embeds.py";
        RtxDoc d = {0} @destroy;
        CCArena frame = cc_arena_heap(kilobytes(8));
        char[:] all;
        const char *p;
        size_t off;
        expect(frame.base != NULL, "embeds.py frame");
        d.from_path(fpath) !>;
        all = d.scratch_span(0, d.len(), frame) !>;
        p = strstr(all.ptr, "\"\"\"Module docstring");
        expect(p != NULL, "embeds.py module docstring");
        if (p) {
            const char *sn;
            const char *def_in;
            off = (size_t)(p - all.ptr);
            sn = rtx_scope_name(d.style_at(off + 3).scope);
            expect(sn && strstr(sn, "string"), "module docstring is a string");
            def_in = strstr(p, "word def and");
            if (def_in) {
                sn = rtx_scope_name(d.style_at((size_t)(def_in - all.ptr) + 5).scope);
                expect(sn && strstr(sn, "string") && !strstr(sn, "keyword"),
                       "def inside the docstring is still string");
            }
        }
        p = strstr(all.ptr, "'''Single-quoted");
        if (p) {
            const char *sn;
            off = (size_t)(p - all.ptr);
            sn = rtx_scope_name(d.style_at(off + 3).scope);
            expect(sn && strstr(sn, "string"), "''' docstring is one span");
        }
        frame.destroy();
    }

    /* HTML <style> / <script> RE_SPAN + CSS/JS guest (embeds.html). */
    {
        const char *fpath = "testdata/rich/code/embeds.html";
        RtxDoc d = {0} @destroy;
        CCArena frame = cc_arena_heap(kilobytes(8));
        char[:] all;
        const char *p, *q;
        size_t k;
        expect(frame.base != NULL, "embeds.html frame");
        d.from_path(fpath) !>;
        all = d.scratch_span(0, d.len(), frame) !>;
        {
            const RtxTmRt *hrt = rtx_tm_for_path(fpath);
            int saw_style = 0, saw_script = 0, saw_cmt = 0;
            const RtxTmRt *mrt = rtx_tm_md_rt();
            expect(hrt != NULL, "embeds.html uses HTML TM");
            if (hrt) {
                for (k = 0; k < hrt->rules.len; k++) {
                    const RtxTmRule *r = &hrt->rules.data[k];
                    if (r->op == RTX_TM_RE_SPAN && r->a && strstr(r->a, "style"))
                        saw_style = 1;
                    if (r->op == RTX_TM_RE_SPAN && r->a && strstr(r->a, "script"))
                        saw_script = 1;
                    if (r->op == RTX_TM_LIT_SPAN && r->a && r->alen == 4 &&
                        r->a[0] == '<' && r->a[1] == '!')
                        saw_cmt = 1;
                }
            }
            expect(saw_style && saw_script, "HTML style/script lower as RE_SPAN");
            expect(saw_cmt, "HTML <!-- stays LIT_SPAN");
            if (mrt) {
                int saw_bold = 0, saw_star = 0, saw_fence = 0;
                for (k = 0; k < mrt->rules.len; k++) {
                    const RtxTmRule *r = &mrt->rules.data[k];
                    if (r->op != RTX_TM_LIT_SPAN || !r->a) continue;
                    if (r->alen == 2 && r->a[0] == '*' && r->a[1] == '*')
                        saw_bold = 1;
                    if (r->alen == 1 && r->a[0] == '*') saw_star = 1;
                    if (r->alen == 3 && r->a[0] == '`') saw_fence = 1;
                }
                expect(saw_bold && saw_star && saw_fence,
                       "markdown ** / * / ``` stay LIT_SPAN");
            }
        }
        p = strstr(all.ptr, "<style>\n");
        q = strstr(all.ptr, "</style>");
        expect(p && q, "embeds.html style landmarks");
        if (p && q) {
            size_t so = (size_t)(p - all.ptr);
            size_t eo = (size_t)(q - all.ptr) + 8;
            int span_ok = 0;
            for (k = 0; k < d.runs.len; k++) {
                RtxRun r = d.runs.data[k];
                const char *s = rtx_scope_name(r.style.scope);
                if (s && strstr(s, "embedded.block.css") && r.start == so) {
                    span_ok = (r.start + r.len == eo && r.hint_a == 7 &&
                               r.hint_b == 8);
                }
            }
            expect(span_ok, "<style>…</style> is one RE_SPAN");
            {
                const char *m = strstr(p, "margin");
                const char *h = strstr(p, "#333");
                const char *c = strstr(p, "/*");
                if (m && m < q) {
                    const char *sn = rtx_scope_name(
                        RtxDoc_style_at(&d, (size_t)(m - all.ptr)).scope);
                    expect(sn && strstr(sn, "keyword"),
                           "style body margin is CSS keyword");
                }
                if (h && h < q) {
                    const char *sn = rtx_scope_name(
                        RtxDoc_style_at(&d, (size_t)(h - all.ptr)).scope);
                    expect(sn && (strstr(sn, "numeric") || strstr(sn, "color")),
                           "style body #333 is CSS hex");
                }
                if (c && c < q) {
                    const char *sn = rtx_scope_name(
                        RtxDoc_style_at(&d, (size_t)(c - all.ptr) + 3).scope);
                    expect(sn && strstr(sn, "comment"),
                           "style body /* is CSS comment");
                }
            }
            for (k = 0; k < d.runs.len; k++) {
                RtxRun r = d.runs.data[k];
                const char *s = rtx_scope_name(r.style.scope);
                if (s && strstr(s, "keyword") && r.start > so && r.start < eo) {
                    expect(r.planter == RTX_RUN_INJECT,
                           "CSS keyword is RTX_RUN_INJECT");
                    break;
                }
            }
        }
        p = strstr(all.ptr, "\"<style>\"");
        expect(p != NULL, "embeds.html L7 \"<style>\"");
        if (p) {
            const char *sn = rtx_scope_name(
                RtxDoc_style_at(&d, (size_t)(p - all.ptr) + 1).scope);
            expect(sn && strstr(sn, "string"),
                   "L7 \"<style>\" is a CSS string");
        }
        p = strstr(all.ptr, "with <script> in it");
        expect(p != NULL, "embeds.html L8 comment landmark");
        if (p) {
            const char *sc = strstr(p, "<script>");
            const char *sn = rtx_scope_name(
                RtxDoc_style_at(&d, (size_t)(sc - all.ptr)).scope);
            expect(sn && strstr(sn, "comment"),
                   "L8 <script> in CSS comment stays comment");
        }
        p = strstr(all.ptr, "<script>\n");
        q = strstr(all.ptr, "</script>\n");
        expect(p && q, "embeds.html script landmarks");
        if (p && q) {
            size_t so = (size_t)(p - all.ptr);
            size_t eo = (size_t)(q - all.ptr) + 9;
            int span_ok = 0;
            for (k = 0; k < d.runs.len; k++) {
                RtxRun r = d.runs.data[k];
                const char *s = rtx_scope_name(r.style.scope);
                if (s && strstr(s, "embedded.block.js") && r.start == so) {
                    span_ok = (r.start + r.len == eo && r.hint_a == 8 &&
                               r.hint_b == 9);
                }
            }
            expect(span_ok, "<script>…</script> is one RE_SPAN");
            {
                const char *c = strstr(p, "const msg");
                const char *f = strstr(p, "function go");
                if (c && c < q) {
                    const char *sn = rtx_scope_name(
                        RtxDoc_style_at(&d, (size_t)(c - all.ptr)).scope);
                    expect(sn && strstr(sn, "keyword"),
                           "script body const is JS keyword");
                }
                if (f && f < q) {
                    const char *sn = rtx_scope_name(
                        RtxDoc_style_at(&d, (size_t)(f - all.ptr)).scope);
                    expect(sn && strstr(sn, "keyword"),
                           "script body function is JS keyword");
                }
            }
            for (k = 0; k < d.runs.len; k++) {
                RtxRun r = d.runs.data[k];
                const char *s = rtx_scope_name(r.style.scope);
                if (s && strstr(s, "keyword") && r.start > so && r.start < eo) {
                    expect(r.planter == RTX_RUN_INJECT,
                           "JS keyword is RTX_RUN_INJECT");
                    break;
                }
            }
            {
                const char *split = strstr(p, "</scr\"");
                expect(split && split < q, "L11 split closer landmark");
                if (split && split < q) {
                    const char *sn = rtx_scope_name(
                        RtxDoc_style_at(&d, (size_t)(split - all.ptr)).scope);
                    expect(sn && strstr(sn, "string"),
                           "L11 </scr inside a JS string does not close");
                }
            }
        }
        p = strstr(all.ptr, "<!-- <script>");
        expect(p != NULL, "embeds.html L17 comment landmark");
        if (p) {
            const char *sc = strstr(p, "<script>");
            const char *sn = rtx_scope_name(
                RtxDoc_style_at(&d, (size_t)(sc - all.ptr)).scope);
            expect(sn && strstr(sn, "comment"),
                   "L17 <script> in HTML comment stays comment");
        }
        frame.destroy();
    }

    /* RTX_SEC_MARKUP + grammar sidecar, in a child with RTX_GRAMMARS. */
    markup_parent(argv[0]);

    {
        RtxDoc d = {0} @destroy;
        d.from_buffer("=== code ===\nint x;\nreturn 1;\n") !>;
        expect(rtx_nav_run_bytes() == sizeof(RtxRun), "nav run ABI");
        expect(rtx_nav_fold_bytes() == sizeof(RtxFold), "nav fold ABI");
        /* Spike keywords are paint, not grammar marks (no hint_a). */
        expect(!d.scope_step(1, 0), "spike has no grammar marks");
    }

    {
        RtxDoc d = {0} @destroy;
        RtxScope inv = RTX_SCOPE_NONE;
        RtxStyle st = {0};
        size_t at;
        d.from_buffer("=== code ===\nint x;\n") !>;
        expect(rtx_scope_put(&inv, "invalid.illegal"), "intern invalid");
        at = d.len() ? d.len() - 1 : 0;
        st.scope = inv;
        expect(rtx_doc_add_run(&d, at, 1, st, RTX_RUN_TM), "plant invalid run");
        d.caret = 0;
        d.sel_anchor = 0;
        expect(d.scope_step(1, 1), "step to invalid");
        expect(d.caret == at, "landed on invalid");
    }

    {
        char mpath[512];
        FILE *mf;
        RtxDoc d = {0} @destroy;
        size_t a, b;
        if (system("mkdir -p testdata/generated") != 0) expect(0, "mkdir nav");
        expect(join2(mpath, sizeof mpath, "testdata/generated", "nav.md"),
               "nav.md path");
        mf = fopen(mpath, "w");
        expect(mf != NULL, "nav.md write");
        if (mf) {
            fputs("# Alpha\n\nbody one\n\n# Beta\n\nbody two\n", mf);
            fclose(mf);
        }
        d.from_path(mpath) !>;
        a = (size_t)-1;
        b = (size_t)-1;
        {
            size_t k;
            for (k = 0; k < d.runs.len; k++) {
                const char *s = rtx_scope_name(d.runs.data[k].style.scope);
                if (!s || !strstr(s, "heading")) continue;
                if (a == (size_t)-1) a = d.runs.data[k].start;
                else if (b == (size_t)-1) b = d.runs.data[k].start;
            }
        }
        expect(a != (size_t)-1 && b != (size_t)-1 && b > a, "two md headings");
        d.caret = 0;
        d.sel_anchor = 0;
        expect(d.scope_step(1, 0), "md next mark");
        expect(d.caret >= a, "step reached a heading");
        d.caret = a;
        d.sel_anchor = a;
        expect(d.fold_toggle() == 1, "fold first heading");
        expect(d.fold_n == 1, "one fold");
        expect(d.fold_covers(a + 8), "body covered");
        expect(!d.fold_covers(b), "next heading visible");
        expect(d.fold_toggle() == 2, "unfold");
        expect(d.fold_n == 0, "fold cleared");
        remove(mpath);
    }

    {
        char jpath[512];
        FILE *jf;
        RtxDoc d = {0} @destroy;
        const char *js =
            "{\n  \"a\": {\n    \"b\": 1\n  },\n  \"c\": \"{no}\"\n}\n";
        size_t inner = 0;
        size_t i;
        if (system("mkdir -p testdata/generated") != 0) expect(0, "mkdir json");
        expect(join2(jpath, sizeof jpath, "testdata/generated", "nav.json"),
               "nav.json path");
        jf = fopen(jpath, "w");
        expect(jf != NULL, "nav.json write");
        if (jf) {
            fputs(js, jf);
            fclose(jf);
        }
        d.from_path(jpath) !>;
        for (i = 0; js[i]; i++) {
            if (js[i] == '{' && i > 0) {
                inner = i;
                break;
            }
        }
        d.caret = inner;
        d.sel_anchor = inner;
        {
            size_t close = 0;
            size_t plo = 0;
            size_t phi = 0;
            for (i = inner + 1; js[i]; i++) {
                if (js[i] == '}') {
                    close = i;
                    break;
                }
            }
            expect(close && rtx_nav_pair_ends(&d.tree, d.runs.data, d.runs.len, d.caret,
                                             d.edit_gen, d.runs.len, &plo, &phi) &&
                   plo == inner && phi == close, "pair is the inner object");
            expect(d.fold_toggle() == 1, "fold json object");
            expect(d.fold_n == 1, "json one fold");
            expect(d.fold_covers(inner + 8), "json body covered");
            expect(!d.fold_covers(0), "json outer open visible");
            d.caret = close;
            d.sel_anchor = close;
            expect(d.fold_toggle() == 2, "closer unfolds");
            expect(d.fold_n == 0, "closer cleared the fold");
            d.caret = inner;
            d.sel_anchor = inner;
            expect(d.fold_toggle() == 1, "fold json again");
            expect(d.fold_toggle() == 2, "json unfold");
        }
        remove(jpath);
    }

    {
        char spath[512];
        FILE *sf;
        RtxDoc d = {0} @destroy;
        const char *only = "\"foo { bar }\"\n";
        size_t i;
        expect(join2(spath, sizeof spath, "testdata/generated", "nav_str.json"),
               "nav_str.json path");
        sf = fopen(spath, "w");
        expect(sf != NULL, "nav_str.json write");
        if (sf) {
            fputs(only, sf);
            fclose(sf);
        }
        d.from_path(spath) !>;
        d.caret = 0;
        d.sel_anchor = 0;
        for (i = 0; only[i]; i++) {
            if (only[i] == '{') {
                d.caret = i;
                d.sel_anchor = i;
                break;
            }
        }
        expect(d.fold_toggle() == 0, "brace in string is not a fold");
        {
            size_t plo = 0, phi = 0;
            expect(!rtx_nav_pair_ends(&d.tree, d.runs.data, d.runs.len, d.caret,
                                     d.edit_gen, d.runs.len, &plo, &phi),
                   "string brace is not a pair");
        }
        remove(spath);
    }

    {
        char ppath[512];
        FILE *pf;
        RtxDoc d = {0} @destroy;
        const char *one = "{\"a\":1}\n";
        size_t close = 0;
        size_t i;
        expect(join2(ppath, sizeof ppath, "testdata/generated", "nav_pair.json"),
               "nav_pair.json path");
        pf = fopen(ppath, "w");
        expect(pf != NULL, "nav_pair.json write");
        if (pf) {
            fputs(one, pf);
            fclose(pf);
        }
        d.from_path(ppath) !>;
        for (i = 0; one[i]; i++) {
            if (one[i] == '}') {
                close = i;
                break;
            }
        }
        d.caret = 0;
        d.sel_anchor = 0;
        expect(d.fold_toggle() == 0, "same-line brace is not a fold");
        {
            size_t plo = 0, phi = 0;
            expect(rtx_nav_pair_ends(&d.tree, d.runs.data, d.runs.len, d.caret,
                                    d.edit_gen, d.runs.len, &plo, &phi) &&
                   plo == 0 && phi == close, "same-line pair ends");
        }
        remove(ppath);
    }

    {
        size_t from = 0, to = 0;
        size_t page = (size_t)RTX_HL_WIN_MAX;
        expect(rtx_nav_brace_pages(0, 100, &from, &to) && from == 0 && to == 100,
               "short file is one clipped page");
        expect(rtx_nav_brace_pages(page - 1, page * 3, &from, &to) &&
                   from == 0 && to == page * 2,
               "end of page 0 includes next page");
        expect(rtx_nav_brace_pages(page, page * 3, &from, &to) &&
                   from == 0 && to == page * 3,
               "start of page 1 includes prev and next");
        expect(!rtx_nav_brace_pages(0, 0, &from, &to), "empty doc has no window");
    }

    {
        char ppath[512];
        FILE *pf;
        RtxDoc d = {0} @destroy;
        size_t page = (size_t)RTX_HL_WIN_MAX;
        size_t open = page - 2;
        size_t close = open + 4;
        size_t left;
        char chunk[4096];
        size_t plo = 0, phi = 0;
        expect(join2(ppath, sizeof ppath, "testdata/generated", "nav_page.txt"),
               "nav_page path");
        pf = fopen(ppath, "w");
        expect(pf != NULL, "nav_page write");
        {
            char[:] c = cc_slice_from_buffer(chunk, sizeof chunk);
            c.fill('x') !>;
        }
        left = open;
        while (pf && left) {
            size_t n = left > sizeof chunk ? sizeof chunk : left;
            if (fwrite(chunk, 1, n, pf) != n) {
                expect(0, "nav_page pad");
                break;
            }
            left -= n;
        }
        if (pf) {
            fputs("{\n1\n}", pf);
            fclose(pf);
        }
        d.from_path(ppath) !>;
        d.ensure_hl(rtx_hl_win(0, page)) !>;
        d.ensure_hl(rtx_hl_win(page, page)) !>;
        d.caret = open;
        d.sel_anchor = open;
        expect(rtx_nav_pair_ends(&d.tree, d.runs.data, d.runs.len, d.caret,
                                d.edit_gen, d.runs.len, &plo, &phi) &&
               plo == open && phi == close, "pair crosses analysis page");
        expect(d.fold_toggle() == 1, "fold across analysis page");
        expect(d.fold_covers(open + 2), "page-fold body covered");
        expect(d.fold_toggle() == 2, "unfold page pair");
        remove(ppath);
    }

    /* ATX heading prefix: opener is hint_a only; title is inner-able. */
    {
        RtxDoc d = {0} @destroy;
        CCArena frame = cc_arena_heap(kilobytes(8));
        char[:] all;
        const char *p, *q;
        size_t h1, h2, trail, empty, k;
        expect(frame.base != NULL, "headings.md frame");
        d.from_path("testdata/rich/md/headings.md") !>;
        expect(d.section_at(0) == RTX_SEC_MARKUP, "headings.md is MARKUP");
        all = d.scratch_span(0, d.len(), frame) !>;
        p = strstr(all.ptr, "# H1 heading");
        expect(p != NULL, "headings.md L1");
        h1 = (size_t)(p - all.ptr);
        expect(RtxDoc_prefix_at(&d, h1, NULL, NULL), "H1 opener is prefix");
        expect(RtxDoc_hint_at(&d, h1, NULL, NULL), "H1 # is a hint");
        expect(!RtxDoc_hint_at(&d, h1 + 2, NULL, NULL), "H1 title is content");
        expect(d.style_at(h1 + 2).bold &&
                   rtx_scope_is_heading(d.style_at(h1 + 2).scope),
               "H1 title stays heading");
        {
            int ok = 0;
            for (k = 0; k < d.runs.len; k++) {
                const RtxRun *r = &d.runs.data[k];
                if (r->start != h1) continue;
                ok = rtx_run_arity(r) == RTX_ARITY_PREFIX && r->hint_a == 2 &&
                     r->hint_b == 0;
                break;
            }
            expect(ok, "H1 prefix hint_a=2 hint_b=0");
        }
        p = strstr(all.ptr, "## H2 heading");
        expect(p != NULL, "headings.md L2");
        h2 = (size_t)(p - all.ptr);
        expect(RtxDoc_prefix_at(&d, h2, NULL, NULL), "H2 opener is prefix");
        p = strstr(all.ptr, "## Trailing hashes ##");
        expect(p != NULL, "headings.md L10");
        trail = (size_t)(p - all.ptr);
        q = p + 18; /* ` ##` after `## Trailing hashes` */
        expect(RtxDoc_prefix_at(&d, trail, NULL, NULL),
               "trailing line leading prefix");
        expect(RtxDoc_prefix_at(&d, (size_t)(q - all.ptr) + 1, NULL, NULL),
               "trailing hashes are a second prefix");
        expect(!RtxDoc_prefix_at(&d, trail + 3, NULL, NULL),
               "trailing-line title is not prefix");
        p = strstr(all.ptr, "## Heading with `code` and **bold**");
        expect(p != NULL, "headings.md L29");
        if (p) {
            q = strstr(p, "`code`");
            expect(q != NULL && d.style_at((size_t)(q - all.ptr) + 1).mono,
                   "code inside heading is mono");
            q = strstr(p, "**bold**");
            expect(q != NULL && d.style_at((size_t)(q - all.ptr) + 2).bold,
                   "bold inside heading");
        }
        p = strstr(all.ptr, "\n#\n");
        expect(p != NULL, "headings.md empty #");
        empty = (size_t)(p - all.ptr) + 1;
        expect(RtxDoc_prefix_at(&d, empty, NULL, NULL), "empty # is prefix");
        d.caret = trail;
        d.sel_anchor = trail;
        expect(d.fold_toggle() == 1, "fold trailing-hash heading");
        q = strstr(all.ptr, "Body under trailing hashes");
        expect(q != NULL && d.fold_covers((size_t)(q - all.ptr)),
               "body under trailing hashes is in the fold");
        q = strstr(all.ptr, "## Back to back A");
        expect(q != NULL && !d.fold_covers((size_t)(q - all.ptr)),
               "next ATX heading is not in the fold");
        expect(d.fold_toggle() == 2, "unfold trailing-hash heading");
        RtxDoc_prefix_apply(&d, h2) !>;
        all = d.scratch_span(0, d.len(), frame) !>;
        expect(strstr(all.ptr, "# H2 heading") != NULL, "demote ## → #");
        expect(strstr(all.ptr, "## H2 heading") == NULL, "old ## H2 gone");
        RtxDoc_prefix_apply(&d, h1) !>;
        all = d.scratch_span(0, d.len(), frame) !>;
        expect(strncmp(all.ptr, "H1 heading", 10) == 0, "unwrap H1 drops # ");
        if (frame.base) frame.destroy();
    }

    /* Heading apply: insert / change / strip, one replace. */
    {
        RtxDoc d = {0} @destroy;
        CCArena frame = cc_arena_heap(kilobytes(8));
        char[:] all;
        const char *p;
        size_t body, h1;
        expect(frame.base != NULL, "heading apply frame");
        d.from_path("testdata/rich/md/headings.md") !>;
        all = d.scratch_span(0, d.len(), frame) !>;
        p = strstr(all.ptr, "Body under H6.");
        expect(p != NULL, "heading apply: body line");
        body = (size_t)(p - all.ptr);
        expect(RtxDoc_apply_at(&d, body, NULL, NULL, NULL) == 0,
               "heading apply: body is not a heading");
        d.caret = body + 5;
        d.sel_anchor = d.caret;
        RtxDoc_apply_set(&d, d.caret, "heading", 1) !>;
        d.reparse_edit(d.last_off, d.last_markup) !>;
        all = d.scratch_span(0, d.len(), frame) !>;
        expect(strstr(all.ptr, "# Body under H6.") != NULL,
               "heading apply: insert #  on a body line");
        expect(RtxDoc_apply_at(&d, body, NULL, NULL, NULL) == 1,
               "heading apply: now H1");
        expect(d.caret == body + 7, "heading apply: caret stays on the title");
        RtxDoc_apply_set(&d, body, "heading", 3) !>;
        d.reparse_edit(d.last_off, d.last_markup) !>;
        all = d.scratch_span(0, d.len(), frame) !>;
        expect(strstr(all.ptr, "### Body under H6.") != NULL,
               "heading apply: change H1 → H3");
        expect(RtxDoc_apply_at(&d, body, NULL, NULL, NULL) == 3,
               "heading apply: now H3");
        RtxDoc_apply_set(&d, body, "heading", 0) !>;
        d.reparse_edit(d.last_off, d.last_markup) !>;
        all = d.scratch_span(0, d.len(), frame) !>;
        expect(strstr(all.ptr, "# Body under H6.") == NULL,
               "heading apply: strip drops the prefix");
        expect(strstr(all.ptr, "Body under H6.") != NULL,
               "heading apply: title remains");
        expect(RtxDoc_apply_at(&d, body, NULL, NULL, NULL) == 0,
               "heading apply: stripped");
        p = strstr(all.ptr, "# H1 heading");
        expect(p != NULL, "heading apply: L1 after body edits");
        h1 = (size_t)(p - all.ptr);
        d.caret = h1 + 2;
        d.sel_anchor = d.caret;
        RtxDoc_apply_set(&d, d.caret, "heading", 2) !>;
        d.reparse_edit(d.last_off, d.last_markup) !>;
        expect(RtxDoc_apply_at(&d, h1, NULL, NULL, NULL) == 2,
               "heading apply: L1 is H2");
        expect(d.caret == h1 + 3, "heading apply: title caret tracks the insert");
        d.undo() !>;
        d.reparse_edit(d.last_off, d.last_markup) !>;
        expect(RtxDoc_apply_at(&d, h1, NULL, NULL, NULL) == 1,
               "heading apply: one undo restores H1");
        all = d.scratch_span(0, d.len(), frame) !>;
        p = strstr(all.ptr, "## Trailing hashes ##");
        expect(p != NULL, "heading apply: trailing line");
        RtxDoc_apply_set(&d, (size_t)(p - all.ptr) + 10, "heading", 1) !>;
        d.reparse_edit(d.last_off, d.last_markup) !>;
        all = d.scratch_span(0, d.len(), frame) !>;
        expect(strstr(all.ptr, "# Trailing hashes ##") != NULL,
               "heading apply: changes the leading prefix, not the trail");
        if (frame.base) frame.destroy();
    }
    {
        RtxDoc d = {0} @destroy;
        CCArena frame = cc_arena_heap(kilobytes(8));
        char[:] all;
        const char *p;
        size_t inc;
        expect(frame.base != NULL, "heading apply fence frame");
        d.from_path("testdata/rich/md/mixed_doc.md") !>;
        all = d.scratch_span(0, d.len(), frame) !>;
        p = strstr(all.ptr, "#include");
        expect(p != NULL, "heading apply: #include");
        inc = (size_t)(p - all.ptr);
        expect(d.section_at(inc) == RTX_SEC_MARKUP,
               "heading apply: fence body is still MARKUP");
        RtxDoc_apply_set(&d, inc, "heading", 1) !>;
        all = d.scratch_span(0, d.len(), frame) !>;
        expect(strstr(all.ptr, "##include") == NULL,
               "heading apply: refuses #include");
        if (frame.base) frame.destroy();
    }

    /* Quote / list prefixes: plant + apply from sidecar insert/max. */
    {
        RtxDoc d = {0} @destroy;
        CCArena frame = cc_arena_heap(kilobytes(8));
        char[:] all;
        const char *p, *nm;
        size_t q0, body;
        expect(frame.base != NULL, "quote apply frame");
        d.from_path("testdata/rich/md/blocks.md") !>;
        all = d.scratch_span(0, d.len(), frame) !>;
        p = strstr(all.ptr, "> single quote line");
        expect(p != NULL, "quote: L3");
        q0 = (size_t)(p - all.ptr);
        expect(RtxDoc_prefix_at(&d, q0, NULL, NULL), "quote: opener is prefix");
        expect(RtxDoc_hint_at(&d, q0, NULL, NULL), "quote: > is a hint");
        expect(!RtxDoc_hint_at(&d, q0 + 2, NULL, NULL),
               "quote: title is content");
        nm = NULL;
        expect(RtxDoc_apply_at(&d, q0, NULL, NULL, &nm) >= 1 && nm &&
                   strcmp(nm, "quote") == 0,
               "quote: apply name from grammar");
        expect(strstr(rtx_scope_name(d.style_at(q0 + 2).scope), "quote") != NULL,
               "quote: title keeps quote scope");
        p = strstr(all.ptr, "\n---\n");
        expect(p != NULL, "quote: thematic ---");
        expect(!RtxDoc_prefix_at(&d, (size_t)(p - all.ptr) + 1, NULL, NULL),
               "thematic --- is not a prefix");
        p = strstr(all.ptr, "\n***\n");
        expect(p != NULL, "quote: thematic ***");
        expect(!RtxDoc_prefix_at(&d, (size_t)(p - all.ptr) + 1, NULL, NULL),
               "thematic *** is not a prefix");
        p = strstr(all.ptr, "Hard break with two spaces");
        expect(p != NULL, "quote: body for cycle");
        body = (size_t)(p - all.ptr);
        d.caret = body;
        d.sel_anchor = body;
        RtxDoc_apply_cycle(&d, d.caret) !>;
        d.reparse_edit(d.last_off, d.last_markup) !>;
        nm = NULL;
        expect(RtxDoc_apply_at(&d, body, NULL, NULL, &nm) == 1 && nm &&
                   strcmp(nm, "heading") == 0,
               "cycle on a bare line inserts the first grammar apply");
        RtxDoc_prefix_apply(&d, q0) !>;
        all = d.scratch_span(0, d.len(), frame) !>;
        expect(strstr(all.ptr, "> single quote line") == NULL,
               "quote: unwrap drops the opener");
        expect(strstr(all.ptr, "single quote line") != NULL,
               "quote: title remains");
        if (frame.base) frame.destroy();
    }
    {
        RtxDoc d = {0} @destroy;
        CCArena frame = cc_arena_heap(kilobytes(8));
        char[:] all;
        const char *p, *nm;
        size_t qoff, loff;
        expect(frame.base != NULL, "prefix nest frame");
        d.from_path("testdata/rich/md/blocks.md") !>;
        all = d.scratch_span(0, d.len(), frame) !>;
        p = strstr(all.ptr, "> - one");
        expect(p != NULL, "quote⊃list: L11");
        qoff = (size_t)(p - all.ptr);
        loff = qoff + 2;
        expect(RtxDoc_prefix_at(&d, qoff, NULL, NULL),
               "quote⊃list: > is prefix");
        expect(RtxDoc_prefix_at(&d, loff, NULL, NULL),
               "quote⊃list: -  is prefix");
        expect(RtxDoc_hint_at(&d, loff, NULL, NULL),
               "quote⊃list: list marker is a hint");
        expect(!RtxDoc_hint_at(&d, loff + 2, NULL, NULL),
               "quote⊃list: item text is content");
        nm = NULL;
        expect(RtxDoc_apply_at(&d, loff, NULL, NULL, &nm) >= 1 && nm &&
                   strcmp(nm, "quote") == 0,
               "quote⊃list: leading apply is quote");
        p = strstr(all.ptr, "> - two");
        expect(p != NULL && RtxDoc_prefix_at(&d, (size_t)(p - all.ptr) + 2,
                                            NULL, NULL),
               "quote⊃list: second item plants");
        RtxDoc_prefix_apply(&d, loff) !>;
        all = d.scratch_span(0, d.len(), frame) !>;
        expect(strstr(all.ptr, "> - one") == NULL,
               "quote⊃list: unwrap list drops - ");
        expect(strstr(all.ptr, "> one") != NULL,
               "quote⊃list: quote prefix remains");
        if (frame.base) frame.destroy();
    }
    {
        RtxDoc d = {0} @destroy;
        CCArena frame = cc_arena_heap(kilobytes(8));
        char[:] all;
        const char *p, *nm;
        size_t dash, nest, star, ord;
        expect(frame.base != NULL, "list apply frame");
        d.from_path("testdata/rich/md/lists_tasks.md") !>;
        all = d.scratch_span(0, d.len(), frame) !>;
        p = strstr(all.ptr, "- dash one");
        expect(p != NULL, "list: dash");
        dash = (size_t)(p - all.ptr);
        expect(RtxDoc_prefix_at(&d, dash, NULL, NULL), "list: -  is prefix");
        expect(RtxDoc_hint_at(&d, dash, NULL, NULL), "list: marker is a hint");
        expect(!RtxDoc_hint_at(&d, dash + 2, NULL, NULL),
               "list: item text is content");
        nm = NULL;
        expect(RtxDoc_apply_at(&d, dash, NULL, NULL, &nm) == 1 && nm &&
                   strcmp(nm, "list") == 0,
               "list: apply name from grammar");
        p = strstr(all.ptr, "  - nested two spaces");
        expect(p != NULL, "list: nested");
        nest = (size_t)(p - all.ptr);
        expect(!RtxDoc_hint_at(&d, nest, NULL, NULL),
               "list: indent stays visible");
        expect(RtxDoc_prefix_at(&d, nest + 2, NULL, NULL),
               "list: nested marker is prefix");
        p = strstr(all.ptr, "* star one");
        expect(p != NULL, "list: star");
        star = (size_t)(p - all.ptr);
        expect(RtxDoc_prefix_at(&d, star, NULL, NULL), "list: *  plants");
        p = strstr(all.ptr, "1. first");
        expect(p != NULL, "list: ordered");
        ord = (size_t)(p - all.ptr);
        expect(RtxDoc_prefix_at(&d, ord, NULL, NULL), "list: 1. plants");
        p = strstr(all.ptr, "2) paren two");
        expect(p != NULL, "list: paren");
        expect(RtxDoc_prefix_at(&d, (size_t)(p - all.ptr), NULL, NULL),
               "list: 2) plants");
        p = strstr(all.ptr, "task with **bold** text and `code`");
        expect(p != NULL, "list: inners line");
        RtxDoc_apply_set(&d, star, "list", 0) !>;
        all = d.scratch_span(0, d.len(), frame) !>;
        expect(strstr(all.ptr, "* star one") == NULL,
               "list: apply 0 unwraps *  (does not rewrite to - )");
        expect(strstr(all.ptr, "star one") != NULL, "list: star text remains");
        RtxDoc_prefix_apply(&d, dash) !>;
        all = d.scratch_span(0, d.len(), frame) !>;
        expect(strstr(all.ptr, "- dash one") == NULL, "list: unwrap drops - ");
        expect(strstr(all.ptr, "dash one") != NULL, "list: item text remains");
        if (frame.base) frame.destroy();
        (void)ord;
        (void)nest;
    }
    {
        RtxDoc d = {0} @destroy;
        CCArena frame = cc_arena_heap(kilobytes(8));
        char[:] all;
        const char *p;
        size_t box, k;
        int planted = 0, not_ref = 1, not_link = 1, not_bare = 1;
        expect(frame.base != NULL, "toggle frame");
        d.from_path("testdata/rich/md/lists_tasks.md") !>;
        all = d.scratch_span(0, d.len(), frame) !>;
        p = strstr(all.ptr, "- [ ] open task");
        expect(p != NULL, "toggle: open");
        box = (size_t)(p - all.ptr) + 2;
        for (k = 0; k < d.runs.len; k++) {
            const RtxRun *r = &d.runs.data[k];
            if (r->start != box) continue;
            planted = rtx_run_arity(r) == RTX_ARITY_PAIR && r->hint_a == 3 &&
                      r->hint_b == 0 && r->len == 3 && r->rule != 0;
        }
        expect(planted, "toggle: [ ] is a 3-byte mark");
        expect(RtxDoc_hint_at(&d, box, NULL, NULL), "toggle: box is a hint");
        expect(RtxDoc_mark_apply(&d, box) &&
                   strcmp(RtxDoc_mark_apply(&d, box), "toggle") == 0,
               "toggle: mark_apply names the box");
        expect(!RtxDoc_mark_apply(&d, box + 10),
               "toggle: content has no mark apply");
        d.caret = box;
        d.sel_anchor = box;
        RtxDoc_apply_named(&d, "toggle") !>;
        d.reparse_edit(d.last_off, d.last_markup) !>;
        all = d.scratch_span(0, d.len(), frame) !>;
        expect(strstr(all.ptr, "- [x] open task") != NULL,
               "toggle: [ ] → [x]");
        p = strstr(all.ptr, "- [x] open task");
        expect(p != NULL, "toggle: flipped open");
        /* Space / click path: mark_apply name → apply_named. */
        d.caret = (size_t)(p - all.ptr) + 2;
        d.sel_anchor = d.caret;
        {
            const char *nm = RtxDoc_mark_apply(&d, d.caret);
            expect(nm && strcmp(nm, "toggle") == 0, "toggle: mark_apply on [x]");
            RtxDoc_apply_named(&d, nm) !>;
        }
        d.reparse_edit(d.last_off, d.last_markup) !>;
        all = d.scratch_span(0, d.len(), frame) !>;
        expect(strstr(all.ptr, "- [ ] open task") != NULL,
               "toggle: activate flips [x] → [ ]");
        p = strstr(all.ptr, "- [ ] open task");
        expect(p != NULL, "toggle: open again");
        d.caret = (size_t)(p - all.ptr) + 10;
        d.sel_anchor = d.caret;
        RtxDoc_apply_named(&d, "toggle") !>;
        d.reparse_edit(d.last_off, d.last_markup) !>;
        all = d.scratch_span(0, d.len(), frame) !>;
        expect(strstr(all.ptr, "- [x] open task") != NULL,
               "toggle: line caret still finds the box");
        p = strstr(all.ptr, "- [x] done task\n");
        expect(p != NULL, "toggle: done");
        d.caret = (size_t)(p - all.ptr) + 2;
        d.sel_anchor = d.caret;
        RtxDoc_apply_named(&d, "toggle") !>;
        d.reparse_edit(d.last_off, d.last_markup) !>;
        all = d.scratch_span(0, d.len(), frame) !>;
        expect(strstr(all.ptr, "- [ ] done task") != NULL,
               "toggle: [x] → [ ]");
        p = strstr(all.ptr, "- [X] done task uppercase");
        expect(p != NULL, "toggle: uppercase");
        d.caret = (size_t)(p - all.ptr) + 2;
        d.sel_anchor = d.caret;
        RtxDoc_apply_named(&d, "toggle") !>;
        d.reparse_edit(d.last_off, d.last_markup) !>;
        all = d.scratch_span(0, d.len(), frame) !>;
        expect(strstr(all.ptr, "- [ ] done task uppercase") != NULL,
               "toggle: [X] → [ ]");
        p = strstr(all.ptr, "- [ ] task with **bold**");
        expect(p != NULL, "toggle: inners");
        {
            const char *b = strstr(p, "**bold**");
            expect(b != NULL && d.style_at((size_t)(b - all.ptr) + 2).bold,
                   "toggle: bold after the box");
        }
        p = strstr(all.ptr, "- [ref] not a task");
        expect(p != NULL, "toggle: ref");
        box = (size_t)(p - all.ptr) + 2;
        for (k = 0; k < d.runs.len; k++) {
            const RtxRun *r = &d.runs.data[k];
            if (r->start != box || !r->hint_a) continue;
            if (r->len == 3 && r->hint_a == 3) not_ref = 0;
        }
        expect(not_ref, "toggle: [ref] is not a task box");
        p = strstr(all.ptr, "- [link](https://example.com)");
        expect(p != NULL, "toggle: link");
        box = (size_t)(p - all.ptr) + 2;
        expect(RtxDoc_path_at(&d, box + 1, NULL, NULL, NULL, NULL),
               "toggle: [link]( stays a path");
        for (k = 0; k < d.runs.len; k++) {
            const RtxRun *r = &d.runs.data[k];
            if (r->start == box && r->len == 3 && r->hint_a == 3) not_link = 0;
        }
        expect(not_link, "toggle: link is not a task box");
        p = strstr(all.ptr, "- [x]no space");
        expect(p != NULL, "toggle: bare");
        box = (size_t)(p - all.ptr) + 2;
        for (k = 0; k < d.runs.len; k++) {
            const RtxRun *r = &d.runs.data[k];
            if (r->start == box && r->len == 3 && r->hint_a == 3) not_bare = 0;
        }
        expect(not_bare, "toggle: [x]no is not a task");
        if (frame.base) frame.destroy();
    }

    /* Named apply: pair wrap / unwrap, prefix cycle-this-name, path unwrap. */
    {
        RtxDoc d = {0} @destroy;
        CCArena frame = cc_arena_heap(kilobytes(8));
        char[:] all;
        const char *p;
        size_t body;
        expect(frame.base != NULL, "named apply frame");
        d.from_path("testdata/rich/md/headings.md") !>;
        all = d.scratch_span(0, d.len(), frame) !>;
        p = strstr(all.ptr, "Body under H6.");
        expect(p != NULL, "named apply: body line");
        body = (size_t)(p - all.ptr);
        d.caret = body;
        d.sel_anchor = body + 4;
        RtxDoc_apply_named(&d, "bold") !>;
        d.reparse_edit(d.last_off, d.last_markup) !>;
        all = d.scratch_span(0, d.len(), frame) !>;
        expect(strstr(all.ptr, "**Body** under H6.") != NULL,
               "named apply: wrap selection as bold");
        expect(d.style_at(body + 2).bold, "named apply: planted bold");
        RtxDoc_apply_named(&d, "bold") !>;
        d.reparse_edit(d.last_off, d.last_markup) !>;
        all = d.scratch_span(0, d.len(), frame) !>;
        expect(strstr(all.ptr, "**Body** under H6.") == NULL,
               "named apply: unwrap bold keeps interior");
        expect(strstr(all.ptr, "Body under H6.") != NULL,
               "named apply: title remains after unwrap");
        d.caret = body + 5;
        d.sel_anchor = d.caret;
        RtxDoc_apply_named(&d, "italic") !>;
        d.reparse_edit(d.last_off, d.last_markup) !>;
        all = d.scratch_span(0, d.len(), frame) !>;
        expect(strstr(all.ptr, "*under*") != NULL,
               "named apply: empty sel wraps the word");
        d.caret = body + 4;
        d.sel_anchor = d.caret;
        RtxDoc_apply_named(&d, "code") !>;
        d.reparse_edit(d.last_off, d.last_markup) !>;
        all = d.scratch_span(0, d.len(), frame) !>;
        expect(strstr(all.ptr, "Body`` *under*") != NULL,
               "named apply: empty non-word inserts a+b");
        if (frame.base) frame.destroy();
    }
    {
        /* Inner `#bold` is a different rule tag than the root include.
         * Toggle-off looks up the tag and compares `cctext.apply`. */
        RtxDoc d = {0} @destroy;
        CCArena frame = cc_arena_heap(kilobytes(8));
        char[:] all;
        const char *p;
        size_t at, k;
        int planted = 0;
        unsigned short tag = 0;
        expect(frame.base != NULL, "rule id frame");
        d.from_path("testdata/rich/md/headings.md") !>;
        all = d.scratch_span(0, d.len(), frame) !>;
        p = strstr(all.ptr, "**bold**");
        expect(p != NULL, "rule id: inner bold");
        at = (size_t)(p - all.ptr) + 2;
        for (k = 0; k < d.runs.len; k++) {
            const RtxRun *r = &d.runs.data[k];
            if (r->start > at || r->start + r->len <= at) continue;
            if (rtx_run_arity(r) != RTX_ARITY_PAIR || !r->hint_a) continue;
            planted = r->planter == RTX_RUN_TM && r->rule != 0 && r->style.bold;
            tag = r->rule;
        }
        expect(planted, "rule id: inner bold run stores a tag");
        expect((tag & (unsigned short)RTX_TM_INNER) != 0,
               "rule id: inner #bold is an inner tag");
        d.caret = at;
        d.sel_anchor = at;
        RtxDoc_apply_named(&d, "bold") !>;
        d.reparse_edit(d.last_off, d.last_markup) !>;
        all = d.scratch_span(0, d.len(), frame) !>;
        {
            int still = 0;
            size_t i;
            for (i = 0; i + 8 <= all.len; i++) {
                if (memcmp(all.ptr + i, "**bold**", 8) == 0) still = 1;
            }
            expect(!still, "rule id: toggle-off inner #bold clone");
        }
        {
            int kept = 0;
            size_t i;
            for (i = 0; i + 8 <= all.len; i++) {
                if (memcmp(all.ptr + i, "and bold", 8) == 0) kept = 1;
            }
            expect(kept, "rule id: inner unwrap keeps the word");
        }
        if (frame.base) frame.destroy();
    }
    {
        RtxDoc d = {0} @destroy;
        CCArena frame = cc_arena_heap(kilobytes(8));
        char[:] all;
        const char *p;
        size_t inc;
        expect(frame.base != NULL, "named apply fence frame");
        d.from_path("testdata/rich/md/mixed_doc.md") !>;
        all = d.scratch_span(0, d.len(), frame) !>;
        p = strstr(all.ptr, "#include");
        expect(p != NULL, "named apply: #include");
        inc = (size_t)(p - all.ptr);
        d.caret = inc;
        d.sel_anchor = inc + 8;
        RtxDoc_apply_named(&d, "bold") !>;
        all = d.scratch_span(0, d.len(), frame) !>;
        expect(strstr(all.ptr, "**#include**") == NULL,
               "named apply: refuses fence body");
        if (frame.base) frame.destroy();
    }
    {
        RtxDoc d = {0} @destroy;
        CCArena frame = cc_arena_heap(kilobytes(8));
        char[:] all;
        const char *p, *nm;
        size_t body;
        expect(frame.base != NULL, "named apply prefix frame");
        d.from_path("testdata/rich/md/headings.md") !>;
        all = d.scratch_span(0, d.len(), frame) !>;
        p = strstr(all.ptr, "Body under H6.");
        expect(p != NULL, "named apply prefix: body");
        body = (size_t)(p - all.ptr);
        d.caret = body;
        d.sel_anchor = body;
        RtxDoc_apply_named(&d, "heading") !>;
        d.reparse_edit(d.last_off, d.last_markup) !>;
        nm = NULL;
        expect(RtxDoc_apply_at(&d, body, NULL, NULL, &nm) == 1 && nm &&
                   strcmp(nm, "heading") == 0,
               "named apply: heading button inserts H1");
        RtxDoc_apply_named(&d, "heading") !>;
        d.reparse_edit(d.last_off, d.last_markup) !>;
        expect(RtxDoc_apply_at(&d, body, NULL, NULL, &nm) == 2,
               "named apply: heading button cycles H1 → H2");
        if (frame.base) frame.destroy();
    }
    {
        RtxDoc d = {0} @destroy;
        CCArena frame = cc_arena_heap(kilobytes(8));
        char[:] all;
        const char *p;
        size_t at;
        expect(frame.base != NULL, "named apply path frame");
        d.from_path("testdata/rich/md/links_images.md") !>;
        all = d.scratch_span(0, d.len(), frame) !>;
        p = strstr(all.ptr, "[text](https://example.com)");
        expect(p != NULL, "named apply: inline link");
        at = (size_t)(p - all.ptr) + 2;
        d.caret = at;
        d.sel_anchor = at;
        RtxDoc_apply_named(&d, "link") !>;
        d.reparse_edit(d.last_off, d.last_markup) !>;
        all = d.scratch_span(0, d.len(), frame) !>;
        expect(strstr(all.ptr, "Inline text link.") != NULL,
               "named apply: link unwrap keeps the label");
        p = strstr(all.ptr, "<https://example.com/auto>");
        expect(p != NULL, "named apply: autolink still there");
        at = (size_t)(p - all.ptr) + 2;
        d.caret = at;
        d.sel_anchor = at;
        RtxDoc_apply_named(&d, "autolink") !>;
        d.reparse_edit(d.last_off, d.last_markup) !>;
        all = d.scratch_span(0, d.len(), frame) !>;
        expect(strstr(all.ptr, "<https://example.com/auto>") == NULL,
               "named apply: autolink unwrap drops wrap bytes");
        expect(strstr(all.ptr, "https://example.com/auto") != NULL,
               "named apply: autolink interior remains");
        p = strstr(all.ptr, "https://example.com/auto");
        expect(p != NULL, "named apply: autolink word");
        at = (size_t)(p - all.ptr);
        d.caret = at;
        d.sel_anchor = at;
        RtxDoc_apply_named(&d, "autolink") !>;
        d.reparse_edit(d.last_off, d.last_markup) !>;
        all = d.scratch_span(0, d.len(), frame) !>;
        expect(strstr(all.ptr, "<https://example.com/auto>") != NULL,
               "named apply: autolink wrap uses insert bookends");
        if (frame.base) frame.destroy();
    }
    {
        /* Path plant: two runs. Label closer is dest opener, not hint_b. */
        RtxDoc d = {0} @destroy;
        CCArena frame = cc_arena_heap(kilobytes(8));
        char[:] all;
        const char *p;
        size_t ls;
        const RtxRun *lab, *dest;
        expect(frame.base != NULL, "path plant frame");
        d.from_path("testdata/rich/md/links_images.md") !>;
        all = d.scratch_span(0, d.len(), frame) !>;
        p = strstr(all.ptr, "[text](https://example.com)");
        expect(p != NULL, "path plant: inline link");
        ls = (size_t)(p - all.ptr);
        lab = smoke_path_run(&d, ls, 0);
        dest = smoke_path_run(&d, ls + 5, 1);
        expect(lab && lab->hint_a == 1 && lab->hint_b == 0 && lab->len == 5,
               "path plant: label [text  hint_a=1 hint_b=0");
        expect(dest && dest->hint_a == 2 && dest->hint_b == 1 && dest->len == 22,
               "path plant: dest ](url) hint_a=2 hint_b=1");
        expect(lab && dest && lab->start + lab->len == dest->start,
               "path plant: dest starts where label ends");
        p = strstr(all.ptr, "[text]()");
        expect(p != NULL, "path plant: empty dest");
        ls = (size_t)(p - all.ptr);
        lab = smoke_path_run(&d, ls, 0);
        dest = smoke_path_run(&d, ls + 5, 1);
        expect(lab && dest && dest->hint_a == 2 && dest->hint_b == 1 &&
                   dest->len == 3,
               "path plant: empty dest is ]()");
        p = strstr(all.ptr, "[](https://example.com)");
        expect(p != NULL, "path plant: empty label");
        ls = (size_t)(p - all.ptr);
        lab = smoke_path_run(&d, ls, 0);
        dest = smoke_path_run(&d, ls + 1, 1);
        expect(lab && lab->hint_a == 1 && lab->len == 1 && dest,
               "path plant: empty label is [");
        p = strstr(all.ptr, "[text](https://example.com \"Example title\")");
        expect(p != NULL, "path plant: titled dest");
        ls = (size_t)(p - all.ptr);
        dest = smoke_path_run(&d, ls + 5, 1);
        expect(dest && dest->len > 22, "path plant: title lives on dest");
        if (frame.base) frame.destroy();
    }
    {
        RtxDoc d = {0} @destroy;
        CCArena frame = cc_arena_heap(kilobytes(8));
        char[:] all;
        const char *p;
        size_t ls, k;
        const RtxRun *lab, *dest;
        int inner_ok = 0;
        const char *ipath = "testdata/generated/path_inner.md";
        expect(frame.base != NULL, "path inner frame");
        if (system("mkdir -p testdata/generated") != 0)
            expect(0, "path inner mkdir");
        expect(write_file(ipath, "See [`file`](../x) here.\n"),
               "path inner write");
        d.from_path(ipath) !>;
        all = d.scratch_span(0, d.len(), frame) !>;
        p = strstr(all.ptr, "[`file`](../x)");
        expect(p != NULL, "path inner: bytes");
        ls = (size_t)(p - all.ptr);
        lab = smoke_path_run(&d, ls, 0);
        dest = smoke_path_run(&d, ls + 7, 1);
        expect(lab && dest && lab->hint_b == 0 && dest->hint_a == 2 &&
                   lab->len == 7,
               "path inner: two runs around `file`");
        if (dest) {
            for (k = 0; k < d.runs.len; k++) {
                const RtxRun *r = &d.runs.data[k];
                if (r->start <= ls || r->start + r->len > dest->start) continue;
                if (r->style.mono && r->hint_a == 1 && r->hint_b == 1)
                    inner_ok = 1;
            }
        }
        expect(inner_ok, "path inner: code pair on the label");
        expect(d.style_at(ls + 2).mono, "path inner: file is mono");
        remove(ipath);
        if (frame.base) frame.destroy();
    }
    {
        RtxDoc d = {0} @destroy;
        CCArena frame = cc_arena_heap(kilobytes(8));
        char[:] all;
        const char *p;
        size_t ls, end;
        expect(frame.base != NULL, "path join frame");
        d.from_path("testdata/rich/md/links_images.md") !>;
        all = d.scratch_span(0, d.len(), frame) !>;
        p = strstr(all.ptr, "[text](https://example.com)");
        expect(p != NULL, "path join: inline");
        ls = (size_t)(p - all.ptr);
        end = ls + 27; /* [text](https://example.com) */
        d.replace_join(end - 1, end, cc_slice_empty()) !>;
        all = d.scratch_span(0, d.len(), frame) !>;
        expect(strstr(all.ptr, "[text](https://example.com") != NULL,
               "path join: dest closer does not pull ](");
        expect(strstr(all.ptr, "[texthttps://") == NULL,
               "path join: dest is not pair-unwrapped");
        p = strstr(all.ptr, "[text](https://example.com");
        expect(p != NULL, "path join: label still there");
        ls = (size_t)(p - all.ptr);
        d.replace_join(ls, ls + 1, cc_slice_empty()) !>;
        all = d.scratch_span(0, d.len(), frame) !>;
        expect(strstr(all.ptr, "text](https://example.com") != NULL,
               "path join: [ does not pull dest");
        if (frame.base) frame.destroy();
    }
    {
        RtxDoc d = {0} @destroy;
        CCArena frame = cc_arena_heap(kilobytes(8));
        char[:] all;
        const char *p;
        size_t at, ls;
        const RtxRun *lab, *dest;
        const char *wpath = "testdata/generated/path_wrap.md";
        expect(frame.base != NULL, "path wrap frame");
        if (system("mkdir -p testdata/generated") != 0)
            expect(0, "path wrap mkdir");
        expect(write_file(wpath, "Wrap me please.\n"), "path wrap write");
        d.from_path(wpath) !>;
        all = d.scratch_span(0, d.len(), frame) !>;
        p = strstr(all.ptr, "Wrap");
        expect(p != NULL, "path wrap: word");
        at = (size_t)(p - all.ptr);
        d.caret = at;
        d.sel_anchor = at;
        RtxDoc_apply_named(&d, "link") !>;
        d.reparse_edit(d.last_off, d.last_markup) !>;
        all = d.scratch_span(0, d.len(), frame) !>;
        p = strstr(all.ptr, "[Wrap]() me please.");
        expect(p != NULL, "path wrap: [sel]()");
        ls = (size_t)(p - all.ptr);
        lab = smoke_path_run(&d, ls, 0);
        dest = smoke_path_run(&d, ls + 5, 1);
        expect(lab && lab->hint_a == 1 && lab->hint_b == 0 && lab->len == 5,
               "path wrap: plants label");
        expect(dest && dest->hint_a == 2 && dest->hint_b == 1 && dest->len == 3,
               "path wrap: plants empty dest");
        d.caret = ls + 2;
        d.sel_anchor = ls + 2;
        RtxDoc_apply_named(&d, "link") !>;
        d.reparse_edit(d.last_off, d.last_markup) !>;
        all = d.scratch_span(0, d.len(), frame) !>;
        expect(strstr(all.ptr, "[Wrap]()") == NULL,
               "path wrap: named apply unwraps");
        expect(strstr(all.ptr, "Wrap me please.") != NULL,
               "path wrap: unwrap keeps the label");
        remove(wpath);
        if (frame.base) frame.destroy();
    }

    /* --- heading fold EOF fallback (nav_region) ------------------------- */
    {
        /* Small file, caret under the LAST heading: whole doc is lexed, so the
         * section closes at EOF, not at the end of the last run. */
        char mpath[512];
        FILE *mf;
        RtxDoc d = {0} @destroy;
        size_t a = (size_t)-1, b = (size_t)-1;
        size_t k;
        expect(join2(mpath, sizeof mpath, "testdata/generated", "nav_eof.md"),
               "nav_eof.md path");
        mf = fopen(mpath, "w");
        expect(mf != NULL, "nav_eof.md write");
        if (mf) {
            fputs("# Alpha\n\nbody one\n\n# Beta\n\nbody two\n\n\n", mf);
            fclose(mf);
        }
        d.from_path(mpath) !>;
        for (k = 0; k < d.runs.len; k++) {
            const char *s = rtx_scope_name(d.runs.data[k].style.scope);
            if (!s || !strstr(s, "heading")) continue;
            if (a == (size_t)-1) a = d.runs.data[k].start;
            else if (b == (size_t)-1) b = d.runs.data[k].start;
        }
        expect(a != (size_t)-1 && b != (size_t)-1 && b > a, "eof: two md headings");
        d.caret = a;
        d.sel_anchor = a;
        expect(d.fold_toggle() == 1, "eof: fold first heading");
        expect(d.fold_n == 1 && d.folds[0].lo == a && d.folds[0].hi == b,
               "eof: first fold ends at next heading");
        expect(d.fold_toggle() == 2, "eof: unfold first");
        d.caret = b;
        d.sel_anchor = b;
        expect(d.fold_toggle() == 1, "eof: fold last heading");
        expect(d.fold_n == 1 && d.folds[0].lo == b && d.folds[0].hi == d.len(),
               "eof: last fold ends at EOF");
        expect(d.fold_covers(b + 8), "eof: last body covered");
        expect(d.fold_covers(d.len() - 1), "eof: trailing blank lines covered");
        expect(!d.fold_covers(d.len()), "eof: EOF itself visible");
        expect(d.fold_toggle() == 2, "eof: unfold last");
        expect(d.fold_n == 0, "eof: fold cleared");
        remove(mpath);
    }

    {
        /* > RTX_HL_WIN_MAX: the lexed window does not reach EOF. A heading with
         * no later heading inside that window is a miss, not a fold to the
         * window edge. Once the caret's window does reach EOF the fold closes
         * there. */
        char lpath[512];
        FILE *lf;
        RtxDoc d = {0} @destroy;
        size_t page = (size_t)RTX_HL_WIN_MAX;
        const char *top = "# Top\n";
        const char *tail = "# Tail\n\nlast body\n";
        size_t tail_at;
        size_t left;
        char chunk[4096];
        size_t k;
        expect(join2(lpath, sizeof lpath, "testdata/generated", "nav_eof_big.md"),
               "nav_eof_big path");
        lf = fopen(lpath, "w");
        expect(lf != NULL, "nav_eof_big write");
        {
            char[:] c = cc_slice_from_buffer(chunk, sizeof chunk);
            c.fill('x') !>;
        }
        for (k = 63; k < sizeof chunk; k += 64) chunk[k] = '\n';
        if (lf) fputs(top, lf);
        left = page;
        while (lf && left) {
            size_t n = left > sizeof chunk ? sizeof chunk : left;
            if (fwrite(chunk, 1, n, lf) != n) {
                expect(0, "nav_eof_big pad");
                break;
            }
            left -= n;
        }
        tail_at = strlen(top) + page;
        if (lf) {
            fputs(tail, lf);
            fclose(lf);
        }
        d.from_path(lpath) !>;
        expect(d.len() == tail_at + strlen(tail), "nav_eof_big length");
        expect(!d.hl_full, "nav_eof_big is windowed");
        d.ensure_hl(rtx_hl_win(0, page)) !>;
        {
            size_t top_run = (size_t)-1;
            for (k = 0; k < d.runs.len; k++) {
                const char *s = rtx_scope_name(d.runs.data[k].style.scope);
                if (!s || !strstr(s, "heading")) continue;
                if (top_run == (size_t)-1 || d.runs.data[k].start < top_run)
                    top_run = d.runs.data[k].start;
            }
            expect(top_run == 0, "nav_eof_big: Top heading lexed");
        }
        d.caret = 0;
        d.sel_anchor = 0;
        expect(d.fold_toggle() == 0, "window edge is not a fold end");
        expect(d.fold_n == 0, "no fold stored at window edge");
        expect(d.caret == 0, "caret stays on the heading");
        d.ensure_hl(rtx_hl_win(page, page)) !>;
        {
            size_t tail_run = (size_t)-1;
            for (k = 0; k < d.runs.len; k++) {
                const char *s = rtx_scope_name(d.runs.data[k].style.scope);
                if (!s || !strstr(s, "heading")) continue;
                if (d.runs.data[k].start == tail_at) tail_run = tail_at;
            }
            expect(tail_run == tail_at, "nav_eof_big: Tail heading lexed");
        }
        d.caret = tail_at;
        d.sel_anchor = tail_at;
        expect(d.fold_toggle() == 1, "window at EOF folds last heading");
        expect(d.fold_n == 1 && d.folds[0].lo == tail_at &&
                   d.folds[0].hi == d.len(),
               "big last fold ends at EOF");
        expect(d.fold_toggle() == 2, "big unfold last");
        remove(lpath);
    }
    /* --- end heading fold EOF fallback ---------------------------------- */

    free(buf);
    if (arena.base) arena.destroy();
    if (fails) {
        fprintf(stderr, "%d failure(s)\n", fails);
        return 1;
    }
    printf("tm_grammar_smoke ok  patterns=%zu  langs=%zu  load_us=%zu  dir=%s\n",
           g.patterns_n, rtx_tm_nlangs, rtx_tm_load_us, rtx_tm_load_dir);
    return 0;
}
