#!ccc ccs
/*
 * Page-store path-backed giant file: mid-file insert, save, reopen.
 * Full wrap of 100k lines is a frontend concern; this checks the tree.
 */
#include <ccc/std/prelude.cch>
#include <ccc/stdio.cch>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include "../core/document.cch"
#include "../core/layout.cch"
#include "../core/workspace.cch"
#include "../core/find.cch"
#include "../core/ui.cch"
#include "../core/browse.cch"

static int fails = 0;

static void expect(int cond, const char *msg) {
    if (!cond) {
        fprintf(stderr, "FAIL: %s\n", msg);
        fails++;
    }
}

static char *slurp(const char *path, size_t *n) {
    FILE *f = fopen(path, "rb");
    char *p;
    long len;
    *n = 0;
    if (!f) return NULL;
    fseek(f, 0, SEEK_END);
    len = ftell(f);
    fseek(f, 0, SEEK_SET);
    p = (char *)malloc((size_t)len + 1);
    if (p && len && fread(p, 1, (size_t)len, f) != (size_t)len) {
        free(p);
        p = NULL;
    }
    fclose(f);
    if (p) *n = (size_t)len;
    return p;
}

/* Whole doc past the page cache (every ORIGINAL byte from the file). */
static int doc_uncached_is(RtxDoc *d, const char *want, size_t n) {
    char *p;
    size_t got;
    int ok;
    if (d->len() != n) return 0;
    p = (char *)malloc(n + 1);
    if (!p) return 0;
    @errhandler(CCError e) {
        cc_error_log(e);
        free(p);
        return 0;
    }
    got = RtxPieceTree_read_uncached(&d->tree, 0, cc_slice_from_buffer(p, n)) !>;
    ok = got == n && memcmp(p, want, n) == 0;
    free(p);
    return ok;
}

static int file_is(const char *path, const char *want, size_t n) {
    size_t got = 0;
    char *p = slurp(path, &got);
    int ok = p && got == n && memcmp(p, want, n) == 0;
    free(p);
    return ok;
}

/* --backup saves through the opened inode of a multi-MiB file: the live
 * tree and history keep their ORIGINAL bytes (uncached reads), undo /
 * redo / the next save agree with a model at every step. */
static void backup_seq(const char *src) {
    const char *path = "testdata/generated/large_backup.txt";
    char bak[256];
    size_t n = 0, mid, i;
    char *base = slurp(src, &n);
    char *m1;
    int prev = rtx_doc_save_backup();
    RtxDoc d = {0} @destroy;
    @errhandler(CCError e) {
        cc_error_log(e);
        expect(0, "backup seq: unexpected error");
        rtx_doc_set_save_backup(prev);
        free(base);
        return;
    }
    snprintf(bak, sizeof(bak), "%s~", path);
    expect(base != NULL && n > 1000000, "backup seq: read fixture");
    if (!base) return;
    {
        FILE *f = fopen(path, "wb");
        expect(f && fwrite(base, 1, n, f) == n, "backup seq: copy fixture");
        if (f) fclose(f);
    }
    mid = n / 2;
    /* m1: fixture with "BACKUP" inserted at mid and 100 bytes cut at n/4. */
    m1 = (char *)malloc(n + 16);
    memcpy(m1, base, n / 4);
    memcpy(m1 + n / 4, base + n / 4 + 100, mid - n / 4 - 100);
    memcpy(m1 + mid - 100, "BACKUP", 6);
    memcpy(m1 + mid - 100 + 6, base + mid, n - mid);
    rtx_doc_set_save_backup(1);
    d.from_path(cc_slice_cstr(path)) !>;
    d.replace(mid, 0, "BACKUP") !>;
    d.break_coalesce();
    d.replace(n / 4, 100, cc_slice_empty()) !>;
    d.save() !>;
    expect(file_is(path, m1, n - 94), "backup seq: file after save");
    expect(doc_uncached_is(&d, m1, n - 94), "backup seq: live doc uncached after save");
    d.undo() !>;
    d.undo() !>;
    expect(doc_uncached_is(&d, base, n) && d.dirty(), "backup seq: undo x2 uncached");
    d.redo() !>;
    d.redo() !>;
    expect(doc_uncached_is(&d, m1, n - 94) && !d.dirty(), "backup seq: redo x2 uncached");
    d.undo() !>;
    d.undo() !>;
    d.save() !>;
    expect(file_is(path, base, n), "backup seq: save back to the original");
    expect(doc_uncached_is(&d, base, n), "backup seq: doc after second save");
    for (i = 0; i < 2; i++) d.redo() !>;
    expect(doc_uncached_is(&d, m1, n - 94) && d.dirty(), "backup seq: redo after second save");
    d.save() !>;
    expect(file_is(path, m1, n - 94) && doc_uncached_is(&d, m1, n - 94),
           "backup seq: third save");
    rtx_doc_set_save_backup(prev);
    free(m1);
    free(base);
    unlink(path);
    unlink(bak);
}

static double meas(void *ctx, char[:] bytes, RtxStyle style, RtxSectionKind sec) {
    (void)ctx;
    (void)style;
    (void)sec;
    return (double)bytes.len;
}

static double lh(void *ctx, RtxStyle style, RtxSectionKind sec) {
    (void)ctx;
    (void)style;
    (void)sec;
    return 1.0;
}

int main(void) {
    rtx_safe_test_isol();
    @errhandler(CCError e) { cc_error_log(e); return 1; }
    @errhandler(RtxIndexErr e) {
        fprintf(stderr, "%s\n", e.message ? e.message : "index");
        return 1;
    }
    const char *src = "testdata/generated/large.txt";
    const char *midpath = "testdata/generated/large_mid.txt";
    const char *saved = "testdata/generated/large_saved.txt";
    const char *mark = "GIANT_EDIT\n";
    RtxMeasure m;
    RtxDoc d = {0} @destroy;
    size_t mid;
    size_t mid_off;
    size_t nlines;
    size_t n;
    char buf[64];
    size_t got;

    m.measure = meas;
    m.line_height = lh;
    m.ctx = NULL;

    if (access(src, R_OK) != 0) {
        if (system("./testdata/gen_large.sh --bytes 3M testdata/generated/large.txt") != 0) {
            expect(0, "gen_large.sh");
            return 1;
        }
    }

    d.from_path(cc_slice_cstr(src)) !>;
    n = d.len();
    /* Above SOFT_MIN, line_count is a scroll budget. Scan past EOF for a real total. */
    {
        size_t past = d.line_start(1000000) !>;
        (void)past;
    }
    nlines = d.line_known();
    expect(n > 1000000, "large byte length");
    expect(nlines > 50000, "many lines");
    expect(d.tree.store.orig_open, "page-store original");

    {
        d.find_set("fn_") !>;
        d.find_finish() !>;
        expect(d.find.hits.len > 10000, "many fn_ hits");
        expect(!d.find.truncated || d.find.hits.len == RTX_FIND_MAX, "cap or all");
        d.find_goto(0);
        expect(d.caret < n, "first hit in range");
    }

    mid = nlines / 2;
    mid_off = d.line_start(mid) !>;
    {
            size_t _v = d.line_of(mid_off) !>;
            expect(_v == mid, "line_of mid");
        }
    {
        RtxLayout L = {0} @destroy;
        size_t last = nlines > 8 ? nlines - 8 : 0;
        size_t last_off = d.line_start(last) !>;
        {
            size_t _v = d.line_of(last_off) !>;
            expect(_v == last, "line_of near end");
        }
        L.lines(&d, &m, 80, last, 16) !>;
        expect(L.rows.len > 0 && L.rows.data[0].line == last, "row line near end");
    }

    d.caret = mid_off;
    d.sel_anchor = mid_off;
    d.type("GIANT_EDIT\n") !>;
    {
        size_t past = d.line_start(1000000) !>;
        (void)past;
    }
    expect(d.line_known() == nlines + 1, "one line inserted");
    got = d.read_at(mid_off, cc_slice_from_buffer(buf, 11)) !>;
    buf[got] = 0;
    expect(got == 11 && ({ char[:] __s = cc_slice_from_buffer(buf, 11); __s.eq_cstr("GIANT_EDIT\n"); }), "mid text");
    expect(d.check(), "tree after mid insert");

    d.save_as(cc_slice_cstr(saved)) !>;
    expect(!d.dirty(), "clean after save");
    d.undo() !>;
    expect(d.dirty(), "dirty after undo past save");
    {
        size_t past = d.line_start(1000000) !>;
        (void)past;
    }
    expect(d.line_known() == nlines, "undo removes insert");

    {
        RtxDoc d2 = {0} @destroy;
        d2.from_path(cc_slice_cstr(saved)) !>;
        {
            size_t past = d2.line_start(1000000) !>;
            (void)past;
        }
        expect(d2.line_known() == nlines + 1, "reopen has insert");
        got = d2.read_at(mid_off, cc_slice_from_buffer(buf, 11)) !>;
        expect(got == 11 && ({ char[:] __s = cc_slice_from_buffer(buf, 11); __s.eq_cstr("GIANT_EDIT\n"); }),
               "reopen mid text");
    }
    unlink(saved);

    if (system("./testdata/gen_large.sh 4000 testdata/generated/large_mid.txt") != 0) {
        expect(0, "gen mid");
    } else {
        RtxLayout L = {0} @destroy;
        size_t row_mid;
        size_t tail_start;
        size_t mid_lines;
        d.destroy();
        d.from_path(cc_slice_cstr(midpath)) !>;
        mid_lines = d.line_count();
        mid_off = d.line_start(mid_lines / 2) !>;
        L.doc(&d, &m, 80) !>;
        expect(L.rows.len >= mid_lines / 2, "enough rows");
        row_mid = L.row_of(mid_off);
        expect(row_mid + 50 < L.rows.len, "room after mid row");
        tail_start = L.rows.data[row_mid + 50].byte_start;
        d.caret = mid_off;
        d.sel_anchor = mid_off;
        d.type("GIANT_EDIT\n") !>;
        L.view_after_edit(&d, &m, 80) !>;
        expect(L.rows.data[row_mid + 51].byte_start == tail_start + strlen(mark),
               "window rebuilt after mid insert");
    }

    backup_seq(src);

    if (fails) {
        fprintf(stderr, "%d failure(s)\n", fails);
        return 1;
    }
    printf("large_file_smoke ok  lines=%zu bytes=%zu\n", nlines, n);
    return 0;
}
