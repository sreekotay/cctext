#!ccc ccs
/*
 * Safe journals: park/reload, identity toss, untitled, quit discard.
 */
#include <ccc/std/prelude.cch>
#include <ccc/stdio.cch>
#include <fcntl.h>
#include <stdint.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <sys/stat.h>
#include <unistd.h>
#include "../core/document.cch"
#include "../core/layout.cch"
#include "../core/workspace.cch"
#include "../core/safe.cch"

static int fails = 0;

/* Fixed part of one RTXS v7 hist rec: 11 u64 + 2 i32, then group (u64),
 * xact (u64), flags (u32). */
#define REC_FIXED (96 + 20)

static double meas(void *ctx, char[:] bytes, RtxStyle style, RtxSectionKind sec) {
    (void)ctx;
    (void)style;
    (void)sec;
    return (double)bytes.len;
}

static double lh(void *ctx, RtxStyle style, RtxSectionKind sec) {
    (void)ctx;
    (void)style;
    (void)sec;
    return 1.0;
}

static void expect(int cond, const char *msg) {
    if (!cond) {
        fprintf(stderr, "FAIL: %s\n", msg);
        fails++;
    }
}

static void expect_text(RtxDoc *d, const char *want, const char *msg) {
    char buf[4096];
    size_t n, got;
    if (!d) {
        expect(0, msg);
        return;
    }
    n = d->len();
    @errhandler(CCError e) {
        cc_error_log(e);
        expect(0, msg);
        return;
    }
    if (n != strlen(want) || n >= sizeof(buf)) {
        expect(0, msg);
        return;
    }
    got = d->read_at(0, cc_slice_from_buffer(buf, n)) !>;
    expect(got == n && ({ char[:] __s = cc_slice_from_buffer(buf, n); __s.eq_cstr(want); }), msg);
}

static void write_file(const char *path, const char *s) {
    FILE *f = fopen(path, "w");
    expect(f != NULL, "write_file open");
    if (!f) return;
    fputs(s, f);
    fclose(f);
}

static int journal_patch_ver(const char *doc_path, uint32_t ver) {
    char path[4096];
    unsigned char b[4];
    int fd;
    if (!rtx_safe_file_path(path, sizeof(path), doc_path)) return 0;
    fd = open(path, O_RDWR);
    if (fd < 0) return 0;
    if (lseek(fd, 4, SEEK_SET) < 0) {
        close(fd);
        return 0;
    }
    b[0] = (unsigned char)ver;
    b[1] = (unsigned char)(ver >> 8);
    b[2] = (unsigned char)(ver >> 16);
    b[3] = (unsigned char)(ver >> 24);
    if (write(fd, b, 4) != 4) {
        close(fd);
        return 0;
    }
    close(fd);
    return 1;
}

static int journal_header(const char *doc_path, uint32_t *magic, uint32_t *ver) {
    char path[4096];
    unsigned char b[8];
    int fd;
    if (!rtx_safe_file_path(path, sizeof(path), doc_path)) return 0;
    fd = open(path, O_RDONLY);
    if (fd < 0) return 0;
    if (read(fd, b, 8) != 8) {
        close(fd);
        return 0;
    }
    close(fd);
    *magic = (uint32_t)b[0] | ((uint32_t)b[1] << 8) | ((uint32_t)b[2] << 16) |
             ((uint32_t)b[3] << 24);
    *ver = (uint32_t)b[4] | ((uint32_t)b[5] << 8) | ((uint32_t)b[6] << 16) |
           ((uint32_t)b[7] << 24);
    return 1;
}

/* Whole RTXS leaf into buf (cap). Returns its size, 0 on a miss. */
static size_t journal_read(const char *doc_path, unsigned char *buf, size_t cap) {
    char path[4096];
    ssize_t n;
    int fd;
    if (!rtx_safe_file_path(path, sizeof(path), doc_path)) return 0;
    fd = open(path, O_RDONLY);
    if (fd < 0) return 0;
    n = read(fd, buf, cap);
    close(fd);
    return n > 0 ? (size_t)n : 0;
}

static int journal_write(const char *doc_path, const unsigned char *buf, size_t n) {
    char path[4096];
    int fd;
    if (!rtx_safe_file_path(path, sizeof(path), doc_path)) return 0;
    fd = open(path, O_WRONLY | O_CREAT | O_TRUNC, 0600);
    if (fd < 0) return 0;
    if (write(fd, buf, n) != (ssize_t)n) {
        close(fd);
        return 0;
    }
    close(fd);
    return 1;
}

/* Re-seal a hand-edited leaf: FNV-1a 64 over all but the 8-byte trailer. */
static void journal_resum(unsigned char *buf, size_t n) {
    uint64_t h = 1469598103934665603ull;
    size_t i;
    if (n < 8) return;
    for (i = 0; i + 8 < n; i++) {
        h ^= (uint64_t)buf[i];
        h *= 1099511628211ull;
    }
    for (i = 0; i < 8; i++) buf[n - 8 + i] = (unsigned char)(h >> (8 * i));
}

static void put_le64(unsigned char *p, uint64_t v) {
    int i;
    for (i = 0; i < 8; i++) p[i] = (unsigned char)(v >> (8 * i));
}

/* Offset of hlen in an RTXS leaf: magic, ver, path len + path, mtime,
 * size, ino, saved, head. */
static size_t journal_hlen_at(const unsigned char *buf) {
    uint32_t pn = (uint32_t)buf[8] | ((uint32_t)buf[9] << 8) |
                  ((uint32_t)buf[10] << 16) | ((uint32_t)buf[11] << 24);
    return 12 + (size_t)pn + 8 * 5;
}

static int file_is(const char *path, const char *want) {
    char buf[4096];
    size_t n;
    FILE *f = fopen(path, "rb");
    if (!f) return 0;
    n = fread(buf, 1, sizeof(buf) - 1, f);
    fclose(f);
    buf[n] = 0;
    return strcmp(buf, want) == 0;
}

/* 1 = RtxWs_save_dirty succeeded. */
static int save_ok(RtxWs *w) {
    @errhandler(CCError e) {
        (void)e;
        return 0;
    }
    w->save_dirty() !>;
    return 1;
}

/* 1 = RtxWs_sync_live succeeded. */
static int sync_ok(RtxWs *w) {
    @errhandler(CCError e) {
        (void)e;
        return 0;
    }
    w->sync_live() !>;
    return 1;
}

static void isol_reset(void) {
    rtx_safe_test_isol();
    {
        char dir[512];
        if (rtx_safe_dir(dir, sizeof(dir))) {
            char cmd[640];
            snprintf(cmd, sizeof(cmd), "rm -rf '%s'", dir);
            (void)system(cmd);
        }
    }
    rtx_safe_test_isol();
}

int main(void) {
    @errhandler(CCError e) { cc_error_log(e); return 1; }
    @errhandler(RtxIndexErr e) {
        fprintf(stderr, "safe_smoke: %s\n", e.message ? e.message : "index");
        return 1;
    }
    const char *a = "testdata/generated/safe_a.txt";
    const char *b = "testdata/generated/safe_b.txt";
    RtxMeasure m;
    m.measure = meas;
    m.line_height = lh;
    m.ctx = NULL;
    mkdir("testdata/generated", 0755);
    isol_reset();
    write_file(a, "hello\n");
    write_file(b, "other\n");

    /* Camera / selection flush without an edit. */
    isol_reset();
    write_file(a, "hello\nworld\n");
    {
        RtxWs w = {0} @destroy;
        char *paths[1];
        paths[0] = (char *)a;
        w.open_files(1, paths) !>;
        w.bufs[0]->doc.caret = 5;
        w.bufs[0]->doc.sel_anchor = 0;
        w.safe_flush_all();
        expect(!w.bufs[0]->doc.dirty(), "select is not an edit");
    }
    {
        RtxWs w = {0} @destroy;
        char *paths[1];
        paths[0] = (char *)a;
        w.open_files(1, paths) !>;
        expect(w.bufs[0]->doc.caret == 5, "reopen caret after select-only flush");
        expect(w.bufs[0]->doc.sel_anchor == 0, "reopen sel after select-only flush");
    }
    isol_reset();
    write_file(a, "hello\n");
    write_file(b, "other\n");

    /* State sidecar: caret write must not rewrite the hist leaf. */
    isol_reset();
    write_file(a, "hello\nworld\n");
    {
        RtxWs w = {0} @destroy;
        char *paths[1];
        struct stat st0, st1;
        char jpath[4096], spath[4096];
        unsigned char sb[8];
        int sfd;
        uint32_t smagic = 0, sver = 0;
        paths[0] = (char *)a;
        w.open_files(1, paths) !>;
        w.bufs[0]->doc.type("Z") !>;
        w.safe_flush_all();
        expect(rtx_safe_file_path(jpath, sizeof(jpath), a), "hist path");
        expect(stat(jpath, &st0) == 0, "hist leaf after edit");
        w.bufs[0]->doc.caret = 3;
        w.bufs[0]->doc.sel_anchor = 1;
        {
            RtxSafeCam cam;
            rtx_safe_cam_clear(&cam);
            cam.view = w.bufs[0]->layout.view;
            rtx_safe_flush_state(&w.bufs[0]->doc, &cam);
        }
        expect(stat(jpath, &st1) == 0, "hist leaf after state flush");
        expect(st0.st_ino == st1.st_ino && st0.st_size == st1.st_size &&
                   st0.st_mtime == st1.st_mtime,
               "state flush leaves hist inode/size/mtime");
        expect(rtx_safe_state_path(spath, sizeof(spath), a), "state path");
        sfd = open(spath, O_RDONLY);
        expect(sfd >= 0, "state sidecar exists");
        if (sfd >= 0) {
            expect(read(sfd, sb, 8) == 8, "state header readable");
            close(sfd);
            smagic = (uint32_t)sb[0] | ((uint32_t)sb[1] << 8) |
                     ((uint32_t)sb[2] << 16) | ((uint32_t)sb[3] << 24);
            sver = (uint32_t)sb[4] | ((uint32_t)sb[5] << 8) |
                   ((uint32_t)sb[6] << 16) | ((uint32_t)sb[7] << 24);
            expect(smagic == RTX_SAFE_STATE_MAGIC, "state magic is RTXC");
            expect(sver == RTX_SAFE_STATE_VER, "state ver is current");
        }
    }
    {
        RtxWs w = {0} @destroy;
        char *paths[1];
        paths[0] = (char *)a;
        w.open_files(1, paths) !>;
        expect_text(&w.bufs[0]->doc, "Zhello\nworld\n", "state reopen keeps hist");
        expect(w.bufs[0]->doc.dirty(), "state reopen is still dirty");
        expect(w.bufs[0]->doc.caret == 3, "state reopen caret");
        expect(w.bufs[0]->doc.sel_anchor == 1, "state reopen sel");
    }
    isol_reset();
    write_file(a, "hello\n");
    write_file(b, "other\n");

    /* Flush + destroy + open restores dirty + undo + caret. */
    {
        RtxWs w = {0} @destroy;
        char *paths[1];
        paths[0] = (char *)a;
        w.open_files(1, paths) !>;
        expect(!w.bufs[0]->parked, "first open live");
        {
            RtxDoc *d = &w.bufs[0]->doc;
            d->caret = 0;
            d->type("x") !>;
            d->caret = 1;
            w.bufs[0]->top = 0;
            w.safe_flush_all();
            expect(d->dirty(), "dirty after type");
            expect(d->can_undo(), "can undo");
        }
    }
    {
        RtxWs w = {0} @destroy;
        char *paths[1];
        paths[0] = (char *)a;
        w.open_files(1, paths) !>;
        {
            RtxDoc *d = &w.bufs[0]->doc;
            expect_text(d, "xhello\n", "reload dirty text");
            expect(d->dirty(), "reload dirty");
            expect(d->can_undo(), "reload undo");
            expect(d->caret == 1, "reload caret");
            d->undo() !>;
            expect_text(d, "hello\n", "undo after reload");
            expect(d->can_redo(), "redo tail");
        }
    }

    /* 1-pane browse-away parks the hidden file; come back restores. */
    isol_reset();
    write_file(a, "hello\n");
    write_file(b, "other\n");
    {
        RtxWs w = {0} @destroy;
        char *paths[1];
        paths[0] = (char *)a;
        w.open_files(1, paths) !>;
        {
            RtxDoc *d = &w.bufs[0]->doc;
            d->type("z") !>;
        }
        w.add_path(cc_slice_cstr(b)) !>;
        w.npanes = 1;
        w.pane[0] = 1;
        w.pane[1] = 1;
        w.sync_live() !>;
        expect(w.bufs[0]->parked, "a parked after browse");
        expect(!w.bufs[1]->parked, "b live");
        expect(w.bufs[0]->park_dirty, "parked dirty bit");
        expect_text(&w.bufs[1]->doc, "other\n", "b unchanged");
        w.pane[0] = 0;
        w.sync_live() !>;
        expect(!w.bufs[0]->parked, "a live again");
        {
            RtxDoc *d = &w.bufs[0]->doc;
            expect_text(d, "zhello\n", "park reload text");
            expect(d->can_undo(), "park reload undo");
        }
    }

    /* Dirty park must not evict if the hist journal write fails. */
    isol_reset();
    write_file(a, "hello\n");
    write_file(b, "other\n");
    {
        RtxWs w = {0} @destroy;
        char *paths[1];
        paths[0] = (char *)a;
        w.open_files(1, paths) !>;
        {
            RtxDoc *d = &w.bufs[0]->doc;
            d->type("z") !>;
        }
        w.add_path(cc_slice_cstr(b)) !>;
        w.npanes = 1;
        w.pane[0] = 1;
        w.pane[1] = 1;
        rtx_safe_fail_next_write();
        w.sync_live() !>;
        expect(!w.bufs[0]->parked, "dirty stays live when journal write fails");
        expect(w.bufs[0]->doc.dirty(), "unsaved delta still in RAM");
        expect_text(&w.bufs[0]->doc, "zhello\n", "failed park keeps the edit");
        w.sync_live() !>;
        expect(w.bufs[0]->parked, "retry park after a good flush");
        w.pane[0] = 0;
        w.sync_live() !>;
        expect_text(&w.bufs[0]->doc, "zhello\n", "retry park recovered");
    }

    /* Idle flush miss must not note hist current, or a later park evicts. */
    isol_reset();
    write_file(a, "hello\n");
    write_file(b, "other\n");
    {
        RtxWs w = {0} @destroy;
        char *paths[1];
        paths[0] = (char *)a;
        w.open_files(1, paths) !>;
        {
            RtxDoc *d = &w.bufs[0]->doc;
            d->type("z") !>;
        }
        w.safe_pump();
        expect(w.bufs[0]->safe_due_ms != 0, "idle debounce armed");
        w.bufs[0]->safe_due_ms = 1;
        rtx_safe_fail_next_write();
        w.safe_pump();
        expect(w.bufs[0]->safe_gen != w.bufs[0]->doc.edit_gen,
               "failed idle flush does not mark hist current");
        expect(w.bufs[0]->safe_fault, "dirty journal miss is a fault");
        expect(rtx_ws_safe_fault(&w), "workspace sees the journal fault");
        w.add_path(cc_slice_cstr(b)) !>;
        w.npanes = 1;
        w.pane[0] = 1;
        w.pane[1] = 1;
        rtx_safe_fail_next_write();
        w.sync_live() !>;
        expect(!w.bufs[0]->parked, "dirty stays live after failed idle flush");
        expect_text(&w.bufs[0]->doc, "zhello\n", "idle miss keeps the edit");
    }

    /* A failed idle hist write backs off; it does not retry every frame. */
    isol_reset();
    write_file(a, "hello\n");
    {
        RtxWs w = {0} @destroy;
        char *paths[1];
        size_t att;
        int k;
        paths[0] = (char *)a;
        w.open_files(1, paths) !>;
        w.bufs[0]->doc.type("z") !>;
        w.safe_pump();
        w.bufs[0]->safe_due_ms = 1;
        rtx_safe_fail_next_write();
        w.safe_pump();
        expect(w.bufs[0]->safe_fault, "backoff: first idle write missed");
        att = rtx_safe_write_attempts();
        for (k = 0; k < 5; k++) w.safe_pump();
        expect(rtx_safe_write_attempts() == att, "failed idle flush does not retry every frame");
        w.bufs[0]->doc.type("y") !>;
        w.safe_pump();
        expect(rtx_safe_write_attempts() == att, "a new edit does not jump the backoff");
        w.bufs[0]->safe_due_ms = 1;
        w.bufs[0]->safe_retry_ms = 1;
        rtx_safe_fail_next_write();
        w.safe_pump();
        expect(rtx_safe_write_attempts() == att + 1, "backoff elapsed: one retry");
        expect(w.bufs[0]->safe_backoff_ms > (long)RTX_SAFE_DEBOUNCE_MS,
               "second miss doubles the backoff");
        w.bufs[0]->safe_due_ms = 1;
        w.bufs[0]->safe_retry_ms = 1;
        w.safe_pump();
        expect(!w.bufs[0]->safe_fault && w.bufs[0]->safe_backoff_ms == 0,
               "a landed write clears the fault and the backoff");
        expect(rtx_safe_peek_dirty(a), "retried journal landed");
    }

    /* External edit, clean journal: only undo history is lost. */
    isol_reset();
    write_file(a, "hello\n");
    {
        RtxWs w = {0} @destroy;
        char *paths[1];
        paths[0] = (char *)a;
        w.open_files(1, paths) !>;
        {
            RtxDoc *d = &w.bufs[0]->doc;
            d->type("x") !>;
            d->undo() !>;
        }
        w.safe_flush_all();
    }
    usleep(30000);
    write_file(a, "changed\n");
    {
        RtxWs w = {0} @destroy;
        char *paths[1];
        paths[0] = (char *)a;
        w.open_files(1, paths) !>;
        {
            RtxDoc *d = &w.bufs[0]->doc;
            expect_text(d, "changed\n", "identity miss uses disk");
            expect(!d->can_undo() && !d->can_redo(), "clean hist tossed");
            expect(!d->dirty(), "not dirty after toss");
            expect(w.bufs[0]->safe_hold == RTX_SAFE_HOLD_NONE, "clean toss holds nothing");
            expect(!w.any_dirty(), "clean toss is not unsaved work");
        }
    }

    /* External edit, dirty journal: the edits come back on the bytes they
     * were made against (the pinned base), dirty, and Save asks. */
    isol_reset();
    write_file(a, "hello\n");
    {
        RtxWs w = {0} @destroy;
        char *paths[1];
        char pin[4096];
        struct stat pst;
        paths[0] = (char *)a;
        w.open_files(1, paths) !>;
        w.bufs[0]->doc.type("x") !>;
        w.safe_flush_all();
        expect(rtx_safe_base_path(pin, sizeof(pin), a) && stat(pin, &pst) == 0,
               "dirty flush pins the base");
    }
    usleep(30000);
    write_file(a, "changed\n");
    {
        RtxWs w = {0} @destroy;
        char *paths[1];
        char msg[512];
        paths[0] = (char *)a;
        w.open_files(1, paths) !>;
        {
            RtxDoc *d = &w.bufs[0]->doc;
            expect_text(d, "xhello\n", "drifted dirty journal replays onto its pin");
            expect(d->dirty() && d->can_undo(), "recovered edits are dirty with undo");
            expect(d->disk_changed(), "recovered onto the old base: Save sees the drift");
            expect(w.bufs[0]->safe_rebased, "buffer knows it was rebased");
            expect(rtx_ws_safe_fault_msg(&w, msg, sizeof(msg)), "rebase is on the status bar");
            expect(!save_ok(&w), "save-all does not overwrite the drifted file");
            expect(file_is(a, "changed\n"), "drifted file untouched");
        }
    }

    /* The reported scenario: edit, switch away (parks dirty), the file
     * changes on disk, quit -> Save. The edits must not vanish. */
    isol_reset();
    write_file(a, "hello\n");
    write_file(b, "other\n");
    {
        RtxWs w = {0} @destroy;
        char *paths[1];
        char pin[4096];
        struct stat pst;
        paths[0] = (char *)a;
        w.open_files(1, paths) !>;
        w.bufs[0]->doc.type("z") !>;
        w.add_path(cc_slice_cstr(b)) !>;
        w.npanes = 1;
        w.pane[0] = 1;
        w.pane[1] = 1;
        w.sync_live() !>;
        expect(w.bufs[0]->parked && w.bufs[0]->park_dirty, "a parked dirty");
        usleep(30000);
        write_file(a, "external\n");
        expect(w.any_disk_changed(), "quit sees a parked dirty buffer's drift");
        expect(!save_ok(&w), "save-all refuses instead of dropping the edits");
        expect(file_is(a, "external\n"), "save-all left the drifted file alone");
        expect(!w.bufs[0]->parked, "save-all unparked a");
        expect_text(&w.bufs[0]->doc, "zhello\n", "parked edits recovered onto the pin");
        expect(w.bufs[0]->doc.dirty(), "recovered parked edits are dirty");
        expect(w.bufs[0]->doc.disk_changed(), "recovered parked buffer sees the drift");
        w.bufs[0]->doc.save_overwrite();
        w.bufs[0]->doc.save() !>;
        expect(file_is(a, "zhello\n"), "overwrite writes the recovered edits");
        w.safe_flush_all();
        expect(rtx_safe_base_path(pin, sizeof(pin), a) && stat(pin, &pst) != 0,
               "clean journal drops the pin");
        expect(!w.any_disk_changed(), "no drift after overwrite");
    }

    /* No pin (the path drifted before the first dirty flush, or the base is
     * past RTX_SAFE_BASE_MAX): the dirty journal is held, never tossed. */
    {
        unsigned char j0[8192], j1[8192];
        size_t n0, n1;
        char pin[4096];
        struct stat pst;
        isol_reset();
        write_file(a, "hello\n");
        write_file(b, "other\n");
        {
            RtxWs w = {0} @destroy;
            char *paths[1];
            paths[0] = (char *)a;
            w.open_files(1, paths) !>;
            w.bufs[0]->doc.type("x") !>;
            usleep(30000);
            write_file(a, "changed!\n");
            w.safe_flush_all();
        }
        expect(rtx_safe_base_path(pin, sizeof(pin), a) && stat(pin, &pst) != 0,
               "no pin from a path that already drifted");
        expect(rtx_safe_peek_dirty(a), "held test journal is dirty");
        n0 = journal_read(a, j0, sizeof(j0));
        {
            RtxWs w = {0} @destroy;
            char *paths[1];
            char msg[512];
            paths[0] = (char *)a;
            w.open_files(1, paths) !>;
            expect_text(&w.bufs[0]->doc, "changed!\n", "held: shows the file");
            expect(w.bufs[0]->safe_hold == RTX_SAFE_HOLD_CONFLICT, "held: conflict");
            expect(w.any_dirty(), "held: counts as unsaved (quit asks)");
            expect(rtx_ws_safe_fault_msg(&w, msg, sizeof(msg)) && strstr(msg, "held"),
                   "held: status bar says so");
            expect(!save_ok(&w), "held: save-all refuses");
            w.bufs[0]->doc.type("Y") !>;
            w.safe_flush_all();
            w.safe_pump();
            n1 = journal_read(a, j1, sizeof(j1));
            expect(n1 == n0 && memcmp(j0, j1, n0) == 0, "held journal stays untouched");
            w.add_path(cc_slice_cstr(b)) !>;
            w.npanes = 1;
            w.pane[0] = 1;
            w.pane[1] = 1;
            w.sync_live() !>;
            expect(!w.bufs[0]->parked, "held + new edits: cannot park");
            w.safe_discard_dirty();
            expect(w.bufs[0]->safe_hold == RTX_SAFE_HOLD_NONE, "quit q releases the hold");
            expect(!rtx_safe_peek_dirty(a), "quit q drops the held journal");
        }
        /* Held journal in a parked buffer (snapshot restore): save-all still
         * refuses, quit still counts it. */
        isol_reset();
        write_file(a, "hello\n");
        {
            RtxWs w = {0} @destroy;
            char *paths[1];
            paths[0] = (char *)a;
            w.open_files(1, paths) !>;
            w.bufs[0]->doc.type("x") !>;
            usleep(30000);
            write_file(a, "changed!\n");
            w.safe_flush_all();
        }
        {
            RtxWs w = {0} @destroy;
            w.open_files(0, NULL) !>;
            expect(w.len == 1 && !w.untitled(), "restore has the held file");
            expect(w.bufs[0]->safe_hold == RTX_SAFE_HOLD_CONFLICT, "restore holds it");
            expect(w.any_dirty(), "restored hold is unsaved");
            expect(!save_ok(&w), "restored hold: save-all refuses");
            expect(rtx_safe_peek_dirty(a), "restored hold keeps the journal");
        }
    }

    /* Journal identity is the base hist is relative to (the document's
     * open/save stamp), not a stat of the path at flush time. A file that
     * drifted under a live dirty buffer must not re-key the journal onto
     * the new bytes. */
    isol_reset();
    write_file(a, "hello\n");
    {
        RtxWs w = {0} @destroy;
        char *paths[1];
        paths[0] = (char *)a;
        w.open_files(1, paths) !>;
        w.bufs[0]->doc.type("x") !>;
        write_file(a, "changed!\n");
        w.safe_flush_all();
    }
    {
        RtxWs w = {0} @destroy;
        char *paths[1];
        paths[0] = (char *)a;
        w.open_files(1, paths) !>;
        expect_text(&w.bufs[0]->doc, "changed!\n",
                    "flush-time drift does not replay onto new bytes");
        expect(!w.bufs[0]->doc.can_undo(), "drifted base: no replay");
    }

    /* RTXS validation. A flipped payload byte fails the trailer sum; a
     * length that does not fit the file is refused before it sizes an
     * allocation; a leaf written for another path is not replayed even
     * when the identity (a hard link) matches. */
    {
        const char *a2 = "testdata/generated/safe_a_link.txt";
        unsigned char jb[8192], orig[8192];
        size_t n = 0, p;
        isol_reset();
        write_file(a, "hello\n");
        {
            RtxWs w = {0} @destroy;
            char *paths[1];
            paths[0] = (char *)a;
            w.open_files(1, paths) !>;
            w.bufs[0]->doc.type("Q") !>;
            w.safe_flush_all();
        }
        n = journal_read(a, orig, sizeof(orig));
        expect(n > 16, "validation journal readable");
        for (p = n; p > 0 && n; p--) {
            if (orig[p - 1] == 'Q') break;
        }
        expect(p > 0, "validation journal holds the typed byte");
        if (n && p > 0) {
            memcpy(jb, orig, n);
            jb[p - 1] = 'R';
            expect(journal_write(a, jb, n), "flip payload byte");
            {
                RtxWs w = {0} @destroy;
                char *paths[1];
                paths[0] = (char *)a;
                w.open_files(1, paths) !>;
                expect_text(&w.bufs[0]->doc, "hello\n", "sum mismatch is not replayed");
                expect(!w.bufs[0]->doc.dirty(), "sum mismatch leaves disk text");
            }
            /* One rec: REC_FIXED-byte fixed part, 1 ins byte, 8-byte trailer. */
            memcpy(jb, orig, n);
            put_le64(jb + (n - 8 - 1 - REC_FIXED) + 16, (uint64_t)1 << 62);
            journal_resum(jb, n);
            expect(journal_write(a, jb, n), "patch ins_n");
            {
                RtxWs w = {0} @destroy;
                char *paths[1];
                paths[0] = (char *)a;
                w.open_files(1, paths) !>;
                expect_text(&w.bufs[0]->doc, "hello\n", "oversized ins_n refused");
                expect(!w.bufs[0]->doc.can_undo(), "oversized ins_n: no hist");
            }
            memcpy(jb, orig, n);
            put_le64(jb + journal_hlen_at(jb), UINT64_MAX / 2);
            journal_resum(jb, n);
            expect(journal_write(a, jb, n), "patch hlen");
            {
                RtxWs w = {0} @destroy;
                char *paths[1];
                paths[0] = (char *)a;
                w.open_files(1, paths) !>;
                expect_text(&w.bufs[0]->doc, "hello\n", "oversized hlen refused");
                expect(!w.bufs[0]->doc.can_undo(), "oversized hlen: no hist");
            }
            unlink(a2);
            expect(link(a, a2) == 0, "hard link for the path check");
            expect(journal_write(a2, orig, n), "plant a's leaf under a2's key");
            {
                RtxWs w = {0} @destroy;
                char *paths[1];
                paths[0] = (char *)a2;
                w.open_files(1, paths) !>;
                expect_text(&w.bufs[0]->doc, "hello\n",
                            "leaf for another path is not replayed");
                expect(!w.bufs[0]->doc.dirty(), "foreign leaf: not dirty");
            }
            unlink(a2);
        }
    }

    /* A replay that fails midway must not leave the recs it did apply on
     * screen as a clean document. Reopen the file, hold the journal (it is
     * the only copy of those edits), and say so. */
    {
        unsigned char jb[8192], again[8192];
        size_t n, n2;
        isol_reset();
        write_file(a, "hello\n");
        {
            RtxWs w = {0} @destroy;
            char *paths[1];
            paths[0] = (char *)a;
            w.open_files(1, paths) !>;
            w.bufs[0]->doc.type("Q") !>;
            w.bufs[0]->doc.break_coalesce();
            w.bufs[0]->doc.caret = w.bufs[0]->doc.len();
            w.bufs[0]->doc.sel_anchor = w.bufs[0]->doc.caret;
            w.bufs[0]->doc.type("W") !>;
            expect_text(&w.bufs[0]->doc, "Qhello\nW", "two recs typed");
            w.safe_flush_all();
        }
        n = journal_read(a, jb, sizeof(jb));
        expect(n > 8 + 1 + REC_FIXED, "two-rec journal readable");
        if (n > 8 + 1 + REC_FIXED) {
            /* Last rec: REC_FIXED-byte fixed part, 1 ins byte, 8-byte trailer. Its
             * offset now lies past EOF, so redo fails after rec 0 applied. */
            put_le64(jb + (n - 8 - 1 - REC_FIXED), (uint64_t)1 << 40);
            journal_resum(jb, n);
            expect(journal_write(a, jb, n), "patch last rec off");
        }
        {
            RtxWs w = {0} @destroy;
            char *paths[1];
            char msg[512];
            paths[0] = (char *)a;
            w.open_files(1, paths) !>;
            expect_text(&w.bufs[0]->doc, "hello\n", "partial replay rolls back to the file");
            expect(!w.bufs[0]->doc.can_undo(), "partial replay: no hist");
            expect(w.bufs[0]->safe_hold == RTX_SAFE_HOLD_REPLAY, "partial replay holds the journal");
            expect(rtx_ws_safe_fault_msg(&w, msg, sizeof(msg)), "partial replay is a visible fault");
            expect(w.any_dirty(), "held journal counts as unsaved");
            w.bufs[0]->doc.type("Z") !>;
            w.safe_flush_all();
            n2 = journal_read(a, again, sizeof(again));
            expect(n2 == n && memcmp(again, jb, n) == 0, "held journal is not overwritten");
            expect(!save_ok(&w), "save_dirty refuses while a journal is held");
            w.safe_discard_dirty();
            expect(w.bufs[0]->safe_hold == RTX_SAFE_HOLD_NONE, "discard releases the hold");
            expect(journal_read(a, again, sizeof(again)) == 0, "discard drops the held journal");
        }
    }

    /* Identity mtime is nanoseconds: a same-size rewrite inside one second
     * still drifts, for the journal and for Save's conflict check. */
    isol_reset();
    write_file(a, "hello\n");
    {
        RtxWs w = {0} @destroy;
        char *paths[1];
        paths[0] = (char *)a;
        w.open_files(1, paths) !>;
        w.bufs[0]->doc.type("Q") !>;
        w.safe_flush_all();
    }
    usleep(30000);
    write_file(a, "HELLO\n");
    {
        RtxWs w = {0} @destroy;
        char *paths[1];
        paths[0] = (char *)a;
        w.open_files(1, paths) !>;
        /* Seconds identity would replay onto HELLO ("QHELLO"). A drift
         * replays onto the pinned base instead. */
        expect_text(&w.bufs[0]->doc, "Qhello\n", "same-size rewrite drifts the journal");
        expect(w.bufs[0]->safe_rebased, "same-size rewrite: rebased onto the pin");
        usleep(30000);
        write_file(a, "hullo\n");
        expect(w.bufs[0]->doc.disk_changed(), "same-size rewrite is a save conflict");
    }

    /* Untitled cannot park. */
    isol_reset();
    {
        RtxWs w = {0} @destroy;
        w.open_files(0, NULL) !>;
        expect(w.untitled(), "untitled boot");
        {
            RtxDoc *d = &w.bufs[0]->doc;
            d->type("nope") !>;
        }
        w.sync_live() !>;
        expect(!w.bufs[0]->parked, "untitled stays live");
        expect(w.bufs[0]->doc.dirty(),
               "untitled dirty");
    }

    /* Quit discard drops the journal. */
    isol_reset();
    write_file(a, "hello\n");
    {
        RtxWs w = {0} @destroy;
        char *paths[1];
        paths[0] = (char *)a;
        w.open_files(1, paths) !>;
        {
            RtxDoc *d = &w.bufs[0]->doc;
            d->type("x") !>;
        }
        w.safe_flush_all();
        expect(rtx_safe_peek_dirty(a), "journal dirty");
        {
            uint32_t magic = 0, ver = 0;
            expect(journal_header(a, &magic, &ver), "journal header readable");
            expect(magic == RTX_SAFE_FILE_MAGIC, "journal magic is RTXS");
            expect(ver == RTX_SAFE_FILE_VER_PLAIN, "flush writes v8 when no branch rides along");
        }
        w.safe_discard_dirty();
        expect(!rtx_safe_peek_dirty(a), "journal dropped");
        w.safe_flush_exit();
        expect(!rtx_safe_peek_dirty(a), "exit flush does not rewrite a discard");
        expect(w.any_dirty(), "discard leaves memory dirty");
    }
    {
        RtxWs w = {0} @destroy;
        char *paths[1];
        paths[0] = (char *)a;
        w.open_files(1, paths) !>;
        {
            RtxDoc *d = &w.bufs[0]->doc;
            expect_text(d, "hello\n", "after discard disk text");
            expect(!d->dirty(), "after discard clean");
        }
    }

    /* Future / too-old file ver is ignored (no recovered hist). */
    isol_reset();
    write_file(a, "hello\n");
    {
        RtxWs w = {0} @destroy;
        char *paths[1];
        paths[0] = (char *)a;
        w.open_files(1, paths) !>;
        w.bufs[0]->doc.type("x") !>;
        w.safe_flush_all();
        expect(rtx_safe_peek_dirty(a), "ver test journal dirty");
        expect(journal_patch_ver(a, RTX_SAFE_FILE_VER + 1), "patch future ver");
        expect(!rtx_safe_peek_dirty(a), "future ver is not dirty");
    }
    {
        RtxWs w = {0} @destroy;
        char *paths[1];
        paths[0] = (char *)a;
        w.open_files(1, paths) !>;
        expect_text(&w.bufs[0]->doc, "hello\n", "future ver tosses hist");
        expect(!w.bufs[0]->doc.dirty(), "future ver leaves disk text");
    }
    isol_reset();
    write_file(a, "hello\n");
    {
        RtxWs w = {0} @destroy;
        char *paths[1];
        paths[0] = (char *)a;
        w.open_files(1, paths) !>;
        w.bufs[0]->doc.type("x") !>;
        w.safe_flush_all();
        expect(journal_patch_ver(a, 0), "patch ver below min");
        expect(!rtx_safe_peek_dirty(a), "old ver is not dirty");
    }
    {
        RtxWs w = {0} @destroy;
        char *paths[1];
        paths[0] = (char *)a;
        w.open_files(1, paths) !>;
        expect_text(&w.bufs[0]->doc, "hello\n", "old ver tosses hist");
        expect(!w.bufs[0]->doc.dirty(), "old ver leaves disk text");
    }

    /* View is part of the camera journal. Reopen and session restore keep it. */
    isol_reset();
    {
        const char *gpath = "testdata/generated/safe_grid.csv";
        write_file(gpath, "id,name\n1,a\n");
        {
            RtxWs w = {0} @destroy;
            char *paths[1];
            paths[0] = (char *)gpath;
            w.open_files(1, paths) !>;
            rtx_layout_set_view(&w.bufs[0]->layout, RTX_VIEW_GRID);
            w.safe_flush_all();
        }
        {
            RtxWs w = {0} @destroy;
            char *paths[1];
            paths[0] = (char *)gpath;
            w.open_files(1, paths) !>;
            expect(rtx_layout_is_grid(&w.bufs[0]->layout),
                   "reopen restores grid view");
        }
        {
            RtxWs w = {0} @destroy;
            w.open_files(0, NULL) !>;
            expect(w.len == 1 && !w.untitled(), "session restore has the file");
            expect(rtx_layout_is_grid(&w.bufs[0]->layout),
                   "session restore keeps grid view");
        }
        /* Cycle is not an edit. Destroy / clean quit must still persist it. */
        isol_reset();
        write_file(gpath, "id,name\n1,a\n");
        {
            RtxWs w = {0} @destroy;
            char *paths[1];
            paths[0] = (char *)gpath;
            w.open_files(1, paths) !>;
            expect(w.bufs[0]->layout.view == RTX_VIEW_DEFAULT, "open default");
            w.bufs[0]->cycle_view(8) !>;
            w.bufs[0]->cycle_view(8) !>;
            expect(rtx_layout_is_grid(&w.bufs[0]->layout), "cycled to grid");
        }
        {
            RtxWs w = {0} @destroy;
            char *paths[1];
            paths[0] = (char *)gpath;
            w.open_files(1, paths) !>;
            expect(rtx_layout_is_grid(&w.bufs[0]->layout),
                   "cycle+destroy persists grid");
        }
        {
            RtxWs w = {0} @destroy;
            w.open_files(0, NULL) !>;
            expect(rtx_layout_is_grid(&w.bufs[0]->layout),
                   "session restore after cycle is grid");
        }
    }

    /* Mid-file camera: journal the red-line; reopen shows abs without prefix. */
    isol_reset();
    {
        const char *mpath = "testdata/generated/safe_marks.txt";
        FILE *fp;
        int i;
        size_t mid, want_abs = 0, saved_off = 0;
        fp = fopen(mpath, "w");
        expect(fp != NULL, "safe_marks fopen");
        if (fp) {
            for (i = 0; i < 4000; i++) fputs("xxxxxxxxxxxxxxxxxxxx\n", fp);
            fclose(fp);
        }
        {
            RtxWs w = {0} @destroy;
            char *paths[1];
            paths[0] = (char *)mpath;
            w.open_files(1, paths) !>;
            mid = w.bufs[0]->doc.len() / 2;
            w.bufs[0]->doc.caret = rtx_doc_line_floor(&w.bufs[0]->doc, mid) !>;
            w.bufs[0]->doc.sel_anchor = w.bufs[0]->doc.caret;
            w.bufs[0]->land(8) !>;
            rtx_line_isle_finish(&w.bufs[0]->doc.tree) !>;
            w.bufs[0]->ensure_view(&m, 80.0, 8) !>;
            expect(rtx_line_isle_connected(&w.bufs[0]->doc.tree),
                   "flush island connected");
            {
                size_t abs = 0, plus = 0;
                int gap = rtx_gutter_gap(w.bufs[0],
                                        w.bufs[0]->layout.rows.data[0].byte_start,
                                        w.bufs[0]->layout.rows.data[0].line,
                                        &abs, &plus);
                expect(gap == 0 && abs > 1, "connected gutter before flush");
                want_abs = abs;
                saved_off = w.bufs[0]->seek_off;
            }
            w.safe_flush_all();
        }
        {
            RtxWs w = {0} @destroy;
            char *paths[1];
            size_t abs = 0, plus = 0;
            int gap;
            paths[0] = (char *)mpath;
            w.open_files(1, paths) !>;
            expect(w.bufs[0]->seek_valid, "reopen keeps seeking");
            expect(rtx_line_mark_ok(&w.bufs[0]->doc.tree), "reopen plants mark");
            expect(!w.bufs[0]->doc.index_covers(saved_off),
                   "reopen prefix has not met the camera");
            w.bufs[0]->ensure_view(&m, 80.0, 8) !>;
            expect(!w.bufs[0]->doc.index_covers(saved_off),
                   "ensure_view does not prefix-scan to the camera");
            expect(w.bufs[0]->doc.tree.line_scan_off < saved_off,
                   "prefix cursor stays behind the mark");
            expect(!rtx_line_isle_live(&w.bufs[0]->doc.tree),
                   "mark does not kick a backfill");
            gap = rtx_gutter_gap(w.bufs[0],
                                 w.bufs[0]->layout.rows.data[0].byte_start,
                                 w.bufs[0]->layout.rows.data[0].line, &abs,
                                 &plus);
            expect(gap == 0, "mark gutter is absolute");
            expect(abs == want_abs, "reopen gutter matches flushed line");
            expect(rtx_line_pin_ok(&w.bufs[0]->doc.tree, saved_off),
                   "reopen pin sits on the camera slot");
        }
        {
            RtxWs w = {0} @destroy;
            char *paths[1];
            paths[0] = (char *)mpath;
            w.open_files(1, paths) !>;
            w.bufs[0]->ensure_view(&m, 80.0, 8) !>;
            expect(rtx_line_pin_ok(&w.bufs[0]->doc.tree, w.bufs[0]->seek_off),
                   "pin exists before edit");
            w.bufs[0]->doc.caret = w.bufs[0]->seek_off;
            w.bufs[0]->doc.sel_anchor = w.bufs[0]->doc.caret;
            {
                size_t n = w.bufs[0]->doc.len();
                size_t off = w.bufs[0]->seek_off;
                size_t slot = n ? (size_t)(((unsigned long long)off *
                                           (unsigned long long)RTX_LINE_MARK_MAX) /
                                          (unsigned long long)n) : 0;
                if (slot >= RTX_LINE_MARK_MAX) slot = RTX_LINE_MARK_MAX - 1;
                w.bufs[0]->doc.type("\n") !>;
                expect(w.bufs[0]->doc.tree.pins[slot].line == RTX_LINE_PIN_EMPTY,
                       "edit wipes pins at or after the byte");
            }
            expect(w.bufs[0]->doc.tree.pins[0].line == 0,
                   "BOF pin stays after a later edit");
        }
        /* Local scroll after the island. Load must not key origin_line at
         * seek_off — that pair is the origin line on the camera byte. */
        {
            RtxWs w = {0} @destroy;
            char *paths[1];
            int i;
            size_t land_abs = 0, plus = 0;
            paths[0] = (char *)mpath;
            w.open_files(1, paths) !>;
            mid = w.bufs[0]->doc.len() / 2;
            w.bufs[0]->doc.caret = rtx_doc_line_floor(&w.bufs[0]->doc, mid) !>;
            w.bufs[0]->doc.sel_anchor = w.bufs[0]->doc.caret;
            w.bufs[0]->land(8) !>;
            rtx_line_isle_finish(&w.bufs[0]->doc.tree) !>;
            w.bufs[0]->ensure_view(&m, 80.0, 8) !>;
            (void)rtx_gutter_gap(w.bufs[0],
                                 w.bufs[0]->layout.rows.data[0].byte_start,
                                 w.bufs[0]->layout.rows.data[0].line, &land_abs,
                                 &plus);
            for (i = 0; i < 5; i++)
                w.bufs[0]->scroll_vis(&m, 80.0, 1) !>;
            w.bufs[0]->ensure_view(&m, 80.0, 8) !>;
            expect(w.bufs[0]->seek_valid && w.bufs[0]->seek_rel != 0,
                   "local scroll keeps a relative camera");
            {
                size_t abs = 0;
                int gap = rtx_gutter_gap(w.bufs[0],
                                        w.bufs[0]->layout.rows.data[0].byte_start,
                                        w.bufs[0]->layout.rows.data[0].line,
                                        &abs, &plus);
                expect(gap == 0 && abs != land_abs,
                       "scrolled gutter is not the landing line");
                want_abs = abs;
                saved_off = w.bufs[0]->seek_off;
            }
            w.safe_flush_all();
        }
        {
            RtxWs w = {0} @destroy;
            char *paths[1];
            size_t abs = 0, plus = 0;
            int gap;
            paths[0] = (char *)mpath;
            w.open_files(1, paths) !>;
            w.bufs[0]->ensure_view(&m, 80.0, 8) !>;
            gap = rtx_gutter_gap(w.bufs[0],
                                 w.bufs[0]->layout.rows.data[0].byte_start,
                                 w.bufs[0]->layout.rows.data[0].line, &abs,
                                 &plus);
            expect(gap == 0, "scrolled reopen gutter is absolute");
            expect(abs == want_abs, "scrolled reopen matches the camera line");
            expect(w.bufs[0]->seek_off == saved_off,
                   "scrolled reopen keeps the camera byte");
        }
    }

    /* Browse preview loads the journal (hist + camera). It does not flush. */
    isol_reset();
    write_file(a, "hello\nworld\nthird\n");
    {
        RtxWs w = {0} @destroy;
        char *paths[1];
        paths[0] = (char *)a;
        w.open_files(1, paths) !>;
        w.bufs[0]->doc.type("Z") !>;
        {
            size_t world = rtx_doc_line_floor(&w.bufs[0]->doc, 7) !>;
            w.bufs[0]->doc.caret = world;
            w.bufs[0]->doc.sel_anchor = world;
            w.bufs[0]->land(8) !>;
            w.bufs[0]->doc.sel_anchor = 0;
            w.bufs[0]->doc.caret = 1;
        }
        rtx_layout_set_view(&w.bufs[0]->layout, RTX_VIEW_WRAP);
        w.safe_flush_all();
        expect(rtx_safe_peek_dirty(a), "preview source journal dirty");
    }
    {
        RtxWs w = {0} @destroy;
        char *paths[1];
        RtxBrowse *br;
        RtxBrowsePrev *pv;
        size_t saved = 0;
        paths[0] = (char *)a;
        w.open_files(1, paths) !>;
        expect_text(&w.bufs[0]->doc, "Zhello\nworld\nthird\n",
                    "reopen recovered type");
        saved = w.bufs[0]->seek_valid ? w.bufs[0]->seek_off : w.bufs[0]->doc.caret;
        w.browse_start() !>;
        br = RtxWs_browse(&w);
        rtx_browse_finish(br) !>;
        w.browse_prev_sync(0, &m, 40.0, 8) !>;
        w.browse_prev_flush(0) !>;
        w.browse_prev_sync(0, &m, 40.0, 8) !>;
        pv = &w.prev[0];
        expect(pv->live && pv->kind == RTX_BROWSE_PREV_FILE,
               "preview opened the journaled file");
        expect_text(&pv->doc, "Zhello\nworld\nthird\n",
                    "preview loads recovered hist");
        expect(pv->doc.dirty(), "preview is recovered-dirty");
        expect(rtx_safe_peek_dirty(a), "preview load did not drop the journal");
        expect(pv->cam.seek_valid, "preview kept seeking");
        expect(pv->cam.seek_off == saved, "preview camera is the journaled seek");
        expect(pv->layout.rows.len &&
                   pv->layout.rows.data[0].byte_start == pv->cam.seek_off,
               "preview fill starts at the journaled camera");
        expect(pv->doc.caret == 1 && pv->doc.sel_anchor == 0,
               "preview loads caret and selection");
        expect(pv->layout.view == RTX_VIEW_DEFAULT && pv->layout.wrap == 1,
               "preview loads migrated wrap journal");
    }

    /* A mid-line selection must not clip the first preview row. */
    isol_reset();
    write_file(a, "item_31 ok true\nitem_32 ok false\n");
    {
        RtxWs w = {0} @destroy;
        char *paths[1];
        paths[0] = (char *)a;
        w.open_files(1, paths) !>;
        w.bufs[0]->doc.sel_anchor = 5;
        w.bufs[0]->doc.caret = 8;
        w.bufs[0]->seek_valid = 1;
        w.bufs[0]->seek_off = 5;
        w.safe_flush_all();
    }
    {
        RtxWs w = {0} @destroy;
        char *paths[1];
        RtxBrowse *br;
        RtxBrowsePrev *pv;
        RtxVisRow *row;
        paths[0] = (char *)a;
        w.open_files(1, paths) !>;
        w.browse_start() !>;
        br = RtxWs_browse(&w);
        rtx_browse_finish(br) !>;
        w.browse_prev_sync(0, &m, 40.0, 8) !>;
        w.browse_prev_flush(0) !>;
        w.browse_prev_sync(0, &m, 40.0, 8) !>;
        pv = &w.prev[0];
        expect(pv->live && pv->kind == RTX_BROWSE_PREV_FILE,
               "mid-line preview opened");
        expect(pv->cam.seek_valid && pv->cam.seek_off == 5,
               "mid-line preview kept the camera on the selection");
        expect(pv->doc.caret == 8 && pv->doc.sel_anchor == 5,
               "mid-line preview kept the selection");
        expect(pv->layout.rows.len > 0, "mid-line preview has a row");
        if (pv->layout.rows.len) {
            row = &pv->layout.rows.data[0];
            expect(row->byte_start == 0,
                   "preview first row starts at the line, not the selection");
            expect(row->byte_start + row->byte_len > pv->doc.caret,
                   "preview first row includes the selection");
        }
        pv->cam.seek_valid = 0;
        pv->cam.top_byte = 0;
        pv->doc.sel_anchor = 18;
        pv->doc.caret = 20;
        pv->fill_view = -1;
        w.browse_prev_sync(0, &m, 40.0, 8) !>;
        w.browse_prev_flush(0) !>;
        w.browse_prev_sync(0, &m, 40.0, 8) !>;
        expect(pv->layout.rows.len > 0, "caret-only preview has a row");
        if (pv->layout.rows.len) {
            row = &pv->layout.rows.data[0];
            expect(row->byte_start == 16,
                   "preview first row is the caret's line, not the caret");
            expect(row->byte_start + row->byte_len > pv->doc.caret,
                   "caret-only preview row includes the caret");
        }
    }

    /* ---- BEGIN layout.rich (RTXC v2) ---- */
    /* rich is per pane on RtxLayout; view cycling and reset leave it. */
    isol_reset();
    write_file(a, "hello\nworld\n");
    {
        RtxWs w = {0} @destroy;
        char *paths[1];
        char spath[4096];
        unsigned char sb[8];
        int sfd;
        paths[0] = (char *)a;
        w.open_files(1, paths) !>;
        expect(w.bufs[0]->layout.rich == 1, "rich opens as Rich");
        w.bufs[0]->layout.rich = 1;
        rtx_layout_cycle_view(&w.bufs[0]->layout);
        expect(w.bufs[0]->layout.rich == 1, "cycle_view leaves rich");
        rtx_layout_set_view(&w.bufs[0]->layout, RTX_VIEW_WRAP);
        expect(w.bufs[0]->layout.rich == 1, "set_view leaves rich");
        RtxLayout_reset(&w.bufs[0]->layout);
        expect(w.bufs[0]->layout.rich == 1, "RtxLayout_reset leaves rich");
        w.bufs[0]->doc.caret = 2;
        w.bufs[0]->doc.sel_anchor = 2;
        /* Same-buf split snapshot carries the bit. */
        w.toggle_split();
        expect(RtxWs_same_split(&w), "rich split is same-buf");
        expect(w.cam[0].layout.rich == 1, "pane snapshot copies rich");
        w.toggle_split();
        w.safe_flush_all();
        expect(rtx_safe_state_path(spath, sizeof(spath), a), "rich state path");
        sfd = open(spath, O_RDONLY);
        expect(sfd >= 0, "rich sidecar exists");
        if (sfd >= 0) {
            uint32_t sver;
            expect(read(sfd, sb, 8) == 8, "rich sidecar header");
            close(sfd);
            sver = (uint32_t)sb[4] | ((uint32_t)sb[5] << 8) |
                   ((uint32_t)sb[6] << 16) | ((uint32_t)sb[7] << 24);
            expect(sver == 4 && sver == RTX_SAFE_STATE_VER, "state ver is 4");
        }
    }
    {
        RtxWs w = {0} @destroy;
        char *paths[1];
        paths[0] = (char *)a;
        w.open_files(1, paths) !>;
        expect(w.bufs[0]->layout.rich == 1, "reopen restores rich");
        expect(w.bufs[0]->layout.view == RTX_VIEW_DEFAULT &&
                   w.bufs[0]->layout.wrap == 1,
               "reopen wrap beside rich");
        expect(w.bufs[0]->doc.caret == 2, "reopen caret beside rich");
    }
    /* Browse preview carries rich from the journal. */
    {
        RtxWs w = {0} @destroy;
        char *paths[1];
        RtxBrowse *br;
        RtxBrowsePrev *pv;
        paths[0] = (char *)a;
        w.open_files(1, paths) !>;
        w.browse_start() !>;
        br = RtxWs_browse(&w);
        rtx_browse_finish(br) !>;
        w.browse_prev_sync(0, &m, 40.0, 8) !>;
        w.browse_prev_flush(0) !>;
        w.browse_prev_sync(0, &m, 40.0, 8) !>;
        pv = &w.prev[0];
        expect(pv->live && pv->kind == RTX_BROWSE_PREV_FILE,
               "rich preview opened the file");
        expect(pv->cam.rich == 1, "preview cam loads rich");
        expect(pv->layout.rich == 1, "preview layout takes rich");
    }
    /* A v1 sidecar (no tail) loads rich = 0 with the rest of the camera. */
    {
        char spath[4096];
        unsigned char one[4] = {1, 0, 0, 0};
        int sfd;
        expect(rtx_safe_state_path(spath, sizeof(spath), a), "v1 state path");
        sfd = open(spath, O_RDWR);
        expect(sfd >= 0, "v1 sidecar open");
        if (sfd >= 0) {
            expect(lseek(sfd, 4, SEEK_SET) == 4 && write(sfd, one, 4) == 4,
                   "patch sidecar ver to 1");
            close(sfd);
        }
    }
    {
        RtxWs w = {0} @destroy;
        char *paths[1];
        paths[0] = (char *)a;
        w.open_files(1, paths) !>;
        expect(w.bufs[0]->layout.rich == 0, "v1 sidecar loads rich = 0");
        expect(w.bufs[0]->layout.view == RTX_VIEW_DEFAULT, "v1 sidecar keeps view");
        expect(w.bufs[0]->layout.wrap == 0, "v1 sidecar wrap stays off");
        expect(w.bufs[0]->doc.caret == 2, "v1 sidecar keeps caret");
        expect(w.bufs[0]->doc.sel_anchor == 2, "v1 sidecar keeps sel");
    }
    /* A future sidecar ver is ignored (camera stays at the open default). */
    {
        char spath[4096];
        unsigned char fut[4] = {(unsigned char)(RTX_SAFE_STATE_VER + 1), 0, 0, 0};
        int sfd;
        expect(rtx_safe_state_path(spath, sizeof(spath), a), "future state path");
        sfd = open(spath, O_RDWR);
        if (sfd >= 0) {
            expect(lseek(sfd, 4, SEEK_SET) == 4 && write(sfd, fut, 4) == 4,
                   "patch sidecar ver to future");
            close(sfd);
        }
    }
    {
        RtxWs w = {0} @destroy;
        char *paths[1];
        paths[0] = (char *)a;
        w.open_files(1, paths) !>;
        expect(w.bufs[0]->layout.rich == 1, "future sidecar ignored: rich default");
        expect(w.bufs[0]->doc.caret == 0, "future sidecar ignored: caret 0");
    }
    /* No sidecar: open + browse preview default to Rich. */
    isol_reset();
    write_file(a, "| A | B |\n|---|---|\n| 1 | 2 |\n");
    {
        RtxWs w = {0} @destroy;
        char *paths[1];
        RtxBrowse *br;
        RtxBrowsePrev *pv;
        paths[0] = (char *)a;
        w.open_files(1, paths) !>;
        expect(w.bufs[0]->layout.rich == 1, "no sidecar opens Rich");
        expect(w.bufs[0]->layout.wrap == 1, "no sidecar opens wrap");
        w.browse_start() !>;
        br = RtxWs_browse(&w);
        rtx_browse_finish(br) !>;
        w.browse_prev_sync(0, &m, 40.0, 8) !>;
        w.browse_prev_flush(0) !>;
        w.browse_prev_sync(0, &m, 40.0, 8) !>;
        pv = &w.prev[0];
        expect(pv->live && pv->kind == RTX_BROWSE_PREV_FILE,
               "default-rich preview opened");
        expect(pv->cam.rich == 1 && pv->layout.rich == 1,
               "preview defaults to Rich without a journal");
        expect(pv->cam.wrap == 1 && pv->layout.wrap == 1,
               "preview defaults to wrap without a journal");
        expect(pv->layout.md_ntab >= 1,
               "rich preview classifies the MD table");
    }
    /* ---- END layout.rich (RTXC v2) ---- */

    /* Browse divider is a workspace preference, not part of the file list. */
    isol_reset();
    write_file(a, "hello\n");
    {
        RtxWs w = {0} @destroy;
        char *paths[1];
        paths[0] = (char *)a;
        w.open_files(1, paths) !>;
        w.browse_split[0] = 420;
        w.browse_split[1] = 610;
        w.safe_flush_all();
    }
    {
        RtxWs w = {0} @destroy;
        char *paths[1];
        paths[0] = (char *)a;
        w.open_files(1, paths) !>;
        expect(w.browse_split[0] == 420, "split pane 0 restored with a path");
        expect(w.browse_split[1] == 610, "split pane 1 restored with a path");
    }
    {
        RtxWs w = {0} @destroy;
        w.open_files(0, NULL) !>;
        expect(w.browse_split[0] == 420, "split pane 0 restored with no argv");
        expect(w.browse_split[1] == 610, "split pane 1 restored with no argv");
    }

    /* next_buf onto the other pane's buffer is a same-file split: the
     * panes get separate cameras, not one shared camera. */
    isol_reset();
    write_file(a, "hello\n");
    write_file(b, "other\n");
    {
        RtxWs w = {0} @destroy;
        char *paths[2];
        paths[0] = (char *)a;
        paths[1] = (char *)b;
        w.open_files(2, paths) !>;
        expect(w.npanes == 2 && w.pane[0] == 0 && w.pane[1] == 1, "two panes, two files");
        w.set_focus(0);
        w.next_buf();
        expect(w.pane[0] == 1 && w.pane[1] == 1, "next_buf lands on the other pane's buffer");
        expect(RtxWs_same_split(&w), "next_buf onto the other pane seeds the split camera");
        w.bufs[1]->top_byte = 3;
        w.focus_other();
        expect(w.bufs[1]->top_byte == 0, "other pane keeps its own camera");
        w.focus_other();
        expect(w.bufs[1]->top_byte == 3, "focused pane camera comes back");
        w.prev_buf();
        w.prev_buf();
        expect(w.pane[0] == 1 && RtxWs_same_split(&w), "prev_buf round trip reseeds");
    }

    /* Snapshot panes restore by path. An entry that does not come back
     * (deleted) must not shift the other panes onto the wrong files. */
    {
        const char *c = "testdata/generated/safe_c.txt";
        isol_reset();
        write_file(a, "hello\n");
        write_file(b, "other\n");
        write_file(c, "third\n");
        {
            RtxWs w = {0} @destroy;
            char *paths[3];
            paths[0] = (char *)a;
            paths[1] = (char *)b;
            paths[2] = (char *)c;
            w.open_files(3, paths) !>;
            w.pane[0] = 2;
            w.pane[1] = 1;
            w.sync_live() !>;
        }
        unlink(a);
        {
            RtxWs w = {0} @destroy;
            w.open_files(0, NULL) !>;
            expect(w.len == 2 && w.npanes == 2, "restore without the deleted file");
            expect(w.bufs[w.pane[0]]->doc.path.ptr &&
                       strstr(w.bufs[w.pane[0]]->doc.path.ptr, "safe_c.txt"),
                   "pane 0 restores its own file by path");
            expect(w.bufs[w.pane[1]]->doc.path.ptr &&
                       strstr(w.bufs[w.pane[1]]->doc.path.ptr, "safe_b.txt"),
                   "pane 1 restores its own file by path");
        }
        /* An untitled buffer is not written, so it cannot shift the slots. */
        isol_reset();
        write_file(a, "hello\n");
        {
            RtxWs w = {0} @destroy;
            char *paths[2];
            paths[0] = (char *)b;
            paths[1] = (char *)c;
            w.open_files(0, NULL) !>;
            expect(w.untitled(), "untitled boot for the slot test");
            w.add_path(cc_slice_cstr(paths[0])) !>;
            w.add_path(cc_slice_cstr(paths[1])) !>;
            w.npanes = 2;
            w.pane[0] = 2;
            w.pane[1] = 0;
            w.sync_live() !>;
        }
        {
            RtxWs w = {0} @destroy;
            w.open_files(0, NULL) !>;
            expect(w.len == 2, "restore lists the two named files");
            expect(w.bufs[w.pane[0]]->doc.path.ptr &&
                       strstr(w.bufs[w.pane[0]]->doc.path.ptr, "safe_c.txt"),
                   "untitled before it does not shift pane 0");
        }
        write_file(a, "hello\n");
        unlink(c);
    }

    /* Two spellings of one file open one document (one journal). */
    isol_reset();
    write_file(a, "hello\n");
    {
        RtxWs w = {0} @destroy;
        char *paths[3];
        char dot[256];
        char abs_a[4096];
        snprintf(dot, sizeof(dot), "./%s", a);
        expect(realpath(a, abs_a) != NULL, "realpath a");
        paths[0] = (char *)a;
        paths[1] = dot;
        paths[2] = abs_a;
        w.open_files(3, paths) !>;
        expect(w.len == 1, "a.txt ./a.txt /abs/a.txt is one buffer");
        expect(w.npanes == 1, "deduped open is one pane");
    }

    /* A parked file that was deleted / renamed: its pane must not show a
     * zeroed doc, the fault is visible, and the other pane still comes back. */
    {
        const char *c = "testdata/generated/safe_c.txt";
        isol_reset();
        write_file(a, "hello\n");
        write_file(b, "other\n");
        write_file(c, "third\n");
        {
            RtxWs w = {0} @destroy;
            char *paths[3];
            char msg[512];
            paths[0] = (char *)a;
            paths[1] = (char *)b;
            paths[2] = (char *)c;
            w.open_files(3, paths) !>;
            w.npanes = 1;
            w.pane[0] = 1;
            w.sync_live() !>;
            expect(w.bufs[0]->parked && w.bufs[2]->parked, "a and c parked");
            unlink(a);
            w.npanes = 2;
            w.pane[0] = 0;
            w.pane[1] = 2;
            expect(sync_ok(&w), "sync_live keeps going past a missing file");
            expect(w.pane[1] == 2 && !w.bufs[2]->parked, "the other pane still unparks");
            expect(w.pane[0] != 0 && !w.bufs[w.pane[0]]->parked,
                   "the missing file's pane moves to a live buffer");
            expect(w.bufs[0]->parked && w.bufs[0]->park_fault, "missing file stays parked, marked");
            expect(rtx_ws_safe_fault_msg(&w, msg, sizeof(msg)) &&
                       strstr(msg, "could not be reopened"),
                   "missing file is on the status bar");
            write_file(a, "back\n");
            w.pane[0] = 0;
            expect(sync_ok(&w) && w.pane[0] == 0 && !w.bufs[0]->parked &&
                       !w.bufs[0]->park_fault,
                   "file back: the buffer unparks and the fault clears");
        }
        /* Dirty + deleted, with a pinned base: the edits come back and Save
         * recreates the file. */
        isol_reset();
        write_file(a, "hello\n");
        write_file(b, "other\n");
        {
            RtxWs w = {0} @destroy;
            char *paths[1];
            paths[0] = (char *)a;
            w.open_files(1, paths) !>;
            w.bufs[0]->doc.type("z") !>;
            w.add_path(cc_slice_cstr(b)) !>;
            w.npanes = 1;
            w.pane[0] = 1;
            w.sync_live() !>;
            expect(w.bufs[0]->parked, "dirty a parked before delete");
            unlink(a);
            w.pane[0] = 0;
            expect(sync_ok(&w), "dirty deleted file: sync ok");
            expect(w.pane[0] == 0 && !w.bufs[0]->parked, "dirty deleted file comes back from its pin");
            expect_text(&w.bufs[0]->doc, "zhello\n", "deleted file's edits recovered");
            expect(w.bufs[0]->doc.dirty(), "deleted file's edits are dirty");
            w.bufs[0]->doc.save() !>;
            expect(file_is(a, "zhello\n"), "save recreates the deleted file");
        }
        unlink(c);
    }

    if (fails) {
        fprintf(stderr, "safe_smoke: %d failure(s)\n", fails);
        return 1;
    }
    printf("safe_smoke ok\n");
    return 0;
}
