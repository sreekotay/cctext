#!ccc ccs
/*
 * Workbook dump tool (docs/workbook.md): open a `*.wb.md`, settle its
 * jobs, and print every cell / name value (rtx_wb_dump_ex with bits,
 * aggregate instances and spans). With `-e expr`, evaluate expressions
 * instead. `-x off n text` edits the document first (the incremental
 * path; `-u` / `-r` undo / redo) and `-s` settles before each next edit;
 * `-p` prints the plain dump (the fixtures' .expect format).
 * A debugging aid for the engine and the fixtures.
 *
 *   ./bin/wb_dump file.wb.md [-x off n text | -u | -r]... [-e expr]...
 */
#include <ccc/std/prelude.cch>
#include <ccc/stdio.cch>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include "../core/document.cch"
#include "../core/wb.cch"

static char g_out[1 << 24];

int main(int argc, char **argv) {
    RtxDoc d = {0};
    RtxWb *wb;
    int i, any = 0, plain = 0;
    @errhandler(CCError e) {
        cc_error_log(e);
        return 1;
    }
    if (argc < 2) {
        fprintf(stderr, "usage: wb_dump file.wb.md [-e expr]...\n");
        return 2;
    }
    d.from_path(cc_slice_cstr(argv[1])) !>;
    wb = rtx_wb_of(&d);
    if (!wb) {
        fprintf(stderr, "wb_dump: %s is not a workbook\n", argv[1]);
        return 1;
    }
    rtx_wb_settle(wb, &d);
    for (i = 2; i < argc; i++) {
        if (!strcmp(argv[i], "-x") && i + 3 < argc) {
            size_t off = (size_t)strtoull(argv[i + 1], NULL, 10);
            size_t n = (size_t)strtoull(argv[i + 2], NULL, 10);
            const char *t = argv[i + 3];
            size_t tn = strlen(t);
            d.replace(off, n, tn ? cc_slice_from_buffer((char *)t, tn) : cc_slice_empty()) !>;
            i += 3;
        } else if (!strcmp(argv[i], "-u")) {
            d.undo() !>;
        } else if (!strcmp(argv[i], "-r")) {
            d.redo() !>;
        } else if (!strcmp(argv[i], "-p")) {
            plain = 1;
        } else if (!strcmp(argv[i], "-s")) {
            rtx_wb_settle(wb, &d);
        }
    }
    rtx_wb_settle(wb, &d);
    for (i = 2; i + 1 < argc; i++) {
        if (strcmp(argv[i], "-e")) continue;
        any = 1;
        rtx_wb_eval(wb, &d, argv[i + 1], strlen(argv[i + 1]), g_out, sizeof g_out);
        printf("%s = %s\n", argv[i + 1], g_out);
    }
    if (!any) {
        if (plain) rtx_wb_dump(wb, &d, g_out, sizeof g_out);
        else rtx_wb_dump_ex(wb, &d, RTX_WB_DUMP_BITS | RTX_WB_DUMP_MAS, g_out, sizeof g_out);
        fputs(g_out, stdout);
    }
    RtxDoc_destroy(&d);
    return 0;
}
