#!ccc ccs
/*
 * Images (docs/images.md): the loader on every format, broken and hostile
 * inputs, limits before allocation, EXIF orientation, the cache budget,
 * the path policy and its persisted allowances, and the remote flow
 * against a local HTTP server (never fetched without consent; caching,
 * the byte cap, the timeout). Fixtures: testdata/img (tests/img_gen.py).
 */
#include <ccc/std/prelude.cch>
#include <arpa/inet.h>
#include <errno.h>
#include <limits.h>
#include <netinet/in.h>
#include <pthread.h>
#include <stdatomic.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <sys/socket.h>
#include <sys/stat.h>
#include <time.h>
#include <unistd.h>
#include "../core/img.cch"
#include "../core/img_resize.h"
#include "../core/img_wuffs.h"
void rtx_safe_test_isol(void);

/* The huge-shrink bound (box prefilter in play); TSan runs it ~5x slower. */
#if defined(__SANITIZE_THREAD__) || defined(__SANITIZE_ADDRESS__)
#define RTX_RS_HUGE_MS 2500
#elif defined(__has_feature)
#if __has_feature(thread_sanitizer) || __has_feature(address_sanitizer)
#define RTX_RS_HUGE_MS 2500
#endif
#endif
#ifndef RTX_RS_HUGE_MS
#define RTX_RS_HUGE_MS 250
#endif

static int fails = 0;

static void expect(int cond, const char *msg) {
    if (!cond) {
        fprintf(stderr, "FAIL: %s\n", msg);
        fails++;
    }
}

static uint8_t *slurp(const char *path, size_t *n) {
    FILE *fp = fopen(path, "rb");
    long sz;
    uint8_t *b;
    *n = 0;
    if (!fp) return NULL;
    fseek(fp, 0, SEEK_END);
    sz = ftell(fp);
    fseek(fp, 0, SEEK_SET);
    b = (uint8_t *)malloc((size_t)sz + 1);
    if (b && fread(b, 1, (size_t)sz, fp) != (size_t)sz) {
        free(b);
        b = NULL;
    }
    fclose(fp);
    if (b) *n = (size_t)sz;
    return b;
}

static long now_ms(void) {
    struct timespec ts;
    clock_gettime(CLOCK_MONOTONIC, &ts);
    return (long)ts.tv_sec * 1000 + ts.tv_nsec / 1000000;
}

/* Pixel (x, y) of an RGBA bitmap near an RGB colour (JPEG slack). */
static int near_rgb(const RtxImgBmp *b, uint32_t x, uint32_t y, int r, int g, int bl, int tol) {
    const uint8_t *p = b->px + (size_t)y * b->stride + (size_t)x * 4;
    return abs(p[0] - r) <= tol && abs(p[1] - g) <= tol && abs(p[2] - bl) <= tol;
}

static void test_formats(void) {
    static const char *names[] = {"quad.png", "quad.jpg", "quad.gif", "quad.bmp",
                                  "quad.webp", "quad.qoi", NULL};
    static const int fmts[] = {RTX_IMG_FMT_PNG, RTX_IMG_FMT_JPEG, RTX_IMG_FMT_GIF,
                               RTX_IMG_FMT_BMP, RTX_IMG_FMT_WEBP, RTX_IMG_FMT_QOI};
    int i;
    for (i = 0; names[i]; i++) {
        char path[256], msg[256];
        size_t n;
        uint8_t *b;
        RtxImgInfo info;
        RtxImgBmp bmp;
        int rc;
        snprintf(path, sizeof path, "testdata/img/%s", names[i]);
        b = slurp(path, &n);
        snprintf(msg, sizeof msg, "%s: read", names[i]);
        expect(b != NULL, msg);
        if (!b) continue;
        rc = rtx_img_probe(b, n, 1, rtx_img_limits(), &info);
        snprintf(msg, sizeof msg, "%s: probe ok (%d)", names[i], rc);
        expect(rc == RTX_IMG_OK, msg);
        snprintf(msg, sizeof msg, "%s: format + 32x24", names[i]);
        expect(info.fmt == fmts[i] && info.w == 32 && info.h == 24, msg);
        /* A prefix too short for the header asks for more. */
        rc = rtx_img_probe(b, 12, 0, rtx_img_limits(), &info);
        snprintf(msg, sizeof msg, "%s: short prefix -> MORE (%d)", names[i], rc);
        expect(rc == RTX_IMG_MORE || (rc == RTX_IMG_OK && info.w == 32), msg);
        rc = rtx_img_decode(b, n, rtx_img_limits(), 0, 0, RTX_IMG_PIX_RGBA, 1, NULL, &bmp,
                            &info);
        snprintf(msg, sizeof msg, "%s: decode ok (%d)", names[i], rc);
        expect(rc == RTX_IMG_OK && bmp.w == 32 && bmp.h == 24 && bmp.nframe == 1, msg);
        if (rc == RTX_IMG_OK) {
            int tol = fmts[i] == RTX_IMG_FMT_JPEG ? 24 : (fmts[i] == RTX_IMG_FMT_GIF ? 12 : 1);
            snprintf(msg, sizeof msg, "%s: quadrant colours", names[i]);
            expect(near_rgb(&bmp, 4, 4, 220, 30, 30, tol) &&
                       near_rgb(&bmp, 28, 4, 30, 200, 40, tol) &&
                       near_rgb(&bmp, 4, 20, 40, 60, 220, tol) &&
                       near_rgb(&bmp, 28, 20, 250, 250, 250, tol),
                   msg);
            if (fmts[i] == RTX_IMG_FMT_PNG || fmts[i] == RTX_IMG_FMT_WEBP ||
                fmts[i] == RTX_IMG_FMT_QOI) {
                snprintf(msg, sizeof msg, "%s: transparent pixel kept", names[i]);
                expect(bmp.px[3] == 0, msg);
            }
        }
        rtx_img_bmp_free(&bmp);
        /* Scaled decode keeps only the small result. */
        rc = rtx_img_decode(b, n, rtx_img_limits(), 16, 0, RTX_IMG_PIX_BGRA_PREMUL, 1, NULL,
                            &bmp, &info);
        snprintf(msg, sizeof msg, "%s: scaled to 16x12", names[i]);
        expect(rc == RTX_IMG_OK && bmp.w == 16 && bmp.h == 12 && bmp.bytes == 16 * 12 * 4, msg);
        rtx_img_bmp_free(&bmp);
        free(b);
    }
}

static void test_broken(void) {
    static const struct {
        const char *name;
        int want;
    } cases[] = {
        {"trunc.png", RTX_IMG_ETRUNC},   {"trunc.jpg", RTX_IMG_ETRUNC},
        {"corrupt.png", RTX_IMG_ECORRUPT}, {"garbage.png", RTX_IMG_EFORMAT},
        {"bomb_dim.png", RTX_IMG_EDIM},  {"bomb_px.png", RTX_IMG_EPX},
        {NULL, 0},
    };
    int i;
    for (i = 0; cases[i].name; i++) {
        char path[256], msg[256];
        size_t n;
        uint8_t *b;
        RtxImgInfo info;
        RtxImgBmp bmp;
        int rc;
        long t0;
        snprintf(path, sizeof path, "testdata/img/%s", cases[i].name);
        b = slurp(path, &n);
        if (!b) {
            expect(0, cases[i].name);
            continue;
        }
        t0 = now_ms();
        rc = rtx_img_decode(b, n, rtx_img_limits(), 0, 0, RTX_IMG_PIX_RGBA, 1, NULL, &bmp,
                            &info);
        snprintf(msg, sizeof msg, "%s: decode -> %d (got %d)", cases[i].name, cases[i].want, rc);
        /* A corrupt stream may also read as truncated; both are refusals. */
        expect(rc == cases[i].want ||
                   (cases[i].want == RTX_IMG_ECORRUPT && rc == RTX_IMG_ETRUNC) ||
                   (cases[i].want == RTX_IMG_ETRUNC && rc == RTX_IMG_ECORRUPT),
               msg);
        expect(bmp.px == NULL && bmp.bytes == 0, "failed decode holds nothing");
        if (cases[i].want == RTX_IMG_EDIM || cases[i].want == RTX_IMG_EPX) {
            /* Refused from the 33-byte header: the claimed canvas (up to
             * 40 GB) was never allocated, and it took no time. */
            snprintf(msg, sizeof msg, "%s: header names the size", cases[i].name);
            expect(info.cw >= 12000 && info.ch >= 12000, msg);
            expect(now_ms() - t0 < 50, "bomb refused at once");
            rc = rtx_img_probe(b, n, 1, rtx_img_limits(), &info);
            expect(rc == cases[i].want, "probe applies the same limit");
        }
        free(b);
    }
    {
        /* The file limit is checked before reading pixels, too. */
        RtxImgLimits l = *rtx_img_limits();
        size_t n;
        uint8_t *b = slurp("testdata/img/big.png", &n);
        RtxImgBmp bmp;
        l.file_max = 100;
        expect(rtx_img_decode(b, n, &l, 0, 0, 0, 1, NULL, &bmp, NULL) == RTX_IMG_EFILE,
               "file limit");
        l = *rtx_img_limits();
        l.dim_max = 1000;
        expect(rtx_img_decode(b, n, &l, 0, 0, 0, 1, NULL, &bmp, NULL) == RTX_IMG_EDIM,
               "dimension limit setting");
        l = *rtx_img_limits();
        l.px_max = 1000000;
        expect(rtx_img_decode(b, n, &l, 0, 0, 0, 1, NULL, &bmp, NULL) == RTX_IMG_EPX,
               "megapixel limit setting");
        l = *rtx_img_limits();
        l.budget = 1000;
        expect(rtx_img_decode(b, n, &l, 100, 0, 0, 1, NULL, &bmp, NULL) == RTX_IMG_EBUDGET,
               "budget limit on the scaled result");
        {
            _Atomic int stop = 1;
            expect(rtx_img_decode(b, n, rtx_img_limits(), 64, 0, 0, 1, &stop, &bmp, NULL) ==
                       RTX_IMG_ECANCEL,
                   "cancel flag stops a decode");
        }
        {
            RtxImgInfo info;
            long t0 = now_ms();
            int rc = rtx_img_decode(b, n, rtx_img_limits(), 300, 200, RTX_IMG_PIX_RGBA, 1, NULL,
                                    &bmp, &info);
            expect(rc == RTX_IMG_OK && bmp.w == 267 && bmp.h == 200, "fit 1200x900 into 300x200");
            expect(info.w == 1200 && info.h == 900, "natural size reported");
            if (rc == RTX_IMG_OK)
                expect(near_rgb(&bmp, 10, 10, 220, 30, 30, 2) &&
                           near_rgb(&bmp, 250, 190, 250, 250, 250, 2),
                       "scaled colours");
            printf("img: 1200x900 png -> 267x200 in %ld ms\n", now_ms() - t0);
            rtx_img_bmp_free(&bmp);
        }
        free(b);
    }
}

static void test_exif(void) {
    int o;
    for (o = 1; o <= 9; o++) {
        char path[256], msg[256];
        size_t n;
        uint8_t *b;
        RtxImgInfo info;
        RtxImgBmp bmp;
        int rc;
        if (o == 9) snprintf(path, sizeof path, "testdata/img/exif6.png");
        else snprintf(path, sizeof path, "testdata/img/exif%d.jpg", o);
        b = slurp(path, &n);
        if (!b) {
            expect(0, path);
            continue;
        }
        expect(rtx_img_exif_orient(b, n) == (o == 9 ? 6 : o), "exif tag read");
        rc = rtx_img_decode(b, n, rtx_img_limits(), 0, 0, RTX_IMG_PIX_RGBA, 1, NULL, &bmp,
                            &info);
        snprintf(msg, sizeof msg, "%s: displayed 40x20 (rc %d, %ux%u)", path, rc, bmp.w, bmp.h);
        expect(rc == RTX_IMG_OK && bmp.w == 40 && bmp.h == 20 && info.w == 40 && info.h == 20,
               msg);
        if (rc == RTX_IMG_OK) {
            snprintf(msg, sizeof msg, "%s: quadrants upright", path);
            expect(near_rgb(&bmp, 4, 4, 220, 30, 30, 30) &&
                       near_rgb(&bmp, 35, 4, 30, 200, 40, 30) &&
                       near_rgb(&bmp, 4, 15, 40, 60, 220, 30) &&
                       near_rgb(&bmp, 35, 15, 250, 250, 250, 30),
                   msg);
        }
        rtx_img_bmp_free(&bmp);
        free(b);
    }
}

static void test_anim(void) {
    size_t n;
    uint8_t *b = slurp("testdata/img/anim.gif", &n);
    RtxImgBmp bmp;
    int rc;
    if (!b) {
        expect(0, "anim.gif");
        return;
    }
    rc = rtx_img_decode(b, n, rtx_img_limits(), 0, 0, RTX_IMG_PIX_RGBA, 1, NULL, &bmp, NULL);
    expect(rc == RTX_IMG_OK && bmp.nframe == 1 && !bmp.delay, "animation off: first frame only");
    if (rc == RTX_IMG_OK) expect(near_rgb(&bmp, 8, 8, 220, 30, 30, 8), "first frame colour");
    rtx_img_bmp_free(&bmp);
    rc = rtx_img_decode(b, n, rtx_img_limits(), 0, 0, RTX_IMG_PIX_RGBA, 64, NULL, &bmp, NULL);
    expect(rc == RTX_IMG_OK && bmp.nframe == 3 && bmp.delay, "animation on: 3 frames");
    if (rc == RTX_IMG_OK && bmp.delay) {
        RtxImgBmp f2 = bmp;
        f2.px = bmp.px + 2 * (size_t)bmp.h * bmp.stride;
        expect(bmp.delay[0] == 100 && bmp.delay[1] == 200 && bmp.delay[2] == 300, "delays");
        expect(near_rgb(&f2, 8, 8, 40, 60, 220, 8), "third frame colour");
    }
    rtx_img_bmp_free(&bmp);
    rc = rtx_img_decode(b, n, rtx_img_limits(), 0, 0, RTX_IMG_PIX_RGBA, 2, NULL, &bmp, NULL);
    expect(rc == RTX_IMG_OK && bmp.nframe == 2, "frame cap");
    rtx_img_bmp_free(&bmp);
    free(b);
}

static void test_md(void) {
    size_t lo, hi, alo, ahi, slo, shi;
    const char *s1 = "![a cat](img/cat.png \"Title\")";
    const char *s2 = "  ![x](<a b.png>)  ";
    const char *s3 = "text ![x](a.png)";
    const char *s4 = "![x](a.png) and more";
    const char *s5 = "![nested [br]](p(1).png)";
    expect(rtx_img_md_line(s1, strlen(s1), &lo, &hi, &alo, &ahi, &slo, &shi) && lo == 0 &&
               hi == strlen(s1) && ahi - alo == 5 && shi - slo == 11 &&
               memcmp(s1 + slo, "img/cat.png", 11) == 0,
           "md: title stripped");
    expect(rtx_img_md_line(s2, strlen(s2), &lo, &hi, &alo, &ahi, &slo, &shi) &&
               memcmp(s2 + slo, "a b.png", 7) == 0 && shi - slo == 7,
           "md: angle brackets");
    expect(!rtx_img_md_line(s3, strlen(s3), &lo, &hi, &alo, &ahi, &slo, &shi),
           "md: text before is no image line");
    expect(!rtx_img_md_line(s4, strlen(s4), &lo, &hi, &alo, &ahi, &slo, &shi),
           "md: text after is no image line");
    expect(rtx_img_md_line(s5, strlen(s5), &lo, &hi, &alo, &ahi, &slo, &shi) &&
               memcmp(s5 + slo, "p(1).png", 8) == 0,
           "md: nested brackets / parens");
    {
        /* The stand-in fits its buffer whatever the alt and the host. */
        RtxImgView v;
        char out[96], alt[300];
        size_t n;
        memset(&v, 0, sizeof v);
        memset(alt, 'a', sizeof alt);
        v.state = RTX_IMG_S_ASK;
        v.src.kind = RTX_IMG_SRC_REMOTE;
        memset(v.src.host, 'h', 250);
        v.src.host[250] = 0;
        n = rtx_img_standin(&v, alt, sizeof alt, out, sizeof out);
        expect(n < sizeof out && out[n] == 0 && out[n - 1] == ']' &&
                   strncmp(out, "[image:", 7) == 0,
               "standin: long host and alt fit");
        v.state = RTX_IMG_S_INFO;
        v.have_info = 1;
        v.info.w = 640;
        v.info.h = 480;
        n = rtx_img_standin(&v, "cat", 3, out, sizeof out);
        expect(n == strlen("[image: cat 640x480]") && strcmp(out, "[image: cat 640x480]") == 0,
               "standin: alt and size");
        n = rtx_img_standin(&v, alt, sizeof alt, out, sizeof out);
        expect(n < sizeof out && strstr(out, "..") && strstr(out, " 640x480]"),
               "standin: a long alt is cut, the size kept");
    }
}

/* ---- policy ------------------------------------------------------------ */

static void sh(const char *cmd) {
    if (system(cmd) != 0) fprintf(stderr, "cmd failed: %s\n", cmd);
}

#define PROJ "testdata/generated/imgproj"
#define OUTD "testdata/generated/imgout"

static void test_policy(void) {
    RtxImgSrc s;
    char doc[512], cwd[400];
    if (!getcwd(cwd, sizeof cwd)) return;
    sh("rm -rf " PROJ " " OUTD " && mkdir -p " PROJ "/.git " PROJ "/sub " OUTD);
    sh("cp testdata/img/quad.png " PROJ "/pic.png && cp testdata/img/quad.png " PROJ
       "/sub/a%20b.png && cp testdata/img/quad.jpg " OUTD "/x.jpg && cp testdata/img/quad.gif " OUTD
       "/y.gif");
    sh("ln -s ../imgout/x.jpg " PROJ "/link.jpg");
    snprintf(doc, sizeof doc, "%s/" PROJ "/doc.md", cwd);
    expect(rtx_img_resolve(doc, "pic.png", 7, &s) == RTX_IMG_OK && s.kind == RTX_IMG_SRC_LOCAL,
           "policy: inside the project");
    expect(rtx_img_resolve(doc, "sub/a%2520b.png", 15, &s) == RTX_IMG_OK,
           "policy: percent-decoded");
    expect(rtx_img_resolve(doc, "missing.png", 11, &s) == RTX_IMG_EIO, "policy: missing file");
    expect(rtx_img_resolve(doc, "../imgout/x.jpg", 15, &s) == RTX_IMG_EDENIED,
           "policy: .. escape denied");
    expect(rtx_img_resolve(doc, "sub/../../imgout/x.jpg", 22, &s) == RTX_IMG_EDENIED,
           "policy: nested .. escape denied");
    expect(rtx_img_resolve(doc, "link.jpg", 8, &s) == RTX_IMG_EDENIED,
           "policy: symlink escape denied");
    expect(strstr(s.key, "imgout/x.jpg") != NULL, "policy: key is the real path");
    /* Allow this file: persisted, survives a reload, revoked by the command. */
    expect(rtx_img_allow(doc, &s, RTX_IMG_ALLOW_FILE), "policy: allow file stored");
    rtx_img_policy_reload();
    expect(rtx_img_resolve(doc, "link.jpg", 8, &s) == RTX_IMG_OK, "policy: allowed file (link)");
    expect(rtx_img_resolve(doc, "../imgout/x.jpg", 15, &s) == RTX_IMG_OK,
           "policy: allowed file (direct)");
    expect(rtx_img_resolve(doc, "../imgout/y.gif", 15, &s) == RTX_IMG_EDENIED,
           "policy: file allowance is one file");
    expect(rtx_img_revoke(doc) >= 1, "policy: revoke counts");
    rtx_img_policy_reload();
    expect(rtx_img_resolve(doc, "../imgout/x.jpg", 15, &s) == RTX_IMG_EDENIED,
           "policy: revoked");
    /* Allow this directory. */
    rtx_img_resolve(doc, "../imgout/x.jpg", 15, &s);
    expect(rtx_img_allow(doc, &s, RTX_IMG_ALLOW_DIR), "policy: allow dir stored");
    rtx_img_policy_reload();
    expect(rtx_img_resolve(doc, "../imgout/y.gif", 15, &s) == RTX_IMG_OK,
           "policy: dir allowance covers siblings");
    rtx_img_revoke(doc);
    /* Allow ALL local images. */
    rtx_img_resolve(doc, "../imgout/y.gif", 15, &s);
    expect(rtx_img_allow(doc, &s, RTX_IMG_ALLOW_ALL_LOCAL), "policy: allow all stored");
    rtx_img_policy_reload();
    {
        char abs[600];
        snprintf(abs, sizeof abs, "%s/" OUTD "/x.jpg", cwd);
        expect(rtx_img_resolve(doc, abs, strlen(abs), &s) == RTX_IMG_OK,
               "policy: all local covers absolute paths");
    }
    {
        /* Another project keeps its own allowances. */
        char other[600];
        sh("mkdir -p testdata/generated/imgproj2/.git");
        snprintf(other, sizeof other, "%s/testdata/generated/imgproj2/doc.md", cwd);
        expect(rtx_img_resolve(other, "../imgout/x.jpg", 15, &s) == RTX_IMG_EDENIED,
               "policy: allowances are per project");
    }
    rtx_img_revoke(doc);
    rtx_img_policy_reload();
    expect(rtx_img_resolve(doc, "../imgout/y.gif", 15, &s) == RTX_IMG_EDENIED,
           "policy: all revoked");
    expect(rtx_img_resolve(NULL, "pic.png", 7, &s) == RTX_IMG_ESRC,
           "policy: untitled has no relative base");
    {
        /* data: URIs up to the limit. */
        static const char png1[] =
            "data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mP8"
            "z8BQDwAEhQGAhKmMIQAAAABJRU5ErkJggg==";
        RtxImgView v;
        expect(rtx_img_resolve(doc, png1, strlen(png1), &s) == RTX_IMG_OK &&
                   s.kind == RTX_IMG_SRC_DATA,
               "data: resolves");
        rtx_img_want(&s, 10, 10, &v);
        rtx_img_finish();
        rtx_img_want(&s, 10, 10, &v);
        expect(v.state == RTX_IMG_S_OK && v.bmp && v.bmp->w == 1 && v.bmp->h == 1,
               "data: 1x1 png decodes");
        {
            size_t big = (1u << 20) * 2;
            char *d = (char *)malloc(big + 32);
            memcpy(d, "data:image/png;base64,", 22);
            memset(d + 22, 'A', big);
            expect(rtx_img_resolve(doc, d, big + 22, &s) == RTX_IMG_EDATA,
                   "data: over 1 MiB refused");
            free(d);
        }
    }
    {
        /* Paths are document relative, and a deck two levels down may
         * reach up to the project's docs/ with no prompt (as
         * testdata/slides/demo.md does). */
        char deck[512], shot[512], want[PATH_MAX];
        FILE *f;
        sh("mkdir -p " PROJ "/testdata/slides " PROJ "/docs && cp testdata/img/quad.png " PROJ
           "/docs/shot.png");
        snprintf(deck, sizeof deck, "%s/" PROJ "/testdata/slides/demo.md", cwd);
        snprintf(shot, sizeof shot, "%s/" PROJ "/docs/shot.png", cwd);
        expect(rtx_img_resolve(deck, "../../docs/shot.png", 19, &s) == RTX_IMG_OK &&
                   realpath(shot, want) && strcmp(s.key, want) == 0,
               "policy: deck-relative ../../docs inside the project");
        expect(rtx_img_resolve(deck, "docs/shot.png", 13, &s) == RTX_IMG_EIO,
               "policy: not project-root relative");
        f = fopen("testdata/slides/../../docs/cctext-ui-linux.png", "rb");
        expect(f != NULL, "demo deck: bg image exists beside the deck's path");
        if (f) fclose(f);
        f = fopen("testdata/slides/../../docs/cctext-ui-linux-md.png", "rb");
        expect(f != NULL, "demo deck: w:320 image exists beside the deck's path");
        if (f) fclose(f);
    }
}

static void test_cache(void) {
    char cwd[400], doc[512];
    RtxImgLimits *l = rtx_img_limits();
    RtxImgLimits save = *l;
    static const char *srcs[] = {"a.png", "b.png", "c.png", "d.png"};
    RtxImgSrc s[4];
    RtxImgView v;
    int i, round;
    if (!getcwd(cwd, sizeof cwd)) return;
    snprintf(doc, sizeof doc, "%s/" PROJ "/doc.md", cwd);
    for (i = 0; i < 4; i++) {
        char cmd[256];
        snprintf(cmd, sizeof cmd, "cp testdata/img/quad.png " PROJ "/%s", srcs[i]);
        sh(cmd);
    }
    rtx_img_reset();
    /* Room for two 32x24 bitmaps. */
    l->budget = 32 * 24 * 4 * 2 + 100;
    for (i = 0; i < 4; i++) rtx_img_resolve(doc, srcs[i], 5, &s[i]);
    /* Header first (size for layout), then pixels. */
    expect(rtx_img_info(&s[0], &v) == RTX_IMG_S_WAIT || v.state == RTX_IMG_S_INFO,
           "cache: header queued");
    rtx_img_finish();
    expect(rtx_img_info(&s[0], &v) == RTX_IMG_S_INFO && v.have_info && v.info.w == 32,
           "cache: header known");
    for (round = 0; round < 4; round++) {
        rtx_img_frame();
        rtx_img_want(&s[round], 32, 24, &v);
        rtx_img_finish();
        rtx_img_want(&s[round], 32, 24, &v);
        expect(v.state == RTX_IMG_S_OK, "cache: wanted bitmap decoded");
        expect(rtx_img_held() <= l->budget, "cache: under budget");
        expect(rtx_img_nbmp() <= 2, "cache: LRU keeps two");
    }
    /* The oldest (a) was evicted; wanting it again decodes it anew. */
    rtx_img_frame();
    rtx_img_want(&s[0], 32, 24, &v);
    expect(v.state != RTX_IMG_S_OK, "cache: evicted bitmap re-decodes");
    rtx_img_finish();
    rtx_img_want(&s[0], 32, 24, &v);
    expect(v.state == RTX_IMG_S_OK && rtx_img_nbmp() <= 2, "cache: re-decoded under budget");
    /* A size within 10 % reuses the bitmap. */
    rtx_img_want(&s[0], 30, 23, &v);
    expect(v.state == RTX_IMG_S_OK && v.bmp && v.bmp->w == 32, "cache: near size reused");
    /* Its pixels alone over the budget: named, not decoded. */
    l->budget = 100;
    rtx_img_want(&s[1], 32, 24, &v);
    rtx_img_finish();
    rtx_img_want(&s[1], 32, 24, &v);
    expect(v.state == RTX_IMG_S_ERR && v.err == RTX_IMG_EBUDGET, "cache: over budget named");
    *l = save;
    {
        /* Far off screen: unpainted for 600 whole paints, dropped even
         * under the budget. */
        size_t n0;
        int k;
        rtx_img_frame();
        rtx_img_want(&s[2], 32, 24, &v);
        rtx_img_finish();
        rtx_img_want(&s[2], 32, 24, &v);
        n0 = rtx_img_nbmp();
        expect(v.state == RTX_IMG_S_OK && n0 >= 1, "cache: bitmap held");
        for (k = 0; k < 601; k++) rtx_img_frame();
        rtx_img_pump();
        expect(rtx_img_nbmp() < n0, "cache: a far bitmap is dropped");
    }
    rtx_img_reset();
    expect(rtx_img_held() == 0 && rtx_img_nbmp() == 0, "cache: reset frees");
}

/* ---- remote: a local HTTP server ------------------------------------- */

static int g_srv_fd = -1;
static int g_port;
static _Atomic int g_hits;
static uint8_t *g_png;
static size_t g_png_n;

static void *srv_main(void *arg) {
    (void)arg;
    for (;;) {
        char req[2048], hdr[256];
        int c = accept(g_srv_fd, NULL, NULL);
        ssize_t r;
        if (c < 0) {
            if (errno == EINTR) continue;
            break;
        }
        r = recv(c, req, sizeof req - 1, 0);
        if (r <= 0) {
            close(c);
            continue;
        }
        req[r] = 0;
        atomic_fetch_add(&g_hits, 1);
        if (strncmp(req, "GET /ok.png", 11) == 0) {
            int hn = snprintf(hdr, sizeof hdr,
                              "HTTP/1.1 200 OK\r\nContent-Type: image/png\r\nContent-Length: %zu\r\n"
                              "ETag: \"v1\"\r\nConnection: close\r\n\r\n",
                              g_png_n);
            send(c, hdr, (size_t)hn, 0);
            send(c, g_png, g_png_n, 0);
        } else if (strncmp(req, "GET /big.png", 12) == 0) {
            /* No length: the cap is enforced while the body arrives. */
            static char junk[65536];
            int k;
            const char *h = "HTTP/1.1 200 OK\r\nContent-Type: image/png\r\nConnection: close\r\n\r\n";
            send(c, h, strlen(h), 0);
            for (k = 0; k < 64; k++)
                if (send(c, junk, sizeof junk, MSG_NOSIGNAL) < 0) break;
        } else if (strncmp(req, "GET /slow.png", 13) == 0) {
            struct timespec ts = {4, 0};
            nanosleep(&ts, NULL);
            {
                const char *h = "HTTP/1.1 404 Not Found\r\nContent-Length: 0\r\n\r\n";
                send(c, h, strlen(h), MSG_NOSIGNAL);
            }
        } else {
            const char *h = "HTTP/1.1 404 Not Found\r\nContent-Length: 0\r\nConnection: close\r\n\r\n";
            send(c, h, strlen(h), 0);
        }
        close(c);
    }
    return NULL;
}

static int srv_start(void) {
    struct sockaddr_in a;
    socklen_t al = sizeof a;
    pthread_t t;
    g_png = slurp("testdata/img/quad.png", &g_png_n);
    g_srv_fd = socket(AF_INET, SOCK_STREAM, 0);
    if (g_srv_fd < 0) return 0;
    memset(&a, 0, sizeof a);
    a.sin_family = AF_INET;
    a.sin_addr.s_addr = htonl(INADDR_LOOPBACK);
    a.sin_port = 0;
    if (bind(g_srv_fd, (struct sockaddr *)&a, sizeof a) != 0) return 0;
    if (listen(g_srv_fd, 8) != 0) return 0;
    if (getsockname(g_srv_fd, (struct sockaddr *)&a, &al) != 0) return 0;
    g_port = ntohs(a.sin_port);
    if (pthread_create(&t, NULL, srv_main, NULL) != 0) return 0;
    pthread_detach(t);
    return 1;
}

static int wait_state(const RtxImgSrc *s, int want_state, long max_ms, RtxImgView *v) {
    long t0 = now_ms();
    for (;;) {
        rtx_img_frame();
        rtx_img_pump();
        rtx_img_want(s, 64, 64, v);
        if (v->state == want_state || v->state == RTX_IMG_S_ERR) return v->state == want_state;
        if (now_ms() - t0 > max_ms) return 0;
        {
            struct timespec ts = {0, 10 * 1000000};
            nanosleep(&ts, NULL);
        }
    }
}

static void test_remote(void) {
    char cwd[400], doc[512], url[256];
    RtxImgSrc s;
    RtxImgView v;
    RtxImgLimits *l = rtx_img_limits();
    RtxImgLimits save = *l;
    int k;
    if (!getcwd(cwd, sizeof cwd)) return;
    if (system("curl --version >/dev/null 2>&1") != 0) {
        printf("img: curl missing: remote tests skipped\n");
        return;
    }
    if (!srv_start()) {
        expect(0, "remote: server");
        return;
    }
    snprintf(doc, sizeof doc, "%s/" PROJ "/doc.md", cwd);
    rtx_img_reset();
    rtx_img_revoke(doc);
    snprintf(url, sizeof url, "http://127.0.0.1:%d/ok.png", g_port);
    /* No decision: a placeholder, and nothing is fetched. */
    expect(rtx_img_resolve(doc, url, strlen(url), &s) == RTX_IMG_EREMOTE, "remote: needs consent");
    expect(strcmp(s.host, "127.0.0.1") == 0 && s.http, "remote: host named");
    for (k = 0; k < 5; k++) {
        rtx_img_want(&s, 64, 64, &v);
        rtx_img_info(&s, &v);
        rtx_img_pump();
    }
    expect(v.state == RTX_IMG_S_ASK, "remote: asks");
    rtx_img_finish();
    expect(atomic_load(&g_hits) == 0 && rtx_img_fetches() == 0, "remote: never fetched without consent");
    /* "Load this image": this session only. */
    expect(rtx_img_allow(doc, &s, RTX_IMG_ALLOW_ONCE), "remote: once");
    expect(rtx_img_resolve(doc, url, strlen(url), &s) == RTX_IMG_OK && s.once, "remote: once allows");
    expect(wait_state(&s, RTX_IMG_S_OK, 5000, &v), "remote: fetched and decoded");
    expect(v.bmp && v.bmp->w == 32, "remote: pixels");
    expect(atomic_load(&g_hits) == 1, "remote: one request");
    /* Next open (policy reloaded): a once-decision is gone, and the cached
     * file is not used without asking. */
    rtx_img_policy_reload();
    rtx_img_reset();
    expect(rtx_img_resolve(doc, url, strlen(url), &s) == RTX_IMG_EREMOTE,
           "remote: once is not remembered");
    rtx_img_want(&s, 64, 64, &v);
    expect(v.state == RTX_IMG_S_ASK, "remote: cache not used after once");
    /* "Always load from this host": persisted; next open reuses the cache
     * without a request. */
    expect(rtx_img_allow(doc, &s, RTX_IMG_ALLOW_HOST), "remote: always host stored");
    rtx_img_policy_reload();
    rtx_img_reset();
    expect(rtx_img_resolve(doc, url, strlen(url), &s) == RTX_IMG_OK, "remote: host allowed");
    expect(wait_state(&s, RTX_IMG_S_OK, 5000, &v), "remote: from the cache");
    expect(atomic_load(&g_hits) == 1, "remote: cache reused, no request");
    /* https only unless http was allowed for that host. */
    {
        char u2[256];
        RtxImgSrc s2;
        snprintf(u2, sizeof u2, "http://localhost:%d/ok.png", g_port);
        rtx_img_allow(doc, &s, RTX_IMG_ALLOW_ALL_REMOTE);
        expect(rtx_img_resolve(doc, u2, strlen(u2), &s2) == RTX_IMG_EREMOTE,
               "remote: all-remote does not cover plain http of another host");
        snprintf(u2, sizeof u2, "https://example.invalid/a.png");
        expect(rtx_img_resolve(doc, u2, strlen(u2), &s2) == RTX_IMG_OK,
               "remote: all-remote covers https");
    }
    /* Byte cap. */
    l->remote_max = 64 << 10;
    snprintf(url, sizeof url, "http://127.0.0.1:%d/big.png", g_port);
    rtx_img_resolve(doc, url, strlen(url), &s);
    expect(s.err == RTX_IMG_OK, "remote: big allowed by host");
    wait_state(&s, RTX_IMG_S_OK, 8000, &v);
    expect(v.state == RTX_IMG_S_ERR && v.err == RTX_IMG_ESIZE, "remote: byte cap");
    /* Timeout. */
    {
        long t0 = now_ms();
        l->timeout_s = 1;
        snprintf(url, sizeof url, "http://127.0.0.1:%d/slow.png", g_port);
        rtx_img_resolve(doc, url, strlen(url), &s);
        wait_state(&s, RTX_IMG_S_OK, 8000, &v);
        expect(v.state == RTX_IMG_S_ERR && v.err == RTX_IMG_ETIMEOUT, "remote: timeout");
        expect(now_ms() - t0 < 4500, "remote: timeout is prompt");
    }
    *l = save;
    rtx_img_revoke(doc);
    rtx_img_reset();
}

/* ---- the resampler (core/img_resize.c) ------------------------------- */

/* The scaler this one replaced (at most ~5 point samples an axis per
 * output pixel, truncated spans): the baseline the edge checks beat. */
static void old_scale(const uint8_t *src, uint32_t W, uint32_t H, uint8_t *dst, uint32_t w,
                      uint32_t h) {
    uint32_t dx, dy;
    for (dy = 0; dy < h; dy++) {
        uint32_t y0 = (uint32_t)((uint64_t)dy * H / h), y1 = (uint32_t)((uint64_t)(dy + 1) * H / h);
        uint32_t ys;
        if (y1 <= y0) y1 = y0 + 1;
        if (y1 > H) y1 = H;
        ys = (y1 - y0 + 4) / 5;
        if (ys < 1) ys = 1;
        for (dx = 0; dx < w; dx++) {
            uint32_t x0 = (uint32_t)((uint64_t)dx * W / w), x1 = (uint32_t)((uint64_t)(dx + 1) * W / w);
            uint32_t xs, x, y, cnt = 0, acc[4] = {0, 0, 0, 0}, c;
            uint8_t *o = dst + ((size_t)dy * w + dx) * 4;
            if (x1 <= x0) x1 = x0 + 1;
            if (x1 > W) x1 = W;
            xs = (x1 - x0 + 4) / 5;
            if (xs < 1) xs = 1;
            for (y = y0; y < y1; y += ys)
                for (x = x0; x < x1; x += xs) {
                    const uint8_t *p = src + ((size_t)y * W + x) * 4;
                    for (c = 0; c < 4; c++) acc[c] += p[c];
                    cnt++;
                }
            for (c = 0; c < 4; c++) o[c] = (uint8_t)((acc[c] + cnt / 2) / cnt);
        }
    }
}

static uint8_t *rs_img(uint32_t w, uint32_t h) {
    return (uint8_t *)calloc((size_t)w * h, 4);
}

static void rs_put(uint8_t *p, uint32_t w, uint32_t x, uint32_t y, int b, int g, int r, int a) {
    uint8_t *q = p + ((size_t)y * w + x) * 4;
    q[0] = (uint8_t)b;
    q[1] = (uint8_t)g;
    q[2] = (uint8_t)r;
    q[3] = (uint8_t)a;
}

/* A dark, slightly slanted edge (text's stroke side), coverage-exact:
 * the pixel's dark fraction is the part of it left of the edge. */
static uint8_t *rs_slant(uint32_t W, uint32_t H, double slope) {
    uint8_t *s = rs_img(W, H);
    uint32_t x, y;
    for (y = 0; y < H; y++)
        for (x = 0; x < W; x++) {
            double e = W * 0.5 + ((double)y - H * 0.5) * slope, cov = e - x;
            int v;
            if (cov < 0) cov = 0;
            if (cov > 1) cov = 1;
            v = (int)(255 * (1 - cov) + 0.5);
            rs_put(s, W, x, y, v, v, v, 255);
        }
    return s;
}

/* Jaggedness: per row, the edge position from the row's total darkness
 * against the true edge, RMS in output pixels (0 = every row's edge where
 * it belongs; a point-sampled scaler steps). Also the mean 10-90 % rise
 * width in pixels (softness). */
/* No libm in this link. */
static double rs_sqrt(double v) {
    double r = v > 1 ? v : 1;
    int k;
    if (v <= 0) return 0;
    for (k = 0; k < 60; k++) r = 0.5 * (r + v / r);
    return r;
}

static void rs_edge(const uint8_t *d, uint32_t w, uint32_t h, uint32_t W, uint32_t H, double slope,
                    double *jag, double *rise) {
    double se = 0, rs = 0;
    int n = 0, nr = 0;
    uint32_t x, y;
    for (y = 2; y + 2 < h; y++) {
        double dark = 0, ys = (y + 0.5) * H / (double)h;
        double truth = (W * 0.5 + (ys - H * 0.5) * slope) / ((double)W / w), x10 = -1, x90 = -1;
        for (x = 0; x < w; x++) dark += (255 - d[((size_t)y * w + x) * 4]) / 255.0;
        se += (dark - truth) * (dark - truth);
        n++;
        for (x = 0; x + 1 < w; x++) {
            double a = d[((size_t)y * w + x) * 4], b = d[((size_t)y * w + x + 1) * 4];
            if (a <= 25.5 && b > 25.5 && x10 < 0) x10 = x + (25.5 - a) / (b - a);
            if (a <= 229.5 && b > 229.5) x90 = x + (229.5 - a) / (b - a);
        }
        if (x10 >= 0 && x90 >= x10) {
            rs += x90 - x10;
            nr++;
        }
    }
    *jag = n ? rs_sqrt(se / n) : 0;
    *rise = nr ? rs / nr : 99;
}

static void test_resize(void) {
    char msg[160];
    uint32_t x, y, i;
    /* A constant translucent colour stays that colour, every direction,
     * orientation and shape (the filter's weights sum to one). */
    {
        static const uint32_t sz[][4] = {{37, 23, 11, 7}, {37, 23, 50, 31}, {37, 23, 37, 23},
                                         {1, 40, 1, 9},   {40, 1, 9, 1},    {1, 1, 1, 1},
                                         {1, 1, 5, 3},    {300, 200, 7, 5}, {9, 9, 1, 1}};
        for (i = 0; i < sizeof sz / sizeof sz[0]; i++) {
            uint32_t W = sz[i][0], H = sz[i][1];
            int o;
            uint8_t *s = rs_img(W, H);
            for (y = 0; y < H; y++)
                for (x = 0; x < W; x++) rs_put(s, W, x, y, 20, 40, 60, 128);
            for (o = 1; o <= 8; o++) {
                uint32_t w = o >= 5 ? sz[i][3] : sz[i][2], h = o >= 5 ? sz[i][2] : sz[i][3], k;
                uint8_t *d = rs_img(w, h);
                int ok = rtx_img_resize(s, W, H, (size_t)W * 4, o, d, w, h, NULL, NULL) == 0;
                for (k = 0; ok && k < w * h; k++)
                    ok = abs(d[k * 4] - 20) <= 1 && abs(d[k * 4 + 1] - 40) <= 1 &&
                         abs(d[k * 4 + 2] - 60) <= 1 && abs(d[k * 4 + 3] - 128) <= 1;
                snprintf(msg, sizeof msg, "resize: constant %ux%u -> %ux%u orient %d", W, H, w, h, o);
                expect(ok, msg);
                free(d);
            }
            free(s);
        }
    }
    /* A 1 px checkerboard shrunk 2:1 (and 3:1, 2.5:1) is an even grey, not
     * stripes or a moire: every source pixel is covered. */
    {
        static const uint32_t to[] = {32, 21, 25};
        uint8_t *s = rs_img(64, 64);
        for (y = 0; y < 64; y++)
            for (x = 0; x < 64; x++) {
                int v = ((x + y) & 1) ? 255 : 0;
                rs_put(s, 64, x, y, v, v, v, 255);
            }
        for (i = 0; i < 3; i++) {
            uint32_t w = to[i], k;
            int lo = 255, hi = 0, ilo = 255, ihi = 0;
            uint8_t *d = rs_img(w, w);
            expect(rtx_img_resize(s, 64, 64, 64 * 4, 1, d, w, w, NULL, NULL) == 0, "resize: checker");
            for (k = 0; k < w * w; k++) {
                int v = d[k * 4], in = k % w && k % w != w - 1 && k / w && k / w != w - 1;
                if (v < lo) lo = v;
                if (v > hi) hi = v;
                if (in && v < ilo) ilo = v;
                if (in && v > ihi) ihi = v;
            }
            /* The outermost pixels lean toward their own column (the edge
             * is clamped: the kernel's outer taps repeat it). */
            snprintf(msg, sizeof msg, "resize: checkerboard 64 -> %u is grey (%d..%d, inside %d..%d)",
                     w, lo, hi, ilo, ihi);
            expect(lo >= 110 && hi <= 145 && ilo >= (i ? 124 : 126) && ihi <= (i ? 131 : 129), msg);
            if (getenv("RTX_IMG_RS_VERBOSE")) printf("%s\n", msg);
            free(d);
        }
        free(s);
    }
    /* A slanted hard edge at 4:3 and 3:2 (the demo screenshot at a Rich
     * pane's width): where the old scaler's rows stepped by a quarter
     * pixel or more, this one's edge sits within a few hundredths, and it
     * is no softer than a two-pixel ramp. */
    {
        uint32_t W = 960, H = 640, k;
        static const uint32_t ws[] = {720, 640};
        uint8_t *s = rs_slant(W, H, 0.07);
        for (k = 0; k < 2; k++) {
            uint32_t w = ws[k], h = (uint32_t)((double)H * w / W + 0.5);
            uint8_t *d = rs_img(w, h), *od = rs_img(w, h);
            double jn, rn, jo, ro;
            expect(rtx_img_resize(s, W, H, (size_t)W * 4, 1, d, w, h, NULL, NULL) == 0, "resize: edge");
            old_scale(s, W, H, od, w, h);
            rs_edge(d, w, h, W, H, 0.07, &jn, &rn);
            rs_edge(od, w, h, W, H, 0.07, &jo, &ro);
            snprintf(msg, sizeof msg, "resize: edge 960 -> %u: jag %.3f (old %.3f), rise %.2f px", w,
                     jn, jo, rn);
            expect(jn < 0.06 && jo > 3 * jn && rn < 1.8, msg);
            if (getenv("RTX_IMG_RS_VERBOSE")) printf("%s (old rise %.2f)\n", msg, ro);
            free(d);
            free(od);
        }
        free(s);
    }
    /* Transparent next to opaque red: filtered premultiplied, the edge
     * pixels are red with less alpha, never darker red (no fringe), and
     * the cubic's overshoot never leaves a colour above its alpha. */
    {
        uint32_t W = 45, H = 9, w = 13, h = 3, k;
        uint8_t *s = rs_img(W, H), *d = rs_img(w, h);
        int ok = 1, partial = 0;
        for (y = 0; y < H; y++)
            for (x = 0; x < W; x++)
                if (x >= 20) rs_put(s, W, x, y, 0, 0, 255, 255);
        expect(rtx_img_resize(s, W, H, (size_t)W * 4, 1, d, w, h, NULL, NULL) == 0, "resize: fringe");
        for (k = 0; k < w * h; k++) {
            uint8_t *p = d + k * 4;
            if (p[0] > p[3] || p[1] > p[3] || p[2] > p[3]) ok = 0;
            if (p[3] >= 16) {
                /* straight red = r * 255 / a */
                int r = (p[2] * 255 + p[3] / 2) / p[3];
                if (r < 240 || p[0] > 2 || p[1] > 2) ok = 0;
                if (p[3] < 250) partial++;
            }
        }
        expect(ok && partial > 0, "resize: no dark fringe at a transparent edge");
        free(s);
        free(d);
    }
    /* Orientation: 1:1 it is exactly the EXIF turn; resampled it matches
     * resampling the turned image (a flip or transpose commutes). */
    {
        uint32_t W = 60, H = 36;
        int o;
        uint8_t *s = rs_img(W, H);
        for (y = 0; y < H; y++)
            for (x = 0; x < W; x++)
                rs_put(s, W, x, y, (int)(x * 4), (int)(y * 7), (int)((x * y) & 255), 255);
        for (o = 1; o <= 8; o++) {
            uint32_t dw = o >= 5 ? H : W, dh = o >= 5 ? W : H, w = dw / 3 + 1, h = dh / 3 + 1;
            uint8_t *t = rs_img(dw, dh), *d = rs_img(w, h), *e = rs_img(w, h);
            int ok = rtx_img_resize(s, W, H, (size_t)W * 4, o, t, dw, dh, NULL, NULL) == 0, md = 0;
            for (y = 0; ok && y < dh; y++)
                for (x = 0; ok && x < dw; x++) {
                    uint32_t cx, cy;
                    switch (o) {
                    case 2: cx = W - 1 - x; cy = y; break;
                    case 3: cx = W - 1 - x; cy = H - 1 - y; break;
                    case 4: cx = x; cy = H - 1 - y; break;
                    case 5: cx = y; cy = x; break;
                    case 6: cx = y; cy = H - 1 - x; break;
                    case 7: cx = W - 1 - y; cy = H - 1 - x; break;
                    case 8: cx = W - 1 - y; cy = x; break;
                    default: cx = x; cy = y; break;
                    }
                    ok = memcmp(t + ((size_t)y * dw + x) * 4, s + ((size_t)cy * W + cx) * 4, 4) == 0;
                }
            snprintf(msg, sizeof msg, "resize: orientation %d at 1:1", o);
            expect(ok, msg);
            expect(rtx_img_resize(s, W, H, (size_t)W * 4, o, d, w, h, NULL, NULL) == 0 &&
                       rtx_img_resize(t, dw, dh, (size_t)dw * 4, 1, e, w, h, NULL, NULL) == 0,
                   "resize: oriented");
            for (i = 0; i < w * h * 4; i++)
                if (abs(d[i] - e[i]) > md) md = abs(d[i] - e[i]);
            snprintf(msg, sizeof msg, "resize: orientation %d resampled (max diff %d)", o, md);
            expect(md <= 2, msg);
            free(t);
            free(d);
            free(e);
        }
        free(s);
    }
    /* A huge shrink goes through the box prefilter: fast, and close to the
     * cubic alone; cancel stops it. */
    {
        uint32_t W = 4096, H = 4096, w = 40, h = 40, k;
        uint8_t *s = (uint8_t *)malloc((size_t)W * H * 4), *d = rs_img(w, h), *e = rs_img(w, h);
        RtxResizeOpt np = {RTX_RS_CATROM, 0, 1};
        _Atomic int stop = 1;
        long t0, best = -1;
        int md = 0;
        if (!s) {
            expect(0, "resize: huge alloc");
            free(d);
            free(e);
            return;
        }
        for (y = 0; y < H; y++)
            for (x = 0; x < W; x++) {
                int v = (int)(((x / 64) + (y / 64)) & 1) * 200 + (int)(x & 31);
                rs_put(s, W, x, y, v, v / 2, 255 - v / 2, 255);
            }
        for (k = 0; k < 3; k++) {
            t0 = now_ms();
            expect(rtx_img_resize(s, W, H, (size_t)W * 4, 6, d, w, h, NULL, NULL) == 0, "resize: huge");
            if (best < 0 || now_ms() - t0 < best) best = now_ms() - t0;
        }
        snprintf(msg, sizeof msg, "resize: 4096x4096 -> 40x40 in %ld ms", best);
        expect(best < RTX_RS_HUGE_MS, msg);
        if (getenv("RTX_IMG_RS_VERBOSE")) printf("%s\n", msg);
        expect(rtx_img_resize(s, W, H, (size_t)W * 4, 6, e, w, h, NULL, &np) == 0, "resize: no prefilter");
        for (k = 0; k < w * h * 4; k++)
            if (abs(d[k] - e[k]) > md) md = abs(d[k] - e[k]);
        snprintf(msg, sizeof msg, "resize: prefilter close to the cubic alone (max diff %d)", md);
        expect(md <= 12, msg);
        t0 = now_ms();
        expect(rtx_img_resize(s, W, H, (size_t)W * 4, 1, d, w, h, &stop, NULL) == RTX_WUFFS_CANCEL,
               "resize: cancel");
        expect(now_ms() - t0 < 20, "resize: cancel is prompt");
        free(s);
        free(d);
        free(e);
    }
}

/* RTX_IMG_BENCH=file: best of 5 header probes and decodes to fit
 * 800x600 (a Rich pane; RTX_IMG_BENCH_W / _H: another box, e.g. a 2x
 * screen's device size), printed; not a check. */
static void bench(const char *path) {
    size_t n;
    uint8_t *b = slurp(path, &n);
    int k;
    uint32_t bw = getenv("RTX_IMG_BENCH_W") ? (uint32_t)atoi(getenv("RTX_IMG_BENCH_W")) : 800;
    uint32_t bh = getenv("RTX_IMG_BENCH_H") ? (uint32_t)atoi(getenv("RTX_IMG_BENCH_H")) : 600;
    long best_p = -1, best_d = -1;
    RtxImgLimits lim = *rtx_img_limits();
    struct timespec t0, t1;
    RtxImgInfo info;
    RtxImgBmp bmp;
    if (!b) return;
    lim.file_max = (uint64_t)n + 1;
    for (k = 0; k < 5; k++) {
        long us;
        clock_gettime(CLOCK_MONOTONIC, &t0);
        rtx_img_probe(b, n < (64u << 10) ? n : (64u << 10), n < (64u << 10), &lim, &info);
        clock_gettime(CLOCK_MONOTONIC, &t1);
        us = (t1.tv_sec - t0.tv_sec) * 1000000L + (t1.tv_nsec - t0.tv_nsec) / 1000;
        if (best_p < 0 || us < best_p) best_p = us;
        clock_gettime(CLOCK_MONOTONIC, &t0);
        if (rtx_img_decode(b, n, &lim, bw, bh, RTX_IMG_PIX_BGRA_PREMUL, 1, NULL, &bmp,
                           &info) != RTX_IMG_OK) {
            printf("bench: %s does not decode\n", path);
            free(b);
            return;
        }
        clock_gettime(CLOCK_MONOTONIC, &t1);
        us = (t1.tv_sec - t0.tv_sec) * 1000000L + (t1.tv_nsec - t0.tv_nsec) / 1000;
        if (best_d < 0 || us < best_d) best_d = us;
        rtx_img_bmp_free(&bmp);
    }
    printf("bench: %s %s %ux%u (%zu bytes): header %ld us, decode to %ux%u: %ld.%ld ms\n",
           path, rtx_img_fmt_name(info.fmt), info.w, info.h, n, best_p, bw, bh, best_d / 1000,
           (best_d % 1000) / 100);
    free(b);
}

int main(void) {
    rtx_safe_test_isol();
    if (getenv("RTX_IMG_BENCH")) {
        bench(getenv("RTX_IMG_BENCH"));
        return 0;
    }
    test_resize();
    test_formats();
    test_broken();
    test_exif();
    test_anim();
    test_md();
    test_policy();
    test_cache();
    test_remote();
    if (fails) {
        fprintf(stderr, "img_smoke: %d failures\n", fails);
        return 1;
    }
    printf("img_smoke: ok\n");
    return 0;
}
