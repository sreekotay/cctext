#!ccc ccs
/*
 * Find options: ignore case, whole word, regex. Every scan is checked
 * against a sequential reference (one rtx_rx_search chain over the whole
 * text, same semantics) — so block edges, lane order and the write-stage
 * re-chain must not change a single hit. Also: a regex match straddling
 * a block edge, the long-match leftover, compile errors, refine with
 * options, the UI toggles, and a random edit fuzz for the patch path
 * (literal + options and regex) against a fresh reference.
 */
#include <ccc/std/prelude.cch>
#include <ccc/stdio.cch>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <time.h>
#include "../core/document.cch"
#include "../core/find.cch"
#include "../core/ui.cch"

static int fails = 0;

static void expect(int cond, const char *msg) {
    if (!cond) {
        fprintf(stderr, "FAIL: %s\n", msg);
        fails++;
    }
}

static double now_ms(void) {
    struct timespec ts;
    clock_gettime(CLOCK_MONOTONIC, &ts);
    return (double)ts.tv_sec * 1000.0 + (double)ts.tv_nsec / 1.0e6;
}

typedef struct {
    size_t off;
    size_t len;
    size_t line;
} RefHit;

static RtxRx *ref_compile(const char *q, unsigned opts, CCArena a) {
    unsigned fl = 0;
    RtxRx *rx;
    if (opts & RTX_FIND_ICASE) fl |= RTX_RX_ICASE;
    if (!(opts & RTX_FIND_REGEX)) fl |= RTX_RX_LITERAL;
    rx = rtx_rx_compile(cc_slice_cstr(q), fl, a) !>(e) {
        (void)e;
        return NULL;
    };
    return rx;
}

static size_t ref_next_cp(const char *t, size_t n, size_t p) {
    p++;
    while (p < n && ((unsigned char)t[p] & 0xC0) == 0x80) p++;
    return p;
}

/* The find semantics, sequentially over the whole text. */
static size_t ref_scan(const char *t, size_t n, const RtxRx *rx, unsigned opts,
                       RefHit *out, size_t cap) {
    RtxRxScratch s = {0};
    RtxRxIn in;
    size_t p = 0, cnt = 0, line = 0, lpos = 0;
    int plain = (opts & (RTX_FIND_ICASE | RTX_FIND_WORD | RTX_FIND_REGEX)) == 0;
    memset(&in, 0, sizeof(in));
    in.s = t;
    in.n = n;
    in.gpos = RTX_RX_UNSET;
    in.ctx = RTX_RX_CTX_BOL0 | RTX_RX_CTX_BOT0;
    while (p < n && cnt < cap) {
        size_t ms = 0, me = 0;
        int r = rtx_rx_search(rx, &in, p, n, 1, &s, &ms, &me);
        if (r != RTX_RX_MATCH) break;
        if (me == ms || ((opts & RTX_FIND_WORD) &&
                         ((rtx_rx_word_before(t, ms) && rtx_rx_word_after(t, ms, n)) ||
                          (rtx_rx_word_before(t, me) && rtx_rx_word_after(t, me, n))))) {
            p = plain ? ms + 1 : ref_next_cp(t, n, ms);
            continue;
        }
        while (lpos < ms) {
            if (t[lpos] == '\n') line++;
            lpos++;
        }
        out[cnt].off = ms;
        out[cnt].len = me - ms;
        out[cnt].line = line;
        cnt++;
        p = (opts & RTX_FIND_REGEX) ? me : (plain ? ms + 1 : ref_next_cp(t, n, ms));
    }
    rtx_rx_scratch_drop(&s);
    return cnt;
}

static char *doc_text(RtxDoc *d, size_t *n) {
    char *buf;
    size_t got;
    @errhandler(CCError e) {
        (void)e;
        return NULL;
    }
    *n = d->len();
    buf = (char *)malloc(*n + 1);
    if (!buf) return NULL;
    got = d->read_at(0, cc_slice_from_buffer(buf, *n)) !>;
    if (got != *n) {
        free(buf);
        return NULL;
    }
    buf[*n] = 0;
    return buf;
}

/* 1 when the published list equals the reference. */
static int same_as_ref(RtxDoc *d, const char *q, unsigned opts, const char *what) {
    CCArena a = cc_arena_heap(kilobytes(64));
    RtxRx *rx = ref_compile(q, opts, a);
    size_t n = 0, cnt, i, hn;
    RefHit *ref;
    char *t = doc_text(d, &n);
    int ok = 1;
    if (!rx || !t) {
        fprintf(stderr, "%s: ref setup failed\n", what);
        a.destroy();
        free(t);
        return 0;
    }
    ref = (RefHit *)malloc(sizeof(RefHit) * (size_t)RTX_FIND_MAX);
    cnt = ref_scan(t, n, rx, opts, ref, (size_t)RTX_FIND_MAX);
    hn = rtx_find_hits_n(&d->find);
    /* A capped list is the reference's prefix. */
    if (d->find.truncated && hn == (size_t)RTX_FIND_MAX && cnt >= hn) cnt = hn;
    if (hn != cnt) {
        fprintf(stderr, "%s: /%s/ opts=%u hits %zu, reference %zu\n", what, q, opts, hn, cnt);
        ok = 0;
    }
    for (i = 0; ok && i < cnt; i++) {
        RtxFindHit h = d->find.hits.data[i];
        if (h.off != ref[i].off || h.len != ref[i].len || h.line != ref[i].line) {
            fprintf(stderr, "%s: /%s/ hit %zu: [%zu +%zu L%zu] reference [%zu +%zu L%zu]\n",
                    what, q, i, h.off, h.len, h.line, ref[i].off, ref[i].len, ref[i].line);
            ok = 0;
        }
    }
    free(ref);
    free(t);
    a.destroy();
    return ok;
}

static int run_find(RtxDoc *d, const char *q, unsigned opts) {
    @errhandler(CCError e) {
        fprintf(stderr, "find: %s\n", e.message ? e.message : "?");
        return 0;
    }
    d->find_set_opt(cc_slice_cstr(q), opts) !>;
    d->find_finish() !>;
    return 1;
}

static void basic(void) {
    RtxDoc d = {0} @destroy;
    @errhandler(CCError e) {
        (void)e;
        expect(0, "basic doc");
        return;
    }
    d.from_buffer("Alpha alpha ALPHA alphabet\nsay \xC3\x89t\xC3\xA9 \xC3\xA9t\xC3\xA9 caf\xC3\xA9-x cafe\n") !>;
    expect(run_find(&d, "alpha", 0) && d.find.hits.len == 2, "plain: case-sensitive alpha x2");
    expect(run_find(&d, "alpha", RTX_FIND_ICASE) && d.find.hits.len == 4, "icase: alpha x4");
    expect(same_as_ref(&d, "alpha", RTX_FIND_ICASE, "icase"), "icase = reference");
    expect(run_find(&d, "alpha", RTX_FIND_ICASE | RTX_FIND_WORD) && d.find.hits.len == 3,
           "icase+word: not alphabet");
    expect(run_find(&d, "\xC3\xA9t\xC3\xA9", RTX_FIND_ICASE) && d.find.hits.len == 2,
           "icase: Été / été (Latin-1 fold)");
    expect(d.find.hits.len == 2 && d.find.hits.data[0].len == 5, "icase hit length");
    expect(run_find(&d, "caf", RTX_FIND_WORD) && d.find.hits.len == 0,
           "word: caf inside café / cafe");
    expect(run_find(&d, "caf\xC3\xA9", RTX_FIND_WORD) && d.find.hits.len == 1,
           "word: café before '-' is a word");
    expect(run_find(&d, "[a-z]+ha", RTX_FIND_REGEX) && d.find.hits.len == 3,
           "regex: [a-z]+ha (lpha, alpha, alpha of alphabet)");
    expect(run_find(&d, "(?i)^al\\w+", RTX_FIND_REGEX) && d.find.hits.len == 1 &&
               d.find.hits.data[0].off == 0 && d.find.hits.data[0].len == 5,
           "regex: ^ anchors the first line only");
    expect(run_find(&d, "\\w+", RTX_FIND_REGEX) && same_as_ref(&d, "\\w+", RTX_FIND_REGEX, "w+"),
           "regex: \\w+ = reference (non-overlapping)");
    expect(run_find(&d, "ET\\n", RTX_FIND_REGEX | RTX_FIND_ICASE) && d.find.hits.len == 1,
           "regex+icase: alphabET at EOL");
    expect(run_find(&d, "bet\\nsay", RTX_FIND_REGEX) && d.find.hits.len == 1 &&
               d.find.hits.data[0].line == 0,
           "regex: a match across a newline");
    expect(run_find(&d, "a*", RTX_FIND_REGEX) && d.find.hits.len > 0 &&
               same_as_ref(&d, "a*", RTX_FIND_REGEX, "a*"),
           "regex: empty matches are skipped, the rest listed");
    /* compile error: honest, no scan */
    expect(run_find(&d, "a(", RTX_FIND_REGEX), "bad regex is not a Result failure");
    expect(d.find.err != NULL && d.find.done && d.find.hits.len == 0, "bad regex: err, done, 0");
    {
        char st[256];
        rtx_ui_find_stats(&d, st, sizeof(st));
        expect(strstr(st, "regex: ") != NULL, "bad regex: the header says so");
    }
    expect(run_find(&d, "a(", 0) && !d.find.err && d.find.hits.len == 0,
           "same text as a literal is fine");
    /* selection takes the hit length */
    expect(run_find(&d, "al\\w+", RTX_FIND_REGEX | RTX_FIND_ICASE), "regex select");
    d.find_goto(3);
    expect(d.caret == 18 && d.sel_anchor == 26, "select spans the regex hit (alphabet)");
}

/* Refine with options: a longer literal keeps scan_off; icase compares
 * folded bytes. Whole word and regex restart. */
static void refine(void) {
    RtxDoc d = {0} @destroy;
    size_t kept;
    @errhandler(CCError e) {
        (void)e;
        expect(0, "refine doc");
        return;
    }
    d.from_buffer("ALpha alp ALP alpine xALPy\n") !>;
    expect(run_find(&d, "al", RTX_FIND_ICASE) && d.find.hits.len == 5, "icase al x5");
    kept = d.find.scan_off;
    d.find_set_opt(cc_slice_cstr("alp"), RTX_FIND_ICASE) !>;
    d.find_finish() !>;
    expect(d.find.scan_off == kept && d.find.hits.len == 5, "icase refine keeps the five");
    expect(same_as_ref(&d, "alp", RTX_FIND_ICASE, "refine"), "icase refine = reference");
    d.find_set_opt(cc_slice_cstr("alph"), RTX_FIND_ICASE) !>;
    d.find_finish() !>;
    expect(d.find.hits.len == 1 && d.find.hits.data[0].len == 4, "icase refine alph x1");
    expect(run_find(&d, "alp", RTX_FIND_ICASE | RTX_FIND_WORD) && d.find.hits.len == 2,
           "word: alp, ALP");
    expect(run_find(&d, "alpi", RTX_FIND_ICASE | RTX_FIND_WORD) && d.find.hits.len == 0,
           "word does not refine (fresh scan)");
}

/* UI: Alt-C / W / R flip options; apply re-runs the same text. */
static void ui_toggles(void) {
    RtxDoc d = {0} @destroy;
    RtxUi ui;
    char st[256];
    @errhandler(CCError e) {
        (void)e;
        expect(0, "ui doc");
        return;
    }
    memset(&ui, 0, sizeof(ui));
    d.from_buffer("a.c abc A.C\n") !>;
    rtx_ui_start_find(&ui, &d);
    rtx_ui_find_char(&ui, 'a');
    rtx_ui_find_char(&ui, '.');
    rtx_ui_find_char(&ui, 'c');
    rtx_ui_find_apply(&ui, &d) !>;
    d.find_finish() !>;
    expect(d.find.hits.len == 1, "literal a.c");
    expect(rtx_ui_find_toggle(&ui, 'c'), "alt-c toggles");
    rtx_ui_find_apply(&ui, &d) !>;
    d.find_finish() !>;
    expect(d.find.hits.len == 2 && d.find.opts == RTX_FIND_ICASE, "icase a.c x2");
    expect(rtx_ui_find_toggle(&ui, 'r'), "alt-r toggles");
    rtx_ui_find_apply(&ui, &d) !>;
    d.find_finish() !>;
    expect(d.find.hits.len == 3, "regex+icase a.c x3");
    rtx_ui_find_stats(&d, st, sizeof(st));
    expect(strstr(st, "icase+regex") != NULL, "header shows the options");
    expect(rtx_ui_find_toggle(&ui, 'w') && ui.find_opts == 7, "alt-w toggles");
    expect(!rtx_ui_find_toggle(&ui, 'x'), "other letters are not toggles");
}

/* A tracked slice (from_buffer refuses untracked bytes). */
static char[:] big_slice(CCArena a, size_t n) {
    return a.alloc_slice_bytes(n);
}

/* A regex hit straddling the block edge: the next block's lane finds the
 * tail of that hit; the write stage re-chains so it is listed once. And
 * a candidate still open RTX_FIND_SPAN past the edge is a leftover. */
static void edges(void) {
    size_t n = 2 * (size_t)RTX_FIND_BLOCK + 4096, B = (size_t)RTX_FIND_BLOCK, i;
    CCArena body = cc_arena_heap(n + 64);
    char[:] sl = big_slice(body, n);
    char *t = sl.len >= n ? sl.ptr : NULL;
    @errhandler(CCError e) {
        (void)e;
        expect(0, "edges");
        body.destroy();
        return;
    }
    if (!t) {
        expect(0, "edges arena");
        return;
    }
    for (i = 0; i < n; i++) t[i] = (i % 97 == 96) ? '\n' : ' ';
    memcpy(t + B - 4, "straddleword", 12);
    memcpy(t + B + 100, "tailword", 8);
    memcpy(t + 1000, "Straddle", 8);
    {
        RtxDoc d = {0} @destroy;
        d.from_buffer(sl) !>;
        expect(run_find(&d, "[a-z]+", RTX_FIND_REGEX), "edge scan");
        expect(d.find.hits.len == 3, "straddling word listed once (+2 others)");
        expect(d.find.hits.len == 3 && d.find.hits.data[1].off == B - 4 &&
                   d.find.hits.data[1].len == 12,
               "the straddling hit is whole");
        expect(same_as_ref(&d, "[a-z]+", RTX_FIND_REGEX, "edge"), "edge = reference");
        expect(run_find(&d, "straddle", RTX_FIND_ICASE) && d.find.hits.len == 2,
               "icase literal across the edge");
        expect(run_find(&d, "word", RTX_FIND_WORD) && d.find.hits.len == 0,
               "word: straddleword / tailword are not 'word'");
        expect(run_find(&d, "tailword", RTX_FIND_WORD) && d.find.hits.len == 1,
               "word: tailword in block 2");
    }
    /* Leftover: `x[^y]*y` opens at B-100 and cannot close inside the
     * block's window (the y is SPAN + 1000 past the edge). */
    for (i = 0; i < n; i++) t[i] = 'a';
    t[B - 100] = 'x';
    t[B + (size_t)RTX_FIND_SPAN + 1000] = 'y';
    t[50] = 'x';
    t[80] = 'y';
    {
        RtxDoc d = {0} @destroy;
        char st[256];
        d.from_buffer(sl) !>;
        expect(run_find(&d, "x[^y]*y", RTX_FIND_REGEX), "leftover scan");
        expect(d.find.hits.len == 1 && d.find.hits.data[0].off == 50 &&
                   d.find.hits.data[0].len == 31,
               "the short match is a hit");
        expect(d.find.long_n == 1 && d.find.long_off == B - 100,
               "the long candidate is a leftover at its start");
        rtx_ui_find_stats(&d, st, sizeof(st));
        expect(strstr(st, "1 over 64 KiB") != NULL, "the header shows the leftover");
        /* A long match that closes inside the window is an ordinary hit. */
        t[B + 1000] = 'y';
    }
    {
        RtxDoc d = {0} @destroy;
        d.from_buffer(sl) !>;
        expect(run_find(&d, "x[^y]*y", RTX_FIND_REGEX), "long hit scan");
        expect(d.find.hits.len == 2 && d.find.long_n == 0 &&
                   d.find.hits.data[1].len == 1101,
               "a decided long match is a hit, not a leftover");
    }
    /* Reverse inner (the literal after an unbounded part that takes
     * newlines): a match straddling the edge is whole and listed once; a
     * candidate still open past the window is a leftover, not a guess. */
    for (i = 0; i < n; i++) t[i] = (i % 97 == 96) ? '\n' : ' ';
    memcpy(t + 3000, "Mr Holmes", 9);
    memcpy(t + B - 6, "Sherlock\n Holmes", 16);
    {
        RtxDoc d = {0} @destroy;
        d.from_buffer(sl) !>;
        expect(run_find(&d, "\\w+\\s+Holmes", RTX_FIND_REGEX), "reverse inner edge scan");
        expect(d.find.hits.len == 2 && d.find.hits.data[1].off == B - 6 &&
                   d.find.hits.data[1].len == 16,
               "reverse inner: the straddling match is whole, listed once");
        expect(same_as_ref(&d, "\\w+\\s+Holmes", RTX_FIND_REGEX, "ri edge"),
               "reverse inner edge = reference");
    }
    for (i = B - 100; i < B + (size_t)RTX_FIND_SPAN + 1000; i++) t[i] = 'a';
    memcpy(t + B + (size_t)RTX_FIND_SPAN + 1000, " Holmes", 7);
    {
        RtxDoc d = {0} @destroy;
        d.from_buffer(sl) !>;
        expect(run_find(&d, "\\w+\\s+Holmes", RTX_FIND_REGEX), "reverse inner leftover scan");
        expect(d.find.hits.len == 2 && d.find.hits.data[0].off == 3000 &&
                   d.find.long_n == 1 && d.find.long_off == B - 100,
               "reverse inner: the cut candidate is a leftover at its start");
        /* the next block starts its own search at the edge (as the plain DFA) */
        expect(d.find.hits.len == 2 && d.find.hits.data[1].off == B,
               "reverse inner: the next block's match starts at the edge");
    }
    body.destroy();
}

static uint32_t rng = 777;
static uint32_t rnd(uint32_t n) {
    rng = rng * 1103515245u + 12345u;
    return (rng >> 16) % n;
}

static const char *words[] = {"alpha", "Beta", "gamma", "delta", "running", "RUNNING",
                              "sing", "é", "caf\xC3\xA9", "x1", "42", "3.14", "_id",
                              "foo-bar", "the", "The", "ing", "a", "\t"};

static size_t gen_text(char *t, size_t n) {
    size_t o = 0;
    while (o + 16 < n) {
        const char *w = words[rnd(sizeof(words) / sizeof(words[0]))];
        size_t k = strlen(w);
        memcpy(t + o, w, k);
        o += k;
        t[o++] = rnd(9) == 0 ? '\n' : ' ';
    }
    while (o < n) t[o++] = ' ';
    return o;
}

/* Parallel lanes (or inline under @smoke_inline) against the sequential
 * reference, on ~9 MiB (5 blocks), several queries. Throughput printed. */
static void lanes(void) {
    size_t n = 4 * (size_t)RTX_FIND_BLOCK + 777777;
    CCArena body = cc_arena_heap(n + 64);
    char[:] sl = big_slice(body, n);
    char *t = sl.len >= n ? sl.ptr : NULL;
    static const char *qs[] = {"running", "\\b[a-z]+ing\\b", "(?i)the\\s+\\w+", "\\d+(\\.\\d+)?",
                               "caf\xC3\xA9", "ing", NULL};
    static const unsigned os[] = {RTX_FIND_ICASE, RTX_FIND_REGEX, RTX_FIND_REGEX, RTX_FIND_REGEX,
                                  RTX_FIND_WORD | RTX_FIND_ICASE, RTX_FIND_WORD, 0};
    size_t k;
    @errhandler(CCError e) {
        (void)e;
        expect(0, "lanes");
        body.destroy();
        return;
    }
    if (!t) {
        expect(0, "lanes arena");
        return;
    }
    gen_text(t, n);
    {
        RtxDoc d = {0} @destroy;
        d.from_buffer(sl) !>;
        for (k = 0; qs[k]; k++) {
            double t0 = now_ms(), t1;
            char what[64];
            expect(run_find(&d, qs[k], os[k]), "lane scan");
            t1 = now_ms();
            snprintf(what, sizeof(what), "lanes %zu", k);
            expect(!d.find.truncated || d.find.hits.len == (size_t)RTX_FIND_MAX, "lanes cap");
            expect(same_as_ref(&d, qs[k], os[k], what), what);
            printf("lanes: /%s/ opts=%u hits=%zu %.1f ms (%.0f MB/s)\n", qs[k], os[k],
                   d.find.hits.len, t1 - t0, (double)n / 1048576.0 / ((t1 - t0) / 1000.0));
        }
    }
    body.destroy();
}

/* Random edits against a fresh reference after each one. Counts how often
 * the patch path kept the list (done, not wiped). */
static void edit_fuzz(const char *q, unsigned opts, int rounds) {
    size_t n = 20000, i;
    CCArena body = cc_arena_heap(n + 64);
    char[:] sl = big_slice(body, n);
    char *t = sl.len >= n ? sl.ptr : NULL;
    int kept = 0, r, bad = 0;
    static const char *ins[] = {"x", "running ", "\n", "42", "alpha", "é", "ing ", " ", "the"};
    @errhandler(CCError e) {
        fprintf(stderr, "edit fuzz: %s\n", e.message ? e.message : "?");
        expect(0, "edit fuzz");
        body.destroy();
        return;
    }
    if (!t) {
        expect(0, "fuzz arena");
        return;
    }
    gen_text(t, n);
    {
        RtxDoc d = {0} @destroy;
        d.from_buffer(sl) !>;
        (void)i;
        expect(run_find(&d, q, opts), "fuzz scan");
        for (r = 0; r < rounds && !bad; r++) {
            size_t len = d.len(), at = len ? rnd((uint32_t)len) : 0;
            int kind = (int)rnd(3);
            char what[96];
            if (kind == 0 || len < 10) {
                const char *s = ins[rnd(sizeof(ins) / sizeof(ins[0]))];
                d.insert(at, cc_slice_cstr(s)) !>;
            } else if (kind == 1) {
                size_t k = 1 + rnd(8);
                if (at + k > len) k = len - at;
                d.erase(at, k) !>;
            } else {
                size_t k = 1 + rnd(4);
                if (at + k > len) k = len - at;
                d.replace(at, k, cc_slice_cstr(ins[rnd(sizeof(ins) / sizeof(ins[0]))])) !>;
            }
            if (d.find.done && !d.find.truncated) kept++;
            d.find_finish() !>;
            snprintf(what, sizeof(what), "edit fuzz /%s/ opts=%u round %d", q, opts, r);
            if (!same_as_ref(&d, q, opts, what)) {
                expect(0, what);
                bad = 1;
            }
        }
    }
    printf("edit fuzz: /%s/ opts=%u rounds=%d patched-and-closed=%d\n", q, opts, rounds, kept);
    expect(kept > rounds / 3, "the patch path keeps most lists");
    body.destroy();
}

int main(void) {
    basic();
    refine();
    ui_toggles();
    edges();
    lanes();
    edit_fuzz("running", RTX_FIND_ICASE, 300);
    edit_fuzz("the", RTX_FIND_WORD | RTX_FIND_ICASE, 300);
    edit_fuzz("\\b[a-z]+ing\\b", RTX_FIND_REGEX, 300);
    edit_fuzz("\\d+|alpha\\s", RTX_FIND_REGEX, 300);
    edit_fuzz("a[^\\n]*?ing", RTX_FIND_REGEX, 200);
    if (fails) {
        fprintf(stderr, "find_opts_smoke: %d failed\n", fails);
        return 1;
    }
    printf("find_opts_smoke ok\n");
    return 0;
}
