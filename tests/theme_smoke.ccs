#!ccc ccs
/*
 * Themes (core/theme.cch): the palette's contrast, the terminal's answers.
 *
 * 1. Contrast: every (fg, bg) pair the painters use keeps WCAG 2 AA in
 *    both themes (4.5:1 text, 3:1 dimmed text and marks); the terminal's
 *    light SGRs keep 4.5:1 on a white background (3:1 for the dim roles),
 *    and a selection / highlight / table header background keeps the
 *    default text readable. Prints the weakest pairs.
 * 2. Every role has a name, a dark and a light colour; the SGRs parse.
 * 3. OSC 11 replies (16 / 8 / 4-bit channels, rgba:, #rgb, ST / BEL, junk)
 *    and COLORFGBG; light / dark by luminance.
 * 4. The theme switch: set, generation, mode names; settings.json
 *    "theme".
 */
#include <ccc/std/prelude.cch>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include "../core/theme.cch"
#include "../core/keymap.cch"

static int fails = 0;

static void expect(int cond, const char *msg) {
    if (!cond) {
        fprintf(stderr, "FAIL: %s\n", msg);
        fails++;
    }
}

static void t_pairs(void) {
    const RtxPalPair *pp;
    size_t n = rtx_pal_pairs(&pp), i;
    int light;
    double worst[2] = {99, 99};
    expect(n > 40, "pairs listed");
    for (light = 0; light < 2; light++) {
        for (i = 0; i < n; i++) {
            uint32_t f = rtx_pal_of(light, pp[i].fg), b = rtx_pal_of(light, pp[i].bg);
            double c = rtx_rgb_contrast(f, b), min = rtx_pal_pair_min(pp[i].kind);
            double slack = c / min;
            if (c < min) {
                char m[160];
                snprintf(m, sizeof m, "%s: %s on %s is %.2f:1 (< %.1f)", light ? "light" : "dark",
                         rtx_pal_name(pp[i].fg), rtx_pal_name(pp[i].bg), c, min);
                expect(0, m);
            }
            if (slack < worst[light]) worst[light] = slack;
        }
    }
    printf("theme_smoke: %zu pairs; tightest margin dark %.2fx, light %.2fx\n", n, worst[0],
           worst[1]);
}

/* The terminal: a light SGR's own colours on white (the terminal's
 * default background when it is light), a background SGR under black. */
static void t_sgr(void) {
    int i;
    for (i = 0; i < RTX_P__N; i++) {
        const char *s = rtx_pal_sgr_of(1, (RtxPalId)i);
        const char *d = rtx_pal_sgr_of(0, (RtxPalId)i);
        const char *nm = rtx_pal_name((RtxPalId)i);
        int32_t fg, bg;
        double min;
        expect((s == NULL) == (d == NULL), "a terminal role has both SGRs");
        if (!s) continue;
        expect(s[0] == 0x1b && s[1] == '[' && s[strlen(s) - 1] == 'm', "SGR shape");
        rtx_pal_sgr_rgb(s, &fg, &bg);
        min = (!strcmp(nm, "syn_stale") || !strcmp(nm, "text_dim") || !strcmp(nm, "tbl_rule") ||
               !strcmp(nm, "divider"))
                  ? 3.0
                  : 4.5;
        if (fg >= 0 && bg < 0) {
            double c = rtx_rgb_contrast((uint32_t)fg, 0xffffffu);
            if (c < min) {
                char m[120];
                snprintf(m, sizeof m, "light terminal: %s %.2f:1 on white", nm, c);
                expect(0, m);
            }
        }
        if (bg >= 0 && fg < 0) {
            /* default text (dark on a light terminal) over this band */
            double c = rtx_rgb_contrast(0x000000u, (uint32_t)bg);
            if (c < 4.5) {
                char m[120];
                snprintf(m, sizeof m, "light terminal: text on %s %.2f:1", nm, c);
                expect(0, m);
            }
        }
        if (fg >= 0 && bg >= 0) {
            double c = rtx_rgb_contrast((uint32_t)fg, (uint32_t)bg);
            if (c < 4.5) {
                char m[120];
                snprintf(m, sizeof m, "light terminal: %s own pair %.2f:1", nm, c);
                expect(0, m);
            }
        }
    }
    {
        int32_t fg, bg;
        rtx_pal_sgr_rgb("\x1b[0;1;97;48;5;25m", &fg, &bg);
        expect(fg == 0xffffff && bg == 0x005faf, "sgr parse: 97 on 256-colour 25");
        rtx_pal_sgr_rgb("\x1b[44m", &fg, &bg);
        expect(fg == -1 && bg == 0x0000ee, "sgr parse: ANSI blue background");
        rtx_pal_sgr_rgb("\x1b[38;5;243m", &fg, &bg);
        expect(fg == 0x767676 && bg == -1, "sgr parse: grey 243");
    }
}

static void t_roles(void) {
    int i;
    for (i = 0; i < RTX_P__N; i++) {
        const char *nm = rtx_pal_name((RtxPalId)i);
        expect(nm && nm[0], "role named");
    }
    expect(rtx_pal_of(0, RTX_P_PANE_BG) != rtx_pal_of(1, RTX_P_PANE_BG), "pane differs");
    expect(!rtx_rgb_is_light(rtx_pal_of(0, RTX_P_PANE_BG)), "dark pane is dark");
    expect(rtx_rgb_is_light(rtx_pal_of(1, RTX_P_PANE_BG)), "light pane is light");
    expect(!rtx_rgb_is_light(rtx_pal_of(1, RTX_P_TEXT)), "light text is dark");
    /* The dark theme is what the editor always painted: its text and the
     * diagram colours the Mermaid tests expect. */
    expect(rtx_pal_of(0, RTX_P_TEXT) == 0xe6e6e6u, "dark text unchanged");
    expect(rtx_pal_of(0, RTX_P_MM_BG) == 0x18181cu && rtx_pal_of(0, RTX_P_MM_ACCENT) == 0x6e96e6u,
           "dark diagram colours unchanged");
    expect(rtx_pal_of(0, RTX_P_CARET) == 0xffc850u, "dark caret unchanged");
}

static int osc(const char *s, uint32_t *rgb) {
    return rtx_theme_osc11((const unsigned char *)s, strlen(s), rgb);
}

static void t_osc11(void) {
    uint32_t c = 0;
    expect(osc("\x1b]11;rgb:ffff/ffff/ffff\x1b\\", &c) && c == 0xffffff, "osc 16-bit white");
    expect(osc("\x1b]11;rgb:0000/0000/0000\x07", &c) && c == 0, "osc BEL black");
    expect(osc("\x1b]11;rgb:fd/f6/e3\x1b\\", &c) && c == 0xfdf6e3, "osc 8-bit");
    expect(osc("\x1b]11;rgb:f/0/8\x1b\\", &c) && c == 0xff0088, "osc 4-bit");
    expect(osc("\x1b]11;rgb:1e1e/1e1e/2e2e\x1b\\", &c) && c == 0x1e1e2e, "osc 16-bit dark");
    expect(osc("\x1b]11;rgba:ffff/ffff/ffff/ffff\x1b\\", &c) && c == 0xffffff, "osc rgba");
    expect(osc("\x1b]11;#002b36\x1b\\", &c) && c == 0x002b36, "osc #rrggbb");
    expect(osc("\x1b]11;#fff\x07", &c) && c == 0xffffff, "osc #rgb");
    expect(!osc("\x1b]11;?\x1b\\", &c), "the query is not an answer");
    expect(!osc("\x1b]10;rgb:ffff/ffff/ffff\x1b\\", &c), "OSC 10 is the foreground");
    expect(!osc("\x1b]11;rgb:ffff/ffff\x1b\\", &c), "two channels");
    expect(!osc("\x1b]11;rgb:fffff/0/0\x1b\\", &c), "five digits");
    expect(!osc("\x1b]11;rgb:ffff/ffff/ffff", &c), "unterminated");
    expect(!osc("\x1b]11;white\x1b\\", &c), "a name is not a spec");
    expect(rtx_rgb_is_light(0xffffff) && rtx_rgb_is_light(0xfdf6e3) && rtx_rgb_is_light(0xc0c0c0),
           "light backgrounds");
    expect(!rtx_rgb_is_light(0x000000) && !rtx_rgb_is_light(0x002b36) &&
               !rtx_rgb_is_light(0x1e1e2e) && !rtx_rgb_is_light(0x555555),
           "dark backgrounds");
    expect(rtx_theme_colorfgbg("0;15") == 1, "COLORFGBG light");
    expect(rtx_theme_colorfgbg("15;0") == 0, "COLORFGBG dark");
    expect(rtx_theme_colorfgbg("15;default;0") == 0, "COLORFGBG three fields");
    expect(rtx_theme_colorfgbg("0;7") == 1 && rtx_theme_colorfgbg("0;8") == 0, "COLORFGBG 7 / 8");
    expect(rtx_theme_colorfgbg("0;231") == 1 && rtx_theme_colorfgbg("15;16") == 0,
           "COLORFGBG 256 palette");
    expect(rtx_theme_colorfgbg("0;default") == -1 && rtx_theme_colorfgbg("") == -1 &&
               rtx_theme_colorfgbg(NULL) == -1 && rtx_theme_colorfgbg("x") == -1,
           "COLORFGBG unknown");
    expect(rtx_theme_x256(243) == 0x767676 && rtx_theme_x256(153) == 0xafd7ff, "x256");
}

static void t_switch(void) {
    unsigned g0 = rtx_theme_gen();
    char err[200];
    RtxSettings s;
    expect(rtx_theme_light() == 0, "starts dark");
    expect(rtx_pal(RTX_P_TEXT) == rtx_pal_of(0, RTX_P_TEXT), "dark palette in use");
    expect(rtx_theme_set(1) == 1 && rtx_theme_gen() != g0, "switch bumps the generation");
    expect(rtx_pal(RTX_P_TEXT) == rtx_pal_of(1, RTX_P_TEXT), "light palette in use");
    expect(rtx_pal_sgr(RTX_P_SEL) == rtx_pal_sgr_of(1, RTX_P_SEL), "light SGR in use");
    g0 = rtx_theme_gen();
    expect(rtx_theme_set(1) == 0 && rtx_theme_gen() == g0, "no change, no bump");
    expect(rtx_theme_set(0) == 1, "back to dark");
    expect(rtx_theme_mode_parse("dark") == RTX_THEME_DARK &&
               rtx_theme_mode_parse("light") == RTX_THEME_LIGHT &&
               rtx_theme_mode_parse("auto") == RTX_THEME_AUTO && rtx_theme_mode_parse("x") == -1 &&
               rtx_theme_mode_parse(NULL) == -1,
           "mode names");
    expect(rtx_theme_mode() == RTX_THEME_AUTO, "mode auto by default");
    rtx_theme_mode_set(RTX_THEME_LIGHT);
    expect(rtx_theme_mode() == RTX_THEME_LIGHT, "mode set");
    rtx_theme_mode_set(9);
    expect(rtx_theme_mode() == RTX_THEME_LIGHT, "bad mode ignored");
    expect(rtx_theme_term_bg() == -1, "terminal background unknown");
    rtx_theme_term_bg_set(0xfdf6e3);
    expect(rtx_theme_term_bg() == 0xfdf6e3, "terminal background kept");
    memset(&s, 0, sizeof s);
    err[0] = 0;
    expect(rtx_settings_parse("{\"theme\": \"light\"}", 18, &s, err, sizeof err) == 0 &&
               s.theme == 1 + RTX_THEME_LIGHT,
           "settings theme light");
    memset(&s, 0, sizeof s);
    expect(rtx_settings_parse("{\"theme\": \"auto\"}", 17, &s, err, sizeof err) == 0 &&
               s.theme == 1 + RTX_THEME_AUTO,
           "settings theme auto");
    memset(&s, 0, sizeof s);
    err[0] = 0;
    rtx_settings_parse("{\"theme\": \"sepia\"}", 18, &s, err, sizeof err);
    expect(s.theme == 0 && strstr(err, "theme is dark, light or auto") != NULL,
           "settings theme: a bad value is reported");
}

int main(void) {
    t_pairs();
    t_sgr();
    t_roles();
    t_osc11();
    t_switch();
    if (fails) {
        fprintf(stderr, "theme_smoke: %d failed\n", fails);
        return 1;
    }
    printf("theme_smoke: ok\n");
    return 0;
}
