#!ccc ccs
/*
 * Grid view: delim split, string-face records, per-cell wrap.
 */
#include <ccc/std/prelude.cch>
#include <ccc/script/stdio.cch>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include "../core/document.cch"
#include "../core/layout.cch"

static int fails = 0;

static void expect(int cond, const char *msg) {
    if (!cond) {
        fprintf(stderr, "FAIL: %s\n", msg);
        fails++;
    }
}

static double grid_m(void *ctx, char[:] bytes, RtxStyle st, RtxSectionKind sec) {
    (void)ctx;
    (void)st;
    (void)sec;
    return (double)rtx_utf8_cols(bytes);
}

static double grid_lh(void *ctx, RtxStyle st, RtxSectionKind sec) {
    (void)ctx;
    (void)st;
    (void)sec;
    return 1.0;
}

int main(void) {
    RtxGridField f[8];
    size_t nf;
    RtxGridGeom g;
    RtxLayout L = {0} @destroy;
    RtxDoc d = {0} @destroy;
    RtxMeasure m;

    @errhandler(CCError e) {
        fprintf(stderr, "grid_view_smoke: %s\n", e.message ? e.message : "?");
        return 1;
    }
    @errhandler(RtxIndexErr e) {
        fprintf(stderr, "grid_view_smoke: %s\n", e.message ? e.message : "index");
        return 1;
    }

    nf = rtx_grid_split("a,b,c", 5, ',', f, 8, NULL);
    expect(nf == 3 && f[0].hi == 1 && f[1].lo == 2 && f[2].lo == 4, "split three");
    {
        unsigned char hold[14];
        size_t i;
        for (i = 0; i < 14; i++) hold[i] = (i >= 1 && i <= 11) ? 1 : 0;
        nf = rtx_grid_split("x,has, comma,y", 14, ',', f, 8, hold);
        expect(nf == 2, "string-face hold keeps the comma");
    }
    nf = rtx_grid_split("a,,c", 4, ',', f, 8, NULL);
    expect(nf == 3 && f[1].lo == f[1].hi, "empty field");
    nf = rtx_grid_split("a,", 2, ',', f, 8, NULL);
    expect(nf == 2 && f[1].lo == 2 && f[1].hi == 2, "trailing comma");

    expect(rtx_grid_probe("a,b,c\n1,2,3\n", 12) == ',', "probe comma");
    expect(rtx_grid_probe("a\tb\tc\n", 6) == '\t', "probe tab");
    expect(rtx_grid_probe("a|b|c\n", 6) == '|', "probe pipe");
    expect(rtx_grid_delim_hint("n.csv") == ',', "hint csv");
    expect(rtx_grid_delim_hint("n.tsv") == '\t', "hint tsv");
    expect(rtx_grid_pick_delim("x.csv", "a,b,c", 5) == ',', "pick csv");
    expect(rtx_grid_pick_delim("x.tsv", "", 0) == '\t', "pick empty tsv");

    {
        RtxGridField wr[8];
        size_t nw = rtx_grid_wrap_field("hello world", 11, 6, wr, 8);
        expect(nw == 2 && wr[0].hi == 6 && wr[1].lo == 6, "wrap on space");
        nw = rtx_grid_wrap_field("abcdefgh", 8, 3, wr, 8);
        expect(nw == 3, "hard wrap");
    }

    rtx_grid_geom_init(&g, ',');
    rtx_grid_geom_add(&g, "id,note,city", 12);
    rtx_grid_geom_add(&g, "1,ok,Austin", 11);
    expect(g.ncols == 3, "three cols");
    expect(g.col_w[1] > g.col_w[0], "note wider than id");
    rtx_grid_geom_fit(&g, 20);
    expect(g.ncols == 3, "fit keeps every column");
    rtx_grid_geom_init(&g, ',');
    rtx_grid_geom_add(&g, "x,yyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyy", 52);
    rtx_grid_geom_fit(&g, 80);
    expect(g.col_w[1] == RTX_GRID_MAX_COL, "fat cell caps at MAX_COL not pane");
    expect(rtx_grid_first_line("ab\ncd", 5) == 2, "first_line stops at NL");
    expect(rtx_grid_record_end("a\nb,c\n1", 7, NULL) == 1,
           "no-lex record ends at every NL");
    {
        unsigned char hold[7];
        size_t i;
        for (i = 0; i < 7; i++) hold[i] = 0;
        hold[1] = 1;
        expect(rtx_grid_record_end("a\nb,c\n1", 7, hold) == 5,
               "string-face NL is not a record end");
    }
    {
        RtxGridField wr[8];
        size_t nw = rtx_grid_wrap_field("a\nb", 3, 40, wr, 8);
        expect(nw == 2 && wr[0].hi == 1 && wr[1].lo == 2, "NL is a wrap line");
    }

    rtx_grid_geom_init(&g, ',');
    rtx_grid_geom_add(&g, "a,bb,c", 6);
    rtx_grid_geom_fit(&g, 40);
    expect(rtx_grid_hit("a,bb,c", 6, &g, 0, 0) == 0, "hit col0");
    expect(rtx_grid_hit("a,bb,c", 6, &g, 0, (double)g.col_w[0] + 1) >= 2,
           "hit second field");

    rtx_layout_set_view(&L, RTX_VIEW_DEFAULT);
    rtx_layout_cycle_view(&L);
    expect(L.view == RTX_VIEW_WRAP, "cycle to wrap");
    rtx_layout_cycle_view(&L);
    expect(rtx_layout_is_hex(&L), "cycle to hex");
    rtx_layout_cycle_view(&L);
    expect(rtx_layout_is_grid(&L), "cycle to grid");
    rtx_layout_cycle_view(&L);
    expect(L.view == RTX_VIEW_DEFAULT, "cycle grid to default");

    m.measure = grid_m;
    m.line_height = grid_lh;
    m.ctx = NULL;
    d.from_buffer("id,note\n1,ok\n2,hello world there\n") !>;
    rtx_layout_set_view(&L, RTX_VIEW_GRID);
    expect(!L.wrap && rtx_layout_soft_wrap(&L),
           "grid is vis-row; wrap field is off");
    expect(rtx_layout_uses_left(&L), "grid has left_col");
    L.grid_delim = ',';
    L.lines(&d, &m, 10, 0, 8) !>;
    expect(L.grid_hdr_on && L.grid_hdr_end == 7, "sticky header is line 0");
    expect(L.len >= 2, "grid body omits the header row");
    expect(L.len && L.rows[0].line == 1, "body starts at record 1");
    expect(L.grid.ncols == 2, "two columns");
    {
        size_t i;
        int saw_wrap = 0;
        for (i = 0; i < L.len; i++) {
            if (L.rows[i].line == 2 && L.rows[i].wrap_i > 0) saw_wrap = 1;
        }
        expect(saw_wrap, "long note wraps inside the cell");
    }
    {
        size_t hit = L.hit(&d, &m, 0, 0) !>;
        expect(hit == 8, "grid layout hit is the first body record");
    }

    L.reset();
    d.destroy();
    d.from_path("testdata/grid_nl.csv") !>;
    rtx_layout_set_view(&L, RTX_VIEW_GRID);
    L.grid_delim = ',';
    L.lines(&d, &m, 40, 0, 8) !>;
    expect(L.grid.ncols == 2, "string-face comma is not a column");
    expect(L.len >= 3, "string NL is still one record");
    {
        size_t i;
        int wraps = 0;
        int next = 0;
        for (i = 0; i < L.len; i++) {
            if (L.rows[i].line == 1 && L.rows[i].wrap_i > 0) wraps = 1;
            if (L.rows[i].line == 3) next = 1;
        }
        expect(wraps, "embedded NL is a wrap row of record 1");
        expect(next, "next record is physical line 3");
    }
    {
        char rec[16];
        size_t n = d.read_at(8, rec, 7) !>;
        rtx_grid_bind_span(&L.grid, 8, n);
        expect(rtx_grid_wrap_line(1, rec, n, &L.grid, 0) == 1,
               "wrap 0 stays on record start line");
        expect(rtx_grid_wrap_line(1, rec, n, &L.grid, 1) == 2,
               "wrap 1 is the quoted continuation line");
    }

    L.reset();
    d.destroy();
    d.from_path("testdata/grid_rfc.csv") !>;
    rtx_layout_set_view(&L, RTX_VIEW_GRID);
    L.grid_delim = ',';
    L.lines(&d, &m, 40, 0, 8) !>;
    expect(L.grid.ncols == 3, "RFC example is three columns");
    expect(L.len >= 3, "quoted Description NL is one record");
    {
        size_t i;
        int wraps = 0;
        int jane = 0;
        for (i = 0; i < L.len; i++) {
            if (L.rows[i].line == 1 && L.rows[i].wrap_i > 0) wraps = 1;
            if (L.rows[i].line == 3) jane = 1;
        }
        expect(wraps, "actual NL wraps inside John Doe's Description");
        expect(jane, "Jane Smith is physical line 3");
    }
    {
        size_t mid = d.line_start(2) !>;
        L.reset();
        L.lines(&d, &m, 40, 2, 8) !>;
        expect(L.grid.ncols == 3, "mid-quote camera still has three columns");
        {
            size_t i;
            int wraps = 0;
            int jane = 0;
            int leftover = 0;
            for (i = 0; i < L.len; i++) {
                if (L.rows[i].line == 1 && L.rows[i].wrap_i > 0) wraps = 1;
                if (L.rows[i].line == 3) jane = 1;
                if (L.rows[i].line == 2 && L.rows[i].wrap_i == 0 &&
                    L.rows[i].byte_start == mid)
                    leftover = 1;
            }
            expect(wraps, "back-scan: continuation is wrap of record 1");
            expect(jane, "back-scan: Jane is still physical line 3");
            expect(!leftover, "back-scan: not a leftover record at line 2");
        }
        L.reset();
        L.fill_off(&d, &m, 40, mid, 8) !>;
        expect(L.len && L.rows[0].byte_start < mid,
               "fill_off mid-quote starts at the record");
        expect(rtx_layout_grid_next_line(&d, 0) !> == 1,
               "next after header is John");
        expect(rtx_layout_grid_next_line(&d, 1) !> == 3,
               "next after John skips the quoted NL");
        expect(rtx_layout_grid_prev_line(&d, 3) !> == 1,
               "prev from Jane is John, not the continuation");
        expect(rtx_layout_grid_prev_line(&d, 1) !> == 0,
               "prev from John is the header");
    }

    L.reset();
    d.destroy();
    d.from_buffer(
        "ID,Name,Description\n1,John Doe,\"This is line 1.\nThis is line 2.\"\n2,Jane Smith,\"Single line description.\"\n") !>;
    rtx_layout_set_view(&L, RTX_VIEW_GRID);
    L.grid_delim = ',';
    L.lines(&d, &m, 40, 0, 8) !>;
    {
        size_t i;
        int mid = 0;
        for (i = 0; i < L.len; i++) {
            if (L.rows[i].line == 2) mid = 1;
        }
        expect(mid, "no-lex fallback: every NL is a record");
        expect(rtx_layout_grid_next_line(&d, 1) !> == 2,
               "no-lex next is the next physical line");
    }
    L.reset();
    L.lines(&d, &m, 40, 2, 8) !>;
    expect(L.len && L.rows[0].line == 2,
           "no-lex mid-field camera stays leftover");

    L.reset();
    d.destroy();
    d.from_buffer("id,note\n1,hello\n") !>;
    rtx_layout_set_view(&L, RTX_VIEW_GRID);
    L.grid_delim = ',';
    L.lines(&d, &m, 40, 0, 4) !>;
    {
        double x = L.x_of(&d, &m, 10) !>;
        expect(x >= (double)L.grid.col_w[0], "grid x_of is columns, not a prefix");
        d.caret = 11;
        L.move_row_edge(&d, 0, 0);
        expect(d.caret == 8, "grid home is this wrap's first cell");
        L.move_row_edge(&d, 1, 0);
        expect(d.caret >= 10, "grid end is this wrap's last cell");
    }

    {
        FILE *fp;
        size_t i;
        const char *path = "testdata/generated/grid_win.csv";
        system("mkdir -p testdata/generated");
        fp = fopen(path, "w");
        expect(fp != NULL, "write grid_win.csv");
        if (fp) {
            fputs("id,sku,name,qty,price,note,city\n", fp);
            fputs("0,SKU-000000,item_0,1,0.25,\"says \"\"hi\"\", really\",Austin\n",
                  fp);
            for (i = 1; i < 8000; i++)
                fprintf(fp, "%zu,SKU-%06zu,item_%zu,1,1.00,ok,Lima\n", i, i, i);
            fclose(fp);
        }
        L.reset();
        d.destroy();
        d.from_path(path) !>;
        expect(d.len() > (size_t)RTX_HL_FULL_MAX, "grid win file is window-lex");
        {
            const RtxTmRt *rt = rtx_tm_for_path(path);
            size_t ri, inn = 0;
            size_t e = 0;
            expect(rt != NULL, "csv tm loaded");
            expect(rtx_re_match("\"\"", 2, "\"\"x", 0, 3, &e) && e == 2,
                   "re matches CSV quote-quote");
            if (rt) {
                for (ri = 0; ri < rt->n; ri++) {
                    if (rt->rules[ri].op == RTX_TM_LIT_SPAN)
                        inn += rt->rules[ri].innern;
                }
            }
            expect(inn > 0, "csv string span has an escape inner");
        }
        {
            char buf[256];
            size_t got = d.read_at(0, buf, sizeof buf) !>;
            size_t q = 0;
            while (q + 5 < got && memcmp(buf + q, "\"says", 5) != 0) q++;
            expect(q + 20 < got, "escaped note in the first page");
            d.ensure_hl(rtx_hl_span(0, 8000)) !>;
            expect(rtx_scope_kind(d.style_at(q).scope) == RTX_HL_STRING,
                   "open quote is string");
            {
                size_t r = q;
                while (r + 6 < got && memcmp(buf + r, "really", 6) != 0) r++;
                expect(r + 6 < got, "really is in the first page");
                expect(rtx_scope_kind(d.style_at(r).scope) == RTX_HL_STRING,
                       "escaped quotes stay string through really");
            }
        }
        {
            size_t body = 2000;
            d.ensure_hl(rtx_hl_span(0, 8000)) !>;
            expect(d.style_at(body).scope != RTX_SCOPE_NONE,
                   "paint window colored");
            d.ensure_hl(rtx_hl_keep(0, 80)) !>;
            expect(d.style_at(body).scope != RTX_SCOPE_NONE,
                   "header keep leaves the body window");
            d.ensure_hl(rtx_hl_win(0, 80)) !>;
            expect(d.style_at(body).scope == RTX_SCOPE_NONE,
                   "replace drops the body window");
        }
        rtx_layout_set_view(&L, RTX_VIEW_GRID);
        L.grid_delim = ',';
        L.lines(&d, &m, 80, 0, 24) !>;
        expect(L.len > 10, "grid fill has vis rows");
        {
            size_t off = L.rows[4].byte_start + 2;
            RtxPref pref = {0};
            expect(d.style_at(off).scope != RTX_SCOPE_NONE,
                   "fill colored a vis row");
            d.caret = L.rows[10].byte_start + 1;
            L.move_vert(&d, &m, 80, 1, 0, &pref) !>;
            expect(d.style_at(off).scope != RTX_SCOPE_NONE,
                   "vert lookback does not drop the pane");
        }
    }

    {
        FILE *fp;
        size_t i;
        const char *path = "testdata/generated/grid_long.csv";
        system("mkdir -p testdata/generated");
        fp = fopen(path, "w");
        expect(fp != NULL, "write grid_long.csv");
        if (fp) {
            fputs("id,note\n1,\"", fp);
            for (i = 0; i < 10000; i++) fputc('x', fp);
            fputs("\"\n2,ok\n", fp);
            fclose(fp);
        }
        L.reset();
        d.destroy();
        d.from_path(path) !>;
        expect(d.len() > (size_t)RTX_FRAME_SCRATCH + 16, "long quoted field");
        expect(rtx_layout_grid_next_line(&d, 0) !> == 1,
               "next after header is the long record");
        expect(rtx_layout_grid_next_line(&d, 1) !> == 2,
               "next after 10KiB field is still one record");
        rtx_layout_set_view(&L, RTX_VIEW_GRID);
        L.grid_delim = ',';
        L.lines(&d, &m, 80, 0, 8) !>;
        expect(L.len > 0 && L.rows[0].byte_len > (size_t)RTX_FRAME_SCRATCH,
               "laid-out record is longer than the stack scratch");
        {
            size_t mid = L.rows[0].byte_start + 100;
            RtxPref pref = {0};
            size_t after;
            d.caret = mid;
            L.move_vert(&d, &m, 80, 1, 0, &pref) !>;
            after = d.caret;
            expect(after > mid &&
                       after <= L.rows[0].byte_start + L.rows[0].byte_len,
                   "vert stays inside the long record");
            d.caret = mid;
            L.move_row_edge(&d, 0, 0);
            expect(d.caret >= L.rows[0].byte_start &&
                       d.caret < L.rows[0].byte_start + L.rows[0].byte_len,
                   "home stays on the long wrap");
            L.move_row_edge(&d, 1, 0);
            expect(d.caret > L.rows[0].byte_start, "end of the long wrap");
            d.insert(mid, "z") !>;
            d.reparse_edit(mid, 0) !>;
            expect(rtx_layout_grid_next_line(&d, 1) !> == 2,
                   "insert in the long field does not split the record");
            expect(rtx_scope_kind(d.style_at(mid).scope) == RTX_HL_STRING,
                   "insert keeps the long field a string");
        }
        {
            const char *qpath = "testdata/generated/grid_qcomma.csv";
            fp = fopen(qpath, "w");
            expect(fp != NULL, "write grid_qcomma.csv");
            if (fp) {
                fputs("id,note\n1,\"has, comma\"\n2,ok\n", fp);
                fclose(fp);
            }
            L.reset();
            d.destroy();
            d.from_path(qpath) !>;
            {
                size_t n = d.len();
                d.ensure_hl(rtx_hl_span(0, n)) !>;
            }
            {
                char buf[64];
                size_t got = d.read_at(0, buf, sizeof buf) !>;
                size_t q = 0;
                while (q + 4 < got && memcmp(buf + q, "has,", 4) != 0) q++;
                expect(q + 4 < got, "quoted comma is in the first page");
                expect(rtx_scope_kind(d.style_at(q + 3).scope) == RTX_HL_STRING,
                       "quoted comma is string face");
            }
            expect(rtx_layout_grid_next_line(&d, 1) !> == 2,
                   "quoted comma is not a field/record break");
        }
    }

    printf("grid_view_smoke ok\n");
    return fails ? 1 : 0;
}
