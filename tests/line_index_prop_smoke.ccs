#!ccc ccs
/*
 * Line-index property smoke: random edits vs a naive newline model,
 * plus an explicit stride-boundary insert (line start exactly at off).
 */
#include <ccc/std/prelude.cch>
#include <ccc/script/stdio.cch>
#include <stdio.h>
#include <string.h>
#include "../core/piece_tree.cch"

static int fails = 0;

static void expect(int cond, const char *msg) {
    if (!cond) {
        fprintf(stderr, "FAIL: %s\n", msg);
        fails++;
    }
}

static size_t ref_row_off(const char *p, size_t n, size_t row) {
    size_t i;
    size_t seen = 0;
    if (row == 0) return 0;
    for (i = 0; i < n; i++) {
        if (p[i] == '\n') {
            seen++;
            if (seen == row) return i + 1;
        }
    }
    return n;
}

static size_t ref_nl_before(const char *p, size_t n, size_t off) {
    size_t i;
    size_t seen = 0;
    if (off > n) off = n;
    for (i = 0; i < off; i++) {
        if (p[i] == '\n') seen++;
    }
    return seen;
}

static void expect_match(RtxPieceTree *t, const char *buf, size_t n, const char *tag) {
    size_t i;
    size_t got;
    size_t nrows;
    size_t want;
    size_t got_s;
    size_t got_l;
    char tmp[8192];
    expect(t->check(), tag);
    expect(t->len() == n, tag);
    if (n >= sizeof(tmp)) {
        expect(0, "buf too big");
        return;
    }
    got = t->read_at(0, tmp, n) !>;
    expect(got == n, tag);
    expect(memcmp(tmp, buf, n) == 0, tag);
    nrows = ref_nl_before(buf, n, n) + 1;
    expect(t->line_count() == nrows, tag);
    for (i = 0; i < nrows; i++) {
        want = ref_row_off(buf, n, i);
        got_s = t->line_start(i);
        if (got_s != want) {
            fprintf(stderr, "  %s line_start(%zu): got %zu want %zu\n",
                    tag, i, got_s, want);
            fails++;
        }
    }
    for (i = 0; i <= n; i++) {
        want = ref_nl_before(buf, n, i);
        got_l = t->line_of(i);
        if (got_l != want) {
            fprintf(stderr, "  %s line_of(%zu): got %zu want %zu\n",
                    tag, i, got_l, want);
            fails++;
            break;
        }
    }
}

static void apply_ins(char *buf, size_t *n, size_t cap, size_t off,
                      const char *ins, size_t ins_n) {
    if (off > *n || *n + ins_n > cap) return;
    memmove(buf + off + ins_n, buf + off, *n - off);
    memcpy(buf + off, ins, ins_n);
    *n += ins_n;
}

static void apply_del(char *buf, size_t *n, size_t off, size_t del_n) {
    if (off > *n || del_n > *n - off) return;
    memmove(buf + off, buf + off + del_n, *n - off - del_n);
    *n -= del_n;
}

int main(void) {
    @errhandler(CCError e) {
        fprintf(stderr, "line_index_prop_smoke: %s\n", e.message ? e.message : "?");
        return 1;
    }

    {
        RtxPieceTree t = {0} @destroy;
        char seed[1024];
        char model[1024];
        size_t n = 0;
        size_t i;
        size_t boundary;
        size_t after;
        for (i = 0; i < (size_t)RTX_LINE_STRIDE + 2; i++) {
            seed[n++] = 'a';
            seed[n++] = 'b';
            seed[n++] = 'c';
            seed[n++] = '\n';
        }
        t.empty() !>;
        t.insert(0, cc_slice_from_buffer(seed, n)) !>;
        (void)t.line_start((size_t)RTX_LINE_STRIDE);
        expect(t.lf_ready(), "lf ready after small buffer");
        boundary = t.line_start((size_t)RTX_LINE_STRIDE);
        expect(boundary == ref_row_off(seed, n, (size_t)RTX_LINE_STRIDE),
               "boundary matches ref");
        t.insert(boundary, "XYZ") !>;
        after = t.line_start((size_t)RTX_LINE_STRIDE);
        expect(after == boundary, "insert at stride line start keeps start");
        memcpy(model, seed, n);
        apply_ins(model, &n, sizeof(model), boundary, "XYZ", 3);
        expect_match(&t, model, n, "after stride insert");
    }

    {
        RtxPieceTree t = {0} @destroy;
        char model[4096];
        size_t n = 0;
        unsigned rng = 0xC0FFEE;
        int round;
        t.empty() !>;
        t.insert(0, "alpha\nbeta\ngamma\ndelta\nepsilon\n") !>;
        n = strlen("alpha\nbeta\ngamma\ndelta\nepsilon\n");
        memcpy(model, "alpha\nbeta\ngamma\ndelta\nepsilon\n", n);
        expect_match(&t, model, n, "seed");
        for (round = 0; round < 80; round++) {
            size_t off;
            size_t del_n;
            size_t ins_n;
            size_t i;
            char ins[8];
            rng = rng * 1103515245u + 12345u;
            if ((rng & 1u) == 0 && n > 0) {
                off = (rng >> 1) % (n + 1);
                del_n = 1 + ((rng >> 8) % 4);
                if (del_n > n - off) del_n = n - off;
                if (del_n) {
                    t.erase(off, del_n) !>;
                    apply_del(model, &n, off, del_n);
                }
            } else {
                off = (rng >> 1) % (n + 1);
                ins_n = 1 + ((rng >> 8) % 5);
                for (i = 0; i < ins_n; i++) {
                    rng = rng * 1103515245u + 12345u;
                    ins[i] = (rng & 7u) == 0 ? '\n' : (char)('a' + (int)(rng % 26));
                }
                t.insert(off, cc_slice_from_buffer(ins, ins_n)) !>;
                apply_ins(model, &n, sizeof(model), off, ins, ins_n);
            }
            expect(!t.index_fault(), "no index fault");
            expect_match(&t, model, n, "round");
            if (fails > 20) break;
        }
    }

    if (fails) {
        fprintf(stderr, "line_index_prop_smoke: %d fails\n", fails);
        return 1;
    }
    printf("line_index_prop_smoke ok\n");
    return 0;
}
