/*
 * Headless piece-tree smoke: offset/line, insert, erase, mmap, RB integrity.
 */
#include <ccc/std/prelude.cch>
#include <ccc/script/stdio.cch>
#include <stdio.h>
#include <string.h>
#include "../core/piece_tree.cch"

static int fails = 0;

static void expect(int cond, const char *msg) {
    if (!cond) {
        fprintf(stderr, "FAIL: %s\n", msg);
        fails++;
    }
}

static CCSlice sl(const char *s) {
    return cc_slice_from_buffer((void *)s, s ? strlen(s) : 0);
}

static void expect_text(RtxPieceTree *t, const char *want, const char *msg) {
    size_t n = rtx_piece_tree_len(t);
    char buf[4096];
    size_t got;
    expect(rtx_piece_tree_check(t), "tree check");
    expect(n == strlen(want), msg);
    if (n >= sizeof(buf)) {
        expect(0, "expect_text buffer");
        return;
    }
    got = rtx_piece_tree_read(t, 0, buf, n);
    expect(got == n, msg);
    buf[n] = 0;
    expect(memcmp(buf, want, n) == 0, msg);
    if (memcmp(buf, want, n) != 0) {
        fprintf(stderr, "  got '%s' want '%s'\n", buf, want);
    }
}

int main(void) {
    @errhandler(CCError e) { cc_error_log(e); return 1; }

    {
        RtxPieceTree t;
        rtx_piece_tree_empty(&t) !>;
        expect(rtx_piece_tree_len(&t) == 0, "empty len");
        expect(rtx_piece_tree_line_count(&t) == 1, "empty lines");
        expect(rtx_piece_tree_line_of(&t, 0) == 0, "empty line_of");
        expect(rtx_piece_tree_check(&t), "empty check");
        rtx_piece_tree_insert(&t, 0, sl("ab")) !>;
        expect_text(&t, "ab", "insert empty");
        rtx_piece_tree_insert(&t, 1, sl("XY")) !>;
        expect_text(&t, "aXYb", "insert middle");
        rtx_piece_tree_insert(&t, 0, sl("[")) !>;
        expect_text(&t, "[aXYb", "insert front");
        rtx_piece_tree_insert(&t, rtx_piece_tree_len(&t), sl("]")) !>;
        expect_text(&t, "[aXYb]", "insert end");
        rtx_piece_tree_erase(&t, 1, 3) !>;
        expect_text(&t, "[b]", "erase");
        rtx_piece_tree_destroy(&t);
    }

    {
        RtxPieceTree t;
        rtx_piece_tree_from_buffer(&t, sl("hello\nworld\n")) !>;
        expect_text(&t, "hello\nworld\n", "from_buffer");
        expect(rtx_piece_tree_line_count(&t) == 3, "two newlines -> 3 lines");
        expect(rtx_piece_tree_line_start(&t, 0) == 0, "line 0");
        expect(rtx_piece_tree_line_start(&t, 1) == 6, "line 1");
        expect(rtx_piece_tree_line_start(&t, 2) == 12, "line 2");
        expect(rtx_piece_tree_line_of(&t, 0) == 0, "line_of 0");
        expect(rtx_piece_tree_line_of(&t, 5) == 0, "line_of 5");
        expect(rtx_piece_tree_line_of(&t, 6) == 1, "line_of 6");
        expect(rtx_piece_tree_line_of(&t, 11) == 1, "line_of 11");
        expect(rtx_piece_tree_line_of(&t, 12) == 2, "line_of 12");
        rtx_piece_tree_insert(&t, 6, sl("there\n")) !>;
        expect_text(&t, "hello\nthere\nworld\n", "insert line");
        expect(rtx_piece_tree_line_count(&t) == 4, "three newlines -> 4 lines");
        expect(rtx_piece_tree_line_start(&t, 2) == 12, "line 2 after insert");
        rtx_piece_tree_erase(&t, 0, 6) !>;
        expect_text(&t, "there\nworld\n", "erase first line");
        expect(rtx_piece_tree_line_count(&t) == 3, "lines after erase");
        rtx_piece_tree_destroy(&t);
    }

    {
        RtxPieceTree t;
        rtx_piece_tree_from_buffer(&t, sl("base")) !>;
        int i;
        for (i = 0; i < 64; i++) {
            rtx_piece_tree_insert(&t, 0, sl("x")) !>;
        }
        expect(rtx_piece_tree_len(&t) == 68, "64 prepends");
        expect(rtx_piece_tree_check(&t), "many pieces check");
        for (i = 0; i < 32; i++) {
            rtx_piece_tree_erase(&t, 0, 1) !>;
        }
        expect(rtx_piece_tree_len(&t) == 36, "32 erases");
        expect(rtx_piece_tree_check(&t), "after erase check");
        rtx_piece_tree_destroy(&t);
    }

    {
        RtxPieceTree t;
        rtx_piece_tree_open(&t, "testdata/small.txt") !>;
        expect_text(&t, "hello\nworld\n", "mmap small.txt");
        rtx_piece_tree_insert(&t, 5, sl(",")) !>;
        expect_text(&t, "hello,\nworld\n", "edit mmap");
        rtx_piece_tree_destroy(&t);
    }

    {
        FILE *f = fopen("testdata/generated/mid.txt", "w");
        size_t i;
        char buf[64];
        size_t n;
        if (!f) {
            if (system("mkdir -p testdata/generated") != 0) {
                expect(0, "mkdir generated");
            }
            f = fopen("testdata/generated/mid.txt", "w");
        }
        expect(f != NULL, "open generated");
        if (f) {
            for (i = 0; i < 2000; i++) fprintf(f, "line-%04zu\n", i);
            fclose(f);
        }
        {
            RtxPieceTree t;
            rtx_piece_tree_open(&t, "testdata/generated/mid.txt") !>;
            expect(rtx_piece_tree_line_count(&t) == 2001, "2000 lines + trailing");
            expect(rtx_piece_tree_line_of(&t, rtx_piece_tree_line_start(&t, 1000)) == 1000, "line 1000");
            rtx_piece_tree_insert(&t, rtx_piece_tree_line_start(&t, 1000), sl("INSERTED\n")) !>;
            expect(rtx_piece_tree_line_count(&t) == 2002, "after mid insert");
            n = rtx_piece_tree_read(&t, rtx_piece_tree_line_start(&t, 1000), buf, 9);
            buf[n] = 0;
            expect(n == 9 && memcmp(buf, "INSERTED\n", 9) == 0, "mid text");
            expect(rtx_piece_tree_check(&t), "mmap mid check");
            rtx_piece_tree_destroy(&t);
        }
    }

    if (fails) {
        fprintf(stderr, "%d failure(s)\n", fails);
        return 1;
    }
    printf("piece_tree_smoke ok\n");
    return 0;
}
