#!ccc ccs
/*
 * Headless piece-tree smoke: offset/line, replace, path-backed, RB integrity.
 */
#include <ccc/std/prelude.cch>
#include <ccc/stdio.cch>
#include <stdio.h>
#include <string.h>
#include "../core/piece_tree.cch"

static int fails = 0;

static void expect(int cond, const char *msg) {
    if (!cond) {
        fprintf(stderr, "FAIL: %s\n", msg);
        fails++;
    }
}

static void expect_text(RtxPieceTree *t, const char *want, const char *msg) {
    size_t n = t->len();
    char buf[4096];
    size_t got;
    expect(t->check(), "tree check");
    expect(n == strlen(want), msg);
    if (n >= sizeof(buf)) {
        expect(0, "expect_text buffer");
        return;
    }
    got = t->read_at(0, buf, n) !>;
    expect(got == n, msg);
    buf[n] = 0;
    {
        char[:] slice = cc_slice_from_buffer(buf, n);
        expect(slice.eq_cstr(want), msg);
        if (!slice.eq_cstr(want)) {
            fprintf(stderr, "  got '%s' want '%s'\n", buf, want);
        }
    }
}

int main(void) {
    @errhandler(CCError e) { cc_error_log(e); return 1; }
    @errhandler(RtxIndexErr e) {
        fprintf(stderr, "%s\n", e.message ? e.message : "index");
        return 1;
    }

    {
        RtxPieceTree t = {0} @destroy;
        t.empty() !>;
        expect(t.len() == 0, "empty len");
        expect(t.line_count() == 1, "empty lines");
        {
            size_t _v = t.line_of(0) !>;
            expect(_v == 0, "empty line_of");
        }
        expect(t.check(), "empty check");
        t.replace(0, 0, "ab") !>;
        expect_text(&t, "ab", "insert empty");
        t.replace(1, 0, "XY") !>;
        expect_text(&t, "aXYb", "insert middle");
        t.replace(0, 0, "[") !>;
        expect_text(&t, "[aXYb", "insert front");
        t.replace(t.len(), 0, "]") !>;
        expect_text(&t, "[aXYb]", "insert end");
        t.replace(1, 3, cc_slice_empty()) !>;
        expect_text(&t, "[b]", "erase");
        t.replace(1, 1, "XY") !>;
        expect_text(&t, "[XY]", "replace");
        t.replace(1, 2, cc_slice_empty()) !>;
        expect_text(&t, "[]", "replace delete");
    }

    {
        RtxPieceTree t = {0} @destroy;
        t.from_buffer("hello\nworld\n") !>;
        expect_text(&t, "hello\nworld\n", "from_buffer");
        expect(t.line_count() == 3, "two newlines -> 3 lines");
        {
            size_t _v = t.line_start(0) !>;
            expect(_v == 0, "line 0");
        }
        {
            size_t _v = t.line_start(1) !>;
            expect(_v == 6, "line 1");
        }
        {
            size_t _v = t.line_start(2) !>;
            expect(_v == 12, "line 2");
        }
        {
            size_t _v = t.line_of(0) !>;
            expect(_v == 0, "line_of 0");
        }
        {
            size_t _v = t.line_of(5) !>;
            expect(_v == 0, "line_of 5");
        }
        {
            size_t _v = t.line_of(6) !>;
            expect(_v == 1, "line_of 6");
        }
        {
            size_t _v = t.line_of(11) !>;
            expect(_v == 1, "line_of 11");
        }
        {
            size_t _v = t.line_of(12) !>;
            expect(_v == 2, "line_of 12");
        }
        t.replace(6, 0, "there\n") !>;
        expect_text(&t, "hello\nthere\nworld\n", "insert line");
        expect(t.line_count() == 4, "three newlines -> 4 lines");
        {
            size_t _v = t.line_start(2) !>;
            expect(_v == 12, "line 2 after insert");
        }
        t.replace(0, 6, cc_slice_empty()) !>;
        expect_text(&t, "there\nworld\n", "erase first line");
        expect(t.line_count() == 3, "lines after erase");
    }

    {
        RtxPieceTree t = {0} @destroy;
        t.from_buffer("base") !>;
        int i;
        for (i = 0; i < 64; i++) {
            t.replace(0, 0, "x") !>;
        }
        expect(t.len() == 68, "64 prepends");
        expect(t.check(), "many pieces check");
        for (i = 0; i < 32; i++) {
            t.replace(0, 1, cc_slice_empty()) !>;
        }
        expect(t.len() == 36, "32 erases");
        expect(t.check(), "after erase check");
    }

    {
        RtxPieceTree t = {0} @destroy;
        t.from_path("testdata/small.txt") !>;
        expect_text(&t, "hello\nworld\n", "path small.txt");
        t.replace(5, 0, ",") !>;
        expect_text(&t, "hello,\nworld\n", "edit path");
    }

    {
        RtxPieceTree t = {0} @destroy;
        size_t lo = 99, hi = 99, oldn;
        t.from_path("testdata/small.txt") !>;
        oldn = t.save_span(&lo, &hi);
        expect(oldn == 12 && lo == 12 && hi == 12, "span clean");
        t.replace(t.len(), 0, "!") !>;
        oldn = t.save_span(&lo, &hi);
        expect(oldn == 12 && lo == 12 && hi == 13, "span append");
    }

    {
        RtxPieceTree t = {0} @destroy;
        size_t lo = 99, hi = 99, oldn;
        t.from_path("testdata/small.txt") !>;
        t.replace(6, 5, "there") !>;
        oldn = t.save_span(&lo, &hi);
        expect(oldn == 12 && lo == 6 && hi == 11, "span mid same-len");
        expect_text(&t, "hello\nthere\n", "span mid text");
    }

    {
        RtxPieceTree t = {0} @destroy;
        size_t lo = 99, hi = 99, oldn;
        t.from_path("testdata/small.txt") !>;
        t.replace(5, 0, ",") !>;
        oldn = t.save_span(&lo, &hi);
        expect(oldn == 12 && lo == 5 && hi == 13, "span insert");
        {
            size_t flo = 99, fhi = 99, on;
            on = t.save_orig_span(lo, hi, &flo, &fhi);
            expect(on == 7 && flo == 5 && fhi == 12, "orig span insert tail");
        }
    }

    {
        RtxPieceTree t = {0} @destroy;
        size_t lo = 99, hi = 99, oldn;
        t.from_path("testdata/small.txt") !>;
        t.replace(0, 1, "H") !>;
        oldn = t.save_span(&lo, &hi);
        expect(oldn == 12 && lo == 0 && hi == 1, "span bof same-len");
        expect_text(&t, "Hello\nworld\n", "span bof text");
    }

    {
        RtxPieceTree t = {0} @destroy;
        size_t lo = 99, hi = 99, oldn;
        t.from_path("testdata/small.txt") !>;
        t.replace(5, 7, cc_slice_empty()) !>;
        oldn = t.save_span(&lo, &hi);
        expect(oldn == 12 && lo == 5 && hi == 5, "span shrink");
        expect_text(&t, "hello", "span shrink text");
    }

    {
        RtxPieceTree t = {0} @destroy;
        size_t lo = 99, hi = 99, oldn;
        t.from_path("testdata/small.txt") !>;
        t.replace(0, t.len(), cc_slice_empty()) !>;
        oldn = t.save_span(&lo, &hi);
        expect(oldn == 12 && lo == 0 && hi == 0, "span delete-all");
    }

    {
        RtxPieceTree t = {0} @destroy;
        size_t lo = 99, hi = 99, oldn;
        t.from_buffer("hello\nworld\n") !>;
        t.replace(6, 5, "there") !>;
        oldn = t.save_span(&lo, &hi);
        expect(oldn == 12 && lo == 6 && hi == 11, "span from_buffer mid");
    }

    {
        FILE *f = fopen("testdata/generated/mid.txt", "w");
        size_t i;
        char buf[64];
        size_t n;
        if (!f) {
            if (system("mkdir -p testdata/generated") != 0) {
                expect(0, "mkdir generated");
            }
            f = fopen("testdata/generated/mid.txt", "w");
        }
        expect(f != NULL, "open generated");
        if (f) {
            for (i = 0; i < 2000; i++) fprintf(f, "line-%04zu\n", i);
            fclose(f);
        }
        {
            RtxPieceTree t = {0} @destroy;
            t.from_path("testdata/generated/mid.txt") !>;
            expect(t.line_count() == 2001, "2000 lines + trailing");
            {
                size_t off = t.line_start(1000) !>;
                {
            size_t _v = t.line_of(off) !>;
            expect(_v == 1000, "line 1000");
        }
            }
            expect(t.line_off_ok, "index warm before mid insert");
            {
                size_t off = t.line_start(1000) !>;
                t.replace(off, 0, "INSERTED\n") !>;
            }
            expect(t.line_off_ok, "index patched after mid insert");
            expect(t.line_count() == 2002, "after mid insert");
            {
                size_t off = t.line_start(500) !>;
                {
            size_t _v = t.line_of(off) !>;
            expect(_v == 500, "line before edit");
        }
            }
            {
                size_t off = t.line_start(1500) !>;
                {
            size_t _v = t.line_of(off) !>;
            expect(_v == 1500, "line after edit");
        }
            }
            {
                size_t off = t.line_start(1000) !>;
                n = t.read_at(off, buf, 9) !>;
            }
            buf[n] = 0;
            {
                char[:] slice = cc_slice_from_buffer(buf, 9);
                expect(n == 9 && slice.eq_cstr("INSERTED\n"), "mid text");
            }
            {
                size_t off = t.line_start(1000) !>;
                t.replace(off, 9, cc_slice_empty()) !>;
            }
            expect(t.line_off_ok, "index patched after mid erase");
            {
                size_t off = t.line_start(1000) !>;
                {
            size_t _v = t.line_of(off) !>;
            expect(_v == 1000, "line 1000 after erase");
        }
            }
            expect(t.check(), "path mid check");
        }
    }

    {
        RtxPieceTree t = {0} @destroy;
        CCArena a = {0} @destroy;
        RtxPieceRef *refs = NULL;
        size_t nrefs = 0;
        a = cc_arena_heap(kilobytes(1));
        expect(a.base != NULL, "capture arena");
        t.from_buffer("hello\nworld\n") !>;
        t.replace(5, 0, "XXX") !>;
        expect_text(&t, "helloXXX\nworld\n", "insert before capture");
        t.capture_range(0, t.len(), a, &refs, &nrefs) !>;
        expect(nrefs >= 2, "capture split pieces");
        t.replace(0, t.len(), cc_slice_empty()) !>;
        expect(t.len() == 0, "erased for splice");
        t.splice_refs(0, refs, nrefs) !>;
        expect_text(&t, "helloXXX\nworld\n", "splice restores");
        expect(t.check(), "splice check");
    }

    if (fails) {
        fprintf(stderr, "%d failure(s)\n", fails);
        return 1;
    }
    printf("piece_tree_smoke ok\n");
    return 0;
}
