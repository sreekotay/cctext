#!ccc ccs
/*
 * Headless piece-tree smoke: offset/line, replace, path-backed, RB integrity.
 */
#include <ccc/std/prelude.cch>
#include <ccc/stdio.cch>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <fcntl.h>
#include <sys/stat.h>
#include <unistd.h>
#include "../core/piece_tree.cch"

static int fails = 0;

static void expect(int cond, const char *msg) {
    if (!cond) {
        fprintf(stderr, "FAIL: %s\n", msg);
        fails++;
    }
}

static void expect_text(RtxPieceTree *t, const char *want, const char *msg) {
    size_t n = t->len();
    char buf[4096];
    size_t got;
    @errhandler(CCError e) {
        (void)e;
        fprintf(stderr, "FAIL: %s\n", msg);
        fails++;
        return;
    }
    expect(t->check(), "tree check");
    expect(n == strlen(want), msg);
    if (n >= sizeof(buf)) {
        expect(0, "expect_text buffer");
        return;
    }
    got = t->read_at(0, cc_slice_from_buffer(buf, n)) !>;
    expect(got == n, msg);
    buf[n] = 0;
    {
        char[:] slice = cc_slice_from_buffer(buf, n);
        expect(slice.eq_cstr(want), msg);
        if (!slice.eq_cstr(want)) {
            fprintf(stderr, "  got '%s' want '%s'\n", buf, want);
        }
    }
}

/* Page p of a store fixture is RTX_PAGE_SIZE copies of 'A' + p % 26, with
 * a newline every 64 bytes. */
static char ps_byte(size_t off) {
    if (off % 64 == 63) return '\n';
    return (char)('A' + (int)((off / (size_t)RTX_PAGE_SIZE) % 26));
}

static int ps_write(const char *path, size_t pages, int flags) {
    char buf[RTX_PAGE_SIZE];
    size_t p, i;
    int fd = open(path, O_WRONLY | O_CREAT | flags, 0644);
    if (fd < 0) return 0;
    for (p = 0; p < pages; p++) {
        for (i = 0; i < sizeof(buf); i++) buf[i] = ps_byte(p * sizeof(buf) + i);
        if (write(fd, buf, sizeof(buf)) != (ssize_t)sizeof(buf)) {
            close(fd);
            return 0;
        }
    }
    close(fd);
    return 1;
}

static int ps_page_ok(const char *buf, size_t page, size_t n) {
    size_t i;
    for (i = 0; i < n; i++)
        if (buf[i] != ps_byte(page * (size_t)RTX_PAGE_SIZE + i)) return 0;
    return 1;
}

static int ps_append_faults(RtxPieceTree *t, size_t n) {
    size_t lf;
    @errhandler(CCError e) {
        (void)e;
        return 1;
    }
    lf = t->append_copy(0, n) !>;
    (void)lf;
    return 0;
}

static int ps_cloexec(int fd) {
    int fl = fcntl(fd, F_GETFD);
    return fl >= 0 && (fl & FD_CLOEXEC);
}

int main(void) {
    @errhandler(CCError e) { cc_error_log(e); return 1; }
    @errhandler(RtxIndexErr e) {
        fprintf(stderr, "%s\n", e.message ? e.message : "index");
        return 1;
    }

    {
        RtxPieceTree t = {0} @destroy;
        t.empty() !>;
        expect(t.len() == 0, "empty len");
        expect(t.line_count() == 1, "empty lines");
        {
            size_t _v = t.line_of(0) !>;
            expect(_v == 0, "empty line_of");
        }
        expect(t.check(), "empty check");
        t.replace(0, 0, "ab") !>;
        expect_text(&t, "ab", "insert empty");
        t.replace(1, 0, "XY") !>;
        expect_text(&t, "aXYb", "insert middle");
        t.replace(0, 0, "[") !>;
        expect_text(&t, "[aXYb", "insert front");
        t.replace(t.len(), 0, "]") !>;
        expect_text(&t, "[aXYb]", "insert end");
        t.replace(1, 3, cc_slice_empty()) !>;
        expect_text(&t, "[b]", "erase");
        t.replace(1, 1, "XY") !>;
        expect_text(&t, "[XY]", "replace");
        t.replace(1, 2, cc_slice_empty()) !>;
        expect_text(&t, "[]", "replace delete");
    }

    {
        RtxPieceTree t = {0} @destroy;
        t.from_buffer("hello\nworld\n") !>;
        expect_text(&t, "hello\nworld\n", "from_buffer");
        expect(t.line_count() == 3, "two newlines -> 3 lines");
        {
            size_t _v = t.line_start(0) !>;
            expect(_v == 0, "line 0");
        }
        {
            size_t _v = t.line_start(1) !>;
            expect(_v == 6, "line 1");
        }
        {
            size_t _v = t.line_start(2) !>;
            expect(_v == 12, "line 2");
        }
        {
            size_t _v = t.line_of(0) !>;
            expect(_v == 0, "line_of 0");
        }
        {
            size_t _v = t.line_of(5) !>;
            expect(_v == 0, "line_of 5");
        }
        {
            size_t _v = t.line_of(6) !>;
            expect(_v == 1, "line_of 6");
        }
        {
            size_t _v = t.line_of(11) !>;
            expect(_v == 1, "line_of 11");
        }
        {
            size_t _v = t.line_of(12) !>;
            expect(_v == 2, "line_of 12");
        }
        t.replace(6, 0, "there\n") !>;
        expect_text(&t, "hello\nthere\nworld\n", "insert line");
        expect(t.line_count() == 4, "three newlines -> 4 lines");
        {
            size_t _v = t.line_start(2) !>;
            expect(_v == 12, "line 2 after insert");
        }
        t.replace(0, 6, cc_slice_empty()) !>;
        expect_text(&t, "there\nworld\n", "erase first line");
        expect(t.line_count() == 3, "lines after erase");
    }

    {
        RtxPieceTree t = {0} @destroy;
        t.from_buffer("base") !>;
        int i;
        for (i = 0; i < 64; i++) {
            t.replace(0, 0, "x") !>;
        }
        expect(t.len() == 68, "64 prepends");
        expect(t.check(), "many pieces check");
        for (i = 0; i < 32; i++) {
            t.replace(0, 1, cc_slice_empty()) !>;
        }
        expect(t.len() == 36, "32 erases");
        expect(t.check(), "after erase check");
    }

    {
        RtxPieceTree t = {0} @destroy;
        t.from_path("testdata/small.txt") !>;
        expect_text(&t, "hello\nworld\n", "path small.txt");
        t.replace(5, 0, ",") !>;
        expect_text(&t, "hello,\nworld\n", "edit path");
    }

    {
        RtxPieceTree t = {0} @destroy;
        size_t lo = 99, hi = 99, oldn;
        t.from_path("testdata/small.txt") !>;
        oldn = t.save_span(&lo, &hi);
        expect(oldn == 12 && lo == 12 && hi == 12, "span clean");
        t.replace(t.len(), 0, "!") !>;
        oldn = t.save_span(&lo, &hi);
        expect(oldn == 12 && lo == 12 && hi == 13, "span append");
    }

    {
        RtxPieceTree t = {0} @destroy;
        size_t lo = 99, hi = 99, oldn;
        t.from_path("testdata/small.txt") !>;
        t.replace(6, 5, "there") !>;
        oldn = t.save_span(&lo, &hi);
        expect(oldn == 12 && lo == 6 && hi == 11, "span mid same-len");
        expect_text(&t, "hello\nthere\n", "span mid text");
    }

    {
        RtxPieceTree t = {0} @destroy;
        size_t lo = 99, hi = 99, oldn;
        t.from_path("testdata/small.txt") !>;
        t.replace(5, 0, ",") !>;
        oldn = t.save_span(&lo, &hi);
        expect(oldn == 12 && lo == 5 && hi == 13, "span insert");
        {
            size_t flo = 99, fhi = 99, on;
            on = t.save_orig_span(lo, hi, &flo, &fhi);
            expect(on == 7 && flo == 5 && fhi == 12, "orig span insert tail");
        }
    }

    {
        RtxPieceTree t = {0} @destroy;
        size_t lo = 99, hi = 99, oldn;
        t.from_path("testdata/small.txt") !>;
        t.replace(0, 1, "H") !>;
        oldn = t.save_span(&lo, &hi);
        expect(oldn == 12 && lo == 0 && hi == 1, "span bof same-len");
        expect_text(&t, "Hello\nworld\n", "span bof text");
    }

    {
        RtxPieceTree t = {0} @destroy;
        size_t lo = 99, hi = 99, oldn;
        t.from_path("testdata/small.txt") !>;
        t.replace(5, 7, cc_slice_empty()) !>;
        oldn = t.save_span(&lo, &hi);
        expect(oldn == 12 && lo == 5 && hi == 5, "span shrink");
        expect_text(&t, "hello", "span shrink text");
    }

    {
        RtxPieceTree t = {0} @destroy;
        size_t lo = 99, hi = 99, oldn;
        t.from_path("testdata/small.txt") !>;
        t.replace(0, t.len(), cc_slice_empty()) !>;
        oldn = t.save_span(&lo, &hi);
        expect(oldn == 12 && lo == 0 && hi == 0, "span delete-all");
    }

    {
        RtxPieceTree t = {0} @destroy;
        size_t lo = 99, hi = 99, oldn;
        t.from_buffer("hello\nworld\n") !>;
        t.replace(6, 5, "there") !>;
        oldn = t.save_span(&lo, &hi);
        expect(oldn == 12 && lo == 6 && hi == 11, "span from_buffer mid");
    }

    {
        FILE *f = fopen("testdata/generated/mid.txt", "w");
        size_t i;
        char buf[64];
        size_t n;
        if (!f) {
            if (system("mkdir -p testdata/generated") != 0) {
                expect(0, "mkdir generated");
            }
            f = fopen("testdata/generated/mid.txt", "w");
        }
        expect(f != NULL, "open generated");
        if (f) {
            for (i = 0; i < 2000; i++) fprintf(f, "line-%04zu\n", i);
            fclose(f);
        }
        {
            RtxPieceTree t = {0} @destroy;
            t.from_path("testdata/generated/mid.txt") !>;
            expect(t.line_count() == 2001, "2000 lines + trailing");
            {
                size_t off = t.line_start(1000) !>;
                {
            size_t _v = t.line_of(off) !>;
            expect(_v == 1000, "line 1000");
        }
            }
            expect(t.line_off_ok, "index warm before mid insert");
            {
                size_t off = t.line_start(1000) !>;
                t.replace(off, 0, "INSERTED\n") !>;
            }
            expect(t.line_off_ok, "index patched after mid insert");
            expect(t.line_count() == 2002, "after mid insert");
            {
                size_t off = t.line_start(500) !>;
                {
            size_t _v = t.line_of(off) !>;
            expect(_v == 500, "line before edit");
        }
            }
            {
                size_t off = t.line_start(1500) !>;
                {
            size_t _v = t.line_of(off) !>;
            expect(_v == 1500, "line after edit");
        }
            }
            {
                size_t off = t.line_start(1000) !>;
                n = t.read_at(off, cc_slice_from_buffer(buf, 9)) !>;
            }
            buf[n] = 0;
            {
                char[:] slice = cc_slice_from_buffer(buf, 9);
                expect(n == 9 && slice.eq_cstr("INSERTED\n"), "mid text");
            }
            {
                size_t off = t.line_start(1000) !>;
                t.replace(off, 9, cc_slice_empty()) !>;
            }
            expect(t.line_off_ok, "index patched after mid erase");
            {
                size_t off = t.line_start(1000) !>;
                {
            size_t _v = t.line_of(off) !>;
            expect(_v == 1000, "line 1000 after erase");
        }
            }
            expect(t.check(), "path mid check");
        }
    }

    {
        RtxPieceTree t = {0} @destroy;
        CCArena a = {0} @destroy;
        RtxPieceRef *refs = NULL;
        size_t nrefs = 0;
        a = cc_arena_heap(kilobytes(1));
        expect(a.base != NULL, "capture arena");
        t.from_buffer("hello\nworld\n") !>;
        t.replace(5, 0, "XXX") !>;
        expect_text(&t, "helloXXX\nworld\n", "insert before capture");
        t.capture_range(0, t.len(), a, &refs, &nrefs) !>;
        expect(nrefs >= 2, "capture split pieces");
        t.replace(0, t.len(), cc_slice_empty()) !>;
        expect(t.len() == 0, "erased for splice");
        t.splice_refs(0, refs, nrefs) !>;
        expect_text(&t, "helloXXX\nworld\n", "splice restores");
        expect(t.check(), "splice check");
    }

    {
        RtxPageStore s = {0} @destroy;
        const char *old = getenv("TMPDIR");
        char keep[1024];
        int failed = 0;
        keep[0] = 0;
        if (old && old[0]) snprintf(keep, sizeof(keep), "%s", old);
        setenv("TMPDIR", "/no/such/cctext_tmpdir", 1);
        rtx_page_store_zero(&s);
        {
            @errhandler(CCError e) {
                (void)e;
                failed = 1;
            }
            s.append_add("x", 1) !>;
        }
        if (keep[0]) setenv("TMPDIR", keep, 1);
        else unsetenv("TMPDIR");
        expect(failed, "add temp respects TMPDIR");
    }

    {
        /* A failed page load must not leave the victim's name on the new
         * page's bytes. Fill every slot, shrink the file under the store,
         * and fault a load that evicts page 0. */
        const char *path = "testdata/generated/ps_victim.txt";
        RtxPageStore s = {0} @destroy;
        char buf[RTX_PAGE_SIZE];
        size_t p;
        int faulted = 0;
        (void)system("mkdir -p testdata/generated");
        expect(ps_write(path, RTX_PAGE_CACHE_DEFAULT + 2, O_TRUNC), "victim fixture");
        rtx_page_store_zero(&s);
        s.open_original(cc_slice_cstr(path)) !>;
        for (p = 0; p < (size_t)RTX_PAGE_CACHE_DEFAULT; p++) {
            s.read(RTX_STORE_ORIG, p * sizeof(buf), buf, sizeof(buf)) !>;
        }
        expect(ps_page_ok(buf, RTX_PAGE_CACHE_DEFAULT - 1, sizeof(buf)), "last cached page");
        /* Page CACHE_DEFAULT keeps 100 bytes: the load reads those, then
         * hits EOF (short) after overwriting the front of page 0's slot. */
        expect(truncate(path, (off_t)RTX_PAGE_CACHE_DEFAULT * RTX_PAGE_SIZE + 100) == 0,
               "victim truncate");
        {
            @errhandler(CCError e) {
                (void)e;
                faulted = 1;
            }
            s.read(RTX_STORE_ORIG, (size_t)RTX_PAGE_CACHE_DEFAULT * sizeof(buf), buf,
                   sizeof(buf)) !>;
        }
        expect(faulted, "short page load is an error");
        memset(buf, 0, sizeof(buf));
        s.read(RTX_STORE_ORIG, 0, buf, sizeof(buf)) !>;
        expect(ps_page_ok(buf, 0, sizeof(buf)), "page 0 is not the failed load's bytes");
        remove(path);
    }

    {
        /* Only regular files open, and never by blocking on a FIFO. Both
         * store fds are close-on-exec. */
        const char *fifo = "testdata/generated/ps_fifo";
        const char *reg = "testdata/generated/ps_reg.txt";
        RtxPageStore s = {0} @destroy;
        int refused;
        (void)system("mkdir -p testdata/generated");
        remove(fifo);
        expect(mkfifo(fifo, 0600) == 0, "mkfifo");
        rtx_page_store_zero(&s);
        refused = 0;
        alarm(5); /* a blocking open() parks here waiting for a writer */
        {
            @errhandler(CCError e) {
                refused = e.kind == CC_ERR_INVALID_ARG;
            }
            s.open_original(cc_slice_cstr(fifo)) !>;
        }
        alarm(0);
        expect(refused, "FIFO is not a document");
        expect(!rtx_page_store_is_open(&s), "FIFO leaves the store closed");
        refused = 0;
        {
            @errhandler(CCError e) {
                refused = e.kind == CC_ERR_INVALID_ARG;
            }
            s.open_original(cc_slice_cstr("testdata/generated")) !>;
        }
        expect(refused, "directory is not a document");
        remove(fifo);
        expect(ps_write(reg, 1, O_TRUNC), "regular fixture");
        s.open_original(cc_slice_cstr(reg)) !>;
        expect(ps_cloexec(s.orig_fd), "original fd is close-on-exec");
        {
            char b[8];
            int fl = fcntl(s.orig_fd, F_GETFL);
            expect(fl >= 0 && !(fl & O_NONBLOCK), "original fd is blocking again");
            s.read(RTX_STORE_ORIG, 0, b, sizeof(b)) !>;
            expect(ps_page_ok(b, 0, sizeof(b)), "regular read");
        }
        s.append_add("x", 1) !>;
        expect(ps_cloexec(s.add_fd), "add fd is close-on-exec");
        remove(reg);
    }

    {
        /* append_copy that faults mid-copy leaves the tree as it was.
         * The source is evicted from the page cache (file > the pool),
         * then shrunk on disk so the second chunk's page load fails. */
        const char *path = "testdata/generated/ps_append.txt";
        const size_t pages = (size_t)RTX_PAGE_CACHE_DEFAULT + 44;
        RtxPieceTree t = {0} @destroy;
        size_t len0, lf0;
        int faulted = 0;
        (void)system("mkdir -p testdata/generated");
        expect(ps_write(path, pages, O_TRUNC), "append fixture");
        t.from_path(cc_slice_cstr(path)) !>;
        {
            @errhandler(RtxIndexErr ie) {
                (void)ie;
                expect(0, "append fixture scan");
            }
            rtx_line_scan_to(&t, t.len()) !>;
        }
        expect(t.lf_ready(), "append fixture weights ready");
        len0 = t.len();
        lf0 = t.root->subtree_lf;
        expect(truncate(path, (off_t)RTX_PAGE_SIZE + 4096) == 0, "append truncate");
        faulted = ps_append_faults(&t, (size_t)RTX_PAGE_SIZE * 3);
        expect(faulted, "append_copy faults on the short page");
        expect(t.len() == len0, "failed append_copy keeps len");
        expect(t.root->subtree_lf == lf0, "failed append_copy keeps weights");
        /* Write the bytes back (same inode) so check() can read every piece. */
        expect(ps_write(path, pages, 0), "append refill");
        expect(t.check(), "failed append_copy leaves a consistent tree");
        {
            size_t lf = t.append_copy(0, (size_t)RTX_PAGE_SIZE * 2) !>;
            expect(lf == (size_t)RTX_PAGE_SIZE * 2 / 64, "append_copy lf");
            expect(t.len() == len0 + (size_t)RTX_PAGE_SIZE * 2, "append_copy len");
            expect(t.check(), "append_copy check");
        }
        remove(path);
    }

    if (fails) {
        fprintf(stderr, "%d failure(s)\n", fails);
        return 1;
    }
    printf("piece_tree_smoke ok\n");
    return 0;
}
