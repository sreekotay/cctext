#!ccc ccs
/*
 * Fake WidthMeasure: mono cells are 1, proportional 'i' is 0.5, others 1.
 * Proves wrap + hit-test without a window.
 */
#include <ccc/std/prelude.cch>
#include <ccc/script/stdio.cch>
#include <stdio.h>
#include <string.h>
#include "../core/document.cch"
#include "../core/layout.cch"
#include "../core/workspace.cch"

static int fails = 0;

static void expect(int cond, const char *msg) {
    if (!cond) {
        fprintf(stderr, "FAIL: %s\n", msg);
        fails++;
    }
}

static double meas(void *ctx, char[:] bytes, RtxStyle style, RtxSectionKind sec) {
    size_t i;
    double w = 0;
    (void)ctx;
    (void)style;
    (void)sec;
    for (i = 0; i < bytes.len; i++) {
        char c = bytes.ptr[i];
        w += (c == 'i' || c == 'l' || c == '.') ? 0.5 : 1.0;
    }
    return w;
}

static double lh(void *ctx, RtxStyle style, RtxSectionKind sec) {
    (void)ctx;
    (void)style;
    return sec == RTX_SEC_CODE ? 1.0 : 1.2;
}

int main(void) {
    @errhandler(CCError e) { cc_error_log(e); return 1; }
    @errhandler(RtxIndexErr e) {
        fprintf(stderr, "%s\n", e.message ? e.message : "index");
        return 1;
    }
    RtxMeasure m;
    m.measure = meas;
    m.line_height = lh;
    m.ctx = NULL;

    {
        RtxDoc d = {0} @destroy;
        RtxLayout L = {0} @destroy;
        d.from_buffer("hello world\nnext") !>;
        L.wrap = 0;
        L.doc(&d, &m, 4.0) !>;
        expect(L.len == 2, "wrap off: two physical lines");
        expect(L.rows[0].byte_len == 11, "wrap off keeps the whole line");
        L.wrap = 1;
        L.doc(&d, &m, 8.0) !>;
        expect(L.len == 3, "word wrap: hello / world / next");
        expect(L.rows[0].byte_len == 6, "break after 'hello '");
        expect(L.rows[1].byte_len == 5, "world on the next visual row");
        expect(d.section_at(0) == RTX_SEC_PROSE, "default prose");
        {
            size_t hit = L.hit(&d, &m, 0, 0) !>;
            expect(hit == 0, "hit origin");
            expect(L.row_of(0) == 0, "row_of origin");
            expect(L.row_of(6) == 1, "wrap boundary prefers later row");
        }
    }

    {
        RtxDoc d = {0} @destroy;
        RtxLayout L = {0} @destroy;
        d.from_buffer("abcdefghij") !>;
        L.wrap = 1;
        L.doc(&d, &m, 3.0) !>;
        expect(L.len == 4, "hard wrap 3+3+3+1");
        expect(L.rows[0].byte_len == 3, "abc");
        expect(L.rows[3].byte_len == 1, "j");
    }

    {
        RtxDoc d = {0} @destroy;
        RtxLayout L = {0} @destroy;
        d.from_buffer("int xyzzyxx;") !>;
        d.secs[0].kind = RTX_SEC_CODE;
        L.wrap = 0;
        L.doc(&d, &m, 4.0) !>;
        expect(L.len == 1, "code does not wrap when off");
        L.wrap = 1;
        L.doc(&d, &m, 4.0) !>;
        expect(L.len > 1, "code wraps when on");
    }

    {
        RtxDoc d = {0} @destroy;
        d.from_buffer("=== code ===\nint x;\n=== prose ===\n*hi* `c`\n") !>;
        expect(d.sec_len >= 2, "two sections");
        expect(d.section_at(0) == RTX_SEC_CODE, "code section");
        expect(d.run_len >= 2, "bold + mono runs");
        {
            size_t i;
            int saw_kw = 0;
            for (i = 0; i < d.run_len; i++) {
                if (d.runs[i].style.hl == RTX_HL_KEYWORD) saw_kw = 1;
            }
            expect(saw_kw, "code section keywords highlighted");
        }
        d.insert(0, "Z") !>;
        expect(d.len() > 0, "insert");
    }

    {
        RtxDoc d = {0} @destroy;
        d.from_path("testdata/mixed.txt") !>;
        expect(d.sec_len >= 2, "mixed.txt sections");
    }

    /* Caret on the next physical line: reveal must keep wrapped rows above
     * it, not snap `top` to the caret line (that made wheel-up stick). */
    {
        RtxBuf b = {0} @destroy;
        b.doc.from_buffer("abcdefghij\nnext") !>;
        b.layout.wrap = 1;
        b.layout.fill(&b.doc, &m, 3.0, 0, 8) !>;
        expect(b.layout.len >= 5, "abcdefghij wraps + next");
        b.doc.caret = b.doc.line_start(1) !>;
        b.top = 0;
        b.top_wrap = 0;
        b.reveal(3) !>;
        expect(b.top == 0, "reveal stays on the wrapped line above the caret");
        expect(b.top_wrap == 2, "scrolls just enough for the caret row");
        b.top_wrap = 0;
        b.reveal(5) !>;
        expect(b.top == 0 && b.top_wrap == 0, "taller view keeps the wrap start");
        b.scroll_vis(&m, 3.0, 1) !>;
        b.reveal(5) !>;
        expect(b.top == 0 && b.top_wrap == 1, "wheel-down into wraps above the caret");
        b.scroll_vis(&m, 3.0, -1) !>;
        b.reveal(5) !>;
        expect(b.top == 0 && b.top_wrap == 0, "wheel-up returns to the wrap start");
        b.doc.caret = 0;
        b.top = 1;
        b.top_wrap = 0;
        b.layout.fill(&b.doc, &m, 3.0, 1, 4) !>;
        b.reveal(4) !>;
        expect(b.top == 0, "caret above the window jumps to its line");
    }

    /* Virtual column: long → short → long keeps the goal col. */
    {
        RtxDoc d = {0} @destroy;
        RtxLayout L = {0} @destroy;
        RtxPref pref = {0};
        d.from_buffer("xxxxxxxxxxxxxxxxxxxx\nshort\nxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx\n") !>;
        L.wrap = 0;
        d.caret = 15;
        L.move_vert(&d, &m, 80.0, 1, 0, &pref) !>;
        {
            size_t ln = d.line_of(d.caret) !>;
            size_t ls = d.line_start(1) !>;
            expect(ln == 1, "down onto the short line");
            expect(d.caret - ls == 5, "clamped to short EOL");
        }
        expect(pref.ok && pref.col == 15, "goal col stays 15");
        L.move_vert(&d, &m, 80.0, 1, 0, &pref) !>;
        {
            size_t ln = d.line_of(d.caret) !>;
            size_t ls = d.line_start(2) !>;
            expect(ln == 2, "down onto the long line");
            expect(d.caret - ls == 15, "restored goal col");
        }
        L.move_vert(&d, &m, 80.0, -1, 0, &pref) !>;
        L.move_vert(&d, &m, 80.0, -1, 0, &pref) !>;
        {
            size_t ln = d.line_of(d.caret) !>;
            expect(ln == 0 && d.caret == 15, "up restores the first line");
        }
    }

    /* End sticks to each line's end, not the first line's width. */
    {
        RtxDoc d = {0} @destroy;
        RtxLayout L = {0} @destroy;
        RtxPref pref = {0};
        d.from_buffer("xxxxx\nsh\nxxxxxxxxxxxxxxxxxxxx\n") !>;
        L.wrap = 0;
        d.move_line_edge(1, 0) !>;
        pref.ok = 1;
        pref.eol = 1;
        expect(d.caret == 5, "end of first line");
        L.move_vert(&d, &m, 80.0, 1, 0, &pref) !>;
        {
            size_t ls = d.line_start(1) !>;
            expect(d.caret - ls == 2, "EOL on short");
        }
        L.move_vert(&d, &m, 80.0, 1, 0, &pref) !>;
        {
            size_t ls = d.line_start(2) !>;
            expect(d.caret - ls == 20, "EOL on longer, not col 5");
        }
    }

    /* Shift-up/down keeps the anchor and the goal col. */
    {
        RtxDoc d = {0} @destroy;
        RtxLayout L = {0} @destroy;
        RtxPref pref = {0};
        d.from_buffer("abcdefghij\nxy\nabcdefghij\n") !>;
        L.wrap = 0;
        d.caret = 7;
        d.sel_anchor = 7;
        L.move_vert(&d, &m, 80.0, 1, 1, &pref) !>;
        expect(d.sel_anchor == 7, "shift keeps anchor");
        expect(d.has_sel(), "shift-down selects");
        L.move_vert(&d, &m, 80.0, 1, 1, &pref) !>;
        {
            size_t ls = d.line_start(2) !>;
            expect(d.caret - ls == 7, "shift restores col");
        }
        expect(d.sel_anchor == 7, "anchor still the start");
    }

    /* Box select is per-line columns, not a stream span. */
    {
        RtxWs w = {0} @destroy;
        RtxDoc *d;
        char *paths[1];
        paths[0] = (char *)"testdata/small.txt";
        w.open_files(1, paths) !>;
        d = w.doc();
        d->destroy();
        d->from_buffer("abcdef\n123456\nxyzxyz\n") !>;
        d->sel_box = 1;
        d->sel_anchor = 2;
        {
            size_t ls = d->line_start(2) !>;
            d->caret = ls + 2;
        }
        d->box_acol = 2;
        d->box_ccol = 5;
        expect(d->has_sel(), "box has sel");
        expect((d->sel_covers(2) !>) && (d->sel_covers(3) !>) && (d->sel_covers(4) !>), "first line cols");
        expect(!(d->sel_covers(0) !>) && !(d->sel_covers(5) !>), "outside the box");
        {
            size_t ls = d->line_start(1) !>;
            expect(d->sel_covers(ls + 2) !>, "second line col 2");
            expect(!(d->sel_covers(ls) !>), "second line col 0 out");
        }
        {
            int n = w.copy() !>;
            expect(n == 1, "box copy");
            expect(w.clip.len == 11, "cde\\n345\\nzxy");
        }
        d->type("Q") !>;
        expect(d->sel_box, "type keeps a zero-width box");
        expect(d->box_acol == 3 && d->box_ccol == 3, "caret after the insert");
        d->undo() !>;
        expect(d->sel_box, "undo restores box mode");
        expect(d->box_acol == 2 && d->box_ccol == 5, "undo restores box cols");
        expect(d->has_sel(), "undo restores box selection");
        d->redo() !>;
        expect(d->sel_box, "redo restores box mode");
        expect(d->box_acol == 3 && d->box_ccol == 3, "redo restores post-type box");
    }

    /* Byte-rail scrollbar: file bytes, never soft line_count. */
    {
        RtxScrollRail r;
        int ty = -1, th = -1;
        r.pos = 0;
        r.vis = 100;
        r.len = 1000;
        r.ready = 1;
        expect(rtx_scroll_rail_thumb_h(&r, 100, 20) == 20, "thumb floor at 10%");
        rtx_scroll_rail_thumb(&r, 100, 20, &ty, &th);
        expect(ty == 0 && th == 20, "start thumb");
        r.pos = 900;
        rtx_scroll_rail_thumb(&r, 100, 20, &ty, &th);
        expect(ty == 80 && th == 20, "end thumb");
        expect(rtx_scroll_rail_pos_at(&r, 100, 20, 40) == 450, "mid pos");
        expect(rtx_scroll_rail_pos_at(&r, 100, 20, -10) == 0, "clamp low");
        expect(rtx_scroll_rail_pos_at(&r, 100, 20, 200) == 900, "clamp high");
        r.vis = 1000;
        expect(rtx_scroll_rail_thumb_h(&r, 100, 20) == 100, "fits = full thumb");
        expect(rtx_scroll_rail_pos_at(&r, 100, 20, 50) == 0, "fits stays put");
        expect(!rtx_scroll_rail_needed(&r), "fits hides rail");
        r.vis = 100;
        r.len = 1000;
        expect(rtx_scroll_rail_needed(&r), "overflow shows rail");
        r.len = 0;
        r.vis = 0;
        r.pos = 0;
        expect(rtx_scroll_rail_thumb_h(&r, 100, 20) == 100, "empty = full thumb");
    }
    {
        RtxBuf b = {0} @destroy;
        RtxScrollRail rail;
        b.doc.from_buffer("aaa\nbbb\nccc\nddd\neee\n") !>;
        b.layout.fill(&b.doc, &m, 80.0, 0, 2) !>;
        b.top = 0;
        rail = b.scroll_rail(2) !>;
        expect(rail.len == b.len(), "rail len is bytes");
        expect(rail.ready, "small buffer lf ready");
        expect(rail.pos == 0, "top at byte 0");
        expect(rail.vis > 0 && rail.vis < rail.len, "window smaller than file");
        expect(b.scroll_needed(2), "short window needs rail");
        b.layout.fill(&b.doc, &m, 80.0, 0, 20) !>;
        expect(!b.scroll_needed(20), "whole file in pane hides rail");
        b.scroll_to_off(rail.len / 2) !>;
        {
            size_t mid_ln = b.line_of(rail.len / 2) !>;
            expect(b.top == mid_ln, "snap to line at mid byte");
        }
        expect(b.top_wrap == 0, "text rail clears wrap");
        rtx_layout_set_view(&b.layout, RTX_VIEW_HEX);
        b.scroll_to_off(17) !>;
        expect(b.top_byte == 16, "hex rail aligns");
        rail = b.scroll_rail(4) !>;
        expect(rail.ready, "hex rail always ready");
        expect(rail.pos == 16, "hex pos is top_byte");
        {
            size_t ln0 = b.doc.line_of(0) !>;
            expect(b.doc.line_guess(0) == ln0, "guess matches when ready");
        }
        expect(b.doc.index_covers(b.len()), "small buffer covers EOF");
    }

    if (fails) {
        fprintf(stderr, "%d failure(s)\n", fails);
        return 1;
    }
    printf("layout_measure_smoke ok\n");
    return 0;
}
