#!ccc ccs
/*
 * Fake WidthMeasure: mono cells are 1, proportional 'i' is 0.5, others 1.
 * Proves wrap + hit-test without a window.
 */
#include <ccc/std/prelude.cch>
#include <ccc/script/stdio.cch>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include "../core/document.cch"
#include "../core/layout.cch"
#include "../core/workspace.cch"
#include "../core/find.cch"
#include "../core/ui.cch"
#include "../core/browse.cch"

static int fails = 0;

static void expect(int cond, const char *msg) {
    if (!cond) {
        fprintf(stderr, "FAIL: %s\n", msg);
        fails++;
    }
}

static double meas(void *ctx, char[:] bytes, RtxStyle style, RtxSectionKind sec) {
    size_t i;
    double w = 0;
    (void)ctx;
    (void)style;
    (void)sec;
    for (i = 0; i < bytes.len; i++) {
        char c = bytes.ptr[i];
        w += (c == 'i' || c == 'l' || c == '.') ? 0.5 : 1.0;
    }
    return w;
}

static double lh(void *ctx, RtxStyle style, RtxSectionKind sec) {
    (void)ctx;
    (void)style;
    return sec == RTX_SEC_CODE ? 1.0 : 1.2;
}

static double utf8_meas(void *ctx, char[:] bytes, RtxStyle style, RtxSectionKind sec) {
    (void)ctx;
    (void)style;
    (void)sec;
    return (double)rtx_utf8_cols(bytes);
}

int main(void) {
    @errhandler(CCError e) { cc_error_log(e); return 1; }
    @errhandler(RtxIndexErr e) {
        fprintf(stderr, "%s\n", e.message ? e.message : "index");
        return 1;
    }
    RtxMeasure m;
    m.measure = meas;
    m.line_height = lh;
    m.ctx = NULL;

    {
        RtxDoc d = {0} @destroy;
        RtxLayout L = {0} @destroy;
        d.from_buffer("hello world\nnext") !>;
        L.wrap = 0;
        L.doc(&d, &m, 4.0) !>;
        expect(L.len == 2, "wrap off: two physical lines");
        expect(L.rows[0].byte_len == 11, "wrap off keeps the whole line");
        L.wrap = 1;
        L.doc(&d, &m, 8.0) !>;
        expect(L.len == 3, "word wrap: hello / world / next");
        expect(L.rows[0].byte_len == 6, "break after 'hello '");
        expect(L.rows[1].byte_len == 5, "world on the next visual row");
        expect(d.section_at(0) == RTX_SEC_PROSE, "default prose");
        {
            size_t hit = L.hit(&d, &m, 0, 0) !>;
            expect(hit == 0, "hit origin");
            expect(L.row_of(0) == 0, "row_of origin");
            expect(L.row_of(6) == 1, "wrap boundary prefers later row");
        }
    }

    {
        RtxDoc d = {0} @destroy;
        RtxLayout L = {0} @destroy;
        d.from_buffer("abcdefghij") !>;
        L.wrap = 1;
        L.doc(&d, &m, 3.0) !>;
        expect(L.len == 4, "hard wrap 3+3+3+1");
        expect(L.rows[0].byte_len == 3, "abc");
        expect(L.rows[3].byte_len == 1, "j");
    }

    {
        RtxDoc d = {0} @destroy;
        RtxLayout L = {0} @destroy;
        d.from_buffer("int xyzzyxx;") !>;
        d.secs[0].kind = RTX_SEC_CODE;
        L.wrap = 0;
        L.doc(&d, &m, 4.0) !>;
        expect(L.len == 1, "code does not wrap when off");
        L.wrap = 1;
        L.doc(&d, &m, 4.0) !>;
        expect(L.len > 1, "code wraps when on");
    }

    /* Last whitespace if the next token fits after it; else a hard break. */
    {
        RtxDoc d = {0} @destroy;
        RtxLayout L = {0} @destroy;
        d.from_buffer("xxxx yyyy") !>;
        L.wrap = 1;
        L.doc(&d, &m, 6.0) !>;
        expect(L.len == 2, "break after the space");
        expect(L.rows[0].byte_len == 5 && L.rows[0].byte_start == 0, "xxxx ");
        expect(L.rows[1].byte_len == 4 && L.rows[1].byte_start == 5, "yyyy");
        d.destroy();
        d.from_buffer("xxxx yyyyyyyy") !>;
        L.reset();
        L.wrap = 1;
        L.doc(&d, &m, 6.0) !>;
        expect(L.len == 3, "long token hard-wraps after the space row");
        expect(L.rows[0].byte_len == 5, "xxxx ");
        expect(L.rows[1].byte_start == 5 && L.rows[1].byte_len == 6, "yyyyyy");
        expect(L.rows[2].byte_len == 2, "yy remainder");
    }

    /* Empty physical line is a zero-length visual row. A glyph wider
     * than the window still occupies a row (DESIGN). */
    {
        RtxDoc d = {0} @destroy;
        RtxLayout L = {0} @destroy;
        d.from_buffer("a\n\nb") !>;
        L.wrap = 1;
        L.doc(&d, &m, 8.0) !>;
        expect(L.len == 3, "empty line is a row");
        expect(L.rows[1].byte_len == 0, "empty row");
        expect(L.rows[1].line == 1, "empty row is physical line 1");
        d.destroy();
        d.from_buffer("W") !>;
        L.reset();
        L.wrap = 1;
        L.doc(&d, &m, 0.25) !>;
        expect(L.len == 1, "overwide glyph is one row");
        expect(L.rows[0].byte_len == 1, "consumed the glyph");
    }

    /* Visual-row up/down, Home/End, and fill from one long physical line. */
    {
        RtxDoc d = {0} @destroy;
        RtxLayout L = {0} @destroy;
        RtxPref pref = {0};
        d.from_buffer("abcdefghij") !>;
        L.wrap = 1;
        L.doc(&d, &m, 3.0) !>;
        expect(L.len == 4, "abc/def/ghi/j");
        expect(L.rows_for_line(0) == 4, "one physical line, four visual");
        d.caret = 1;
        L.move_vert(&d, &m, 3.0, 1, 0, &pref) !>;
        expect(d.caret == 4, "down to the same x on the next wrap row");
        L.move_vert(&d, &m, 3.0, 1, 0, &pref) !>;
        expect(d.caret == 7, "down again");
        L.move_vert(&d, &m, 3.0, -1, 0, &pref) !>;
        expect(d.caret == 4, "up restores the wrap row");
        L.move_row_edge(&d, 1, 0);
        expect(d.caret == 6, "End is the visual row end, not EOL");
        d.caret = 4;
        L.move_row_edge(&d, 0, 0);
        expect(d.caret == 3, "Home is the visual row start");
        pref.ok = 0;
        pref.eol = 1;
        d.caret = 1;
        L.move_vert(&d, &m, 3.0, 1, 0, &pref) !>;
        expect(d.caret == 6, "EOL pref sticks to each wrap-row end");
        {
            RtxLayout F = {0} @destroy;
            F.wrap = 1;
            F.fill(&d, &m, 3.0, 0, 8) !>;
            expect(F.len == 4, "fill does not invent rows past the line");
            expect(F.rows_for_line(0) == 4, "fill still one physical line");
        }
    }

    /* Down off the last wrap row lands on the next physical line. */
    {
        RtxDoc d = {0} @destroy;
        RtxLayout L = {0} @destroy;
        RtxPref pref = {0};
        d.from_buffer("abcdefghij\nXY") !>;
        L.wrap = 1;
        L.doc(&d, &m, 3.0) !>;
        d.caret = 9;
        L.move_vert(&d, &m, 3.0, 1, 0, &pref) !>;
        expect((d.line_of(d.caret) !>) == 1, "down off last wrap row");
        expect(d.caret == (d.line_start(1) !>), "lands on the next line");
    }

    /* Insert / newline in a wrapped line: after_edit rebuilds visual rows. */
    {
        RtxDoc d = {0} @destroy;
        RtxLayout L = {0} @destroy;
        d.from_buffer("abcdefghij") !>;
        L.wrap = 1;
        L.lines(&d, &m, 3.0, 0, 1) !>;
        expect(L.len == 4, "before edit");
        d.insert(3, "XXX") !>;
        L.view_after_edit(&d, &m, 3.0) !>;
        expect(L.len == 5, "insert grew wrap rows (13 chars / 3)");
        expect(L.rows[0].byte_len == 3, "first row still width-capped");
        expect(L.row_of(3) == 1, "insert site is on the next wrap row");
        d.insert(3, "\n") !>;
        L.lines(&d, &m, 3.0, 0, 2) !>;
        expect(L.rows[0].byte_len == 3, "newline split the physical line");
        expect(L.rows[0].line == 0 && L.rows[1].line == 1, "new physical line");
        expect((d.line_of(4) !>) == 1, "bytes after the newline are line 1");
    }

    {
        RtxDoc d = {0} @destroy;
        d.from_buffer("=== code ===\nint x;\n=== prose ===\n*hi* `c`\n") !>;
        expect(d.sec_len >= 2, "two sections");
        expect(d.section_at(0) == RTX_SEC_CODE, "code section");
        expect(d.run_len >= 2, "bold + mono runs");
        {
            size_t i;
            int saw_kw = 0;
            for (i = 0; i < d.run_len; i++) {
                if (rtx_scope_kind(d.runs[i].style.scope) == RTX_HL_KEYWORD) {
                    saw_kw = 1;
                }
            }
            expect(saw_kw, "code section keywords highlighted");
        }
        d.insert(0, "Z") !>;
        expect(d.len() > 0, "insert");
    }

    /* Code then === prose ===: digits in the paragraph are not C numbers. */
    {
        const char *path = "testdata/generated/code_then_prose.txt";
        const char *src =
            "=== code ===\n"
            "int fn_31058916(void) {\n"
            "    /* block 31058916 */\n"
            "    int x = 31058916;\n"
            "    return x;\n"
            "}\n"
            "=== prose ===\n"
            "Block 31058917. A *bold* word and `mono` in a wrapping paragraph that keeps\n";
        FILE *fp;
        RtxDoc d = {0} @destroy;
        size_t code_off, prose_off, i;
        int code_hl = 0, prose_hl = 0, saw_bold = 0, saw_mono = 0;
        char ch;
        (void)system("mkdir -p testdata/generated");
        fp = fopen(path, "w");
        expect(fp != NULL, "code_then_prose fopen");
        if (fp) {
            fputs(src, fp);
            fclose(fp);
            d.from_path(path) !>;
            expect(d.section_at(0) == RTX_SEC_CODE, "code-then-prose starts CODE");
            code_off = strlen("=== code ===\nint fn_31058916(void) {\n    /* block 31058916 */\n    int x = ");
            prose_off = strlen("=== code ===\nint fn_31058916(void) {\n    /* block 31058916 */\n    int x = 31058916;\n    return x;\n}\n=== prose ===\nBlock ");
            expect((d.read_at(code_off, &ch, 1) !>) == 1 && ch == '3', "code digit off");
            expect((d.read_at(prose_off, &ch, 1) !>) == 1 && ch == '3', "prose digit off");
            expect(d.section_at(prose_off) == RTX_SEC_PROSE, "Block N is prose");
            expect(rtx_scope_kind(d.style_at(code_off).scope) == RTX_HL_NUMBER,
                   "code 31058916 is numeric");
            expect(rtx_scope_kind(d.style_at(prose_off).scope) == RTX_HL_NONE,
                   "prose 31058917 is not numeric");
            for (i = 0; i < d.run_len; i++) {
                RtxRun r = d.runs[i];
                int num = rtx_scope_kind(r.style.scope) == RTX_HL_NUMBER;
                if (num && r.start <= code_off && code_off < r.start + r.len) {
                    code_hl = 1;
                }
                if (num && r.start <= prose_off && prose_off < r.start + r.len) {
                    prose_hl = 1;
                }
                if (r.style.bold) saw_bold = 1;
                if (r.style.mono) saw_mono = 1;
            }
            expect(code_hl, "code number run");
            expect(!prose_hl, "no number run on prose digits");
            expect(saw_bold && saw_mono, "prose *bold* and `mono`");
            unlink(path);
        }
    }

    {
        RtxDoc d = {0} @destroy;
        size_t i;
        int saw_bold = 0;
        d.from_path("testdata/mixed.txt") !>;
        expect(d.section_at(0) == RTX_SEC_PROSE, "mixed.txt root prose");
        d.caret = 20;
        d.sel_anchor = 20;
        d.type("*") !>;
        d.reparse_edit(d.last_off, d.last_markup) !>;
        expect(!d.last_markup, "star does not rescan sections");
        for (i = 0; i < d.run_len; i++) {
            if (d.runs[i].style.bold) saw_bold = 1;
        }
        expect(saw_bold, "mixed *bold* after star");
        d.caret = d.len();
        d.sel_anchor = d.caret;
        d.type("=") !>;
        d.reparse_edit(d.last_off, d.last_markup) !>;
        expect(d.last_markup, "equals rescans");
        expect(d.section_at(0) == RTX_SEC_PROSE, "mixed still prose at BOF");
        saw_bold = 0;
        for (i = 0; i < d.run_len; i++) {
            if (d.runs[i].style.bold) saw_bold = 1;
        }
        expect(saw_bold, "mixed *bold* after section rescan");
    }

    {
        RtxDoc d = {0} @destroy;
        d.from_path("testdata/mixed.txt") !>;
        expect(d.sec_len >= 2, "mixed.txt sections");
    }

    /* Path-backed fixtures that wrap at a normal 80-col pane — not width 3. */
    {
        RtxDoc d = {0} @destroy;
        RtxLayout L = {0} @destroy;
        size_t phys, prose_rows, comment_rows, i;
        d.from_path("testdata/wrap.txt") !>;
        L.wrap = 0;
        L.doc(&d, &m, 80.0) !>;
        phys = L.len;
        expect(phys == 6, "wrap.txt physical lines");
        expect(L.rows[1].byte_len == 178, "prose line is one row when wrap is off");
        expect(L.rows[1].width > 80.0, "prose line is wider than 80");
        L.wrap = 1;
        L.doc(&d, &m, 80.0) !>;
        expect(L.len > phys, "wrap.txt grows visual rows at width 80");
        prose_rows = L.rows_for_line(1);
        expect(prose_rows > 1, "long prose wraps at 80");
        comment_rows = L.rows_for_line(4);
        expect(comment_rows > 1, "98-col code comment wraps at 80");
        expect(L.rows_for_line(2) == 1, "short line stays one row");
        for (i = 0; i < L.len; i++) {
            expect(L.rows[i].width <= 80.0 + 0.001, "no wrap row wider than the pane");
        }
        d.destroy();
        d.from_path("testdata/mixed.txt") !>;
        L.reset();
        L.wrap = 1;
        L.doc(&d, &m, 80.0) !>;
        expect(L.rows_for_line(1) > 1, "mixed.txt prose wraps at 80");
    }

    /* Caret on the next physical line: reveal must keep wrapped rows above
     * it, not snap `top` to the caret line (that made wheel-up stick). */
    {
        RtxBuf b = {0} @destroy;
        b.doc.from_buffer("abcdefghij\nnext") !>;
        b.layout.wrap = 1;
        b.layout.fill(&b.doc, &m, 3.0, 0, 8) !>;
        expect(b.layout.len >= 5, "abcdefghij wraps + next");
        b.doc.caret = b.doc.line_start(1) !>;
        b.top = 0;
        b.top_wrap = 0;
        b.reveal(3) !>;
        expect(b.top == 0, "reveal stays on the wrapped line above the caret");
        expect(b.top_wrap == 2, "scrolls just enough for the caret row");
        b.top_wrap = 0;
        b.reveal(5) !>;
        expect(b.top == 0 && b.top_wrap == 0, "taller view keeps the wrap start");
        b.scroll_vis(&m, 3.0, 1) !>;
        b.reveal(5) !>;
        expect(b.top == 0 && b.top_wrap == 1, "wheel-down into wraps above the caret");
        b.scroll_vis(&m, 3.0, -1) !>;
        b.reveal(5) !>;
        expect(b.top == 0 && b.top_wrap == 0, "wheel-up returns to the wrap start");
        b.doc.caret = 0;
        b.top = 1;
        b.top_wrap = 0;
        b.layout.fill(&b.doc, &m, 3.0, 1, 4) !>;
        b.reveal(4) !>;
        expect(b.top == 0, "caret above the window jumps to its line");
    }

    /* land is a seek; line_of hands off so wrap follow can set top_wrap. */
    {
        RtxBuf b = {0} @destroy;
        b.doc.from_buffer("abcdefghij\nnext") !>;
        b.layout.wrap = 1;
        b.doc.caret = 6;
        b.land(2) !>;
        expect(b.seek_valid, "land is a seek until labeled");
        b.ensure_view(&m, 3.0, 2) !>;
        expect(!b.seek_valid, "line_of hands off");
        expect(b.top == 0 && b.top_wrap == 0, "land shows the line start");
        b.reveal(2) !>;
        expect(b.top == 0 && b.top_wrap == 1, "follow brings the wrap row on screen");
    }

    /* Virtual column: long → short → long keeps the goal col. */
    {
        RtxDoc d = {0} @destroy;
        RtxLayout L = {0} @destroy;
        RtxPref pref = {0};
        d.from_buffer("xxxxxxxxxxxxxxxxxxxx\nshort\nxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx\n") !>;
        L.wrap = 0;
        d.caret = 15;
        L.move_vert(&d, &m, 80.0, 1, 0, &pref) !>;
        {
            size_t ln = d.line_of(d.caret) !>;
            size_t ls = d.line_start(1) !>;
            expect(ln == 1, "down onto the short line");
            expect(d.caret - ls == 5, "clamped to short EOL");
        }
        expect(pref.ok && pref.col == 15, "goal col stays 15");
        L.move_vert(&d, &m, 80.0, 1, 0, &pref) !>;
        {
            size_t ln = d.line_of(d.caret) !>;
            size_t ls = d.line_start(2) !>;
            expect(ln == 2, "down onto the long line");
            expect(d.caret - ls == 15, "restored goal col");
        }
        L.move_vert(&d, &m, 80.0, -1, 0, &pref) !>;
        L.move_vert(&d, &m, 80.0, -1, 0, &pref) !>;
        {
            size_t ln = d.line_of(d.caret) !>;
            expect(ln == 0 && d.caret == 15, "up restores the first line");
        }
    }

    /* End sticks to each line's end, not the first line's width. */
    {
        RtxDoc d = {0} @destroy;
        RtxLayout L = {0} @destroy;
        RtxPref pref = {0};
        d.from_buffer("xxxxx\nsh\nxxxxxxxxxxxxxxxxxxxx\n") !>;
        L.wrap = 0;
        d.move_line_edge(1, 0) !>;
        pref.ok = 1;
        pref.eol = 1;
        expect(d.caret == 5, "end of first line");
        L.move_vert(&d, &m, 80.0, 1, 0, &pref) !>;
        {
            size_t ls = d.line_start(1) !>;
            expect(d.caret - ls == 2, "EOL on short");
        }
        L.move_vert(&d, &m, 80.0, 1, 0, &pref) !>;
        {
            size_t ls = d.line_start(2) !>;
            expect(d.caret - ls == 20, "EOL on longer, not col 5");
        }
    }

    /* Shift-up/down keeps the anchor and the goal col. */
    {
        RtxDoc d = {0} @destroy;
        RtxLayout L = {0} @destroy;
        RtxPref pref = {0};
        d.from_buffer("abcdefghij\nxy\nabcdefghij\n") !>;
        L.wrap = 0;
        d.caret = 7;
        d.sel_anchor = 7;
        L.move_vert(&d, &m, 80.0, 1, 1, &pref) !>;
        expect(d.sel_anchor == 7, "shift keeps anchor");
        expect(d.has_sel(), "shift-down selects");
        L.move_vert(&d, &m, 80.0, 1, 1, &pref) !>;
        {
            size_t ls = d.line_start(2) !>;
            expect(d.caret - ls == 7, "shift restores col");
        }
        expect(d.sel_anchor == 7, "anchor still the start");
    }

    /* Box select is per-line columns, not a stream span. */
    {
        RtxWs w = {0} @destroy;
        RtxDoc *d;
        char *paths[1];
        paths[0] = (char *)"testdata/small.txt";
        w.open_files(1, paths) !>;
        d = w.doc();
        d->destroy();
        d->from_buffer("abcdef\n123456\nxyzxyz\n") !>;
        d->sel_box = 1;
        d->sel_anchor = 2;
        {
            size_t ls = d->line_start(2) !>;
            d->caret = ls + 2;
        }
        d->box_acol = 2;
        d->box_ccol = 5;
        expect(d->has_sel(), "box has sel");
        expect((d->sel_covers(2) !>) && (d->sel_covers(3) !>) && (d->sel_covers(4) !>), "first line cols");
        expect(!(d->sel_covers(0) !>) && !(d->sel_covers(5) !>), "outside the box");
        {
            size_t ls = d->line_start(1) !>;
            expect(d->sel_covers(ls + 2) !>, "second line col 2");
            expect(!(d->sel_covers(ls) !>), "second line col 0 out");
        }
        {
            int n = w.copy() !>;
            expect(n == 1, "box copy");
            expect(w.clip.len == 11, "cde\\n345\\nzxy");
        }
        d->type("Q") !>;
        expect(d->sel_box, "type keeps a zero-width box");
        expect(d->box_acol == 3 && d->box_ccol == 3, "caret after the insert");
        d->undo() !>;
        expect(d->sel_box, "undo restores box mode");
        expect(d->box_acol == 2 && d->box_ccol == 5, "undo restores box cols");
        expect(d->has_sel(), "undo restores box selection");
        d->redo() !>;
        expect(d->sel_box, "redo restores box mode");
        expect(d->box_acol == 3 && d->box_ccol == 3, "redo restores post-type box");
    }

    /* Byte-rail scrollbar: file bytes, never soft line_count. */
    {
        RtxScrollRail r;
        int ty = -1, th = -1;
        r.pos = 0;
        r.vis = 100;
        r.len = 1000;
        r.ready = 1;
        expect(rtx_scroll_rail_thumb_h(&r, 100, 20) == 20, "thumb floor at 10%");
        rtx_scroll_rail_thumb(&r, 100, 20, &ty, &th);
        expect(ty == 0 && th == 20, "start thumb");
        r.pos = 900;
        rtx_scroll_rail_thumb(&r, 100, 20, &ty, &th);
        expect(ty == 80 && th == 20, "end thumb");
        expect(rtx_scroll_rail_pos_at(&r, 100, 20, 40) == 450, "mid pos");
        expect(rtx_scroll_rail_pos_at(&r, 100, 20, -10) == 0, "clamp low");
        expect(rtx_scroll_rail_pos_at(&r, 100, 20, 200) == 900, "clamp high");
        r.vis = 1000;
        expect(rtx_scroll_rail_thumb_h(&r, 100, 20) == 100, "fits = full thumb");
        expect(rtx_scroll_rail_pos_at(&r, 100, 20, 50) == 0, "fits stays put");
        expect(!rtx_scroll_rail_needed(&r), "fits hides rail");
        r.vis = 100;
        r.len = 1000;
        expect(rtx_scroll_rail_needed(&r), "overflow shows rail");
        expect(rtx_scroll_rail_mark_y(&r, 100, 0) == 0, "mark at start");
        expect(rtx_scroll_rail_mark_y(&r, 100, 999) == 99, "mark at end");
        expect(rtx_scroll_rail_mark_y(&r, 100, 500) == 49, "mark mid");
        r.len = 0;
        r.vis = 0;
        r.pos = 0;
        expect(rtx_scroll_rail_thumb_h(&r, 100, 20) == 100, "empty = full thumb");
    }
    {
        RtxBuf b = {0} @destroy;
        RtxScrollRail rail;
        b.doc.from_buffer("aaa\nbbb\nccc\nddd\neee\n") !>;
        b.layout.fill(&b.doc, &m, 80.0, 0, 2) !>;
        b.top = 0;
        rail = b.scroll_rail(2) !>;
        expect(rail.len == b.len(), "rail len is bytes");
        expect(rail.ready, "small buffer lf ready");
        expect(rail.pos == 0, "top at byte 0");
        expect(rail.vis > 0 && rail.vis < rail.len, "window smaller than file");
        expect(b.scroll_needed(2), "short window needs rail");
        b.layout.fill(&b.doc, &m, 80.0, 0, 20) !>;
        expect(!b.scroll_needed(20), "whole file in pane hides rail");
        b.scroll_to_off(rail.len / 2) !>;
        {
            size_t mid = rail.len / 2;
            size_t floor = rtx_doc_line_floor(&b.doc, mid) !>;
            size_t mid_ln = b.line_of(mid) !>;
            expect(b.seek_valid, "byte rail stays a seek");
            expect(b.seek_off == floor, "snap to line start at mid byte");
            b.ensure_view(&m, 80.0, 2) !>;
            expect(!b.seek_valid, "line_of hands off to the line camera");
            expect(b.top == mid_ln, "handoff origin is the seek floor");
        }
        expect(b.top_wrap == 0, "text rail clears wrap");
        rtx_layout_set_view(&b.layout, RTX_VIEW_HEX);
        b.scroll_to_off(17) !>;
        expect(b.top_byte == 16, "hex rail aligns");
        rail = b.scroll_rail(4) !>;
        expect(rail.ready, "hex rail always ready");
        expect(rail.pos == 16, "hex pos is top_byte");
        {
            size_t ln0 = b.doc.line_of(0) !>;
            expect(b.doc.line_guess(0) == ln0, "guess matches when ready");
        }
        expect(b.doc.index_covers(b.len()), "small buffer covers EOF");
    }

    /* Jump / find land in the active view. Hex % keeps the byte. */
    {
        RtxBuf b = {0} @destroy;
        RtxUi ui = {0};
        size_t n, off, keep, ln;
        b.doc.from_buffer("aaa\nbbb\nccc\nddd\neee\n") !>;
        n = b.len();
        off = n ? (n - 1) * 50 / 100 : 0;
        rtx_layout_set_view(&b.layout, RTX_VIEW_HEX);
        ui.jump = 1;
        ui.jump_len = 3;
        ui.jump_buf[0] = '5';
        ui.jump_buf[1] = '0';
        ui.jump_buf[2] = '%';
        ui.jump_buf[3] = 0;
        rtx_ui_apply_jump(&ui, &b, 4) !>;
        expect(b.doc.caret == off, "hex jump % keeps the byte");
        expect(off / (size_t)RTX_HEX_COLS >= b.top_byte / (size_t)RTX_HEX_COLS &&
               off / (size_t)RTX_HEX_COLS < b.top_byte / (size_t)RTX_HEX_COLS + 4,
               "hex jump % row is on screen");
        rtx_layout_set_view(&b.layout, RTX_VIEW_DEFAULT);
        ui.jump = 1;
        ui.jump_len = 3;
        ui.jump_buf[0] = '5';
        ui.jump_buf[1] = '0';
        ui.jump_buf[2] = '%';
        ui.jump_buf[3] = 0;
        rtx_ui_apply_jump(&ui, &b, 20) !>;
        ln = b.doc.line_of(off) !>;
        expect(b.doc.caret == (b.doc.line_start(ln) !>), "text jump % snaps to line");
        b.unlock = 1;
        b.top = 2;
        b.top_wrap = 0;
        b.layout.fill(&b.doc, &m, 80.0, 2, 3) !>;
        keep = b.view_off();
        b.cycle_view(3) !>;
        expect(b.layout.wrap, "unlock cycle default->wrap");
        expect(b.top == (b.line_of(keep) !>), "unlock cycle keeps the window line");
        b.unlock = 0;
        b.doc.caret = 0;
        b.cycle_view(3) !>;
        expect(rtx_layout_is_hex(&b.layout), "lock cycle wrap->hex");
        expect(b.top_byte == 0, "lock cycle hex follows the caret");
    }

    /* Above MARKUP_SCAN_MAX: open stays one section; ensure_hl classifies the window. */
    {
        const char *path = "testdata/generated/window_hl.txt";
        const char *tail =
            "=== prose ===\nA *bold* word and `mono`.\n=== code ===\nint zz;\n";
        size_t pad = (size_t)RTX_MARKUP_SCAN_MAX + 4096;
        FILE *fp;
        size_t prose_off, code_off, deep_off, i;
        int saw_kw, saw_bold, saw_mono;
        char block[64];
        (void)system("mkdir -p testdata/generated");
        memset(block, 'a', 63);
        block[63] = '\n';
        fp = fopen(path, "w");
        expect(fp != NULL, "window_hl fopen");
        if (fp) {
            for (i = 0; i < pad / 64; i++) fwrite(block, 1, 64, fp);
            fputs(tail, fp);
            for (i = 0; i < 300; i++) fwrite(block, 1, 64, fp);
            deep_off = pad + strlen(tail) + 300 * 64;
            fputs("int deep;\n", fp);
            fclose(fp);
            {
                RtxDoc d = {0} @destroy;
                RtxLayout L = {0} @destroy;
                d.from_path(path) !>;
                expect(d.len() > (size_t)RTX_MARKUP_SCAN_MAX, "above markup scan");
                expect(d.sec_len == 1, "open plants one section");
                expect(d.section_at(0) == RTX_SEC_PROSE, "open prose");
                expect(d.run_len == 0, "open does not scan markup");
                prose_off = pad;
                code_off = pad + strlen("=== prose ===\nA *bold* word and `mono`.\n");
                d.ensure_hl(rtx_hl_win(0, 80)) !>;
                expect(d.section_at(0) == RTX_SEC_PROSE, "prefix still prose");
                d.ensure_hl(rtx_hl_win(prose_off, 40)) !>;
                expect(d.section_at(prose_off + 20) == RTX_SEC_PROSE, "window prose");
                saw_bold = saw_mono = 0;
                for (i = 0; i < d.run_len; i++) {
                    if (d.runs[i].style.bold) saw_bold = 1;
                    if (d.runs[i].style.mono) saw_mono = 1;
                }
                expect(saw_bold && saw_mono, "window *bold* and `mono`");
                d.ensure_hl(rtx_hl_win(code_off, 16)) !>;
                expect(d.section_at(code_off + 4) == RTX_SEC_CODE, "window code");
                saw_kw = 0;
                for (i = 0; i < d.run_len; i++) {
                    if (rtx_scope_kind(d.runs[i].style.scope) == RTX_HL_KEYWORD) {
                    saw_kw = 1;
                }
                }
                expect(saw_kw, "window lexed int");
                d.ensure_hl(rtx_hl_win(0, 80)) !>;
                expect(d.section_at(code_off + 4) == RTX_SEC_CODE, "kept other window");
                d.ensure_hl(rtx_hl_win(code_off + 13, 7)) !>;
                expect(d.section_at(code_off + 13) == RTX_SEC_CODE, "lookback code");
                L.fill_off(&d, &m, 80.0, code_off, 4) !>;
                expect(L.len > 0 && L.rows[0].sec == RTX_SEC_CODE, "fill_off code sec");
                d.ensure_hl(rtx_hl_win(deep_off, 9)) !>;
                expect(d.section_at(deep_off) == RTX_SEC_UNKNOWN,
                       "one-budget miss is honestly unknown");
                d.ensure_hl(rtx_hl_win(deep_off, 9)) !>;
                expect(d.section_at(deep_off) == RTX_SEC_CODE,
                       "later draw continues backward to the code header");
                d.analysis_reset();
                d.ensure_hl(rtx_hl_win(code_off, 16)) !>;
                d.ensure_hl(rtx_hl_win(0, 80)) !>;
                expect(d.section_at(code_off + 4) == RTX_SEC_CODE,
                       "second camera retains the first camera classification");
            }
            unlink(path);
        }
    }

    /* Large mixed file: a window that shows the last code lines plus the next
     * prose paragraph must not paint Block N as constant.numeric. */
    {
        const char *path = "testdata/generated/window_hl_boundary.txt";
        const char *tail =
            "=== code ===\n"
            "int fn_31058916(void) {\n"
            "    /* block 31058916 */\n"
            "    int x = 31058916;\n"
            "    return x;\n"
            "}\n"
            "=== prose ===\n"
            "Block 31058917. A *bold* word and `mono` in a wrapping paragraph that keeps\n";
        size_t pad = (size_t)RTX_MARKUP_SCAN_MAX + 4096;
        FILE *fp;
        size_t i, win_from, code_num, prose_num;
        char ch;
        char block[64];
        (void)system("mkdir -p testdata/generated");
        memset(block, 'a', 63);
        block[63] = '\n';
        fp = fopen(path, "w");
        expect(fp != NULL, "window_hl_boundary fopen");
        if (fp) {
            for (i = 0; i < pad / 64; i++) fwrite(block, 1, 64, fp);
            fputs(tail, fp);
            fclose(fp);
            {
                RtxDoc d = {0} @destroy;
                d.from_path(path) !>;
                expect(d.len() > (size_t)RTX_MARKUP_SCAN_MAX, "boundary above scan");
                expect(d.sec_len == 1, "boundary open plants one section");
                win_from = pad + strlen("=== code ===\nint fn_31058916(void) {\n    /* block 31058916 */\n");
                code_num = pad + strlen("=== code ===\nint fn_31058916(void) {\n    /* block 31058916 */\n    int x = ");
                prose_num = pad + strlen("=== code ===\nint fn_31058916(void) {\n    /* block 31058916 */\n    int x = 31058916;\n    return x;\n}\n=== prose ===\nBlock ");
                expect((d.read_at(code_num, &ch, 1) !>) == 1 && ch == '3',
                       "boundary code digit");
                expect((d.read_at(prose_num, &ch, 1) !>) == 1 && ch == '3',
                       "boundary prose digit");
                d.ensure_hl(rtx_hl_win(win_from, 200)) !>;
                expect(d.section_at(code_num) == RTX_SEC_CODE, "boundary code sec");
                expect(d.section_at(prose_num) == RTX_SEC_PROSE, "boundary prose sec");
                expect(rtx_scope_kind(d.style_at(code_num).scope) == RTX_HL_NUMBER,
                       "boundary code number");
                expect(rtx_scope_kind(d.style_at(prose_num).scope) == RTX_HL_NONE,
                       "boundary prose number is not highlighted");
            }
            {
                RtxDoc d = {0} @destroy;
                size_t code_only_n;
                d.from_path(path) !>;
                win_from = pad + strlen("=== code ===\nint fn_31058916(void) {\n    /* block 31058916 */\n");
                code_num = pad + strlen("=== code ===\nint fn_31058916(void) {\n    /* block 31058916 */\n    int x = ");
                prose_num = pad + strlen("=== code ===\nint fn_31058916(void) {\n    /* block 31058916 */\n    int x = 31058916;\n    return x;\n}\n=== prose ===\nBlock ");
                code_only_n = strlen("    int x = 31058916;\n    return x;\n}\n");
                d.ensure_hl(rtx_hl_win(win_from, code_only_n)) !>;
                expect(d.section_at(code_num) == RTX_SEC_CODE, "code-only window is CODE");
                rtx_doc_highlight_span(&d, win_from, prose_num + 16) !>;
                d.ensure_hl(rtx_hl_win(win_from, 200)) !>;
                expect(d.section_at(prose_num) == RTX_SEC_PROSE,
                       "later window finds prose");
                expect(rtx_scope_kind(d.style_at(prose_num).scope) == RTX_HL_NONE,
                       "reclassified prose drops leftover numbers");
            }
            unlink(path);
        }
    }

    /* TM-backed path: first mid-file window is CODE (do not wait for BOF). */
    {
        const char *path = "testdata/generated/window_hl.json";
        const char *row =
            "{\"id\": 1, \"name\": \"item\", \"ok\": false, \"n\": -2.5},\n";
        size_t pad = (size_t)RTX_MARKUP_SCAN_MAX + 4096;
        FILE *fp;
        size_t i, mid;
        int saw_str, saw_num;
        (void)system("mkdir -p testdata/generated");
        fp = fopen(path, "w");
        expect(fp != NULL, "window_hl.json fopen");
        if (fp) {
            for (i = 0; i < (pad / strlen(row)) + 8; i++) fputs(row, fp);
            fclose(fp);
            {
                RtxDoc d = {0} @destroy;
                d.from_path(path) !>;
                expect(d.len() > (size_t)RTX_MARKUP_SCAN_MAX, "json above scan");
                expect(d.sec_len == 1 && d.secs[0].kind == RTX_SEC_CODE,
                       "open plants path-CODE");
                mid = d.len() / 2;
                d.ensure_hl(rtx_hl_win(mid, 80)) !>;
                expect(d.section_at(mid) == RTX_SEC_CODE,
                       "first mid-file json window is CODE");
                saw_str = saw_num = 0;
                for (i = 0; i < d.run_len; i++) {
                    RtxHlKind k = rtx_scope_kind(d.runs[i].style.scope);
                    if (k == RTX_HL_STRING) saw_str = 1;
                    if (k == RTX_HL_NUMBER) saw_num = 1;
                }
                expect(saw_str && saw_num, "first mid-file json window lexed");
            }
            unlink(path);
        }
    }

    {
        uint32_t cp;
        char tmp[4];
        int n, i;
        const uint32_t *tab = rtx_utf8_combining_tab;
        int np = (int)(sizeof(rtx_utf8_combining_tab) / sizeof(tab[0]) / 2);
        char cafe[5];
        char cjk[3];
        char comb[3];
        cafe[0] = 'c'; cafe[1] = 'a'; cafe[2] = 'f';
        cafe[3] = (char)0xC3; cafe[4] = (char)0xA9;
        cjk[0] = (char)0xE4; cjk[1] = (char)0xB8; cjk[2] = (char)0xAD;
        comb[0] = 'e'; comb[1] = (char)0xCC; comb[2] = (char)0x81;
        expect(rtx_utf8_decode("A", 1, &cp) == 1 && cp == 'A', "ascii decode");
        n = rtx_utf8_encode(0xE9, tmp);
        expect(n == 2 && (unsigned char)tmp[0] == 0xC3 &&
               (unsigned char)tmp[1] == 0xA9, "encode e-acute");
        expect(rtx_utf8_decode(tmp, 2, &cp) == 2 && cp == 0xE9, "decode e-acute");
        expect(rtx_utf8_decode("\x80", 1, &cp) == 0, "lone continuation");
        expect(rtx_utf8_decode("\xC0\x80", 2, &cp) == 0, "overlong");
        expect(rtx_utf8_cp_width(0x4E2D) == 2, "CJK width 2");
        expect(rtx_utf8_cp_width(0x0301) == 0, "combining width 0");
        expect(rtx_utf8_cols(cafe.to_slice_n(5)) == 4, "café cols");
        expect(rtx_utf8_cols(cjk.to_slice_n(3)) == 2, "中 cols");
        expect(rtx_utf8_next(cafe.to_slice_n(5), 3) == 5, "next skips 2-byte é");
        expect(rtx_utf8_prev(cafe.to_slice_n(5), 5) == 3, "prev lands on é");
        expect(rtx_utf8_align(cafe.to_slice_n(5), 4) == 3, "align mid-é");
        expect(rtx_utf8_hit_col(cafe.to_slice_n(5), 0) == 0, "hit col 0");
        expect(rtx_utf8_hit_col(cafe.to_slice_n(5), 1) == 1, "hit after c");
        expect(rtx_utf8_hit_col(cafe.to_slice_n(5), 4) == 5, "hit past é");
        {
            RtxUtf8Cl cl = rtx_utf8_cluster(comb.to_slice_n(3), 0);
            char put[8];
            expect(cl.n == 3 && cl.cols == 1, "e + combining acute is one cluster");
            expect(rtx_utf8_next(comb.to_slice_n(3), 0) == 3, "cluster next past combining");
            expect(rtx_utf8_term_put('\r', "\r", 1, put, sizeof put) == 0,
                   "CR is omitted (TTY home + [K wipes the row)");
            expect(rtx_utf8_term_cols('\r', 1) == 0, "CR takes no text column");
            expect(rtx_utf8_term_put(0x1b, "\x1b", 1, put, sizeof put) == 1 &&
                   put[0] == '.', "ESC is a dot, not CSI");
            expect(rtx_utf8_term_put('A', "A", 1, put, sizeof put) == 1 &&
                   put[0] == 'A', "printable is raw");
        }
        for (i = 1; i < np; i++) {
            expect(tab[i * 2] > tab[(i - 1) * 2 + 1], "combining ranges sorted");
            if (tab[i * 2] <= tab[(i - 1) * 2 + 1]) break;
        }
    }

    {
        RtxDoc d = {0} @destroy;
        RtxLayout L = {0} @destroy;
        RtxMeasure um;
        um.measure = utf8_meas;
        um.line_height = lh;
        um.ctx = NULL;
        d.from_buffer("\xE4\xB8\xAD\xE4\xB8\xAD") !>;
        L.wrap = 1;
        L.doc(&d, &um, 2.0) !>;
        expect(L.len == 2, "CJK wrap: one wide char per row");
        expect(L.rows[0].byte_len == 3 && L.rows[1].byte_len == 3,
               "wrap does not split a 3-byte char");
        expect((L.hit(&d, &um, 1.0, 0) !>) == 0, "hit first 中");
        expect((L.hit(&d, &um, 1.0, 1.2) !>) == 3, "hit second 中");
        expect((d.cluster_next(0) !>) == 3, "doc cluster_next");
        expect((d.cluster_prev(6) !>) == 3, "doc cluster_prev");
        expect((d.cluster_align(4) !>) == 3, "doc cluster_align mid-char");
        d.caret = 4;
        d.caret = d.cluster_align(d.caret) !>;
        expect(d.caret == 3, "caret snaps out of a code unit");
    }

    /* Path-backed line longer than RTX_FRAME_SCRATCH must still layout. */
    {
        const char *path = "testdata/generated/long_line.txt";
        size_t n = (size_t)RTX_FRAME_SCRATCH + 1024;
        FILE *fp;
        size_t i;
        char buf[256];
        (void)system("mkdir -p testdata/generated");
        fp = fopen(path, "w");
        expect(fp != NULL, "long_line fopen");
        if (fp) {
            memset(buf, 'x', sizeof(buf));
            for (i = 0; i + sizeof(buf) <= n; i += sizeof(buf))
                fwrite(buf, 1, sizeof(buf), fp);
            for (; i < n; i++) fputc('x', fp);
            fputc('\n', fp);
            fputs("tail\n", fp);
            fclose(fp);
            {
                RtxDoc d = {0} @destroy;
                RtxLayout L = {0} @destroy;
                size_t hit;
                d.from_path(path) !>;
                L.wrap = 0;
                L.doc(&d, &m, 80.0) !>;
                expect(L.len >= 2, "long line plus tail");
                expect(L.rows[0].byte_len == n, "unwrapped row is the long line");
                expect((L.x_of(&d, &m, 80) !>) == 80.0, "x_of on long line");
                L.wrap = 1;
                L.doc(&d, &m, 80.0) !>;
                expect(L.len > 2, "long line wraps");
                hit = L.hit(&d, &m, 0, 0) !>;
                expect(hit == 0, "hit on long wrapped line");
            }
        }
    }

    {
        const char *path = "testdata/generated/nav_fold.md";
        FILE *fp;
        RtxDoc d = {0} @destroy;
        RtxLayout L = {0} @destroy;
        size_t before;
        (void)system("mkdir -p testdata/generated");
        fp = fopen(path, "w");
        expect(fp != NULL, "nav_fold fopen");
        if (fp) {
            fputs("# Alpha\n\nbody one\n\n# Beta\n\nbody two\n", fp);
            fclose(fp);
        }
        d.from_path(path) !>;
        L.wrap = 0;
        L.lines(&d, &m, 80.0, 0, 16) !>;
        before = L.len;
        expect(before >= 5, "nav_fold rows");
        d.caret = 0;
        d.sel_anchor = 0;
        expect(d.fold_toggle() == 1, "layout fold heading");
        L.lines(&d, &m, 80.0, 0, 16) !>;
        expect(L.len < before, "fold drops interior rows");
        expect(L.len >= 2, "fold keeps start lines");
        {
            RtxPref pref = {0};
            size_t mid;
            L.move_vert(&d, &m, 80.0, 1, 0, &pref) !>;
            expect(!d.fold_covers(d.caret), "down leaves fold");
            mid = d.caret;
            L.move_vert(&d, &m, 80.0, -1, 0, &pref) !>;
            expect(!d.fold_covers(d.caret), "up leaves fold");
            expect(d.caret < mid, "up back to heading");
        }
        remove(path);
    }

    /* Mid-file camera: arrows / wheel must not line_of; gutter is +1 / -1. */
    {
        const char *path = "testdata/generated/gap_scroll.txt";
        FILE *fp;
        int i;
        RtxBuf b = {0} @destroy;
        RtxPref pref = {0};
        size_t mid, scan0;
        (void)system("mkdir -p testdata/generated");
        fp = fopen(path, "w");
        expect(fp != NULL, "gap_scroll fopen");
        if (fp) {
            for (i = 0; i < 4000; i++) fputs("xxxxxxxxxxxxxxxxxxxx\n", fp);
            fclose(fp);
        }
        b.doc.from_path(path) !>;
        mid = b.doc.len() / 2;
        b.doc.caret = rtx_doc_line_floor(&b.doc, mid) !>;
        b.doc.sel_anchor = b.doc.caret;
        rtx_line_isle_kick(&b.doc.tree, b.doc.caret);
        b.land(20) !>;
        scan0 = b.doc.tree.line_scan_off;
        expect(scan0 < mid, "gap still uncovered");
        b.layout.move_vert(&b.doc, &m, 80.0, -1, 0, &pref) !>;
        expect(b.doc.tree.line_scan_off == scan0, "arrow up does not line_of");
        b.layout.move_vert(&b.doc, &m, 80.0, 1, 0, &pref) !>;
        expect(b.doc.tree.line_scan_off == scan0, "arrow down does not line_of");
        b.scroll_vis(&m, 80.0, -1) !>;
        expect(b.doc.tree.line_scan_off == scan0, "scroll up does not line_of");
        expect(b.seek_rel == -1, "scroll up is -1");
        b.scroll_vis(&m, 80.0, 1) !>;
        expect(b.seek_rel == 0, "scroll back to origin");
        b.ensure_view(&m, 80.0, 8) !>;
        expect(b.layout.len > 0, "gap fill");
        {
            size_t abs = 0, plus = 0;
            int gap = rtx_gutter_gap(&b, b.layout.rows[0].byte_start,
                                    b.layout.rows[0].line, &abs, &plus);
            RtxScrollRail rail = b.scroll_rail(8) !>;
            int ty = 0, th = 0, my;
            rtx_scroll_rail_thumb(&rail, 8, 1, &ty, &th);
            expect(gap == 1 && plus == 1, "origin gutter +1");
            expect(rtx_buf_scroll_rel(&b), "rail mark is relative");
            expect(rtx_buf_scroll_rel_row(&b, 8) == 0, "caret on first vis row");
            my = rtx_buf_scroll_rel_mark_y(&b, &rail, 8, 1, 8);
            expect(my >= ty && my < ty + (th > 0 ? th : 1),
                   "mid-file mark sits on the thumb");
            expect(ty > 0, "mid-file thumb is not at the top");
        }
        b.scroll_vis(&m, 80.0, -1) !>;
        b.ensure_view(&m, 80.0, 8) !>;
        {
            size_t abs = 0, plus = 0;
            int gap = rtx_gutter_gap(&b, b.layout.rows[0].byte_start,
                                    b.layout.rows[0].line, &abs, &plus);
            RtxScrollRail rail = b.scroll_rail(8) !>;
            int ty = 0, th = 0, my;
            rtx_scroll_rail_thumb(&rail, 8, 1, &ty, &th);
            expect(gap == -1 && plus == 1, "scrolled-up gutter -1");
            expect(rtx_buf_scroll_rel_row(&b, 8) == 1,
                   "caret stays on +0 after the window moves");
            my = rtx_buf_scroll_rel_mark_y(&b, &rail, 8, 1, 8);
            expect(my >= ty && my < ty + (th > 0 ? th : 1),
                   "scrolled mark stays on the thumb");
        }
        {
            RtxUi ui = {0};
            RtxScrollRail rail;
            int ty = 0, th = 0, my;
            ui.jump = 1;
            ui.jump_len = 3;
            ui.jump_buf[0] = '9';
            ui.jump_buf[1] = '9';
            ui.jump_buf[2] = '%';
            ui.jump_buf[3] = 0;
            rtx_ui_apply_jump(&ui, &b, 8) !>;
            b.ensure_view(&m, 80.0, 8) !>;
            expect(rtx_buf_scroll_rel(&b), "99% gap is relative");
            expect(rtx_buf_scroll_rel_row(&b, 8) == 0, "99% caret on first vis row");
            rail = b.scroll_rail(8) !>;
            rtx_scroll_rail_thumb(&rail, 100, 8, &ty, &th);
            my = rtx_buf_scroll_rel_mark_y(&b, &rail, 100, 8, 8);
            expect(ty > 50, "99% thumb is in the lower half");
            expect(my >= ty && my < ty + (th > 0 ? th : 1),
                   "99% mark sits on the thumb");
            expect(my > 50, "99% mark is not at the top of the track");
        }
        remove(path);
    }

    /* Gap camera: hit / stream / box select / type must not line_of. */
    {
        const char *path = "testdata/generated/gap_hit.txt";
        FILE *fp;
        int i;
        RtxBuf b = {0} @destroy;
        size_t mid, scan0, at;
        (void)system("mkdir -p testdata/generated");
        fp = fopen(path, "w");
        expect(fp != NULL, "gap_hit fopen");
        if (fp) {
            for (i = 0; i < 16000; i++) fputs("xxxxxxxxxxxxxxxxxxxx\n", fp);
            fclose(fp);
        }
        b.doc.from_path(path) !>;
        expect(b.doc.len() > (size_t)RTX_LINE_SOFT_MIN, "gap_hit above soft min");
        mid = b.doc.len() / 2;
        b.doc.caret = rtx_doc_line_floor(&b.doc, mid) !>;
        b.doc.sel_anchor = b.doc.caret;
        rtx_line_isle_kick(&b.doc.tree, b.doc.caret);
        b.land(20) !>;
        b.ensure_view(&m, 80.0, 8) !>;
        scan0 = b.doc.tree.line_scan_off;
        expect(scan0 < mid, "gap_hit still uncovered");
        expect(b.layout.len > 3, "gap_hit filled");
        {
            double y = 0;
            size_t r;
            size_t origin = b.seek_off;
            for (r = 0; r < 2 && r < b.layout.len; r++)
                y += b.layout.rows[r].height;
            y += 0.1;
            at = b.layout.hit(&b.doc, &m, 4.0, y) !>;
            expect(at >= b.layout.rows[2].byte_start &&
                   at <= b.layout.rows[2].byte_start + b.layout.rows[2].byte_len,
                   "hit lands on row 2");
            b.doc.caret = at;
            b.doc.sel_anchor = at;
            b.reveal(8) !>;
            expect(b.seek_valid && b.seek_off == origin,
                   "reveal does not snap a visible click to top");
            b.land(8) !>;
            expect(b.seek_valid && b.seek_off ==
                   (rtx_doc_line_floor(&b.doc, at) !>),
                   "land snaps a visible caret to top");
        }
        expect(b.doc.tree.line_scan_off == scan0, "hit does not line_of");
        b.doc.sel_anchor = b.layout.rows[0].byte_start;
        b.doc.caret = at;
        b.doc.sel_box = 0;
        expect((b.doc.sel_covers(b.doc.sel_anchor) !>), "stream covers lo");
        expect(b.doc.tree.line_scan_off == scan0, "stream sel_covers no scan");
        b.doc.sel_box = 1;
        b.doc.box_acol = 2;
        b.doc.box_ccol = 8;
        expect((b.doc.sel_covers(b.layout.rows[0].byte_start + 3) !>),
               "box covers col");
        expect(!(b.doc.sel_covers(b.layout.rows[0].byte_start) !>),
               "box misses col 0");
        expect(b.doc.tree.line_scan_off == scan0, "box sel_covers no scan");
        expect(!b.doc.index_covers(mid), "mid still uncovered");
        b.doc.sel_box = 0;
        b.doc.sel_anchor = b.doc.caret;
        b.doc.type("Z") !>;
        b.after_edit(&m, 80.0, 8) !>;
        expect(b.seek_valid, "edit keeps seek");
        expect(b.doc.tree.line_scan_off == scan0, "edit does not line_of");
        rtx_line_scan_to(&b.doc.tree, b.seek_off) !>;
        expect(b.doc.index_covers(b.seek_off), "prefix reached the window");
        {
            size_t off = b.seek_off;
            size_t ln = b.doc.line_of(off) !>;
            b.ensure_view(&m, 80.0, 8) !>;
            expect(!b.seek_valid, "line_of hands off to the line camera");
            expect(b.top == ln && b.layout.from_line == ln, "handoff keeps the window");
        }
        b.scroll_vis(&m, 80.0, 1) !>;
        expect(!b.seek_valid, "wheel stays on the line camera");
        remove(path);
    }

    expect(rtx_pct(30000000, 248471338) == 12, "pct 30M/248M is 12 not int32 wrap");
    expect(rtx_pct((size_t)1 << 32, (size_t)1 << 33) == 50, "pct 4G/8G");

    /* g L above SOFT_MIN is a pumped prefix scan. Progress lives on the jump
     * chrome — not a blocking line_start / busy_pulse on the status row. */
    {
        const char *path = "testdata/generated/jump_pump.txt";
        FILE *fp;
        int i;
        RtxBuf b = {0} @destroy;
        RtxUi ui = {0};
        size_t caret0, want;
        char hdr[80];
        (void)system("mkdir -p testdata/generated");
        fp = fopen(path, "w");
        expect(fp != NULL, "jump_pump fopen");
        if (fp) {
            for (i = 0; i < 14000; i++) fputs("xxxxxxxxxxxxxxxxxxxx\n", fp);
            fclose(fp);
        }
        b.doc.from_path(path) !>;
        expect(b.doc.len() > (size_t)RTX_LINE_SOFT_MIN, "jump_pump above soft min");
        expect(!b.doc.lf_ready(), "jump_pump not indexed");
        caret0 = b.doc.caret;
        ui.jump = 1;
        ui.jump_len = 5;
        ui.jump_buf[0] = '1';
        ui.jump_buf[1] = '3';
        ui.jump_buf[2] = '0';
        ui.jump_buf[3] = '0';
        ui.jump_buf[4] = '0';
        ui.jump_buf[5] = 0;
        rtx_ui_apply_jump(&ui, &b, 20) !>;
        expect(ui.jump, "jump stays open while pumping");
        expect(b.doc.tree.want_line == 13000, "want_line is 13000");
        expect(b.doc.caret == caret0, "caret stays until pump lands");
        rtx_ui_jump_header(&ui, &b.doc, hdr, sizeof(hdr));
        expect(strstr(hdr, "scanning...") != NULL, "progress lives on jump chrome");
        want = b.doc.tree.want_line;
        while (rtx_line_want_pumping(&b.doc.tree))
            rtx_ui_jump_pump(&ui, &b, 20, NULL) !>;
        expect(!ui.jump, "jump closes after land");
        expect(b.doc.tree.want_line == 0, "want cleared");
        expect(b.doc.caret == (b.doc.line_start(want - 1) !>), "lands on exact line");
        remove(path);
    }

    /* Open above SOFT_MIN: idle prefix must run without g L or an island. */
    {
        const char *path = "testdata/generated/prefix_pump.txt";
        FILE *fp;
        int i;
        RtxBuf b = {0} @destroy;
        RtxUi ui = {0};
        size_t scan0;
        char pos[80];
        (void)system("mkdir -p testdata/generated");
        fp = fopen(path, "w");
        expect(fp != NULL, "prefix_pump fopen");
        if (fp) {
            for (i = 0; i < 20000; i++) fputs("xxxxxxxxxxxxxxxxxxxx\n", fp);
            fclose(fp);
        }
        b.doc.from_path(path) !>;
        expect(b.doc.len() > (size_t)RTX_LINE_SOFT_MIN, "prefix_pump above soft min");
        expect(!b.doc.lf_ready(), "prefix_pump not indexed");
        expect(rtx_line_prefix_pumping(&b.doc.tree), "idle prefix is live");
        rtx_status_line_pos(&b, pos, sizeof pos) !>;
        expect(strstr(pos, "scanning...") != NULL, "prefix progress on status");
        scan0 = b.doc.tree.line_scan_off;
        rtx_ui_work_pump(&ui, &b, 20, NULL) !>;
        expect(b.doc.tree.line_scan_off > scan0, "idle prefix advances");
        while (rtx_line_prefix_pumping(&b.doc.tree))
            rtx_ui_work_pump(&ui, &b, 20, NULL) !>;
        expect(b.doc.tree.line_scan_off >= b.doc.len(), "prefix reached EOF");
        remove(path);
    }

    if (fails) {
        fprintf(stderr, "%d failure(s)\n", fails);
        return 1;
    }
    printf("layout_measure_smoke ok\n");
    return 0;
}
