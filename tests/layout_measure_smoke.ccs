/*
 * Fake WidthMeasure: mono cells are 1, proportional 'i' is 0.5, others 1.
 * Proves wrap + hit-test without a window.
 */
#include <ccc/std/prelude.cch>
#include <ccc/script/stdio.cch>
#include <stdio.h>
#include <string.h>
#include "../core/layout.cch"

static int fails = 0;

static void expect(int cond, const char *msg) {
    if (!cond) {
        fprintf(stderr, "FAIL: %s\n", msg);
        fails++;
    }
}

static CCSlice sl(const char *s) {
    return cc_slice_from_buffer((void *)s, s ? strlen(s) : 0);
}

static double meas(void *ctx, CCSlice bytes, RtxStyle style) {
    size_t i;
    double w = 0;
    (void)ctx;
    (void)style;
    for (i = 0; i < bytes.len; i++) {
        char c = bytes.ptr[i];
        w += (c == 'i' || c == 'l' || c == '.') ? 0.5 : 1.0;
    }
    return w;
}

static double lh(void *ctx, RtxStyle style, RtxSectionKind sec) {
    (void)ctx;
    (void)style;
    return sec == RTX_SEC_CODE ? 1.0 : 1.2;
}

int main(void) {
    @errhandler(CCError e) { cc_error_log(e); return 1; }
    RtxMeasure m;
    m.measure = meas;
    m.line_height = lh;
    m.ctx = NULL;

    {
        RtxDoc d;
        RtxLayout L;
        rtx_doc_from_buffer(&d, sl("iii wrap here\ncode")) !>;
        memset(&L, 0, sizeof(L));
        expect(rtx_layout_doc(&L, &d, &m, 3.0), "layout");
        expect(L.len >= 2, "wrapped to 2+ rows");
        expect(rtx_doc_section_at(&d, 0) == RTX_SEC_PROSE, "default prose");
        {
            size_t hit = rtx_layout_hit(&L, &d, &m, 0, 0);
            expect(hit == 0, "hit origin");
        }
        rtx_layout_destroy(&L);
        rtx_doc_destroy(&d);
    }

    {
        RtxDoc d;
        rtx_doc_from_buffer(&d, sl("=== code ===\nint x;\n=== prose ===\n*hi* `c`\n")) !>;
        expect(d.sec_len >= 2, "two sections");
        expect(rtx_doc_section_at(&d, 0) == RTX_SEC_CODE, "code section");
        expect(d.run_len >= 2, "bold + mono runs");
        {
            size_t i;
            int saw_kw = 0;
            for (i = 0; i < d.run_len; i++) {
                if (d.runs[i].style.hl == RTX_HL_KEYWORD) saw_kw = 1;
            }
            expect(saw_kw, "code section keywords highlighted");
        }
        rtx_doc_insert(&d, 0, sl("Z")) !>;
        expect(rtx_piece_tree_len(&d.tree) > 0, "insert");
        rtx_doc_destroy(&d);
    }

    {
        RtxDoc d;
        rtx_doc_open(&d, "testdata/mixed.txt") !>;
        expect(d.sec_len >= 2, "mixed.txt sections");
        rtx_doc_destroy(&d);
    }

    if (fails) {
        fprintf(stderr, "%d failure(s)\n", fails);
        return 1;
    }
    printf("layout_measure_smoke ok\n");
    return 0;
}
