#!ccc ccs
/*
 * Regex engine smoke: a pattern / subject / expected table (search and
 * anchored), the old engine's defects, UTF-8, Onig syntax, compile
 * errors, pathological patterns (must finish inside the budget), a
 * randomized three-way differential (lazy DFA vs Pike VM vs backtracker),
 * and the reverse inner search (which patterns take it, a differential
 * against the plain DFA and the Pike VM, linear time on adversarial text).
 */
#include <ccc/std/prelude.cch>
#include <ccc/stdio.cch>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <time.h>
#include "../core/rx.cch"

static int fails = 0;
static int checks = 0;

static void expect(int cond, const char *what, const char *pat, const char *subj) {
    checks++;
    if (!cond) {
        fprintf(stderr, "FAIL: %s  pat=/%s/ subj=\"%s\"\n", what, pat, subj ? subj : "");
        fails++;
    }
}

static double now_ms(void) {
    struct timespec ts;
    clock_gettime(CLOCK_MONOTONIC, &ts);
    return (double)ts.tv_sec * 1000.0 + (double)ts.tv_nsec / 1.0e6;
}

static RtxRx *try_compile(const char *p, unsigned fl, CCArena a, const char **err) {
    RtxRx *rx = rtx_rx_compile(cc_slice_cstr(p), fl, a) !>(e) {
        if (err) *err = e.message;
        return NULL;
    };
    return rx;
}

/* Search cases: first match in the whole subject (eof). ms = -1: none.
 * g1: expected text of group 1 (NULL = not checked, "" = unset/empty). */
typedef struct {
    const char *pat;
    unsigned fl;
    const char *subj;
    int ms;
    int me;
    const char *g1;
} RxCase;

static const RxCase cases[] = {
    /* anchors ^ $ (old engine treated ^ as a literal) */
    {"^key", 0, "a\nkey", 2, 5, NULL},
    {"^key", 0, "akey", -1, 0, NULL},
    {"^[ \\t]*[A-Za-z0-9_.-]+\\s*:", 0, "x\n  name: v", 2, 9, NULL},
    {"a$", 0, "ab a\nb", 3, 4, NULL},
    {"^$", 0, "a\n\nb", 2, 2, NULL},
    {"\\Aab", 0, "ab", 0, 2, NULL},
    {"\\Aab", 0, "xab", -1, 0, NULL},
    {"b\\z", 0, "ab\n", -1, 0, NULL},
    {"b\\Z", 0, "ab\n", 1, 2, NULL},
    {"b\\z", 0, "ab", 1, 2, NULL},
    /* unbounded repeats (old engine capped at 63) */
    {"a+b", 0, "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaab", 0, 101, NULL},
    {"\"([^\"]+)\"\\s*:", 0, "{\"a_really_long_json_key_that_goes_on_and_on_well_past_sixty_three_bytes_of_text\": 1}", 1, 82,
     "a_really_long_json_key_that_goes_on_and_on_well_past_sixty_three_bytes_of_text"},
    {"<https?://[^>]+>", 0, "see <https://example.com/a/very/long/path/that/keeps/going/and/going/past/the/old/limit/of/sixty/three.html> ok", 4, 108, NULL},
    {"<script\\b[^>]*>", 0, "<script type=\"text/javascript\" src=\"https://cdn.example.com/lib/library-with-a-long-name.min.js\" defer>", 0, 103, NULL},
    {"a{100}", 0, "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", 0, 100, NULL},
    {"a{2,3}", 0, "aaaa", 0, 3, NULL},
    {"a{2,}", 0, "a aaaa", 2, 6, NULL},
    {"x{,2}", 0, "xxx", 0, 2, NULL},
    {"a{2}", 0, "a{2}", -1, 0, NULL},
    {"a\\{2", 0, "a{2", 0, 3, NULL},
    {"{", 0, "a{", 1, 2, NULL},
    /* groups backtrack; first-match alternation */
    {"(ab|a)bc", 0, "abc", 0, 3, "a"},
    {"a|ab", 0, "ab", 0, 1, NULL},
    {"(?:a|ab)c", 0, "abc", 0, 3, NULL},
    {"(a|ab)(c|bcd)", 0, "abcd", 0, 4, "a"},
