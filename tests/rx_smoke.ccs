};

static void run_cases(void) {
    CCArena a = cc_arena_heap(megabytes(4));
    RtxRxScratch s = {0};
    size_t i;
    for (i = 0; i < sizeof(cases) / sizeof(cases[0]); i++) {
        const RxCase *c = &cases[i];
        RtxRx *rx;
        RtxRxIn in = {0};
        size_t ms = 0, me = 0, n = strlen(c->subj);
        int force, r;
        const char *err = NULL;
        rx = try_compile(c->pat, c->fl, a, &err);
        if (!rx) {
            fprintf(stderr, "compile error: %s\n", err ? err : "?");
            expect(0, "compiles", c->pat, c->subj);
            continue;
        }
        in.s = c->subj;
        in.n = n;
        in.gpos = RTX_RX_UNSET;
        in.ctx = RTX_RX_CTX_BOL0 | RTX_RX_CTX_BOT0;
        for (force = 0; force <= 4; force++) {
            char what[96];
            if (force == 3) continue; /* 4: the reverse inner search where built */
            if (force == 1 && rtx_rx_mode(rx) == RTX_RX_BACKTRACK) continue;
            in.force = (unsigned)force;
            ms = me = 0;
            r = rtx_rx_search(rx, &in, 0, n + 1, 1, &s, &ms, &me);
            snprintf(what, sizeof(what), "search case %zu force %d (got %d [%zu,%zu))", i,
                     force, r, ms, me);
            if (c->ms < 0) {
                /* an empty match at the very end counts as none here */
                expect(r == RTX_RX_NONE, what, c->pat, c->subj);
            } else {
                expect(r == RTX_RX_MATCH && ms == (size_t)c->ms && me == (size_t)c->me,
                       what, c->pat, c->subj);
            }
        }
        if (c->ms >= 0) {
            RtxRxCaps caps;
            size_t end = 0;
            for (force = 0; force <= 2; force++) {
                char what[96];
                if (force == 1 && rtx_rx_mode(rx) == RTX_RX_BACKTRACK) continue;
                in.force = (unsigned)force;
                r = rtx_rx_at(rx, &in, (size_t)c->ms, &s, &end, &caps);
                snprintf(what, sizeof(what), "anchored case %zu force %d (got %d end %zu)", i,
                         force, r, end);
                expect(r == RTX_RX_MATCH && end == (size_t)c->me, what, c->pat, c->subj);
                if (r == RTX_RX_MATCH && c->g1) {
                    size_t gs = caps.s[1], ge = caps.e[1];
                    int ok;
                    if (!c->g1[0]) ok = gs == RTX_RX_UNSET || gs == ge;
                    else
                        ok = gs != RTX_RX_UNSET && ge - gs == strlen(c->g1) &&
                             !memcmp(c->subj + gs, c->g1, ge - gs);
                    snprintf(what, sizeof(what), "group 1 case %zu force %d", i, force);
                    expect(ok, what, c->pat, c->subj);
                }
            }
        }
    }
    rtx_rx_scratch_drop(&s);
    a.destroy();
}

static const char *bad[] = {
    "\\q", "\\p{L}", "(", ")", "a)", "a{3,2}", "(?<=a+)b", "*a", "+", "[a", "[z-a]",
    "(?z)", "\\k<nope>", "(a)\\2", "a{100001}", "[[:bogus:]]", "\\K", "(?<=\\1)a",
    "\\x{110000}", "\\u12", "x{2}{", NULL,
};

static void run_errors(void) {
    CCArena a = cc_arena_heap(megabytes(1));
    size_t i;
    for (i = 0; bad[i]; i++) {
        int failed = try_compile(bad[i], 0, a, NULL) == NULL;
        /* x{2}{ : the trailing `{` is a literal — that one compiles. */
        if (!strcmp(bad[i], "x{2}{")) expect(!failed, "literal brace after interval", bad[i], "");
        else expect(failed, "compile error expected", bad[i], "");
    }
    a.destroy();
}

/* Pathological patterns finish: linear engines stay linear; the
 * backtracker stops at its budget with RTX_RX_BUDGET. */
static void run_patho(void) {
    CCArena a = cc_arena_heap(megabytes(4));
    RtxRxScratch s = {0};
    char *sp = (char *)malloc(200001);
    size_t i, ms = 0, me = 0, end = 0;
    RtxRxIn in = {0};
    RtxRx *rx;
    double t0, t1;
    int r;
    for (i = 0; i < 200000; i++) sp[i] = ' ';
    sp[200000] = 0;
    in.s = sp;
    in.n = 200000;
    in.gpos = RTX_RX_UNSET;
    in.ctx = RTX_RX_CTX_BOL0;
    rx = try_compile("\\s*\\s*\\s*x", 0, a, NULL);
    if (!rx) {
        expect(0, "compile", "\\s*\\s*\\s*x", "");
        return;
    }
    t0 = now_ms();
    r = rtx_rx_search(rx, &in, 0, in.n, 1, &s, &ms, &me);
    t1 = now_ms();
    expect(r == RTX_RX_NONE, "\\s*\\s*\\s*x on 200k spaces: none", "\\s*\\s*\\s*x", "");
    expect(t1 - t0 < 2000.0, "\\s*\\s*\\s*x is linear (DFA)", "\\s*\\s*\\s*x", "");
    printf("patho: \\s*\\s*\\s*x over 200000 spaces: %.2f ms\n", t1 - t0);
    in.force = 1;
    in.n = 20000;
    t0 = now_ms();
    r = rtx_rx_search(rx, &in, 0, in.n, 1, &s, &ms, &me);
    t1 = now_ms();
    expect(r == RTX_RX_NONE, "pike: none", "\\s*\\s*\\s*x", "");
    printf("patho: pike \\s*\\s*\\s*x over 20000 spaces: %.2f ms\n", t1 - t0);
    in.force = 0;

    /* Exponential for a naive backtracker. */
    {
        static const char *pp[] = {"(a|a)*b", "(x+x+)+y", "(a*)*c", "(\\w+\\s?)*$!", NULL};
        static const char *ss[] = {"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
                                   "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx",
                                   "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
                                   "word word word word word word word word word word word word!x",
                                   NULL};
        size_t k;
        for (k = 0; pp[k]; k++) {
            RtxRxIn in2 = {0};
            size_t hits0 = s.budget_hits;
            rx = try_compile(pp[k], 0, a, NULL);
            if (!rx) {
                expect(0, "compile", pp[k], "");
                continue;
            }
            in2.s = ss[k];
            in2.n = strlen(ss[k]);
            in2.gpos = RTX_RX_UNSET;
            in2.budget = 100000;
            /* linear engines: correct answer (none) */
            r = rtx_rx_at(rx, &in2, 0, &s, &end, NULL);
            expect(r == RTX_RX_NONE, "linear: pathological → none", pp[k], ss[k]);
            /* backtracker: stops at the budget, honestly */
            in2.force = 2;
            t0 = now_ms();
            r = rtx_rx_at(rx, &in2, 0, &s, &end, NULL);
            t1 = now_ms();
            expect(r == RTX_RX_BUDGET || r == RTX_RX_NONE, "bt: budget or none", pp[k], ss[k]);
            expect(t1 - t0 < 1000.0, "bt: finishes quickly", pp[k], ss[k]);
            printf("patho: bt /%s/ r=%d budget_hits+=%zu %.2f ms\n", pp[k], r,
                   s.budget_hits - hits0, t1 - t0);
        }
    }
    expect(rtx_rx_budget_hits() > 0, "budget counter surfaced", "", "");
    free(sp);
    rtx_rx_scratch_drop(&s);
    a.destroy();
}

/* Anchored API details: \G, EXTREF (TM end after begin), context flags,
 * lookbehind into the text before `at`, partial search. */
static void run_misc(void) {
    CCArena a = cc_arena_heap(megabytes(1));
    RtxRxScratch s = {0};
    RtxRxIn in = {0};
    RtxRxCaps caps;
    size_t end = 0, ms = 0, me = 0;
    RtxRx *rx;
    int r;
    in.gpos = RTX_RX_UNSET;
    rx = try_compile("\\Gfoo", 0, a, NULL);
    if (!rx) { expect(0, "compile", "\\Gfoo", ""); return; }
    in.s = "xx foo";
    in.n = 6;
    in.gpos = 3;
    expect(rtx_rx_at(rx, &in, 3, &s, &end, NULL) == RTX_RX_MATCH && end == 6, "\\G at gpos", "\\Gfoo", in.s);
    in.gpos = 2;
    expect(rtx_rx_at(rx, &in, 3, &s, &end, NULL) == RTX_RX_NONE, "\\G elsewhere", "\\Gfoo", in.s);
    in.gpos = RTX_RX_UNSET;

    rx = try_compile("^\\s*\\3\\s*$", RTX_RX_EXTREF, a, NULL);
    if (!rx) { expect(0, "compile", "^\\s*\\3\\s*$", ""); return; }
    {
        static const char *begin_line = "cat <<-EOF";
        size_t xs[4] = {RTX_RX_UNSET, RTX_RX_UNSET, RTX_RX_UNSET, 7};
        size_t xe[4] = {RTX_RX_UNSET, RTX_RX_UNSET, RTX_RX_UNSET, 10};
        in.ext = begin_line;
        in.ext_s = xs;
        in.ext_e = xe;
        in.ext_n = 4;
        in.s = "  EOF  \n";
        in.n = 8;
        in.ctx = RTX_RX_CTX_BOL0;
        expect(rtx_rx_at(rx, &in, 0, &s, &end, NULL) == RTX_RX_MATCH && end == 8,
               "extref heredoc end", "^\\s*\\3\\s*$", in.s);
        in.s = "  EOFX \n";
        expect(rtx_rx_at(rx, &in, 0, &s, &end, NULL) == RTX_RX_NONE,
               "extref heredoc end: other word", "^\\s*\\3\\s*$", in.s);
        in.ext = NULL;
        in.ext_s = in.ext_e = NULL;
        in.ext_n = 0;
    }
    /* ^ at offset 0 follows the context flag (window lex mid-line). */
    rx = try_compile("^a", 0, a, NULL);
    if (!rx) { expect(0, "compile", "^a", ""); return; }
    in.s = "ab";
    in.n = 2;
    in.ctx = 0;
    expect(rtx_rx_at(rx, &in, 0, &s, &end, NULL) == RTX_RX_NONE, "^ without BOL0", "^a", "ab");
    in.ctx = RTX_RX_CTX_BOL0;
    expect(rtx_rx_at(rx, &in, 0, &s, &end, NULL) == RTX_RX_MATCH, "^ with BOL0", "^a", "ab");
    /* lookbehind reads bytes before `at` */
    rx = try_compile("(?<=x)y", 0, a, NULL);
    if (!rx) { expect(0, "compile", "(?<=x)y", ""); return; }
    in.s = "xy";
    in.n = 2;
    expect(rtx_rx_at(rx, &in, 1, &s, &end, &caps) == RTX_RX_MATCH && end == 2, "lookbehind before at", "(?<=x)y", "xy");
    /* search window: stop, partial */
    rx = try_compile("a[^z]*z", 0, a, NULL);
    if (!rx) { expect(0, "compile", "a[^z]*z", ""); return; }
    in.s = "abbbbbbbbbbbbbbbbbbbbbbbbbbbbb";
    in.n = strlen(in.s);
    r = rtx_rx_search(rx, &in, 0, 10, 0, &s, &ms, &me);
    expect(r == RTX_RX_PARTIAL && ms == 0, "partial: undecided candidate", "a[^z]*z", in.s);
    r = rtx_rx_search(rx, &in, 0, 10, 1, &s, &ms, &me);
    expect(r == RTX_RX_NONE, "eof: no partial", "a[^z]*z", in.s);
    in.force = 1;
    r = rtx_rx_search(rx, &in, 0, 10, 0, &s, &ms, &me);
    expect(r == RTX_RX_PARTIAL && ms == 0, "pike partial", "a[^z]*z", in.s);
    in.force = 0;
    rx = try_compile("a.*", 0, a, NULL);
    if (!rx) { expect(0, "compile", "a.*", ""); return; }
    r = rtx_rx_search(rx, &in, 0, 10, 0, &s, &ms, &me);
    expect(r == RTX_RX_PARTIAL && ms == 0, "partial: match may extend", "a.*", in.s);
    in.s = "abbb\nc";
    in.n = 6;
    r = rtx_rx_search(rx, &in, 0, 3, 0, &s, &ms, &me);
    expect(r == RTX_RX_MATCH && ms == 0 && me == 4, "decided before the end", "a.*", in.s);
    rx = try_compile("ab", 0, a, NULL);
    if (!rx) { expect(0, "compile", "ab", ""); return; }
    in.s = "xxab";
    in.n = 4;
    r = rtx_rx_search(rx, &in, 0, 2, 1, &s, &ms, &me);
    expect(r == RTX_RX_NONE, "start at stop is the next block's", "ab", in.s);
    expect(rtx_rx_is_literal(rx), "literal detected", "ab", "");
    rx = try_compile("a.c", RTX_RX_LITERAL, a, NULL);
    if (!rx) { expect(0, "compile", "a.c", ""); return; }
    in.s = "abc a.c";
    in.n = 7;
    r = rtx_rx_search(rx, &in, 0, 7, 1, &s, &ms, &me);
    expect(r == RTX_RX_MATCH && ms == 4 && me == 7, "RTX_RX_LITERAL", "a.c", in.s);
    rx = try_compile("A.C", RTX_RX_LITERAL | RTX_RX_ICASE, a, NULL);
    if (!rx) { expect(0, "compile", "A.C", ""); return; }
    r = rtx_rx_search(rx, &in, 0, 7, 1, &s, &ms, &me);
    expect(r == RTX_RX_MATCH && ms == 4 && me == 7, "RTX_RX_LITERAL icase", "A.C", in.s);
    expect(rtx_rx_max_len(rx) == 3, "max_len literal", "A.C", "");
    /* one buffer refilled between calls (project search reads every file
     * into the same buffer): nothing of the last text may carry over */
    rx = try_compile("[a-c]+_send\\(", 0, a, NULL);
    if (!rx) { expect(0, "compile", "[a-c]+_send\\(", ""); return; }
    {
        static char buf[300];
        size_t i;
        memset(buf, 'z', sizeof(buf));
        for (i = 19; i < sizeof(buf); i += 20) buf[i] = '\n';
        in.s = buf;
        in.n = sizeof(buf);
        r = rtx_rx_search(rx, &in, 0, 100, 1, &s, &ms, &me);
        expect(r == RTX_RX_NONE, "refilled buffer: none", "[a-c]+_send\\(", "");
        memcpy(buf + 10, "ab_send(", 8);
        r = rtx_rx_search(rx, &in, 0, 100, 1, &s, &ms, &me);
        expect(r == RTX_RX_MATCH && ms == 10 && me == 18, "refilled buffer: hit", "[a-c]+_send\\(", "");
    }
    rtx_rx_scratch_drop(&s);
    a.destroy();
}

static const char *esc(const char *in, char *buf, size_t cap) {
    size_t o = 0;
    for (; *in && o + 4 < cap; in++) {
        if (*in == '\n') {
            buf[o++] = '\\';
            buf[o++] = 'n';
        } else {
            buf[o++] = *in;
        }
    }
    buf[o] = 0;
    return buf;
}

/* Random patterns over a small alphabet; DFA / Pike / backtracker must
 * agree on every search (the engines share one program). */
static uint32_t rng = 12345;
static uint32_t rnd(uint32_t n) {
    rng = rng * 1103515245u + 12345u;
    return (rng >> 16) % n;
}

static void gen_pat(char *out, size_t cap, int depth) {
    static const char *atoms[] = {"a", "b", "c", ".", "[ab]", "[^a]", "\\n", "\xC3\xA9",
                                  "\\w", "\\s", "^", "$", "\\b", "\\B", "[a-c\xC3\xA9]", "x",
                                  "ab", "xa", "\\d", "[0-9]", "A", "\\A", "\\z", "\xC3\x89"};
    size_t len = strlen(out);
    int parts = 1 + (int)rnd(3), p;
    for (p = 0; p < parts && len + 24 < cap; p++) {
        int k = (int)rnd(10);
        if (k < 6 || depth > 2) {
            strcat(out, atoms[rnd(sizeof(atoms) / sizeof(atoms[0]))]);
        } else if (k < 8) {
            strcat(out, "(");
            gen_pat(out, cap, depth + 1);
            strcat(out, rnd(2) ? "|" : ")");
            if (out[strlen(out) - 1] == '|') {
                gen_pat(out, cap, depth + 1);
                strcat(out, ")");
            }
        } else {
            strcat(out, "(?:");
            gen_pat(out, cap, depth + 1);
            strcat(out, ")");
        }
        len = strlen(out);
        if (rnd(3) == 0 && out[len - 1] != '^' && out[len - 1] != '$') {
            static const char *q[] = {"*", "+", "?", "*?", "+?", "{1,2}", "{2}", "??"};
            strcat(out, q[rnd(8)]);
        }
        len = strlen(out);
    }
}

static void run_fuzz(void) {
    CCArena a = cc_arena_heap(megabytes(8));
    RtxRxScratch s = {0};
    int it, bad = 0, skipped = 0, budgeted = 0, iters = 3000, maxlen = 24;
    const char *ev = getenv("RX_FUZZ_N");
    /* ASCII, Latin-1 (mixed-class leads), Cyrillic / CJK (all-word leads),
     * an emoji, and broken UTF-8: a lone lead, a truncated scalar, a
     * stray continuation (the DFA's valid-UTF-8 assumption must rerun) */
    static const char *alpha[] = {"a", "b", "c", "\n", " ", "\xC3\xA9", "x", "_",
                                  "A", "1", "\xC3\x89", "\xC2\xAB", "\xD0\xB6",
                                  "\xE4\xB8\xAD", "\xF0\x9F\x98\x80", "\xE4",
                                  "\xE4\xB8", "\x80", "\xD0", "\xE2\x80\x94"};
    if (ev && ev[0]) iters = atoi(ev);
    ev = getenv("RX_FUZZ_SEED");
    if (ev && ev[0]) rng = (uint32_t)atoi(ev);
    ev = getenv("RX_FUZZ_LEN");
    if (ev && ev[0]) maxlen = atoi(ev);
    if (maxlen < 1) maxlen = 1;
    if (maxlen > 200) maxlen = 200;
    for (it = 0; it < iters; it++) {
        char pat[256] = {0};
        char subj[512] = {0};
        RtxRxIn in = {0};
        RtxRx *rx;
        size_t n, lo;
        int slen = (int)rnd((uint32_t)maxlen), k, f;
        size_t ms[4] = {0, 0, 0, 0}, me[4] = {0, 0, 0, 0};
        int r[4];
        gen_pat(pat, sizeof(pat), 0);
        for (k = 0; k < slen; k++) strcat(subj, alpha[rnd(rnd(3) ? 12 : 20)]);
        rx = try_compile(pat, rnd(4) == 0 ? RTX_RX_ICASE : 0, a, NULL);
        if (!rx) {
            skipped++;
            continue;
        }
        n = strlen(subj);
        in.s = subj;
        in.n = n;
        in.gpos = RTX_RX_UNSET;
        in.ctx = RTX_RX_CTX_BOL0 | RTX_RX_CTX_BOT0;
        in.budget = 1000000;
        lo = n ? rnd((uint32_t)n) : 0;
        /* 0 auto (DFA + prefilter), 1 Pike, 2 backtracker, 3 DFA alone */
        for (f = 0; f < 4; f++) {
            size_t h0 = s.budget_hits;
            in.force = (unsigned)f;
            r[f] = rtx_rx_search(rx, &in, lo, n + 1, 1, &s, &ms[f], &me[f]);
            if (s.budget_hits != h0) r[f] = -1; /* inconclusive: budget spent */
        }
        if (r[0] < 0 || r[2] < 0) budgeted++;
        for (f = 1; f < 4; f++) {
            if (r[f] < 0 || r[0] < 0) continue;
            if (r[f] != r[0] || (r[0] == RTX_RX_MATCH && (ms[f] != ms[0] || me[f] != me[0]))) {
                char eb[1200];
                if (bad < 12)
                    fprintf(stderr, "FUZZ MISMATCH /%s/ on \"%s\" lo=%zu: dfa %d [%zu,%zu) %s %d [%zu,%zu)\n",
                            pat, esc(subj, eb, sizeof(eb)), lo, r[0], ms[0], me[0],
                            f == 1 ? "pike" : f == 2 ? "bt" : "dfa-nopf", r[f],
                            ms[f], me[f]);
                bad++;
                break;
            }
        }
        /* anchored at the found start: same end, same group 1 (Pike vs BT) */
        if (r[0] == RTX_RX_MATCH && r[2] == RTX_RX_MATCH) {
            RtxRxCaps c1, c2;
            size_t e1 = 0, e2 = 0;
            int a1, a2;
            in.force = 2;
            a2 = rtx_rx_at(rx, &in, ms[0], &s, &e2, &c2);
            if (rtx_rx_mode(rx) == RTX_RX_LINEAR) {
                /* auto: Pike, or the backtracker when captures sit in a
                 * nullable loop (Onig keeps the empty last iteration) */
                in.force = 0;
                a1 = rtx_rx_at(rx, &in, ms[0], &s, &e1, &c1);
                if (a2 != RTX_RX_BUDGET &&
                    (a1 != a2 || e1 != e2 ||
                     (a1 == RTX_RX_MATCH && rtx_rx_groups(rx) > 1 &&
                      (c1.s[1] != c2.s[1] || c1.e[1] != c2.e[1])))) {
                    char eb[1200];
                    if (bad < 12)
                        fprintf(stderr, "FUZZ ANCHORED MISMATCH /%s/ on \"%s\" at=%zu: auto %d %zu g1[%zu,%zu) bt %d %zu g1[%zu,%zu)\n",
                                pat, esc(subj, eb, sizeof(eb)), ms[0], a1, e1, c1.s[1], c1.e[1],
                                a2, e2, c2.s[1], c2.e[1]);
                    bad++;
                }
            }
            if (a2 == RTX_RX_MATCH && e2 != me[0]) {
                char eb[1200];
                if (bad < 12)
                    fprintf(stderr, "FUZZ SEARCH/ANCHOR MISMATCH /%s/ on \"%s\" at=%zu: search end %zu anchored %zu\n",
                            pat, esc(subj, eb, sizeof(eb)), ms[0], me[0], e2);
                bad++;
            }
            in.force = 0;
        }
        /* partial windows: DFA and Pike agree when the text is cut short */
        if (n > 4) {
            size_t cut = n - 2;
            in.n = cut;
            for (f = 0; f < 4; f++) {
                if (f == 2) continue;
                in.force = (unsigned)f;
                r[f] = rtx_rx_search(rx, &in, lo < cut ? lo : 0, cut / 2 + 1, 0, &s, &ms[f], &me[f]);
            }
            r[2] = r[0];
            ms[2] = ms[0];
            me[2] = me[0];
            if (r[1] != r[0] || (r[0] != RTX_RX_NONE && (ms[1] != ms[0] ||
                                                         (r[0] == RTX_RX_MATCH && me[1] != me[0]))) ||
                r[3] != r[0] || (r[0] != RTX_RX_NONE && (ms[3] != ms[0] ||
                                                         (r[0] == RTX_RX_MATCH && me[3] != me[0])))) {
                char eb[1200];
                subj[cut] = 0;
                if (bad < 12)
                    fprintf(stderr, "FUZZ PARTIAL MISMATCH /%s/ on \"%s\" lo=%zu stop=%zu: dfa %d [%zu,%zu) pike %d [%zu,%zu) dfa-nopf %d [%zu,%zu)\n",
                            pat, esc(subj, eb, sizeof(eb)), lo < cut ? lo : 0, cut / 2 + 1, r[0], ms[0], me[0], r[1], ms[1], me[1],
                            r[3], ms[3], me[3]);
                bad++;
            }
        }
    }
    checks++;
    if (bad) fails++;
    printf("fuzz: %d patterns, %d mismatches, %d compile-skips, %d budgeted, dfa resets %zu giveups %zu exact reruns %zu\n",
           iters, bad, skipped, budgeted, s.dfa_resets, s.dfa_giveups, s.dfa_exact);
    rtx_rx_scratch_drop(&s);
    a.destroy();
}

/* Prefilter differential: literal-shaped patterns (ignore case, inner
 * literals under a line or offset bound, literal sets) on long random
 * haystacks with planted hits, long enough for the vector filter. Every
 * hit list must equal the plain DFA scan (force 3) and the Pike VM; cut
 * windows (partial) must agree too. */
static void rand_lit(char *out, size_t cap, int maxn) {
    static const char *ch[] = {"a", "b", "c", "x", "y", "z", "_", "(", "E", "\xC3\xA9", "q", "Q"};
    int n = 1 + (int)rnd((uint32_t)maxn), k;
    out[0] = 0;
    for (k = 0; k < n && strlen(out) + 4 < cap; k++) {
        const char *c = ch[rnd(12)];
        if (!strcmp(c, "(")) strcat(out, "\\(");
        else strcat(out, c);
    }
}

/* The literal text of rand_lit's pattern (unescape \( ), case-flipped
 * at random when icase. */
static void lit_text(const char *pat, char *out, int flip) {
    size_t o = 0;
    for (; *pat; pat++) {
        char c = *pat;
        if (c == '\\' && pat[1]) c = *++pat;
        if (flip && rnd(2)) {
            if (c >= 'a' && c <= 'z') c = (char)(c - 32);
            else if (c >= 'A' && c <= 'Z') c = (char)(c + 32);
        }
        out[o++] = c;
    }
    out[o] = 0;
}

static void run_pf_fuzz(void) {
    CCArena a = cc_arena_heap(megabytes(8));
    RtxRxScratch s = {0};
    int it, bad = 0, iters = 1500, withpf = 0;
    static const char *alpha[] = {"a", "b", "c", "x", "y", "z", "_", "(", "\n", " ", "A",
                                  "X", "E", "e", "\xC3\xA9", "\xC3\x89", "0", "1", "q",
                                  "\xD0\xB6", "\xE4\xB8\xAD", "\xE4", "\x80"};
    const char *ev = getenv("RX_PF_N");
    static char subj[4096];
    if (ev && ev[0]) iters = atoi(ev);
    for (it = 0; it < iters; it++) {
        char l1[64], l2[64], l3[64], pat[512], t1[64], t2[64];
        RtxRxIn in = {0};
        RtxRx *rx;
        unsigned fl = rnd(3) == 0 ? RTX_RX_ICASE : 0;
        int kind = (int)rnd(12), k, f, plants;
        size_t n, len = 40 + rnd(900), lo, pos[3];
        uint32_t hsh[3];
        int cnt[3];
        rand_lit(l1, sizeof(l1), 6);
        rand_lit(l2, sizeof(l2), 4);
        rand_lit(l3, sizeof(l3), 3);
        switch (kind) {
        case 0: snprintf(pat, sizeof(pat), "%s", l1); break;
        case 1: snprintf(pat, sizeof(pat), "\\b%s\\w*", l1); break;
        case 2: snprintf(pat, sizeof(pat), "[a-c]+%s", l1); break;
        case 3: snprintf(pat, sizeof(pat), "(?s).{0,3}%s", l1); break;
        case 4: snprintf(pat, sizeof(pat), "%s|%s|%s", l1, l2, l3); break;
        case 5: snprintf(pat, sizeof(pat), "(?:%s|%s)[0-9]+", l1, l2); break;
        case 6: snprintf(pat, sizeof(pat), "%s\\s+%s", l1, l2); break;
        case 7: snprintf(pat, sizeof(pat), "[^x]*%s", l1); break;
        case 8: snprintf(pat, sizeof(pat), "\\d{2}%s(%s)?", l1, l2); break;
        case 9: snprintf(pat, sizeof(pat), "^%s|%s$", l1, l2); break;
        case 10: snprintf(pat, sizeof(pat), "\\b\\w+%s\\b", l1); break;
        default: snprintf(pat, sizeof(pat), "%s\\B.|\\b.%s", l1, l2); break;
        }
        rx = try_compile(pat, fl, a, NULL);
        if (!rx) continue;
        subj[0] = 0;
        n = 0;
        while (n < len) {
            const char *c = alpha[rnd(23)];
            strcat(subj, c);
            n += strlen(c);
        }
        /* plant literal hits */
        plants = (int)rnd(4);
        for (k = 0; k < plants; k++) {
            size_t at = rnd((uint32_t)n), ln;
            lit_text(k & 1 ? l2 : l1, t1, fl != 0);
            ln = strlen(t1);
            if (at + ln < n) memcpy(subj + at, t1, ln);
        }
        n = strlen(subj);
        in.s = subj;
        in.n = n;
        in.gpos = RTX_RX_UNSET;
        in.ctx = RTX_RX_CTX_BOL0 | RTX_RX_CTX_BOT0;
        in.budget = 1000000;
        lo = rnd(8) ? 0 : rnd((uint32_t)n);
        /* every hit from lo: 0 = auto, 1 = Pike, 2 = DFA without prefilter */
        for (f = 0; f < 3; f++) {
            size_t p = lo;
            in.force = f == 2 ? 3u : (unsigned)f;
            cnt[f] = 0;
            hsh[f] = 2166136261u;
            while (p <= n && cnt[f] < 4000) {
                size_t ms = 0, me = 0;
                int r = rtx_rx_search(rx, &in, p, n + 1, 1, &s, &ms, &me);
                if (r != RTX_RX_MATCH) break;
                cnt[f]++;
                hsh[f] = (hsh[f] ^ (uint32_t)ms) * 16777619u;
                hsh[f] = (hsh[f] ^ (uint32_t)me) * 16777619u;
                p = me > ms ? me : ms + 1;
            }
            pos[f] = p;
        }
        if (rtx_rx_has_prefilter(rx)) withpf++;
        if (cnt[1] != cnt[0] || hsh[1] != hsh[0] || cnt[2] != cnt[0] || hsh[2] != hsh[0]) {
            if (bad < 12)
                fprintf(stderr, "PF MISMATCH /%s/%s n=%zu lo=%zu: auto %d pike %d dfa-nopf %d hits\n",
                        pat, fl ? "i" : "", n, lo, cnt[0], cnt[1], cnt[2]);
            bad++;
            continue;
        }
        /* cut windows: partial answers agree */
        for (k = 0; k < 4; k++) {
            size_t cut = rnd((uint32_t)n + 1), stop, l0, ms[3] = {0, 0, 0}, me[3] = {0, 0, 0};
            int r[3];
            if (cut == 0) continue;
            stop = 1 + rnd((uint32_t)cut);
            l0 = rnd((uint32_t)stop);
            in.n = cut;
            for (f = 0; f < 3; f++) {
                in.force = f == 2 ? 3u : (unsigned)f;
                r[f] = rtx_rx_search(rx, &in, l0, stop, 0, &s, &ms[f], &me[f]);
            }
            in.n = n;
            for (f = 1; f < 3; f++) {
                if (r[f] != r[0] || (r[0] != RTX_RX_NONE && ms[f] != ms[0]) ||
                    (r[0] == RTX_RX_MATCH && me[f] != me[0])) {
                    if (bad < 12)
                        fprintf(stderr, "PF PARTIAL MISMATCH /%s/%s cut=%zu lo=%zu stop=%zu: auto %d [%zu,%zu) %s %d [%zu,%zu)\n",
                                pat, fl ? "i" : "", cut, l0, stop, r[0], ms[0], me[0],
                                f == 1 ? "pike" : "dfa-nopf", r[f], ms[f], me[f]);
                    bad++;
                    break;
                }
            }
        }
        (void)t2;
        (void)pos;
    }
    checks++;
    if (bad) fails++;
    printf("pf fuzz: %d patterns (%d with a prefilter), %d mismatches\n", iters, withpf, bad);
    rtx_rx_scratch_drop(&s);
    a.destroy();
}

/* A DFA whose states outgrow the cache: it clears and goes on (or hands
 * the search to the Pike VM when it thrashes); answers stay the Pike VM's. */
static void run_dfa_cache(void) {
    CCArena a = cc_arena_heap(megabytes(1));
    RtxRxScratch s = {0};
    RtxRxIn in = {0};
    static const char *pats[] = {"[ab]*a[ab]{15}c", "(?:a|b)*a(?:a|b){17}c", "\\ba[ab]{14}\\b", NULL};
    size_t n = 300000, k, i;
    char *t = (char *)malloc(n + 1);
    uint32_t seed = 99;
    if (!t) return;
    for (i = 0; i < n; i++) {
        seed = seed * 1103515245u + 12345u;
        t[i] = (seed >> 16) & 1 ? 'a' : 'b';
    }
    t[n - 5] = 'c';
    t[n] = 0;
    in.s = t;
    in.n = n;
    in.gpos = RTX_RX_UNSET;
    in.ctx = RTX_RX_CTX_BOL0 | RTX_RX_CTX_BOT0;
    for (k = 0; pats[k]; k++) {
        RtxRx *rx = try_compile(pats[k], 0, a, NULL);
        size_t ms[2] = {0, 0}, me[2] = {0, 0}, r0 = s.dfa_resets, g0 = s.dfa_giveups;
        int r[2], f;
        double t0 = now_ms();
        if (!rx) {
            expect(0, "compile", pats[k], "");
            continue;
        }
        for (f = 0; f < 2; f++) {
            in.force = (unsigned)f;
            r[f] = rtx_rx_search(rx, &in, 0, n, 1, &s, &ms[f], &me[f]);
        }
        in.force = 0;
        printf("dfa cache: /%s/ r=%d [%zu,%zu) resets+=%zu giveups+=%zu %.1f ms\n", pats[k], r[0],
               ms[0], me[0], s.dfa_resets - r0, s.dfa_giveups - g0, now_ms() - t0);
        expect(r[0] == r[1] && (r[0] != RTX_RX_MATCH || (ms[0] == ms[1] && me[0] == me[1])),
               "dfa cache overflow: same answer as Pike", pats[k], "");
    }
    free(t);
    rtx_rx_scratch_drop(&s);
    a.destroy();
}

/* Reverse inner: which patterns take it (compile's safety proofs), and
 * answers on short subjects with it forced (force 4). */
typedef struct {
    const char *pat;
    unsigned fl;
    int inner; /* 1: compile builds the reverse inner search */
} RiShape;

static const RiShape ri_shapes[] = {
    {"\\w+\\s+Holmes\\s+\\w+", 0, 1},       /* sep: \s+ vs \w+ and 'H' */
    {"\\w+\\s+\xD0\xA5\xD0\xBE\xD0\xBB\xD0\xBC\xD1\x81\\s+\\w+", 0, 1},
    {"\\w+\\s+(?:Holmes|Watson)", 0, 1},     /* a literal set */
    {"[a-z_]+\\s*=\\s*NULL", 0, 1},          /* byte: P never takes 'N' */
    {"\\w+\\s*Holmes", 0, 1},               /* chain: C0+ C1* */
    {"(?s).*TODO", 0, 1},                   /* chain: one run, across newlines */
    {"\\b\\w{2,}\\s*Holmes", 0, 0},          /* chain needs C0{0,1} before C1* */
    {"\\w+\\s*\\w+Holmes", 0, 0},            /* no proof: P may hold the literal */
    {"\\s*\\w*\\s+\\w+Holmes", 0, 0},
    {"\\w+Holmes", 0, 0},                 /* \w takes no newline: the line prefilter */
    {"[a-z]+_send\\(", 0, 0},               /* the line prefilter already takes it */
    {"\\bxylo\\w*", 0, 0},                  /* prefix literal: the prefilter */
    {NULL, 0, 0},
};

typedef struct {
    const char *pat;
    const char *subj;
    int ms;
    int me;
} RiCase;

static const RiCase ri_cases[] = {
    {"\\w+\\s+Holmes\\s+\\w+", "Mr Holmes. Dr\n  Holmes said", 11, 27},
    {"\\w+\\s+Holmes\\s+\\w+", "Holmes Holmes Holmes", 0, 20},
    {"\\w+\\s+Holmes", "HolmesHolmes Holmes", 0, 19},
    {"\\w+\\s+Holmes", "a\n\n\nHolmes", 0, 10},
    {"\\w+\\s*Holmes", "xHolmesHolmes!", 0, 13},
    {"\\w+\\s*Holmes!", "xHolmesHolmes yHolmes!", 14, 22},
    {"(?s).*TODO", "a\nb TODO c TODO\nd", 0, 15},
    {"[a-z_]+\\s*=\\s*NULL", "x = 1; y_z =\n NULL;", 7, 18},
    {"[a-z_]+\\s*=\\s*NULL", "A = NULL", -1, 0},
    {"\\w+\\s+(?:Holmes|Watson)", "Dr. Watson, Mr Holmes", 12, 21},
    {"\\w+\\s+Holmes", "\xC3\xA9t\xC3\xA9 Holmes", 0, 12},
    {"\\w+\\s+Holmes", "\xE4\xB8 Holmes", -1, 0},  /* a stray lead is not \w */
    {"\\w+\\s+Holmes", "\xE4\xB8\xAD\xC2\xA0Holmes", 0, 11}, /* U+00A0 is \s */
    {NULL, NULL, 0, 0},
};

static void run_ri_cases(void) {
    CCArena a = cc_arena_heap(megabytes(4));
    RtxRxScratch s = {0};
    size_t i;
    int f;
    for (i = 0; ri_shapes[i].pat; i++) {
        RtxRx *rx = try_compile(ri_shapes[i].pat, ri_shapes[i].fl, a, NULL);
        char what[128];
        snprintf(what, sizeof(what), "reverse inner built = %d", ri_shapes[i].inner);
        expect(rx && rtx_rx_has_inner(rx) == ri_shapes[i].inner, what, ri_shapes[i].pat, "");
    }
    for (i = 0; ri_cases[i].pat; i++) {
        const RiCase *c = &ri_cases[i];
        RtxRx *rx = try_compile(c->pat, 0, a, NULL);
        RtxRxIn in = {0};
        size_t n = strlen(c->subj);
        if (!rx) {
            expect(0, "compile", c->pat, c->subj);
            continue;
        }
        expect(rtx_rx_has_inner(rx), "reverse inner built", c->pat, c->subj);
        in.s = c->subj;
        in.n = n;
        in.gpos = RTX_RX_UNSET;
        in.ctx = RTX_RX_CTX_BOL0 | RTX_RX_CTX_BOT0;
        for (f = 0; f < 3; f++) {
            size_t ms = 0, me = 0;
            char what[128];
            int r;
            in.force = f == 0 ? 4u : f == 1 ? 3u : 1u;
            r = rtx_rx_search(rx, &in, 0, n + 1, 1, &s, &ms, &me);
            snprintf(what, sizeof(what), "ri case %zu force %u (got %d [%zu,%zu))", i, in.force,
                     r, ms, me);
            if (c->ms < 0) expect(r == RTX_RX_NONE, what, c->pat, c->subj);
            else
                expect(r == RTX_RX_MATCH && ms == (size_t)c->ms && me == (size_t)c->me, what,
                       c->pat, c->subj);
        }
    }
    rtx_rx_scratch_drop(&s);
    a.destroy();
}

/* Reverse inner differential: X+ sep literal Y shapes (the literal after
 * an unbounded part that may take a newline) on haystacks with newlines,
 * broken UTF-8 and literal pieces. Every hit list from lo, and every cut
 * window (partial answers at a window that is not the text end), must
 * equal the plain DFA (force 3) and the Pike VM, with the reverse inner
 * search forced (force 4) and in auto. */
static void run_ri_fuzz(void) {
    static const char *xs[] = {"\\w", "[a-c]", "[a-z]", "\\S", "\\d", "[^\\n]", ".", "[^x]",
                               "[ab]", "\\w\\w", "[a-z\xC3\xA9]", "(?:ab|a)", "\\D", "[^ ]",
                               "(?s:.)", "\\W", "[\xD0\xB0-\xD1\x8F]"};
    static const char *qs[] = {"+", "*", "+?", "{2,}", "{1,3}", "", "*?"};
    static const char *seps[] = {"\\s+", "\\s*", " ", "\\s", "\\s+\\b", "[ \\n]+", "\\W+", "-",
                                 "", "\\s{1,2}", "(?:\\s|,)+", "[^a-z]+", "\\s+?"};
    static const char *lits[] = {"Holmes", "ab", "abab", "aab", "xy", "_x\\(", "\xC3\xA9",
                                 "\xD0\xB6\xD0\xB6", "\xE4\xB8\xAD", "Ab", "x", "(?:ab|ba)",
                                 "(?:Holmes|Watson)", "(?i:hol)", "b\\n", "a-", "\\(\\)"};
    static const char *ys[] = {"", "\\w*", "\\s+\\w+", "[0-9]+", "x?", "\\b", "$", "(?:ab)*",
                               ".*", "\\s*\\w{2}", "\\z"};
    static const char *alpha[] = {"a", "b", "c", "x", "y", " ", " ", "\n", "\n", "-", "_", "(",
                                  ",", "1", "9", "\xC3\xA9", "\xD0\xB6", "\xE4\xB8\xAD", "A",
                                  "H", "Holmes", "Watson", "ab", "ba", "hol", "HOL", "xy",
                                  "_x(", "()", "\xE4", "\x80", "\xE4\xB8", "\xC2\xAB",
                                  "\xC2\xA0"};
    CCArena a = cc_arena_heap(megabytes(16));
    RtxRxScratch s = {0};
    int it, bad = 0, iters = 2500, inner = 0, k, f;
    const char *ev = getenv("RX_RI_N");
    static char subj[8192];
    if (ev && ev[0]) iters = atoi(ev);
    for (it = 0; it < iters; it++) {
        char pat[256];
        RtxRxIn in = {0};
        RtxRx *rx;
        size_t n, len, lo;
        uint32_t hsh[4];
        int cnt[4];
        unsigned fl = rnd(8) == 0 ? RTX_RX_ICASE : 0u;
        const char *pre = rnd(4) ? "" : rnd(2) ? "^" : "\\b";
        const char *opt = rnd(7) ? "" : rnd(2) ? "(?m)" : "(?s)";
        snprintf(pat, sizeof(pat), "%s%s%s%s%s", opt, pre, xs[rnd(17)], qs[rnd(7)], seps[rnd(13)]);
        if (rnd(4) == 0) {
            strcat(pat, xs[rnd(17)]);
            strcat(pat, qs[rnd(7)]);
        }
        strcat(pat, lits[rnd(17)]);
        strcat(pat, ys[rnd(11)]);
        rx = try_compile(pat, fl, a, NULL);
        if (!rx || !rtx_rx_has_inner(rx)) continue;
        inner++;
        len = rnd(4) ? rnd(120) : 200 + rnd(3000);
        subj[0] = 0;
        n = 0;
        while (n < len) {
            const char *c = alpha[rnd(34)];
            strcat(subj, c);
            n += strlen(c);
        }
        in.s = subj;
        in.n = n;
        in.gpos = RTX_RX_UNSET;
        in.ctx = RTX_RX_CTX_BOL0 | RTX_RX_CTX_BOT0;
        lo = rnd(4) || !n ? 0 : rnd((uint32_t)n);
        /* every hit from lo: 4 reverse inner forced, 0 auto, 3 plain DFA, 1 Pike */
        for (f = 0; f < 4; f++) {
            static const unsigned fo[4] = {4, 0, 3, 1};
            size_t p = lo;
            in.force = fo[f];
            cnt[f] = 0;
            hsh[f] = 2166136261u;
            while (p <= n && cnt[f] < 4000) {
                size_t ms = 0, me = 0;
                int r = rtx_rx_search(rx, &in, p, n + 1, 1, &s, &ms, &me);
                if (r != RTX_RX_MATCH) break;
                cnt[f]++;
                hsh[f] = (hsh[f] ^ (uint32_t)ms) * 16777619u;
                hsh[f] = (hsh[f] ^ (uint32_t)me) * 16777619u;
                p = me > ms ? me : ms + 1;
            }
        }
        if (cnt[0] != cnt[2] || hsh[0] != hsh[2] || cnt[1] != cnt[2] || hsh[1] != hsh[2] ||
            cnt[3] != cnt[2] || hsh[3] != hsh[2]) {
            char eb[1200];
            if (bad < 12)
                fprintf(stderr, "RI MISMATCH /%s/%s on \"%s\" lo=%zu: ri %d auto %d dfa %d pike %d hits\n",
                        pat, fl ? "i" : "", esc(subj, eb, sizeof(eb)), lo, cnt[0], cnt[1], cnt[2],
                        cnt[3]);
            bad++;
            continue;
        }
        /* cut windows (not the text end), and eof searches that stop early */
        for (k = 0; k < 8; k++) {
            size_t cut = rnd((uint32_t)n + 1), stop, l0, ms[4] = {0, 0, 0, 0}, me[4] = {0, 0, 0, 0};
            int r[4], eof = k >= 6;
            static const unsigned fo[4] = {4, 0, 3, 1};
            if (cut == 0) continue;
            stop = 1 + rnd((uint32_t)cut);
            l0 = rnd((uint32_t)stop);
            in.n = eof ? n : cut;
            for (f = 0; f < 4; f++) {
                in.force = fo[f];
                r[f] = rtx_rx_search(rx, &in, l0, stop, eof, &s, &ms[f], &me[f]);
            }
            in.n = n;
            for (f = 0; f < 4; f++) {
                if (f == 2) continue;
                if (r[f] != r[2] || (r[2] != RTX_RX_NONE && ms[f] != ms[2]) ||
                    (r[2] == RTX_RX_MATCH && me[f] != me[2])) {
                    char eb[1200];
                    if (bad < 12)
                        fprintf(stderr, "RI WINDOW MISMATCH /%s/%s on \"%s\" n=%zu lo=%zu stop=%zu eof=%d: dfa %d [%zu,%zu) %s %d [%zu,%zu)\n",
                                pat, fl ? "i" : "", esc(subj, eb, sizeof(eb)), eof ? n : cut, l0,
                                stop, eof, r[2], ms[2], me[2],
                                f == 0 ? "ri" : f == 1 ? "auto" : "pike", r[f], ms[f], me[f]);
                    bad++;
                    break;
                }
            }
        }
    }
    checks++;
    if (bad) fails++;
    expect(inner > iters / 5, "reverse inner fuzz: enough patterns take it", "", "");
    printf("ri fuzz: %d patterns (%d with reverse inner), %d mismatches, ri work %zu bytes, %zu bails\n",
           iters, inner, bad, s.ri_work, s.ri_bails);
    rtx_rx_scratch_drop(&s);
    a.destroy();
}

/* Reverse inner stays linear: inputs where a naive reverse scan from every
 * literal hit (or a forward scan from every start) is quadratic. The bytes
 * it reads stay within a constant factor of the text, the answer is the
 * plain DFA's and the time stays in line with it. */
static void run_ri_linear(void) {
    static const struct {
        const char *pat;
        const char *unit; /* repeated to fill the text */
        const char *tail; /* at the very end */
    } adv[] = {
        /* one \w run, the literal every 7 bytes, no match */
        {"\\w+\\s+Holmes", "abHolmes", ""},
        {"\\w+\\s*Holmes!", "xHolmes", ""},
        /* every hit reverse-scans back to the start of the run, then the
         * forward confirm runs to its end: n^2 without the guards */
        {"[a-zQ\\s]+Q\\d", "Q", ""},
        {"[a-zQ\\s]+Q\\d", "a\nQ", "Q1"},
        /* the literal every 9 bytes, each confirm fails after it */
        {"\\w+\\s+Holmes\\d", "a Holmes ", ""},
        /* a P start at every hit, the confirm fails at once */
        {"\\w+\\s+Holmes\\s+\\w+", "x Holmes.", "x Holmes y"},
        /* long runs of P between hits */
        {"(?s).*TODO\\d", "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaTODO\n", ""},
    };
    CCArena a = cc_arena_heap(megabytes(4));
    RtxRxScratch s = {0};
    size_t n = (size_t)1 << 20, k;
    char *t = (char *)malloc(n + 64);
    if (!t) return;
    for (k = 0; k < sizeof(adv) / sizeof(adv[0]); k++) {
        RtxRx *rx = try_compile(adv[k].pat, 0, a, NULL);
        RtxRxIn in = {0};
        size_t ul = strlen(adv[k].unit), tl = strlen(adv[k].tail), m = 0, w0, b0, hits[2] = {0, 0};
        double tm[2] = {0, 0};
        int f;
        if (!rx) {
            expect(0, "compile", adv[k].pat, "");
            continue;
        }
        expect(rtx_rx_has_inner(rx), "reverse inner built", adv[k].pat, "");
        while (m + ul + tl <= n) {
            memcpy(t + m, adv[k].unit, ul);
            m += ul;
        }
        memcpy(t + m, adv[k].tail, tl);
        m += tl;
        in.s = t;
        in.n = m;
        in.gpos = RTX_RX_UNSET;
        in.ctx = RTX_RX_CTX_BOL0 | RTX_RX_CTX_BOT0;
        w0 = s.ri_work;
        b0 = s.ri_bails;
        /* 0 auto (reverse inner, guards and rest), 1 plain DFA; every
         * match, as find walks them, then a cut window */
        for (f = 0; f < 2; f++) {
            size_t p = 0, ms = 0, me = 0;
            double t0 = now_ms();
            in.force = f == 0 ? 0u : 3u;
            while (p < m && rtx_rx_search(rx, &in, p, m, 1, &s, &ms, &me) == RTX_RX_MATCH) {
                hits[f]++;
                p = me > ms ? me : ms + 1;
            }
            in.n = m - 5;
            (void)rtx_rx_search(rx, &in, m / 2, m / 2 + 4096, 0, &s, &ms, &me);
            in.n = m;
            tm[f] = now_ms() - t0;
        }
        printf("ri linear: /%s/ on %zu bytes: %zu hits, ri work %zu bytes (%.2fx), %zu bails, %.2f ms vs plain %.2f ms\n",
               adv[k].pat, m, hits[0], s.ri_work - w0, (double)(s.ri_work - w0) / (double)m,
               s.ri_bails - b0, tm[0], tm[1]);
        expect(hits[0] == hits[1], "reverse inner: same hits as the plain DFA", adv[k].pat, "");
        expect(s.ri_work - w0 <= 4 * m + ((size_t)64 << 10), "reverse inner: linear byte work",
               adv[k].pat, "");
        expect(tm[0] <= 4.0 * tm[1] + 20.0, "reverse inner: time in line with the plain DFA",
               adv[k].pat, "");
    }
    free(t);
    rtx_rx_scratch_drop(&s);
    a.destroy();
}

/* rx_smoke --one PATTERN SUBJECT LO [EOFCUT]: print each engine's answer
 * (a hook for shrinking a fuzz mismatch by hand). */
static int run_one(int argc, char **argv) {
    CCArena a = cc_arena_heap(megabytes(1));
    RtxRxScratch s = {0};
    RtxRxIn in = {0};
    RtxRx *rx;
    size_t lo, ms, me, stop;
    int f, r, eof = 1;
    if (argc < 5) return 2;
    rx = try_compile(argv[2], getenv("RX_ICASE") ? RTX_RX_ICASE : 0, a, NULL);
    if (!rx) {
        printf("compile error\n");
        return 0;
    }
    in.s = argv[3];
    in.n = strlen(argv[3]);
    in.gpos = RTX_RX_UNSET;
    in.ctx = RTX_RX_CTX_BOL0 | RTX_RX_CTX_BOT0;
    in.budget = 1000000;
    lo = (size_t)atoi(argv[4]);
    stop = in.n + 1;
    if (argc > 5) {
        eof = 0;
        stop = (size_t)atoi(argv[5]);
    }
    for (f = 0; f < 5; f++) {
        in.force = (unsigned)f;
        ms = me = 0;
        r = rtx_rx_search(rx, &in, lo, stop, eof, &s, &ms, &me);
        printf("%d %zu %zu\n", r, r ? ms : 0, r == 1 ? me : 0);
    }
    rtx_rx_scratch_drop(&s);
    a.destroy();
    return 0;
}

int main(int argc, char **argv) {
    if (argc > 1 && !strcmp(argv[1], "--one")) return run_one(argc, argv);
    run_cases();
    run_errors();
    run_misc();
    run_patho();
    run_fuzz();
    run_pf_fuzz();
    run_ri_cases();
    run_ri_fuzz();
    run_ri_linear();
    run_dfa_cache();
    if (fails) {
        fprintf(stderr, "rx_smoke: %d of %d checks failed\n", fails, checks);
        return 1;
    }
    printf("rx_smoke ok  checks=%d cases=%zu\n", checks, sizeof(cases) / sizeof(cases[0]));
    return 0;
}
