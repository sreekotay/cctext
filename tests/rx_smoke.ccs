    {"a.*?b", 0, "aXbYb", 0, 3, NULL},
    {"a.*b", 0, "aXbYb", 0, 5, NULL},
    {"a+?", 0, "aaa", 0, 1, NULL},
    {"a??b", 0, "ab", 0, 2, NULL},
    {"<.+?>", 0, "<a><b>", 0, 3, NULL},
