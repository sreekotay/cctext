    {"EXIT_failure", RTX_RX_ICASE, "x exit_FAILURE y", 2, 14, NULL},
    {"EXIT_failure", RTX_RX_ICASE | RTX_RX_LITERAL, "EXIT_FAILUR exit_failure", 12, 24, NULL},
