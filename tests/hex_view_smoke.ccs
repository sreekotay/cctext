#!ccc ccs
/*
 * Hex view helpers: row math + read window of bytes (no frontend).
 */
#include <ccc/std/prelude.cch>
#include <ccc/script/stdio.cch>
#include <stdio.h>
#include <string.h>
#include "../core/document.cch"
#include "../core/layout.cch"

static int fails = 0;

static void expect(int cond, const char *msg) {
    if (!cond) {
        fprintf(stderr, "FAIL: %s\n", msg);
        fails++;
    }
}

int main(void) {
    RtxDoc d = {0} @destroy;
    RtxLayout L = {0} @destroy;
    char buf[32];
    size_t got;

    @errhandler(CCError e) {
        fprintf(stderr, "hex_view_smoke: %s\n", e.message ? e.message : "?");
        return 1;
    }

    expect(rtx_hex_align(0) == 0, "align 0");
    expect(rtx_hex_align(17) == 16, "align 17");
    expect(rtx_hex_row_count(0) == 1, "empty rows");
    expect(rtx_hex_row_count(16) == 1, "16 bytes one row");
    expect(rtx_hex_row_count(17) == 2, "17 bytes two rows");
    expect(rtx_hex_row_off(0, 1) == 16, "row 1 off");
    expect(rtx_hex_ascii('A') == 'A', "ascii printable");
    expect(rtx_hex_ascii(0) == '.', "ascii nul");

    d.from_buffer("Hello, hex!\nSecond line.\n") !>;
    rtx_layout_set_view(&L, RTX_VIEW_HEX);
    expect(rtx_layout_is_hex(&L), "hex view");
    expect(!L.wrap, "hex not wrap");
    rtx_layout_cycle_view(&L);
    expect(L.view == RTX_VIEW_DEFAULT, "cycle hex->default");
    rtx_layout_cycle_view(&L);
    expect(L.view == RTX_VIEW_WRAP && L.wrap, "cycle to wrap");
    rtx_layout_cycle_view(&L);
    expect(rtx_layout_is_hex(&L), "cycle to hex");

    got = d.read_at(0, buf, 16) !>;
    expect(got == 16, "first hex row bytes");
    expect(memcmp(buf, "Hello, hex!\nSeco", 16) == 0, "row content");

    printf("hex_view_smoke ok\n");
    return fails ? 1 : 0;
}
