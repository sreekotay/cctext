#!ccc ccs
/*
 * Hex view helpers: row math + read window of bytes (no frontend).
 */
#include <ccc/std/prelude.cch>
#include <ccc/script/stdio.cch>
#include <stdio.h>
#include <string.h>
#include "../core/document.cch"
#include "../core/layout.cch"
#include "../core/workspace.cch"

static int fails = 0;

static void expect(int cond, const char *msg) {
    if (!cond) {
        fprintf(stderr, "FAIL: %s\n", msg);
        fails++;
    }
}

int main(void) {
    RtxDoc d = {0} @destroy;
    RtxLayout L = {0} @destroy;
    char buf[32];
    size_t got;

    @errhandler(CCError e) {
        fprintf(stderr, "hex_view_smoke: %s\n", e.message ? e.message : "?");
        return 1;
    }
    @errhandler(RtxIndexErr e) {
        fprintf(stderr, "hex_view_smoke: %s\n", e.message ? e.message : "index");
        return 1;
    }

    expect(rtx_hex_align(0) == 0, "align 0");
    expect(rtx_hex_align(17) == 16, "align 17");
    expect(rtx_hex_row_count(0) == 1, "empty rows");
    expect(rtx_hex_row_count(16) == 1, "16 bytes one row");
    expect(rtx_hex_row_count(17) == 2, "17 bytes two rows");
    expect(rtx_hex_row_off(0, 1) == 16, "row 1 off");
    expect(rtx_hex_ascii('A') == 'A', "ascii printable");
    expect(rtx_hex_ascii(0) == '.', "ascii nul");
    expect(rtx_hex_ascii_col0() == RTX_HEX_OFF_W + RTX_HEX_COLS * 3 + RTX_HEX_GAP,
           "ascii col0");
    {
        RtxHexDumpCell cells[RTX_HEX_COLS];
        unsigned char cafe[] = {'c', 'a', 'f', 0xC3, 0xA9};
        unsigned char torn[] = {0xC3};
        unsigned char straddle[] = {0xC3, 0xA9};
        unsigned char zhong[] = {0xE4, 0xB8, 0xAD};
        unsigned char ctrl[] = {'A', '\n', 0};

        rtx_hex_dump_row(cafe, sizeof(cafe), 0, sizeof(cafe), cells);
        expect(cells[0].kind == RTX_HEX_DUMP_LEAD && cells[0].utf8[0] == 'c',
               "dump c");
        expect(cells[3].kind == RTX_HEX_DUMP_LEAD && cells[3].n == 2 &&
               (unsigned char)cells[3].utf8[0] == 0xC3 &&
               (unsigned char)cells[3].utf8[1] == 0xA9, "dump é lead");
        expect(cells[4].kind == RTX_HEX_DUMP_CONT, "dump é cont");

        rtx_hex_dump_row(torn, 1, 0, 1, cells);
        expect(cells[0].kind == RTX_HEX_DUMP_DOT, "torn C3 is dot");

        rtx_hex_dump_row(straddle, 2, 0, 1, cells);
        expect(cells[0].kind == RTX_HEX_DUMP_LEAD && cells[0].n == 2,
               "peek tail completes é");
        rtx_hex_dump_row(straddle, 2, 1, 1, cells);
        expect(cells[0].kind == RTX_HEX_DUMP_CONT, "row-start cont is ·");

        rtx_hex_dump_row(zhong, 3, 0, 3, cells);
        expect(cells[0].kind == RTX_HEX_DUMP_DOT &&
               cells[1].kind == RTX_HEX_DUMP_DOT &&
               cells[2].kind == RTX_HEX_DUMP_DOT, "wide CJK stays dots");

        rtx_hex_dump_row(ctrl, 3, 0, 3, cells);
        expect(cells[0].kind == RTX_HEX_DUMP_LEAD && cells[0].utf8[0] == 'A',
               "dump A");
        expect(cells[1].kind == RTX_HEX_DUMP_DOT, "newline is dot");
        expect(cells[2].kind == RTX_HEX_DUMP_DOT, "nul is dot");
    }
    expect(rtx_hex_hit_col(0, 32, 0, 0) == 0, "hit offset col");
    expect(rtx_hex_hit_col(0, 32, 0, RTX_HEX_OFF_W) == 0, "hit first hex");
    expect(rtx_hex_hit_col(0, 32, 0, RTX_HEX_OFF_W + 3) == 1, "hit second hex");
    expect(rtx_hex_hit_col(0, 32, 0, rtx_hex_ascii_col0()) == 0, "hit ascii 0");
    expect(rtx_hex_hit_x(0, 32, 0, 0.0f, 8.0f) == 0, "hit x offset");
    expect(rtx_hex_hit_x(0, 32, 0, 8.0f * (float)RTX_HEX_OFF_W + 12.0f, 8.0f) == 0,
           "hit x first hex");

    d.from_buffer("Hello, hex!\nSecond line.\n") !>;
    rtx_layout_set_view(&L, RTX_VIEW_HEX);
    expect(rtx_layout_is_hex(&L), "hex view");
    expect(!L.wrap, "hex not wrap");
    rtx_layout_cycle_view(&L);
    expect(L.view == RTX_VIEW_DEFAULT, "cycle hex->default");
    rtx_layout_cycle_view(&L);
    expect(L.view == RTX_VIEW_WRAP && L.wrap, "cycle to wrap");
    rtx_layout_cycle_view(&L);
    expect(rtx_layout_is_hex(&L), "cycle to hex");

    got = d.read_at(0, buf, 16) !>;
    expect(got == 16, "first hex row bytes");
    expect(memcmp(buf, "Hello, hex!\nSeco", 16) == 0, "row content");

    {
        RtxBuf b = {0} @destroy;
        b.doc.from_buffer("caf\xC3\xA9") !>;
        rtx_layout_set_view(&b.layout, RTX_VIEW_HEX);
        b.doc.caret = 5;
        b.doc.sel_anchor = 5;
        b.move_horiz(-1, 0) !>;
        expect(b.doc.caret == 4, "hex left is one byte, not the é cluster");
        b.move_horiz(1, 0) !>;
        expect(b.doc.caret == 5, "hex right is one byte");
        b.backspace() !>;
        expect(b.doc.len() == 4, "hex backspace deletes one code unit");
        expect(b.doc.caret == 4, "hex caret after byte delete");
        b.delete_forward() !>;
        expect(b.doc.len() == 4, "hex delete at EOF is a no-op");
        b.doc.caret = 3;
        b.doc.sel_anchor = 3;
        b.delete_forward() !>;
        expect(b.doc.len() == 3, "hex delete_forward is one byte");
    }
    {
        RtxBuf b = {0} @destroy;
        b.doc.from_buffer("caf\xC3\xA9") !>;
        b.doc.caret = 4;
        b.doc.sel_anchor = 4;
        rtx_layout_set_view(&b.layout, RTX_VIEW_HEX);
        b.cycle_view(8) !>;
        expect(!rtx_layout_is_hex(&b.layout), "cycle leaves hex");
        expect(b.doc.caret == 3, "leaving hex snaps mid-é to the cluster start");
    }

    printf("hex_view_smoke ok\n");
    return fails ? 1 : 0;
}
