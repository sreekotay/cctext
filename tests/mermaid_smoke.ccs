#!ccc ccs
/*
 * Mermaid through cctext-render (docs/images.md, "Mermaid"): the
 * protocol's MERMAID kind (size then pixels from one script run, parse
 * errors, the node cap, the engine's time budget and restart, the heap
 * and job-count recycling, a pack whose bytecode is not this build's),
 * the editor's second helper slot (lazy, apart from the SVG one; a hung
 * helper killed and respawned; messages), the content-hash cache on disk,
 * all seven diagram types against our reference PNGs and, by structure,
 * against Chromium's renders, the dark and light themes, and the Rich
 * layout: a fence as one picture row, the caret revealing its source, the
 * stale display while its source changes, terminal cells, a theme change
 * that re-renders only what is laid out, and idle once settled.
 *
 * Needs bin/cctext-render, its pack and bin/cctext-render-selftest
 * (./make.shcc @cctext_render; @smoke builds them first).
 */
#include <ccc/std/prelude.cch>
#include <ccc/stdio.cch>
#include <errno.h>
#include <fcntl.h>
#include <poll.h>
#include <signal.h>
#include <spawn.h>
#include <stdatomic.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <sys/socket.h>
#include <sys/stat.h>
#include <sys/wait.h>
#include <time.h>
#include <unistd.h>
#include "../core/utf8.cch"
#include "../core/document.cch"
#include "../core/layout.cch"
#include "../core/img.cch"
#include "../core/img_svg.h"
#include "../render/cr_proto.h"

void rtx_safe_test_isol(void);

static int fails = 0;

static void expect(int cond, const char *msg) {
    if (!cond) {
        fprintf(stderr, "FAIL: %s\n", msg);
        fails++;
    }
}

static uint8_t *slurp(const char *path, size_t *n) {
    FILE *fp = fopen(path, "rb");
    long sz;
    uint8_t *b;
    *n = 0;
    if (!fp) return NULL;
    fseek(fp, 0, SEEK_END);
    sz = ftell(fp);
    fseek(fp, 0, SEEK_SET);
    b = (uint8_t *)malloc((size_t)sz + 1);
    if (b && fread(b, 1, (size_t)sz, fp) != (size_t)sz) {
        free(b);
        b = NULL;
    }
    fclose(fp);
    if (b) {
        b[sz] = 0;
        *n = (size_t)sz;
    }
    return b;
}

/* libm is not linked: the few helpers used here. */
static uint32_t ceilu(float v) {
    uint32_t u;
    if (!(v > 0)) return 0;
    u = (uint32_t)v;
    return (float)u < v ? u + 1 : u;
}

static double sqrt_d(double v) {
    double x = v > 1 ? v : 1;
    int i;
    if (!(v > 0)) return 0;
    for (i = 0; i < 80; i++) x = 0.5 * (x + v / x);
    return x;
}

static double abs_d(double v) { return v < 0 ? -v : v; }

static double now_ms(void) {
    struct timespec ts;
    clock_gettime(CLOCK_MONOTONIC, &ts);
    return (double)ts.tv_sec * 1000.0 + (double)ts.tv_nsec / 1e6;
}

static char g_bin[1024], g_selftest[1024], g_pack[1024];

static const char *const k_types[] = {"flowchart", "sequence", "class", "state",
                                      "gantt", "pie", "er", NULL};
static const char k_light[] = "{\"theme\":\"default\"}";
static const char k_pie[] = "pie title Pets\n  \"Dogs\": 3\n  \"Cats\": 2\n";

/* The helper's payload: options line, newline, source (malloc'd). */
static uint8_t *payload(const char *opts, const char *src, size_t *n) {
    size_t a = strlen(opts), b = strlen(src);
    uint8_t *p = (uint8_t *)malloc(a + 1 + b + 1);
    memcpy(p, opts, a);
    p[a] = '\n';
    memcpy(p + a + 1, src, b + 1);
    *n = a + 1 + b;
    return p;
}

static void cfg_mm(RtxSvgCfg *c) {
    memset(c, 0, sizeof *c);
    c->input_max = 1u << 20;
    c->px_max = 16000000u;
    c->timeout_ms = 10000;
    c->node_max = 150;
}

/* ---- raw protocol ---------------------------------------------------------- */

typedef struct {
    pid_t pid;
    int fd;
} Raw;

static int raw_spawn(Raw *r, const char *bin, char *const *args) {
    int sv[2], na = 0;
    posix_spawn_file_actions_t fa;
    char *argv[12];
    char *envp[1] = {NULL};
    memset(r, 0, sizeof *r);
    if (socketpair(AF_UNIX, SOCK_STREAM | SOCK_CLOEXEC, 0, sv) != 0) return -1;
    posix_spawn_file_actions_init(&fa);
    posix_spawn_file_actions_adddup2(&fa, sv[1], 0);
    posix_spawn_file_actions_adddup2(&fa, sv[1], 1);
    posix_spawn_file_actions_addopen(&fa, 2, "/dev/null", O_WRONLY, 0);
    argv[na++] = (char *)bin;
    while (args && *args && na < 11) argv[na++] = *args++;
    argv[na] = NULL;
    if (posix_spawn(&r->pid, bin, &fa, NULL, argv, envp) != 0) {
        posix_spawn_file_actions_destroy(&fa);
        close(sv[0]);
        close(sv[1]);
        return -1;
    }
    posix_spawn_file_actions_destroy(&fa);
    close(sv[1]);
    r->fd = sv[0];
    return 0;
}

static int raw_read(Raw *r, void *p, size_t n, int ms) {
    uint8_t *b = (uint8_t *)p;
    double dl = now_ms() + ms;
    while (n) {
        struct pollfd pf = {r->fd, POLLIN, 0};
        ssize_t k;
        int left = (int)(dl - now_ms());
        if (left <= 0) return -2;
        if (poll(&pf, 1, left) <= 0) continue;
        k = read(r->fd, b, n);
        if (k <= 0) return -1;
        b += k;
        n -= (size_t)k;
    }
    return 0;
}

static void raw_close(Raw *r) {
    int st;
    close(r->fd);
    kill(r->pid, SIGKILL);
    waitpid(r->pid, &st, 0);
}

static int raw_hello(Raw *r, uint32_t hello[3]) {
    CrReply h;
    if (raw_read(r, &h, sizeof h, 5000) != 0) return -1;
    if (h.magic != CR_MAGIC_REP || h.type != CR_R_HELLO || h.len != 12) return -1;
    return raw_read(r, hello, 12, 5000);
}

static void raw_mm(Raw *r, uint32_t id, uint8_t kind, uint8_t flags, uint32_t bw, uint32_t bh,
                   uint32_t budget, uint32_t node_max, const uint8_t *p, size_t n) {
    CrReq q;
    memset(&q, 0, sizeof q);
    q.magic = CR_MAGIC_REQ;
    q.id = id;
    q.kind = kind;
    q.flags = flags;
    q.scale = 1.0f;
    q.box_w = bw;
    q.box_h = bh;
    q.len = (uint32_t)n;
    q.budget_ms = budget;
    q.node_max = node_max;
    if (send(r->fd, &q, sizeof q, MSG_NOSIGNAL) < 0) return;
    if (n && send(r->fd, p, n, MSG_NOSIGNAL) < 0) return;
}

static int raw_frame(Raw *r, CrReply *h, uint8_t **pl, int ms) {
    *pl = NULL;
    if (raw_read(r, h, sizeof *h, ms) != 0) return -1;
    if (h->magic != CR_MAGIC_REP) return -1;
    *pl = (uint8_t *)malloc(h->len + 1);
    if (!*pl) return -1;
    if (raw_read(r, *pl, h->len, ms) != 0) return -1;
    (*pl)[h->len] = 0;
    return 0;
}

/* A STATS reply's counter `key` (-1 when absent). */
static long stat_of(Raw *r, uint32_t id, const char *key) {
    CrReply h;
    uint8_t *p;
    char k[64];
    long v = -1;
    const char *at;
    raw_mm(r, id, CR_KIND_STATS, 0, 0, 0, 0, 0, NULL, 0);
    if (raw_frame(r, &h, &p, 5000) != 0 || h.type != CR_R_INFO) {
        free(p);
        return -1;
    }
    snprintf(k, sizeof k, "\"%s\":", key);
    at = strstr((const char *)p, k);
    if (at) v = strtol(at + strlen(k), NULL, 10);
    free(p);
    return v;
}

/* A MERMAID request whose first reply is ERROR: its code, message in msg. */
static uint32_t raw_err(Raw *r, uint32_t id, uint32_t budget, uint32_t node_max, const char *src,
                        char *msg, size_t cap, int ms) {
    CrReply h;
    uint8_t *p, *pl;
    size_t n;
    uint32_t code = 0;
    pl = payload(k_light, src, &n);
    raw_mm(r, id, CR_KIND_MERMAID, CR_F_SIZE_ONLY, 0, 0, budget, node_max, pl, n);
    free(pl);
    msg[0] = 0;
    if (raw_frame(r, &h, &p, ms) == 0 && h.type == CR_R_ERROR && h.len >= 4) {
        memcpy(&code, p, 4);
        snprintf(msg, cap, "%s", (const char *)p + 4);
    }
    free(p);
    return code;
}

static int raw_size(Raw *r, uint32_t id, const char *src, CrSize *sz) {
    CrReply h;
    uint8_t *p, *pl;
    size_t n;
    int ok = 0;
    pl = payload(k_light, src, &n);
    raw_mm(r, id, CR_KIND_MERMAID, CR_F_SIZE_ONLY, 0, 0, 10000, 150, pl, n);
    free(pl);
    if (raw_frame(r, &h, &p, 20000) == 0 && h.type == CR_R_SIZE && h.len == sizeof *sz) {
        memcpy(sz, p, sizeof *sz);
        ok = 1;
    }
    free(p);
    return ok;
}

static void test_protocol(void) {
    Raw r;
    uint32_t hello[3];
    CrReply h;
    CrSize sz;
    uint8_t *p, *pl;
    size_t n, fn;
    char msg[400];
    uint8_t *flow = slurp("testdata/mermaid/flowchart.mmd", &fn);
    char big[16384];
    long rs0;
    size_t k = 0;
    int i;
    double t0;
    expect(raw_spawn(&r, g_bin, NULL) == 0 && raw_hello(&r, hello) == 0, "proto: spawn, hello");
    expect(hello[0] == CR_PROTO_VERSION && (hello[1] & (1u << CR_KIND_MERMAID)) &&
               (hello[1] & (1u << CR_KIND_SVG)) && (hello[2] & CR_H_SANDBOXED),
           "proto: hello: v2, SVG and Mermaid, sandboxed");
    expect(stat_of(&r, 1, "engine") == 0, "proto: no engine before the first diagram (lazy)");
    t0 = now_ms();
    expect(raw_size(&r, 2, (const char *)flow, &sz) && sz.w_css > 400 && sz.h_css > 600,
           "proto: flowchart SIZE");
    printf("mermaid_smoke: first diagram (engine start included) %.0f ms, %gx%g\n",
           now_ms() - t0, sz.w_css, sz.h_css);
    expect(stat_of(&r, 3, "engine") == 1 && stat_of(&r, 4, "runs") == 1,
           "proto: the engine started on the first diagram");
    /* Pixels at the box: the SVG from the size request (no second run). */
    pl = payload(k_light, (const char *)flow, &n);
    raw_mm(&r, 5, CR_KIND_MERMAID, 0, 236, 352, 10000, 150, pl, n);
    expect(raw_frame(&r, &h, &p, 20000) == 0 && h.type == CR_R_SIZE && h.id == 5,
           "proto: pixels: SIZE first");
    free(p);
    expect(raw_frame(&r, &h, &p, 20000) == 0 && h.type == CR_R_PIXELS &&
               h.len == 12 + 236 * 352 * 4,
           "proto: pixels: PIXELS at the box");
    free(p);
    free(pl);
    expect(stat_of(&r, 6, "runs") == 1 && stat_of(&r, 7, "cache_hits") == 1,
           "proto: the pixel request reused the script's SVG");
    /* A parse error: mermaid's message, one line; the helper serves on,
     * with the same engine (typing makes one every other keystroke). */
    rs0 = stat_of(&r, 80, "starts");
    expect(raw_err(&r, 8, 10000, 150, "flowchart TD\n  A --> \n  ((( B\n", msg, sizeof msg,
                   20000) == CR_E_SCRIPT &&
               strstr(msg, "Parse error on line 3") && !strchr(msg, '\n'),
           "proto: a parse error names its line");
    expect(raw_err(&r, 9, 10000, 150, "not a diagram at all", msg, sizeof msg, 20000) ==
               CR_E_SCRIPT,
           "proto: no diagram type");
    expect(stat_of(&r, 81, "starts") == rs0 && rs0 > 0, "proto: a parse error keeps the engine");
    /* The node cap, counted from mermaid's own parse, before any layout. */
    k = (size_t)snprintf(big, sizeof big, "flowchart TD\n");
    for (i = 0; i < 200; i++) k += (size_t)snprintf(big + k, sizeof big - k, "  n%d --> n%d\n", i, i + 1);
    t0 = now_ms();
    expect(raw_err(&r, 10, 10000, 150, big, msg, sizeof msg, 20000) == CR_E_TOO_LARGE &&
               strcmp(msg, "diagram too large to render (201 nodes, limit 150)") == 0,
           "proto: node cap: 'diagram too large to render (201 nodes, limit 150)'");
    expect(now_ms() - t0 < 3000, "proto: node cap: refused before layout (fast)");
    {
        long s0 = stat_of(&r, 11, "starts");
        expect(raw_size(&r, 12, k_pie, &sz), "proto: serving after the refusal");
        expect(stat_of(&r, 13, "starts") == s0, "proto: a node-cap refusal keeps the engine");
    }
    /* Configuration a diagram cannot change: htmlLabels, securityLevel. */
    expect(raw_size(&r, 14,
                    "%%{init: {\"htmlLabels\": true, \"securityLevel\": \"loose\"}}%%\n"
                    "flowchart TD\n  A[\"<b>bold</b> label\"] --> B\n  click A callback \"x\"\n",
                    &sz),
           "proto: hostile directives render (ignored)");
    pl = payload(k_light,
                 "%%{init: {\"htmlLabels\": true}}%%\nflowchart TD\n  A[\"label\"] --> B\n", &n);
    raw_mm(&r, 15, CR_KIND_MERMAID, 0, 0, 0, 10000, 150, pl, n);
    free(pl);
    expect(raw_frame(&r, &h, &p, 20000) == 0 && h.type == CR_R_SIZE, "proto: htmlLabels: SIZE");
    free(p);
    if (raw_frame(&r, &h, &p, 20000) == 0 && h.type == CR_R_PIXELS) {
        /* SVG <text> labels draw (a <foreignObject> would be skipped). */
        uint32_t w = ((uint32_t *)p)[0], hh = ((uint32_t *)p)[1], x, y, dark = 0;
        for (y = 0; y < hh; y++)
            for (x = 0; x < w; x++) {
                const uint8_t *q = p + 12 + ((size_t)y * w + x) * 4;
                if (q[3] > 200 && q[0] < 80 && q[1] < 80 && q[2] < 80) dark++;
            }
        expect(dark > 30, "proto: htmlLabels forced off: the label is text");
    } else {
        expect(0, "proto: htmlLabels: PIXELS");
    }
    free(p);
    raw_close(&r);
    free(flow);
}

/* The engine's budget and the recycle policy (the -selftest helper). */
static void test_budget_recycle(void) {
    Raw r;
    uint32_t hello[3];
    CrSize sz;
    char msg[400];
    double t0;
    int i;
    expect(raw_spawn(&r, g_selftest, NULL) == 0 && raw_hello(&r, hello) == 0, "budget: spawn");
    expect(raw_size(&r, 1, k_pie, &sz), "budget: a first diagram");
    t0 = now_ms();
    expect(raw_err(&r, 2, 300, 150, "%%cr-selftest:jsloop", msg, sizeof msg, 5000) == CR_E_TIMEOUT,
           "budget: an endless script ends with CR_E_TIMEOUT");
    expect(now_ms() - t0 < 1500, "budget: ... near its 300 ms budget");
    expect(stat_of(&r, 3, "recycles") == 1 && stat_of(&r, 4, "heap") == 0,
           "budget: the engine is freed after the timeout");
    expect(raw_size(&r, 5, "pie\n  \"after\": 1\n", &sz) && stat_of(&r, 6, "starts") == 2,
           "budget: the next diagram starts a fresh engine");
    raw_close(&r);
    {
        /* Heap past the ceiling: the next call finds a fresh runtime. */
        static char *args[] = {"--recycle-mb", "64", NULL};
        expect(raw_spawn(&r, g_selftest, args) == 0 && raw_hello(&r, hello) == 0, "heap: spawn");
        expect(raw_size(&r, 1, k_pie, &sz), "heap: a first diagram");
        expect(stat_of(&r, 2, "recycles") == 0, "heap: 20 MB of heap is under 64 MB");
        expect(raw_size(&r, 3, "%%cr-selftest:jsheap 80", &sz), "heap: 80 MB retained");
        expect(stat_of(&r, 4, "recycles") == 1 && stat_of(&r, 5, "heap") == 0,
               "heap: past --recycle-mb the engine is recycled");
        expect(raw_size(&r, 6, "pie\n  \"after\": 1\n", &sz) && stat_of(&r, 7, "starts") == 2 &&
                   stat_of(&r, 8, "heap") < (40l << 20),
               "heap: the next diagram runs on a fresh heap");
        raw_close(&r);
    }
    {
        static char *args[] = {"--recycle-jobs", "2", NULL};
        char src[64];
        expect(raw_spawn(&r, g_bin, args) == 0 && raw_hello(&r, hello) == 0, "jobs: spawn");
        for (i = 0; i < 5; i++) {
            snprintf(src, sizeof src, "pie\n  \"a\": %d\n  \"b\": 1\n", i + 2);
            expect(raw_size(&r, (uint32_t)(1 + i), src, &sz), "jobs: diagram");
        }
        expect(stat_of(&r, 9, "starts") == 3 && stat_of(&r, 10, "recycles") == 2,
               "jobs: --recycle-jobs 2 restarts the engine every two diagrams");
        raw_close(&r);
    }
}

/* A pack whose js:mermaid bytes changed (and whose FNV trailer was fixed
 * up so the pack itself opens): the helper refuses the bytecode. */
static uint64_t fnv64(const uint8_t *p, size_t n) {
    uint64_t h = 1469598103934665603ull;
    size_t i;
    for (i = 0; i < n; i++) {
        h ^= p[i];
        h *= 1099511628211ull;
    }
    return h;
}

static void test_pack_hash(void) {
    size_t n, o = 12;
    uint8_t *b = slurp(g_pack, &n);
    uint32_t cnt, i;
    int done = 0;
    if (!b || n < 20) {
        expect(0, "pack hash: read the pack");
        free(b);
        return;
    }
    memcpy(&cnt, b + 8, 4);
    for (i = 0; i < cnt && o + 2 <= n; i++) {
        uint16_t nl;
        uint32_t rl, cl;
        memcpy(&nl, b + o, 2);
        o += 2;
        if (o + nl + 8 > n) break;
        if (nl == 10 && memcmp(b + o, "js:mermaid", 10) == 0) {
            memcpy(&rl, b + o + nl, 4);
            memcpy(&cl, b + o + nl + 4, 4);
            /* one bit in the middle of the compressed bytecode */
            b[o + nl + 8 + cl / 2] ^= 0x10;
            done = 1;
            (void)rl;
        }
        memcpy(&cl, b + o + nl + 4, 4);
        o += nl + 8 + cl;
    }
    expect(done, "pack hash: js:mermaid in the pack");
    if (done) {
        uint64_t h = fnv64(b, n - 8);
        FILE *fp;
        memcpy(b + n - 8, &h, 8);
        fp = fopen("testdata/generated/mm_tampered.pack", "wb");
        if (fp) {
            fwrite(b, 1, n, fp);
            fclose(fp);
        }
        {
            static char *args[] = {"--pack", "testdata/generated/mm_tampered.pack", NULL};
            Raw r;
            uint32_t hello[3];
            char msg[400];
            CrReply h2;
            uint8_t *p;
            static const char svg[] =
                "<svg xmlns='http://www.w3.org/2000/svg' width='4' height='4'/>";
            CrReq q;
            expect(raw_spawn(&r, g_bin, args) == 0 && raw_hello(&r, hello) == 0,
                   "pack hash: the tampered pack opens (fonts)");
            expect(raw_err(&r, 1, 10000, 150, k_pie, msg, sizeof msg, 20000) == CR_E_ENGINE &&
                       strstr(msg, "does not match"),
                   "pack hash: bytecode that is not this build's is refused before QuickJS");
            memset(&q, 0, sizeof q);
            q.magic = CR_MAGIC_REQ;
            q.id = 2;
            q.kind = CR_KIND_SVG;
            q.flags = CR_F_SIZE_ONLY;
            q.len = sizeof svg - 1;
            if (send(r.fd, &q, sizeof q, MSG_NOSIGNAL) > 0 &&
                send(r.fd, svg, sizeof svg - 1, MSG_NOSIGNAL) > 0)
                expect(raw_frame(&r, &h2, &p, 5000) == 0 && h2.type == CR_R_SIZE,
                       "pack hash: SVG still renders");
            else
                expect(0, "pack hash: send");
            free(p);
            raw_close(&r);
        }
    }
    free(b);
}

/* ---- the editor's client: slot 1 ------------------------------------------- */

static void test_client(void) {
    RtxSvgCfg c;
    RtxSvgStats s0, s1, v0;
    float w = 0, h = 0;
    uint8_t *px = NULL, *pl;
    size_t n;
    char msg[400], big[16384];
    int rc, i;
    size_t k = 0;
    double t0;
    cfg_mm(&c);
    setenv("RTX_RENDER_BIN", g_bin, 1);
    rtx_svg_shutdown();
    rtx_svg_forget_memory();
    rtx_render_stats(RTX_RENDER_MERMAID, &s0);
    expect(s0.pid == 0, "client: no Mermaid helper before the first diagram");
    pl = payload(k_light, k_pie, &n);
    t0 = now_ms();
    rc = rtx_mermaid_size(pl, n, &c, NULL, &w, &h, msg, sizeof msg);
    rtx_render_stats(RTX_RENDER_MERMAID, &s1);
    rtx_render_stats(RTX_RENDER_SVG, &v0);
    expect(rc == RTX_SVG_OK && w > 100 && h > 100, "client: pie size");
    expect(s1.spawns == s0.spawns + 1 && s1.pid > 0 && v0.pid == 0,
           "client: the Mermaid slot spawned, the SVG slot did not");
    printf("mermaid_smoke: client: spawn-to-ready %.1f ms, first pie %.0f ms\n",
           s1.last_ready_ms, now_ms() - t0);
    rc = rtx_mermaid_render(pl, n, &c, (uint32_t)w, (uint32_t)h, NULL, &px, msg, sizeof msg);
    expect(rc == RTX_SVG_OK && px, "client: pie pixels");
    free(px);
    px = NULL;
    {
        static const char svg[] = "<svg xmlns='http://www.w3.org/2000/svg' width='8' height='4'/>";
        RtxSvgCfg sc = c;
        rc = rtx_svg_size((const uint8_t *)svg, sizeof svg - 1, &sc, NULL, &w, &h);
        rtx_render_stats(RTX_RENDER_SVG, &v0);
        rtx_render_stats(RTX_RENDER_MERMAID, &s0);
        expect(rc == RTX_SVG_OK && v0.pid > 0 && s0.pid > 0 && v0.pid != s0.pid,
               "client: SVG and Mermaid run in two helper processes");
    }
    free(pl);
    /* Messages: a parse error, the node cap. */
    pl = payload(k_light, "flowchart TD\n  A -->\n  ((( B\n", &n);
    rc = rtx_mermaid_size(pl, n, &c, NULL, &w, &h, msg, sizeof msg);
    expect(rc == RTX_SVG_ESCRIPT && strstr(msg, "Parse error"), "client: parse error message");
    free(pl);
    k = (size_t)snprintf(big, sizeof big, "flowchart LR\n");
    for (i = 0; i < 160; i++) k += (size_t)snprintf(big + k, sizeof big - k, "  a%d --> b%d\n", i, i);
    pl = payload(k_light, big, &n);
    rc = rtx_mermaid_size(pl, n, &c, NULL, &w, &h, msg, sizeof msg);
    expect(rc == RTX_SVG_ELARGE &&
               strcmp(msg, "diagram too large to render (320 nodes, limit 150)") == 0,
           "client: node cap message");
    {
        RtxSvgCfg more = c;
        more.node_max = 400;
        rtx_svg_forget_memory();
        rc = rtx_mermaid_size(pl, n, &more, NULL, &w, &h, msg, sizeof msg);
        expect(rc == RTX_SVG_OK, "client: the cap is a setting (400 lets 320 through)");
    }
    free(pl);
    /* A hung helper (the C side, not the script): the editor kills it at
     * the budget + its grace, and the next diagram respawns. */
    setenv("RTX_RENDER_BIN", g_selftest, 1);
    rtx_svg_shutdown();
    {
        RtxSvgCfg quick = c;
        quick.timeout_ms = 300;
        pl = payload(k_light, "<!--cr-selftest:hang-->pie\n  \"x\": 1\n", &n);
        rtx_render_stats(RTX_RENDER_MERMAID, &s0);
        t0 = now_ms();
        rc = rtx_mermaid_size(pl, n, &quick, NULL, &w, &h, msg, sizeof msg);
        rtx_render_stats(RTX_RENDER_MERMAID, &s1);
        expect(rc == RTX_SVG_ETIMEOUT && s1.kills == s0.kills + 1 && s1.pid == 0,
               "client: a hung helper is killed past its budget");
        expect(now_ms() - t0 < 4500, "client: ... soon after (budget + grace)");
        free(pl);
        pl = payload(k_light, k_pie, &n);
        rtx_svg_forget_memory();
        rc = rtx_mermaid_size(pl, n, &c, NULL, &w, &h, msg, sizeof msg);
        rtx_render_stats(RTX_RENDER_MERMAID, &s0);
        expect(rc == RTX_SVG_OK && s0.spawns == s1.spawns + 1, "client: the next diagram respawns");
        free(pl);
        /* The engine's own interrupt: a clean error, the same helper. */
        pl = payload(k_light, "%%cr-selftest:jsloop", &n);
        quick.timeout_ms = 400;
        rc = rtx_mermaid_size(pl, n, &quick, NULL, &w, &h, msg, sizeof msg);
        rtx_render_stats(RTX_RENDER_MERMAID, &s1);
        expect(rc == RTX_SVG_ETIMEOUT && s1.pid == s0.pid && s1.kills == s0.kills,
               "client: an endless script ends in the engine, the helper lives");
        free(pl);
    }
    setenv("RTX_RENDER_BIN", g_bin, 1);
    rtx_svg_shutdown();
}

static void test_disk_cache(void) {
    RtxSvgCfg c;
    RtxSvgStats s0, s1;
    float w = 0, h = 0, w2 = 0, h2 = 0;
    uint8_t *a = NULL, *b = NULL, *pl;
    size_t n, sn;
    char msg[256];
    uint8_t *src = slurp("testdata/mermaid/sequence.mmd", &sn);
    if (system("rm -rf testdata/generated/mmcache && mkdir -p testdata/generated/mmcache") != 0)
        return;
    cfg_mm(&c);
    c.cache_dir = "testdata/generated/mmcache";
    c.cache_max = 8u << 20;
    pl = payload(k_light, (const char *)src, &n);
    rtx_svg_forget_memory();
    expect(rtx_mermaid_size(pl, n, &c, NULL, &w, &h, msg, sizeof msg) == RTX_SVG_OK, "cache: size");
    expect(rtx_mermaid_render(pl, n, &c, (uint32_t)w, (uint32_t)h, NULL, &a, msg, sizeof msg) ==
               RTX_SVG_OK,
           "cache: pixels");
    /* A later session with no helper at all: layout and paint from disk. */
    rtx_svg_shutdown();
    rtx_svg_forget_memory();
    setenv("RTX_RENDER_BIN", "/nonexistent/cctext-render", 1);
    rtx_render_stats(RTX_RENDER_MERMAID, &s0);
    expect(rtx_mermaid_size(pl, n, &c, NULL, &w2, &h2, msg, sizeof msg) == RTX_SVG_OK && w2 == w &&
               h2 == h,
           "cache: the size from disk, no helper");
    expect(rtx_mermaid_render(pl, n, &c, (uint32_t)w, (uint32_t)h, NULL, &b, msg, sizeof msg) ==
                   RTX_SVG_OK &&
               b && memcmp(a, b, (size_t)(uint32_t)w * (uint32_t)h * 4) == 0,
           "cache: identical pixels from disk");
    rtx_render_stats(RTX_RENDER_MERMAID, &s1);
    expect(s1.disk_size_hits == s0.disk_size_hits + 1 && s1.disk_px_hits == s0.disk_px_hits + 1 &&
               s1.spawns == s0.spawns,
           "cache: hits counted, nothing spawned");
    free(pl);
    /* Another theme is another key: not in the cache. */
    pl = payload("{\"theme\":\"dark\"}", (const char *)src, &n);
    expect(rtx_mermaid_size(pl, n, &c, NULL, &w2, &h2, msg, sizeof msg) == RTX_SVG_ENONE,
           "cache: the key holds the theme");
    setenv("RTX_RENDER_BIN", g_bin, 1);
    rtx_svg_shutdown();
    free(pl);
    free(a);
    free(b);
    free(src);
}

/* ---- the seven types: our references, Chromium's structure ---------------- */

/* Premultiplied RGBA over white -> 8-bit grey. */
static void to_grey_white(const uint8_t *px, uint32_t w, uint32_t h, int premul, uint8_t *out) {
    size_t i, npx = (size_t)w * h;
    for (i = 0; i < npx; i++) {
        const uint8_t *p = px + i * 4;
        int a = p[3], r, g, b;
        if (premul) {
            r = p[0] + 255 - a;
            g = p[1] + 255 - a;
            b = p[2] + 255 - a;
        } else {
            r = (p[0] * a + 255 * (255 - a)) / 255;
            g = (p[1] * a + 255 * (255 - a)) / 255;
            b = (p[2] * a + 255 * (255 - a)) / 255;
        }
        out[i] = (uint8_t)((r * 299 + g * 587 + b * 114) / 1000);
    }
}

/* Ink map: 255 - grey, averaged over a G x G grid of the picture. */
#define INK_G 16
static void ink_map(const uint8_t *grey, uint32_t w, uint32_t h, double *out) {
    uint32_t i, j, x, y;
    for (j = 0; j < INK_G; j++)
        for (i = 0; i < INK_G; i++) {
            uint32_t y0 = j * h / INK_G, y1 = (j + 1) * h / INK_G, x0 = i * w / INK_G,
                     x1 = (i + 1) * w / INK_G;
            double s = 0;
            size_t c = 0;
            if (y1 <= y0) y1 = y0 + 1;
            if (x1 <= x0) x1 = x0 + 1;
            for (y = y0; y < y1 && y < h; y++)
                for (x = x0; x < x1 && x < w; x++) {
                    s += 255.0 - grey[(size_t)y * w + x];
                    c++;
                }
            out[j * INK_G + i] = c ? s / (double)c : 0;
        }
}

static double corr(const double *a, const double *b, int n) {
    double ma = 0, mb = 0, sab = 0, saa = 0, sbb = 0;
    int i;
    for (i = 0; i < n; i++) {
        ma += a[i];
        mb += b[i];
    }
    ma /= n;
    mb /= n;
    for (i = 0; i < n; i++) {
        sab += (a[i] - ma) * (b[i] - mb);
        saa += (a[i] - ma) * (a[i] - ma);
        sbb += (b[i] - mb) * (b[i] - mb);
    }
    return saa > 0 && sbb > 0 ? sab / sqrt_d(saa * sbb) : 0;
}

static void test_types(void) {
    RtxSvgCfg c;
    RtxImgLimits lim;
    int t;
    cfg_mm(&c);
    rtx_img_limits_default(&lim);
    rtx_svg_forget_memory();
    for (t = 0; k_types[t]; t++) {
        char p[256], msg[400];
        size_t sn, rn, cn, n;
        uint8_t *src, *ref, *chr, *pl, *px = NULL, *cpx = NULL;
        float w = 0, h = 0, cw = 0, chh = 0;
        RtxImgBmp want;
        RtxImgInfo wi;
        int rc;
        double t0, t_first, t_warm;
        snprintf(p, sizeof p, "testdata/mermaid/%s.mmd", k_types[t]);
        src = slurp(p, &sn);
        snprintf(p, sizeof p, "testdata/mermaid/ref/%s.png", k_types[t]);
        ref = slurp(p, &rn);
        snprintf(p, sizeof p, "testdata/mermaid/chromium/%s.nohtml.svg", k_types[t]);
        chr = slurp(p, &cn);
        if (!src || !ref || !chr) {
            snprintf(msg, sizeof msg, "types %s: fixtures", k_types[t]);
            expect(0, msg);
            free(src);
            free(ref);
            free(chr);
            continue;
        }
        pl = payload(k_light, (const char *)src, &n);
        t0 = now_ms();
        rc = rtx_mermaid_size(pl, n, &c, NULL, &w, &h, msg, sizeof msg);
        t_first = now_ms() - t0;
        if (rc == RTX_SVG_OK)
            rc = rtx_mermaid_render(pl, n, &c, ceilu(w), ceilu(h), NULL, &px,
                                    msg, sizeof msg);
        snprintf(p, sizeof p, "types %s: renders (%d %s)", k_types[t], rc, msg);
        expect(rc == RTX_SVG_OK && px, p);
        free(pl);
        {
            /* warm: the same diagram, another source byte (a comment) */
            char *s2 = (char *)malloc(sn + 32);
            float w2, h2;
            snprintf(s2, sn + 32, "%s\n%%%% warm\n", (const char *)src);
            pl = payload(k_light, s2, &n);
            t0 = now_ms();
            (void)rtx_mermaid_size(pl, n, &c, NULL, &w2, &h2, msg, sizeof msg);
            t_warm = now_ms() - t0;
            free(pl);
            free(s2);
        }
        rc = rtx_img_decode(ref, rn, &lim, 0, 0, RTX_IMG_PIX_RGBA, 1, NULL, &want, &wi);
        if (rc == RTX_IMG_OK && px) {
            uint32_t pw = ceilu(w), ph = ceilu(h);
            uint32_t mw = pw < want.w ? pw : want.w, mh = ph < want.h ? ph : want.h, x, y;
            size_t bad = 0;
            uint8_t *g1 = (uint8_t *)malloc((size_t)pw * ph), *g2 = (uint8_t *)malloc((size_t)want.w * want.h);
            to_grey_white(px, pw, ph, 1, g1);
            to_grey_white(want.px, want.w, want.h, 0, g2);
            if (getenv("MM_DUMP")) {
                /* MM_DUMP=1: ours and the reference as PGM (debugging). */
                FILE *df;
                snprintf(msg, sizeof msg, "testdata/generated/mm_%s_ours.pgm", k_types[t]);
                df = fopen(msg, "wb");
                if (df) {
                    fprintf(df, "P5 %u %u 255\n", pw, ph);
                    fwrite(g1, 1, (size_t)pw * ph, df);
                    fclose(df);
                }
                snprintf(msg, sizeof msg, "testdata/generated/mm_%s_ref.pgm", k_types[t]);
                df = fopen(msg, "wb");
                if (df) {
                    fprintf(df, "P5 %u %u 255\n", want.w, want.h);
                    fwrite(g2, 1, (size_t)want.w * want.h, df);
                    fclose(df);
                }
            }
            for (y = 0; y < mh; y++)
                for (x = 0; x < mw; x++)
                    if (abs((int)g1[(size_t)y * pw + x] - (int)g2[(size_t)y * want.w + x]) > 24) bad++;
            snprintf(msg, sizeof msg, "types %s: size %ux%u vs the reference %ux%u", k_types[t], pw,
                     ph, want.w, want.h);
            expect(abs((int)pw - (int)want.w) <= 2 && abs((int)ph - (int)want.h) <= 2, msg);
            snprintf(msg, sizeof msg, "types %s: %zu of %u px off the reference (> 1%%)",
                     k_types[t], bad, mw * mh);
            expect(bad * 100 <= (size_t)mw * mh, msg);
            /* Chromium: the same source in a browser (its SVG drawn by us). */
            {
                RtxSvgCfg sc = c;
                double ia[INK_G * INK_G], ib[INK_G * INK_G], r;
                if (rtx_svg_size(chr, cn, &sc, NULL, &cw, &chh) == RTX_SVG_OK &&
                    rtx_svg_render(chr, cn, &sc, ceilu(cw), ceilu(chh), NULL,
                                   &cpx) == RTX_SVG_OK) {
                    uint32_t cpw = ceilu(cw), cph = ceilu(chh);
                    uint8_t *g3 = (uint8_t *)malloc((size_t)cpw * cph);
                    double dw = 100.0 * (w - cw) / cw, dh = 100.0 * (h - chh) / chh;
                    to_grey_white(cpx, cpw, cph, 1, g3);
                    ink_map(g1, pw, ph, ia);
                    ink_map(g3, cpw, cph, ib);
                    r = corr(ia, ib, INK_G * INK_G);
                    snprintf(msg, sizeof msg,
                             "types %s: like Chromium: width %+.1f%% (<= 6%%), height %+.1f%% (<= "
                             "13%%), ink map r %.3f (>= 0.90)",
                             k_types[t], dw, dh, r);
                    expect(abs_d(dw) <= 6.0 && abs_d(dh) <= 13.0 && r >= 0.90, msg);
                    printf("mermaid_smoke: %-10s %4ux%-4u first %4.0f ms warm %4.0f ms  %5zu px "
                           "off ref  vs Chromium %+5.1f%% x %+5.1f%% r %.3f\n",
                           k_types[t], pw, ph, t_first, t_warm, bad, dw, dh, r);
                    free(g3);
                } else {
                    snprintf(msg, sizeof msg, "types %s: Chromium's SVG renders", k_types[t]);
                    expect(0, msg);
                }
            }
            free(g1);
            free(g2);
            rtx_img_bmp_free(&want);
        } else {
            snprintf(msg, sizeof msg, "types %s: reference PNG decodes", k_types[t]);
            expect(0, msg);
        }
        free(px);
        free(cpx);
        free(src);
        free(ref);
        free(chr);
    }
}

/* Dark and light: the same source, the other theme's colours. */
static void test_themes(void) {
    RtxSvgCfg c;
    uint8_t *pl, *a = NULL, *b = NULL;
    size_t n, sn, i;
    float w = 0, h = 0;
    char msg[256];
    uint8_t *src = slurp("testdata/mermaid/flowchart.mmd", &sn);
    double la = 0, lb = 0, cov = 0;
    cfg_mm(&c);
    pl = payload(k_light, (const char *)src, &n);
    if (rtx_mermaid_size(pl, n, &c, NULL, &w, &h, msg, sizeof msg) == RTX_SVG_OK)
        (void)rtx_mermaid_render(pl, n, &c, ceilu(w), ceilu(h), NULL, &a, msg,
                                 sizeof msg);
    free(pl);
    pl = payload("{\"theme\":\"dark\",\"themeVariables\":{\"darkMode\":true,\"background\":"
                 "\"#18181c\",\"primaryColor\":\"#2a2d3a\",\"mainBkg\":\"#2a2d3a\","
                 "\"primaryTextColor\":\"#dcdce0\"}}",
                 (const char *)src, &n);
    if (rtx_mermaid_size(pl, n, &c, NULL, &w, &h, msg, sizeof msg) == RTX_SVG_OK)
        (void)rtx_mermaid_render(pl, n, &c, ceilu(w), ceilu(h), NULL, &b, msg,
                                 sizeof msg);
    free(pl);
    expect(a && b, "themes: both render");
    if (a && b) {
        /* mean luminance of the opaque (node) pixels */
        size_t na = 0, nb = 0, npx = (size_t)ceilu(w) * ceilu(h);
        for (i = 0; i < npx; i++) {
            if (a[i * 4 + 3] == 255) {
                la += (a[i * 4] * 299 + a[i * 4 + 1] * 587 + a[i * 4 + 2] * 114) / 1000.0;
                na++;
            }
            if (b[i * 4 + 3] == 255) {
                lb += (b[i * 4] * 299 + b[i * 4 + 1] * 587 + b[i * 4 + 2] * 114) / 1000.0;
                nb++;
            }
        }
        la = na ? la / (double)na : 0;
        lb = nb ? lb / (double)nb : 0;
        cov = (double)nb / (double)npx;
        snprintf(msg, sizeof msg, "themes: light nodes (%.0f) are light, dark nodes (%.0f) dark",
                 la, lb);
        expect(la > 180 && lb < 90 && cov > 0.02, msg);
        {
            /* the dark fill #2a2d3a is what the node boxes are */
            size_t fill = 0;
            for (i = 0; i < npx; i++)
                if (abs(b[i * 4] - 0x2a) < 6 && abs(b[i * 4 + 1] - 0x2d) < 6 &&
                    abs(b[i * 4 + 2] - 0x3a) < 6 && b[i * 4 + 3] == 255)
                    fill++;
            expect(fill > 1000, "themes: themeVariables reach the drawing (primaryColor)");
        }
    }
    free(a);
    free(b);
    free(src);
}

/* ---- the Rich layout ------------------------------------------------------- */

static double px_meas(void *ctx, char[:] bytes, RtxStyle style, RtxSectionKind sec) {
    (void)ctx;
    (void)style;
    (void)sec;
    return 8.0 * (double)bytes.len;
}

static double px_lh(void *ctx, RtxStyle style, RtxSectionKind sec) {
    (void)ctx;
    (void)style;
    (void)sec;
    return 18.0;
}

static double cell_meas(void *ctx, char[:] bytes, RtxStyle style, RtxSectionKind sec) {
    (void)ctx;
    (void)style;
    (void)sec;
    return (double)bytes.len;
}

static double cell_lh(void *ctx, RtxStyle style, RtxSectionKind sec) {
    (void)ctx;
    (void)style;
    (void)sec;
    return 1.0;
}

#define MDIR "testdata/generated/mmdoc"

static const char g_doc[] =
    "# Diagrams\n"
    "\n"
    "Before.\n"
    "\n"
    "```mermaid\n"
    "pie title Pets\n"
    "  \"Dogs\": 3\n"
    "  \"Cats\": 2\n"
    "```\n"
    "\n"
    "Between.\n"
    "\n"
    "```mermaid\n"
    "flowchart LR\n"
    "  A --> B\n"
    "```\n"
    "\n"
    "```python\n"
    "print('not a diagram')\n"
    "```\n";

static size_t off_of(const char *needle) {
    const char *p = strstr(g_doc, needle);
    return p ? (size_t)(p - g_doc) : 0;
}

static int row_starting(RtxLayout *L, size_t off) {
    size_t i;
    for (i = 0; i < L->rows.len; i++)
        if (L->rows.data[i].byte_start == off) return (int)i;
    return -1;
}

static void settle(void) {
    int k;
    for (k = 0; k < 4; k++) rtx_img_finish();
}

static void test_layout(void) {
    char cwd[512], path[700];
    FILE *fp;
    RtxImgLimits *lim = rtx_img_limits();
    RtxSvgStats s0, s1;
    size_t f1 = off_of("```mermaid\npie"), f2 = off_of("```mermaid\nflowchart");
    size_t pie_body = off_of("pie title"), dogs = off_of("  \"Dogs\"");
    rtx_img_reset();
    setenv("RTX_RENDER_BIN", g_bin, 1);
    rtx_svg_shutdown();
    rtx_svg_forget_memory();
    lim->svg_cache_max = 0; /* no disk cache: prove the helper path */
    if (system("rm -rf " MDIR " && mkdir -p " MDIR "/.git") != 0) return;
    if (!getcwd(cwd, sizeof cwd)) return;
    snprintf(path, sizeof path, "%s/" MDIR "/doc.md", cwd);
    fp = fopen(path, "wb");
    if (!fp) return;
    fwrite(g_doc, 1, sizeof g_doc - 1, fp);
    fclose(fp);
    {
        @errhandler(CCError e) {
            fprintf(stderr, "error: %s\n", e.message ? e.message : "?");
            fails++;
            return;
        }
        RtxDoc d = {0} @destroy;
        RtxLayout R = {0} @destroy;
        RtxMeasure pm = {0}, cm = {0};
        const RtxImgRec *rec;
        RtxImgRec keep;
        size_t rows_hidden;
        double h0;
        pm.measure = px_meas;
        pm.line_height = px_lh;
        cm.measure = cell_meas;
        cm.line_height = cell_lh;
        d.from_path(cc_slice_cstr(path)) !>;
        R.rich = 1;
        R.wrap = 1;
        R.doc(&d, &pm, 600.0) !>;
        expect(R.mm_on && R.img_on, "layout: Mermaid fences seen");
        rec = rtx_layout_img_rec(&R, f1);
        expect(rec && rec->mm && !rec->revealed && rec->lo == f1, "layout: the fence is a picture row");
        if (rec) expect(rec->h == 36.0 && rec->w == 300.0, "layout: a small box while it renders");
        expect(row_starting(&R, pie_body) < 0 && row_starting(&R, dogs) < 0,
               "layout: the fence's other lines lay out nothing");
        expect(rtx_layout_img_rec(&R, off_of("```python")) == NULL, "layout: a python fence is code");
        rows_hidden = R.rows.len;
        settle();
        expect(rtx_img_layout_changed(), "layout: the sizes arrived");
        R.doc(&d, &pm, 600.0) !>;
        rec = rtx_layout_img_rec(&R, f1);
        expect(rec && rec->state == RTX_IMG_S_INFO && rec->w > 300 && rec->h > 200 &&
                   !rec->mm_stale,
               "layout: the pie's box from its size");
        h0 = rec ? rec->h : 0;
        expect(R.rows.len == rows_hidden, "layout: still one row per fence");
        /* Pixels for the box (what a painter asks), then idle. */
        if (rec) {
            RtxImgSrc s;
            RtxImgView v;
            rtx_img_src_mermaid_key(rec->mm_h, rec->mm_n, rec->mm_theme, &s);
            rtx_img_want(&s, (uint32_t)rec->w, (uint32_t)rec->h, &v);
            settle();
            rtx_img_want(&s, (uint32_t)rec->w, (uint32_t)rec->h, &v);
            expect(v.state == RTX_IMG_S_OK && v.bmp && v.bmp->w == (uint32_t)rec->w,
                   "layout: the painter's bitmap at the box");
            expect(!rtx_img_busy() && !rtx_img_pump() && !rtx_img_pump(),
                   "idle: nothing queued, nothing changes once settled");
        }
        /* The caret inside the fence: its source is text, the diagram under
         * the closing line. */
        expect(rtx_layout_reveal(&R, &d, dogs, dogs), "reveal: the caret in the fence reveals");
        R.doc(&d, &pm, 600.0) !>;
        expect(row_starting(&R, dogs) >= 0, "reveal: the source lines are rows");
        {
            size_t close = off_of("```\n\nBetween");
            rec = rtx_layout_img_rec(&R, close);
            expect(rec && rec->mm && rec->revealed && rec->h == h0,
                   "reveal: the diagram under the closing line, the same box");
        }
        /* An edit inside the fence: the old diagram stays up (stale) with
         * its box until the new render has a size. */
        memcpy(&keep, rtx_layout_img_rec(&R, off_of("```\n\nBetween")), sizeof keep);
        d.replace(off_of("3\n  \"Cats\""), 1, cc_slice_cstr("5")) !>;
        d.reparse_edit(d.last_off, d.last_markup) !>;
        rtx_layout_reveal(&R, &d, dogs, dogs);
        R.doc(&d, &pm, 600.0) !>;
        rec = NULL;
        {
            size_t i;
            for (i = 0; i < R.img_recs.len; i++)
                if (R.img_recs.data[i].mm && R.img_recs.data[i].lo == f1) rec = &R.img_recs.data[i];
        }
        expect(rec && rec->mm_prev && rec->mm_stale && rec->h == keep.h &&
                   (rec->mm_h != keep.mm_h) && rec->mm_prev_h == keep.mm_h,
               "stale: the new source keeps the old diagram and its box");
        settle();
        rtx_layout_reveal(&R, &d, dogs, dogs);
        R.doc(&d, &pm, 600.0) !>;
        rec = NULL;
        {
            size_t i;
            for (i = 0; i < R.img_recs.len; i++)
                if (R.img_recs.data[i].mm && R.img_recs.data[i].lo == f1) rec = &R.img_recs.data[i];
        }
        expect(rec && !rec->mm_stale && rec->state == RTX_IMG_S_INFO,
               "stale: the new diagram replaces it once sized");
        /* A source that does not parse: stale with the old picture. */
        d.replace(pie_body, 3, cc_slice_cstr("pye")) !>;
        d.reparse_edit(d.last_off, d.last_markup) !>;
        rtx_layout_reveal(&R, &d, dogs, dogs);
        R.doc(&d, &pm, 600.0) !>;
        settle();
        R.doc(&d, &pm, 600.0) !>;
        rec = NULL;
        {
            size_t i;
            for (i = 0; i < R.img_recs.len; i++)
                if (R.img_recs.data[i].mm && R.img_recs.data[i].lo == f1) rec = &R.img_recs.data[i];
        }
        expect(rec && rec->state == RTX_IMG_S_ERR && rec->mm_prev && rec->mm_stale,
               "stale: a parse error keeps the last good diagram");
        if (rec) {
            RtxImgSrc s;
            RtxImgView v;
            rtx_img_src_mermaid_key(rec->mm_h, rec->mm_n, rec->mm_theme, &s);
            rtx_img_info(&s, &v);
            expect(v.state == RTX_IMG_S_ERR && v.msg && strstr(v.msg, "No diagram type"),
                   "stale: the error's message reaches the painter");
        }
        d.replace(pie_body, 3, cc_slice_cstr("pie")) !>;
        d.reparse_edit(d.last_off, d.last_markup) !>;
        /* Theme change: only what is laid out re-renders. The window holds
         * the first fence only. */
        rtx_layout_reveal(&R, &d, 0, 0);
        R.lines(&d, &pm, 600.0, 0, 9) !>;
        settle();
        rtx_render_stats(RTX_RENDER_MERMAID, &s0);
        {
            RtxMmTheme t = *rtx_img_mm_theme();
            t.accent[0] = 200;
            t.accent[1] = 80;
            rtx_img_mm_theme_set(&t);
            expect(rtx_img_layout_changed(), "theme: a change asks for a relayout");
            R.lines(&d, &pm, 600.0, 0, 9) !>;
            rec = rtx_layout_img_rec(&R, f1);
            expect(rec && rec->mm_stale && rec->mm_prev, "theme: the old picture stays up meanwhile");
            settle();
            rtx_render_stats(RTX_RENDER_MERMAID, &s1);
            expect(s1.requests == s0.requests + 1,
                   "theme: one diagram re-rendered (the visible one), not the one below");
            R.lines(&d, &pm, 600.0, 0, 9) !>;
            rec = rtx_layout_img_rec(&R, f1);
            expect(rec && !rec->mm_stale && rec->state == RTX_IMG_S_INFO,
                   "theme: the re-rendered diagram");
        }
        /* The terminal: cells. */
        rtx_img_cells_set(1, 8, 16, 30);
        R.doc(&d, &cm, 80.0) !>;
        rec = rtx_layout_img_rec(&R, f1);
        expect(rec && rec->mm && rec->h >= 5 && rec->h <= 30 && rec->w <= 80 &&
                   rec->h == (double)(int)rec->h,
               "cells: the diagram's box in whole cells");
        rec = rtx_layout_img_rec(&R, f2);
        expect(rec && rec->mm, "cells: the second fence too");
        rtx_img_cells_set(0, 8, 16, 30);
        /* Off: fences are code. */
        lim->mermaid = 0;
        R.doc(&d, &pm, 600.0) !>;
        expect(!R.mm_on && rtx_layout_img_rec(&R, f1) == NULL && row_starting(&R, pie_body) >= 0,
               "setting: mermaid off lays fences out as text");
        lim->mermaid = 1;
        /* Bytes untouched by any of it. */
        {
            char buf[4096];
            size_t got = d.read_at(0, cc_slice_from_buffer(buf, sizeof buf)) !>;
            buf[got] = 0;
            expect(strstr(buf, "```mermaid\npie title Pets\n  \"Dogs\": 5\n  \"Cats\": 2\n```") != NULL,
                   "bytes: the document is its text");
        }
    }
    rtx_svg_shutdown();
    rtx_img_reset();
}

int main(void) {
    char cwd[512];
    rtx_safe_test_isol();
    if (!getcwd(cwd, sizeof cwd)) return 1;
    snprintf(g_bin, sizeof g_bin, "%s/bin/cctext-render", cwd);
    snprintf(g_selftest, sizeof g_selftest, "%s/bin/cctext-render-selftest", cwd);
    snprintf(g_pack, sizeof g_pack, "%s/bin/cctext-render.pack", cwd);
    if (access(g_bin, X_OK) != 0 || access(g_selftest, X_OK) != 0) {
        fprintf(stderr, "mermaid_smoke: bin/cctext-render missing (./make.shcc @cctext_render)\n");
        return 1;
    }
    if (system("mkdir -p testdata/generated") != 0) return 1;
    setenv("TZ", "UTC", 1);
    test_protocol();
    test_budget_recycle();
    test_pack_hash();
    test_client();
    test_disk_cache();
    test_types();
    test_themes();
    test_layout();
    rtx_svg_shutdown();
    if (fails) {
        fprintf(stderr, "mermaid_smoke: %d failed\n", fails);
        return 1;
    }
    printf("mermaid_smoke: ok\n");
    return 0;
}
