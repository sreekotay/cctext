#!ccc ccs
/*
 * Find throughput (a perf tool, not a smoke).
 *
 *   ./bin/find_perf FILE [NAME]     RESULT lines per query: ms, MB/s, hits
 *   ./bin/find_perf FILE --query Q [OPTS]   one query (OPTS: i w r)
 *                                   (NAME: only queries whose name holds it)
 *
 * Each query: open (not timed), find_set_opt, finish = search to EOF
 * through the dest-live block scan (lanes, stage), best of
 * RTX_PERF_TRIALS (default 5). Queries cover a literal with no hits (pure
 * scan), common literals, ignore case, whole word and regexes.
 */
#include <ccc/std/prelude.cch>
#include <ccc/stdio.cch>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <time.h>
#include "../core/document.cch"
#include "../core/find.cch"

static double perf_ms(void) {
    struct timespec ts;
    if (clock_gettime(CLOCK_MONOTONIC, &ts) != 0) return 0.0;
    return (double)ts.tv_sec * 1000.0 + (double)ts.tv_nsec / 1.0e6;
}

typedef struct {
    const char *name;
    const char *q;
    unsigned opts;
} PerfQ;

static const PerfQ qs[] = {
    {"lit_none", "xylophone", 0},
    {"lit_return", "return", 0},
    {"lit_fn_9999", "fn_9999(", 0},
    {"lit_long_miss", "paragraph that keeps going so an eighty-column pane actually splits this line into two", 0},
    {"lit_e", "e", 0},
    {"icase_none", "Xylophone", RTX_FIND_ICASE},
    {"icase_return", "RETURN", RTX_FIND_ICASE},
    {"word_x", "x", RTX_FIND_WORD},
    {"re_none", "xylo[a-z]+", RTX_FIND_REGEX},
    {"re_fn", "fn_[0-9]+\\(", RTX_FIND_REGEX},
    {"re_int_word", "\\bint\\s+\\w+", RTX_FIND_REGEX},
    {"re_block_num", "Block [0-9]+\\.", RTX_FIND_REGEX},
    {"re_alt", "(?i)(bold|mono|eighty)", RTX_FIND_REGEX},
    {"re_line", "^=== \\w+ ===$", RTX_FIND_REGEX},
    /* Rare hits: throughput stays meaningful on a 1 GiB file (the capped
     * queries above stop at the hit cap). */
    {"re_rare_fn", "fn_99[0-9]9\\(", RTX_FIND_REGEX},
    {"re_rare_word", "\\bxylo\\w*|\\d{12}", RTX_FIND_REGEX},
    {"icase_rare", "FN_9999(", RTX_FIND_ICASE},
    {"icase_exit", "EXIT_failure", RTX_FIND_ICASE},
    {"re_word_pre", "\\bxylo\\w*", RTX_FIND_REGEX},
    {"re_send", "[a-z]+_send\\(", RTX_FIND_REGEX},
    {"re_alt5", "alpha|bravo|charlie|delta|foxtrot", RTX_FIND_REGEX},
    {"re_alt5_icase", "(?i)alpha|bravo|charlie|delta|foxtrot", RTX_FIND_REGEX},
    /* a literal after an unbounded part that may cross a newline (reverse
     * inner); `.*TODO` stays on its line (the line prefilter) */
    {"re_surround", "\\w+\\s+Holmes\\s+\\w+", RTX_FIND_REGEX},
    {"re_null_assign", "[a-z_]+\\s*=\\s*NULL", RTX_FIND_REGEX},
    {"re_todo_line", ".*TODO", RTX_FIND_REGEX},
    {NULL, NULL, 0},
};

int main(int argc, char **argv) {
    const char *src = argc > 1 ? argv[1] : "testdata/generated/large.txt";
    const char *te = getenv("RTX_PERF_TRIALS");
    int trials = te && te[0] ? atoi(te) : 5, t;
    size_t k, n = 0;
    PerfQ one[2] = {{"arg", NULL, 0}, {NULL, NULL, 0}};
    const PerfQ *list = qs;
    if (trials < 1) trials = 1;
    if (argc > 3 && !strcmp(argv[2], "--query")) {
        /* find_perf FILE --query Q [OPTS]: OPTS letters i (ignore case),
         * w (whole word), r (regex) — bench/rg_subtitles.py */
        const char *o = argc > 4 ? argv[4] : "";
        one[0].q = argv[3];
        if (strchr(o, 'i')) one[0].opts |= RTX_FIND_ICASE;
        if (strchr(o, 'w')) one[0].opts |= RTX_FIND_WORD;
        if (strchr(o, 'r')) one[0].opts |= RTX_FIND_REGEX;
        list = one;
        argc = 2;
    }
    for (k = 0; list[k].name; k++) {
        double best = -1.0;
        const PerfQ *q = &list[k];
        if (argc > 2 && !strstr(q->name, argv[2])) continue;
        size_t hits = 0, lng = 0;
        int trunc = 0;
        for (t = 0; t < trials; t++) {
            RtxDoc d = {0} @destroy;
            double t0, t1;
            @errhandler(CCError e) {
                fprintf(stderr, "find_perf: %s\n", e.message ? e.message : "?");
                return 1;
            }
            d.from_path(cc_slice_cstr(src)) !>;
            n = d.len();
            t0 = perf_ms();
            d.find_set_opt(cc_slice_cstr(q->q), q->opts) !>;
            d.find_finish() !>;
            t1 = perf_ms();
            if (best < 0 || t1 - t0 < best) best = t1 - t0;
            hits = d.find.hits.len;
            trunc = d.find.truncated;
            lng = d.find.long_n;
        }
        printf("RESULT op=find_%s bytes=%zu ms=%.3f MBps=%.0f hits=%zu%s long=%zu\n",
               q->name, n, best, best > 0 ? (double)n / 1048576.0 / (best / 1000.0) : 0.0,
               hits, trunc ? " capped" : "", lng);
        fflush(stdout);
    }
    return 0;
}
