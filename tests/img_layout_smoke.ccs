#!ccc ccs
/*
 * Rich layout with images (docs/images.md): picture rows sized from the
 * header, heights stable before and after the pixels decode, the caret
 * on an image's line reveals its source (text rows, the picture below),
 * the terminal's text stand-in `[image: alt WxH]`, and bytes untouched.
 * Marp size hints (docs/slides.md "Images"): `w:` / `h:` in a deck's
 * image alt size its picture row (aspect kept, both: that box, clamped
 * to the pane and image_max_height), in pixels and in cells; outside a
 * deck they are alt text.
 */
#include <ccc/std/prelude.cch>
#include <ccc/stdio.cch>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include "../core/utf8.cch"
#include "../core/document.cch"
#include "../core/layout.cch"
#include "../core/img.cch"

void rtx_safe_test_isol(void);

static int fails = 0;

static void expect(int cond, const char *msg) {
    if (!cond) {
        fprintf(stderr, "FAIL: %s\n", msg);
        fails++;
    }
}

/* cctext-ui-like: 8 px per byte, 18 px lines. */
static double px_meas(void *ctx, char[:] bytes, RtxStyle style, RtxSectionKind sec) {
    (void)ctx;
    (void)style;
    (void)sec;
    return 8.0 * (double)bytes.len;
}

static double px_lh(void *ctx, RtxStyle style, RtxSectionKind sec) {
    (void)ctx;
    (void)style;
    (void)sec;
    return 18.0;
}

/* Terminal: one cell per byte (ASCII fixture), one line. */
static double cell_meas(void *ctx, char[:] bytes, RtxStyle style, RtxSectionKind sec) {
    (void)ctx;
    (void)style;
    (void)sec;
    return (double)bytes.len;
}

static double cell_lh(void *ctx, RtxStyle style, RtxSectionKind sec) {
    (void)ctx;
    (void)style;
    (void)sec;
    return 1.0;
}

#define DIR "testdata/generated/imgdoc"

static const char g_doc[] =
    "# Pictures\n"
    "\n"
    "Some text.\n"
    "\n"
    "![a quad](quad.png)\n"
    "\n"
    "![big one](big.png \"Big\")\n"
    "\n"
    "Inline ![tiny](quad.png) in text.\n"
    "\n"
    "```\n"
    "![not an image](quad.png)\n"
    "```\n";

static size_t off_of(const char *needle) {
    const char *p = strstr(g_doc, needle);
    return p ? (size_t)(p - g_doc) : 0;
}

static double row_h_at(RtxLayout *L, size_t off) {
    size_t r = L->row_of(off);
    return r < L->rows.len ? L->rows.data[r].height : -1;
}


/* Marp size hints: a deck and the same lines in plain Markdown. */
static const char g_deck[] =
    "---\n"
    "marp: true\n"
    "---\n"
    "\n"
    "![w:320](big.png)\n"
    "\n"
    "![h:90](big.png)\n"
    "\n"
    "![w:100 h:50](big.png)\n"
    "\n"
    "![w:2000](big.png)\n"
    "\n"
    "![w:300 h:3000](big.png)\n"
    "\n"
    "![a width:1in](quad.png)\n"
    "\n"
    "![w:auto](big.png)\n";

static const char g_plain[] =
    "# Not a deck\n"
    "\n"
    "![w:320](big.png)\n";

static int write_file(const char *path, const char *s, size_t n) {
    FILE *fp = fopen(path, "wb");
    if (!fp) return 0;
    fwrite(s, 1, n, fp);
    fclose(fp);
    return 1;
}

static const RtxImgRec *rec_of(RtxLayout *L, const char *doc, const char *needle) {
    const char *p = strstr(doc, needle);
    return p ? rtx_layout_img_rec(L, (size_t)(p - doc)) : NULL;
}

static void expect_box(RtxLayout *L, const char *doc, const char *needle, double w, double h,
                       const char *msg) {
    const RtxImgRec *r = rec_of(L, doc, needle);
    if (!r) {
        expect(0, msg);
        return;
    }
    if (r->w != w || r->h != h)
        fprintf(stderr, "  %s: got %gx%g want %gx%g\n", needle, r->w, r->h, w, h);
    expect(r->w == w && r->h == h, msg);
}

static int hint_checks(const char *cwd) {
    char dpath[700], ppath[700];
    double w, h;
    /* The parser: units, decimals, words that are no hint. */
    expect(rtx_img_marp_kw("w:320", 5, &w, &h) && w == 320 && h == 0, "kw: w:320");
    expect(rtx_img_marp_kw("x width:320px  height:2.5in", 27, &w, &h) && w == 320 && h == 240,
           "kw: width px, height in");
    expect(rtx_img_marp_kw("h:12pt", 6, &w, &h) && w == 0 && h == 16, "kw: pt");
    expect(!rtx_img_marp_kw("w:50% h:auto", 12, &w, &h), "kw: % and auto are no hint");
    expect(!rtx_img_marp_kw("W:320 w: wide:3", 15, &w, &h), "kw: not keywords");
    expect(rtx_img_marp_kw("w:10 w:20", 9, &w, &h) && w == 20, "kw: the later word wins");
    rtx_img_marp_size(960, 640, 320, 0, &w, &h);
    expect(w == 320 && h > 213.3 && h < 213.4, "size: w keeps the aspect");
    rtx_img_marp_size(960, 640, 0, 64, &w, &h);
    expect(w == 96 && h == 64, "size: h keeps the aspect");
    rtx_img_marp_size(960, 640, 100, 100, &w, &h);
    expect(w == 100 && h == 100, "size: both stretch");
    snprintf(dpath, sizeof dpath, "%s/" DIR "/deck.md", cwd);
    snprintf(ppath, sizeof ppath, "%s/" DIR "/plain.md", cwd);
    if (!write_file(dpath, g_deck, sizeof g_deck - 1) ||
        !write_file(ppath, g_plain, sizeof g_plain - 1))
        return 0;
    {
        @errhandler(CCError e) {
            fprintf(stderr, "error: %s\n", e.message ? e.message : "?");
            return 0;
        }
        RtxDoc dk = {0} @destroy;
        RtxDoc pl = {0} @destroy;
        RtxLayout R = {0} @destroy;
        RtxLayout P = {0} @destroy;
        RtxMeasure pm = {0}, cm = {0};
        const RtxImgRec *r;
        pm.measure = px_meas;
        pm.line_height = px_lh;
        cm.measure = cell_meas;
        cm.line_height = cell_lh;
        dk.from_path(cc_slice_cstr(dpath)) !>;
        pl.from_path(cc_slice_cstr(ppath)) !>;
        expect(RtxDoc_marp(&dk) && !RtxDoc_marp(&pl), "hint: deck detected");
        R.rich = 1;
        R.wrap = 1;
        P.rich = 1;
        P.wrap = 1;
        R.doc(&dk, &pm, 400.0) !>;
        P.doc(&pl, &pm, 400.0) !>;
        rtx_img_finish();
        R.doc(&dk, &pm, 400.0) !>;
        P.doc(&pl, &pm, 400.0) !>;
        /* big.png is 1200 x 900; the pane leaves 396 px; max_h 480. */
        expect_box(&R, g_deck, "![w:320]", 320, 240, "hint: w:320 in a deck, aspect kept");
        expect_box(&R, g_deck, "![h:90]", 120, 90, "hint: h:90 keeps the aspect");
        expect_box(&R, g_deck, "![w:100 h:50]", 100, 50, "hint: both give the box (stretch)");
        expect_box(&R, g_deck, "![w:2000]", 396, 297, "hint: clamped to the pane width");
        expect_box(&R, g_deck, "![w:300 h:3000]", 48, 480, "hint: clamped to image_max_height");
        expect_box(&R, g_deck, "![a width:1in]", 96, 72, "hint: enlarges a small picture");
        expect_box(&R, g_deck, "![w:auto]", 396, 297, "hint: auto is no hint");
        expect_box(&P, g_plain, "![w:320]", 396, 297, "hint: ignored outside a deck");
        /* Cells: 8 x 16 px per cell, like the presenter's picture code. */
        rtx_img_cells_set(1, 8, 16, 40);
        R.doc(&dk, &cm, 80.0) !>;
        P.doc(&pl, &cm, 80.0) !>;
        r = rec_of(&R, g_deck, "![w:320]");
        expect(r && r->w == 40 && r->h == 15 && r->pw == 320 && r->ph == 240,
               "hint cells: w:320 is 40 x 15 cells");
        r = rec_of(&R, g_deck, "![w:100 h:50]");
        expect(r && r->w == 13 && r->h == 4 && r->pw == 100 && r->ph == 50,
               "hint cells: a stretched box keeps its pixels");
        r = rec_of(&R, g_deck, "![w:2000]");
        expect(r && r->w == 80 && r->pw == 640, "hint cells: clamped to the pane");
        r = rec_of(&P, g_plain, "![w:320]");
        expect(r && r->w == 80 && r->pw == 0 && r->ph == 0, "hint cells: ignored outside a deck");
        rtx_img_cells_set(0, 0, 0, 0);
    }
    return 1;
}

int main(void) {
    char cwd[512], path[700];
    FILE *fp;
    rtx_safe_test_isol();
    if (system("rm -rf " DIR " && mkdir -p " DIR "/.git && cp testdata/img/quad.png "
               "testdata/img/big.png " DIR "/") != 0)
        return 1;
    if (!getcwd(cwd, sizeof cwd)) return 1;
    snprintf(path, sizeof path, "%s/" DIR "/doc.md", cwd);
    fp = fopen(path, "wb");
    if (!fp) return 1;
    fwrite(g_doc, 1, sizeof g_doc - 1, fp);
    fclose(fp);
    {
        @errhandler(CCError e) {
            fprintf(stderr, "error: %s\n", e.message ? e.message : "?");
            return 1;
        }
        RtxDoc d = {0} @destroy;
        RtxLayout R = {0} @destroy;
        RtxMeasure pm = {0}, cm = {0};
        size_t quad = off_of("![a quad]"), big = off_of("![big one]");
        size_t inl = off_of("![tiny]"), fence = off_of("![not an image]");
        const RtxImgRec *rec;
        double hq0, hb0, hq1, hb1;
        size_t nrows_hidden;
        pm.measure = px_meas;
        pm.line_height = px_lh;
        cm.measure = cell_meas;
        cm.line_height = cell_lh;
        d.from_path(cc_slice_cstr(path)) !>;
        R.rich = 1;
        R.wrap = 1;
        R.doc(&d, &pm, 400.0) !>;
        expect(R.has_marks && R.img_on, "layout: images seen in the window");
        /* Before the header: a placeholder box of three lines. */
        rec = rtx_layout_img_rec(&R, quad);
        expect(rec != NULL && !rec->revealed, "layout: picture row for the quad line");
        if (rec) expect(rec->h == 54.0 && row_h_at(&R, quad) == 60.0, "layout: placeholder box");
        expect(rtx_layout_img_rec(&R, inl - 7) == NULL, "layout: inline image is no picture row");
        expect(rtx_layout_img_rec(&R, fence) == NULL, "layout: an image in a fence is text");
        /* Header arrives: the box is the picture's, fitted to the pane. */
        rtx_img_finish();
        expect(rtx_img_layout_changed(), "layout: header change reported");
        R.doc(&d, &pm, 400.0) !>;
        rec = rtx_layout_img_rec(&R, quad);
        expect(rec && rec->w == 32 && rec->h == 24, "layout: quad box is its natural size");
        rec = rtx_layout_img_rec(&R, big);
        expect(rec && rec->w == 396 && rec->h == 297, "layout: big box fits the pane");
        hq0 = row_h_at(&R, quad);
        hb0 = row_h_at(&R, big);
        expect(hq0 == 30.0 && hb0 == 303.0, "layout: rows are box + padding");
        nrows_hidden = R.rows.len;
        /* Pixels: the heights do not move. */
        {
            RtxImgSrc s;
            RtxImgView v;
            rtx_img_resolve(path, "quad.png", 8, &s);
            rtx_img_frame();
            rtx_img_want(&s, 32, 24, &v);
            rtx_img_resolve(path, "big.png", 7, &s);
            rtx_img_want(&s, 396, 297, &v);
            rtx_img_finish();
            rtx_img_want(&s, 396, 297, &v);
            expect(v.state == RTX_IMG_S_OK && v.bmp && v.bmp->w == 396, "layout: big decoded at box size");
            expect(v.bmp && v.bmp->bytes == 396u * 297u * 4u, "layout: only the scaled pixels held");
        }
        R.doc(&d, &pm, 400.0) !>;
        hq1 = row_h_at(&R, quad);
        hb1 = row_h_at(&R, big);
        expect(hq1 == hq0 && hb1 == hb0 && R.rows.len == nrows_hidden,
               "layout: heights stable after decode");
        /* Caret on the image's line: its source shows, the picture below. */
        expect(rtx_layout_reveal(&R, &d, quad + 3, quad + 3), "layout: reveal changes");
        expect(R.reveal_lo <= quad && R.reveal_hi >= quad + strlen("![a quad](quad.png)"),
               "layout: reveal covers the image");
        R.doc(&d, &pm, 400.0) !>;
        rec = rtx_layout_img_rec(&R, quad);
        expect(rec && rec->revealed && rec->text_h == 18.0 && rec->top == 21.0,
               "layout: revealed picture under its source");
        expect(row_h_at(&R, quad) == 18.0 + 24.0 + 6.0, "layout: source row + picture");
        {
            size_t r = R.row_of(quad);
            expect(R.rows.data[r].width >= px_meas(NULL, cc_slice_cstr("![a quad](quad.png)"),
                                                   (RtxStyle){0}, RTX_SEC_MARKUP),
                   "layout: the source text is laid out (no hidden bytes)");
        }
        rtx_layout_reveal(&R, &d, 0, 0);
        R.doc(&d, &pm, 400.0) !>;
        expect(row_h_at(&R, quad) == hq0, "layout: caret away hides the source again");
        /* The terminal: a text stand-in, inline too. */
        R.doc(&d, &cm, 80.0) !>;
        {
            size_t r = R.row_of(inl);
            const char *want = "Inline [image: tiny 32x24] in text.";
            expect(R.rows.data[r].width == (double)strlen(want),
                   "layout: terminal stand-in width");
            r = R.row_of(quad);
            expect(R.rows.data[r].width == (double)strlen("[image: a quad 32x24]"),
                   "layout: terminal stand-in for a picture line");
            expect(rtx_layout_img_rec(&R, quad) == NULL, "layout: no picture rows in cells");
        }
        {
            RtxHintVis hv;
            char line[64];
            size_t n = strlen("![a quad](quad.png)");
            memcpy(line, g_doc + quad, n);
            expect(rtx_layout_hint_vis(&R, &d, quad, line, 0, n, &hv) && hv.skip == n &&
                       hv.gn == strlen("[image: a quad 32x24]") &&
                       memcmp(hv.g, "[image: a quad 32x24]", hv.gn) == 0,
                   "layout: stand-in text");
        }
        /* Bytes stay the truth. */
        {
            CCArena fr = cc_arena_heap(4096);
            char[:] all = d.scratch_span(0, d.len(), fr) !>;
            expect(all.len == sizeof g_doc - 1 && memcmp(all.ptr, g_doc, all.len) == 0,
                   "layout: document bytes unchanged");
            fr.destroy();
        }
    }
    if (!hint_checks(cwd)) fails++;
    rtx_img_reset();
    if (fails) {
        fprintf(stderr, "img_layout_smoke: %d failures\n", fails);
        return 1;
    }
    printf("img_layout_smoke: ok\n");
    return 0;
}
