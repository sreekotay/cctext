#!ccc ccs
/*
 * GFM table classify against testdata/rich/md/tables.md.
 */
#include <ccc/std/prelude.cch>
#include <ccc/stdio.cch>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include "../core/md_table.cch"

static int fails = 0;

static void expect(int cond, const char *msg) {
    if (!cond) {
        fprintf(stderr, "FAIL: %s\n", msg);
        fails++;
    }
}

static char *read_all(const char *path, size_t *out_n) {
    FILE *fp;
    char *buf;
    long sz;
    if (out_n) *out_n = 0;
    fp = fopen(path, "rb");
    if (!fp) return NULL;
    if (fseek(fp, 0, SEEK_END) != 0) {
        fclose(fp);
        return NULL;
    }
    sz = ftell(fp);
    if (sz < 0) {
        fclose(fp);
        return NULL;
    }
    if (fseek(fp, 0, SEEK_SET) != 0) {
        fclose(fp);
        return NULL;
    }
    buf = (char *)malloc((size_t)sz + 1);
    if (!buf) {
        fclose(fp);
        return NULL;
    }
    if (fread(buf, 1, (size_t)sz, fp) != (size_t)sz) {
        free(buf);
        fclose(fp);
        return NULL;
    }
    fclose(fp);
    buf[sz] = 0;
    if (out_n) *out_n = (size_t)sz;
    return buf;
}

static int cell_eq(const char *line, RtxMdCell f, const char *want) {
    size_t n = f.hi - f.lo;
    size_t w = strlen(want);
    return n == w && memcmp(line + f.lo, want, n) == 0;
}

int main(void) {
    const char *path = "testdata/rich/md/tables.md";
    size_t n = 0;
    char *buf = read_all(path, &n);
    const char *hdr, *sep, *esc, *ragged, *t2, *t3, *prose, *fake;
    RtxMdCell cells[8];
    RtxMdTable t;
    size_t nc;

    expect(buf != NULL && n > 0, "read tables.md");
    if (!buf) return 1;

    /* Split: outer pipes dropped; `\|` is content. */
    {
        const char *row = "| Name | Kind | Count |";
        nc = rtx_md_row_split(row, strlen(row), cells, 8);
        expect(nc == 3, "header is 3 cells");
        expect(cell_eq(row, cells[0], " Name "), "cell 0 Name");
        expect(cell_eq(row, cells[1], " Kind "), "cell 1 Kind");
        expect(cell_eq(row, cells[2], " Count "), "cell 2 Count");
    }

    {
        const char *row = "Col A | Col B";
        nc = rtx_md_row_split(row, strlen(row), cells, 8);
        expect(nc == 2, "no outer pipes is 2 cells");
    }

    {
        const char *row = "| delta | pipe \\| escaped | 4 |";
        nc = rtx_md_row_split(row, strlen(row), cells, 8);
        expect(nc == 3, "escaped pipe stays one cell");
        expect(cell_eq(row, cells[1], " pipe \\| escaped "), "escaped pipe content");
    }

    {
        const char *row = "| ragged | long | 7 | extra |";
        nc = rtx_md_row_split(row, strlen(row), cells, 8);
        expect(nc == 4, "overflow row is 4 cells");
    }

    {
        const char *row = "| epsilon | | 5 |";
        nc = rtx_md_row_split(row, strlen(row), cells, 8);
        expect(nc == 3, "empty middle cell still 3");
    }

    {
        const char *row = "|------|:----:|------:|";
        expect(rtx_md_line_is_sep(row, strlen(row)), "align row is sep");
    }
    {
        const char *row = "--- | ---";
        expect(rtx_md_line_is_sep(row, strlen(row)), "sep without outer pipes");
    }
    {
        const char *row = "| Name | Kind | Count |";
        expect(!rtx_md_line_is_sep(row, strlen(row)), "header is not sep");
    }
    {
        const char *row = "| but has no | separator |";
        expect(!rtx_md_line_is_sep(row, strlen(row)), "text row is not sep");
    }

    hdr = strstr(buf, "| Name | Kind | Count |");
    sep = strstr(buf, "|------|:----:|------:|");
    esc = strstr(buf, "pipe \\| escaped");
    ragged = strstr(buf, "| ragged | long | 7 | extra |");
    t2 = strstr(buf, "Col A | Col B");
    t3 = strstr(buf, "| Key | Value |");
    prose = strstr(buf, "single pipe in it");
    fake = strstr(buf, "| looks like | a row |");
    expect(hdr && sep && esc && ragged && t2 && t3 && prose && fake,
           "tables.md landmarks");

    if (hdr && rtx_md_table_at(buf, n, (size_t)(hdr - buf), &t)) {
        expect(t.ncols == 3, "table 1 is 3 columns");
        expect(t.align[0] == RTX_MD_ALIGN_LEFT, "col 0 left");
        expect(t.align[1] == RTX_MD_ALIGN_CENTER, "col 1 center");
        expect(t.align[2] == RTX_MD_ALIGN_RIGHT, "col 2 right");
        expect(t.sep_lo == (size_t)(sep - buf), "table 1 sep at align row");
        expect(t.body_lo == t.sep_hi, "body starts after the sep line");
        expect(ragged && t.hi == (size_t)(ragged - buf) + strlen("| ragged | long | 7 | extra |\n"),
               "table 1 ends after overflow row");
        expect(esc && esc >= buf + t.body_lo && esc < buf + t.hi,
               "escaped-pipe row is a body record");
    } else {
        expect(0, "table 1 at Name header");
    }

    if (t2 && rtx_md_table_at(buf, n, (size_t)(t2 - buf), &t)) {
        expect(t.ncols == 2, "table 2 is 2 columns");
        expect(t.align[0] == RTX_MD_ALIGN_LEFT && t.align[1] == RTX_MD_ALIGN_LEFT,
               "table 2 both left");
        expect(t.lo == (size_t)(t2 - buf), "table 2 starts at Col A");
    } else {
        expect(0, "table 2 at Col A");
    }

    if (t3 && rtx_md_table_at(buf, n, (size_t)(t3 - buf), &t)) {
        expect(t.ncols == 2, "table 3 is 2 columns");
        expect(t.lo == (size_t)(t3 - buf), "table 3 starts after the paragraph");
    } else {
        expect(0, "table 3 at Key header");
    }

    if (prose) {
        size_t at = (size_t)(prose - buf);
        while (at > 0 && buf[at - 1] != '\n') at--;
        expect(!rtx_md_table_at(buf, n, at, &t), "single pipe in prose is not a table");
    }
    if (fake) {
        expect(!rtx_md_table_at(buf, n, (size_t)(fake - buf), &t),
               "pipe rows without a separator are not a table");
    }

    {
        int ntab = 0;
        size_t from = 0;
        while (rtx_md_table_next(buf, n, from, &t)) {
            ntab++;
            from = t.hi;
        }
        expect(ntab == 3, "tables.md has exactly 3 tables");
    }

    {
        const char *row = "| Name | Kind | Count |";
        const char *esc_row = "| delta | pipe \\| escaped | 4 |";
        int col_w[8];
        expect(rtx_md_row_col_at(row, strlen(row), 2, 3) == 0, "N is column 0");
        expect(rtx_md_row_col_at(row, strlen(row), 0, 3) == -1, "leading | is not a cell");
        {
            RtxMdCell ec[8];
            size_t enc = rtx_md_row_split(esc_row, strlen(esc_row), ec, 8);
            expect(enc == 3, "escaped-pipe row still 3 cells");
            expect(rtx_md_disp_cols(esc_row + ec[1].lo, ec[1].hi - ec[1].lo) == 14,
                   "\\| is one display column");
        }
        expect(rtx_md_align_pad(RTX_MD_ALIGN_RIGHT, 5, 1) == 4, "right pad");
        expect(rtx_md_align_pad(RTX_MD_ALIGN_CENTER, 5, 1) == 2, "center pad");
        if (hdr && rtx_md_table_at(buf, n, (size_t)(hdr - buf), &t)) {
            rtx_md_table_widths(buf, &t, col_w, 8);
            expect(col_w[0] == 12, "col 0 is ragged short");
            expect(col_w[1] == 27, "col 1 is the link");
            expect(col_w[2] == 5, "col 2 is Count");
            expect(rtx_md_row_width(col_w, 3) == 48, "header ∪ body width + rails");
            expect(rtx_md_col_origin(col_w, 3, 2) == 42, "Count column origin after rail");
            expect(rtx_md_table_role(&t, t.lo) == RTX_MD_ROLE_HDR, "header role");
            expect(rtx_md_table_role(&t, t.sep_lo) == RTX_MD_ROLE_SEP, "sep role");
            expect(rtx_md_table_role(&t, t.body_lo) == RTX_MD_ROLE_BODY, "body role");
        }
    }

    {
        char row[32];
        char out[32];
        size_t n;
        n = rtx_md_empty_row(2, row, sizeof(row));
        expect(n == 8 && memcmp(row, "|  |  |\n", 8) == 0, "empty 2-col row");
        n = rtx_md_line_add_col("| A | B |", 9, 0, out, sizeof(out));
        expect(n == 12 && memcmp(out, "| A | B |  |", 12) == 0,
               "add body column");
        n = rtx_md_line_add_col("|---|---|", 9, 1, out, sizeof(out));
        expect(n == 13 && memcmp(out, "|---|---|---|", 13) == 0,
               "add sep column");
        n = rtx_md_line_del_col("| A | B | C |", 13, 1, out, sizeof(out));
        expect(n == 9 && memcmp(out, "| A | C |", 9) == 0, "drop middle col");
        n = rtx_md_line_del_col("|---|---|---|", 13, 0, out, sizeof(out));
        expect(n == 9 && memcmp(out, "|---|---|", 9) == 0, "drop sep col 0");
    }

    /* Window cut: header without the separator in the window is leftover. */
    if (hdr && sep) {
        expect(!rtx_md_table_at(buf, (size_t)(sep - buf), (size_t)(hdr - buf), &t),
               "header without sep in window is leftover");
    }

    if (hdr) {
        const char *beta = strstr(buf, "| beta |");
        size_t ho = (size_t)(hdr - buf);
        expect(rtx_md_table_cover(buf, n, ho, &t) && t.lo == ho,
               "cover at header is the table");
        if (beta) {
            size_t bo = (size_t)(beta - buf);
            expect(rtx_md_table_cover(buf, n, bo, &t) && t.lo == ho &&
                       bo >= t.body_lo && bo < t.hi,
                   "cover at a body row walks back to the header");
        }
        expect(!rtx_md_table_cover(buf, n, 0, &t),
               "cover at the title is not a table");
    }

    {
        RtxMdCell lines[8];
        size_t nw = rtx_md_wrap_field("hello world there", 17, 6, lines, 8);
        expect(nw >= 2 && lines[0].hi <= 6, "wrap field soft-breaks");
        nw = rtx_md_wrap_field("abc", 3, 40, lines, 8);
        expect(nw == 1 && lines[0].lo == 0 && lines[0].hi == 3,
               "short cell is one wrap line");
    }

    free(buf);
    if (fails) {
        fprintf(stderr, "%d failure(s)\n", fails);
        return 1;
    }
    printf("md_table_smoke ok\n");
    return 0;
}
