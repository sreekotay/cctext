#!ccc ccs
/*
 * Grammar lex dump / timing (differential + perf tool, not a smoke).
 *
 *   ./bin/tm_dump FILE...          print every run of a full-document lex
 *   ./bin/tm_dump --time FILE...   RESULT lines: full lex ms (min of trials)
 *
 * Dump lines: `start len scope hint_a hint_b planter` per run, after a
 * `== path` header. Two builds (old engine / new engine) diff the output.
 * The document is lexed in RTX_HL_WIN_MAX windows through ensure_hl —
 * the same window face the frame uses — never one body-wide call.
 */
#include <ccc/std/prelude.cch>
#include <ccc/stdio.cch>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <time.h>
#include "../core/document.cch"

static double dump_ms(void) {
    struct timespec ts;
    if (clock_gettime(CLOCK_MONOTONIC, &ts) != 0) return 0.0;
    return (double)ts.tv_sec * 1000.0 + (double)ts.tv_nsec / 1.0e6;
}

static int dump_lex_all(RtxDoc *d) {
    size_t n, off;
    @errhandler(CCError e) {
        fprintf(stderr, "tm_dump: lex: %s\n", e.message ? e.message : "error");
        return 0;
    }
    n = d->len();
    for (off = 0; off < n; off += (size_t)RTX_HL_WIN_MAX) {
        size_t w = n - off;
        if (w > (size_t)RTX_HL_WIN_MAX) w = (size_t)RTX_HL_WIN_MAX;
        d->ensure_hl(rtx_hl_keep(off, w)) !>;
    }
    return 1;
}

static int dump_one(const char *path) {
    RtxDoc d = {0} @destroy;
    size_t k;
    @errhandler(CCError e) {
        fprintf(stderr, "tm_dump: %s: %s\n", path, e.message ? e.message : "open");
        return 0;
    }
    d.from_path(cc_slice_cstr(path)) !>;
    if (!dump_lex_all(&d)) return 0;
    printf("== %s\n", path);
    for (k = 0; k < d.runs.len; k++) {
        const RtxRun *r = &d.runs.data[k];
        const char *s = rtx_scope_name(r->style.scope);
        printf("%zu %zu %s %u %u %u\n", r->start, r->len, s ? s : "-",
               (unsigned)r->hint_a, (unsigned)r->hint_b, (unsigned)r->planter);
    }
    return 1;
}

static int time_one(const char *path, int trials) {
    double best = -1.0;
    size_t runs = 0, bytes = 0;
    int t;
    for (t = 0; t < trials; t++) {
        RtxDoc d = {0} @destroy;
        double t0, t1;
        @errhandler(CCError e) {
            fprintf(stderr, "tm_dump: %s: %s\n", path, e.message ? e.message : "open");
            return 0;
        }
        t0 = dump_ms();
        d.from_path(cc_slice_cstr(path)) !>;
        if (!dump_lex_all(&d)) return 0;
        t1 = dump_ms();
        if (best < 0 || t1 - t0 < best) best = t1 - t0;
        runs = d.runs.len;
        bytes = d.len();
    }
    printf("RESULT file=%s bytes=%zu runs=%zu lex_ms=%.3f\n", path, bytes, runs,
           best);
    fflush(stdout);
    return 1;
}

int main(int argc, char **argv) {
    int i, timing = 0, trials = 5, rc = 0;
    const char *tr = getenv("RTX_PERF_TRIALS");
    if (tr && tr[0]) trials = atoi(tr);
    if (trials < 1) trials = 1;
    for (i = 1; i < argc; i++) {
        if (strcmp(argv[i], "--time") == 0) {
            timing = 1;
            continue;
        }
        if (timing ? !time_one(argv[i], trials) : !dump_one(argv[i])) rc = 1;
    }
    return rc;
}
