/*
 * Terminal boundary: no byte from a file name, a path, or a document
 * reaches the TTY as a control. Filenames with ESC / BEL / C1 CSI, and
 * a body with C1 and invalid bytes, are painted through cctext_draw and
 * the capture must hold none of the injected sequences. Browse names are
 * measured in columns (a wide name is truncated by cells, never mid
 * UTF-8).
 */
#include <ccc/std/prelude.cch>
#include <errno.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include <sys/stat.h>
#include "../core/utf8.cch"
#include "../core/document.cch"
#include "../core/layout.cch"
#include "../core/workspace.cch"
#include "../core/find.cch"
#include "../core/ui.cch"
#include "../core/browse.cch"
#include "../frontend/cctext.cch"

static int fails = 0;

static void expect(int cond, const char *msg) {
    if (!cond) {
        fprintf(stderr, "FAIL: %s\n", msg);
        fails++;
    }
}

int g_mouse_col;
int g_mouse_row;
int g_mouse_press;
int g_mouse_drag;
int g_drag_edge;
int g_field_drag;
int g_shift;
int g_alt;
int g_cmd_ch;
int g_ctrl;
int g_nav;
char g_status[160];

int cctext_osx_shift_down(void) { return 0; }
int cctext_osx_alt_down(void) { return 0; }

static double meas(void *ctx, char[:] bytes, RtxStyle style, RtxSectionKind sec) {
    (void)ctx;
    (void)style;
    (void)sec;
    return (double)rtx_utf8_cols(bytes);
}

static double lh(void *ctx, RtxStyle style, RtxSectionKind sec) {
    (void)ctx;
    (void)style;
    (void)sec;
    return 1.0;
}

static char *capture(RtxWs *w, RtxUi *ui, int rows, int cols, size_t *n) {
    FILE *saved;
    FILE *cap;
    char *buf = NULL;
    *n = 0;
    fflush(stdout);
    cctext_draw_invalidate();
    cap = open_memstream(&buf, n);
    if (!cap) return NULL;
    saved = stdout;
    stdout = cap;
    cctext_draw(w, ui, rows, cols);
    fflush(stdout);
    stdout = saved;
    fclose(cap);
    return buf;
}

static int has(const char *buf, size_t n, const char *needle, size_t nn) {
    size_t i;
    if (!buf || nn == 0 || nn > n) return 0;
    for (i = 0; i + nn <= n; i++)
        if (memcmp(buf + i, needle, nn) == 0) return 1;
    return 0;
}

/* Every ESC in the capture starts one of our own sequences: CSI (ESC [)
 * with a final byte. No OSC (ESC ]), no BEL, no raw C1. */
static int clean_escapes(const char *buf, size_t n) {
    size_t i;
    for (i = 0; i < n; i++) {
        unsigned char c = (unsigned char)buf[i];
        if (c == 0x07) return 0;
        if (c == 0x1b && (i + 1 >= n || buf[i + 1] != '[')) return 0;
        if (c == 0xC2 && i + 1 < n && (unsigned char)buf[i + 1] >= 0x80 &&
            (unsigned char)buf[i + 1] < 0xA0)
            return 0;
    }
    return 1;
}

static int valid_utf8(const char *buf, size_t n) {
    size_t i = 0;
    while (i < n) {
        int k = rtx_utf8_decode(buf + i, n - i, NULL);
        if (k <= 0) return 0;
        i += (size_t)k;
    }
    return 1;
}

static void touch(const char *dir, const char *name, const char *body) {
    char p[512];
    FILE *f;
    snprintf(p, sizeof(p), "%s/%s", dir, name);
    f = fopen(p, "wb");
    /* APFS refuses names that are not valid UTF-8. */
    if (!f && errno == EILSEQ) return;
    expect(f != NULL, "create fixture");
    if (!f) return;
    if (body) fwrite(body, 1, strlen(body), f);
    fclose(f);
}

static void unit_fit(void) {
    char out[64];
    size_t used = 0;
    int cols = 0;
    size_t bn;
    /* C0, DEL, C1 CSI, invalid byte → stand-ins; one column each. */
    bn = rtx_utf8_term_fit("a\x1b" "b\x7f" "c\xc2\x9b" "d\xff", 9, 100, out,
                           sizeof(out), &used, &cols);
    expect(used == 9, "fit takes the whole run");
    expect(cols == 8, "fit: each stand-in is one column");
    expect(bn == 10 && memcmp(out, "a.b.c.d\xef\xbf\xbd", 10) == 0,
           "fit: C0 / DEL / C1 are '.', invalid is U+FFFD");
    /* Newline in a name is visible, not a row break. */
    bn = rtx_utf8_term_fit("x\ny", 3, 100, out, sizeof(out), &used, &cols);
    expect(bn == 3 && memcmp(out, "x.y", 3) == 0, "fit: LF is a stand-in");
    /* Wide clusters stop at the column budget, whole. */
    bn = rtx_utf8_term_fit("\xe5\x90\x8d\xe5\x89\x8d", 6, 3, out, sizeof(out),
                           &used, &cols);
    expect(used == 3 && cols == 2 && bn == 3, "fit: a wide cluster is not split");
    /* A pane row: term_put drops CR / LF, stands in for C1. */
    {
        char put[8];
        expect(rtx_utf8_term_put(0x9B, "\xc2\x9b", 2, put, sizeof(put)) == 1 &&
                   put[0] == '.',
               "term_put: C1 CSI is '.'");
        expect(rtx_utf8_term_cols(0x9B, 1) == 1, "term_cols: C1 is one column");
        expect(rtx_utf8_term_put(RTX_UTF8_FFFD, "\xff", 1, put, sizeof(put)) == 3 &&
                   memcmp(put, "\xef\xbf\xbd", 3) == 0,
               "term_put: invalid byte is U+FFFD");
        expect(rtx_utf8_term_put('\r', "\r", 1, put, sizeof(put)) == 0,
               "term_put: CR is dropped in a row");
    }
    /* Browse names are columns: a long name keeps both ends with '~' in
     * the middle; offsets stay on cluster starts. */
    {
        size_t head_n = 0, tail_off = 0;
        int ellip = 0;
        const char *wide = "\xe5\x90\x8d\xe5\x90\x8d\xe5\x90\x8d\xe5\x90\x8d\xe5\x90\x8d";
        rtx_browse_name_window(wide, 6, &head_n, &tail_off, &ellip);
        expect(ellip == 1, "wide name is windowed");
        expect(head_n % 3 == 0, "head ends on a cluster");
        expect(tail_off % 3 == 0, "tail starts on a cluster");
        expect(head_n <= tail_off, "head does not overlap tail");
        expect(rtx_utf8_cols(cc_slice_from_buffer((void *)wide, head_n)) + 1 +
                       rtx_utf8_cols(cc_slice_cstr(wide + tail_off)) <=
                   6,
               "head + ~ + tail fits the window");
        rtx_browse_name_window("abc", 6, &head_n, &tail_off, &ellip);
        expect(ellip == 0 && head_n == 3, "short name is whole");
        rtx_browse_name_window("abcdefghij", 7, &head_n, &tail_off, &ellip);
        /* budget 6 → head 2, tail 4: "ab~ghij" */
        expect(ellip == 1 && head_n == 2 && tail_off == 6,
               "ascii middle keeps both ends");
        expect(strcmp("abcdefghij" + 6, "ghij") == 0, "ab~ghij");
    }
}

int main(void) {
    const char *dir = "testdata/generated/term_safe";
    char body_path[256];
    rtx_safe_test_isol();
    @errhandler(CCError e) {
        cc_error_log(e);
        return 1;
    }
    unit_fit();
    mkdir("testdata/generated", 0755);
    mkdir(dir, 0755);
    touch(dir, "a_osc\x1b]0;PWNED\x07z.txt", "x\n");
    touch(dir, "b_c1\xc2\x9b" "31mRED.txt", "x\n");
    touch(dir, "c_bad\xff\xfe.txt", "x\n");
    touch(dir, "d_nl\nname.txt", "x\n");
    touch(dir, "e_\xe5\x90\x8d\xe5\x89\x8d\xe5\x90\x8d\xe5\x89\x8d\xe5\x90\x8d\xe5\x89\x8d"
               "\xe5\x90\x8d\xe5\x89\x8d\xe5\x90\x8d\xe5\x89\x8d\xe5\x90\x8d\xe5\x89\x8d"
               "\xe5\x90\x8d\xe5\x89\x8d\xe5\x90\x8d\xe5\x89\x8d.txt",
          "x\n");
    snprintf(body_path, sizeof(body_path), "%s/f_body.txt", dir);
    touch(dir, "f_body.txt",
          "c1 \xc2\x9b" "2J here\nbad \xff\xfe bytes\nesc \x1b]0;T\x07 x\n");
    {
        RtxWs w = {0} @destroy;
        RtxUi ui = {0};
        char *paths[1];
        char *buf;
        size_t n = 0;
        RtxBrowse *br;
        paths[0] = (char *)dir;
        w.open_files(1, paths) !>;
        w.browse_start() !>;
        br = RtxWs_browse(&w);
        expect(br != NULL, "browse");
        if (br) rtx_browse_finish(br) !>;
        buf = capture(&w, &ui, 24, 60, &n);
        expect(n > 0, "browse painted");
        expect(!has(buf, n, "\x1b]0;PWNED", 9), "OSC from a filename is not emitted");
        expect(clean_escapes(buf, n), "browse: no raw ESC / BEL / C1 reaches the TTY");
        expect(valid_utf8(buf, n), "browse: capture is valid UTF-8");
        expect(has(buf, n, "a_osc.]0;PWNED.z", 16), "OSC name shows stand-ins");
        free(buf);
    }
    {
        RtxWs w = {0} @destroy;
        RtxUi ui = {0};
        RtxMeasure m;
        char *paths[1];
        char *buf;
        size_t n = 0;
        RtxBuf *b;
        m.measure = meas;
        m.line_height = lh;
        m.ctx = NULL;
        paths[0] = body_path;
        w.open_files(1, paths) !>;
        b = w.active();
        expect(b != NULL, "open body");
        if (b) {
            int held = w.hold_pane(0);
            b->ensure_view(&m, 70.0, 23) !>;
            w.drop_pane(0, held);
        }
        snprintf(g_status, sizeof(g_status), "err \x1b[2J\xc2\x9b" "5n");
        buf = capture(&w, &ui, 24, 80, &n);
        expect(n > 0, "pane painted");
        expect(clean_escapes(buf, n), "pane: no raw ESC / BEL / C1 reaches the TTY");
        expect(valid_utf8(buf, n), "pane: capture is valid UTF-8");
        expect(!has(buf, n, "\x1b[2J", 4), "status message cannot clear the screen");
        free(buf);
        g_status[0] = 0;
    }
    if (fails) {
        fprintf(stderr, "term_safe_smoke: %d failed\n", fails);
        return 1;
    }
    printf("term_safe_smoke: ok\n");
    return 0;
}
