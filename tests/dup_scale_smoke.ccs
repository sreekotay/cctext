#!ccc ccs
/*
 * Scale stress without an 8 GiB fixture: mmap a seed, then append a full
 * copy of the seed bytes eight times (select-all / copy / paste at EOF).
 * Touches line_start / line_of after each round — where a full line-index
 * rebuild would hurt.
 *
 *   make run-dup_scale_smoke
 *   RTX_DUP_ROUNDS=16 ./bin/dup_scale_smoke [path]
 */
#include <ccc/std/prelude.cch>
#include <ccc/script/stdio.cch>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include "../core/document.cch"
#include "../core/edit.cch"

static int fails = 0;

static void expect(int cond, const char *msg) {
    if (!cond) {
        fprintf(stderr, "FAIL: %s\n", msg);
        fails++;
    }
}

static int ensure_seed(const char *path) {
    if (access(path, R_OK) == 0) return 0;
    {
        char cmd[512];
        snprintf(cmd, sizeof(cmd), "./testdata/gen_large.sh 4000 %s", path);
        if (system(cmd) != 0) return -1;
    }
    return access(path, R_OK) == 0 ? 0 : -1;
}

int main(int argc, char **argv) {
    const char *path = "testdata/generated/large.txt";
    int rounds = 8;
    size_t seed_len, seed_lines, i;
    const char *env;
    RtxDoc d = {0} @destroy;

    if (argc > 1) path = argv[1];
    env = getenv("RTX_DUP_ROUNDS");
    if (env && env[0]) rounds = atoi(env);
    if (rounds < 1) rounds = 1;
    if (rounds > 64) rounds = 64;

    if (ensure_seed(path) != 0) {
        fprintf(stderr, "dup_scale: missing seed %s\n", path);
        return 1;
    }

    @errhandler(CCError e) {
        fprintf(stderr, "dup_scale: %s\n", e.message ? e.message : "?");
        return 1;
    }

    d.from_path(path) !>;
    seed_len = d.len();
    seed_lines = d.line_count();
    expect(seed_len > 0, "seed non-empty");
    expect(seed_lines > 0, "seed has lines");
    (void)d.line_start(seed_lines / 2);

    for (i = 0; i < (size_t)rounds; i++) {
        CCArena hold = {0} @destroy;
        char[:] chunk;
        size_t mid;
        chunk = d.scratch_span(&hold, 0, seed_len) !>;
        expect(chunk.len == seed_len, "seed chunk");
        d.insert(d.len(), chunk) !>;
        expect(d.len() == seed_len * (i + 2), "len after append");
        mid = d.line_count() / 2;
        expect(d.line_of(d.line_start(mid)) == mid, "line_of(line_start) mid");
        expect(d.check(), "tree check");
    }

    expect(d.line_count() >= seed_lines, "lines grew or held");
    expect(d.len() == seed_len * ((size_t)rounds + 1), "final len");

    printf("dup_scale_smoke ok  rounds=%d seed_bytes=%zu final_bytes=%zu lines=%zu\n",
           rounds, seed_len, d.len(), d.line_count());
    return fails ? 1 : 0;
}
