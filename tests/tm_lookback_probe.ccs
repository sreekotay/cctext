#!ccc ccs
/*
 * Window lex must see a block comment opened before the visible range:
 * lookback replay, catch-up from BOF within RTX_TM_CATCHUP_MAX, and
 * same-line begin.
 */
#include <ccc/std/prelude.cch>
#include <stdio.h>
#include <string.h>
#include <unistd.h>
#include "../core/document.cch"
#include "../core/find.cch"

static int fails = 0;

static void expect(int cond, const char *msg) {
    if (!cond) {
        fprintf(stderr, "FAIL: %s\n", msg);
        fails++;
    }
}

static int has_scope_at(RtxDoc *d, size_t off, const char *needle) {
    size_t i;
    for (i = 0; i < d->runs.len; i++) {
        size_t a = d->runs.data[i].start;
        size_t b = a + d->runs.data[i].len;
        const char *s;
        if (off < a || off >= b) continue;
        s = rtx_scope_name(d->runs.data[i].style.scope);
        if (s && strstr(s, needle)) return 1;
    }
    return 0;
}

static void fill_lines(FILE *fp, size_t n) {
    size_t i;
    for (i = 0; i < n; i++) fputc((i % 64) == 63 ? '\n' : 'z', fp);
}

/* Every hinted run's hint bytes are delimiter bytes (`` ` `` / `#` / ` `):
 * a clipped or seeded run that kept a stale hint would name content. */
static int hints_are_delims(RtxDoc *d) {
    size_t k, j;
    char buf[8];
    @errhandler(CCError e) {
        cc_error_log(e);
        return 0;
    }
    for (k = 0; k < d->runs.len; k++) {
        const RtxRun *r = &d->runs.data[k];
        size_t na = r->hint_a < sizeof buf ? r->hint_a : sizeof buf;
        size_t nb = r->hint_b < sizeof buf ? r->hint_b : sizeof buf;
        if (na) {
            if (d->read_at(r->start, cc_slice_from_buffer(buf, na)) !> != na) return 0;
            for (j = 0; j < na; j++)
                if (buf[j] != '`' && buf[j] != '#' && buf[j] != ' ') return 0;
        }
        if (nb) {
            if (d->read_at(r->start + r->len - nb, cc_slice_from_buffer(buf, nb)) !> != nb)
                return 0;
            for (j = 0; j < nb; j++)
                if (buf[j] != '`') return 0;
        }
    }
    return 1;
}

static int write_probe(const char *path, size_t prefix, size_t gap) {
    FILE *fp = fopen(path, "w");
    if (!fp) return 0;
    fill_lines(fp, prefix);
    fputs("/*\n", fp);
    fill_lines(fp, gap);
    fputs("\nint x;\n", fp);
    fclose(fp);
    return 1;
}

static int resolve_code(RtxDoc *d, size_t win_lo, size_t win_hi) {
    int steps = 0;
    @errhandler(CCError e) {
        cc_error_log(e);
        fails++;
        return steps;
    }
    while (steps < 64) {
        d->ensure_hl(rtx_hl_span(win_lo, win_hi)) !>;
        steps++;
        if (has_scope_at(d, win_hi > 1 ? win_hi - 1 : 0, "comment")) return steps;
        if (d->hl_full) return steps;
    }
    return steps;
}

static void run_case(const char *label, size_t prefix, size_t gap) {
    char path[256];
    RtxDoc d = {0} @destroy;
    size_t n, off, win_lo, win_hi;
    @errhandler(CCError e) {
        cc_error_log(e);
        fails++;
        return;
    }
    snprintf(path, sizeof path, "testdata/generated/tm_lookback_%s.c", label);
    expect(write_probe(path, prefix, gap), "write probe");
    d.from_path(cc_slice_cstr(path)) !>;
    n = d.len();
    off = n - 6;
    win_lo = off > 64 ? off - 64 : 0;
    win_hi = n;
    resolve_code(&d, win_lo, win_hi);
    expect(has_scope_at(&d, off, "comment"), label);
    expect(!has_scope_at(&d, off, "keyword"), label);
    unlink(path);
}

int main(void) {
    @errhandler(CCError e) { cc_error_log(e); return 1; }
    size_t lb = (size_t)RTX_MARKUP_LOOKBACK;
    size_t full = (size_t)RTX_HL_FULL_MAX;
    if (!rtx_tm_c_rt()) {
        fprintf(stderr, "no C grammar (dir=%s)\n", rtx_tm_load_dir);
        return 1;
    }
    run_case("small", 0, lb + 4096);
    run_case("near", full + 4096, lb / 2);
    run_case("far", full + 4096, lb + 4096);
    run_case("beyond", (size_t)RTX_TM_CATCHUP_MAX + 8192, 4096);
    {
        char path[256];
        RtxDoc d = {0} @destroy;
        size_t n, off, win_lo;
        FILE *fp;
        snprintf(path, sizeof path, "testdata/generated/tm_lookback_sameline.c");
        fp = fopen(path, "w");
        expect(fp != NULL, "sameline fopen");
        if (fp) {
            fill_lines(fp, full + 4096);
            fputs("/* int x; */\n", fp);
            fclose(fp);
        }
        d.from_path(cc_slice_cstr(path)) !>;
        n = d.len();
        off = n - 10;
        win_lo = off > 4 ? off - 4 : 0;
        resolve_code(&d, win_lo, n);
        expect(has_scope_at(&d, off, "comment"), "sameline");
        unlink(path);
    }
    {
        char path[256];
        RtxDoc d = {0} @destroy;
        size_t n, off, i;
        FILE *fp;
        snprintf(path, sizeof path, "testdata/generated/tm_lookback_longline.c");
        fp = fopen(path, "w");
        expect(fp != NULL, "longline fopen");
        if (fp) {
            fill_lines(fp, full + 4096);
            for (i = 0; i < lb + 2048; i++) fputc('z', fp);
            fputs("/* int x; */\n", fp);
            fclose(fp);
        }
        d.from_path(cc_slice_cstr(path)) !>;
        n = d.len();
        off = n - 10;
        resolve_code(&d, off > 4 ? off - 4 : 0, n);
        expect(has_scope_at(&d, off, "comment"), "longline");
        unlink(path);
    }
    /* A window inside a fence whose opener is behind the lex start: the
     * seeded frame re-emits the fence run at the window, but its opener
     * hint is not there. No content byte may read as a hint. */
    {
        char path[256];
        RtxDoc d = {0} @destroy;
        size_t n, lo, k;
        int hinted = 0, fenced = 0;
        FILE *fp;
        snprintf(path, sizeof path, "testdata/generated/tm_lookback_fence.md");
        fp = fopen(path, "w");
        expect(fp != NULL, "fence fopen");
        if (fp) {
            fputs("# Doc\n\n```\n", fp);
            fill_lines(fp, full + lb + 8192);
            fputs("\n```\n\ntail\n", fp);
            fclose(fp);
        }
        d.from_path(cc_slice_cstr(path)) !>;
        n = d.len();
        lo = full + lb / 2;
        lo -= lo % 64; /* a line start inside the fence body */
        d.ensure_hl(rtx_hl_win(lo, 256)) !>;
        for (k = 0; k < d.runs.len; k++) {
            const RtxRun *r = &d.runs.data[k];
            if (r->start > lo + 8 || r->start + r->len <= lo) continue;
            if (r->start + r->len > lo + 64) fenced = 1;
        }
        expect(fenced, "fence: window lies in a fence run");
        for (k = lo; k < lo + 8 && k < n; k++) {
            if (RtxDoc_hint_at(&d, k, NULL, NULL)) hinted = 1;
        }
        expect(!hinted, "fence: clipped fence run hides no content");
        expect(hints_are_delims(&d), "fence: seeded window hints are delimiters");
        /* A lex that holds the opener, then a re-lex in the middle of that
         * run: the clip fragments keep only the hint whose edge they kept. */
        d.ensure_hl(rtx_hl_win(0, 200000)) !>;
        expect(hints_are_delims(&d), "fence: head window hints are delimiters");
        d.ensure_hl(rtx_hl_win(96 * 64, 256)) !>;
        expect(hints_are_delims(&d), "fence: re-lexed middle keeps honest hints");
        d.ensure_hl(rtx_hl_win(n > 512 ? n - 512 : 0, 512)) !>;
        expect(hints_are_delims(&d), "fence: tail window hints are delimiters");
        unlink(path);
    }
    if (fails) {
        fprintf(stderr, "%d failure(s)\n", fails);
        return 1;
    }
    printf("tm_lookback_probe ok\n");
    return 0;
}
