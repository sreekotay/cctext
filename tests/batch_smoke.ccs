#!ccc ccs
/*
 * Headless --batch command runner.
 */
#include <ccc/std/prelude.cch>
#include <ccc/stdio.cch>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <sys/time.h>
#include <unistd.h>
#include "../core/document.cch"
#include "../core/layout.cch"
#include "../core/workspace.cch"
#include "../core/find.cch"
#include "../core/ui.cch"
#include "../core/batch.cch"

extern FILE *open_memstream(char **bufp, size_t *sizep);

static int fails = 0;

static void expect(int cond, const char *msg) {
    if (!cond) {
        fprintf(stderr, "FAIL: %s\n", msg);
        fails++;
    }
}

/* The active buffer's bytes are `want`. */
static void batch_doc(RtxWs *w, const char *want, const char *msg) {
    char got[256];
    size_t n;
    RtxDoc *d = &w->active()->doc;
    @errhandler(CCError e) {
        (void)e;
        expect(0, msg);
        return;
    }
    n = d->len() < sizeof(got) - 1 ? d->len() : sizeof(got) - 1;
    n = d->read_at(0, cc_slice_from_buffer(got, n)) !>;
    got[n] = 0;
    if (strcmp(got, want)) fprintf(stderr, "  doc [%s]\n  want [%s]\n", got, want);
    expect(!strcmp(got, want), msg);
}

int main(void) {
    @errhandler(CCError e) {
        fprintf(stderr, "batch_smoke: %s\n", e.message ? e.message : "?");
        return 1;
    }
    rtx_safe_test_isol();
    rtx_safe_set_enabled(0);

    {
        char *av[8];
        char *files[4];
        RtxCli cli;
        av[0] = (char *)"cctext";
        av[1] = (char *)"--batch";
        av[2] = (char *)"-c";
        av[3] = (char *)"goto 50%";
        av[4] = (char *)"-c";
        av[5] = (char *)"stats-json";
        av[6] = (char *)"testdata/small.txt";
        expect(rtx_cli_parse(7, av, files, 4, &cli) == 0, "cli --batch -c");
        expect(cli.batch && cli.ncmds == 2 && cli.nfiles == 1, "cli batch fields");
        expect(strcmp(cli.cmds[0], "goto 50%") == 0, "cli -c[0]");
    }

    {
        RtxWs w = {0} @destroy;
        char *paths[1];
        char *cmds[8];
        char outpath[128];
        FILE *out;
        char got[512];
        size_t n;
        paths[0] = (char *)"testdata/small.txt";
        w.open_files(1, paths) !>;
        cmds[0] = (char *)"goto @0";
        cmds[1] = (char *)"insert BATCH";
        cmds[2] = (char *)"goto @0";
        cmds[3] = (char *)"read @0 5";
        snprintf(outpath, sizeof(outpath), "testdata/generated/batch_out.txt");
        out = fopen(outpath, "w");
        expect(out != NULL, "batch out");
        expect(rtx_batch_run(&w, cmds, 4, out, stderr) == 0, "batch run");
        if (out) fclose(out);
        out = fopen(outpath, "r");
        n = out ? fread(got, 1, sizeof(got) - 1, out) : 0;
        if (out) fclose(out);
        got[n] = 0;
        expect(n >= 5 && memcmp(got, "BATCH", 5) == 0, "insert+read");
        unlink(outpath);
    }

    {
        RtxWs w = {0} @destroy;
        char *paths[1];
        char *cmds[6];
        paths[0] = (char *)"testdata/small.txt";
        w.open_files(1, paths) !>;
        cmds[0] = (char *)"goto 50%";
        cmds[1] = (char *)"await index";
        cmds[2] = (char *)"goto L1";
        cmds[3] = (char *)"print 1";
        expect(rtx_batch_run(&w, cmds, 4, stdout, stderr) == 0,
               "goto % / await / L / print");
        expect(w.active()->doc.caret == 0, "L1 is BOF");
    }

    {
        RtxWs w = {0} @destroy;
        char *paths[1];
        char *cmds[2];
        const char *path = "testdata/generated/batch_conflict.txt";
        FILE *f;
        struct timeval tv[2];
        if (system("mkdir -p testdata/generated") != 0) expect(0, "mkdir");
        unlink(path);
        f = fopen(path, "w");
        expect(f != NULL, "batch conflict create");
        if (f) {
            fputs("abc", f);
            fclose(f);
        }
        paths[0] = (char *)path;
        w.open_files(1, paths) !>;
        cmds[0] = (char *)"insert Z";
        expect(rtx_batch_run(&w, cmds, 1, stdout, stderr) == 0, "batch insert");
        f = fopen(path, "w");
        if (f) {
            fputs("abc-ext", f);
            fclose(f);
        }
        tv[0].tv_sec = 1;
        tv[0].tv_usec = 0;
        tv[1] = tv[0];
        expect(utimes(path, tv) == 0, "batch conflict utimes");
        cmds[0] = (char *)"save";
        expect(rtx_batch_run(&w, cmds, 1, stdout, stderr) != 0,
               "batch save refuses a drifted path");
        unlink(path);
    }

    {
        RtxWs w = {0} @destroy;
        char *paths[1];
        FILE *fp;
        paths[0] = (char *)"testdata/small.txt";
        w.open_files(1, paths) !>;
        fp = fopen("testdata/batch/smoke.ops", "r");
        expect(fp != NULL, "smoke.ops");
        if (fp) {
            expect(rtx_batch_run_fp(&w, fp, stdout, stderr) == 0, "ops file");
            fclose(fp);
        }
    }

    {
        /* replace [--all] [--regex] [--icase] [--word] FIND REPL */
        RtxWs w = {0} @destroy;
        char *paths[1];
        const char *path = "testdata/generated/batch_replace.txt";
        FILE *f;
        if (system("mkdir -p testdata/generated") != 0) expect(0, "mkdir");
        f = fopen(path, "w");
        expect(f != NULL, "batch replace create");
        if (f) {
            fputs("cat cat Cat\nk=v x=y catalog\n", f);
            fclose(f);
        }
        paths[0] = (char *)path;
        w.open_files(1, paths) !>;
        expect(rtx_batch_exec(&w, "replace --all cat dog", stdout, stderr) == RTX_BATCH_OK,
               "replace --all");
        batch_doc(&w, "dog dog Cat\nk=v x=y dogalog\n", "replace --all: literal, case-sensitive");
        expect(rtx_batch_exec(&w, "undo", stdout, stderr) == RTX_BATCH_OK, "undo");
        batch_doc(&w, "cat cat Cat\nk=v x=y catalog\n", "undo: one step");
        expect(rtx_batch_exec(&w, "redo", stdout, stderr) == RTX_BATCH_OK, "redo");
        batch_doc(&w, "dog dog Cat\nk=v x=y dogalog\n", "redo");
        expect(rtx_batch_exec(&w, "undo", stdout, stderr) == RTX_BATCH_OK, "undo 2");
        expect(rtx_batch_exec(&w, "replace --all --icase --word cat \"a \\\"b\\\"\"",
                              stdout, stderr) == RTX_BATCH_OK,
               "replace --icase --word, double-quoted with \\\"");
        batch_doc(&w, "a \"b\" a \"b\" a \"b\"\nk=v x=y catalog\n", "icase + word + quotes");
        expect(rtx_batch_exec(&w, "undo", stdout, stderr) == RTX_BATCH_OK, "undo 3");
        expect(rtx_batch_exec(&w, "goto @0", stdout, stderr) == RTX_BATCH_OK, "goto");
        expect(rtx_batch_exec(&w, "replace --regex '(\\w)=(\\w)' '$2=$1'", stdout,
                              stderr) == RTX_BATCH_OK,
               "replace one --regex, single-quoted");
        batch_doc(&w, "cat cat Cat\nv=k x=y catalog\n", "replace one: the first match only");
        expect(rtx_batch_exec(&w, "replace --all --regex \"(\\w)=(\\w)\" \"[$1\\t]\"",
                              stdout, stderr) == RTX_BATCH_OK,
               "replace --all --regex, \\t kept for the template");
        batch_doc(&w, "cat cat Cat\n[v\t] [x\t] catalog\n", "regex template: $1 and \\t");
        expect(rtx_batch_exec(&w, "replace --all ' catalog' ''", stdout, stderr) ==
                   RTX_BATCH_OK,
               "replace with '' deletes");
        batch_doc(&w, "cat cat Cat\n[v\t] [x\t]\n", "empty replacement");
        expect(rtx_batch_exec(&w, "replace --all onlyfind", stdout, stderr) == RTX_BATCH_ERR,
               "replace without REPL fails");
        expect(rtx_batch_exec(&w, "replace --all 'open x", stdout, stderr) == RTX_BATCH_ERR,
               "unterminated quote fails");
        expect(rtx_batch_exec(&w, "replace --all a b c", stdout, stderr) == RTX_BATCH_ERR,
               "extra args fail");
        expect(rtx_batch_exec(&w, "replace --regex '(a' x", stdout, stderr) == RTX_BATCH_ERR,
               "bad regex fails");
        expect(rtx_batch_exec(&w, "replace zzz y", stdout, stderr) == RTX_BATCH_ERR,
               "replace one with no match fails");
        batch_doc(&w, "cat cat Cat\n[v\t] [x\t]\n", "failed verbs edit nothing");
        unlink(path);
    }

    {
        /* A regex the backtracker cannot decide at the run of a's (line
         * 3): replace --all is an error that names the line and edits
         * nothing; find lists the hits before it and flags the rest;
         * replace one takes a decided hit, and fails past the run. */
        RtxWs w = {0} @destroy;
        char *paths[1];
        const char *path = "testdata/generated/batch_indet.txt";
        const char *text = "z\nz\naaaaaaaaaaaaaaaa\nz\n";
        char *ob = NULL, *eb = NULL;
        size_t on = 0, en = 0;
        FILE *out, *err, *f;
        int rc;
        if (system("mkdir -p testdata/generated") != 0) expect(0, "mkdir");
        f = fopen(path, "w");
        if (f) {
            fputs(text, f);
            fclose(f);
        }
        paths[0] = (char *)path;
        w.open_files(1, paths) !>;
        err = open_memstream(&eb, &en);
        rc = rtx_batch_exec(&w, "replace --all --regex '(?:(a+)+b|a+|z)(?=$)' Q", stdout, err);
        fclose(err);
        expect(rc == RTX_BATCH_ERR && eb &&
                   strstr(eb, "pattern too complex to search exhaustively at line 3"),
               "indet: replace --all fails and names the line");
        if (eb && !strstr(eb, "line 3")) fprintf(stderr, "  err: %s\n", eb);
        free(eb);
        eb = NULL;
        batch_doc(&w, text, "indet: replace --all edits nothing");
        expect(!w.active()->doc.can_undo(), "indet: no history");
        out = open_memstream(&ob, &on);
        rc = rtx_batch_exec(&w, "find --regex '(?:(a+)+b|a+|z)(?=$)'", out, stderr);
        fclose(out);
        expect(rc == RTX_BATCH_OK && ob && strstr(ob, "1\t0\t1\n2\t2\t1\n") &&
                   !strstr(ob, "\n4\t") &&
                   strstr(ob, "# 2 matches; search incomplete: pattern too complex at line 3"),
               "indet: find lists the hits before the run and flags the rest");
        if (ob && !strstr(ob, "incomplete")) fprintf(stderr, "  out: %s\n", ob);
        free(ob);
        ob = NULL;
        expect(rtx_batch_exec(&w, "goto @0", stdout, stderr) == RTX_BATCH_OK, "goto");
        expect(rtx_batch_exec(&w, "replace --regex '(?:(a+)+b|a+|z)(?=$)' Q", stdout, stderr) ==
                   RTX_BATCH_OK,
               "indet: replace one takes a decided hit");
        batch_doc(&w, "Q\nz\naaaaaaaaaaaaaaaa\nz\n", "indet: replace one");
        expect(rtx_batch_exec(&w, "goto @5", stdout, stderr) == RTX_BATCH_OK, "goto 5");
        err = open_memstream(&eb, &en);
        rc = rtx_batch_exec(&w, "replace --regex '(?:(a+)+b|a+|z)(?=$)' Q", stdout, err);
        fclose(err);
        expect(rc == RTX_BATCH_ERR && eb && strstr(eb, "search incomplete"),
               "indet: replace one past the run fails, saying why");
        free(eb);
        batch_doc(&w, "Q\nz\naaaaaaaaaaaaaaaa\nz\n", "indet: nothing past the run");
        unlink(path);
    }

    if (fails) {
        fprintf(stderr, "batch_smoke: %d fail(s)\n", fails);
        return 1;
    }
    printf("batch_smoke ok\n");
    return 0;
}
