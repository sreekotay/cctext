#!ccc ccs
/*
 * Marp slides (core/slides.ccs, docs/slides.md).
 *
 * 1. Block pass in Marp mode: a top-level thematic break is a slide
 *    separator; inside a container, a fence, or under a paragraph
 *    (setext) it is not; without `marp: true` nothing changes.
 * 2. Deck index over strings: directives (global, local, spot, front
 *    matter, notes), fragments, headingDivider, pagination, background
 *    images, a prefix index (windowed: past the scan nothing is guessed).
 * 3. testdata/slides/demo.md as a document: slide views (headings, items
 *    with build steps, code, table, setext) and the presenter's
 *    navigation, fragments, transitions and idle wait.
 * 4. A deck past RTX_HL_FULL_MAX: window lex of a middle slide.
 */
#include <ccc/std/prelude.cch>
#include <ccc/stdio.cch>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <time.h>
#include "../core/document.cch"
#include "../core/md_block.cch"
#include "../core/md_table.cch"
#include "../core/cmd.cch"
#include "../core/slides.cch"

static int fails = 0;

static void expect(int cond, const char *msg) {
    if (!cond) {
        fprintf(stderr, "FAIL: %s\n", msg);
        fails++;
    }
}

/* Span kind per line: 'S' slide, 'T' hr, 'H' setext, 'F' fence body,
 * '.' other. */
static void classify(const char *md, int marp, char *out, size_t cap) {
    RtxMdb st;
    RtxMdbLine L;
    size_t i = 0, n = strlen(md), w = 0;
    rtx_mdb_init(&st, 1, 0, 0);
    rtx_mdb_set_marp(&st, marp);
    while (i < n && w + 1 < cap) {
        const char *nl = strchr(md + i, '\n');
        size_t eol = nl ? (size_t)(nl - md) : n;
        char c = '.';
        int j;
        rtx_mdb_line(&st, md, i, eol, &L);
        for (j = 0; j < L.nsp; j++) {
            if (L.sp[j].kind == RTX_MDB_S_SLIDE) c = 'S';
            else if (L.sp[j].kind == RTX_MDB_S_HR) c = 'T';
            else if (L.sp[j].kind == RTX_MDB_S_SETEXT) c = 'H';
        }
        if (c == '.' && L.mode == RTX_MDB_M_GUEST && st.leaf == RTX_MDB_LEAF_FENCE) c = 'F';
        out[w++] = c;
        i = nl ? eol + 1 : n;
    }
    out[w] = 0;
}

static void block_checks(void) {
    char got[64];
    classify("a\n\n---\nb\n", 1, got, sizeof got);
    expect(strcmp(got, "..S.") == 0, "marp: --- after a blank line is a slide");
    classify("a\n\n---\nb\n", 0, got, sizeof got);
    expect(strcmp(got, "..T.") == 0, "no marp: --- is an hr");
    classify("Title\n---\n", 1, got, sizeof got);
    expect(strcmp(got, ".H") == 0, "marp: Title + --- stays setext (markdown-it)");
    classify("a\n***\nb\n___\n- - -\n", 1, got, sizeof got);
    expect(strcmp(got, ".S.SS") == 0, "marp: *** ___ - - - split too");
    classify("> q\n>\n> ---\n", 1, got, sizeof got);
    expect(strcmp(got, "..T") == 0, "marp: --- inside a quote is an hr");
    classify("- a\n\n  ---\n", 1, got, sizeof got);
    expect(strcmp(got, "..T") == 0, "marp: --- inside a list item is an hr");
    classify("- a\n---\n", 1, got, sizeof got);
    expect(strcmp(got, ".S") == 0, "marp: --- ends a list and splits");
    classify("```\n---\n```\n---\n", 1, got, sizeof got);
    expect(strcmp(got, ".F.S") == 0, "marp: --- in a fence is body, after it a slide");
    classify("    ---\n", 1, got, sizeof got);
    expect(strcmp(got, ".") == 0, "marp: indented --- is code");
    classify("<!--\n---\n-->\n---\n", 1, got, sizeof got);
    expect(strcmp(got, "...S") == 0, "marp: --- in an HTML comment is not a slide");

    expect(rtx_mdb_marp_front("---\nmarp: true\n---\n", 20), "front: marp: true");
    expect(rtx_mdb_marp_front("---\r\ntheme: x\r\nmarp:  TRUE  # yes\r\n---\r\n", 38),
           "front: CRLF, case, comment");
    expect(!rtx_mdb_marp_front("---\nmarp: false\n---\n", 21), "front: marp: false");
    expect(!rtx_mdb_marp_front("---\ntitle: x\n---\nmarp: true\n", 29),
           "front: marp after the front matter");
    expect(!rtx_mdb_marp_front("# x\n---\nmarp: true\n---\n", 24), "front: not at BOF");
    expect(!rtx_mdb_marp_front("---\nmarp: true", 14), "front: probe ends inside");
}

static const char deck1[] =
    "---\n"
    "marp: true\n"
    "theme: gaia\n"
    "size: 4:3\n"
    "paginate: true\n"
    "footer: F\n"
    "transition: fade 0.5s\n"
    "---\n"
    "\n"
    "<!-- _class: lead invert -->\n"
    "# One\n"
    "\n"
    "---\n"
    "<!-- backgroundColor: #abc -->\n"
    "<!-- _footer: \"spot\" -->\n"
    "## Two\n"
    "* a\n"
    "* b\n"
    "  - nested (no step)\n"
    "1) c\n"
    "- d\n"
    "\n"
    "---\n"
    "<!--\n"
    "header: H\n"
    "transition: push 250ms\n"
    "-->\n"
    "<!-- just a note: with words and more -->\n"
    "<!-- paginate: hold -->\n"
    "Three text\n"
    "![bg right:30% fit](a.png)\n"
    "![bg](b.png)\n"
    "\n"
    "```\n"
    "---\n"
    "```\n"
    "***\n"
    "<!-- paginate: skip -->\n"
    "Four\n";

static void deck_checks(void) {
    RtxDeck k = {0};
    size_t n = strlen(deck1);
    const RtxSlide *s;
    rtx_deck_build(&k, deck1, n, 1);
    expect(k.marp && k.n == 4, "deck1: four slides");
    if (k.n != 4) {
        fprintf(stderr, "deck1 slides %zu\n", k.n);
        rtx_deck_free(&k);
        return;
    }
    expect(strcmp(k.theme, "gaia") == 0 && k.w == 960 && k.h == 720, "deck1: theme, 4:3");
    s = &k.s[0];
    expect(s->dir.lead && s->dir.invert, "slide 1: spot class lead invert");
    expect(s->dir.trans == RTX_TR_FADE && s->dir.trans_ms == 500, "slide 1: fade 0.5s");
    expect(strcmp(s->dir.footer, "F") == 0 && s->dir.paginate == 1, "slide 1: footer, paginate");
    expect(s->title_hi > s->title_lo &&
           memcmp(deck1 + s->title_lo, "One", 3) == 0, "slide 1: title One");
    s = &k.s[1];
    expect(!s->dir.lead && !s->dir.invert, "slide 2: spot class is gone");
    expect(s->dir.bg_set && s->dir.bg == 0xaabbcc, "slide 2: backgroundColor #abc");
    expect(strcmp(s->dir.footer, "spot") == 0, "slide 2: spot footer");
    expect(s->nfrag == 3, "slide 2: * * 1) are three steps, - and nested - are not");
    expect(memcmp(deck1 + s->sep, "---", 3) == 0, "slide 2: sep at its ---");
    s = &k.s[2];
    expect(s->dir.bg_set && s->dir.bg == 0xaabbcc, "slide 3: local backgroundColor carries");
    expect(strcmp(s->dir.footer, "F") == 0, "slide 3: footer back to F");
    expect(strcmp(s->dir.header, "H") == 0, "slide 3: multi-line comment header");
    expect(s->dir.trans == RTX_TR_PUSH && s->dir.trans_ms == 250, "slide 3: push 250ms");
    expect(s->dir.paginate == 2, "slide 3: paginate hold");
    expect(s->nbg == 2 && s->bg_side == 2 && s->bg_pct == 30 && s->bg_fit == 1 &&
           memcmp(deck1 + s->bg_src_lo, "a.png", 5) == 0,
           "slide 3: bg right:30% fit a.png, two bg images");
    expect(k.s[3].dir.paginate == 3, "slide 4: paginate skip");
    expect(k.s[0].page == 1 && k.s[1].page == 2 && k.s[2].page == 2 && k.s[3].page == 2,
           "pages: hold and skip do not count");
    expect(rtx_deck_slide_of(&k, 0) == 0, "slide_of(0)");
    expect(rtx_deck_slide_of(&k, k.s[1].sep) == 1, "slide_of(separator) = the slide it opens");
    expect(rtx_deck_slide_of(&k, n - 1) == 3, "slide_of(end)");

    /* A prefix: the index stops; past it nothing is guessed. */
    {
        size_t cut = (size_t)(strstr(deck1, "```\n---") - deck1) + 6;
        rtx_deck_build(&k, deck1, cut, 0);
        expect(k.n == 3 && !k.complete, "prefix inside a fence: three slides so far");
        expect(rtx_deck_slide_of(&k, cut + 2) == -1, "past the prefix: unknown");
        expect(rtx_deck_slide_of(&k, cut - 1) == 2, "inside the prefix: slide 3");
    }

    /* headingDivider. */
    {
        static const char hd[] =
            "---\nmarp: true\nheadingDivider: 2\n---\n# A\ntext\n## B\n### c\n## D\n---\n## E\n";
        rtx_deck_build(&k, hd, strlen(hd), 1);
        expect(k.n == 4, "headingDivider 2: A, B(+c), D, E");
        if (k.n == 4) {
            expect(memcmp(hd + k.s[1].lo, "## B", 4) == 0, "headingDivider: slide at ## B");
            expect(memcmp(hd + k.s[3].title_lo, "E", 1) == 0, "headingDivider: --- still splits");
        }
    }
    /* Not a deck. */
    rtx_deck_build(&k, "# x\n---\n", 8, 1);
    expect(!k.marp && k.n == 0, "no front matter: not a deck");
    rtx_deck_free(&k);

    {
        int ms = 0;
        expect(rtx_slide_transition("slide", 5, &ms) == RTX_TR_SLIDE && ms == RTX_TR_DEFAULT_MS,
               "transition slide");
        expect(rtx_slide_transition("\"cube 1s\"", 9, &ms) == RTX_TR_PUSH && ms == 1000,
               "transition cube 1s -> push");
        expect(rtx_slide_transition("sparkle", 7, &ms) == RTX_TR_FADE, "unknown -> fade");
        expect(rtx_slide_transition("none", 4, &ms) == RTX_TR_NONE, "none");
    }
    {
        uint32_t c = 0;
        expect(rtx_slide_color("#ff8000", 7, &c) && c == 0xff8000, "color #ff8000");
        expect(rtx_slide_color(" navy ", 6, &c) && c == 0x000080, "color navy");
        expect(!rtx_slide_color("#12", 3, &c), "color #12 is not a colour");
    }
}

static const RtxSlLine *line_kind(const RtxSlideView *v, int kind, int nth) {
    size_t i;
    for (i = 0; i < v->nl; i++) {
        if (v->lines[i].kind == kind && nth-- == 0) return &v->lines[i];
    }
    return NULL;
}

static int line_is(const RtxSlideView *v, const RtxSlLine *l, const char *want) {
    char buf[256];
    if (!l) return 0;
    rtx_sl_line_text(v, l, buf, sizeof buf);
    if (strcmp(buf, want) != 0) {
        fprintf(stderr, "  line text '%s' want '%s'\n", buf, want);
        return 0;
    }
    return 1;
}

static void demo_checks(void) {
    RtxDoc d = {0} @destroy;
    RtxSlideView v = {0};
    const RtxDeck *k;
    const RtxSlLine *l;
    RtxPresent *p = rtx_present();
    char st[64];
    long now = 1000;
    size_t caret;
    @errhandler(CCError e) {
        (void)e;
        expect(0, "demo: open");
        return;
    }
    d.from_path("testdata/slides/demo.md") !>;
    expect(RtxDoc_marp(&d), "demo: RtxDoc_marp");
    k = rtx_deck_for(&d);
    expect(k && k->n == 11, "demo: eleven slides");
    if (!k || k->n != 11) {
        if (k) fprintf(stderr, "demo slides %zu\n", k->n);
        return;
    }
    expect(k->s[1].nfrag == 4 && k->s[2].nfrag == 3, "demo: build steps 4 and 3");
    expect(k->s[0].dir.paginate == 0 && k->s[1].dir.paginate == 1, "demo: _paginate false");
    expect(k->s[5].nbg == 1 && k->s[5].bg_side == 1 && k->s[5].bg_pct == 40,
           "demo: bg left:40%");
    expect(k->s[4].dir.bg_set && k->s[4].dir.bg == 0x1e1e2e && !k->s[5].dir.bg_set,
           "demo: spot backgroundColor");
    expect(k->s[9].dir.trans == RTX_TR_MORPH, "demo: morph carries to the next slide");
    rtx_slides_status(&d, k->s[3].lo + 2, st, sizeof st);
    expect(strcmp(st, "slide 4/11") == 0, "status: slide 4/11");
    {
        RtxOutlineEnt ol[16];
        size_t on = rtx_deck_outline(&d, ol, 16);
        expect(on == 11, "outline: one entry per slide");
        if (on == 11)
            expect(ol[1].title_hi - ol[1].title_lo == 11, "outline: slide 2 title 'Build steps'");
    }

    /* Slide 2: heading, a paragraph with inline code, four stepped items. */
    expect(rtx_slide_view(&d, 1, &v), "view slide 2");
    l = line_kind(&v, RTX_SL_HEAD, 0);
    expect(l && l->level == 2 && line_is(&v, l, "Build steps"), "slide 2 heading");
    l = line_kind(&v, RTX_SL_PARA, 0);
    expect(line_is(&v, l, "A fragmented list (*) appears one item at a time:"),
           "slide 2 paragraph: backticks hidden");
    l = line_kind(&v, RTX_SL_ITEM, 3);
    expect(l && l->frag == 4 && line_is(&v, l, "And finally, slides"), "slide 2 item 4: step 4");
    expect(v.nfrag == 4, "slide 2 view: four steps");
    expect(line_kind(&v, RTX_SL_ITEM, 0) && line_kind(&v, RTX_SL_ITEM, 0)->frag == 1,
           "slide 2 item 1: step 1");
    /* Slide 3: `1)` steps, `1.` always shown. */
    expect(rtx_slide_view(&d, 2, &v), "view slide 3");
    l = line_kind(&v, RTX_SL_ITEM, 3);
    expect(l && l->frag == 0 && l->ordered && strcmp(l->marker, "1.") == 0,
           "slide 3: 1. list is always shown");
    l = line_kind(&v, RTX_SL_ITEM, 2);
    expect(l && l->frag == 3 && strcmp(l->marker, "3.") == 0, "slide 3: 3) is step 3, drawn 3.");
    /* Slide 4: the fence, --- inside it is code. */
    expect(rtx_slide_view(&d, 3, &v), "view slide 4");
    l = line_kind(&v, RTX_SL_CODE, 0);
    expect(line_is(&v, l, "/* a --- inside a fence is not a slide break */"), "slide 4 code line");
    l = line_kind(&v, RTX_SL_CODE, 2);
    expect(line_is(&v, l, "    const char *sep = \"---\";"), "slide 4 code keeps indent");
    {
        size_t g;
        int coloured = 0;
        l = line_kind(&v, RTX_SL_CODE, 1);
        for (g = l ? l->seg0 : 0; l && g < l->seg0 + l->nseg; g++)
            if (v.segs[g].st.scope) coloured = 1;
        expect(coloured, "slide 4 code has grammar scopes");
    }
    /* Slide 5: table header, alignment, rows. */
    expect(rtx_slide_view(&d, 4, &v), "view slide 5");
    l = line_kind(&v, RTX_SL_ROW, 0);
    expect(l && l->header && l->ncells == 3 && line_is(&v, l, "Transition | Kind | Drawn as"),
           "slide 5 table header");
    expect(v.talign[1] == RTX_MD_ALIGN_CENTER && v.talign[2] == RTX_MD_ALIGN_RIGHT,
           "slide 5 alignment");
    l = line_kind(&v, RTX_SL_ROW, 3);
    expect(l && !l->header && line_is(&v, l, "push | motion | pushed out"), "slide 5 last row");
    l = line_kind(&v, RTX_SL_PARA, 0);
    expect(l && l->quote == 1, "slide 5 quote depth");
    /* Slide 6: the bg image is not a line. */
    expect(rtx_slide_view(&d, 5, &v), "view slide 6");
    expect(!line_kind(&v, RTX_SL_IMAGE, 0), "slide 6: bg image is not content");
    /* Slide 7: content image; bold / link text. */
    expect(rtx_slide_view(&d, 6, &v), "view slide 7");
    l = line_kind(&v, RTX_SL_IMAGE, 0);
    expect(l && l->nseg == 2, "slide 7: content image (alt, src)");
    l = line_kind(&v, RTX_SL_PARA, 0);
    expect(line_is(&v, l, "Bold, italic, strike, code and a link"), "slide 7: marks hidden");
    /* Slide 8: the note comment is not drawn. */
    expect(rtx_slide_view(&d, 7, &v), "view slide 8");
    expect(v.nl == 3, "slide 8: heading, blank, text (note hidden)");
    /* Slide 11: setext under a paragraph is a heading, not a slide. */
    expect(rtx_slide_view(&d, 10, &v), "view slide 11");
    l = line_kind(&v, RTX_SL_HEAD, 1);
    expect(l && l->level == 2 && line_is(&v, l, "Setext title"), "slide 11: setext h2");
    rtx_slide_view_free(&v);

    /* Presenter. */
    expect(rtx_present_start(p, &d, k->s[1].lo + 3, now), "present: start");
    expect(p->slide == 1 && p->step == 0, "present: starts at the caret's slide");
    expect(rtx_present_wait_ms(p, now) == -1, "present: idle wait is -1");
    expect(rtx_present_key(p, &d, 0, ' ', now) == RTX_PK_MOVE && p->step == 1 &&
           p->tr == RTX_TR_FRAG, "present: space shows step 1 (fragment fade)");
    expect(rtx_present_wait_ms(p, now + 5) > 0, "present: animating wait > 0");
    expect(rtx_present_tick(p, now + 5) == 1, "present: still animating");
    expect(rtx_present_tick(p, now + RTX_TR_FRAG_MS) == 0 && p->tr == 0, "present: frag done");
    expect(rtx_present_wait_ms(p, now + RTX_TR_FRAG_MS) == -1, "present: idle again");
    now += 1000;
    rtx_present_key(p, &d, RTX_KEY_RIGHT, 0, now);
    rtx_present_key(p, &d, RTX_KEY_PGDN, 0, now);
    rtx_present_key(p, &d, RTX_KEY_DOWN, 0, now);
    expect(p->slide == 1 && p->step == 4, "present: four steps");
    expect(rtx_present_next(p, &d, now) == RTX_PK_MOVE && p->slide == 2 && p->step == 0 &&
           p->tr == RTX_TR_SLIDE && p->dir == 1, "present: next slide with its slide transition");
    expect(rtx_present_prev(p, &d, now) == RTX_PK_MOVE && p->slide == 1 && p->step == 4 &&
           p->tr == RTX_TR_SLIDE && p->dir == -1,
           "present: back shows every step, leaving slide's transition reversed");
    expect(rtx_present_key(p, &d, RTX_KEY_LEFT, 0, now) == RTX_PK_MOVE && p->step == 3 &&
           p->tr == RTX_TR_NONE, "present: back one step, no animation");
    rtx_present_key(p, &d, 0, '7', now);
    expect(rtx_present_key(p, &d, RTX_KEY_ENTER, 0, now) == RTX_PK_MOVE && p->slide == 6 &&
           p->tr == RTX_TR_WIPE, "present: 7 Enter goes to slide 7 (wipe)");
    expect(rtx_present_key(p, &d, RTX_KEY_END, 0, now) == RTX_PK_MOVE && p->slide == 10,
           "present: End");
    expect(rtx_present_next(p, &d, now) == RTX_PK_SAME, "present: next at the end stays");
    expect(rtx_present_key(p, &d, RTX_KEY_HOME, 0, now) == RTX_PK_MOVE && p->slide == 0 &&
           p->tr == RTX_TR_FADE_OUT && p->dir == -1,
           "present: Home (the left slide's fade-out, reversed)");
    rtx_present_key(p, &d, 0, '4', now);
    expect(rtx_present_key(p, &d, RTX_KEY_ESC, 0, now) == RTX_PK_SAME && p->num_len == 0,
           "present: Esc clears a typed number first");
    expect(rtx_present_key(p, &d, 0, 'x', now) == RTX_PK_NONE, "present: other keys unused");
    rtx_present_goto(p, &d, 3, 0, now);
    expect(rtx_present_key(p, &d, RTX_KEY_ESC, 0, now) == RTX_PK_EXIT, "present: Esc exits");
    caret = rtx_present_stop(p, &d);
    expect(caret == k->s[3].lo + 1 && !p->on,
           "present: stop puts the caret on the slide's first text line");

    /* Turning marp off in the front matter: no deck, a relex. */
    {
        size_t at = 4; /* "marp: true" */
        d.replace(at + 6, 4, cc_slice_cstr("fals")) !>;
        expect(!RtxDoc_marp(&d) && rtx_deck_for(&d) == NULL, "edit: marp: fals is no deck");
        d.replace(at + 6, 4, cc_slice_cstr("true")) !>;
        k = rtx_deck_for(&d);
        expect(k && k->n == 11, "edit: back to a deck");
    }
}

/* A deck past RTX_HL_FULL_MAX: a middle slide is lexed as a window. */
static void big_checks(void) {
    const char *path = "testdata/generated/slides_big.md";
    RtxDoc d = {0} @destroy;
    RtxSlideView v = {0};
    const RtxDeck *k;
    FILE *fp;
    int i;
    @errhandler(CCError e) {
        (void)e;
        expect(0, "big: open");
        return;
    }
    if (system("mkdir -p testdata/generated") != 0) expect(0, "mkdir");
    fp = fopen(path, "w");
    if (!fp) {
        expect(0, "big: write");
        return;
    }
    fputs("---\nmarp: true\n---\n\n", fp);
    for (i = 0; i < 3000; i++) {
        fprintf(fp, "# Slide %d\n\n* step one of %d\n* step **two**\n\n```js\nlet x = %d; // ---\n---\n```\n\n---\n\n",
                i + 1, i + 1, i);
    }
    fputs("# Last\n", fp);
    fclose(fp);
    d.from_path(cc_slice_cstr(path)) !>;
    expect(d.len() > (size_t)RTX_HL_FULL_MAX, "big: past the whole-file lex");
    {
        struct timespec t0, t1;
        double ms;
        clock_gettime(CLOCK_MONOTONIC, &t0);
        k = rtx_deck_for(&d);
        clock_gettime(CLOCK_MONOTONIC, &t1);
        ms = (double)(t1.tv_sec - t0.tv_sec) * 1e3 + (double)(t1.tv_nsec - t0.tv_nsec) / 1e6;
        printf("slides_smoke: deck index %zu KiB, %zu slides: %.2f ms\n", d.len() >> 10,
               k ? k->n : 0, ms);
    }
    expect(k && k->n == 3001 && k->complete, "big: 3001 slides");
    if (!k || k->n != 3001) return;
    expect(k->s[1500].nfrag == 2, "big: slide 1501 has two steps");
    expect(rtx_slide_view(&d, 1500, &v), "big: view a middle slide");
    {
        const RtxSlLine *l = line_kind(&v, RTX_SL_HEAD, 0);
        expect(line_is(&v, l, "Slide 1501"), "big: its heading");
        l = line_kind(&v, RTX_SL_ITEM, 1);
        expect(l && l->frag == 2 && line_is(&v, l, "step two"), "big: bold hidden, step 2");
        l = line_kind(&v, RTX_SL_CODE, 1);
        expect(line_is(&v, l, "---"), "big: --- inside the fence is a code line");
        {
            size_t g;
            int bold = 0;
            l = line_kind(&v, RTX_SL_ITEM, 1);
            for (g = l ? l->seg0 : 0; l && g < l->seg0 + l->nseg; g++)
                if (v.segs[g].st.bold) bold = 1;
            expect(bold, "big: window lex styled the middle slide");
        }
    }
    rtx_slide_view_free(&v);
}

int main(void) {
    block_checks();
    deck_checks();
    demo_checks();
    big_checks();
    if (fails) {
        fprintf(stderr, "%d failure(s)\n", fails);
        return 1;
    }
    printf("slides_smoke ok\n");
    return 0;
}
