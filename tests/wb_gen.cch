#!ccc cch
/*
 * Giant-workbook generator for the W2 scale smoke and perf tool
 * (docs/workbook.md "W2 at scale"). Header-only: each test includes it.
 *
 * One `*.wb.md` of `rows` rows in table Big:
 *
 *   | id | key | a | b | c | d | e | f1 | f2 |
 *
 * id int, key text (EU / US / APAC / LATAM / MEA), a int (0..999), b dec(2),
 * c float with awkward values (0.1, 1e-300, -2.5e10, 1e300, 3.14159, -0.5,
 * 7e-5), d date, e int; f1 = `=@a * @b`, f2 = `=@f1 + @c` per row. Params
 * k / asof / lim that predicates read; calc aggregates: `nagg_a` over
 * column a (sum with a where on id, or avg / count / max), `nagg_b` over b,
 * one over e, a group by key, lookups into it, and a chain of `chain` names.
 */
#ifndef RTX_WB_GEN_H
#define RTX_WB_GEN_H

#include <stdio.h>
#include <stdlib.h>
#include <string.h>

typedef struct {
    int rows;
    int nagg_a;  /* aggregates reading column a */
    int nagg_b;  /* ... column b */
    int chain;   /* calc names chained after the aggregates */
} WbGen;

static const char *const g_wbgen_keys[] = {"EU", "US", "APAC", "LATAM", "MEA"};
static const char *const g_wbgen_c[] = {"0.1", "1e-300", "-2.5e10", "1e300", "3.14159", "-0.5",
                                        "7e-5"};

/* The row line for row r (1-based id), into buf; its length. */
static size_t wbgen_row(char *buf, size_t cap, long r) {
    int n = snprintf(buf, cap, "| %ld | %s | %ld | %ld.%02ld | %s | 2026-%02ld-%02ld | %ld | =@a * @b | =@f1 + @c |\n",
                     r, g_wbgen_keys[r % 5], (r * 37) % 1000, (r * 13) % 10000, (r * 7) % 100,
                     g_wbgen_c[r % 7], 1 + (r % 12), 1 + (r % 28), (r * 3) % 97);
    return n > 0 ? (size_t)n : 0;
}

/* Malloc'd workbook text; *out_n its length. */
static char *wbgen(const WbGen *g, size_t *out_n) {
    size_t cap = (size_t)g->rows * 96 + (size_t)(g->nagg_a + g->nagg_b + g->chain) * 72 + 8192;
    size_t n = 0;
    char *p = (char *)malloc(cap);
    long r;
    int i;
    if (!p) return NULL;
#define WBG(...) n += (size_t)snprintf(p + n, cap - n, __VA_ARGS__)
    WBG("# Scale\n\nA generated workbook: one big table, row formulas, aggregates, a group.\n\n"
        "```params\nk = 500\nasof = 2026-06-01\nlim = 0.5\n```\n\nTable: Big\n\n"
        "| id | key | a | b | c | d | e | f1 | f2 |\n"
        "|----|-----|---|---|---|---|---|----|----|\n");
    for (r = 1; r <= g->rows; r++) n += wbgen_row(p + n, cap - n, r);
    WBG("\nProse between the table and the names.\n\n```calc\n");
    WBG("total = sum(Big.f1)\n");
    WBG("n_big = count(Big where a > k)\n");
    WBG("avg_b = avg(Big.b where d >= asof)\n");
    WBG("top_c = max(Big.c)\n");
    WBG("low_b = min(Big.b where c > lim)\n");
    WBG("sum_c = sum(Big.c)\n");
    WBG("sum_f2 = sum?(Big.f2)\n");
    WBG("keys = distinct(Big.key)\n");
    WBG("by_key = group Big by key { n: count(), s: sum(b), hi: max(c), lo: min(a) }\n");
    WBG("eu = by_key[key = \"EU\"].s\n");
    WBG("us_hi = by_key[key = \"US\"].hi\n");
    WBG("e_one = sum(Big.e)\n");
    for (i = 0; i < g->nagg_a; i++) {
        switch (i % 4) {
        case 0: WBG("a%d = sum(Big.a where id > %d)\n", i, (i * 7919) % (g->rows ? g->rows : 1)); break;
        case 1: WBG("a%d = avg(Big.a where key = \"%s\")\n", i, g_wbgen_keys[i % 5]); break;
        case 2: WBG("a%d = count(Big where a > %d)\n", i, (i * 31) % 1000); break;
        default: WBG("a%d = max(Big.a where id <= %d)\n", i, 1 + (i * 104729) % (g->rows ? g->rows : 1)); break;
        }
    }
    for (i = 0; i < g->nagg_b; i++)
        WBG("b%d = sum(Big.b where a > %d)\n", i, (i * 17) % 1000);
    WBG("chain0 = total + n_big\n");
    for (i = 1; i < g->chain; i++) WBG("chain%d = chain%d + %d\n", i, i - 1, i);
    WBG("```\n\nTail prose.\n");
#undef WBG
    *out_n = n;
    return p;
}

#endif /* RTX_WB_GEN_H */
