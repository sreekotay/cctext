{
  "name": "Python",
  "scopeName": "source.python",
  "fileTypes": ["py"],
  "patterns": [
    {
      "name": "",
      "match": "",
      "begin": "",
      "end": "",
      "include": "#comment"
    },
    {
      "name": "",
      "match": "",
      "begin": "",
      "end": "",
      "include": "#dstring"
    },
    {
      "name": "",
      "match": "",
      "begin": "",
      "end": "",
      "include": "#sstring"
    },
    {
      "name": "",
      "match": "",
      "begin": "",
      "end": "",
      "include": "#numbers"
    },
    {
      "name": "",
      "match": "",
      "begin": "",
      "end": "",
      "include": "#keywords"
    }
  ],
  "repository": {
    "comment": {
      "name": "comment.line.number-sign.python",
      "match": "#.*",
      "begin": "",
      "end": "",
      "include": ""
    },
    "dstring": {
      "name": "string.quoted.double.python",
      "match": "",
      "begin": "\"",
      "end": "\"",
      "include": ""
    },
    "sstring": {
      "name": "string.quoted.single.python",
      "match": "",
      "begin": "'",
      "end": "'",
      "include": ""
    },
    "numbers": {
      "name": "constant.numeric.python",
      "match": "\\b[0-9]+\\b",
      "begin": "",
      "end": "",
      "include": ""
    },
    "keywords": {
      "name": "keyword.control.python",
      "match": "\\b(def|class|return|if|else|elif|for|while|import|from|as|with|try|except|finally|raise|pass|break|continue|in|not|and|or|lambda|yield|None|True|False)\\b",
      "begin": "",
      "end": "",
      "include": ""
    }
  }
}
