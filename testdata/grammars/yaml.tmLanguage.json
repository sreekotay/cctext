{
  "name": "YAML",
  "scopeName": "source.yaml",
  "fileTypes": ["yml", "yaml"],
  "patterns": [
    {
      "name": "",
      "match": "",
      "begin": "",
      "end": "",
      "include": "#comment"
    },
    {
      "name": "",
      "match": "",
      "begin": "",
      "end": "",
      "include": "#string"
    },
    {
      "name": "",
      "match": "",
      "begin": "",
      "end": "",
      "include": "#number"
    },
    {
      "name": "",
      "match": "",
      "begin": "",
      "end": "",
      "include": "#keyword"
    },
    {
      "name": "",
      "match": "",
      "begin": "",
      "end": "",
      "include": "#key"
    }
  ],
  "repository": {
    "comment": {
      "name": "comment.line.number-sign.yaml",
      "match": "#.*",
      "begin": "",
      "end": "",
      "include": ""
    },
    "string": {
      "name": "string.quoted.double.yaml",
      "match": "",
      "begin": "\"",
      "end": "\"",
      "include": ""
    },
    "number": {
      "name": "constant.numeric.yaml",
      "match": "-?[0-9]+(\\.[0-9]+)?",
      "begin": "",
      "end": "",
      "include": ""
    },
    "keyword": {
      "name": "keyword.constant.yaml",
      "match": "\\b(true|false|null|yes|no|on|off)\\b",
      "begin": "",
      "end": "",
      "include": ""
    },
    "key": {
      "name": "entity.name.tag.yaml",
      "match": "^[ \\t]*[A-Za-z0-9_.-]+\\s*:",
      "begin": "",
      "end": "",
      "include": ""
    }
  }
}
