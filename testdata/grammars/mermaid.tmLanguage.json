{
  "name": "Mermaid",
  "scopeName": "source.mermaid",
  "fileTypes": ["mermaid", "mmd"],
  "patterns": [
    { "name": "", "match": "", "begin": "", "end": "", "include": "#comment" },
    { "name": "", "match": "", "begin": "", "end": "", "include": "#string" },
    { "name": "", "match": "", "begin": "", "end": "", "include": "#diagram" },
    { "name": "", "match": "", "begin": "", "end": "", "include": "#keyword" },
    { "name": "", "match": "", "begin": "", "end": "", "include": "#classref" },
    { "name": "", "match": "", "begin": "", "end": "", "include": "#arrow" },
    { "name": "", "match": "", "begin": "", "end": "", "include": "#bracket" },
    { "name": "", "match": "", "begin": "", "end": "", "include": "#number" }
  ],
  "repository": {
    "comment": {
      "name": "comment.line.percentage.mermaid",
      "match": "%%.*",
      "begin": "",
      "end": "",
      "include": ""
    },
    "string": {
      "name": "string.quoted.double.mermaid",
      "match": "",
      "begin": "\"",
      "end": "\"",
      "include": ""
    },
    "diagram": {
      "name": "keyword.control.diagram.mermaid",
      "match": "^[ \\t]*(graph|flowchart-elk|flowchart|sequenceDiagram|classDiagram-v2|classDiagram|stateDiagram-v2|stateDiagram|erDiagram|journey|gantt|pie|quadrantChart|requirementDiagram|gitGraph|C4Context|C4Container|C4Component|C4Dynamic|C4Deployment|mindmap|timeline|zenuml|sankey-beta|sankey|xychart-beta|xychart|block-beta|block|packet-beta|packet|kanban|architecture-beta|architecture|radar-beta|treemap-beta|treemap|info)\\b",
      "begin": "",
      "end": "",
      "include": ""
    },
    "keyword": {
      "name": "keyword.other.mermaid",
      "match": "\\b(subgraph|end|direction|TB|TD|BT|RL|LR|participant|actor|loop|alt|else|opt|par|and|critical|break|rect|note|Note|over|left of|right of|activate|deactivate|autonumber|as|class|classDef|style|linkStyle|click|state|section|title|dateFormat|axisFormat|tickInterval|excludes|includes|todayMarker|accTitle|accDescr|commit|branch|checkout|merge|namespace|showData|x-axis|y-axis|quadrant-[1-4])\\b",
      "begin": "",
      "end": "",
      "include": ""
    },
    "classref": {
      "name": "entity.name.type.class.mermaid",
      "match": ":::[A-Za-z_][A-Za-z0-9_-]*",
      "begin": "",
      "end": "",
      "include": ""
    },
    "arrow": {
      "name": "keyword.operator.arrow.mermaid",
      "match": "<\\|--|--\\|>|<<?-{1,2}>>?|-{1,2}>>|([|}][|o])?<?[-=.]{2,}[>xo*]?([o|][|{])?|-[x)>]",
      "begin": "",
      "end": "",
      "include": ""
    },
    "bracket": {
      "name": "punctuation.definition.node.mermaid",
      "match": "[\\[\\](){}>]",
      "begin": "",
      "end": "",
      "include": ""
    },
    "number": {
      "name": "constant.numeric.mermaid",
      "match": "\\b[0-9]+(\\.[0-9]+)?\\b",
      "begin": "",
      "end": "",
      "include": ""
    }
  }
}
