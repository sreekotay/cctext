{
  "name": "C",
  "scopeName": "source.c",
  "fileTypes": ["c", "h", "ccs", "cch", "cc"],
  "patterns": [
    {
      "name": "",
      "match": "",
      "begin": "",
      "end": "",
      "include": "#comments"
    },
    {
      "name": "",
      "match": "",
      "begin": "",
      "end": "",
      "include": "#block"
    },
    {
      "name": "",
      "match": "",
      "begin": "",
      "end": "",
      "include": "#strings"
    },
    {
      "name": "",
      "match": "",
      "begin": "",
      "end": "",
      "include": "#chars"
    },
    {
      "name": "",
      "match": "",
      "begin": "",
      "end": "",
      "include": "#numbers"
    },
    {
      "name": "",
      "match": "",
      "begin": "",
      "end": "",
      "include": "#keywords"
    },
    {
      "name": "keyword.control.directive.c",
      "match": "#[ \\t]*(include|define|ifdef|ifndef|endif|pragma)\\b",
      "begin": "",
      "end": "",
      "include": ""
    }
  ],
  "repository": {
    "comments": {
      "name": "comment.line.double-slash.c",
      "match": "//.*",
      "begin": "",
      "end": "",
      "include": ""
    },
    "block": {
      "name": "comment.block.c",
      "match": "",
      "begin": "/*",
      "end": "*/",
      "include": ""
    },
    "strings": {
      "name": "string.quoted.double.c",
      "match": "",
      "begin": "\"",
      "end": "\"",
      "include": "",
      "patterns": [
        {
          "name": "constant.character.escape.c",
          "match": "\\\\.",
          "begin": "",
          "end": "",
          "include": ""
        }
      ]
    },
    "chars": {
      "name": "string.quoted.single.c",
      "match": "",
      "begin": "'",
      "end": "'",
      "include": ""
    },
    "numbers": {
      "name": "constant.numeric.c",
      "match": "\\b[0-9]+\\b",
      "begin": "",
      "end": "",
      "include": ""
    },
    "keywords": {
      "name": "keyword.control.c",
      "match": "\\b(int|void|return|if|else|for|while|do|struct|typedef|static|const|char|size_t|unsigned|long|short|enum|union|sizeof|break|continue|switch|case|default|goto|extern|inline|bool|true|false|NULL)\\b",
      "begin": "",
      "end": "",
      "include": ""
    }
  }
}
