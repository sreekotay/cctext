{
  "name": "Markdown",
  "scopeName": "text.markdown",
  "fileTypes": ["md", "markdown"],
  "cctext": { "kind": "markup", "blocks": "commonmark" },
  "patterns": [
    { "name": "", "match": "", "begin": "", "end": "", "include": "#fence" },
    { "name": "", "match": "", "begin": "", "end": "", "include": "#heading" },
    { "name": "", "match": "", "begin": "", "end": "", "include": "#quote" },
    { "name": "", "match": "", "begin": "", "end": "", "include": "#list" },
    { "name": "", "match": "", "begin": "", "end": "", "include": "#list_num" },
    { "name": "", "match": "", "begin": "", "end": "", "include": "#list_paren" },
    { "name": "", "match": "", "begin": "", "end": "", "include": "#heading_close" },
    { "name": "", "match": "", "begin": "", "end": "", "include": "#setext" },
    { "name": "", "match": "", "begin": "", "end": "", "include": "#task" },
    { "name": "", "match": "", "begin": "", "end": "", "include": "#hr" },
    { "name": "", "match": "", "begin": "", "end": "", "include": "#code_block" },
    { "name": "", "match": "", "begin": "", "end": "", "include": "#html_block" },
    { "name": "", "match": "", "begin": "", "end": "", "include": "#math_block" },
    { "name": "", "match": "", "begin": "", "end": "", "include": "#front_matter" },
    { "name": "", "match": "", "begin": "", "end": "", "include": "#ref_def" },
    { "name": "", "match": "", "begin": "", "end": "", "include": "#ref_def_dest" },
    { "name": "", "match": "", "begin": "", "end": "", "include": "#foot_def" },
    { "name": "", "match": "", "begin": "", "end": "", "include": "#escape" },
    { "name": "", "match": "", "begin": "", "end": "", "include": "#break_bs" },
    { "name": "", "match": "", "begin": "", "end": "", "include": "#break_sp" },
    { "name": "", "match": "", "begin": "", "end": "", "include": "#code_n" },
    { "name": "", "match": "", "begin": "", "end": "", "include": "#code" },
    { "name": "", "match": "", "begin": "", "end": "", "include": "#math" },
    { "name": "", "match": "", "begin": "", "end": "", "include": "#autolink" },
    { "name": "", "match": "", "begin": "", "end": "", "include": "#autolink_mail" },
    { "name": "", "match": "", "begin": "", "end": "", "include": "#html_comment" },
    { "name": "", "match": "", "begin": "", "end": "", "include": "#html_tag" },
    { "name": "", "match": "", "begin": "", "end": "", "include": "#image" },
    { "name": "", "match": "", "begin": "", "end": "", "include": "#wikilink" },
    { "name": "", "match": "", "begin": "", "end": "", "include": "#footnote" },
    { "name": "", "match": "", "begin": "", "end": "", "include": "#link_label" },
    { "name": "", "match": "", "begin": "", "end": "", "include": "#link_dest" },
    { "name": "", "match": "", "begin": "", "end": "", "include": "#ref_dest" },
    { "name": "", "match": "", "begin": "", "end": "", "include": "#strike" },
    { "name": "", "match": "", "begin": "", "end": "", "include": "#highlight" },
    { "name": "", "match": "", "begin": "", "end": "", "include": "#bold" },
    { "name": "", "match": "", "begin": "", "end": "", "include": "#bold_u" },
    { "name": "", "match": "", "begin": "", "end": "", "include": "#italic" },
    { "name": "", "match": "", "begin": "", "end": "", "include": "#italic_u" },
    { "name": "", "match": "", "begin": "", "end": "", "include": "#url" },
    { "name": "", "match": "", "begin": "", "end": "", "include": "#entity" }
  ],
  "repository": {
    "fence": {
      "name": "markup.raw.block.markdown",
      "match": "",
      "begin": "```",
      "end": "```",
      "include": "",
      "cctext": { "bol": true, "info": true, "block": "fence" }
    },
    "heading": {
      "name": "markup.heading.markdown",
      "match": "",
      "begin": "#{1,6}[ \\t]*",
      "end": "\n",
      "include": "",
      "cctext": { "bol": true, "arity": "prefix", "apply": "heading", "insert": "#", "max": 6, "block": "heading" },
      "patterns": [
        { "name": "", "match": "", "begin": "", "end": "", "include": "#bold" },
        { "name": "", "match": "", "begin": "", "end": "", "include": "#italic" },
        { "name": "", "match": "", "begin": "", "end": "", "include": "#code" },
        { "name": "", "match": "", "begin": "", "end": "", "include": "#link_label" },
        { "name": "", "match": "", "begin": "", "end": "", "include": "#link_dest" },
        { "name": "", "match": "", "begin": "", "end": "", "include": "#heading_trail" }
      ]
    },
    "heading_trail": {
      "name": "markup.heading.markdown",
      "match": "[ \\t]+#+$",
      "begin": "",
      "end": "",
      "include": "",
      "cctext": { "arity": "prefix", "apply": "heading", "insert": "#", "max": 6 }
    },
    "heading_close": {
      "name": "markup.heading.markdown",
      "cctext": { "arity": "prefix", "apply": "heading", "insert": "#", "max": 6, "block": "heading_close" }
    },
    "setext": {
      "name": "punctuation.definition.heading.setext.markdown",
      "cctext": { "arity": "prefix", "block": "setext" }
    },
    "quote": {
      "name": "markup.quote.markdown",
      "match": "",
      "begin": "[ \\t]{0,3}>([ \\t]*>)*[ \\t]*",
      "end": "\n",
      "include": "",
      "cctext": { "bol": true, "arity": "prefix", "apply": "quote", "insert": ">", "max": 6, "block": "quote" },
      "patterns": [
        { "name": "", "match": "", "begin": "", "end": "", "include": "#heading" },
        { "name": "", "match": "", "begin": "", "end": "", "include": "#list" },
        { "name": "", "match": "", "begin": "", "end": "", "include": "#list_num" },
        { "name": "", "match": "", "begin": "", "end": "", "include": "#list_paren" },
        { "name": "", "match": "", "begin": "", "end": "", "include": "#bold" },
        { "name": "", "match": "", "begin": "", "end": "", "include": "#italic" },
        { "name": "", "match": "", "begin": "", "end": "", "include": "#code" },
        { "name": "", "match": "", "begin": "", "end": "", "include": "#link_label" },
        { "name": "", "match": "", "begin": "", "end": "", "include": "#link_dest" }
      ]
    },
    "list": {
      "name": "markup.list.markdown",
      "match": "",
      "begin": "[ \\t]*[-*+][ \\t]+",
      "end": "\n",
      "include": "",
      "cctext": { "bol": true, "arity": "prefix", "apply": "list", "insert": "- ", "max": 1, "block": "list" },
      "patterns": [
        { "name": "", "match": "", "begin": "", "end": "", "include": "#task_box" },
        { "name": "", "match": "", "begin": "", "end": "", "include": "#bold" },
        { "name": "", "match": "", "begin": "", "end": "", "include": "#italic" },
        { "name": "", "match": "", "begin": "", "end": "", "include": "#code" },
        { "name": "", "match": "", "begin": "", "end": "", "include": "#link_label" },
        { "name": "", "match": "", "begin": "", "end": "", "include": "#link_dest" }
      ]
    },
    "list_num": {
      "name": "markup.list.markdown",
      "match": "",
      "begin": "[ \\t]*[0-9]{1,9}[.][ \\t]+",
      "end": "\n",
      "include": "",
      "cctext": { "bol": true, "arity": "prefix", "apply": "list", "insert": "- ", "max": 1 },
      "patterns": [
        { "name": "", "match": "", "begin": "", "end": "", "include": "#task_box" },
        { "name": "", "match": "", "begin": "", "end": "", "include": "#bold" },
        { "name": "", "match": "", "begin": "", "end": "", "include": "#italic" },
        { "name": "", "match": "", "begin": "", "end": "", "include": "#code" },
        { "name": "", "match": "", "begin": "", "end": "", "include": "#link_label" },
        { "name": "", "match": "", "begin": "", "end": "", "include": "#link_dest" }
      ]
    },
    "list_paren": {
      "name": "markup.list.markdown",
      "match": "",
      "begin": "[ \\t]*[0-9]{1,9}[)][ \\t]+",
      "end": "\n",
      "include": "",
      "cctext": { "bol": true, "arity": "prefix", "apply": "list", "insert": "- ", "max": 1 },
      "patterns": [
        { "name": "", "match": "", "begin": "", "end": "", "include": "#task_box" },
        { "name": "", "match": "", "begin": "", "end": "", "include": "#bold" },
        { "name": "", "match": "", "begin": "", "end": "", "include": "#italic" },
        { "name": "", "match": "", "begin": "", "end": "", "include": "#code" },
        { "name": "", "match": "", "begin": "", "end": "", "include": "#link_label" },
        { "name": "", "match": "", "begin": "", "end": "", "include": "#link_dest" }
      ]
    },
    "task_box": {
      "name": "markup.list.task.markdown",
      "match": "\\[[ xX]\\]",
      "begin": "",
      "end": "",
      "include": "",
      "cctext": { "bol": true, "apply": "toggle", "insert": "[ ]/[x]" }
    },
    "task": {
      "name": "markup.list.task.markdown",
      "cctext": { "apply": "toggle", "insert": "[ ]/[x]", "block": "task" }
    },
    "hr": {
      "name": "meta.separator.markdown",
      "cctext": { "block": "hr" }
    },
    "code_block": {
      "name": "markup.raw.block.indented.markdown",
      "cctext": { "block": "code" }
    },
    "html_block": {
      "name": "meta.embedded.block.html.markdown",
      "include": "text.html.basic",
      "cctext": { "block": "html" }
    },
    "math_block": {
      "name": "markup.raw.block.math.markdown",
      "cctext": { "block": "math" }
    },
    "front_matter": {
      "name": "markup.raw.block.frontmatter.markdown",
      "include": "source.yaml",
      "cctext": { "block": "front" }
    },
    "ref_def": {
      "name": "constant.other.reference.link.markdown",
      "cctext": { "block": "ref" }
    },
    "ref_def_dest": {
      "name": "markup.underline.link.reference.markdown",
      "cctext": { "block": "ref_dest" }
    },
    "foot_def": {
      "name": "constant.other.footnote.markdown",
      "cctext": { "block": "foot" }
    },
    "escape": {
      "name": "constant.character.escape.markdown",
      "match": "\\\\[!-/:-@\\[-`{-~]"
    },
    "break_bs": {
      "name": "meta.hardbreak.markdown",
      "match": "\\\\$"
    },
    "break_sp": {
      "name": "meta.hardbreak.markdown",
      "match": " {2,}$"
    },
    "bold": {
      "name": "markup.bold.markdown",
      "match": "",
      "begin": "**",
      "end": "**",
      "include": "",
      "cctext": { "inline": true, "flank": true, "apply": "bold" },
      "patterns": [
        { "include": "$self" }
      ]
    },
    "bold_u": {
      "name": "markup.bold.markdown",
      "begin": "__",
      "end": "__",
      "cctext": { "inline": true, "flank": "under" },
      "patterns": [
        { "include": "$self" }
      ]
    },
    "italic": {
      "name": "markup.italic.markdown",
      "match": "",
      "begin": "*",
      "end": "*",
      "include": "",
      "cctext": { "inline": true, "flank": true, "apply": "italic" },
      "patterns": [
        { "include": "$self" }
      ]
    },
    "italic_u": {
      "name": "markup.italic.markdown",
      "begin": "_",
      "end": "_",
      "cctext": { "inline": true, "flank": "under" },
      "patterns": [
        { "include": "$self" }
      ]
    },
    "strike": {
      "name": "markup.strikethrough.markdown",
      "begin": "~~",
      "end": "~~",
      "cctext": { "inline": true, "flank": true, "apply": "strike" },
      "patterns": [
        { "include": "$self" }
      ]
    },
    "highlight": {
      "name": "markup.highlight.markdown",
      "begin": "==",
      "end": "==",
      "cctext": { "inline": true, "flank": true },
      "patterns": [
        { "include": "$self" }
      ]
    },
    "code": {
      "name": "markup.raw.inline.markdown",
      "match": "",
      "begin": "`",
      "end": "`",
      "include": "",
      "cctext": { "inline": true, "exact": true, "apply": "code" }
    },
    "code_n": {
      "name": "markup.raw.inline.markdown",
      "begin": "(``+)",
      "end": "\\1",
      "cctext": { "inline": true, "exact": true }
    },
    "math": {
      "name": "markup.math.inline.markdown",
      "begin": "$",
      "end": "$",
      "cctext": { "inline": true, "flank": "math", "lit": true, "mono": true }
    },
    "bracket": {
      "name": "",
      "begin": "[",
      "end": "]",
      "cctext": { "inline": true, "lit": true },
      "patterns": [
        { "include": "#code" },
        { "include": "#bold" },
        { "include": "#italic" },
        { "include": "#bracket" }
      ]
    },
    "paren": {
      "name": "",
      "begin": "(",
      "end": ")",
      "cctext": { "inline": true, "lit": true },
      "patterns": [
        { "include": "#paren" }
      ]
    },
    "image": {
      "name": "markup.underline.link.image.markdown",
      "begin": "!\\[",
      "end": "\\](?=[(\\[])",
      "cctext": { "inline": true, "arity": "path", "face": "label", "abort": "]" },
      "patterns": [
        { "include": "#code" },
        { "include": "#bold" },
        { "include": "#italic" },
        { "include": "#bracket" }
      ]
    },
    "link_label": {
      "name": "markup.underline.link.markdown",
      "match": "",
      "begin": "\\[",
      "end": "\\](?=[(\\[])",
      "include": "",
      "cctext": { "inline": true, "arity": "path", "face": "label", "apply": "link", "abort": "]" },
      "patterns": [
        { "include": "#image" },
        { "include": "#code" },
        { "include": "#code_n" },
        { "include": "#bold" },
        { "include": "#italic" },
        { "include": "#strike" },
        { "include": "#bracket" }
      ]
    },
    "link_dest": {
      "name": "markup.underline.link.markdown",
      "match": "",
      "begin": "](",
      "end": ")",
      "include": "",
      "cctext": { "inline": true, "lit": true, "arity": "path", "face": "dest" },
      "patterns": [
        { "include": "#paren" }
      ]
    },
    "ref_dest": {
      "name": "markup.underline.link.markdown",
      "begin": "][",
      "end": "]",
      "cctext": { "inline": true, "lit": true, "arity": "path", "face": "dest" }
    },
    "footnote": {
      "name": "markup.underline.link.footnote.markdown",
      "match": "\\[\\^[^\\]\\s]+\\]"
    },
    "wikilink": {
      "name": "markup.underline.link.wiki.markdown",
      "match": "\\[\\[[^\\]\\[\\n]+\\]\\]",
      "cctext": { "wrap": 2 }
    },
    "autolink": {
      "name": "markup.underline.link.markdown",
      "match": "<[A-Za-z][A-Za-z0-9+.\\-]{1,31}:[^\\s<>]*>",
      "begin": "",
      "end": "",
      "include": "",
      "cctext": { "wrap": 1, "apply": "autolink", "insert": "<>" }
    },
    "autolink_mail": {
      "name": "markup.underline.link.markdown",
      "match": "<[A-Za-z0-9.!#$%&'*+/=?^_`{|}~\\-]+@[A-Za-z0-9](?:[A-Za-z0-9\\-]{0,61}[A-Za-z0-9])?(?:\\.[A-Za-z0-9](?:[A-Za-z0-9\\-]{0,61}[A-Za-z0-9])?)*>",
      "cctext": { "wrap": 1 }
    },
    "html_comment": {
      "name": "comment.block.html.markdown",
      "begin": "<!--",
      "end": "-->"
    },
    "html_tag": {
      "name": "meta.tag.inline.html.markdown",
      "match": "</?[A-Za-z][A-Za-z0-9\\-]*(?:\\s+[A-Za-z_:][A-Za-z0-9_.:\\-]*(?:\\s*=\\s*(?:[^\\s\"'=<>`]+|'[^']*'|\"[^\"]*\"))?)*\\s*/?>"
    },
    "url": {
      "name": "markup.underline.link.url.markdown",
      "match": "(?<![A-Za-z0-9/])(?:https?://|www\\.)[^\\s<]*[^\\s<?!.,:*_~'\")\\]]"
    },
    "entity": {
      "name": "constant.character.entity.markdown",
      "match": "&(?:#[0-9]{1,7}|#[xX][0-9A-Fa-f]{1,6}|[A-Za-z][A-Za-z0-9]{1,31});"
    }
  }
}
