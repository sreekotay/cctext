{
  "name": "Markdown",
  "scopeName": "text.markdown",
  "fileTypes": ["md", "markdown"],
  "cctext": { "kind": "markup" },
  "patterns": [
    {
      "name": "",
      "match": "",
      "begin": "",
      "end": "",
      "include": "#fence"
    },
    {
      "name": "",
      "match": "",
      "begin": "",
      "end": "",
      "include": "#heading"
    },
    {
      "name": "",
      "match": "",
      "begin": "",
      "end": "",
      "include": "#quote"
    },
    {
      "name": "",
      "match": "",
      "begin": "",
      "end": "",
      "include": "#bold"
    },
    {
      "name": "",
      "match": "",
      "begin": "",
      "end": "",
      "include": "#italic"
    },
    {
      "name": "",
      "match": "",
      "begin": "",
      "end": "",
      "include": "#code"
    },
    {
      "name": "",
      "match": "",
      "begin": "",
      "end": "",
      "include": "#link_label"
    },
    {
      "name": "",
      "match": "",
      "begin": "",
      "end": "",
      "include": "#link_dest"
    },
    {
      "name": "",
      "match": "",
      "begin": "",
      "end": "",
      "include": "#autolink"
    }
  ],
  "repository": {
    "fence": {
      "name": "markup.raw.block.markdown",
      "match": "",
      "begin": "```",
      "end": "```",
      "include": "",
      "cctext": { "bol": true, "info": true }
    },
    "heading": {
      "name": "markup.heading.markdown",
      "match": "",
      "begin": "#{1,6}[ \\t]*",
      "end": "\n",
      "include": "",
      "cctext": { "bol": true, "arity": "prefix", "apply": "heading" },
      "patterns": [
        { "name": "", "match": "", "begin": "", "end": "", "include": "#bold" },
        { "name": "", "match": "", "begin": "", "end": "", "include": "#italic" },
        { "name": "", "match": "", "begin": "", "end": "", "include": "#code" },
        { "name": "", "match": "", "begin": "", "end": "", "include": "#link_label" },
        { "name": "", "match": "", "begin": "", "end": "", "include": "#link_dest" },
        { "name": "", "match": "", "begin": "", "end": "", "include": "#heading_trail" }
      ]
    },
    "heading_trail": {
      "name": "markup.heading.markdown",
      "match": "[ \\t]+#+$",
      "begin": "",
      "end": "",
      "include": "",
      "cctext": { "arity": "prefix", "apply": "heading" }
    },
    "quote": {
      "name": "markup.quote.markdown",
      "match": ">.*",
      "begin": "",
      "end": "",
      "include": ""
    },
    "bold": {
      "name": "markup.bold.markdown",
      "match": "",
      "begin": "**",
      "end": "**",
      "include": "",
      "cctext": { "inline": true, "flank": true },
      "patterns": [
        { "name": "", "match": "", "begin": "", "end": "", "include": "#italic" },
        { "name": "", "match": "", "begin": "", "end": "", "include": "#code" },
        { "name": "", "match": "", "begin": "", "end": "", "include": "#link_label" },
        { "name": "", "match": "", "begin": "", "end": "", "include": "#link_dest" }
      ]
    },
    "italic": {
      "name": "markup.italic.markdown",
      "match": "",
      "begin": "*",
      "end": "*",
      "include": "",
      "cctext": { "inline": true, "flank": true },
      "patterns": [
        { "name": "", "match": "", "begin": "", "end": "", "include": "#bold" },
        { "name": "", "match": "", "begin": "", "end": "", "include": "#code" },
        { "name": "", "match": "", "begin": "", "end": "", "include": "#link_label" },
        { "name": "", "match": "", "begin": "", "end": "", "include": "#link_dest" }
      ]
    },
    "code": {
      "name": "markup.raw.inline.markdown",
      "match": "",
      "begin": "`",
      "end": "`",
      "include": "",
      "cctext": { "inline": true }
    },
    "link_label": {
      "name": "markup.underline.link.markdown",
      "match": "",
      "begin": "[",
      "end": "](",
      "include": "",
      "cctext": { "inline": true, "lit": true, "arity": "path", "face": "label", "apply": "link" },
      "patterns": [
        { "name": "", "match": "", "begin": "", "end": "", "include": "#bold" },
        { "name": "", "match": "", "begin": "", "end": "", "include": "#italic" },
        { "name": "", "match": "", "begin": "", "end": "", "include": "#code" }
      ]
    },
    "link_dest": {
      "name": "markup.underline.link.markdown",
      "match": "",
      "begin": "](",
      "end": ")",
      "include": "",
      "cctext": { "inline": true, "lit": true, "arity": "path", "face": "dest" }
    },
    "autolink": {
      "name": "markup.underline.link.markdown",
      "match": "<https?://[^>]+>",
      "begin": "",
      "end": "",
      "include": "",
      "cctext": { "wrap": 1, "apply": "autolink" }
    }
  }
}
