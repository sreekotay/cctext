{
  "name": "Markdown",
  "scopeName": "text.markdown",
  "fileTypes": ["md", "markdown"],
  "patterns": [
    {
      "name": "",
      "match": "",
      "begin": "",
      "end": "",
      "include": "#fence"
    },
    {
      "name": "",
      "match": "",
      "begin": "",
      "end": "",
      "include": "#heading"
    },
    {
      "name": "",
      "match": "",
      "begin": "",
      "end": "",
      "include": "#quote"
    },
    {
      "name": "",
      "match": "",
      "begin": "",
      "end": "",
      "include": "#bold"
    },
    {
      "name": "",
      "match": "",
      "begin": "",
      "end": "",
      "include": "#italic"
    },
    {
      "name": "",
      "match": "",
      "begin": "",
      "end": "",
      "include": "#code"
    },
    {
      "name": "",
      "match": "",
      "begin": "",
      "end": "",
      "include": "#link"
    }
  ],
  "repository": {
    "fence": {
      "name": "markup.raw.block.markdown",
      "match": "",
      "begin": "```",
      "end": "```",
      "include": ""
    },
    "heading": {
      "name": "markup.heading.markdown",
      "match": "#+\\s.*",
      "begin": "",
      "end": "",
      "include": ""
    },
    "quote": {
      "name": "markup.quote.markdown",
      "match": ">.*",
      "begin": "",
      "end": "",
      "include": ""
    },
    "bold": {
      "name": "markup.bold.markdown",
      "match": "",
      "begin": "**",
      "end": "**",
      "include": ""
    },
    "italic": {
      "name": "markup.italic.markdown",
      "match": "",
      "begin": "*",
      "end": "*",
      "include": ""
    },
    "code": {
      "name": "markup.raw.inline.markdown",
      "match": "",
      "begin": "`",
      "end": "`",
      "include": ""
    },
    "link": {
      "name": "markup.underline.link.markdown",
      "match": "\\[[^\\]]+\\]\\([^)]+\\)",
      "begin": "",
      "end": "",
      "include": ""
    }
  }
}
