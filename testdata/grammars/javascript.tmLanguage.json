{
  "name": "JavaScript",
  "scopeName": "source.js",
  "fileTypes": ["js", "mjs", "ts"],
  "patterns": [
    {
      "name": "",
      "match": "",
      "begin": "",
      "end": "",
      "include": "#comments"
    },
    {
      "name": "",
      "match": "",
      "begin": "",
      "end": "",
      "include": "#block"
    },
    {
      "name": "",
      "match": "",
      "begin": "",
      "end": "",
      "include": "#strings"
    },
    {
      "name": "",
      "match": "",
      "begin": "",
      "end": "",
      "include": "#chars"
    },
    {
      "name": "",
      "match": "",
      "begin": "",
      "end": "",
      "include": "#numbers"
    },
    {
      "name": "",
      "match": "",
      "begin": "",
      "end": "",
      "include": "#keywords"
    }
  ],
  "repository": {
    "comments": {
      "name": "comment.line.double-slash.js",
      "match": "//.*",
      "begin": "",
      "end": "",
      "include": ""
    },
    "block": {
      "name": "comment.block.js",
      "match": "",
      "begin": "/*",
      "end": "*/",
      "include": ""
    },
    "strings": {
      "name": "string.quoted.double.js",
      "match": "",
      "begin": "\"",
      "end": "\"",
      "include": "",
      "patterns": [
        {
          "name": "constant.character.escape.js",
          "match": "\\\\.",
          "begin": "",
          "end": "",
          "include": ""
        }
      ]
    },
    "chars": {
      "name": "string.quoted.single.js",
      "match": "",
      "begin": "'",
      "end": "'",
      "include": ""
    },
    "numbers": {
      "name": "constant.numeric.js",
      "match": "\\b[0-9]+\\b",
      "begin": "",
      "end": "",
      "include": ""
    },
    "keywords": {
      "name": "keyword.control.js",
      "match": "\\b(function|return|if|else|for|while|do|const|let|var|class|new|this|typeof|instanceof|in|of|break|continue|switch|case|default|try|catch|finally|throw|import|export|from|async|await|true|false|null|undefined)\\b",
      "begin": "",
      "end": "",
      "include": ""
    }
  }
}
