{
  "name": "HTML",
  "scopeName": "text.html.basic",
  "fileTypes": ["html", "htm"],
  "patterns": [
    {
      "name": "",
      "match": "",
      "begin": "",
      "end": "",
      "include": "#comment"
    },
    {
      "name": "",
      "match": "",
      "begin": "",
      "end": "",
      "include": "#string"
    },
    {
      "name": "",
      "match": "",
      "begin": "",
      "end": "",
      "include": "#style"
    },
    {
      "name": "",
      "match": "",
      "begin": "",
      "end": "",
      "include": "#script"
    },
    {
      "name": "",
      "match": "",
      "begin": "",
      "end": "",
      "include": "#tag"
    }
  ],
  "repository": {
    "comment": {
      "name": "comment.block.html",
      "match": "",
      "begin": "<!--",
      "end": "-->",
      "include": ""
    },
    "string": {
      "name": "string.quoted.double.html",
      "match": "",
      "begin": "\"",
      "end": "\"",
      "include": ""
    },
    "style": {
      "name": "meta.embedded.block.css",
      "match": "",
      "begin": "<style\\b[^>]*>",
      "end": "</style\\s*>",
      "include": "source.css"
    },
    "script": {
      "name": "meta.embedded.block.js",
      "match": "",
      "begin": "<script\\b[^>]*>",
      "end": "</script\\s*>",
      "include": "source.js"
    },
    "tag": {
      "name": "entity.name.tag.html",
      "match": "</?[A-Za-z][^>]*>",
      "begin": "",
      "end": "",
      "include": ""
    }
  }
}
