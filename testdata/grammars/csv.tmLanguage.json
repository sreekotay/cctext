{
  "name": "CSV",
  "scopeName": "text.csv",
  "fileTypes": ["csv", "tsv", "psv", "pipe"],
  "patterns": [
    {
      "name": "",
      "match": "",
      "begin": "",
      "end": "",
      "include": "#comment"
    },
    {
      "name": "",
      "match": "",
      "begin": "",
      "end": "",
      "include": "#string"
    },
    {
      "name": "",
      "match": "",
      "begin": "",
      "end": "",
      "include": "#number"
    },
    {
      "name": "",
      "match": "",
      "begin": "",
      "end": "",
      "include": "#column"
    },
    {
      "name": "",
      "match": "",
      "begin": "",
      "end": "",
      "include": "#field"
    },
    {
      "name": "",
      "match": "",
      "begin": "",
      "end": "",
      "include": "#sep"
    }
  ],
  "repository": {
    "comment": {
      "name": "comment.line.number-sign.csv",
      "match": "#.*",
      "begin": "",
      "end": "",
      "include": ""
    },
    "string": {
      "name": "string.quoted.double.csv",
      "match": "",
      "begin": "\"",
      "end": "\"",
      "include": "",
      "patterns": [
        {
          "name": "constant.character.escape.csv",
          "match": "\"\"",
          "begin": "",
          "end": "",
          "include": ""
        }
      ]
    },
    "number": {
      "name": "constant.numeric.csv",
      "match": "-?[0-9]+(\\.[0-9]+)?",
      "begin": "",
      "end": "",
      "include": ""
    },
    "column": {
      "name": "entity.name.column.csv",
      "match": "[A-Za-z_][A-Za-z0-9_]*",
      "begin": "",
      "end": "",
      "include": ""
    },
    "field": {
      "name": "meta.field.csv",
      "match": "[^,\"\\t|\\n#][^,\"\\t|\\n]*",
      "begin": "",
      "end": "",
      "include": ""
    },
    "sep": {
      "name": "punctuation.separator.csv",
      "match": "[,\\t|]",
      "begin": "",
      "end": "",
      "include": ""
    }
  }
}
