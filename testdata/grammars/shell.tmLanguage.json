{
  "name": "Shell",
  "scopeName": "source.shell",
  "fileTypes": ["sh", "bash"],
  "patterns": [
    {
      "name": "",
      "match": "",
      "begin": "",
      "end": "",
      "include": "#comment"
    },
    {
      "name": "",
      "match": "",
      "begin": "",
      "end": "",
      "include": "#dstring"
    },
    {
      "name": "",
      "match": "",
      "begin": "",
      "end": "",
      "include": "#sstring"
    },
    {
      "name": "",
      "match": "",
      "begin": "",
      "end": "",
      "include": "#keywords"
    }
  ],
  "repository": {
    "comment": {
      "name": "comment.line.number-sign.shell",
      "match": "#.*",
      "begin": "",
      "end": "",
      "include": ""
    },
    "dstring": {
      "name": "string.quoted.double.shell",
      "match": "",
      "begin": "\"",
      "end": "\"",
      "include": ""
    },
    "sstring": {
      "name": "string.quoted.single.shell",
      "match": "",
      "begin": "'",
      "end": "'",
      "include": ""
    },
    "keywords": {
      "name": "keyword.control.shell",
      "match": "\\b(if|then|else|elif|fi|for|do|done|while|until|case|esac|function|return|in|select|export|local|source)\\b",
      "begin": "",
      "end": "",
      "include": ""
    }
  }
}
