{
  "name": "CSS",
  "scopeName": "source.css",
  "fileTypes": ["css"],
  "patterns": [
    {
      "name": "",
      "match": "",
      "begin": "",
      "end": "",
      "include": "#comments"
    },
    {
      "name": "",
      "match": "",
      "begin": "",
      "end": "",
      "include": "#block"
    },
    {
      "name": "",
      "match": "",
      "begin": "",
      "end": "",
      "include": "#strings"
    },
    {
      "name": "",
      "match": "",
      "begin": "",
      "end": "",
      "include": "#hex"
    },
    {
      "name": "",
      "match": "",
      "begin": "",
      "end": "",
      "include": "#numbers"
    },
    {
      "name": "",
      "match": "",
      "begin": "",
      "end": "",
      "include": "#keywords"
    }
  ],
  "repository": {
    "comments": {
      "name": "comment.line.double-slash.css",
      "match": "//.*",
      "begin": "",
      "end": "",
      "include": ""
    },
    "block": {
      "name": "comment.block.css",
      "match": "",
      "begin": "/*",
      "end": "*/",
      "include": ""
    },
    "strings": {
      "name": "string.quoted.double.css",
      "match": "",
      "begin": "\"",
      "end": "\"",
      "include": ""
    },
    "hex": {
      "name": "constant.numeric.color.css",
      "match": "#[0-9A-Fa-f]+",
      "begin": "",
      "end": "",
      "include": ""
    },
    "numbers": {
      "name": "constant.numeric.css",
      "match": "\\b[0-9]+(\\.[0-9]+)?(px|em|rem|%|vh|vw)?\\b",
      "begin": "",
      "end": "",
      "include": ""
    },
    "keywords": {
      "name": "keyword.other.css",
      "match": "\\b(display|color|background|margin|padding|border|width|height|font|flex|grid|position|absolute|relative|fixed|sticky|none|auto|inherit|block|inline|hidden|visible|center|left|right|top|bottom|solid|dashed|important)\\b",
      "begin": "",
      "end": "",
      "include": ""
    }
  }
}
