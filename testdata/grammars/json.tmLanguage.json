{
  "name": "JSON",
  "scopeName": "source.json",
  "fileTypes": ["json"],
  "patterns": [
    {
      "name": "",
      "match": "",
      "begin": "",
      "end": "",
      "include": "#key"
    },
    {
      "name": "",
      "match": "",
      "begin": "",
      "end": "",
      "include": "#string"
    },
    {
      "name": "",
      "match": "",
      "begin": "",
      "end": "",
      "include": "#number"
    },
    {
      "name": "",
      "match": "",
      "begin": "",
      "end": "",
      "include": "#keyword"
    }
  ],
  "repository": {
    "key": {
      "name": "",
      "match": "\"([^\"]+)\"\\s*:",
      "begin": "",
      "end": "",
      "include": "",
      "captures": {
        "1": {
          "name": "variable.other.property.json",
          "match": "",
          "begin": "",
          "end": "",
          "include": ""
        }
      }
    },
    "string": {
      "name": "string.quoted.double.json",
      "match": "",
      "begin": "\"",
      "end": "\"",
      "include": "",
      "patterns": [
        {
          "name": "constant.character.escape.json",
          "match": "\\\\.",
          "begin": "",
          "end": "",
          "include": ""
        }
      ]
    },
    "number": {
      "name": "constant.numeric.json",
      "match": "-?[0-9]+(\\.[0-9]+)?([eE][+-]?[0-9]+)?",
      "begin": "",
      "end": "",
      "include": ""
    },
    "keyword": {
      "name": "keyword.constant.json",
      "match": "\\b(true|false|null)\\b",
      "begin": "",
      "end": "",
      "include": ""
    }
  }
}
