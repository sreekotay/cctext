classDiagram
    class Document {
        +PieceTree text
        +int epoch
        +insert(off, bytes) bool
        -journal() void
    }
    class Layout {
        +rows[] VisRow
        +fill(width)
    }
    class Renderer {
        <<interface>>
        +render(bytes) Pixmap
    }
    Document "1" --> "*" Layout : views
    Layout ..> Renderer : uses
    Renderer <|-- SvgRenderer
    Renderer <|-- MathRenderer
