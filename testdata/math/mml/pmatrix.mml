<math xmlns="http://www.w3.org/1998/Math/MathML" data-latex="A = \begin{pmatrix} a_{11} &amp; a_{12} \\ a_{21} &amp; a_{22} \end{pmatrix}" display="block">
  <mi data-latex="A">A</mi>
  <mo data-latex="=">=</mo>
  <mrow data-mjx-texclass="INNER" data-latex="{pmatrix}">
    <mo data-mjx-texclass="OPEN">(</mo>
    <mtable columnspacing="1em" rowspacing="4pt">
      <mtr>
        <mtd>
          <msub data-latex="a_{11}">
            <mi data-latex="a">a</mi>
            <mrow data-mjx-texclass="ORD" data-latex="{11}">
              <mn data-latex="11">11</mn>
            </mrow>
          </msub>
        </mtd>
        <mtd>
          <msub data-latex="a_{12}">
            <mi data-latex="a">a</mi>
            <mrow data-mjx-texclass="ORD" data-latex="{12}">
              <mn data-latex="12">12</mn>
            </mrow>
          </msub>
        </mtd>
      </mtr>
      <mtr>
        <mtd>
          <msub data-latex="a_{21}">
            <mi data-latex="a">a</mi>
            <mrow data-mjx-texclass="ORD" data-latex="{21}">
              <mn data-latex="21">21</mn>
            </mrow>
          </msub>
        </mtd>
        <mtd>
          <msub data-latex="a_{22}">
            <mi data-latex="a">a</mi>
            <mrow data-mjx-texclass="ORD" data-latex="{22}">
              <mn data-latex="22">22</mn>
            </mrow>
          </msub>
        </mtd>
      </mtr>
    </mtable>
    <mo data-mjx-texclass="CLOSE">)</mo>
  </mrow>
</math>