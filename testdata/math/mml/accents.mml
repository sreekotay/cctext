<math xmlns="http://www.w3.org/1998/Math/MathML" data-latex="\hat{x}\ \bar{y}\ \vec{v}\ \dot{a}\ \ddot{b}\ \tilde{n}\ \widehat{ABC}\ \overline{z+w}\ \underbrace{a+\dots+a}_{n}" display="block">
  <mrow data-mjx-texclass="ORD" data-latex="\hat{x}">
    <mover>
      <mi data-latex="x">x</mi>
      <mo stretchy="false">^</mo>
    </mover>
  </mrow>
  <mtext data-latex="\ ">&#xA0;</mtext>
  <mrow data-mjx-texclass="ORD" data-latex="\bar{y}">
    <mover>
      <mi data-latex="y">y</mi>
      <mo stretchy="false">&#xAF;</mo>
    </mover>
  </mrow>
  <mtext data-latex="\ ">&#xA0;</mtext>
  <mrow data-mjx-texclass="ORD" data-latex="\vec{v}">
    <mover>
      <mi data-latex="v">v</mi>
      <mo stretchy="false">&#x2192;</mo>
    </mover>
  </mrow>
  <mtext data-latex="\ ">&#xA0;</mtext>
  <mrow data-mjx-texclass="ORD" data-latex="\dot{a}">
    <mover>
      <mi data-latex="a">a</mi>
      <mo>&#x2D9;</mo>
    </mover>
  </mrow>
  <mtext data-latex="\ ">&#xA0;</mtext>
  <mrow data-mjx-texclass="ORD" data-latex="\ddot{b}">
    <mover>
      <mi data-latex="b">b</mi>
      <mo>&#xA8;</mo>
    </mover>
  </mrow>
  <mtext data-latex="\ ">&#xA0;</mtext>
  <mrow data-mjx-texclass="ORD" data-latex="\tilde{n}">
    <mover>
      <mi data-latex="n">n</mi>
      <mo stretchy="false">~</mo>
    </mover>
  </mrow>
  <mtext data-latex="\ ">&#xA0;</mtext>
  <mrow data-mjx-texclass="ORD" data-latex="\widehat{ABC}">
    <mover>
      <mrow data-latex="ABC">
        <mi data-latex="A">A</mi>
        <mi data-latex="B">B</mi>
        <mi data-latex="C">C</mi>
      </mrow>
      <mo>^</mo>
    </mover>
  </mrow>
  <mtext data-latex="\ ">&#xA0;</mtext>
  <mover data-latex="\overline{z+w}">
    <mrow data-latex="z+w">
      <mi data-latex="z">z</mi>
      <mo data-latex="+">+</mo>
      <mi data-latex="w">w</mi>
    </mrow>
    <mo accent="true">&#x2015;</mo>
  </mover>
  <mtext data-latex="\ ">&#xA0;</mtext>
  <munder data-latex="\underbrace{a+\dots+a}_{n}">
    <mrow data-mjx-texclass="OP" data-latex="\underbrace{a+\dots+a}">
      <munder>
        <mrow data-latex="a+\dots+a">
          <mi data-latex="a">a</mi>
          <mo data-latex="+">+</mo>
          <mo>&#x22EF;</mo>
          <mo data-latex="+">+</mo>
          <mi data-latex="a">a</mi>
        </mrow>
        <mo>&#x23DF;</mo>
      </munder>
    </mrow>
    <mrow data-mjx-texclass="ORD" data-latex="{n}">
      <mi data-latex="n">n</mi>
    </mrow>
  </munder>
</math>