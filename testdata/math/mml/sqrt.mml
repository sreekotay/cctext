<math xmlns="http://www.w3.org/1998/Math/MathML" data-latex="\sqrt[3]{x^3+y^3} \le \sqrt{\sqrt{\sqrt{2}}}" display="block">
  <mroot data-latex="\sqrt[3]{x^3+y^3}">
    <mrow data-latex="x^3 +y^3">
      <msup data-latex="x^3">
        <mi data-latex="x">x</mi>
        <mn data-latex="3">3</mn>
      </msup>
      <mo data-latex="+">+</mo>
      <msup data-latex="y^3">
        <mi data-latex="y">y</mi>
        <mn data-latex="3">3</mn>
      </msup>
    </mrow>
    <mn data-latex="3">3</mn>
  </mroot>
  <mo data-latex="\le">&#x2264;</mo>
  <msqrt data-latex="\sqrt{\sqrt{\sqrt{2}}}">
    <msqrt data-latex="\sqrt{\sqrt{2}}">
      <msqrt data-latex="\sqrt{2}">
        <mn data-latex="2">2</mn>
      </msqrt>
    </msqrt>
  </msqrt>
</math>