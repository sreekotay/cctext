<math xmlns="http://www.w3.org/1998/Math/MathML" data-latex="x = a_0 + \cfrac{1}{a_1 + \cfrac{1}{a_2 + \cdots}}" display="block">
  <mi data-latex="x">x</mi>
  <mo data-latex="=">=</mo>
  <msub data-latex="a_0">
    <mi data-latex="a">a</mi>
    <mn data-latex="0">0</mn>
  </msub>
  <mo data-latex="+">+</mo>
  <mfrac data-latex="\cfrac{1}{a_1 + \cfrac{1}{a_2 + \cdots}}">
    <mrow data-latex="\strut\textstyle{1}">
      <mpadded height="8.6pt" depth="3pt" width="0" data-latex="\strut">
        <mrow></mrow>
      </mpadded>
      <mrow data-mjx-texclass="ORD" data-latex="{1}">
        <mn data-latex="1">1</mn>
      </mrow>
    </mrow>
    <mrow data-latex="\strut\textstyle{a_1  + \cfrac{1}{a_2 + \cdots}}">
      <mpadded height="8.6pt" depth="3pt" width="0" data-latex="\strut">
        <mrow></mrow>
      </mpadded>
      <mrow data-mjx-texclass="ORD" data-latex="{a_1+\cfrac{1}{a_2 + \cdots}}">
        <msub data-latex="a_1">
          <mi data-latex="a">a</mi>
          <mn data-latex="1">1</mn>
        </msub>
        <mo data-latex="+">+</mo>
        <mfrac data-latex="\cfrac{1}{a_2 + \cdots}">
          <mrow data-latex="\strut\textstyle{1}">
            <mpadded height="8.6pt" depth="3pt" width="0" data-latex="\strut">
              <mrow></mrow>
            </mpadded>
            <mstyle scriptlevel="0">
              <mrow data-mjx-texclass="ORD" data-latex="{1}">
                <mn data-latex="1">1</mn>
              </mrow>
            </mstyle>
          </mrow>
          <mrow data-latex="\strut\textstyle{a_2  + \cdots}">
            <mpadded height="8.6pt" depth="3pt" width="0" data-latex="\strut">
              <mrow></mrow>
            </mpadded>
            <mstyle scriptlevel="0">
              <mrow data-mjx-texclass="ORD" data-latex="{a_2+\cdots}">
                <msub data-latex="a_2">
                  <mi data-latex="a">a</mi>
                  <mn data-latex="2">2</mn>
                </msub>
                <mo data-latex="+">+</mo>
                <mo data-latex="\cdots">&#x22EF;</mo>
              </mrow>
            </mstyle>
          </mrow>
        </mfrac>
      </mrow>
    </mrow>
  </mfrac>
</math>