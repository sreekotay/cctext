<math xmlns="http://www.w3.org/1998/Math/MathML" data-latex="x_{i_1}^{j^2} + {}_nC_k + x'' + f^{(n)}(x)" display="block">
  <msubsup data-latex="x_{i_1}^{j^2}">
    <mi data-latex="x">x</mi>
    <mrow data-mjx-texclass="ORD" data-latex="{i_1}">
      <msub data-latex="i_1">
        <mi data-latex="i">i</mi>
        <mn data-latex="1">1</mn>
      </msub>
    </mrow>
    <mrow data-mjx-texclass="ORD" data-latex="{j^2}">
      <msup data-latex="j^2">
        <mi data-latex="j">j</mi>
        <mn data-latex="2">2</mn>
      </msup>
    </mrow>
  </msubsup>
  <mo data-latex="+">+</mo>
  <msub data-latex="{}_n">
    <mrow data-mjx-texclass="ORD" data-latex="{}"></mrow>
    <mi data-latex="n">n</mi>
  </msub>
  <msub data-latex="C_k">
    <mi data-latex="C">C</mi>
    <mi data-latex="k">k</mi>
  </msub>
  <mo data-latex="+">+</mo>
  <msup>
    <mi data-latex="x">x</mi>
    <mo data-mjx-alternate="1" data-latex="''">&#x2033;</mo>
  </msup>
  <mo data-latex="+">+</mo>
  <msup data-latex="f^{(n)}">
    <mi data-latex="f">f</mi>
    <mrow data-mjx-texclass="ORD" data-latex="{(n)}">
      <mo data-latex="(" stretchy="false">(</mo>
      <mi data-latex="n">n</mi>
      <mo data-latex=")" stretchy="false">)</mo>
    </mrow>
  </msup>
  <mo data-latex="(" stretchy="false">(</mo>
  <mi data-latex="x">x</mi>
  <mo data-latex=")" stretchy="false">)</mo>
</math>