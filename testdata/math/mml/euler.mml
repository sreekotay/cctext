<math xmlns="http://www.w3.org/1998/Math/MathML" data-latex="e^{i\pi} + 1 = 0" display="block">
  <msup data-latex="e^{i\pi}">
    <mi data-latex="e">e</mi>
    <mrow data-mjx-texclass="ORD" data-latex="{i\pi}">
      <mi data-latex="i">i</mi>
      <mi data-latex="\pi">&#x3C0;</mi>
    </mrow>
  </msup>
  <mo data-latex="+">+</mo>
  <mn data-latex="1">1</mn>
  <mo data-latex="=">=</mo>
  <mn data-latex="0">0</mn>
</math>