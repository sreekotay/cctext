<math xmlns="http://www.w3.org/1998/Math/MathML" data-latex="\int_{-\infty}^{\infty} e^{-x^2}\,dx = \sqrt{\pi}" display="block">
  <msubsup data-latex="\int_{-\infty}^{\infty}">
    <mo data-latex="\int">&#x222B;</mo>
    <mrow data-mjx-texclass="ORD" data-latex="{-\infty}">
      <mo data-latex="-">&#x2212;</mo>
      <mi mathvariant="normal" data-latex="\infty">&#x221E;</mi>
    </mrow>
    <mrow data-mjx-texclass="ORD" data-latex="{\infty}">
      <mi mathvariant="normal" data-latex="\infty">&#x221E;</mi>
    </mrow>
  </msubsup>
  <msup data-latex="e^{-x^2}">
    <mi data-latex="e">e</mi>
    <mrow data-mjx-texclass="ORD" data-latex="{-x^2}">
      <mo data-latex="-">&#x2212;</mo>
      <msup data-latex="x^2">
        <mi data-latex="x">x</mi>
        <mn data-latex="2">2</mn>
      </msup>
    </mrow>
  </msup>
  <mspace width="0.167em" data-latex="\,"></mspace>
  <mi data-latex="d">d</mi>
  <mi data-latex="x">x</mi>
  <mo data-latex="=">=</mo>
  <msqrt data-latex="\sqrt{\pi}">
    <mi data-latex="\pi">&#x3C0;</mi>
  </msqrt>
</math>