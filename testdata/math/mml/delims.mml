<math xmlns="http://www.w3.org/1998/Math/MathML" data-latex="\left( \frac{a}{b} \right) \left[ \frac{c}{d} \right] \left\{ \frac{e}{f} \right\} \left\langle \frac{g}{h} \right\rangle \left| \frac{i}{j} \right| \left\lfloor x \right\rfloor" display="block">
  <mrow data-mjx-texclass="INNER" data-latex="\left( \frac{a}{b} \right)">
    <mo data-mjx-texclass="OPEN" data-latex="\left(">(</mo>
    <mfrac data-latex="\frac{a}{b}">
      <mi data-latex="a">a</mi>
      <mi data-latex="b">b</mi>
    </mfrac>
    <mo data-mjx-texclass="CLOSE" data-latex="\right)">)</mo>
  </mrow>
  <mrow data-mjx-texclass="INNER" data-latex="\left[ \frac{c}{d} \right]">
    <mo data-mjx-texclass="OPEN" data-latex="\left[">[</mo>
    <mfrac data-latex="\frac{c}{d}">
      <mi data-latex="c">c</mi>
      <mi data-latex="d">d</mi>
    </mfrac>
    <mo data-mjx-texclass="CLOSE" data-latex="\right]">]</mo>
  </mrow>
  <mrow data-mjx-texclass="INNER" data-latex="\left\{ \frac{e}{f} \right\}">
    <mo data-mjx-texclass="OPEN" data-latex="\left\{">{</mo>
    <mfrac data-latex="\frac{e}{f}">
      <mi data-latex="e">e</mi>
      <mi data-latex="f">f</mi>
    </mfrac>
    <mo data-mjx-texclass="CLOSE" data-latex="\right\}">}</mo>
  </mrow>
  <mrow data-mjx-texclass="INNER" data-latex="\left\langle \frac{g}{h} \right\rangle ">
    <mo data-mjx-texclass="OPEN" data-latex="\left\langle ">&#x27E8;</mo>
    <mfrac data-latex="\frac{g}{h}">
      <mi data-latex="g">g</mi>
      <mi data-latex="h">h</mi>
    </mfrac>
    <mo data-mjx-texclass="CLOSE" data-latex="\right\rangle ">&#x27E9;</mo>
  </mrow>
  <mrow data-mjx-texclass="INNER" data-latex="\left| \frac{i}{j} \right|">
    <mo data-mjx-texclass="OPEN" data-latex="\left|">|</mo>
    <mfrac data-latex="\frac{i}{j}">
      <mi data-latex="i">i</mi>
      <mi data-latex="j">j</mi>
    </mfrac>
    <mo data-mjx-texclass="CLOSE" data-latex="\right|">|</mo>
  </mrow>
  <mrow data-mjx-texclass="INNER" data-latex="\left\lfloor x \right\rfloor">
    <mo data-mjx-texclass="OPEN" data-latex="\left\lfloor ">&#x230A;</mo>
    <mi data-latex="x">x</mi>
    <mo data-mjx-texclass="CLOSE" data-latex="\right\rfloor">&#x230B;</mo>
  </mrow>
</math>