<math xmlns="http://www.w3.org/1998/Math/MathML" data-latex="\lim_{n\to\infty}\prod_{i=1}^{n}\left(1+\frac{1}{n}\right) \quad \bigcup_{i\in I} A_i" display="block">
  <munder data-latex="\lim_{n\to\infty}">
    <mo data-mjx-texclass="OP" movablelimits="true" data-latex="\lim">lim</mo>
    <mrow data-mjx-texclass="ORD" data-latex="{n\to\infty}">
      <mi data-latex="n">n</mi>
      <mo accent="false" stretchy="false" data-latex="\to">&#x2192;</mo>
      <mi mathvariant="normal" data-latex="\infty">&#x221E;</mi>
    </mrow>
  </munder>
  <munderover data-latex="\prod_{i=1}^{n}">
    <mo data-latex="\prod">&#x220F;</mo>
    <mrow data-mjx-texclass="ORD" data-latex="{i=1}">
      <mi data-latex="i">i</mi>
      <mo data-latex="=">=</mo>
      <mn data-latex="1">1</mn>
    </mrow>
    <mrow data-mjx-texclass="ORD" data-latex="{n}">
      <mi data-latex="n">n</mi>
    </mrow>
  </munderover>
  <mrow data-mjx-texclass="INNER" data-latex="\left(1+\frac{1}{n}\right)">
    <mo data-mjx-texclass="OPEN" data-latex="\left(">(</mo>
    <mn data-latex="1">1</mn>
    <mo data-latex="+">+</mo>
    <mfrac data-latex="\frac{1}{n}">
      <mn data-latex="1">1</mn>
      <mi data-latex="n">n</mi>
    </mfrac>
    <mo data-mjx-texclass="CLOSE" data-latex="\right)">)</mo>
  </mrow>
  <mspace width="1em" data-latex="\quad"></mspace>
  <munder data-latex="\bigcup_{i\in I}">
    <mo data-latex="\bigcup">&#x22C3;</mo>
    <mrow data-mjx-texclass="ORD" data-latex="{i\in I}">
      <mi data-latex="i">i</mi>
      <mo data-latex="\in">&#x2208;</mo>
      <mi data-latex="I">I</mi>
    </mrow>
  </munder>
  <msub data-latex="A_i">
    <mi data-latex="A">A</mi>
    <mi data-latex="i">i</mi>
  </msub>
</math>