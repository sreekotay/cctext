<math xmlns="http://www.w3.org/1998/Math/MathML" data-latex="\color{red}{x} + \cancel{y} + \boxed{z = 1}" display="block">
  <mstyle mathcolor="red" data-latex="\fbox{$\displaystyle{z = 1}$}">
    <mrow data-mjx-texclass="ORD" data-latex="{x}">
      <mi data-latex="x">x</mi>
    </mrow>
    <mo data-latex="+">+</mo>
    <menclose notation="updiagonalstrike" data-latex="\cancel {y}">
      <mi data-latex="y">y</mi>
    </menclose>
    <mo data-latex="+">+</mo>
    <menclose notation="box" data-latex="\fbox{$\displaystyle{z = 1}$}">
      <mrow data-mjx-texclass="ORD">
        <mrow data-mjx-texclass="ORD" data-latex="\displaystyle{z = 1}">
          <mi data-latex="z">z</mi>
          <mo data-latex="=">=</mo>
          <mn data-latex="1">1</mn>
        </mrow>
      </mrow>
    </menclose>
  </mstyle>
</math>