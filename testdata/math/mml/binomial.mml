<math xmlns="http://www.w3.org/1998/Math/MathML" data-latex="\binom{n}{k} = \frac{n!}{k!(n-k)!} \quad \tbinom{a}{b}" display="block">
  <mrow data-mjx-texclass="ORD" data-latex="\binom{n}{k}">
    <mrow data-mjx-texclass="OPEN" data-latex="\biggl (">
      <mo minsize="2.047em" maxsize="2.047em">(</mo>
    </mrow>
    <mfrac linethickness="0">
      <mi data-latex="n">n</mi>
      <mi data-latex="k">k</mi>
    </mfrac>
    <mrow data-mjx-texclass="CLOSE" data-latex="\biggr )">
      <mo minsize="2.047em" maxsize="2.047em">)</mo>
    </mrow>
  </mrow>
  <mo data-latex="=">=</mo>
  <mfrac data-latex="\frac{n!}{k!(n-k)!}">
    <mrow data-latex="n!">
      <mi data-latex="n">n</mi>
      <mo data-latex="!">!</mo>
    </mrow>
    <mrow data-latex="k!(n-k)!">
      <mi data-latex="k">k</mi>
      <mo data-latex="!">!</mo>
      <mo data-latex="(" stretchy="false">(</mo>
      <mi data-latex="n">n</mi>
      <mo data-latex="-">&#x2212;</mo>
      <mi data-latex="k">k</mi>
      <mo data-latex=")" stretchy="false">)</mo>
      <mo data-latex="!">!</mo>
    </mrow>
  </mfrac>
  <mspace width="1em" data-latex="\quad"></mspace>
  <mstyle displaystyle="false" data-latex="\tbinom{a}{b}">
    <mrow data-mjx-texclass="ORD">
      <mrow data-mjx-texclass="OPEN" data-latex="\bigl (">
        <mo minsize="1.2em" maxsize="1.2em">(</mo>
      </mrow>
      <mfrac linethickness="0">
        <mi data-latex="a">a</mi>
        <mi data-latex="b">b</mi>
      </mfrac>
      <mrow data-mjx-texclass="CLOSE" data-latex="\bigr )">
        <mo minsize="1.2em" maxsize="1.2em">)</mo>
      </mrow>
    </mrow>
  </mstyle>
</math>