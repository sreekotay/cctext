<math xmlns="http://www.w3.org/1998/Math/MathML" data-latex="\frac{a+b}{c-d} = \dfrac{1}{1+\frac{1}{x}}" display="block">
  <mfrac data-latex="\frac{a+b}{c-d}">
    <mrow data-latex="a+b">
      <mi data-latex="a">a</mi>
      <mo data-latex="+">+</mo>
      <mi data-latex="b">b</mi>
    </mrow>
    <mrow data-latex="c-d">
      <mi data-latex="c">c</mi>
      <mo data-latex="-">&#x2212;</mo>
      <mi data-latex="d">d</mi>
    </mrow>
  </mfrac>
  <mo data-latex="=">=</mo>
  <mfrac data-latex="\dfrac{1}{1+\frac{1}{x}}">
    <mn data-latex="1">1</mn>
    <mrow data-latex="1+\frac{1}{x}">
      <mn data-latex="1">1</mn>
      <mo data-latex="+">+</mo>
      <mfrac data-latex="\frac{1}{x}">
        <mn data-latex="1">1</mn>
        <mi data-latex="x">x</mi>
      </mfrac>
    </mrow>
  </mfrac>
</math>