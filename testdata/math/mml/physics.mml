<math xmlns="http://www.w3.org/1998/Math/MathML" data-latex="i\hbar\frac{\partial}{\partial t}\Psi(\mathbf{r},t) = \left[-\frac{\hbar^2}{2m}\nabla^2 + V\right]\Psi" display="block">
  <mi data-latex="i">i</mi>
  <mi data-mjx-alternate="1" data-latex="\hbar">&#x210F;</mi>
  <mfrac data-latex="\frac{\partial}{\partial t}">
    <mi data-latex="\partial">&#x2202;</mi>
    <mrow data-latex="\partial t">
      <mi data-latex="\partial">&#x2202;</mi>
      <mi data-latex="t">t</mi>
    </mrow>
  </mfrac>
  <mi mathvariant="normal" data-latex="\Psi">&#x3A8;</mi>
  <mo data-latex="(" stretchy="false">(</mo>
  <mrow data-mjx-texclass="ORD" data-latex="\mathbf{r}">
    <mi mathvariant="bold" data-latex="r">r</mi>
  </mrow>
  <mo data-latex=",">,</mo>
  <mi data-latex="t">t</mi>
  <mo data-latex=")" stretchy="false">)</mo>
  <mo data-latex="=">=</mo>
  <mrow data-mjx-texclass="INNER" data-latex="\left[-\frac{\hbar^2}{2m}\nabla^2  + V\right]">
    <mo data-mjx-texclass="OPEN" data-latex="\left[">[</mo>
    <mo data-latex="-">&#x2212;</mo>
    <mfrac data-latex="\frac{\hbar^2}{2m}">
      <msup data-latex="\hbar^2">
        <mi data-mjx-alternate="1" data-latex="\hbar">&#x210F;</mi>
        <mn data-latex="2">2</mn>
      </msup>
      <mrow data-latex="2m">
        <mn data-latex="2">2</mn>
        <mi data-latex="m">m</mi>
      </mrow>
    </mfrac>
    <msup data-latex="\nabla^2">
      <mi mathvariant="normal" data-latex="\nabla">&#x2207;</mi>
      <mn data-latex="2">2</mn>
    </msup>
    <mo data-latex="+">+</mo>
    <mi data-latex="V">V</mi>
    <mo data-mjx-texclass="CLOSE" data-latex="\right]">]</mo>
  </mrow>
  <mi mathvariant="normal" data-latex="\Psi">&#x3A8;</mi>
