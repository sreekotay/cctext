<math xmlns="http://www.w3.org/1998/Math/MathML" data-latex="\overbrace{1+2+\cdots+n}^{\frac{n(n+1)}{2}}" display="block">
  <mover data-latex="\overbrace{1+2+\cdots+n}^{\frac{n(n+1)}{2}}">
    <mrow data-mjx-texclass="OP" data-latex="\overbrace{1+2+\cdots+n}">
      <mover>
        <mrow data-latex="1+2+\cdots+n">
          <mn data-latex="1">1</mn>
          <mo data-latex="+">+</mo>
          <mn data-latex="2">2</mn>
          <mo data-latex="+">+</mo>
          <mo data-latex="\cdots">&#x22EF;</mo>
          <mo data-latex="+">+</mo>
          <mi data-latex="n">n</mi>
        </mrow>
        <mo>&#x23DE;</mo>
      </mover>
    </mrow>
    <mrow data-mjx-texclass="ORD" data-latex="{\frac{n(n+1)}{2}}">
      <mfrac data-latex="\frac{n(n+1)}{2}">
        <mrow data-latex="n(n+1)">
          <mi data-latex="n">n</mi>
          <mo data-latex="(" stretchy="false">(</mo>
          <mi data-latex="n">n</mi>
          <mo data-latex="+">+</mo>
          <mn data-latex="1">1</mn>
          <mo data-latex=")" stretchy="false">)</mo>
        </mrow>
        <mn data-latex="2">2</mn>
      </mfrac>
    </mrow>
  </mover>
</math>