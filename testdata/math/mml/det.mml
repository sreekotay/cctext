<math xmlns="http://www.w3.org/1998/Math/MathML" data-latex="\det\begin{vmatrix} x &amp; y \\ z &amp; w \end{vmatrix} = xw - yz" display="block">
  <mo data-mjx-texclass="OP" movablelimits="true" data-latex="\det">det</mo>
  <mrow data-mjx-texclass="INNER" data-latex="{vmatrix}">
    <mo data-mjx-texclass="OPEN">|</mo>
    <mtable columnspacing="1em" rowspacing="4pt">
      <mtr>
        <mtd>
          <mi data-latex="x">x</mi>
        </mtd>
        <mtd>
          <mi data-latex="y">y</mi>
        </mtd>
      </mtr>
      <mtr>
        <mtd>
          <mi data-latex="z">z</mi>
        </mtd>
        <mtd>
          <mi data-latex="w">w</mi>
        </mtd>
      </mtr>
    </mtable>
    <mo data-mjx-texclass="CLOSE">|</mo>
  </mrow>
  <mo data-latex="=">=</mo>
  <mi data-latex="x">x</mi>
  <mi data-latex="w">w</mi>
  <mo data-latex="-">&#x2212;</mo>
  <mi data-latex="y">y</mi>
  <mi data-latex="z">z</mi>
</math>