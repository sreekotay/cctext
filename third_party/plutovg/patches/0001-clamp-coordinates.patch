cctext patch 0001: clamp coordinates and stroke parameters before the
FreeType-derived stroker / rasterizer; no memcpy from NULL.

Found by the cctext-render fuzz run (ASan + UBSan over mutated SVGs):
- ft_trig_downscale / PVG_FT_Vector_Rotate / PVG_FT_MulDiv / gray_line_to:
  signed 64-bit overflow on coordinates like 1e38 (and a float -> integer
  conversion out of range for inf / NaN). Device coordinates are clamped
  to +-2^20 px (NaN -> 0) when the path is converted to 26.6 fixed point;
  every canvas is far smaller, so only geometry far off-canvas changes.
- the stroke half-width is clamped the same way, the miter limit to
  [1, 10000] (both were converted to fixed point unchecked).
- ft_stroke_border_export: memcpy(dst, NULL, 0) for an empty border
  (undefined behaviour); an empty border now returns early.

Apply: patch -p1 -d third_party/plutovg < third_party/plutovg/patches/0001-clamp-coordinates.patch

--- a/source/plutovg-ft-stroker.c
+++ b/source/plutovg-ft-stroker.c
@@ -568,6 +568,11 @@
 static void ft_stroke_border_export(PVG_FT_StrokeBorder border,
                                     PVG_FT_Outline*     outline)
 {
+    /* cctext patch: an empty border has NULL arrays (memcpy(dst, NULL, 0)
+     * is undefined behaviour). */
+    if(border->num_points == 0)
+        return;
+
     /* copy point locations */
     memcpy(outline->points + outline->n_points, border->points,
            border->num_points * sizeof(PVG_FT_Vector));
--- a/source/plutovg-rasterize.c
+++ b/source/plutovg-rasterize.c
@@ -189,7 +189,20 @@
     free(outline);
 }
 
-#define FT_COORD(x) (PVG_FT_Pos)(roundf(x * 64))
+/* cctext patch: clamp device coordinates to +-2^20 px before the 26.6
+ * conversion. The FreeType-derived stroker and rasterizer multiply
+ * coordinates in 64-bit (CORDIC scale, MulDiv); a 1e38 or NaN coordinate
+ * overflowed there (signed overflow, and a float -> integer conversion out
+ * of range). Every canvas is far smaller than 2^20 px. */
+#define FT_COORD_MAX 1048576.f
+static inline PVG_FT_Pos ft_coord(float x)
+{
+    if(!(x == x)) return 0;
+    if(x > FT_COORD_MAX) x = FT_COORD_MAX;
+    if(x < -FT_COORD_MAX) x = -FT_COORD_MAX;
+    return (PVG_FT_Pos)(roundf(x * 64));
+}
+#define FT_COORD(x) ft_coord(x)
 static void ft_outline_move_to(PVG_FT_Outline* ft, float x, float y)
 {
     ft->points[ft->n_points].x = FT_COORD(x);
@@ -304,9 +317,16 @@
 
     double scale = hypot(scale_x, scale_y) / PLUTOVG_SQRT2;
     double width = stroke_data->style.width * scale;
+    double miter = stroke_data->style.miter_limit;
+    /* cctext patch: the same clamp for the half width and the miter limit
+     * (16.16; SVG allows any value >= 1, 1e4 is already a spike). */
+    if(!(width == width) || width < 0) width = 0;
+    if(width > 2.0 * FT_COORD_MAX) width = 2.0 * FT_COORD_MAX;
+    if(!(miter == miter) || miter < 1) miter = 1;
+    if(miter > 10000) miter = 10000;
 
     PVG_FT_Fixed ftWidth = (PVG_FT_Fixed)(width * 0.5 * (1 << 6));
-    PVG_FT_Fixed ftMiterLimit = (PVG_FT_Fixed)(stroke_data->style.miter_limit * (1 << 16));
+    PVG_FT_Fixed ftMiterLimit = (PVG_FT_Fixed)(miter * (1 << 16));
 
     PVG_FT_Stroker_LineCap ftCap;
