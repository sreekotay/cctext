cctext patch 0003: resolve a nested <svg>'s percentage viewport once.

currentViewportSize() of a nested <svg> without a viewBox called
valueForLength() for width and height separately, and each call resolved
the parent's viewport again: 2^depth work for nested percentage-sized
<svg> (25 levels took 3.5 s; 40 levels would never finish). The parent
viewport is now fetched once per level: O(depth).

--- a/source/svgelement.cpp
+++ b/source/svgelement.cpp
@@ -416,10 +416,20 @@
         const auto& viewBox = element->viewBox();
         if(viewBox.value().isValid())
             return viewBox.value().size();
+        // cctext patch: resolve the parent viewport once. Calling valueForLength() for
+        // width and height separately recursed twice per nesting level (2^depth for
+        // nested percentage-sized <svg>; 25 levels took 3.5 s).
+        const auto& w = element->width().value();
+        const auto& h = element->height().value();
+        if(w.units() == LengthUnits::Percent || h.units() == LengthUnits::Percent) {
+            auto base = element->currentViewportSize();
+            LengthContext lengthContext(element);
+            auto width = w.units() == LengthUnits::Percent ? w.value() * base.w / 100.f : lengthContext.valueForLength(element->width());
+            auto height = h.units() == LengthUnits::Percent ? h.value() * base.h / 100.f : lengthContext.valueForLength(element->height());
+            return Size(width, height);
+        }
         LengthContext lengthContext(element);
-        auto width = lengthContext.valueForLength(element->width());
-        auto height = lengthContext.valueForLength(element->height());
-        return Size(width, height);
+        return Size(lengthContext.valueForLength(element->width()), lengthContext.valueForLength(element->height()));
     }
 
     return parent->currentViewportSize();
