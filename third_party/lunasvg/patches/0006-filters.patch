+bool hasPrimitiveChild(const SVGElement* e)
+{
+    for(const auto& child : e->children()) {
+        auto c = toSVGElement(child);
+        if(c && isPrimitive(c->id()))
+            return true;
+    }
+    return false;
+}
+
+enum class RunStatus { Ok, Nothing, Unfiltered };
+
+// Run one <filter> with `given` (or the canvas) as its SourceGraphic.
+RunStatus runFilterElement(const Context& base, const SVGFilterElement* filter, const ImageRef& given, ImageRef& result)
+{
+    Context ctx = base;
+    ctx.region = IRect{0, 0, ctx.w, ctx.h};
+    ctx.userRegion = filter->filterRegion(ctx.element);
+    if(ctx.userRegion.isEmpty())
+        return RunStatus::Nothing;
+    ctx.region = toPixels(ctx, ctx.userRegion);
+    if(ctx.region.empty())
+        return RunStatus::Nothing;
+    ctx.primitiveUnits = filter->attributeSource(PropertyID::PrimitiveUnits)->primitiveUnits();
+    if(ctx.primitiveUnits == Units::ObjectBoundingBox && ctx.bbox.isEmpty())
+        return RunStatus::Nothing;
+    FilterRun run(ctx, given);
+    int count = 0;
+    for(const auto& child : filter->primitivesSource()->children()) {
+        auto e = toSVGElement(child);
+        if(!e || !isPrimitive(e->id()))
+            continue;
+        if(++count > g_limits.maxPrimitives)
+            break;
+        if(!chargeWork(ctx.region.x1 - ctx.region.x0, ctx.region.y1 - ctx.region.y0, workWeight(e->id())))
+            return RunStatus::Unfiltered;  // over the render's work budget
+        if(!run.run(static_cast<const SVGFilterPrimitiveElement*>(e), count == 1))
+            return RunStatus::Unfiltered;  // over the memory budget
+    }
+    if(count == 0)
+        return RunStatus::Nothing;  // an empty filter: transparent
+    result = convert(run.last(), false);
+    return result ? RunStatus::Ok : RunStatus::Unfiltered;
+}
+
+} // namespace
+
+void resetFilterWork()
+{
+    g_work = 0.0;
+}
+
+bool parseFilterFunctions(const std::string& value, const SVGElement* element)
+{
+    return parseFunctions(value, element, nullptr);
+}
+
+Rect filterFunctionsRegion(const SVGElement* element, const Rect& box)
+{
+    // Filter functions have no filter region: the paint box grown by what
+    // blurs and shadows can reach (and a url()'s filter region).
+    std::vector<FilterFunction> fns;
+    if(!parseFunctions(element->filterFunctions(), element, &fns))
+        return box;
+    Rect r = box;
+    for(const auto& fn : fns) {
+        if(fn.type == FunctionType::Blur) {
+            r.inflate(3.f * fn.value);
+        } else if(fn.type == FunctionType::DropShadow) {
+            Rect s = r;
+            s.x += fn.dx;
+            s.y += fn.dy;
+            s.inflate(3.f * fn.value);
+            r.unite(s);
+        } else if(fn.type == FunctionType::Url) {
+            if(auto filter = element->getFilter(fn.id))
+                r.unite(filter->filterRegion(element));
+        }
+    }
+    if(!std::isfinite(r.x) || !std::isfinite(r.y) || !std::isfinite(r.w) || !std::isfinite(r.h))
+        return box;
+    return r;
+}
+
+// How far (device px) a filter can move content: 3 deviations per blur plus
+// every offset, summed over the primitives (an upper bound).
+float filterReach(const SVGElement* element, const Transform& ctm)
+{
+    const auto& m = ctm.matrix();
+    float sx = std::sqrt(m.a * m.a + m.b * m.b);
+    float sy = std::sqrt(m.c * m.c + m.d * m.d);
+    float s = std::max(sx, sy);
+    Rect bbox = element->fillBoundingBox();
+    double reach = 0.0;
+    auto blur = [&](float sdx, float sdy, bool obb) {
+        if(obb) {
+            sdx *= bbox.w;
+            sdy *= bbox.h;
+        }
+        float d = std::max(std::abs(sdx) * sx, std::abs(sdy) * sy);
+        reach += 3.0 * std::min(g_limits.maxBlur, finiteOr(d, g_limits.maxBlur));
+    };
+    auto shift = [&](float dx, float dy, bool obb) {
+        if(obb) {
+            dx *= bbox.w;
+            dy *= bbox.h;
+        }
+        reach += double(finiteOr(std::abs(dx) + std::abs(dy), 1e9f)) * s;
+    };
+    auto walk = [&](const SVGFilterElement* filter) {
+        bool obb = filter->attributeSource(PropertyID::PrimitiveUnits)->primitiveUnits() == Units::ObjectBoundingBox;
+        int count = 0;
+        for(const auto& child : filter->primitivesSource()->children()) {
+            auto e = toSVGElement(child);
+            if(!e || !isPrimitive(e->id()) || ++count > g_limits.maxPrimitives)
+                continue;
+            float sdy;
+            bool ok;
+            if(e->id() == ElementID::FeGaussianBlur) {
+                float sdx = stdDeviationPair(e, 0.f, sdy, ok);
+                blur(sdx, sdy, obb);
+            } else if(e->id() == ElementID::FeDropShadow) {
+                float sdx = stdDeviationPair(e, 2.f, sdy, ok);
+                blur(sdx, sdy, obb);
+                shift(numberAttr(e, PropertyID::Dx, 2.f, true), numberAttr(e, PropertyID::Dy, 2.f, true), obb);
+            } else if(e->id() == ElementID::FeOffset) {
+                shift(numberAttr(e, PropertyID::Dx, 0.f, true), numberAttr(e, PropertyID::Dy, 0.f, true), obb);
+            }
+        }
+    };
+    if(auto filter = element->filter()) {
+        walk(filter);
+    } else {
+        std::vector<FilterFunction> fns;
+        parseFunctions(element->filterFunctions(), element, &fns);
+        for(const auto& fn : fns) {
+            if(fn.type == FunctionType::Blur) {
+                blur(fn.value, fn.value, false);
+            } else if(fn.type == FunctionType::DropShadow) {
+                blur(fn.value, fn.value, false);
+                shift(fn.dx, fn.dy, false);
+            } else if(fn.type == FunctionType::Url) {
+                if(auto f = element->getFilter(fn.id))
+                    walk(f);
+            }
+        }
+    }
+    return float(std::min(reach, 1e7));
+}
+
+Rect filterCanvasRect(const SVGElement* element, const Rect& region, const Rect& extents, const Transform& ctm)
+{
+    if(!region.isValid() || region.isEmpty())
+        return Rect::Empty;
+    // Only what the filter can bring into the visible canvas: the canvas
+    // grown by the filter's reach (blurs, offsets), within the region.
+    Rect near = extents;
+    near.inflate(filterReach(element, ctm) + 1.f);
+    near.intersect(region);
+    return near;
+}
+
+bool applyFilter(const SVGElement* element, Canvas& canvas, const Transform& ctm)
+{
+    if(element->hasInvalidFilter())
+        return false;
+    auto* surface = canvas.surface();
+    int w = plutovg_surface_get_width(surface);
+    int h = plutovg_surface_get_height(surface);
+    if(double(w) * double(h) > g_limits.maxPixels || w <= 1 || h <= 1)
+        return true;  // over the limit (or no canvas): drawn unfiltered
+    if(plutovg_surface_get_stride(surface) != w * 4)
+        return true;
+
+    Context ctx;
+    ctx.element = element;
+    ctx.ctm = ctm;
+    ctx.w = w;
+    ctx.h = h;
+    ctx.ox = float(canvas.x());
+    ctx.oy = float(canvas.y());
+    const auto& m = ctm.matrix();
+    ctx.sx = std::sqrt(m.a * m.a + m.b * m.b);
+    ctx.sy = std::sqrt(m.c * m.c + m.d * m.d);
+    ctx.source = reinterpret_cast<uint32_t*>(plutovg_surface_get_data(surface));
+    ctx.bbox = element->fillBoundingBox();
+    ctx.region = IRect{0, 0, w, h};
+
+    ImageRef result;
+    if(const auto* filter = element->filter()) {
+        auto status = runFilterElement(ctx, filter, nullptr, result);
+        if(status == RunStatus::Nothing)
+            return false;
+        if(status == RunStatus::Unfiltered)
+            return true;
+    } else {
+        std::vector<FilterFunction> fns;
+        if(!parseFunctions(element->filterFunctions(), element, &fns))
+            return true;
+        auto inverse = ctm;
+        inverse.invert();
+        ctx.userRegion = inverse.mapRect(Rect(ctx.ox, ctx.oy, float(w), float(h)));
+        FilterRun run(ctx);
+        result = run.sourceGraphic();
+        for(const auto& fn : fns) {
+            if(!result)
+                return true;
+            if(fn.type == FunctionType::Url) {
+                // A url() in a list runs that filter on the result so far; one
+                // that names no <filter> is skipped.
+                auto filter = element->getFilter(fn.id);
+                if(!filter)
+                    continue;
+                ImageRef next;
+                auto status = runFilterElement(ctx, filter, result, next);
+                if(status == RunStatus::Unfiltered)
+                    return true;
+                if(status == RunStatus::Nothing)
+                    return false;
+                result = next;
+                continue;
+            }
+            if(!chargeWork(w, h, fn.type == FunctionType::Blur ? 3 : fn.type == FunctionType::DropShadow ? 4 : 1))
+                return true;
+            result = runFunction(ctx, fn, result);
+        }
+    }
+    if(!result)
+        return true;
+
+    auto* px = ctx.source;
+    for(int y = 0; y < h; y++) {
+        uint32_t* row = px + size_t(y) * w;
+        if(y < result->sub.y0 || y >= result->sub.y1) {
+            std::memset(row, 0, size_t(w) * 4);
+            continue;
+        }
+        const uint32_t* src = result->px + size_t(y) * w;
+        std::memset(row, 0, size_t(result->sub.x0) * 4);
+        std::memcpy(row + result->sub.x0, src + result->sub.x0, size_t(result->sub.x1 - result->sub.x0) * 4);
+        std::memset(row + result->sub.x1, 0, size_t(w - result->sub.x1) * 4);
+    }
+    return true;
+}
+
