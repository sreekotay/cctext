+namespace {
+
+template<typename F>
+const SVGFilterElement* walkHref(const SVGFilterElement* start, F match)
+{
+    const SVGFilterElement* chain[32];
+    int n = 0;
+    for(auto e = start; e && n < 32; ) {
+        for(int i = 0; i < n; i++) {
+            if(chain[i] == e)
+                return nullptr;
+        }
+        chain[n++] = e;
+        if(match(e))
+            return e;
+        auto target = e->getTargetElement(e->document());
+        e = target && target->id() == ElementID::Filter ? static_cast<const SVGFilterElement*>(target) : nullptr;
+    }
+    return nullptr;
+}
+
+bool hasPrimitiveChild(const SVGElement* e);
+
+} // namespace
+
+const SVGFilterElement* SVGFilterElement::attributeSource(PropertyID id) const
+{
+    auto e = walkHref(this, [id](const SVGFilterElement* f) { return f->hasAttribute(id); });
+    return e ? e : this;
+}
+
+const SVGFilterElement* SVGFilterElement::primitivesSource() const
+{
+    auto e = walkHref(this, [](const SVGFilterElement* f) { return hasPrimitiveChild(f); });
+    return e ? e : this;
+}
+
+Rect SVGFilterElement::filterRegion(const SVGElement* element) const
+{
+    auto units = attributeSource(PropertyID::FilterUnits)->m_filterUnits.value();
+    const auto* ex = attributeSource(PropertyID::X);
+    const auto* ey = attributeSource(PropertyID::Y);
+    const auto* ew = attributeSource(PropertyID::Width);
+    const auto* eh = attributeSource(PropertyID::Height);
+    // A negative or unparsable width / height disables the element.
+    for(const auto* e : {ew, eh}) {
+        auto id = e == ew ? PropertyID::Width : PropertyID::Height;
+        if(e->hasAttribute(id)) {
+            Length length;
+            std::string_view value(e->getAttribute(id));
+            stripLeadingAndTrailingSpaces(value);
+            if(!length.parse(value, LengthNegativeMode::Forbid))
+                return Rect::Empty;
+        }
+    }
+    LengthContext lengthContext(this, units);
+    Rect region = {
+        lengthContext.valueForLength(ex->m_x),
+        lengthContext.valueForLength(ey->m_y),
+        lengthContext.valueForLength(ew->m_width),
+        lengthContext.valueForLength(eh->m_height)
+    };
+
+    if(units == Units::ObjectBoundingBox) {
+        auto bbox = element->fillBoundingBox();
+        if(bbox.isEmpty())
+            return Rect::Empty;
+        region.x = region.x * bbox.w + bbox.x;
+        region.y = region.y * bbox.h + bbox.y;
+        region.w = region.w * bbox.w;
+        region.h = region.h * bbox.h;
+    }
+
+    if(!std::isfinite(region.x) || !std::isfinite(region.y) || !std::isfinite(region.w) || !std::isfinite(region.h) || region.w <= 0.f || region.h <= 0.f)
+        return Rect::Empty;
+    return region;
+}
