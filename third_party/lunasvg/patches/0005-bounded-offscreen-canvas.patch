cctext patch 0005: bounded offscreen canvases; no NULL surface.

Groups with opacity / masks / filters, patterns and masks render into an
offscreen canvas. Canvas::create allowed up to 32767 x 32767 (4 GiB) and
Canvas::Canvas passed a NULL surface to plutovg_canvas_create when the
allocation failed, which dereferenced it (fuzz: UBSan null member access).
An offscreen canvas over 2^26 px is now empty (1 x 1), and a failed
allocation falls back to a 1 x 1 surface: that content does not draw,
the rest of the image does.

Apply after 0004.

--- a/source/graphics.cpp
+++ b/source/graphics.cpp
@@ -496,7 +496,10 @@
 std::shared_ptr<Canvas> Canvas::create(float x, float y, float width, float height)
 {
     constexpr int kMaxSize = 1 << 15;
-    if(width <= 0 || height <= 0 || width >= kMaxSize || height >= kMaxSize)
+    // cctext patch: also bound the area (a 32767 x 32767 group, mask or
+    // pattern canvas is 4 GiB): past 2^26 px an offscreen canvas is empty.
+    constexpr double kMaxArea = double(1 << 26);
+    if(width <= 0 || height <= 0 || width >= kMaxSize || height >= kMaxSize || double(width) * double(height) > kMaxArea)
         return std::shared_ptr<Canvas>(new Canvas(0, 0, 1, 1));
     auto l = static_cast<int>(std::floor(x));
     auto t = static_cast<int>(std::floor(y));
@@ -682,8 +685,17 @@
 {
 }
 
+// cctext patch: an allocation failure falls back to a 1 x 1 surface (draws
+// nothing) instead of a NULL surface that plutovg_canvas_create dereferences.
+static plutovg_surface_t* createSurfaceOrEmpty(int width, int height)
+{
+    if(auto surface = plutovg_surface_create(width, height))
+        return surface;
+    return plutovg_surface_create(1, 1);
+}
+
 Canvas::Canvas(int x, int y, int width, int height)
-    : m_surface(plutovg_surface_create(width, height))
+    : m_surface(createSurfaceOrEmpty(width, height))
     , m_canvas(plutovg_canvas_create(m_surface))
     , m_translation({1, 0, 0, 1, -static_cast<float>(x), -static_cast<float>(y)})
     , m_x(x), m_y(y)
