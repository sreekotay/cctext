# Linux ASAN/TSAN smoke host: Ubuntu 24.04, ccc from concurrent-c.
# Build with SANITIZER=address|thread (see docker/sanitize-smoke.sh).
#
#   docker build -f docker/Dockerfile.sanitize --build-arg SANITIZER=address -t cctext-asan .
#   docker build -f docker/Dockerfile.sanitize --build-arg SANITIZER=thread -t cctext-tsan .

FROM ubuntu:24.04

ARG SANITIZER=address
ARG CCC_REF=
ARG DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential ca-certificates git python3 time \
    && rm -rf /var/lib/apt/lists/*

ENV PREFIX=/opt/ccc
ENV PATH="/opt/ccc/bin:${PATH}"
ENV CCC=ccc

RUN git clone --filter=blob:none https://github.com/sreekotay/concurrent-c.git /tmp/concurrent-c \
    && if [ -n "$CCC_REF" ]; then git -C /tmp/concurrent-c checkout "$CCC_REF"; fi \
    && PREFIX="$PREFIX" /tmp/concurrent-c/cc-install.sh --no-editor-tools --no-add-to-path \
    && rm -rf /tmp/concurrent-c \
    && ccc --version

WORKDIR /src
COPY . .

RUN mkdir -p testdata/generated out-asan bin-asan out-tsan bin-tsan \
    && ./testdata/gen_large.sh --bytes 3M testdata/generated/large.txt

ENV SANITIZER=${SANITIZER}
CMD ["sh", "-c", "case \"$SANITIZER\" in address) ./make.shcc @smoke_asan ;; thread) ./make.shcc @smoke_tsan ;; *) echo bad SANITIZER >&2; exit 2 ;; esac"]
