#!ccc cch
/*
 * cctext pane + chrome paint (linked TU). Keys are cctext_input.ccs.
 * The host loop stays in cctext.ccs.
 */
#ifndef RTX_CCTEXT_DRAW_H
#define RTX_CCTEXT_DRAW_H

#define CCTEXT_SCROLL_W 2

int cctext_rail_w(RtxBuf *b, int vis);
int cctext_text_cols(RtxBuf *b, int pcols, int vis);
int cctext_body_vis(RtxBuf *b, int vis, int pcols);
int cctext_pane_cols(RtxWs *w, int cols, int pane);
void cctext_style(RtxStyle st, int sel, int here);
void cctext_row_end(RtxBuf *b, int focused, int vis, int pcols, int col0,
                    int pad_rest, int used, int row);
void cctext_draw_grid_pane(RtxBuf *b, const RtxUi *ui, int focused, int vis,
                           int pcols, int col0, int pad_rest);
int cctext_grid_caret_cell(RtxBuf *b, int vis, int pcols, int col0, int *row,
                           int *col);
void cctext_draw_pane(RtxBuf *b, const RtxUi *ui, int focused, int vis,
                      int pcols, int col0, int pad_rest, char *status,
                      size_t statusn, int mouse_row);
void cctext_draw_stats(RtxBuf *b, int rows, int cols);

#endif
