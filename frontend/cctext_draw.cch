#!ccc cch
/*
 * cctext pane + chrome paint (linked TU). Keys are cctext_input.ccs.
 * The host loop stays in cctext.ccs.
 */
#ifndef RTX_CCTEXT_DRAW_H
#define RTX_CCTEXT_DRAW_H

#define CCTEXT_SCROLL_W 2

int cctext_rail_w(RtxBuf *b, int vis);
int cctext_text_cols(RtxBuf *b, int pcols, int vis);
int cctext_body_vis(RtxBuf *b, int vis, int pcols);
int cctext_pane_cols(RtxWs *w, int cols, int pane);

/* Pane geometry (cctext_geo): rows above the pane (0-based), first
 * column (1-based), columns, rows; pad = not at the right edge (paint
 * pads instead of erasing to the end of the line). */
typedef struct {
    int row0, col0, cols, vis, pad;
} CctextGeo;
extern CctextGeo g_geo[RTX_PANES_MAX];
extern int g_cctext_row0;
#define CCTEXT_GAP_X 2 /* " │" between side-by-side panes */
#define CCTEXT_GAP_Y 1 /* "─" row between stacked panes */
enum {
    CCTEXT_TABS_NEVER = 0,
    CCTEXT_TABS_AUTO,   /* two or more buffers */
    CCTEXT_TABS_ALWAYS
};
typedef struct {
    int x0, x1, close_x, buf;
} CctextTab;
#define CCTEXT_TAB_HITS 64
void cctext_tabs_set(int mode);
int cctext_tabs_mode(void);
int cctext_tabs_shown(const RtxWs *w);
RtxPaneRect cctext_pane_area(const RtxWs *w, int rows, int cols, int find_h);
void cctext_geo(RtxWs *w, int rows, int cols, int find_h);
void cctext_geo_ensure(RtxWs *w, int cols, int vis);
int cctext_geo_rows(void);
void cctext_geo_again(RtxWs *w);
int cctext_pane_at(RtxWs *w, int row, int col);
int cctext_divider_at(RtxWs *w, int row, int col);
int cctext_divider_drag(RtxWs *w, int node, int row, int col);
int cctext_focus_dir(RtxWs *w, int dx, int dy);
int cctext_tab_at(int col, int *close);
/* Project picker list rows on a `rows`-row screen. */
int cctext_pick_list_rows(int rows);
void cctext_style(RtxStyle st, int sel, int here);
void cctext_row_end(RtxBuf *b, int focused, int vis, int pcols, int col0,
                    int pad_rest, int used, int row);
void cctext_draw_grid_pane(RtxBuf *b, const RtxUi *ui, int focused, int vis,
                           int pcols, int col0, int pad_rest);
void cctext_draw_pane(RtxBuf *b, const RtxUi *ui, int focused, int vis,
                      int pcols, int col0, int pad_rest, char *status,
                      size_t statusn, int mouse_row);
void cctext_draw_stats(RtxBuf *b, int rows, int cols);
/* Presentation mode (cctext_present.ccs): the current slide of the deck
 * full-screen, every row written (CUP … EL) for the frame diff. */
void cctext_draw_present(RtxUi *ui, RtxBuf *act, int rows, int cols);
/* The terminal cursor is the caret (RtxUi.caret_host). A painter notes the
 * caret's screen cell (1-based) as it paints it: at = the caret is at the
 * cell being painted. The first note of a frame wins. */
void cctext_hw_mark(const RtxUi *ui, int focused, int at, int row, int col);
/* Focus in / out: rewrite the cursor shape only (steady while unfocused). */
void cctext_cursor_sync(const RtxUi *ui, int rows);

#endif
