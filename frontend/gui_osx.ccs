#!ccc ccs
/*
 * macOS file picker + live-resize observer (linked TU).
 * Stays out of gui.ccs so objc_msgSend casts do not sit on the 8192 AST cap.
 */
#include <ccc/std/prelude.cch>
#include <stdio.h>
#include <string.h>

#if defined(__APPLE__)
#include <objc/message.h>
#include <objc/runtime.h>

static void (*g_resize_fn)(void);

static void gui_osx_on_resize(id self, SEL cmd, id note) {
    (void)self;
    (void)cmd;
    (void)note;
    if (g_resize_fn) g_resize_fn();
}

int gui_osx_pick_file(const char *dir, char *out, size_t n) {
    id panel;
    id url;
    id nspath;
    const char *c;
    long rc;
    if (!out || n == 0) return 0;
    out[0] = 0;
    panel = ((id (*)(id, SEL))objc_msgSend)(
        (id)objc_getClass("NSOpenPanel"), sel_getUid("openPanel"));
    if (!panel) return -1;
    ((void (*)(id, SEL, unsigned char))objc_msgSend)(
        panel, sel_getUid("setCanChooseFiles:"), 1);
    ((void (*)(id, SEL, unsigned char))objc_msgSend)(
        panel, sel_getUid("setCanChooseDirectories:"), 0);
    ((void (*)(id, SEL, unsigned char))objc_msgSend)(
        panel, sel_getUid("setAllowsMultipleSelection:"), 0);
    if (dir && dir[0] == '/') {
        id nsdir = ((id (*)(id, SEL, const char *))objc_msgSend)(
            (id)objc_getClass("NSString"), sel_getUid("stringWithUTF8String:"),
            dir);
        id durl = ((id (*)(id, SEL, id))objc_msgSend)(
            (id)objc_getClass("NSURL"), sel_getUid("fileURLWithPath:"), nsdir);
        ((void (*)(id, SEL, id))objc_msgSend)(
            panel, sel_getUid("setDirectoryURL:"), durl);
    }
    rc = ((long (*)(id, SEL))objc_msgSend)(panel, sel_getUid("runModal"));
    if (rc != 1) return 0;
    url = ((id (*)(id, SEL))objc_msgSend)(panel, sel_getUid("URL"));
    if (!url) return 0;
    nspath = ((id (*)(id, SEL))objc_msgSend)(url, sel_getUid("path"));
    if (!nspath) return 0;
    c = ((const char *(*)(id, SEL))objc_msgSend)(nspath, sel_getUid("UTF8String"));
    if (!c || !c[0]) return 0;
    snprintf(out, n, "%s", c);
    return 1;
}

int gui_osx_install_resize(void *window, void (*fn)(void),
                           void **observer, void **center) {
    Class cls;
    id obs;
    id ctr;
    id name;
    if (!window || !observer || !center) return 0;
    g_resize_fn = fn;
    cls = objc_allocateClassPair(objc_getClass("NSObject"), "RtxGuiResizeObserver", 0);
    if (!cls) return 0;
    class_addMethod(cls, sel_getUid("onResize:"), (IMP)gui_osx_on_resize, "v@:@");
    objc_registerClassPair(cls);
    obs = ((id (*)(id, SEL))objc_msgSend)((id)cls, sel_getUid("new"));
    ctr = ((id (*)(id, SEL))objc_msgSend)(
        (id)objc_getClass("NSNotificationCenter"), sel_getUid("defaultCenter"));
    name = ((id (*)(id, SEL, const char *))objc_msgSend)(
        (id)objc_getClass("NSString"), sel_getUid("stringWithUTF8String:"),
        "NSWindowDidResizeNotification");
    ((void (*)(id, SEL, id, SEL, id, id))objc_msgSend)(
        ctr, sel_getUid("addObserver:selector:name:object:"),
        obs, sel_getUid("onResize:"), name, (id)window);
    *observer = (void *)obs;
    *center = (void *)ctr;
    return 1;
}

void gui_osx_uninstall_resize(void *observer, void *center) {
    if (center && observer) {
        ((void (*)(id, SEL, id))objc_msgSend)(
            (id)center, sel_getUid("removeObserver:"), (id)observer);
        ((void (*)(id, SEL))objc_msgSend)((id)observer, sel_getUid("release"));
    }
}

#else

int gui_osx_pick_file(const char *dir, char *out, size_t n) {
    (void)dir;
    if (out && n) out[0] = 0;
    return -1;
}

int gui_osx_install_resize(void *window, void (*fn)(void),
                           void **observer, void **center) {
    (void)window;
    (void)fn;
    (void)observer;
    (void)center;
    return 0;
}

void gui_osx_uninstall_resize(void *observer, void *center) {
    (void)observer;
    (void)center;
}

#endif
