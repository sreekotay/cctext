/*
 * cctext-ui colours from the theme's palette (core/theme.cch). GP(ROLE)
 * is the role's colour in the current theme, opaque; GPA(ROLE, a) with
 * alpha a. A scrim (the veil under a modal) is half as strong over a
 * light window: black at the dark theme's alpha would read as a shadow.
 */
#ifndef RTX_GUI_THEME_H
#define RTX_GUI_THEME_H

#include "gui_plat.h"
#include "../core/theme.cch"

static inline Color gui_pca(RtxPalId id, int a) {
    uint32_t c = rtx_pal(id);
    Color k;
    k.r = (unsigned char)(c >> 16);
    k.g = (unsigned char)(c >> 8);
    k.b = (unsigned char)c;
    k.a = (unsigned char)(a < 0 ? 0 : a > 255 ? 255 : a);
    return k;
}

static inline Color gui_pc(RtxPalId id) { return gui_pca(id, 255); }

static inline Color gui_scrim(int a) {
    return gui_pca(RTX_P_SCRIM, rtx_theme_light() ? a / 2 : a);
}

#define GP(role) gui_pc(RTX_P_##role)
#define GPA(role, a) gui_pca(RTX_P_##role, (a))

#endif
