#!ccc ccs
/*
 * cctext key decoder (linked TU; see cctext.cch). A pure function over a
 * byte window: no fd, no globals, no stdio. The host owns the read queue,
 * the ESC timeout and the bracketed-paste body; tests table-drive this.
 *
 * A return of 0 is "incomplete": the caller reads more, or passes
 * CCTEXT_KEY_FINAL once the ESC timeout has passed. A final lone ESC is
 * Help; a final dangling CSI is dropped (never typed).
 */
#include <ccc/std/prelude.cch>
#include <stdint.h>
#include <stddef.h>
#include "../core/utf8.cch"
#include "../core/nav.cch"
#include "cctext_keys.cch"

#define CCTEXT_CSI_MAX 64

static const char g_paste_end[] = "\x1b[201~";
#define CCTEXT_PASTE_END_N 6

static void cctext_key_zero(CctextKey *k) {
    k->kind = KEY_NONE;
    k->ch = 0;
    k->nav = 0;
    k->shift = 0;
    k->alt = 0;
    k->ctrl = 0;
    k->mx = 0;
    k->my = 0;
    k->focus = -1;
    k->chord = 0;
}

static uint32_t cctext_chord_mods(int bits) {
    uint32_t m = 0;
    if (bits & 1) m |= RTX_CHORD_SHIFT;
    if (bits & 2) m |= RTX_CHORD_ALT;
    if ((bits & 4) || (bits & 8)) m |= RTX_CHORD_CTRL;
    return m;
}

/* A chord from a key code (CSI u / modifyOtherKeys) and xterm mod bits.
 * An upper-case letter is the letter with Shift. */
static uint32_t cctext_chord_code(int code, int bits) {
    uint32_t m = cctext_chord_mods(bits);
    if (code >= 'A' && code <= 'Z') {
        code = code - 'A' + 'a';
        m |= RTX_CHORD_SHIFT;
    }
    if (code == 9) return RTX_KEY_TAB | m;
    if (code > 0x20 && code < 0x7f) return (uint32_t)code | m;
    return 0;
}

/* xterm mods: 1 + shift(1) + alt(2) + ctrl(4) + meta/cmd(8). */
static int cctext_key_mods(CctextKey *k, int key, int mods) {
    int bits = mods > 0 ? mods - 1 : 0;
    int cmd = (bits & 4) || (bits & 8);
    if (bits & 1) k->shift = 1;
    if (bits & 2) k->alt = 1;
    if (cmd) {
        if (key == KEY_LEFT) return KEY_HOME;
        if (key == KEY_RIGHT) return KEY_END;
        if (key == KEY_HOME) return KEY_DOC_HOME;
        if (key == KEY_END) return KEY_DOC_END;
    }
    return key;
}

/* modifyOtherKeys / CSI u: Ctrl-. and Ctrl-= (C0 has no encoding for them). */
static int cctext_key_other(CctextKey *k, int code, int mods) {
    int bits = mods > 0 ? mods - 1 : 0;
    if (bits & (2 | 4 | 8)) k->chord = cctext_chord_code(code, bits);
    /* Shift-Enter / Alt-Enter (kitty CSI 13;2u, modifyOtherKeys 27;2;13~). */
    if (code == 13 && !(bits & 4) && !(bits & 8)) {
        if (bits & 1) k->shift = 1;
        if (bits & 2) k->alt = 1;
        return KEY_ENTER;
    }
    /* Ctrl-Enter (Cmd-Enter): a picker row opens in the other pane. */
    if (code == 13) {
        k->ctrl = 1;
        if (bits & 1) k->shift = 1;
        return KEY_ENTER;
    }
    if (!(bits & 4) && !(bits & 8)) {
        /* Alt-letter (kitty / CSI u): the command letter, alt set. */
        if ((bits & 2) && ((code >= 'a' && code <= 'z') || (code >= 'A' && code <= 'Z'))) {
            k->alt = 1;
            k->ch = code >= 'A' && code <= 'Z' ? code - 'A' + 'a' : code;
            return KEY_CMD_LETTER;
        }
        return KEY_NONE;
    }
    if (code == '.') return KEY_APPLY_MENU;
    if (code == '=') return KEY_STATS;
    if (code >= 'A' && code <= 'Z') code = code - 'A' + 'a';
    if (code >= 'a' && code <= 'z') {
        k->ch = code;
        return KEY_CMD_LETTER;
    }
    return KEY_NONE;
}

static int cctext_key_letter(CctextKey *k, int d, int mods) {
    int bits = mods > 0 ? mods - 1 : 0;
    /* Ctrl-Alt-arrow: move the nearest pane divider (pane.resize_*). */
    if ((bits & 2) && (bits & 4) && d >= 'A' && d <= 'D') {
        k->nav = d == 'D' ? 1 : d == 'C' ? 2 : d == 'A' ? 3 : 4;
        k->chord = (uint32_t)(d == 'D' ? RTX_KEY_LEFT : d == 'C' ? RTX_KEY_RIGHT
                              : d == 'A' ? RTX_KEY_UP : RTX_KEY_DOWN) |
                   cctext_chord_mods(bits);
        return KEY_PANE_NUDGE;
    }
    if (d == 'A') return cctext_key_mods(k, KEY_UP, mods);
    if (d == 'B') return cctext_key_mods(k, KEY_DOWN, mods);
    if (d == 'C') return cctext_key_mods(k, KEY_RIGHT, mods);
    if (d == 'D') return cctext_key_mods(k, KEY_LEFT, mods);
    if (d == 'H') return cctext_key_mods(k, KEY_HOME, mods);
    if (d == 'F') return cctext_key_mods(k, KEY_END, mods);
    if (d == 'Z') {
        k->shift = 1;
        return KEY_TAB;
    }
    if (d >= 'P' && d <= 'S') {
        /* F1-F4 (SS3 P / CSI 1;m P): a chord only, no built-in meaning. */
        int bits = mods > 0 ? mods - 1 : 0;
        k->chord = (uint32_t)(RTX_KEY_F1 + (d - 'P')) | cctext_chord_mods(bits);
        return KEY_NONE;
    }
    return KEY_NONE;
}

static int cctext_key_tilde(CctextKey *k, const int *p, int np) {
    int n = np > 0 ? p[0] : 0;
    int mods = np > 1 ? p[1] : 0;
    int bits = mods > 0 ? mods - 1 : 0;
    /* xterm modifyOtherKeys: CSI 27 ; mods ; code ~ */
    if (n == 27 && np >= 3) return cctext_key_other(k, p[2], p[1]);
    if (n == 200) return KEY_PASTE_BEGIN;
    if (n == 201) return KEY_NONE;
    if (n == 3) return KEY_DELETE;
    if (n == 1 || n == 7) return cctext_key_mods(k, KEY_HOME, mods);
    if (n == 4 || n == 8) return cctext_key_mods(k, KEY_END, mods);
    if (n == 5 || n == 6) {
        (void)cctext_key_mods(k, KEY_NONE, mods);
        /* Ctrl-PgUp / PgDn may be bound (buffer switch); unbound they page. */
        if ((bits & 4) || (bits & 8))
            k->chord = (uint32_t)(n == 5 ? RTX_KEY_PGUP : RTX_KEY_PGDN) |
                       cctext_chord_mods(bits);
        return n == 5 ? KEY_PAGE_UP : KEY_PAGE_DOWN;
    }
    {
        /* F1-F12: CSI 11~..15~, 17~..21~, 23~, 24~. */
        static const int fk[] = {11, 12, 13, 14, 15, 17, 18, 19, 20, 21, 23, 24};
        int f;
        for (f = 0; f < 12; f++) {
            if (fk[f] == n) {
                k->chord = (uint32_t)(RTX_KEY_F1 + f) | cctext_chord_mods(bits);
                return KEY_NONE;
            }
        }
    }
    if (n == 2) {
        (void)cctext_key_mods(k, KEY_NONE, mods);
        /* Insert: no overwrite mode. Shift-Insert pastes, Ctrl-Insert copies
         * (the CUA pair). */
        if (bits & 1) return KEY_PASTE;
        if ((bits & 4) || (bits & 8)) return KEY_COPY;
        return KEY_NONE;
    }
    return KEY_NONE;
}

static int cctext_key_mouse(CctextKey *k, const int *p, int np, int fin) {
    int btn = np > 0 ? p[0] : 0;
    int code = btn & ~(4 | 8 | 16 | 32);
    int motion = (btn & 32) ? 1 : 0;
    k->mx = np > 1 ? p[1] : 0;
    k->my = np > 2 ? p[2] : 0;
    k->shift = (btn & 4) ? 1 : 0;
    k->alt = (btn & 8) ? 1 : 0;
    k->ctrl = (btn & 16) ? 1 : 0;
    /* 4/8/16 = shift/alt/ctrl; 32 = motion. Wheel is 64..67. */
    if (code == 64) return KEY_WHEEL_UP;
    if (code == 65) return KEY_WHEEL_DOWN;
    if (code == 66) return KEY_WHEEL_LEFT;
    if (code == 67) return KEY_WHEEL_RIGHT;
    if (code == 0) {
        if (fin == 'm') return KEY_MOUSE_UP;
        return motion ? KEY_MOUSE_DRAG : KEY_MOUSE;
    }
    if (code == 1 && fin == 'M' && !motion) return KEY_MOUSE_MID;
    return KEY_NONE;
}

/* CSI body at p[0..n) (after ESC [ ). Returns bytes of the body consumed,
 * 0 if incomplete. `malformed` = a byte that cannot be in a CSI. */
static size_t cctext_key_csi(const unsigned char *p, size_t n, CctextKey *k,
                             int *incomplete) {
    size_t i = 0;
    int priv = 0;
    int par[4] = {0, 0, 0, 0};
    int np = 0;
    int have = 0;
    int fin;
    *incomplete = 0;
    if (i < n && (p[i] == '<' || p[i] == '?' || p[i] == '>' || p[i] == '=')) {
        priv = p[i];
        i++;
    }
    while (i < n) {
        unsigned char c = p[i];
        if (c >= '0' && c <= '9') {
            if (np == 0) np = 1;
            if (par[np - 1] < 100000) par[np - 1] = par[np - 1] * 10 + (c - '0');
            have = 1;
        } else if (c == ';') {
            if (np == 0) np = 1;
            if (np < 4) par[np++] = 0;
        } else if (c >= 0x30 && c <= 0x3f) {
            /* other parameter bytes (':' subparams): skip */
        } else {
            break;
        }
        i++;
        if (i >= CCTEXT_CSI_MAX) return i; /* runaway: drop it */
    }
    while (i < n && p[i] >= 0x20 && p[i] <= 0x2f) i++;
    if (i >= n) {
        *incomplete = 1;
        return 0;
    }
    fin = p[i];
    if (fin < 0x40 || fin > 0x7e) {
        /* Not a CSI after all: drop what we parsed, keep the stray byte. */
        k->kind = KEY_NONE;
        return i;
    }
    i++;
    (void)have;
    if (priv == '<') {
        if (fin == 'M' || fin == 'm') k->kind = cctext_key_mouse(k, par, np, fin);
        return i;
    }
    if (priv) return i;
    if (np == 0 && (fin == 'I' || fin == 'O')) {
        k->kind = KEY_FOCUS;
        k->focus = fin == 'I' ? 1 : 0;
        return i;
    }
    if (fin == '~') {
        k->kind = cctext_key_tilde(k, par, np);
        return i;
    }
    /* kitty CSI u: CSI code ; mods u */
    if (fin == 'u') {
        k->kind = cctext_key_other(k, np > 0 ? par[0] : 0, np > 1 ? par[1] : 0);
        return i;
    }
    k->kind = cctext_key_letter(k, fin, np > 1 ? par[1] : 0);
    return i;
}

static int cctext_key_ctrl(CctextKey *k, int c) {
    int nav;
    /* Ctrl-letter (not ^H ^I ^J ^M: Backspace, Tab, Enter) and Ctrl-\\. */
    if (c >= 1 && c <= 26 && c != 8 && c != 9 && c != 10 && c != 13)
        k->chord = RTX_CHORD_CTRL | (uint32_t)('a' + c - 1);
    else if (c == 28)
        k->chord = RTX_CHORD_CTRL | (uint32_t)'\\';
    else if (c == 29)
        k->chord = RTX_CHORD_CTRL | (uint32_t)']';
    else if (c == 31)
        k->chord = RTX_CHORD_CTRL | (uint32_t)'-'; /* Ctrl-- / Ctrl-_ / Ctrl-/ */
    switch (c) {
        case 17: return KEY_QUIT;
        case 19: return KEY_SAVE;
        case 26: return KEY_UNDO;
        case 25: return KEY_REDO;
        case 24: return KEY_CUT;
        case 3: return KEY_COPY;
        case 22: return KEY_PASTE;
        case 23: return KEY_OTHER_PANE;
        case 29: return KEY_PANE_CLOSE; /* Ctrl-] */
        case 31: return KEY_SPLIT_DOWN; /* Ctrl-_ / Ctrl-- / Ctrl-/ */
        case 14: return KEY_NEXT_BUF;
        case 28: return KEY_SPLIT;
        case 7: return KEY_JUMP;
        case 6: return KEY_FIND;
        case 2: return KEY_OPEN;  /* Ctrl-B browse */
        case 15: return KEY_OPEN; /* Ctrl-O browse (also) */
        case 1: return KEY_SEL_ALL;
        case 12: return KEY_VIEW;
        case 4: return KEY_RICH; /* Ctrl-D rich / source */
        case 21: return KEY_FOLLOW;
        default: break;
    }
    nav = rtx_nav_from_ctrl(c);
    if (nav) {
        k->nav = nav;
        return KEY_NAV;
    }
    if (c == 127 || c == 8) return KEY_BACKSPACE;
    if (c == '\t') return KEY_TAB;
    if (c == '\r' || c == '\n') return KEY_ENTER;
    return KEY_NONE;
}

size_t cctext_key_decode(const unsigned char *p, size_t n, unsigned flags,
                         CctextKey *k) {
    int final = (flags & CCTEXT_KEY_FINAL) ? 1 : 0;
    int c;
    if (!k) return 0;
    cctext_key_zero(k);
    if (!p || n == 0) return 0;
    c = p[0];
    if (c == 0x1b) {
        if (n == 1) {
            if (!final) return 0;
            k->kind = KEY_HELP;
            return 1;
        }
        if (p[1] == 0x1b) {
            k->kind = KEY_HELP;
            return 1;
        }
        if (p[1] == '[') {
            int inc = 0;
            size_t used = cctext_key_csi(p + 2, n - 2, k, &inc);
            if (inc) {
                if (!final) return 0;
                /* ESC timeout inside a CSI: drop it, do not type it. */
                k->kind = KEY_NONE;
                return n;
            }
            return 2 + used;
        }
        if (p[1] == 'O') {
            if (n < 3) {
                if (!final) return 0;
                k->ch = 'O';
                k->kind = KEY_CMD_LETTER;
                return 2;
            }
            k->kind = cctext_key_letter(k, p[2], 0);
            if (p[2] == 'Z') k->kind = KEY_NONE;
            return 3;
        }
        /* Alt-Enter: a soft line break (Shift-Enter is plain CR in most
         * terminals). */
        if (p[1] == '\r' || p[1] == '\n') {
            k->alt = 1;
            k->kind = KEY_ENTER;
            return 2;
        }
        /* Alt / Meta + key: the command letter (menu-less terminals). The
         * find field reads alt to tell Alt-C (ignore case) from copy. */
        k->ch = p[1];
        k->alt = 1;
        k->kind = KEY_CMD_LETTER;
        k->chord = cctext_chord_code(p[1], 2);
        return 2;
    }
    /* Only right after a timed-out ESC may `[<…M` / `[I` / `[O` be the
     * rest of a mouse or focus report. Typed text is never guessed at. */
    if (c == '[' && (flags & CCTEXT_KEY_AFTER_ESC) && n == 1 && !final)
        return 0;
    if (c == '[' && (flags & CCTEXT_KEY_AFTER_ESC) && n >= 2 &&
        (p[1] == '<' || p[1] == 'I' || p[1] == 'O')) {
        int inc = 0;
        CctextKey t;
        size_t used;
        cctext_key_zero(&t);
        used = cctext_key_csi(p + 1, n - 1, &t, &inc);
        if (inc && !final) return 0;
        if (!inc && (t.kind == KEY_FOCUS || p[1] == '<')) {
            *k = t;
            return 1 + used;
        }
    }
    if (c < 0x20 || c == 0x7f) {
        k->kind = cctext_key_ctrl(k, c);
        return 1;
    }
    if (c < 0x80) {
        k->ch = c;
        k->kind = KEY_CHAR;
        return 1;
    }
    {
        int need = rtx_utf8_lead_len((unsigned char)c);
        uint32_t cp = 0;
        size_t i;
        if (need <= 1) return 1; /* stray continuation / invalid lead */
        if (n < (size_t)need) {
            for (i = 1; i < n; i++)
                if ((p[i] & 0xC0) != 0x80) return 1;
            if (!final) return 0;
            return n;
        }
        if (rtx_utf8_decode((const char *)p, (size_t)need, &cp) != need)
            return 1;
        k->ch = (int)cp;
        k->kind = KEY_CHAR;
        return (size_t)need;
    }
}

size_t cctext_paste_end(const unsigned char *p, size_t n, size_t *body) {
    size_t i, keep;
    if (body) *body = 0;
    if (!p || n == 0) return 0;
    for (i = 0; i + CCTEXT_PASTE_END_N <= n; i++) {
        if (p[i] != 0x1b) continue;
        {
            size_t j = 1;
            while (j < CCTEXT_PASTE_END_N &&
                   p[i + j] == (unsigned char)g_paste_end[j])
                j++;
            if (j == CCTEXT_PASTE_END_N) {
                if (body) *body = i;
                return i + CCTEXT_PASTE_END_N;
            }
        }
    }
    /* Hold back a tail that could be the start of the terminator. */
    keep = n < CCTEXT_PASTE_END_N ? n : CCTEXT_PASTE_END_N - 1;
    while (keep > 0) {
        size_t j = 0;
        while (j < keep && p[n - keep + j] == (unsigned char)g_paste_end[j]) j++;
        if (j == keep) break;
        keep--;
    }
    if (body) *body = n - keep;
    return 0;
}

size_t cctext_paste_norm(char *p, size_t n) {
    size_t i, o = 0;
    if (!p) return 0;
    for (i = 0; i < n; i++) {
        char c = p[i];
        if (c == '\r') {
            p[o++] = '\n';
            if (i + 1 < n && p[i + 1] == '\n') i++;
            continue;
        }
        p[o++] = c;
    }
    return o;
}
