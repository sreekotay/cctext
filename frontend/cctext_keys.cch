#!ccc cch
/*
 * cctext key ids and the pure byte decoder (cctext_keys.ccs). The host
 * read queue and bracketed paste live in cctext.ccs.
 */
#ifndef RTX_CCTEXT_KEYS_H
#define RTX_CCTEXT_KEYS_H

#include <stddef.h>
#include <stdint.h>
#include "../core/cmd.cch"

enum {
    KEY_NONE = 0,
    KEY_QUIT,
    KEY_SAVE,
    KEY_UNDO,
    KEY_REDO,
    KEY_CUT,
    KEY_COPY,
    KEY_PASTE,
    KEY_SPLIT,
    KEY_OTHER_PANE,
    KEY_NEXT_BUF,
    KEY_UP,
    KEY_DOWN,
    KEY_LEFT,
    KEY_RIGHT,
    KEY_BACKSPACE,
    KEY_DELETE,
    KEY_ENTER,
    KEY_MOUSE,
    KEY_MOUSE_DRAG,
    KEY_WHEEL_UP,
    KEY_WHEEL_DOWN,
    KEY_WHEEL_LEFT,
    KEY_WHEEL_RIGHT,
    KEY_HELP,
    KEY_JUMP,
    KEY_FIND,
    KEY_OPEN,
    KEY_SEL_ALL,
    KEY_HOME,
    KEY_END,
    KEY_VIEW,
    KEY_RICH,
    KEY_WRAP,
    KEY_APPLY,
    KEY_APPLY_MENU,
    KEY_FOLLOW,
    KEY_NAV,
    KEY_STATS,
    KEY_TAB,
    KEY_CHAR,
    KEY_PAGE_UP,
    KEY_PAGE_DOWN,
    KEY_DOC_HOME,    /* Ctrl-Home */
    KEY_DOC_END,     /* Ctrl-End */
    /* g_text / g_text_n: one insert (paste), or a typed run. */
    KEY_PASTE_TEXT,
    KEY_TEXT,
    /* Buffers and panes. KEY_SPLIT is split right, KEY_OTHER_PANE focus
     * next, KEY_NEXT_BUF the next tab. */
    KEY_CLOSE_BUF,   /* Ctrl-W */
    KEY_PREV_BUF,    /* Ctrl-PgUp / Ctrl-Shift-Tab */
    KEY_TAB_NEXT,    /* Ctrl-PgDn / Ctrl-Tab (Ctrl-N is KEY_NEXT_BUF; in
                      * browse it launches this frontend) */
    KEY_SPLIT_DOWN,  /* Ctrl-_ (Ctrl-- / Ctrl-/ send it) */
    KEY_PANE_CLOSE,  /* Ctrl-] */
    KEY_PANE_PREV,   /* Shift-F6 */
    KEY_PANE_MOVE,   /* Ctrl-F6: this buffer into the next pane */
    KEY_PANE_NUDGE,  /* Ctrl-Alt-arrow: nav = 1 left, 2 right, 3 up, 4 down */
    KEY_CLOSE_OTHERS,
    KEY_CLOSE_ALL,
    KEY_TABS,        /* tab bar on / off */
    KEY_MOUSE_MID,   /* middle button press */
    /* Project (core/ui_proj.cch): host kinds of the "workspace.*" rows
     * (cctext_kind_of_row), not decoder output — the chords are Ctrl-P,
     * Ctrl-Shift-F / Alt-Shift-F, F4 / Shift-F4, F5. */
    KEY_QUICK_OPEN,
    KEY_PROJ_SEARCH,
    KEY_PROJ_NEXT,
    KEY_PROJ_PREV,
    KEY_PROJ_REWALK,
    /* Decoder only; the host maps these before cctext_handle_input. */
    KEY_CMD_LETTER,  /* Alt-letter / CSI u: ch is the letter */
    KEY_PASTE_BEGIN, /* CSI 200 ~ : the host reads the body */
    KEY_MOUSE_UP,
    KEY_FOCUS,       /* CSI I / CSI O: focus is 1 / 0 */
    KEY_CMD          /* a command-table row (g_cmd_row): palette, keymap */
};

typedef struct {
    int kind;
    int ch;     /* KEY_CHAR scalar; KEY_CMD_LETTER letter */
    int nav;    /* KEY_NAV */
    int shift, alt, ctrl;
    int mx, my; /* SGR mouse cell (1-based) */
    int focus;  /* KEY_FOCUS: 1 in, 0 out; else -1 */
    uint32_t chord; /* RTX_CHORD_* key + mods when this event is a chord the
                     * keymap may rebind (Ctrl-letter, Alt-letter, CSI u,
                     * F-keys, Ctrl-Tab / PgUp / PgDn); else 0. `kind` is
                     * the built-in meaning the host keeps when nothing
                     * binds it. */
} CctextKey;

/* No more bytes are coming (the ESC wait passed). */
#define CCTEXT_KEY_FINAL 1u
/* The previous event was a timed-out lone ESC: `[<…M` / `[I` / `[O` that
 * follow are the tail of that report, not typed text. */
#define CCTEXT_KEY_AFTER_ESC 2u

/* Decode one event from p[0..n). Returns bytes consumed; 0 = incomplete
 * (read more, or call again with CCTEXT_KEY_FINAL). */
size_t cctext_key_decode(const unsigned char *p, size_t n, unsigned flags,
                         CctextKey *k);
/* Bracketed paste: find ESC [ 201 ~ in p[0..n). Returns bytes through the
 * terminator (body = bytes before it), or 0 with body = the bytes that
 * cannot be part of a split terminator. */
size_t cctext_paste_end(const unsigned char *p, size_t n, size_t *body);
/* CR LF and a lone CR become LF, in place. Returns the new length. */
size_t cctext_paste_norm(char *p, size_t n);

#endif
