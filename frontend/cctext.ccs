#!ccc ccs
/*
 * cctext — POSIX console frontend. Same document/layout as cctext-gui.
 *
 *   cctext [-h|--help] [-v|--version] [--no-blink] [--backup] [--stats-json]
 *          [--batch] [-c CMD]... [--safe]
 *          [--wrap|--hex|--grid|--view=default|wrap|hex|grid] [file ...]
 *
 *   --batch runs -c commands (or a script on stdin) with no TTY. Safe journals
 *   are off unless --safe.
 *
 *   Esc help menu   g / Ctrl-G jump   f / Ctrl-F find   b / Ctrl-B browse
 *   (o / Ctrl-O also browse)   browse ^O this app   browse e the other app
 *   k / Ctrl-K next mark   p / Ctrl-P prev mark   t / Ctrl-T fold   l / Ctrl-L cycle view
 *   (browse: Ctrl-L cycles the right-hand preview)
 *   click caret   drag select   shift-arrows   Alt-arrows box   type to insert
 */
#include <ccc/std/prelude.cch>
#include <stdio.h>
#include <string.h>
#include <stdlib.h>
#include <unistd.h>
#include <termios.h>
#include <sys/ioctl.h>
#include <sys/select.h>
#include <fcntl.h>
#include <errno.h>
#include <signal.h>
#include <time.h>
#include "../core/utf8.cch"
#include "../core/document.cch"
#include "../core/nav.cch"
#include "../core/layout.cch"
#include "../core/workspace.cch"
#include "../core/find.cch"
#include "../core/ui.cch"
#include "../core/browse.cch"
#include "cctext.cch"

static struct termios g_old;
static int g_raw = 0;
int g_mouse_col;
int g_mouse_row;
int g_mouse_press;
int g_mouse_drag;
int g_drag_edge;
int g_field_drag; /* 1 find query, 2 browse glob */
int g_shift;
int g_alt;
int g_nav;
char g_status[160];
static volatile sig_atomic_t g_winch;
static int g_busy_frame;
/* Status-row spinner while piece-tree scan/save runs (blocking). */
static void cctext_busy(void *ctx, const char *label, int pct) {
    struct winsize ws;
    int cols = 80;
    int rows = 24;
    const char *spin = "|/-\\";
    char msg[48];
    int n;
    (void)ctx;
    if (ioctl(STDOUT_FILENO, TIOCGWINSZ, &ws) == 0) {
        if (ws.ws_col > 0) cols = ws.ws_col;
        if (ws.ws_row > 0) rows = ws.ws_row;
    }
    if (!label) {
        fprintf(stdout, "\x1b[s\x1b[%d;%dH\x1b[K\x1b[u",
                rows, cols > 1 ? cols - 24 : 1);
        fflush(stdout);
        return;
    }
    if (pct >= 0) {
        n = snprintf(msg, sizeof(msg), "%c %s %d%%",
                     spin[g_busy_frame++ & 3], label, pct);
    } else {
        n = snprintf(msg, sizeof(msg), "%c %s", spin[g_busy_frame++ & 3], label);
    }
    if (n < 0) n = 0;
    if (n > 24) n = 24;
    /* Status row, not row 1: the rail lives on the right edge and xenl
     * already eats (1,cols). A corner overlay would hide the thumb at BOF. */
    fprintf(stdout, "\x1b[s\x1b[%d;%dH\x1b[33;1m%.*s\x1b[0m\x1b[u",
            rows, cols > n ? cols - n + 1 : 1, n, msg);
    fflush(stdout);
}

static char g_outbuf[65536];

static void cctext_restore(void) {
    if (g_raw) tcsetattr(STDIN_FILENO, TCSANOW, &g_old);
    cctext_osx_stop();
    fputs("\x1b[?2026l\x1b[?7h\x1b[?1002l\x1b[?1000l\x1b[?1006l\x1b[?1004l"
          "\x1b[0m\x1b[0 q\x1b[?25h\x1b[?1049l", stdout);
    fflush(stdout);
    g_raw = 0;
}

static void cctext_on_winch(int sig) {
    (void)sig;
    g_winch = 1;
}

static int cctext_raw(void) {
    struct termios t;
    if (tcgetattr(STDIN_FILENO, &g_old) != 0) return 0;
    t = g_old;
    cfmakeraw(&t);
    t.c_cc[VMIN] = 1;
    t.c_cc[VTIME] = 0;
#ifdef _POSIX_VDISABLE
    t.c_cc[VINTR] = _POSIX_VDISABLE;
    t.c_cc[VQUIT] = _POSIX_VDISABLE;
    t.c_cc[VSUSP] = _POSIX_VDISABLE;
    t.c_cc[VSTART] = _POSIX_VDISABLE;
    t.c_cc[VSTOP] = _POSIX_VDISABLE;
#ifdef VLNEXT
    t.c_cc[VLNEXT] = _POSIX_VDISABLE;
#endif
#ifdef VDISCARD
    t.c_cc[VDISCARD] = _POSIX_VDISABLE;
#endif
#endif
    if (tcsetattr(STDIN_FILENO, TCSANOW, &t) != 0) return 0;
    setvbuf(stdin, NULL, _IONBF, 0);
    setvbuf(stdout, g_outbuf, _IOFBF, sizeof(g_outbuf));
    g_raw = 1;
    {
        struct sigaction sa = {0};
        sa.sa_handler = cctext_on_winch;
        sigemptyset(&sa.sa_mask);
        sigaction(SIGWINCH, &sa, NULL);
    }
    fputs("\x1b[?1049h\x1b[?25l\x1b[1 q\x1b[?7l\x1b[?1000h\x1b[?1002h\x1b[?1006h"
          "\x1b[?1004h",
          stdout);
    fflush(stdout);
    cctext_osx_start();
    atexit(cctext_restore);
    return 1;
}

static void cctext_winsize(int *rows, int *cols) {
    struct winsize w;
    *rows = 24;
    *cols = 80;
    if (ioctl(STDOUT_FILENO, TIOCGWINSZ, &w) == 0 && w.ws_row && w.ws_col) {
        *rows = w.ws_row;
        *cols = w.ws_col;
    }
}

static double cctext_measure(void *ctx, char[:] bytes, RtxStyle style, RtxSectionKind sec) {
    (void)ctx;
    (void)style;
    (void)sec;
    return (double)rtx_utf8_cols(bytes);
}

static double cctext_lh(void *ctx, RtxStyle style, RtxSectionKind sec) {
    (void)ctx;
    (void)style;
    (void)sec;
    return 1.0;
}

/* Next byte if already in the stdio buffer or the kernel; does not block.
 * select() on the fd is wrong after getchar() — the rest of ESC[<mouse
 * is often already in the FILE buffer, so select times out and we treat
 * a mouse CSI as typed text. */
int cctext_pending(void) {
    int flags = fcntl(STDIN_FILENO, F_GETFL, 0);
    int c;
    if (flags < 0) return -1;
    if (fcntl(STDIN_FILENO, F_SETFL, flags | O_NONBLOCK) < 0) return -1;
    c = fgetc(stdin);
    fcntl(STDIN_FILENO, F_SETFL, flags);
    if (c == EOF) {
        clearerr(stdin);
        return -1;
    }
    return c;
}

/* Focus/mouse CSI often arrives as ESC, then `[`. A bare pending()
 * would treat that as Help and close the boot browser. */
static int cctext_pending_wait(void) {
    int c;
    fd_set rfds;
    struct timeval tv;
    c = cctext_pending();
    if (c >= 0) return c;
    FD_ZERO(&rfds);
    FD_SET(STDIN_FILENO, &rfds);
    tv.tv_sec = 0;
    tv.tv_usec = 40000;
    if (select(STDIN_FILENO + 1, &rfds, NULL, NULL, &tv) <= 0) return -1;
    return cctext_pending();
}

static int cctext_isle_yield(void) {
    int c = cctext_pending();
    if (c < 0) return 0;
    ungetc(c, stdin);
    return 1;
}

int cctext_decode_utf8(int lead, uint32_t *cp) {
    char seq[4];
    int need, i, n;
    if (lead < 0x80) {
        if (cp) *cp = (uint32_t)lead;
        return 1;
    }
    need = rtx_utf8_lead_len((unsigned char)lead);
    if (need <= 1) return 0;
    seq[0] = (char)lead;
    for (i = 1; i < need; i++) {
        int b = cctext_pending();
        if (b < 0 || (b & 0xC0) != 0x80) {
            if (b >= 0) ungetc(b, stdin);
            return 0;
        }
        seq[i] = (char)b;
    }
    n = rtx_utf8_decode(seq, (size_t)need, cp);
    return n == need;
}

static int cctext_parse_mouse(void) {
    int btn = 0, col = 0, row = 0, *slot = &btn;
    int d;
    int press = 0;
    while ((d = getchar()) != EOF) {
        if (d >= '0' && d <= '9') {
            *slot = (*slot * 10) + (d - '0');
        } else if (d == ';') {
            if (slot == &btn) slot = &col;
            else slot = &row;
        } else if (d == 'M' || d == 'm') {
            press = (d == 'M');
            break;
        } else {
            break;
        }
    }
    g_mouse_col = col;
    g_mouse_row = row;
    g_mouse_press = press;
    g_shift = (btn & 4) ? 1 : 0;
    g_alt = (btn & 8) ? 1 : 0;
    {
        /* 4/8/16 = shift/alt/ctrl; 32 = motion. Wheel is 64..67. */
        int code = btn & ~(4 | 8 | 16 | 32);
        int motion = (btn & 32) ? 1 : 0;
        if (code == 64) return KEY_WHEEL_UP;
        if (code == 65) return KEY_WHEEL_DOWN;
        if (code == 66) return KEY_WHEEL_LEFT;
        if (code == 67) return KEY_WHEEL_RIGHT;
        if (code == 0) {
            if (!press) {
                g_mouse_drag = 0;
                g_drag_edge = 0;
                return KEY_NONE;
            }
            g_mouse_drag = 1;
            return motion ? KEY_MOUSE_DRAG : KEY_MOUSE;
        }
    }
    return KEY_NONE;
}

/* xterm mods: 1 + shift(1) + alt(2) + ctrl(4) + meta/cmd(8). */
static int cctext_with_mods(int key, int mods) {
    int bits = mods > 0 ? mods - 1 : 0;
    if (bits & 1) g_shift = 1;
    if (bits & 2) g_alt = 1;
    if ((bits & 4) || (bits & 8)) {
        if (key == KEY_LEFT) return KEY_HOME;
        if (key == KEY_RIGHT) return KEY_END;
    }
    return key;
}

static int cctext_csi_letter(int d, int n, int mods) {
    if (d == 'I') {
        cctext_osx_focus(1);
        return KEY_NONE;
    }
    if (d == 'O') {
        cctext_osx_focus(0);
        return KEY_NONE;
    }
    if (d == 'A') return cctext_with_mods(KEY_UP, mods);
    if (d == 'B') return cctext_with_mods(KEY_DOWN, mods);
    if (d == 'C') return cctext_with_mods(KEY_RIGHT, mods);
    if (d == 'D') return cctext_with_mods(KEY_LEFT, mods);
    if (d == 'H') return cctext_with_mods(KEY_HOME, mods);
    if (d == 'F') return cctext_with_mods(KEY_END, mods);
    if (d == 'Z') {
        g_shift = 1;
        return KEY_TAB;
    }
    if (d == '~') {
        if (n == 3) return KEY_DELETE;
        if (n == 1 || n == 7) return cctext_with_mods(KEY_HOME, mods);
        if (n == 4 || n == 8) return cctext_with_mods(KEY_END, mods);
    }
    return KEY_NONE;
}

static int cctext_parse_csi(int first) {
    int b = first;
    if (b < 0) b = getchar();
    if (b == '<') return cctext_parse_mouse();
    if (b == 'A' || b == 'B' || b == 'C' || b == 'D' || b == 'H' || b == 'F' ||
        b == 'I' || b == 'O' || b == 'Z') {
        return cctext_csi_letter(b, 0, 0);
    }
    if (b >= '0' && b <= '9') {
        int n = b - '0';
        int d;
        int mods = 0;
        int saw_mod = 0;
        while ((d = getchar()) != EOF) {
            if (d >= '0' && d <= '9') {
                if (saw_mod) mods = mods * 10 + (d - '0');
                else n = n * 10 + (d - '0');
            } else if (d == ';') {
                saw_mod = 1;
            } else {
                return cctext_csi_letter(d, n, mods);
            }
        }
    }
    return KEY_NONE;
}

/* 1 stdin, 2 session scroll tap, 0 timeout, -1 error. */
static int cctext_wait_in(int wait_us) {
    fd_set rfds;
    struct timeval tv;
    int n;
    int sfd = cctext_osx_scroll_fd();
    int maxfd = STDIN_FILENO;
    FD_ZERO(&rfds);
    FD_SET(STDIN_FILENO, &rfds);
    if (sfd >= 0) {
        FD_SET(sfd, &rfds);
        if (sfd > maxfd) maxfd = sfd;
    }
    tv.tv_sec = 0;
    tv.tv_usec = wait_us < 0 ? 400000 : wait_us;
    n = select(maxfd + 1, &rfds, NULL, NULL, &tv);
    if (n < 0) return -1;
    if (n == 0) return 0;
    if (FD_ISSET(STDIN_FILENO, &rfds)) return 1;
    if (sfd >= 0 && FD_ISSET(sfd, &rfds)) return 2;
    return 0;
}

static int cctext_osx_wheel(void) {
    int d = cctext_osx_scroll_dir();
    g_shift = 0;
    g_alt = 0;
    if (d < 0) return KEY_WHEEL_LEFT;
    if (d > 0) return KEY_WHEEL_RIGHT;
    return KEY_NONE;
}

static int cctext_read(int *ch_out, int wait_us) {
    int c;
    if (g_winch) return KEY_NONE;
    /* Terminals clamp the pointer to row 1..rows. While a drag sits on
     * the first or last text row, poll so we keep scrolling without a wiggle. */
    if (g_mouse_drag && g_drag_edge) {
        int n = cctext_wait_in(32000);
        if (n == 0) return KEY_MOUSE_DRAG;
        if (n < 0) return KEY_NONE;
        if (n == 2) return cctext_osx_wheel();
    } else {
        /* Wake on SIGWINCH. Do not select if stdio already holds a CSI byte. */
        int peek = cctext_pending();
        if (peek >= 0) {
            ungetc(peek, stdin);
        } else {
            int n = cctext_wait_in(wait_us);
            if (n < 0) return (errno == EINTR) ? KEY_NONE : KEY_QUIT;
            if (n == 0) return KEY_NONE;
            if (n == 2) return cctext_osx_wheel();
        }
    }
    if (g_winch) return KEY_NONE;
    c = getchar();
    g_shift = 0;
    g_alt = 0;
    if (c == EOF) return KEY_QUIT;
    if (c == 17) return KEY_QUIT;
    if (c == 19) return KEY_SAVE;
    if (c == 26) return KEY_UNDO;
    if (c == 25) return KEY_REDO;
    if (c == 24) return KEY_CUT;
    if (c == 3) return KEY_COPY;
    if (c == 22) return KEY_PASTE;
    if (c == 23) return KEY_OTHER_PANE;
    if (c == 14) return KEY_NEXT_BUF;
    if (c == 28) return KEY_SPLIT;
    if (c == 7) return KEY_JUMP;
    if (c == 6) return KEY_FIND;
    if (c == 2) return KEY_OPEN;   /* Ctrl-B browse */
    if (c == 15) return KEY_OPEN;  /* Ctrl-O browse (also) */
    if (c == 1) return KEY_SEL_ALL;
    if (c == 12) return KEY_VIEW;
    if (c == 21) return KEY_FOLLOW;
    {
        int nav = rtx_nav_from_ctrl(c);
        if (nav) {
            g_nav = nav;
            return KEY_NAV;
        }
    }
    if (c == 127 || c == 8) return KEY_BACKSPACE;
    if (c == '\t') return KEY_TAB;
    if (c == '\r' || c == '\n') return KEY_ENTER;
    if (c == 0x1b) {
        int a = cctext_pending_wait();
        if (a < 0) return KEY_HELP;
        if (a == 0x1b) {
            ungetc(a, stdin);
            return KEY_HELP;
        }
        if (a == 'O') {
            int b = getchar();
            if (b == 'A') return KEY_UP;
            if (b == 'B') return KEY_DOWN;
            if (b == 'C') return KEY_RIGHT;
            if (b == 'D') return KEY_LEFT;
            if (b == 'H') return KEY_HOME;
            if (b == 'F') return KEY_END;
            return KEY_NONE;
        }
        if (a == '[') return cctext_parse_csi(-1);
        return cctext_cmd_letter(a);
    }
    /* Leftover CSI after a botched ESC: mouse or 1004 focus. */
    if (c == '[') {
        int n = cctext_pending();
        if (n == '<') return cctext_parse_mouse();
        if (n == 'I' || n == 'O') {
            cctext_osx_focus(n == 'I');
            return KEY_NONE;
        }
        if (n >= 0) ungetc(n, stdin);
    }
    if (c == '<') {
        int n = cctext_pending();
        if (n >= '0' && n <= '9') {
            ungetc(n, stdin);
            return cctext_parse_mouse();
        }
        if (n >= 0) ungetc(n, stdin);
    }
    if (c >= 32 && c < 127) {
        *ch_out = c;
        return KEY_CHAR;
    }
    if (c >= 0x80) {
        uint32_t cp;
        if (cctext_decode_utf8(c, &cp)) {
            *ch_out = (int)cp;
            return KEY_CHAR;
        }
        return KEY_NONE;
    }
    return KEY_NONE;
}
int main(int argc, char **argv) {
    @errhandler(CCError e) {
            snprintf(g_status, sizeof(g_status), "%s",
                     e.message ? e.message : "error");
        cc_error_log(e);
        if (!g_raw) return 1;
    }
    @errhandler(RtxIndexErr e) {
        (void)e;
        if (!g_raw) return 1;
    }
    RtxWs w = {0} @destroy;
    RtxMeasure m;
    char *filebuf[32];
    RtxCli cli;
    const char *prog;
    int rows = 24, cols = 80;
    int last_rows = 0, last_cols = 0;
    int kind;
    int ch = 0;
    int skip_reveal = 0;
    RtxUi ui;

    prog = (argc > 0 && argv[0] && argv[0][0]) ? argv[0] : "cctext";
    rtx_host_set_exe(prog);
    if (rtx_cli_parse(argc, argv, filebuf, 32, &cli) != 0) {
        rtx_cli_usage(stderr, prog);
        return 2;
    }
    if (cli.help) {
        rtx_cli_usage(stdout, prog);
        return 0;
    }
    if (cli.version) {
        rtx_cli_print_version(stdout, prog);
        return 0;
    }
    rtx_doc_set_save_backup(cli.backup);
    if (cli.batch) {
        int rc;
        if (!cli.safe) rtx_safe_set_enabled(0);
        if (cli.nfiles == 0) {
            fprintf(stderr, "cctext --batch needs a file\n");
            return 2;
        }
        w.open_files(cli.nfiles, filebuf) !>;
        rtx_cli_apply_views(&w, &cli);
        if (cli.ncmds > 0)
            rc = rtx_batch_run(&w, cli.cmds, cli.ncmds, stdout, stderr);
        else
            rc = rtx_batch_run_fp(&w, stdin, stdout, stderr);
        if (cli.stats_json) rtx_ui_write_stats_json(stdout, w.active());
        return rc ? 1 : 0;
    }
    if (cli.nfiles == 0) {
        w.open_files(0, NULL) !>;
    } else {
        w.open_files(cli.nfiles, filebuf) !>;
    }
    rtx_cli_apply_views(&w, &cli);
    m.measure = cctext_measure;
    m.line_height = cctext_lh;
    m.ctx = NULL;
    g_status[0] = 0;
    ui = (RtxUi){0};
    ui.no_blink = cli.no_blink;

    if (!isatty(STDIN_FILENO) || !cctext_raw()) {
        /* Batch/pipe without --batch: --stats-json dumps and exits. Else
         * stream bytes. Do not walk soft line_count. */
        if (cli.stats_json) {
            rtx_ui_write_stats_json(stdout, w.active());
            return 0;
        }
        RtxBuf *b = w.active();
        char buf[64 * 1024];
        size_t off = 0;
        size_t n = b ? b->len() : 0;
        while (off < n) {
            size_t take = sizeof(buf);
            size_t got;
            if (take > n - off) take = n - off;
            got = b->read_at(off, buf, take) !>;
            if (!got) break;
            fwrite(buf, 1, got, stdout);
            off += got;
        }
        return 0;
    }

    w.busy_bind(cctext_busy, NULL);
    if (cli.nfiles == 0 || w.untitled()) w.browse_start() !>;

    /* input → pump → layout → paint. Dirty is a flag, not a timestamp.
     * Read blocks; timeout 0 while dirty so the first frame and the
     * frame after a key paint in the same turn. */
    {
        int dirty = 1;
        int chrome = 0;
        long tick_at = 0;
        int isle_was = 0;
        int browse_busy_was = 0;
        size_t browse_cur = (size_t)-1;
        for (;;) {
            int vis;
            int find_h;
            int p;
            int wait_us;
            int isle_on;
            int scan_on;
            int browse_tick;
            int find_tick;
            long now;
            long tick_ms;
            RtxBuf *act;

            act = w.active();
            wait_us = 400000;
            if (rtx_ui_work_pumping(&ui, act ? &act->doc : NULL) || ui.stats)
                wait_us = 0;
            else if (RtxWs_browse_busy(&w) || browse_busy_was)
                wait_us = 16000;
            else if ((act && rtx_line_isle_pumping(&act->doc.tree)) ||
                     rtx_ui_find_scanning(&ui, act ? &act->doc : NULL))
                wait_us = (int)RTX_LINE_ISLE_PAINT_MS * 1000;
            if (dirty || chrome) wait_us = 0;

            kind = cctext_read(&ch, wait_us);
            if (kind != KEY_NONE) rtx_ui_blink_show(&ui);

            cctext_winsize(&rows, &cols);
            if (g_winch || rows != last_rows || cols != last_cols) {
                int rp;
                g_winch = 0;
                last_rows = rows;
                last_cols = cols;
                fputs("\x1b[H\x1b[J", stdout);
                dirty = 1;
                for (rp = 0; rp < w.npanes; rp++) {
                    int held = w.hold_pane(rp);
                    w.bufs[w.pane[rp]].layout.clear_rows();
                    w.drop_pane(rp, held);
                }
            }
            find_h = rtx_ui_find_rows(&ui, rows);
            vis = rows - 1 - find_h;
            if (vis < 1) vis = 1;

            act = w.active();
            if (!act) break;
            if (!g_mouse_drag && act->drag_len) {
                act->drag_vis = 0;
                act->drag_len = 0;
                act->drag_grab = 0;
            }
            if (!g_mouse_drag) g_field_drag = 0;
            if (cctext_handle_input(&w, act, &m, &ui, kind, ch, vis, cols,
                                    &skip_reveal))
                break;
            if (kind != KEY_NONE) dirty = 1;
            act = w.active();
            if (!act) break;

            if (act) {
                size_t caret0 = act->doc.caret;
                rtx_ui_work_pump(&ui, act, vis, cctext_isle_yield) !>;
                if (act->doc.caret != caret0) {
                    if (ui.find && act->doc.find.pinned)
                        act->land(vis) !>;
                    else if (!ui.find && !act->unlock)
                        cctext_follow_caret(act);
                    dirty = 1;
                }
            }
            RtxWs_browse_pump(&w) !>;
            w.safe_pump();

            isle_on = act && rtx_line_isle_pumping(&act->doc.tree);
            if (isle_was && !isle_on) dirty = 1;
            isle_was = isle_on;

            now = rtx_ui_now_ms();
            scan_on = RtxWs_browse_scanning(&w);
            browse_tick = RtxWs_browse_busy(&w);
            find_tick = rtx_ui_find_scanning(&ui, act ? &act->doc : NULL);
            tick_ms = scan_on ? (long)RTX_BROWSE_PAINT_MS
                              : (long)RTX_LINE_ISLE_PAINT_MS;
            if (browse_busy_was && !browse_tick) dirty = 1;
            browse_busy_was = browse_tick;
            if (!w.nav[w.focus].on) {
                if (!act || !act->layout.rows.len) dirty = 1;
                else if (act->seek_valid && !rtx_buf_seek_cam_row(act))
                    dirty = 1;
            } else if (w.nav[w.focus].cur != browse_cur) {
                dirty = 1;
            }
            if ((browse_tick || isle_on) &&
                (tick_at == 0 || now - tick_at >= tick_ms))
                dirty = 1;
            else if ((find_tick || ui.stats) &&
                     (tick_at == 0 || now - tick_at >= (long)RTX_LINE_ISLE_PAINT_MS))
                chrome = 1;
            if (rtx_ui_blink_step(&ui)) chrome = 1;

            if (dirty) {
                RtxWs_browse_pause(&w);
                if (act) rtx_line_isle_pause(&act->doc.tree);
                if (act) rtx_find_pause(&act->doc);
                for (p = 0; p < w.npanes; p++) {
                    RtxBuf *b = &w.bufs[w.pane[p]];
                    double pw = (double)cctext_pane_cols(&w, cols, p);
                    int held = w.hold_pane(p);
                    if (!w.nav[p].on) {
                        if (p == w.focus && !ui.find && !skip_reveal)
                            cctext_ensure_caret(b, vis);
                        b->ensure_view(&m,
                                       (double)cctext_text_cols(b, (int)pw, vis),
                                       vis) !>;
                    }
                    w.drop_pane(p, held);
                }
                cctext_draw(&w, &ui, rows, cols);
                tick_at = now;
                if (w.nav[w.focus].on) browse_cur = w.nav[w.focus].cur;
                if (act) rtx_find_resume(&act->doc);
                if (act) rtx_line_isle_resume(&act->doc.tree);
                RtxWs_browse_resume(&w);
                dirty = 0;
                chrome = 0;
                skip_reveal = 0;
            } else if (chrome) {
                cctext_draw_chrome(&w, &ui, rows, cols);
                tick_at = now;
                chrome = 0;
            }
        }
    }
    w.safe_flush_exit();
    w.busy_bind(NULL, NULL);
    cctext_restore();
    if (cli.stats_json) rtx_ui_write_stats_json(stdout, w.active());
    if (rtx_ws_close_heavy(&w)) _exit(0);
    return 0;
}
