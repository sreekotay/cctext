#!ccc ccs
/*
 * cctext — POSIX console frontend. Same document/layout as raytext.
 *
 *   cctext [file ...]
 *
 *   Esc help menu   g / Ctrl-G jump   f / Ctrl-F find   l / Ctrl-L cycle view
 *   click caret   drag select   shift-arrows   Alt-arrows box   type to insert
 */
#include <ccc/std/prelude.cch>
#include <ccc/script/stdio.cch>
#include <stdio.h>
#include <string.h>
#include <stdlib.h>
#include <unistd.h>
#include <termios.h>
#include <sys/ioctl.h>
#include <sys/select.h>
#include <fcntl.h>
#include <errno.h>
#include <signal.h>
#include "../core/document.cch"
#include "../core/layout.cch"
#include "../core/workspace.cch"

enum {
    KEY_NONE = 0,
    KEY_QUIT,
    KEY_SAVE,
    KEY_UNDO,
    KEY_REDO,
    KEY_CUT,
    KEY_COPY,
    KEY_PASTE,
    KEY_SPLIT,
    KEY_OTHER_PANE,
    KEY_NEXT_BUF,
    KEY_UP,
    KEY_DOWN,
    KEY_LEFT,
    KEY_RIGHT,
    KEY_BACKSPACE,
    KEY_DELETE,
    KEY_ENTER,
    KEY_MOUSE,
    KEY_MOUSE_DRAG,
    KEY_WHEEL_UP,
    KEY_WHEEL_DOWN,
    KEY_HELP,
    KEY_JUMP,
    KEY_FIND,
    KEY_SEL_ALL,
    KEY_HOME,
    KEY_END,
    KEY_VIEW,
    KEY_CHAR
};

static struct termios g_old;
static int g_raw = 0;
static int g_mouse_col;
static int g_mouse_row;
static int g_mouse_press;
static int g_mouse_drag;
static int g_drag_edge;
static int g_shift;
static int g_alt;
static char g_status[160];
static volatile sig_atomic_t g_winch;
static int g_busy_frame;

/* Corner spinner while piece-tree scan/save runs (blocking). */
static void cctext_busy(void *ctx, const char *label, int pct) {
    struct winsize ws;
    int cols = 80;
    int rows = 24;
    const char *spin = "|/-\\";
    char msg[48];
    int n;
    (void)ctx;
    if (ioctl(STDOUT_FILENO, TIOCGWINSZ, &ws) == 0) {
        if (ws.ws_col > 0) cols = ws.ws_col;
        if (ws.ws_row > 0) rows = ws.ws_row;
    }
    if (!label) {
        fprintf(stdout, "\x1b[s\x1b[1;%dH\x1b[K\x1b[u", cols > 1 ? cols - 24 : 1);
        fflush(stdout);
        return;
    }
    if (pct >= 0) {
        n = snprintf(msg, sizeof(msg), "%c %s %d%%",
                     spin[g_busy_frame++ & 3], label, pct);
    } else {
        n = snprintf(msg, sizeof(msg), "%c %s", spin[g_busy_frame++ & 3], label);
    }
    if (n < 0) n = 0;
    if (n > 24) n = 24;
    fprintf(stdout, "\x1b[s\x1b[1;%dH\x1b[33;1m%.*s\x1b[0m\x1b[u",
            cols > n ? cols - n + 1 : 1, n, msg);
    (void)rows;
    fflush(stdout);
}

static char g_outbuf[65536];

static void cctext_restore(void) {
    if (g_raw) tcsetattr(STDIN_FILENO, TCSANOW, &g_old);
    fputs("\x1b[?2026l\x1b[?7h\x1b[?1002l\x1b[?1000l\x1b[?1006l"
          "\x1b[0m\x1b[?25h\x1b[?1049l", stdout);
    fflush(stdout);
    g_raw = 0;
}

static int cctext_cmd_letter(int c) {
    if (c >= 'A' && c <= 'Z') c = c - 'A' + 'a';
    switch (c) {
        case 'q': return KEY_QUIT;
        case 's': return KEY_SAVE;
        case 'z': return KEY_UNDO;
        case 'y': return KEY_REDO;
        case 'x': return KEY_CUT;
        case 'c': return KEY_COPY;
        case 'v': return KEY_PASTE;
        case 'w': return KEY_OTHER_PANE;
        case 'n': return KEY_NEXT_BUF;
        case '\\': return KEY_SPLIT;
        case 'g': return KEY_JUMP;
        case 'f': return KEY_FIND;
        case 'a': return KEY_SEL_ALL;
        case 'l': return KEY_VIEW;
        default: return KEY_NONE;
    }
}

static void cctext_on_winch(int sig) {
    (void)sig;
    g_winch = 1;
}

static int cctext_raw(void) {
    struct termios t;
    if (tcgetattr(STDIN_FILENO, &g_old) != 0) return 0;
    t = g_old;
    cfmakeraw(&t);
    t.c_cc[VMIN] = 1;
    t.c_cc[VTIME] = 0;
#ifdef _POSIX_VDISABLE
    t.c_cc[VINTR] = _POSIX_VDISABLE;
    t.c_cc[VQUIT] = _POSIX_VDISABLE;
    t.c_cc[VSUSP] = _POSIX_VDISABLE;
    t.c_cc[VSTART] = _POSIX_VDISABLE;
    t.c_cc[VSTOP] = _POSIX_VDISABLE;
#ifdef VLNEXT
    t.c_cc[VLNEXT] = _POSIX_VDISABLE;
#endif
#ifdef VDISCARD
    t.c_cc[VDISCARD] = _POSIX_VDISABLE;
#endif
#endif
    if (tcsetattr(STDIN_FILENO, TCSANOW, &t) != 0) return 0;
    setvbuf(stdin, NULL, _IONBF, 0);
    setvbuf(stdout, g_outbuf, _IOFBF, sizeof(g_outbuf));
    g_raw = 1;
    {
        struct sigaction sa;
        memset(&sa, 0, sizeof(sa));
        sa.sa_handler = cctext_on_winch;
        sigemptyset(&sa.sa_mask);
        sigaction(SIGWINCH, &sa, NULL);
    }
    fputs("\x1b[?1049h\x1b[?25l\x1b[?7l\x1b[?1000h\x1b[?1002h\x1b[?1006h", stdout);
    atexit(cctext_restore);
    return 1;
}

static void cctext_winsize(int *rows, int *cols) {
    struct winsize w;
    *rows = 24;
    *cols = 80;
    if (ioctl(STDOUT_FILENO, TIOCGWINSZ, &w) == 0 && w.ws_row && w.ws_col) {
        *rows = w.ws_row;
        *cols = w.ws_col;
    }
}

static double cctext_measure(void *ctx, char[:] bytes, RtxStyle style, RtxSectionKind sec) {
    (void)ctx;
    (void)style;
    (void)sec;
    return (double)bytes.len;
}

static double cctext_lh(void *ctx, RtxStyle style, RtxSectionKind sec) {
    (void)ctx;
    (void)style;
    (void)sec;
    return 1.0;
}

static const char *cctext_hl_ansi(RtxHlKind hl) {
    switch (hl) {
        case RTX_HL_KEYWORD: return "\x1b[36m";
        case RTX_HL_STRING:  return "\x1b[32m";
        case RTX_HL_COMMENT: return "\x1b[90m";
        case RTX_HL_NUMBER:  return "\x1b[33m";
        default:             return "\x1b[0m";
    }
}

/* Next byte if already in the stdio buffer or the kernel; does not block.
 * select() on the fd is wrong after getchar() — the rest of ESC[<mouse
 * is often already in the FILE buffer, so select times out and we treat
 * a mouse CSI as typed text. */
static int cctext_pending(void) {
    int flags = fcntl(STDIN_FILENO, F_GETFL, 0);
    int c;
    if (flags < 0) return -1;
    if (fcntl(STDIN_FILENO, F_SETFL, flags | O_NONBLOCK) < 0) return -1;
    c = fgetc(stdin);
    fcntl(STDIN_FILENO, F_SETFL, flags);
    if (c == EOF) {
        clearerr(stdin);
        return -1;
    }
    return c;
}

static int cctext_parse_mouse(void) {
    int btn = 0, col = 0, row = 0, *slot = &btn;
    int d;
    int press = 0;
    while ((d = getchar()) != EOF) {
        if (d >= '0' && d <= '9') {
            *slot = (*slot * 10) + (d - '0');
        } else if (d == ';') {
            if (slot == &btn) slot = &col;
            else slot = &row;
        } else if (d == 'M' || d == 'm') {
            press = (d == 'M');
            break;
        } else {
            break;
        }
    }
    g_mouse_col = col;
    g_mouse_row = row;
    g_mouse_press = press;
    g_shift = (btn & 4) ? 1 : 0;
    g_alt = (btn & 8) ? 1 : 0;
    {
        int code = btn & ~(4 | 8 | 16);
        if (code == 64) return KEY_WHEEL_UP;
        if (code == 65) return KEY_WHEEL_DOWN;
        if (code == 32 || code == 0) {
            if (!press) {
                g_mouse_drag = 0;
                g_drag_edge = 0;
                return KEY_NONE;
            }
            g_mouse_drag = 1;
            return (code == 32) ? KEY_MOUSE_DRAG : KEY_MOUSE;
        }
    }
    return KEY_NONE;
}

/* xterm mods: 1 + shift(1) + alt(2) + ctrl(4) + meta/cmd(8). */
static int cctext_with_mods(int key, int mods) {
    int bits = mods > 0 ? mods - 1 : 0;
    if (bits & 1) g_shift = 1;
    if (bits & 2) g_alt = 1;
    if ((bits & 4) || (bits & 8)) {
        if (key == KEY_LEFT) return KEY_HOME;
        if (key == KEY_RIGHT) return KEY_END;
    }
    return key;
}

static int cctext_csi_letter(int d, int n, int mods) {
    if (d == 'A') return cctext_with_mods(KEY_UP, mods);
    if (d == 'B') return cctext_with_mods(KEY_DOWN, mods);
    if (d == 'C') return cctext_with_mods(KEY_RIGHT, mods);
    if (d == 'D') return cctext_with_mods(KEY_LEFT, mods);
    if (d == 'H') return cctext_with_mods(KEY_HOME, mods);
    if (d == 'F') return cctext_with_mods(KEY_END, mods);
    if (d == '~') {
        if (n == 3) return KEY_DELETE;
        if (n == 1 || n == 7) return cctext_with_mods(KEY_HOME, mods);
        if (n == 4 || n == 8) return cctext_with_mods(KEY_END, mods);
    }
    return KEY_NONE;
}

static int cctext_parse_csi(int first) {
    int b = first;
    if (b < 0) b = getchar();
    if (b == '<') return cctext_parse_mouse();
    if (b == 'A' || b == 'B' || b == 'C' || b == 'D' || b == 'H' || b == 'F') {
        return cctext_csi_letter(b, 0, 0);
    }
    if (b >= '0' && b <= '9') {
        int n = b - '0';
        int d;
        int mods = 0;
        int saw_mod = 0;
        while ((d = getchar()) != EOF) {
            if (d >= '0' && d <= '9') {
                if (saw_mod) mods = mods * 10 + (d - '0');
                else n = n * 10 + (d - '0');
            } else if (d == ';') {
                saw_mod = 1;
            } else {
                return cctext_csi_letter(d, n, mods);
            }
        }
    }
    return KEY_NONE;
}

static int cctext_read(int *ch_out) {
    int c;
    if (g_winch) return KEY_NONE;
    /* Terminals clamp the pointer to row 1..rows. While a drag sits on
     * the first or last text row, poll so we keep scrolling without a wiggle. */
    if (g_mouse_drag && g_drag_edge) {
        fd_set rfds;
        struct timeval tv;
        int n;
        FD_ZERO(&rfds);
        FD_SET(STDIN_FILENO, &rfds);
        tv.tv_sec = 0;
        tv.tv_usec = 32000;
        n = select(STDIN_FILENO + 1, &rfds, NULL, NULL, &tv);
        if (n == 0) return KEY_MOUSE_DRAG;
        if (n < 0) return KEY_NONE;
    } else {
        /* Wake on SIGWINCH. Do not select if stdio already holds a CSI byte. */
        int peek = cctext_pending();
        if (peek >= 0) {
            ungetc(peek, stdin);
        } else {
            fd_set rfds;
            int n;
            FD_ZERO(&rfds);
            FD_SET(STDIN_FILENO, &rfds);
            n = select(STDIN_FILENO + 1, &rfds, NULL, NULL, NULL);
            if (n < 0) return (errno == EINTR) ? KEY_NONE : KEY_QUIT;
            if (n == 0) return KEY_NONE;
        }
    }
    if (g_winch) return KEY_NONE;
    c = getchar();
    g_shift = 0;
    g_alt = 0;
    if (c == EOF) return KEY_QUIT;
    if (c == 17) return KEY_QUIT;
    if (c == 19) return KEY_SAVE;
    if (c == 26) return KEY_UNDO;
    if (c == 25) return KEY_REDO;
    if (c == 24) return KEY_CUT;
    if (c == 3) return KEY_COPY;
    if (c == 22) return KEY_PASTE;
    if (c == 23) return KEY_OTHER_PANE;
    if (c == 14) return KEY_NEXT_BUF;
    if (c == 28) return KEY_SPLIT;
    if (c == 7) return KEY_JUMP;
    if (c == 6) return KEY_FIND;
    if (c == 1) return KEY_SEL_ALL;
    if (c == 12) return KEY_VIEW;
    if (c == 127 || c == 8) return KEY_BACKSPACE;
    if (c == '\r' || c == '\n') return KEY_ENTER;
    if (c == 0x1b) {
        int a = cctext_pending();
        if (a < 0) return KEY_HELP;
        if (a == 0x1b) {
            ungetc(a, stdin);
            return KEY_HELP;
        }
        if (a == 'O') {
            int b = getchar();
            if (b == 'A') return KEY_UP;
            if (b == 'B') return KEY_DOWN;
            if (b == 'C') return KEY_RIGHT;
            if (b == 'D') return KEY_LEFT;
            if (b == 'H') return KEY_HOME;
            if (b == 'F') return KEY_END;
            return KEY_NONE;
        }
        if (a == '[') return cctext_parse_csi(-1);
        return cctext_cmd_letter(a);
    }
    /* Leftover SGR mouse after a botched ESC: `[<32;71;32M` or `<32;…M`. */
    if (c == '[') {
        int n = cctext_pending();
        if (n == '<') return cctext_parse_mouse();
        if (n >= 0) ungetc(n, stdin);
    }
    if (c == '<') {
        int n = cctext_pending();
        if (n >= '0' && n <= '9') {
            ungetc(n, stdin);
            return cctext_parse_mouse();
        }
        if (n >= 0) ungetc(n, stdin);
    }
    if (c >= 32 && c < 127) {
        *ch_out = c;
        return KEY_CHAR;
    }
    return KEY_NONE;
}

static void !>(CCError) cctext_after_edit(RtxBuf *b, RtxMeasure *m, double width, int vis) {
    b->clear_pref();
    if (!rtx_layout_is_hex(&b->layout)) {
        b->layout.view_after_edit(&b->doc, m, width) !>(e) { return cc_err(e); };
        b->layout_width = width;
    }
    return b->ensure_view(m, width, vis);
}

static void cctext_ensure_caret(RtxBuf *b, int vis) {
    b->reveal(vis);
}

static int cctext_pane_cols(RtxWs *w, int cols, int pane) {
    if (w->npanes < 2) return cols;
    if (pane == 0) return cols / 2 - 1;
    return cols - (cols / 2) - 1;
}

static int cctext_pane_at_col(RtxWs *w, int cols, int col) {
    if (w->npanes < 2) return 0;
    return col > cols / 2 ? 1 : 0;
}

static int cctext_text_cols(RtxBuf *b, int pcols, int vis) {
    int g = rtx_gutter_cols_buf(b, vis);
    if (pcols <= g + 4) return pcols;
    return pcols - g;
}

static void cctext_style(RtxStyle st, int sel, int here) {
    fputs(cctext_hl_ansi(st.hl), stdout);
    if (st.bold) fputs("\x1b[1m", stdout);
    if (sel) fputs("\x1b[44m", stdout);
    if (here) fputs("\x1b[7m", stdout);
}

static void cctext_eol(int pad_to) {
    if (pad_to > 0) {
        int i;
        for (i = 0; i < pad_to; i++) fputc(' ', stdout);
    } else {
        fputs("\x1b[K", stdout);
    }
}

/* Hex pane: offset | 16 hex bytes | ASCII (geometry in core/hex). */
static size_t cctext_hex_hit_byte(RtxBuf *b, int vis, int row, int col) {
    if (!b || row < 0 || row >= vis) return b ? b->doc.caret : 0;
    return rtx_hex_hit_col(b->top_byte, b->len(), row, col);
}

static void cctext_draw_hex_pane(RtxBuf *b, int focused, int vis, int pcols, int col0,
                                 int pad_rest) {
    size_t r;
    size_t n = b->len();
    int has = b->doc.has_sel();
    static const char *hexd = "0123456789ABCDEF";
    b->top_byte = rtx_hex_align(b->top_byte);
    for (r = 0; r < (size_t)vis; r++) {
        size_t off = rtx_hex_row_off(b->top_byte, r);
        unsigned char buf[RTX_HEX_COLS];
        size_t take = (size_t)RTX_HEX_COLS;
        size_t got = 0;
        size_t k;
        int used = 0;
        fprintf(stdout, "\x1b[%zu;%dH", r + 1, col0);
        if (off >= n && !(n == 0 && r == 0)) {
            fputs("\x1b[90m~\x1b[0m", stdout);
            used = 1;
            cctext_eol(pad_rest ? pcols - used : 0);
            continue;
        }
        if (take > n - off) take = n - off;
        if (take) {
            @errhandler(CCError e) {
                (void)e;
                got = 0;
            }
            got = b->read_at(off, (char *)buf, take) !>;
        }
        fprintf(stdout, "\x1b[34m%0*zX \x1b[0m", RTX_HEX_OFF_W - 1, off);
        used = RTX_HEX_OFF_W;
        for (k = 0; k < (size_t)RTX_HEX_COLS; k++) {
            size_t at = off + k;
            int sel = has && at < n && b->doc.sel_covers(at);
            int here = focused && b->doc.caret == at;
            if (k < got) {
                if (sel || here) fputs(here ? "\x1b[7m" : "\x1b[44m", stdout);
                fputc(hexd[(buf[k] >> 4) & 0xF], stdout);
                fputc(hexd[buf[k] & 0xF], stdout);
                if (sel || here) fputs("\x1b[0m", stdout);
            } else {
                fputs("  ", stdout);
            }
            fputc(k + 1 == (size_t)RTX_HEX_COLS ? ' ' : ' ', stdout);
            used += 3;
        }
        {
            int g;
            for (g = 0; g < RTX_HEX_GAP; g++) fputc(' ', stdout);
            used += RTX_HEX_GAP;
        }
        for (k = 0; k < (size_t)RTX_HEX_COLS; k++) {
            size_t at = off + k;
            int sel = has && at < n && b->doc.sel_covers(at);
            int here = focused && b->doc.caret == at;
            char ch = (k < got) ? rtx_hex_ascii(buf[k]) : ' ';
            if (sel || here) fputs(here ? "\x1b[7m" : "\x1b[44m", stdout);
            fputc(ch, stdout);
            if (sel || here) fputs("\x1b[0m", stdout);
            used++;
        }
        if (focused && b->doc.caret == off + got && got < (size_t)RTX_HEX_COLS) {
            /* caret past last byte on short final row — already drawn on hex gap */
        }
        cctext_eol(pad_rest ? pcols - used : 0);
    }
}

static void cctext_draw_pane(RtxBuf *b, int focused, int vis, int pcols, int col0,
                             int pad_rest) {
    size_t r;
    int has = b->doc.has_sel();
    int g = rtx_gutter_cols_buf(b, vis);
    int tcols = cctext_text_cols(b, pcols, vis);
    if (rtx_layout_is_hex(&b->layout)) {
        cctext_draw_hex_pane(b, focused, vis, pcols, col0, pad_rest);
        return;
    }
    for (r = 0; r < (size_t)vis; r++) {
        size_t idx = r + b->top_wrap;
        int used = 0;
        fprintf(stdout, "\x1b[%zu;%dH", r + 1, col0);
        if (idx >= b->layout.len) {
            fputs("\x1b[90m", stdout);
            {
                int i;
                for (i = 0; i < g - 1; i++) fputc(' ', stdout);
            }
            fputs("~\x1b[0m", stdout);
            used = g;
            cctext_eol(pad_rest ? pcols - used : 0);
            continue;
        }
        {
            RtxVisRow *row = &b->layout.rows[idx];
            size_t k;
            size_t col = 0;
            size_t line = row->line;
            int show_ln = (idx == 0 || b->layout.rows[idx - 1].line != line);
            int caret_end = focused && (b->doc.caret == row->byte_start + row->byte_len);
            int last_sel = -1, last_here = -1, last_hl = -1, last_bold = -1;
            cc_arena_stack(scratch, RTX_FRAME_SCRATCH);
            if (show_ln) fprintf(stdout, "\x1b[90m%*zu \x1b[0m", g - 1, line + 1);
            else {
                int i;
                fputs("\x1b[90m", stdout);
                for (i = 0; i < g - 1; i++) fputc(' ', stdout);
                fputs(" \x1b[0m", stdout);
            }
            char[:] bytes = b->scratch_span(&scratch, row->byte_start, row->byte_len) !>(e) {
                snprintf(g_status, sizeof(g_status), "span failed");
                return;
            };
            for (k = 0; k < bytes.len && col < (size_t)tcols; k++) {
                size_t off = row->byte_start + k;
                RtxStyle st = b->doc.style_at(off);
                int here = focused && (b->doc.caret == off);
                int sel = has && b->doc.sel_covers(off);
                if ((int)st.hl != last_hl || (int)st.bold != last_bold ||
                    sel != last_sel || here != last_here) {
                    fputs("\x1b[0m", stdout);
                    cctext_style(st, sel, here);
                    last_hl = (int)st.hl;
                    last_bold = (int)st.bold;
                    last_sel = sel;
                    last_here = here;
                }
                fputc(bytes.ptr[k], stdout);
                col++;
            }
            if (caret_end && col < (size_t)tcols) {
                fputs("\x1b[0m\x1b[7m \x1b[0m", stdout);
                col++;
            } else {
                fputs("\x1b[0m", stdout);
            }
            used = g + (int)col;
            cctext_eol(pad_rest ? pcols - used : 0);
        }
    }
}

static void cctext_draw_help(int rows, int cols) {
    int i;
    int n = 0;
    int box_w = 44;
    int box_h;
    int r0, c0;
    while (rtx_help_lines[n]) n++;
    box_h = n + 4;
    if (box_w > cols - 2) box_w = cols - 2;
    if (box_h > rows - 2) box_h = rows - 2;
    r0 = (rows - box_h) / 2;
    if (r0 < 1) r0 = 1;
    c0 = (cols - box_w) / 2;
    if (c0 < 1) c0 = 1;
    for (i = 0; i < box_h; i++) {
        int k;
        fprintf(stdout, "\x1b[%d;%dH\x1b[44;37m", r0 + i, c0);
        if (i == 0) fprintf(stdout, " key bindings%*s", box_w - 13, "");
        else if (i == box_h - 1) {
            for (k = 0; k < box_w; k++) fputc(' ', stdout);
        } else if (i - 2 >= 0 && i - 2 < n && i < box_h - 1) {
            fprintf(stdout, " %-*.*s", box_w - 2, box_w - 2, rtx_help_lines[i - 2]);
        } else {
            for (k = 0; k < box_w; k++) fputc(' ', stdout);
        }
        fputs("\x1b[0m", stdout);
    }
}

static void cctext_draw_find(RtxDoc *d, RtxUi *ui, int rows, int cols, int find_h) {
    int r0 = rows - find_h;
    int vis_hits = find_h > 1 ? find_h - 1 : 0;
    int i;
    char head[256];
    size_t ctxn = (size_t)(cols > 16 ? cols - 10 : 8);
    if (r0 < 1) r0 = 1;
    rtx_ui_find_scroll(ui, d, (size_t)vis_hits);
    rtx_ui_find_header(ui, d, head, sizeof(head));
    fprintf(stdout, "\x1b[%d;1H\x1b[44;37m %s\x1b[0m\x1b[K", r0, head);
    for (i = 0; i < vis_hits; i++) {
        size_t hit = ui->find_top + (size_t)i;
        int row = r0 + 1 + i;
        int cur = d && hit == d->find.cur;
        fprintf(stdout, "\x1b[%d;1H%s", row, cur ? "\x1b[7m" : "\x1b[0m");
        if (!d || hit >= d->find.len) {
            fputs("\x1b[K\x1b[0m", stdout);
            continue;
        }
        {
            char ctx[256];
            size_t line1 = 0;
            int ok = 1;
            rtx_ui_find_row_text(d, hit, ctxn, ctx, sizeof(ctx), &line1) !>(e) {
                ok = 0;
            };
            if (ok) fprintf(stdout, " %5zu  %s\x1b[K\x1b[0m", line1, ctx);
            else fprintf(stdout, "  %zu\x1b[K\x1b[0m", hit + 1);
        }
    }
}

static void cctext_draw(RtxWs *w, RtxUi *ui, int rows, int cols) {
    int find_h = rtx_ui_find_rows(ui, rows);
    int vis = rows - 1 - find_h;
    int p;
    RtxBuf *act = w->active();
    if (vis < 1) vis = 1;
    /* Synchronized update: do not ED (erase display) — that is the flicker. */
    fputs("\x1b[?2026h", stdout);
    for (p = 0; p < w->npanes; p++) {
        int bi = w->pane[p];
        RtxBuf *b = &w->bufs[bi];
        int pcols = cctext_pane_cols(w, cols, p);
        int col0 = (p == 0) ? 1 : (cols / 2 + 2);
        int pad_left = (w->npanes == 2 && p == 0);
        cctext_draw_pane(b, p == w->focus, vis, pcols, col0, pad_left);
        if (w->npanes == 2 && p == 0) {
            size_t r;
            for (r = 0; r < (size_t)vis; r++) {
                fprintf(stdout, "\x1b[%zu;%dH\x1b[90m│\x1b[0m", r + 1, cols / 2 + 1);
            }
        }
    }
    if (ui && ui->find && act && find_h > 0) {
        cctext_draw_find(&act->doc, ui, rows, cols, find_h);
    }
    if (ui && ui->help) cctext_draw_help(rows, cols);
    {
        const char *path = (act && act->doc.path.ptr) ? act->doc.path.ptr : "(untitled)";
        const char *star = (act && act->doc.dirty()) ? "*" : " ";
        if (ui && ui->ask_quit) {
            fprintf(stdout,
                    "\x1b[%d;1H\x1b[41;97m unsaved  s save  q don't save  Esc cancel  %s\x1b[0m\x1b[K",
                    rows, g_status);
        } else if (ui && ui->jump) {
            fprintf(stdout, "\x1b[%d;1H\x1b[7m jump line or N%%: %s_\x1b[0m\x1b[K",
                    rows, ui->jump_buf);
        } else if (ui && ui->find) {
            fprintf(stdout,
                    "\x1b[%d;1H\x1b[7m find  up/down hits  Esc close  %s\x1b[0m\x1b[K",
                    rows, g_status);
        } else {
            if (act && rtx_layout_is_hex(&act->layout)) {
                fprintf(stdout,
                        "\x1b[%d;1H\x1b[7m%s%s  @%zX  hex  Esc help  g jump  %s\x1b[0m\x1b[K",
                        rows, star, path, act->doc.caret, g_status);
            } else {
                {
                    char pos[32];
                    rtx_status_line_pos(act ? &act->doc : NULL, pos, sizeof(pos));
                    fprintf(stdout,
                            "\x1b[%d;1H\x1b[7m%s%s  %s  Esc help  g jump  f find  %s\x1b[0m\x1b[K",
                            rows, star, path, pos, g_status);
                }
            }
        }
    }
    fputs("\x1b[?2026l", stdout);
    fflush(stdout);
}

static void cctext_hit(RtxWs *w, RtxMeasure *m, int cols, int vis, int drag) {
    int pane = cctext_pane_at_col(w, cols, g_mouse_col);
    int pcols = cctext_pane_cols(w, cols, pane);
    int col0 = (pane == 0) ? 1 : (cols / 2 + 2);
    RtxBuf *b;
    double x, y;
    w->focus = pane;
    b = w->active();
    if (!b) return;
    {
        double tw = (double)cctext_text_cols(b, pcols, vis);
        /* SGR never reports a row above the window; row 1 is "above". */
        if (drag && g_mouse_row <= 1) {
            b->scroll_vis(m, tw, -1) !>(e) {
                snprintf(g_status, sizeof(g_status), "hit failed");
                return;
            };
            b->ensure_view(m, tw, vis) !>(e) {
                snprintf(g_status, sizeof(g_status), "hit failed");
                return;
            };
            g_mouse_row = 1;
        } else if (drag && g_mouse_row >= vis) {
            b->scroll_vis(m, tw, 1) !>(e) {
                snprintf(g_status, sizeof(g_status), "hit failed");
                return;
            };
            b->ensure_view(m, tw, vis) !>(e) {
                snprintf(g_status, sizeof(g_status), "hit failed");
                return;
            };
            g_mouse_row = vis;
        } else if (g_mouse_row < 1 || g_mouse_row > vis) {
            return;
        }
        g_drag_edge = drag && (g_mouse_row <= 1 || g_mouse_row >= vis);
    }
    if (rtx_layout_is_hex(&b->layout)) {
        int col = g_mouse_col - col0;
        int row = g_mouse_row - 1;
        size_t at;
        if (col < 0) col = 0;
        at = cctext_hex_hit_byte(b, vis, row, col);
        b->doc.caret = at;
        if (!drag && !g_shift) b->doc.sel_anchor = b->doc.caret;
        b->doc.sel_box = 0;
        b->clear_pref();
        b->doc.break_coalesce();
        return;
    }
    x = (double)(g_mouse_col - col0);
    x -= (double)rtx_gutter_cols_buf(b, vis);
    if (x < 0) x = 0;
    if (x > (double)pcols) x = (double)pcols;
    y = (double)(g_mouse_row - 1);
    {
        size_t s;
        for (s = 0; s < b->top_wrap && s < b->layout.len; s++) {
            y += b->layout.rows[s].height;
        }
    }
    {
        size_t at = b->layout.hit(&b->doc, m, x, y) !>(e) {
            snprintf(g_status, sizeof(g_status), "hit failed");
            return;
        };
        b->doc.caret = at;
    }
    if (g_alt) {
        size_t line = b->doc.line_of(b->doc.caret);
        if (!drag) {
            b->doc.sel_anchor = b->doc.caret;
            b->doc.sel_box = 1;
            b->pref.col = b->doc.caret - b->doc.line_start(line);
            b->pref.ok = 1;
            b->pref.eol = 0;
            b->doc.box_acol = b->pref.col;
            b->doc.box_ccol = b->pref.col;
        } else {
            b->pref.col = b->doc.caret - b->doc.line_start(line);
            b->pref.ok = 1;
            b->pref.eol = 0;
            b->box_sync();
        }
    } else {
        if (!drag && !g_shift) b->doc.sel_anchor = b->doc.caret;
        b->doc.sel_box = 0;
        b->clear_pref();
    }
    b->doc.break_coalesce();
}

int main(int argc, char **argv) {
    @errhandler(CCError e) {
            snprintf(g_status, sizeof(g_status), "%s",
                     e.message ? e.message : "error");
        cc_error_log(e);
        if (!g_raw) return 1;
    }
    RtxWs w = {0} @destroy;
    RtxMeasure m;
    char *def[1];
    int nfiles;
    char **files;
    int rows = 24, cols = 80;
    int last_rows = 0, last_cols = 0;
    int kind;
    int ch = 0;
    int skip_reveal = 0;
    RtxUi ui;

    def[0] = (char *)"testdata/mixed.txt";
    nfiles = argc > 1 ? argc - 1 : 1;
    files = argc > 1 ? argv + 1 : def;
    w.open_files(nfiles, files) !>;
    m.measure = cctext_measure;
    m.line_height = cctext_lh;
    m.ctx = NULL;
    g_status[0] = 0;
    memset(&ui, 0, sizeof(ui));

    if (!isatty(STDIN_FILENO) || !cctext_raw()) {
        /* Batch/pipe: stream bytes. Do not walk soft line_count (that can
         * be a million provisional lines on a giant unindexed file). */
        RtxBuf *b = w.active();
        char buf[64 * 1024];
        size_t off = 0;
        size_t n = b ? b->len() : 0;
        while (off < n) {
            size_t take = sizeof(buf);
            size_t got;
            if (take > n - off) take = n - off;
            got = b->read_at(off, buf, take) !>;
            if (!got) break;
            fwrite(buf, 1, got, stdout);
            off += got;
        }
        return 0;
    }

    w.busy_bind(cctext_busy, NULL);

    for (;;) {
        int vis;
        int find_h;
        int p;
        RtxBuf *act;
        cctext_winsize(&rows, &cols);
        if (g_winch || rows != last_rows || cols != last_cols) {
            int rp;
            g_winch = 0;
            last_rows = rows;
            last_cols = cols;
            fputs("\x1b[H\x1b[J", stdout);
            for (rp = 0; rp < w.npanes; rp++) {
                w.bufs[w.pane[rp]].layout.len = 0;
            }
        }
        find_h = rtx_ui_find_rows(&ui, rows);
        vis = rows - 1 - find_h;
        if (vis < 1) vis = 1;
        act = w.active();
        if (act && ui.find) {
            rtx_ui_find_pump(&ui, &act->doc) !>;
        }
        for (p = 0; p < w.npanes; p++) {
            RtxBuf *b = &w.bufs[w.pane[p]];
            double pw = (double)cctext_pane_cols(&w, cols, p);
            /* Reveal before fill: jump/find move the caret, then we need
             * layout for the new top — console only redraws once per key. */
            if (p == w.focus && !skip_reveal) cctext_ensure_caret(b, vis);
            b->ensure_view(&m, (double)cctext_text_cols(b, (int)pw, vis), vis) !>;
        }
        skip_reveal = 0;
        cctext_draw(&w, &ui, rows, cols);
        kind = cctext_read(&ch);
        act = w.active();
        if (!act) break;
        if (ui.ask_quit) {
            if (kind == KEY_HELP ||
                (kind == KEY_CHAR && (ch == 'c' || ch == 'C'))) {
                ui.ask_quit = 0;
            } else if (kind == KEY_SAVE ||
                       (kind == KEY_CHAR && (ch == 's' || ch == 'S'))) {
                size_t si;
                int ok = 1;
                for (si = 0; si < w.len; si++) {
                    RtxDoc *sd = &w.bufs[si].doc;
                    if (!sd->dirty()) continue;
                    if (!sd->path.ptr || sd->path.len == 0) {
                        snprintf(g_status, sizeof(g_status),
                                 "untitled — save as a path first");
                        ok = 0;
                        break;
                    }
                    sd->save() !>(e) {
                        snprintf(g_status, sizeof(g_status), "%s",
                                 e.message ? e.message : "save failed");
                        ok = 0;
                    };
                    if (!ok) break;
                    sd->break_coalesce();
                }
                if (ok) break;
            } else if (kind == KEY_QUIT ||
                       (kind == KEY_CHAR &&
                        (ch == 'q' || ch == 'Q' || ch == 'n' || ch == 'N' ||
                         ch == 'd' || ch == 'D'))) {
                break;
            }
            continue;
        }
        if (ui.jump) {
            if (kind == KEY_HELP || kind == KEY_QUIT) {
                rtx_ui_clear_jump(&ui);
            } else if (kind == KEY_ENTER) {
                rtx_ui_apply_jump(&ui, &act->doc);
                if (rtx_layout_is_hex(&act->layout)) {
                    act->top_byte = rtx_hex_align(act->doc.caret);
                }
            } else if (kind == KEY_BACKSPACE && ui.jump_len > 0) {
                ui.jump_buf[--ui.jump_len] = 0;
            } else if (kind == KEY_CHAR) {
                rtx_ui_jump_char(&ui, ch);
            }
            continue;
        }
        if (ui.find) {
            if (kind == KEY_HELP || kind == KEY_QUIT) {
                rtx_ui_clear_find(&ui);
            } else if (kind == KEY_UP) {
                act->doc.find_prev();
            } else if (kind == KEY_DOWN) {
                act->doc.find_next();
            } else if (kind == KEY_BACKSPACE && ui.find_len > 0) {
                ui.find_buf[--ui.find_len] = 0;
                rtx_ui_find_apply(&ui, &act->doc) !>;
            } else if (kind == KEY_CHAR) {
                if (rtx_ui_find_char(&ui, ch)) {
                    rtx_ui_find_apply(&ui, &act->doc) !>;
                }
            } else if (kind == KEY_JUMP) {
                rtx_ui_start_jump(&ui);
            } else if (kind == KEY_MOUSE || kind == KEY_MOUSE_DRAG) {
                int idx = g_mouse_row - vis - 2;
                if (idx >= 0) {
                    size_t hit = ui.find_top + (size_t)idx;
                    if (hit < act->doc.find.len) act->doc.find_goto(hit);
                }
            }
            continue;
        }
        if (kind == KEY_HELP) {
            ui.help = !ui.help;
            continue;
        }
        if (ui.help) {
            if (kind == KEY_CHAR) kind = cctext_cmd_letter(ch);
            if (kind == KEY_MOUSE || kind == KEY_MOUSE_DRAG ||
                kind == KEY_WHEEL_UP || kind == KEY_WHEEL_DOWN ||
                kind == KEY_NONE) {
                continue;
            }
            if (kind == KEY_CHAR) continue;
            ui.help = 0;
        }
        if (kind == KEY_JUMP) {
            rtx_ui_start_jump(&ui);
            continue;
        }
        if (kind == KEY_FIND) {
            rtx_ui_start_find(&ui);
            rtx_ui_find_apply(&ui, &act->doc) !>;
            continue;
        }
        if (kind == KEY_VIEW) {
            rtx_layout_cycle_view(&act->layout);
            act->top_wrap = 0;
            act->layout.len = 0;
            act->clear_pref();
            if (rtx_layout_is_hex(&act->layout)) {
                act->top_byte = rtx_hex_align(act->doc.caret);
            }
            snprintf(g_status, sizeof(g_status), "view %s",
                     rtx_layout_view_name(&act->layout));
            continue;
        }
        if (kind == KEY_QUIT) {
            if (rtx_ui_offer_quit(&w, &ui)) break;
            g_status[0] = 0;
            continue;
        }
        if (kind == KEY_SAVE) {
            act->doc.save() !>(e) {
                snprintf(g_status, sizeof(g_status), "save failed");
            };
            if (!act->doc.dirty()) snprintf(g_status, sizeof(g_status), "saved");
            act->doc.break_coalesce();
        } else if (kind == KEY_UNDO) {
            act->doc.undo() !>;
            cctext_after_edit(act, &m, (double)cctext_text_cols(act, cctext_pane_cols(&w, cols, w.focus), vis), vis) !>;
        } else if (kind == KEY_REDO) {
            act->doc.redo() !>;
            cctext_after_edit(act, &m, (double)cctext_text_cols(act, cctext_pane_cols(&w, cols, w.focus), vis), vis) !>;
        } else if (kind == KEY_COPY) {
            w.copy() !>;
        } else if (kind == KEY_CUT) {
            w.cut() !>;
            cctext_after_edit(act, &m, (double)cctext_text_cols(act, cctext_pane_cols(&w, cols, w.focus), vis), vis) !>;
        } else if (kind == KEY_PASTE) {
            w.paste() !>;
            cctext_after_edit(act, &m, (double)cctext_text_cols(act, cctext_pane_cols(&w, cols, w.focus), vis), vis) !>;
        } else if (kind == KEY_SPLIT) {
            w.toggle_split();
        } else if (kind == KEY_OTHER_PANE) {
            w.focus_other();
        } else if (kind == KEY_NEXT_BUF) {
            w.next_buf();
        } else if (kind == KEY_WHEEL_UP) {
            act->scroll_vis(&m, (double)cctext_text_cols(act, cctext_pane_cols(&w, cols, w.focus), vis), -1) !>;
            skip_reveal = 1;
            continue;
        } else if (kind == KEY_WHEEL_DOWN) {
            act->scroll_vis(&m, (double)cctext_text_cols(act, cctext_pane_cols(&w, cols, w.focus), vis), 1) !>;
            skip_reveal = 1;
            continue;
        } else if (kind == KEY_MOUSE || kind == KEY_MOUSE_DRAG) {
            cctext_hit(&w, &m, cols, vis, kind == KEY_MOUSE_DRAG);
        } else if (kind == KEY_SEL_ALL) {
            act->doc.select_all();
        } else if (kind == KEY_HOME) {
            if (rtx_layout_is_hex(&act->layout)) {
                size_t row = act->doc.caret / (size_t)RTX_HEX_COLS;
                size_t at = row * (size_t)RTX_HEX_COLS;
                if (!g_shift) act->doc.sel_anchor = at;
                act->doc.caret = at;
                act->doc.sel_box = 0;
                act->doc.break_coalesce();
            } else if (act->layout.wrap && act->layout.len) {
                act->layout.move_row_edge(&act->doc, 0, g_shift);
            } else {
                act->doc.move_line_edge(0, g_shift);
            }
            act->clear_pref();
        } else if (kind == KEY_END) {
            if (rtx_layout_is_hex(&act->layout)) {
                size_t n = act->len();
                size_t row = n ? act->doc.caret / (size_t)RTX_HEX_COLS : 0;
                size_t at = row * (size_t)RTX_HEX_COLS + (size_t)RTX_HEX_COLS - 1;
                if (n == 0) at = 0;
                else if (at >= n) at = n - 1;
                if (!g_shift) act->doc.sel_anchor = at;
                act->doc.caret = at;
                act->doc.sel_box = 0;
                act->doc.break_coalesce();
                act->clear_pref();
            } else if (act->layout.wrap && act->layout.len) {
                act->layout.move_row_edge(&act->doc, 1, g_shift);
                act->stick_eol();
            } else {
                act->doc.move_line_edge(1, g_shift);
                act->stick_eol();
            }
        } else if (kind == KEY_LEFT) {
            if (g_alt) {
                act->box_move_col(-1);
            } else if (!g_shift && act->doc.has_sel()) {
                act->doc.caret = act->doc.sel_lo();
                act->doc.clear_sel();
            } else if (act->doc.caret > 0) {
                if (!g_shift) act->doc.sel_anchor = act->doc.caret;
                act->doc.caret--;
                if (!g_shift) act->doc.sel_anchor = act->doc.caret;
                act->doc.sel_box = 0;
            }
            act->doc.break_coalesce();
            if (!g_alt) act->clear_pref();
        } else if (kind == KEY_RIGHT) {
            size_t n = act->len();
            if (g_alt) {
                act->box_move_col(1);
            } else if (!g_shift && act->doc.has_sel()) {
                act->doc.caret = act->doc.sel_hi();
                act->doc.clear_sel();
            } else if (act->doc.caret < n) {
                if (!g_shift) act->doc.sel_anchor = act->doc.caret;
                act->doc.caret++;
                if (!g_shift) act->doc.sel_anchor = act->doc.caret;
                act->doc.sel_box = 0;
            }
            act->doc.break_coalesce();
            if (!g_alt) act->clear_pref();
        } else if (kind == KEY_UP || kind == KEY_DOWN) {
            if (rtx_layout_is_hex(&act->layout)) {
                size_t n = act->len();
                size_t at = act->doc.caret;
                if (kind == KEY_UP) {
                    if (at >= (size_t)RTX_HEX_COLS) at -= (size_t)RTX_HEX_COLS;
                    else at = 0;
                } else if (n) {
                    at += (size_t)RTX_HEX_COLS;
                    if (at >= n) at = n - 1;
                }
                if (!g_shift) act->doc.sel_anchor = at;
                act->doc.caret = at;
                act->doc.sel_box = 0;
                act->doc.break_coalesce();
                act->clear_pref();
            } else {
                if (g_alt) act->box_begin();
                act->layout.move_vert(&act->doc, &m,
                                      (double)cctext_text_cols(act, cctext_pane_cols(&w, cols, w.focus), vis),
                                      kind == KEY_UP ? -1 : 1, g_shift || g_alt,
                                      &act->pref) !>;
                if (g_alt) act->box_sync();
            }
        } else if (kind == KEY_BACKSPACE) {
            act->doc.backspace() !>;
            cctext_after_edit(act, &m, (double)cctext_text_cols(act, cctext_pane_cols(&w, cols, w.focus), vis), vis) !>;
        } else if (kind == KEY_DELETE) {
            act->doc.delete_forward() !>;
            cctext_after_edit(act, &m, (double)cctext_text_cols(act, cctext_pane_cols(&w, cols, w.focus), vis), vis) !>;
        } else if (kind == KEY_ENTER) {
            act->doc.type("\n") !>;
            cctext_after_edit(act, &m, (double)cctext_text_cols(act, cctext_pane_cols(&w, cols, w.focus), vis), vis) !>;
        } else if (kind == KEY_CHAR) {
            char s[2];
            s[0] = (char)ch;
            s[1] = 0;
            act->doc.type(s.to_slice_n(1)) !>;
            cctext_after_edit(act, &m, (double)cctext_text_cols(act, cctext_pane_cols(&w, cols, w.focus), vis), vis) !>;
        }
    }
    w.busy_bind(NULL, NULL);
    cctext_restore();
    return 0;
}
