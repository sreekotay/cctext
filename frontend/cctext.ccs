#!ccc ccs
/*
 * cctext — POSIX console frontend. Same document/layout as cctext-ray.
 *
 *   cctext [--version] [--wrap|--hex|--view=default|wrap|hex] [file ...]
 *
 *   Esc help menu   g / Ctrl-G jump   f / Ctrl-F find   o / Ctrl-O browse
 *   k / Ctrl-K next mark   t / Ctrl-T fold   l / Ctrl-L cycle view
 *   click caret   drag select   shift-arrows   Alt-arrows box   type to insert
 */
#include <ccc/std/prelude.cch>
#include <ccc/script/stdio.cch>
#include <stdio.h>
#include <string.h>
#include <stdlib.h>
#include <unistd.h>
#include <termios.h>
#include <sys/ioctl.h>
#include <sys/select.h>
#include <fcntl.h>
#include <errno.h>
#include <signal.h>
#include <time.h>
#include "../core/document.cch"
#include "../core/layout.cch"
#include "../core/workspace.cch"
#include "../core/find.cch"
#include "../core/ui.cch"
#include "../core/browse.cch"
#include "cctext_draw.cch"

enum {
    KEY_NONE = 0,
    KEY_QUIT,
    KEY_SAVE,
    KEY_UNDO,
    KEY_REDO,
    KEY_CUT,
    KEY_COPY,
    KEY_PASTE,
    KEY_SPLIT,
    KEY_OTHER_PANE,
    KEY_NEXT_BUF,
    KEY_UP,
    KEY_DOWN,
    KEY_LEFT,
    KEY_RIGHT,
    KEY_BACKSPACE,
    KEY_DELETE,
    KEY_ENTER,
    KEY_MOUSE,
    KEY_MOUSE_DRAG,
    KEY_WHEEL_UP,
    KEY_WHEEL_DOWN,
    KEY_HELP,
    KEY_JUMP,
    KEY_FIND,
    KEY_OPEN,
    KEY_SEL_ALL,
    KEY_HOME,
    KEY_END,
    KEY_VIEW,
    KEY_FOLLOW,
    KEY_NAV,
    KEY_STATS,
    KEY_CHAR
};

static struct termios g_old;
static int g_raw = 0;
static int g_mouse_col;
static int g_mouse_row;
static int g_mouse_press;
static int g_mouse_drag;
static int g_drag_edge;
static int g_field_drag; /* 1 find query, 2 browse glob */
static int g_shift;
static int g_alt;
static int g_nav;
static char g_status[160];
static volatile sig_atomic_t g_winch;
static int g_busy_frame;
static long g_isle_paint_at;
/* Status-row spinner while piece-tree scan/save runs (blocking). */
static void cctext_busy(void *ctx, const char *label, int pct) {
    struct winsize ws;
    int cols = 80;
    int rows = 24;
    const char *spin = "|/-\\";
    char msg[48];
    int n;
    (void)ctx;
    if (ioctl(STDOUT_FILENO, TIOCGWINSZ, &ws) == 0) {
        if (ws.ws_col > 0) cols = ws.ws_col;
        if (ws.ws_row > 0) rows = ws.ws_row;
    }
    if (!label) {
        fprintf(stdout, "\x1b[s\x1b[%d;%dH\x1b[K\x1b[u",
                rows, cols > 1 ? cols - 24 : 1);
        fflush(stdout);
        return;
    }
    if (pct >= 0) {
        n = snprintf(msg, sizeof(msg), "%c %s %d%%",
                     spin[g_busy_frame++ & 3], label, pct);
    } else {
        n = snprintf(msg, sizeof(msg), "%c %s", spin[g_busy_frame++ & 3], label);
    }
    if (n < 0) n = 0;
    if (n > 24) n = 24;
    /* Status row, not row 1: the rail lives on the right edge and xenl
     * already eats (1,cols). A corner overlay would hide the thumb at BOF. */
    fprintf(stdout, "\x1b[s\x1b[%d;%dH\x1b[33;1m%.*s\x1b[0m\x1b[u",
            rows, cols > n ? cols - n + 1 : 1, n, msg);
    fflush(stdout);
}

static char g_outbuf[65536];

static void cctext_restore(void) {
    if (g_raw) tcsetattr(STDIN_FILENO, TCSANOW, &g_old);
    fputs("\x1b[?2026l\x1b[?7h\x1b[?1002l\x1b[?1000l\x1b[?1006l"
          "\x1b[0m\x1b[0 q\x1b[?25h\x1b[?1049l", stdout);
    fflush(stdout);
    g_raw = 0;
}

static int cctext_cmd_letter(int c) {
    int nav = rtx_nav_from_letter(c);
    if (nav) {
        g_nav = nav;
        return KEY_NAV;
    }
    if (c >= 'A' && c <= 'Z') c = c - 'A' + 'a';
    switch (c) {
        case 'q': return KEY_QUIT;
        case 's': return KEY_SAVE;
        case 'z': return KEY_UNDO;
        case 'y': return KEY_REDO;
        case 'x': return KEY_CUT;
        case 'c': return KEY_COPY;
        case 'v': return KEY_PASTE;
        case 'w': return KEY_OTHER_PANE;
        case 'n': return KEY_NEXT_BUF;
        case '\\': return KEY_SPLIT;
        case 'g': return KEY_JUMP;
        case 'f': return KEY_FIND;
        case 'o': return KEY_OPEN;
        case 'a': return KEY_SEL_ALL;
        case 'l': return KEY_VIEW;
        case 'u': return KEY_FOLLOW;
        case '=': return KEY_STATS;
        default: return KEY_NONE;
    }
}

static void cctext_on_winch(int sig) {
    (void)sig;
    g_winch = 1;
}

static int cctext_raw(void) {
    struct termios t;
    if (tcgetattr(STDIN_FILENO, &g_old) != 0) return 0;
    t = g_old;
    cfmakeraw(&t);
    t.c_cc[VMIN] = 1;
    t.c_cc[VTIME] = 0;
#ifdef _POSIX_VDISABLE
    t.c_cc[VINTR] = _POSIX_VDISABLE;
    t.c_cc[VQUIT] = _POSIX_VDISABLE;
    t.c_cc[VSUSP] = _POSIX_VDISABLE;
    t.c_cc[VSTART] = _POSIX_VDISABLE;
    t.c_cc[VSTOP] = _POSIX_VDISABLE;
#ifdef VLNEXT
    t.c_cc[VLNEXT] = _POSIX_VDISABLE;
#endif
#ifdef VDISCARD
    t.c_cc[VDISCARD] = _POSIX_VDISABLE;
#endif
#endif
    if (tcsetattr(STDIN_FILENO, TCSANOW, &t) != 0) return 0;
    setvbuf(stdin, NULL, _IONBF, 0);
    setvbuf(stdout, g_outbuf, _IOFBF, sizeof(g_outbuf));
    g_raw = 1;
    {
        struct sigaction sa;
        memset(&sa, 0, sizeof(sa));
        sa.sa_handler = cctext_on_winch;
        sigemptyset(&sa.sa_mask);
        sigaction(SIGWINCH, &sa, NULL);
    }
    fputs("\x1b[?1049h\x1b[?25l\x1b[1 q\x1b[?7l\x1b[?1000h\x1b[?1002h\x1b[?1006h",
          stdout);
    atexit(cctext_restore);
    return 1;
}

static void cctext_winsize(int *rows, int *cols) {
    struct winsize w;
    *rows = 24;
    *cols = 80;
    if (ioctl(STDOUT_FILENO, TIOCGWINSZ, &w) == 0 && w.ws_row && w.ws_col) {
        *rows = w.ws_row;
        *cols = w.ws_col;
    }
}

static double cctext_measure(void *ctx, char[:] bytes, RtxStyle style, RtxSectionKind sec) {
    (void)ctx;
    (void)style;
    (void)sec;
    return (double)rtx_utf8_cols(bytes);
}

static double cctext_lh(void *ctx, RtxStyle style, RtxSectionKind sec) {
    (void)ctx;
    (void)style;
    (void)sec;
    return 1.0;
}

/* Next byte if already in the stdio buffer or the kernel; does not block.
 * select() on the fd is wrong after getchar() — the rest of ESC[<mouse
 * is often already in the FILE buffer, so select times out and we treat
 * a mouse CSI as typed text. */
static int cctext_pending(void) {
    int flags = fcntl(STDIN_FILENO, F_GETFL, 0);
    int c;
    if (flags < 0) return -1;
    if (fcntl(STDIN_FILENO, F_SETFL, flags | O_NONBLOCK) < 0) return -1;
    c = fgetc(stdin);
    fcntl(STDIN_FILENO, F_SETFL, flags);
    if (c == EOF) {
        clearerr(stdin);
        return -1;
    }
    return c;
}

static int cctext_isle_yield(void) {
    int c = cctext_pending();
    if (c < 0) return 0;
    ungetc(c, stdin);
    return 1;
}

static void cctext_draw_isle_status(RtxBuf *act, int rows) {
    char pos[48];
    const char *path = (act && act->doc.path.ptr) ? act->doc.path.ptr : "(untitled)";
    const char *star = (act && act->doc.dirty()) ? "*" : " ";
    @errhandler(RtxIndexErr e) {
        (void)e;
        return;
    }
    rtx_status_line_pos(act, pos, sizeof(pos)) !>;
    fprintf(stdout,
            "\x1b[%d;1H\x1b[7m%s%s  %s%s  Esc help  g jump  f find  %s\x1b[0m\x1b[K",
            rows, star, path, pos,
            (act && act->unlock) ? "  unlock" : "", g_status);
    fflush(stdout);
}

static int cctext_decode_utf8(int lead, uint32_t *cp) {
    char seq[4];
    int need, i, n;
    if (lead < 0x80) {
        if (cp) *cp = (uint32_t)lead;
        return 1;
    }
    need = rtx_utf8_lead_len((unsigned char)lead);
    if (need <= 1) return 0;
    seq[0] = (char)lead;
    for (i = 1; i < need; i++) {
        int b = cctext_pending();
        if (b < 0 || (b & 0xC0) != 0x80) {
            if (b >= 0) ungetc(b, stdin);
            return 0;
        }
        seq[i] = (char)b;
    }
    n = rtx_utf8_decode(seq, (size_t)need, cp);
    return n == need;
}

static void cctext_find_absorb(RtxUi *ui) {
    for (;;) {
        int p = cctext_pending();
        uint32_t cp;
        if (p < 0) return;
        if (p < 32 || p == 127) {
            ungetc(p, stdin);
            return;
        }
        if (p < 0x80) cp = (uint32_t)p;
        else if (!cctext_decode_utf8(p, &cp)) {
            return;
        }
        if (!rtx_ui_find_char(ui, (int)cp)) {
            return;
        }
    }
}

static int cctext_parse_mouse(void) {
    int btn = 0, col = 0, row = 0, *slot = &btn;
    int d;
    int press = 0;
    while ((d = getchar()) != EOF) {
        if (d >= '0' && d <= '9') {
            *slot = (*slot * 10) + (d - '0');
        } else if (d == ';') {
            if (slot == &btn) slot = &col;
            else slot = &row;
        } else if (d == 'M' || d == 'm') {
            press = (d == 'M');
            break;
        } else {
            break;
        }
    }
    g_mouse_col = col;
    g_mouse_row = row;
    g_mouse_press = press;
    g_shift = (btn & 4) ? 1 : 0;
    g_alt = (btn & 8) ? 1 : 0;
    {
        int code = btn & ~(4 | 8 | 16);
        if (code == 64) return KEY_WHEEL_UP;
        if (code == 65) return KEY_WHEEL_DOWN;
        if (code == 32 || code == 0) {
            if (!press) {
                g_mouse_drag = 0;
                g_drag_edge = 0;
                return KEY_NONE;
            }
            g_mouse_drag = 1;
            return (code == 32) ? KEY_MOUSE_DRAG : KEY_MOUSE;
        }
    }
    return KEY_NONE;
}

/* xterm mods: 1 + shift(1) + alt(2) + ctrl(4) + meta/cmd(8). */
static int cctext_with_mods(int key, int mods) {
    int bits = mods > 0 ? mods - 1 : 0;
    if (bits & 1) g_shift = 1;
    if (bits & 2) g_alt = 1;
    if ((bits & 4) || (bits & 8)) {
        if (key == KEY_LEFT) return KEY_HOME;
        if (key == KEY_RIGHT) return KEY_END;
    }
    return key;
}

static int cctext_csi_letter(int d, int n, int mods) {
    if (d == 'A') return cctext_with_mods(KEY_UP, mods);
    if (d == 'B') return cctext_with_mods(KEY_DOWN, mods);
    if (d == 'C') return cctext_with_mods(KEY_RIGHT, mods);
    if (d == 'D') return cctext_with_mods(KEY_LEFT, mods);
    if (d == 'H') return cctext_with_mods(KEY_HOME, mods);
    if (d == 'F') return cctext_with_mods(KEY_END, mods);
    if (d == '~') {
        if (n == 3) return KEY_DELETE;
        if (n == 1 || n == 7) return cctext_with_mods(KEY_HOME, mods);
        if (n == 4 || n == 8) return cctext_with_mods(KEY_END, mods);
    }
    return KEY_NONE;
}

static int cctext_parse_csi(int first) {
    int b = first;
    if (b < 0) b = getchar();
    if (b == '<') return cctext_parse_mouse();
    if (b == 'A' || b == 'B' || b == 'C' || b == 'D' || b == 'H' || b == 'F') {
        return cctext_csi_letter(b, 0, 0);
    }
    if (b >= '0' && b <= '9') {
        int n = b - '0';
        int d;
        int mods = 0;
        int saw_mod = 0;
        while ((d = getchar()) != EOF) {
            if (d >= '0' && d <= '9') {
                if (saw_mod) mods = mods * 10 + (d - '0');
                else n = n * 10 + (d - '0');
            } else if (d == ';') {
                saw_mod = 1;
            } else {
                return cctext_csi_letter(d, n, mods);
            }
        }
    }
    return KEY_NONE;
}

static int cctext_read(int *ch_out, int wait_us) {
    int c;
    if (g_winch) return KEY_NONE;
    /* Terminals clamp the pointer to row 1..rows. While a drag sits on
     * the first or last text row, poll so we keep scrolling without a wiggle. */
    if (g_mouse_drag && g_drag_edge) {
        fd_set rfds;
        struct timeval tv;
        int n;
        FD_ZERO(&rfds);
        FD_SET(STDIN_FILENO, &rfds);
        tv.tv_sec = 0;
        tv.tv_usec = 32000;
        n = select(STDIN_FILENO + 1, &rfds, NULL, NULL, &tv);
        if (n == 0) return KEY_MOUSE_DRAG;
        if (n < 0) return KEY_NONE;
    } else {
        /* Wake on SIGWINCH. Do not select if stdio already holds a CSI byte. */
        int peek = cctext_pending();
        if (peek >= 0) {
            ungetc(peek, stdin);
        } else {
            fd_set rfds;
            struct timeval tv;
            int n;
            FD_ZERO(&rfds);
            FD_SET(STDIN_FILENO, &rfds);
            tv.tv_sec = 0;
            tv.tv_usec = wait_us < 0 ? 400000 : wait_us;
            n = select(STDIN_FILENO + 1, &rfds, NULL, NULL, &tv);
            if (n < 0) return (errno == EINTR) ? KEY_NONE : KEY_QUIT;
            if (n == 0) return KEY_NONE;
        }
    }
    if (g_winch) return KEY_NONE;
    c = getchar();
    g_shift = 0;
    g_alt = 0;
    if (c == EOF) return KEY_QUIT;
    if (c == 17) return KEY_QUIT;
    if (c == 19) return KEY_SAVE;
    if (c == 26) return KEY_UNDO;
    if (c == 25) return KEY_REDO;
    if (c == 24) return KEY_CUT;
    if (c == 3) return KEY_COPY;
    if (c == 22) return KEY_PASTE;
    if (c == 23) return KEY_OTHER_PANE;
    if (c == 14) return KEY_NEXT_BUF;
    if (c == 28) return KEY_SPLIT;
    if (c == 7) return KEY_JUMP;
    if (c == 6) return KEY_FIND;
    if (c == 15) return KEY_OPEN;
    if (c == 1) return KEY_SEL_ALL;
    if (c == 12) return KEY_VIEW;
    if (c == 21) return KEY_FOLLOW;
    {
        int nav = rtx_nav_from_ctrl(c);
        if (nav) {
            g_nav = nav;
            return KEY_NAV;
        }
    }
    if (c == 127 || c == 8) return KEY_BACKSPACE;
    if (c == '\r' || c == '\n') return KEY_ENTER;
    if (c == 0x1b) {
        int a = cctext_pending();
        if (a < 0) return KEY_HELP;
        if (a == 0x1b) {
            ungetc(a, stdin);
            return KEY_HELP;
        }
        if (a == 'O') {
            int b = getchar();
            if (b == 'A') return KEY_UP;
            if (b == 'B') return KEY_DOWN;
            if (b == 'C') return KEY_RIGHT;
            if (b == 'D') return KEY_LEFT;
            if (b == 'H') return KEY_HOME;
            if (b == 'F') return KEY_END;
            return KEY_NONE;
        }
        if (a == '[') return cctext_parse_csi(-1);
        return cctext_cmd_letter(a);
    }
    /* Leftover SGR mouse after a botched ESC: `[<32;71;32M` or `<32;…M`. */
    if (c == '[') {
        int n = cctext_pending();
        if (n == '<') return cctext_parse_mouse();
        if (n >= 0) ungetc(n, stdin);
    }
    if (c == '<') {
        int n = cctext_pending();
        if (n >= '0' && n <= '9') {
            ungetc(n, stdin);
            return cctext_parse_mouse();
        }
        if (n >= 0) ungetc(n, stdin);
    }
    if (c >= 32 && c < 127) {
        *ch_out = c;
        return KEY_CHAR;
    }
    if (c >= 0x80) {
        uint32_t cp;
        if (cctext_decode_utf8(c, &cp)) {
            *ch_out = (int)cp;
            return KEY_CHAR;
        }
        return KEY_NONE;
    }
    return KEY_NONE;
}

static int cctext_pane_cols(RtxWs *w, int cols, int pane);

static void !>(CCError) cctext_after_edit(RtxWs *w, RtxMeasure *m, int cols, int vis) {
    int bufi, held;
    double w0, w1;
    if (!w || !m) return cc_err(CC_ERR_INVALID_ARG, "after edit");
    bufi = w->pane[w->focus];
    held = w->hold_pane(0);
    w0 = (double)cctext_text_cols(&w->bufs[w->pane[0]], cctext_pane_cols(w, cols, 0), vis);
    w->drop_pane(0, held);
    w1 = w0;
    if (w->npanes > 1) {
        held = w->hold_pane(1);
        w1 = (double)cctext_text_cols(&w->bufs[w->pane[1]], cctext_pane_cols(w, cols, 1), vis);
        w->drop_pane(1, held);
    }
    return w->after_edit(bufi, m, w0, w1, vis);
}

static void cctext_ensure_caret(RtxBuf *b, int vis) {
    @errhandler(RtxIndexErr e) {
        (void)e;
        return; /* fault already set by line_* on err */
    }
    if (!b || b->unlock || b->pin_view) return;
    if (b->seek_valid) b->reveal_guess(b->doc.caret, vis) !>;
    else b->reveal(vis) !>;
}

static void cctext_follow_caret(RtxBuf *b) {
    if (b) b->pin_view = 0;
}

static int cctext_pane_cols(RtxWs *w, int cols, int pane) {
    if (w->npanes < 2) return cols;
    if (pane == 0) return cols / 2 - 1;
    return cols - (cols / 2) - 1;
}

static int cctext_pane_at_col(RtxWs *w, int cols, int col) {
    if (w->npanes < 2) return 0;
    return col > cols / 2 ? 1 : 0;
}

static int cctext_scroll_hit(int mx, int col0, int pcols, int rw) {
    int sc;
    if (rw < 1) return 0;
    sc = col0 + pcols - rw;
    return mx == sc || (rw > 1 && mx == sc + 1);
}

static int cctext_caret_cell(RtxBuf *b, int vis, int pcols, int col0, int *row, int *col);

/* Hex pane: offset | 16 hex bytes | UTF-8 dump (geometry in core/hex). */
static size_t cctext_hex_hit_byte(RtxBuf *b, int vis, int row, int col) {
    if (!b || row < 0 || row >= vis) return b ? b->doc.caret : 0;
    return rtx_hex_hit_col(b->top_byte, b->len(), row, col);
}

static int cctext_put_field(RtxField f, const RtxUi *ui, const char *restore,
                            int used, int maxc) {
    size_t i, n, lo, hi;
    char[:] bytes;
    const char *caret = ui ? rtx_ui_prompt_caret(ui) : "";
    int has;
    rtx_field_clamp(f);
    n = f.len ? *f.len : 0;
    bytes = rtx_field_bytes(f);
    lo = rtx_field_lo(f);
    hi = rtx_field_hi(f);
    has = rtx_field_has_sel(f);
    i = 0;
    while (i <= n && used < maxc) {
        if (f.caret && *f.caret == i && caret && caret[0]) {
            fputs(caret, stdout);
            used++;
            if (used >= maxc) break;
        }
        if (i >= n) break;
        {
            RtxUtf8Cl cl = rtx_utf8_cluster(bytes, i);
            size_t step = cl.n ? cl.n : 1;
            int sel = has && i >= lo && i < hi;
            if (cl.cols > 0 && used + cl.cols > maxc) break;
            if (sel) fputs("\x1b[7m", stdout);
            if (f.buf) fwrite(f.buf + i, 1, step, stdout);
            if (sel) fputs(restore ? restore : "\x1b[0m", stdout);
            used += cl.cols;
            i += step;
        }
    }
    return used;
}

static void cctext_browse_face(int selected, RtxBrowseFace face) {
    fputs("\x1b[0m", stdout);
    if (selected) fputs("\x1b[44m", stdout);
    fputs(rtx_browse_face(face).ansi, stdout);
}

static void cctext_browse_pad(int n, int selected) {
    int i;
    fputs("\x1b[0m", stdout);
    if (selected) fputs("\x1b[44m", stdout);
    for (i = 0; i < n; i++) fputc(' ', stdout);
}

static void cctext_browse_text(const char *s, int maxc) {
    int n = 0;
    if (!s) return;
    while (s[n] && n < maxc) {
        fputc(s[n], stdout);
        n++;
    }
}

static void cctext_browse_row(int row, int col0, int pcols, int pad_rest,
                              int selected, const char *text, RtxBrowseFace face) {
    int n = 0;
    fprintf(stdout, "\x1b[%d;%dH", row, col0);
    cctext_browse_face(selected, face);
    if (text) {
        while (text[n] && n < pcols) {
            fputc(text[n], stdout);
            n++;
        }
    }
    cctext_browse_pad(pcols - n, selected);
    fputs("\x1b[0m", stdout);
    if (!pad_rest) fputs("\x1b[K", stdout);
}

static void cctext_browse_ent(int row, int col0, int pcols, int pad_rest,
                              int selected, const RtxBrowse *br,
                              const RtxBrowseEnt *e) {
    char name[RTX_BROWSE_NAME + 2];
    char size[12];
    char when[24];
    int meta = RTX_BROWSE_SIZE_W + 2 + RTX_BROWSE_MTIME_W;
    int show = pcols >= 10 + meta;
    int size_at = show ? pcols - meta : pcols;
    int name_w = size_at - 2;
    int used;
    if (name_w < 1) name_w = 1;
    fprintf(stdout, "\x1b[%d;%dH", row, col0);
    cctext_browse_pad(1, selected);
    snprintf(name, sizeof(name), "%s%s", e->name, e->is_dir ? "/" : "");
    {
        size_t pref = rtx_browse_dir_prefix(name);
        size_t hit = 0, hn = 0, i = 0;
        int left = name_w;
        rtx_browse_hit_span(br, name, &hit, &hn);
        while (left > 0 && name[i]) {
            RtxBrowseFace fa, fb;
            size_t j = i;
            int n;
            if (hn && i >= hit && i < hit + hn) fa = RTX_BROWSE_FACE_HIT;
            else if (i < pref || e->is_dir) fa = RTX_BROWSE_FACE_DIR;
            else fa = RTX_BROWSE_FACE_FILE;
            j++;
            while (name[j]) {
                if (hn && j >= hit && j < hit + hn) fb = RTX_BROWSE_FACE_HIT;
                else if (j < pref || e->is_dir) fb = RTX_BROWSE_FACE_DIR;
                else fb = RTX_BROWSE_FACE_FILE;
                if (fb != fa) break;
                j++;
            }
            n = (int)(j - i);
            if (n > left) n = left;
            cctext_browse_face(selected, fa);
            cctext_browse_text(name + i, n);
            left -= n;
            i = j;
        }
    }
    used = 1 + (int)strlen(name);
    if (used > 1 + name_w) used = 1 + name_w;
    if (used < size_at) cctext_browse_pad(size_at - used, selected);
    if (show) {
        rtx_browse_fmt_size(size, sizeof(size), e);
        rtx_browse_fmt_mtime(when, sizeof(when), e);
        cctext_browse_face(selected, RTX_BROWSE_FACE_SIZE);
        cctext_browse_text(size, RTX_BROWSE_SIZE_W);
        cctext_browse_pad(2, selected);
        cctext_browse_face(selected, RTX_BROWSE_FACE_DATE);
        cctext_browse_text(when, RTX_BROWSE_MTIME_W);
        used = size_at + meta;
    }
    if (used < pcols) cctext_browse_pad(pcols - used, selected);
    fputs("\x1b[0m", stdout);
    if (!pad_rest) fputs("\x1b[K", stdout);
}

static void cctext_draw_browse(RtxBrowse *br, const RtxUi *ui, int focused, int vis,
                               int pcols, int col0, int pad_rest) {
    char line[512];
    int r;
    size_t list, i;
    if (!br) return;
    rtx_browse_scroll(br, vis);
    snprintf(line, sizeof(line), " %s", br->dir);
    cctext_browse_row(1, col0, pcols, pad_rest, 0, line, RTX_BROWSE_FACE_PATH);
    {
        int used = 0;
        int i;
        fprintf(stdout, "\x1b[%d;%dH", 2, col0);
        cctext_browse_face(0, RTX_BROWSE_FACE_GLOB);
        fputs(" glob: ", stdout);
        used = 7;
        used = cctext_put_field(rtx_browse_field(br), focused ? ui : NULL,
                                rtx_browse_face(RTX_BROWSE_FACE_GLOB).ansi, used, pcols);
        cctext_browse_pad(pcols - used, 0);
        fputs("\x1b[0m", stdout);
        if (!pad_rest) fputs("\x1b[K", stdout);
    }
    list = (vis > RTX_BROWSE_HEAD) ? (size_t)(vis - RTX_BROWSE_HEAD) : 0;
    for (i = 0; i < list; i++) {
        size_t idx = br->top + i;
        r = RTX_BROWSE_HEAD + 1 + (int)i;
        if (idx >= br->len) {
            cctext_browse_row(r, col0, pcols, pad_rest, 0, "", RTX_BROWSE_FACE_FILE);
            continue;
        }
        cctext_browse_ent(r, col0, pcols, pad_rest,
                          focused && idx == br->cur, br, &br->ents[idx]);
    }
}


/* 1 if the caret is on a cell in this pane. Hex sits on the first nibble. */
static int cctext_caret_cell(RtxBuf *b, int vis, int pcols, int col0, int *row, int *col) {
    size_t caret;
    int g, tcols;
    size_t r;
    if (!b || vis < 1 || !row || !col) return 0;
    caret = b->doc.caret;
    if (rtx_layout_is_hex(&b->layout)) {
        size_t top = rtx_hex_align(b->top_byte);
        size_t crow = caret / (size_t)RTX_HEX_COLS;
        size_t trow = top / (size_t)RTX_HEX_COLS;
        size_t k;
        if (crow < trow || crow >= trow + (size_t)vis) return 0;
        k = caret - crow * (size_t)RTX_HEX_COLS;
        *row = (int)(crow - trow) + 1;
        *col = col0 + RTX_HEX_OFF_W + (int)k * 3;
        return 1;
    }
    g = rtx_gutter_cols_buf(b, vis);
    tcols = cctext_text_cols(b, pcols, vis);
    for (r = 0; r < (size_t)vis; r++) {
        size_t idx = r + b->top_wrap;
        RtxVisRow *vr;
        size_t at;
        int span_ok = 1;
        if (idx >= b->layout.len) break;
        vr = &b->layout.rows[idx];
        if (caret < vr->byte_start) continue;
        if (caret > vr->byte_start + vr->byte_len) continue;
        at = caret - vr->byte_start;
        {
            cc_arena_stack(scratch, RTX_FRAME_SCRATCH);
            char[:] bytes = cc_slice_empty();
            @errhandler(CCError e) {
                (void)e;
                span_ok = 0;
            }
            bytes = b->scratch_span(&scratch, vr->byte_start, vr->byte_len) !>;
            if (span_ok) at = (size_t)rtx_utf8_prefix_cols(bytes, at);
        }
        if (at > (size_t)tcols) at = (size_t)tcols;
        *row = (int)r + 1;
        *col = col0 + g + (int)at;
        return 1;
    }
    return 0;
}

static void cctext_place_cursor(RtxWs *w, RtxUi *ui, int vis, int cols) {
    RtxBuf *act;
    int pane, pcols, col0, row, col;
    if (!w) return;
    act = w->active();
    if (!act || rtx_ui_prompting(ui) || (ui && (ui->help || ui->ask_quit)) ||
        (w && w->browsing())) {
        fputs("\x1b[?25l", stdout);
        return;
    }
    pane = w->focus;
    pcols = cctext_pane_cols(w, cols, pane);
    col0 = (pane == 0) ? 1 : (cols / 2 + 2);
    if (rtx_ui_blink(ui) && cctext_caret_cell(act, vis, pcols, col0, &row, &col)) {
        fprintf(stdout, "\x1b[%d;%dH\x1b[?25h", row, col);
    } else {
        fputs("\x1b[?25l", stdout);
    }
}

/* Last "  " is the key / action split. A line with no gap is all action. */
static void cctext_help_split(const char *line, size_t *key_n, const char **desc) {
    const char *last = NULL;
    const char *p;
    size_t kn;
    if (!key_n || !desc) return;
    *key_n = 0;
    *desc = line ? line : "";
    if (!line || !line[0]) return;
    for (p = line; p[0] && p[1]; p++) {
        if (p[0] == ' ' && p[1] == ' ') last = p;
    }
    if (!last) return;
    while (*last == ' ') last++;
    kn = (size_t)(last - line);
    while (kn && line[kn - 1] == ' ') kn--;
    *key_n = kn;
    *desc = last;
}

static void cctext_help_pad(int n) {
    int i;
    for (i = 0; i < n; i++) fputc(' ', stdout);
}

static void cctext_draw_help(int rows, int cols) {
    int i;
    int n = 0;
    int box_w = 50;
    int box_h;
    int r0, c0;
    int key_w = 13;
    while (rtx_help_line((size_t)n)) n++;
    box_h = n + 4;
    if (box_w > cols - 2) box_w = cols - 2;
    if (box_h > rows - 2) box_h = rows - 2;
    r0 = (rows - box_h) / 2;
    if (r0 < 1) r0 = 1;
    c0 = (cols - box_w) / 2;
    if (c0 < 1) c0 = 1;
    for (i = 0; i < box_h; i++) {
        fprintf(stdout, "\x1b[%d;%dH", r0 + i, c0);
        if (i == 0) {
            fputs("\x1b[44;33;1m key bindings", stdout);
            cctext_help_pad(box_w - 13);
        } else if (i == 1) {
            int d;
            fputs("\x1b[44;34m ", stdout);
            for (d = 1; d < box_w - 1; d++) fputc('-', stdout);
            fputc(' ', stdout);
        } else if (i - 2 >= 0 && i - 2 < n && i < box_h - 1) {
            size_t kn = 0;
            const char *desc = "";
            int used = 1;
            int dn, room;
            cctext_help_split(rtx_help_line((size_t)(i - 2)), &kn, &desc);
            fputs("\x1b[44m ", stdout);
            if (kn) {
                int kw = (int)kn < key_w ? (int)kn : key_w;
                fputs("\x1b[36;1m", stdout);
                fwrite(rtx_help_line((size_t)(i - 2)), 1, (size_t)kw, stdout);
                fputs("\x1b[44m", stdout);
                cctext_help_pad(key_w - kw);
                used += key_w;
                fputs("\x1b[37m ", stdout);
                used++;
            } else {
                fputs("\x1b[37m", stdout);
            }
            room = box_w - used - 1;
            dn = (int)strlen(desc);
            if (dn > room) dn = room;
            if (dn > 0) fwrite(desc, 1, (size_t)dn, stdout);
            used += dn;
            fputs("\x1b[44m", stdout);
            cctext_help_pad(box_w - used);
        } else {
            fputs("\x1b[44m", stdout);
            cctext_help_pad(box_w);
        }
        fputs("\x1b[0m", stdout);
    }
}

static int cctext_find_span(const char *ctx, size_t n, const char *q, size_t qn,
                            size_t *at, size_t *len, int *hit) {
    size_t i, j;
    if (!ctx || !at || !len || !hit || *at >= n) return 0;
    i = *at;
    if (q && qn && i + qn <= n && memcmp(ctx + i, q, qn) == 0) {
        *len = qn;
        *hit = 1;
        *at = i + qn;
        return 1;
    }
    j = i + 1;
    while (j < n && !(q && qn && j + qn <= n && memcmp(ctx + j, q, qn) == 0))
        j++;
    *len = j - i;
    *hit = 0;
    *at = j;
    return 1;
}

static void cctext_draw_find(RtxDoc *d, RtxUi *ui, int rows, int cols, int find_h) {
    int r0 = rows - find_h;
    int vis_hits = find_h > 1 ? find_h - 1 : 0;
    int i;
    char head[256];
    size_t ctxn = (size_t)(cols > 16 ? cols - 10 : 8);
    if (r0 < 1) r0 = 1;
    rtx_ui_find_scroll(ui, d, (size_t)vis_hits);
    rtx_ui_find_stats(d, head, sizeof(head));
    fprintf(stdout, "\x1b[%d;1H\x1b[44;37m find: ", r0);
    cctext_put_field(rtx_ui_find_field(ui), ui, "\x1b[44;37m", 7, cols > 2 ? cols - 1 : 1);
    fprintf(stdout, "  %s\x1b[0m\x1b[K", head);
    for (i = 0; i < vis_hits; i++) {
        size_t hit = ui->find_top + (size_t)i;
        int row = r0 + 1 + i;
        int cur = d && hit == d->find.cur;
        fprintf(stdout, "\x1b[%d;1H%s", row, cur ? "\x1b[7m" : "\x1b[0m");
        if (!d || hit >= d->find.len) {
            fputs("\x1b[K\x1b[0m", stdout);
            continue;
        }
        {
            char ctx[256];
            size_t line1 = 0;
            int ok = 1;
            rtx_ui_find_row_text(d, hit, ctxn, ctx, sizeof(ctx), &line1) !>(e) {
                ok = 0;
            };
            if (!ok) {
                fprintf(stdout, "  %zu\x1b[K\x1b[0m", hit + 1);
            } else {
                const char *q = d->find.query.ptr;
                size_t qn = d->find.query.len;
                size_t at = 0, n = strlen(ctx), len;
                int is_hit;
                fprintf(stdout, " %5zu  ", line1);
                while (cctext_find_span(ctx, n, q, qn, &at, &len, &is_hit)) {
                    fputs(is_hit ? "\x1b[43;30m" : (cur ? "\x1b[7m" : "\x1b[0m"),
                          stdout);
                    fwrite(ctx + at - len, 1, len, stdout);
                }
                fputs("\x1b[K\x1b[0m", stdout);
            }
        }
    }
}

static void cctext_draw(RtxWs *w, RtxUi *ui, int rows, int cols) {
    int find_h = rtx_ui_find_rows(ui, rows);
    int vis = rows - 1 - find_h;
    int p;
    RtxBuf *act = w->active();
    @errhandler(RtxIndexErr e) {
        (void)e;
        return; /* fault already set by line_* on err */
    }
    if (vis < 1) vis = 1;
    rtx_ui_blink_step(ui);
    /* Synchronized update: do not ED (erase display) — that is the flicker. */
    fputs("\x1b[?2026h", stdout);
    for (p = 0; p < w->npanes; p++) {
        int bi = w->pane[p];
        RtxBuf *b = &w->bufs[bi];
        int pcols = cctext_pane_cols(w, cols, p);
        int col0 = (p == 0) ? 1 : (cols / 2 + 2);
        int pad_left = (w->npanes == 2 && p == 0);
        {
            RtxBrowse *br = &w->nav[p];
            int held = w->hold_pane(p);
            if (br && br->on)
                cctext_draw_browse(br, ui, p == w->focus, vis, pcols, col0, pad_left);
            else
                cctext_draw_pane(b, ui, p == w->focus, vis, pcols, col0, pad_left,
                                 g_status, sizeof(g_status), g_mouse_row);
            w->drop_pane(p, held);
        }
        if (w->npanes == 2 && p == 0) {
            size_t r;
            int gap = cols / 2;
            for (r = 0; r < (size_t)vis; r++) {
                fprintf(stdout, "\x1b[%zu;%dH\x1b[0m \x1b[90m│\x1b[0m", r + 1, gap);
            }
        }
    }
    if (ui && ui->find && act && find_h > 0) {
        cctext_draw_find(&act->doc, ui, rows, cols, find_h);
    }
    if (ui && ui->help) cctext_draw_help(rows, cols);
    if (ui && ui->stats) cctext_draw_stats(act, rows, cols);
    {
        const char *path = (act && act->doc.path.ptr) ? act->doc.path.ptr : "(untitled)";
        const char *star = (act && act->doc.dirty()) ? "*" : " ";
        if (ui && ui->ask_quit) {
            fprintf(stdout,
                    "\x1b[%d;1H\x1b[41;97m unsaved  s save  q don't save  Esc cancel  %s\x1b[0m\x1b[K",
                    rows, g_status);
        } else if (ui && ui->jump) {
            char jump[64];
            rtx_ui_jump_header(ui, jump, sizeof(jump));
            fprintf(stdout, "\x1b[%d;1H\x1b[7m %s\x1b[0m\x1b[K", rows, jump);
        } else if (w && w->browsing()) {
            RtxBrowse *br = RtxWs_browse(w);
            fprintf(stdout,
                    "\x1b[%d;1H\x1b[7m browse  %zu/%zu%s  enter open  Esc %s  %s\x1b[0m\x1b[K",
                    rows, br && br->len ? br->cur + 1 : 0, br ? br->len : 0,
                    br && br->scanning ? "  scanning..." :
                    (br && br->truncated ? "  capped" : ""),
                    br && br->boot ? "quit" : "close", g_status);
        } else if (ui && ui->find) {
            fprintf(stdout,
                    "\x1b[%d;1H\x1b[7m find  up/down hits  Esc close  %s\x1b[0m\x1b[K",
                    rows, g_status);
        } else {
            if (act && rtx_layout_is_hex(&act->layout)) {
                fprintf(stdout,
                        "\x1b[%d;1H\x1b[7m%s%s  @%zX  hex %s%s  Esc help  g jump  %s\x1b[0m\x1b[K",
                        rows, star, path, act->doc.caret,
                        act->hex_nib ? "lo" : "hi",
                        act->unlock ? "  unlock" : "", g_status);
            } else {
                {
                    char pos[48];
                    rtx_status_line_pos(act, pos, sizeof(pos)) !>;
                    fprintf(stdout,
                            "\x1b[%d;1H\x1b[7m%s%s  %s%s  Esc help  g jump  f find  %s\x1b[0m\x1b[K",
                            rows, star, path, pos,
                            (act && act->unlock) ? "  unlock" : "", g_status);
                }
            }
        }
    }
    fputs("\x1b[?2026l", stdout);
    cctext_place_cursor(w, ui, vis, cols);
    fflush(stdout);
}

static void cctext_scroll_bar(RtxBuf *b, RtxMeasure *m, int vis, int pcols, int drag) {
    RtxScrollRail rail;
    int ly, ty, th;
    double tw;
    if (!b || vis < 1) return;
    tw = (double)cctext_text_cols(b, pcols, vis);
    ly = g_mouse_row - 1;
    @errhandler(CCError e) {
        snprintf(g_status, sizeof(g_status), "%s", e.message ? e.message : "scroll");
        return;
    }
    @errhandler(RtxIndexErr e) {
        (void)e;
        return; /* fault already set by line_* on err */
    }
    if (!drag || !b->drag_len) {
        rail = b->scroll_rail(vis) !>;
        rtx_scroll_rail_thumb(&rail, vis, 1, &ty, &th);
        b->drag_vis = rail.vis ? rail.vis : 1;
        b->drag_len = rail.len;
        if (ly >= ty && ly < ty + th) b->drag_grab = ly - ty;
        else {
            b->drag_grab = th / 2;
            b->scroll_to_off(rtx_scroll_rail_pos_at(&rail, vis, 1, ly - b->drag_grab)) !>;
            b->ensure_view(m, tw, vis) !>;
        }
        return;
    }
    {
        RtxScrollRail map;
        size_t off, dest, cur;
        map.pos = 0;
        map.vis = b->drag_vis ? b->drag_vis : 1;
        map.len = b->drag_len ? b->drag_len : b->len();
        map.ready = 1;
        off = rtx_scroll_rail_pos_at(&map, vis, 1, ly - b->drag_grab);
        if (rtx_layout_is_hex(&b->layout)) {
            dest = rtx_hex_align(off);
            cur = b->top_byte;
        } else {
            dest = rtx_doc_line_floor(&b->doc, off) !>;
            cur = b->seek_valid ? b->seek_off :
                  (b->layout.len ? b->layout.rows[0].byte_start : (size_t)-1);
        }
        if (dest != cur) {
            b->scroll_to_off(off) !>;
            b->ensure_view(m, tw, vis) !>;
        }
    }
}

static int cctext_click_keeps_sel(RtxDoc *d, size_t at, int crossed) {
    @errhandler(RtxIndexErr e) {
        (void)e;
        return 0;
    }
    if (!crossed || g_shift || g_alt || !d || !d->has_sel()) return 0;
    return d->sel_covers(at) !>;
}

static void cctext_hit(RtxWs *w, RtxMeasure *m, int cols, int vis, int drag) {
    int pane = cctext_pane_at_col(w, cols, g_mouse_col);
    int prev = w->focus;
    int pcols = cctext_pane_cols(w, cols, pane);
    int col0 = (pane == 0) ? 1 : (cols / 2 + 2);
    RtxBuf *b;
    double x, y;
    @errhandler(CCError e) {
        snprintf(g_status, sizeof(g_status), "%s", e.message ? e.message : "hit failed");
        return;
    }
    @errhandler(RtxIndexErr e) {
        (void)e;
        return; /* fault already set by line_* on err */
    }
    w->set_focus(pane);
    b = w->active();
    if (!b) return;
    if (w->nav[pane].on) {
        int brow = g_mouse_row - 1;
        if (brow == 1 || g_field_drag == 2) {
            int col = g_mouse_col - col0 - 7;
            if (!drag) g_field_drag = 2;
            w->nav[pane].glob_focus = 1;
            rtx_field_click(rtx_browse_field(&w->nav[pane]), col, g_shift, drag);
            return;
        }
        if (!drag) {
            g_field_drag = 0;
            w->nav[pane].glob_focus = 0;
        }
        {
            int idx = rtx_browse_hit(&w->nav[pane], brow, vis);
            if (idx >= 0) {
                size_t was = w->nav[pane].cur;
                w->nav[pane].cur = (size_t)idx;
                rtx_browse_scroll(&w->nav[pane], vis);
                if (!drag && was == w->nav[pane].cur)
                    w->browse_enter() !>;
            }
        }
        return;
    }
    if (cctext_scroll_hit(g_mouse_col, col0, pcols, cctext_rail_w(b, vis)) ||
        (drag && b->drag_len)) {
        cctext_scroll_bar(b, m, vis, pcols, drag);
        return;
    }
    cctext_follow_caret(b);
    if (!drag) {
        b->drag_vis = 0;
        b->drag_len = 0;
        b->drag_grab = 0;
    }
    {
        double tw = (double)cctext_text_cols(b, pcols, vis);
        /* SGR never reports a row above the window; row 1 is "above". */
        if (drag && g_mouse_row <= 1) {
            b->scroll_vis(m, tw, -1) !>;
            b->ensure_view(m, tw, vis) !>;
            g_mouse_row = 1;
        } else if (drag && g_mouse_row >= vis) {
            b->scroll_vis(m, tw, 1) !>;
            b->ensure_view(m, tw, vis) !>;
            g_mouse_row = vis;
        } else if (g_mouse_row < 1 || g_mouse_row > vis) {
            return;
        }
        g_drag_edge = drag && (g_mouse_row <= 1 || g_mouse_row >= vis);
    }
    if (rtx_layout_is_hex(&b->layout)) {
        int col = g_mouse_col - col0;
        int row = g_mouse_row - 1;
        size_t at;
        if (col < 0) col = 0;
        at = cctext_hex_hit_byte(b, vis, row, col);
        if (!drag && cctext_click_keeps_sel(&b->doc, at, pane != prev)) return;
        b->doc.caret = at;
        if (!drag) b->hex_nib = rtx_hex_nib_from_col(col);
        if (!drag && !g_shift) b->doc.sel_anchor = b->doc.caret;
        b->doc.sel_box = 0;
        b->clear_pref();
        b->doc.break_coalesce();
        return;
    }
    x = (double)(g_mouse_col - col0);
    x -= (double)rtx_gutter_cols_buf(b, vis);
    if (x < 0) x = 0;
    if (x > (double)pcols) x = (double)pcols;
    y = (double)(g_mouse_row - 1);
    {
        size_t s;
        for (s = 0; s < b->top_wrap && s < b->layout.len; s++) {
            y += b->layout.rows[s].height;
        }
    }
    {
        size_t at = b->layout.hit(&b->doc, m, x, y) !>;
        if (!drag && cctext_click_keeps_sel(&b->doc, at, pane != prev)) return;
        b->doc.caret = at;
    }
    if (g_alt) {
        size_t ls = rtx_doc_line_floor(&b->doc, b->doc.caret) !>;
        if (!drag) {
            b->doc.sel_anchor = b->doc.caret;
            b->doc.sel_box = 1;
            b->pref.col = b->doc.caret - ls;
            b->pref.ok = 1;
            b->pref.eol = 0;
            b->doc.box_acol = b->pref.col;
            b->doc.box_ccol = b->pref.col;
        } else {
            b->pref.col = b->doc.caret - ls;
            b->pref.ok = 1;
            b->pref.eol = 0;
            b->box_sync() !>;
        }
    } else {
        if (!drag && !g_shift) b->doc.sel_anchor = b->doc.caret;
        b->doc.sel_box = 0;
        b->clear_pref();
    }
    b->doc.break_coalesce();
}

int main(int argc, char **argv) {
    @errhandler(CCError e) {
            snprintf(g_status, sizeof(g_status), "%s",
                     e.message ? e.message : "error");
        cc_error_log(e);
        if (!g_raw) return 1;
    }
    @errhandler(RtxIndexErr e) {
        (void)e;
        if (!g_raw) return 1;
    }
    RtxWs w = {0} @destroy;
    RtxMeasure m;
    char *filebuf[32];
    RtxCli cli;
    const char *prog;
    int rows = 24, cols = 80;
    int last_rows = 0, last_cols = 0;
    int kind;
    int ch = 0;
    int skip_reveal = 0;
    RtxUi ui;

    prog = (argc > 0 && argv[0] && argv[0][0]) ? argv[0] : "cctext";
    if (rtx_cli_parse(argc, argv, filebuf, 32, &cli) != 0) {
        rtx_cli_usage(stderr, prog);
        return 2;
    }
    if (cli.help) {
        rtx_cli_usage(stdout, prog);
        return 0;
    }
    if (cli.version) {
        rtx_cli_print_version(stdout, prog);
        return 0;
    }
    if (cli.nfiles == 0) {
        w.open_files(0, NULL) !>;
        if (w.len) rtx_layout_set_view(&w.bufs[0].layout, cli.view);
    } else {
        w.open_files(cli.nfiles, filebuf) !>;
        w.set_views(cli.file_view, cli.nfiles);
    }
    m.measure = cctext_measure;
    m.line_height = cctext_lh;
    m.ctx = NULL;
    g_status[0] = 0;
    memset(&ui, 0, sizeof(ui));

    if (!isatty(STDIN_FILENO) || !cctext_raw()) {
        /* Batch/pipe: stream bytes. Do not walk soft line_count (that can
         * be a million provisional lines on a giant unindexed file). */
        RtxBuf *b = w.active();
        char buf[64 * 1024];
        size_t off = 0;
        size_t n = b ? b->len() : 0;
        while (off < n) {
            size_t take = sizeof(buf);
            size_t got;
            if (take > n - off) take = n - off;
            got = b->read_at(off, buf, take) !>;
            if (!got) break;
            fwrite(buf, 1, got, stdout);
            off += got;
        }
        return 0;
    }

    w.busy_bind(cctext_busy, NULL);
    if (cli.nfiles == 0 || w.untitled()) w.browse_start() !>;

    for (;;) {
        int vis;
        int find_h;
        int p;
        RtxBuf *act;
        cctext_winsize(&rows, &cols);
        if (g_winch || rows != last_rows || cols != last_cols) {
            int rp;
            g_winch = 0;
            last_rows = rows;
            last_cols = cols;
            fputs("\x1b[H\x1b[J", stdout);
            for (rp = 0; rp < w.npanes; rp++) {
                int held = w.hold_pane(rp);
                w.bufs[w.pane[rp]].layout.len = 0;
                w.drop_pane(rp, held);
            }
        }
        find_h = rtx_ui_find_rows(&ui, rows);
        vis = rows - 1 - find_h;
        if (vis < 1) vis = 1;
        act = w.active();
        if (act && ui.find) {
            size_t caret0 = act->doc.caret;
            rtx_ui_find_pump(&ui, &act->doc) !>;
            if (act->doc.caret != caret0 ||
                (act->doc.find.len && !act->seek_valid))
                act->reveal_guess(act->doc.caret, vis) !>;
        }
        RtxWs_browse_pump(&w) !>;
        {
            int isle_on = act && rtx_line_isle_pumping(&act->doc.tree);
            int stale = 0;
            long now = rtx_ui_now_ms();
            if (act && act->seek_valid && act->layout.len &&
                act->layout.rows[0].byte_start != act->seek_off)
                stale = 1;
            if (!act || !act->layout.len) stale = 1;
            if (!isle_on || stale || g_isle_paint_at == 0 ||
                now - g_isle_paint_at >= (long)RTX_LINE_ISLE_PAINT_MS) {
                for (p = 0; p < w.npanes; p++) {
                    RtxBuf *b = &w.bufs[w.pane[p]];
                    double pw = (double)cctext_pane_cols(&w, cols, p);
                    int held = w.hold_pane(p);
                    if (!w.nav[p].on) {
                        if (p == w.focus && !ui.find && !skip_reveal)
                            cctext_ensure_caret(b, vis);
                        b->ensure_view(&m,
                                       (double)cctext_text_cols(b, (int)pw, vis),
                                       vis) !>;
                    }
                    w.drop_pane(p, held);
                }
                cctext_draw(&w, &ui, rows, cols);
                g_isle_paint_at = now;
            }
            if (act) rtx_ui_line_isle_pump(&act->doc, cctext_isle_yield);
            if (act && rtx_line_isle_pumping(&act->doc.tree))
                cctext_draw_isle_status(act, rows);
        }
        skip_reveal = 0;
        kind = cctext_read(&ch,
                           ((ui.find && act && !act->doc.find.done)
                            || RtxWs_browse_busy(&w) || ui.stats
                            || (act && rtx_line_isle_pumping(&act->doc.tree)))
                               ? 0 : 400000);
        if (kind != KEY_NONE) rtx_ui_blink_show(&ui);
        act = w.active();
        if (!act) break;
        if (!g_mouse_drag && act->drag_len) {
            act->drag_vis = 0;
            act->drag_len = 0;
            act->drag_grab = 0;
        }
        if (!g_mouse_drag) g_field_drag = 0;
        if (ui.ask_quit) {
            if (kind == KEY_HELP ||
                (kind == KEY_CHAR && (ch == 'c' || ch == 'C'))) {
                ui.ask_quit = 0;
            } else if (kind == KEY_SAVE ||
                       (kind == KEY_CHAR && (ch == 's' || ch == 'S'))) {
                size_t si;
                int ok = 1;
                for (si = 0; si < w.len; si++) {
                    RtxDoc *sd = &w.bufs[si].doc;
                    if (!sd->dirty()) continue;
                    if (!sd->path.ptr || sd->path.len == 0) {
                        snprintf(g_status, sizeof(g_status),
                                 "untitled — save as a path first");
                        ok = 0;
                        break;
                    }
                    {
                        @errhandler(CCError e) {
                            snprintf(g_status, sizeof(g_status), "%s",
                                     e.message ? e.message : "save failed");
                            ok = 0;
                        }
                        sd->save() !>;
                    }
                    if (!ok) break;
                    sd->break_coalesce();
                }
                if (ok) break;
            } else if (kind == KEY_QUIT ||
                       (kind == KEY_CHAR &&
                        (ch == 'q' || ch == 'Q' || ch == 'n' || ch == 'N' ||
                         ch == 'd' || ch == 'D'))) {
                break;
            }
            continue;
        }
        if (ui.jump) {
            if (kind == KEY_HELP || kind == KEY_QUIT) {
                rtx_ui_clear_jump(&ui);
            } else if (kind == KEY_ENTER) {
                rtx_ui_apply_jump(&ui, act, vis) !>;
                if (!act->unlock) cctext_follow_caret(act);
            } else if (kind == KEY_BACKSPACE && ui.jump_len > 0) {
                ui.jump_buf[--ui.jump_len] = 0;
            } else if (kind == KEY_CHAR) {
                rtx_ui_jump_char(&ui, ch);
            }
            continue;
        }
        if (ui.find) {
            RtxField ff = rtx_ui_find_field(&ui);
            int changed = 0;
            if (kind == KEY_HELP || kind == KEY_QUIT) {
                act->doc.find.cancel = 1;
                rtx_ui_clear_find(&ui);
            } else if (kind == KEY_UP) {
                act->doc.find_prev();
                act->reveal_guess(act->doc.caret, vis) !>;
                if (!act->unlock) cctext_follow_caret(act);
            } else if (kind == KEY_DOWN) {
                act->doc.find_next();
                act->reveal_guess(act->doc.caret, vis) !>;
                if (!act->unlock) cctext_follow_caret(act);
            } else if (kind == KEY_LEFT) {
                rtx_field_move(ff, -1, g_shift);
            } else if (kind == KEY_RIGHT) {
                rtx_field_move(ff, 1, g_shift);
            } else if (kind == KEY_HOME) {
                rtx_field_edge(ff, 0, g_shift);
            } else if (kind == KEY_END) {
                rtx_field_edge(ff, 1, g_shift);
            } else if (kind == KEY_SEL_ALL) {
                rtx_field_select_all(ff);
            } else if (kind == KEY_COPY) {
                rtx_field_copy(&w, ff) !>;
            } else if (kind == KEY_CUT) {
                rtx_field_cut(&w, ff) !>;
                changed = 1;
            } else if (kind == KEY_PASTE) {
                rtx_field_paste(&w, ff) !>;
                changed = 1;
            } else if (kind == KEY_BACKSPACE) {
                rtx_ui_find_backspace(&ui);
                changed = 1;
            } else if (kind == KEY_DELETE) {
                rtx_field_delete(ff);
                changed = 1;
            } else if (kind == KEY_CHAR) {
                if (rtx_ui_find_char(&ui, ch)) {
                    cctext_find_absorb(&ui);
                    changed = 1;
                }
            } else if (kind == KEY_JUMP) {
                rtx_ui_start_jump(&ui);
            } else if (kind == KEY_MOUSE || kind == KEY_MOUSE_DRAG) {
                int header = vis + 1;
                int idx = g_mouse_row - vis - 2;
                if (g_mouse_row == header || g_field_drag == 1) {
                    if (!g_mouse_drag || kind == KEY_MOUSE) g_field_drag = 1;
                    rtx_field_click(ff, g_mouse_col - 8, g_shift,
                                    kind == KEY_MOUSE_DRAG);
                } else if (idx >= 0) {
                    size_t hit = ui.find_top + (size_t)idx;
                    if (hit < act->doc.find.len) {
                        act->doc.find_goto(hit);
                        act->reveal_guess(act->doc.caret, vis) !>;
                        if (!act->unlock) cctext_follow_caret(act);
                    }
                }
            }
            if (changed) {
                rtx_ui_find_apply(&ui, &act->doc) !>;
                if (act->doc.find.len) act->reveal_guess(act->doc.caret, vis) !>;
            }
            continue;
        }
        if (w.browsing() && (kind == KEY_HELP || kind == KEY_QUIT)) {
            if (w.browse_close()) break;
            continue;
        }
        if (kind == KEY_HELP) {
            ui.help = !ui.help;
            if (ui.help) ui.stats = 0;
            continue;
        }
        if (kind == KEY_STATS) {
            ui.stats = !ui.stats;
            if (ui.stats) ui.help = 0;
            continue;
        }
        if (ui.help) {
            if (kind == KEY_CHAR) kind = cctext_cmd_letter(ch);
            if (kind == KEY_MOUSE || kind == KEY_MOUSE_DRAG ||
                kind == KEY_WHEEL_UP || kind == KEY_WHEEL_DOWN ||
                kind == KEY_NONE) {
                continue;
            }
            if (kind == KEY_CHAR) continue;
            ui.help = 0;
            if (kind == KEY_STATS) {
                ui.stats = 1;
                continue;
            }
        }
        if (kind == KEY_OPEN) {
            rtx_ui_clear_jump(&ui);
            rtx_ui_clear_find(&ui);
            ui.help = 0;
            w.browse_start() !>;
            continue;
        }
        if (w.browsing()) {
            RtxBrowse *br = w.browse();
            RtxField gf = rtx_browse_field(br);
            if (kind == KEY_UP || kind == KEY_WHEEL_UP)
                rtx_browse_move(br, -1, vis);
            else if (kind == KEY_DOWN || kind == KEY_WHEEL_DOWN)
                rtx_browse_move(br, 1, vis);
            else if (kind == KEY_LEFT && (br->glob_focus || g_shift))
                rtx_field_move(gf, -1, g_shift);
            else if (kind == KEY_RIGHT && (br->glob_focus || g_shift))
                rtx_field_move(gf, 1, g_shift);
            else if (kind == KEY_LEFT) w.browse_parent() !>;
            else if (kind == KEY_RIGHT || kind == KEY_ENTER) w.browse_enter() !>;
            else if (kind == KEY_HOME) rtx_field_edge(gf, 0, g_shift);
            else if (kind == KEY_END) rtx_field_edge(gf, 1, g_shift);
            else if (kind == KEY_SEL_ALL) {
                rtx_field_select_all(gf);
                br->glob_focus = 1;
            } else if (kind == KEY_COPY) {
                rtx_field_copy(&w, gf) !>;
            } else if (kind == KEY_CUT) {
                rtx_field_cut(&w, gf) !>;
                rtx_browse_kick(br) !>;
            } else if (kind == KEY_PASTE) {
                rtx_field_paste(&w, gf) !>;
                rtx_browse_kick(br) !>;
            } else if (kind == KEY_DELETE) {
                rtx_field_delete(gf);
                rtx_browse_kick(br) !>;
            } else if (kind == KEY_BACKSPACE) w.browse_backspace() !>;
            else if (kind == KEY_MOUSE || kind == KEY_MOUSE_DRAG)
                cctext_hit(&w, &m, cols, vis, kind == KEY_MOUSE_DRAG);
            else if (kind == KEY_CHAR) w.browse_type(ch) !>;
            continue;
        }
        if (kind == KEY_JUMP) {
            rtx_ui_start_jump(&ui);
            continue;
        }
        if (kind == KEY_FIND) {
            rtx_ui_start_find(&ui);
            rtx_ui_find_apply(&ui, &act->doc) !>;
            if (act->doc.find.len) act->reveal_guess(act->doc.caret, vis) !>;
            continue;
        }
        if (kind == KEY_VIEW) {
            act->cycle_view(vis) !>;
            snprintf(g_status, sizeof(g_status), "view %s",
                     rtx_layout_view_name(&act->layout));
            continue;
        }
        if (kind == KEY_FOLLOW) {
            act->unlock = !act->unlock;
            if (!act->unlock) cctext_follow_caret(act);
            snprintf(g_status, sizeof(g_status), "%s",
                     act->unlock ? "unlock" : "follow");
            continue;
        }
        if (kind == KEY_NAV) {
            int hex = rtx_layout_is_hex(&act->layout);
            int r = 0;
            if (g_nav == 5) {
                if (!hex) r = act->doc.fold_toggle();
                if (r) w.invalidate_buf_views(w.pane[w.focus]);
            } else {
                r = act->doc.scope_step((g_nav == 2 || g_nav == 4) ? -1 : 1,
                                        g_nav >= 3);
            }
            if (r) cctext_follow_caret(act);
            snprintf(g_status, sizeof(g_status), "%s", rtx_nav_msg(g_nav, r, hex));
            continue;
        }
        if (kind == KEY_QUIT) {
            if (rtx_ui_offer_quit(&w, &ui)) break;
            g_status[0] = 0;
            continue;
        }
        if (kind != KEY_NONE && kind != KEY_WHEEL_UP && kind != KEY_WHEEL_DOWN &&
            kind != KEY_MOUSE && kind != KEY_MOUSE_DRAG && kind != KEY_HELP &&
            kind != KEY_SAVE && kind != KEY_COPY && kind != KEY_SPLIT &&
            kind != KEY_OTHER_PANE && kind != KEY_NEXT_BUF &&
            kind != KEY_FOLLOW && kind != KEY_VIEW && !act->unlock) {
            cctext_follow_caret(act);
        }
        if (kind == KEY_SAVE) {
            {
                @errhandler(CCError e) {
                    snprintf(g_status, sizeof(g_status), "%s",
                             e.message ? e.message : "save failed");
                }
                act->doc.save() !>;
            }
            if (!act->doc.dirty()) snprintf(g_status, sizeof(g_status), "saved");
            act->doc.break_coalesce();
        } else if (kind == KEY_UNDO) {
            act->doc.undo() !>;
            cctext_after_edit(&w, &m, cols, vis) !>;
        } else if (kind == KEY_REDO) {
            act->doc.redo() !>;
            cctext_after_edit(&w, &m, cols, vis) !>;
        } else if (kind == KEY_COPY) {
            w.copy() !>;
        } else if (kind == KEY_CUT) {
            w.cut() !>;
            cctext_after_edit(&w, &m, cols, vis) !>;
        } else if (kind == KEY_PASTE) {
            w.paste() !>;
            cctext_after_edit(&w, &m, cols, vis) !>;
        } else if (kind == KEY_SPLIT) {
            w.toggle_split();
            fputs("\x1b[H\x1b[J", stdout);
            {
                int rp;
                for (rp = 0; rp < w.npanes; rp++) {
                    int held = w.hold_pane(rp);
                    w.bufs[w.pane[rp]].layout.len = 0;
                    w.drop_pane(rp, held);
                }
            }
        } else if (kind == KEY_OTHER_PANE) {
            w.focus_other();
        } else if (kind == KEY_NEXT_BUF) {
            w.next_buf();
        } else if (kind == KEY_WHEEL_UP) {
            act->scroll_vis(&m, (double)cctext_text_cols(act, cctext_pane_cols(&w, cols, w.focus), vis), -1) !>;
            skip_reveal = 1;
            continue;
        } else if (kind == KEY_WHEEL_DOWN) {
            act->scroll_vis(&m, (double)cctext_text_cols(act, cctext_pane_cols(&w, cols, w.focus), vis), 1) !>;
            skip_reveal = 1;
            continue;
        } else if (kind == KEY_MOUSE || kind == KEY_MOUSE_DRAG) {
            cctext_hit(&w, &m, cols, vis, kind == KEY_MOUSE_DRAG);
            act = w.active();
            if (act && act->drag_len) skip_reveal = 1;
        } else if (kind == KEY_SEL_ALL) {
            act->doc.select_all();
        } else if (kind == KEY_HOME) {
            if (rtx_layout_is_hex(&act->layout)) {
                size_t row = act->doc.caret / (size_t)RTX_HEX_COLS;
                size_t at = row * (size_t)RTX_HEX_COLS;
                if (!g_shift) act->doc.sel_anchor = at;
                act->doc.caret = at;
                act->hex_nib = 0;
                act->doc.sel_box = 0;
                act->doc.break_coalesce();
            } else if (act->layout.wrap && act->layout.len) {
                act->layout.move_row_edge(&act->doc, 0, g_shift);
            } else {
                act->doc.move_line_edge(0, g_shift) !>;
            }
            act->clear_pref();
        } else if (kind == KEY_END) {
            if (rtx_layout_is_hex(&act->layout)) {
                size_t n = act->len();
                size_t row = n ? act->doc.caret / (size_t)RTX_HEX_COLS : 0;
                size_t at = row * (size_t)RTX_HEX_COLS + (size_t)RTX_HEX_COLS - 1;
                if (n == 0) at = 0;
                else if (at >= n) at = n - 1;
                if (!g_shift) act->doc.sel_anchor = at;
                act->doc.caret = at;
                act->hex_nib = 0;
                act->doc.sel_box = 0;
                act->doc.break_coalesce();
                act->clear_pref();
            } else if (act->layout.wrap && act->layout.len) {
                act->layout.move_row_edge(&act->doc, 1, g_shift);
                act->stick_eol();
            } else {
                act->doc.move_line_edge(1, g_shift) !>;
                act->stick_eol();
            }
        } else if (kind == KEY_LEFT) {
            if (g_alt) {
                act->box_move_col(-1) !>;
            } else {
                act->move_horiz(-1, g_shift) !>;
            }
        } else if (kind == KEY_RIGHT) {
            if (g_alt) {
                act->box_move_col(1) !>;
            } else {
                act->move_horiz(1, g_shift) !>;
            }
        } else if (kind == KEY_UP || kind == KEY_DOWN) {
            if (rtx_layout_is_hex(&act->layout)) {
                size_t n = act->len();
                size_t at = act->doc.caret;
                if (kind == KEY_UP) {
                    if (at >= (size_t)RTX_HEX_COLS) at -= (size_t)RTX_HEX_COLS;
                    else at = 0;
                } else if (n) {
                    at += (size_t)RTX_HEX_COLS;
                    if (at >= n) at = n - 1;
                }
                if (!g_shift) act->doc.sel_anchor = at;
                act->doc.caret = at;
                act->hex_nib = 0;
                act->doc.sel_box = 0;
                act->doc.break_coalesce();
                act->clear_pref();
            } else {
                if (g_alt) act->box_begin() !>;
                act->layout.move_vert(&act->doc, &m,
                                      (double)cctext_text_cols(act, cctext_pane_cols(&w, cols, w.focus), vis),
                                      kind == KEY_UP ? -1 : 1, g_shift || g_alt,
                                      &act->pref) !>;
                if (g_alt) act->box_sync() !>;
            }
        } else if (kind == KEY_BACKSPACE) {
            act->backspace() !>;
            cctext_after_edit(&w, &m, cols, vis) !>;
        } else if (kind == KEY_DELETE) {
            act->delete_forward() !>;
            cctext_after_edit(&w, &m, cols, vis) !>;
        } else if (kind == KEY_ENTER) {
            if (!rtx_layout_is_hex(&act->layout)) {
                act->doc.type("\n") !>;
                cctext_after_edit(&w, &m, cols, vis) !>;
            }
        } else if (kind == KEY_CHAR) {
            act->type_cp((uint32_t)ch) !>;
            cctext_after_edit(&w, &m, cols, vis) !>;
        }
    }
    w.busy_bind(NULL, NULL);
    cctext_restore();
    return 0;
}
