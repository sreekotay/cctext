#!ccc ccs
/*
 * Fonts + help overlay (linked TU; see gui_chrome.cch).
 * Menus are native NSMenu (gui_plat.m).
 */
#include <ccc/std/prelude.cch>
#include "gui_plat.h"
#include "gui_chrome.cch"

const char *rtx_help_line(size_t i);

static const char *gui_mono_paths[] = {
    "/System/Library/Fonts/SFNSMono.ttf",
    "/System/Library/Fonts/Monaco.ttf",
    "/System/Library/Fonts/Supplemental/Andale Mono.ttf",
    "/System/Library/Fonts/Supplemental/Courier New.ttf",
    "/System/Library/Fonts/Menlo.ttc",
    NULL
};
static const char *gui_prose_paths[] = {
    "/System/Library/Fonts/Supplemental/Georgia.ttf",
    "/System/Library/Fonts/Supplemental/Arial.ttf",
    NULL
};

const char **gui_mono_font_paths(void) {
    return gui_mono_paths;
}

const char **gui_prose_font_paths(void) {
    return gui_prose_paths;
}

Font gui_load_font(const char **paths, int px, int *owned) {
    int cps[224];
    int i;
    *owned = 0;
    for (i = 0; i < 224; i++) cps[i] = 32 + i;
    for (i = 0; paths[i]; i++) {
        Font f;
        if (!FileExists(paths[i])) continue;
        f = LoadFontEx(paths[i], px, cps, 224);
        if (f.texture.id && f.glyphCount >= 90) {
            SetTextureFilter(f.texture, TEXTURE_FILTER_BILINEAR);
            *owned = 1;
            return f;
        }
        if (f.texture.id) UnloadFont(f);
    }
    return GetFontDefault();
}

void gui_layout_menus(void) { }

void gui_draw_help(GuiFonts *fonts, int ww, int hh) {
    int x = 40;
    int y = 48;
    int i;
    float title_sz = 22;
    float line_sz = 15;
    Vector2 pos;
    (void)hh;
    if (!fonts) return;
    DrawRectangle(0, 0, ww, hh, (Color){0, 0, 0, 180});
    DrawRectangle(24, 32, ww - 48, hh - 64, (Color){28, 30, 36, 250});
    pos.x = (float)x;
    pos.y = (float)y;
    DrawTextEx(fonts->mono, "key bindings", pos, title_sz, 0,
               (Color){255, 220, 100, 255});
    y += 36;
    for (i = 0; rtx_help_line((size_t)i); i++) {
        pos.x = (float)x;
        pos.y = (float)y;
        DrawTextEx(fonts->mono, rtx_help_line((size_t)i), pos, line_sz, 0,
                   (Color){220, 220, 230, 255});
        y += 20;
        if (y > hh - 48) break;
    }
}
