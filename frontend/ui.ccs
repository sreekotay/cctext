#!ccc ccs
/*
 * cctext-ui host loop. Paint is gui_draw.ccs; keys/mouse are
 * gui_input.ccs. The window is libui-ng; text is drawn in the area
 * callback (ui_plat.c) with no display list.
 * Frame: input → pump → layout → paint (DESIGN.md Interactive).
 */
#include <ccc/std/prelude.cch>
#include <stdarg.h>
#include <stdint.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include "gui_plat.h"
#include "ui_hook.h"
#include "../core/document.cch"
#include "../core/layout.cch"
#include "../core/workspace.cch"
#include "../core/find.cch"
#include "../core/ui.cch"
#include "../core/ui_proj.cch"
#include "../core/browse.cch"
#include "gui.cch"

int g_dirty = 1;
int g_need_layout = 1;
/* Window size the last gui_relayout ran at. A live resize (AppKit's own
 * loop, ours paused until the mouse is up) only reaches ui_frame. */
static int g_lay_ww = -1, g_lay_hh = -1;
static Vector2 g_mouse_was;
static long g_isle_paint_at;
static long g_browse_paint_at;
static int g_browse_busy_was;
static int g_prev_busy_was;
static unsigned g_prev_ready_was;
static int g_isle_was;
static int g_find_was;
static unsigned g_safe_fault_was;

static int gui_isle_yield(void) {
    int k;
    if (IsMouseButtonDown(MOUSE_BUTTON_LEFT) ||
        IsMouseButtonDown(MOUSE_BUTTON_RIGHT))
        return 1;
    for (k = 32; k <= 348; k++) {
        if (IsKeyDown(k)) return 1;
    }
    return 0;
}
GuiLive g_live;
static int g_busy_frame;
char g_busy_msg[64];
int g_busy_show;

static void gui_blink_show(RtxUi *ui) {
    rtx_ui_blink_show(ui);
    g_dirty = 1;
}

/* RTX_UI_LOG: paint kinds for the blink test (tests/ui_blink_test.py). */
static void gui_trace(const char *fmt, ...) {
    const char *tp = getenv("RTX_UI_LOG");
    FILE *fp;
    va_list ap;
    if (!tp || !tp[0]) return;
    fp = fopen(tp, "a");
    if (!fp) return;
    fprintf(fp, "%ld ", rtx_ui_now_ms());
    va_start(ap, fmt);
    vfprintf(fp, fmt, ap);
    va_end(ap);
    fputc('\n', fp);
    fclose(fp);
}

/* Everything a caret blink rect depends on, as of the last whole-area
 * paint. A blink turn repaints just the noted rects only while this still
 * matches; otherwise the caret may have moved and the window paints. */
static uint64_t g_paint_sig;

static uint64_t gui_sig_mix(uint64_t h, uint64_t v) {
    return (h ^ v) * 1099511628211ull;
}

static uint64_t gui_caret_sig(void) {
    uint64_t h = 1469598103934665603ull;
    RtxWs *w = g_live.w;
    RtxUi *ui = g_live.ui;
    int k;
    if (!w || !ui) return 0;
    h = gui_sig_mix(h, (uint64_t)GetScreenWidth());
    h = gui_sig_mix(h, (uint64_t)GetScreenHeight());
    h = gui_sig_mix(h, (uint64_t)w->npanes);
    h = gui_sig_mix(h, (uint64_t)w->focus);
    h = gui_sig_mix(h, (uint64_t)w->len);
    h = gui_sig_mix(h, (uint64_t)gui_tabs_shown(w));
    for (k = 0; k < w->npanes; k++) {
        int p = w->order[k];
        RtxBuf *b = w->bufs[w->pane[p]];
        RtxBrowse *br = &w->nav[p];
        h = gui_sig_mix(h, (uint64_t)g_gg[p].x0);
        h = gui_sig_mix(h, (uint64_t)g_gg[p].y0);
        h = gui_sig_mix(h, (uint64_t)g_gg[p].w);
        h = gui_sig_mix(h, (uint64_t)g_gg[p].h);
        h = gui_sig_mix(h, (uint64_t)w->pane[p]);
        h = gui_sig_mix(h, (uint64_t)br->on);
        if (br->on) {
            h = gui_sig_mix(h, (uint64_t)br->glob_len);
            h = gui_sig_mix(h, (uint64_t)br->glob_caret);
            h = gui_sig_mix(h, (uint64_t)rtx_browse_view_cur(br));
        }
        if (!b) continue;
        h = gui_sig_mix(h, (uint64_t)(uintptr_t)b);
        h = gui_sig_mix(h, (uint64_t)b->doc.caret);
        h = gui_sig_mix(h, (uint64_t)b->doc.sel_anchor);
        h = gui_sig_mix(h, (uint64_t)b->doc.edit_gen);
        h = gui_sig_mix(h, (uint64_t)b->top);
        h = gui_sig_mix(h, (uint64_t)b->top_wrap);
        h = gui_sig_mix(h, (uint64_t)b->left_col);
        h = gui_sig_mix(h, (uint64_t)b->top_byte);
        h = gui_sig_mix(h, (uint64_t)b->seek_off);
        h = gui_sig_mix(h, (uint64_t)b->seek_valid);
        h = gui_sig_mix(h, (uint64_t)b->hex_nib);
        h = gui_sig_mix(h, (uint64_t)b->layout.rows.len);
        h = gui_sig_mix(h, (uint64_t)b->layout.view);
        h = gui_sig_mix(h, (uint64_t)b->layout.wrap);
        h = gui_sig_mix(h, (uint64_t)b->layout.rich);
    }
    h = gui_sig_mix(h, (uint64_t)ui->help);
    h = gui_sig_mix(h, (uint64_t)ui->apply);
    h = gui_sig_mix(h, (uint64_t)ui->stats);
    h = gui_sig_mix(h, (uint64_t)ui->jump);
    h = gui_sig_mix(h, (uint64_t)ui->jump_len);
    h = gui_sig_mix(h, (uint64_t)ui->find);
    h = gui_sig_mix(h, (uint64_t)ui->find_len);
    h = gui_sig_mix(h, (uint64_t)ui->find_caret);
    h = gui_sig_mix(h, (uint64_t)ui->find_sel);
    h = gui_sig_mix(h, (uint64_t)ui->find_top);
    h = gui_sig_mix(h, (uint64_t)ui->ask_quit);
    h = gui_sig_mix(h, (uint64_t)ui->ask_conflict);
    h = gui_sig_mix(h, (uint64_t)ui->ask_xact);
    h = gui_sig_mix(h, (uint64_t)ui->ask_close);
    return h ? h : 1;
}

static void on_turn(int enter) {
    /* Layout + paint, and every Draw the toolkit runs (ui_plat brackets
     * the area callback). The idle wait is not a turn: scans run there. */
    rtx_ws_scans_set(g_live.w, enter);
}

/* Work still being published. A dest-live handle stays live() until it
 * is joined, and nobody joins a finished island or find, so live() alone
 * ticked (and spun) for the rest of the session. */
static int gui_isle_busy(RtxBuf *b) {
    return b && b->doc.tree.isle_h.live() && rtx_line_isle_pumping(&b->doc.tree);
}

static int gui_find_busy(RtxBuf *b) {
    return b && b->doc.find.h.live() && !b->doc.find.done;
}

static long g_find_since; /* ms the running scan was first seen */

/* Idle is event-driven: sleep until input, the next caret blink, a Safe
 * debounce, or the next overlay tick of a scan that still publishes. With
 * none of those due (blink stopped: idle, unfocused, --no-blink) the host
 * sleeps until the toolkit has an event: -1. */
static double gui_wait_s(RtxWs *w, RtxBuf *act, RtxUi *ui, int dragging) {
    long now = rtx_ui_now_ms();
    long ms = rtx_ui_blink_next_ms(ui, now);
    long safe_ms = RtxWs_safe_next_ms(w, now);
    if (safe_ms >= 0 && (ms < 0 || safe_ms < ms)) ms = safe_ms;
    {
        long pick_ms = rtx_ui_pick_next_ms(ui, now);
        if (pick_ms >= 0 && (ms < 0 || pick_ms < ms)) ms = pick_ms;
    }
    {
        /* A slide transition runs at the frame clock; a still slide
         * waits for input like any idle window. */
        long pr_ms = rtx_present_wait_ms(rtx_present(), now);
        if (pr_ms >= 0 && (ms < 0 || pr_ms < ms)) ms = pr_ms;
    }
    if ((RtxWs_browse_prev_busy(w) || g_prev_busy_was) &&
        (ms < 0 || ms > 16))
        ms = 16;
    /* A held drag scrolls at the edge with the pointer still. */
    if (dragging && (ms < 0 || ms > RTX_UI_BLINK_MS)) ms = RTX_UI_BLINK_MS;
    if (ms < 0) ms = 1L << 30;
    if (RtxWs_browse_busy(w) || g_browse_busy_was) {
        if (ms > 16) ms = 16;
    }
    if (gui_isle_busy(act)) {
        long left = (long)RTX_LINE_ISLE_PAINT_MS - (now - g_isle_paint_at);
        if (ms > left) ms = left;
    }
    if (gui_find_busy(act) || RtxWs_browse_busy(w)) {
        long tick = RtxWs_browse_scanning(w) ? (long)RTX_BROWSE_PAINT_MS
                                             : (long)RTX_LINE_ISLE_PAINT_MS;
        long left = tick - (now - g_browse_paint_at);
        if (ms > left) ms = left;
    }
    if (ui && ui->stats && ms > (long)RTX_LINE_ISLE_PAINT_MS)
        ms = (long)RTX_LINE_ISLE_PAINT_MS;
    /* A young find (most finish in a few ms): look again soon so the
     * finished list paints now, not at the next overlay tick. */
    if (gui_find_busy(act) && g_find_since) {
        long age = now - g_find_since;
        if (age < 8) return 0.00025;
        if (age < 250 && ms > 2) ms = 2;
    }
    if (ms >= (1L << 30)) return -1.0;
    if (ms < 1) ms = 1;
    return (double)ms / 1000.0;
}

static int gui_keys_down(void) {
    int k;
    for (k = 32; k <= 348; k++) {
        if (IsKeyPressed(k) || IsKeyPressedRepeat(k)) return 1;
    }
    return 0;
}

static int gui_saw_input(int dragging) {
    Vector2 m = GetMousePosition();
    int moved = ((int)m.x != (int)g_mouse_was.x) || ((int)m.y != (int)g_mouse_was.y);
    g_mouse_was = m;
    if (IsWindowResized()) return 1;
    {
        Vector2 wh = GetMouseWheelMoveV();
        if (wh.x != 0.0f || wh.y != 0.0f) return 1;
    }
    if (IsMouseButtonPressed(MOUSE_BUTTON_LEFT) ||
        IsMouseButtonReleased(MOUSE_BUTTON_LEFT)) return 1;
    if (dragging) return 1;
    if (gui_menu_pending()) return 1;
    if (ui_chars_waiting()) return 1;
    return gui_keys_down();
}

static void gui_busy(void *ctx, const char *label, int pct) {
    const char *spin = "|/-\\";
    (void)ctx;
    if (!label) {
        g_busy_show = 0;
        g_busy_msg[0] = 0;
        return;
    }
    if (pct >= 0) {
        snprintf(g_busy_msg, sizeof(g_busy_msg), "%c %s %d%%",
                 spin[g_busy_frame++ & 3], label, pct);
    } else {
        snprintf(g_busy_msg, sizeof(g_busy_msg), "%c %s",
                 spin[g_busy_frame++ & 3], label);
    }
    g_busy_show = 1;
    /* Overlay only. A spinner-only Begin/EndDrawing swaps a torn frame. */
    if (g_live.draw_open && IsWindowReady()) gui_draw_busy_badge();
}

static void gui_geom(int *ww, int *hh, int *inner, int *pane_w, int *vis_rows,
                     int pad, int top, int find_on) {
    *ww = GetScreenWidth();
    *hh = GetScreenHeight();
    /* Left pad only — V-rail sits on the window edge, not inside a right gutter. */
    *inner = *ww - pad;
    if (*inner < 40) *inner = 40;
    *pane_w = (g_live.w && g_live.w->npanes >= 2) ? (*inner / 2) : *inner;
    *vis_rows = (*hh - top - 28 - (find_on ? GUI_FIND_H : 0)) / GUI_ROW_H;
    if (*vis_rows < 4) *vis_rows = 4;
}

/* Body slots above the H-rail. A sticky grid header is not a vis row —
 * TUI subtracts it in paint; reveal / ensure_view must use the same count
 * or the last body row is “visible” while clipped and up/down slip. */
static int gui_body_vis(RtxBuf *b, int vis_rows, int ph) {
    int hx, fit, inner, hdr;
    if (!b) return vis_rows < 1 ? 1 : vis_rows;
    if (vis_rows < 1) vis_rows = 1;
    hx = gui_scroll_x_h(b);
    hdr = 0;
    if (rtx_layout_is_grid(&b->layout) && b->layout.grid_hdr_on)
        hdr = GUI_ROW_H;
    inner = ph > hx ? ph - hx : ph;
    if (inner > hdr) inner -= hdr;
    fit = inner / GUI_ROW_H;
    if (fit < 1) fit = 1;
    return fit < vis_rows ? fit : vis_rows;
}

/* Lay the pane tree out in the window; pane_w / vis_rows become the
 * focused pane's. */
static void gui_focus_geom(int ww, int hh, int *pane_w, int *vis_rows) {
    RtxWs *w = g_live.w;
    RtxBuf *act;
    if (!w) return;
    gui_geo(w, ww, hh, g_live.pad, g_live.top, g_live.ui && g_live.ui->find);
    if (!RtxWs_pane_live(w, w->focus)) return;
    *pane_w = g_gg[w->focus].w;
    *vis_rows = g_gg[w->focus].vis;
    act = RtxWs_active(w);
    if (act) *vis_rows = gui_body_vis(act, *vis_rows, g_gg[w->focus].h);
}

static int gui_view_stale(const RtxBuf *b) {
    if (!b || b->layout.rows.len == 0) return 1;
    if (b->seek_valid && !rtx_buf_seek_cam_row(b))
        return 1;
    return 0;
}

/* Every pane at its own rect (gui_geo); the focused one with the rows the
 * host settled on (a grid header is not a vis row). */
static void !>(CCError) gui_relayout(int pane_w, int vis_rows) {
    int k;
    RtxWs *w = g_live.w;
    if (!g_live.w || !g_live.m || !g_live.fonts) {
        return cc_err(CC_ERR_INVALID_ARG, "live layout");
    }
    (void)pane_w;
    g_lay_ww = GetScreenWidth();
    g_lay_hh = GetScreenHeight();
    for (k = 0; k < w->npanes; k++) {
        int p = w->order[k];
        RtxBuf *b = w->bufs[w->pane[p]];
        int held = RtxWs_hold_pane(w, p);
        int pw = g_gg[p].w;
        int pv = p == w->focus ? vis_rows : gui_body_vis(b, g_gg[p].vis, g_gg[p].h);
        {
            size_t nlines = b->line_count();
            if (!rtx_layout_is_hex(&b->layout) && !b->seek_valid &&
                b->top >= nlines && nlines)
                b->top = nlines - 1;
        }
        RtxWs_pane_geom(w, p, gui_text_w(g_live.fonts, b, pw, pv), pv);
        b->ensure_view(g_live.m, gui_text_w(g_live.fonts, b, pw, pv), pv) !>(e) {
            RtxWs_drop_pane(w, p, held);
            return cc_err(e);
        };
        RtxWs_drop_pane(w, p, held);
    }
    RtxWs_hl_trim(w);
    return cc_ok();
}

/* Paint + swap without PollInputEvents (unsafe to nest inside a resize).
 * Only safe when no BeginDrawing is open — EndDrawing has already swapped
 * before it polls, so resize notifications land in that window. */
static void gui_live_paint(void) {
    int ww, hh, inner, pane_w, vis_rows;
    if (!g_live.ready || g_live.painting || g_live.draw_open) return;
    g_live.painting = 1;
    @errhandler(CCError e) {
        (void)e;
        g_live.painting = 0;
        g_live.draw_open = 0;
        return;
    }
    gui_geom(&ww, &hh, &inner, &pane_w, &vis_rows, g_live.pad, g_live.top,
             g_live.ui && g_live.ui->find);
    gui_focus_geom(ww, hh, &pane_w, &vis_rows);
    gui_relayout(pane_w, vis_rows) !>;
    g_need_layout = 0;
    g_dirty = 1;
    BeginDrawing();
    g_live.draw_open = 1;
    gui_draw_body(ww, hh, g_live.pad, g_live.top, pane_w, inner, vis_rows);
    g_live.draw_open = 0;
    g_live.painting = 0;
}

/* Paint runs inside the area Draw callback (context is current). A
 * partial Draw (a caret blink, a toolkit expose) paints only its clip. A
 * whole Draw records the caret signature its blink rects belong to. */
static void ui_frame(void) {
    int ww, hh, inner, pane_w, vis_rows;
    int full = gui_clip_full();
    if (!g_live.ready || g_live.painting) {
        if (full) gui_blink_forget();
        return;
    }
    g_live.painting = 1;
    @errhandler(CCError e) {
        (void)e;
        gui_blink_forget();
        g_live.painting = 0;
        g_live.draw_open = 0;
        return;
    }
    gui_geom(&ww, &hh, &inner, &pane_w, &vis_rows, g_live.pad, g_live.top,
             g_live.ui && g_live.ui->find);
    gui_focus_geom(ww, hh, &pane_w, &vis_rows);
    if (g_need_layout || ww != g_lay_ww || hh != g_lay_hh) {
        /* Not on a blink (the host lays out first). A toolkit expose of
         * part of the window: the rest predates this layout. */
        if (!full) g_dirty = 1;
        gui_trace(full ? "relayout draw" : "relayout expose");
        gui_relayout(pane_w, vis_rows) !>;
    }
    g_need_layout = 0;
    g_live.draw_open = 1;
    gui_draw_body(ww, hh, g_live.pad, g_live.top, pane_w, inner, vis_rows);
    g_live.draw_open = 0;
    g_live.painting = 0;
    if (full) g_paint_sig = gui_caret_sig();
}

static void gui_install_live_resize(void) {
    fb_set_live_resize(gui_live_paint);
    ui_set_paint(ui_frame);
}

static void gui_uninstall_live_resize(void) {
    fb_set_live_resize(NULL);
    g_live.resize_observer = NULL;
    g_live.resize_center = NULL;
}

int main(int argc, char **argv) {
    @errhandler(CCError e) { cc_error_log(e); return 1; }
    RtxWs w = {0} @destroy;
    RtxMeasure m;
    GuiFonts fonts;
    char *filebuf[32];
    RtxCli cli;
    const char *prog;
    int ww = 960;
    int hh = 640;
    int pad = 16;
    int top = 8;
    int dragging = 0;
    int scroll_grab = 0;
    size_t quit_armed_at = (size_t)-1;
    int close_held = 0;
    char status[160];
    char cfg_msg[256];
    RtxUi ui;

    cfg_msg[0] = 0;
    prog = (argc > 0 && argv[0] && argv[0][0]) ? argv[0] : "cctext-ui";
    rtx_host_set_exe(prog);
    if (rtx_cli_parse(argc, argv, filebuf, 32, &cli) != 0) {
        rtx_cli_usage(stderr, prog);
        return 2;
    }
    if (cli.help) {
        rtx_cli_usage(stdout, prog);
        return 0;
    }
    if (cli.version) {
        rtx_cli_print_version(stdout, prog);
        return 0;
    }
    /* keys.json / settings.json: problems show on the status bar. */
    rtx_cli_setup_keys(&cli, RTX_HOST_GUI, cfg_msg, sizeof cfg_msg);
    rtx_doc_set_save_backup(cli.backup);
    rtx_edit_set_autopair(!cli.no_autopair);
    rtx_edit_set_tab_spaces(cli.tab_spaces);
    gui_tabs_set(rtx_cli_tabs(&cli));
    if (cli.batch) {
        fprintf(stderr, "cctext-ui: --batch is console-only (use cctext)\n");
        return 2;
    }
    /* --project: the session snapshot and the quick-open index share it. */
    if (cli.project) rtx_safe_ws_set_project(cli.project);
    if (cli.nfiles == 0) {
        w.open_files(0, NULL) !>;
    } else {
        w.open_files(cli.nfiles, filebuf) !>;
    }
    rtx_cli_apply_views(&w, &cli);
    status[0] = 0;
    if (cfg_msg[0]) snprintf(status, sizeof status, "%s", cfg_msg);
    ui = (RtxUi){0};
    ui.no_blink = cli.no_blink;
    ui.blink_idle_ms = rtx_ui_blink_idle_env();
    rtx_ui_proj_hint(&ui, cli.project, cli.nfiles ? filebuf[0] : ".");
    if (w.start_dir[0] || cli.nfiles == 0 || w.untitled()) w.browse_start() !>;

    SetTraceLogLevel(LOG_NONE);
    SetConfigFlags(FLAG_WINDOW_RESIZABLE);
    InitWindow(ww, hh, "cctext");
    SetExitKey(0);
    SetTargetFPS(60);
    gui_install_live_resize();
    /* The carets live on the toolkit's caret layer (a blink repaints no
     * text) unless --caret=cell or the toolkit has none. */
    gui_caret_setup(!cli.caret_cell, cli.caret_fade);
    ui.caret_host = gui_caret_layer();

    {
        Vector2 dpi = GetWindowScaleDPI();
        (void)dpi;
        /* CT sizes are in points; do not multiply by backing scale. */
        fonts.mono_sz = 16;
        fonts.prose_sz = 17;
        fonts.mono = gui_load_font(gui_mono_font_paths(), (int)fonts.mono_sz,
                                   &fonts.owned_mono);
        fonts.prose = gui_load_font(gui_prose_font_paths(), (int)fonts.prose_sz,
                                    &fonts.owned_prose);
        fonts.mono_bold = gui_derive_font(fonts.mono, 1, 0);
        fonts.prose_bold = gui_derive_font(fonts.prose, 1, 0);
        fonts.owned_mono_bold = (fonts.mono_bold.ct != fonts.mono.ct);
        fonts.owned_prose_bold = (fonts.prose_bold.ct != fonts.prose.ct);
        /* Italic faces via the libui font descriptor; gui_derive_font returns the base
         * face when the family has no italic, so these fall back to regular
         * (and bold-italic to bold) without extra checks. */
        fonts.mono_italic = gui_derive_font(fonts.mono, 0, 1);
        fonts.prose_italic = gui_derive_font(fonts.prose, 0, 1);
        fonts.owned_mono_italic = (fonts.mono_italic.ct != fonts.mono.ct);
        fonts.owned_prose_italic = (fonts.prose_italic.ct != fonts.prose.ct);
        fonts.mono_bold_italic = gui_derive_font(fonts.mono_bold, 1, 1);
        fonts.prose_bold_italic = gui_derive_font(fonts.prose_bold, 1, 1);
        fonts.owned_mono_bold_italic =
            (fonts.mono_bold_italic.ct != fonts.mono_bold.ct);
        fonts.owned_prose_bold_italic =
            (fonts.prose_bold_italic.ct != fonts.prose_bold.ct);
    }
    w.busy_bind(gui_busy, NULL);
    gui_layout_menus();

    m.measure = gui_measure;
    m.line_height = gui_lh;
    m.ctx = &fonts;

    g_live.w = &w;
    g_live.m = &m;
    g_live.fonts = &fonts;
    g_live.ui = &ui;
    g_live.status = status;
    g_live.pad = pad;
    g_live.top = top;
    g_live.dragging = &dragging;
    g_live.scroll_grab = &scroll_grab;
    g_live.ready = 1;
    ui_set_turn(on_turn);

    for (;;) {
        ui_frame_mark(0);
        gui_input_begin_frame();
        /*
         * Host close is a one-shot offer into ask_quit. Cancel dismisses the
         * prompt; further quit is menu / Ctrl-Q, or save-then-exit.
         */
        if (WindowShouldClose()) {
            w.safe_flush_all();
            if (!w.any_dirty()) break;
            if (!ui.ask_quit && !close_held) rtx_ui_offer_quit(&w, &ui);
            close_held = 1;
            g_dirty = 1;
        } else {
            close_held = 0;
        }
        int p;
        int inner;
        int pane_w;
        int vis_rows;
        int saw;
        int blink_flip;
        int relaid = 0;
        RtxBuf *act;
        saw = gui_saw_input(dragging);
        if (saw) gui_blink_show(&ui);
        {
            /* Unfocused: solid caret, no blink timer. Back: blink again. */
            int edge = gui_focus_edge();
            if (edge >= 0) {
                gui_trace("focus %d", edge);
                if (rtx_ui_blink_focus(&ui, edge)) {
                    if (ui.caret_host) gui_caret_phase(rtx_ui_blink(&ui));
                    else g_dirty = 1;
                }
            }
        }
        gui_geom(&ww, &hh, &inner, &pane_w, &vis_rows, pad, top, ui.find);
        gui_focus_geom(ww, hh, &pane_w, &vis_rows);
        act = w.active();
        {
            /* Replace-all: progress each turn; its edit group lands in
             * gui_handle_input once the scan is in. */
            int rbusy = rtx_ui_repl_busy(&ui);
            if (gui_handle_input(&w, act, &m, &fonts, &ui, status, sizeof(status),
                                 &quit_armed_at, &dragging, &scroll_grab,
                                 pane_w, vis_rows, pad, top, inner, hh)) {
                break;
            }
            if (rbusy) {
                g_dirty = 1;
                g_need_layout = 1;
            }
        }
        {
            const char *tp = getenv("RTX_UI_LOG");
            if (tp && tp[0]) {
                static int pd = -1, pf = -1, pb = -1, pa = -1, ph = -1, pg = -1;
                RtxBuf *tr = w.active();
                int dirty = w.any_dirty();
                int find_on = ui.find;
                int br = w.browsing();
                int ask = ui.ask_quit;
                int hits = (tr && find_on) ? (int)rtx_find_hits_n(&tr->doc.find) : 0;
                int g0 = 0;
                if (br) {
                    RtxBrowse *b = RtxWs_browse(&w);
                    g0 = b && b->glob[0] ? (unsigned char)b->glob[0] : 0;
                }
                if (dirty != pd || find_on != pf || br != pb || ask != pa ||
                    hits != ph || g0 != pg) {
                    FILE *fp = fopen(tp, "a");
                    pd = dirty;
                    pf = find_on;
                    pb = br;
                    pa = ask;
                    ph = hits;
                    pg = g0;
                    if (fp) {
                        fprintf(fp,
                                "dirty=%d find=%d hits=%d browse=%d ask=%d\n",
                                dirty, find_on, hits, br, ask);
                        if (br) {
                            RtxBrowse *b = RtxWs_browse(&w);
                            fprintf(fp, "glob=%s\n",
                                    b && b->glob[0] ? b->glob : "-");
                        }
                        fclose(fp);
                    }
                }
                {
                    /* Buffers and panes (tests read this line). */
                    static int pn = -1, pl = -1, pfo = -1, pask = -1;
                    if (w.npanes != pn || (int)w.len != pl || w.focus != pfo ||
                        ui.ask_close != pask) {
                        FILE *fp = fopen(tp, "a");
                        pn = w.npanes;
                        pl = (int)w.len;
                        pfo = w.focus;
                        pask = ui.ask_close;
                        if (fp) {
                            fprintf(fp, "panes=%d bufs=%d focus=%d ask_close=%d\n",
                                    pn, pl, pfo, pask);
                            fclose(fp);
                        }
                    }
                }
                {
                    /* Project picker: mode, rows, and the active file. */
                    static int pp = -1;
                    static size_t pr = (size_t)-1;
                    static char pa_path[512];
                    const char *ap = (tr && tr->doc.path.ptr) ? tr->doc.path.ptr : "-";
                    size_t rows = rtx_ui_pick_nrows(&ui);
                    if (ui.pick != pp || rows != pr || strcmp(ap, pa_path) != 0) {
                        FILE *fp = fopen(tp, "a");
                        pp = ui.pick;
                        pr = rows;
                        snprintf(pa_path, sizeof pa_path, "%s", ap);
                        if (fp) {
                            fprintf(fp, "pick=%d rows=%zu active=%s caret=%zu\n", ui.pick,
                                    rows, ap, tr ? tr->doc.caret : 0);
                            fclose(fp);
                        }
                    }
                }
            }
        }
        /* Before EndDrawing: that call clears edges then pumps the next
         * mouse-up. Consuming after paint ate the release and stuck drag. */
        gui_input_consume();
        act = w.active();
        if (act) {
            size_t caret0 = act->doc.caret;
            int vis_fit = vis_rows;
            @errhandler(RtxIndexErr e) {
                snprintf(status, sizeof(status), "%s",
                         e.message ? e.message : "scan");
            }
            rtx_ui_work_pump(&ui, act, vis_rows, gui_isle_yield) !>;
            if (act->doc.caret != caret0) {
                if (ui.find && act->doc.find.pinned) gui_land(act, vis_rows);
                else if (!ui.find && !act->unlock) act->pin_view = 0;
                g_need_layout = 1;
            }
            gui_focus_geom(ww, hh, &pane_w, &vis_fit);
            if (vis_fit != vis_rows) {
                vis_rows = vis_fit;
                g_need_layout = 1;
            }
        }
        RtxWs_browse_pump(&w) !>;
        {
            /* Project walk / search: join, fold new files in, debounce. */
            int pick_new = rtx_ui_pick_pump(&ui) !>(e) {
                snprintf(status, sizeof(status), "%s", e.message ? e.message : "project");
                @ok(1);
            };
            if (pick_new && ui.pick) g_dirty = 1;
            if (ui.si_note) {
                ui.si_note = 0;
                snprintf(status, sizeof(status), "%s", ui.pick_msg);
                g_dirty = 1;
            }
        }
        w.safe_pump();
        {
            /* Nothing else repaints an idle window (no blink timer). */
            unsigned fault = rtx_ws_safe_fault_sig(&w);
            if (fault != g_safe_fault_was) g_dirty = 1;
            g_safe_fault_was = fault;
        }

        {
            int isle_on = gui_isle_busy(act);
            long now = rtx_ui_now_ms();
            if (g_isle_was && !isle_on) {
                g_dirty = 1;
                g_need_layout = 1;
            } else if (isle_on &&
                       (g_isle_paint_at == 0 ||
                        now - g_isle_paint_at >= (long)RTX_LINE_ISLE_PAINT_MS)) {
                g_dirty = 1;
                g_need_layout = 1;
                g_isle_paint_at = now;
            }
            g_isle_was = isle_on;
        }

        if (saw) g_dirty = 1;
        blink_flip = rtx_ui_blink_step(&ui);
        if (rtx_present()->on) {
            /* No caret on a slide. A transition paints every turn; the
             * turn its time is up paints the still slide. */
            blink_flip = 0;
            if (rtx_present()->tr) {
                rtx_present_tick(rtx_present(), rtx_ui_now_ms());
                g_dirty = 1;
            }
        }
        {
            /* Kick is in paint; adopt may land on pump. Paint when either
             * the busy edge drops or ready_seq advances. */
            int prev_tick = RtxWs_browse_prev_busy(&w);
            unsigned ready = RtxWs_browse_prev_ready_seq(&w);
            if (g_prev_busy_was && !prev_tick) g_dirty = 1;
            if (ready != g_prev_ready_was) g_dirty = 1;
            g_prev_busy_was = prev_tick;
            g_prev_ready_was = ready;
        }
        {
            int browse_tick = RtxWs_browse_busy(&w);
            if (g_browse_busy_was && !browse_tick) g_dirty = 1;
            g_browse_busy_was = browse_tick;
        }
        if (RtxWs_browse_busy(&w) || gui_find_busy(act)) {
            long now = rtx_ui_now_ms();
            long ms = RtxWs_browse_scanning(&w) ? (long)RTX_BROWSE_PAINT_MS
                                                : (long)RTX_LINE_ISLE_PAINT_MS;
            if (g_browse_paint_at == 0 || now - g_browse_paint_at >= ms)
                g_dirty = 1;
        }
        {
            /* `done` is the arm's last write; the handle may stay live
             * until joined. Paint the finished list on that edge. */
            int find_on = gui_find_busy(act);
            if (find_on && !g_find_was) g_find_since = rtx_ui_now_ms();
            if (!find_on) g_find_since = 0;
            if (g_find_was && !find_on) g_dirty = 1;
            g_find_was = find_on;
        }
        if (g_busy_show && !(act && rtx_ui_work_pumping(&ui, &act->doc)))
            g_dirty = 1;
        if (ui.stats) g_dirty = 1;

        /* Layout and paint are one turn (scans paused). A Draw the
         * toolkit runs later, inside the wait, brackets itself. */
        ui_turn(1);
        if (saw || g_need_layout || (act && gui_view_stale(act))) {
            for (p = 0; p < w.npanes; p++) {
                RtxBuf *b = w.bufs[w.pane[w.order[p]]];
                int held = w.hold_pane(w.order[p]);
                size_t nlines = b->line_count();
                if (!rtx_line_want_pumping(&b->doc.tree) &&
                    !b->seek_valid && b->top >= nlines && nlines)
                    b->top = nlines - 1;
                w.drop_pane(w.order[p], held);
            }
            gui_relayout(pane_w, vis_rows) !>;
            g_need_layout = 0;
            relaid = 1;
            gui_trace("relayout turn");
        }
        ui_frame_mark(1);

        /* Caret layer: a blink is the layer's phase — no Draw, no text.
         * Painted caret (fallback): a blink alone repaints the caret rects
         * the last whole paint noted — no layout, no other rows. Anything
         * else this turn, or a caret that moved since that paint, paints
         * the window. */
        if (!g_dirty && blink_flip) {
            if (ui.caret_host) {
                gui_caret_phase(rtx_ui_blink(&ui));
                gui_trace("paint blink layer %d", rtx_ui_blink(&ui));
            } else if (relaid || gui_caret_sig() != g_paint_sig ||
                       !gui_blink_paint()) {
                g_dirty = 1;
            } else {
                gui_trace("paint blink %d rects", gui_blink_rects());
            }
        }
        if (g_dirty) {
            gui_trace("paint full");
            ui_sync_paint();
            if (RtxWs_browse_busy(&w) || gui_find_busy(act) || gui_isle_busy(act))
                g_browse_paint_at = rtx_ui_now_ms();
            g_dirty = 0;
        }
        ui_frame_mark(2);
        ui_frame_end(saw);
        /* Kick lives in paint (browse_prev_sync). Sample busy/ready after so
         * the next turn sees an in-flight open and an adopt already drawn. */
        if (RtxWs_browse_prev_busy(&w)) g_prev_busy_was = 1;
        g_prev_ready_was = RtxWs_browse_prev_ready_seq(&w);
        /* Input shows the caret (blink restarts on): the layer follows. */
        if (ui.caret_host) gui_caret_phase(rtx_ui_blink(&ui));
        ui_turn(0);

        /* A host-stepped walk (g L) owns the frame clock; everything else
         * waits for an event or the next deadline. */
        if (act && rtx_ui_work_pumping(&ui, &act->doc))
            PollInputEvents();
        else
            WaitTime(gui_wait_s(&w, act, &ui, dragging));
    }

    g_live.ready = 0;
    rtx_ui_proj_close(&ui);
    w.busy_bind(NULL, NULL);
    gui_uninstall_live_resize();
    if (fonts.owned_mono) UnloadFont(fonts.mono);
    if (fonts.owned_prose) UnloadFont(fonts.prose);
    if (fonts.owned_mono_bold) UnloadFont(fonts.mono_bold);
    if (fonts.owned_prose_bold) UnloadFont(fonts.prose_bold);
    if (fonts.owned_mono_italic) UnloadFont(fonts.mono_italic);
    if (fonts.owned_prose_italic) UnloadFont(fonts.prose_italic);
    if (fonts.owned_mono_bold_italic) UnloadFont(fonts.mono_bold_italic);
    if (fonts.owned_prose_bold_italic) UnloadFont(fonts.prose_bold_italic);
    CloseWindow();
    if (cli.stats_json) rtx_ui_write_stats_json(stdout, w.active());
    if (rtx_ws_close_heavy(&w)) _exit(0);
    return 0;
}
