#!ccc ccs
/*
 * TUI grid pane paint (linked TU). Same cut as hex / browse / grid geometry.
 */
#include <ccc/std/prelude.cch>
#include <stdio.h>
#include <string.h>
#include "../core/utf8.cch"
#include "../core/document.cch"
#include "../core/nav_pair.cch"
#include "../core/layout.cch"
#include "../core/workspace.cch"
#include "../core/find.cch"
#include "../core/ui.cch"
#include "../core/browse.cch"
#include "cctext.cch"

void cctext_draw_grid_pane(RtxBuf *b, const RtxUi *ui, int focused, int vis,
                           int pcols, int col0, int pad_rest) {
    size_t r;
    int has = b->doc.has_sel();
    int g = rtx_gutter_cols_buf(b, vis);
    int tcols = cctext_text_cols(b, pcols, vis);
    @errhandler(CCError e) {
        (void)e;
        return;
    }
    @errhandler(RtxIndexErr e) {
        (void)e;
        return;
    }
    {
        int body = cctext_body_vis(b, vis, pcols);
        int hdr = b->layout.grid_hdr_on;
    for (r = 0; r < (size_t)body; r++) {
        size_t idx;
        int used = 0;
        int is_hdr = hdr && r == 0;
        fprintf(stdout, "\x1b[%zu;%dH", r + 1, col0);
        if (is_hdr) {
            idx = 0;
        } else {
            idx = r - (size_t)hdr + b->top_wrap;
        }
        if (!is_hdr && idx >= b->layout.len) {
            fputs("\x1b[90m", stdout);
            {
                int i;
                for (i = 0; i < g - 1; i++) fputc(' ', stdout);
            }
            fputs("~\x1b[0m", stdout);
            used = g;
            cctext_row_end(b, focused, vis, pcols, col0, pad_rest, used, (int)r);
            continue;
        }
        {
            RtxVisRow head;
            RtxVisRow *row;
            size_t col = 0;
            size_t virt = 0;
            size_t c;
            int show_ln;
            if (is_hdr) {
                head.byte_start = 0;
                head.byte_len = b->layout.grid_hdr_end;
                head.line = 0;
                head.wrap_i = 0;
                head.width = 0;
                head.height = 1;
                head.sec = RTX_SEC_CODE;
                row = &head;
                show_ln = 1;
                fputs("\x1b[48;5;236m", stdout);
            } else {
                row = &b->layout.rows[idx];
                show_ln = 1;
            }
            int span_ok = 1;
            CCArena heap = {0};
            char[:] bytes = cc_slice_empty();
            if (row->byte_len) {
                heap = cc_arena_heap(row->byte_len + 64);
                if (!heap.base) span_ok = 0;
                else {
                    @errhandler(CCError e) {
                        (void)e;
                        span_ok = 0;
                    }
                    bytes = b->scratch_span(row->byte_start, row->byte_len,
                                            heap) !>;
                }
            }
            if (!span_ok) {
                if (heap.base) heap.destroy();
                used = g;
                cctext_row_end(b, focused, vis, pcols, col0, pad_rest, used, (int)r);
                continue;
            }
            {
                size_t gl = row->line;
                if (!is_hdr) {
                    rtx_grid_bind_span(&b->layout.grid, row->byte_start, bytes.len);
                    gl = rtx_grid_wrap_line(row->line, bytes.ptr, bytes.len,
                                            &b->layout.grid, (int)row->wrap_i);
                    if (row->wrap_i > 0) {
                        size_t pgl = rtx_grid_wrap_line(row->line, bytes.ptr,
                                                        bytes.len, &b->layout.grid,
                                                        (int)row->wrap_i - 1);
                        show_ln = (gl != pgl);
                    }
                }
                if (show_ln) {
                    size_t abs = 0, plus = 0;
                    int gap = rtx_gutter_gap(b, row->byte_start, gl, &abs, &plus);
                    if (gap) {
                        char gn[16];
                        snprintf(gn, sizeof gn, gap < 0 ? "-%zu" : "+%zu", plus);
                        fprintf(stdout, "\x1b[31m%*s \x1b[0m", g - 1, gn);
                    } else
                        fprintf(stdout, "\x1b[90m%*zu \x1b[0m", g - 1, abs);
                } else {
                    int i;
                    fputs("\x1b[90m", stdout);
                    for (i = 0; i < g - 1; i++) fputc(' ', stdout);
                    fputs(" \x1b[0m", stdout);
                }
            }
            for (c = 0; c < b->layout.grid.ncols && col < (size_t)tcols; c++) {
                RtxGridField cell;
                int cw = b->layout.grid.col_w[c];
                int used_c = 0;
                if (cw <= 0) break;
                rtx_grid_bind_span(&b->layout.grid, row->byte_start, bytes.len);
                if (!rtx_grid_cell_wrap(bytes.ptr, bytes.len, &b->layout.grid, c,
                                        (int)row->wrap_i, &cell)) {
                    cell.lo = 0;
                    cell.hi = 0;
                }
                {
                    size_t k = cell.lo;
                    while (k < cell.hi && used_c < cw) {
                        RtxUtf8Cl cl = rtx_utf8_cluster(bytes, k);
                        size_t step = cl.n ? cl.n : 1;
                        size_t off = row->byte_start + k;
                        RtxStyle st = b->doc.style_at(off);
                        char put[RTX_UTF8_LOOK];
                        int pn = rtx_utf8_term_put(cl.cp, bytes.ptr + k, step, put,
                                                   sizeof(put));
                        int pc = rtx_utf8_term_cols(cl.cp, cl.cols);
                        int here = rtx_ui_here(ui, focused, b->doc.caret == off);
                        int sel = has && (b->doc.sel_covers(off) !>);
                        if (pc < 1) pc = 1;
                        if (used_c + pc > cw) break;
                        if (virt >= b->left_col && col < (size_t)tcols) {
                            fputs("\x1b[0m", stdout);
                            cctext_style(st, sel, here);
                            if (pn > 0) fwrite(put, 1, (size_t)pn, stdout);
                            col += (size_t)pc;
                        }
                        virt += (size_t)pc;
                        used_c += pc;
                        k += step;
                    }
                }
                fputs("\x1b[0m", stdout);
                {
                    size_t field_hi = rtx_grid_col_hi(bytes.ptr, bytes.len,
                                                      &b->layout.grid, c,
                                                      cell.hi);
                    int last = (cell.hi == field_hi);
                    int pad_here = 0;
                    while (used_c < cw) {
                        if (virt >= b->left_col && col < (size_t)tcols) {
                            int here = last && !pad_here &&
                                       rtx_ui_here(ui, focused,
                                                   b->doc.caret ==
                                                       row->byte_start + cell.hi);
                            if (here) {
                                fputs("\x1b[7m \x1b[0m", stdout);
                                pad_here = 1;
                            } else
                                fputc(' ', stdout);
                            col++;
                        }
                        virt++;
                        used_c++;
                    }
                    if (c + 1 < b->layout.grid.ncols) {
                        if (virt >= b->left_col && col < (size_t)tcols) {
                            size_t gap = row->byte_start + field_hi;
                            int here = last &&
                                       rtx_ui_here(ui, focused,
                                                   b->doc.caret == gap);
                            int gsel = last && has &&
                                       (b->doc.sel_covers(gap) !>);
                            fputs("\x1b[0m", stdout);
                            if (here) fputs("\x1b[7m \x1b[0m", stdout);
                            else if (gsel) fputs("\x1b[44m \x1b[0m", stdout);
                            else fputs("\x1b[90m \x1b[0m", stdout);
                            col++;
                        }
                        virt++;
                    }
                }
            }
            used = g + (int)col;
            if (is_hdr) fputs("\x1b[0m", stdout);
            if (heap.base) heap.destroy();
            cctext_row_end(b, focused, vis, pcols, col0, pad_rest, used, (int)r);
        }
    }
    }
}

int cctext_grid_caret_cell(RtxBuf *b, int vis, int pcols, int col0, int *row,
                           int *col) {
    size_t caret;
    int g, tcols, hdr, body, slots;
    size_t at;
    if (!b || !row || !col || vis < 1) return 0;
    caret = b->doc.caret;
    g = rtx_gutter_cols_buf(b, vis);
    tcols = cctext_text_cols(b, pcols, vis);
    hdr = b->layout.grid_hdr_on;
    body = cctext_body_vis(b, vis, pcols);
    slots = body > hdr ? body - hdr : 0;
    if (hdr && caret < b->layout.grid_hdr_end) {
        size_t hlen = b->layout.grid_hdr_end;
        CCArena heap = {0};
        char[:] hbytes = cc_slice_empty();
        if (hlen) {
            heap = cc_arena_heap(hlen + 64);
            if (!heap.base) return 0;
            {
                @errhandler(CCError e) {
                    (void)e;
                    heap.destroy();
                    return 0;
                }
                hbytes = b->scratch_span(0, hlen, heap) !>;
            }
        }
        rtx_grid_bind_span(&b->layout.grid, 0, hbytes.len);
        at = (size_t)rtx_grid_x_of(hbytes.ptr, hbytes.len, &b->layout.grid, caret);
        if (heap.base) heap.destroy();
        if (at < b->left_col) return 0;
        at -= b->left_col;
        if (at > (size_t)tcols) return 0;
        *row = 1;
        *col = col0 + g + (int)at;
        return 1;
    }
    {
        size_t ri = rtx_layout_grid_row_of(&b->layout, &b->doc, caret);
        size_t base, rec_n, rel;
        RtxVisRow *vr;
        CCArena heap = {0};
        char[:] bytes = cc_slice_empty();
        if (ri < b->top_wrap) return 0;
        if (ri - b->top_wrap >= (size_t)slots) return 0;
        vr = &b->layout.rows[ri];
        if (!rtx_layout_grid_rec_in(&b->layout, caret, &base, &rec_n)) {
            if (caret < vr->byte_start ||
                caret >= vr->byte_start + vr->byte_len)
                return 0;
            base = vr->byte_start;
            rec_n = vr->byte_len;
        }
        if (rec_n) {
            heap = cc_arena_heap(rec_n + 64);
            if (!heap.base) return 0;
            {
                @errhandler(CCError e) {
                    (void)e;
                    heap.destroy();
                    return 0;
                }
                bytes = b->scratch_span(base, rec_n, heap) !>;
            }
        }
        rel = rtx_layout_grid_rel(caret, base, rec_n);
        rtx_grid_bind_span(&b->layout.grid, base, bytes.len);
        at = (size_t)rtx_grid_x_of(bytes.ptr, bytes.len, &b->layout.grid, rel);
        if (heap.base) heap.destroy();
        if (at < b->left_col) return 0;
        at -= b->left_col;
        if (at > (size_t)tcols) return 0;
        *row = (int)(ri - b->top_wrap) + 1 + hdr;
        *col = col0 + g + (int)at;
        return 1;
    }
}
