#!ccc cch
/*
 * GUI menus / fonts / help overlay. Bodies in gui_chrome.ccs (linked TU).
 */
#ifndef RTX_GUI_CHROME_H
#define RTX_GUI_CHROME_H

#define GUI_MENU_H 28
#define GUI_ITEM_H 26
#define GUI_DROP_W 240

typedef struct {
    Font mono;
    Font prose;
    float mono_sz;
    float prose_sz;
    int owned_mono;
    int owned_prose;
} GuiFonts;

enum {
    CMD_NONE = 0,
    CMD_SAVE,
    CMD_UNDO,
    CMD_REDO,
    CMD_CUT,
    CMD_COPY,
    CMD_PASTE,
    CMD_PANE,
    CMD_NEXT,
    CMD_SPLIT,
    CMD_QUIT,
    CMD_JUMP,
    CMD_FIND,
    CMD_OPEN,
    CMD_BROWSE,
    CMD_HELP,
    CMD_SEL_ALL,
    CMD_VIEW,
    CMD_FOLLOW,
    CMD_NAV_NEXT,
    CMD_NAV_PREV,
    CMD_NAV_INV,
    CMD_NAV_INV_PREV,
    CMD_FOLD,
    CMD_STATS
};

void gui_layout_menus(void);
void gui_draw_menubar(GuiFonts *fonts, int ww, int open, Vector2 mouse);
void gui_menu_hover_title(int mx, int my, int *open);
int gui_menu_click(int mx, int my, int *open, int *cmd);
void gui_draw_help(GuiFonts *fonts, int ww, int hh);
Font gui_load_font(const char **paths, int px, int *owned);
const char **gui_mono_font_paths(void);
const char **gui_prose_font_paths(void);

#endif
