#!ccc cch
/*
 * GUI menus / fonts / help overlay. Bodies in gui_chrome.ccs (linked TU).
 */
#ifndef RTX_GUI_CHROME_H
#define RTX_GUI_CHROME_H

#define GUI_MENU_H 0
#define GUI_ITEM_H 26
#define GUI_DROP_W 240

typedef struct {
    Font mono;
    Font prose;
    Font mono_bold;
    Font prose_bold;
    float mono_sz;
    float prose_sz;
    int owned_mono;
    int owned_prose;
    int owned_mono_bold;
    int owned_prose_bold;
} GuiFonts;

void gui_layout_menus(void);
void gui_draw_help(GuiFonts *fonts, int ww, int hh);
Font gui_load_font(const char **paths, int px, int *owned);
const char **gui_mono_font_paths(void);
const char **gui_prose_font_paths(void);

#endif
