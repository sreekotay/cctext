#!ccc cch
/*
 * cctext-gui shared types / flags. Draw and input are linked TUs
 * (gui_draw.ccs / gui_input.ccs). The host loop stays in gui.ccs.
 */
#ifndef RTX_GUI_H
#define RTX_GUI_H

#include "gui_chrome.cch"

#define GUI_SCROLL_W 12
#define GUI_SCROLL_MIN_TH 20
#define GUI_DRAG_TEXT 1
#define GUI_DRAG_SCROLL 2
#define GUI_DRAG_FIND 3
#define GUI_DRAG_GLOB 4
#define GUI_DRAG_SCROLL_X 5
#define GUI_FIND_ROW_H 20
#define GUI_FIND_H (RTX_UI_FIND_ROWS * GUI_FIND_ROW_H + 8)

typedef struct {
    RtxWs *w;
    RtxMeasure *m;
    GuiFonts *fonts;
    RtxUi *ui;
    char *status;
    int pad;
    int top;
    int ready;
    int painting;
    int draw_open;
    int *dragging;
    int *scroll_grab;
    void *resize_observer;
    void *resize_center;
} GuiLive;

extern GuiLive g_live;
extern int g_dirty;
extern int g_need_layout;
extern int g_busy_show;
extern char g_busy_msg[64];

int gui_osx_pick_file(const char *dir, char *out, size_t n);
int gui_osx_shift_down(void);
int gui_osx_alt_down(void);
int gui_osx_install_resize(void *window, void (*fn)(void),
                           void **observer, void **center);
void gui_osx_uninstall_resize(void *observer, void *center);

double gui_measure(void *ctx, char[:] bytes, RtxStyle style, RtxSectionKind sec);
double gui_lh(void *ctx, RtxStyle style, RtxSectionKind sec);
float gui_mono_w(GuiFonts *fonts, float sz, const char *s);
float gui_gutter_px(GuiFonts *fonts, RtxBuf *b, int vis_rows);
/* Viewport width in layout units (grid columns, else pixels). Same space as hit. */
double gui_text_w(GuiFonts *fonts, RtxBuf *b, int pane_w, int vis_rows);
/* Pane-relative pixels → layout x (no left_col). Drag compares this to gui_text_w. */
double gui_layout_hit_x(GuiFonts *fonts, RtxBuf *b, double px);
int gui_pane_at(RtxWs *w, int x, int pad, int inner);
int gui_pane_x0(RtxWs *w, int pane, int pad, int inner);
int gui_text_ph(int hh, int top, int find_on);
int gui_scroll_hit(int mx, int my, int x0, int y0, int pane_w, int ph,
                   RtxBuf *b, int vis_rows);
int gui_scroll_x_h(RtxBuf *b);
int gui_scroll_x_hit(int mx, int my, int x0, int y0, int pane_w, int ph,
                     RtxBuf *b);
size_t gui_field_hit_x(GuiFonts *fonts, float sz, RtxField f, float x);
size_t gui_hex_hit_byte(RtxBuf *b, GuiFonts *fonts, int x0, int y0, int ph,
                        float mx, float my);

void gui_draw_stats(GuiFonts *fonts, RtxBuf *b, int ww, int hh);
void gui_draw_body(int ww, int hh, int pad, int top, int pane_w, int inner,
                   int vis_rows);
void gui_draw_busy_badge(void);

void gui_land(RtxBuf *b, int vis_rows);
void gui_wheel(RtxBuf *b, RtxMeasure *m, double width, int force_horiz);
int gui_handle_input(RtxWs *w, RtxBuf *act, RtxMeasure *m, GuiFonts *fonts,
                     RtxUi *ui, char *status, size_t status_n,
                     size_t *quit_armed_at, int *dragging,
                     int *scroll_grab, int pane_w, int vis_rows, int pad,
                     int top, int inner, int hh);

#endif
