#!ccc ccs
/*
 * cctext keys / mouse (linked TU; see cctext.cch).
 */
#include <ccc/std/prelude.cch>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include "../core/document.cch"
#include "../core/nav.cch"
#include "../core/layout.cch"
#include "../core/workspace.cch"
#include "../core/find.cch"
#include "../core/ui.cch"
#include "../core/browse.cch"
#include "cctext.cch"

int cctext_cmd_letter(int c) {
    int cmd = rtx_cmd_from_letter(c);
    int nav = rtx_nav_from_cmd(cmd);
    if (nav) {
        g_nav = nav;
        return KEY_NAV;
    }
    switch (cmd) {
        case CMD_QUIT: return KEY_QUIT;
        case CMD_SAVE: return KEY_SAVE;
        case CMD_UNDO: return KEY_UNDO;
        case CMD_REDO: return KEY_REDO;
        case CMD_CUT: return KEY_CUT;
        case CMD_COPY: return KEY_COPY;
        case CMD_PASTE: return KEY_PASTE;
        case CMD_PANE: return KEY_OTHER_PANE;
        case CMD_NEXT: return KEY_NEXT_BUF;
        case CMD_SPLIT: return KEY_SPLIT;
        case CMD_JUMP: return KEY_JUMP;
        case CMD_FIND: return KEY_FIND;
        case CMD_BROWSE: return KEY_OPEN;
        case CMD_SEL_ALL: return KEY_SEL_ALL;
        case CMD_VIEW: return KEY_VIEW;
        case CMD_FOLLOW: return KEY_FOLLOW;
        case CMD_STATS: return KEY_STATS;
        default: return KEY_NONE;
    }
}

static void cctext_find_absorb(RtxUi *ui) {
    for (;;) {
        int p = cctext_pending();
        uint32_t cp;
        if (p < 0) return;
        if (p < 32 || p == 127) {
            ungetc(p, stdin);
            return;
        }
        if (p < 0x80) cp = (uint32_t)p;
        else if (!cctext_decode_utf8(p, &cp)) {
            return;
        }
        if (!rtx_ui_find_char(ui, (int)cp)) {
            return;
        }
    }
}

static const char *cctext_clip_cmd(int wr) {
#if defined(__APPLE__)
    (void)wr;
    return wr ? "pbcopy" : "pbpaste";
#else
    if (getenv("WAYLAND_DISPLAY"))
        return wr ? "wl-copy" : "wl-paste";
    return wr ? "xclip -selection clipboard" : "xclip -selection clipboard -o";
#endif
}

static void cctext_sync_clip(RtxWs *w) {
    FILE *fp;
    if (!w) return;
    fp = popen(cctext_clip_cmd(1), "w");
    if (!fp) return;
    if (w->clip.ptr && w->clip.len)
        fwrite(w->clip.ptr, 1, w->clip.len, fp);
    pclose(fp);
}

static void !>(CCError) cctext_from_os_clip(RtxWs *w) {
    FILE *fp;
    char tmp[4096];
    char *buf = NULL;
    size_t n = 0, cap = 0, got;
    int rc;
    if (!w) return cc_ok();
    fp = popen(cctext_clip_cmd(0), "r");
    if (!fp) return cc_ok();
    while ((got = fread(tmp, 1, sizeof tmp, fp)) > 0) {
        if (n + got > cap) {
            size_t ncap = cap ? cap * 2 : 8192;
            char *nb;
            while (ncap < n + got) ncap *= 2;
            nb = realloc(buf, ncap);
            if (!nb) {
                free(buf);
                pclose(fp);
                return cc_err(CC_ERR_OUT_OF_MEMORY, "clipboard");
            }
            buf = nb;
            cap = ncap;
        }
        {
            char[:] dst = cc_slice_from_buffer(buf + n, got);
            char[:] src = cc_slice_from_buffer(tmp, got);
            dst.copy(src) !>(e) {
                free(buf);
                pclose(fp);
                return cc_err(e);
            };
        }
        n += got;
    }
    rc = pclose(fp);
    if (rc != 0 && n == 0) {
        free(buf);
        return cc_ok();
    }
    if (!buf || n == 0) {
        free(buf);
        return w->set_clip(cc_slice_empty());
    }
    w->set_clip(cc_slice_from_buffer(buf, n)) !>(e) {
        free(buf);
        return cc_err(e);
    };
    free(buf);
    return cc_ok();
}

void !>(CCError) cctext_after_edit(RtxWs *w, RtxMeasure *m, int cols, int vis) {
    int bufi, held;
    double w0, w1;
    if (!w || !m) return cc_err(CC_ERR_INVALID_ARG, "after edit");
    bufi = w->pane[w->focus];
    held = w->hold_pane(0);
    w0 = (double)cctext_text_cols(&w->bufs[w->pane[0]], cctext_pane_cols(w, cols, 0), vis);
    w->drop_pane(0, held);
    w1 = w0;
    if (w->npanes > 1) {
        held = w->hold_pane(1);
        w1 = (double)cctext_text_cols(&w->bufs[w->pane[1]], cctext_pane_cols(w, cols, 1), vis);
        w->drop_pane(1, held);
    }
    return w->after_edit(bufi, m, w0, w1, vis);
}

void cctext_ensure_caret(RtxBuf *b, int vis) {
    @errhandler(RtxIndexErr e) {
        (void)e;
        return; /* fault already set by line_* on err */
    }
    if (!b || b->unlock || b->pin_view) return;
    b->reveal(vis) !>;
}

void cctext_follow_caret(RtxBuf *b) {
    if (b) b->pin_view = 0;
}

static int cctext_pane_at_col(RtxWs *w, int cols, int col) {
    if (w->npanes < 2) return 0;
    return col > cols / 2 ? 1 : 0;
}

static int cctext_scroll_hit(int mx, int col0, int pcols, int rw) {
    int sc;
    if (rw < 1) return 0;
    sc = col0 + pcols - rw;
    return mx == sc || (rw > 1 && mx == sc + 1);
}

static int cctext_scroll_x_hit(RtxBuf *b, int mx, int my, int col0, int pcols,
                               int vis) {
    int tcols, g, body;
    if (!b || vis < 2) return 0;
    tcols = cctext_text_cols(b, pcols, vis);
    if (!b->scroll_x_needed((double)tcols)) return 0;
    body = cctext_body_vis(b, vis, pcols);
    g = rtx_gutter_cols_buf(b, vis);
    if (my != body + 1 && my != vis + 1) return 0;
    return mx >= col0 + g && mx < col0 + g + tcols;
}

static void !>(CCError) cctext_wheel(RtxWs *w, RtxBuf *act, RtxMeasure *m,
                                    int kind, int vis, int cols) {
    int pane, pcols, col0, horiz, dir;
    double tw;
    if (!w || !act) return cc_ok();
    pane = w->focus;
    pcols = cctext_pane_cols(w, cols, pane);
    col0 = (pane == 0) ? 1 : (cols / 2 + 2);
    tw = (double)cctext_text_cols(act, pcols, vis);
    horiz = (kind == KEY_WHEEL_LEFT || kind == KEY_WHEEL_RIGHT) ||
            g_shift || g_alt ||
            cctext_osx_shift_down() || cctext_osx_alt_down() ||
            cctext_scroll_x_hit(act, g_mouse_col, g_mouse_row, col0,
                                pcols, vis);
    dir = (kind == KEY_WHEEL_LEFT || kind == KEY_WHEEL_UP) ? -1 : 1;
    if (horiz) {
        double xw = tw;
        if (kind == KEY_WHEEL_LEFT || kind == KEY_WHEEL_RIGHT)
            xw = tw * 0.5;
        act->scroll_x(xw, dir) !>(e) { return cc_err(e); };
    } else {
        act->scroll_vis(m, tw, dir) !>(e) { return cc_err(e); };
        if (!rtx_layout_is_grid(&act->layout))
            act->scroll_vis(m, tw, dir) !>(e) { return cc_err(e); };
    }
    return cc_ok();
}

static void cctext_scroll_x_bar(RtxBuf *b, RtxMeasure *m, int vis, int pcols,
                                int col0, int drag) {
    int tcols;
    int g;
    int lx;
    double tw;
    int tx, th;
    if (!b || vis < 1) return;
    tcols = cctext_text_cols(b, pcols, vis);
    tw = (double)tcols;
    g = rtx_gutter_cols_buf(b, vis);
    lx = g_mouse_col - col0 - g;
    (void)m;
    @errhandler(CCError e) {
        snprintf(g_status, sizeof(g_status), "%s", e.message ? e.message : "scroll");
        return;
    }
    if (!drag || !b->drag_len || !b->drag_horiz) {
        RtxScrollRail rail = b->scroll_x_rail(tw);
        rtx_scroll_rail_thumb(&rail, tcols, 1, &tx, &th);
        b->drag_horiz = 1;
        b->drag_vis = rail.vis ? rail.vis : 1;
        b->drag_len = rail.len;
        if (lx >= tx && lx < tx + th) b->drag_grab = lx - tx;
        else {
            b->drag_grab = th / 2;
            b->scroll_x_to(tw, rtx_scroll_rail_pos_at(&rail, tcols, 1,
                                                      lx - b->drag_grab)) !>;
        }
        return;
    }
    {
        RtxScrollRail map;
        map.pos = 0;
        map.vis = b->drag_vis ? b->drag_vis : 1;
        map.len = b->drag_len ? b->drag_len : 1;
        map.ready = 1;
        b->scroll_x_to(tw, rtx_scroll_rail_pos_at(&map, tcols, 1,
                                                 lx - b->drag_grab)) !>;
    }
}

static int cctext_caret_cell(RtxBuf *b, int vis, int pcols, int col0, int *row, int *col);

/* Hex pane: offset | 16 hex bytes | UTF-8 dump (geometry in core/hex). */
static size_t cctext_hex_hit_byte(RtxBuf *b, int vis, int row, int col) {
    if (!b || row < 0 || row >= vis) return b ? b->doc.caret : 0;
    return rtx_hex_hit_col(b->top_byte, b->len(), row, col);
}

static void cctext_scroll_bar(RtxBuf *b, RtxMeasure *m, int vis, int pcols, int drag) {
    RtxScrollRail rail;
    int ly, ty, th;
    double tw;
    if (!b || vis < 1) return;
    tw = (double)cctext_text_cols(b, pcols, vis);
    ly = g_mouse_row - 1;
    @errhandler(CCError e) {
        snprintf(g_status, sizeof(g_status), "%s", e.message ? e.message : "scroll");
        return;
    }
    @errhandler(RtxIndexErr e) {
        (void)e;
        return; /* fault already set by line_* on err */
    }
    if (!drag || !b->drag_len || b->drag_horiz) {
        rail = b->scroll_rail(vis) !>;
        rtx_scroll_rail_thumb(&rail, vis, 1, &ty, &th);
        b->drag_horiz = 0;
        b->drag_vis = rail.vis ? rail.vis : 1;
        b->drag_len = rail.len;
        if (ly >= ty && ly < ty + th) b->drag_grab = ly - ty;
        else {
            b->drag_grab = th / 2;
            b->scroll_to_off(rtx_scroll_rail_pos_at(&rail, vis, 1, ly - b->drag_grab)) !>;
            b->ensure_view(m, tw, vis) !>;
        }
        return;
    }
    {
        RtxScrollRail map;
        size_t off, dest, cur;
        map.pos = 0;
        map.vis = b->drag_vis ? b->drag_vis : 1;
        map.len = b->drag_len ? b->drag_len : b->len();
        map.ready = 1;
        off = rtx_scroll_rail_pos_at(&map, vis, 1, ly - b->drag_grab);
        if (rtx_layout_is_hex(&b->layout)) {
            dest = rtx_hex_align(off);
            cur = b->top_byte;
        } else {
            dest = rtx_doc_line_floor(&b->doc, off) !>;
            cur = b->seek_valid ? b->seek_off :
                  (b->layout.rows.len ? b->layout.rows.data[0].byte_start : (size_t)-1);
        }
        if (dest != cur) {
            b->scroll_to_off(off) !>;
            b->ensure_view(m, tw, vis) !>;
        }
    }
}

static RtxClickSeq g_clicks;

static int cctext_click_keeps_sel(RtxDoc *d, size_t at, int crossed) {
    @errhandler(RtxIndexErr e) {
        (void)e;
        return 0;
    }
    if (!crossed || g_shift || g_alt || !d || !d->has_sel()) return 0;
    return d->sel_covers(at) !>;
}

void cctext_hit(RtxWs *w, RtxMeasure *m, int cols, int vis, int drag) {
    int pane = cctext_pane_at_col(w, cols, g_mouse_col);
    int prev = w->focus;
    int pcols = cctext_pane_cols(w, cols, pane);
    int col0 = (pane == 0) ? 1 : (cols / 2 + 2);
    RtxBuf *b;
    double x, y;
    @errhandler(CCError e) {
        snprintf(g_status, sizeof(g_status), "%s", e.message ? e.message : "hit failed");
        return;
    }
    @errhandler(RtxIndexErr e) {
        (void)e;
        return; /* fault already set by line_* on err */
    }
    w->set_focus(pane);
    b = w->active();
    if (!b) return;
    if (w->nav[pane].on) {
        int brow = g_mouse_row - 1;
        if (brow == 1 || g_field_drag == 2) {
            int col = g_mouse_col - col0 - 7;
            if (!drag) g_field_drag = 2;
            w->nav[pane].glob_focus = 1;
            rtx_field_click(rtx_browse_field(&w->nav[pane]), col, g_shift, drag);
            return;
        }
        if (!drag) {
            g_field_drag = 0;
            w->nav[pane].glob_focus = 0;
        }
        {
            int list_w = rtx_browse_list_cols(pcols);
            if (list_w < pcols && g_mouse_col - col0 >= list_w) {
                if (!drag)
                    w->browse_enter() !>;
                return;
            }
        }
        {
            int idx = rtx_browse_hit(&w->nav[pane], brow, vis);
            if (idx >= 0) {
                size_t was = w->nav[pane].cur;
                rtx_browse_select(&w->nav[pane], (size_t)idx, vis);
                if (!drag && was == w->nav[pane].cur)
                    w->browse_enter() !>;
            }
        }
        return;
    }
    /* Press on a rail starts that rail. A text drag must not be stolen
     * when the pointer crosses the bar. */
    if (drag && b->drag_len && b->drag_horiz) {
        cctext_scroll_x_bar(b, m, vis, pcols, col0, drag);
        return;
    }
    if (drag && b->drag_len && !b->drag_horiz) {
        cctext_scroll_bar(b, m, vis, pcols, drag);
        return;
    }
    if (!drag && cctext_scroll_x_hit(b, g_mouse_col, g_mouse_row, col0, pcols, vis)) {
        cctext_scroll_x_bar(b, m, vis, pcols, col0, drag);
        return;
    }
    {
        int body = cctext_body_vis(b, vis, pcols);
        if (!drag && cctext_scroll_hit(g_mouse_col, col0, pcols, cctext_rail_w(b, vis)) &&
            g_mouse_row <= body) {
            cctext_scroll_bar(b, m, vis, pcols, drag);
            return;
        }
    }
    if (!drag) {
        cctext_follow_caret(b);
        rtx_buf_drag_end(b);
    }
    {
        double tw = (double)cctext_text_cols(b, pcols, vis);
        int body = cctext_body_vis(b, vis, pcols);
        int g = rtx_gutter_cols_buf(b, vis);
        int rw = cctext_rail_w(b, vis);
        int text0 = col0 + g;
        int text1 = col0 + pcols - rw;
        int xedge = 0;
        /* SGR never reports a row above the window; row 1 is "above"
         * except a sticky grid header, which is a real row. */
        int above = 1;
        if (rtx_layout_is_grid(&b->layout) && b->layout.grid_hdr_on) above = 0;
        if (drag && g_mouse_row <= above) {
            b->scroll_vis(m, tw, -1) !>;
            b->ensure_view(m, tw, vis) !>;
            g_mouse_row = 1;
        } else if (drag && g_mouse_row > body) {
            b->scroll_vis(m, tw, 1) !>;
            b->ensure_view(m, tw, vis) !>;
            g_mouse_row = body;
        } else if (g_mouse_row < 1 || g_mouse_row > body) {
            return;
        }
        if (drag && rtx_layout_uses_left(&b->layout)) {
            if (g_mouse_col < text0) {
                b->scroll_x(tw, -1) !>;
                b->ensure_view(m, tw, vis) !>;
                g_mouse_col = text0;
                xedge = 1;
            } else if (g_mouse_col >= text1) {
                b->scroll_x(tw, 1) !>;
                b->ensure_view(m, tw, vis) !>;
                g_mouse_col = text1 > text0 ? text1 - 1 : text0;
                xedge = 1;
            }
        }
        g_drag_edge = drag && (g_mouse_row <= above || g_mouse_row > body || xedge);
    }
    if (rtx_layout_is_hex(&b->layout)) {
        int col = g_mouse_col - col0;
        int row = g_mouse_row - 1;
        size_t at;
        if (col < 0) col = 0;
        at = cctext_hex_hit_byte(b, vis, row, col);
        if (!drag && cctext_click_keeps_sel(&b->doc, at, pane != prev)) return;
        b->doc.caret = at;
        if (!drag) b->hex_nib = rtx_hex_nib_from_col(col);
        if (!drag && !g_shift) b->doc.sel_anchor = b->doc.caret;
        b->doc.sel_box = 0;
        b->clear_pref();
        b->doc.break_coalesce();
        return;
    }
    x = (double)(g_mouse_col - col0);
    x -= (double)rtx_gutter_cols_buf(b, vis);
    if (x < 0) x = 0;
    if (x > (double)pcols) x = (double)pcols;
    if (rtx_layout_uses_left(&b->layout)) x += (double)b->left_col;
    y = (double)(g_mouse_row - 1);
    if (rtx_layout_is_grid(&b->layout) && b->layout.grid_hdr_on) {
        if (y < 1.0) {
            size_t hlen = b->layout.grid_hdr_end;
            size_t at = 0;
            CCArena heap = {0};
            char[:] hbytes = cc_slice_empty();
            if (hlen) {
                heap = cc_arena_heap(hlen + 64);
                if (heap.base) {
                    @errhandler(CCError e) {
                        (void)e;
                        hlen = 0;
                    }
                    hbytes = b->scratch_span(0, hlen, heap) !>;
                } else {
                    hlen = 0;
                }
            }
            rtx_grid_bind_span(&b->layout.grid, 0, hbytes.len);
            at = rtx_grid_hit(hbytes.ptr, hbytes.len, &b->layout.grid, 0, x);
            if (heap.base) heap.destroy();
            if (!drag && cctext_click_keeps_sel(&b->doc, at, pane != prev)) return;
            b->doc.caret = at;
            if (!drag && !g_shift) b->doc.sel_anchor = at;
            b->doc.sel_box = 0;
            b->clear_pref();
            b->doc.break_coalesce();
            return;
        }
        y -= 1.0;
    }
    {
        size_t s;
        for (s = 0; s < b->top_wrap && s < b->layout.rows.len; s++) {
            y += b->layout.rows.data[s].height;
        }
    }
    {
        size_t at = b->layout.hit(&b->doc, m, x, y) !>;
        size_t key;
        int n = 1;
        if (!drag && cctext_click_keeps_sel(&b->doc, at, pane != prev)) return;
        if (!drag && !g_shift && !g_alt) {
            key = b->doc.cluster_align(at) !>;
            n = rtx_click_count(&g_clicks, rtx_ui_now_ms(), key);
            if (n == 2) {
                b->doc.select_word(at) !>;
                return;
            }
            if (n >= 3) {
                b->doc.select_line(at) !>;
                return;
            }
        }
        b->doc.caret = at;
    }
    if (g_alt) {
        size_t ls = rtx_doc_line_floor(&b->doc, b->doc.caret) !>;
        if (!drag) {
            b->doc.sel_anchor = b->doc.caret;
            b->doc.sel_box = 1;
            b->pref.col = b->doc.caret - ls;
            b->pref.ok = 1;
            b->pref.eol = 0;
            b->doc.box_acol = b->pref.col;
            b->doc.box_ccol = b->pref.col;
        } else {
            b->pref.col = b->doc.caret - ls;
            b->pref.ok = 1;
            b->pref.eol = 0;
            b->box_sync() !>;
        }
    } else {
        if (!drag && !g_shift) b->doc.sel_anchor = b->doc.caret;
        b->doc.sel_box = 0;
        b->clear_pref();
    }
    b->doc.break_coalesce();
}

int cctext_handle_input(RtxWs *w, RtxBuf *act, RtxMeasure *m, RtxUi *ui,
                        int kind, int ch, int vis, int cols, int *skip_reveal) {
    @errhandler(CCError e) {
        snprintf(g_status, sizeof(g_status), "%s",
                 e.message ? e.message : "error");
        return 0;
    }
    @errhandler(RtxIndexErr e) {
        (void)e;
        return 0;
    }
    if (!w || !act || !ui) return 0;

if (ui->ask_conflict) {
    int choice = -1;
    if (kind == KEY_HELP || kind == KEY_QUIT) choice = 0;
    else if (kind == KEY_SAVE) choice = 1;
    else if (kind == KEY_CHAR) choice = rtx_ui_conflict_letter(ch);
    if (choice == 0) {
        ui->ask_conflict = 0;
    } else if (choice == 1) {
        int ok = 1;
        ui->ask_conflict = 0;
        {
            @errhandler(CCError e) {
                snprintf(g_status, sizeof(g_status), "%s",
                         e.message ? e.message : "save failed");
                ok = 0;
            }
            act->doc.save_overwrite();
            act->doc.save() !>;
        }
        if (ok) {
            snprintf(g_status, sizeof(g_status), "saved");
            act->doc.break_coalesce();
        }
    }
    return 0;
}
if (ui->ask_quit) {
    int choice = -1;
    if (kind == KEY_HELP) choice = 0;
    else if (kind == KEY_SAVE) choice = 1;
    else if (kind == KEY_QUIT) choice = 2;
    else if (kind == KEY_CHAR) choice = rtx_ui_quit_letter(ch);
    if (choice == 0) {
        ui->ask_quit = 0;
    } else if (choice == 1) {
        int ok = 1;
        if (w->any_disk_changed()) {
            ui->ask_quit = 0;
            rtx_ui_offer_conflict(ui);
            snprintf(g_status, sizeof(g_status), "file changed on disk");
            return 0;
        }
        {
            @errhandler(CCError e) {
                snprintf(g_status, sizeof(g_status), "%s",
                         e.message ? e.message : "save failed");
                ok = 0;
            }
            w->save_dirty() !>;
        }
        if (ok) return 1;
    } else if (choice == 2) {
        ui->ask_quit = 0;
        w->safe_discard_dirty();
        return 1;
    }
    return 0;
}
if (ui->jump) {
    if (kind == KEY_HELP || kind == KEY_QUIT) {
        rtx_ui_cancel_jump(ui, &act->doc);
    } else if (kind == KEY_ENTER) {
        rtx_ui_apply_jump(ui, act, vis) !>;
        if (!act->unlock) cctext_follow_caret(act);
    } else if (kind == KEY_BACKSPACE && ui->jump_len > 0) {
        rtx_ui_jump_backspace(ui, &act->doc);
    } else if (kind == KEY_CHAR) {
        rtx_ui_jump_char(ui, &act->doc, ch);
    }
    return 0;
}
if (ui->find) {
    RtxField ff = rtx_ui_find_field(ui);
    int changed = 0;
    if (kind == KEY_HELP || kind == KEY_QUIT) {
        act->doc.find.cancel = 1;
        rtx_ui_clear_find(ui);
    } else if (kind == KEY_UP) {
        act->doc.find_prev();
        act->land(vis) !>;
    } else if (kind == KEY_DOWN) {
        act->doc.find_next();
        act->land(vis) !>;
    } else if (kind == KEY_LEFT) {
        rtx_field_move(ff, -1, g_shift);
    } else if (kind == KEY_RIGHT) {
        rtx_field_move(ff, 1, g_shift);
    } else if (kind == KEY_HOME) {
        rtx_field_edge(ff, 0, g_shift);
    } else if (kind == KEY_END) {
        rtx_field_edge(ff, 1, g_shift);
    } else if (kind == KEY_SEL_ALL) {
        rtx_field_cmd(w, ff, CMD_SEL_ALL) !>;
    } else if (kind == KEY_COPY) {
        if (rtx_field_cmd(w, ff, CMD_COPY) !>) cctext_sync_clip(w);
    } else if (kind == KEY_CUT) {
        rtx_field_cmd(w, ff, CMD_CUT) !>;
        cctext_sync_clip(w);
        changed = 1;
    } else if (kind == KEY_PASTE) {
        cctext_from_os_clip(w) !>;
        rtx_field_cmd(w, ff, CMD_PASTE) !>;
        changed = 1;
    } else if (kind == KEY_BACKSPACE) {
        rtx_ui_find_backspace(ui);
        changed = 1;
    } else if (kind == KEY_DELETE) {
        rtx_field_delete(ff);
        changed = 1;
    } else if (kind == KEY_CHAR) {
        if (rtx_ui_find_char(ui, ch)) {
            cctext_find_absorb(ui);
            changed = 1;
        }
    } else if (kind == KEY_JUMP) {
        rtx_ui_start_jump(ui, &act->doc);
    } else if (kind == KEY_WHEEL_UP || kind == KEY_WHEEL_DOWN ||
               kind == KEY_WHEEL_LEFT || kind == KEY_WHEEL_RIGHT) {
        cctext_wheel(w, act, m, kind, vis, cols) !>;
        if (skip_reveal) *skip_reveal = 1;
    } else if (kind == KEY_MOUSE || kind == KEY_MOUSE_DRAG) {
        int header = vis + 1;
        int idx = g_mouse_row - vis - 2;
        int rail = act && act->drag_len;
        if (!rail && (g_mouse_row == header || g_field_drag == 1)) {
            if (!g_mouse_drag || kind == KEY_MOUSE) g_field_drag = 1;
            rtx_field_click(ff, g_mouse_col - 8, g_shift,
                            kind == KEY_MOUSE_DRAG);
        } else if (!rail && idx >= 0) {
            size_t hit = ui->find_top + (size_t)idx;
            if (hit < act->doc.find.len) {
                act->doc.find_goto(hit);
                act->land(vis) !>;
            }
        } else {
            cctext_hit(w, m, cols, vis, kind == KEY_MOUSE_DRAG);
            act = w->active();
            if (act && act->drag_len && skip_reveal) *skip_reveal = 1;
        }
    }
    if (changed) {
        rtx_ui_find_apply(ui, &act->doc) !>;
    }
    return 0;
}
if (kind == KEY_HELP) {
    rtx_ui_toggle_help(ui);
    return 0;
}
if (kind == KEY_STATS) {
    rtx_ui_toggle_stats(ui);
    return 0;
}
if (ui->help) {
    if (kind == KEY_CHAR) kind = cctext_cmd_letter(ch);
    if (kind == KEY_MOUSE || kind == KEY_MOUSE_DRAG ||
        kind == KEY_WHEEL_UP || kind == KEY_WHEEL_DOWN ||
        kind == KEY_WHEEL_LEFT || kind == KEY_WHEEL_RIGHT ||
        kind == KEY_NONE) {
        return 0;
    }
    if (kind == KEY_CHAR) return 0;
    ui->help = 0;
    if (kind == KEY_STATS) {
        rtx_ui_toggle_stats(ui);
        return 0;
    }
}
if (kind == KEY_OPEN) {
    rtx_ui_cancel_jump(ui, &act->doc);
    rtx_ui_clear_find(ui);
    ui->help = 0;
    if (w->browsing()) {
        int ok = rtx_browse_spawn(w->browse(), 0);
        snprintf(g_status, sizeof(g_status), "%s %s",
                 ok ? "opened in" : "could not open in",
                 rtx_host_peer_name(0));
        return 0;
    }
    w->browse_start() !>;
    return 0;
}
if (w->browsing()) {
    RtxBrowse *br = w->browse();
    RtxField gf = rtx_browse_field(br);
    if (kind == KEY_QUIT) {
        if (rtx_ui_offer_quit(w, ui)) return 1;
        return 0;
    }
    if (ui->help) return 0;
    if (kind == KEY_UP || kind == KEY_WHEEL_UP)
        rtx_browse_move(br, -1, vis);
    else if (kind == KEY_DOWN || kind == KEY_WHEEL_DOWN)
        rtx_browse_move(br, 1, vis);
    else if (kind == KEY_LEFT && (br->glob_focus || g_shift))
        rtx_field_move(gf, -1, g_shift);
    else if (kind == KEY_RIGHT && (br->glob_focus || g_shift))
        rtx_field_move(gf, 1, g_shift);
    else if (kind == KEY_LEFT) w->browse_parent() !>;
    else if (kind == KEY_RIGHT || kind == KEY_ENTER) w->browse_enter() !>;
    else if (kind == KEY_HOME) rtx_field_edge(gf, 0, g_shift);
    else if (kind == KEY_END) rtx_field_edge(gf, 1, g_shift);
    else if (kind == KEY_SEL_ALL) {
        rtx_field_cmd(w, gf, CMD_SEL_ALL) !>;
        br->glob_focus = 1;
    } else if (kind == KEY_COPY) {
        if (rtx_field_cmd(w, gf, CMD_COPY) !>) cctext_sync_clip(w);
    } else if (kind == KEY_CUT) {
        rtx_field_cmd(w, gf, CMD_CUT) !>;
        cctext_sync_clip(w);
        rtx_browse_kick(br) !>;
    } else if (kind == KEY_PASTE) {
        cctext_from_os_clip(w) !>;
        rtx_field_cmd(w, gf, CMD_PASTE) !>;
        rtx_browse_kick(br) !>;
    } else if (kind == KEY_DELETE) {
        rtx_field_delete(gf);
        rtx_browse_kick(br) !>;
    } else if (kind == KEY_BACKSPACE) w->browse_backspace() !>;
    else if (kind == KEY_MOUSE || kind == KEY_MOUSE_DRAG)
        cctext_hit(w, m, cols, vis, kind == KEY_MOUSE_DRAG);
    else if (kind == KEY_NAV && g_nav == 3) {
        int ok = rtx_browse_spawn(br, 1);
        snprintf(g_status, sizeof(g_status), "%s %s",
                 ok ? "opened in" : "could not open in",
                 rtx_host_peer_name(1));
    } else if (kind == KEY_VIEW) {
        w->browse_prev_cycle(w->focus);
        snprintf(g_status, sizeof(g_status), "view %s",
                 rtx_layout_view_name(&w->prev[w->focus].layout));
    } else if (kind == KEY_CHAR) w->browse_type(ch) !>;
    return 0;
}
if (kind == KEY_JUMP) {
    rtx_ui_start_jump(ui, &act->doc);
    return 0;
}
if (kind == KEY_FIND) {
    rtx_ui_start_find(ui, &act->doc);
    rtx_ui_find_apply(ui, &act->doc) !>;
    return 0;
}
if (kind == KEY_VIEW) {
    act->cycle_view(vis) !>;
    snprintf(g_status, sizeof(g_status), "view %s",
             rtx_layout_view_name(&act->layout));
    return 0;
}
if (kind == KEY_FOLLOW) {
    act->unlock = !act->unlock;
    if (!act->unlock) cctext_follow_caret(act);
    snprintf(g_status, sizeof(g_status), "%s",
             act->unlock ? "unlock" : "follow");
    return 0;
}
if (kind == KEY_NAV) {
    int hex = rtx_layout_is_hex(&act->layout);
    int r = 0;
    if (g_nav == 5) {
        if (!hex) r = act->doc.fold_toggle();
        if (r) w->invalidate_buf_views(w->pane[w->focus]);
    } else {
        r = act->doc.scope_step((g_nav == 2 || g_nav == 4) ? -1 : 1,
                                g_nav >= 3);
    }
    if (r) cctext_follow_caret(act);
    snprintf(g_status, sizeof(g_status), "%s", rtx_nav_msg(g_nav, r, hex));
    return 0;
}
if (kind == KEY_QUIT) {
    if (rtx_ui_offer_quit(w, ui)) return 1;
    g_status[0] = 0;
    return 0;
}
if (kind != KEY_NONE && kind != KEY_WHEEL_UP && kind != KEY_WHEEL_DOWN &&
    kind != KEY_WHEEL_LEFT && kind != KEY_WHEEL_RIGHT &&
    kind != KEY_MOUSE && kind != KEY_MOUSE_DRAG && kind != KEY_HELP &&
    kind != KEY_SAVE && kind != KEY_COPY && kind != KEY_SPLIT &&
    kind != KEY_OTHER_PANE && kind != KEY_NEXT_BUF &&
    kind != KEY_FOLLOW && kind != KEY_VIEW && !act->unlock) {
    cctext_follow_caret(act);
}
if (kind == KEY_SAVE) {
    if (act->doc.disk_changed()) {
        rtx_ui_offer_conflict(ui);
        return 0;
    }
    {
        @errhandler(CCError e) {
            snprintf(g_status, sizeof(g_status), "%s",
                     e.message ? e.message : "save failed");
        }
        act->doc.save() !>;
    }
    if (!act->doc.dirty()) snprintf(g_status, sizeof(g_status), "saved");
    act->doc.break_coalesce();
} else if (kind == KEY_UNDO) {
    act->doc.undo() !>;
    cctext_after_edit(w, m, cols, vis) !>;
} else if (kind == KEY_REDO) {
    act->doc.redo() !>;
    cctext_after_edit(w, m, cols, vis) !>;
} else if (kind == KEY_COPY) {
    if (w->copy() !>) cctext_sync_clip(w);
} else if (kind == KEY_CUT) {
    w->cut() !>;
    cctext_sync_clip(w);
    cctext_after_edit(w, m, cols, vis) !>;
} else if (kind == KEY_PASTE) {
    cctext_from_os_clip(w) !>;
    w->paste() !>;
    cctext_after_edit(w, m, cols, vis) !>;
} else if (kind == KEY_SPLIT) {
    w->toggle_split();
    fputs("\x1b[H\x1b[J", stdout);
    {
        int rp;
        for (rp = 0; rp < w->npanes; rp++) {
            int held = w->hold_pane(rp);
            w->bufs[w->pane[rp]].layout.clear_rows();
            w->drop_pane(rp, held);
        }
    }
} else if (kind == KEY_OTHER_PANE) {
    w->focus_other();
} else if (kind == KEY_NEXT_BUF) {
    w->next_buf();
} else if (kind == KEY_WHEEL_UP || kind == KEY_WHEEL_DOWN ||
           kind == KEY_WHEEL_LEFT || kind == KEY_WHEEL_RIGHT) {
    cctext_wheel(w, act, m, kind, vis, cols) !>;
    if (skip_reveal) *skip_reveal = 1;
    return 0;
} else if (kind == KEY_MOUSE || kind == KEY_MOUSE_DRAG) {
    cctext_hit(w, m, cols, vis, kind == KEY_MOUSE_DRAG);
    act = w->active();
    if (act && act->drag_len) if (skip_reveal) *skip_reveal = 1;
} else if (kind == KEY_SEL_ALL) {
    act->doc.select_all();
} else if (kind == KEY_HOME) {
    act->move_edge(0, g_shift, 0) !>;
} else if (kind == KEY_END) {
    act->move_edge(1, g_shift, 0) !>;
} else if (kind == KEY_LEFT) {
    if (g_alt) {
        act->box_move_col(-1) !>;
    } else {
        act->move_horiz(-1, g_shift) !>;
    }
} else if (kind == KEY_RIGHT) {
    if (g_alt) {
        act->box_move_col(1) !>;
    } else {
        act->move_horiz(1, g_shift) !>;
    }
} else if (kind == KEY_UP || kind == KEY_DOWN) {
    if (g_alt) act->box_begin() !>;
    act->move_vert(m,
                   (double)cctext_text_cols(act, cctext_pane_cols(w, cols, w->focus), vis),
                   kind == KEY_UP ? -1 : 1, g_shift || g_alt) !>;
    if (g_alt) act->box_sync() !>;
} else if (kind == KEY_BACKSPACE) {
    act->backspace() !>;
    cctext_after_edit(w, m, cols, vis) !>;
} else if (kind == KEY_DELETE) {
    act->delete_forward() !>;
    cctext_after_edit(w, m, cols, vis) !>;
} else if (kind == KEY_ENTER) {
    if (!rtx_layout_is_hex(&act->layout)) {
        act->doc.type("\n") !>;
        cctext_after_edit(w, m, cols, vis) !>;
    }
} else if (kind == KEY_TAB) {
    if (rtx_layout_is_grid(&act->layout)) {
        act->move_grid_col(g_shift ? -1 : 1) !>;
    } else if (!rtx_layout_is_hex(&act->layout)) {
        act->type_cp((uint32_t)'\t') !>;
        cctext_after_edit(w, m, cols, vis) !>;
    }
} else if (kind == KEY_CHAR) {
    act->type_cp((uint32_t)ch) !>;
    cctext_after_edit(w, m, cols, vis) !>;
}

    return 0;
}
