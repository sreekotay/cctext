    {"Open…", "Ctrl-O", CMD_OPEN},
    {"Browse files", "Ctrl-Shift-O", CMD_BROWSE},
    {"Save", "Ctrl-S", CMD_SAVE},
    {"Quit", "Ctrl-Q", CMD_QUIT},
};
