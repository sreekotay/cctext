#!ccc ccs
/*
 * cctext-ray — Raylib GPU frontend. Same document/layout/highlight as cctext.
 * #include <raylib.h> is ordinary C; host cc sees the types.
 *
 *   cctext-ray [--version] [--wrap|--hex|--view=default|wrap|hex] [file ...]
 *   File / Edit / View / Go menu bar
 *   Esc key-binding overlay   Ctrl-G jump   Ctrl-F find
 *   Same as cctext: blink caret, idle skip-layout, unlock
 *   Open… is the system dialog; Ctrl-Shift-O keeps the in-app browser
 */
#include <ccc/std/prelude.cch>
#include <ccc/script/stdio.cch>
#include <stdio.h>
#include <string.h>
#include <raylib.h>
#include <rlgl.h>
#if defined(__APPLE__)
#include <objc/message.h>
#include <objc/runtime.h>
#endif
#include "../core/document.cch"
#include "../core/layout.cch"
#include "../core/workspace.cch"

#define GUI_MENU_H 28
#define GUI_ITEM_H 26
#define GUI_DROP_W 240
#define GUI_SCROLL_W 12
#define GUI_SCROLL_MIN_TH 20
#define GUI_DRAG_TEXT 1
#define GUI_DRAG_SCROLL 2
#define GUI_DRAG_FIND 3
#define GUI_DRAG_GLOB 4
#define GUI_FIND_ROW_H 20
#define GUI_FIND_H (RTX_UI_FIND_ROWS * GUI_FIND_ROW_H + 8)

typedef struct {
    Font mono;
    Font prose;
    float mono_sz;
    float prose_sz;
    int owned_mono;
    int owned_prose;
} GuiFonts;

typedef struct {
    const char *label;
    const char *shortcut;
    int cmd;
} GuiMenuItem;

typedef struct {
    const char *title;
    const GuiMenuItem *items;
    int n;
    int x;
    int w;
} GuiMenu;

enum {
    CMD_NONE = 0,
    CMD_SAVE,
    CMD_UNDO,
    CMD_REDO,
    CMD_CUT,
    CMD_COPY,
    CMD_PASTE,
    CMD_PANE,
    CMD_NEXT,
    CMD_SPLIT,
    CMD_QUIT,
    CMD_JUMP,
    CMD_FIND,
    CMD_OPEN,
    CMD_BROWSE,
    CMD_HELP,
    CMD_SEL_ALL,
    CMD_VIEW,
    CMD_FOLLOW
};

