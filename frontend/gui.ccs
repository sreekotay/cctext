/*
 * raytext — Raylib GPU frontend. Same document/layout/highlight as cctext.
 * #include <raylib.h> is ordinary C; host cc sees the types.
 */
#include <ccc/std/prelude.cch>
#include <ccc/script/stdio.cch>
#include <stdio.h>
#include <string.h>
#include <raylib.h>
#include "../core/layout.cch"

typedef struct {
    Font mono;
    Font prose;
    float mono_sz;
    float prose_sz;
} GuiFonts;

static Font gui_font(GuiFonts *f, RtxStyle st, RtxSectionKind sec) {
    if (sec == RTX_SEC_CODE || st.mono) return f->mono;
    return f->prose;
}

static float gui_size(GuiFonts *f, RtxStyle st, RtxSectionKind sec) {
    if (sec == RTX_SEC_CODE || st.mono) return f->mono_sz;
    return f->prose_sz;
}

static double gui_measure(void *ctx, CCSlice bytes, RtxStyle style, RtxSectionKind sec) {
    GuiFonts *f = (GuiFonts *)ctx;
    char tmp[8];
    Vector2 sz;
    if (!f || bytes.len == 0) return 0;
    tmp[0] = bytes.ptr ? bytes.ptr[0] : ' ';
    tmp[1] = 0;
    sz = MeasureTextEx(gui_font(f, style, sec), tmp, gui_size(f, style, sec), 0);
    return (double)sz.x;
}

static double gui_lh(void *ctx, RtxStyle style, RtxSectionKind sec) {
    GuiFonts *f = (GuiFonts *)ctx;
    if (!f) return 20;
    return (double)gui_size(f, style, sec) * 1.25;
}

static Color gui_hl_color(RtxHlKind hl) {
    switch (hl) {
        case RTX_HL_KEYWORD: return (Color){80, 200, 220, 255};
        case RTX_HL_STRING:  return (Color){120, 200, 120, 255};
        case RTX_HL_COMMENT: return (Color){140, 140, 140, 255};
        case RTX_HL_NUMBER:  return (Color){220, 180, 80, 255};
        default:             return (Color){230, 230, 230, 255};
    }
}

static void gui_relayout(RtxDoc *d, RtxLayout *L, RtxMeasure *m, double width) {
    rtx_doc_reparse(d);
    rtx_layout_doc(L, d, m, width);
}

int main(int argc, char **argv) {
    @errhandler(CCError e) { cc_error_log(e); return 1; }
    RtxDoc d;
    RtxLayout L;
    RtxMeasure m;
    GuiFonts fonts;
    const char *path = argc > 1 ? argv[1] : "testdata/mixed.txt";
    const char *mono_path = "/System/Library/Fonts/Menlo.ttc";
    const char *prose_path = "/System/Library/Fonts/Supplemental/Arial.ttf";
    int w = 960;
    int h = 640;
    double scroll = 0;
    int pad = 16;

    rtx_doc_open(&d, path) !>;
    memset(&L, 0, sizeof(L));

    SetConfigFlags(FLAG_WINDOW_RESIZABLE);
    InitWindow(w, h, "raytext");
    SetTargetFPS(60);

    fonts.mono_sz = 18;
    fonts.prose_sz = 20;
    fonts.mono = FileExists(mono_path) ? LoadFontEx(mono_path, 36, NULL, 0)
                                      : GetFontDefault();
    fonts.prose = FileExists(prose_path) ? LoadFontEx(prose_path, 40, NULL, 0)
                                        : GetFontDefault();
    if (fonts.mono.texture.id) SetTextureFilter(fonts.mono.texture, TEXTURE_FILTER_BILINEAR);
    if (fonts.prose.texture.id) SetTextureFilter(fonts.prose.texture, TEXTURE_FILTER_BILINEAR);

    m.measure = gui_measure;
    m.line_height = gui_lh;
    m.ctx = &fonts;
    rtx_layout_doc(&L, &d, &m, (double)(w - 2 * pad));

    while (!WindowShouldClose()) {
        Vector2 mouse;
        int key;
        w = GetScreenWidth();
        h = GetScreenHeight();
        scroll -= (double)GetMouseWheelMove() * 32.0;
        if (scroll < 0) scroll = 0;
        if (L.total_height > (double)(h - 2 * pad) &&
            scroll > L.total_height - (double)(h - 2 * pad)) {
            scroll = L.total_height - (double)(h - 2 * pad);
        }

        if (IsMouseButtonPressed(MOUSE_BUTTON_LEFT)) {
            mouse = GetMousePosition();
            {
                double x = (double)mouse.x - (double)pad;
                double y = (double)mouse.y - (double)pad + scroll;
                if (x >= 0 && y >= 0) d.caret = rtx_layout_hit(&L, &d, &m, x, y);
            }
        }

        key = GetCharPressed();
        while (key > 0) {
            if (key >= 32 && key < 127) {
                char s[2];
                s[0] = (char)key;
                s[1] = 0;
                rtx_doc_insert(&d, d.caret, cc_slice_from_buffer(s, 1)) !>;
                gui_relayout(&d, &L, &m, (double)(w - 2 * pad));
            }
            key = GetCharPressed();
        }
        if (IsKeyPressed(KEY_BACKSPACE) && d.caret > 0) {
            rtx_doc_erase(&d, d.caret - 1, 1) !>;
            gui_relayout(&d, &L, &m, (double)(w - 2 * pad));
        }
        if (IsKeyPressed(KEY_ENTER)) {
            rtx_doc_insert(&d, d.caret, cc_slice_from_buffer((void *)"\n", 1)) !>;
            gui_relayout(&d, &L, &m, (double)(w - 2 * pad));
        }
        if (IsKeyPressed(KEY_LEFT) && d.caret > 0) d.caret--;
        if (IsKeyPressed(KEY_RIGHT) && d.caret < rtx_piece_tree_len(&d.tree)) d.caret++;
        if (IsWindowResized()) {
            rtx_layout_doc(&L, &d, &m, (double)(w - 2 * pad));
        }

        BeginDrawing();
        ClearBackground((Color){24, 24, 28, 255});
        {
            size_t i;
            double acc = 0;
            for (i = 0; i < L.len; i++) {
                RtxVisRow *row = &L.rows[i];
                double y = (double)pad + acc - scroll;
                acc += row->height;
                if (y + row->height < 0) continue;
                if (y > (double)h) break;
                {
                    size_t k;
                    double x = (double)pad;
                    char *buf = (char *)malloc(row->byte_len ? row->byte_len : 1);
                    if (!buf) continue;
                    rtx_piece_tree_read(&d.tree, row->byte_start, buf, row->byte_len);
                    for (k = 0; k < row->byte_len; k++) {
                        RtxStyle st = rtx_style_at(&d, row->byte_start + k);
                        char tmp[8];
                        Vector2 pos;
                        tmp[0] = buf[k];
                        tmp[1] = 0;
                        pos.x = (float)x;
                        pos.y = (float)y;
                        if (d.caret == row->byte_start + k) {
                            DrawRectangle((int)x, (int)y, 2, (int)row->height,
                                          (Color){255, 200, 80, 255});
                        }
                        DrawTextEx(gui_font(&fonts, st, row->sec), tmp, pos,
                                   gui_size(&fonts, st, row->sec), 0,
                                   gui_hl_color(st.hl));
                        x += gui_measure(&fonts,
                                         cc_slice_from_buffer(tmp, 1), st, row->sec);
                    }
                    if (d.caret == row->byte_start + row->byte_len) {
                        DrawRectangle((int)x, (int)y, 2, (int)row->height,
                                      (Color){255, 200, 80, 255});
                    }
                    free(buf);
                }
            }
        }
        DrawText("raytext  click caret  type  wheel scroll", 16, h - 22, 14,
                 (Color){160, 160, 160, 255});
        EndDrawing();
    }

    if (FileExists(mono_path)) UnloadFont(fonts.mono);
    if (FileExists(prose_path)) UnloadFont(fonts.prose);
    CloseWindow();
    rtx_layout_destroy(&L);
    rtx_doc_destroy(&d);
    return 0;
}
