/*
 * raytext — Raylib GPU frontend. Same document, layout, highlight as cctext.
 * Raylib types stay in rl_host.c (shadow_lower does not ingest <raylib.h>).
 */
#include <ccc/std/prelude.cch>
#include <ccc/script/stdio.cch>
#include <stdio.h>
#include <string.h>
#include "rl_host.h"
#include "../core/layout.cch"

typedef struct {
    RtxRl *rl;
} GuiCtx;

static int gui_mono(RtxStyle st, RtxSectionKind sec) {
    return (sec == RTX_SEC_CODE || st.mono) ? 1 : 0;
}

static double gui_measure(void *ctx, CCSlice bytes, RtxStyle style, RtxSectionKind sec) {
    GuiCtx *g = (GuiCtx *)ctx;
    if (!g || !g->rl || bytes.len == 0) return 0;
    return rtx_rl_measure(g->rl, gui_mono(style, sec), bytes.ptr ? bytes.ptr[0] : ' ');
}

static double gui_lh(void *ctx, RtxStyle style, RtxSectionKind sec) {
    GuiCtx *g = (GuiCtx *)ctx;
    if (!g || !g->rl) return 20;
    return rtx_rl_line_height(g->rl, gui_mono(style, sec));
}

static void gui_relayout(RtxDoc *d, RtxLayout *L, RtxMeasure *m, double width) {
    rtx_doc_reparse(d);
    rtx_layout_doc(L, d, m, width);
}

int main(int argc, char **argv) {
    @errhandler(CCError e) { cc_error_log(e); return 1; }
    RtxDoc d;
    RtxLayout L;
    RtxMeasure m;
    GuiCtx ctx;
    const char *path = argc > 1 ? argv[1] : "testdata/mixed.txt";
    int w = 960;
    int h = 640;
    double scroll = 0;
    int pad = 16;

    rtx_doc_open(&d, path) !>;
    memset(&L, 0, sizeof(L));
    ctx.rl = rtx_rl_open(w, h, "raytext");
    if (!ctx.rl) {
        rtx_doc_destroy(&d);
        return 1;
    }
    m.measure = gui_measure;
    m.line_height = gui_lh;
    m.ctx = &ctx;
    rtx_layout_doc(&L, &d, &m, (double)(w - 2 * pad));

    while (!rtx_rl_should_close(ctx.rl)) {
        double mx = 0, my = 0;
        int key;
        w = rtx_rl_width(ctx.rl);
        h = rtx_rl_height(ctx.rl);
        scroll -= rtx_rl_wheel(ctx.rl) * 32.0;
        if (scroll < 0) scroll = 0;
        if (L.total_height > (double)(h - 2 * pad) &&
            scroll > L.total_height - (double)(h - 2 * pad)) {
            scroll = L.total_height - (double)(h - 2 * pad);
        }

        if (rtx_rl_click(ctx.rl, &mx, &my)) {
            double x = mx - (double)pad;
            double y = my - (double)pad + scroll;
            if (x >= 0 && y >= 0) d.caret = rtx_layout_hit(&L, &d, &m, x, y);
        }

        key = rtx_rl_char(ctx.rl);
        while (key > 0) {
            if (key >= 32 && key < 127) {
                char s[2];
                s[0] = (char)key;
                s[1] = 0;
                rtx_doc_insert(&d, d.caret, cc_slice_from_buffer(s, 1)) !>;
                gui_relayout(&d, &L, &m, (double)(w - 2 * pad));
            }
            key = rtx_rl_char(ctx.rl);
        }
        if (rtx_rl_keydown_backspace(ctx.rl) && d.caret > 0) {
            rtx_doc_erase(&d, d.caret - 1, 1) !>;
            gui_relayout(&d, &L, &m, (double)(w - 2 * pad));
        }
        if (rtx_rl_keydown_enter(ctx.rl)) {
            rtx_doc_insert(&d, d.caret, cc_slice_from_buffer((void *)"\n", 1)) !>;
            gui_relayout(&d, &L, &m, (double)(w - 2 * pad));
        }
        if (rtx_rl_keydown_left(ctx.rl) && d.caret > 0) d.caret--;
        if (rtx_rl_keydown_right(ctx.rl) && d.caret < rtx_piece_tree_len(&d.tree)) d.caret++;
        if (rtx_rl_resized(ctx.rl)) {
            rtx_layout_doc(&L, &d, &m, (double)(w - 2 * pad));
        }

        rtx_rl_begin(ctx.rl);
        {
            size_t i;
            double acc = 0;
            for (i = 0; i < L.len; i++) {
                RtxVisRow *row = &L.rows[i];
                double y = (double)pad + acc - scroll;
                acc += row->height;
                if (y + row->height < 0) continue;
                if (y > (double)h) break;
                {
                    size_t k;
                    double x = (double)pad;
                    char *buf = (char *)malloc(row->byte_len ? row->byte_len : 1);
                    if (!buf) continue;
                    rtx_piece_tree_read(&d.tree, row->byte_start, buf, row->byte_len);
                    for (k = 0; k < row->byte_len; k++) {
                        RtxStyle st = rtx_style_at(&d, row->byte_start + k);
                        int mono = gui_mono(st, row->sec);
                        int caret = (d.caret == row->byte_start + k);
                        rtx_rl_draw_char(ctx.rl, mono, buf[k], (float)x, (float)y,
                                         (int)st.hl, caret);
                        x += rtx_rl_measure(ctx.rl, mono, buf[k]);
                    }
                    if (d.caret == row->byte_start + row->byte_len) {
                        rtx_rl_draw_char(ctx.rl, 1, ' ', (float)x, (float)y, 0, 1);
                    }
                    free(buf);
                }
            }
        }
        rtx_rl_status(ctx.rl, "raytext  click caret  type  wheel scroll");
        rtx_rl_end(ctx.rl);
    }

    rtx_rl_close(ctx.rl);
    rtx_layout_destroy(&L);
    rtx_doc_destroy(&d);
    return 0;
}
