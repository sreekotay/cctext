    {"Undo", "Ctrl-Z", CMD_UNDO},
    {"Redo", "Ctrl-Y", CMD_REDO},
    {"Select all", "Ctrl-A", CMD_SEL_ALL},
    {"Cut", "Ctrl-X", CMD_CUT},
    {"Copy", "Ctrl-C", CMD_COPY},
    {"Paste", "Ctrl-V", CMD_PASTE},
};
static const GuiMenuItem gui_view_items[] = {
    {"Cycle view", "Ctrl-L", CMD_VIEW},
    {"Follow caret", "Ctrl-U", CMD_FOLLOW},
    {"Split", "Ctrl-\\", CMD_SPLIT},
    {"Next file", "Ctrl-N", CMD_NEXT},
    {"Other pane", "Ctrl-W", CMD_PANE},
    {"Key bindings", "Esc", CMD_HELP},
};
static const GuiMenuItem gui_go_items[] = {
    {"Jump to line", "Ctrl-G", CMD_JUMP},
    {"Find", "Ctrl-F", CMD_FIND},
    {"Browse files", "Ctrl-Shift-O", CMD_BROWSE},
};

static GuiMenu gui_menus[] = {
    {"File", gui_file_items, 4, 0, 0},
    {"Edit", gui_edit_items, 6, 0, 0},
    {"View", gui_view_items, 6, 0, 0},
    {"Go", gui_go_items, 3, 0, 0},
};

static const char *gui_mono_paths[] = {
    "/System/Library/Fonts/SFNSMono.ttf",
    "/System/Library/Fonts/Monaco.ttf",
    "/System/Library/Fonts/Supplemental/Andale Mono.ttf",
    "/System/Library/Fonts/Supplemental/Courier New.ttf",
    "/System/Library/Fonts/Menlo.ttc",
    NULL
};
static const char *gui_prose_paths[] = {
    "/System/Library/Fonts/Supplemental/Georgia.ttf",
    "/System/Library/Fonts/Supplemental/Arial.ttf",
    NULL
};

static Font gui_load_font(const char **paths, int px, int *owned) {
    int cps[224];
    int i;
    *owned = 0;
    for (i = 0; i < 224; i++) cps[i] = 32 + i;
    for (i = 0; paths[i]; i++) {
        Font f;
        if (!FileExists(paths[i])) continue;
        f = LoadFontEx(paths[i], px, cps, 224);
        if (f.texture.id && f.glyphCount >= 90) {
            SetTextureFilter(f.texture, TEXTURE_FILTER_BILINEAR);
            *owned = 1;
            return f;
        }
        if (f.texture.id) UnloadFont(f);
    }
    return GetFontDefault();
}

static Font gui_font(GuiFonts *f, RtxStyle st, RtxSectionKind sec) {
    if (sec == RTX_SEC_CODE || st.mono) return f->mono;
    return f->prose;
}

static float gui_size(GuiFonts *f, RtxStyle st, RtxSectionKind sec) {
    if (sec == RTX_SEC_CODE || st.mono) return f->mono_sz;
    return f->prose_sz;
}

static double gui_measure(void *ctx, char[:] bytes, RtxStyle style, RtxSectionKind sec) {
    GuiFonts *f = (GuiFonts *)ctx;
    double w = 0;
    size_t i;
    if (!f || !bytes.ptr || bytes.len == 0) return 0;
    i = 0;
    while (i < bytes.len) {
        RtxUtf8Cl cl = rtx_utf8_cluster(bytes, i);
        size_t step = cl.n ? cl.n : 1;
        char tmp[RTX_UTF8_LOOK + 1];
        Vector2 sz;
        if (step > RTX_UTF8_LOOK) step = RTX_UTF8_LOOK;
        memcpy(tmp, bytes.ptr + i, step);
        tmp[step] = 0;
        sz = MeasureTextEx(gui_font(f, style, sec), tmp, gui_size(f, style, sec), 0);
        w += (double)sz.x;
        i += cl.n ? cl.n : 1;
    }
    return w;
}

static double gui_lh(void *ctx, RtxStyle style, RtxSectionKind sec) {
    GuiFonts *f = (GuiFonts *)ctx;
    if (!f) return 20;
    return (double)gui_size(f, style, sec) * 1.25;
}

static Color gui_hl_color(RtxScope scope) {
    RtxThemeColor c = rtx_theme_color(scope);
    return (Color){c.r, c.g, c.b, 255};
}

static Color gui_face(RtxBrowseFace face) {
    RtxThemeColor c = rtx_browse_face(face);
    return (Color){c.r, c.g, c.b, 255};
}

static int gui_ctrl(void) {
    return IsKeyDown(KEY_LEFT_CONTROL) || IsKeyDown(KEY_RIGHT_CONTROL) ||
           IsKeyDown(KEY_LEFT_SUPER) || IsKeyDown(KEY_RIGHT_SUPER);
}

static int gui_shift(void) {
    return IsKeyDown(KEY_LEFT_SHIFT) || IsKeyDown(KEY_RIGHT_SHIFT);
}

static int gui_alt(void) {
    return IsKeyDown(KEY_LEFT_ALT) || IsKeyDown(KEY_RIGHT_ALT);
}

/* Initial press or OS key-repeat. Commands stay on IsKeyPressed. */
static int gui_key(int key) {
    return IsKeyPressed(key) || IsKeyPressedRepeat(key);
}

static int g_dirty = 1;
static int g_need_layout = 1;
static Vector2 g_mouse_was;

static void gui_blink_show(RtxUi *ui) {
    rtx_ui_blink_show(ui);
    g_dirty = 1;
}

static void gui_idle_wait(RtxUi *ui) {
    long left_ms = RTX_UI_BLINK_MS;
    if (ui && ui->blink_at)
        left_ms = RTX_UI_BLINK_MS - (rtx_ui_now_ms() - ui->blink_at);
    if (left_ms < 16) left_ms = 16;
    if (left_ms > RTX_UI_BLINK_MS) left_ms = RTX_UI_BLINK_MS;
    WaitTime(left_ms > 16 ? 0.016 : (double)left_ms / 1000.0);
    PollInputEvents();
}

static int gui_keys_down(void) {
    int k;
    for (k = 32; k <= 348; k++) {
        if (IsKeyPressed(k) || IsKeyPressedRepeat(k)) return 1;
    }
    return 0;
}

static int gui_saw_input(int dragging, int menu_open) {
    Vector2 m = GetMousePosition();
    int moved = ((int)m.x != (int)g_mouse_was.x) || ((int)m.y != (int)g_mouse_was.y);
    g_mouse_was = m;
    if (IsWindowResized()) return 1;
    if (GetMouseWheelMove() != 0.0f) return 1;
    if (IsMouseButtonPressed(MOUSE_BUTTON_LEFT) ||
        IsMouseButtonReleased(MOUSE_BUTTON_LEFT)) return 1;
    if (dragging) return 1;
    if (moved && menu_open >= 0) return 1;
    if (moved && m.y >= 0.0f && m.y < (float)GUI_MENU_H) return 1;
    return gui_keys_down();
}

static void gui_follow_caret(RtxBuf *b) {
    if (b) b->pin_view = 0;
}

/* 1 = path chosen, 0 = cancel, -1 = no system dialog (use in-app browse). */
static int gui_pick_file(RtxBuf *act, char *out, size_t n) {
#if defined(__APPLE__)
    id panel;
    id url;
    id nspath;
    const char *c;
    long rc;
    char dir[RTX_BROWSE_DIR];
    if (!out || n == 0) return 0;
    out[0] = 0;
    dir[0] = 0;
    if (act && act->doc.path.ptr && act->doc.path.len)
        rtx_browse_dirname(dir, sizeof(dir), act->doc.path.ptr);
    panel = ((id (*)(id, SEL))objc_msgSend)(
        (id)objc_getClass("NSOpenPanel"), sel_getUid("openPanel"));
    if (!panel) return -1;
    ((void (*)(id, SEL, unsigned char))objc_msgSend)(
        panel, sel_getUid("setCanChooseFiles:"), 1);
    ((void (*)(id, SEL, unsigned char))objc_msgSend)(
        panel, sel_getUid("setCanChooseDirectories:"), 0);
    ((void (*)(id, SEL, unsigned char))objc_msgSend)(
        panel, sel_getUid("setAllowsMultipleSelection:"), 0);
    if (dir[0] == '/') {
        id nsdir = ((id (*)(id, SEL, const char *))objc_msgSend)(
            (id)objc_getClass("NSString"), sel_getUid("stringWithUTF8String:"),
            dir);
        id durl = ((id (*)(id, SEL, id))objc_msgSend)(
            (id)objc_getClass("NSURL"), sel_getUid("fileURLWithPath:"), nsdir);
        ((void (*)(id, SEL, id))objc_msgSend)(
            panel, sel_getUid("setDirectoryURL:"), durl);
    }
    rc = ((long (*)(id, SEL))objc_msgSend)(panel, sel_getUid("runModal"));
    if (rc != 1) return 0;
    url = ((id (*)(id, SEL))objc_msgSend)(panel, sel_getUid("URL"));
    if (!url) return 0;
    nspath = ((id (*)(id, SEL))objc_msgSend)(url, sel_getUid("path"));
    if (!nspath) return 0;
    c = ((const char *(*)(id, SEL))objc_msgSend)(nspath, sel_getUid("UTF8String"));
    if (!c || !c[0]) return 0;
    snprintf(out, n, "%s", c);
    return 1;
#else
    (void)act;
    (void)out;
    (void)n;
    return -1;
#endif
}

static size_t gui_hex_hit_byte(RtxBuf *b, GuiFonts *fonts, int x0, int y0, int ph,
                               float mx, float my);
static void gui_draw_hex_buf(RtxBuf *b, const RtxUi *ui, GuiFonts *fonts, int focused,
                             int x0, int y0, int pw, int ph);

static void !>(CCError) gui_after_edit(RtxWs *w, RtxBuf *act, RtxMeasure *m, double width,
                                      int vis_rows) {
    int bufi;
    if (!w || !act || !m) return cc_err(CC_ERR_INVALID_ARG, "after edit");
    bufi = w->pane[w->focus];
    w->after_edit(bufi, m, width, width, vis_rows) !>;
    if (!act->unlock) {
        gui_follow_caret(act);
        act->reveal(vis_rows) !>(e) {
            return cc_err(CC_ERR_IO, e.message ? e.message : "line index");
        };
        return act->ensure_view(m, width, vis_rows);
    }
    return cc_ok();
}

static void gui_wheel(RtxBuf *b, RtxMeasure *m, double width) {
    int wheel;
    if (!b) return;
    wheel = (int)GetMouseWheelMove();
    while (wheel > 0) {
        b->scroll_vis(m, width, -1) !>(e) { (void)e; return; };
        wheel--;
    }
    while (wheel < 0) {
        b->scroll_vis(m, width, 1) !>(e) { (void)e; return; };
        wheel++;
    }
}

static void gui_move_vert(RtxBuf *b, RtxMeasure *m, double width, int dir, int shift) {
    if (!b) return;
    if (rtx_layout_is_hex(&b->layout)) {
        size_t n = b->len();
        size_t at = b->doc.caret;
        if (dir < 0) {
            if (at >= (size_t)RTX_HEX_COLS) at -= (size_t)RTX_HEX_COLS;
            else at = 0;
        } else if (n) {
            at += (size_t)RTX_HEX_COLS;
            if (at >= n) at = n - 1;
        }
        if (!shift) b->doc.sel_anchor = at;
        b->doc.caret = at;
        b->doc.sel_box = 0;
        b->doc.break_coalesce();
        b->clear_pref();
        return;
    }
    b->layout.move_vert(&b->doc, m, width, dir, shift, &b->pref) !>(e) {
        (void)e;
    };
}

static float gui_gutter_px(GuiFonts *fonts, RtxBuf *b, int vis_rows);
static double gui_text_w(GuiFonts *fonts, RtxBuf *b, int pane_w, int vis_rows);
static int gui_pane_at(RtxWs *w, int x, int pad, int inner);
static int gui_pane_x0(RtxWs *w, int pane, int pad, int inner);
static int gui_text_ph(int hh, int top, int find_on);
static int gui_scroll_hit(int mx, int my, int x0, int y0, int pane_w, int ph,
                          RtxBuf *b, int vis_rows);
static int gui_menu_click(int mx, int my, int *open, int *cmd);
static void gui_reveal_caret(RtxBuf *b, int vis_rows);
static void gui_land(RtxBuf *b, int vis_rows);
static double gui_hit_y(const RtxBuf *b, double y);
static int gui_quit_hit(int mx, int my, int ww, int hh);
static int gui_run_cmd(int cmd, RtxWs *w, RtxBuf *act, RtxMeasure *m,
                       double text_w, int vis_rows, RtxUi *ui,
                       char *status, size_t status_n, size_t *quit_armed_at);
static float gui_mono_w(GuiFonts *fonts, float sz, const char *s);
static size_t gui_field_hit_x(GuiFonts *fonts, float sz, RtxField f, float x);
static int gui_field_cmd(int cmd, RtxWs *w, RtxField f);

static void gui_home_end(RtxBuf *b, int to_end, int shift, int physical) {
    @errhandler(RtxIndexErr e) {
        (void)e;
        return; /* fault already set by line_* on err */
    }
    if (!b) return;
    if (rtx_layout_is_hex(&b->layout)) {
        size_t n = b->len();
        size_t row = n ? b->doc.caret / (size_t)RTX_HEX_COLS : 0;
        size_t at;
        if (!to_end) at = row * (size_t)RTX_HEX_COLS;
        else {
            at = row * (size_t)RTX_HEX_COLS + (size_t)RTX_HEX_COLS - 1;
            if (n == 0) at = 0;
            else if (at >= n) at = n - 1;
        }
        if (!shift) b->doc.sel_anchor = at;
        b->doc.caret = at;
        b->doc.sel_box = 0;
        b->doc.break_coalesce();
        b->clear_pref();
        return;
    }
    if (!physical && b->layout.wrap && b->layout.len) {
        b->layout.move_row_edge(&b->doc, to_end, shift);
    } else {
        b->doc.move_line_edge(to_end, shift) !>;
    }
    if (to_end) b->stick_eol();
    else b->clear_pref();
}

/* Mouse + keys. 1 = quit. Not Result: main is already at the bind cap. */
static int gui_handle_input(RtxWs *w, RtxBuf *act, RtxMeasure *m, GuiFonts *fonts,
                            RtxUi *ui, char *status, size_t status_n,
                            size_t *quit_armed_at, int *menu_open, int *dragging,
                            int *scroll_grab, int pane_w, int vis_rows, int pad,
                            int top, int inner, int hh) {
    Vector2 mouse;
    int key;
    double text_w;
    @errhandler(CCError e) {
        snprintf(status, status_n, "%s", e.message ? e.message : "error");
        return 0;
    }
    @errhandler(RtxIndexErr e) {
        (void)e;
        return 0; /* fault already set by line_* on err */
    }
    if (!w || !act || !m || !fonts || !ui || !scroll_grab) return 0;
    text_w = gui_text_w(fonts, act, pane_w, vis_rows);
    if (ui->ask_quit) {
        int choice = 0;
        if (IsKeyPressed(KEY_ESCAPE) || (IsKeyPressed(KEY_C) && !gui_ctrl())) {
            choice = 3;
        } else if (IsKeyPressed(KEY_S) || (gui_ctrl() && IsKeyPressed(KEY_S))) {
            choice = 1;
        } else if (IsKeyPressed(KEY_Q) || IsKeyPressed(KEY_N) ||
                   IsKeyPressed(KEY_D) || (gui_ctrl() && IsKeyPressed(KEY_Q))) {
            choice = 2;
        }
        if (IsMouseButtonPressed(MOUSE_BUTTON_LEFT)) {
            Vector2 mp = GetMousePosition();
            int hit = gui_quit_hit((int)mp.x, (int)mp.y, GetScreenWidth(), hh);
            if (hit) choice = hit;
        }
        while (GetCharPressed() > 0) { }
        if (choice == 3) {
            ui->ask_quit = 0;
            /* Dismiss this host-close offer; chrome-X stays latched. */
            return 0;
        }
        if (choice == 2) return 1;
        if (choice == 1) {
            size_t si;
            for (si = 0; si < w->len; si++) {
                RtxDoc *sd = &w->bufs[si].doc;
                if (!sd->dirty()) continue;
                if (!sd->path.ptr || sd->path.len == 0) {
                    snprintf(status, status_n, "untitled — save as a path first");
                    return 0;
                }
                sd->save() !>;
                sd->break_coalesce();
            }
            return 1;
        }
        return 0;
    }
    if (*menu_open >= 0) {
        Vector2 hm = GetMousePosition();
        if (hm.y >= 0 && hm.y < (float)GUI_MENU_H) {
            int mi;
            for (mi = 0; mi < 4; mi++) {
                if (hm.x >= (float)gui_menus[mi].x &&
                    hm.x < (float)(gui_menus[mi].x + gui_menus[mi].w)) {
                    *menu_open = mi;
                }
            }
        }
    }
    if (IsMouseButtonPressed(MOUSE_BUTTON_LEFT)) {
        int mcmd = CMD_NONE;
        int mhit;
        mouse = GetMousePosition();
        mhit = gui_menu_click((int)mouse.x, (int)mouse.y, menu_open, &mcmd);
        if (mhit == 2) {
            if (gui_run_cmd(mcmd, w, act, m, text_w, vis_rows, ui, status,
                            status_n, quit_armed_at)) {
                return 1;
            }
        } else if (mhit == 0 && ui->find &&
                   mouse.y >= (float)(hh - 26 - GUI_FIND_H) &&
                   mouse.y < (float)(hh - 26)) {
            int y0 = hh - 26 - GUI_FIND_H;
            int row = ((int)mouse.y - y0 - 8) / GUI_FIND_ROW_H;
            if (row <= 0) {
                RtxField ff = rtx_ui_find_field(ui);
                float lab = gui_mono_w(fonts, 15, "find: ");
                size_t at = gui_field_hit_x(fonts, 15, ff,
                                            mouse.x - 12.0f - lab);
                *ff.caret = at;
                if (!gui_shift()) *ff.sel = at;
                *dragging = GUI_DRAG_FIND;
            } else {
                size_t hit = ui->find_top + (size_t)(row - 1);
                if (hit < act->doc.find.len) {
                    act->doc.find_goto(hit);
                    gui_land(act, vis_rows);
                }
            }
        } else if (mhit == 0) {
            int ph;
            int x0;
            int pane = gui_pane_at(w, (int)mouse.x, pad, inner);
            int prev = w->focus;
            w->set_focus(pane);
            act = w->active();
            text_w = gui_text_w(fonts, act, pane_w, vis_rows);
            x0 = gui_pane_x0(w, w->focus, pad, inner);
            ph = gui_text_ph(hh, top, ui->find);
            if (w->nav[w->focus].on) {
                int row = ((int)mouse.y - top) / 20;
                if (row == 1) {
                    RtxBrowse *br = &w->nav[w->focus];
                    RtxField gf = rtx_browse_field(br);
                    float lab = gui_mono_w(fonts, 14, "glob: ");
                    size_t at = gui_field_hit_x(fonts, 14, gf,
                                                mouse.x - (float)x0 - 8.0f - lab);
                    *gf.caret = at;
                    if (!gui_shift()) *gf.sel = at;
                    br->glob_focus = 1;
                    *dragging = GUI_DRAG_GLOB;
                } else {
                    int idx = rtx_browse_hit(&w->nav[w->focus], row, vis_rows);
                    w->nav[w->focus].glob_focus = 0;
                    if (idx >= 0) {
                        size_t was = w->nav[w->focus].cur;
                        w->nav[w->focus].cur = (size_t)idx;
                        rtx_browse_scroll(&w->nav[w->focus], vis_rows);
                        if (was == w->nav[w->focus].cur)
                            w->browse_enter() !>;
                    }
                }
            } else if (gui_scroll_hit((int)mouse.x, (int)mouse.y, x0, top, pane_w, ph,
                               act, vis_rows)) {
                RtxScrollRail rail = act->scroll_rail(vis_rows) !>;
                int ty, th;
                int ly = (int)mouse.y - top;
                rtx_scroll_rail_thumb(&rail, ph, GUI_SCROLL_MIN_TH, &ty, &th);
                act->drag_vis = rail.vis ? rail.vis : 1;
                act->drag_len = rail.len;
                if (ly >= ty && ly < ty + th) {
                    *scroll_grab = ly - ty;
                } else {
                    *scroll_grab = th / 2;
                    act->scroll_to_off(rtx_scroll_rail_pos_at(&rail, ph,
                                                              GUI_SCROLL_MIN_TH,
                                                              ly - *scroll_grab)) !>;
                    act->ensure_view(m, text_w, vis_rows) !>;
                }
                *dragging = GUI_DRAG_SCROLL;
            } else {
                double x = (double)mouse.x - (double)x0 - (double)gui_gutter_px(fonts, act, vis_rows);
                double y = (double)mouse.y - (double)top;
                size_t at;
                if (rtx_layout_is_hex(&act->layout)) {
                    if (mouse.y >= (float)top) {
                        at = gui_hex_hit_byte(act, fonts, x0, top, ph, mouse.x, mouse.y);
                        if (pane != prev && !gui_shift() && !gui_alt() &&
                            act->doc.has_sel() && (act->doc.sel_covers(at) !>)) {
                            /* focus only — keep the selection */
                        } else {
                            act->doc.caret = at;
                            if (!gui_shift()) act->doc.sel_anchor = act->doc.caret;
                            act->doc.sel_box = 0;
                            act->clear_pref();
                            *dragging = GUI_DRAG_TEXT;
                            act->doc.break_coalesce();
                        }
                    }
                } else if (x >= 0 && y >= 0) {
                    at = act->layout.hit(&act->doc, m, x, gui_hit_y(act, y)) !>;
                    if (pane != prev && !gui_shift() && !gui_alt() &&
                        act->doc.has_sel() && (act->doc.sel_covers(at) !>)) {
                        /* focus only — keep the selection */
                    } else {
                        act->doc.caret = at;
                        if (gui_alt()) {
                            size_t line = act->doc.line_of(at) !>;
                            size_t ls = act->doc.line_start(line) !>;
                            act->doc.sel_anchor = at;
                            act->doc.sel_box = 1;
                            act->pref.col = at - ls;
                            act->pref.ok = 1;
                            act->pref.eol = 0;
                            act->doc.box_acol = act->pref.col;
                            act->doc.box_ccol = act->pref.col;
                        } else {
                            if (!gui_shift()) act->doc.sel_anchor = act->doc.caret;
                            act->doc.sel_box = 0;
                            act->clear_pref();
                        }
                        *dragging = GUI_DRAG_TEXT;
                        act->doc.break_coalesce();
                    }
                }
            }
        }
    }
    if (*dragging == GUI_DRAG_SCROLL && IsMouseButtonDown(MOUSE_BUTTON_LEFT)) {
        RtxScrollRail map;
        size_t off, dest, cur;
        int ph = gui_text_ph(hh, top, ui->find);
        mouse = GetMousePosition();
        map.pos = 0;
        map.vis = act->drag_vis ? act->drag_vis : 1;
        map.len = act->drag_len ? act->drag_len : act->len();
        map.ready = 1;
        off = rtx_scroll_rail_pos_at(&map, ph, GUI_SCROLL_MIN_TH,
                                     (int)mouse.y - top - *scroll_grab);
        if (rtx_layout_is_hex(&act->layout)) {
            dest = rtx_hex_align(off);
            cur = act->top_byte;
        } else {
            dest = rtx_doc_line_floor(&act->doc, off) !>;
            cur = act->seek_valid ? act->seek_off :
                  (act->layout.len ? act->layout.rows[0].byte_start : (size_t)-1);
        }
        if (dest != cur) {
            act->scroll_to_off(off) !>;
            act->ensure_view(m, text_w, vis_rows) !>;
        }
    } else if (*dragging == GUI_DRAG_TEXT && IsMouseButtonDown(MOUSE_BUTTON_LEFT)) {
        mouse = GetMousePosition();
        {
            int x0 = gui_pane_x0(w, w->focus, pad, inner);
            double x = (double)mouse.x - (double)x0 - (double)gui_gutter_px(fonts, act, vis_rows);
            double y = (double)mouse.y - (double)top;
            int ph = gui_text_ph(hh, top, ui->find);
            size_t at;
            if (x < 0) x = 0;
            if (y < 0) {
                act->scroll_vis(m, text_w, -1) !>;
                act->ensure_view(m, text_w, vis_rows) !>;
                y = 0;
            } else if (ph > 0 && y >= (double)ph) {
                act->scroll_vis(m, text_w, 1) !>;
                act->ensure_view(m, text_w, vis_rows) !>;
                y = (double)(ph - 1);
            }
            if (rtx_layout_is_hex(&act->layout)) {
                at = gui_hex_hit_byte(act, fonts, x0, top, ph, mouse.x,
                                      (float)top + (float)y);
                act->doc.caret = at;
                act->clear_pref();
            } else {
                at = act->layout.hit(&act->doc, m, x, gui_hit_y(act, y)) !>;
                act->doc.caret = at;
                if (act->doc.sel_box) {
                    size_t line = act->doc.line_of(at) !>;
                    size_t ls = act->doc.line_start(line) !>;
                    act->pref.col = at - ls;
                    act->pref.ok = 1;
                    act->pref.eol = 0;
                    act->box_sync() !>;
                } else {
                    act->clear_pref();
                }
            }
        }
    } else if (*dragging == GUI_DRAG_FIND && IsMouseButtonDown(MOUSE_BUTTON_LEFT)) {
        RtxField ff = rtx_ui_find_field(ui);
        float lab = gui_mono_w(fonts, 15, "find: ");
        mouse = GetMousePosition();
        *ff.caret = gui_field_hit_x(fonts, 15, ff, mouse.x - 12.0f - lab);
    } else if (*dragging == GUI_DRAG_GLOB && IsMouseButtonDown(MOUSE_BUTTON_LEFT) &&
               w->nav[w->focus].on) {
        RtxBrowse *br = &w->nav[w->focus];
        RtxField gf = rtx_browse_field(br);
        int x0 = gui_pane_x0(w, w->focus, pad, inner);
        float lab = gui_mono_w(fonts, 14, "glob: ");
        mouse = GetMousePosition();
        *gf.caret = gui_field_hit_x(fonts, 14, gf,
                                    mouse.x - (float)x0 - 8.0f - lab);
    }
    if (IsMouseButtonReleased(MOUSE_BUTTON_LEFT)) {
        *dragging = 0;
        act->drag_vis = 0;
        act->drag_len = 0;
    }

    if (ui->jump) {
        if (IsKeyPressed(KEY_ESCAPE)) {
            rtx_ui_clear_jump(ui);
        } else if (IsKeyPressed(KEY_ENTER)) {
            rtx_ui_apply_jump(ui, act, vis_rows) !>;
        } else if (gui_key(KEY_BACKSPACE) && ui->jump_len > 0) {
            ui->jump_buf[--ui->jump_len] = 0;
        } else {
            key = GetCharPressed();
            while (key > 0) {
                rtx_ui_jump_char(ui, key);
                key = GetCharPressed();
            }
        }
        return 0;
    }
    if (ui->find) {
        RtxField ff = rtx_ui_find_field(ui);
        int cmd = gui_ctrl() && IsKeyPressed(KEY_C) ? CMD_COPY :
                  gui_ctrl() && IsKeyPressed(KEY_X) ? CMD_CUT :
                  gui_ctrl() && IsKeyPressed(KEY_V) ? CMD_PASTE :
                  gui_ctrl() && IsKeyPressed(KEY_A) ? CMD_SEL_ALL : CMD_NONE;
        int chg = 0;
        if (IsKeyPressed(KEY_ESCAPE)) {
            act->doc.find.cancel = 1;
            rtx_ui_clear_find(ui);
        } else if (cmd) {
            chg = gui_field_cmd(cmd, w, ff) && cmd != CMD_COPY && cmd != CMD_SEL_ALL;
            while (GetCharPressed() > 0) { }
        } else if (gui_key(KEY_UP)) {
            act->doc.find_prev();
            gui_land(act, vis_rows);
        } else if (gui_key(KEY_DOWN)) {
            act->doc.find_next();
            gui_land(act, vis_rows);
        } else if (gui_key(KEY_LEFT)) rtx_field_move(ff, -1, gui_shift());
        else if (gui_key(KEY_RIGHT)) rtx_field_move(ff, 1, gui_shift());
        else if (gui_key(KEY_BACKSPACE)) {
            rtx_ui_find_backspace(ui);
            chg = 1;
        } else if (gui_ctrl() && (IsKeyPressed(KEY_G) || IsKeyPressed(KEY_J))) {
            rtx_ui_start_jump(ui);
        } else if (gui_ctrl() && IsKeyPressed(KEY_Q)) {
            if (gui_run_cmd(CMD_QUIT, w, act, m, text_w, vis_rows, ui, status,
                            status_n, quit_armed_at)) return 1;
        } else if (gui_ctrl() && IsKeyPressed(KEY_S)) {
            gui_run_cmd(CMD_SAVE, w, act, m, text_w, vis_rows, ui, status,
                        status_n, quit_armed_at);
        } else {
            key = GetCharPressed();
            while (key > 0) {
                if (rtx_ui_find_char(ui, key)) chg = 1;
                key = GetCharPressed();
            }
        }
        if (chg) {
            rtx_ui_find_apply(ui, &act->doc) !>;
            gui_land(act, vis_rows);
        }
        return 0;
    }
    if (w->browsing()) {
        RtxBrowse *br = RtxWs_browse(w);
        RtxField gf = rtx_browse_field(br);
        int list_h = vis_rows > RTX_BROWSE_HEAD ? vis_rows : 8;
        int cmd = gui_ctrl() && IsKeyPressed(KEY_C) ? CMD_COPY :
                  gui_ctrl() && IsKeyPressed(KEY_X) ? CMD_CUT :
                  gui_ctrl() && IsKeyPressed(KEY_V) ? CMD_PASTE :
                  gui_ctrl() && IsKeyPressed(KEY_A) ? CMD_SEL_ALL : CMD_NONE;
        if (IsKeyPressed(KEY_ESCAPE)) {
            if (w->browse_close()) return 1;
        } else if (cmd) {
            if (gui_field_cmd(cmd, w, gf) && (cmd == CMD_CUT || cmd == CMD_PASTE))
                rtx_browse_refresh(br) !>;
            if (cmd == CMD_SEL_ALL) br->glob_focus = 1;
            while (GetCharPressed() > 0) { }
        } else if (gui_key(KEY_UP)) rtx_browse_move(br, -1, list_h);
        else if (gui_key(KEY_DOWN)) rtx_browse_move(br, 1, list_h);
        else if (br->glob_focus && gui_key(KEY_LEFT))
            rtx_field_move(gf, -1, gui_shift());
        else if (br->glob_focus && gui_key(KEY_RIGHT))
            rtx_field_move(gf, 1, gui_shift());
        else if (gui_key(KEY_LEFT)) w->browse_parent() !>;
        else if (gui_key(KEY_RIGHT) || IsKeyPressed(KEY_ENTER)) w->browse_enter() !>;
        else if (gui_key(KEY_BACKSPACE)) w->browse_backspace() !>;
        else {
            key = GetCharPressed();
            while (key > 0) {
                if (key >= 32 && key != 127) w->browse_type(key) !>;
                key = GetCharPressed();
            }
        }
        return 0;
    }
    if (IsKeyPressed(KEY_ESCAPE)) {
        *menu_open = -1;
        ui->help = !ui->help;
        return 0;
    }
    {
        int cmd = CMD_NONE;
        if (ui->help) {
            if (IsKeyPressed(KEY_S)) cmd = CMD_SAVE;
            else if (IsKeyPressed(KEY_Z)) cmd = CMD_UNDO;
            else if (IsKeyPressed(KEY_Y)) cmd = CMD_REDO;
            else if (IsKeyPressed(KEY_X)) cmd = CMD_CUT;
            else if (IsKeyPressed(KEY_C)) cmd = CMD_COPY;
            else if (IsKeyPressed(KEY_V)) cmd = CMD_PASTE;
            else if (IsKeyPressed(KEY_W)) cmd = CMD_PANE;
            else if (IsKeyPressed(KEY_N) || IsKeyPressed(KEY_TAB)) cmd = CMD_NEXT;
            else if (IsKeyPressed(KEY_BACKSLASH)) cmd = CMD_SPLIT;
            else if (IsKeyPressed(KEY_Q)) cmd = CMD_QUIT;
            else if (IsKeyPressed(KEY_G)) cmd = CMD_JUMP;
            else if (IsKeyPressed(KEY_F)) cmd = CMD_FIND;
            else if (IsKeyPressed(KEY_O))
                cmd = gui_shift() ? CMD_BROWSE : CMD_OPEN;
            else if (IsKeyPressed(KEY_A)) cmd = CMD_SEL_ALL;
            else if (IsKeyPressed(KEY_L)) cmd = CMD_VIEW;
            else if (IsKeyPressed(KEY_U)) cmd = CMD_FOLLOW;
            if (cmd == CMD_NONE) {
                while (GetCharPressed() > 0) { }
            } else {
                ui->help = 0;
            }
        } else if (gui_ctrl() && (IsKeyPressed(KEY_G) || IsKeyPressed(KEY_J))) {
            cmd = CMD_JUMP;
        } else if (gui_ctrl() && IsKeyPressed(KEY_F)) {
            cmd = CMD_FIND;
        } else if (gui_ctrl() && gui_shift() && IsKeyPressed(KEY_O)) {
            cmd = CMD_BROWSE;
        } else if (gui_ctrl() && IsKeyPressed(KEY_O)) {
            cmd = CMD_OPEN;
        } else if (gui_ctrl() && IsKeyPressed(KEY_S)) {
            cmd = CMD_SAVE;
        } else if (gui_ctrl() && IsKeyPressed(KEY_Z) && !gui_shift()) {
            cmd = CMD_UNDO;
        } else if ((gui_ctrl() && IsKeyPressed(KEY_Y)) ||
                   (gui_ctrl() && gui_shift() && IsKeyPressed(KEY_Z))) {
            cmd = CMD_REDO;
        } else if (gui_ctrl() && IsKeyPressed(KEY_C)) {
            cmd = CMD_COPY;
        } else if (gui_ctrl() && IsKeyPressed(KEY_X)) {
            cmd = CMD_CUT;
        } else if (gui_ctrl() && IsKeyPressed(KEY_V)) {
            cmd = CMD_PASTE;
        } else if (gui_ctrl() && IsKeyPressed(KEY_W)) {
            cmd = CMD_PANE;
        } else if (gui_ctrl() && (IsKeyPressed(KEY_TAB) || IsKeyPressed(KEY_N))) {
            cmd = CMD_NEXT;
        } else if (gui_ctrl() && IsKeyPressed(KEY_BACKSLASH)) {
            cmd = CMD_SPLIT;
        } else if (gui_ctrl() && IsKeyPressed(KEY_Q)) {
            cmd = CMD_QUIT;
        } else if (gui_ctrl() && IsKeyPressed(KEY_A)) {
            cmd = CMD_SEL_ALL;
        } else if (gui_ctrl() && IsKeyPressed(KEY_L)) {
            cmd = CMD_VIEW;
        } else if (gui_ctrl() && IsKeyPressed(KEY_U)) {
            cmd = CMD_FOLLOW;
        }
        if (cmd != CMD_NONE) {
            while (GetCharPressed() > 0) { }
            if (gui_run_cmd(cmd, w, act, m, text_w, vis_rows, ui, status,
                            status_n, quit_armed_at)) {
                return 1;
            }
            return 0;
        }
        if (ui->help) return 0;
        if (gui_key(KEY_HOME) || (gui_ctrl() && gui_key(KEY_LEFT))) {
            gui_home_end(act, 0, gui_shift(), gui_ctrl());
            gui_follow_caret(act);
            gui_reveal_caret(act, vis_rows);
            while (GetCharPressed() > 0) { }
        } else if (gui_key(KEY_END) || (gui_ctrl() && gui_key(KEY_RIGHT))) {
            gui_home_end(act, 1, gui_shift(), gui_ctrl());
            gui_follow_caret(act);
            gui_reveal_caret(act, vis_rows);
            while (GetCharPressed() > 0) { }
        } else if (!gui_ctrl() && (gui_key(KEY_UP) || gui_key(KEY_DOWN))) {
            int box = gui_alt();
            if (box) act->box_begin() !>;
            gui_move_vert(act, m, text_w, gui_key(KEY_UP) ? -1 : 1,
                          gui_shift() || box);
            if (box) act->box_sync() !>;
            gui_follow_caret(act);
            gui_reveal_caret(act, vis_rows);
            while (GetCharPressed() > 0) { }
        } else if (!gui_ctrl()) {
            if (gui_key(KEY_LEFT)) {
                if (gui_alt()) {
                    act->box_move_col(-1) !>;
                } else {
                    act->move_horiz(-1, gui_shift()) !>;
                }
                gui_follow_caret(act);
                gui_reveal_caret(act, vis_rows);
            }
            if (gui_key(KEY_RIGHT)) {
                if (gui_alt()) {
                    act->box_move_col(1) !>;
                } else {
                    act->move_horiz(1, gui_shift()) !>;
                }
                gui_follow_caret(act);
                gui_reveal_caret(act, vis_rows);
            }
            if (gui_key(KEY_BACKSPACE)) {
                act->backspace() !>;
                gui_after_edit(w, act, m, text_w, vis_rows) !>;
            }
            if (gui_key(KEY_DELETE)) {
                act->delete_forward() !>;
                gui_after_edit(w, act, m, text_w, vis_rows) !>;
            }
            if (gui_key(KEY_ENTER)) {
                act->doc.type("\n") !>;
                gui_after_edit(w, act, m, text_w, vis_rows) !>;
            }
            key = GetCharPressed();
            while (key > 0) {
                if (key >= 32 && key != 127) {
                    act->doc.type_cp((uint32_t)key) !>;
                    gui_after_edit(w, act, m, text_w, vis_rows) !>;
                }
                key = GetCharPressed();
            }
        }
    }
    return 0;
}

static void gui_sync_clip(RtxWs *w) {
    if (w->clip.ptr && w->clip.len) {
        cc_arena_stack(scratch, RTX_FRAME_SCRATCH);
        char[:] z = scratch.alloc_slice_bytes(w->clip.len + 1);
        if (z.ptr) {
            memcpy(z.ptr, w->clip.ptr, w->clip.len);
            z.ptr[w->clip.len] = 0;
            SetClipboardText(z.ptr);
        }
    }
}

static void !>(CCError) gui_from_os_clip(RtxWs *w) {
    const char *t = GetClipboardText();
    if (t && t[0]) return w->set_clip(cc_slice_cstr(t));
    return cc_ok();
}

static int gui_pane_at(RtxWs *w, int x, int pad, int inner) {
    if (w->npanes < 2) return 0;
    return x >= pad + inner / 2 ? 1 : 0;
}

static int gui_pane_x0(RtxWs *w, int pane, int pad, int inner) {
    return pad + (pane == 1 && w && w->npanes == 2 ? inner / 2 + 8 : 0);
}

static int gui_text_ph(int hh, int top, int find_on) {
    int ph = hh - top - 28 - (find_on ? GUI_FIND_H : 0);
    return ph > 0 ? ph : 0;
}

static int gui_scroll_hit(int mx, int my, int x0, int y0, int pane_w, int ph,
                          RtxBuf *b, int vis_rows) {
    int sx;
    if (!b || !b->scroll_needed(vis_rows)) return 0;
    sx = x0 + pane_w - GUI_SCROLL_W;
    return ph > 0 && mx >= sx && mx < x0 + pane_w && my >= y0 && my < y0 + ph;
}

static float gui_gutter_px(GuiFonts *fonts, RtxBuf *b, int vis_rows) {
    int g = rtx_gutter_cols_buf(b, vis_rows);
    return fonts->mono_sz * 0.6f * (float)g + 10.0f;
}

static double gui_text_w(GuiFonts *fonts, RtxBuf *b, int pane_w, int vis_rows) {
    int rw = (b && b->scroll_needed(vis_rows)) ? GUI_SCROLL_W : 0;
    double w = (double)pane_w - (double)gui_gutter_px(fonts, b, vis_rows) - (double)rw;
    return w < 8.0 ? 8.0 : w;
}

static void gui_layout_menus(void) {
    int x = 10;
    int i;
    for (i = 0; i < 4; i++) {
        gui_menus[i].x = x;
        gui_menus[i].w = 56;
        x += gui_menus[i].w;
    }
}

static void gui_draw_menubar(GuiFonts *fonts, int ww, int open, Vector2 mouse) {
    int i;
    DrawRectangle(0, 0, ww, GUI_MENU_H, (Color){36, 38, 46, 255});
    DrawLine(0, GUI_MENU_H - 1, ww, GUI_MENU_H - 1, (Color){70, 74, 86, 255});
    for (i = 0; i < 4; i++) {
        Vector2 pos;
        int hot = mouse.y >= 0 && mouse.y < GUI_MENU_H &&
                  mouse.x >= (float)gui_menus[i].x &&
                  mouse.x < (float)(gui_menus[i].x + gui_menus[i].w);
        if (open == i || hot) {
            DrawRectangle(gui_menus[i].x, 0, gui_menus[i].w, GUI_MENU_H,
                          (Color){56, 72, 110, 255});
        }
        pos.x = (float)(gui_menus[i].x + 10);
        pos.y = 5;
        DrawTextEx(fonts->mono, gui_menus[i].title, pos, 16, 0,
                   (Color){230, 232, 240, 255});
    }
    if (open >= 0 && open < 4) {
        GuiMenu *mn = &gui_menus[open];
        int drop_h = 8 + mn->n * GUI_ITEM_H;
        int j;
        DrawRectangle(mn->x, GUI_MENU_H, GUI_DROP_W, drop_h, (Color){32, 36, 48, 255});
        DrawRectangleLines(mn->x, GUI_MENU_H, GUI_DROP_W, drop_h,
                           (Color){120, 160, 210, 255});
        for (j = 0; j < mn->n; j++) {
            int iy = GUI_MENU_H + 4 + j * GUI_ITEM_H;
            Vector2 lp, sp;
            int ihot = mouse.x >= (float)mn->x &&
                       mouse.x < (float)(mn->x + GUI_DROP_W) &&
                       mouse.y >= (float)iy &&
                       mouse.y < (float)(iy + GUI_ITEM_H);
            if (ihot) {
                DrawRectangle(mn->x + 2, iy, GUI_DROP_W - 4, GUI_ITEM_H,
                              (Color){60, 90, 140, 255});
            }
            lp.x = (float)(mn->x + 12);
            lp.y = (float)(iy + 4);
            DrawTextEx(fonts->mono, mn->items[j].label, lp, 15, 0,
                       (Color){235, 238, 245, 255});
            sp.x = (float)(mn->x + GUI_DROP_W - 88);
            sp.y = (float)(iy + 4);
            DrawTextEx(fonts->mono, mn->items[j].shortcut, sp, 13, 0,
                       (Color){150, 165, 190, 255});
        }
    }
}

/* 0 = miss, 1 = toggled a title (cmd unused), 2 = chose an item. */
static int gui_menu_click(int mx, int my, int *open, int *cmd) {
    int i;
    *cmd = CMD_NONE;
    if (*open >= 0 && *open < 4) {
        GuiMenu *mn = &gui_menus[*open];
        if (mx >= mn->x && mx < mn->x + GUI_DROP_W &&
            my >= GUI_MENU_H && my < GUI_MENU_H + 4 + mn->n * GUI_ITEM_H) {
            int j = (my - GUI_MENU_H - 4) / GUI_ITEM_H;
            if (j >= 0 && j < mn->n) {
                *cmd = mn->items[j].cmd;
                *open = -1;
                return 2;
            }
        }
    }
    if (my >= 0 && my < GUI_MENU_H) {
        for (i = 0; i < 4; i++) {
            if (mx >= gui_menus[i].x && mx < gui_menus[i].x + gui_menus[i].w) {
                *open = (*open == i) ? -1 : i;
                return 1;
            }
        }
        *open = -1;
        return 1;
    }
    if (*open >= 0) {
        *open = -1;
        return 1;
    }
    return 0;
}

static void gui_draw_help(GuiFonts *fonts, int ww, int hh) {
    int n = 0;
    int i;
    int box_w = 520;
    int row_h = 24;
    int box_h;
    int x, y;
    float title_sz = 22;
    float line_sz = 18;
    Vector2 pos;
    while (rtx_help_lines[n]) n++;
    n += 1; /* GUI splits the shared browse line into open + in-app browser */
    box_h = 56 + n * row_h + 16;
    if (box_w > ww - 32) box_w = ww - 32;
    if (box_h > hh - 32) box_h = hh - 32;
    x = (ww - box_w) / 2;
    y = (hh - box_h) / 2;
    if (x < 16) x = 16;
    if (y < 16) y = 16;
    DrawRectangle(0, 0, ww, hh, (Color){0, 0, 0, 140});
    DrawRectangle(x, y, box_w, box_h, (Color){28, 36, 56, 255});
    DrawRectangleLines(x, y, box_w, box_h, (Color){140, 190, 240, 255});
    pos.x = (float)(x + 20);
    pos.y = (float)(y + 14);
    DrawTextEx(fonts->mono, "key bindings", pos, title_sz, 0,
               (Color){240, 240, 250, 255});
    {
        int row = 0;
        for (i = 0; rtx_help_lines[i]; i++) {
            const char *line = rtx_help_lines[i];
            pos.x = (float)(x + 24);
            pos.y = (float)(y + 48 + row * row_h);
            if (line[0] == 'o' && strstr(line, "browse")) {
                DrawTextEx(fonts->mono, "o  Ctrl-O         open (system dialog)",
                           pos, line_sz, 0, (Color){220, 230, 245, 255});
                row++;
                pos.y = (float)(y + 48 + row * row_h);
                DrawTextEx(fonts->mono, "O  Ctrl-Shift-O   in-app file browser",
                           pos, line_sz, 0, (Color){220, 230, 245, 255});
                row++;
                continue;
            }
            DrawTextEx(fonts->mono, line, pos, line_sz, 0,
                       (Color){220, 230, 245, 255});
            row++;
        }
    }
}

static void gui_draw_jump(GuiFonts *fonts, RtxUi *ui, int ww, int hh) {
    char line[64];
    int box_w = 420;
    int box_h = 88;
    int x = (ww - box_w) / 2;
    int y = (hh - box_h) / 2;
    Vector2 pos;
    if (x < 16) x = 16;
    if (y < 16) y = 16;
    DrawRectangle(0, 0, ww, hh, (Color){0, 0, 0, 140});
    DrawRectangle(x, y, box_w, box_h, (Color){28, 36, 56, 255});
    DrawRectangleLines(x, y, box_w, box_h, (Color){240, 200, 80, 255});
    pos.x = (float)(x + 20);
    pos.y = (float)(y + 16);
    DrawTextEx(fonts->mono, "jump to line or N%", pos, 20, 0, (Color){240, 240, 250, 255});
    snprintf(line, sizeof(line), "> %s%s", ui->jump_buf, rtx_ui_prompt_caret(ui));
    pos.y = (float)(y + 48);
    DrawTextEx(fonts->mono, line, pos, 22, 0, (Color){255, 220, 100, 255});
}

#define GUI_QUIT_W 460
#define GUI_QUIT_H 168
#define GUI_QUIT_BTN_W 120
#define GUI_QUIT_BTN_H 32

static void gui_quit_box(int ww, int hh, int *x, int *y) {
    *x = (ww - GUI_QUIT_W) / 2;
    *y = (hh - GUI_QUIT_H) / 2;
    if (*x < 16) *x = 16;
    if (*y < 16) *y = 16;
}

/* 1 = save, 2 = discard, 3 = cancel, 0 = miss. */
static int gui_quit_hit(int mx, int my, int ww, int hh) {
    int x, y, by, i;
    gui_quit_box(ww, hh, &x, &y);
    by = y + 112;
    if (my < by || my >= by + GUI_QUIT_BTN_H) return 0;
    for (i = 0; i < 3; i++) {
        int bx = x + 24 + i * (GUI_QUIT_BTN_W + 12);
        if (mx >= bx && mx < bx + GUI_QUIT_BTN_W) return i + 1;
    }
    return 0;
}

static void gui_draw_quit(GuiFonts *fonts, const RtxWs *w, int ww, int hh) {
    int x, y, i;
    size_t n;
    char line[80];
    Vector2 pos;
    Vector2 mouse = GetMousePosition();
    const char *labels[3];
    labels[0] = "Save";
    labels[1] = "Don't save";
    labels[2] = "Cancel";
    gui_quit_box(ww, hh, &x, &y);
    n = 0;
    if (w) {
        size_t di;
        for (di = 0; di < w->len; di++) {
            if (w->bufs[di].doc.dirty()) n++;
        }
    }
    DrawRectangle(0, 0, ww, hh, (Color){0, 0, 0, 160});
    DrawRectangle(x, y, GUI_QUIT_W, GUI_QUIT_H, (Color){36, 28, 32, 255});
    DrawRectangleLines(x, y, GUI_QUIT_W, GUI_QUIT_H, (Color){240, 140, 120, 255});
    pos.x = (float)(x + 24);
    pos.y = (float)(y + 18);
    DrawTextEx(fonts->mono, "Unsaved changes", pos, 22, 0,
               (Color){255, 230, 220, 255});
    if (n == 1) snprintf(line, sizeof(line), "1 file has unsaved edits.");
    else snprintf(line, sizeof(line), "%zu files have unsaved edits.", n);
    pos.y = (float)(y + 56);
    DrawTextEx(fonts->mono, line, pos, 16, 0, (Color){220, 210, 200, 255});
    pos.y = (float)(y + 80);
    DrawTextEx(fonts->mono, "Save before quitting?", pos, 16, 0,
               (Color){200, 190, 180, 255});
    for (i = 0; i < 3; i++) {
        int bx = x + 24 + i * (GUI_QUIT_BTN_W + 12);
        int by = y + 112;
        int hot = mouse.x >= (float)bx && mouse.x < (float)(bx + GUI_QUIT_BTN_W) &&
                  mouse.y >= (float)by && mouse.y < (float)(by + GUI_QUIT_BTN_H);
        DrawRectangle(bx, by, GUI_QUIT_BTN_W, GUI_QUIT_BTN_H,
                      hot ? (Color){70, 50, 48, 255} : (Color){48, 36, 40, 255});
        DrawRectangleLines(bx, by, GUI_QUIT_BTN_W, GUI_QUIT_BTN_H,
                           (Color){180, 120, 110, 255});
        pos.x = (float)(bx + 12);
        pos.y = (float)(by + 8);
        DrawTextEx(fonts->mono, labels[i], pos, 15, 0, (Color){240, 220, 210, 255});
    }
}

static float gui_mono_w(GuiFonts *fonts, float sz, const char *s) {
    Vector2 m;
    if (!fonts) return 0;
    m = MeasureTextEx(fonts->mono, s ? s : "", sz, 0);
    return m.x;
}

static float gui_field_cw(GuiFonts *fonts, float sz) {
    float cw = gui_mono_w(fonts, sz, "0");
    return cw > 1 ? cw : 8;
}

static size_t gui_field_hit_x(GuiFonts *fonts, float sz, RtxField f, float x) {
    float cw = gui_field_cw(fonts, sz);
    int col = x > 0 && cw > 0 ? (int)(x / cw + 0.5f) : 0;
    return rtx_utf8_hit_col(rtx_field_bytes(f), col);
}

static void gui_draw_field(GuiFonts *fonts, float sz, Vector2 pos, RtxField f,
                           const RtxUi *ui, Color fg) {
    char tmp[RTX_FIND_QMAX];
    size_t n = f.len ? *f.len : 0;
    float cw = gui_field_cw(fonts, sz);
    rtx_field_clamp(f);
    if (n >= sizeof(tmp)) n = sizeof(tmp) - 1;
    if (rtx_field_has_sel(f)) {
        float x1 = pos.x + cw * (float)rtx_utf8_prefix_cols(rtx_field_bytes(f),
                                                            rtx_field_lo(f));
        float x2 = pos.x + cw * (float)rtx_utf8_prefix_cols(rtx_field_bytes(f),
                                                            rtx_field_hi(f));
        if (x2 > x1)
            DrawRectangle((int)x1, (int)pos.y - 1, (int)(x2 - x1) + 1,
                          (int)sz + 4, (Color){60, 70, 110, 255});
    }
    if (f.buf && n) memcpy(tmp, f.buf, n);
    tmp[n] = 0;
    DrawTextEx(fonts->mono, tmp, pos, sz, 0, fg);
    if (ui && rtx_ui_blink(ui) && f.caret) {
        float cx = pos.x + cw * (float)rtx_utf8_prefix_cols(rtx_field_bytes(f),
                                                            *f.caret);
        DrawRectangle((int)cx, (int)pos.y, 2, (int)sz + 2,
                      (Color){255, 200, 80, 255});
    }
}

static int gui_field_cmd(int cmd, RtxWs *w, RtxField f) {
    @errhandler(CCError e) {
        (void)e;
        return 0;
    }
    if (cmd == CMD_COPY) {
        if (rtx_field_copy(w, f) !>) gui_sync_clip(w);
        return 1;
    }
    if (cmd == CMD_CUT) {
        rtx_field_cut(w, f) !>;
        gui_sync_clip(w);
        return 1;
    }
    if (cmd == CMD_PASTE) {
        gui_from_os_clip(w) !>;
        rtx_field_paste(w, f) !>;
        return 1;
    }
    if (cmd == CMD_SEL_ALL) {
        rtx_field_select_all(f);
        return 1;
    }
    return 0;
}

static void gui_draw_find(GuiFonts *fonts, RtxUi *ui, RtxDoc *d, int ww, int hh) {
    int y0 = hh - 26 - GUI_FIND_H;
    int vis_hits = RTX_UI_FIND_ROWS - 1;
    int i;
    char stats[64];
    Vector2 pos;
    float lab;
    if (y0 < GUI_MENU_H) y0 = GUI_MENU_H;
    rtx_ui_find_scroll(ui, d, (size_t)vis_hits);
    rtx_ui_find_stats(d, stats, sizeof(stats));
    DrawRectangle(0, y0, ww, GUI_FIND_H, (Color){28, 32, 44, 255});
    DrawLine(0, y0, ww, y0, (Color){80, 90, 110, 255});
    pos.x = 12;
    pos.y = (float)(y0 + 4);
    DrawTextEx(fonts->mono, "find: ", pos, 15, 0, (Color){255, 220, 100, 255});
    lab = gui_mono_w(fonts, 15, "find: ");
    pos.x = 12 + lab;
    gui_draw_field(fonts, 15, pos, rtx_ui_find_field(ui), ui,
                   (Color){255, 220, 100, 255});
    pos.x = 12 + lab + gui_mono_w(fonts, 15, ui->find_buf) + 16;
    DrawTextEx(fonts->mono, stats, pos, 15, 0, (Color){255, 220, 100, 255});
    for (i = 0; i < vis_hits; i++) {
        size_t hit = ui->find_top + (size_t)i;
        int y = y0 + 8 + (i + 1) * GUI_FIND_ROW_H;
        int cur = d && hit == d->find.cur;
        if (!d || hit >= d->find.len) continue;
        if (cur) {
            DrawRectangle(0, y - 2, ww, GUI_FIND_ROW_H, (Color){60, 70, 100, 255});
        }
        {
            char ctx[192];
            char line[256];
            size_t line1 = 0;
            int ok = 1;
            rtx_ui_find_row_text(d, hit, 80, ctx, sizeof(ctx), &line1) !>(e) {
                ok = 0;
            };
            if (ok) snprintf(line, sizeof(line), "%5zu  %s", line1, ctx);
            else snprintf(line, sizeof(line), "  %zu", hit + 1);
            pos.x = 12;
            pos.y = (float)y;
            DrawTextEx(fonts->mono, line, pos, 14, 0,
                       cur ? (Color){255, 230, 140, 255}
                           : (Color){200, 206, 220, 255});
        }
    }
}

static void gui_reveal_caret(RtxBuf *b, int vis_rows) {
    @errhandler(RtxIndexErr e) {
        (void)e;
        return; /* fault already set by line_* on err */
    }
    if (!b || b->unlock || b->pin_view) return;
    if (b->seek_valid) b->reveal_guess(b->doc.caret, vis_rows) !>;
    else b->reveal(vis_rows) !>;
}

static void gui_land(RtxBuf *b, int vis_rows) {
    @errhandler(RtxIndexErr e) {
        (void)e;
        return;
    }
    if (!b) return;
    b->reveal_guess(b->doc.caret, vis_rows) !>;
}

static double gui_hit_y(const RtxBuf *b, double y) {
    size_t s;
    if (!b) return y;
    for (s = 0; s < b->top_wrap && s < b->layout.len; s++) {
        y += b->layout.rows[s].height;
    }
    return y;
}

/* Returns 1 if the caller should quit. */
static int gui_run_cmd(int cmd, RtxWs *w, RtxBuf *act, RtxMeasure *m,
                       double text_w, int vis_rows, RtxUi *ui,
                       char *status, size_t status_n, size_t *quit_armed_at) {
    @errhandler(CCError e) {
        snprintf(status, status_n, "%s", e.message ? e.message : "error");
        return 0;
    }
    @errhandler(RtxIndexErr e) {
        (void)e;
        return 0;
    }
    if (cmd == CMD_SAVE) {
        act->doc.save() !>;
        snprintf(status, status_n, "saved");
        act->doc.break_coalesce();
    } else if (cmd == CMD_UNDO) {
        act->doc.undo() !>;
        gui_after_edit(w, act, m, text_w, vis_rows) !>;
    } else if (cmd == CMD_REDO) {
        act->doc.redo() !>;
        gui_after_edit(w, act, m, text_w, vis_rows) !>;
    } else if (cmd == CMD_CUT) {
        w->cut() !>;
        gui_sync_clip(w);
        gui_after_edit(w, act, m, text_w, vis_rows) !>;
    } else if (cmd == CMD_COPY) {
        if (w->copy() !>) gui_sync_clip(w);
    } else if (cmd == CMD_PASTE) {
        gui_from_os_clip(w) !>;
        w->paste() !>;
        gui_after_edit(w, act, m, text_w, vis_rows) !>;
    } else if (cmd == CMD_PANE) {
        w->focus_other();
    } else if (cmd == CMD_NEXT) {
        w->next_buf();
    } else if (cmd == CMD_SPLIT) {
        w->toggle_split();
    } else if (cmd == CMD_QUIT) {
        (void)quit_armed_at;
        if (rtx_ui_offer_quit(w, ui)) return 1;
        status[0] = 0;
    } else if (cmd == CMD_JUMP) {
        rtx_ui_start_jump(ui);
    } else if (cmd == CMD_FIND) {
        rtx_ui_start_find(ui);
        rtx_ui_find_apply(ui, &act->doc) !>;
        gui_land(act, vis_rows);
    } else if (cmd == CMD_OPEN) {
        char path[RTX_BROWSE_DIR];
        int pick;
        rtx_ui_clear_jump(ui);
        rtx_ui_clear_find(ui);
        ui->help = 0;
        pick = gui_pick_file(act, path, sizeof(path));
        if (pick < 0) {
            w->browse_start() !>;
        } else if (pick > 0) {
            w->open_in_pane(path) !>;
            g_need_layout = 1;
            g_dirty = 1;
            snprintf(status, status_n, "opened");
        }
    } else if (cmd == CMD_BROWSE) {
        rtx_ui_clear_jump(ui);
        rtx_ui_clear_find(ui);
        ui->help = 0;
        w->browse_start() !>;
    } else if (cmd == CMD_HELP) {
        ui->help = !ui->help;
    } else if (cmd == CMD_SEL_ALL) {
        act->doc.select_all();
    } else if (cmd == CMD_VIEW) {
        act->cycle_view(vis_rows) !>;
        snprintf(status, status_n, "view %s", rtx_layout_view_name(&act->layout));
    } else if (cmd == CMD_FOLLOW) {
        act->unlock = !act->unlock;
        if (!act->unlock) {
            gui_follow_caret(act);
            gui_reveal_caret(act, vis_rows);
        }
        snprintf(status, status_n, "%s", act->unlock ? "unlock" : "follow");
    }
    return 0;
}

static void gui_draw_hex_buf(RtxBuf *b, const RtxUi *ui, GuiFonts *fonts, int focused,
                             int x0, int y0, int pw, int ph) {
    size_t r;
    size_t n = b->len();
    int has = b->doc.has_sel();
    float cw;
    float row_h = 18.0f;
    int vis;
    static const char *hexd = "0123456789ABCDEF";
    Vector2 m0;
    (void)pw;
    @errhandler(RtxIndexErr e) {
        (void)e;
        return; /* fault already set by line_* on err */
    }
    m0 = MeasureTextEx(fonts->mono, "0", 14, 0);
    cw = m0.x > 1 ? m0.x : 8.0f;
    vis = (int)((float)ph / row_h);
    if (vis < 1) vis = 1;
    b->top_byte = rtx_hex_align(b->top_byte);
    for (r = 0; r < (size_t)vis; r++) {
        size_t off = rtx_hex_row_off(b->top_byte, r);
        unsigned char win[RTX_HEX_DUMP_WIN];
        unsigned char *row;
        RtxHexDumpCell dump[RTX_HEX_COLS];
        size_t take = (size_t)RTX_HEX_COLS;
        size_t look = 0;
        size_t tail = 0;
        size_t got = 0;
        size_t k;
        float y = (float)y0 + (float)r * row_h;
        float x;
        char off_s[16];
        Vector2 pos;
        if (y > (float)(y0 + ph)) break;
        if (off >= n && !(n == 0 && r == 0)) {
            pos.x = (float)x0;
            pos.y = y;
            DrawTextEx(fonts->mono, "~", pos, 14, 0, (Color){90, 90, 100, 255});
            continue;
        }
        if (take > n - off) take = n - off;
        look = rtx_hex_dump_look(off);
        tail = rtx_hex_dump_tail(off, take, n);
        {
            size_t wn = 0;
            size_t want = look + take + tail;
            if (want) {
                @errhandler(CCError e) {
                    (void)e;
                    wn = 0;
                }
                wn = b->read_at(off - look, (char *)win, want) !>;
            }
            if (wn > look) {
                got = wn - look;
                if (got > take) got = take;
            }
            rtx_hex_dump_row(win, wn, look, got, dump);
        }
        row = win + look;
        snprintf(off_s, sizeof(off_s), "%010zX", off);
        pos.x = (float)x0;
        pos.y = y;
        DrawTextEx(fonts->mono, off_s, pos, 14, 0, (Color){100, 140, 220, 255});
        x = (float)x0 + cw * 11.0f;
        for (k = 0; k < (size_t)RTX_HEX_COLS; k++) {
            size_t at = off + k;
            char pair[4];
            int sel = has && at < n && (b->doc.sel_covers(at) !>);
            int here = rtx_ui_here(ui, focused, b->doc.caret == at);
            if (k < got) {
                pair[0] = hexd[(row[k] >> 4) & 0xF];
                pair[1] = hexd[row[k] & 0xF];
            } else {
                pair[0] = ' ';
                pair[1] = ' ';
            }
            pair[2] = 0;
            if (sel) {
                DrawRectangle((int)x, (int)y, (int)(cw * 2.5f), (int)row_h,
                              (Color){40, 70, 120, 255});
            }
            if (here) {
                DrawRectangle((int)x, (int)y, 2, (int)row_h, (Color){255, 200, 80, 255});
            }
            pos.x = x;
            pos.y = y;
            DrawTextEx(fonts->mono, pair, pos, 14, 0, (Color){220, 220, 230, 255});
            x += cw * 3.0f;
        }
        x += cw * 2.0f;
        for (k = 0; k < (size_t)RTX_HEX_COLS; k++) {
            size_t at = off + k;
            const char *chs;
            Color fg;
            int sel = has && at < n && (b->doc.sel_covers(at) !>);
            int here = rtx_ui_here(ui, focused, b->doc.caret == at);
            if (k >= got || dump[k].kind == RTX_HEX_DUMP_EMPTY) chs = " ";
            else chs = dump[k].utf8;
            if (dump[k].kind == RTX_HEX_DUMP_CONT) fg = (Color){140, 150, 130, 255};
            else fg = (Color){200, 210, 180, 255};
            if (sel) {
                DrawRectangle((int)x, (int)y, (int)cw + 1, (int)row_h,
                              (Color){40, 70, 120, 255});
            }
            if (here) {
                DrawRectangle((int)x, (int)y, 2, (int)row_h, (Color){255, 200, 80, 255});
            }
            pos.x = x;
            pos.y = y;
            DrawTextEx(fonts->mono, chs, pos, 14, 0, fg);
            x += cw;
        }
    }
}

static size_t gui_hex_hit_byte(RtxBuf *b, GuiFonts *fonts, int x0, int y0, int ph,
                               float mx, float my) {
    float cw;
    float row_h = 18.0f;
    int row;
    Vector2 m0;
    m0 = MeasureTextEx(fonts->mono, "0", 14, 0);
    cw = m0.x > 1 ? m0.x : 8.0f;
    row = (int)((my - (float)y0) / row_h);
    if (row < 0) row = 0;
    (void)ph;
    return rtx_hex_hit_x(b->top_byte, b->len(), row, mx - (float)x0, cw);
}

static void gui_draw_browse(RtxBrowse *br, const RtxUi *ui, GuiFonts *fonts, int focused,
                            int x0, int y0, int pw, int ph, int vis_rows) {
    char line[512];
    char name[RTX_BROWSE_NAME + 2];
    char meta[40];
    size_t i, list;
    float row_h = 20.0f;
    float cw;
    int cols, meta_w;
    Vector2 m0;
    if (!br || !fonts) return;
    rtx_browse_scroll(br, vis_rows);
    m0 = MeasureTextEx(fonts->mono, "0", 14, 0);
    cw = m0.x > 1 ? m0.x : 8.0f;
    cols = (int)(((float)pw - 16.0f) / cw);
    if (cols < 2) cols = 2;
    meta_w = RTX_BROWSE_SIZE_W + 2 + RTX_BROWSE_MTIME_W;
    DrawRectangle(x0, y0, pw, ph, (Color){22, 24, 30, 255});
    snprintf(line, sizeof(line), "%s", br->dir);
    DrawTextEx(fonts->mono, line, (Vector2){(float)x0 + 8, (float)y0 + 2}, 14, 0,
               gui_face(RTX_BROWSE_FACE_PATH));
    {
        Vector2 gp;
        float lab;
        gp.x = (float)x0 + 8;
        gp.y = (float)y0 + row_h + 2;
        DrawTextEx(fonts->mono, "glob: ", gp, 14, 0, gui_face(RTX_BROWSE_FACE_GLOB));
        lab = gui_mono_w(fonts, 14, "glob: ");
        gp.x += lab;
        gui_draw_field(fonts, 14, gp, rtx_browse_field(br),
                       focused ? ui : NULL, gui_face(RTX_BROWSE_FACE_GLOB));
    }
    list = (vis_rows > RTX_BROWSE_HEAD) ? (size_t)(vis_rows - RTX_BROWSE_HEAD) : 0;
    for (i = 0; i < list; i++) {
        size_t idx = br->top + i;
        float y = (float)y0 + (float)(RTX_BROWSE_HEAD + i) * row_h;
        Color name_c;
        if (y > (float)(y0 + ph)) break;
        if (idx >= br->len) continue;
        if (focused && idx == br->cur) {
            DrawRectangle(x0, (int)y, pw, (int)row_h, (Color){40, 70, 120, 255});
        }
        snprintf(name, sizeof(name), "%s%s", br->ents[idx].name,
                 br->ents[idx].is_dir ? "/" : "");
        if (cols >= 10 + meta_w) {
            int name_max = cols - meta_w - 2;
            if (name_max < 1) name_max = 1;
            if ((int)strlen(name) > name_max) name[name_max] = 0;
        }
        name_c = gui_face(br->ents[idx].is_dir ? RTX_BROWSE_FACE_DIR
                                              : RTX_BROWSE_FACE_FILE);
        DrawTextEx(fonts->mono, name, (Vector2){(float)x0 + 8, y + 2}, 14, 0, name_c);
        if (cols >= 10 + meta_w) {
            Vector2 mw;
            rtx_browse_fmt_meta(meta, sizeof(meta), &br->ents[idx]);
            mw = MeasureTextEx(fonts->mono, meta, 14, 0);
            DrawTextEx(fonts->mono, meta,
                       (Vector2){(float)x0 + (float)pw - 8.0f - mw.x, y + 2},
                       14, 0, gui_face(RTX_BROWSE_FACE_DATE));
        }
    }
}

static void gui_draw_buf(RtxBuf *b, const RtxUi *ui, GuiFonts *fonts, int focused,
                         int x0, int y0, int pw, int ph, int pad) {
    size_t i;
    double acc = 0;
    int has = b->doc.has_sel();
    int vis_rows = ph > 0 ? (int)((float)ph / 18.0f) : 32;
    float gpx = gui_gutter_px(fonts, b, vis_rows);
    @errhandler(CCError e) {
        (void)e;
        return;
    }
    @errhandler(RtxIndexErr e) {
        (void)e;
        return; /* fault already set by line_* on err */
    }
    (void)pad;
    if (pw > 0 && ph > 0) {
        DrawRectangle(x0, y0, pw, ph,
                      focused ? (Color){28, 30, 36, 255} : (Color){16, 16, 20, 255});
        if (focused) DrawRectangle(x0, y0, 3, ph, (Color){80, 200, 220, 255});
    }
    if (rtx_layout_is_hex(&b->layout)) {
        gui_draw_hex_buf(b, ui, fonts, focused, x0, y0, pw, ph);
        return;
    }
    for (i = b->top_wrap; i < b->layout.len; i++) {
        RtxVisRow *row = &b->layout.rows[i];
        double y = (double)y0 + acc;
        acc += row->height;
        if (y + row->height < (double)y0) continue;
        if (y > (double)(y0 + ph)) break;
        {
            size_t k;
            double x = (double)x0 + (double)gpx;
            size_t line = row->line;
            size_t box_l0 = 0, box_l1 = 0;
            int box_row = 0;
            int show_ln = (i == 0 || b->layout.rows[i - 1].line != line);
            if (b->doc.sel_box) {
                rtx_doc_box_lines(&b->doc, &box_l0, &box_l1) !>;
                box_row = (line >= box_l0 && line <= box_l1);
            }
            cc_arena_stack(scratch, RTX_FRAME_SCRATCH);
            if (show_ln) {
                char ln[16];
                Vector2 lp;
                snprintf(ln, sizeof(ln), "%zu", line + 1);
                lp.x = (float)x0 + (focused ? 4.0f : 0);
                lp.y = (float)y;
                DrawTextEx(fonts->mono, ln, lp, 13, 0,
                           focused ? (Color){168, 172, 184, 255}
                                   : (Color){78, 82, 94, 255});
            }
            {
                size_t line_off = row->byte_start;
                if (box_row) {
                    size_t j = i;
                    while (j > 0 && b->layout.rows[j - 1].line == line) j--;
                    line_off = b->layout.rows[j].byte_start;
                }
            int span_ok = 1;
            char[:] bytes = cc_slice_empty();
            {
                @errhandler(CCError e) {
                    (void)e;
                    span_ok = 0;
                }
                bytes = b->scratch_span(&scratch, row->byte_start, row->byte_len) !>;
            }
            if (!span_ok) continue;
            k = 0;
            while (k < bytes.len) {
                RtxUtf8Cl cl = rtx_utf8_cluster(bytes, k);
                size_t step = cl.n ? cl.n : 1;
                size_t off = row->byte_start + k;
                RtxStyle st = b->doc.style_at(off);
                char tmp[RTX_UTF8_LOOK + 1];
                Vector2 pos;
                double gw;
                char[:] one = bytes.sub(k, k + step);
                if (step > RTX_UTF8_LOOK) step = RTX_UTF8_LOOK;
                memcpy(tmp, bytes.ptr + k, step);
                tmp[step] = 0;
                gw = gui_measure(fonts, one, st, row->sec);
                pos.x = (float)x;
                pos.y = (float)y;
                if (has && (b->doc.sel_covers(off) !>)) {
                    DrawRectangle((int)x, (int)y, (int)gw + 1, (int)row->height,
                                  (Color){40, 70, 120, 255});
                }
                if (rtx_ui_here(ui, focused, b->doc.caret == off ||
                    (box_row && (rtx_box_col_on_line(&b->doc, line, b->doc.box_ccol) !>) ==
                     off - line_off))) {
                    DrawRectangle((int)x, (int)y, 2, (int)row->height,
                                  (Color){255, 200, 80, 255});
                }
                DrawTextEx(gui_font(fonts, st, row->sec), tmp, pos,
                           gui_size(fonts, st, row->sec), 0, gui_hl_color(st.scope));
                x += gw;
                k += cl.n ? cl.n : 1;
            }
            if (rtx_ui_here(ui, focused, b->doc.caret == row->byte_start + row->byte_len ||
                (box_row &&
                 line_off + (rtx_box_col_on_line(&b->doc, line, b->doc.box_ccol) !>) ==
                 row->byte_start + row->byte_len))) {
                DrawRectangle((int)x, (int)y, 2, (int)row->height,
                              (Color){255, 200, 80, 255});
            }
            }
        }
    }
}

/* Shared scene state so macOS live-resize can repaint while PollInputEvents
 * is blocked inside AppKit's nested resize tracking loop. */
typedef struct {
    RtxWs *w;
    RtxMeasure *m;
    GuiFonts *fonts;
    RtxUi *ui;
    int *menu_open;
    char *status;
    int pad;
    int top;
    int ready;
    int painting;   /* live-resize paint in progress */
    int draw_open;  /* BeginDrawing without matching end/swap */
    int *dragging;
    int *scroll_grab;
    void *resize_observer;
    void *resize_center;
} GuiLive;

static GuiLive g_live;
static int g_busy_frame;
static char g_busy_msg[64];
static int g_busy_show;

static void gui_draw_busy_badge(void) {
    Vector2 pos;
    Color bg = {40, 36, 20, 230};
    Color fg = {255, 210, 80, 255};
    int ww;
    if (!g_busy_show || !g_busy_msg[0]) return;
    ww = GetScreenWidth();
    pos = (Vector2){(float)ww - 160.0f, 8.0f};
    if (pos.x < 8) pos.x = 8;
    DrawRectangle((int)pos.x - 8, (int)pos.y - 2, 152, 22, bg);
    if (g_live.fonts) {
        DrawTextEx(g_live.fonts->mono, g_busy_msg, pos, 14, 0, fg);
    } else {
        DrawText(g_busy_msg, (int)pos.x, (int)pos.y, 14, fg);
    }
}

static void gui_busy(void *ctx, const char *label, int pct) {
    const char *spin = "|/-\\";
    (void)ctx;
    if (!label) {
        g_busy_show = 0;
        g_busy_msg[0] = 0;
        return;
    }
    if (pct >= 0) {
        snprintf(g_busy_msg, sizeof(g_busy_msg), "%c %s %d%%",
                 spin[g_busy_frame++ & 3], label, pct);
    } else {
        snprintf(g_busy_msg, sizeof(g_busy_msg), "%c %s",
                 spin[g_busy_frame++ & 3], label);
    }
    g_busy_show = 1;
    /* Overlay only. A spinner-only Begin/EndDrawing swaps a torn frame. */
    if (g_live.draw_open && IsWindowReady()) gui_draw_busy_badge();
}

static void gui_geom(int *ww, int *hh, int *inner, int *pane_w, int *vis_rows,
                     int pad, int top, int find_on) {
    *ww = GetScreenWidth();
    *hh = GetScreenHeight();
    *inner = *ww - 2 * pad;
    if (*inner < 40) *inner = 40;
    *pane_w = (g_live.w && g_live.w->npanes >= 2) ? (*inner / 2 - 8) : *inner;
    *vis_rows = (*hh - top - 28 - (find_on ? GUI_FIND_H : 0)) / 20;
    if (*vis_rows < 4) *vis_rows = 4;
}

static void !>(CCError) gui_relayout(int pane_w, int vis_rows) {
    int p;
    if (!g_live.w || !g_live.m || !g_live.fonts) {
        return cc_err(CC_ERR_INVALID_ARG, "live layout");
    }
    for (p = 0; p < g_live.w->npanes; p++) {
        RtxBuf *b = &g_live.w->bufs[g_live.w->pane[p]];
        int held = RtxWs_hold_pane(g_live.w, p);
        if (rtx_layout_is_hex(&b->layout)) {
            b->ensure_view(g_live.m, gui_text_w(g_live.fonts, b, pane_w, vis_rows),
                            vis_rows) !>(e) {
                RtxWs_drop_pane(g_live.w, p, held);
                return cc_err(e);
            };
            RtxWs_drop_pane(g_live.w, p, held);
            continue;
        }
        {
            size_t nlines = b->line_count();
            if (!b->seek_valid && b->top >= nlines && nlines) b->top = nlines - 1;
        }
        b->ensure_view(g_live.m, gui_text_w(g_live.fonts, b, pane_w, vis_rows),
                        vis_rows) !>(e) {
            RtxWs_drop_pane(g_live.w, p, held);
            return cc_err(e);
        };
        RtxWs_drop_pane(g_live.w, p, held);
    }
    return cc_ok();
}

static void gui_draw_scroll(RtxBuf *b, int focused, int x0, int y0, int pane_w,
                            int ph, int vis_rows) {
    RtxScrollRail rail;
    int ty, th;
    int sx;
    Color track, thumb;
    @errhandler(RtxIndexErr e) {
        (void)e;
        return; /* fault already set by line_* on err */
    }
    if (!b || ph < 1) return;
    if (!b->scroll_needed(vis_rows) && !b->drag_len) return;
    rail = b->scroll_rail(vis_rows) !>;
    if (focused && g_live.dragging && *g_live.dragging == GUI_DRAG_SCROLL &&
        b->drag_len) {
        rail.vis = b->drag_vis ? b->drag_vis : rail.vis;
        rail.len = b->drag_len;
    }
    rtx_scroll_rail_thumb(&rail, ph, GUI_SCROLL_MIN_TH, &ty, &th);
    if (focused && g_live.dragging && *g_live.dragging == GUI_DRAG_SCROLL &&
        g_live.scroll_grab) {
        int ly = (int)GetMouseY() - y0 - *g_live.scroll_grab;
        int usable = ph - th;
        if (ly < 0) ly = 0;
        if (usable > 0 && ly > usable) ly = usable;
        ty = ly;
    }
    sx = x0 + pane_w - GUI_SCROLL_W;
    if (rail.ready) {
        track = (Color){32, 34, 40, 255};
        thumb = focused ? (Color){90, 96, 112, 255} : (Color){70, 74, 86, 255};
        DrawRectangle(sx, y0, GUI_SCROLL_W, ph, track);
        DrawRectangle(sx + 2, y0 + ty, GUI_SCROLL_W - 4, th, thumb);
    } else {
        track = (Color){28, 30, 36, 255};
        thumb = focused ? (Color){70, 78, 96, 255} : (Color){56, 60, 72, 255};
        DrawRectangle(sx, y0, GUI_SCROLL_W, ph, track);
        DrawRectangle(sx + 3, y0 + ty, GUI_SCROLL_W - 6, th, thumb);
        DrawRectangle(sx + 2, y0 + ph - 3, GUI_SCROLL_W - 4, 2,
                      (Color){110, 90, 50, 255});
    }
}

/* Draw contents only. Caller owns BeginDrawing / EndDrawing or flush+swap. */
static void gui_draw_body(int ww, int hh, int pad, int top, int pane_w, int inner,
                          int vis_rows) {
    int p;
    RtxBuf *act;
    int ph;
    @errhandler(RtxIndexErr e) {
        (void)e;
        return; /* fault already set by line_* on err */
    }
    if (!g_live.w || !g_live.fonts || !g_live.ui) return;
    act = RtxWs_active(g_live.w);
    ph = gui_text_ph(hh, top, g_live.ui->find);
    ClearBackground((Color){24, 24, 28, 255});
    for (p = 0; p < g_live.w->npanes; p++) {
        RtxBuf *b = &g_live.w->bufs[g_live.w->pane[p]];
        int x0 = gui_pane_x0(g_live.w, p, pad, inner);
        if (g_live.w->npanes == 2 && p == 1) {
            DrawLine(pad + inner / 2, top, pad + inner / 2,
                     hh - 28 - (g_live.ui->find ? GUI_FIND_H : 0),
                     (Color){80, 80, 90, 255});
        }
        {
            RtxBrowse *br = &g_live.w->nav[p];
            int held = RtxWs_hold_pane(g_live.w, p);
            if (br && br->on) {
                gui_draw_browse(br, g_live.ui, g_live.fonts, p == g_live.w->focus,
                                x0, top, pane_w, ph, vis_rows);
            } else {
                gui_draw_buf(b, g_live.ui, g_live.fonts, p == g_live.w->focus,
                             x0, top, pane_w, ph, pad);
                gui_draw_scroll(b, p == g_live.w->focus, x0, top, pane_w, ph, vis_rows);
            }
            RtxWs_drop_pane(g_live.w, p, held);
        }
    }
    gui_draw_menubar(g_live.fonts, ww, g_live.menu_open ? *g_live.menu_open : -1,
                     GetMousePosition());
    if (g_live.ui->help) gui_draw_help(g_live.fonts, ww, hh);
    if (g_live.ui->jump) gui_draw_jump(g_live.fonts, g_live.ui, ww, hh);
    if (g_live.ui->find && act) gui_draw_find(g_live.fonts, g_live.ui, &act->doc, ww, hh);
    if (g_live.ui->ask_quit) gui_draw_quit(g_live.fonts, g_live.w, ww, hh);
    {
        const char *path = (act && act->doc.path.ptr) ? act->doc.path.ptr : "(untitled)";
        const char *star = (act && act->doc.dirty()) ? "*" : "";
        const char *status = g_live.status ? g_live.status : "";
        char bar[256];
        Vector2 bp;
        if (g_live.ui->ask_quit) {
            snprintf(bar, sizeof(bar), "unsaved  S save  Q don't save  Esc cancel  %s",
                     status);
        } else if (g_live.ui->jump) {
            rtx_ui_jump_header(g_live.ui, bar, sizeof(bar));
        } else if (g_live.ui->find) {
            snprintf(bar, sizeof(bar), "find  up/down hits  Esc close  %s", status);
        } else if (RtxWs_browsing(g_live.w)) {
            RtxBrowse *br = RtxWs_browse(g_live.w);
            snprintf(bar, sizeof(bar), "browse  %zu/%zu%s  enter open  Esc %s  %s",
                     br && br->len ? br->cur + 1 : 0, br ? br->len : 0,
                     br && br->truncated ? "  capped" : "",
                     br && br->boot ? "quit" : "close", status);
        } else if (act && rtx_layout_is_hex(&act->layout)) {
            snprintf(bar, sizeof(bar), "%s%s  @%zX  hex%s  %s",
                     star, path, act->doc.caret,
                     act->unlock ? "  unlock" : "", status);
        } else {
            char pos[32];
            rtx_status_line_pos(act ? &act->doc : NULL, pos, sizeof(pos)) !>;
            snprintf(bar, sizeof(bar), "%s%s  %s%s  %s",
                     star, path, pos,
                     (act && act->unlock) ? "  unlock" : "", status);
        }
        DrawRectangle(0, hh - 26, ww, 26, (Color){36, 38, 46, 255});
        bp.x = 12;
        bp.y = (float)(hh - 22);
        DrawTextEx(g_live.fonts->mono, bar, bp, 14, 0, (Color){170, 174, 186, 255});
    }
    gui_draw_busy_badge();
}

/* Paint + swap without PollInputEvents (unsafe to nest inside a resize).
 * Only safe when no BeginDrawing is open — EndDrawing has already swapped
 * before it polls, so resize notifications land in that window. */
static void gui_live_paint(void) {
    int ww, hh, inner, pane_w, vis_rows;
    if (!g_live.ready || g_live.painting || g_live.draw_open) return;
    g_live.painting = 1;
    @errhandler(CCError e) {
        (void)e;
        g_live.painting = 0;
        g_live.draw_open = 0;
        return;
    }
    gui_geom(&ww, &hh, &inner, &pane_w, &vis_rows, g_live.pad, g_live.top,
             g_live.ui && g_live.ui->find);
    gui_relayout(pane_w, vis_rows) !>;
    g_need_layout = 0;
    g_dirty = 1;
    BeginDrawing();
    g_live.draw_open = 1;
    gui_draw_body(ww, hh, g_live.pad, g_live.top, pane_w, inner, vis_rows);
    rlDrawRenderBatchActive();
    SwapScreenBuffer();
    g_live.draw_open = 0;
    g_live.painting = 0;
}

#if defined(__APPLE__)
static void rtx_on_window_resize(id self, SEL cmd, id note) {
    (void)self;
    (void)cmd;
    (void)note;
    gui_live_paint();
}

static void gui_install_live_resize(void) {
    Class cls;
    id observer;
    id center;
    id name;
    id window;

    window = (id)GetWindowHandle();
    if (!window) return;

    cls = objc_allocateClassPair(objc_getClass("NSObject"), "RtxGuiResizeObserver", 0);
    if (!cls) return;
    class_addMethod(cls, sel_getUid("onResize:"), (IMP)rtx_on_window_resize, "v@:@");
    objc_registerClassPair(cls);

    observer = ((id (*)(id, SEL))objc_msgSend)((id)cls, sel_getUid("new"));
    center = ((id (*)(id, SEL))objc_msgSend)(
        (id)objc_getClass("NSNotificationCenter"), sel_getUid("defaultCenter"));
    name = ((id (*)(id, SEL, const char *))objc_msgSend)(
        (id)objc_getClass("NSString"), sel_getUid("stringWithUTF8String:"),
        "NSWindowDidResizeNotification");
    ((void (*)(id, SEL, id, SEL, id, id))objc_msgSend)(
        center, sel_getUid("addObserver:selector:name:object:"),
        observer, sel_getUid("onResize:"), name, window);
    g_live.resize_observer = (void *)observer;
    g_live.resize_center = (void *)center;
}

static void gui_uninstall_live_resize(void) {
    id center = (id)g_live.resize_center;
    id observer = (id)g_live.resize_observer;
    if (center && observer) {
        ((void (*)(id, SEL, id))objc_msgSend)(
            center, sel_getUid("removeObserver:"), observer);
        ((void (*)(id, SEL))objc_msgSend)(observer, sel_getUid("release"));
    }
    g_live.resize_observer = NULL;
    g_live.resize_center = NULL;
}
#else
static void gui_install_live_resize(void) {
}
static void gui_uninstall_live_resize(void) {
}
#endif

int main(int argc, char **argv) {
    @errhandler(CCError e) { cc_error_log(e); return 1; }
    RtxWs w = {0} @destroy;
    RtxMeasure m;
    GuiFonts fonts;
    char *filebuf[32];
    RtxCli cli;
    const char *prog;
    int ww = 960;
    int hh = 640;
    int pad = 16;
    int top = GUI_MENU_H + 8;
    int dragging = 0;
    int scroll_grab = 0;
    size_t quit_armed_at = (size_t)-1;
    int close_held = 0;
    int menu_open = -1;
    char status[160];
    RtxUi ui;

    prog = (argc > 0 && argv[0] && argv[0][0]) ? argv[0] : "cctext-ray";
    if (rtx_cli_parse(argc, argv, filebuf, 32, &cli) != 0) {
        rtx_cli_usage(stderr, prog);
        return 2;
    }
    if (cli.help) {
        rtx_cli_usage(stdout, prog);
        return 0;
    }
    if (cli.version) {
        rtx_cli_print_version(stdout, prog);
        return 0;
    }
    if (cli.nfiles == 0) {
        w.open_files(0, NULL) !>;
        if (w.len) rtx_layout_set_view(&w.bufs[0].layout, cli.view);
    } else {
        w.open_files(cli.nfiles, filebuf) !>;
        w.set_views(cli.file_view, cli.nfiles);
    }
    status[0] = 0;
    memset(&ui, 0, sizeof(ui));
    if (cli.nfiles == 0 || w.untitled()) w.browse_start() !>;

    SetConfigFlags(FLAG_WINDOW_RESIZABLE | FLAG_WINDOW_HIGHDPI);
    InitWindow(ww, hh, "cctext");
    SetExitKey(0);
    SetTargetFPS(60);
    gui_install_live_resize();

    {
        Vector2 dpi = GetWindowScaleDPI();
        float scale = dpi.y > 1.0f ? dpi.y : 1.0f;
        fonts.mono_sz = 16;
        fonts.prose_sz = 17;
        fonts.mono = gui_load_font(gui_mono_paths, (int)(fonts.mono_sz * scale + 0.5f),
                                   &fonts.owned_mono);
        fonts.prose = gui_load_font(gui_prose_paths, (int)(fonts.prose_sz * scale + 0.5f),
                                    &fonts.owned_prose);
    }
    w.busy_bind(gui_busy, NULL);
    gui_layout_menus();

    m.measure = gui_measure;
    m.line_height = gui_lh;
    m.ctx = &fonts;

    g_live.w = &w;
    g_live.m = &m;
    g_live.fonts = &fonts;
    g_live.ui = &ui;
    g_live.menu_open = &menu_open;
    g_live.status = status;
    g_live.pad = pad;
    g_live.top = top;
    g_live.dragging = &dragging;
    g_live.scroll_grab = &scroll_grab;
    g_live.ready = 1;

    for (;;) {
        /*
         * Host close is a one-shot offer into ask_quit. Cancel dismisses the
         * prompt; Raylib latches shouldClose so chrome-X will not re-fire —
         * further quit is menu / Ctrl-Q, or save-then-exit while still latched.
         */
        if (WindowShouldClose()) {
            if (!w.any_dirty()) break;
            if (!ui.ask_quit && !close_held) rtx_ui_offer_quit(&w, &ui);
            close_held = 1;
            g_dirty = 1;
        } else {
            close_held = 0;
        }
        int p;
        int inner;
        int pane_w;
        int vis_rows;
        int saw;
        RtxBuf *act;
        saw = gui_saw_input(dragging, menu_open);
        if (saw) gui_blink_show(&ui);
        gui_geom(&ww, &hh, &inner, &pane_w, &vis_rows, pad, top, ui.find);
        act = w.active();
        if (act && ui.find) {
            size_t caret0 = act->doc.caret;
            int was_done = act->doc.find.done;
            rtx_ui_find_pump(&ui, &act->doc) !>;
            if (act->doc.caret != caret0) {
                gui_land(act, vis_rows);
                g_need_layout = 1;
                g_dirty = 1;
            } else if (act->doc.find.done != was_done) {
                g_dirty = 1;
            }
        }

        if (saw || g_need_layout) {
            for (p = 0; p < w.npanes; p++) {
                RtxBuf *b = &w.bufs[w.pane[p]];
                int held = w.hold_pane(p);
                size_t nlines = b->line_count();
                if (p == w.focus && dragging != GUI_DRAG_SCROLL) {
                    if (w.nav[p].on) {
                        int wheel = (int)GetMouseWheelMove();
                        int list_h = vis_rows > RTX_BROWSE_HEAD ? vis_rows : 8;
                        while (wheel > 0) {
                            rtx_browse_move(&w.nav[p], -1, list_h);
                            wheel--;
                        }
                        while (wheel < 0) {
                            rtx_browse_move(&w.nav[p], 1, list_h);
                            wheel++;
                        }
                    } else {
                        gui_wheel(b, &m, gui_text_w(&fonts, b, pane_w, vis_rows));
                    }
                }
                if (!b->seek_valid && b->top >= nlines && nlines) b->top = nlines - 1;
                w.drop_pane(p, held);
            }
            gui_relayout(pane_w, vis_rows) !>;
            g_need_layout = 0;
        }
        act = w.active();

        if (gui_handle_input(&w, act, &m, &fonts, &ui, status, sizeof(status),
                             &quit_armed_at, &menu_open, &dragging, &scroll_grab,
                             pane_w, vis_rows, pad, top, inner, hh)) {
            break;
        }
        act = w.active();
        if (g_need_layout || (act && dragging != GUI_DRAG_SCROLL &&
            !act->seek_valid && act->layout.from_line != act->top)) {
            gui_relayout(pane_w, vis_rows) !>;
            g_need_layout = 0;
        }

        if (rtx_ui_blink_step(&ui)) g_dirty = 1;
        if (ui.find && act && !act->doc.find.done) g_dirty = 1;
        if (g_busy_show) g_dirty = 1;

        if (g_dirty) {
            BeginDrawing();
            g_live.draw_open = 1;
            gui_draw_body(ww, hh, pad, top, pane_w, inner, vis_rows);
            g_live.draw_open = 0;
            EndDrawing();
            g_dirty = 0;
        } else {
            gui_idle_wait(&ui);
        }
    }

    g_live.ready = 0;
    w.busy_bind(NULL, NULL);
    gui_uninstall_live_resize();
    if (fonts.owned_mono) UnloadFont(fonts.mono);
    if (fonts.owned_prose) UnloadFont(fonts.prose);
    CloseWindow();
    return 0;
}
