#!ccc ccs
/*
 * raytext — Raylib GPU frontend. Same document/layout/highlight as cctext.
 * #include <raylib.h> is ordinary C; host cc sees the types.
 *
 *   raytext [file ...]
 *   File / Edit / View / Go menu bar
 *   Esc key-binding overlay   Ctrl-G jump   Ctrl-F find
 */
#include <ccc/std/prelude.cch>
#include <ccc/script/stdio.cch>
#include <stdio.h>
#include <string.h>
#include <raylib.h>
#include <rlgl.h>
#if defined(__APPLE__)
#include <objc/message.h>
#include <objc/runtime.h>
#endif
#include "../core/document.cch"
#include "../core/layout.cch"
#include "../core/workspace.cch"

#define GUI_MENU_H 28
#define GUI_ITEM_H 26
#define GUI_DROP_W 240

typedef struct {
    Font mono;
    Font prose;
    float mono_sz;
    float prose_sz;
    int owned_mono;
    int owned_prose;
} GuiFonts;

typedef struct {
    const char *label;
    const char *shortcut;
    int cmd;
} GuiMenuItem;

typedef struct {
    const char *title;
    const GuiMenuItem *items;
    int n;
    int x;
    int w;
} GuiMenu;

enum {
    CMD_NONE = 0,
    CMD_SAVE,
    CMD_UNDO,
    CMD_REDO,
    CMD_CUT,
    CMD_COPY,
    CMD_PASTE,
    CMD_PANE,
    CMD_NEXT,
    CMD_SPLIT,
    CMD_QUIT,
    CMD_JUMP,
    CMD_FIND,
    CMD_HELP,
    CMD_SEL_ALL,
    CMD_WRAP
};

static const GuiMenuItem gui_file_items[] = {
    {"Save", "Ctrl-S", CMD_SAVE},
    {"Quit", "Ctrl-Q", CMD_QUIT},
};
static const GuiMenuItem gui_edit_items[] = {
    {"Undo", "Ctrl-Z", CMD_UNDO},
    {"Redo", "Ctrl-Y", CMD_REDO},
    {"Select all", "Ctrl-A", CMD_SEL_ALL},
    {"Cut", "Ctrl-X", CMD_CUT},
    {"Copy", "Ctrl-C", CMD_COPY},
    {"Paste", "Ctrl-V", CMD_PASTE},
};
static const GuiMenuItem gui_view_items[] = {
    {"Cycle view", "Ctrl-L", CMD_WRAP},
    {"Split", "Ctrl-\\", CMD_SPLIT},
    {"Next file", "Ctrl-N", CMD_NEXT},
    {"Other pane", "Ctrl-W", CMD_PANE},
    {"Key bindings", "Esc", CMD_HELP},
};
static const GuiMenuItem gui_go_items[] = {
    {"Jump to line", "Ctrl-G", CMD_JUMP},
    {"Find", "Ctrl-F", CMD_FIND},
};

static GuiMenu gui_menus[] = {
    {"File", gui_file_items, 2, 0, 0},
    {"Edit", gui_edit_items, 6, 0, 0},
    {"View", gui_view_items, 5, 0, 0},
    {"Go", gui_go_items, 2, 0, 0},
};

static const char *gui_mono_paths[] = {
    "/System/Library/Fonts/SFNSMono.ttf",
    "/System/Library/Fonts/Monaco.ttf",
    "/System/Library/Fonts/Supplemental/Andale Mono.ttf",
    "/System/Library/Fonts/Supplemental/Courier New.ttf",
    "/System/Library/Fonts/Menlo.ttc",
    NULL
};
static const char *gui_prose_paths[] = {
    "/System/Library/Fonts/Supplemental/Georgia.ttf",
    "/System/Library/Fonts/Supplemental/Arial.ttf",
    NULL
};

static Font gui_load_font(const char **paths, int px, int *owned) {
    int cps[224];
    int i;
    *owned = 0;
    for (i = 0; i < 224; i++) cps[i] = 32 + i;
    for (i = 0; paths[i]; i++) {
        Font f;
        if (!FileExists(paths[i])) continue;
        f = LoadFontEx(paths[i], px, cps, 224);
        if (f.texture.id && f.glyphCount >= 90) {
            SetTextureFilter(f.texture, TEXTURE_FILTER_BILINEAR);
            *owned = 1;
            return f;
        }
        if (f.texture.id) UnloadFont(f);
    }
    return GetFontDefault();
}

static Font gui_font(GuiFonts *f, RtxStyle st, RtxSectionKind sec) {
    if (sec == RTX_SEC_CODE || st.mono) return f->mono;
    return f->prose;
}

static float gui_size(GuiFonts *f, RtxStyle st, RtxSectionKind sec) {
    if (sec == RTX_SEC_CODE || st.mono) return f->mono_sz;
    return f->prose_sz;
}

static double gui_measure(void *ctx, char[:] bytes, RtxStyle style, RtxSectionKind sec) {
    GuiFonts *f = (GuiFonts *)ctx;
    double w = 0;
    size_t i;
    if (!f || bytes.len == 0) return 0;
    for (i = 0; i < bytes.len; i++) {
        char tmp[8];
        Vector2 sz;
        tmp[0] = bytes.ptr ? bytes.ptr[i] : ' ';
        tmp[1] = 0;
        sz = MeasureTextEx(gui_font(f, style, sec), tmp, gui_size(f, style, sec), 0);
        w += (double)sz.x;
    }
    return w;
}

static double gui_lh(void *ctx, RtxStyle style, RtxSectionKind sec) {
    GuiFonts *f = (GuiFonts *)ctx;
    if (!f) return 20;
    return (double)gui_size(f, style, sec) * 1.25;
}

static Color gui_hl_color(RtxHlKind hl) {
    switch (hl) {
        case RTX_HL_KEYWORD: return (Color){80, 200, 220, 255};
        case RTX_HL_STRING:  return (Color){120, 200, 120, 255};
        case RTX_HL_COMMENT: return (Color){140, 140, 140, 255};
        case RTX_HL_NUMBER:  return (Color){220, 180, 80, 255};
        default:             return (Color){230, 230, 230, 255};
    }
}

static int gui_ctrl(void) {
    return IsKeyDown(KEY_LEFT_CONTROL) || IsKeyDown(KEY_RIGHT_CONTROL) ||
           IsKeyDown(KEY_LEFT_SUPER) || IsKeyDown(KEY_RIGHT_SUPER);
}

static int gui_shift(void) {
    return IsKeyDown(KEY_LEFT_SHIFT) || IsKeyDown(KEY_RIGHT_SHIFT);
}

static int gui_alt(void) {
    return IsKeyDown(KEY_LEFT_ALT) || IsKeyDown(KEY_RIGHT_ALT);
}

/* Initial press or OS key-repeat. Commands stay on IsKeyPressed. */
static int gui_key(int key) {
    return IsKeyPressed(key) || IsKeyPressedRepeat(key);
}

static size_t gui_hex_hit_byte(RtxBuf *b, GuiFonts *fonts, int x0, int y0, int ph,
                               float mx, float my);
static void gui_draw_hex_buf(RtxBuf *b, GuiFonts *fonts, int focused, int x0, int y0,
                             int pw, int ph);

static void !>(CCError) gui_ensure_view(RtxBuf *b, RtxMeasure *m, double width, int vis_rows) {
    size_t nlines;
    size_t want;
    size_t avail;
    size_t need;
    size_t n;
    size_t rows;
    if (!b) return cc_err(CC_ERR_INVALID_ARG, "null buf");
    if (vis_rows < 1) vis_rows = 1;
    if (rtx_layout_is_hex(&b->layout)) {
        n = b->len();
        rows = rtx_hex_row_count(n);
        b->top_byte = rtx_hex_align(b->top_byte);
        if (rows > 0) {
            size_t last_top = (rows - 1) * (size_t)RTX_HEX_COLS;
            if (b->top_byte > last_top) b->top_byte = last_top;
        } else {
            b->top_byte = 0;
        }
        (void)m;
        (void)width;
        return cc_ok();
    }
    nlines = b->line_count();
    if (b->top >= nlines && nlines) b->top = nlines - 1;
    want = (size_t)vis_rows + 8;
    avail = (b->top < nlines) ? (nlines - b->top) : 0;
    need = want < avail ? want : avail;
    /* Rebuild on width/scroll change, and when the window grows taller. */
    if (b->layout_width != width || b->layout.from_line != b->top ||
        b->layout.len == 0 || b->layout.nlines < need ||
        (b->layout.wrap && b->layout.len < want + b->top_wrap)) {
        size_t min_rows = want + b->top_wrap;
        b->layout.fill(&b->doc, m, width, b->top, min_rows) !>(e) { return cc_err(e); };
        b->layout_width = width;
    }
    return cc_ok();
}

static void !>(CCError) gui_after_edit(RtxBuf *b, RtxMeasure *m, double width, int vis_rows) {
    b->clear_pref();
    if (!rtx_layout_is_hex(&b->layout)) {
        b->layout.view_after_edit(&b->doc, m, width) !>(e) { return cc_err(e); };
        b->layout_width = width;
    }
    gui_ensure_view(b, m, width, vis_rows) !>(e) { return cc_err(e); };
    b->reveal(vis_rows);
    return gui_ensure_view(b, m, width, vis_rows);
}

static void gui_wheel(RtxBuf *b, RtxMeasure *m, double width) {
    int wheel;
    if (!b) return;
    wheel = (int)GetMouseWheelMove();
    while (wheel > 0) {
        b->scroll_vis(m, width, -1) !>(e) { (void)e; return; };
        wheel--;
    }
    while (wheel < 0) {
        b->scroll_vis(m, width, 1) !>(e) { (void)e; return; };
        wheel++;
    }
}

static void gui_move_vert(RtxBuf *b, RtxMeasure *m, double width, int dir, int shift) {
    if (!b) return;
    if (rtx_layout_is_hex(&b->layout)) {
        size_t n = b->len();
        size_t at = b->doc.caret;
        if (dir < 0) {
            if (at >= (size_t)RTX_HEX_COLS) at -= (size_t)RTX_HEX_COLS;
            else at = 0;
        } else if (n) {
            at += (size_t)RTX_HEX_COLS;
            if (at >= n) at = n - 1;
        }
        if (!shift) b->doc.sel_anchor = at;
        b->doc.caret = at;
        b->doc.sel_box = 0;
        b->doc.break_coalesce();
        b->clear_pref();
        return;
    }
    b->layout.move_vert(&b->doc, m, width, dir, shift, &b->pref) !>(e) {
        (void)e;
    };
}

static float gui_gutter_px(GuiFonts *fonts, RtxBuf *b);
static int gui_pane_at(RtxWs *w, int x, int pad, int inner);
static int gui_menu_click(int mx, int my, int *open, int *cmd);
static void gui_reveal_caret(RtxBuf *b, int vis_rows);
static double gui_hit_y(const RtxBuf *b, double y);
static int gui_quit_hit(int mx, int my, int ww, int hh);
static int gui_run_cmd(int cmd, RtxWs *w, RtxBuf *act, RtxMeasure *m,
                       double text_w, int vis_rows, RtxUi *ui,
                       char *status, size_t status_n, size_t *quit_armed_at);

static void gui_home_end(RtxBuf *b, int to_end, int shift, int physical) {
    if (!b) return;
    if (rtx_layout_is_hex(&b->layout)) {
        size_t n = b->len();
        size_t row = n ? b->doc.caret / (size_t)RTX_HEX_COLS : 0;
        size_t at;
        if (!to_end) at = row * (size_t)RTX_HEX_COLS;
        else {
            at = row * (size_t)RTX_HEX_COLS + (size_t)RTX_HEX_COLS - 1;
            if (n == 0) at = 0;
            else if (at >= n) at = n - 1;
        }
        if (!shift) b->doc.sel_anchor = at;
        b->doc.caret = at;
        b->doc.sel_box = 0;
        b->doc.break_coalesce();
        b->clear_pref();
        return;
    }
    if (!physical && b->layout.wrap && b->layout.len) {
        b->layout.move_row_edge(&b->doc, to_end, shift);
    } else {
        b->doc.move_line_edge(to_end, shift);
    }
    if (to_end) b->stick_eol();
    else b->clear_pref();
}

/* Mouse + keys. 1 = quit. Not Result: main is already at the bind cap. */
static int gui_handle_input(RtxWs *w, RtxBuf *act, RtxMeasure *m, GuiFonts *fonts,
                            RtxUi *ui, char *status, size_t status_n,
                            size_t *quit_armed_at, int *menu_open, int *dragging,
                            int pane_w, int vis_rows, int pad, int top, int inner,
                            int hh) {
    Vector2 mouse;
    int key;
    double text_w;
    @errhandler(CCError e) {
        snprintf(status, status_n, "%s", e.message ? e.message : "error");
        return 0;
    }
    if (!w || !act || !m || !fonts || !ui) return 0;
    text_w = (double)pane_w - (double)gui_gutter_px(fonts, act);
    if (ui->ask_quit) {
        int choice = 0;
        if (IsKeyPressed(KEY_ESCAPE) || (IsKeyPressed(KEY_C) && !gui_ctrl())) {
            choice = 3;
        } else if (IsKeyPressed(KEY_S) || (gui_ctrl() && IsKeyPressed(KEY_S))) {
            choice = 1;
        } else if (IsKeyPressed(KEY_Q) || IsKeyPressed(KEY_N) ||
                   IsKeyPressed(KEY_D) || (gui_ctrl() && IsKeyPressed(KEY_Q))) {
            choice = 2;
        }
        if (IsMouseButtonPressed(MOUSE_BUTTON_LEFT)) {
            Vector2 mp = GetMousePosition();
            int hit = gui_quit_hit((int)mp.x, (int)mp.y, GetScreenWidth(), hh);
            if (hit) choice = hit;
        }
        while (GetCharPressed() > 0) { }
        if (choice == 3) {
            ui->ask_quit = 0;
            /* Dismiss this host-close offer; chrome-X stays latched. */
            return 0;
        }
        if (choice == 2) return 1;
        if (choice == 1) {
            size_t si;
            for (si = 0; si < w->len; si++) {
                RtxDoc *sd = &w->bufs[si].doc;
                if (!sd->dirty()) continue;
                if (!sd->path.ptr || sd->path.len == 0) {
                    snprintf(status, status_n, "untitled — save as a path first");
                    return 0;
                }
                sd->save() !>;
                sd->break_coalesce();
            }
            return 1;
        }
        return 0;
    }
    if (*menu_open >= 0) {
        Vector2 hm = GetMousePosition();
        if (hm.y >= 0 && hm.y < (float)GUI_MENU_H) {
            int mi;
            for (mi = 0; mi < 4; mi++) {
                if (hm.x >= (float)gui_menus[mi].x &&
                    hm.x < (float)(gui_menus[mi].x + gui_menus[mi].w)) {
                    *menu_open = mi;
                }
            }
        }
    }
    if (IsMouseButtonPressed(MOUSE_BUTTON_LEFT)) {
        int mcmd = CMD_NONE;
        int mhit;
        mouse = GetMousePosition();
        mhit = gui_menu_click((int)mouse.x, (int)mouse.y, menu_open, &mcmd);
        if (mhit == 2) {
            if (gui_run_cmd(mcmd, w, act, m, text_w, vis_rows, ui, status,
                            status_n, quit_armed_at)) {
                return 1;
            }
        } else if (mhit == 0 && ui->find &&
                   mouse.y >= (float)(hh - 26 - GUI_FIND_H) &&
                   mouse.y < (float)(hh - 26)) {
            int row = ((int)mouse.y - (hh - 26 - GUI_FIND_H) - 8) / GUI_FIND_ROW_H;
            if (row >= 1) {
                size_t hit = ui->find_top + (size_t)(row - 1);
                if (hit < act->doc.find.len) act->doc.find_goto(hit);
            }
        } else if (mhit == 0) {
            w->focus = gui_pane_at(w, (int)mouse.x, pad, inner);
            act = w->active();
            {
                int x0 = pad + (w->focus == 1 && w->npanes == 2 ? inner / 2 + 8 : 0);
                double x = (double)mouse.x - (double)x0 - (double)gui_gutter_px(fonts, act);
                double y = (double)mouse.y - (double)top;
                size_t at;
                if (rtx_layout_is_hex(&act->layout)) {
                    if (mouse.y >= (float)top) {
                        at = gui_hex_hit_byte(act, fonts, x0, top,
                                              hh - top - 28, mouse.x, mouse.y);
                        act->doc.caret = at;
                        if (!gui_shift()) act->doc.sel_anchor = act->doc.caret;
                        act->doc.sel_box = 0;
                        act->clear_pref();
                        *dragging = 1;
                        act->doc.break_coalesce();
                    }
                } else if (x >= 0 && y >= 0) {
                    at = act->layout.hit(&act->doc, m, x, gui_hit_y(act, y)) !>;
                    act->doc.caret = at;
                    if (gui_alt()) {
                        size_t line = act->doc.line_of(at);
                        act->doc.sel_anchor = at;
                        act->doc.sel_box = 1;
                        act->pref.col = at - act->doc.line_start(line);
                        act->pref.ok = 1;
                        act->pref.eol = 0;
                        act->doc.box_acol = act->pref.col;
                        act->doc.box_ccol = act->pref.col;
                    } else {
                        if (!gui_shift()) act->doc.sel_anchor = act->doc.caret;
                        act->doc.sel_box = 0;
                        act->clear_pref();
                    }
                    *dragging = 1;
                    act->doc.break_coalesce();
                }
            }
        }
    }
    if (*dragging && IsMouseButtonDown(MOUSE_BUTTON_LEFT)) {
        mouse = GetMousePosition();
        {
            int x0 = pad + (w->focus == 1 && w->npanes == 2 ? inner / 2 + 8 : 0);
            double x = (double)mouse.x - (double)x0 - (double)gui_gutter_px(fonts, act);
            double y = (double)mouse.y - (double)top;
            int ph = hh - top - 28 - (ui->find ? GUI_FIND_H : 0);
            size_t at;
            if (x < 0) x = 0;
            if (y < 0) {
                act->scroll_vis(m, text_w, -1) !>;
                gui_ensure_view(act, m, text_w, vis_rows) !>;
                y = 0;
            } else if (ph > 0 && y >= (double)ph) {
                act->scroll_vis(m, text_w, 1) !>;
                gui_ensure_view(act, m, text_w, vis_rows) !>;
                y = (double)(ph - 1);
            }
            if (rtx_layout_is_hex(&act->layout)) {
                at = gui_hex_hit_byte(act, fonts, x0, top, ph, mouse.x,
                                      (float)top + (float)y);
                act->doc.caret = at;
                act->clear_pref();
            } else {
                at = act->layout.hit(&act->doc, m, x, gui_hit_y(act, y)) !>;
                act->doc.caret = at;
                if (act->doc.sel_box) {
                    size_t line = act->doc.line_of(at);
                    act->pref.col = at - act->doc.line_start(line);
                    act->pref.ok = 1;
                    act->pref.eol = 0;
                    act->box_sync();
                } else {
                    act->clear_pref();
                }
            }
        }
    }
    if (IsMouseButtonReleased(MOUSE_BUTTON_LEFT)) *dragging = 0;

    if (ui->jump) {
        if (IsKeyPressed(KEY_ESCAPE)) {
            rtx_ui_clear_jump(ui);
        } else if (IsKeyPressed(KEY_ENTER)) {
            rtx_ui_apply_jump(ui, &act->doc);
            if (rtx_layout_is_hex(&act->layout)) {
                act->top_byte = rtx_hex_align(act->doc.caret);
            }
            gui_reveal_caret(act, vis_rows);
        } else if (gui_key(KEY_BACKSPACE) && ui->jump_len > 0) {
            ui->jump_buf[--ui->jump_len] = 0;
        } else {
            key = GetCharPressed();
            while (key > 0) {
                rtx_ui_jump_char(ui, key);
                key = GetCharPressed();
            }
        }
        return 0;
    }
    if (ui->find) {
        if (IsKeyPressed(KEY_ESCAPE)) {
            rtx_ui_clear_find(ui);
        } else if (gui_key(KEY_UP)) {
            act->doc.find_prev();
            gui_reveal_caret(act, vis_rows);
        } else if (gui_key(KEY_DOWN)) {
            act->doc.find_next();
            gui_reveal_caret(act, vis_rows);
        } else if (gui_key(KEY_BACKSPACE) && ui->find_len > 0) {
            ui->find_buf[--ui->find_len] = 0;
            rtx_ui_find_apply(ui, &act->doc) !>;
            gui_reveal_caret(act, vis_rows);
        } else if (gui_ctrl() && (IsKeyPressed(KEY_G) || IsKeyPressed(KEY_J))) {
            rtx_ui_start_jump(ui);
        } else if (gui_ctrl() && IsKeyPressed(KEY_Q)) {
            if (gui_run_cmd(CMD_QUIT, w, act, m, text_w, vis_rows, ui, status,
                            status_n, quit_armed_at)) {
                return 1;
            }
        } else if (gui_ctrl() && IsKeyPressed(KEY_S)) {
            gui_run_cmd(CMD_SAVE, w, act, m, text_w, vis_rows, ui, status,
                        status_n, quit_armed_at);
        } else {
            key = GetCharPressed();
            while (key > 0) {
                if (rtx_ui_find_char(ui, key)) {
                    rtx_ui_find_apply(ui, &act->doc) !>;
                    gui_reveal_caret(act, vis_rows);
                }
                key = GetCharPressed();
            }
        }
        return 0;
    }
    if (IsKeyPressed(KEY_ESCAPE)) {
        *menu_open = -1;
        ui->help = !ui->help;
        return 0;
    }
    {
        int cmd = CMD_NONE;
        if (ui->help) {
            if (IsKeyPressed(KEY_S)) cmd = CMD_SAVE;
            else if (IsKeyPressed(KEY_Z)) cmd = CMD_UNDO;
            else if (IsKeyPressed(KEY_Y)) cmd = CMD_REDO;
            else if (IsKeyPressed(KEY_X)) cmd = CMD_CUT;
            else if (IsKeyPressed(KEY_C)) cmd = CMD_COPY;
            else if (IsKeyPressed(KEY_V)) cmd = CMD_PASTE;
            else if (IsKeyPressed(KEY_W)) cmd = CMD_PANE;
            else if (IsKeyPressed(KEY_N) || IsKeyPressed(KEY_TAB)) cmd = CMD_NEXT;
            else if (IsKeyPressed(KEY_BACKSLASH)) cmd = CMD_SPLIT;
            else if (IsKeyPressed(KEY_Q)) cmd = CMD_QUIT;
            else if (IsKeyPressed(KEY_G)) cmd = CMD_JUMP;
            else if (IsKeyPressed(KEY_F)) cmd = CMD_FIND;
            else if (IsKeyPressed(KEY_A)) cmd = CMD_SEL_ALL;
            else if (IsKeyPressed(KEY_L)) cmd = CMD_WRAP;
            if (cmd == CMD_NONE) {
                while (GetCharPressed() > 0) { }
            } else {
                ui->help = 0;
            }
        } else if (gui_ctrl() && (IsKeyPressed(KEY_G) || IsKeyPressed(KEY_J))) {
            cmd = CMD_JUMP;
        } else if (gui_ctrl() && IsKeyPressed(KEY_F)) {
            cmd = CMD_FIND;
        } else if (gui_ctrl() && IsKeyPressed(KEY_S)) {
            cmd = CMD_SAVE;
        } else if (gui_ctrl() && IsKeyPressed(KEY_Z) && !gui_shift()) {
            cmd = CMD_UNDO;
        } else if ((gui_ctrl() && IsKeyPressed(KEY_Y)) ||
                   (gui_ctrl() && gui_shift() && IsKeyPressed(KEY_Z))) {
            cmd = CMD_REDO;
        } else if (gui_ctrl() && IsKeyPressed(KEY_C)) {
            cmd = CMD_COPY;
        } else if (gui_ctrl() && IsKeyPressed(KEY_X)) {
            cmd = CMD_CUT;
        } else if (gui_ctrl() && IsKeyPressed(KEY_V)) {
            cmd = CMD_PASTE;
        } else if (gui_ctrl() && IsKeyPressed(KEY_W)) {
            cmd = CMD_PANE;
        } else if (gui_ctrl() && (IsKeyPressed(KEY_TAB) || IsKeyPressed(KEY_N))) {
            cmd = CMD_NEXT;
        } else if (gui_ctrl() && IsKeyPressed(KEY_BACKSLASH)) {
            cmd = CMD_SPLIT;
        } else if (gui_ctrl() && IsKeyPressed(KEY_Q)) {
            cmd = CMD_QUIT;
        } else if (gui_ctrl() && IsKeyPressed(KEY_A)) {
            cmd = CMD_SEL_ALL;
        } else if (gui_ctrl() && IsKeyPressed(KEY_L)) {
            cmd = CMD_WRAP;
        }
        if (cmd != CMD_NONE) {
            while (GetCharPressed() > 0) { }
            if (gui_run_cmd(cmd, w, act, m, text_w, vis_rows, ui, status,
                            status_n, quit_armed_at)) {
                return 1;
            }
            return 0;
        }
        if (ui->help) return 0;
        if (gui_key(KEY_HOME) || (gui_ctrl() && gui_key(KEY_LEFT))) {
            gui_home_end(act, 0, gui_shift(), gui_ctrl());
            gui_reveal_caret(act, vis_rows);
            while (GetCharPressed() > 0) { }
        } else if (gui_key(KEY_END) || (gui_ctrl() && gui_key(KEY_RIGHT))) {
            gui_home_end(act, 1, gui_shift(), gui_ctrl());
            gui_reveal_caret(act, vis_rows);
            while (GetCharPressed() > 0) { }
        } else if (!gui_ctrl() && (gui_key(KEY_UP) || gui_key(KEY_DOWN))) {
            int box = gui_alt();
            if (box) act->box_begin();
            gui_move_vert(act, m, text_w, gui_key(KEY_UP) ? -1 : 1,
                          gui_shift() || box);
            if (box) act->box_sync();
            gui_reveal_caret(act, vis_rows);
            while (GetCharPressed() > 0) { }
        } else if (!gui_ctrl()) {
            if (gui_key(KEY_LEFT)) {
                if (gui_alt()) {
                    act->box_move_col(-1);
                } else if (!gui_shift() && act->doc.has_sel()) {
                    act->doc.caret = act->doc.sel_lo();
                    act->doc.clear_sel();
                } else if (act->doc.caret > 0) {
                    if (!gui_shift()) act->doc.sel_anchor = act->doc.caret;
                    act->doc.caret--;
                    if (!gui_shift()) act->doc.sel_anchor = act->doc.caret;
                    act->doc.sel_box = 0;
                }
                act->doc.break_coalesce();
                if (!gui_alt()) act->clear_pref();
                gui_reveal_caret(act, vis_rows);
            }
            if (gui_key(KEY_RIGHT)) {
                size_t n = act->len();
                if (gui_alt()) {
                    act->box_move_col(1);
                } else if (!gui_shift() && act->doc.has_sel()) {
                    act->doc.caret = act->doc.sel_hi();
                    act->doc.clear_sel();
                } else if (act->doc.caret < n) {
                    if (!gui_shift()) act->doc.sel_anchor = act->doc.caret;
                    act->doc.caret++;
                    if (!gui_shift()) act->doc.sel_anchor = act->doc.caret;
                    act->doc.sel_box = 0;
                }
                act->doc.break_coalesce();
                if (!gui_alt()) act->clear_pref();
                gui_reveal_caret(act, vis_rows);
            }
            if (gui_key(KEY_BACKSPACE)) {
                act->doc.backspace() !>;
                gui_after_edit(act, m, text_w, vis_rows) !>;
            }
            if (gui_key(KEY_DELETE)) {
                act->doc.delete_forward() !>;
                gui_after_edit(act, m, text_w, vis_rows) !>;
            }
            if (gui_key(KEY_ENTER)) {
                act->doc.type("\n") !>;
                gui_after_edit(act, m, text_w, vis_rows) !>;
            }
            key = GetCharPressed();
            while (key > 0) {
                if (key >= 32 && key < 127) {
                    char s[2];
                    s[0] = (char)key;
                    s[1] = 0;
                    act->doc.type(s.to_slice_n(1)) !>;
                    gui_after_edit(act, m, text_w, vis_rows) !>;
                }
                key = GetCharPressed();
            }
        }
    }
    return 0;
}

static void gui_sync_clip(RtxWs *w) {
    if (w->clip.ptr && w->clip.len) {
        cc_arena_stack(scratch, RTX_FRAME_SCRATCH);
        char[:] z = scratch.alloc_slice_bytes(w->clip.len + 1);
        if (z.ptr) {
            memcpy(z.ptr, w->clip.ptr, w->clip.len);
            z.ptr[w->clip.len] = 0;
            SetClipboardText(z.ptr);
        }
    }
}

static void !>(CCError) gui_from_os_clip(RtxWs *w) {
    const char *t = GetClipboardText();
    if (t && t[0]) return w->set_clip(cc_slice_cstr(t));
    return cc_ok();
}

static int gui_pane_at(RtxWs *w, int x, int pad, int inner) {
    if (w->npanes < 2) return 0;
    return x >= pad + inner / 2 ? 1 : 0;
}

static float gui_gutter_px(GuiFonts *fonts, RtxBuf *b) {
    int g = rtx_gutter_cols(b->line_count());
    return fonts->mono_sz * 0.6f * (float)g + 10.0f;
}

static void gui_layout_menus(void) {
    int x = 10;
    int i;
    for (i = 0; i < 4; i++) {
        gui_menus[i].x = x;
        gui_menus[i].w = 56;
        x += gui_menus[i].w;
    }
}

static void gui_draw_menubar(GuiFonts *fonts, int ww, int open, Vector2 mouse) {
    int i;
    DrawRectangle(0, 0, ww, GUI_MENU_H, (Color){36, 38, 46, 255});
    DrawLine(0, GUI_MENU_H - 1, ww, GUI_MENU_H - 1, (Color){70, 74, 86, 255});
    for (i = 0; i < 4; i++) {
        Vector2 pos;
        int hot = mouse.y >= 0 && mouse.y < GUI_MENU_H &&
                  mouse.x >= (float)gui_menus[i].x &&
                  mouse.x < (float)(gui_menus[i].x + gui_menus[i].w);
        if (open == i || hot) {
            DrawRectangle(gui_menus[i].x, 0, gui_menus[i].w, GUI_MENU_H,
                          (Color){56, 72, 110, 255});
        }
        pos.x = (float)(gui_menus[i].x + 10);
        pos.y = 5;
        DrawTextEx(fonts->mono, gui_menus[i].title, pos, 16, 0,
                   (Color){230, 232, 240, 255});
    }
    if (open >= 0 && open < 4) {
        GuiMenu *mn = &gui_menus[open];
        int drop_h = 8 + mn->n * GUI_ITEM_H;
        int j;
        DrawRectangle(mn->x, GUI_MENU_H, GUI_DROP_W, drop_h, (Color){32, 36, 48, 255});
        DrawRectangleLines(mn->x, GUI_MENU_H, GUI_DROP_W, drop_h,
                           (Color){120, 160, 210, 255});
        for (j = 0; j < mn->n; j++) {
            int iy = GUI_MENU_H + 4 + j * GUI_ITEM_H;
            Vector2 lp, sp;
            int ihot = mouse.x >= (float)mn->x &&
                       mouse.x < (float)(mn->x + GUI_DROP_W) &&
                       mouse.y >= (float)iy &&
                       mouse.y < (float)(iy + GUI_ITEM_H);
            if (ihot) {
                DrawRectangle(mn->x + 2, iy, GUI_DROP_W - 4, GUI_ITEM_H,
                              (Color){60, 90, 140, 255});
            }
            lp.x = (float)(mn->x + 12);
            lp.y = (float)(iy + 4);
            DrawTextEx(fonts->mono, mn->items[j].label, lp, 15, 0,
                       (Color){235, 238, 245, 255});
            sp.x = (float)(mn->x + GUI_DROP_W - 88);
            sp.y = (float)(iy + 4);
            DrawTextEx(fonts->mono, mn->items[j].shortcut, sp, 13, 0,
                       (Color){150, 165, 190, 255});
        }
    }
}

/* 0 = miss, 1 = toggled a title (cmd unused), 2 = chose an item. */
static int gui_menu_click(int mx, int my, int *open, int *cmd) {
    int i;
    *cmd = CMD_NONE;
    if (*open >= 0 && *open < 4) {
        GuiMenu *mn = &gui_menus[*open];
        if (mx >= mn->x && mx < mn->x + GUI_DROP_W &&
            my >= GUI_MENU_H && my < GUI_MENU_H + 4 + mn->n * GUI_ITEM_H) {
            int j = (my - GUI_MENU_H - 4) / GUI_ITEM_H;
            if (j >= 0 && j < mn->n) {
                *cmd = mn->items[j].cmd;
                *open = -1;
                return 2;
            }
        }
    }
    if (my >= 0 && my < GUI_MENU_H) {
        for (i = 0; i < 4; i++) {
            if (mx >= gui_menus[i].x && mx < gui_menus[i].x + gui_menus[i].w) {
                *open = (*open == i) ? -1 : i;
                return 1;
            }
        }
        *open = -1;
        return 1;
    }
    if (*open >= 0) {
        *open = -1;
        return 1;
    }
    return 0;
}

static void gui_draw_help(GuiFonts *fonts, int ww, int hh) {
    int n = 0;
    int i;
    int box_w = 520;
    int row_h = 24;
    int box_h;
    int x, y;
    float title_sz = 22;
    float line_sz = 18;
    Vector2 pos;
    while (rtx_help_lines[n]) n++;
    box_h = 56 + n * row_h + 16;
    if (box_w > ww - 32) box_w = ww - 32;
    if (box_h > hh - 32) box_h = hh - 32;
    x = (ww - box_w) / 2;
    y = (hh - box_h) / 2;
    if (x < 16) x = 16;
    if (y < 16) y = 16;
    DrawRectangle(0, 0, ww, hh, (Color){0, 0, 0, 140});
    DrawRectangle(x, y, box_w, box_h, (Color){28, 36, 56, 255});
    DrawRectangleLines(x, y, box_w, box_h, (Color){140, 190, 240, 255});
    pos.x = (float)(x + 20);
    pos.y = (float)(y + 14);
    DrawTextEx(fonts->mono, "key bindings", pos, title_sz, 0,
               (Color){240, 240, 250, 255});
    for (i = 0; i < n; i++) {
        pos.x = (float)(x + 24);
        pos.y = (float)(y + 48 + i * row_h);
        DrawTextEx(fonts->mono, rtx_help_lines[i], pos, line_sz, 0,
                   (Color){220, 230, 245, 255});
    }
}

static void gui_draw_jump(GuiFonts *fonts, RtxUi *ui, int ww, int hh) {
    char line[64];
    int box_w = 420;
    int box_h = 88;
    int x = (ww - box_w) / 2;
    int y = (hh - box_h) / 2;
    Vector2 pos;
    if (x < 16) x = 16;
    if (y < 16) y = 16;
    DrawRectangle(0, 0, ww, hh, (Color){0, 0, 0, 140});
    DrawRectangle(x, y, box_w, box_h, (Color){28, 36, 56, 255});
    DrawRectangleLines(x, y, box_w, box_h, (Color){240, 200, 80, 255});
    pos.x = (float)(x + 20);
    pos.y = (float)(y + 16);
    DrawTextEx(fonts->mono, "jump to line or N%", pos, 20, 0, (Color){240, 240, 250, 255});
    snprintf(line, sizeof(line), "> %s_", ui->jump_buf);
    pos.y = (float)(y + 48);
    DrawTextEx(fonts->mono, line, pos, 22, 0, (Color){255, 220, 100, 255});
}

#define GUI_QUIT_W 460
#define GUI_QUIT_H 168
#define GUI_QUIT_BTN_W 120
#define GUI_QUIT_BTN_H 32

static void gui_quit_box(int ww, int hh, int *x, int *y) {
    *x = (ww - GUI_QUIT_W) / 2;
    *y = (hh - GUI_QUIT_H) / 2;
    if (*x < 16) *x = 16;
    if (*y < 16) *y = 16;
}

/* 1 = save, 2 = discard, 3 = cancel, 0 = miss. */
static int gui_quit_hit(int mx, int my, int ww, int hh) {
    int x, y, by, i;
    gui_quit_box(ww, hh, &x, &y);
    by = y + 112;
    if (my < by || my >= by + GUI_QUIT_BTN_H) return 0;
    for (i = 0; i < 3; i++) {
        int bx = x + 24 + i * (GUI_QUIT_BTN_W + 12);
        if (mx >= bx && mx < bx + GUI_QUIT_BTN_W) return i + 1;
    }
    return 0;
}

static void gui_draw_quit(GuiFonts *fonts, const RtxWs *w, int ww, int hh) {
    int x, y, i;
    size_t n;
    char line[80];
    Vector2 pos;
    Vector2 mouse = GetMousePosition();
    const char *labels[3];
    labels[0] = "Save";
    labels[1] = "Don't save";
    labels[2] = "Cancel";
    gui_quit_box(ww, hh, &x, &y);
    n = 0;
    if (w) {
        size_t di;
        for (di = 0; di < w->len; di++) {
            if (w->bufs[di].doc.dirty()) n++;
        }
    }
    DrawRectangle(0, 0, ww, hh, (Color){0, 0, 0, 160});
    DrawRectangle(x, y, GUI_QUIT_W, GUI_QUIT_H, (Color){36, 28, 32, 255});
    DrawRectangleLines(x, y, GUI_QUIT_W, GUI_QUIT_H, (Color){240, 140, 120, 255});
    pos.x = (float)(x + 24);
    pos.y = (float)(y + 18);
    DrawTextEx(fonts->mono, "Unsaved changes", pos, 22, 0,
               (Color){255, 230, 220, 255});
    if (n == 1) snprintf(line, sizeof(line), "1 file has unsaved edits.");
    else snprintf(line, sizeof(line), "%zu files have unsaved edits.", n);
    pos.y = (float)(y + 56);
    DrawTextEx(fonts->mono, line, pos, 16, 0, (Color){220, 210, 200, 255});
    pos.y = (float)(y + 80);
    DrawTextEx(fonts->mono, "Save before quitting?", pos, 16, 0,
               (Color){200, 190, 180, 255});
    for (i = 0; i < 3; i++) {
        int bx = x + 24 + i * (GUI_QUIT_BTN_W + 12);
        int by = y + 112;
        int hot = mouse.x >= (float)bx && mouse.x < (float)(bx + GUI_QUIT_BTN_W) &&
                  mouse.y >= (float)by && mouse.y < (float)(by + GUI_QUIT_BTN_H);
        DrawRectangle(bx, by, GUI_QUIT_BTN_W, GUI_QUIT_BTN_H,
                      hot ? (Color){70, 50, 48, 255} : (Color){48, 36, 40, 255});
        DrawRectangleLines(bx, by, GUI_QUIT_BTN_W, GUI_QUIT_BTN_H,
                           (Color){180, 120, 110, 255});
        pos.x = (float)(bx + 12);
        pos.y = (float)(by + 8);
        DrawTextEx(fonts->mono, labels[i], pos, 15, 0, (Color){240, 220, 210, 255});
    }
}

#define GUI_FIND_ROW_H 20
#define GUI_FIND_H (RTX_UI_FIND_ROWS * GUI_FIND_ROW_H + 8)

static void gui_draw_find(GuiFonts *fonts, RtxUi *ui, RtxDoc *d, int ww, int hh) {
    int y0 = hh - 26 - GUI_FIND_H;
    int vis_hits = RTX_UI_FIND_ROWS - 1;
    int i;
    char head[256];
    Vector2 pos;
    if (y0 < GUI_MENU_H) y0 = GUI_MENU_H;
    rtx_ui_find_scroll(ui, d, (size_t)vis_hits);
    rtx_ui_find_header(ui, d, head, sizeof(head));
    DrawRectangle(0, y0, ww, GUI_FIND_H, (Color){28, 32, 44, 255});
    DrawLine(0, y0, ww, y0, (Color){80, 90, 110, 255});
    pos.x = 12;
    pos.y = (float)(y0 + 4);
    DrawTextEx(fonts->mono, head, pos, 15, 0, (Color){255, 220, 100, 255});
    for (i = 0; i < vis_hits; i++) {
        size_t hit = ui->find_top + (size_t)i;
        int y = y0 + 8 + (i + 1) * GUI_FIND_ROW_H;
        int cur = d && hit == d->find.cur;
        if (!d || hit >= d->find.len) continue;
        if (cur) {
            DrawRectangle(0, y - 2, ww, GUI_FIND_ROW_H, (Color){60, 70, 100, 255});
        }
        {
            char ctx[192];
            char line[256];
            size_t line1 = 0;
            int ok = 1;
            rtx_ui_find_row_text(d, hit, 80, ctx, sizeof(ctx), &line1) !>(e) {
                ok = 0;
            };
            if (ok) snprintf(line, sizeof(line), "%5zu  %s", line1, ctx);
            else snprintf(line, sizeof(line), "  %zu", hit + 1);
            pos.x = 12;
            pos.y = (float)y;
            DrawTextEx(fonts->mono, line, pos, 14, 0,
                       cur ? (Color){255, 230, 140, 255}
                           : (Color){200, 206, 220, 255});
        }
    }
}

static void gui_reveal_caret(RtxBuf *b, int vis_rows) {
    b->reveal(vis_rows);
}

static double gui_hit_y(const RtxBuf *b, double y) {
    size_t s;
    if (!b) return y;
    for (s = 0; s < b->top_wrap && s < b->layout.len; s++) {
        y += b->layout.rows[s].height;
    }
    return y;
}

/* Returns 1 if the caller should quit. */
static int gui_run_cmd(int cmd, RtxWs *w, RtxBuf *act, RtxMeasure *m,
                       double text_w, int vis_rows, RtxUi *ui,
                       char *status, size_t status_n, size_t *quit_armed_at) {
    @errhandler(CCError e) {
        snprintf(status, status_n, "%s", e.message ? e.message : "error");
        return 0;
    }
    if (cmd == CMD_SAVE) {
        act->doc.save() !>;
        snprintf(status, status_n, "saved");
        act->doc.break_coalesce();
    } else if (cmd == CMD_UNDO) {
        act->doc.undo() !>;
        gui_after_edit(act, m, text_w, vis_rows) !>;
    } else if (cmd == CMD_REDO) {
        act->doc.redo() !>;
        gui_after_edit(act, m, text_w, vis_rows) !>;
    } else if (cmd == CMD_CUT) {
        w->cut() !>;
        gui_sync_clip(w);
        gui_after_edit(act, m, text_w, vis_rows) !>;
    } else if (cmd == CMD_COPY) {
        if (w->copy() !>) gui_sync_clip(w);
    } else if (cmd == CMD_PASTE) {
        gui_from_os_clip(w) !>;
        w->paste() !>;
        gui_after_edit(act, m, text_w, vis_rows) !>;
    } else if (cmd == CMD_PANE) {
        w->focus_other();
    } else if (cmd == CMD_NEXT) {
        w->next_buf();
    } else if (cmd == CMD_SPLIT) {
        w->toggle_split();
    } else if (cmd == CMD_QUIT) {
        (void)quit_armed_at;
        if (rtx_ui_offer_quit(w, ui)) return 1;
        status[0] = 0;
    } else if (cmd == CMD_JUMP) {
        rtx_ui_start_jump(ui);
    } else if (cmd == CMD_FIND) {
        rtx_ui_start_find(ui);
        rtx_ui_find_apply(ui, &act->doc) !>;
    } else if (cmd == CMD_HELP) {
        ui->help = !ui->help;
    } else if (cmd == CMD_SEL_ALL) {
        act->doc.select_all();
    } else if (cmd == CMD_WRAP) {
        rtx_layout_cycle_view(&act->layout);
        act->top_wrap = 0;
        act->layout.len = 0;
        act->clear_pref();
        if (rtx_layout_is_hex(&act->layout)) {
            act->top_byte = rtx_hex_align(act->doc.caret);
        }
        snprintf(status, status_n, "view %s", rtx_layout_view_name(&act->layout));
    }
    return 0;
}

static void gui_draw_hex_buf(RtxBuf *b, GuiFonts *fonts, int focused, int x0, int y0,
                             int pw, int ph) {
    size_t r;
    size_t n = b->len();
    int has = b->doc.has_sel();
    float cw;
    float row_h = 18.0f;
    int vis;
    static const char *hexd = "0123456789ABCDEF";
    Vector2 m0;
    (void)pw;
    m0 = MeasureTextEx(fonts->mono, "0", 14, 0);
    cw = m0.x > 1 ? m0.x : 8.0f;
    vis = (int)((float)ph / row_h);
    if (vis < 1) vis = 1;
    b->top_byte = rtx_hex_align(b->top_byte);
    for (r = 0; r < (size_t)vis; r++) {
        size_t off = rtx_hex_row_off(b->top_byte, r);
        unsigned char buf[RTX_HEX_COLS];
        size_t take = (size_t)RTX_HEX_COLS;
        size_t got = 0;
        size_t k;
        float y = (float)y0 + (float)r * row_h;
        float x;
        char off_s[16];
        Vector2 pos;
        if (y > (float)(y0 + ph)) break;
        if (off >= n && !(n == 0 && r == 0)) {
            pos.x = (float)x0;
            pos.y = y;
            DrawTextEx(fonts->mono, "~", pos, 14, 0, (Color){90, 90, 100, 255});
            continue;
        }
        if (take > n - off) take = n - off;
        if (take) {
            @errhandler(CCError e) {
                (void)e;
                got = 0;
            }
            got = b->read_at(off, (char *)buf, take) !>;
        }
        snprintf(off_s, sizeof(off_s), "%010zX", off);
        pos.x = (float)x0;
        pos.y = y;
        DrawTextEx(fonts->mono, off_s, pos, 14, 0, (Color){100, 140, 220, 255});
        x = (float)x0 + cw * 11.0f;
        for (k = 0; k < (size_t)RTX_HEX_COLS; k++) {
            size_t at = off + k;
            char pair[4];
            int sel = has && at < n && b->doc.sel_covers(at);
            int here = focused && b->doc.caret == at;
            if (k < got) {
                pair[0] = hexd[(buf[k] >> 4) & 0xF];
                pair[1] = hexd[buf[k] & 0xF];
            } else {
                pair[0] = ' ';
                pair[1] = ' ';
            }
            pair[2] = 0;
            if (sel) {
                DrawRectangle((int)x, (int)y, (int)(cw * 2.5f), (int)row_h,
                              (Color){40, 70, 120, 255});
            }
            if (here) {
                DrawRectangle((int)x, (int)y, 2, (int)row_h, (Color){255, 200, 80, 255});
            }
            pos.x = x;
            pos.y = y;
            DrawTextEx(fonts->mono, pair, pos, 14, 0, (Color){220, 220, 230, 255});
            x += cw * 3.0f;
        }
        x += cw * 2.0f;
        for (k = 0; k < (size_t)RTX_HEX_COLS; k++) {
            size_t at = off + k;
            char chs[2];
            int sel = has && at < n && b->doc.sel_covers(at);
            int here = focused && b->doc.caret == at;
            chs[0] = (k < got) ? rtx_hex_ascii(buf[k]) : ' ';
            chs[1] = 0;
            if (sel) {
                DrawRectangle((int)x, (int)y, (int)cw + 1, (int)row_h,
                              (Color){40, 70, 120, 255});
            }
            if (here) {
                DrawRectangle((int)x, (int)y, 2, (int)row_h, (Color){255, 200, 80, 255});
            }
            pos.x = x;
            pos.y = y;
            DrawTextEx(fonts->mono, chs, pos, 14, 0, (Color){200, 210, 180, 255});
            x += cw;
        }
    }
}

static size_t gui_hex_hit_byte(RtxBuf *b, GuiFonts *fonts, int x0, int y0, int ph,
                               float mx, float my) {
    float cw;
    float row_h = 18.0f;
    int row;
    float local_x;
    size_t base;
    size_t n;
    size_t at;
    Vector2 m0;
    m0 = MeasureTextEx(fonts->mono, "0", 14, 0);
    cw = m0.x > 1 ? m0.x : 8.0f;
    row = (int)((my - (float)y0) / row_h);
    if (row < 0) row = 0;
    n = b->len();
    base = rtx_hex_row_off(b->top_byte, (size_t)row);
    local_x = mx - (float)x0;
    if (local_x < cw * 11.0f) {
        at = base;
    } else if (local_x < cw * 11.0f + cw * 3.0f * (float)RTX_HEX_COLS) {
        float hx = local_x - cw * 11.0f;
        at = base + (size_t)(hx / (cw * 3.0f));
    } else {
        float ax = local_x - (cw * 11.0f + cw * 3.0f * (float)RTX_HEX_COLS + cw * 2.0f);
        if (ax < 0) ax = 0;
        at = base + (size_t)(ax / cw);
    }
    if (at > n) at = n;
    (void)ph;
    return at;
}

static void gui_draw_buf(RtxBuf *b, GuiFonts *fonts, int focused, int x0, int y0,
                         int pw, int ph, int pad) {
    size_t i;
    double acc = 0;
    int has = b->doc.has_sel();
    float gpx = gui_gutter_px(fonts, b);
    (void)pw;
    (void)pad;
    if (rtx_layout_is_hex(&b->layout)) {
        gui_draw_hex_buf(b, fonts, focused, x0, y0, pw, ph);
        return;
    }
    for (i = b->top_wrap; i < b->layout.len; i++) {
        RtxVisRow *row = &b->layout.rows[i];
        double y = (double)y0 + acc;
        acc += row->height;
        if (y + row->height < (double)y0) continue;
        if (y > (double)(y0 + ph)) break;
        {
            size_t k;
            double x = (double)x0 + (double)gpx;
            size_t line = row->line;
            size_t box_l0 = 0, box_l1 = 0;
            int box_row = 0;
            int show_ln = (i == 0 || b->layout.rows[i - 1].line != line);
            if (b->doc.sel_box) {
                rtx_doc_box_lines(&b->doc, &box_l0, &box_l1);
                box_row = (line >= box_l0 && line <= box_l1);
            }
            cc_arena_stack(scratch, RTX_FRAME_SCRATCH);
            if (show_ln) {
                char ln[16];
                Vector2 lp;
                snprintf(ln, sizeof(ln), "%zu", line + 1);
                lp.x = (float)x0;
                lp.y = (float)y;
                DrawTextEx(fonts->mono, ln, lp, 13, 0, (Color){110, 114, 128, 255});
            }
            char[:] bytes = b->scratch_span(&scratch, row->byte_start, row->byte_len) !>(e) {
                return;
            };
            for (k = 0; k < bytes.len; k++) {
                size_t off = row->byte_start + k;
                RtxStyle st = b->doc.style_at(off);
                char tmp[8];
                Vector2 pos;
                double gw;
                char[:] one = bytes.sub(k, k + 1);
                tmp[0] = one.ptr ? one.ptr[0] : ' ';
                tmp[1] = 0;
                gw = gui_measure(fonts, one, st, row->sec);
                pos.x = (float)x;
                pos.y = (float)y;
                if (has && b->doc.sel_covers(off)) {
                    DrawRectangle((int)x, (int)y, (int)gw + 1, (int)row->height,
                                  (Color){40, 70, 120, 255});
                }
                if (focused && (b->doc.caret == off ||
                    (box_row && rtx_box_col_on_line(&b->doc, line, b->doc.box_ccol) ==
                     off - b->doc.line_start(line)))) {
                    DrawRectangle((int)x, (int)y, 2, (int)row->height,
                                  (Color){255, 200, 80, 255});
                }
                DrawTextEx(gui_font(fonts, st, row->sec), tmp, pos,
                           gui_size(fonts, st, row->sec), 0, gui_hl_color(st.hl));
                x += gw;
            }
            if (focused && (b->doc.caret == row->byte_start + row->byte_len ||
                (box_row &&
                 b->doc.line_start(line) + rtx_box_col_on_line(&b->doc, line, b->doc.box_ccol) ==
                 row->byte_start + row->byte_len))) {
                DrawRectangle((int)x, (int)y, 2, (int)row->height,
                              (Color){255, 200, 80, 255});
            }
        }
    }
}

/* Shared scene state so macOS live-resize can repaint while PollInputEvents
 * is blocked inside AppKit's nested resize tracking loop. */
typedef struct {
    RtxWs *w;
    RtxMeasure *m;
    GuiFonts *fonts;
    RtxUi *ui;
    int *menu_open;
    char *status;
    int pad;
    int top;
    int ready;
    int painting;   /* live-resize paint in progress */
    int draw_open;  /* BeginDrawing without matching end/swap */
    void *resize_observer;
    void *resize_center;
} GuiLive;

static GuiLive g_live;
static int g_busy_frame;

static void gui_busy(void *ctx, const char *label, int pct) {
    const char *spin = "|/-\\";
    char msg[64];
    int ww, hh;
    Vector2 pos;
    Color bg = {40, 36, 20, 230};
    Color fg = {255, 210, 80, 255};
    (void)ctx;
    if (!label) return;
    if (!IsWindowReady()) return;
    if (pct >= 0) {
        snprintf(msg, sizeof(msg), "%c %s %d%%", spin[g_busy_frame++ & 3], label,
                 pct);
    } else {
        snprintf(msg, sizeof(msg), "%c %s", spin[g_busy_frame++ & 3], label);
    }
    ww = GetScreenWidth();
    hh = GetScreenHeight();
    pos = (Vector2){(float)ww - 160.0f, 8.0f};
    if (pos.x < 8) pos.x = 8;
    if (g_live.draw_open) {
        DrawRectangle((int)pos.x - 8, (int)pos.y - 2, 152, 22, bg);
        if (g_live.fonts) {
            DrawTextEx(g_live.fonts->mono, msg, pos, 14, 0, fg);
        }
        return;
    }
    BeginDrawing();
    DrawRectangle((int)pos.x - 8, (int)pos.y - 2, 152, 22, bg);
    if (g_live.fonts) {
        DrawTextEx(g_live.fonts->mono, msg, pos, 14, 0, fg);
    } else {
        DrawText(msg, (int)pos.x, (int)pos.y, 14, fg);
    }
    (void)hh;
    EndDrawing();
}

static void gui_geom(int *ww, int *hh, int *inner, int *pane_w, int *vis_rows,
                     int pad, int top, int find_on) {
    *ww = GetScreenWidth();
    *hh = GetScreenHeight();
    *inner = *ww - 2 * pad;
    if (*inner < 40) *inner = 40;
    *pane_w = (g_live.w && g_live.w->npanes >= 2) ? (*inner / 2 - 8) : *inner;
    *vis_rows = (*hh - top - 28 - (find_on ? GUI_FIND_H : 0)) / 20;
    if (*vis_rows < 4) *vis_rows = 4;
}

static void !>(CCError) gui_relayout(int pane_w, int vis_rows) {
    int p;
    if (!g_live.w || !g_live.m || !g_live.fonts) {
        return cc_err(CC_ERR_INVALID_ARG, "live layout");
    }
    for (p = 0; p < g_live.w->npanes; p++) {
        RtxBuf *b = &g_live.w->bufs[g_live.w->pane[p]];
        if (rtx_layout_is_hex(&b->layout)) {
            gui_ensure_view(b, g_live.m,
                            (double)pane_w - (double)gui_gutter_px(g_live.fonts, b),
                            vis_rows) !>(e) { return cc_err(e); };
            continue;
        }
        {
            size_t nlines = b->line_count();
            if (b->top >= nlines && nlines) b->top = nlines - 1;
        }
        gui_ensure_view(b, g_live.m,
                        (double)pane_w - (double)gui_gutter_px(g_live.fonts, b),
                        vis_rows) !>(e) { return cc_err(e); };
    }
    return cc_ok();
}

/* Draw contents only. Caller owns BeginDrawing / EndDrawing or flush+swap. */
static void gui_draw_body(int ww, int hh, int pad, int top, int pane_w, int inner) {
    int p;
    RtxBuf *act;
    if (!g_live.w || !g_live.fonts || !g_live.ui) return;
    act = RtxWs_active(g_live.w);
    ClearBackground((Color){24, 24, 28, 255});
    for (p = 0; p < g_live.w->npanes; p++) {
        RtxBuf *b = &g_live.w->bufs[g_live.w->pane[p]];
        int x0 = pad + (p == 1 ? inner / 2 + 8 : 0);
        if (g_live.w->npanes == 2 && p == 1) {
            DrawLine(pad + inner / 2, top, pad + inner / 2,
                     hh - 28 - (g_live.ui->find ? GUI_FIND_H : 0),
                     (Color){80, 80, 90, 255});
        }
        gui_draw_buf(b, g_live.fonts, p == g_live.w->focus, x0, top, pane_w,
                     hh - top - 28 - (g_live.ui->find ? GUI_FIND_H : 0), pad);
    }
    gui_draw_menubar(g_live.fonts, ww, g_live.menu_open ? *g_live.menu_open : -1,
                     GetMousePosition());
    if (g_live.ui->help) gui_draw_help(g_live.fonts, ww, hh);
    if (g_live.ui->jump) gui_draw_jump(g_live.fonts, g_live.ui, ww, hh);
    if (g_live.ui->find && act) gui_draw_find(g_live.fonts, g_live.ui, &act->doc, ww, hh);
    if (g_live.ui->ask_quit) gui_draw_quit(g_live.fonts, g_live.w, ww, hh);
    {
        const char *path = (act && act->doc.path.ptr) ? act->doc.path.ptr : "(untitled)";
        const char *star = (act && act->doc.dirty()) ? "*" : "";
        const char *status = g_live.status ? g_live.status : "";
        char bar[256];
        Vector2 bp;
        size_t cur = act ? act->line_of(act->doc.caret) + 1 : 0;
        size_t nln = act ? act->line_count() : 0;
        if (g_live.ui->ask_quit) {
            snprintf(bar, sizeof(bar), "unsaved  S save  Q don't save  Esc cancel  %s",
                     status);
        } else if (g_live.ui->jump) {
            snprintf(bar, sizeof(bar), "jump line or N%%: %s_", g_live.ui->jump_buf);
        } else if (g_live.ui->find) {
            snprintf(bar, sizeof(bar), "find  up/down hits  Esc close  %s", status);
        } else if (act && rtx_layout_is_hex(&act->layout)) {
            snprintf(bar, sizeof(bar), "%s%s  @%zX  hex  %s",
                     star, path, act->doc.caret, status);
        } else {
            snprintf(bar, sizeof(bar), "%s%s  L%zu/%zu  %s",
                     star, path, cur, nln, status);
        }
        DrawRectangle(0, hh - 26, ww, 26, (Color){36, 38, 46, 255});
        bp.x = 12;
        bp.y = (float)(hh - 22);
        DrawTextEx(g_live.fonts->mono, bar, bp, 14, 0, (Color){170, 174, 186, 255});
    }
}

/* Paint + swap without PollInputEvents (unsafe to nest inside a resize).
 * Only safe when no BeginDrawing is open — EndDrawing has already swapped
 * before it polls, so resize notifications land in that window. */
static void gui_live_paint(void) {
    int ww, hh, inner, pane_w, vis_rows;
    if (!g_live.ready || g_live.painting || g_live.draw_open) return;
    g_live.painting = 1;
    @errhandler(CCError e) {
        (void)e;
        g_live.painting = 0;
        g_live.draw_open = 0;
        return;
    }
    gui_geom(&ww, &hh, &inner, &pane_w, &vis_rows, g_live.pad, g_live.top,
             g_live.ui && g_live.ui->find);
    gui_relayout(pane_w, vis_rows) !>;
    BeginDrawing();
    g_live.draw_open = 1;
    gui_draw_body(ww, hh, g_live.pad, g_live.top, pane_w, inner);
    rlDrawRenderBatchActive();
    SwapScreenBuffer();
    g_live.draw_open = 0;
    g_live.painting = 0;
}

#if defined(__APPLE__)
static void rtx_on_window_resize(id self, SEL cmd, id note) {
    (void)self;
    (void)cmd;
    (void)note;
    gui_live_paint();
}

static void gui_install_live_resize(void) {
    Class cls;
    id observer;
    id center;
    id name;
    id window;

    window = (id)GetWindowHandle();
    if (!window) return;

    cls = objc_allocateClassPair(objc_getClass("NSObject"), "RtxGuiResizeObserver", 0);
    if (!cls) return;
    class_addMethod(cls, sel_getUid("onResize:"), (IMP)rtx_on_window_resize, "v@:@");
    objc_registerClassPair(cls);

    observer = ((id (*)(id, SEL))objc_msgSend)((id)cls, sel_getUid("new"));
    center = ((id (*)(id, SEL))objc_msgSend)(
        (id)objc_getClass("NSNotificationCenter"), sel_getUid("defaultCenter"));
    name = ((id (*)(id, SEL, const char *))objc_msgSend)(
        (id)objc_getClass("NSString"), sel_getUid("stringWithUTF8String:"),
        "NSWindowDidResizeNotification");
    ((void (*)(id, SEL, id, SEL, id, id))objc_msgSend)(
        center, sel_getUid("addObserver:selector:name:object:"),
        observer, sel_getUid("onResize:"), name, window);
    g_live.resize_observer = (void *)observer;
    g_live.resize_center = (void *)center;
}

static void gui_uninstall_live_resize(void) {
    id center = (id)g_live.resize_center;
    id observer = (id)g_live.resize_observer;
    if (center && observer) {
        ((void (*)(id, SEL, id))objc_msgSend)(
            center, sel_getUid("removeObserver:"), observer);
        ((void (*)(id, SEL))objc_msgSend)(observer, sel_getUid("release"));
    }
    g_live.resize_observer = NULL;
    g_live.resize_center = NULL;
}
#else
static void gui_install_live_resize(void) {
}
static void gui_uninstall_live_resize(void) {
}
#endif

int main(int argc, char **argv) {
    @errhandler(CCError e) { cc_error_log(e); return 1; }
    RtxWs w = {0} @destroy;
    RtxMeasure m;
    GuiFonts fonts;
    char *def[1];
    int nfiles;
    char **files;
    int ww = 960;
    int hh = 640;
    int pad = 16;
    int top = GUI_MENU_H + 8;
    int dragging = 0;
    size_t quit_armed_at = (size_t)-1;
    int close_held = 0;
    int menu_open = -1;
    char status[160];
    RtxUi ui;

    def[0] = (char *)"testdata/mixed.txt";
    nfiles = argc > 1 ? argc - 1 : 1;
    files = argc > 1 ? argv + 1 : def;
    w.open_files(nfiles, files) !>;
    status[0] = 0;
    memset(&ui, 0, sizeof(ui));

    SetConfigFlags(FLAG_WINDOW_RESIZABLE | FLAG_WINDOW_HIGHDPI);
    InitWindow(ww, hh, "raytext");
    SetExitKey(0);
    SetTargetFPS(60);
    gui_install_live_resize();

    {
        Vector2 dpi = GetWindowScaleDPI();
        float scale = dpi.y > 1.0f ? dpi.y : 1.0f;
        fonts.mono_sz = 16;
        fonts.prose_sz = 17;
        fonts.mono = gui_load_font(gui_mono_paths, (int)(fonts.mono_sz * scale + 0.5f),
                                   &fonts.owned_mono);
        fonts.prose = gui_load_font(gui_prose_paths, (int)(fonts.prose_sz * scale + 0.5f),
                                    &fonts.owned_prose);
    }
    rtx_busy_bind(gui_busy, NULL);
    gui_layout_menus();

    m.measure = gui_measure;
    m.line_height = gui_lh;
    m.ctx = &fonts;

    g_live.w = &w;
    g_live.m = &m;
    g_live.fonts = &fonts;
    g_live.ui = &ui;
    g_live.menu_open = &menu_open;
    g_live.status = status;
    g_live.pad = pad;
    g_live.top = top;
    g_live.ready = 1;

    for (;;) {
        /*
         * Host close is a one-shot offer into ask_quit. Cancel dismisses the
         * prompt; Raylib latches shouldClose so chrome-X will not re-fire —
         * further quit is menu / Ctrl-Q, or save-then-exit while still latched.
         */
        if (WindowShouldClose()) {
            if (!w.any_dirty()) break;
            if (!ui.ask_quit && !close_held) rtx_ui_offer_quit(&w, &ui);
            close_held = 1;
        } else {
            close_held = 0;
        }
        int p;
        int inner;
        int pane_w;
        int vis_rows;
        RtxBuf *act;
        gui_geom(&ww, &hh, &inner, &pane_w, &vis_rows, pad, top, ui.find);
        act = w.active();
        if (act && ui.find) {
            rtx_ui_find_pump(&ui, &act->doc) !>;
        }

        for (p = 0; p < w.npanes; p++) {
            RtxBuf *b = &w.bufs[w.pane[p]];
            size_t nlines = b->line_count();
            if (p == w.focus) {
                gui_wheel(b, &m, (double)pane_w - (double)gui_gutter_px(&fonts, b));
            }
            if (b->top >= nlines && nlines) b->top = nlines - 1;
        }
        gui_relayout(pane_w, vis_rows) !>;
        act = w.active();

        if (gui_handle_input(&w, act, &m, &fonts, &ui, status, sizeof(status),
                             &quit_armed_at, &menu_open, &dragging, pane_w,
                             vis_rows, pad, top, inner, hh)) {
            break;
        }
        act = w.active();
        if (act && act->layout.from_line != act->top) {
            gui_relayout(pane_w, vis_rows) !>;
        }

        BeginDrawing();
        g_live.draw_open = 1;
        gui_draw_body(ww, hh, pad, top, pane_w, inner);
        g_live.draw_open = 0;
        EndDrawing();
    }

    g_live.ready = 0;
    rtx_busy_bind(NULL, NULL);
    gui_uninstall_live_resize();
    if (fonts.owned_mono) UnloadFont(fonts.mono);
    if (fonts.owned_prose) UnloadFont(fonts.prose);
    CloseWindow();
    return 0;
}
