#!ccc ccs
/*
 * cctext-ray host loop. Paint is gui_draw.ccs; keys/mouse are gui_input.ccs.
 * Frame: input → pump → layout → paint (DESIGN.md Interactive). TUI is the
 * same cycle with input last because read blocks.
 */
#include <ccc/std/prelude.cch>
#include <stdio.h>
#include <string.h>
#include <unistd.h>
#include <raylib.h>
#include <rlgl.h>
#include "../core/document.cch"
#include "../core/layout.cch"
#include "../core/workspace.cch"
#include "../core/find.cch"
#include "../core/ui.cch"
#include "../core/browse.cch"
#include "gui.cch"

int g_dirty = 1;
int g_need_layout = 1;
static Vector2 g_mouse_was;
static long g_isle_paint_at;

static int gui_isle_yield(void) {
    int k;
    if (IsMouseButtonDown(MOUSE_BUTTON_LEFT) ||
        IsMouseButtonDown(MOUSE_BUTTON_RIGHT))
        return 1;
    for (k = 32; k <= 348; k++) {
        if (IsKeyDown(k)) return 1;
    }
    return 0;
}
GuiLive g_live;
static int g_busy_frame;
char g_busy_msg[64];
int g_busy_show;

static void gui_blink_show(RtxUi *ui) {
    rtx_ui_blink_show(ui);
    g_dirty = 1;
}

static void gui_idle_wait(RtxUi *ui) {
    long left_ms = RTX_UI_BLINK_MS;
    if (ui && ui->blink_at)
        left_ms = RTX_UI_BLINK_MS - (rtx_ui_now_ms() - ui->blink_at);
    if (left_ms < 16) left_ms = 16;
    if (left_ms > RTX_UI_BLINK_MS) left_ms = RTX_UI_BLINK_MS;
    WaitTime(left_ms > 16 ? 0.016 : (double)left_ms / 1000.0);
    PollInputEvents();
}

static int gui_keys_down(void) {
    int k;
    for (k = 32; k <= 348; k++) {
        if (IsKeyPressed(k) || IsKeyPressedRepeat(k)) return 1;
    }
    return 0;
}

static int gui_saw_input(int dragging, int menu_open) {
    Vector2 m = GetMousePosition();
    int moved = ((int)m.x != (int)g_mouse_was.x) || ((int)m.y != (int)g_mouse_was.y);
    g_mouse_was = m;
    if (IsWindowResized()) return 1;
    if (GetMouseWheelMove() != 0.0f) return 1;
    if (IsMouseButtonPressed(MOUSE_BUTTON_LEFT) ||
        IsMouseButtonReleased(MOUSE_BUTTON_LEFT)) return 1;
    if (dragging) return 1;
    if (moved && menu_open >= 0) return 1;
    if (moved && m.y >= 0.0f && m.y < (float)GUI_MENU_H) return 1;
    return gui_keys_down();
}

static void gui_busy(void *ctx, const char *label, int pct) {
    const char *spin = "|/-\\";
    (void)ctx;
    if (!label) {
        g_busy_show = 0;
        g_busy_msg[0] = 0;
        return;
    }
    if (pct >= 0) {
        snprintf(g_busy_msg, sizeof(g_busy_msg), "%c %s %d%%",
                 spin[g_busy_frame++ & 3], label, pct);
    } else {
        snprintf(g_busy_msg, sizeof(g_busy_msg), "%c %s",
                 spin[g_busy_frame++ & 3], label);
    }
    g_busy_show = 1;
    /* Overlay only. A spinner-only Begin/EndDrawing swaps a torn frame. */
    if (g_live.draw_open && IsWindowReady()) gui_draw_busy_badge();
}

static void gui_geom(int *ww, int *hh, int *inner, int *pane_w, int *vis_rows,
                     int pad, int top, int find_on) {
    *ww = GetScreenWidth();
    *hh = GetScreenHeight();
    *inner = *ww - 2 * pad;
    if (*inner < 40) *inner = 40;
    *pane_w = (g_live.w && g_live.w->npanes >= 2) ? (*inner / 2 - 8) : *inner;
    *vis_rows = (*hh - top - 28 - (find_on ? GUI_FIND_H : 0)) / 20;
    if (*vis_rows < 4) *vis_rows = 4;
}

static int gui_view_stale(const RtxBuf *b) {
    if (!b || b->layout.len == 0) return 1;
    if (b->seek_valid && b->layout.rows[0].byte_start != b->seek_off)
        return 1;
    return 0;
}

static void !>(CCError) gui_relayout(int pane_w, int vis_rows) {
    int p;
    if (!g_live.w || !g_live.m || !g_live.fonts) {
        return cc_err(CC_ERR_INVALID_ARG, "live layout");
    }
    for (p = 0; p < g_live.w->npanes; p++) {
        RtxBuf *b = &g_live.w->bufs[g_live.w->pane[p]];
        int held = RtxWs_hold_pane(g_live.w, p);
        {
            size_t nlines = b->line_count();
            if (!rtx_layout_is_hex(&b->layout) && !b->seek_valid &&
                b->top >= nlines && nlines)
                b->top = nlines - 1;
        }
        b->ensure_view(g_live.m, gui_text_w(g_live.fonts, b, pane_w, vis_rows),
                        vis_rows) !>(e) {
            RtxWs_drop_pane(g_live.w, p, held);
            return cc_err(e);
        };
        RtxWs_drop_pane(g_live.w, p, held);
    }
    return cc_ok();
}

/* Paint + swap without PollInputEvents (unsafe to nest inside a resize).
 * Only safe when no BeginDrawing is open — EndDrawing has already swapped
 * before it polls, so resize notifications land in that window. */
static void gui_live_paint(void) {
    int ww, hh, inner, pane_w, vis_rows;
    if (!g_live.ready || g_live.painting || g_live.draw_open) return;
    g_live.painting = 1;
    @errhandler(CCError e) {
        (void)e;
        g_live.painting = 0;
        g_live.draw_open = 0;
        return;
    }
    gui_geom(&ww, &hh, &inner, &pane_w, &vis_rows, g_live.pad, g_live.top,
             g_live.ui && g_live.ui->find);
    gui_relayout(pane_w, vis_rows) !>;
    g_need_layout = 0;
    g_dirty = 1;
    BeginDrawing();
    g_live.draw_open = 1;
    gui_draw_body(ww, hh, g_live.pad, g_live.top, pane_w, inner, vis_rows);
    rlDrawRenderBatchActive();
    SwapScreenBuffer();
    g_live.draw_open = 0;
    g_live.painting = 0;
}

static void gui_install_live_resize(void) {
    void *window = GetWindowHandle();
    if (!window) return;
    gui_osx_install_resize(window, gui_live_paint,
                           &g_live.resize_observer, &g_live.resize_center);
}

static void gui_uninstall_live_resize(void) {
    gui_osx_uninstall_resize(g_live.resize_observer, g_live.resize_center);
    g_live.resize_observer = NULL;
    g_live.resize_center = NULL;
}

int main(int argc, char **argv) {
    @errhandler(CCError e) { cc_error_log(e); return 1; }
    RtxWs w = {0} @destroy;
    RtxMeasure m;
    GuiFonts fonts;
    char *filebuf[32];
    RtxCli cli;
    const char *prog;
    int ww = 960;
    int hh = 640;
    int pad = 16;
    int top = GUI_MENU_H + 8;
    int dragging = 0;
    int scroll_grab = 0;
    size_t quit_armed_at = (size_t)-1;
    int close_held = 0;
    int menu_open = -1;
    char status[160];
    RtxUi ui;

    prog = (argc > 0 && argv[0] && argv[0][0]) ? argv[0] : "cctext-ray";
    if (rtx_cli_parse(argc, argv, filebuf, 32, &cli) != 0) {
        rtx_cli_usage(stderr, prog);
        return 2;
    }
    if (cli.help) {
        rtx_cli_usage(stdout, prog);
        return 0;
    }
    if (cli.version) {
        rtx_cli_print_version(stdout, prog);
        return 0;
    }
    if (cli.nfiles == 0) {
        w.open_files(0, NULL) !>;
        if (w.len) rtx_layout_set_view(&w.bufs[0].layout, cli.view);
    } else {
        w.open_files(cli.nfiles, filebuf) !>;
        w.set_views(cli.file_view, cli.nfiles);
    }
    status[0] = 0;
    memset(&ui, 0, sizeof(ui));
    if (cli.nfiles == 0 || w.untitled()) w.browse_start() !>;

    SetTraceLogLevel(LOG_NONE);
    SetConfigFlags(FLAG_WINDOW_RESIZABLE | FLAG_WINDOW_HIGHDPI);
    InitWindow(ww, hh, "cctext");
    SetExitKey(0);
    SetTargetFPS(60);
    gui_install_live_resize();

    {
        Vector2 dpi = GetWindowScaleDPI();
        float scale = dpi.y > 1.0f ? dpi.y : 1.0f;
        fonts.mono_sz = 16;
        fonts.prose_sz = 17;
        fonts.mono = gui_load_font(gui_mono_font_paths(), (int)(fonts.mono_sz * scale + 0.5f),
                                   &fonts.owned_mono);
        fonts.prose = gui_load_font(gui_prose_font_paths(), (int)(fonts.prose_sz * scale + 0.5f),
                                    &fonts.owned_prose);
    }
    w.busy_bind(gui_busy, NULL);
    gui_layout_menus();

    m.measure = gui_measure;
    m.line_height = gui_lh;
    m.ctx = &fonts;

    g_live.w = &w;
    g_live.m = &m;
    g_live.fonts = &fonts;
    g_live.ui = &ui;
    g_live.menu_open = &menu_open;
    g_live.status = status;
    g_live.pad = pad;
    g_live.top = top;
    g_live.dragging = &dragging;
    g_live.scroll_grab = &scroll_grab;
    g_live.ready = 1;

    for (;;) {
        /*
         * Host close is a one-shot offer into ask_quit. Cancel dismisses the
         * prompt; Raylib latches shouldClose so chrome-X will not re-fire —
         * further quit is menu / Ctrl-Q, or save-then-exit while still latched.
         */
        if (WindowShouldClose()) {
            if (!w.any_dirty()) break;
            if (!ui.ask_quit && !close_held) rtx_ui_offer_quit(&w, &ui);
            close_held = 1;
            g_dirty = 1;
        } else {
            close_held = 0;
        }
        int p;
        int inner;
        int pane_w;
        int vis_rows;
        int saw;
        RtxBuf *act;
        saw = gui_saw_input(dragging, menu_open);
        if (saw) gui_blink_show(&ui);
        gui_geom(&ww, &hh, &inner, &pane_w, &vis_rows, pad, top, ui.find);
        act = w.active();
        if (gui_handle_input(&w, act, &m, &fonts, &ui, status, sizeof(status),
                             &quit_armed_at, &menu_open, &dragging, &scroll_grab,
                             pane_w, vis_rows, pad, top, inner, hh)) {
            break;
        }
        act = w.active();
        if (act) {
            size_t caret0 = act->doc.caret;
            int isle_was = rtx_line_isle_pumping(&act->doc.tree);
            long now;
            @errhandler(RtxIndexErr e) {
                snprintf(status, sizeof(status), "%s",
                         e.message ? e.message : "scan");
            }
            rtx_ui_work_pump(&ui, act, vis_rows, gui_isle_yield) !>;
            if (act->doc.caret != caret0) {
                if (ui.find) gui_land(act, vis_rows);
                else if (!act->unlock) act->pin_view = 0;
                g_need_layout = 1;
            }
            now = rtx_ui_now_ms();
            if (isle_was && !rtx_line_isle_pumping(&act->doc.tree)) {
                g_dirty = 1;
                g_need_layout = 1;
            } else if (rtx_ui_work_pumping(&ui, &act->doc) &&
                       (g_isle_paint_at == 0 ||
                        now - g_isle_paint_at >= (long)RTX_LINE_ISLE_PAINT_MS)) {
                g_dirty = 1;
                g_isle_paint_at = now;
            }
        }
        RtxWs_browse_pump(&w) !>;

        if (saw || g_need_layout || (act && gui_view_stale(act))) {
            for (p = 0; p < w.npanes; p++) {
                RtxBuf *b = &w.bufs[w.pane[p]];
                int held = w.hold_pane(p);
                size_t nlines = b->line_count();
                if (!b->seek_valid && b->top >= nlines && nlines)
                    b->top = nlines - 1;
                w.drop_pane(p, held);
            }
            gui_relayout(pane_w, vis_rows) !>;
            g_need_layout = 0;
        }

        if (rtx_ui_blink_step(&ui)) g_dirty = 1;
        if (RtxWs_browse_busy(&w)) g_dirty = 1;
        if (g_busy_show && !(act && rtx_line_isle_pumping(&act->doc.tree)))
            g_dirty = 1;
        if (ui.stats) g_dirty = 1;

        if (g_dirty) {
            BeginDrawing();
            g_live.draw_open = 1;
            gui_draw_body(ww, hh, pad, top, pane_w, inner, vis_rows);
            g_live.draw_open = 0;
            EndDrawing();
            g_dirty = 0;
        } else if (act && rtx_line_isle_pumping(&act->doc.tree)) {
            PollInputEvents();
        } else {
            gui_idle_wait(&ui);
        }
    }

    g_live.ready = 0;
    w.busy_bind(NULL, NULL);
    gui_uninstall_live_resize();
    if (fonts.owned_mono) UnloadFont(fonts.mono);
    if (fonts.owned_prose) UnloadFont(fonts.prose);
    CloseWindow();
    if (rtx_ws_close_heavy(&w)) _exit(0);
    return 0;
}
