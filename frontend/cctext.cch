#!ccc cch
/*
 * cctext shared types / flags. Draw is cctext_draw.ccs; keys/mouse are
 * cctext_input.ccs. The host loop stays in cctext.ccs.
 */
#ifndef RTX_CCTEXT_H
#define RTX_CCTEXT_H

#include "cctext_draw.cch"

#include "cctext_keys.cch"

extern int g_mouse_col;
extern int g_mouse_row;
extern int g_mouse_press;
extern int g_mouse_drag;
extern int g_drag_edge;
extern int g_field_drag;
extern int g_shift;
extern int g_alt;
extern int g_cmd_ch; /* letter of the last KEY_CMD_LETTER event, else 0 */
extern int g_ctrl;
extern int g_nav;
extern char g_status[160];
/* cctext_input.ccs: KEY_TEXT / KEY_PASTE_TEXT bytes and wheel notches. */
extern const char *g_text;
extern size_t g_text_n;
extern int g_wheel_n;
extern int g_wheel_at;

extern int g_cmd_row; /* KEY_CMD: the command-table row (cctext_input) */

int cctext_cmd_letter(int c);
/* Command-table row → this host's key kind (KEY_SAVE, …) or KEY_CMD with
 * g_cmd_row set. */
int cctext_kind_of_row(int row);
/* Palette rows the overlay shows for `rows` screen rows. */
int cctext_palette_vis(int rows);
int cctext_pane_cols(RtxWs *w, int cols, int pane);
void cctext_ensure_caret(RtxBuf *b, int vis);
void cctext_follow_caret(RtxBuf *b);
void !>(CCError) cctext_after_edit(RtxWs *w, RtxMeasure *m, int cols, int vis);
void cctext_draw(RtxWs *w, RtxUi *ui, int rows, int cols);
void cctext_draw_chrome(RtxWs *w, RtxUi *ui, int rows, int cols);
/* Screen writes that bypass cctext_draw (erase, busy spinner). */
void cctext_draw_invalidate(void);
/* Row `row` (1-based) was overwritten outside cctext_draw. */
void cctext_draw_row_stale(int row);
/* Blocking-work spinner on the status row (marks only that row stale). */
void cctext_draw_busy(const char *label, int pct, int rows, int cols);
/* The spinner ended; the next frame or chrome paint rewrites its row. */
int cctext_draw_busy_pending(void);
/* Region scrolls (DECSTBM + DL / IL) for full-width panes; on by default. */
void cctext_scroll_regions_set(int on);
int cctext_scroll_regions_on(void);
void cctext_hit(RtxWs *w, RtxMeasure *m, int cols, int vis, int drag);
int cctext_handle_input(RtxWs *w, RtxBuf *act, RtxMeasure *m, RtxUi *ui,
                        int kind, int ch, int vis, int cols, int *skip_reveal);

void cctext_osx_start(void);
void cctext_osx_stop(void);
void cctext_osx_focus(int on);
int cctext_osx_scroll_fd(void);
int cctext_osx_scroll_dir(void);
int cctext_osx_shift_down(void);
int cctext_osx_alt_down(void);

/* RTX_FRAME_TRACE=path: one line per loop turn that did work (ms per
 * phase). Off unless set; the draw / edit sites add into g_tr. */
typedef struct CctextTrace {
    int on;
    long after_us;  /* cctext_after_edit (reparse + relayout patch) */
    long paint_us;  /* in-memory pane + chrome paint */
    long pub_us;    /* row diff + write */
    long rows_out;  /* rows emitted this frame */
    long bytes_out; /* bytes emitted this frame (row logs) */
} CctextTrace;
extern CctextTrace g_tr;
long cctext_tr_us(void);

#endif
