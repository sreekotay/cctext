#!ccc ccs
/*
 * cctext-ui input (linked TU; see gui.cch).
 */
#include <ccc/std/prelude.cch>
#include <stdio.h>
#include <string.h>
#include "gui_plat.h"
#include "../core/document.cch"
#include "../core/nav.cch"
