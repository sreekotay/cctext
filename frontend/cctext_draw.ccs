#!ccc ccs
/*
 * cctext text/hex pane paint (linked TU; see cctext_draw.cch).
 */
#include <ccc/std/prelude.cch>
#include <stdio.h>
#include <string.h>
#include "../core/utf8.cch"
#include "../core/document.cch"
#include "../core/nav_pair.cch"
#include "../core/layout.cch"
#include "../core/workspace.cch"
#include "../core/find.cch"
#include "../core/ui.cch"
#include "../core/browse.cch"
#include "cctext.cch"

static int g_draw_mouse_row;

static size_t cctext_stat_push(char *dst, size_t cap, size_t used, char *one) {
    size_t i = 0;
    if (!dst || !one || cap == 0) return used;
    while (one[i] && used + 1 < cap) {
        dst[used] = one[i];
        used++;
        i++;
    }
    if (used + 1 < cap) {
        dst[used] = '\n';
        used++;
    }
    if (used < cap) dst[used] = 0;
    return used;
}

static void cctext_stat_line(char *text, int idx, char *out, size_t cap) {
    int n = 0;
    size_t i = 0, o = 0;
    if (!out || cap == 0) return;
    out[0] = 0;
    if (!text) return;
    while (text[i]) {
        if (n == idx) {
            while (text[i] && text[i] != '\n' && o + 1 < cap) {
                out[o] = text[i];
                o++;
                i++;
            }
            out[o] = 0;
            return;
        }
        if (text[i] == '\n') n++;
        i++;
    }
}

int cctext_rail_w(RtxBuf *b, int vis) {
    return (b && b->scroll_needed(vis)) ? CCTEXT_SCROLL_W : 0;
}

int cctext_text_cols(RtxBuf *b, int pcols, int vis) {
    int g = rtx_gutter_cols_buf(b, vis);
    int rw = cctext_rail_w(b, vis);
    int inner = pcols > rw ? pcols - rw : pcols;
    if (inner <= g + 4) return inner > 0 ? inner : 1;
    return inner - g;
}

int cctext_body_vis(RtxBuf *b, int vis, int pcols) {
    if (vis < 2 || !b) return vis < 1 ? 1 : vis;
    if (b->scroll_x_needed((double)cctext_text_cols(b, pcols, vis)))
        return vis - 1;
    return vis;
}

static const char *cctext_hl_ansi(RtxScope scope) {
    return rtx_theme_color(scope).ansi;
}

void cctext_style(RtxStyle st, int sel, int here) {
    fputs(cctext_hl_ansi(st.scope), stdout);
    if (st.bold) fputs("\x1b[1m", stdout);
    if (sel) fputs("\x1b[44m", stdout);
    if (here) fputs("\x1b[7m", stdout);
}

static void cctext_eol(int pad_to) {
    if (pad_to > 0) {
        int i;
        for (i = 0; i < pad_to; i++) fputc(' ', stdout);
    } else {
        fputs("\x1b[K", stdout);
    }
}

static void cctext_put_scroll(RtxBuf *b, int focused, int vis, int row, int col) {
    RtxScrollRail rail;
    int ty, th;
    char ch;
    const char *fg;
    @errhandler(RtxIndexErr e) {
        (void)e;
        return;
    }
    if (!b || vis < 1 || col < 1 || row < 0 || row >= vis) return;
    if (!b->scroll_needed(vis) && !(b->drag_len && !b->drag_horiz)) return;
    rail = b->scroll_rail(vis) !>;
    if (b->drag_len && !b->drag_horiz) {
        rail.vis = b->drag_vis ? b->drag_vis : rail.vis;
        rail.len = b->drag_len;
    }
    rtx_scroll_rail_thumb(&rail, vis, 1, &ty, &th);
    if (b->drag_len && !b->drag_horiz) {
        int ly = g_draw_mouse_row - 1 - b->drag_grab;
        int usable = vis - th;
        if (ly < 0) ly = 0;
        if (usable > 0 && ly > usable) ly = usable;
        ty = ly;
    }
    {
        int on_thumb = (row >= ty && row < ty + th);
        int rel = rtx_buf_scroll_rel(b);
        int mark = rtx_buf_scroll_rel_mark_y(b, &rail, vis, 1, vis);
        int on_mark = rel && row == mark;
        if (on_thumb) {
            ch = '#';
            if (on_mark)
                fg = focused ? "\x1b[7;31m" : "\x1b[7;91m";
            else
                fg = rail.ready ? (focused ? "\x1b[7;37m" : "\x1b[7;90m")
                                : (focused ? "\x1b[7;33m" : "\x1b[7;90m");
        } else if (on_mark) {
            ch = '-';
            fg = focused ? "\x1b[31m" : "\x1b[91m";
        } else if (!rail.ready && row == vis - 1) {
            ch = '+';
            fg = "\x1b[33m";
        } else {
            ch = '|';
            fg = "\x1b[90m";
        }
    }
    fprintf(stdout, "\x1b[%d;%dH%s%c\x1b[0m", row + 1, col, fg, ch);
}

static void cctext_put_scroll_x(RtxBuf *b, int focused, int vis, int pcols, int col0) {
    RtxScrollRail rail;
    int tcols = cctext_text_cols(b, pcols, vis);
    int g = rtx_gutter_cols_buf(b, vis);
    int body = cctext_body_vis(b, vis, pcols);
    int rw = cctext_rail_w(b, vis);
    int inner = pcols > rw ? pcols - rw : pcols;
    int tx, th;
    int c;
    if (!b || body >= vis || inner < 1) return;
    rail = b->scroll_x_rail((double)tcols);
    if (b->drag_horiz && b->drag_len) {
        rail.vis = b->drag_vis ? b->drag_vis : rail.vis;
        rail.len = b->drag_len;
    }
    rtx_scroll_rail_thumb(&rail, tcols, 1, &tx, &th);
    if (b->drag_horiz && b->drag_len) {
        int lx = g_mouse_col - col0 - g - b->drag_grab;
        int usable = tcols - th;
        if (lx < 0) lx = 0;
        if (usable > 0 && lx > usable) lx = usable;
        tx = lx;
    }
    fprintf(stdout, "\x1b[%d;%dH", body + 1, col0);
    for (c = 0; c < g && c < inner; c++) fputc(' ', stdout);
    for (c = 0; c < tcols; c++) {
        int on = (c >= tx && c < tx + th);
        if (on)
            fputs(focused ? "\x1b[7;37m#\x1b[0m" : "\x1b[7;90m#\x1b[0m", stdout);
        else
            fputs("\x1b[90m-\x1b[0m", stdout);
    }
    for (c = 0; c < rw; c++) fputs("\x1b[90m+\x1b[0m", stdout);
}

void cctext_row_end(RtxBuf *b, int focused, int vis, int pcols, int col0,
                    int pad_rest, int used, int row) {
    int rw = cctext_rail_w(b, vis);
    int body = cctext_body_vis(b, vis, pcols);
    cctext_eol(pad_rest ? pcols - rw - used : 0);
    if (rw) cctext_put_scroll(b, focused, body, row, col0 + pcols - rw);
}

static void cctext_draw_hex_pane(RtxBuf *b, const RtxUi *ui, int focused, int vis,
                                 int pcols, int col0, int pad_rest) {
    size_t r;
    size_t n = b->len();
    int has = b->doc.has_sel();
    size_t plo = 0, phi = 0;
    int phave;
    static const char *hexd = "0123456789ABCDEF";
    @errhandler(RtxIndexErr e) {
        (void)e;
        return;
    }
    phave = rtx_nav_pair_ends(&b->doc.tree, b->doc.runs.data, b->doc.runs.len,
                             b->doc.caret, b->doc.edit_gen, b->doc.runs.len,
                             &plo, &phi);
    b->top_byte = rtx_hex_align(b->top_byte);
    {
        int body = cctext_body_vis(b, vis, pcols);
        for (r = 0; r < (size_t)body; r++) {
        size_t off = rtx_hex_row_off(b->top_byte, r);
        unsigned char win[RTX_HEX_DUMP_WIN];
        unsigned char *row;
        RtxHexDumpCell dump[RTX_HEX_COLS];
        size_t take = (size_t)RTX_HEX_COLS;
        size_t look = 0;
        size_t tail = 0;
        size_t got = 0;
        size_t k;
        int used = 0;
        fprintf(stdout, "\x1b[%zu;%dH", r + 1, col0);
        if (off >= n && !(n == 0 && r == 0)) {
            fputs("\x1b[90m~\x1b[0m", stdout);
            used = 1;
            cctext_row_end(b, focused, vis, pcols, col0, pad_rest, used, (int)r);
            continue;
        }
        if (take > n - off) take = n - off;
        look = rtx_hex_dump_look(off);
        tail = rtx_hex_dump_tail(off, take, n);
        {
            size_t wn = 0;
            size_t want = look + take + tail;
            if (want) {
                @errhandler(CCError e) {
                    (void)e;
                    wn = 0;
                }
                wn = b->read_at(off - look, (char *)win, want) !>;
            }
            if (wn > look) {
                got = wn - look;
                if (got > take) got = take;
            }
            rtx_hex_dump_row(win, wn, look, got, dump);
        }
        row = win + look;
        fprintf(stdout, "\x1b[34m%0*zX \x1b[0m", RTX_HEX_OFF_W - 1, off);
        used = RTX_HEX_OFF_W;
        for (k = 0; k < (size_t)RTX_HEX_COLS; k++) {
            size_t at = off + k;
            int sel = has && at < n && (b->doc.sel_covers(at) !>);
            int here = rtx_ui_here(ui, focused, b->doc.caret == at);
            int match = phave && at < n && (at == plo || at == phi);
            int nib0 = here && !b->hex_nib;
            int nib1 = here && b->hex_nib;
            if (k < got) {
                if (sel || nib0 || match)
                    fputs(nib0 ? "\x1b[7m" : sel ? "\x1b[44m"
                                                : rtx_theme_pair().ansi,
                          stdout);
                fputc(hexd[(row[k] >> 4) & 0xF], stdout);
                if (sel || nib0 || match) fputs("\x1b[0m", stdout);
                if (sel || nib1 || match)
                    fputs(nib1 ? "\x1b[7m" : sel ? "\x1b[44m"
                                                : rtx_theme_pair().ansi,
                          stdout);
                fputc(hexd[row[k] & 0xF], stdout);
                if (sel || nib1 || match) fputs("\x1b[0m", stdout);
            } else {
                fputs("  ", stdout);
            }
            fputc(' ', stdout);
            used += 3;
        }
        {
            int g;
            for (g = 0; g < RTX_HEX_GAP; g++) fputc(' ', stdout);
            used += RTX_HEX_GAP;
        }
        for (k = 0; k < (size_t)RTX_HEX_COLS; k++) {
            size_t at = off + k;
            int sel = has && at < n && (b->doc.sel_covers(at) !>);
            int here = rtx_ui_here(ui, focused, b->doc.caret == at);
            int match = phave && at < n && (at == plo || at == phi);
            int cont = k < got && dump[k].kind == RTX_HEX_DUMP_CONT;
            if (k >= got || dump[k].kind == RTX_HEX_DUMP_EMPTY) {
                fputc(' ', stdout);
            } else {
                if (here) fputs("\x1b[7m", stdout);
                else if (sel) fputs("\x1b[44m", stdout);
                else if (match) fputs(rtx_theme_pair().ansi, stdout);
                else if (cont) fputs("\x1b[90m", stdout);
                fwrite(dump[k].utf8, 1, (size_t)(dump[k].n > 0 ? dump[k].n : 1),
                       stdout);
                if (here || sel || match || cont) fputs("\x1b[0m", stdout);
            }
            used++;
        }
        cctext_row_end(b, focused, vis, pcols, col0, pad_rest, used, (int)r);
    }
    }
}

void cctext_draw_pane(RtxBuf *b, const RtxUi *ui, int focused, int vis,
                      int pcols, int col0, int pad_rest, char *status,
                      size_t statusn, int mouse_row) {
    size_t r;
    int has = b->doc.has_sel();
    int g = rtx_gutter_cols_buf(b, vis);
    int tcols = cctext_text_cols(b, pcols, vis);
    size_t plo = 0, phi = 0;
    int phave;
    g_draw_mouse_row = mouse_row;
    @errhandler(CCError e) {
        if (status && statusn)
            snprintf(status, statusn, "%s", e.message ? e.message : "span failed");
        fputs("\x1b[0m", stdout);
        return;
    }
    @errhandler(RtxIndexErr e) {
        (void)e;
        return;
    }
    if (rtx_layout_is_hex(&b->layout)) {
        cctext_draw_hex_pane(b, ui, focused, vis, pcols, col0, pad_rest);
    } else if (rtx_layout_is_grid(&b->layout)) {
        cctext_draw_grid_pane(b, ui, focused, vis, pcols, col0, pad_rest);
    } else {
    phave = rtx_nav_pair_ends(&b->doc.tree, b->doc.runs.data, b->doc.runs.len,
                             b->doc.caret, b->doc.edit_gen, b->doc.runs.len,
                             &plo, &phi);
    {
        int body = cctext_body_vis(b, vis, pcols);
    for (r = 0; r < (size_t)body; r++) {
        size_t idx = r + b->top_wrap;
        int used = 0;
        fprintf(stdout, "\x1b[%zu;%dH", r + 1, col0);
        if (idx >= b->layout.rows.len) {
            fputs("\x1b[90m", stdout);
            {
                int i;
                for (i = 0; i < g - 1; i++) fputc(' ', stdout);
            }
            fputs("~\x1b[0m", stdout);
            used = g;
            cctext_row_end(b, focused, vis, pcols, col0, pad_rest, used, (int)r);
            continue;
        }
        {
            RtxVisRow *row = &b->layout.rows.data[idx];
            size_t k;
            size_t col = 0;
            size_t virt = 0;
            size_t line = row->line;
            int show_ln = (idx == 0 || b->layout.rows.data[idx - 1].line != line);
            int caret_end = rtx_ui_here(ui, focused,
                                       b->doc.caret == row->byte_start + row->byte_len);
            int last_sel = -1, last_here = -1, last_pair = -1, last_bold = -1;
            RtxScope last_scope = (RtxScope)-1;
            int span_ok = 1;
            CCArena scratch = {0};
            if (row->byte_len) {
                scratch = cc_arena_heap(row->byte_len + 64);
                if (!scratch.base) span_ok = 0;
            }
            if (show_ln) {
                size_t abs = 0, plus = 0;
                int gap = rtx_gutter_gap(b, row->byte_start, line, &abs, &plus);
                if (gap) {
                    char gn[16];
                    snprintf(gn, sizeof gn, gap < 0 ? "-%zu" : "+%zu", plus);
                    fprintf(stdout, "\x1b[31m%*s \x1b[0m", g - 1, gn);
                } else
                    fprintf(stdout, "\x1b[90m%*zu \x1b[0m", g - 1, abs);
            }
            else {
                int i;
                fputs("\x1b[90m", stdout);
                for (i = 0; i < g - 1; i++) fputc(' ', stdout);
                fputs(" \x1b[0m", stdout);
            }
            char[:] bytes = cc_slice_empty();
            {
                @errhandler(CCError e) {
                    (void)e;
                    span_ok = 0;
                }
                bytes = b->scratch_span(row->byte_start, row->byte_len,
                                        scratch) !>;
            }
            if (!span_ok) {
                if (scratch.base) scratch.destroy();
                fputs("\x1b[0m", stdout);
                used = g;
                cctext_row_end(b, focused, vis, pcols, col0, pad_rest, used, (int)r);
                continue;
            }
            k = 0;
            while (k < bytes.len && col < (size_t)tcols) {
                RtxUtf8Cl cl = rtx_utf8_cluster(bytes, k);
                size_t step = cl.n ? cl.n : 1;
                size_t off = row->byte_start + k;
                RtxStyle st = b->doc.style_at(off);
                int here = rtx_ui_here(ui, focused, b->doc.caret == off);
                int sel = has && (b->doc.sel_covers(off) !>);
                int pair = phave && (off == plo || off == phi);
                {
                    char put[RTX_UTF8_LOOK];
                    int pn = rtx_utf8_term_put(cl.cp, bytes.ptr + k, step, put,
                                               sizeof(put));
                    int pc = rtx_utf8_term_cols(cl.cp, cl.cols);
                    if (pc < 1) pc = 0;
                    if ((size_t)pc > 0 && virt < b->left_col) {
                        virt += (size_t)pc;
                        k += step;
                        continue;
                    }
                    if ((size_t)pc > 0 && col + (size_t)pc > (size_t)tcols) break;
                    if (st.scope != last_scope || (int)st.bold != last_bold ||
                        sel != last_sel || here != last_here ||
                        pair != last_pair) {
                        fputs("\x1b[0m", stdout);
                        cctext_style(st, sel, here);
                        if (pair && !sel) fputs(rtx_theme_pair().ansi, stdout);
                        last_scope = st.scope;
                        last_bold = (int)st.bold;
                        last_sel = sel;
                        last_here = here;
                        last_pair = pair;
                    }
                    if (pn > 0) {
                        if (cl.cp == RTX_UTF8_FFFD && step == 1 &&
                            (unsigned char)bytes.ptr[k] >= 0x80) {
                            fputs("\xEF\xBF\xBD", stdout);
                        } else {
                            fwrite(put, 1, (size_t)pn, stdout);
                        }
                    }
                    col += (size_t)pc;
                    k += step;
                }
            }
            if (caret_end && col < (size_t)tcols) {
                fputs("\x1b[0m\x1b[7m \x1b[0m", stdout);
                col++;
            } else {
                fputs("\x1b[0m", stdout);
            }
            used = g + (int)col;
            if (scratch.base) scratch.destroy();
            cctext_row_end(b, focused, vis, pcols, col0, pad_rest, used, (int)r);
        }
    }
    }
    }
    if (cctext_body_vis(b, vis, pcols) < vis)
        cctext_put_scroll_x(b, focused, vis, pcols, col0);
}

void cctext_draw_stats(RtxBuf *b, int rows, int cols) {
    char text[768];
    char one[96];
    char a[32], c[32], e[32], f[32];
    int n = 0, i, box_w = 54, box_h, r0, c0;
    size_t used = 0, from = 0, to = 0, plo = 0, phi = 0, live = 0, si;
    int have = 0, covered = 0;
    const char *lf = "soft";
    const char *kindn = "unk";
    const char *winst = "walk";
    const char *findst = "walk";
    char lkind, wkind, fkind;
    RtxDoc *d = b ? &b->doc : NULL;
    RtxPageStore *st = d ? &d->tree.store : NULL;
    RtxMarkupWin *last = NULL;
    size_t livew = 0, walk = 0, wi;
    text[0] = 0;
    if (st && st->slots) {
        for (si = 0; si < st->slot_n; si++)
            if (st->slots[si].file_id >= 0) live++;
    }
    if (d) {
        rtx_nav_brace_pages(d->caret, d->len(), &from, &to);
        have = rtx_nav_pair_ends(&d->tree, d->runs.data, d->runs.len, d->caret,
                                 d->edit_gen, d->runs.len, &plo, &phi);
        covered = d->index_covers(d->caret);
        if (d->tree.lf_ready) lf = "ready";
        for (wi = 0; wi < (size_t)RTX_MARKUP_CACHE_WINDOWS; wi++) {
            RtxMarkupWin *mw = &d->hl_win[wi];
            if (!mw->live) continue;
            livew++;
            if (!mw->ready) walk++;
            if (!last || mw->stamp >= last->stamp) last = mw;
        }
    }
    lkind = (d && !d->tree.lf_ready) ? '!' : '.';
    wkind = walk ? '!' : '.';
    snprintf(one, sizeof one, "#FILE");
    used = cctext_stat_push(text, sizeof text, used, one);
    n++;
    rtx_ui_fmt_bytes(a, sizeof a, d ? d->len() : 0);
    snprintf(c, sizeof c, "%zu", d ? d->caret : 0);
    snprintf(one, sizeof one, ".%-8s %-16s %-8s %s", "bytes", a, "caret", c);
    used = cctext_stat_push(text, sizeof text, used, one);
    n++;
    snprintf(a, sizeof a, "%zu / %zu", live, st ? st->slot_n : 0);
    if (st && st->orig_open && st->add_open)
        snprintf(c, sizeof c, "orig + add");
    else if (st && st->orig_open)
        snprintf(c, sizeof c, "orig");
    else if (st && st->add_open)
        snprintf(c, sizeof c, "add");
    else
        snprintf(c, sizeof c, "-");
    snprintf(one, sizeof one, ".%-8s %-16s %-8s %s", "pages", a, "store", c);
    used = cctext_stat_push(text, sizeof text, used, one);
    n++;
    snprintf(one, sizeof one, "#LINES");
    used = cctext_stat_push(text, sizeof text, used, one);
    n++;
    rtx_ui_fmt_bytes(a, sizeof a, d ? d->tree.line_scan_off : 0);
    rtx_ui_fmt_pct(c, sizeof c, d ? d->tree.line_scan_off : 0,
                    d ? d->len() : 0);
    snprintf(e, sizeof e, "%s %s", a, c);
    snprintf(c, sizeof c, "L%zu", d ? d->tree.scan_line : 0);
    snprintf(one, sizeof one, "%c%-8s %-16s %-8s %s", lkind, "scan", e,
             "line", c);
    used = cctext_stat_push(text, sizeof text, used, one);
    n++;
    snprintf(a, sizeof a, "%s · %zu slots", lf, d ? d->tree.line_off_len : 0);
    snprintf(c, sizeof c, "%s", covered ? "known" : "gap");
    snprintf(one, sizeof one, "%c%-8s %-16s %-8s %s",
             covered ? lkind : '!', "index", a, "caret", c);
    used = cctext_stat_push(text, sizeof text, used, one);
    n++;
    if (b && b->seek_valid)
        snprintf(c, sizeof c, "%zu", b->seek_off);
    else
        snprintf(c, sizeof c, "-");
    snprintf(one, sizeof one, ".%-8s %s", "seek", c);
    used = cctext_stat_push(text, sizeof text, used, one);
    n++;
    if (d && rtx_line_isle_live(&d->tree)) {
        const char *ist = rtx_line_isle_connected(&d->tree) ? "met" : "back";
        rtx_ui_fmt_bytes(a, sizeof a, d->tree.isle_from);
        rtx_ui_fmt_bytes(c, sizeof c, d->tree.isle_anchor);
        snprintf(e, sizeof e, "%s .. %s", a, c);
        snprintf(one, sizeof one, "%c%-8s %-16s %-8s %s",
                 rtx_line_isle_pumping(&d->tree) ? '!' : '.', "island", e,
                 "state", ist);
        used = cctext_stat_push(text, sizeof text, used, one);
        n++;
    }
    snprintf(one, sizeof one, "#GRAMMAR");
    used = cctext_stat_push(text, sizeof text, used, one);
    n++;
    snprintf(a, sizeof a, "%zu · %zu sec", d ? d->runs.len : 0,
             d ? d->secs.len : 0);
    snprintf(c, sizeof c, "%zu", d ? d->fold_n : 0);
    snprintf(one, sizeof one, ".%-8s %-16s %-8s %s", "runs", a, "folds", c);
    used = cctext_stat_push(text, sizeof text, used, one);
    n++;
    snprintf(a, sizeof a, "%zu / %d", livew, RTX_MARKUP_CACHE_WINDOWS);
    snprintf(c, sizeof c, walk ? "walk %zu" : "idle", walk);
    snprintf(one, sizeof one, "%c%-8s %-16s %-8s %s", wkind, "windows", a,
             "state", c);
    used = cctext_stat_push(text, sizeof text, used, one);
    n++;
    snprintf(a, sizeof a, "%s", d && d->hl_full ? "full" : "windowed");
    snprintf(c, sizeof c, "%zu", d ? d->tm_ckpt.len : 0);
    snprintf(one, sizeof one, ".%-8s %-16s %-8s %s", "mode", a, "ckpt", c);
    used = cctext_stat_push(text, sizeof text, used, one);
    n++;
    if (last) {
        if (last->kind == RTX_SEC_CODE) kindn = "code";
        else if (last->kind == RTX_SEC_PROSE) kindn = "prose";
        if (last->ready) winst = "ready";
        rtx_ui_fmt_bytes(a, sizeof a, last->from);
        rtx_ui_fmt_bytes(c, sizeof c, last->to);
        snprintf(e, sizeof e, "%s .. %s", a, c);
        snprintf(f, sizeof f, "%s %s", kindn, winst);
        snprintf(one, sizeof one, "%c%-8s %-16s %-8s %s",
                 last->ready ? '.' : '!', "last", e, "kind", f);
        used = cctext_stat_push(text, sizeof text, used, one);
        n++;
    }
    if (d && d->find.query.len) {
        if (d->find.done) findst = d->find.truncated ? "trunc" : "done";
        fkind = d->find.done ? '.' : '!';
        snprintf(one, sizeof one, "#FIND");
        used = cctext_stat_push(text, sizeof text, used, one);
        n++;
        snprintf(a, sizeof a, "%zu", d->find.len);
        rtx_ui_fmt_pct(c, sizeof c, d->find.scan_off, d->len());
        snprintf(one, sizeof one, "%c%-8s %-16s %-8s %s", fkind, "hits", a,
                 "scan", c);
        used = cctext_stat_push(text, sizeof text, used, one);
        n++;
        snprintf(one, sizeof one, "%c%-8s %s", fkind, "state", findst);
        used = cctext_stat_push(text, sizeof text, used, one);
        n++;
    }
    snprintf(one, sizeof one, "#PAIR");
    used = cctext_stat_push(text, sizeof text, used, one);
    n++;
    rtx_ui_fmt_bytes(a, sizeof a, to > from ? to - from : 0);
    if (have)
        snprintf(c, sizeof c, "%zu .. %zu", plo, phi);
    else
        snprintf(c, sizeof c, "-");
    snprintf(one, sizeof one, ".%-8s %-16s %-8s %s", "span", a, "match", c);
    used = cctext_stat_push(text, sizeof text, used, one);
    n++;
    (void)used;
    box_h = n + 3;
    if (box_w > cols - 2) box_w = cols - 2;
    if (box_h > rows - 2) box_h = rows - 2;
    r0 = (rows - box_h) / 2;
    if (r0 < 1) r0 = 1;
    c0 = (cols - box_w) / 2;
    if (c0 < 1) c0 = 1;
    for (i = 0; i < box_h; i++) {
        fprintf(stdout, "\x1b[%d;%dH", r0 + i, c0);
        if (i == 0) {
            fputs("\x1b[45;97;1m  engine", stdout);
            {
                int p;
                for (p = 8; p < box_w; p++) fputc(' ', stdout);
            }
        } else if (i == 1 || i == box_h - 1) {
            fputs("\x1b[45;35m ", stdout);
            {
                int p;
                for (p = 1; p < box_w - 1; p++) fputc('-', stdout);
            }
            fputc(' ', stdout);
        } else if (i - 2 < n) {
            int pad;
            char kind;
            char *body;
            cctext_stat_line(text, i - 2, one, sizeof one);
            kind = one[0];
            body = one[0] ? one + 1 : one;
            if (kind == '#') fputs("\x1b[45;96;1m ", stdout);
            else if (kind == '!') fputs("\x1b[45;93m ", stdout);
            else fputs("\x1b[45;97m ", stdout);
            fputs(body, stdout);
            pad = 1 + (int)strlen(body);
            while (pad < box_w) {
                fputc(' ', stdout);
                pad++;
            }
        }
        fputs("\x1b[0m", stdout);
    }
}

int cctext_pane_cols(RtxWs *w, int cols, int pane) {
    if (w->npanes < 2) return cols;
    if (pane == 0) return cols / 2 - 1;
    return cols - (cols / 2) - 1;
}

static int cctext_put_field(RtxField f, const RtxUi *ui, const char *restore,
                            int used, int maxc) {
    size_t i, n, lo, hi;
    char[:] bytes;
    const char *caret = ui ? rtx_ui_prompt_caret(ui) : "";
    int has;
    rtx_field_clamp(f);
    n = f.len ? *f.len : 0;
    bytes = rtx_field_bytes(f);
    lo = rtx_field_lo(f);
    hi = rtx_field_hi(f);
    has = rtx_field_has_sel(f);
    i = 0;
    while (i <= n && used < maxc) {
        if (f.caret && *f.caret == i && caret && caret[0]) {
            fputs(caret, stdout);
            used++;
            if (used >= maxc) break;
        }
        if (i >= n) break;
        {
            RtxUtf8Cl cl = rtx_utf8_cluster(bytes, i);
            size_t step = cl.n ? cl.n : 1;
            int sel = has && i >= lo && i < hi;
            if (cl.cols > 0 && used + cl.cols > maxc) break;
            if (sel) fputs("\x1b[7m", stdout);
            if (f.buf) fwrite(f.buf + i, 1, step, stdout);
            if (sel) fputs(restore ? restore : "\x1b[0m", stdout);
            used += cl.cols;
            i += step;
        }
    }
    return used;
}

static void cctext_browse_face(int selected, RtxBrowseFace face) {
    fputs("\x1b[0m", stdout);
    if (selected) fputs("\x1b[44m", stdout);
    fputs(rtx_browse_face(face).ansi, stdout);
}

static void cctext_browse_pad(int n, int selected) {
    int i;
    fputs("\x1b[0m", stdout);
    if (selected) fputs("\x1b[44m", stdout);
    for (i = 0; i < n; i++) fputc(' ', stdout);
}

static void cctext_browse_text(const char *s, int maxc) {
    int n = 0;
    if (!s) return;
    while (s[n] && n < maxc) {
        fputc(s[n], stdout);
        n++;
    }
}

static void cctext_browse_row(int row, int col0, int pcols, int pad_rest,
                              int selected, const char *text, RtxBrowseFace face) {
    int n = 0;
    fprintf(stdout, "\x1b[%d;%dH", row, col0);
    cctext_browse_face(selected, face);
    if (text) {
        while (text[n] && n < pcols) {
            fputc(text[n], stdout);
            n++;
        }
    }
    cctext_browse_pad(pcols - n, selected);
    fputs("\x1b[0m", stdout);
    if (!pad_rest) fputs("\x1b[K", stdout);
}

static void cctext_browse_ent(int row, int col0, int pcols, int pad_rest,
                              int selected, const RtxBrowse *br,
                              const RtxBrowseEnt *e) {
    char name[RTX_BROWSE_NAME + 2];
    char size[12];
    char when[24];
    int meta = RTX_BROWSE_SIZE_W + 2 + RTX_BROWSE_MTIME_W;
    int show = pcols >= 10 + meta;
    int size_at = show ? pcols - meta : pcols;
    int name_w = size_at - 2;
    int used;
    if (name_w < 1) name_w = 1;
    fprintf(stdout, "\x1b[%d;%dH", row, col0);
    cctext_browse_pad(1, selected);
    snprintf(name, sizeof(name), "%s%s", e->name,
             (e->is_dir && !e->sep) ? "/" : "");
    {
        size_t pref = rtx_browse_dir_prefix(name);
        size_t hit = 0, hn = 0, ext = 0, en = 0, i = 0;
        int left = name_w;
        rtx_browse_hit_span(br, name, &hit, &hn);
        if (!e->is_dir && !e->sep) rtx_tm_ext_span(name, &ext, &en);
        if (e->sep) {
            cctext_browse_face(selected, RTX_BROWSE_FACE_GLOB);
            cctext_browse_text(name, left);
            left = 0;
        }
        while (left > 0 && name[i]) {
            RtxBrowseFace fa, fb;
            size_t j = i;
            int n;
            fa = rtx_browse_name_face(e->is_dir, i, pref, hit, hn, ext, en);
            j++;
            while (name[j]) {
                fb = rtx_browse_name_face(e->is_dir, j, pref, hit, hn, ext, en);
                if (fb != fa) break;
                j++;
            }
            n = (int)(j - i);
            if (n > left) n = left;
            cctext_browse_face(selected, fa);
            cctext_browse_text(name + i, n);
            left -= n;
            i = j;
        }
    }
    used = 1 + (int)strlen(name);
    if (used > 1 + name_w) used = 1 + name_w;
    if (used < size_at) cctext_browse_pad(size_at - used, selected);
    if (show) {
        rtx_browse_fmt_size(size, sizeof(size), e);
        rtx_browse_fmt_mtime(when, sizeof(when), e);
        if (e->size_denied) {
            fputs("\x1b[0m\x1b[41;97m", stdout);
            cctext_browse_text(size, RTX_BROWSE_SIZE_W);
        } else {
            cctext_browse_face(selected, rtx_browse_size_face(br, e));
            cctext_browse_text(size, RTX_BROWSE_SIZE_W);
        }
        cctext_browse_pad(2, selected);
        cctext_browse_face(selected, RTX_BROWSE_FACE_DATE);
        cctext_browse_text(when, RTX_BROWSE_MTIME_W);
        used = size_at + meta;
    }
    if (used < pcols) cctext_browse_pad(pcols - used, selected);
    fputs("\x1b[0m", stdout);
    if (!pad_rest) fputs("\x1b[K", stdout);
}

static double cctext_prev_measure(void *ctx, char[:] bytes, RtxStyle style,
                                 RtxSectionKind sec) {
    (void)ctx;
    (void)style;
    (void)sec;
    return (double)rtx_utf8_cols(bytes);
}

static double cctext_prev_lh(void *ctx, RtxStyle style, RtxSectionKind sec) {
    (void)ctx;
    (void)style;
    (void)sec;
    return 1.0;
}

static void cctext_draw_browse_prev_hex(RtxBrowsePrev *pv, int row0, int col0,
                                        int cols, int vis, int pad_rest) {
    size_t r;
    size_t n;
    static const char *hexd = "0123456789ABCDEF";
    size_t htop;
    if (!pv || !pv->live) return;
    n = pv->doc.len();
    htop = pv->cam.top_byte;
    if (!htop && pv->cam.seek_valid) htop = pv->cam.seek_off;
    htop = rtx_hex_align(htop);
    for (r = 0; r < (size_t)vis; r++) {
        size_t off = rtx_hex_row_off(htop, r);
        unsigned char win[RTX_HEX_DUMP_WIN];
        unsigned char *row;
        RtxHexDumpCell dump[RTX_HEX_COLS];
        size_t take = (size_t)RTX_HEX_COLS;
        size_t look = 0, tail = 0, got = 0, k;
        int used = 0;
        fprintf(stdout, "\x1b[%d;%dH", row0 + (int)r, col0);
        if (off >= n && !(n == 0 && r == 0)) {
            fputs("\x1b[90m~\x1b[0m", stdout);
            used = 1;
            cctext_browse_pad(cols - used, 0);
            fputs("\x1b[0m", stdout);
            if (!pad_rest) fputs("\x1b[K", stdout);
            continue;
        }
        if (take > n - off) take = n - off;
        look = rtx_hex_dump_look(off);
        tail = rtx_hex_dump_tail(off, take, n);
        {
            size_t wn = 0;
            size_t want = look + take + tail;
            if (want) {
                @errhandler(CCError e) {
                    (void)e;
                    wn = 0;
                }
                wn = pv->doc.read_at(off - look, (char *)win, want) !>;
            }
            if (wn > look) {
                got = wn - look;
                if (got > take) got = take;
            }
            rtx_hex_dump_row(win, wn, look, got, dump);
        }
        row = win + look;
        if (used + RTX_HEX_OFF_W <= cols) {
            fprintf(stdout, "\x1b[34m%0*zX \x1b[0m", RTX_HEX_OFF_W - 1, off);
            used += RTX_HEX_OFF_W;
        }
        for (k = 0; k < (size_t)RTX_HEX_COLS && used + 3 <= cols; k++) {
            size_t at = off + k;
            int here = k < got && pv->doc.caret == at;
            int sel = k < got && rtx_browse_prev_sel(&pv->doc, at);
            if (sel || here) fputs(here ? "\x1b[7m" : "\x1b[44m", stdout);
            if (k < got) {
                fputc(hexd[(row[k] >> 4) & 0xF], stdout);
                fputc(hexd[row[k] & 0xF], stdout);
            } else {
                fputs("  ", stdout);
            }
            if (sel || here) fputs("\x1b[0m", stdout);
            fputc(' ', stdout);
            used += 3;
        }
        if (used + RTX_HEX_GAP <= cols) {
            int g;
            for (g = 0; g < RTX_HEX_GAP; g++) fputc(' ', stdout);
            used += RTX_HEX_GAP;
        }
        for (k = 0; k < (size_t)RTX_HEX_COLS && used < cols; k++) {
            if (k >= got || dump[k].kind == RTX_HEX_DUMP_EMPTY) {
                fputc(' ', stdout);
            } else {
                if (dump[k].kind == RTX_HEX_DUMP_CONT) fputs("\x1b[90m", stdout);
                fwrite(dump[k].utf8, 1, (size_t)(dump[k].n > 0 ? dump[k].n : 1),
                       stdout);
                if (dump[k].kind == RTX_HEX_DUMP_CONT) fputs("\x1b[0m", stdout);
            }
            used++;
        }
        cctext_browse_pad(cols - used, 0);
        fputs("\x1b[0m", stdout);
        if (!pad_rest) fputs("\x1b[K", stdout);
    }
}

static void cctext_draw_browse_prev_text(RtxBrowsePrev *pv, int row0, int col0,
                                         int cols, int vis, int pad_rest) {
    size_t r;
    size_t skip;
    if (!pv || !pv->live) return;
    skip = pv->cam.top_wrap;
    for (r = 0; r < (size_t)vis; r++) {
        size_t ri = r + skip;
        int used = 0;
        fprintf(stdout, "\x1b[%d;%dH", row0 + (int)r, col0);
        if (ri >= pv->layout.rows.len) {
            fputs("\x1b[90m~\x1b[0m", stdout);
            used = 1;
            cctext_browse_pad(cols - used, 0);
            fputs("\x1b[0m", stdout);
            if (!pad_rest) fputs("\x1b[K", stdout);
            continue;
        }
        {
            RtxVisRow *row = &pv->layout.rows.data[ri];
            size_t k = 0;
            size_t col = 0;
            size_t virt = 0;
            int span_ok = 1;
            int last_sel = -1, last_here = -1, last_bold = -1;
            CCArena scratch = {0};
            char[:] bytes = cc_slice_empty();
            RtxScope last_scope = (RtxScope)-1;
            if (row->byte_len) {
                scratch = cc_arena_heap(row->byte_len + 64);
                if (!scratch.base) span_ok = 0;
            }
            {
                @errhandler(CCError e) {
                    (void)e;
                    span_ok = 0;
                }
                bytes = pv->doc.scratch_span(row->byte_start, row->byte_len,
                                             scratch) !>;
            }
            if (!span_ok) {
                if (scratch.base) scratch.destroy();
                cctext_browse_pad(cols, 0);
                fputs("\x1b[0m", stdout);
                if (!pad_rest) fputs("\x1b[K", stdout);
                continue;
            }
            while (k < bytes.len && col < (size_t)cols) {
                RtxUtf8Cl cl = rtx_utf8_cluster(bytes, k);
                size_t step = cl.n ? cl.n : 1;
                size_t off = row->byte_start + k;
                RtxStyle st = pv->doc.style_at(off);
                int here = pv->doc.caret == off;
                int sel = rtx_browse_prev_sel(&pv->doc, off);
                char put[RTX_UTF8_LOOK];
                int pn = rtx_utf8_term_put(cl.cp, bytes.ptr + k, step, put,
                                           sizeof(put));
                int pc = rtx_utf8_term_cols(cl.cp, cl.cols);
                if (pc < 1) pc = 0;
                if ((size_t)pc > 0 && virt < pv->cam.left_col) {
                    virt += (size_t)pc;
                    k += step;
                    continue;
                }
                if ((size_t)pc > 0 && col + (size_t)pc > (size_t)cols) break;
                if (st.scope != last_scope || (int)st.bold != last_bold ||
                    sel != last_sel || here != last_here) {
                    fputs("\x1b[0m", stdout);
                    cctext_style(st, sel, here);
                    last_scope = st.scope;
                    last_bold = (int)st.bold;
                    last_sel = sel;
                    last_here = here;
                }
                if (pn > 0) fwrite(put, 1, (size_t)pn, stdout);
                col += (size_t)pc;
                virt += (size_t)pc;
                k += step;
            }
            used = (int)col;
            if (scratch.base) scratch.destroy();
        }
        fputs("\x1b[0m", stdout);
        cctext_browse_pad(cols - used, 0);
        fputs("\x1b[0m", stdout);
        if (!pad_rest) fputs("\x1b[K", stdout);
    }
}

static void cctext_draw_browse_prev_rail(RtxBrowsePrev *pv, int focused,
                                        int vis, int row, int screen_row,
                                        int col) {
    RtxScrollRail rail;
    int ty, th;
    char ch;
    const char *fg;
    int on_thumb, on_mark, mark;
    if (!pv || !pv->live || vis < 1 || col < 1 || row < 0 || row >= vis)
        return;
    rail = rtx_browse_prev_rail(pv, vis);
    rtx_scroll_rail_thumb(&rail, vis, 1, &ty, &th);
    mark = rtx_scroll_rail_mark_y(&rail, vis, pv->doc.caret);
    on_thumb = (row >= ty && row < ty + th);
    on_mark = row == mark;
    if (on_thumb) {
        ch = '#';
        if (on_mark)
            fg = focused ? "\x1b[7;33m" : "\x1b[7;90m";
        else
            fg = rail.ready ? (focused ? "\x1b[7;37m" : "\x1b[7;90m")
                            : (focused ? "\x1b[7;33m" : "\x1b[7;90m");
    } else if (on_mark) {
        ch = '+';
        fg = focused ? "\x1b[33m" : "\x1b[90m";
    } else if (!rail.ready && row == vis - 1) {
        ch = '+';
        fg = "\x1b[33m";
    } else {
        ch = '|';
        fg = "\x1b[90m";
    }
    fprintf(stdout, "\x1b[%d;%dH%s%c\x1b[0m", screen_row, col, fg, ch);
}

static void cctext_draw_browse_prev_grid(RtxBrowsePrev *pv, int row0, int col0,
                                        int cols, int vis, int pad_rest) {
    size_t r;
    int hdr;
    if (!pv || !pv->live || cols < 1 || vis < 1) return;
    hdr = pv->layout.grid_hdr_on;
    for (r = 0; r < (size_t)vis; r++) {
        int is_hdr = hdr && r == 0;
        size_t idx = is_hdr ? 0 : r - (size_t)hdr + pv->cam.top_wrap;
        int used = 0;
        fprintf(stdout, "\x1b[%d;%dH", row0 + (int)r, col0);
        if (!is_hdr && idx >= pv->layout.rows.len) {
            fputs("\x1b[90m~\x1b[0m", stdout);
            used = 1;
            cctext_browse_pad(cols - used, 0);
            fputs("\x1b[0m", stdout);
            if (!pad_rest) fputs("\x1b[K", stdout);
            continue;
        }
        {
            RtxVisRow head;
            RtxVisRow *row;
            size_t c, col = 0, virt = 0;
            int span_ok = 1;
            CCArena heap = {0};
            char[:] bytes = cc_slice_empty();
            if (is_hdr) {
                head.byte_start = 0;
                head.byte_len = pv->layout.grid_hdr_end;
                head.line = 0;
                head.wrap_i = 0;
                head.width = 0;
                head.height = 1;
                head.sec = RTX_SEC_CODE;
                row = &head;
                fputs("\x1b[48;5;236m", stdout);
            } else {
                row = &pv->layout.rows.data[idx];
            }
            if (row->byte_len) {
                heap = cc_arena_heap(row->byte_len + 64);
                if (!heap.base) span_ok = 0;
                else {
                    @errhandler(CCError e) {
                        (void)e;
                        span_ok = 0;
                    }
                    bytes = pv->doc.scratch_span(row->byte_start, row->byte_len,
                                                 heap) !>;
                }
            }
            if (!span_ok) {
                if (heap.base) heap.destroy();
                cctext_browse_pad(cols, 0);
                fputs("\x1b[0m", stdout);
                if (!pad_rest) fputs("\x1b[K", stdout);
                continue;
            }
            for (c = 0; c < pv->layout.grid.ncols && col < (size_t)cols; c++) {
                RtxGridField cell;
                int cw = pv->layout.grid.col_w[c];
                int used_c = 0;
                if (cw <= 0) break;
                rtx_grid_bind_span(&pv->layout.grid, row->byte_start, bytes.len);
                if (!rtx_grid_cell_wrap(bytes.ptr, bytes.len, &pv->layout.grid, c,
                                        (int)row->wrap_i, &cell)) {
                    cell.lo = 0;
                    cell.hi = 0;
                }
                {
                    size_t k = cell.lo;
                    while (k < cell.hi && used_c < cw) {
                        RtxUtf8Cl cl = rtx_utf8_cluster(bytes, k);
                        size_t step = cl.n ? cl.n : 1;
                        size_t off = row->byte_start + k;
                        RtxStyle st = pv->doc.style_at(off);
                        char put[RTX_UTF8_LOOK];
                        int pn = rtx_utf8_term_put(cl.cp, bytes.ptr + k, step,
                                                   put, sizeof(put));
                        int pc = rtx_utf8_term_cols(cl.cp, cl.cols);
                        int here = pv->doc.caret == off;
                        int sel = rtx_browse_prev_sel(&pv->doc, off);
                        if (pc < 1) pc = 1;
                        if (used_c + pc > cw) break;
                        if (virt >= pv->cam.left_col && col < (size_t)cols) {
                            fputs("\x1b[0m", stdout);
                            if (is_hdr) fputs("\x1b[48;5;236m", stdout);
                            cctext_style(st, sel, here);
                            if (pn > 0) fwrite(put, 1, (size_t)pn, stdout);
                            col += (size_t)pc;
                        }
                        virt += (size_t)pc;
                        used_c += pc;
                        k += step;
                    }
                }
                fputs("\x1b[0m", stdout);
                if (is_hdr) fputs("\x1b[48;5;236m", stdout);
                while (used_c < cw) {
                    if (virt >= pv->cam.left_col && col < (size_t)cols) {
                        fputc(' ', stdout);
                        col++;
                    }
                    virt++;
                    used_c++;
                }
                if (c + 1 < pv->layout.grid.ncols) {
                    if (virt >= pv->cam.left_col && col < (size_t)cols) {
                        fputs("\x1b[90m \x1b[0m", stdout);
                        if (is_hdr) fputs("\x1b[48;5;236m", stdout);
                        col++;
                    }
                    virt++;
                }
            }
            used = (int)col;
            if (heap.base) heap.destroy();
        }
        fputs("\x1b[0m", stdout);
        cctext_browse_pad(cols - used, 0);
        fputs("\x1b[0m", stdout);
        if (!pad_rest) fputs("\x1b[K", stdout);
    }
}

static void cctext_draw_browse_prev(RtxWs *w, int pane, int row0, int col0,
                                    int cols, int vis, int pad_rest,
                                    int focused) {
    RtxBrowsePrev *pv;
    RtxMeasure m;
    const char *msg = NULL;
    RtxBrowseFace face = RTX_BROWSE_FACE_FILE;
    int rw = cols > 1 ? 1 : 0;
    int text_c = cols - rw;
    if (!w || cols < 1 || vis < 1) return;
    if (text_c < 1) text_c = 1;
    m.measure = cctext_prev_measure;
    m.line_height = cctext_prev_lh;
    m.ctx = NULL;
    w->browse_prev_sync(pane, &m, (double)text_c, vis) !>(e) { (void)e; };
    pv = &w->prev[pane];
    if (pv->kind == RTX_BROWSE_PREV_DIR) {
        msg = " directory";
        face = RTX_BROWSE_FACE_DIR;
    } else if (pv->kind == RTX_BROWSE_PREV_FAIL) {
        msg = " cannot open";
        face = RTX_BROWSE_FACE_DENY;
    } else if (pv->kind == RTX_BROWSE_PREV_EMPTY) {
        msg = "";
    } else if (pv->live) {
        int r;
        if (rtx_layout_is_hex(&pv->layout))
            cctext_draw_browse_prev_hex(pv, row0, col0, text_c, vis, pad_rest);
        else if (rtx_layout_is_grid(&pv->layout))
            cctext_draw_browse_prev_grid(pv, row0, col0, text_c, vis, pad_rest);
        else
            cctext_draw_browse_prev_text(pv, row0, col0, text_c, vis, pad_rest);
        if (rw) {
            for (r = 0; r < vis; r++)
                cctext_draw_browse_prev_rail(pv, focused, vis, r, row0 + r,
                                             col0 + cols - 1);
        }
        return;
    }
    {
        int r;
        for (r = 0; r < vis; r++) {
            cctext_browse_row(row0 + r, col0, cols, pad_rest, 0,
                              r == 0 ? msg : "", face);
        }
    }
}

static void cctext_draw_browse(RtxWs *w, int pane, const RtxUi *ui, int focused,
                               int vis, int pcols, int col0, int pad_rest) {
    RtxBrowse *br;
    char line[512];
    int r;
    size_t list, i;
    int list_w;
    int prev_w;
    if (!w) return;
    br = &w->nav[pane];
    if (!br) return;
    rtx_browse_scroll(br, vis);
    list_w = rtx_browse_list_cols(pcols);
    prev_w = pcols - list_w;
    snprintf(line, sizeof(line), " %s", br->dir);
    cctext_browse_row(1, col0, pcols, pad_rest, 0, line, RTX_BROWSE_FACE_PATH);
    {
        int used = 0;
        fprintf(stdout, "\x1b[%d;%dH", 2, col0);
        cctext_browse_face(0, RTX_BROWSE_FACE_GLOB);
        fputs(" glob: ", stdout);
        used = 7;
        used = cctext_put_field(rtx_browse_field(br), focused ? ui : NULL,
                                rtx_browse_face(RTX_BROWSE_FACE_GLOB).ansi, used, pcols);
        cctext_browse_pad(pcols - used, 0);
        fputs("\x1b[0m", stdout);
        if (!pad_rest) fputs("\x1b[K", stdout);
    }
    {
        int head = rtx_browse_head(br);
        int list_pad = prev_w > 0 ? 1 : pad_rest;
        list = (vis > head) ? (size_t)(vis - head) : 0;
        for (i = 0; i < list; i++) {
            size_t idx = br->top + i;
            r = head + 1 + (int)i;
            if (idx >= br->len) {
                cctext_browse_row(r, col0, list_w, list_pad, 0, "",
                                  RTX_BROWSE_FACE_FILE);
                continue;
            }
            cctext_browse_ent(r, col0, list_w, list_pad,
                              focused && idx == br->cur, br, &br->ents[idx]);
        }
        if (prev_w > 0) {
            int gap = prev_w > 1 ? 1 : 0;
            int pc = prev_w - gap;
            int pr0 = head + 1;
            int pvis = vis > head ? vis - head : 0;
            size_t j;
            for (j = 0; j < list && gap; j++) {
                fprintf(stdout, "\x1b[%d;%dH\x1b[90m│\x1b[0m",
                        head + 1 + (int)j, col0 + list_w);
            }
            if (pc > 0 && pvis > 0)
                cctext_draw_browse_prev(w, pane, pr0, col0 + list_w + gap, pc,
                                        pvis, pad_rest, focused);
        }
    }
}

/* 1 if the caret is on a cell in this pane. Hex sits on the first nibble. */
static int cctext_caret_cell(RtxBuf *b, int vis, int pcols, int col0, int *row, int *col) {
    size_t caret;
    int g, tcols;
    size_t r;
    if (!b || vis < 1 || !row || !col) return 0;
    caret = b->doc.caret;
    if (rtx_layout_is_hex(&b->layout)) {
        size_t top = rtx_hex_align(b->top_byte);
        size_t crow = caret / (size_t)RTX_HEX_COLS;
        size_t trow = top / (size_t)RTX_HEX_COLS;
        size_t k;
        if (crow < trow || crow >= trow + (size_t)vis) return 0;
        k = caret - crow * (size_t)RTX_HEX_COLS;
        *row = (int)(crow - trow) + 1;
        *col = col0 + RTX_HEX_OFF_W + (int)k * 3;
        return 1;
    }
    g = rtx_gutter_cols_buf(b, vis);
    tcols = cctext_text_cols(b, pcols, vis);
    if (rtx_layout_is_grid(&b->layout))
        return cctext_grid_caret_cell(b, vis, pcols, col0, row, col);
    {
        int body = cctext_body_vis(b, vis, pcols);
        int hdr = rtx_layout_is_grid(&b->layout) && b->layout.grid_hdr_on;
        int slots = body > hdr ? body - hdr : 0;
    for (r = 0; r < (size_t)slots; r++) {
        size_t idx = r + b->top_wrap;
        RtxVisRow *vr;
        size_t at;
        if (idx >= b->layout.rows.len) break;
        vr = &b->layout.rows.data[idx];
        if (caret < vr->byte_start) continue;
        if (caret > vr->byte_start + vr->byte_len) continue;
        at = caret - vr->byte_start;
        {
            CCArena scratch = {0};
            char[:] bytes = cc_slice_empty();
            if (vr->byte_len) {
                scratch = cc_arena_heap(vr->byte_len + 64);
                if (!scratch.base) return 0;
            }
            {
                @errhandler(CCError e) {
                    (void)e;
                    if (scratch.base) scratch.destroy();
                    return 0;
                }
                bytes = b->scratch_span(vr->byte_start, vr->byte_len, scratch) !>;
            }
            at = (size_t)rtx_utf8_prefix_cols(bytes, at);
            if (scratch.base) scratch.destroy();
        }
        if (at < b->left_col) return 0;
        at -= b->left_col;
        if (at > (size_t)tcols) return 0;
        *row = (int)r + 1 + hdr;
        *col = col0 + g + (int)at;
        return 1;
    }
    }
    return 0;
}

static void cctext_place_cursor(RtxWs *w, RtxUi *ui, int vis, int cols) {
    RtxBuf *act;
    int pane, pcols, col0, row, col;
    if (!w) return;
    act = w->active();
    if (!act || rtx_ui_prompting(ui) || (ui && (ui->help || ui->ask_quit)) ||
        (w && w->browsing())) {
        fputs("\x1b[?25l", stdout);
        return;
    }
    pane = w->focus;
    pcols = cctext_pane_cols(w, cols, pane);
    col0 = (pane == 0) ? 1 : (cols / 2 + 2);
    if (rtx_ui_blink(ui) && cctext_caret_cell(act, vis, pcols, col0, &row, &col)) {
        fprintf(stdout, "\x1b[%d;%dH\x1b[?25h", row, col);
    } else {
        fputs("\x1b[?25l", stdout);
    }
}

/* Last "  " is the key / action split. A line with no gap is all action. */
static void cctext_help_split(const char *line, size_t *key_n, const char **desc) {
    const char *last = NULL;
    const char *p;
    size_t kn;
    if (!key_n || !desc) return;
    *key_n = 0;
    *desc = line ? line : "";
    if (!line || !line[0]) return;
    for (p = line; p[0] && p[1]; p++) {
        if (p[0] == ' ' && p[1] == ' ') last = p;
    }
    if (!last) return;
    while (*last == ' ') last++;
    kn = (size_t)(last - line);
    while (kn && line[kn - 1] == ' ') kn--;
    *key_n = kn;
    *desc = last;
}

static void cctext_help_pad(int n) {
    int i;
    for (i = 0; i < n; i++) fputc(' ', stdout);
}

static void cctext_draw_help(int rows, int cols) {
    int i;
    int n = 0;
    int box_w = 50;
    int box_h;
    int r0, c0;
    int key_w = 13;
    while (rtx_help_line((size_t)n)) n++;
    box_h = n + 4;
    if (box_w > cols - 2) box_w = cols - 2;
    if (box_h > rows - 2) box_h = rows - 2;
    r0 = (rows - box_h) / 2;
    if (r0 < 1) r0 = 1;
    c0 = (cols - box_w) / 2;
    if (c0 < 1) c0 = 1;
    for (i = 0; i < box_h; i++) {
        fprintf(stdout, "\x1b[%d;%dH", r0 + i, c0);
        if (i == 0) {
            fputs("\x1b[44;33;1m key bindings", stdout);
            cctext_help_pad(box_w - 13);
        } else if (i == 1) {
            int d;
            fputs("\x1b[44;34m ", stdout);
            for (d = 1; d < box_w - 1; d++) fputc('-', stdout);
            fputc(' ', stdout);
        } else if (i - 2 >= 0 && i - 2 < n && i < box_h - 1) {
            size_t kn = 0;
            const char *desc = "";
            int used = 1;
            int dn, room;
            cctext_help_split(rtx_help_line((size_t)(i - 2)), &kn, &desc);
            fputs("\x1b[44m ", stdout);
            if (kn) {
                int kw = (int)kn < key_w ? (int)kn : key_w;
                fputs("\x1b[36;1m", stdout);
                fwrite(rtx_help_line((size_t)(i - 2)), 1, (size_t)kw, stdout);
                fputs("\x1b[44m", stdout);
                cctext_help_pad(key_w - kw);
                used += key_w;
                fputs("\x1b[37m ", stdout);
                used++;
            } else {
                fputs("\x1b[37m", stdout);
            }
            room = box_w - used - 1;
            dn = (int)strlen(desc);
            if (dn > room) dn = room;
            if (dn > 0) fwrite(desc, 1, (size_t)dn, stdout);
            used += dn;
            fputs("\x1b[44m", stdout);
            cctext_help_pad(box_w - used);
        } else {
            fputs("\x1b[44m", stdout);
            cctext_help_pad(box_w);
        }
        fputs("\x1b[0m", stdout);
    }
}

static int cctext_find_span(const char *ctx, size_t n, const char *q, size_t qn,
                            size_t *at, size_t *len, int *hit) {
    size_t i, j;
    if (!ctx || !at || !len || !hit || *at >= n) return 0;
    i = *at;
    if (q && qn && i + qn <= n) {
        char[:] ctx_slice = cc_slice_from_buffer((void *)(ctx + i), qn);
        char[:] q_slice = cc_slice_from_buffer((void *)q, qn);
        if (ctx_slice.eq(q_slice)) {
            *len = qn;
            *hit = 1;
            *at = i + qn;
            return 1;
        }
    }
    j = i + 1;
    while (j < n) {
        if (q && qn && j + qn <= n) {
            char[:] ctx_slice = cc_slice_from_buffer((void *)(ctx + j), qn);
            char[:] q_slice = cc_slice_from_buffer((void *)q, qn);
            if (ctx_slice.eq(q_slice)) break;
        }
        j++;
    }
    *len = j - i;
    *hit = 0;
    *at = j;
    return 1;
}

static void cctext_draw_find_head(RtxDoc *d, RtxUi *ui, int r0, int cols) {
    char head[256];
    int field_max;
    int used;
    int statw;
    rtx_ui_find_stats(d, head, sizeof(head));
    statw = (int)strlen(head) + 2;
    field_max = cols > 2 ? cols - 1 : 1;
    if (statw + 12 < field_max) field_max -= statw;
    fprintf(stdout, "\x1b[%d;1H\x1b[44;37m find: ", r0);
    used = cctext_put_field(rtx_ui_find_field(ui), ui, "\x1b[44;37m", 7,
                            field_max);
    while (used < field_max) {
        fputc(' ', stdout);
        used++;
    }
    fprintf(stdout, "  %s\x1b[0m\x1b[K", head);
}

static void cctext_draw_find(RtxDoc *d, RtxUi *ui, int rows, int cols, int find_h) {
    int r0 = rows - find_h;
    int vis_hits = find_h > 1 ? find_h - 1 : 0;
    int i;
    size_t ctxn = (size_t)(cols > 16 ? cols - 10 : 8);
    if (r0 < 1) r0 = 1;
    rtx_ui_find_scroll(ui, d, (size_t)vis_hits);
    cctext_draw_find_head(d, ui, r0, cols);
    for (i = 0; i < vis_hits; i++) {
        size_t hit = ui->find_top + (size_t)i;
        int row = r0 + 1 + i;
        int cur = d && d->find.pinned && hit == d->find.cur;
        fprintf(stdout, "\x1b[%d;1H%s", row, cur ? "\x1b[7m" : "\x1b[0m");
        if (!d || hit >= d->find.len) {
            fputs("\x1b[K\x1b[0m", stdout);
            continue;
        }
        {
            char ctx[256];
            size_t line1 = 0;
            int ok = 1;
            rtx_ui_find_row_text(d, hit, ctxn, ctx, sizeof(ctx), &line1) !>(e) {
                ok = 0;
            };
            if (!ok) {
                fprintf(stdout, "  %zu\x1b[K\x1b[0m", hit + 1);
            } else {
                const char *q = d->find.query.ptr;
                size_t qn = d->find.query.len;
                size_t at = 0, n = strlen(ctx), len;
                int is_hit;
                fprintf(stdout, " %5zu  ", line1);
                while (cctext_find_span(ctx, n, q, qn, &at, &len, &is_hit)) {
                    fputs(is_hit ? "\x1b[43;30m" : (cur ? "\x1b[7m" : "\x1b[0m"),
                          stdout);
                    fwrite(ctx + at - len, 1, len, stdout);
                }
                fputs("\x1b[K\x1b[0m", stdout);
            }
        }
    }
}

static void cctext_paint_chrome(RtxWs *w, RtxUi *ui, RtxBuf *act, int rows,
                                int cols, int find_h) {
    const char *path = (act && act->doc.path.ptr) ? act->doc.path.ptr : "(untitled)";
    const char *star = (act && act->doc.dirty()) ? "*" : " ";
    @errhandler(RtxIndexErr e) {
        (void)e;
        return;
    }
    if (ui && ui->find && act && find_h > 0)
        cctext_draw_find(&act->doc, ui, rows, cols, find_h);
    if (ui && ui->help) cctext_draw_help(rows, cols);
    if (ui && ui->stats) cctext_draw_stats(act, rows, cols);
    if (ui && ui->ask_quit) {
        fprintf(stdout,
                "\x1b[%d;1H\x1b[41;97m unsaved  s save  q don't save  Esc cancel  %s\x1b[0m\x1b[K",
                rows, g_status);
    } else if (ui && ui->jump) {
        char jump[80];
        rtx_ui_jump_header(ui, act ? &act->doc : NULL, jump, sizeof(jump));
        fprintf(stdout, "\x1b[%d;1H\x1b[7m %s\x1b[0m\x1b[K", rows, jump);
    } else if (w && w->browsing()) {
        RtxBrowse *br = RtxWs_browse(w);
        const char *scan = rtx_browse_scan_msg(br);
        fprintf(stdout, "\x1b[%d;1H\x1b[7m browse  %zu/%zu",
                rows, br && br->len ? br->cur + 1 : 0, br ? br->len : 0);
        if (br && br->denied)
            fputs("  \x1b[0m\x1b[41;97m denied \x1b[0m\x1b[7m", stdout);
        else if (scan && scan[0])
            fputs(scan, stdout);
        fprintf(stdout, "  enter open  ^O this  ^E other  Esc %s  %s\x1b[0m\x1b[K",
                br && br->boot ? "quit" : "close", g_status);
    } else if (ui && ui->find) {
        fprintf(stdout,
                "\x1b[%d;1H\x1b[7m find  up/down hits  Esc close  %s\x1b[0m\x1b[K",
                rows, g_status);
    } else if (act && rtx_layout_is_hex(&act->layout)) {
        fprintf(stdout,
                "\x1b[%d;1H\x1b[7m%s%s  @%zX  hex %s%s  Esc help  g jump  %s\x1b[0m\x1b[K",
                rows, star, path, act->doc.caret,
                act->hex_nib ? "lo" : "hi",
                act->unlock ? "  unlock" : "", g_status);
    } else if (act && rtx_layout_is_grid(&act->layout)) {
        char pos[48];
        rtx_status_line_pos(act, pos, sizeof(pos)) !>;
        fprintf(stdout,
                "\x1b[%d;1H\x1b[7m%s%s  %s  grid %s%s  Esc help  g jump  %s\x1b[0m\x1b[K",
                rows, star, path, pos,
                rtx_grid_delim_name(act->layout.grid_delim
                                        ? act->layout.grid_delim
                                        : act->layout.grid.delim),
                (act->unlock) ? "  unlock" : "", g_status);
    } else {
        char pos[48];
        rtx_status_line_pos(act, pos, sizeof(pos)) !>;
        fprintf(stdout,
                "\x1b[%d;1H\x1b[7m%s%s  %s%s  Esc help  g jump  f find  %s\x1b[0m\x1b[K",
                rows, star, path, pos,
                (act && act->unlock) ? "  unlock" : "", g_status);
    }
}

void cctext_draw_chrome(RtxWs *w, RtxUi *ui, int rows, int cols) {
    int find_h = rtx_ui_find_rows(ui, rows);
    int vis = rows - 1 - find_h;
    if (vis < 1) vis = 1;
    if (w && ui && ui->find) {
        RtxBuf *act = w->active();
        if (act) rtx_find_pause(&act->doc);
        cctext_paint_chrome(w, ui, w->active(), rows, cols, find_h);
        if (act) rtx_find_resume(&act->doc);
    } else {
        cctext_paint_chrome(w, ui, w ? w->active() : NULL, rows, cols, find_h);
    }
    cctext_place_cursor(w, ui, vis, cols);
    fflush(stdout);
}

void cctext_draw(RtxWs *w, RtxUi *ui, int rows, int cols) {
    int find_h = rtx_ui_find_rows(ui, rows);
    int vis = rows - 1 - find_h;
    int p;
    RtxBuf *act = w->active();
    @errhandler(RtxIndexErr e) {
        (void)e;
        return; /* fault already set by line_* on err */
    }
    if (vis < 1) vis = 1;
    /* Synchronized update: do not ED (erase display) — that is the flicker. */
    fputs("\x1b[?2026h", stdout);
    for (p = 0; p < w->npanes; p++) {
        int bi = w->pane[p];
        RtxBuf *b = &w->bufs[bi];
        int pcols = cctext_pane_cols(w, cols, p);
        int col0 = (p == 0) ? 1 : (cols / 2 + 2);
        int pad_left = (w->npanes == 2 && p == 0);
        {
            RtxBrowse *br = &w->nav[p];
            int held = w->hold_pane(p);
            if (br && br->on)
                cctext_draw_browse(w, p, ui, p == w->focus, vis, pcols, col0, pad_left);
            else
                cctext_draw_pane(b, ui, p == w->focus, vis, pcols, col0, pad_left,
                                 g_status, sizeof(g_status), g_mouse_row);
            w->drop_pane(p, held);
        }
        if (w->npanes == 2 && p == 0) {
            size_t r;
            int gap = cols / 2;
            for (r = 0; r < (size_t)vis; r++) {
                fprintf(stdout, "\x1b[%zu;%dH\x1b[0m \x1b[90m│\x1b[0m", r + 1, gap);
            }
        }
    }
    cctext_paint_chrome(w, ui, act, rows, cols, find_h);
    fputs("\x1b[?2026l", stdout);
    cctext_place_cursor(w, ui, vis, cols);
    fflush(stdout);
}
