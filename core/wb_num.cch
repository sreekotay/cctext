#!ccc cch
/*
 * Exact workbook arithmetic (docs/workbook.md "W2 as built"): the sums a
 * maintained aggregate keeps, so subtract-old / add-new is exact and a
 * value never depends on the order its rows arrived in. Owner: wb.ccs
 * (linked into the rtx_document target with it).
 *
 * RtxXs — a float superaccumulator: a fixed-point integer in units of
 * 2^-1074 (the smallest subnormal) spanning the whole double range, as
 * signed 64-bit digits of 32 bits each (Neal's "small accumulator"
 * layout: carries are deferred, every 2^30 adds renormalise). Adding or
 * subtracting a finite double is exact; the sum is rounded once, to
 * nearest, ties to even; past DBL_MAX it is +-inf.
 *
 * RtxXd — an exact int / dec sum: a 256-bit integer in units of 10^-18,
 * so every `dec(p)` (p <= 18) and `int` adds exactly.
 *
 * Neither type rounds while it accumulates, so a from-scratch sum and
 * one maintained through any sequence of +value / -value are equal as
 * integers, and their rounded results are bit-identical.
 */
#ifndef RTX_WB_NUM_H
#define RTX_WB_NUM_H

#include <stddef.h>
#include <stdint.h>

#define RTX_XS_LIMBS 70 /* 2^-1074 .. 2^1166: any double, 2^30 adds of headroom per bit */
#define RTX_XD_LIMBS 8  /* 256 bits of 10^-18 */

typedef struct {
    int64_t c[RTX_XS_LIMBS];
    uint32_t adds;
} RtxXs;

typedef struct {
    int64_t c[RTX_XD_LIMBS];
    uint32_t adds;
} RtxXd;

void rtx_xs_zero(RtxXs *x);
/* x += sign * v for a finite v (callers count NaN / inf apart). */
void rtx_xs_add(RtxXs *x, double v, int sign);
/* x += sign * y (exact; the W1 leaf-merge operation). */
void rtx_xs_merge(RtxXs *x, const RtxXs *y, int sign);
/* -1 / 0 / 1: the sign of the exact sum. */
int rtx_xs_sign(const RtxXs *x);
/* The exact sum rounded once (nearest, ties to even); +-inf past the
 * double range; an exact zero is +0.0. */
double rtx_xs_round(const RtxXs *x);
/* x (units 2^-1074) + d (units 10^-18), the exact real sum rounded once. */
double rtx_xs_round_mixed(const RtxXs *x, const RtxXd *d);
/* Bits are equal (both normalised): the same exact value. */
int rtx_xs_eq(const RtxXs *a, const RtxXs *b);

void rtx_xd_zero(RtxXd *d);
/* d += sign * v / 10^sc, sc in 0..18. */
void rtx_xd_add(RtxXd *d, int64_t v, int sc, int sign);
/* d += v / 10^sc for a 128-bit v (|v| < 2^127). */
void rtx_xd_add128(RtxXd *d, __int128 v, int sc);
void rtx_xd_merge(RtxXd *d, const RtxXd *y, int sign);
/* The sum at scale sc (it must be a multiple of 10^-sc): 1 and *out when
 * it fits an int64, 0 when it does not. */
int rtx_xd_get(const RtxXd *d, int sc, int64_t *out);

/* Exact comparison of v / 10^sc with a finite double f: -1 / 0 / 1. */
int rtx_num_cmp_dec_f(int64_t v, int sc, double f);

#endif /* RTX_WB_NUM_H */
