#!ccc ccs
/*
 * Layout (linked TU; see layout.cch). Hosts include the face for types
 * / UFCS; this file owns the wrap / hit-test bodies.
 */
#include <ccc/std/prelude.cch>
#include <string.h>
#include "utf8.cch"
#include "document.cch"
#include "layout.cch"

void rtx_layout_set_view(RtxLayout *L, int view) {
    if (!L) return;
    /* Old journals stored wrap as a view; fold into the wrap bit. */
    if (view == RTX_VIEW_WRAP) {
        L->view = RTX_VIEW_DEFAULT;
        L->wrap = 1;
        return;
    }
    if (view < RTX_VIEW_DEFAULT || view > RTX_VIEW_GRID) view = RTX_VIEW_DEFAULT;
    L->view = view;
}

void rtx_layout_cycle_view(RtxLayout *L) {
    if (!L) return;
    if (L->view == RTX_VIEW_HEX) rtx_layout_set_view(L, RTX_VIEW_GRID);
    else if (L->view == RTX_VIEW_GRID) rtx_layout_set_view(L, RTX_VIEW_DEFAULT);
    else rtx_layout_set_view(L, RTX_VIEW_HEX);
}

void rtx_layout_set_wrap(RtxLayout *L, int on) {
    if (!L) return;
    L->wrap = on ? 1 : 0;
}

int rtx_layout_is_hex(const RtxLayout *L) {
    return L && L->view == RTX_VIEW_HEX;
}

int rtx_layout_is_grid(const RtxLayout *L) {
    return L && L->view == RTX_VIEW_GRID;
}

int rtx_layout_soft_wrap(const RtxLayout *L) {
    if (!L || L->view == RTX_VIEW_HEX) return 0;
    return L->wrap || L->view == RTX_VIEW_GRID;
}

int rtx_layout_uses_left(const RtxLayout *L) {
    if (!L || L->view == RTX_VIEW_HEX) return 0;
    if (L->view == RTX_VIEW_GRID) return 1;
    return !L->wrap;
}

const char *rtx_layout_view_name(const RtxLayout *L) {
    if (!L) return "default";
    if (L->view == RTX_VIEW_HEX) return "hex";
    if (L->view == RTX_VIEW_GRID) return "grid";
    return "default";
}

int RtxLayout_ensure(RtxLayout *L) {
    if (!L) return 0;
    if (L->store.base) return 1;
    L->store = cc_arena_malloc(kilobytes(8));
    return L->store.base != NULL;
}

void RtxLayout_reset(RtxLayout *L) {
    if (!L) return;
    L->rows.destroy();
    if (L->store.base) L->store.reset();
    L->total_height = 0;
    rtx_grid_geom_destroy(&L->grid);
    L->grid_hdr_end = 0;
    L->grid_hdr_on = 0;
    if (!L->md_keep) {
        L->md_ntab = 0;
        L->md_px = 0;
    }
}

void RtxLayout_destroy(RtxLayout *L) {
    if (!L) return;
    L->rows.destroy();
    rtx_grid_geom_destroy(&L->grid);
    if (L->store.base) L->store.destroy();
    *L = (RtxLayout){0};
}

static int rtx_layout_push(RtxLayout *L, RtxVisRow row) {
    if (!L) return 0;
    if (!L->rows.data) {
        Vec::[RtxVisRow] planted = vec_new::[RtxVisRow](L->store);
        if (!planted.data) return 0;
        L->rows = planted;
    }
    if (L->rows.push(row) != 0) return 0;
    L->total_height += row.height;
    return 1;
}

static int rtx_layout_is_break(char c) {
    return c == ' ' || c == '\t';
}

static int rtx_layout_push_row(RtxLayout *L, const RtxMeasure *m,
                               size_t byte_start, size_t byte_len, size_t phys,
                               double w, double h, double pad,
                               RtxSectionKind sec) {
    RtxVisRow row = {0};
    RtxStyle z = {0};
    row.byte_start = byte_start;
    row.byte_len = byte_len;
    row.line = phys;
    row.wrap_i = 0;
    row.width = w;
    row.height = h > 0 ? h : m->line_height(m->ctx, z, sec);
    row.pad = pad;
    row.sec = sec;
    if (!rtx_layout_push(L, row)) {
        L->reset();
        return 0;
    }
    return 1;
}

static int rtx_layout_push_grid_row(RtxLayout *L, const RtxMeasure *m,
                                    size_t byte_start, size_t byte_len,
                                    size_t phys, size_t wrap_i, double h,
                                    RtxSectionKind sec) {
    RtxVisRow row = {0};
    RtxStyle z = {0};
    row.byte_start = byte_start;
    row.byte_len = byte_len;
    row.line = phys;
    row.wrap_i = wrap_i;
    row.width = (double)rtx_grid_geom_width(&L->grid);
    row.height = h > 0 ? h : m->line_height(m->ctx, z, sec);
    row.pad = 0;
    row.sec = sec;
    if (!rtx_layout_push(L, row)) {
        L->reset();
        return 0;
    }
    return 1;
}

static int rtx_layout_grid_held(RtxDocLayout d, size_t off) {
    return d && rtx_scope_kind(d->style_at(off).scope) == RTX_HL_STRING;
}

int rtx_layout_grid_gap_at(RtxDocLayout d, size_t off, char delim) {
    char c = 0;
    size_t got = 0;
    if (!d || rtx_layout_grid_held(d, off)) return 0;
    {
        @errhandler(CCError e) {
            (void)e;
            return 0;
        }
        got = d->read_at(off, &c, 1) !>;
    }
    if (got != 1) return 0;
    if (c == '\n' || c == '\r') return 1;
    return delim && c == delim;
}

size_t !>(CCError) rtx_layout_grid_rec_len(RtxDocLayout d, size_t from) {
    char buf[RTX_FRAME_SCRATCH];
    size_t rec_n = 0, dlen, cap;
    @errhandler(CCError e) {
        return cc_err(e);
    }
    if (!d) return cc_ok(0);
    dlen = d->len();
    if (from >= dlen) return cc_ok(0);
    cap = dlen - from;
    if (cap > (size_t)RTX_GRID_REC_CAP) cap = (size_t)RTX_GRID_REC_CAP;
    {
        size_t win = from > (size_t)RTX_MARKUP_LOOKBACK
                         ? from - (size_t)RTX_MARKUP_LOOKBACK
                         : 0;
        d->ensure_hl(rtx_hl_keep(win, cap + (from - win))) !>;
    }
    while (rec_n < cap) {
        size_t take = cap - rec_n;
        size_t got, i;
        if (take > sizeof(buf)) take = sizeof(buf);
        got = d->read_at(from + rec_n, buf, take) !>;
        if (!got) break;
        for (i = 0; i < got; i++) {
            if (buf[i] == '\n' && !rtx_layout_grid_held(d, from + rec_n + i))
                return cc_ok(rec_n + i);
        }
        rec_n += got;
        if (got < take) break;
    }
    return cc_ok(rec_n);
}

int rtx_layout_grid_rec_in(const RtxLayout *L, size_t off, size_t *start,
                                 size_t *rec_n) {
    size_t i;
    if (!L || !start || !rec_n) return 0;
    /* Sticky header is not a vis row. The record NL is a gap, not the
     * last field — `<= end` made EOL x_of / vert land in the last column. */
    if (L->grid_hdr_on && L->grid_hdr_end && off < L->grid_hdr_end) {
        *start = 0;
        *rec_n = L->grid_hdr_end;
        return 1;
    }
    if (!L->rows.len) return 0;
    for (i = 0; i < L->rows.len; i++) {
        size_t a = L->rows.data[i].byte_start;
        size_t b = a + L->rows.data[i].byte_len;
        if (off >= a && (off < b || a == b)) {
            *start = a;
            *rec_n = L->rows.data[i].byte_len;
            return 1;
        }
    }
    return 0;
}

size_t rtx_layout_grid_rel(size_t off, size_t start, size_t rec_n) {
    size_t rel;
    if (off < start) return 0;
    rel = off - start;
    if (rel > rec_n) rel = rec_n;
    return rel;
}

size_t rtx_layout_grid_after_rec(RtxDocLayout d, size_t start, size_t rec_n) {
    size_t next, dlen, got;
    char c = 0;
    if (!d) return start + rec_n;
    dlen = d->len();
    next = start + rec_n;
    if (next >= dlen) return dlen;
    {
        @errhandler(CCError e) {
            (void)e;
            return next < dlen ? next + 1 : dlen;
        }
        got = d->read_at(next, &c, 1) !>;
        if (got == 1 && c == '\r') {
            next++;
            if (next >= dlen) return dlen;
            got = d->read_at(next, &c, 1) !>;
        }
        if (got == 1 && c == '\n') next++;
    }
    return next;
}

size_t !>(CCError) rtx_layout_grid_cam_lo(RtxDocLayout d, size_t off,
                                                size_t *nls_back) {
    size_t lo = off;
    size_t steps = 0;
    size_t win;
    @errhandler(CCError e) {
        return cc_err(e);
    }
    if (nls_back) *nls_back = 0;
    if (!d) return cc_ok(off);
    win = off > (size_t)RTX_MARKUP_LOOKBACK ? off - (size_t)RTX_MARKUP_LOOKBACK : 0;
    d->ensure_hl(rtx_hl_keep(win, (off - win) + 1)) !>;
    while (lo > 0 && steps < (size_t)RTX_MARKUP_LOOKBACK) {
        char c = 0;
        size_t got = d->read_at(lo - 1, &c, 1) !>;
        if (!got) break;
        if (c == '\n' && !rtx_layout_grid_held(d, lo - 1)) break;
        if (c == '\n' && nls_back) (*nls_back)++;
        lo--;
        steps++;
        if (lo < win) {
            win = lo > (size_t)RTX_MARKUP_LOOKBACK ? lo - (size_t)RTX_MARKUP_LOOKBACK
                                                   : 0;
            d->ensure_hl(rtx_hl_keep(win, (off - win) + 1)) !>;
        }
    }
    return cc_ok(lo);
}

static size_t rtx_layout_grid_rec_n(RtxDocLayout d, size_t from, const char *s,
                                   size_t n) {
    size_t i;
    for (i = 0; i < n; i++) {
        if (s[i] == '\n' && !rtx_layout_grid_held(d, from + i)) return i;
    }
    return n;
}

size_t !>(CCError) rtx_layout_grid_next_line(RtxDocLayout d, size_t from_line) {
    size_t from, rec_n, nls = 0, dlen, next_off, i;
    char buf[RTX_FRAME_SCRATCH];
    @errhandler(CCError e) {
        return cc_err(e);
    }
    @errhandler(RtxIndexErr ie) {
        return cc_err(CC_ERR_IO, ie.message ? ie.message : "line index");
    }
    if (!d) return cc_ok(from_line);
    from = d->line_start(from_line) !>;
    dlen = d->len();
    rec_n = rtx_layout_grid_rec_len(d, from) !>;
    i = 0;
    while (i < rec_n) {
        size_t take = rec_n - i;
        size_t got, k;
        if (take > sizeof(buf)) take = sizeof(buf);
        got = d->read_at(from + i, buf, take) !>;
        if (!got) break;
        for (k = 0; k < got; k++)
            if (buf[k] == '\n') nls++;
        i += got;
        if (got < take) break;
    }
    next_off = from + rec_n;
    if (next_off < dlen) {
        char c = 0;
        size_t got = d->read_at(next_off, &c, 1) !>;
        if (got && c == '\n') next_off++;
    }
    if (next_off >= dlen) return cc_ok(from_line);
    return cc_ok(from_line + 1 + nls);
}

size_t !>(CCError) rtx_layout_grid_prev_line(RtxDocLayout d, size_t from_line) {
    size_t from, nls_back = 0;
    @errhandler(CCError e) {
        return cc_err(e);
    }
    @errhandler(RtxIndexErr ie) {
        return cc_err(CC_ERR_IO, ie.message ? ie.message : "line index");
    }
    if (!d || from_line == 0) return cc_ok(0);
    from = d->line_start(from_line) !>;
    if (from == 0) return cc_ok(0);
    from = rtx_layout_grid_cam_lo(d, from - 1, &nls_back) !>;
    (void)from;
    if (from_line < 1 + nls_back) return cc_ok(0);
    return cc_ok(from_line - 1 - nls_back);
}

static void !>(CCError) rtx_layout_grid_walk(RtxLayout *L, RtxDocLayout d,
                                            const RtxMeasure *m, size_t from,
                                            size_t n, double max_width,
                                            char[:] bytes) {
    size_t i = 0;
    size_t phys = L->from_line;
    char delim;
    int pane;
    size_t hlen, hi;
    RtxStyle z = {0};
    @errhandler(CCError e) {
        return cc_err(e);
    }
    if (!L || !d || !m) return cc_err(CC_ERR_INVALID_ARG, "grid walk");
    delim = L->grid_delim;
    if (!delim) delim = rtx_grid_probe(bytes.ptr, n);
    if (!delim) delim = ',';
    L->grid_delim = delim;
    rtx_grid_geom_init(&L->grid, delim);
    pane = (int)max_width;
    if (pane < RTX_GRID_MIN_COL) pane = RTX_GRID_MIN_COL;
    hlen = rtx_layout_grid_rec_len(d, 0) !>;
    {
        unsigned char *hold =
            (unsigned char *)cc_arena_alloc(L->store, n ? n : 1, 1);
        L->grid.hold_from = from;
        L->grid.hold_n = n;
        if (hold)
            for (hi = 0; hi < n; hi++)
                hold[hi] = rtx_layout_grid_held(d, from + hi) ? 1 : 0;
        L->grid.hold = hold;
    }
    L->grid_hdr_end = hlen;
    L->grid_hdr_on = d->len() > 0;
    if (L->grid_hdr_on && hlen) {
        CCArena frame = cc_arena_heap(hlen + 64);
        char[:] hbytes;
        if (!frame.base) return cc_err(CC_ERR_OUT_OF_MEMORY, "grid header");
        hbytes = d->scratch_span(0, hlen, frame) !>(e) {
            frame.destroy();
            return cc_err(e);
        };
        if (hbytes.len && hbytes.ptr[hbytes.len - 1] == '\r')
            hbytes = hbytes.sub(0, hbytes.len - 1);
        L->grid_hdr_end = hbytes.len;
        rtx_grid_bind_span(&L->grid, 0, hbytes.len);
        rtx_grid_geom_add(&L->grid, hbytes.ptr, hbytes.len);
        frame.destroy();
    }
    while (i < n) {
        size_t rec_n = rtx_layout_grid_rec_n(d, from + i, bytes.ptr + i, n - i);
        rtx_grid_bind_span(&L->grid, from + i, rec_n);
        if (!d->fold_covers(from + i) && from + i != 0)
            rtx_grid_geom_add(&L->grid, bytes.ptr + i, rec_n);
        i += rec_n;
        if (i < n && bytes.ptr[i] == '\n') i++;
    }
    rtx_grid_geom_fit(&L->grid, pane);
    i = 0;
    phys = L->from_line;
    while (i < n) {
        size_t rec_n = rtx_layout_grid_rec_n(d, from + i, bytes.ptr + i, n - i);
        size_t nls = 0;
        RtxSectionKind sec = d->section_at(from + i);
        double h;
        int rec_h, wr;
        @for (ch in bytes.sub(i, i + rec_n))
            if (ch == '\n') nls++;
        rtx_grid_bind_span(&L->grid, from + i, rec_n);
        if (d->fold_covers(from + i) || from + i == 0) {
            i += rec_n + ((i + rec_n < n && bytes.ptr[i + rec_n] == '\n') ? 1 : 0);
            phys += 1 + nls;
            continue;
        }
        h = m->line_height(m->ctx, z, sec);
        rec_h = rtx_grid_record_height(bytes.ptr + i, rec_n, &L->grid);
        for (wr = 0; wr < rec_h; wr++) {
            if (!rtx_layout_push_grid_row(L, m, from + i, rec_n, phys,
                                          (size_t)wr, h, sec)) {
                return cc_err(CC_ERR_OUT_OF_MEMORY, "grid row");
            }
        }
        i += rec_n;
        if (i < n && bytes.ptr[i] == '\n') {
            i++;
            phys += 1 + nls;
        } else {
            phys += nls;
        }
    }
    return cc_ok();
}

/* 1: unordered (`•  `). 2: copy the hint (ordered / task box). */
static int rtx_hint_list_kind(const char *s, size_t n) {
    size_t i;
    if (!s || n < 2) return 0;
    if (n == 3 && s[0] == '[' && s[2] == ']' &&
        (s[1] == ' ' || s[1] == 'x' || s[1] == 'X'))
        return 2;
    if (s[0] == '-' || s[0] == '*' || s[0] == '+') {
        i = 1;
        if (i < n && (s[i] == ' ' || s[i] == '\t')) {
            while (i < n && (s[i] == ' ' || s[i] == '\t')) i++;
            if (i == n) return 1;
        }
        return 0;
    }
    i = 0;
    while (i < n && s[i] >= '0' && s[i] <= '9') i++;
    if (!i || i >= n || (s[i] != '.' && s[i] != ')')) return 0;
    i++;
    if (i >= n || (s[i] != ' ' && s[i] != '\t')) return 0;
    while (i < n && (s[i] == ' ' || s[i] == '\t')) i++;
    return i == n ? 2 : 0;
}

static size_t rtx_hint_standin(const char *hint, size_t n, char *dst, size_t dst_n) {
    int kind;
    if (!dst || dst_n < 6) return 0;
    kind = rtx_hint_list_kind(hint, n);
    if (kind == 1) {
        dst[0] = (char)0xe2;
        dst[1] = (char)0x80;
        dst[2] = (char)0xa2;
        dst[3] = ' ';
        dst[4] = ' ';
        return 5;
    }
    if (kind == 2 && n < dst_n) {
        char[:] to = cc_slice_from_buffer(dst, n);
        char[:] from = cc_slice_from_buffer((void *)hint, n);
        to.copy(from) !>(e) {
            (void)e;
            return 0;
        };
        return n;
    }
    return 0;
}

int rtx_hint_standin_cols(const char *g, size_t n) {
    size_t k = 0;
    int cols = 0;
    char[:] s;
    if (!g || !n) return 0;
    s = cc_slice_from_buffer((char *)g, n);
    while (k < n) {
        RtxUtf8Cl cl = rtx_utf8_cluster(s, k);
        size_t step = cl.n ? cl.n : 1;
        cols += cl.cols > 0 ? cl.cols : 1;
        k += step;
    }
    return cols;
}

int rtx_layout_hint_vis(const RtxLayout *L, RtxDocLayout d, size_t off,
                        const char *row, size_t rel, size_t row_n,
                        RtxHintVis *out) {
    size_t to, n;
    if (!out) return 0;
    memset(out, 0, sizeof(*out));
    to = rtx_layout_hidden_to(L, d, off);
    if (!to) return 0;
    n = row_n > rel ? row_n - rel : 0;
    if (to > off) {
        size_t hn = to - off;
        if (!n || hn < n) n = hn;
    }
    if (!n) n = 1;
    out->skip = n;
    if (row && rel < row_n)
        out->gn = rtx_hint_standin(row + rel, n, out->g, sizeof(out->g));
    return 1;
}

static double rtx_layout_standin_w(const RtxMeasure *m, const RtxHintVis *hv,
                                   RtxStyle st, RtxSectionKind sec) {
    if (!hv || !hv->gn || !m || !m->measure) return 0;
    return m->measure(m->ctx, cc_slice_from_buffer((char *)hv->g, hv->gn), st, sec);
}

static double rtx_layout_list_indent_w(const RtxMeasure *m, RtxSectionKind sec) {
    RtxStyle z = {0};
    char sp[2];
    if (!m || !m->measure) return 0;
    sp[0] = ' ';
    sp[1] = ' ';
    return m->measure(m->ctx, cc_slice_from_buffer(sp, 2), z, sec);
}

/* Marker at `s` (`- ` / `1. ` / `2) `), or 0. */
static size_t rtx_list_mark_len(const char *s, size_t n) {
    size_t i;
    if (!s || n < 2) return 0;
    if (s[0] == '-' || s[0] == '*' || s[0] == '+') {
        if (s[1] != ' ' && s[1] != '\t') return 0;
        i = 2;
        while (i < n && (s[i] == ' ' || s[i] == '\t')) i++;
        return i;
    }
    i = 0;
    while (i < n && s[i] >= '0' && s[i] <= '9') i++;
    if (!i || i >= n || (s[i] != '.' && s[i] != ')')) return 0;
    i++;
    if (i >= n || (s[i] != ' ' && s[i] != '\t')) return 0;
    i++;
    while (i < n && (s[i] == ' ' || s[i] == '\t')) i++;
    return i;
}

/* List line: leading visible ws and the painted mark width (`•  ` / `1. `). */
static int rtx_layout_list_hang(const RtxLayout *L, RtxDocLayout d,
                                const RtxMeasure *m, size_t from,
                                char[:] bytes, size_t lo, size_t hi,
                                RtxSectionKind sec, double *lead_w,
                                double *mark_w) {
    size_t i = lo;
    double lead = 0;
    if (!L || !L->has_marks || !m || !m->measure || !bytes.ptr || lo >= hi)
        return 0;
    while (i < hi) {
        RtxHintVis hv;
        size_t off = from + i;
        if (rtx_layout_hint_vis(L, d, off, bytes.ptr, i, hi, &hv)) {
            if (hv.gn) {
                if (lead_w) *lead_w = lead;
                if (mark_w) *mark_w = rtx_layout_standin_w(m, &hv,
                    d->style_at(off), sec);
                return 1;
            }
            i += hv.skip;
            continue;
        }
        {
            RtxUtf8Cl cl = rtx_utf8_cluster(bytes, i);
            size_t step = cl.n ? cl.n : 1;
            if (step == 1 && (bytes.ptr[i] == ' ' || bytes.ptr[i] == '\t')) {
                lead += m->measure(m->ctx, bytes.sub(i, i + step),
                                   d->style_at(off), sec);
                i += step;
                continue;
            }
        }
        {
            size_t mn = rtx_list_mark_len(bytes.ptr + i, hi - i);
            if (!mn) return 0;
            if (lead_w) *lead_w = lead;
            if (mark_w)
                *mark_w = m->measure(m->ctx, bytes.sub(i, i + mn),
                                     d->style_at(from + i), sec);
            return 1;
        }
    }
    return 0;
}

/* Leading `|` plus following spaces. Continuation hangs under the cell. */
static int rtx_layout_table_hang(const RtxLayout *L, RtxDocLayout d,
                                 const RtxMeasure *m, size_t from,
                                 char[:] bytes, size_t lo, size_t hi,
                                 RtxSectionKind sec, double *lead_w,
                                 double *mark_w) {
    size_t i = lo;
    size_t j, pipes, mn;
    double lead = 0;
    if (!L || !d || !m || !m->measure || !bytes.ptr || lo >= hi) return 0;
    while (i < hi) {
        size_t off = from + i;
        if (L->has_marks) {
            RtxHintVis hv;
            if (rtx_layout_hint_vis(L, d, off, bytes.ptr, i, hi, &hv)) {
                if (hv.gn) return 0;
                i += hv.skip;
                continue;
            }
        }
        {
            RtxUtf8Cl cl = rtx_utf8_cluster(bytes, i);
            size_t step = cl.n ? cl.n : 1;
            if (step == 1 && (bytes.ptr[i] == ' ' || bytes.ptr[i] == '\t')) {
                lead += m->measure(m->ctx, bytes.sub(i, i + step),
                                   d->style_at(off), sec);
                i += step;
                continue;
            }
        }
        break;
    }
    if (i >= hi || bytes.ptr[i] != '|') return 0;
    pipes = 0;
    for (j = i; j < hi; j++) {
        if (bytes.ptr[j] == '|') pipes++;
    }
    if (pipes < 2) return 0;
    mn = 1;
    while (i + mn < hi && (bytes.ptr[i + mn] == ' ' || bytes.ptr[i + mn] == '\t'))
        mn++;
    if (lead_w) *lead_w = lead;
    if (mark_w)
        *mark_w = m->measure(m->ctx, bytes.sub(i, i + mn),
                             d->style_at(from + i), sec);
    return 1;
}

size_t rtx_layout_hidden_to(const RtxLayout *L, RtxDocLayout d, size_t off) {
    size_t lo, hi, plo, phi, klo, khi;
    if (!L || !L->has_marks) return 0;
    if (d->dest_at(off, &lo, &hi)) {
        if (!(off >= L->reveal_lo && off < L->reveal_hi)) return hi;
    }
    if (!d->hint_at(off, &lo, &hi)) return 0;
    /* Path label opener stays hidden while dest is not revealed. Dest
     * entry reveals the whole path so dest content can be typed. */
    if (d->path_at(off, &plo, &phi, &klo, &khi) &&
        !d->dest_at(off, NULL, NULL) && off < klo &&
        !(L->reveal_lo <= plo && L->reveal_hi >= phi)) {
        return hi;
    }
    if (off >= L->reveal_lo && off < L->reveal_hi) return 0;
    return hi;
}

int rtx_layout_reveal(RtxLayout *L, RtxDocLayout d, size_t caret, size_t anchor) {
    size_t lo = 0, hi = 0, mlo, mhi, plo, phi;
    if (!L) return 0;
    if (L->rich && d->has_marks()) {
        if (d->mark_at(caret, &mlo, &mhi)) {
            lo = mlo;
            hi = mhi;
            if (d->dest_at(caret, &plo, &phi) &&
                d->path_at(caret, &plo, &phi, NULL, NULL)) {
                if (plo < lo) lo = plo;
                if (phi > hi) hi = phi;
            }
        }
        if (anchor != caret && d->mark_at(anchor, &mlo, &mhi)) {
            if (hi == lo || mlo < lo) lo = mlo;
            if (mhi > hi) hi = mhi;
        }
    }
    if (lo == L->reveal_lo && hi == L->reveal_hi) return 0;
    L->reveal_lo = lo;
    L->reveal_hi = hi;
    return 1;
}

int rtx_layout_link_chip(const RtxLayout *L, RtxDocLayout d, size_t off) {
    size_t plo, phi, klo, khi, lo, hi;
    if (!L || !L->rich || !L->has_marks || !d) return 0;
    if (d->dest_at(off, NULL, NULL)) return 0;
    if (d->path_at(off, &plo, &phi, &klo, &khi)) {
        if (off < klo || off >= khi) return 0;
        if (L->reveal_lo <= plo && L->reveal_hi >= phi) return 0;
        return 1;
    }
    if (!d->mark_at(off, &lo, &hi)) return 0;
    if (d->hint_at(off, NULL, NULL)) return 0;
    if (off >= L->reveal_lo && off < L->reveal_hi) return 0;
    return rtx_scope_is_underline(d->style_at(off).scope);
}

int rtx_layout_md_index(const RtxLayout *L, size_t off) {
    int i;
    if (!L || !L->rich || L->md_ntab <= 0) return -1;
    for (i = 0; i < L->md_ntab; i++) {
        if (off >= L->md_tab[i].lo && off < L->md_tab[i].hi) return i;
    }
    return -1;
}

static int rtx_layout_md_role_at(const RtxLayout *L, size_t off) {
    int i = rtx_layout_md_index(L, off);
    if (i < 0) return RTX_MD_ROLE_NONE;
    return rtx_md_table_role(&L->md_tab[i], off);
}

static int rtx_layout_md_row_sep(const RtxLayout *L, size_t row) {
    if (!L || row >= L->rows.len) return 0;
    return rtx_layout_md_role_at(L, L->rows.data[row].byte_start) ==
           RTX_MD_ROLE_SEP;
}

static void rtx_layout_md_copy(RtxLayout *dst, const RtxLayout *src) {
    int i, j, n;
    if (!dst || !src) return;
    n = src->md_ntab;
    if (n < 0) n = 0;
    if (n > RTX_MD_TABLE_FILL) n = RTX_MD_TABLE_FILL;
    dst->md_ntab = n;
    dst->md_keep = n > 0 ? 1 : 0;
    dst->md_px = src->md_px;
    for (i = 0; i < n; i++) {
        dst->md_tab[i] = src->md_tab[i];
        for (j = 0; j < RTX_MD_TABLE_COLS; j++) {
            dst->md_colw[i][j] = src->md_colw[i][j];
            dst->md_colpx[i][j] = src->md_colpx[i][j];
        }
    }
}

static void rtx_layout_md_step(const RtxLayout *L, RtxDocLayout d, size_t base,
                               char[:] bytes, size_t i, size_t hi, size_t *step,
                               int *cols) {
    if (step) *step = 1;
    if (cols) *cols = 0;
    if (!bytes.ptr || i >= hi) return;
    {
        RtxHintVis hv;
        if (rtx_layout_hint_vis(L, d, base + i, bytes.ptr, i, hi, &hv)) {
            if (step) *step = hv.skip;
            if (cols) *cols = rtx_hint_standin_cols(hv.g, hv.gn);
            return;
        }
    }
    if (i + 1 < hi && bytes.ptr[i] == '\\' && bytes.ptr[i + 1] == '|') {
        if (step) *step = 2;
        if (cols) *cols = 1;
        return;
    }
    {
        RtxUtf8Cl cl = rtx_utf8_cluster(bytes, i);
        size_t n = cl.n ? cl.n : 1;
        int c = cl.cols > 0 ? cl.cols : 1;
        if (i + n > hi) n = hi - i;
        if (step) *step = n;
        if (cols) *cols = c;
    }
}

static int rtx_layout_md_vis(const RtxLayout *L, RtxDocLayout d, size_t base,
                             char[:] bytes, size_t lo, size_t hi) {
    size_t i = lo;
    int cols = 0;
    while (i < hi) {
        size_t step = 1;
        int dc = 0;
        rtx_layout_md_step(L, d, base, bytes, i, hi, &step, &dc);
        cols += dc;
        i += step;
    }
    return cols;
}

static double rtx_layout_md_measure_span(const RtxLayout *L, RtxDocLayout d,
                                         const RtxMeasure *m, size_t base,
                                         char[:] bytes, size_t lo, size_t hi,
                                         RtxSectionKind sec) {
    double w = 0;
    size_t i = lo;
    if (!m || !m->measure || !bytes.ptr || lo >= hi) return 0;
    while (i < hi) {
        RtxStyle st;
        {
            RtxHintVis hv;
            if (rtx_layout_hint_vis(L, d, base + i, bytes.ptr, i, hi, &hv)) {
                w += rtx_layout_standin_w(m, &hv, d->style_at(base + i), sec);
                i += hv.skip;
                if (i > hi) i = hi;
                continue;
            }
        }
        st = d->style_at(base + i);
        if (i + 1 < hi && bytes.ptr[i] == '\\' && bytes.ptr[i + 1] == '|') {
            char bar[1];
            bar[0] = '|';
            w += m->measure(m->ctx, cc_slice_from_buffer(bar, 1), st, sec);
            i += 2;
            continue;
        }
        {
            RtxUtf8Cl cl = rtx_utf8_cluster(bytes, i);
            size_t step = cl.n ? cl.n : 1;
            if (i + step > hi) step = hi - i;
            w += m->measure(m->ctx, bytes.sub(i, i + step), st, sec);
            i += step;
        }
    }
    return w;
}

static double rtx_layout_md_unit(const RtxMeasure *m, RtxSectionKind sec) {
    RtxStyle z = {0};
    char sp[1];
    char[:] s;
    double u;
    if (!m || !m->measure) return 1.0;
    sp[0] = ' ';
    s = cc_slice_from_buffer(sp, 1);
    u = m->measure(m->ctx, s, z, sec);
    return u > 0 ? u : 1.0;
}

static void rtx_layout_md_widths(RtxLayout *L, RtxDocLayout d,
                                 const RtxMeasure *m, size_t from, char[:] win,
                                 const RtxMdTable *t, int *col_w, int *col_px,
                                 RtxSectionKind sec) {
    size_t line, le, nrel;
    int nout, i;
    if (!L || !d || !t || !col_w || !win.ptr) return;
    nout = t->ncols;
    if (nout > RTX_MD_TABLE_COLS) nout = RTX_MD_TABLE_COLS;
    for (i = 0; i < nout; i++) {
        col_w[i] = 0;
        if (col_px) col_px[i] = 0;
    }
    nrel = t->hi;
    line = t->lo;
    while (line < nrel) {
        int role = rtx_md_table_role(t, line);
        le = line;
        while (le < nrel && win.ptr[le] != '\n') le++;
        if (role == RTX_MD_ROLE_HDR || role == RTX_MD_ROLE_BODY) {
            RtxMdCell cells[RTX_MD_TABLE_COLS];
            size_t nc = rtx_md_row_split(win.ptr + line, le - line, cells,
                                         RTX_MD_TABLE_COLS);
            size_t c, lim = (size_t)nout < nc ? (size_t)nout : nc;
            char[:] row = win.sub(line, le);
            for (c = 0; c < lim; c++) {
                size_t lo = cells[c].lo, hi = cells[c].hi;
                int w;
                rtx_md_span_trim(row.ptr, &lo, &hi);
                w = rtx_layout_md_vis(L, d, from + line, row, lo, hi);
                if (w > col_w[c]) col_w[c] = w;
                if (col_px && m && m->measure) {
                    double px = rtx_layout_md_measure_span(L, d, m, from + line,
                                                           row, lo, hi, sec);
                    int ipx = (int)(px + 0.999);
                    if (ipx < 1 && hi > lo) ipx = 1;
                    if (ipx > col_px[c]) col_px[c] = ipx;
                }
            }
        }
        if (le < nrel && win.ptr[le] == '\n') line = le + 1;
        else break;
    }
    if (col_px) {
        for (i = 0; i < nout; i++)
            if (col_px[i] < 1) col_px[i] = 1;
    }
}

/* Shrink content columns so full table width (content + pad/rails) fits
 * `pane`. Scale content only — chrome is fixed. Prefer each column keep
 * min(RTX_MD_FIT_PREF, natural width); only go below when the pane cannot
 * hold those floors. No-op when already fitting. */
static void rtx_layout_md_fit(RtxLayout *L, int ti, double pane) {
    int *cw, *cpx, ncols, i, total, room, chrome, col_room, sum;
    int use_px;
    int nat_w[RTX_MD_TABLE_COLS];
    int nat_px[RTX_MD_TABLE_COLS];
    if (!L || ti < 0 || ti >= L->md_ntab || pane <= 0) return;
    ncols = L->md_tab[ti].ncols;
    if (ncols < 1) return;
    if (ncols > RTX_MD_TABLE_COLS) ncols = RTX_MD_TABLE_COLS;
    use_px = L->md_px;
    cw = L->md_colw[ti];
    cpx = L->md_colpx[ti];
    room = (int)(pane + 0.5);
    for (i = 0; i < ncols; i++) {
        nat_w[i] = cw[i];
        nat_px[i] = cpx[i];
    }
    if (use_px) {
        chrome = RTX_MD_PX_LINE;
        for (i = 0; i < ncols; i++)
            chrome += 2 * RTX_MD_PX_PAD + RTX_MD_PX_LINE;
        total = 0;
        for (i = 0; i < ncols; i++) total += cpx[i];
        if (total < 1) return;
        col_room = room - chrome;
        if (col_room < ncols) col_room = ncols;
        if (total <= col_room) return;
        for (i = 0; i < ncols; i++) {
            int w = (int)((double)cpx[i] * (double)col_room / (double)total);
            if (w < 1) w = 1;
            cpx[i] = w;
        }
        sum = 0;
        for (i = 0; i < ncols; i++) sum += cpx[i];
        if (sum > col_room) {
            int over = sum - col_room;
            for (i = ncols - 1; i >= 0 && over > 0; i--) {
                int take = cpx[i] - 1;
                if (take > over) take = over;
                if (take > 0) {
                    cpx[i] -= take;
                    over -= take;
                }
            }
        } else if (sum < col_room) {
            cpx[ncols - 1] += col_room - sum;
        }
        /* Raise toward pref floors when slack exists (steal from fat cols). */
        {
            int floors = 0;
            int floor_px[RTX_MD_TABLE_COLS];
            for (i = 0; i < ncols; i++) {
                int f = RTX_MD_FIT_PREF_PX;
                if (f > nat_px[i]) f = nat_px[i];
                if (f < 1) f = 1;
                floor_px[i] = f;
                floors += f;
            }
            if (floors <= col_room) {
                for (i = 0; i < ncols; i++) {
                    if (cpx[i] >= floor_px[i]) continue;
                    {
                        int need = floor_px[i] - cpx[i];
                        int j;
                        for (j = 0; j < ncols && need > 0; j++) {
                            int spare;
                            if (j == i) continue;
                            spare = cpx[j] - floor_px[j];
                            if (spare < 1) continue;
                            if (spare > need) spare = need;
                            cpx[j] -= spare;
                            cpx[i] += spare;
                            need -= spare;
                        }
                    }
                }
            }
        }
        for (i = 0; i < ncols; i++) {
            int w = cpx[i] / 8;
            if (w < 1) w = 1;
            if (w < RTX_MD_MIN_COL) w = RTX_MD_MIN_COL;
            if (w < cw[i]) cw[i] = w;
        }
    } else {
        chrome = 2 * RTX_MD_TABLE_RAIL;
        if (ncols > 1) chrome += RTX_MD_TABLE_GAP * (ncols - 1);
        total = 0;
        for (i = 0; i < ncols; i++) total += cw[i];
        if (total < 1) return;
        col_room = room - chrome;
        if (col_room < ncols) col_room = ncols;
        if (total <= col_room) return;
        for (i = 0; i < ncols; i++) {
            int w = (int)((double)cw[i] * (double)col_room / (double)total);
            if (w < 1) w = 1;
            cw[i] = w;
        }
        sum = 0;
        for (i = 0; i < ncols; i++) sum += cw[i];
        if (sum > col_room) {
            int over = sum - col_room;
            for (i = ncols - 1; i >= 0 && over > 0; i--) {
                int take = cw[i] - 1;
                if (take > over) take = over;
                if (take > 0) {
                    cw[i] -= take;
                    over -= take;
                }
            }
        } else if (sum < col_room) {
            cw[ncols - 1] += col_room - sum;
        }
        {
            int floors = 0;
            int floor_w[RTX_MD_TABLE_COLS];
            for (i = 0; i < ncols; i++) {
                int f = RTX_MD_FIT_PREF;
                if (f > nat_w[i]) f = nat_w[i];
                if (f < 1) f = 1;
                floor_w[i] = f;
                floors += f;
            }
            if (floors <= col_room) {
                for (i = 0; i < ncols; i++) {
                    if (cw[i] >= floor_w[i]) continue;
                    {
                        int need = floor_w[i] - cw[i];
                        int j;
                        for (j = 0; j < ncols && need > 0; j++) {
                            int spare;
                            if (j == i) continue;
                            spare = cw[j] - floor_w[j];
                            if (spare < 1) continue;
                            if (spare > need) spare = need;
                            cw[j] -= spare;
                            cw[i] += spare;
                            need -= spare;
                        }
                    }
                }
            }
        }
    }
}

static size_t rtx_layout_md_lookback(RtxDocLayout d, size_t from) {
    size_t win, extra;
    if (!d || from == 0) return 0;
    win = from > (size_t)RTX_MARKUP_LOOKBACK ? from - (size_t)RTX_MARKUP_LOOKBACK
                                             : 0;
    extra = 0;
    @errhandler(CCError e) {
        (void)e;
        return win;
    }
    while (win > 0 && extra < (size_t)RTX_MARKUP_LOOKBACK) {
        char c = 0;
        size_t got = d->read_at(win - 1, &c, 1) !>;
        if (!got || c == '\n' || c == '\r') break;
        win--;
        extra++;
    }
    return win;
}

static void rtx_layout_md_push(RtxLayout *L, RtxDocLayout d, const RtxMeasure *m,
                               size_t base, char[:] ext, RtxMdTable t) {
    RtxSectionKind sec;
    if (!L || !d || L->md_ntab >= RTX_MD_TABLE_FILL) return;
    sec = d->section_at(base + t.lo);
    rtx_layout_md_widths(L, d, m, base, ext, &t, L->md_colw[L->md_ntab],
                         L->md_colpx[L->md_ntab], sec);
    t.lo += base;
    t.hi += base;
    t.sep_lo += base;
    t.sep_hi += base;
    t.body_lo += base;
    L->md_tab[L->md_ntab] = t;
    L->md_ntab++;
}

static void rtx_layout_md_collect(RtxLayout *L, RtxDocLayout d,
                                  const RtxMeasure *m, size_t from,
                                  char[:] bytes, double max_width) {
    char[:] ext;
    size_t base, fill_lo, fill_hi, rel;
    CCArena frame = {0};
    if (!L) return;
    if (L->md_keep) return;
    L->md_ntab = 0;
    L->md_px = 0;
    if (!L->rich || L->view == RTX_VIEW_GRID || L->view == RTX_VIEW_HEX)
        return;
    if (!bytes.ptr || !d) return;
    L->md_px = rtx_layout_md_unit(m, RTX_SEC_MARKUP) >= 2.0 ? 1 : 0;
    ext = bytes;
    base = from;
    fill_lo = 0;
    fill_hi = bytes.len;
    if (from > 0) {
        size_t win = rtx_layout_md_lookback(d, from);
        size_t n = bytes.len + (from - win);
        int got = 0;
        @errhandler(CCError e) {
            (void)e;
            got = 0;
        }
        d->ensure_hl(rtx_hl_keep(win, n)) !>;
        frame = cc_arena_heap(n + 64);
        if (frame.base) {
            ext = d->scratch_span(win, n, frame) !>;
            if (ext.ptr && ext.len) got = 1;
        }
        if (got) {
            base = win;
            fill_lo = from - win;
            fill_hi = fill_lo + bytes.len;
        } else {
            ext = bytes;
            if (frame.base) {
                frame.destroy();
                frame = (CCArena){0};
            }
        }
    }
    rel = 0;
    if (fill_lo > 0) {
        RtxMdTable t;
        if (rtx_md_table_cover(ext.ptr, ext.len, fill_lo, &t)) {
            rel = t.hi;
            rtx_layout_md_push(L, d, m, base, ext, t);
        }
    }
    while (L->md_ntab < RTX_MD_TABLE_FILL) {
        RtxMdTable t;
        if (!rtx_md_table_next(ext.ptr, ext.len, rel, &t)) break;
        if (t.hi <= fill_lo) {
            rel = t.hi;
            continue;
        }
        if (t.lo >= fill_hi) break;
        rel = t.hi;
        rtx_layout_md_push(L, d, m, base, ext, t);
    }
    if (frame.base) frame.destroy();
    /* A proportional host measures an em in many units; TUI stays 1≈1. */
    {
        int i, c, maxw = 0, maxpx = 0;
        for (i = 0; i < L->md_ntab; i++) {
            int n = L->md_tab[i].ncols;
            if (n > RTX_MD_TABLE_COLS) n = RTX_MD_TABLE_COLS;
            for (c = 0; c < n; c++) {
                if (L->md_colw[i][c] > maxw) maxw = L->md_colw[i][c];
                if (L->md_colpx[i][c] > maxpx) maxpx = L->md_colpx[i][c];
            }
        }
        if (maxpx > maxw + 2) L->md_px = 1;
    }
    /* Wrap on: fit columns to the pane so cell wrap can engage. */
    if (L->wrap && max_width > 0) {
        int i;
        for (i = 0; i < L->md_ntab; i++) rtx_layout_md_fit(L, i, max_width);
    }
}

static size_t rtx_layout_md_wrap_li_rel(const RtxMdCell *lines, size_t nl,
                                        size_t rel) {
    size_t i;
    if (!lines || nl == 0) return 0;
    /* Half-open [lo,hi): the byte at lines[i].hi belongs to the next line. */
    for (i = 0; i < nl; i++) {
        if (rel < lines[i].hi) return i;
    }
    return nl - 1;
}

static int rtx_layout_md_x_cols_row(const RtxLayout *L, RtxDocLayout d,
                                    const RtxVisRow *r, char[:] bytes,
                                    size_t off, int ti) {
    const RtxMdTable *t;
    const int *cw;
    size_t rel, n;
    int c, ncols;
    RtxMdCell cells[RTX_MD_TABLE_COLS];
    size_t nc;
    if (!L || !r || ti < 0) return -1;
    t = &L->md_tab[ti];
    cw = L->md_colw[ti];
    ncols = t->ncols;
    n = bytes.len;
    if (off < r->byte_start) rel = 0;
    else rel = off - r->byte_start;
    if (rel > n) rel = n;
    if (rtx_md_table_role(t, off) == RTX_MD_ROLE_SEP) return 0;
    nc = rtx_md_row_split(bytes.ptr, n, cells, RTX_MD_TABLE_COLS);
    c = rtx_md_row_col_at(bytes.ptr, n, rel, ncols);
    if (c < 0) {
        size_t i;
        if (nc == 0 || rel < cells[0].lo) return rtx_md_col_origin(cw, ncols, 0);
        for (i = 0; i < nc && i < (size_t)ncols; i++) {
            if (rel >= cells[i].hi && (i + 1 >= nc || rel < cells[i + 1].lo)) {
                int next = (int)i + 1;
                if (next >= ncols) return rtx_md_row_width(cw, ncols);
                return rtx_md_col_origin(cw, ncols, next);
            }
        }
        return rtx_md_row_width(cw, ncols);
    }
    if (c >= ncols) return rtx_md_row_width(cw, ncols);
    {
        size_t lo = cells[c].lo, hi = cells[c].hi;
        int cell_w, pad, x;
        rtx_md_span_trim(bytes.ptr, &lo, &hi);
        if (L->wrap && hi > lo) {
            RtxMdCell lines[RTX_MD_WRAP_MAX];
            size_t nl, li, slo, shi, rel_cell;
            nl = rtx_layout_md_cell_wrap(L, d, NULL, r->byte_start, bytes, lo, hi,
                                         ti, c, r->sec, lines, RTX_MD_WRAP_MAX);
            if (nl < 1) {
                lines[0].lo = 0;
                lines[0].hi = hi - lo;
                nl = 1;
            }
            rel_cell = rel > lo ? rel - lo : 0;
            li = rtx_layout_md_wrap_li_rel(lines, nl, rel_cell);
            slo = lo + lines[li].lo;
            shi = lo + lines[li].hi;
            if (shi > hi) shi = hi;
            if (slo > shi) slo = shi;
            cell_w = rtx_layout_md_vis(L, d, r->byte_start, bytes, slo, shi);
            pad = rtx_md_align_pad((int)t->align[c], cw[c], cell_w);
            x = rtx_md_col_origin(cw, ncols, c) + pad;
            if (rel <= slo) return x;
            if (rel >= shi) return x + cell_w;
            return x + rtx_layout_md_vis(L, d, r->byte_start, bytes, slo, rel);
        }
        cell_w = rtx_layout_md_vis(L, d, r->byte_start, bytes, lo, hi);
        pad = rtx_md_align_pad((int)t->align[c], cw[c], cell_w);
        x = rtx_md_col_origin(cw, ncols, c) + pad;
        if (rel <= lo) return x;
        if (rel >= hi) return x + cell_w;
        return x + rtx_layout_md_vis(L, d, r->byte_start, bytes, lo, rel);
    }
}

int rtx_layout_md_x_cols(const RtxLayout *L, RtxDocLayout d, const RtxVisRow *r,
                         char[:] bytes, size_t off) {
    int ti;
    if (!L || !r) return -1;
    ti = rtx_layout_md_index(L, r->byte_start);
    if (ti < 0) return -1;
    return rtx_layout_md_x_cols_row(L, d, r, bytes, off, ti);
}

static double rtx_layout_md_step_px(const RtxLayout *L, RtxDocLayout d,
                                    const RtxMeasure *m, size_t base,
                                    char[:] bytes, size_t i, size_t hi,
                                    RtxSectionKind sec, size_t *step) {
    size_t n = 1;
    int vis = 0;
    rtx_layout_md_step(L, d, base, bytes, i, hi, &n, &vis);
    if (step) *step = n;
    if (!vis || !m || !m->measure) return 0;
    if (n == 2 && i + 1 < hi && bytes.ptr[i] == '\\' &&
        bytes.ptr[i + 1] == '|') {
        char bar[1];
        bar[0] = '|';
        return m->measure(m->ctx, cc_slice_from_buffer(bar, 1),
                          d->style_at(base + i + 1), sec);
    }
    if (i + n > hi) n = hi - i;
    if (!n) return 0;
    return m->measure(m->ctx, bytes.sub(i, i + n), d->style_at(base + i), sec);
}

/* Soft-wrap one cell in measure units (GUI). `out` spans are relative to `lo`. */
static size_t rtx_layout_md_wrap_px(const RtxLayout *L, RtxDocLayout d,
                                    const RtxMeasure *m, size_t base,
                                    char[:] bytes, size_t lo, size_t hi,
                                    double max_px, RtxSectionKind sec,
                                    RtxMdCell *out, size_t cap) {
    size_t i = lo;
    size_t nf = 0;
    if (!out || cap == 0 || !bytes.ptr) return 0;
    if (max_px < 1.0) max_px = 1.0;
    if (hi > bytes.len) hi = bytes.len;
    if (lo >= hi) {
        out[0].lo = 0;
        out[0].hi = 0;
        return 1;
    }
    while (i < hi && nf < cap) {
        size_t row_start = i;
        double w = 0;
        size_t last_br = i;
        double last_br_w = 0;
        while (i < hi) {
            size_t step = 1;
            double pw;
            if (bytes.ptr[i] == '\n' || bytes.ptr[i] == '\r') break;
            pw = rtx_layout_md_step_px(L, d, m, base, bytes, i, hi, sec, &step);
            if (w > 0 && w + pw > max_px) {
                if (last_br > row_start) {
                    i = last_br;
                    w = last_br_w;
                }
                break;
            }
            w += pw;
            i += step;
            if (step == 1 && (bytes.ptr[i - 1] == ' ' || bytes.ptr[i - 1] == '\t' ||
                              bytes.ptr[i - 1] == '-' || bytes.ptr[i - 1] == '/')) {
                last_br = i;
                last_br_w = w;
            }
        }
        if (i == row_start && i < hi && bytes.ptr[i] != '\n' &&
            bytes.ptr[i] != '\r') {
            size_t step = 1;
            (void)rtx_layout_md_step_px(L, d, m, base, bytes, i, hi, sec, &step);
            i += step;
        }
        if (nf + 1 == cap && i < hi) i = hi;
        out[nf].lo = row_start - lo;
        out[nf].hi = i - lo;
        nf++;
        if (i < hi && (bytes.ptr[i] == '\n' || bytes.ptr[i] == '\r'))
            i = (bytes.ptr[i] == '\r' && i + 1 < hi && bytes.ptr[i + 1] == '\n')
                    ? i + 2
                    : i + 1;
    }
    return nf ? nf : 1;
}

static int rtx_layout_md_row_lines(const RtxLayout *L, RtxDocLayout d,
                                   const RtxMeasure *m, size_t base,
                                   char[:] bytes, int ti, RtxSectionKind sec) {
    const RtxMdTable *t;
    RtxMdCell cells[RTX_MD_TABLE_COLS];
    RtxMdCell lines[RTX_MD_WRAP_MAX];
    size_t nc, c, lim;
    int h = 1;
    if (!L || ti < 0 || ti >= L->md_ntab || !bytes.ptr) return 1;
    t = &L->md_tab[ti];
    nc = rtx_md_row_split(bytes.ptr, bytes.len, cells, RTX_MD_TABLE_COLS);
    lim = (size_t)t->ncols < nc ? (size_t)t->ncols : nc;
    for (c = 0; c < lim; c++) {
        size_t lo = cells[c].lo, hi = cells[c].hi;
        size_t nh;
        rtx_md_span_trim(bytes.ptr, &lo, &hi);
        if (L->md_px && m && m->measure) {
            double max_px = (double)L->md_colpx[ti][c];
            nh = rtx_layout_md_wrap_px(L, d, m, base, bytes, lo, hi, max_px, sec,
                                       lines, RTX_MD_WRAP_MAX);
        } else {
            nh = rtx_md_wrap_field(bytes.ptr + lo, hi - lo, L->md_colw[ti][c],
                                   lines, RTX_MD_WRAP_MAX);
        }
        if ((int)nh > h) h = (int)nh;
    }
    return h < 1 ? 1 : h;
}

size_t rtx_layout_md_cell_wrap(const RtxLayout *L, RtxDocLayout d,
                               const RtxMeasure *m, size_t row_base,
                               char[:] bytes, size_t lo, size_t hi, int ti,
                               int col, RtxSectionKind sec, RtxMdCell *out,
                               size_t cap) {
    if (!L || !out || cap == 0 || ti < 0 || ti >= L->md_ntab) return 0;
    if (col < 0 || col >= L->md_tab[ti].ncols) return 0;
    if (L->md_px && m && m->measure)
        return rtx_layout_md_wrap_px(L, d, m, row_base, bytes, lo, hi,
                                     (double)L->md_colpx[ti][col], sec, out,
                                     cap);
    return rtx_md_wrap_field(bytes.ptr + lo, hi > lo ? hi - lo : 0,
                             L->md_colw[ti][col], out, cap);
}

int rtx_layout_md_wrap_li(const RtxLayout *L, RtxDocLayout d, const RtxMeasure *m,
                          size_t off) {
    int ti, c;
    const RtxVisRow *r;
    size_t i, rel, lo, hi;
    RtxMdCell cells[RTX_MD_TABLE_COLS];
    RtxMdCell lines[RTX_MD_WRAP_MAX];
    size_t nc, nl;
    CCArena frame = {0};
    char[:] bytes = cc_slice_empty();
    int ok = 1;
    if (!L || !d || L->rows.len == 0) return 0;
    ti = rtx_layout_md_index(L, off);
    if (ti < 0) return 0;
    if (rtx_md_table_role(&L->md_tab[ti], off) == RTX_MD_ROLE_SEP) return 0;
    if (!L->wrap) return 0;
    i = L->row_of(off);
    r = &L->rows.data[i];
    if (!r->byte_len) return 0;
    frame = cc_arena_heap(r->byte_len + 64);
    if (!frame.base) return 0;
    {
        @errhandler(CCError e) {
            (void)e;
            ok = 0;
        }
        bytes = d->scratch_span(r->byte_start, r->byte_len, frame) !>;
    }
    if (!ok) {
        frame.destroy();
        return 0;
    }
    nc = rtx_md_row_split(bytes.ptr, bytes.len, cells, RTX_MD_TABLE_COLS);
    rel = off < r->byte_start ? 0 : off - r->byte_start;
    if (rel > bytes.len) rel = bytes.len;
    c = rtx_md_row_col_at(bytes.ptr, bytes.len, rel, L->md_tab[ti].ncols);
    if (c < 0 || (size_t)c >= nc) {
        frame.destroy();
        return 0;
    }
    lo = cells[c].lo;
    hi = cells[c].hi;
    rtx_md_span_trim(bytes.ptr, &lo, &hi);
    nl = rtx_layout_md_cell_wrap(L, d, m, r->byte_start, bytes, lo, hi, ti, c,
                                 r->sec, lines, RTX_MD_WRAP_MAX);
    if (nl < 1) {
        frame.destroy();
        return 0;
    }
    {
        size_t li = rtx_layout_md_wrap_li_rel(lines, nl, rel > lo ? rel - lo : 0);
        frame.destroy();
        return (int)li;
    }
}

static double rtx_layout_md_x_px_row(const RtxLayout *L, RtxDocLayout d,
                                     const RtxMeasure *m, const RtxVisRow *r,
                                     char[:] bytes, size_t off, int ti) {
    const RtxMdTable *t;
    const int *cpx;
    size_t rel, n;
    int c, ncols;
    RtxMdCell cells[RTX_MD_TABLE_COLS];
    size_t nc;
    if (!L || !r || ti < 0) return 0;
    t = &L->md_tab[ti];
    cpx = L->md_colpx[ti];
    ncols = t->ncols;
    n = bytes.len;
    if (off < r->byte_start) rel = 0;
    else rel = off - r->byte_start;
    if (rel > n) rel = n;
    if (rtx_md_table_role(t, off) == RTX_MD_ROLE_SEP) return 0;
    nc = rtx_md_row_split(bytes.ptr, n, cells, RTX_MD_TABLE_COLS);
    c = rtx_md_row_col_at(bytes.ptr, n, rel, ncols);
    if (c < 0) {
        size_t i;
        if (nc == 0 || rel < cells[0].lo)
            return (double)rtx_md_px_origin(cpx, ncols, 0);
        for (i = 0; i < nc && i < (size_t)ncols; i++) {
            if (rel >= cells[i].hi && (i + 1 >= nc || rel < cells[i + 1].lo)) {
                int next = (int)i + 1;
                if (next >= ncols)
                    return (double)rtx_md_px_width(cpx, ncols);
                return (double)rtx_md_px_vline(cpx, ncols, next);
            }
        }
        return (double)rtx_md_px_width(cpx, ncols);
    }
    if (c >= ncols) return (double)rtx_md_px_width(cpx, ncols);
    {
        size_t lo = cells[c].lo, hi = cells[c].hi;
        double cell_px, pad, x;
        rtx_md_span_trim(bytes.ptr, &lo, &hi);
        if (L->wrap && hi > lo) {
            RtxMdCell lines[RTX_MD_WRAP_MAX];
            size_t nl, li, slo, shi, rel_cell;
            nl = rtx_layout_md_cell_wrap(L, d, m, r->byte_start, bytes, lo, hi,
                                         ti, c, r->sec, lines, RTX_MD_WRAP_MAX);
            if (nl < 1) {
                lines[0].lo = 0;
                lines[0].hi = hi - lo;
                nl = 1;
            }
            rel_cell = rel > lo ? rel - lo : 0;
            li = rtx_layout_md_wrap_li_rel(lines, nl, rel_cell);
            slo = lo + lines[li].lo;
            shi = lo + lines[li].hi;
            if (shi > hi) shi = hi;
            if (slo > shi) slo = shi;
            cell_px = rtx_layout_md_measure_span(L, d, m, r->byte_start, bytes,
                                                 slo, shi, r->sec);
            pad = (double)rtx_md_align_pad((int)t->align[c], cpx[c],
                                           (int)(cell_px + 0.999));
            x = (double)rtx_md_px_origin(cpx, ncols, c) + pad;
            if (rel <= slo) return x;
            if (rel >= shi) return x + cell_px;
            return x + rtx_layout_md_measure_span(L, d, m, r->byte_start, bytes,
                                                  slo, rel, r->sec);
        }
        cell_px = rtx_layout_md_measure_span(L, d, m, r->byte_start, bytes, lo,
                                             hi, r->sec);
        pad = (double)rtx_md_align_pad((int)t->align[c], cpx[c],
                                       (int)(cell_px + 0.999));
        x = (double)rtx_md_px_origin(cpx, ncols, c) + pad;
        if (rel <= lo) return x;
        if (rel >= hi) return x + cell_px;
        return x + rtx_layout_md_measure_span(L, d, m, r->byte_start, bytes, lo,
                                              rel, r->sec);
    }
}

static int rtx_layout_md_line_at(const RtxLayout *L, RtxDocLayout d, size_t off,
                                 size_t *ls, size_t *ln) {
    int ti;
    const RtxMdTable *t;
    if (!L || !d || !ls || !ln) return 0;
    ti = rtx_layout_md_index(L, off);
    if (ti < 0) return 0;
    t = &L->md_tab[ti];
    if (L->rows.len) {
        size_t i = L->row_of(off);
        if (i < L->rows.len) {
            size_t a = L->rows.data[i].byte_start;
            size_t n = L->rows.data[i].byte_len;
            if (a >= t->lo && a < t->hi) {
                *ls = a;
                *ln = n;
                return 1;
            }
        }
    }
    {
        size_t i, dlen, got;
        char ch;
        dlen = d->len();
        i = off;
        if (i > t->hi) i = t->hi;
        if (i < t->lo) i = t->lo;
        while (i > t->lo) {
            got = d->read_at(i - 1, &ch, 1) !>(e) {
                (void)e;
                return 0;
            };
            if (got != 1 || ch == '\n') break;
            i--;
        }
        *ls = i;
        while (i < t->hi && i < dlen) {
            got = d->read_at(i, &ch, 1) !>(e) {
                (void)e;
                return 0;
            };
            if (got != 1 || ch == '\n') break;
            i++;
        }
        *ln = i - *ls;
    }
    return 1;
}

static size_t rtx_layout_md_first_vis(const RtxLayout *L, RtxDocLayout d,
                                     size_t base, size_t lo, size_t hi) {
    size_t i = lo;
    while (i < hi) {
        size_t to = rtx_layout_hidden_to(L, d, base + i);
        if (to) {
            i = to > base + hi ? hi : to - base;
            continue;
        }
        return base + i;
    }
    return base + lo;
}

static size_t rtx_layout_md_snap_once(const RtxLayout *L, RtxDocLayout d,
                                      size_t off, int dir) {
    int ti, c, ncols;
    const RtxMdTable *t;
    size_t ls, ln, rel, nc, i;
    RtxMdCell cells[RTX_MD_TABLE_COLS];
    CCArena frame;
    char[:] bytes;
    size_t lo, hi, want;
    if (!L || !d) return off;
    ti = rtx_layout_md_index(L, off);
    if (ti < 0) return off;
    t = &L->md_tab[ti];
    ncols = t->ncols;
    if (rtx_md_table_role(t, off) == RTX_MD_ROLE_SEP) {
        if (dir < 0) return t->sep_lo ? t->sep_lo - 1 : t->lo;
        if (t->body_lo < t->hi) return t->body_lo;
        return t->lo;
    }
    if (!rtx_layout_md_line_at(L, d, off, &ls, &ln)) return off;
    if (!ln) return off;
    frame = cc_arena_heap(ln + 64);
    if (!frame.base) return off;
    bytes = d->scratch_span(ls, ln, frame) !>(e) {
        (void)e;
        frame.destroy();
        return off;
    };
    nc = rtx_md_row_split(bytes.ptr, bytes.len, cells, RTX_MD_TABLE_COLS);
    if (off < ls) rel = 0;
    else rel = off - ls;
    if (rel > bytes.len) rel = bytes.len;
    c = rtx_md_row_col_at(bytes.ptr, bytes.len, rel, ncols);
    if (c >= 0 && (size_t)c < nc) {
        lo = cells[c].lo;
        hi = cells[c].hi;
        rtx_md_span_trim(bytes.ptr, &lo, &hi);
        if (rel >= lo && rel <= hi) {
            if (dir == 0) {
                size_t to = rtx_layout_hidden_to(L, d, ls + rel);
                if (to && to > ls + rel && to <= ls + hi) {
                    frame.destroy();
                    return to;
                }
            }
            frame.destroy();
            return off;
        }
        if (rel < lo) {
            want = dir < 0 ? (size_t)0 : rtx_layout_md_first_vis(L, d, ls, lo, hi);
            if (dir < 0) {
                if (c == 0) want = ls ? ls - 1 : ls + lo;
                else {
                    size_t plo = cells[c - 1].lo, phi = cells[c - 1].hi;
                    rtx_md_span_trim(bytes.ptr, &plo, &phi);
                    want = ls + phi;
                }
            }
            frame.destroy();
            return want;
        }
        /* trailing pad */
        if (dir > 0) {
            if ((size_t)c + 1 < nc && (size_t)c + 1 < (size_t)ncols) {
                size_t nlo = cells[c + 1].lo, nhi = cells[c + 1].hi;
                rtx_md_span_trim(bytes.ptr, &nlo, &nhi);
                want = ls + nlo;
            } else {
                want = ls + bytes.len;
            }
        } else {
            want = ls + hi;
        }
        frame.destroy();
        return want;
    }
    /* `|` delimiter or leftover past the split */
    if (nc == 0) {
        frame.destroy();
        return off;
    }
    if (rel < cells[0].lo) {
        lo = cells[0].lo;
        hi = cells[0].hi;
        rtx_md_span_trim(bytes.ptr, &lo, &hi);
        want = dir < 0 ? (ls ? ls - 1 : ls + lo)
                       : rtx_layout_md_first_vis(L, d, ls, lo, hi);
        frame.destroy();
        return want;
    }
    for (i = 0; i < nc && i < (size_t)ncols; i++) {
        size_t next_lo = (i + 1 < nc) ? cells[i + 1].lo : bytes.len;
        if (rel >= cells[i].hi && rel < next_lo) {
            size_t plo = cells[i].lo, phi = cells[i].hi;
            rtx_md_span_trim(bytes.ptr, &plo, &phi);
            if (dir < 0) {
                want = ls + phi;
            } else if (dir > 0) {
                if (i + 1 < nc) {
                    size_t nlo = cells[i + 1].lo, nhi = cells[i + 1].hi;
                    rtx_md_span_trim(bytes.ptr, &nlo, &nhi);
                    want = ls + nlo;
                } else {
                    want = ls + bytes.len;
                }
            } else {
                /* Land on the pipe that closes cell i: stay at that
                 * cell's end so type / click insert there. Leading `|`
                 * is handled above (first cell start). */
                want = ls + phi;
            }
            frame.destroy();
            return want;
        }
    }
    {
        size_t plo = cells[nc - 1].lo, phi = cells[nc - 1].hi;
        rtx_md_span_trim(bytes.ptr, &plo, &phi);
        want = dir < 0 ? ls + phi : ls + bytes.len;
        if (dir == 0) want = ls + phi;
        frame.destroy();
        return want;
    }
}

size_t rtx_layout_md_snap(const RtxLayout *L, RtxDocLayout d, size_t off,
                          int dir) {
    int guard;
    size_t cur;
    if (!L || !L->rich || !d) return off;
    if (L->view == RTX_VIEW_GRID || L->view == RTX_VIEW_HEX) return off;
    cur = off;
    for (guard = 0; guard < 6; guard++) {
        size_t next = rtx_layout_md_snap_once(L, d, cur, dir);
        if (next == cur) return cur;
        cur = next;
    }
    return cur;
}

static int rtx_layout_md_own_col(const RtxMdCell *cells, size_t nc, int ncols,
                                 size_t rel) {
    size_t i;
    int lim = ncols;
    if ((size_t)lim > nc) lim = (int)nc;
    if (nc == 0 || lim <= 0) return -1;
    if (rel < cells[0].lo) return 0;
    for (i = 0; i < (size_t)lim; i++) {
        size_t next_lo = (i + 1 < nc) ? cells[i + 1].lo : (size_t)-1;
        if (rel >= cells[i].lo && rel < cells[i].hi) return (int)i;
        if (rel >= cells[i].hi && (next_lo == (size_t)-1 || rel < next_lo))
            return (int)i;
    }
    return lim - 1;
}

int rtx_layout_md_cell_span(const RtxLayout *L, RtxDocLayout d, size_t off,
                            size_t *clo, size_t *chi) {
    int ti, c, ncols;
    const RtxMdTable *t;
    size_t ls, ln, rel, nc;
    RtxMdCell cells[RTX_MD_TABLE_COLS];
    CCArena frame;
    char[:] bytes;
    size_t lo, hi;
    if (!L || !d || !clo || !chi) return 0;
    ti = rtx_layout_md_index(L, off);
    if (ti < 0) return 0;
    t = &L->md_tab[ti];
    if (rtx_md_table_role(t, off) == RTX_MD_ROLE_SEP) return 0;
    if (!rtx_layout_md_line_at(L, d, off, &ls, &ln) || !ln) return 0;
    frame = cc_arena_heap(ln + 64);
    if (!frame.base) return 0;
    bytes = d->scratch_span(ls, ln, frame) !>(e) {
        (void)e;
        frame.destroy();
        return 0;
    };
    nc = rtx_md_row_split(bytes.ptr, bytes.len, cells, RTX_MD_TABLE_COLS);
    ncols = t->ncols;
    rel = off < ls ? 0 : off - ls;
    if (rel > bytes.len) rel = bytes.len;
    c = rtx_layout_md_own_col(cells, nc, ncols, rel);
    if (c < 0 || (size_t)c >= nc) {
        frame.destroy();
        return 0;
    }
    lo = cells[c].lo;
    hi = cells[c].hi;
    rtx_md_span_trim(bytes.ptr, &lo, &hi);
    *clo = ls + lo;
    *chi = ls + hi;
    frame.destroy();
    return 1;
}

size_t rtx_layout_md_step_cell(const RtxLayout *L, RtxDocLayout d, size_t off,
                               int dir) {
    int ti, c, ncols, next;
    const RtxMdTable *t;
    size_t ls, ln, rel, nc, lo, hi;
    RtxMdCell cells[RTX_MD_TABLE_COLS];
    CCArena frame;
    char[:] bytes;
    if (!L || !d || dir == 0) return off;
    ti = rtx_layout_md_index(L, off);
    if (ti < 0) return off;
    t = &L->md_tab[ti];
    if (rtx_md_table_role(t, off) == RTX_MD_ROLE_SEP) return off;
    if (!rtx_layout_md_line_at(L, d, off, &ls, &ln) || !ln) return off;
    frame = cc_arena_heap(ln + 64);
    if (!frame.base) return off;
    bytes = d->scratch_span(ls, ln, frame) !>(e) {
        (void)e;
        frame.destroy();
        return off;
    };
    nc = rtx_md_row_split(bytes.ptr, bytes.len, cells, RTX_MD_TABLE_COLS);
    ncols = t->ncols;
    rel = off < ls ? 0 : off - ls;
    if (rel > bytes.len) rel = bytes.len;
    c = rtx_layout_md_own_col(cells, nc, ncols, rel);
    next = c + (dir > 0 ? 1 : -1);
    if (c < 0 || next < 0 || next >= ncols || (size_t)next >= nc) {
        frame.destroy();
        return off;
    }
    lo = cells[next].lo;
    hi = cells[next].hi;
    rtx_md_span_trim(bytes.ptr, &lo, &hi);
    off = rtx_layout_md_first_vis(L, d, ls, lo, hi);
    frame.destroy();
    return off;
}

int rtx_layout_md_col_at(const RtxLayout *L, RtxDocLayout d, size_t off) {
    int ti, c, ncols;
    const RtxMdTable *t;
    size_t ls, ln, rel, nc;
    RtxMdCell cells[RTX_MD_TABLE_COLS];
    CCArena frame;
    char[:] bytes;
    if (!L || !d) return -1;
    ti = rtx_layout_md_index(L, off);
    if (ti < 0) return -1;
    t = &L->md_tab[ti];
    if (rtx_md_table_role(t, off) == RTX_MD_ROLE_SEP) return -1;
    if (!rtx_layout_md_line_at(L, d, off, &ls, &ln) || !ln) return -1;
    frame = cc_arena_heap(ln + 64);
    if (!frame.base) return -1;
    bytes = d->scratch_span(ls, ln, frame) !>(e) {
        (void)e;
        frame.destroy();
        return -1;
    };
    nc = rtx_md_row_split(bytes.ptr, bytes.len, cells, RTX_MD_TABLE_COLS);
    ncols = t->ncols;
    rel = off < ls ? 0 : off - ls;
    if (rel > bytes.len) rel = bytes.len;
    c = rtx_layout_md_own_col(cells, nc, ncols, rel);
    frame.destroy();
    return c;
}

static size_t rtx_layout_md_hit_px(const RtxLayout *L, const RtxVisRow *r,
                                   RtxDocLayout d, const RtxMeasure *m,
                                   char[:] bytes, double x, double y_in,
                                   int ti) {
    const RtxMdTable *t;
    const int *cpx;
    int c, ncols;
    RtxMdCell cells[RTX_MD_TABLE_COLS];
    size_t nc, n;
    double lh;
    if (!L || !r || !d || ti < 0) return r ? r->byte_start : 0;
    t = &L->md_tab[ti];
    cpx = L->md_colpx[ti];
    ncols = t->ncols;
    n = bytes.len;
    nc = rtx_md_row_split(bytes.ptr, n, cells, RTX_MD_TABLE_COLS);
    if (x < 0) x = 0;
    if (y_in < 0) y_in = 0;
    lh = m && m->line_height ? m->line_height(m->ctx, (RtxStyle){0}, r->sec)
                             : 1.0;
    if (lh < 1.0) lh = 1.0;
    if (rtx_md_table_role(t, r->byte_start) == RTX_MD_ROLE_SEP) {
        if (t->body_lo < t->hi) return t->body_lo;
        return t->lo;
    }
    if (x < (double)rtx_md_px_origin(cpx, ncols, 0) && nc) {
        size_t lo = cells[0].lo, hi = cells[0].hi;
        rtx_md_span_trim(bytes.ptr, &lo, &hi);
        return r->byte_start + lo;
    }
    for (c = 0; c < ncols; c++) {
        int right = rtx_md_px_vline(cpx, ncols, c + 1);
        if (x < (double)right + (double)RTX_MD_PX_LINE || c + 1 == ncols) {
            size_t lo, hi, i, slo, shi;
            double cell_px, pad, local;
            if ((size_t)c >= nc) return r->byte_start + n;
            lo = cells[c].lo;
            hi = cells[c].hi;
            rtx_md_span_trim(bytes.ptr, &lo, &hi);
            slo = lo;
            shi = hi;
            if (L->wrap && hi > lo) {
                RtxMdCell lines[RTX_MD_WRAP_MAX];
                size_t nl, li;
                nl = rtx_layout_md_cell_wrap(L, d, m, r->byte_start, bytes, lo,
                                             hi, ti, c, r->sec, lines,
                                             RTX_MD_WRAP_MAX);
                if (nl < 1) {
                    lines[0].lo = 0;
                    lines[0].hi = hi - lo;
                    nl = 1;
                }
                li = (size_t)(y_in / lh);
                if (li >= nl) li = nl - 1;
                slo = lo + lines[li].lo;
                shi = lo + lines[li].hi;
                if (shi > hi) shi = hi;
                if (slo > shi) slo = shi;
            }
            cell_px = rtx_layout_md_measure_span(L, d, m, r->byte_start, bytes,
                                                 slo, shi, r->sec);
            pad = (double)rtx_md_align_pad((int)t->align[c], cpx[c],
                                           (int)(cell_px + 0.999));
            local = x - (double)rtx_md_px_origin(cpx, ncols, c);
            if (local < pad) return r->byte_start + slo;
            local -= pad;
            if (local >= cell_px) {
                if (shi > slo) return r->byte_start + shi;
                return r->byte_start + cells[c].lo;
            }
            i = slo;
            while (i < shi) {
                size_t step = 1;
                double pw = rtx_layout_md_step_px(L, d, m, r->byte_start, bytes,
                                                  i, shi, r->sec, &step);
                if (local < pw) return r->byte_start + i;
                local -= pw;
                i += step;
            }
            return r->byte_start + shi;
        }
    }
    return r->byte_start + n;
}

static size_t rtx_layout_md_hit_row(const RtxLayout *L, const RtxVisRow *r,
                                    RtxDocLayout d, const RtxMeasure *m,
                                    char[:] bytes, double x, double y_in) {
    int ti, c, ncols, dc;
    const RtxMdTable *t;
    const int *cw;
    double unit, acc;
    RtxMdCell cells[RTX_MD_TABLE_COLS];
    size_t nc, n;
    if (!L || !r || !d) return r ? r->byte_start : 0;
    ti = rtx_layout_md_index(L, r->byte_start);
    if (ti < 0) return r->byte_start;
    if (L->md_px || rtx_layout_md_unit(m, r->sec) >= 2.0)
        return rtx_layout_md_hit_px(L, r, d, m, bytes, x, y_in, ti);
    t = &L->md_tab[ti];
    cw = L->md_colw[ti];
    ncols = t->ncols;
    n = bytes.len;
    nc = rtx_md_row_split(bytes.ptr, n, cells, RTX_MD_TABLE_COLS);
    unit = rtx_layout_md_unit(m, r->sec);
    if (x < 0) x = 0;
    if (y_in < 0) y_in = 0;
    if (rtx_md_table_role(t, r->byte_start) == RTX_MD_ROLE_SEP) {
        if (t->body_lo < t->hi) return t->body_lo;
        return t->lo;
    }
    dc = unit > 0 ? (int)(x / unit + 0.0001) : (int)x;
    acc = (double)RTX_MD_TABLE_RAIL;
    if (dc < RTX_MD_TABLE_RAIL) {
        size_t lo, hi;
        if (nc == 0) return r->byte_start;
        lo = cells[0].lo;
        hi = cells[0].hi;
        rtx_md_span_trim(bytes.ptr, &lo, &hi);
        return r->byte_start + lo;
    }
    for (c = 0; c < ncols; c++) {
        int w = cw[c];
        int next = (int)acc + w;
        int in_gap = (c + 1 < ncols);
        if (dc < next + (in_gap ? RTX_MD_TABLE_GAP : 0) || c + 1 == ncols) {
            size_t lo, hi, i, slo, shi;
            int cell_w, pad, local;
            if ((size_t)c >= nc) return r->byte_start + n;
            lo = cells[c].lo;
            hi = cells[c].hi;
            rtx_md_span_trim(bytes.ptr, &lo, &hi);
            slo = lo;
            shi = hi;
            if (L->wrap && hi > lo) {
                RtxMdCell lines[RTX_MD_WRAP_MAX];
                size_t nl, li;
                nl = rtx_layout_md_cell_wrap(L, d, m, r->byte_start, bytes, lo,
                                             hi, ti, c, r->sec, lines,
                                             RTX_MD_WRAP_MAX);
                if (nl < 1) {
                    lines[0].lo = 0;
                    lines[0].hi = hi - lo;
                    nl = 1;
                }
                li = (size_t)(y_in + 0.0001);
                if (li >= nl) li = nl - 1;
                slo = lo + lines[li].lo;
                shi = lo + lines[li].hi;
                if (shi > hi) shi = hi;
                if (slo > shi) slo = shi;
            }
            cell_w = rtx_layout_md_vis(L, d, r->byte_start, bytes, slo, shi);
            pad = rtx_md_align_pad((int)t->align[c], w, cell_w);
            local = dc - (int)acc;
            if (local < pad) return r->byte_start + slo;
            local -= pad;
            if (local >= cell_w) {
                if (shi > slo) return r->byte_start + shi;
                return r->byte_start + cells[c].lo;
            }
            i = slo;
            while (i < shi) {
                size_t step = 1;
                int vis = 0;
                rtx_layout_md_step(L, d, r->byte_start, bytes, i, shi, &step,
                                   &vis);
                if (local < vis) return r->byte_start + i;
                local -= vis;
                i += step;
            }
            return r->byte_start + shi;
        }
        acc += (double)(w + RTX_MD_TABLE_GAP);
    }
    return r->byte_start + n;
}

/* Width-bearing bits only. Scope colours a glyph; it does not size one, so
 * adjacent runs that differ only in scope measure as one segment. */
static int rtx_layout_size_eq(RtxStyle a, RtxStyle b) {
    return a.bold == b.bold && a.italic == b.italic && a.mono == b.mono;
}

/* Next relative edge: style_next, clipped by hint_next when Rich marks are
 * live. Same boundary rule as row_measure. */
static size_t rtx_layout_style_edge(const RtxLayout *L, RtxDocLayout d,
                                    size_t from, size_t i, size_t hi) {
    size_t nxt = d->style_next(from + i, from + hi) - from;
    if (L->has_marks) {
        size_t hn = d->hint_next(from + i, from + nxt) - from;
        if (hn < nxt) nxt = hn;
    }
    if (nxt > hi) nxt = hi;
    if (nxt <= i) nxt = i + 1;
    return nxt;
}

/*
 * Unwrapped row: width is the sum of per-size-style segment measures,
 * height the max over them. Walk run edges with `style_next` (any
 * planter: prose scanner or TM sidecar bold/italic/mono) and coalesce
 * edges where no width-bearing bit changes. A line with no run is one
 * style_next call and one measure — a 3 MiB JSON line pays as before.
 */
static double rtx_layout_row_measure(const RtxLayout *L, RtxDocLayout d,
                                     const RtxMeasure *m, size_t from,
                                     char[:] bytes, size_t lo, size_t hi,
                                     RtxSectionKind sec, double *h_out) {
    RtxStyle cur;
    size_t seg = lo, k = lo;
    double w = 0, h;
    cur = d->style_at(from + lo);
    h = m->line_height(m->ctx, cur, sec);
    while (k < hi) {
        size_t nxt;
        RtxStyle st;
        double gh;
        /* Rich: a hidden hint at k is zero width unless it has a stand-in
         * (list marker / task box). The segment resumes past it. */
        {
            RtxHintVis hv;
            if (rtx_layout_hint_vis(L, d, from + k, bytes.ptr, k, hi, &hv)) {
                if (seg < k) w += m->measure(m->ctx, bytes.sub(seg, k), cur, sec);
                w += rtx_layout_standin_w(m, &hv, d->style_at(from + k), sec);
                k += hv.skip;
                if (k > hi) k = hi;
                seg = k;
                if (k < hi) cur = d->style_at(from + k);
                continue;
            }
        }
        nxt = rtx_layout_style_edge(L, d, from, k, hi);
        if (nxt >= hi) break;
        st = d->style_at(from + nxt);
        k = nxt;
        if (rtx_layout_size_eq(st, cur)) continue;
        w += m->measure(m->ctx, bytes.sub(seg, k), cur, sec);
        seg = k;
        cur = st;
        gh = m->line_height(m->ctx, cur, sec);
        if (gh > h) h = gh;
    }
    if (seg < hi) w += m->measure(m->ctx, bytes.sub(seg, hi), cur, sec);
    *h_out = h;
    return w;
}

static void !>(CCError) rtx_layout_range_walk(RtxLayout *L, RtxDocLayout d,
                                             const RtxMeasure *m, size_t from,
                                             size_t n, double max_width, int wrap,
                                             char[:] bytes) {
    size_t i = 0;
    /* Callers set L->from_line (exact for lines(); fill_off guess is a
     * gutter label, not a camera). */
    size_t phys = L->from_line;
    while (i < n) {
        RtxSectionKind sec = d->section_at(from + i);
        size_t line_end = i;
        RtxStyle z = {0};
        while (line_end < n && bytes.ptr[line_end] != '\n') line_end++;
        if (d->fold_covers(from + i)) {
            i = line_end;
            if (i < n && bytes.ptr[i] == '\n') {
                i++;
                phys++;
            }
            continue;
        }
        {
            int role = rtx_layout_md_role_at(L, from + i);
            if (role == RTX_MD_ROLE_HDR || role == RTX_MD_ROLE_SEP ||
                role == RTX_MD_ROLE_BODY) {
                int ti = rtx_layout_md_index(L, from + i);
                double h = m->line_height(m->ctx, z, sec);
                double unit = rtx_layout_md_unit(m, sec);
                double w = 0;
                if (ti >= 0) {
                    if (L->md_px)
                        w = (double)rtx_md_px_width(L->md_colpx[ti],
                                                    L->md_tab[ti].ncols);
                    else
                        w = (double)rtx_md_row_width(L->md_colw[ti],
                                                     L->md_tab[ti].ncols) *
                            unit;
                    if (role == RTX_MD_ROLE_SEP && L->md_px &&
                        h > (double)RTX_MD_PX_SEP)
                        h = (double)RTX_MD_PX_SEP;
                    else if (role != RTX_MD_ROLE_SEP && L->wrap) {
                        /* Tall record: GUI (md_px) and TUI both grow height so
                         * paint can emit every wrap line. */
                        char[:] rowb = bytes.sub(i, line_end);
                        int lines = rtx_layout_md_row_lines(L, d, m, from + i,
                                                            rowb, ti, sec);
                        if (lines > 1) h *= (double)lines;
                    }
                }
                if (!rtx_layout_push_row(L, m, from + i, line_end - i, phys,
                                         w, h, 0, sec)) {
                    return cc_err(CC_ERR_OUT_OF_MEMORY, "layout row");
                }
                i = line_end;
                if (i < n && bytes.ptr[i] == '\n') {
                    i++;
                    phys++;
                }
                continue;
            }
        }
        {
            double lead = 0, mark = 0, first_pad = 0, hang = 0;
            int hanging = 0;
            int listed = rtx_layout_list_hang(L, d, m, from, bytes, i, line_end,
                                              sec, &lead, &mark);
            if (listed) {
                first_pad = rtx_layout_list_indent_w(m, sec);
                hang = first_pad + lead + mark;
                hanging = 1;
            } else if (rtx_layout_table_hang(L, d, m, from, bytes, i, line_end,
                                             sec, &lead, &mark)) {
                hang = lead + mark;
                hanging = 1;
            }
        if (!wrap) {
            double h = 0;
            double w = rtx_layout_row_measure(L, d, m, from, bytes, i, line_end,
                                              sec, &h);
            if (!rtx_layout_push_row(L, m, from + i, line_end - i, phys,
                                     w + first_pad, h, first_pad, sec)) {
                return cc_err(CC_ERR_OUT_OF_MEMORY, "layout row");
            }
            i = line_end;
        } else {
            int first_vis = 1;
            if (i == line_end) {
                double h = m->line_height(m->ctx, z, sec);
                if (!rtx_layout_push_row(L, m, from + i, 0, phys, 0, h, 0,
                                         sec)) {
                    return cc_err(CC_ERR_OUT_OF_MEMORY, "layout row");
                }
            }
            while (i < line_end) {
                size_t row_start = i;
                double w = 0;
                double h = 0;
                size_t last_br = i;
                double last_br_w = 0;
                double last_br_h = 0;
                double pad = hanging ? (first_vis ? first_pad : hang) : 0;
                double limit = max_width - pad;
                int overflow = 0;
                if (limit < 1.0) limit = 1.0;
                /* Same style_next edges as row_measure; cluster only inside
                 * a segment so style_at/next run once per edge, not per glyph. */
                while (!overflow && i < line_end) {
                    RtxStyle st;
                    size_t nxt;
                    {
                        RtxHintVis hv;
                        if (rtx_layout_hint_vis(L, d, from + i, bytes.ptr, i,
                                                line_end, &hv)) {
                            if (hv.gn) {
                                RtxStyle hs = d->style_at(from + i);
                                double sw = rtx_layout_standin_w(m, &hv, hs, sec);
                                double sh = m->line_height(m->ctx, hs, sec);
                                if (w > 0 && w + sw > limit) {
                                    overflow = 1;
                                    break;
                                }
                                w += sw;
                                if (sh > h) h = sh;
                            }
                            i += hv.skip;
                            continue;
                        }
                    }
                    st = d->style_at(from + i);
                    nxt = rtx_layout_style_edge(L, d, from, i, line_end);
                    /* Coalesce scope-only edges like row_measure — wrap width
                     * ignores colour, so one cluster walk covers the span. */
                    while (nxt < line_end) {
                        RtxStyle st2 = d->style_at(from + nxt);
                        if (!rtx_layout_size_eq(st2, st)) break;
                        nxt = rtx_layout_style_edge(L, d, from, nxt, line_end);
                    }
                    while (i < nxt) {
                        RtxUtf8Cl cl;
                        size_t step;
                        char[:] one;
                        double gw, gh;
                        {
                            RtxHintVis hv;
                            if (rtx_layout_hint_vis(L, d, from + i, bytes.ptr, i,
                                                    line_end, &hv))
                                break;
                        }
                        cl = rtx_utf8_cluster(bytes, i);
                        step = cl.n ? cl.n : 1;
                        if (i + step > nxt) step = nxt - i;
                        one = bytes.sub(i, i + step);
                        gw = m->measure(m->ctx, one, st, sec);
                        gh = m->line_height(m->ctx, st, sec);
                        if (w > 0 && w + gw > limit) {
                            if (last_br > row_start) {
                                i = last_br;
                                w = last_br_w;
                                h = last_br_h;
                            }
                            overflow = 1;
                            break;
                        }
                        w += gw;
                        if (gh > h) h = gh;
                        i += step;
                        if (step == 1 && rtx_layout_is_break(one.ptr[0])) {
                            last_br = i;
                            last_br_w = w;
                            last_br_h = h;
                        }
                    }
                }
                if (i == row_start) {
                    RtxUtf8Cl cl = rtx_utf8_cluster(bytes, i);
                    size_t step = cl.n ? cl.n : 1;
                    RtxStyle st = d->style_at(from + i);
                    char[:] one = bytes.sub(i, i + step);
                    w = m->measure(m->ctx, one, st, sec);
                    h = m->line_height(m->ctx, st, sec);
                    i += step;
                }
                /* A row of only hidden hints still has a line's height. */
                if (h <= 0) h = m->line_height(m->ctx, z, sec);
                if (!rtx_layout_push_row(L, m, from + row_start, i - row_start,
                                         phys, w + pad, h, pad, sec)) {
                    return cc_err(CC_ERR_OUT_OF_MEMORY, "layout row");
                }
                first_vis = 0;
            }
        }
        }
        if (i < n && bytes.ptr[i] == '\n') {
            i++;
            phys++;
        }
    }
    return cc_ok();
}

void !>(CCError) RtxLayout_range(RtxLayout *L, RtxDocLayout d, const RtxMeasure *m,
                            size_t from, size_t n, double max_width) {
    size_t end;
    char[:] bytes;
    int wrap;
    if (!L || !d || !m || !m->measure || !m->line_height) {
        return cc_err(CC_ERR_INVALID_ARG, "layout range");
    }
    if (!L->ensure()) return cc_err(CC_ERR_OUT_OF_MEMORY, "layout store");
    wrap = L->wrap && max_width > 0;
    /* Fill-epoch gate: every hidden-hint check is one compare when 0. */
    L->has_marks = L->rich && L->view != RTX_VIEW_GRID && L->view != RTX_VIEW_HEX &&
                   d->has_marks();
    {
        size_t dlen = d->len();
        if (from >= dlen) return cc_ok();
        if (n > dlen - from) n = dlen - from;
        end = from + n;
    }
    if (from >= end) return cc_ok();
    n = end - from;
    {
        CCArena frame = cc_arena_heap(n + 64);
        if (!frame.base) return cc_err(CC_ERR_OUT_OF_MEMORY, "layout span");
        bytes = d->scratch_span(from, n, frame) !>(e) {
            frame.destroy();
            return cc_err(e);
        };
        rtx_layout_md_collect(L, d, m, from, bytes, max_width);
        if (L->view == RTX_VIEW_GRID) {
            rtx_layout_grid_walk(L, d, m, from, n, max_width, bytes) !>(e) {
                frame.destroy();
                return cc_err(e);
            };
        } else {
            rtx_layout_range_walk(L, d, m, from, n, max_width, wrap, bytes) !>(e) {
                frame.destroy();
                return cc_err(e);
            };
        }
        frame.destroy();
        return cc_ok();
    }
}

void !>(CCError) RtxLayout_doc(RtxLayout *L, RtxDocLayout d, const RtxMeasure *m, double max_width) {
    if (!L || !L->ensure()) return cc_err(CC_ERR_OUT_OF_MEMORY, "layout store");
    L->reset();
    L->from_line = 0;
    L->nlines = d ? d->line_count() : 0;
    if (!d) return cc_ok();
    return L->range(d, m, 0, d->len(), max_width);
}

void !>(CCError) RtxLayout_lines(RtxLayout *L, RtxDocLayout d, const RtxMeasure *m,
                            double max_width, size_t from_line, size_t nlines) {
    size_t total, from, to;
    @errhandler(CCError e) {
        return cc_err(e);
    }
    @errhandler(RtxIndexErr ie) {
        return cc_err(CC_ERR_IO, ie.message ? ie.message : "line index");
    }
    if (!L || !d || !L->ensure()) return cc_err(CC_ERR_INVALID_ARG, "layout lines");
    total = d->line_count();
    if (from_line >= total) from_line = total ? total - 1 : 0;
    if (from_line + nlines > total) nlines = total - from_line;
    {
        size_t want_line = from_line;
        from = d->line_start(from_line) !>;
        if (L->view == RTX_VIEW_GRID) {
            size_t nls_back = 0;
            from = rtx_layout_grid_cam_lo(d, from, &nls_back) !>;
            if (from_line >= nls_back) from_line -= nls_back;
            else from_line = 0;
        }
        /* Soft line_count is known+1MiB. `to = len` laid out the rest of
         * a 2G file after an edit reported one line. */
        to = d->line_start(want_line + nlines) !>;
    }
    if (to < from) to = from;
    if (to - from > (size_t)RTX_HL_WIN_MAX) to = from + (size_t)RTX_HL_WIN_MAX;
    d->ensure_hl(rtx_hl_span(from, to)) !>;
    L->reset();
    L->from_line = from_line;
    L->nlines = nlines;
    return L->range(d, m, from, to - from, max_width);
}

void !>(CCError) RtxLayout_fill(RtxLayout *L, RtxDocLayout d, const RtxMeasure *m,
                           double max_width, size_t from_line, size_t min_rows) {
    size_t total;
    size_t nphys;
    size_t guard = 0;
    if (!L || !d || !m) return cc_err(CC_ERR_INVALID_ARG, "layout fill");
    total = d->line_count();
    if (min_rows == 0) min_rows = 1;
    nphys = min_rows;
    for (;;) {
        L->lines(d, m, max_width, from_line, nphys) !>(e) { return cc_err(e); };
        if (L->rows.len >= min_rows) return cc_ok();
        if (from_line + nphys >= total) return cc_ok();
        nphys += min_rows - L->rows.len;
        if (++guard > 24) return cc_ok();
    }
}

void !>(CCError) RtxLayout_fill_off(RtxLayout *L, RtxDocLayout d, const RtxMeasure *m,
                               double max_width, size_t from, size_t min_rows) {
    char buf[512];
    size_t len;
    size_t off;
    size_t seen;
    size_t n;
    if (!L || !d || !m) return cc_err(CC_ERR_INVALID_ARG, "layout fill_off");
    if (min_rows == 0) min_rows = 1;
    len = d->len();
    if (from > len) from = len;
    @errhandler(CCError e) { return cc_err(e); }
    if (L->view == RTX_VIEW_GRID) from = rtx_layout_grid_cam_lo(d, from, NULL) !>;
    off = from;
    seen = 0;
    while (off < len && seen < min_rows && (off - from) < (size_t)RTX_FILL_OFF_CAP) {
        size_t take = len - off;
        size_t got, i;
        if (take > sizeof(buf)) take = sizeof(buf);
        if (take > (size_t)RTX_FILL_OFF_CAP - (off - from))
            take = (size_t)RTX_FILL_OFF_CAP - (off - from);
        got = d->read_at(off, buf, take) !>;
        if (!got) break;
        for (i = 0; i < got; i++) {
            if (buf[i] == '\n') {
                seen++;
                if (seen >= min_rows) {
                    off += i + 1;
                    got = 0;
                    break;
                }
            }
        }
        if (got) off += got;
    }
    n = off - from;
    if (n == 0 && from < len) n = 1;
    d->ensure_hl(rtx_hl_win(from, n)) !>(e) { return cc_err(e); };
    L->reset();
    /* Gutter label until seek_label; not a camera origin. */
    L->from_line = d->line_guess(from);
    L->nlines = seen ? seen : 1;
    return L->range(d, m, from, n, max_width);
}

static size_t !>(CCError) rtx_layout_hit_bytes(const RtxLayout *L, const RtxVisRow *r,
                                              RtxDocLayout d, const RtxMeasure *m,
                                              double x, char[:] bytes) {
    size_t k = 0;
    size_t hit = r->byte_start + r->byte_len;
    double cx = 0;
    while (k < bytes.len) {
        RtxUtf8Cl cl;
        size_t step;
        RtxStyle st;
        char[:] one;
        double gw;
        {
            RtxHintVis hv;
            if (rtx_layout_hint_vis(L, d, r->byte_start + k, bytes.ptr, k,
                                    bytes.len, &hv)) {
                if (hv.gn) {
                    double gw = rtx_layout_standin_w(m, &hv,
                                                    d->style_at(r->byte_start + k),
                                                    r->sec);
                    if (x < cx + gw) {
                        hit = r->byte_start + k + hv.skip;
                        break;
                    }
                    cx += gw;
                }
                k += hv.skip;
                continue;
            }
        }
        cl = rtx_utf8_cluster(bytes, k);
        step = cl.n ? cl.n : 1;
        st = d->style_at(r->byte_start + k);
        one = bytes.sub(k, k + step);
        gw = m->measure(m->ctx, one, st, r->sec);
        if (cx + gw / 2.0 >= x) {
            hit = r->byte_start + k;
            break;
        }
        cx += gw;
        k += step;
    }
    return cc_ok(hit);
}

size_t !>(CCError) rtx_layout_grid_hit_row(const RtxLayout *L, const RtxVisRow *r,
                                                 RtxDocLayout d, double x) {
    CCArena frame;
    char[:] bytes;
    size_t hit;
    if (!L || !r || !d) return cc_ok(r ? r->byte_start : 0);
    if (!r->byte_len) return cc_ok(r->byte_start);
    frame = cc_arena_heap(r->byte_len + 64);
    if (!frame.base) return cc_err(CC_ERR_OUT_OF_MEMORY, "layout span");
    bytes = d->scratch_span(r->byte_start, r->byte_len, frame) !>(e) {
        frame.destroy();
        return cc_err(e);
    };
    rtx_grid_bind_span((RtxGridGeom *)&L->grid, r->byte_start, bytes.len);
    hit = r->byte_start + rtx_grid_hit(bytes.ptr, bytes.len, &L->grid,
                                      (int)r->wrap_i, x);
    frame.destroy();
    return cc_ok(hit);
}

static size_t !>(CCError) rtx_layout_hit_row(const RtxLayout *L, const RtxVisRow *r,
                                            RtxDocLayout d, const RtxMeasure *m,
                                            double x, double y_in) {
    CCArena frame;
    char[:] bytes;
    size_t hit;
    if (!r || !d || !m) return cc_ok(0);
    if (!r->byte_len) return cc_ok(r->byte_start);
    frame = cc_arena_heap(r->byte_len + 64);
    if (!frame.base) return cc_err(CC_ERR_OUT_OF_MEMORY, "layout span");
    bytes = d->scratch_span(r->byte_start, r->byte_len, frame) !>(e) {
        frame.destroy();
        return cc_err(e);
    };
    if (rtx_layout_md_index(L, r->byte_start) >= 0) {
        hit = rtx_layout_md_snap(
            L, d, rtx_layout_md_hit_row(L, r, d, m, bytes, x, y_in), 0);
        frame.destroy();
        return cc_ok(hit);
    }
    hit = rtx_layout_hit_bytes(L, r, d, m, x - r->pad, bytes) !>(e) {
        frame.destroy();
        return cc_err(e);
    };
    frame.destroy();
    return cc_ok(hit);
}

static double rtx_layout_x_of_bytes(const RtxLayout *L, const RtxVisRow *r,
                                    RtxDocLayout d, const RtxMeasure *m,
                                    size_t off, char[:] bytes) {
    size_t k = 0;
    double x = 0;
    while (k < bytes.len && r->byte_start + k < off) {
        RtxUtf8Cl cl;
        size_t step;
        {
            RtxHintVis hv;
            if (rtx_layout_hint_vis(L, d, r->byte_start + k, bytes.ptr, k,
                                    bytes.len, &hv)) {
                x += rtx_layout_standin_w(m, &hv, d->style_at(r->byte_start + k),
                                          r->sec);
                k += hv.skip;
                continue;
            }
        }
        cl = rtx_utf8_cluster(bytes, k);
        step = cl.n ? cl.n : 1;
        if (r->byte_start + k + step > off) break;
        {
            RtxStyle st = d->style_at(r->byte_start + k);
            char[:] one = bytes.sub(k, k + step);
            x += m->measure(m->ctx, one, st, r->sec);
        }
        k += step;
    }
    return x;
}

double !>(CCError) RtxLayout_x_of(const RtxLayout *L, RtxDocLayout d, const RtxMeasure *m,
                             size_t off) {
    size_t i;
    const RtxVisRow *r;
    if (!L || !d || !m || L->rows.len == 0) return cc_ok(0);
    i = L->row_of(off);
    r = &L->rows.data[i];
    {
        int ti = rtx_layout_md_index(L, off);
        if (ti < 0) ti = rtx_layout_md_index(L, r->byte_start);
        if (ti >= 0) {
            CCArena frame;
            char[:] bytes;
            double x, unit;
            int cols;
            if (rtx_md_table_role(&L->md_tab[ti], off) == RTX_MD_ROLE_SEP)
                return cc_ok(0);
            if (!r->byte_len) return cc_ok(0);
            frame = cc_arena_heap(r->byte_len + 64);
            if (!frame.base) return cc_err(CC_ERR_OUT_OF_MEMORY, "layout span");
            bytes = d->scratch_span(r->byte_start, r->byte_len, frame) !>(e) {
                frame.destroy();
                return cc_err(e);
            };
            if (L->md_px || rtx_layout_md_unit(m, r->sec) >= 2.0) {
                x = rtx_layout_md_x_px_row(L, d, m, r, bytes, off, ti);
            } else {
                cols = rtx_layout_md_x_cols_row(L, d, r, bytes, off, ti);
                unit = rtx_layout_md_unit(m, r->sec);
                x = cols >= 0 ? (double)cols * unit : 0;
            }
            frame.destroy();
            return cc_ok(x);
        }
    }
    if (L->view == RTX_VIEW_GRID) {
        CCArena frame;
        char[:] bytes;
        double x;
        size_t base, rec_n, rel;
        if (!rtx_layout_grid_rec_in(L, off, &base, &rec_n)) {
            /* Gap (record NL) or leftover: do not use a body row the
             * caret is not inside — that underflowed to the last column. */
            if (off < r->byte_start || off >= r->byte_start + r->byte_len)
                return cc_ok(0);
            base = r->byte_start;
            rec_n = r->byte_len;
        }
        if (!rec_n) return cc_ok(0);
        rel = rtx_layout_grid_rel(off, base, rec_n);
        frame = cc_arena_heap(rec_n + 64);
        if (!frame.base) return cc_err(CC_ERR_OUT_OF_MEMORY, "layout span");
        bytes = d->scratch_span(base, rec_n, frame) !>(e) {
            frame.destroy();
            return cc_err(e);
        };
        rtx_grid_bind_span((RtxGridGeom *)&L->grid, base, bytes.len);
        x = rtx_grid_x_of(bytes.ptr, bytes.len, &L->grid, rel);
        frame.destroy();
        return cc_ok(x);
    }
    if (off <= r->byte_start) return cc_ok(r->pad);
    {
        CCArena frame;
        char[:] bytes;
        double x;
        if (!r->byte_len) return cc_ok(0);
        frame = cc_arena_heap(r->byte_len + 64);
        if (!frame.base) return cc_err(CC_ERR_OUT_OF_MEMORY, "layout span");
        bytes = d->scratch_span(r->byte_start, r->byte_len, frame) !>(e) {
            frame.destroy();
            return cc_err(e);
        };
        x = rtx_layout_x_of_bytes(L, r, d, m, off, bytes) + r->pad;
        frame.destroy();
        return cc_ok(x);
    }
}

size_t !>(CCError) RtxLayout_hit(const RtxLayout *L, RtxDocLayout d, const RtxMeasure *m,
                             double x, double y) {
    size_t i;
    double acc = 0;
    if (!L || !d || !m || L->rows.len == 0) return cc_ok(0);
    for (i = 0; i < L->rows.len; i++) {
        RtxVisRow *r = &L->rows.data[i];
        if (y < acc + r->height || i + 1 == L->rows.len) {
            if (L->view == RTX_VIEW_GRID)
                return rtx_layout_grid_hit_row(L, r, d, x);
            return rtx_layout_hit_row(L, r, d, m, x, y - acc);
        }
        acc += r->height;
    }
    return cc_ok(d->len());
}

size_t RtxLayout_rows_for_line(const RtxLayout *L, size_t phys) {
    size_t i;
    size_t n = 0;
    if (!L) return 0;
    for (i = 0; i < L->rows.len; i++) {
        if (L->rows.data[i].line == phys) n++;
    }
    return n;
}

size_t rtx_layout_grid_row_of(const RtxLayout *L, RtxDocLayout d, size_t off) {
    size_t i, rec;
    int wr = 0;
    if (!L || L->rows.len == 0) return 0;
    rec = (size_t)-1;
    for (i = 0; i < L->rows.len; i++) {
        size_t a = L->rows.data[i].byte_start;
        size_t b = a + L->rows.data[i].byte_len;
        if (off >= a && (off < b || a == b)) {
            rec = i;
            break;
        }
    }
    if (rec == (size_t)-1) {
        if (off >= L->rows.data[L->rows.len - 1].byte_start) return L->rows.len - 1;
        return 0;
    }
    while (rec > 0 && L->rows.data[rec - 1].byte_start == L->rows.data[rec].byte_start)
        rec--;
    if (d) {
        const RtxVisRow *r = &L->rows.data[rec];
        if (r->byte_len) {
            CCArena frame = cc_arena_heap(r->byte_len + 64);
            if (frame.base) {
                char[:] bytes = cc_slice_empty();
                int ok = 1;
                {
                    @errhandler(CCError e) {
                        (void)e;
                        ok = 0;
                    }
                    bytes = d->scratch_span(r->byte_start, r->byte_len, frame) !>;
                }
                if (ok) {
                    rtx_grid_bind_span((RtxGridGeom *)&L->grid, r->byte_start,
                                       bytes.len);
                    wr = rtx_grid_wrap_at(bytes.ptr, bytes.len, &L->grid,
                                          rtx_layout_grid_rel(off, r->byte_start,
                                                              r->byte_len));
                }
                frame.destroy();
            }
        }
    }
    for (i = rec; i < L->rows.len && L->rows.data[i].byte_start == L->rows.data[rec].byte_start;
         i++) {
        if ((int)L->rows.data[i].wrap_i == wr) return i;
    }
    return rec;
}

size_t RtxLayout_row_of(const RtxLayout *L, size_t off) {
    size_t i;
    size_t at_end = (size_t)-1;
    if (!L || L->rows.len == 0) return 0;
    if (L->view == RTX_VIEW_GRID) return rtx_layout_grid_row_of(L, NULL, off);
    for (i = 0; i < L->rows.len; i++) {
        size_t a = L->rows.data[i].byte_start;
        size_t b = a + L->rows.data[i].byte_len;
        if (off >= a && off < b) return i;
        if (off == b) at_end = i;
    }
    if (at_end != (size_t)-1) {
        if (at_end + 1 < L->rows.len && L->rows.data[at_end + 1].byte_start == off) {
            return at_end + 1;
        }
        return at_end;
    }
    if (off >= L->rows.data[L->rows.len - 1].byte_start) return L->rows.len - 1;
    return 0;
}

void RtxLayout_move_row_edge(RtxLayout *L, RtxDoc *d, int to_end, int shift) {
    size_t i;
    size_t a, b;
    if (!L || !d || L->rows.len == 0) return;
    if (L->view == RTX_VIEW_GRID) {
        const RtxVisRow *r;
        i = rtx_layout_grid_row_of(L, d, d->caret);
        r = &L->rows.data[i];
        a = r->byte_start;
        b = a + r->byte_len;
        if (r->byte_len) {
            CCArena frame = cc_arena_heap(r->byte_len + 64);
            char[:] bytes;
            int ok = 1;
            if (!frame.base) {
                if (!shift) d->sel_anchor = to_end ? b : a;
                d->caret = to_end ? b : a;
                d->break_coalesce();
                return;
            }
            {
                @errhandler(CCError e) {
                    (void)e;
                    ok = 0;
                }
                bytes = d->scratch_span(r->byte_start, r->byte_len, frame) !>;
            }
            if (ok) {
                rtx_grid_bind_span(&L->grid, r->byte_start, bytes.len);
                if (to_end)
                    b = r->byte_start +
                        rtx_grid_hit(bytes.ptr, bytes.len, &L->grid,
                                     (int)r->wrap_i,
                                     (double)rtx_grid_geom_width(&L->grid));
                else
                    a = r->byte_start +
                        rtx_grid_hit(bytes.ptr, bytes.len, &L->grid,
                                     (int)r->wrap_i, 0);
            }
            frame.destroy();
        }
        if (!shift) d->sel_anchor = to_end ? b : a;
        d->caret = to_end ? b : a;
        d->break_coalesce();
        return;
    }
    i = L->row_of(d->caret);
    a = L->rows.data[i].byte_start;
    b = a + L->rows.data[i].byte_len;
    if (!shift) d->sel_anchor = to_end ? b : a;
    d->caret = to_end ? b : a;
    d->caret = rtx_layout_md_snap(L, d, d->caret, 0);
    if (!shift) d->sel_anchor = d->caret;
    d->break_coalesce();
}

void !>(CCError) RtxLayout_move_vert(RtxLayout *L, RtxDoc *d, const RtxMeasure *m,
                                double width, int dir, int shift, RtxPref *pref) {
    size_t start;
    size_t row;
    int capture;
    RtxLayout one = {0} @destroy;
    @errhandler(CCError e) {
        return cc_err(e);
    }
    @errhandler(RtxIndexErr ie) {
        return cc_err(CC_ERR_IO, ie.message ? ie.message : "line index");
    }
    if (!L || !d || !m || !pref) return cc_err(CC_ERR_INVALID_ARG, "move vert");
    /* Scratch rows measure like the pane: same Rich bit, reveal, and
     * fill-epoch table geom (one physical line cannot reclassify a table). */
    one.rich = L->rich;
    one.reveal_lo = L->reveal_lo;
    one.reveal_hi = L->reveal_hi;
    rtx_layout_md_copy(&one, L);
    if (!shift) {
        d->sel_anchor = d->caret;
        d->sel_box = 0;
    }
    start = rtx_doc_line_floor(d, d->caret) !>;
    capture = !pref->ok;
    if (capture && L->view != RTX_VIEW_GRID) {
        pref->col = d->caret - start;
        pref->ok = 1;
    }
    if (L->view == RTX_VIEW_GRID) {
        size_t rec_n, dlen, lo, col;
        int wr, h, owned = 0;
        char[:] line = cc_slice_empty();
        CCArena frame = {0};
        dlen = d->len();
        {
            int in_rec = rtx_layout_grid_rec_in(L, d->caret, &lo, &rec_n);
            if (!in_rec) {
                lo = rtx_layout_grid_cam_lo(d, d->caret, NULL) !>;
                rec_n = rtx_layout_grid_rec_len(d, lo) !>;
            }
            start = lo;
            if (rec_n) {
                frame = cc_arena_heap(rec_n + 64);
                if (!frame.base) return cc_err(CC_ERR_OUT_OF_MEMORY, "grid vert");
                owned = 1;
                line = d->scratch_span(start, rec_n, frame) !>(e) {
                    frame.destroy();
                    return cc_err(e);
                };
            }
            rtx_grid_bind_span(&L->grid, start, rec_n);
            {
                size_t rel = rtx_layout_grid_rel(d->caret, start, rec_n);
                if (!in_rec && d->caret >= start + rec_n) rel = 0;
                col = (size_t)rtx_grid_col_at(line.ptr, line.len, &L->grid, rel);
            wr = rtx_grid_wrap_at(line.ptr, line.len, &L->grid, rel);
            if (capture) {
                pref->col = col;
                pref->ok = 1;
                if (!pref->eol) {
                    double x0 = rtx_grid_col_origin(&L->grid, col);
                    pref->x = rtx_grid_x_of(line.ptr, line.len, &L->grid, rel) - x0;
                    if (pref->x < 0) pref->x = 0;
                }
            } else {
                col = pref->col;
            }
            }
        }
        h = rtx_grid_field_height(line.ptr, line.len, &L->grid, col);
        if (dir < 0) {
            if (wr > 0) wr--;
            else if (start == 0) {
                if (owned) frame.destroy();
                if (!shift) d->sel_anchor = d->caret;
                d->break_coalesce();
                return cc_ok();
            } else {
                if (owned) {
                    frame.destroy();
                    owned = 0;
                    line = cc_slice_empty();
                }
                if (!rtx_layout_grid_rec_in(L, start - 1, &start, &rec_n)) {
                    start = rtx_layout_grid_cam_lo(d, start - 1, NULL) !>;
                    rec_n = rtx_layout_grid_rec_len(d, start) !>;
                }
                if (rec_n) {
                    frame = cc_arena_heap(rec_n + 64);
                    if (!frame.base)
                        return cc_err(CC_ERR_OUT_OF_MEMORY, "grid vert");
                    owned = 1;
                    line = d->scratch_span(start, rec_n, frame) !>(e) {
                        frame.destroy();
                        return cc_err(e);
                    };
                }
                rtx_grid_bind_span(&L->grid, start, rec_n);
                wr = rtx_grid_field_height(line.ptr, line.len, &L->grid, col) - 1;
            }
        } else {
            if (wr + 1 < h) wr++;
            else {
                size_t next = rtx_layout_grid_after_rec(d, start, rec_n);
                if (next >= dlen) {
                    if (owned) frame.destroy();
                    if (!shift) d->sel_anchor = d->caret;
                    d->break_coalesce();
                    return cc_ok();
                }
                if (owned) {
                    frame.destroy();
                    owned = 0;
                    line = cc_slice_empty();
                }
                if (!rtx_layout_grid_rec_in(L, next, &start, &rec_n)) {
                    start = rtx_layout_grid_cam_lo(d, next, NULL) !>;
                    rec_n = rtx_layout_grid_rec_len(d, start) !>;
                }
                if (rec_n) {
                    frame = cc_arena_heap(rec_n + 64);
                    if (!frame.base)
                        return cc_err(CC_ERR_OUT_OF_MEMORY, "grid vert");
                    owned = 1;
                    line = d->scratch_span(start, rec_n, frame) !>(e) {
                        frame.destroy();
                        return cc_err(e);
                    };
                }
                rtx_grid_bind_span(&L->grid, start, rec_n);
                wr = 0;
            }
        }
        d->caret = start + rtx_grid_hit_col(line.ptr, line.len, &L->grid, col,
                                            wr, pref->x, pref->eol);
        if (owned) frame.destroy();
        d->caret = d->fold_snap(d->caret, dir);
        if (!shift) d->sel_anchor = d->caret;
        d->break_coalesce();
        return cc_ok();
    }
    if (!L->wrap) {
        size_t ns = start;
        size_t nend, nlen, next;
        int has;
        if (dir < 0) {
            if (start == 0) {
                if (!shift) d->sel_anchor = d->caret;
                d->break_coalesce();
                return cc_ok();
            }
            ns = rtx_doc_line_floor(d, start - 1) !>;
        } else {
            has = rtx_doc_next_line_start(d, start, &next) !>;
            if (!has) {
                if (!shift) d->sel_anchor = d->caret;
                d->break_coalesce();
                return cc_ok();
            }
            ns = next;
        }
        nend = rtx_doc_line_end_caret(d, ns) !>;
        if (L->rich && rtx_layout_md_role_at(L, ns) == RTX_MD_ROLE_SEP) {
            if (dir < 0) {
                if (ns == 0) {
                    if (!shift) d->sel_anchor = d->caret;
                    d->break_coalesce();
                    return cc_ok();
                }
                ns = rtx_doc_line_floor(d, ns - 1) !>;
            } else {
                has = rtx_doc_next_line_start(d, ns, &next) !>;
                if (!has) {
                    if (!shift) d->sel_anchor = d->caret;
                    d->break_coalesce();
                    return cc_ok();
                }
                ns = next;
            }
            nend = rtx_doc_line_end_caret(d, ns) !>;
        }
        nlen = nend - ns;
        if (pref->eol) d->caret = nend;
        else d->caret = ns + (pref->col < nlen ? pref->col : nlen);
        d->caret = d->cluster_align(d->caret) !>(e) { return cc_err(e); };
        if (d->caret < ns) d->caret = ns;
        if (d->caret > nend) d->caret = nend;
        d->caret = d->fold_snap(d->caret, dir);
        d->caret = rtx_layout_md_snap(L, d, d->caret, 0);
        if (!shift) d->sel_anchor = d->caret;
        d->break_coalesce();
        return cc_ok();
    }
    if (L->rich && rtx_layout_md_role_at(L, start) == RTX_MD_ROLE_SEP) {
        int ti = rtx_layout_md_index(L, start);
        if (ti >= 0) start = L->md_tab[ti].lo;
    }
    one.wrap = 1;
    one.fill_off(d, m, width, start, 1) !>;
    if (one.rows.len == 0) return cc_ok();
    row = one.row_of(d->caret);
    if (capture && !pref->eol) {
        double x = one.x_of(d, m, d->caret) !>;
        pref->x = x;
    }
    if (dir < 0) {
        if (row > 0) row--;
        else if (start == 0) {
            if (!shift) d->sel_anchor = d->caret;
            d->break_coalesce();
            return cc_ok();
        } else {
            size_t prev = rtx_doc_line_floor(d, start - 1) !>;
            int guard = 0;
            for (;;) {
                one.reset();
                one.wrap = 1;
                one.fill_off(d, m, width, prev, 1) !>;
                if (one.rows.len > 0 && !rtx_layout_md_row_sep(&one, 0)) break;
                if (prev == 0 || ++guard > 8) break;
                prev = rtx_doc_line_floor(d, prev - 1) !>;
            }
            row = one.rows.len ? one.rows.len - 1 : 0;
        }
    } else {
        if (row + 1 < one.rows.len) row++;
        else {
            size_t next;
            int has = rtx_doc_next_line_start(d, start, &next) !>;
            int guard = 0;
            if (!has) {
                if (!shift) d->sel_anchor = d->caret;
                d->break_coalesce();
                return cc_ok();
            }
            for (;;) {
                one.reset();
                one.wrap = 1;
                one.fill_off(d, m, width, next, 1) !>;
                if (one.rows.len > 0 && !rtx_layout_md_row_sep(&one, 0)) break;
                {
                    size_t nxt2;
                    int has2 = rtx_doc_next_line_start(d, next, &nxt2) !>;
                    if (!has2 || ++guard > 8) break;
                    next = nxt2;
                }
            }
            row = 0;
        }
    }
    if (row >= one.rows.len) row = one.rows.len ? one.rows.len - 1 : 0;
    {
        int guard = 0;
        while (one.rows.len && rtx_layout_md_row_sep(&one, row) &&
               guard++ < 8) {
            if (dir < 0) {
                if (row > 0) {
                    row--;
                    continue;
                }
                break;
            }
            if (row + 1 < one.rows.len) {
                row++;
                continue;
            }
            break;
        }
    }
    if (row >= one.rows.len) row = one.rows.len ? one.rows.len - 1 : 0;
    if (pref->eol) {
        d->caret = one.rows.data[row].byte_start + one.rows.data[row].byte_len;
    } else {
        size_t at = rtx_layout_hit_row(&one, &one.rows.data[row], d, m, pref->x,
                                       0.0) !>;
        d->caret = at;
    }
    d->caret = d->fold_snap(d->caret, dir);
    d->caret = rtx_layout_md_snap(L, d, d->caret, 0);
    if (!shift) d->sel_anchor = d->caret;
    d->break_coalesce();
    return cc_ok();
}

void !>(CCError) RtxLayout_after_edit(RtxLayout *L, RtxDocLayout d, const RtxMeasure *m,
                                 double max_width, size_t off) {
    size_t fl, nl;
    (void)off;
    if (!L || !d || !m) return cc_err(CC_ERR_INVALID_ARG, "layout after edit");
    fl = L->from_line;
    nl = L->nlines;
    if (nl == 0) nl = d->line_count();
    return L->lines(d, m, max_width, fl, nl);
}

void !>(CCError) RtxLayout_view_after_edit(RtxLayout *L, RtxDoc *d, const RtxMeasure *m, double width) {
    size_t fl, nl;
    if (!d || !L || !m) return cc_err(CC_ERR_INVALID_ARG, "view after edit");
    fl = L->from_line;
    nl = L->nlines ? L->nlines : 64;
    d->reparse_edit(d->last_off, d->last_markup) !>(e) {
        return cc_err(e);
    };
    return L->lines(d, m, width, fl, nl);
}

void rtx_layout_reline(RtxLayout *L, size_t from_line) {
    size_t i, old;
    if (!L || L->from_line == from_line) return;
    old = L->from_line;
    L->from_line = from_line;
    for (i = 0; i < L->rows.len; i++) {
        if (L->rows.data[i].line >= old)
            L->rows.data[i].line = from_line + (L->rows.data[i].line - old);
        else
            L->rows.data[i].line = from_line;
    }
}

