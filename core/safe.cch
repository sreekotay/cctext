#!ccc cch
/*
 * On-disk session journals (linked TU: safe.ccs). Not a RAM epoch.
 * File journal: flattened hist (`RTXS`) plus a small state sidecar
 * (`RTXC`, same hash + `.s`) for caret / camera / pins. Workspace:
 * path list + panes. Untitled has no journal. Identity mismatch
 * tosses hist. File leaf is little-endian magic+ver. Unknown / future
 * ver is ignored.
 */
#ifndef RTX_SAFE_H
#define RTX_SAFE_H

#include <stdint.h>
#include <stdio.h>

#ifndef RTX_SAFE_DEBOUNCE_MS
#define RTX_SAFE_DEBOUNCE_MS 250
#endif
/* Bump FILE_VER when the payload layout or a field's meaning changes.
 * Load rejects ver < MIN or ver > FILE_VER (the whole journal).
 *   1: camera + hist
 *   2: + nmark (off,line)*
 *   3: + origin line before marks
 *   4: marks are file-fraction pins (vacant line = SIZE_MAX; density is RTX_LINE_MARK_MAX)
 *   5: + origin byte (mark_off) so load keys that pair, not seek_off */
#define RTX_SAFE_FILE_MAGIC 0x53585452u /* RTXS */
#define RTX_SAFE_FILE_VER 5
#define RTX_SAFE_FILE_VER_MIN 1
#define RTX_SAFE_STATE_MAGIC 0x43585452u /* RTXC */
#define RTX_SAFE_STATE_VER 1
#define RTX_SAFE_WS_MAGIC 0x57585452u /* RTXW */
#define RTX_SAFE_WS_VER 1

typedef struct {
    size_t top, top_wrap, left_col, top_byte, seek_off;
    long seek_rel;
    int seek_valid;
    int view;
    int hex_nib;
    int unlock;
    int pin_view;
    int mark_valid;        /* 1: mark_line is the camera origin (0-based) */
    size_t mark_line;
    size_t mark_off;       /* byte of that origin; v5+ */
} RtxSafeCam;

typedef struct {
    char path[4096];
    int view;
    int dirty;
} RtxSafeWsEnt;

typedef struct {
    int ok;
    int npanes;
    int focus;
    int pane0;
    int pane1;
    size_t n;
    RtxSafeWsEnt *ents; /* caller arena */
} RtxSafeWs;

/* Isolate journals under testdata/generated (smokes). */
void rtx_safe_test_isol(void);
void rtx_safe_set_enabled(int on);
int rtx_safe_enabled(void);
int rtx_safe_dir(char *dst, size_t n);
int rtx_safe_file_path(char *dst, size_t n, const char *doc_path);
int rtx_safe_state_path(char *dst, size_t n, const char *doc_path);
void rtx_safe_cam_clear(RtxSafeCam *c);

/* Best-effort. Untitled / no path is a no-op. Never fails the caller.
 * flush writes hist (+ current state into that leaf). flush_state
 * writes only the sidecar — camera / caret, not hist recs. */
void rtx_safe_flush(RtxDoc *d, const RtxSafeCam *cam);
void rtx_safe_flush_state(RtxDoc *d, const RtxSafeCam *cam);
/* After from_path. Journal miss / corrupt / identity miss: camera only. */
void rtx_safe_load(RtxDoc *d, RtxSafeCam *cam);
void rtx_safe_drop(const char *doc_path);
int rtx_safe_peek_dirty(const char *doc_path);

void rtx_safe_ws_write(const RtxSafeWs *ws);
int rtx_safe_ws_read(RtxSafeWs *ws, CCArena a);
void rtx_safe_ws_drop(void);

#endif /* RTX_SAFE_H */
