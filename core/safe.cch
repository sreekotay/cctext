#!ccc cch
/*
 * On-disk session journals (linked TU: safe.ccs). Not a RAM epoch.
 * File journal: camera + flattened hist. Workspace: path list + panes.
 * Untitled has no journal. Identity mismatch tosses hist.
 */
#ifndef RTX_SAFE_H
#define RTX_SAFE_H

#include <stdint.h>
#include <stdio.h>

#ifndef RTX_SAFE_DEBOUNCE_MS
#define RTX_SAFE_DEBOUNCE_MS 250
#endif

typedef struct {
    size_t top, top_wrap, left_col, top_byte, seek_off;
    long seek_rel;
    int seek_valid;
    int view;
    int hex_nib;
    int unlock;
    int pin_view;
} RtxSafeCam;

typedef struct {
    char path[4096];
    int view;
    int dirty;
} RtxSafeWsEnt;

typedef struct {
    int ok;
    int npanes;
    int focus;
    int pane0;
    int pane1;
    size_t n;
    RtxSafeWsEnt *ents; /* caller arena */
} RtxSafeWs;

/* Isolate journals under testdata/generated (smokes). */
void rtx_safe_test_isol(void);
int rtx_safe_dir(char *dst, size_t n);
int rtx_safe_file_path(char *dst, size_t n, const char *doc_path);
void rtx_safe_cam_clear(RtxSafeCam *c);

/* Best-effort. Untitled / no path is a no-op. Never fails the caller. */
void rtx_safe_flush(RtxDoc *d, const RtxSafeCam *cam);
/* After from_path. Journal miss / corrupt / identity miss: camera only. */
void rtx_safe_load(RtxDoc *d, RtxSafeCam *cam);
void rtx_safe_drop(const char *doc_path);
int rtx_safe_peek_dirty(const char *doc_path);

void rtx_safe_ws_write(const RtxSafeWs *ws);
int rtx_safe_ws_read(RtxSafeWs *ws, CCArena *a);
void rtx_safe_ws_drop(void);

#endif /* RTX_SAFE_H */
