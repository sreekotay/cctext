#ifndef RTX_SCOPE_H
#define RTX_SCOPE_H

#include <stdint.h>
#include <stdlib.h>
#include <string.h>

typedef uint32_t RtxScope;
#define RTX_SCOPE_NONE ((RtxScope)0)

typedef struct {
    unsigned char r, g, b;
    const char *ansi;
} RtxThemeColor;

#define RTX_SCOPE_MAX 256

static char *rtx_scope_tab[RTX_SCOPE_MAX];
static size_t rtx_scope_n;

static RtxScope rtx_scope_intern_n(const char *name, size_t n) {
    size_t i;
    char *copy;
    if (!name || n == 0) return RTX_SCOPE_NONE;
    for (i = 1; i <= rtx_scope_n; i++) {
        if (rtx_scope_tab[i] && strlen(rtx_scope_tab[i]) == n &&
            memcmp(rtx_scope_tab[i], name, n) == 0) {
            return (RtxScope)i;
        }
    }
    if (rtx_scope_n + 1 >= RTX_SCOPE_MAX) return RTX_SCOPE_NONE;
    copy = (char *)malloc(n + 1);
    if (!copy) return RTX_SCOPE_NONE;
    memcpy(copy, name, n);
    copy[n] = 0;
    rtx_scope_n++;
    rtx_scope_tab[rtx_scope_n] = copy;
    return (RtxScope)rtx_scope_n;
}

static RtxScope rtx_scope_intern(const char *name) {
    if (!name || !name[0]) return RTX_SCOPE_NONE;
    return rtx_scope_intern_n(name, strlen(name));
}

static const char *rtx_scope_name(RtxScope id) {
    if (id == RTX_SCOPE_NONE || id > rtx_scope_n) return "";
    return rtx_scope_tab[id] ? rtx_scope_tab[id] : "";
}

static int rtx_scope_has_prefix(RtxScope id, const char *prefix) {
    const char *s = rtx_scope_name(id);
    size_t n;
    if (!prefix || !prefix[0] || !s[0]) return 0;
    n = strlen(prefix);
    if (strncmp(s, prefix, n) != 0) return 0;
    return s[n] == 0 || s[n] == '.';
}

static RtxHlKind rtx_scope_kind(RtxScope id) {
    if (id == RTX_SCOPE_NONE) return RTX_HL_NONE;
    if (rtx_scope_has_prefix(id, "comment") ||
        rtx_scope_has_prefix(id, "markup.quote")) {
        return RTX_HL_COMMENT;
    }
    if (rtx_scope_has_prefix(id, "string") ||
        rtx_scope_has_prefix(id, "markup.raw")) {
        return RTX_HL_STRING;
    }
    if (rtx_scope_has_prefix(id, "constant.numeric") ||
        rtx_scope_has_prefix(id, "constant")) {
        return RTX_HL_NUMBER;
    }
    if (rtx_scope_has_prefix(id, "keyword") ||
        rtx_scope_has_prefix(id, "storage") ||
        rtx_scope_has_prefix(id, "variable") ||
        rtx_scope_has_prefix(id, "entity.name") ||
        rtx_scope_has_prefix(id, "markup.heading") ||
        rtx_scope_has_prefix(id, "markup.bold") ||
        rtx_scope_has_prefix(id, "markup.italic") ||
        rtx_scope_has_prefix(id, "markup.underline")) {
        return RTX_HL_KEYWORD;
    }
    if (rtx_scope_has_prefix(id, "punctuation")) return RTX_HL_PUNCT;
    return RTX_HL_NONE;
}

static RtxThemeColor rtx_theme_color(RtxScope id) {
    RtxThemeColor z = {230, 230, 230, "\x1b[0m"};
    switch (rtx_scope_kind(id)) {
    case RTX_HL_KEYWORD:
        z.r = 80; z.g = 200; z.b = 220; z.ansi = "\x1b[36m";
        break;
    case RTX_HL_STRING:
        z.r = 120; z.g = 200; z.b = 120; z.ansi = "\x1b[32m";
        break;
    case RTX_HL_COMMENT:
        z.r = 140; z.g = 140; z.b = 140; z.ansi = "\x1b[90m";
        break;
    case RTX_HL_NUMBER:
        z.r = 220; z.g = 180; z.b = 80; z.ansi = "\x1b[33m";
        break;
    default:
        break;
    }
    return z;
}

#endif /* RTX_SCOPE_H */
