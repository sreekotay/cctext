/*
 * TextMate scope intern + theme kind. Bodies in scope.ccs (linked TU).
 * One table for every host that includes the document — paint and lex
 * must share IDs (GUI draw is its own TU).
 */
#ifndef RTX_SCOPE_H
#define RTX_SCOPE_H

#include <stdint.h>

typedef uint32_t RtxScope;
#define RTX_SCOPE_NONE ((RtxScope)0)

#ifndef RTX_THEME_COLOR_TYPE
#define RTX_THEME_COLOR_TYPE
typedef struct {
    unsigned char r, g, b;
    const char *ansi;
} RtxThemeColor;
#endif

#define RTX_SCOPE_MAX 256
#define RTX_SCOPE_STORE (64 * 1024)

typedef enum {
    RTX_HL_NONE = 0,
    RTX_HL_KEYWORD,
    RTX_HL_STRING,
    RTX_HL_COMMENT,
    RTX_HL_NUMBER,
    RTX_HL_PUNCT
} RtxHlKind;

int rtx_scope_put(RtxScope *out, const char *name);
const char *rtx_scope_name(RtxScope id);
RtxHlKind rtx_scope_kind(RtxScope id);
int rtx_scope_is_invalid(RtxScope id);
int rtx_scope_is_heading(RtxScope id);
int rtx_scope_is_mark(RtxScope id);

/* Default scope → style bits for grammars with no `cctext` sidecar
 * (markup.bold → bold, markup.italic → italic, markup.raw → mono,
 * markup.heading → bold). Consulted once per rule at bind, never per glyph. */
#define RTX_SBIT_BOLD 1u
#define RTX_SBIT_ITALIC 2u
#define RTX_SBIT_MONO 4u
unsigned char rtx_scope_default_bits(RtxScope id);
RtxThemeColor rtx_theme_color(RtxScope id);
RtxThemeColor rtx_theme_pair(void);

#endif
