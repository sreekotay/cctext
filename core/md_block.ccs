#!ccc ccs
/*
 * Markdown block pass (linked TU; see md_block.cch). CommonMark 0.31
 * block structure, GFM tables, plus front matter and `$$` math — one
 * line at a time, state between lines, no lookahead: a line's class
 * depends on the bytes before it and itself, so a checkpoint's state is
 * the whole story (a setext underline restyles its paragraph behind it;
 * that is why a paragraph state is never a relex seed).
 */
#include <ccc/std/prelude.cch>
#include <string.h>
#include "md_block.cch"
#include "md_table.cch"

/* Column walker over one line: tabs stop every 4 columns; a tab a
 * container only partly consumes leaves virtual spaces (`vsp`). */
typedef struct {
    const char *b;
    size_t i;     /* current byte */
    size_t e;     /* line end (no NL, no CR) */
    unsigned col; /* column of b[i] */
    unsigned vsp; /* virtual spaces before b[i] */
} MdbCur;

static int mdb_ws(char c) {
    return c == ' ' || c == '\t';
}

/* Columns of whitespace ahead of the cursor; *nw = first non-space byte,
 * *nwcol its column. */
static unsigned mdb_indent(const MdbCur *c, size_t *nw, unsigned *nwcol) {
    unsigned w = c->vsp, col = c->col;
    size_t i = c->i;
    while (i < c->e) {
        if (c->b[i] == ' ') {
            w++;
            col++;
        } else if (c->b[i] == '\t') {
            unsigned t = 4u - (col % 4u);
            w += t;
            col += t;
        } else {
            break;
        }
        i++;
    }
    if (nw) *nw = i;
    if (nwcol) *nwcol = col;
    return w;
}

/* Consume `k` columns of whitespace (fewer if the run is shorter). */
static void mdb_skip(MdbCur *c, unsigned k) {
    while (k > 0) {
        if (c->vsp) {
            unsigned t = c->vsp < k ? c->vsp : k;
            c->vsp -= t;
            k -= t;
            continue;
        }
        if (c->i >= c->e) break;
        if (c->b[c->i] == ' ') {
            c->i++;
            c->col++;
            k--;
        } else if (c->b[c->i] == '\t') {
            unsigned t = 4u - (c->col % 4u);
            c->i++;
            c->col += t;
            if (t > k) {
                c->vsp = t - k;
                k = 0;
            } else {
                k -= t;
            }
        } else {
            break;
        }
    }
}

static void mdb_skip_ws(MdbCur *c) {
    c->vsp = 0;
    while (c->i < c->e && mdb_ws(c->b[c->i])) {
        if (c->b[c->i] == '\t') c->col += 4u - (c->col % 4u);
        else c->col++;
        c->i++;
    }
}

/* Past one plain byte (a marker). */
static void mdb_step(MdbCur *c, size_t n) {
    c->vsp = 0;
    while (n-- && c->i < c->e) {
        c->i++;
        c->col++;
    }
}

static int mdb_blank(const char *b, size_t i, size_t e) {
    while (i < e && mdb_ws(b[i])) i++;
    return i >= e;
}

static void mdb_span(RtxMdbLine *o, size_t lo, size_t hi, int kind, int aux) {
    if (!o || o->nsp >= RTX_MDB_SPANS || hi < lo) return;
    o->sp[o->nsp].lo = lo;
    o->sp[o->nsp].hi = hi;
    o->sp[o->nsp].kind = (unsigned char)kind;
    o->sp[o->nsp].aux = (unsigned char)aux;
    o->nsp++;
}

static int mdb_lower(int c) {
    return (c >= 'A' && c <= 'Z') ? c - 'A' + 'a' : c;
}

/* s[0, n) starts with lit, ASCII case folded. */
static int mdb_ci(const char *s, size_t n, const char *lit) {
    size_t i;
    for (i = 0; lit[i]; i++) {
        if (i >= n || mdb_lower((unsigned char)s[i]) != lit[i]) return 0;
    }
    return 1;
}

/* First occurrence of lit (case folded) in s[0, n), else -1. */
static long mdb_find_ci(const char *s, size_t n, const char *lit) {
    size_t i, k = strlen(lit);
    if (k == 0 || n < k) return -1;
    for (i = 0; i + k <= n; i++) {
        if (mdb_ci(s + i, n - i, lit)) return (long)i;
    }
    return -1;
}

static int mdb_alpha(char c) {
    return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z');
}

static int mdb_alnum(char c) {
    return mdb_alpha(c) || (c >= '0' && c <= '9');
}

/* ---- leaf recognizers (s[i..e) is the line past indentation) ---- */

/* ATX: 1-6 `#`, then a space / tab or the end. `#hashtag` is text. */
static int mdb_atx(const char *b, size_t i, size_t e, size_t *open_hi,
                   size_t *c_lo, size_t *c_hi, size_t *close_lo,
                   size_t *close_hi) {
    size_t k = i, t, h;
    int lvl;
    while (k < e && b[k] == '#') k++;
    lvl = (int)(k - i);
    if (lvl < 1 || lvl > 6) return 0;
    if (k < e && !mdb_ws(b[k])) return 0;
    t = k;
    while (t < e && mdb_ws(b[t])) t++;
    *open_hi = t;
    *c_lo = t;
    *close_lo = *close_hi = 0;
    /* Closing sequence: trailing `#`s after a space (or the whole title). */
    h = e;
    while (h > t && mdb_ws(b[h - 1])) h--;
    {
        size_t q = h;
        while (q > t && b[q - 1] == '#') q--;
        if (q < h && (q == t || mdb_ws(b[q - 1]))) {
            *close_lo = q;
            *close_hi = h;
            h = q;
            while (h > t && mdb_ws(b[h - 1])) h--;
        }
    }
    *c_hi = h;
    return lvl;
}

/* Fence line at i: run of >= 3 '`' or '~'. Info is the rest, trimmed; a
 * backtick fence's info may not hold a backtick. */
static int mdb_fence_at(const char *b, size_t i, size_t e, char *ch, size_t *run,
                        size_t *ilo, size_t *ihi) {
    size_t k = i, a, z;
    char c;
    if (i >= e) return 0;
    c = b[i];
    if (c != '`' && c != '~') return 0;
    while (k < e && b[k] == c) k++;
    if (k - i < 3) return 0;
    a = k;
    while (a < e && mdb_ws(b[a])) a++;
    z = e;
    while (z > a && mdb_ws(b[z - 1])) z--;
    if (c == '`' && a < z && memchr(b + a, '`', z - a)) return 0;
    *ch = c;
    *run = k - i;
    *ilo = a;
    *ihi = z;
    return 1;
}

int rtx_mdb_fence_line(const char *s, size_t n, int *info) {
    size_t i = 0, run, ilo, ihi;
    char ch;
    if (!s) return 0;
    if (n && s[n - 1] == '\r') n--;
    while (i < n && i < 4 && s[i] == ' ') i++;
    if (i > 3) return 0;
    if (!mdb_fence_at(s, i, n, &ch, &run, &ilo, &ihi)) return 0;
    if (info) *info = ihi > ilo;
    return 1;
}

/* Thematic break: >= 3 of one of `*-_`, spaces / tabs between, nothing else. */
static int mdb_hr(const char *b, size_t i, size_t e) {
    char c;
    int k = 0;
    if (i >= e) return 0;
    c = b[i];
    if (c != '*' && c != '-' && c != '_') return 0;
    for (; i < e; i++) {
        if (b[i] == c) k++;
        else if (!mdb_ws(b[i])) return 0;
    }
    return k >= 3;
}

/* Setext underline: `=+` or `-+`, trailing whitespace only. */
static int mdb_setext(const char *b, size_t i, size_t e, size_t *hi) {
    size_t k = i;
    char c;
    if (i >= e) return 0;
    c = b[i];
    if (c != '=' && c != '-') return 0;
    while (k < e && b[k] == c) k++;
    *hi = k;
    while (k < e && mdb_ws(b[k])) k++;
    if (k != e) return 0;
    return c == '=' ? 1 : 2;
}

/* List marker at i: bullet `-+*` or 1-9 digits + `.` / `)`, then a space,
 * a tab or the end. *mlen marker bytes, *start the ordinal (bullet: -1). */
static int mdb_marker(const char *b, size_t i, size_t e, size_t *mlen, long *start) {
    size_t k = i;
    if (i >= e) return 0;
    if (b[i] == '-' || b[i] == '+' || b[i] == '*') {
        if (i + 1 < e && !mdb_ws(b[i + 1])) return 0;
        *mlen = 1;
        *start = -1;
        return 1;
    }
    {
        long v = 0;
        while (k < e && k - i < 10 && b[k] >= '0' && b[k] <= '9') {
            v = v * 10 + (b[k] - '0');
            k++;
        }
        if (k == i || k - i > 9 || k >= e) return 0;
        if (b[k] != '.' && b[k] != ')') return 0;
        if (k + 1 < e && !mdb_ws(b[k + 1])) return 0;
        *mlen = k + 1 - i;
        *start = v;
        return 1;
    }
}

static const char *const mdb_block_tags[] = {
    "address", "article", "aside", "base", "basefont", "blockquote", "body",
    "caption", "center", "col", "colgroup", "dd", "details", "dialog", "dir",
    "div", "dl", "dt", "fieldset", "figcaption", "figure", "footer", "form",
    "frame", "frameset", "h1", "h2", "h3", "h4", "h5", "h6", "head", "header",
    "hr", "html", "iframe", "legend", "li", "link", "main", "menu", "menuitem",
    "nav", "noframes", "ol", "optgroup", "option", "p", "param", "search",
    "section", "summary", "table", "tbody", "td", "tfoot", "th", "thead",
    "title", "tr", "track", "ul", NULL,
};

static int mdb_tag_is(const char *s, size_t n, const char *name) {
    size_t k = strlen(name), i;
    if (n != k) return 0;
    for (i = 0; i < k; i++) {
        if (mdb_lower((unsigned char)s[i]) != name[i]) return 0;
    }
    return 1;
}

/* Complete open / closing tag, then only whitespace (HTML kind 7). */
static int mdb_complete_tag(const char *s, size_t n) {
    size_t i = 1, nm;
    int close = 0;
    if (n < 3 || s[0] != '<') return 0;
    if (s[i] == '/') {
        close = 1;
        i++;
    }
    if (i >= n || !mdb_alpha(s[i])) return 0;
    nm = i;
    while (i < n && (mdb_alnum(s[i]) || s[i] == '-')) i++;
    if (mdb_tag_is(s + nm, i - nm, "script") || mdb_tag_is(s + nm, i - nm, "style") ||
        mdb_tag_is(s + nm, i - nm, "pre") || mdb_tag_is(s + nm, i - nm, "textarea"))
        return 0;
    if (close) {
        while (i < n && mdb_ws(s[i])) i++;
        if (i >= n || s[i] != '>') return 0;
        i++;
    } else {
        for (;;) {
            size_t ws = i;
            while (i < n && mdb_ws(s[i])) i++;
            if (i >= n) return 0;
            if (s[i] == '>') {
                i++;
                break;
            }
            if (s[i] == '/' && i + 1 < n && s[i + 1] == '>') {
                i += 2;
                break;
            }
            if (i == ws) return 0; /* attributes need a space before them */
            if (!(mdb_alpha(s[i]) || s[i] == '_' || s[i] == ':')) return 0;
            while (i < n && (mdb_alnum(s[i]) || s[i] == '_' || s[i] == '.' ||
                             s[i] == ':' || s[i] == '-'))
                i++;
            {
                size_t j = i;
                while (j < n && mdb_ws(s[j])) j++;
                if (j < n && s[j] == '=') {
                    j++;
                    while (j < n && mdb_ws(s[j])) j++;
                    if (j >= n) return 0;
                    if (s[j] == '"' || s[j] == '\'') {
                        char q = s[j++];
                        while (j < n && s[j] != q) j++;
                        if (j >= n) return 0;
                        j++;
                    } else {
                        size_t v = j;
                        while (j < n && !mdb_ws(s[j]) && s[j] != '"' && s[j] != '\'' &&
                               s[j] != '=' && s[j] != '<' && s[j] != '>' && s[j] != '`')
                            j++;
                        if (j == v) return 0;
                    }
                    i = j;
                }
            }
        }
    }
    while (i < n && mdb_ws(s[i])) i++;
    return i == n;
}

int rtx_mdb_html_start(const char *s, size_t n, int para) {
    size_t i, nm;
    if (!s || n < 2 || s[0] != '<') return 0;
    {
        static const char *const k1[] = {"script", "pre", "style", "textarea", NULL};
        int t;
        for (t = 0; k1[t]; t++) {
            size_t k = strlen(k1[t]);
            if (mdb_ci(s + 1, n - 1, k1[t]) &&
                (1 + k == n || mdb_ws(s[1 + k]) || s[1 + k] == '>'))
                return 1;
        }
    }
    if (n >= 4 && s[1] == '!' && s[2] == '-' && s[3] == '-') return 2;
    if (s[1] == '?') return 3;
    if (n >= 9 && memcmp(s, "<![CDATA[", 9) == 0) return 5;
    if (s[1] == '!' && n >= 3 && mdb_alpha(s[2])) return 4;
    i = 1;
    if (s[i] == '/') i++;
    nm = i;
    while (i < n && mdb_alnum(s[i])) i++;
    if (i > nm && (i == n || mdb_ws(s[i]) || s[i] == '>' ||
                   (s[i] == '/' && i + 1 < n && s[i + 1] == '>'))) {
        int t;
        for (t = 0; mdb_block_tags[t]; t++) {
            if (mdb_tag_is(s + nm, i - nm, mdb_block_tags[t])) return 6;
        }
    }
    if (!para && mdb_complete_tag(s, n)) return 7;
    return 0;
}

/* HTML kinds 1-5 end on a line holding their end marker. */
static int mdb_html_ends(int kind, const char *s, size_t n) {
    switch (kind) {
    case 1:
        return mdb_find_ci(s, n, "</script>") >= 0 || mdb_find_ci(s, n, "</pre>") >= 0 ||
               mdb_find_ci(s, n, "</style>") >= 0 || mdb_find_ci(s, n, "</textarea>") >= 0;
    case 2:
        return mdb_find_ci(s, n, "-->") >= 0;
    case 3:
        return mdb_find_ci(s, n, "?>") >= 0;
    case 4:
        return memchr(s, '>', n) != NULL;
    case 5:
        return mdb_find_ci(s, n, "]]>") >= 0;
    default:
        return 0;
    }
}

/* Link reference definition on one line: `[label]: dest "title"`. */
static int mdb_refdef(const char *b, size_t i, size_t e, RtxMdbLine *o) {
    size_t j, close, k, dlo, dhi, tlo = 0, thi = 0;
    int nonws = 0;
    if (i >= e || b[i] != '[' || i + 1 >= e || b[i + 1] == '^') return 0;
    j = i + 1;
    while (j < e) {
        if (b[j] == '\\' && j + 1 < e) {
            j += 2;
            nonws = 1;
            continue;
        }
        if (b[j] == ']') break;
        if (b[j] == '[') return 0;
        if (!mdb_ws(b[j])) nonws = 1;
        j++;
    }
    if (j >= e || !nonws || j - i > 1000) return 0;
    close = j;
    if (close + 1 >= e || b[close + 1] != ':') return 0;
    k = close + 2;
    while (k < e && mdb_ws(b[k])) k++;
    if (k >= e) return 0;
    dlo = k;
    if (b[k] == '<') {
        k++;
        while (k < e && b[k] != '>' && b[k] != '<') k++;
        if (k >= e || b[k] != '>') return 0;
        k++;
    } else {
        int depth = 0;
        while (k < e && !mdb_ws(b[k])) {
            if (b[k] == '(') depth++;
            else if (b[k] == ')' && --depth < 0) return 0;
            k++;
        }
    }
    dhi = k;
    if (dhi == dlo) return 0;
    if (k < e) {
        size_t ws = k;
        char q;
        while (k < e && mdb_ws(b[k])) k++;
        if (k < e) {
            if (k == ws) return 0;
            q = b[k];
            if (q != '"' && q != '\'' && q != '(') return 0;
            if (q == '(') q = ')';
            tlo = k;
            k++;
            while (k < e && b[k] != q) {
                if (b[k] == '\\' && k + 1 < e) k++;
                k++;
            }
            if (k >= e) return 0;
            k++;
            thi = k;
            while (k < e && mdb_ws(b[k])) k++;
            if (k != e) return 0;
        }
    }
    mdb_span(o, i, close + 2, RTX_MDB_S_REF_LABEL, 0);
    mdb_span(o, dlo, dhi, RTX_MDB_S_REF_DEST, 0);
    if (thi > tlo) mdb_span(o, tlo, thi, RTX_MDB_S_REF_TITLE, 0);
    return 1;
}

/* Footnote definition label `[^x]:` → *hi past the colon. */
static int mdb_footdef(const char *b, size_t i, size_t e, size_t *hi) {
    size_t j;
    if (i + 3 >= e || b[i] != '[' || b[i + 1] != '^') return 0;
    j = i + 2;
    while (j < e && b[j] != ']' && !mdb_ws(b[j]) && b[j] != '[') j++;
    if (j >= e || b[j] != ']' || j == i + 2) return 0;
    if (j + 1 >= e || b[j + 1] != ':') return 0;
    *hi = j + 2;
    return 1;
}

static unsigned char mdb_cells(const char *b, size_t i, size_t e) {
    size_t n;
    if (!rtx_md_line_pipe(b + i, e - i)) return 0;
    n = rtx_md_line_cells(b + i, e - i);
    return (unsigned char)(n > 255 ? 255 : n);
}

/* ---- state ---- */

void rtx_mdb_init(RtxMdb *st, int bof, int soft, int unsure) {
    if (!st) return;
    memset(st, 0, sizeof *st);
    if (bof) st->flags |= (unsigned char)RTX_MDB_BOF;
    if (soft && !bof) st->flags |= (unsigned char)RTX_MDB_SOFT;
    if (unsure && !bof) st->flags |= (unsigned char)RTX_MDB_UNSURE;
}

void rtx_mdb_set_marp(RtxMdb *st, int on) {
    if (!st) return;
    if (on) st->flags |= (unsigned char)RTX_MDB_MARP;
    else st->flags &= (unsigned char)~RTX_MDB_MARP;
}

int rtx_mdb_marp_front(const char *s, size_t n) {
    size_t i = 0;
    int first = 1;
    if (!s || n < 4 || memcmp(s, "---", 3) != 0) return 0;
    while (i < n) {
        const char *nl = (const char *)memchr(s + i, '\n', n - i);
        size_t e = nl ? (size_t)(nl - s) : n, z = e, k;
        if (!nl) return 0; /* the probe ended inside the front matter */
        while (z > i && (mdb_ws(s[z - 1]) || s[z - 1] == '\r')) z--;
        if (first) {
            if (z - i != 3) return 0;
            first = 0;
        } else if (z - i == 3 && (memcmp(s + i, "---", 3) == 0 ||
                                  memcmp(s + i, "...", 3) == 0)) {
            return 0;
        } else if (z - i >= 5 && memcmp(s + i, "marp", 4) == 0) {
            k = i + 4;
            while (k < z && mdb_ws(s[k])) k++;
            if (k < z && s[k] == ':') {
                k++;
                while (k < z && mdb_ws(s[k])) k++;
                if (z - k >= 4 && mdb_ci(s + k, z - k, "true")) {
                    size_t t = k + 4;
                    while (t < z && mdb_ws(s[t])) t++;
                    if (t == z || s[t] == '#') return 1;
                }
            }
        }
        i = e + 1;
    }
    return 0;
}

int rtx_mdb_eq(const RtxMdb *a, const RtxMdb *b) {
    int k;
    if (a->n != b->n || a->leaf != b->leaf || a->flags != b->flags) return 0;
    for (k = 0; k < a->n; k++) {
        if (a->kind[k] != b->kind[k] || a->ind[k] != b->ind[k]) return 0;
    }
    if (a->leaf != RTX_MDB_LEAF_NONE && a->ldep != b->ldep) return 0;
    switch (a->leaf) {
    case RTX_MDB_LEAF_FENCE:
        return a->fch == b->fch && a->flen == b->flen && a->find == b->find;
    case RTX_MDB_LEAF_HTML:
        return a->html == b->html;
    case RTX_MDB_LEAF_MATH:
    case RTX_MDB_LEAF_FRONT:
        return a->fch == b->fch;
    case RTX_MDB_LEAF_TABLE:
        return a->tcols == b->tcols;
    case RTX_MDB_LEAF_PARA:
        return a->pcells == b->pcells && a->poff == b->poff &&
               a->plines == b->plines && a->pback == b->pback && a->plen == b->plen;
    default:
        return 1;
    }
}

int rtx_mdb_seedable(const RtxMdb *st) {
    return st && st->leaf != RTX_MDB_LEAF_PARA;
}

static void mdb_leaf(RtxMdb *st, int leaf) {
    st->leaf = (unsigned char)leaf;
    st->ldep = st->n;
}

/* The open leaf ends (a new block starts in its container). */
static void mdb_leaf_end(RtxMdb *st, RtxMdbLine *o) {
    if (st->leaf == RTX_MDB_LEAF_PARA) o->drop = 1;
    else if (st->leaf == RTX_MDB_LEAF_FENCE || st->leaf == RTX_MDB_LEAF_HTML ||
             st->leaf == RTX_MDB_LEAF_MATH)
        o->close0 = st->leaf;
    st->leaf = RTX_MDB_LEAF_NONE;
}

/* Containers m.. did not match and nothing continues them lazily. */
static void mdb_close_from(RtxMdb *st, int m, RtxMdbLine *o) {
    if (m >= st->n) return;
    if (st->leaf != RTX_MDB_LEAF_NONE && st->ldep > m) mdb_leaf_end(st, o);
    st->n = (unsigned char)m;
}

static void mdb_quote_marker(MdbCur *c, size_t nw, RtxMdbLine *o) {
    size_t lo;
    mdb_skip_ws(c);
    lo = c->i;
    (void)nw;
    mdb_step(c, 1); /* '>' */
    if (c->i < c->e && c->b[c->i] == ' ') {
        c->i++;
        c->col++;
    } else if (c->i < c->e && c->b[c->i] == '\t') {
        unsigned t = 4u - (c->col % 4u);
        c->i++;
        c->col += t;
        c->vsp = t - 1;
    }
    if (o->nsp && o->sp[o->nsp - 1].kind == RTX_MDB_S_QUOTE &&
        mdb_blank(c->b, o->sp[o->nsp - 1].hi, lo)) {
        o->sp[o->nsp - 1].hi = c->i;
        return;
    }
    mdb_span(o, lo, c->i, RTX_MDB_S_QUOTE, 0);
}

/* Would the rest of the line (past containers, not a new container) start
 * a block? Then it is not a lazy paragraph continuation. */
static int mdb_block_start(const char *b, size_t nw, size_t e, unsigned ind,
                           const RtxMdb *st) {
    size_t x0, x1, x2, x3;
    char ch;
    size_t run, ilo, ihi;
    if (ind >= 4 || nw >= e) return 0;
    if (mdb_atx(b, nw, e, &x0, &x1, &x2, &x3, &run)) return 1;
    if (mdb_fence_at(b, nw, e, &ch, &run, &ilo, &ihi) &&
        (!(st->flags & RTX_MDB_UNSURE) || ihi > ilo))
        return 1;
    if (mdb_hr(b, nw, e)) return 1;
    if (b[nw] == '<') {
        int k = rtx_mdb_html_start(b + nw, e - nw, 1);
        if (k >= 1 && k <= 6) return 1;
    }
    return 0;
}

static void mdb_para_line(RtxMdb *st, RtxMdbLine *o, const char *b, size_t lo,
                          size_t nw, size_t e) {
    if (st->leaf != RTX_MDB_LEAF_PARA) {
        mdb_leaf(st, RTX_MDB_LEAF_PARA);
        st->plines = 0;
        st->pback = 0;
        st->poff = (unsigned short)(nw - lo > 0xffff ? 0xffff : nw - lo);
    }
    st->plines++;
    st->pcells = mdb_cells(b, nw, e);
    o->para = 1;
    o->mode = RTX_MDB_M_INLINE;
    o->c_lo = nw;
    o->c_hi = e;
}

void rtx_mdb_line(RtxMdb *st, const char *b, size_t lo, size_t eol, RtxMdbLine *o) {
    MdbCur c;
    size_t e = eol, nw = lo, x;
    unsigned ind, nwcol;
    int m, k, all, bof, para_open, prev_blank;
    if (!st || !b || !o) return;
    memset(o, 0, sizeof *o);
    if (e > lo && b[e - 1] == '\r') e--;
    c.b = b;
    c.i = lo;
    c.e = e;
    c.col = 0;
    c.vsp = 0;
    o->c_lo = o->c_hi = lo;
    if (st->leaf == RTX_MDB_LEAF_PARA) st->pback += st->plen;
    st->plen = (uint32_t)(eol + 1 - lo);
    bof = (st->flags & RTX_MDB_BOF) != 0;
    prev_blank = (st->flags & RTX_MDB_BLANK) != 0;
    st->flags &= (unsigned char)~(RTX_MDB_BOF | RTX_MDB_BLANK);

    /* Front matter: `---` (YAML) / `+++` (TOML) on the first line. */
    if (st->leaf == RTX_MDB_LEAF_FRONT) {
        size_t z = e;
        while (z > lo && mdb_ws(b[z - 1])) z--;
        if (z - lo == 3 &&
            ((st->fch == '-' && (memcmp(b + lo, "---", 3) == 0 || memcmp(b + lo, "...", 3) == 0)) ||
             (st->fch == '+' && memcmp(b + lo, "+++", 3) == 0))) {
            mdb_span(o, lo, lo + 3, RTX_MDB_S_FRONT_CLOSE, 0);
            st->leaf = RTX_MDB_LEAF_NONE;
            o->close = RTX_MDB_LEAF_FRONT;
            return;
        }
        o->mode = RTX_MDB_M_GUEST;
        o->c_lo = lo;
        o->c_hi = e;
        return;
    }
    if (bof && st->n == 0 && st->leaf == RTX_MDB_LEAF_NONE && e >= lo + 3 &&
        (memcmp(b + lo, "---", 3) == 0 || memcmp(b + lo, "+++", 3) == 0) &&
        mdb_blank(b, lo + 3, e)) {
        st->fch = (unsigned char)b[lo];
        mdb_leaf(st, RTX_MDB_LEAF_FRONT);
        mdb_span(o, lo, lo + 3, RTX_MDB_S_FRONT_OPEN, 0);
        o->open = RTX_MDB_LEAF_FRONT;
        return;
    }

    /* Match open containers. */
    m = 0;
    for (k = 0; k < st->n; k++) {
        ind = mdb_indent(&c, &nw, &nwcol);
        if (st->kind[k] == RTX_MDB_QUOTE) {
            if (ind <= 3 && nw < e && b[nw] == '>') {
                mdb_quote_marker(&c, nw, o);
                m++;
                continue;
            }
            break;
        }
        if (nw >= e) { /* a blank line keeps a list item open */
            m++;
            continue;
        }
        if (ind >= st->ind[k]) {
            mdb_skip(&c, st->ind[k]);
            m++;
            continue;
        }
        break;
    }
    all = m == st->n;

    /* An open multi-line leaf continues, closes, or ends with its container. */
    if (st->leaf == RTX_MDB_LEAF_FENCE || st->leaf == RTX_MDB_LEAF_HTML ||
        st->leaf == RTX_MDB_LEAF_MATH) {
        if (st->ldep > m) {
            o->close0 = st->leaf;
            st->leaf = RTX_MDB_LEAF_NONE;
        } else if (st->leaf == RTX_MDB_LEAF_FENCE) {
            char ch;
            size_t run, ilo, ihi;
            ind = mdb_indent(&c, &nw, &nwcol);
            if (ind <= 3 && mdb_fence_at(b, nw, e, &ch, &run, &ilo, &ihi) &&
                (unsigned char)ch == st->fch && run >= st->flen && ilo == ihi) {
                mdb_span(o, nw, nw + run, RTX_MDB_S_FENCE_CLOSE, 0);
                st->leaf = RTX_MDB_LEAF_NONE;
                o->close = RTX_MDB_LEAF_FENCE;
                return;
            }
            mdb_skip(&c, ind < st->find ? ind : st->find);
            o->mode = RTX_MDB_M_GUEST;
            o->c_lo = c.i;
            o->c_hi = e;
            return;
        } else if (st->leaf == RTX_MDB_LEAF_MATH) {
            size_t z = e;
            while (z > c.i && mdb_ws(b[z - 1])) z--;
            o->mode = RTX_MDB_M_RAW;
            o->c_lo = c.i;
            o->c_hi = e;
            if (z >= c.i + 2 && b[z - 1] == '$' && b[z - 2] == '$') {
                mdb_span(o, z - 2, z, RTX_MDB_S_MATH_CLOSE, 0);
                o->c_hi = z - 2;
                st->leaf = RTX_MDB_LEAF_NONE;
                o->close = RTX_MDB_LEAF_MATH;
            }
            return;
        } else { /* HTML */
            if (st->html >= 6) {
                if (mdb_blank(b, c.i, e)) {
                    o->close0 = RTX_MDB_LEAF_HTML;
                    st->leaf = RTX_MDB_LEAF_NONE;
                    /* fall through: a blank line */
                } else {
                    o->mode = RTX_MDB_M_GUEST;
                    o->c_lo = c.i;
                    o->c_hi = e;
                    return;
                }
            } else {
                o->mode = RTX_MDB_M_GUEST;
                o->c_lo = c.i;
                o->c_hi = e;
                if (mdb_html_ends(st->html, b + c.i, e - c.i)) {
                    st->leaf = RTX_MDB_LEAF_NONE;
                    o->close = RTX_MDB_LEAF_HTML;
                }
                return;
            }
        }
    }

    /* New containers. */
    para_open = st->leaf == RTX_MDB_LEAF_PARA;
    for (;;) {
        size_t mlen;
        long start;
        ind = mdb_indent(&c, &nw, &nwcol);
        if (nw >= e || ind >= 4) break;
        if (b[nw] == '>') {
            if (st->n >= RTX_MDB_DEPTH) break;
            mdb_close_from(st, m, o);
            if (st->leaf != RTX_MDB_LEAF_NONE) mdb_leaf_end(st, o);
            st->kind[st->n] = RTX_MDB_QUOTE;
            st->ind[st->n] = 0;
            st->n++;
            mdb_quote_marker(&c, nw, o);
            m = st->n;
            all = 1;
            para_open = 0;
            continue;
        }
        if (mdb_marker(b, nw, e, &mlen, &start) && !mdb_hr(b, nw, e)) {
            unsigned base = c.col - c.vsp, mcol = nwcol, sp, w;
            size_t after = nw + mlen, q;
            int empty;
            MdbCur t;
            if (st->n >= RTX_MDB_DEPTH) break;
            empty = mdb_blank(b, after, e);
            /* Only an item that would otherwise continue the paragraph (all
             * containers matched) must not be empty or start past 1. */
            if (para_open && all && (empty || (start >= 0 && start != 1))) break;
            /* Spaces after the marker: 1-4 are the content indent; 5+
             * (or none before the end) keep one — the rest is code. */
            t = c;
            mdb_skip(&t, ind);
            mdb_step(&t, mlen);
            sp = mdb_indent(&t, &q, NULL);
            if (empty || sp >= 5) sp = 1;
            w = (mcol - base) + (unsigned)mlen + sp;
            mdb_close_from(st, m, o);
            if (st->leaf != RTX_MDB_LEAF_NONE) mdb_leaf_end(st, o);
            st->kind[st->n] = RTX_MDB_ITEM;
            st->ind[st->n] = (unsigned char)(w > 255 ? 255 : w);
            st->n++;
            mdb_skip(&c, ind);
            mdb_step(&c, mlen);
            if (!empty) mdb_skip(&c, sp);
            else mdb_skip_ws(&c);
            mdb_span(o, nw, empty ? e : c.i, RTX_MDB_S_ITEM, 0);
            /* GFM task box: `[ ]` / `[x]` / `[X]` then a space. */
            if (!empty && c.vsp == 0 && c.i + 3 < e && b[c.i] == '[' && b[c.i + 2] == ']' &&
                (b[c.i + 1] == ' ' || b[c.i + 1] == 'x' || b[c.i + 1] == 'X') &&
                mdb_ws(b[c.i + 3])) {
                mdb_span(o, c.i, c.i + 3, RTX_MDB_S_TASK, 0);
                mdb_step(&c, 3);
            }
            m = st->n;
            all = 1;
            para_open = 0;
            continue;
        }
        break;
    }

    ind = mdb_indent(&c, &nw, &nwcol);
    if (nw >= e) { /* blank */
        if (!all) mdb_close_from(st, m, o);
        if (st->leaf == RTX_MDB_LEAF_PARA || st->leaf == RTX_MDB_LEAF_TABLE)
            mdb_leaf_end(st, o);
        st->flags |= (unsigned char)RTX_MDB_BLANK;
        o->c_lo = o->c_hi = nw;
        return;
    }
    if (!all && para_open && !mdb_block_start(b, nw, e, ind, st)) {
        o->lazy = 1;
        mdb_para_line(st, o, b, lo, nw, e);
        return;
    }
    if (!all) {
        mdb_close_from(st, m, o);
        para_open = st->leaf == RTX_MDB_LEAF_PARA;
    }
    if ((st->flags & RTX_MDB_SOFT) && prev_blank && ind == 0 && st->n == 0)
        st->flags &= (unsigned char)~RTX_MDB_SOFT;

    if (ind >= 4) {
        if (para_open) {
            mdb_para_line(st, o, b, lo, nw, e);
            return;
        }
        if (!(st->flags & RTX_MDB_SOFT) && st->leaf != RTX_MDB_LEAF_TABLE) {
            mdb_skip(&c, 4);
            mdb_leaf(st, RTX_MDB_LEAF_ICODE);
            mdb_span(o, c.i, e, RTX_MDB_S_ICODE, 0);
            o->mode = RTX_MDB_M_RAW;
            o->c_lo = c.i;
            o->c_hi = e;
            return;
        }
    }
    mdb_skip_ws(&c);
    nw = c.i;
    if (st->leaf == RTX_MDB_LEAF_ICODE) st->leaf = RTX_MDB_LEAF_NONE;

    { /* ATX heading */
        size_t oh, cl, ch, zl, zh;
        int lvl = mdb_atx(b, nw, e, &oh, &cl, &ch, &zl, &zh);
        if (lvl) {
            if (st->leaf != RTX_MDB_LEAF_NONE) mdb_leaf_end(st, o);
            mdb_span(o, nw, oh, RTX_MDB_S_ATX, lvl);
            if (zh > zl) mdb_span(o, zl, zh, RTX_MDB_S_ATX_CLOSE, lvl);
            o->mode = RTX_MDB_M_INLINE;
            o->hard = 1;
            o->c_lo = cl;
            o->c_hi = ch;
            return;
        }
    }
    { /* fence */
        char ch;
        size_t run, ilo, ihi;
        if (mdb_fence_at(b, nw, e, &ch, &run, &ilo, &ihi) &&
            (!(st->flags & RTX_MDB_UNSURE) || ihi > ilo)) {
            /* Parity unknown: a bare fence may close one opened above the
             * lex, so it stays text; an info string only opens. */
            st->flags &= (unsigned char)~RTX_MDB_UNSURE;
            if (st->leaf != RTX_MDB_LEAF_NONE) mdb_leaf_end(st, o);
            mdb_leaf(st, RTX_MDB_LEAF_FENCE);
            st->fch = (unsigned char)ch;
            st->flen = (unsigned short)(run > 0xffff ? 0xffff : run);
            st->find = (unsigned char)ind;
            mdb_span(o, nw, nw + run, RTX_MDB_S_FENCE_OPEN, 0);
            o->info_lo = ilo;
            o->info_hi = ihi;
            o->open = RTX_MDB_LEAF_FENCE;
            o->c_lo = o->c_hi = e;
            return;
        }
    }
    if (para_open && !o->lazy) { /* setext underline */
        int lvl = mdb_setext(b, nw, e, &x);
        if (lvl) {
            o->setext = (unsigned char)lvl;
            o->title_back = (size_t)st->pback - st->poff;
            o->drop = 1;
            mdb_span(o, nw, x, RTX_MDB_S_SETEXT, lvl);
            st->leaf = RTX_MDB_LEAF_NONE;
            return;
        }
    }
    if (mdb_hr(b, nw, e)) {
        /* Marp: a break outside every container splits the deck (Marpit
         * splits on top-level `hr` tokens; `Title` + `---` stays setext,
         * as markdown-it reads it). */
        int slide = (st->flags & RTX_MDB_MARP) && st->n == 0;
        if (st->leaf != RTX_MDB_LEAF_NONE) mdb_leaf_end(st, o);
        mdb_span(o, nw, e, slide ? RTX_MDB_S_SLIDE : RTX_MDB_S_HR, 0);
        return;
    }
    if (para_open && st->pcells && rtx_md_line_is_sep(b + nw, e - nw) &&
        mdb_cells(b, nw, e) == st->pcells) {
        o->drop = 1;
        mdb_leaf(st, RTX_MDB_LEAF_TABLE);
        st->tcols = st->pcells;
        mdb_span(o, nw, e, RTX_MDB_S_TABLE_SEP, st->tcols);
        return;
    }
    if (st->leaf == RTX_MDB_LEAF_TABLE) {
        if (rtx_md_line_pipe(b + nw, e - nw)) {
            o->mode = RTX_MDB_M_INLINE;
            o->row = 1;
            o->hard = 1;
            o->c_lo = nw;
            o->c_hi = e;
            return;
        }
        st->leaf = RTX_MDB_LEAF_NONE;
    }
    if (b[nw] == '<') {
        int hk = rtx_mdb_html_start(b + nw, e - nw, para_open);
        if (hk) {
            if (st->leaf != RTX_MDB_LEAF_NONE) mdb_leaf_end(st, o);
            mdb_span(o, nw, e, RTX_MDB_S_HTML, hk);
            o->open = RTX_MDB_LEAF_HTML;
            o->mode = RTX_MDB_M_GUEST;
            o->c_lo = nw;
            o->c_hi = e;
            if (hk <= 5 && mdb_html_ends(hk, b + nw + 2, e - nw - 2)) {
                o->close = RTX_MDB_LEAF_HTML;
            } else {
                mdb_leaf(st, RTX_MDB_LEAF_HTML);
                st->html = (unsigned char)hk;
            }
            return;
        }
    }
    if (!para_open && !(st->flags & RTX_MDB_UNSURE) && nw + 1 < e && b[nw] == '$' &&
        b[nw + 1] == '$') {
        size_t z = e;
        while (z > nw + 2 && mdb_ws(b[z - 1])) z--;
        mdb_span(o, nw, nw + 2, RTX_MDB_S_MATH_OPEN, 0);
        o->open = RTX_MDB_LEAF_MATH;
        o->mode = RTX_MDB_M_RAW;
        o->c_lo = nw + 2;
        o->c_hi = e;
        if (z >= nw + 4 && b[z - 1] == '$' && b[z - 2] == '$') {
            mdb_span(o, z - 2, z, RTX_MDB_S_MATH_CLOSE, 0);
            o->close = RTX_MDB_LEAF_MATH;
            o->c_hi = z - 2;
        } else {
            mdb_leaf(st, RTX_MDB_LEAF_MATH);
            st->fch = '$';
        }
        return;
    }
    if (!para_open && b[nw] == '[') {
        size_t fh;
        if (mdb_refdef(b, nw, e, o)) {
            st->leaf = RTX_MDB_LEAF_NONE;
            return;
        }
        if (mdb_footdef(b, nw, e, &fh)) {
            size_t q = fh;
            mdb_span(o, nw, fh, RTX_MDB_S_FOOT_LABEL, 0);
            while (q < e && mdb_ws(b[q])) q++;
            mdb_para_line(st, o, b, lo, q, e);
            return;
        }
    }
    mdb_para_line(st, o, b, lo, nw, e);
}
