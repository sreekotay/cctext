#!ccc ccs
/*
 * Project picker (see ui_proj.cch). Second source of the rtx_ui target.
 */
#include <ccc/std/prelude.cch>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <time.h>
#include "utf8.cch"
#include "document.cch"
#include "nav_pair.cch"
#include "layout.cch"
#include "workspace.cch"
#include "find.cch"
#include "ui.cch"
#include "ui_proj.cch"

_Static_assert(RTX_PS_ICASE == RTX_FIND_ICASE && RTX_PS_WORD == RTX_FIND_WORD &&
                   RTX_PS_REGEX == RTX_FIND_REGEX,
               "search options share the find bits");

static int rtx_pick_mi(const RtxUi *ui) {
    return ui && ui->pick == RTX_PICK_SEARCH ? 1 : 0;
}

void rtx_ui_proj_hint(RtxUi *ui, const char *project, const char *start) {
    char root[RTX_PROJ_PATH];
    if (!ui) return;
    free(ui->proj_hint);
    ui->proj_hint = NULL;
    if (project && project[0]) {
        ui->proj_hint = strdup(project);
        return;
    }
    /* No file argument: the session's project (rtx_safe_ws_project), so
     * the restored workspace and the index agree on the root. */
    if (!start || !start[0] || (start[0] == '.' && !start[1])) {
        const char *sp = rtx_safe_ws_project();
        if (sp && sp[0]) {
            ui->proj_hint = strdup(sp);
            return;
        }
    }
    if (rtx_proj_root_of(start && start[0] ? start : ".", root, sizeof root) < 0 &&
        rtx_proj_root_of(".", root, sizeof root) < 0)
        return;
    ui->proj_hint = strdup(root);
}

void rtx_ui_proj_close(RtxUi *ui) {
    if (!ui) return;
    if (ui->proj) {
        rtx_proj_close(ui->proj);
        free(ui->proj);
        ui->proj = NULL;
    }
    free(ui->proj_hint);
    ui->proj_hint = NULL;
}

static int rtx_ui_proj_ensure(RtxUi *ui) {
    char cache[RTX_PROJ_PATH];
    if (!ui) return 0;
    if (ui->proj && rtx_proj_is_open(ui->proj)) return 1;
    if (!ui->proj_hint) rtx_ui_proj_hint(ui, NULL, ".");
    if (!ui->proj_hint) {
        snprintf(ui->pick_msg, sizeof ui->pick_msg, "no project root");
        return 0;
    }
    if (!ui->proj) {
        ui->proj = (RtxProj *)calloc(1, sizeof(RtxProj));
        if (!ui->proj) return 0;
    }
    rtx_proj_open(ui->proj, cc_slice_cstr(ui->proj_hint), 0) !>(e) {
        snprintf(ui->pick_msg, sizeof ui->pick_msg, "project: %s",
                 e.message ? e.message : "cannot open");
        return 0;
    };
    if (rtx_safe_dir(cache, sizeof cache)) {
        rtx_proj_mru_load(ui->proj, cache);
        rtx_proj_index_dir(ui->proj, cache);
    }
    return 1;
}

RtxField rtx_ui_pick_field(RtxUi *ui) {
    RtxField f = {0};
    int m;
    if (!ui) return f;
    m = rtx_pick_mi(ui);
    f.buf = ui->pick_q[m];
    f.len = &ui->pick_len[m];
    f.cap = sizeof(ui->pick_q[m]);
    f.caret = &ui->pick_caret[m];
    f.sel = &ui->pick_sel[m];
    return f;
}

const char *rtx_ui_pick_label(const RtxUi *ui) {
    return rtx_pick_mi(ui) ? "search" : "open";
}

size_t rtx_ui_pick_nrows(const RtxUi *ui) {
    if (!ui || !ui->proj || !ui->pick) return 0;
    if (ui->pick == RTX_PICK_OPEN) return rtx_proj_pick_n(ui->proj);
    return rtx_proj_search_rows(ui->proj);
}

size_t rtx_ui_pick_cur(const RtxUi *ui) {
    return ui ? ui->pick_cur[rtx_pick_mi(ui)] : 0;
}

size_t rtx_ui_pick_top(const RtxUi *ui) {
    return ui ? ui->pick_top[rtx_pick_mi(ui)] : 0;
}

static void rtx_pick_fit(RtxUi *ui, int vis) {
    int m = rtx_pick_mi(ui);
    size_t n = rtx_ui_pick_nrows(ui);
    if (vis < 1) vis = 1;
    if (n == 0) {
        ui->pick_cur[m] = 0;
        ui->pick_top[m] = 0;
        return;
    }
    if (ui->pick_cur[m] >= n) ui->pick_cur[m] = n - 1;
    if (ui->pick_cur[m] < ui->pick_top[m]) ui->pick_top[m] = ui->pick_cur[m];
    if (ui->pick_cur[m] >= ui->pick_top[m] + (size_t)vis)
        ui->pick_top[m] = ui->pick_cur[m] - (size_t)vis + 1;
}

void rtx_ui_pick_move(RtxUi *ui, long delta, int vis) {
    int m;
    size_t n;
    long c;
    if (!ui || !ui->pick) return;
    m = rtx_pick_mi(ui);
    n = rtx_ui_pick_nrows(ui);
    if (n == 0) return;
    c = (long)ui->pick_cur[m] + delta;
    if (c < 0) c = 0;
    if ((size_t)c >= n) c = (long)n - 1;
    ui->pick_cur[m] = (size_t)c;
    rtx_pick_fit(ui, vis);
}

int rtx_ui_pick_select(RtxUi *ui, size_t row, int vis) {
    if (!ui || !ui->pick || row >= rtx_ui_pick_nrows(ui)) return 0;
    ui->pick_cur[rtx_pick_mi(ui)] = row;
    rtx_pick_fit(ui, vis);
    return 1;
}

/* Search now (debounce passed, Enter, an option toggled). */
static void !>(CCError) rtx_pick_search_kick(RtxUi *ui) {
    RtxProj *p = ui->proj;
    ui->pick_due = 0;
    if (!p) return cc_ok();
    ui->pick_cur[1] = 0;
    ui->pick_top[1] = 0;
    ui->ps_hit = 0;
    if (ui->pick_len[1] == 0) {
        rtx_proj_search_clear(p);
        return cc_ok();
    }
    return rtx_proj_search_set(p, cc_slice_from_buffer(ui->pick_q[1], ui->pick_len[1]),
                               ui->pick_opts);
}

/* The search list already shows this query (and options). */
static int rtx_pick_search_same(const RtxUi *ui) {
    const RtxProj *p = ui->proj;
    return p && p->ps.on && p->ps.qn == ui->pick_len[1] && p->ps.opts == ui->pick_opts &&
           (p->ps.qn == 0 || !memcmp(p->ps.q, ui->pick_q[1], p->ps.qn));
}

/* Prefill search with a one-line selection (<= 200 bytes). */
static void rtx_pick_prefill(RtxUi *ui, RtxWs *w) {
    RtxBuf *b = w ? RtxWs_active(w) : NULL;
    size_t lo, hi, got;
    char tmp[208];
    if (!b || b->parked || b->doc.sel_box || b->doc.caret == b->doc.sel_anchor) return;
    lo = b->doc.caret < b->doc.sel_anchor ? b->doc.caret : b->doc.sel_anchor;
    hi = b->doc.caret < b->doc.sel_anchor ? b->doc.sel_anchor : b->doc.caret;
    if (hi - lo > 200) return;
    got = b->doc.read_at(lo, cc_slice_from_buffer(tmp, hi - lo)) !>(e) {
        (void)e;
        return;
    };
    if (got != hi - lo || memchr(tmp, '\n', got)) return;
    memcpy(ui->pick_q[1], tmp, got);
    ui->pick_len[1] = got;
    ui->pick_caret[1] = got;
    ui->pick_sel[1] = 0;
}

void !>(CCError) rtx_ui_pick_start(RtxUi *ui, RtxWs *w, int mode) {
    int m;
    RtxBuf *act;
    if (!ui) return cc_ok();
    if (mode != RTX_PICK_OPEN && mode != RTX_PICK_SEARCH) return cc_ok();
    if (ui->pick == mode && mode == RTX_PICK_OPEN) {
        rtx_ui_pick_move(ui, 1, 1 << 20);
        return cc_ok();
    }
    act = w ? RtxWs_active(w) : NULL;
    if (act) rtx_ui_cancel_jump(ui, &act->doc);
    else rtx_ui_clear_jump(ui);
    rtx_ui_clear_find(ui);
    ui->help = 0;
    ui->apply = 0;
    ui->stats = 0;
    ui->pick_msg[0] = 0;
    if (!rtx_ui_proj_ensure(ui)) return cc_ok();
    if (mode == RTX_PICK_SEARCH && w) {
        /* Buffers with unsaved edits: the search index never skips them. */
        int i;
        rtx_proj_keep_clear(ui->proj);
        for (i = 0; i < (int)w->len; i++) {
            const char *bp = RtxWs_buf_path(w, i);
            if (bp && bp[0] && RtxWs_buf_dirty(w, i)) rtx_proj_keep_add(ui->proj, bp);
        }
    }
    ui->pick = mode;
    m = rtx_pick_mi(ui);
    if (mode == RTX_PICK_SEARCH) rtx_pick_prefill(ui, w);
    if (ui->pick_len[m]) {
        ui->pick_sel[m] = 0;
        ui->pick_caret[m] = ui->pick_len[m];
    } else {
        ui->pick_caret[m] = 0;
        ui->pick_sel[m] = 0;
    }
    rtx_field_select_all(rtx_ui_pick_field(ui));
    if (mode == RTX_PICK_OPEN) {
        ui->pick_cur[0] = 0;
        ui->pick_top[0] = 0;
        rtx_proj_pick_set(ui->proj, cc_slice_from_buffer(ui->pick_q[0], ui->pick_len[0])) !>(e) {
            return cc_err(e);
        };
    } else if (!rtx_pick_search_same(ui)) {
        rtx_pick_search_kick(ui) !>(e) { return cc_err(e); };
    } else if (ui->ps_hit) {
        ui->pick_cur[1] = rtx_proj_search_row_of_hit(ui->proj, ui->ps_hit - 1);
    }
    ui->pick_seen[0] = (size_t)-1;
    ui->pick_seen[1] = (size_t)-1;
    rtx_ui_blink_show(ui);
    return cc_ok();
}

void rtx_ui_pick_close(RtxUi *ui) {
    if (!ui) return;
    ui->pick = RTX_PICK_NONE;
}

void !>(CCError) rtx_ui_pick_changed(RtxUi *ui) {
    if (!ui || !ui->pick || !ui->proj) return cc_ok();
    if (ui->pick == RTX_PICK_OPEN) {
        ui->pick_cur[0] = 0;
        ui->pick_top[0] = 0;
        rtx_proj_pick_set(ui->proj, cc_slice_from_buffer(ui->pick_q[0], ui->pick_len[0])) !>(e) {
            return cc_err(e);
        };
        return cc_ok();
    }
    if (ui->pick_len[1] == 0) return rtx_pick_search_kick(ui);
    ui->pick_due = rtx_ui_now_ms() + RTX_PICK_DEBOUNCE_MS;
    return cc_ok();
}

int !>(CCError) rtx_ui_pick_toggle(RtxUi *ui, int letter) {
    unsigned bit = 0;
    if (!ui || ui->pick != RTX_PICK_SEARCH) return cc_ok(0);
    if (letter >= 'A' && letter <= 'Z') letter += 32;
    if (letter == 'c') bit = RTX_FIND_ICASE;
    else if (letter == 'w') bit = RTX_FIND_WORD;
    else if (letter == 'r') bit = RTX_FIND_REGEX;
    if (!bit) return cc_ok(0);
    ui->pick_opts ^= bit;
    rtx_pick_search_kick(ui) !>(e) { return cc_err(e); };
    return cc_ok(1);
}

void !>(CCError) rtx_ui_pick_rewalk(RtxUi *ui) {
    if (!ui || !ui->proj || !rtx_proj_is_open(ui->proj)) return cc_ok();
    snprintf(ui->pick_msg, sizeof ui->pick_msg, "re-walking the project");
    return rtx_proj_rewalk(ui->proj);
}

static void !>(CCError) rtx_ui_proj_index_mode(RtxUi *ui, int update) {
    if (!ui) return cc_ok();
    if (!rtx_ui_proj_ensure(ui)) return cc_ok();
    if (!ui->proj->si_path[0]) {
        snprintf(ui->pick_msg, sizeof ui->pick_msg,
                 rtx_si_enabled() ? "search index: no cache directory"
                                  : "search index is off (search_index: false)");
        return cc_ok();
    }
    rtx_proj_index_kick_mode(ui->proj, update) !>(e) {
        snprintf(ui->pick_msg, sizeof ui->pick_msg, "search index: %s",
                 e.message ? e.message : "failed");
        return cc_ok();
    };
    ui->si_seen = 1;
    snprintf(ui->pick_msg, sizeof ui->pick_msg,
             update ? "updating the search index..." : "building the search index...");
    return cc_ok();
}

void !>(CCError) rtx_ui_proj_index(RtxUi *ui) {
    rtx_ui_proj_index_mode(ui, 0) !>(e) { return cc_err(e); };
    return cc_ok();
}

void !>(CCError) rtx_ui_proj_index_update(RtxUi *ui) {
    rtx_ui_proj_index_mode(ui, 1) !>(e) { return cc_err(e); };
    return cc_ok();
}

int !>(CCError) rtx_ui_pick_pump(RtxUi *ui) {
    RtxProj *p;
    int repaint = 0;
    size_t seen;
    if (!ui || !ui->proj || !rtx_proj_is_open(ui->proj)) return cc_ok(0);
    p = ui->proj;
    rtx_proj_pump(p) !>(e) { return cc_err(e); };
    if (ui->si_seen && !rtx_proj_index_building(p)) {
        /* The build finished: say so where the status shows pick_msg. */
        const RtxSiBuildOut *r = &p->si_last;
        ui->si_seen = 0;
        ui->si_note = 1;
        if (r->ok && r->update)
            snprintf(ui->pick_msg, sizeof ui->pick_msg,
                     "search index updated: %u changed, %u new, %u gone files; %u blocks"
                     " re-read in %.2f s (a full build: %.1f s)",
                     r->upd_changed, r->upd_new, r->upd_gone, r->upd_dirty + r->upd_tail,
                     (double)r->ms / 1000.0, (double)r->full_ms / 1000.0);
        else if (r->ok)
            snprintf(ui->pick_msg, sizeof ui->pick_msg,
                     "search index: %u files, %.1f MiB (%.2f%% of %.0f MiB) in %.1f s%s%s%s",
                     r->files, (double)r->bytes / 1048576.0,
                     r->corpus ? 100.0 * (double)r->bytes / (double)r->corpus : 0.0,
                     (double)r->corpus / 1048576.0, (double)r->ms / 1000.0,
                     r->why_full ? " (full build: " : "", r->why_full ? r->why_full : "",
                     r->why_full ? ")" : "");
        else
            snprintf(ui->pick_msg, sizeof ui->pick_msg, "search index: %s",
                     r->err ? r->err : "failed");
        repaint = 1;
    }
    if (ui->pick_due && rtx_ui_now_ms() >= ui->pick_due) {
        rtx_pick_search_kick(ui) !>(e) { return cc_err(e); };
        repaint = 1;
    }
    if (ui->pick == RTX_PICK_OPEN) {
        if (rtx_proj_pick_update(p) !>(e) { return cc_err(e); })
            repaint = 1;
        seen = rtx_proj_nfiles(p) * 2 + (rtx_proj_walking(p) ? 1 : 0);
        if (seen != ui->pick_seen[0]) repaint = 1;
        ui->pick_seen[0] = seen;
    } else if (ui->pick == RTX_PICK_SEARCH) {
        seen = rtx_proj_search_nh(p) * 4 +
               (rtx_proj_searching(p) ? 1 : 0) + (p->ps.truncated ? 2 : 0);
        if (seen != ui->pick_seen[1] || rtx_proj_searching(p)) repaint = 1;
        ui->pick_seen[1] = seen;
    }
    return cc_ok(repaint);
}

int rtx_ui_pick_busy(const RtxUi *ui) {
    if (!ui || !ui->proj || !rtx_proj_is_open(ui->proj)) return 0;
    if (ui->pick_due) return 1;
    return rtx_proj_walking(ui->proj) || rtx_proj_searching(ui->proj) ||
           rtx_proj_index_building(ui->proj);
}

long rtx_ui_pick_next_ms(const RtxUi *ui, long now) {
    long due = -1;
    if (!ui || !ui->proj) return -1;
    if (ui->pick_due) due = ui->pick_due > now ? ui->pick_due - now : 0;
    if (rtx_proj_walking(ui->proj) || rtx_proj_searching(ui->proj) ||
        rtx_proj_index_building(ui->proj)) {
        /* Progress ticks while the overlay shows it; else join soon. */
        long tick = ui->pick ? 50 : 200;
        if (due < 0 || tick < due) due = tick;
    }
    return due;
}

void rtx_ui_pick_head(const RtxUi *ui, char *dst, size_t n) {
    const RtxProj *p;
    if (!dst || n == 0) return;
    dst[0] = 0;
    if (!ui) return;
    p = ui->proj;
    if (ui->pick_msg[0] && (!p || !rtx_proj_is_open(p))) {
        snprintf(dst, n, "%s", ui->pick_msg);
        return;
    }
    if (!p) return;
    if (ui->pick == RTX_PICK_OPEN) {
        snprintf(dst, n, "%zu / %zu files%s", rtx_proj_pick_n(p), rtx_proj_nfiles(p),
                 rtx_proj_walking(p) ? "  indexing..." : "");
        return;
    }
    {
        char opts[48];
        size_t nh = rtx_proj_search_nh(p), ng = rtx_proj_search_ng(p);
        size_t done = (size_t)atomic_load(&((RtxProj *)p)->ps.pub_files);
        size_t nf = rtx_proj_nfiles(p);
        rtx_ui_find_opts_label(ui->pick_opts, opts, sizeof opts);
        if (p->ps.err) {
            snprintf(dst, n, "%s%s%s", opts, opts[0] ? "  " : "", p->ps.err);
        } else if (!p->ps.on) {
            snprintf(dst, n, "%s%s%zu files", opts, opts[0] ? "  " : "", nf);
        } else {
            snprintf(dst, n, "%s%s%zu matches in %zu files%s%s", opts, opts[0] ? "  " : "", nh,
                     ng, p->ps.truncated ? "  capped" : "",
                     ui->pick_due ? "  ..." : "");
            if (p->ps.complete && p->ps.n_idx_skip && !ui->pick_due) {
                size_t k = strlen(dst);
                snprintf(dst + k, n - k, "  index skipped %zu", p->ps.n_idx_skip);
            }
            if (rtx_proj_index_building(p)) {
                size_t k = strlen(dst);
                snprintf(dst + k, n - k, "  indexing %d%%", rtx_proj_index_pct(p));
            }
            if (rtx_proj_searching(p) && !ui->pick_due) {
                size_t k = strlen(dst);
                snprintf(dst + k, n - k, "  searching %zu%%",
                         nf ? (done * 100 / nf > 99 ? 99 : done * 100 / nf) : 0);
            }
        }
    }
}

static size_t rtx_pick_put(RtxPickRow *r, const char *s, size_t n, unsigned char mark) {
    size_t i, k = 0;
    for (i = 0; i < n && r->n + 1 < RTX_PICK_ROW_TEXT; i++) {
        unsigned char c = (unsigned char)s[i];
        if (c == '\t' || c == '\n' || c == '\r') c = ' ';
        else if (c < 0x20 || c == 0x7F) c = '?';
        r->text[r->n] = (char)c;
        r->mark[r->n] = mark;
        r->n++;
        k++;
    }
    r->text[r->n] = 0;
    return k;
}

int rtx_ui_pick_row(RtxUi *ui, size_t row, RtxPickRow *out) {
    RtxProj *p;
    char path[RTX_PROJ_PATH];
    size_t pn;
    if (!ui || !out || !ui->proj || row >= rtx_ui_pick_nrows(ui)) return 0;
    p = ui->proj;
    out->n = 0;
    out->text[0] = 0;
    if (ui->pick == RTX_PICK_OPEN) {
        const RtxProjHit *h = rtx_proj_pick_at(p, row);
        uint16_t pos[RTX_FUZZY_QMAX];
        size_t base, i, qn = ui->pick_len[0];
        if (!h) return 0;
        pn = rtx_proj_path(p, h->id, path, sizeof path);
        base = rtx_proj_base_off(path, pn);
        out->kind = RTX_PICK_ROW_FILE;
        rtx_pick_put(out, path, pn, 0);
        for (i = 0; i < out->n; i++) out->mark[i] = i < base ? 2 : 0;
        if (qn > RTX_FUZZY_QMAX) qn = RTX_FUZZY_QMAX;
        if (qn && rtx_fuzzy_path(ui->pick_q[0], qn, path, pn, base, pos) != RTX_FUZZY_NONE) {
            for (i = 0; i < qn; i++)
                if (pos[i] < out->n) out->mark[pos[i]] = 1;
        }
        return 1;
    }
    {
        size_t g = 0, hit = 0;
        rtx_proj_search_row(p, row, &g, &hit);
        if (g == (size_t)-1) return 0;
        if (hit == (size_t)-1) {
            const RtxPsGroup *gr = rtx_proj_search_group(p, g);
            char cnt[32];
            pn = rtx_proj_path(p, gr->file, path, sizeof path);
            out->kind = RTX_PICK_ROW_GROUP;
            rtx_pick_put(out, path, pn, 0);
            snprintf(cnt, sizeof cnt, "  (%u)", gr->n);
            rtx_pick_put(out, cnt, strlen(cnt), 2);
            return 1;
        }
        {
            const RtxPsHit *h = rtx_proj_search_hit(p, hit);
            const char *pv = rtx_proj_search_pv(p, h);
            char num[32];
            size_t lead = 0, at, len, start;
            out->kind = RTX_PICK_ROW_HIT;
            snprintf(num, sizeof num, "  %6u  ", h->line);
            rtx_pick_put(out, num, strlen(num), 2);
            while (lead < h->pvn && lead < h->pvhit && (pv[lead] == ' ' || pv[lead] == '\t'))
                lead++;
            start = out->n;
            rtx_pick_put(out, pv + lead, h->pvn - lead, 0);
            at = start + (h->pvhit - lead);
            len = h->mlen;
            while (len && at < out->n) {
                out->mark[at++] = 1;
                len--;
            }
            return 1;
        }
    }
}

/* Open `rel` in the focused pane, or the other one (split if needed). */
static void !>(CCError) rtx_pick_open_path(RtxUi *ui, RtxWs *w, const char *rel, int other) {
    char abs[RTX_PROJ_PATH];
    if (!rtx_proj_abs(ui->proj, rel, abs, sizeof abs))
        return cc_err(CC_ERR_INVALID_ARG, "path too long");
    if (other) {
        /* One pane: split right (the new pane takes focus); else the
         * next pane in tree order. */
        if (w->npanes <= 1) {
            if (RtxWs_split(w, RTX_SPLIT_COLS) < 0) RtxWs_focus_step(w, 1);
        } else {
            RtxWs_focus_step(w, 1);
        }
    }
    RtxWs_open_in_pane(w, cc_slice_cstr(abs)) !>(e) { return cc_err(e); };
    rtx_proj_mru_touch(ui->proj, rel);
    return cc_ok();
}

static int !>(CCError) rtx_pick_open_hit(RtxUi *ui, RtxWs *w, size_t hit, int other, int vis) {
    RtxProj *p = ui->proj;
    const RtxPsHit *h = rtx_proj_search_hit(p, hit);
    char rel[RTX_PROJ_PATH];
    RtxBuf *b;
    size_t off, len;
    if (!h) return cc_ok(0);
    rtx_proj_path(p, h->file, rel, sizeof rel);
    rtx_pick_open_path(ui, w, rel, other) !>(e) { return cc_err(e); };
    b = RtxWs_active(w);
    if (!b) return cc_ok(0);
    len = b->doc.len();
    off = h->off < len ? (size_t)h->off : len;
    b->doc.caret = off;
    b->doc.sel_anchor = off + h->mlen <= len ? off + h->mlen : len;
    b->doc.sel_box = 0;
    b->doc.break_coalesce();
    b->unlock = 0;
    b->land(vis) !>(e) { (void)e; };
    ui->ps_hit = hit + 1;
    ui->pick_cur[1] = rtx_proj_search_row_of_hit(p, hit);
    snprintf(ui->pick_msg, sizeof ui->pick_msg, "match %zu / %zu", hit + 1,
             rtx_proj_search_nh(p));
    return cc_ok(1);
}

int !>(CCError) rtx_ui_pick_accept(RtxUi *ui, RtxWs *w, int other, int vis) {
    RtxProj *p;
    if (!ui || !w || !ui->pick || !ui->proj) return cc_ok(0);
    p = ui->proj;
    if (ui->pick == RTX_PICK_OPEN) {
        const RtxProjHit *h = rtx_proj_pick_at(p, ui->pick_cur[0]);
        char rel[RTX_PROJ_PATH];
        if (!h) return cc_ok(0);
        rtx_proj_path(p, h->id, rel, sizeof rel);
        ui->pick = RTX_PICK_NONE;
        rtx_pick_open_path(ui, w, rel, other) !>(e) { return cc_err(e); };
        return cc_ok(1);
    }
    if (ui->pick_due || !rtx_pick_search_same(ui)) {
        /* Enter before the debounce: search now. */
        rtx_pick_search_kick(ui) !>(e) { return cc_err(e); };
        return cc_ok(0);
    }
    {
        size_t g = 0, hit = 0;
        rtx_proj_search_row(p, ui->pick_cur[1], &g, &hit);
        if (g == (size_t)-1) return cc_ok(0);
        if (hit == (size_t)-1) hit = rtx_proj_search_group(p, g)->first;
        ui->pick = RTX_PICK_NONE;
        return rtx_pick_open_hit(ui, w, hit, other, vis);
    }
}

int !>(CCError) rtx_ui_psearch_step(RtxUi *ui, RtxWs *w, int dir, int vis) {
    size_t nh, hit;
    if (!ui || !w || !ui->proj) return cc_ok(0);
    nh = rtx_proj_search_nh(ui->proj);
    if (!nh) {
        snprintf(ui->pick_msg, sizeof ui->pick_msg, "no search results (Ctrl-Shift-F)");
        return cc_ok(0);
    }
    if (!ui->ps_hit) hit = dir >= 0 ? 0 : nh - 1;
    else if (dir >= 0) hit = ui->ps_hit < nh ? ui->ps_hit : 0;
    else hit = ui->ps_hit >= 2 ? ui->ps_hit - 2 : nh - 1;
    return rtx_pick_open_hit(ui, w, hit, 0, vis);
}
