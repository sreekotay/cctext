#!ccc cch
/*
 * Per-pane directory listing. A real glob (* ? [) filters files and leaves
 * directories so you can walk. Enter on a directory clears the glob. A
 * fragment like "R" matches any name that contains it (case-insensitive).
 * `>` walks every subfolder and flattens files as `dir/name`; text after
 * `>` is the same glob. A typed fragment filters this directory first,
 * then appends a `> Flattened search` row and nested matches. Leading `.`
 * reveals dotfiles; it is
 * not a fragment — it does not match extension dots.
 * Does not chdir. Ctrl-O / Ctrl-E spawn this / the other frontend on the
 * selection (Enter still opens in this instance).
 * The current folder (not `..`) gets a pumped size walk: one live dir
 * and a depth stack (not a preload of every subdirectory). A move
 * parks and defers I/O so the key owns the turn. Leaving pauses it
 * and coming back resumes. A finished total is kept by absolute path
 * (64) across kick; it does not start over. Size counts up in the listing.
 * Scan model (DESIGN.md): kick plants a dest-live wrapper; the arm
 * runs `@parallel wait` over directory jobs and publishes in the write
 * stage. finish waits the wrapper.
 */
#ifndef RTX_BROWSE_H
#define RTX_BROWSE_H

#ifndef RTX_BROWSE_PAINT_MS
#define RTX_BROWSE_PAINT_MS 100 /* listing chrome; folder size stays 50 ms */
#endif
#ifndef RTX_BROWSE_CAP
#define RTX_BROWSE_CAP 4
#endif

#include <limits.h>
#include <stdint.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <sys/stat.h>
#include <time.h>

#ifndef RTX_BROWSE_TYPES
#define RTX_BROWSE_TYPES
enum {
    RTX_BROWSE_NAME = 256,
    RTX_BROWSE_DIR = 1024,
    RTX_BROWSE_GLOB = 96,
    RTX_BROWSE_MAX = 4096,
    RTX_BROWSE_HEAD = 2
};

typedef struct {
    int is_dir;
    int has_stat;
    int sized;             /* 1: size is a folder total (running or done) */
    int size_done;         /* 1: folder total finished; 0: still walking */
    int size_denied;       /* 1: folder itself was EACCES/EPERM */
    int sep;               /* 1: "> Flattened search" divider */
    uint64_t size;
    time_t mtime;
    char name[RTX_BROWSE_NAME];
} RtxBrowseEnt;

typedef struct {
    int on;
    int truncated;
    int denied;            /* 1: listing dir itself was EACCES/EPERM */
    int scanning;          /* 1 while listing handle is live and not yet done */
    int sizing;            /* 1: pumped du of the current folder */
    int flat;              /* 1: typed fragment, flattening this tree */
    char dir[RTX_BROWSE_DIR];
    char glob[RTX_BROWSE_GLOB];
    size_t glob_len;
    size_t glob_caret;
    size_t glob_sel;
    int glob_focus;        /* 1: arrows edit the glob, not the list */
    RtxBrowseEnt *ents;
    size_t len, cap;
    size_t cur, top;
    int boot;              /* 1: started with no file; close without a pick quits */
    CCArena store;
    void *wk;              /* RtxBrowseWalk in browse.ccs */
} RtxBrowse;
#endif

void rtx_browse_walk_stop(RtxBrowse *br);
void rtx_browse_keep_set(RtxBrowse *br, const char *name);
void rtx_browse_drop(RtxBrowse *br);
int rtx_browse_is_root(const char *dir);
void rtx_browse_basename(char *dst, size_t n, const char *path);
void rtx_browse_dirname(char *dst, size_t n, const char *path);
int rtx_browse_abs(char *dst, size_t n, const char *path);
int rtx_browse_join(char *dst, size_t n, const char *dir, const char *name);

enum {
    RTX_BROWSE_SIZE_W = 7,
    RTX_BROWSE_MTIME_W = 16 /* YYYY-MM-DD HH:MM */
};

/* Closed chrome palette. Same RGB + ANSI for both frontends. */
typedef enum {
    RTX_BROWSE_FACE_PATH = 0,
    RTX_BROWSE_FACE_GLOB,
    RTX_BROWSE_FACE_DIR,
    RTX_BROWSE_FACE_FILE,
    RTX_BROWSE_FACE_SIZE,
    RTX_BROWSE_FACE_DATE,
    RTX_BROWSE_FACE_HIT,
    RTX_BROWSE_FACE_EXT,  /* last suffix matches a loaded grammar */
    RTX_BROWSE_FACE_DENY  /* permission denied (size column / chip) */
} RtxBrowseFace;

#ifndef RTX_THEME_COLOR_TYPE
#define RTX_THEME_COLOR_TYPE
typedef struct {
    unsigned char r, g, b;
    const char *ansi;
} RtxThemeColor;
#endif

RtxThemeColor rtx_browse_face(RtxBrowseFace face);
void rtx_browse_fmt_size(char *dst, size_t n, const RtxBrowseEnt *e);
const char *rtx_browse_scan_msg(const RtxBrowse *br);
void rtx_browse_fmt_mtime(char *dst, size_t n, const RtxBrowseEnt *e);
void rtx_browse_fmt_meta(char *dst, size_t n, const RtxBrowseEnt *e);
void rtx_browse_fmt_row(char *dst, size_t n, int cols, const RtxBrowseEnt *e);
int rtx_browse_hit_span(const RtxBrowse *br, const char *name,
                        size_t *off, size_t *n);
size_t rtx_browse_dir_prefix(const char *name);

/* Face for name[i]. Hit wins; dirs stay DIR; a known suffix is EXT. */
static RtxBrowseFace rtx_browse_name_face(int is_dir, size_t i, size_t pref,
                                         size_t hit, size_t hn,
                                         size_t ext, size_t en) {
    if (hn && i >= hit && i < hit + hn) return RTX_BROWSE_FACE_HIT;
    if (is_dir || i < pref) return RTX_BROWSE_FACE_DIR;
    if (en && i >= ext && i < ext + en) return RTX_BROWSE_FACE_EXT;
    return RTX_BROWSE_FACE_FILE;
}

/* Folder totals use DIR. A paused incomplete total is DATE (gray). Files stay SIZE. */
static RtxBrowseFace rtx_browse_size_face(const RtxBrowse *br,
                                         const RtxBrowseEnt *e) {
    int live;
    if (!e || !e->is_dir || !e->sized) return RTX_BROWSE_FACE_SIZE;
    if (e->size_denied) return RTX_BROWSE_FACE_DENY;
    live = br && br->ents && br->cur < br->len && e == &br->ents[br->cur];
    if (!e->size_done && !live) return RTX_BROWSE_FACE_DATE;
    return RTX_BROWSE_FACE_DIR;
}
void !>(CCError) rtx_browse_kick(RtxBrowse *br);
void rtx_browse_pause(RtxBrowse *br);
void rtx_browse_resume(RtxBrowse *br);
size_t !>(CCError) rtx_browse_pump(RtxBrowse *br);
void !>(CCError) rtx_browse_finish(RtxBrowse *br);
int rtx_browse_head(const RtxBrowse *br);
void rtx_browse_scroll(RtxBrowse *br, int vis);
void rtx_browse_move(RtxBrowse *br, int dir, int vis);
int rtx_browse_hit(const RtxBrowse *br, int row, int vis);
int rtx_browse_need_pump(const RtxBrowse *br);
void rtx_browse_select(RtxBrowse *br, size_t idx, int vis);

/* Host exe (argv0 / dyld). Spawn a new process on the browse selection. */
void rtx_host_set_exe(const char *argv0);
int rtx_host_is_ray(const char *exe);
int rtx_host_peer_path(const char *exe, int other, char *dst, size_t n);
const char *rtx_host_peer_name(int other);
const char *rtx_host_tty_app(void);
int rtx_browse_sel_path(const RtxBrowse *br, char *dst, size_t n, int *is_dir);
int rtx_browse_spawn(const RtxBrowse *br, int other);

#endif /* RTX_BROWSE_H */
