#!ccc cch
/*
 * Per-pane directory listing. A real glob (* ? [) filters files and leaves
 * directories so you can walk. Enter on a directory clears the glob. A
 * fragment like "R" matches any name that contains it (case-insensitive).
 * `>` walks every subfolder and flattens files as `dir/name`; text after
 * `>` is the same glob. A typed fragment filters this directory first,
 * then appends a `> Flattened search` row and nested matches. Leading `.`
 * reveals dotfiles; it is
 * not a fragment — it does not match extension dots.
 * Does not chdir. Ctrl-O / Ctrl-E spawn this / the other frontend on the
 * selection (Enter still opens in this instance).
 * The current folder (not `..`) gets a pumped size walk: one live dir
 * and a depth stack (not a preload of every subdirectory). A move
 * parks and defers I/O so the key owns the turn. Leaving pauses it
 * and coming back resumes. A finished total is kept by absolute path
 * (64) across kick; it does not start over. Size counts up in the listing.
 * Scan model (DESIGN.md): kick plants a dest-live wrapper; the arm
 * runs one `@parallel wait` wave and returns. Dest-live `h.live()`
 * stays true until `.wait()`. The host pump joins a finished arm
 * and starts the next wave so a keystroke join is that wave, not
 * the rest of the tree. Flatten does not descend vendor trees (`node_modules`,
 * `target`, …). A huge directory is split (`RTX_BROWSE_DIR_BUDGET`
 * dirents, then the same folder is re-queued). The job queue is
 * capped (`RTX_BROWSE_JOB_MAX`); overflow is `truncated`. A glob
 * keystroke keeps the last list on screen until the new scan has a
 * real row. finish drains remaining waves, then folder-size.
 * Drop/kick cancel the tree and join.
 */
#ifndef RTX_BROWSE_H
#define RTX_BROWSE_H

#ifndef RTX_BROWSE_PAINT_MS
#define RTX_BROWSE_PAINT_MS 100 /* listing chrome; folder size stays 50 ms */
#endif
#ifndef RTX_BROWSE_CAP
#define RTX_BROWSE_CAP 4
#endif
#ifndef RTX_BROWSE_WAVE
#define RTX_BROWSE_WAVE 8 /* jobs per @parallel wait; not the whole queue */
#endif
#ifndef RTX_BROWSE_JOB_MAX
#define RTX_BROWSE_JOB_MAX 1024
#endif
#ifndef RTX_BROWSE_DIR_BUDGET
#define RTX_BROWSE_DIR_BUDGET 128 /* dirents per deep job; then resume */
#endif

#include <ccc/std/prelude.cch>
#include <limits.h>
#include <stdatomic.h>
#include <stdint.h>
#include <string.h>
#include <sys/stat.h>
#include <time.h>
#include "utf8.cch"

#ifndef RTX_BROWSE_TYPES
#define RTX_BROWSE_TYPES
enum {
    RTX_BROWSE_NAME = 256,
    RTX_BROWSE_DIR = 1024,
    RTX_BROWSE_GLOB = 96,
    RTX_BROWSE_MAX = 4096,
    RTX_BROWSE_HEAD = 2
};

typedef struct {
    int is_dir;
    int has_stat;
    int sized;             /* 1: size is a folder total (running or done) */
    int size_done;         /* 1: folder total finished; 0: still walking */
    int size_denied;       /* 1: folder itself was EACCES/EPERM */
    int sep;               /* 1: "> Flattened search" divider */
    uint64_t size;
    time_t mtime;
    char name[RTX_BROWSE_NAME];
} RtxBrowseEnt;

/* One wave's listing. The worker allocates this, fills it, then
 * release-stores `pub`. The host acquire-loads it and does not read
 * `ents` while the arm is live. The buffer is not sorted or freed
 * after that store; a later sort copies first. `truncated` / `denied`
 * are the walk's flags at that same site (the host reads these, not
 * br->truncated / br->denied, while the arm is live). */
typedef struct {
    RtxBrowseEnt *ents;
    size_t len;
    size_t cur;
    size_t top;
    int truncated;
    int denied;
} RtxBrowsePub;

typedef struct {
    int on;
    int truncated;
    int denied;            /* 1: listing dir itself was EACCES/EPERM */
    int scanning;          /* 1 while listing handle is live and not yet done */
    int sizing;            /* 1: pumped du of the current folder */
    int flat;              /* 1: typed fragment, flattening this tree */
    char dir[RTX_BROWSE_DIR];
    char keep[RTX_BROWSE_NAME]; /* preselect; set before kick */
    char glob[RTX_BROWSE_GLOB];
    size_t glob_len;
    size_t glob_caret;
    size_t glob_sel;
    int glob_focus;        /* 1: arrows edit the glob, not the list */
    Vec::[RtxBrowseEnt] ents; /* on store; append only in @stage */
    size_t cur, top;
    int boot;              /* 1: started with no file; close without a pick quits */
    CCArena store;
    void *wk;              /* RtxBrowseWalk; calloc — embeds CCParallel */
    RtxBrowseEnt *hold;    /* last list while a glob kick rescans */
    CCArena hold_a;        /* owns hold[]; survives store.reset */
    size_t hold_len, hold_cap, hold_cur, hold_top;
    int host_nav;          /* host moved while the arm was live */
    size_t host_cur, host_top;
    char host_name[RTX_BROWSE_NAME]; /* that row's name; the join remaps by it */
    int hold_drop_later;   /* worker finished the hold; host frees after join */
    RtxBrowsePub *_Atomic pub;
} RtxBrowse;
#endif

void rtx_browse_walk_stop(RtxBrowse *br);
void rtx_browse_keep_set(RtxBrowse *br, char[:0] name);
void rtx_browse_drop(RtxBrowse *br);
