#!ccc cch
/*
 * Per-pane directory listing. A real glob (* ? [) filters files and leaves
 * directories so you can walk. A fragment like "R" matches any name that
 * contains it. `>` walks every subfolder and flattens files as `dir/name`;
 * text after `>` is the same glob. Does not chdir the process.
 */
#ifndef RTX_BROWSE_H
#define RTX_BROWSE_H

#include <limits.h>
#include <stdint.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <sys/stat.h>
#include <time.h>

#ifndef RTX_BROWSE_TYPES
#define RTX_BROWSE_TYPES
enum {
    RTX_BROWSE_NAME = 256,
    RTX_BROWSE_DIR = 1024,
    RTX_BROWSE_GLOB = 96,
    RTX_BROWSE_MAX = 4096,
    RTX_BROWSE_HEAD = 2
};

typedef struct {
    int is_dir;
    int has_stat;
    uint64_t size;
    time_t mtime;
    char name[RTX_BROWSE_NAME];
} RtxBrowseEnt;

typedef struct {
    int on;
    int truncated;
    char dir[RTX_BROWSE_DIR];
    char glob[RTX_BROWSE_GLOB];
    size_t glob_len;
    size_t glob_caret;
    size_t glob_sel;
    int glob_focus;        /* 1: arrows edit the glob, not the list */
    RtxBrowseEnt *ents;
    size_t len, cap;
    size_t cur, top;
    CCArena store;
} RtxBrowse;
#endif

static void rtx_browse_drop(RtxBrowse *br) {
    if (!br) return;
    if (br->store.base) br->store.destroy();
    memset(br, 0, sizeof(*br));
}

static int rtx_browse_is_root(const char *dir) {
    return dir && dir[0] == '/' && dir[1] == 0;
}

static void rtx_browse_basename(char *dst, size_t n, const char *path) {
    const char *slash;
    if (!dst || n == 0) return;
    dst[0] = 0;
    if (!path || !path[0]) return;
    slash = strrchr(path, '/');
    snprintf(dst, n, "%s", slash ? slash + 1 : path);
}

static void rtx_browse_dirname(char *dst, size_t n, const char *path) {
    const char *slash;
    size_t len;
    if (!dst || n == 0) return;
    if (!path || !path[0]) {
        snprintf(dst, n, ".");
        return;
    }
    slash = strrchr(path, '/');
    if (!slash) {
        snprintf(dst, n, ".");
        return;
    }
    if (slash == path) {
        snprintf(dst, n, "/");
        return;
    }
    len = (size_t)(slash - path);
    if (len >= n) len = n - 1;
    memcpy(dst, path, len);
    dst[len] = 0;
}

/* Process cwd if `path` is empty or `.`; else cwd/`path` when relative. */
static int rtx_browse_abs(char *dst, size_t n, const char *path) {
    char raw[RTX_BROWSE_DIR];
    char resolved[PATH_MAX];
    if (!dst || n == 0) return 0;
    dst[0] = 0;
    if (!path || !path[0] || strcmp(path, ".") == 0) {
        cc_arena_stack(scratch, 1024);
        CCSlice cwd = cc_dir_cwd(&scratch);
        if (!(cwd.ptr && cwd.len)) return 0;
        snprintf(raw, sizeof(raw), "%s", cwd.ptr);
    } else if (path[0] == '/') {
        snprintf(raw, sizeof(raw), "%s", path);
    } else {
        cc_arena_stack(scratch, 1024);
        CCSlice cwd = cc_dir_cwd(&scratch);
        if (cwd.ptr && cwd.len)
            snprintf(raw, sizeof(raw), "%s/%s", cwd.ptr, path);
        else
            snprintf(raw, sizeof(raw), "%s", path);
    }
    if (realpath(raw, resolved) && resolved[0]) {
        if (strlen(resolved) >= n) return 0;
        snprintf(dst, n, "%s", resolved);
        return 1;
    }
    if (!raw[0] || strlen(raw) >= n) return 0;
    snprintf(dst, n, "%s", raw);
    return 1;
}

static int rtx_browse_join(char *dst, size_t n, const char *dir, const char *name) {
    int wr;
    char abs[RTX_BROWSE_DIR];
    if (!dst || n == 0 || !dir || !name) return 0;
    if (strcmp(name, "..") == 0) {
        /* Relative `testdata` has no slash: dirname is `.` and `..` stuck. */
        if (!rtx_browse_abs(abs, sizeof(abs), dir)) return 0;
        rtx_browse_dirname(dst, n, abs);
        return dst[0] != 0;
    }
    if (strcmp(dir, "/") == 0) wr = snprintf(dst, n, "/%s", name);
    else wr = snprintf(dst, n, "%s/%s", dir, name);
    return wr > 0 && (size_t)wr < n;
}

enum {
    RTX_BROWSE_SIZE_W = 7,
    RTX_BROWSE_MTIME_W = 16 /* YYYY-MM-DD HH:MM */
};

/* Closed chrome palette. Same RGB + ANSI for both frontends. */
typedef enum {
    RTX_BROWSE_FACE_PATH = 0,
    RTX_BROWSE_FACE_GLOB,
    RTX_BROWSE_FACE_DIR,
    RTX_BROWSE_FACE_FILE,
    RTX_BROWSE_FACE_SIZE,
    RTX_BROWSE_FACE_DATE
} RtxBrowseFace;

#ifndef RTX_BROWSE_LIST
static RtxThemeColor rtx_browse_face(RtxBrowseFace face) {
    RtxThemeColor z;
    z.r = 230; z.g = 230; z.b = 230; z.ansi = "\x1b[0m";
    switch (face) {
    case RTX_BROWSE_FACE_PATH:
        z.r = 120; z.g = 160; z.b = 210; z.ansi = "\x1b[34m";
        break;
    case RTX_BROWSE_FACE_GLOB:
        z.r = 220; z.g = 180; z.b = 80; z.ansi = "\x1b[33m";
        break;
    case RTX_BROWSE_FACE_DIR:
        z.r = 80; z.g = 200; z.b = 220; z.ansi = "\x1b[36;1m";
        break;
    case RTX_BROWSE_FACE_FILE:
        z.r = 230; z.g = 230; z.b = 230; z.ansi = "\x1b[37m";
        break;
    case RTX_BROWSE_FACE_SIZE:
        z.r = 220; z.g = 180; z.b = 80; z.ansi = "\x1b[33m";
        break;
    case RTX_BROWSE_FACE_DATE:
        z.r = 140; z.g = 140; z.b = 140; z.ansi = "\x1b[90m";
        break;
    }
    return z;
}
#endif

static int rtx_browse_stat_path(const char *path, RtxBrowseEnt *e) {
    struct stat st;
    if (!path || !path[0] || !e) return 0;
    if (stat(path, &st) != 0) return 0;
    e->has_stat = 1;
    e->is_dir = S_ISDIR(st.st_mode);
    e->size = (uint64_t)st.st_size;
    e->mtime = st.st_mtime;
    return 1;
}

static void rtx_browse_fmt_size(char *dst, size_t n, const RtxBrowseEnt *e) {
    uint64_t s;
    double v;
    char u;
    if (!dst || n == 0) return;
    if (!e || !e->has_stat || e->is_dir) {
        snprintf(dst, n, "%*s", RTX_BROWSE_SIZE_W, "");
        return;
    }
    s = e->size;
    if (s < 1024ull) {
        snprintf(dst, n, "%*llu", RTX_BROWSE_SIZE_W, (unsigned long long)s);
        return;
    }
    if (s < 1024ull * 1024) {
        v = (double)s / 1024.0;
        u = 'K';
    } else if (s < 1024ull * 1024 * 1024) {
        v = (double)s / (1024.0 * 1024.0);
        u = 'M';
    } else {
        v = (double)s / (1024.0 * 1024.0 * 1024.0);
        u = 'G';
    }
    snprintf(dst, n, "%*.1f%c", RTX_BROWSE_SIZE_W - 1, v, u);
}

static void rtx_browse_fmt_mtime(char *dst, size_t n, const RtxBrowseEnt *e) {
    struct tm tm;
    if (!dst || n == 0) return;
    if (!e || !e->has_stat || !localtime_r(&e->mtime, &tm) ||
        strftime(dst, n, "%Y-%m-%d %H:%M", &tm) == 0) {
        snprintf(dst, n, "%*s", RTX_BROWSE_MTIME_W, "");
    }
}

static void rtx_browse_fmt_meta(char *dst, size_t n, const RtxBrowseEnt *e) {
    char size[12];
    char when[24];
    rtx_browse_fmt_size(size, sizeof(size), e);
    rtx_browse_fmt_mtime(when, sizeof(when), e);
    snprintf(dst, n, "%s  %s", size, when);
}

/* Name left, size + mtime right. Narrow panes keep the name only. */
static void rtx_browse_fmt_row(char *dst, size_t n, int cols, const RtxBrowseEnt *e) {
    char name[RTX_BROWSE_NAME + 2];
    char size[12];
    char when[24];
    int meta = RTX_BROWSE_SIZE_W + 2 + RTX_BROWSE_MTIME_W;
    int name_w, i, show, size_at;

    if (!dst || n == 0) return;
    dst[0] = 0;
    if (!e) return;
    if (cols < 2) cols = 2;
    if ((size_t)cols >= n) cols = (int)n - 1;
    memset(dst, ' ', (size_t)cols);
    dst[cols] = 0;

    snprintf(name, sizeof(name), "%s%s", e->name, e->is_dir ? "/" : "");
    show = cols >= 10 + meta;
    size_at = show ? cols - meta : cols;
    name_w = size_at - 2;
    if (name_w < 1) name_w = 1;
    for (i = 0; name[i] && i < name_w; i++)
        dst[1 + i] = name[i];
    if (!show) return;
    rtx_browse_fmt_size(size, sizeof(size), e);
    rtx_browse_fmt_mtime(when, sizeof(when), e);
    for (i = 0; size[i] && size_at + i < cols; i++)
        dst[size_at + i] = size[i];
    for (i = 0; when[i] && cols - RTX_BROWSE_MTIME_W + i < cols; i++)
        dst[cols - RTX_BROWSE_MTIME_W + i] = when[i];
}

static int rtx_browse_cmp(const void *a, const void *b) {
    const RtxBrowseEnt *x = (const RtxBrowseEnt *)a;
    const RtxBrowseEnt *y = (const RtxBrowseEnt *)b;
    if (x->is_dir != y->is_dir) return y->is_dir - x->is_dir;
    return strcmp(x->name, y->name);
}

static int rtx_browse_deep(const RtxBrowse *br) {
    return br && br->glob_len && br->glob[0] == '>';
}

static const char *rtx_browse_filter(const RtxBrowse *br) {
    if (!br || !br->glob_len) return "";
    if (br->glob[0] == '>') return br->glob + 1;
    return br->glob;
}

static const char *rtx_browse_rel_base(const char *name) {
    const char *slash;
    if (!name) return "";
    slash = strrchr(name, '/');
    return slash ? slash + 1 : name;
}

/* Bytes of `dir/` on a flattened `dir/name`. 0 if this row is top-level. */
static size_t rtx_browse_dir_prefix(const char *name) {
    const char *slash;
    if (!name) return 0;
    slash = strrchr(name, '/');
    if (!slash) return 0;
    return (size_t)(slash - name + 1);
}

static int rtx_browse_glob_meta(const char *pat) {
    const char *p;
    if (!pat) return 0;
    for (p = pat; *p; p++) {
        if (*p == '*' || *p == '?' || *p == '[') return 1;
    }
    return 0;
}

static int rtx_browse_glob_match(const char *pat, const char *name) {
    char wrapped[RTX_BROWSE_GLOB + 2];
    if (!pat || !pat[0] || !name) return 1;
    if (rtx_browse_glob_meta(pat))
        return cc_glob_match(cc_slice_cstr(pat), cc_slice_cstr(name));
    /* Typing "R" should keep README.md, not only a file named R. */
    if (strlen(pat) + 2 >= sizeof(wrapped)) return strstr(name, pat) != NULL;
    snprintf(wrapped, sizeof(wrapped), "*%s*", pat);
    return cc_glob_match(cc_slice_cstr(wrapped), cc_slice_cstr(name));
}

static int rtx_browse_hidden(const RtxBrowse *br, const char *name) {
    const char *base = rtx_browse_rel_base(name);
    const char *filter = rtx_browse_filter(br);
    if (!base || base[0] != '.') return 0;
    if (filter[0] == '.') return 0;
    return 1;
}

static int rtx_browse_show_name(const RtxBrowse *br, const char *name, int is_dir) {
    const char *filter;
    if (!name || name[0] == 0) return 0;
    if (strcmp(name, ".") == 0 || strcmp(name, "..") == 0) return 0;
    if (rtx_browse_hidden(br, name)) return 0;
    filter = rtx_browse_filter(br);
    if (!filter[0]) return 1;
    /* `*.md` keeps every directory so you can still walk. Flattened `>`
     * lists files only; the walk itself decides which folders to enter. */
    if (is_dir && !rtx_browse_deep(br) && rtx_browse_glob_meta(filter)) return 1;
    if (rtx_browse_glob_match(filter, name)) return 1;
    /* `>*.md` is a normal glob on the basename, not only the relative path. */
    if (rtx_browse_deep(br))
        return rtx_browse_glob_match(filter, rtx_browse_rel_base(name));
    return 0;
}

static void rtx_browse_keep_cur(RtxBrowse *br, const char *keep) {
    size_t i;
    if (!br || !keep || !keep[0] || br->len == 0) {
        if (br) br->cur = 0;
        return;
    }
    for (i = 0; i < br->len; i++) {
        if (strcmp(br->ents[i].name, keep) == 0) {
            br->cur = i;
            return;
        }
    }
    if (br->cur >= br->len) br->cur = br->len - 1;
}

void !>(CCError) rtx_browse_refresh(RtxBrowse *br);

static void rtx_browse_scroll(RtxBrowse *br, int vis) {
    size_t list;
    if (!br) return;
    list = (vis > RTX_BROWSE_HEAD) ? (size_t)(vis - RTX_BROWSE_HEAD) : 1;
    if (br->len == 0) {
        br->cur = 0;
        br->top = 0;
        return;
    }
    if (br->cur >= br->len) br->cur = br->len - 1;
    if (br->cur < br->top) br->top = br->cur;
    if (br->cur >= br->top + list) br->top = br->cur - list + 1;
}

static void rtx_browse_move(RtxBrowse *br, int dir, int vis) {
    if (br) br->glob_focus = 0;
    if (!br || br->len == 0) return;
    if (dir < 0) {
        if (br->cur > 0) br->cur--;
    } else if (br->cur + 1 < br->len) {
        br->cur++;
    }
    rtx_browse_scroll(br, vis);
}

static int rtx_browse_hit(const RtxBrowse *br, int row, int vis) {
    size_t list, idx;
    (void)vis;
    if (!br || row < RTX_BROWSE_HEAD) return -1;
    list = (size_t)(row - RTX_BROWSE_HEAD);
    idx = br->top + list;
    if (idx >= br->len) return -1;
    return (int)idx;
}

#ifndef RTX_BROWSE_LIST
static RtxBrowse *RtxWs_browse_at(RtxWs *w, int pane) {
    if (!w || pane < 0 || pane >= 2) return NULL;
    return &w->nav[pane];
}

static RtxBrowse *RtxWs_browse(RtxWs *w) {
    if (!w) return NULL;
    return &w->nav[w->focus];
}

static int RtxWs_browsing(const RtxWs *w) {
    return w && w->nav[w->focus].on;
}

static void rtx_ws_same_split_seed(RtxWs *w) {
    RtxBuf *b;
    if (!w || w->npanes != 2 || w->pane[0] != w->pane[1] || w->side.live) return;
    b = &w->bufs[w->pane[0]];
    memset(&w->side, 0, sizeof(w->side));
    w->side.live = 1;
    w->side.top = b->top;
    w->side.top_wrap = b->top_wrap;
    w->side.top_byte = b->top_byte;
    w->side.unlock = b->unlock;
    w->side.layout.view = b->layout.view;
    w->side.layout.wrap = b->layout.wrap;
}

static int rtx_ws_find_path(const RtxWs *w, const char *path) {
    size_t i;
    if (!w || !path || !path[0]) return -1;
    for (i = 0; i < w->len; i++) {
        char[:] p = w->bufs[i].doc.path;
        if (p.ptr && strcmp(p.ptr, path) == 0) return (int)i;
    }
    return -1;
}

/* Point the focused pane at `path`. Same-file split keeps the other camera
 * on the old buf. A second pane on a different file is two ordinary bufs. */
static void !>(CCError) RtxWs_open_in_pane(RtxWs *w, const char *path) {
    int pane, bufi, found;
    if (!w || !path || !path[0]) return cc_err(CC_ERR_INVALID_ARG, "open path");
    pane = w->focus;
    found = rtx_ws_find_path(w, path);
    if (found >= 0) bufi = found;
    else if (RtxWs_untitled(w)) {
        w->bufs[0].destroy();
        memset(&w->bufs[0], 0, sizeof(w->bufs[0]));
        w->len = 0;
        w->add_path(path) !>(e) { return cc_err(e); };
        bufi = 0;
    } else {
        w->add_path(path) !>(e) { return cc_err(e); };
        bufi = (int)w->len - 1;
    }
    if (RtxWs_same_split(w) && w->pane[pane] != bufi) {
        if (w->focus == pane)
            rtx_buf_swap_cam(&w->bufs[w->pane[0]], &w->side);
        rtx_ws_side_drop(w);
    }
    w->pane[pane] = bufi;
    rtx_ws_same_split_seed(w);
    rtx_browse_drop(&w->nav[pane]);
    return cc_ok();
}

static void !>(CCError) RtxWs_browse_refresh(RtxWs *w, int pane) {
    RtxBrowse *br = RtxWs_browse_at(w, pane);
    if (!br) return cc_err(CC_ERR_INVALID_ARG, "browse pane");
    return rtx_browse_refresh(br);
}

static void !>(CCError) RtxWs_browse_start(RtxWs *w) {
    RtxBrowse *br;
    RtxBuf *b;
    char want[RTX_BROWSE_NAME];
    if (!w) return cc_err(CC_ERR_INVALID_ARG, "null ws");
    br = &w->nav[w->focus];
    b = RtxWs_active(w);
    want[0] = 0;
    rtx_browse_drop(br);
    br->on = 1;
    br->boot = RtxWs_untitled(w);
    if (b && b->doc.path.ptr && b->doc.path.len) {
        char rel[RTX_BROWSE_DIR];
        rtx_browse_dirname(rel, sizeof(rel), b->doc.path.ptr);
        rtx_browse_basename(want, sizeof(want), b->doc.path.ptr);
        if (!rtx_browse_abs(br->dir, sizeof(br->dir), rel))
            snprintf(br->dir, sizeof(br->dir), "%s", rel);
    }
    if (!br->dir[0] || strcmp(br->dir, ".") == 0) {
        if (!rtx_browse_abs(br->dir, sizeof(br->dir), "."))
            snprintf(br->dir, sizeof(br->dir), ".");
    }
    rtx_browse_refresh(br) !>(e) { return cc_err(e); };
    if (want[0]) rtx_browse_keep_cur(br, want);
    return cc_ok();
}

/* 1 = no file was picked from a boot browser; the host should exit. */
static int RtxWs_browse_close(RtxWs *w) {
    int quit = 0;
    if (!w) return 0;
    quit = w->nav[w->focus].boot && RtxWs_untitled(w);
    rtx_browse_drop(&w->nav[w->focus]);
    return quit;
}

static void !>(CCError) RtxWs_browse_enter(RtxWs *w) {
    RtxBrowse *br;
    RtxBrowseEnt *ent;
    char full[RTX_BROWSE_DIR];
    if (!w) return cc_err(CC_ERR_INVALID_ARG, "null ws");
    br = &w->nav[w->focus];
    if (!br->on || br->len == 0 || br->cur >= br->len) return cc_ok();
    ent = &br->ents[br->cur];
    if (!rtx_browse_join(full, sizeof(full), br->dir, ent->name))
        return cc_err(CC_ERR_INVALID_ARG, "browse path");
    if (ent->is_dir) {
        if (!rtx_browse_abs(br->dir, sizeof(br->dir), full))
            snprintf(br->dir, sizeof(br->dir), "%s", full);
        return rtx_browse_refresh(br);
    }
    return RtxWs_open_in_pane(w, full);
}

static void !>(CCError) RtxWs_browse_parent(RtxWs *w) {
    RtxBrowse *br;
    char next[RTX_BROWSE_DIR];
    if (!w) return cc_err(CC_ERR_INVALID_ARG, "null ws");
    br = &w->nav[w->focus];
    if (!br->on) return cc_ok();
    if (!rtx_browse_join(next, sizeof(next), br->dir, "..")) return cc_ok();
    snprintf(br->dir, sizeof(br->dir), "%s", next);
    return rtx_browse_refresh(br);
}

static void !>(CCError) RtxWs_browse_glob_set(RtxWs *w, const char *glob) {
    RtxBrowse *br;
    if (!w) return cc_err(CC_ERR_INVALID_ARG, "null ws");
    br = &w->nav[w->focus];
    if (!br->on) return cc_ok();
    if (!glob) glob = "";
    snprintf(br->glob, sizeof(br->glob), "%s", glob);
    br->glob_len = strlen(br->glob);
    br->glob_caret = br->glob_len;
    br->glob_sel = br->glob_len;
    return rtx_browse_refresh(br);
}

static RtxField rtx_browse_field(RtxBrowse *br) {
    RtxField f = {0};
    if (!br) return f;
    f.buf = br->glob;
    f.len = &br->glob_len;
    f.cap = sizeof(br->glob);
    f.caret = &br->glob_caret;
    f.sel = &br->glob_sel;
    return f;
}

static void !>(CCError) RtxWs_browse_type(RtxWs *w, int ch) {
    RtxBrowse *br;
    if (!w) return cc_err(CC_ERR_INVALID_ARG, "null ws");
    br = &w->nav[w->focus];
    if (!br->on) return cc_ok();
    if (rtx_field_type_cp(rtx_browse_field(br), (uint32_t)ch))
        return rtx_browse_refresh(br);
    return cc_ok();
}

static void !>(CCError) RtxWs_browse_backspace(RtxWs *w) {
    RtxBrowse *br;
    RtxField f;
    if (!w) return cc_err(CC_ERR_INVALID_ARG, "null ws");
    br = &w->nav[w->focus];
    if (!br->on) return cc_ok();
    f = rtx_browse_field(br);
    if (br->glob_len == 0 && !rtx_field_has_sel(f))
        return RtxWs_browse_parent(w);
    rtx_field_backspace(f);
    return rtx_browse_refresh(br);
}

#endif /* RTX_BROWSE_LIST */
#endif /* RTX_BROWSE_H */
