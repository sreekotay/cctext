void rtx_browse_basename(char *dst, size_t n, char[:0] path);
void rtx_browse_dirname(char *dst, size_t n, char[:0] path);
int rtx_browse_abs(char *dst, size_t n, char[:0] path);
int rtx_browse_join(char *dst, size_t n, char[:0] dir, char[:0] name);
static inline int rtx_path_is_dir(char[:0] path) {
    struct stat st;
    if (!path.ptr || path.len == 0) return 0;
    return stat(path.ptr, &st) == 0 && S_ISDIR(st.st_mode);
}
int rtx_open_url(const char *url);

enum {
    RTX_BROWSE_SIZE_W = 7,
    RTX_BROWSE_MTIME_W = 16 /* YYYY-MM-DD HH:MM */
};

/* Closed chrome palette. Same RGB + ANSI for both frontends. */
typedef enum {
    RTX_BROWSE_FACE_PATH = 0,
    RTX_BROWSE_FACE_GLOB,
    RTX_BROWSE_FACE_DIR,
    RTX_BROWSE_FACE_FILE,
    RTX_BROWSE_FACE_SIZE,
    RTX_BROWSE_FACE_DATE,
    RTX_BROWSE_FACE_HIT,
    RTX_BROWSE_FACE_EXT,  /* last suffix matches a loaded grammar */
    RTX_BROWSE_FACE_DENY  /* permission denied (size column / chip) */
} RtxBrowseFace;

#ifndef RTX_THEME_COLOR_TYPE
#define RTX_THEME_COLOR_TYPE
typedef struct {
    unsigned char r, g, b;
    const char *ansi;
} RtxThemeColor;
#endif

RtxThemeColor rtx_browse_face(RtxBrowseFace face);
void rtx_browse_fmt_size(char *dst, size_t n, const RtxBrowseEnt *e);
const char *rtx_browse_scan_msg(const RtxBrowse *br);
void rtx_browse_fmt_mtime(char *dst, size_t n, const RtxBrowseEnt *e);
void rtx_browse_fmt_meta(char *dst, size_t n, const RtxBrowseEnt *e);
void rtx_browse_fmt_row(char *dst, size_t n, int cols, const RtxBrowseEnt *e);
int rtx_browse_hit_span(const RtxBrowse *br, const char *name,
                        size_t *off, size_t *n);
size_t rtx_browse_dir_prefix(const char *name);

/* Listing | preview split. Too-narrow panes keep a full-width listing. */
#ifndef RTX_BROWSE_PREV_MIN
#define RTX_BROWSE_PREV_MIN 32
#endif
#ifndef RTX_BROWSE_LIST_MIN
#define RTX_BROWSE_LIST_MIN 28
#endif
#ifndef RTX_BROWSE_PREV_PX
#define RTX_BROWSE_PREV_PX 200
#endif
#ifndef RTX_BROWSE_LIST_PX
#define RTX_BROWSE_LIST_PX 160
#endif
/* pm is list/pane * 1000. 0 keeps the old default (preview at its minimum). */
static inline int rtx_browse_split_pm(int span, int whole) {
    int pm;
    if (whole < 1) return 0;
    if (span < 0) span = 0;
    if (span > whole) span = whole;
    pm = (int)(((long)span * 1000 + whole / 2) / whole);
    if (pm < 1) pm = 1;
    if (pm > 1000) pm = 1000;
    return pm;
}
static inline int rtx_browse_list_cols_at(int pcols, int pm) {
    int hi, want;
    if (pcols < RTX_BROWSE_PREV_MIN + RTX_BROWSE_LIST_MIN) return pcols;
    hi = pcols - RTX_BROWSE_PREV_MIN;
    if (pm <= 0) return hi;
    want = (int)(((long)pcols * pm + 500) / 1000);
    if (want < RTX_BROWSE_LIST_MIN) want = RTX_BROWSE_LIST_MIN;
    if (want > hi) want = hi;
    return want;
}
static inline int rtx_browse_list_cols(int pcols) {
    return rtx_browse_list_cols_at(pcols, 0);
}
static inline int rtx_browse_list_px_at(int pw, int pm) {
    int hi, want;
    if (pw < RTX_BROWSE_PREV_PX + RTX_BROWSE_LIST_PX) return pw;
    hi = pw - RTX_BROWSE_PREV_PX;
    if (pm <= 0) return hi;
    want = (int)(((long)pw * pm + 500) / 1000);
    if (want < RTX_BROWSE_LIST_PX) want = RTX_BROWSE_LIST_PX;
    if (want > hi) want = hi;
    return want;
}
static inline int rtx_browse_list_px(int pw) {
    return rtx_browse_list_px_at(pw, 0);
}
static inline void rtx_browse_split_set(int *slot, int whole, int at,
                                        int lo, int hi) {
    if (!slot || whole < 1) return;
    if (at < lo) at = lo;
    if (at > hi) at = hi;
    *slot = rtx_browse_split_pm(at, whole);
}

/* 1 while the dest-live arm has not been joined. */
int rtx_browse_listing_live(const RtxBrowse *br);

/* New listing is only `..` / divider rows; paint the last list instead.
 * Reads `ents` / `scanning`: the walk's side (a stage, or the host after
 * the join). The host asks rtx_browse_hold_on. */
static inline int rtx_browse_ents_ready(const RtxBrowse *br) {
    size_t i;
    if (!br || !br->ents.data || !br->ents.len) return 0;
    if (!br->scanning) return 1;
    for (i = 0; i < br->ents.len; i++) {
        if (br->ents.data[i].sep) continue;
        if (strcmp(br->ents.data[i].name, "..") == 0) continue;
        return 1;
    }
    return 0;
}
/* Host side. While the arm is live the hold is on iff the last publish
 * is the hold list; `hold` itself is host-owned (saved before the kick,
 * freed after the join). */
static inline int rtx_browse_hold_on(const RtxBrowse *br) {
    RtxBrowsePub *p;
    if (!br || !br->hold || !br->hold_len) return 0;
    if (rtx_browse_listing_live(br)) {
        p = atomic_load_explicit(&br->pub, memory_order_acquire);
        return p && p->ents == br->hold;
    }
    return !rtx_browse_ents_ready(br);
}
/* Host reads of walk-written flags. While the arm is live the walk owns
 * `scanning` / `truncated` / `denied`: live is scanning, and the other
 * two come from the last publish. */
static inline int rtx_browse_scanning(const RtxBrowse *br) {
    if (!br) return 0;
    if (rtx_browse_listing_live(br)) return 1;
    return br->scanning;
}
static inline int rtx_browse_truncated(const RtxBrowse *br) {
    RtxBrowsePub *p;
    if (!br) return 0;
    if (rtx_browse_listing_live(br)) {
        p = atomic_load_explicit(&br->pub, memory_order_acquire);
        return p ? p->truncated : 0;
    }
    return br->truncated;
}
static inline int rtx_browse_denied(const RtxBrowse *br) {
    RtxBrowsePub *p;
    if (!br) return 0;
    if (rtx_browse_listing_live(br)) {
        p = atomic_load_explicit(&br->pub, memory_order_acquire);
        return p ? p->denied : 0;
    }
    return br->denied;
}
/* While the arm is live this is the last published wave (or the host's
 * move on top of it). Otherwise the hold list or `ents`. One snap so
 * len and the pointer cannot come from different waves. */
static inline RtxBrowsePub rtx_browse_view_snap(const RtxBrowse *br) {
    RtxBrowsePub z;
    RtxBrowsePub *p;
    memset(&z, 0, sizeof z);
    if (!br) return z;
    if (rtx_browse_listing_live(br)) {
        p = atomic_load_explicit(&br->pub, memory_order_acquire);
        if (!p) return z;
        z = *p;
        if (br->host_nav) {
            z.cur = br->host_cur;
            z.top = br->host_top;
        }
        return z;
    }
    if (rtx_browse_hold_on(br)) {
        z.ents = br->hold;
        z.len = br->hold_len;
        z.cur = br->hold_cur;
        z.top = br->hold_top;
        return z;
    }
    z.ents = br->ents.data;
    z.len = br->ents.len;
    z.cur = br->cur;
    z.top = br->top;
    return z;
}
static inline const RtxBrowseEnt *rtx_browse_view_ents(const RtxBrowse *br) {
    return rtx_browse_view_snap(br).ents;
}
static inline size_t rtx_browse_view_len(const RtxBrowse *br) {
    return rtx_browse_view_snap(br).len;
}
static inline size_t rtx_browse_view_cur(const RtxBrowse *br) {
    return rtx_browse_view_snap(br).cur;
}
static inline size_t rtx_browse_view_top(const RtxBrowse *br) {
    return rtx_browse_view_snap(br).top;
}

/* Long names keep both ends (tail-biased): "dir/sub/very_long_file.c"
 * → "dir/~ile.c". `maxc` is terminal columns; `head_n` / `tail_off` are
 * byte offsets on cluster starts so UTF-8 is never split. */
static inline void rtx_browse_name_window(const char *name, int maxc,
                                          size_t *head_n, size_t *tail_off,
                                          int *ellip) {
    size_t n, i, head, tail;
    int total, budget, left, right, seen;
    char[:] b;
    if (head_n) *head_n = 0;
    if (tail_off) *tail_off = 0;
    if (ellip) *ellip = 0;
    if (!name || maxc < 1) return;
    n = strlen(name);
    b = cc_slice_from_buffer((void *)name, n);
    total = rtx_utf8_cols(b);
    if (head_n) *head_n = n;
    if (tail_off) *tail_off = n;
    if (total <= maxc) return;
    if (maxc == 1) {
        if (head_n) *head_n = 0;
        if (tail_off) *tail_off = n;
        if (ellip) *ellip = 1;
        return;
    }
    budget = maxc - 1; /* one column for '~' */
    /* Prefer the end (basename / extension) over the start. */
    left = budget / 3;
    right = budget - left;
    /* Suffix of at most `right` columns (cluster-aligned). */
    seen = 0;
    tail = n;
    for (i = 0; i < n; ) {
        RtxUtf8Cl cl = rtx_utf8_cluster(b, i);
        int c = cl.cols > 0 ? cl.cols : 1;
        size_t take = cl.n ? cl.n : 1;
        if (total - seen <= right) {
            tail = i;
            break;
        }
        seen += c;
        i += take;
    }
    /* Prefix of at most `left` columns, stopping before the suffix. */
    head = 0;
    seen = 0;
    for (i = 0; i < tail; ) {
        RtxUtf8Cl cl = rtx_utf8_cluster(b, i);
        int c = cl.cols > 0 ? cl.cols : 1;
        size_t take = cl.n ? cl.n : 1;
        if (seen + c > left) break;
        seen += c;
        i += take;
        head = i;
    }
    if (head_n) *head_n = head;
    if (tail_off) *tail_off = tail;
    if (ellip) *ellip = 1;
}

/* Face for name[i]. Hit wins; dirs stay DIR; a known suffix is EXT. */
static RtxBrowseFace rtx_browse_name_face(int is_dir, size_t i, size_t pref,
                                         size_t hit, size_t hn,
                                         size_t ext, size_t en) {
    if (hn && i >= hit && i < hit + hn) return RTX_BROWSE_FACE_HIT;
    if (is_dir || i < pref) return RTX_BROWSE_FACE_DIR;
    if (en && i >= ext && i < ext + en) return RTX_BROWSE_FACE_EXT;
    return RTX_BROWSE_FACE_FILE;
}

/* Folder totals use DIR. A paused incomplete total is DATE (gray). Files stay SIZE. */
static RtxBrowseFace rtx_browse_size_face(const RtxBrowse *br,
                                         const RtxBrowseEnt *e) {
    RtxBrowsePub v;
    int live;
    if (!e || !e->is_dir || !e->sized) return RTX_BROWSE_FACE_SIZE;
    if (e->size_denied) return RTX_BROWSE_FACE_DENY;
    v = rtx_browse_view_snap(br);
    live = v.ents && v.cur < v.len && e == &v.ents[v.cur];
    if (!e->size_done && !live) return RTX_BROWSE_FACE_DATE;
    return RTX_BROWSE_FACE_DIR;
}
