/*
 * Fuzzy subsequence scorer (owner: fuzzy.ccs). Plain C decls: the
 * command palette ranks commands with it; quick-open ranks paths.
 *
 * A pattern matches when its bytes appear in order in the string (ASCII
 * case folded; other bytes compare exactly). The score is the best
 * alignment: every matched byte earns a base, a byte at a word start
 * (string start, after a space / punctuation / path separator), a camel
 * hump (a..zA..Z, letter→digit), or right after the previous matched
 * byte earns a bonus, and gaps between matched bytes cost. A match at
 * the string's first byte earns the most (prefix). Ties go to the
 * shorter string. No allocation; strings past RTX_FUZZY_MAX_S bytes
 * score on their last RTX_FUZZY_MAX_S bytes (a path's basename end).
 */
#ifndef RTX_FUZZY_H
#define RTX_FUZZY_H

#include <stddef.h>

enum {
    RTX_FUZZY_MAX_P = 64,  /* longer patterns: no match */
    RTX_FUZZY_MAX_S = 512
};

/* Score of `pat` against `s`: >= 0 on a match (higher is better), -1 when
 * pat is not a subsequence. An empty pattern matches everything with 0. */
int rtx_fuzzy_score(const char *pat, size_t pn, const char *s, size_t sn);

/* Same, over NUL-terminated strings. */
int rtx_fuzzy_score_cstr(const char *pat, const char *s);

#endif /* RTX_FUZZY_H */
