/*
 * Shared help text, gutter width, and jump-to-line.
 */
#ifndef RTX_HELP_H
#define RTX_HELP_H

static const char *rtx_help_lines[] = {
    "Esc          toggle this menu",
    "g  Ctrl-G/J  jump to line",
    "s  Ctrl-S    save",
    "a  Ctrl-A    select all",
    "z  Ctrl-Z    undo",
    "y  Ctrl-Y    redo",
    "x  Ctrl-X    cut",
    "c  Ctrl-C    copy",
    "v  Ctrl-V    paste",
    "w  Ctrl-W    other pane",
    "n  Ctrl-N    next file",
    "\\  Ctrl-\\    split",
    "q  Ctrl-Q    quit  (again if unsaved)",
    "arrows       move   shift-arrows select",
    "Cmd-arrows   start/end of line",
    "click/drag   caret / selection",
    "wheel        scroll",
    NULL
};

typedef struct {
    int help;
    int jump;
    char jump_buf[16];
    size_t jump_len;
} RtxUi;

static void rtx_ui_clear_jump(RtxUi *ui) {
    if (!ui) return;
    ui->jump = 0;
    ui->jump_len = 0;
    ui->jump_buf[0] = 0;
}

static void rtx_ui_start_jump(RtxUi *ui) {
    if (!ui) return;
    ui->help = 0;
    ui->jump = 1;
    ui->jump_len = 0;
    ui->jump_buf[0] = 0;
}

static int rtx_gutter_cols(size_t nlines) {
    int w = 1;
    if (nlines == 0) nlines = 1;
    while (nlines >= 10) {
        nlines /= 10;
        w++;
    }
    return w + 1;
}

static void RtxDoc_goto_line(RtxDoc *d, size_t line1) {
    size_t n;
    if (!d) return;
    n = d->line_count();
    if (n == 0) return;
    if (line1 < 1) line1 = 1;
    if (line1 > n) line1 = n;
    d->caret = d->line_start(line1 - 1);
    d->sel_anchor = d->caret;
    d->break_coalesce();
}

static int rtx_ui_apply_jump(RtxUi *ui, RtxDoc *d) {
    size_t line = 0;
    size_t i;
    if (!ui || !d || ui->jump_len == 0) {
        rtx_ui_clear_jump(ui);
        return 0;
    }
    for (i = 0; i < ui->jump_len; i++) {
        line = line * 10 + (size_t)(ui->jump_buf[i] - '0');
    }
    d->goto_line(line);
    rtx_ui_clear_jump(ui);
    return 1;
}

static int rtx_ui_jump_char(RtxUi *ui, int ch) {
    if (!ui || !ui->jump) return 0;
    if (ch >= '0' && ch <= '9' && ui->jump_len + 1 < sizeof(ui->jump_buf)) {
        ui->jump_buf[ui->jump_len++] = (char)ch;
        ui->jump_buf[ui->jump_len] = 0;
        return 1;
    }
    return 0;
}

#endif /* RTX_HELP_H */
