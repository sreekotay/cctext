#ifndef RTX_TM_H
#define RTX_TM_H

/*
 * Lowered TextMate runtime: classified matchers + a begin/end stack.
 * Grammars are *.tmLanguage.json loaded at first use. Directory is
 * RTX_GRAMMARS, else <exe>/grammars, else <exe>/../testdata/grammars.
 * Leftover match / begin / end patterns compile once at load with the
 * regex engine (rx.cch) onto the TM store. Each rule stores a first-byte
 * gate (-1 = any; regex rules also test the program's first-byte set).
 * Regex rules see one line at a time (the line and its newline), the
 * way TextMate feeds Oniguruma. `\\.` is ESC_DOT; 1-byte spans
 * memchr to the closer / backslash instead of walking every byte.
 * Rules / patterns are Vecs on a process TM store; match strings
 * intern there so bind pointers survive grow. Bodies in document.ccs.
 */

#include <dirent.h>
#include <time.h>
#include <limits.h>
#include <unistd.h>
#ifdef __APPLE__
#include <mach-o/dyld.h>
#endif
#include "rx.cch"

typedef enum {
    RTX_TM_SKIP = 0,
    RTX_TM_LIT_LINE,   /* literal, then to end of line */
    RTX_TM_LIT_SPAN,   /* begin literal … end literal (stack) */
    RTX_TM_RE_SPAN,    /* begin/end regex (ra / rb); a/b are the patterns */
    RTX_TM_KEYWORDS,   /* identifier in a '|' list */
    RTX_TM_DIGITS,
    RTX_TM_REGEX,      /* leftover TM match */
    RTX_TM_ESC_DOT,    /* \\. — backslash + one non-newline */
} RtxTmOp;

#define RTX_TM_CAPS 8

typedef struct {
    RtxTmOp op;
    RtxScope scope;
    const char *a;
    const char *b;
    size_t alen;
    size_t blen;
    const RtxRx *ra; /* REGEX match / RE_SPAN begin, on the TM store */
    const RtxRx *rb; /* RE_SPAN end; \\1-\\9 read the begin captures */
    size_t inner0;
    size_t innern;
    RtxScope cap[RTX_TM_CAPS];
    signed short first; /* -1 = any starting byte */
    unsigned char has_cap;
    unsigned char bol; /* span: begin and end must sit at line start (`cctext.bol`) */
    unsigned char inl; /* span: unclosed at EOL → the opener is plain text (`cctext.inline`) */
    unsigned char flank; /* span: RTX_FLANK_* delimiter-run rule (`cctext.flank`) */
    unsigned char exact; /* span: begin / end are a whole run of their byte (`cctext.exact`) */
    unsigned char abort; /* span: this byte (not a closer, not an inner) drops the frame */
    unsigned char block; /* RTX_MDB_ROLE_*: planted by the Markdown block pass, never tried */
    unsigned char self_in; /* span: inners include the grammar's own rules (`$self`) */
    unsigned char info; /* span: bytes after begin to EOL pick a guest grammar (`cctext.info`) */
    const char *embed_scope; /* interned `include: source.x` on a span; resolved at lex */
    /* Effective style bits, copied onto every run this rule plants: the
     * pattern's `"cctext": { "bold", "italic", "mono" }` sidecar when
     * present, else rtx_scope_default_bits(scope). `cap_bits[g]` is the
     * default for capture scope g. `apply` is the toolbar / cycle name;
     * `insert` is the prefix unit and `max` is how many stack. */
    unsigned char sc_bold;
    unsigned char sc_italic;
    unsigned char sc_mono;
    unsigned char sc_strike;
    unsigned char cap_bits[RTX_TM_CAPS]; /* RTX_SBIT_* */
    const char *sc_apply;
    const char *sc_insert; /* prefix unit, or wrap bookends (`<>` + wrap 1) */
    unsigned char sc_max;  /* stacked insert units; 0 → 1 */
    unsigned char mark; /* RTX_ARITY_* + RTX_MARK_DEST from cctext.arity / face */
    unsigned char sc_wrap; /* match: plant this many hint bytes on each end */
    unsigned char sc_mark; /* pattern set a topology key (`arity` / `face` / `wrap`):
                            * it plants hints even outside a markup grammar */
} RtxTmRule;

#define RTX_APPLY_MAX 16
#define RTX_TM_PAIRS 12
#define RTX_TM_PAIRS_BYTES 25 /* 2 * RTX_TM_PAIRS + 1 (a literal: claude.md) */
enum {
    RTX_APPLY_PREFIX = 1,
    RTX_APPLY_PAIR = 2,
    RTX_APPLY_PATH = 3,
    RTX_APPLY_TOGGLE = 4
};
typedef struct {
    const char *name;
    unsigned char kind; /* RTX_APPLY_* */
} RtxApplyEnt;

/* `cctext.flank`: CommonMark delimiter runs. STAR (`true`): the opener
 * is left-flanking, the closer right-flanking. UNDER: `_` rules — also no
 * intraword open / close. MATH: `$` — opener not before whitespace,
 * closer not after it and not before a digit. An empty span never closes. */
enum {
    RTX_FLANK_NONE = 0,
    RTX_FLANK_STAR = 1,
    RTX_FLANK_UNDER = 2,
    RTX_FLANK_MATH = 3
};

/* `cctext.block`: which Markdown block-pass role a rule plants (md_block.cch).
 * The pass decides where; the rule gives scope, bits, arity, apply, tag. */
enum {
    RTX_MDB_ROLE_NONE = 0,
    RTX_MDB_ROLE_FENCE,
    RTX_MDB_ROLE_HEADING,
    RTX_MDB_ROLE_HEADING_CLOSE,
    RTX_MDB_ROLE_SETEXT,
    RTX_MDB_ROLE_QUOTE,
    RTX_MDB_ROLE_LIST,
    RTX_MDB_ROLE_TASK,
    RTX_MDB_ROLE_HR,
    RTX_MDB_ROLE_CODE,
    RTX_MDB_ROLE_HTML,
    RTX_MDB_ROLE_MATH,
    RTX_MDB_ROLE_FRONT,
    RTX_MDB_ROLE_REF,
    RTX_MDB_ROLE_REF_DEST,
    RTX_MDB_ROLE_FOOT,
    RTX_MDB_ROLE_N
};

typedef struct {
    Vec::[RtxTmRule] rules;
    Vec::[RtxTmRule] inners;
    char exts[16][16];
    size_t n_exts;
    int markup; /* grammar-level `"cctext": { "kind": "markup" }` → RTX_SEC_MARKUP */
    int blocks; /* `"cctext": { "blocks": "commonmark" }`: the Markdown block pass
                 * owns block structure; the grammar lexes inline content */
    short blk[RTX_MDB_ROLE_N]; /* rules index per role, -1 = none */
    const char *scope; /* interned `scopeName`; NULL if the JSON omitted it */
    const char *title; /* interned display `name` */
    /* Auto-close pairs, opener then closer, one byte each: grammar-level
     * `"cctext": { "pairs": "()[]" }` or the VS Code style top-level
     * `autoClosingPairs` (single-byte entries). pairs_set: the grammar
     * named its own table (an empty one turns auto-pairs off). */
    char pairs[RTX_TM_PAIRS_BYTES];
    int pairs_set;
} RtxTmRt;

/* Begin/end stack. A frame is (rule tag, grammar index, opener off, embed).
 * Inner LIT_SPAN / RE_SPAN may open (allow_span = 1), so sp exceeds 1 for
 * nested marks and for a guest span inside a host fence. Guest rules run
 * only while the host frame is open. The current closer is always tested
 * first: italic `*` must not steal bold `**`, and fence ``` / `</script>`
 * win over an unclosed guest. `cctext.flank` keeps `*outer **inner**`
 * from closing on the space before `**`. A RE_SPAN end reads `\\1`–`\\9` from the
 * frame's begin captures (window offsets; not on RtxTmCkpt, so a resume
 * mid-heredoc does not close). `\\G` is the end of the frame's begin. */
#define RTX_TM_STACK 32
#define RTX_TM_NO_LANG 0xffffu
#define RTX_TM_INNER 0x8000u

/* Interned pattern. Strings live on the process TM store. */
typedef struct {
    const char *name;
    const char *match;
    const char *begin;
    const char *end;
    const char *incl;
    const char *capn[RTX_TM_CAPS];
    size_t kid0;
    size_t n_kids;
    unsigned char sc_has; /* `cctext` had a style key: sidecar wins over defaults */
    unsigned char sc_bol; /* `cctext.bol`: line-anchored literal begin / end */
    unsigned char sc_inl; /* `cctext.inline`: span may not cross a line end */
    unsigned char sc_flank; /* `cctext.flank`: RTX_FLANK_* */
    unsigned char sc_exact; /* `cctext.exact`: begin / end are a whole delimiter run */
    unsigned char sc_abort; /* `cctext.abort`: byte that drops an open span */
    unsigned char sc_block; /* `cctext.block`: RTX_MDB_ROLE_* */
    unsigned char sc_strike;
    unsigned char sc_info; /* `cctext.info`: opener line after begin is an info string */
    unsigned char sc_bold;
    unsigned char sc_italic;
    unsigned char sc_mono;
    const char *sc_apply; /* interned; "" when absent */
    const char *sc_insert; /* interned prefix unit / wrap bookends; "" when absent */
    unsigned char sc_arity; /* RTX_ARITY_* */
    unsigned char sc_dest;  /* 1 = path dest face */
    unsigned char sc_lit;   /* force LIT_SPAN when begin/end are regex meta */
    unsigned char sc_wrap;  /* match: hint_a = hint_b = N */
    unsigned char sc_max;   /* stacked insert units; 0 → 1 */
    unsigned char sc_mark;  /* had `arity` / `face` / `wrap`: opts into hints */
} RtxTmPat;

typedef struct {
    const char *key;
    RtxTmPat pat;
} RtxTmRepoEnt;

typedef struct {
    Vec::[RtxTmPat] pats;
    Vec::[RtxTmPat] kids;
    RtxTmRt rt;
    /* Registered from metadata (name / scopeName / fileTypes: rt.title,
     * rt.scope, rt.exts) at the dir scan; rules are loaded and compiled
     * the first time a lookup hands this grammar out. `ready` / `failed`
     * are read with acquire loads, set under the load lock. */
    const char *src; /* interned grammar path */
    int meta;        /* title / scope / exts came from the scan */
    int ready;
    int failed;      /* full load failed: lookups skip it */
} RtxTmLang;

extern size_t rtx_tm_nlangs;     /* grammars registered by the dir scan */
extern char rtx_tm_load_dir[256];
extern size_t rtx_tm_load_us;     /* scan + every full load so far */
extern size_t rtx_tm_load_files;  /* files registered */
extern size_t rtx_tm_nready;      /* grammars fully loaded (lazily) */
/* Grammar patterns the regex engine refused (the rule is dropped). */
extern size_t rtx_tm_rx_errors;
extern char rtx_tm_rx_err[160];

typedef struct {
    const char *s;
    size_t n;
    size_t i;
} RtxJw;

/* The grammar loader's JSON reader (document.ccs); keymap.ccs reads
 * keys.json / settings.json with it. Each skips leading whitespace;
 * 0 = not there / malformed (j->i is then unspecified). */
void rtx_jw_ws(RtxJw *j);
int rtx_jw_eat(RtxJw *j, char c);
int rtx_jw_string(RtxJw *j, char *dst, size_t cap);
int rtx_jw_skip(RtxJw *j);
int rtx_jw_bool(RtxJw *j, int *out);

RtxTmRt *rtx_tm_c_rt(void);
RtxTmRt *rtx_tm_json_rt(void);
RtxTmRt *rtx_tm_md_rt(void);
const RtxTmRt *rtx_tm_for_path(const char *path);
const RtxTmRt *rtx_tm_rt_for_scope(const char *scope);
/* Info-string / fence language (`python`, `js`) → loaded grammar, or NULL. */
const RtxTmRt *rtx_tm_rt_for_info(const char *s, size_t n);
/* 1 if the basename's last suffix is a loaded grammar. Includes the dot. */
int rtx_tm_ext_span(const char *name, size_t *off, size_t *n);
/* Unique `cctext.apply` names in grammar order (rules, then inners).
 * Kind is derived from arity + insert/wrap — not a sidecar key. */
size_t rtx_tm_apply_list(const RtxTmRt *rt, RtxApplyEnt *out, size_t cap);

#endif /* RTX_TM_H */
