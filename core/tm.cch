#ifndef RTX_TM_H
#define RTX_TM_H

/*
 * Lowered TextMate runtime: classified matchers + a begin/end stack.
 * Grammars are *.tmLanguage.json loaded at first use. Directory is
 * RTX_GRAMMARS, else <exe>/grammars, else <exe>/../testdata/grammars.
 * Leftover match patterns use the tiny regex in tm_re.cch (not Onig).
 * Each rule stores a first-byte gate (-1 = any). Regex without captures
 * uses rtx_re_match, not match_caps. `\\.` is ESC_DOT; 1-byte spans
 * memchr to the closer / backslash instead of walking every byte.
 * Rules / patterns are Vecs on a process TM store; match strings
 * intern there so bind pointers survive grow. Bodies in document.ccs.
 */

#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <dirent.h>
#include <time.h>
#include <limits.h>
#include <unistd.h>
#ifdef __APPLE__
#include <mach-o/dyld.h>
#endif
#include "tm_re.cch"

typedef enum {
    RTX_TM_SKIP = 0,
    RTX_TM_LIT_LINE,   /* literal, then to end of line */
    RTX_TM_LIT_SPAN,   /* begin literal … end literal (stack) */
    RTX_TM_KEYWORDS,   /* identifier in a '|' list */
    RTX_TM_DIGITS,
    RTX_TM_REGEX,      /* leftover TM match */
    RTX_TM_ESC_DOT,    /* \\. — backslash + one non-newline */
} RtxTmOp;

#define RTX_TM_CAPS 8

typedef struct {
    RtxTmOp op;
    RtxScope scope;
    const char *a;
    const char *b;
    size_t alen;
    size_t blen;
    size_t inner0;
    size_t innern;
    RtxScope cap[RTX_TM_CAPS];
    signed short first; /* -1 = any starting byte */
    unsigned char has_cap;
    unsigned char bol; /* LIT_SPAN: begin and end must sit at line start (`cctext.bol`) */
    unsigned char inl; /* LIT_SPAN: unclosed at EOL → the opener is plain text (`cctext.inline`) */
    unsigned char flank; /* LIT_SPAN: opener not before, closer not after, whitespace (`cctext.flank`) */
    /* Effective style bits, copied onto every run this rule plants: the
     * pattern's `"cctext": { "bold", "italic", "mono" }` sidecar when
     * present, else rtx_scope_default_bits(scope). `cap_bits[g]` is the
     * default for capture scope g. `apply` is interned on the process TM
     * store, or NULL; nothing consumes it yet. */
    unsigned char sc_bold;
    unsigned char sc_italic;
    unsigned char sc_mono;
    unsigned char cap_bits[RTX_TM_CAPS]; /* RTX_SBIT_* */
    const char *sc_apply;
} RtxTmRule;

typedef struct {
    Vec::[RtxTmRule] rules;
    Vec::[RtxTmRule] inners;
    char exts[16][16];
    size_t n_exts;
    int markup; /* grammar-level `"cctext": { "kind": "markup" }` → RTX_SEC_MARKUP */
} RtxTmRt;

/* Honesty: span nesting depth is 1 today. rtx_tm_try_rule only opens a
 * LIT_SPAN with allow_span, and rtx_tm_lex passes allow_span = 1 only at
 * depth 0 (inner rules get 0), so sp never exceeds 1. RTX_TM_STACK sizes
 * the stack / checkpoint arrays for a deeper walker that does not exist yet. */
#define RTX_TM_STACK 32

/* Interned pattern. Strings live on the process TM store. */
typedef struct {
    const char *name;
    const char *match;
    const char *begin;
    const char *end;
    const char *incl;
    const char *capn[RTX_TM_CAPS];
    size_t kid0;
    size_t n_kids;
    unsigned char sc_has; /* `cctext` had a style key: sidecar wins over defaults */
    unsigned char sc_bol; /* `cctext.bol`: line-anchored literal begin / end */
    unsigned char sc_inl; /* `cctext.inline`: span may not cross a line end */
    unsigned char sc_flank; /* `cctext.flank`: CommonMark-style flanking delimiters */
    unsigned char sc_bold;
    unsigned char sc_italic;
    unsigned char sc_mono;
    const char *sc_apply; /* interned; "" when absent */
} RtxTmPat;

typedef struct {
    const char *key;
    RtxTmPat pat;
} RtxTmRepoEnt;

typedef struct {
    Vec::[RtxTmPat] pats;
    Vec::[RtxTmPat] kids;
    RtxTmRt rt;
    int ready;
} RtxTmLang;

extern size_t rtx_tm_nlangs;
extern char rtx_tm_load_dir[256];
extern size_t rtx_tm_load_us;
extern size_t rtx_tm_load_files;

typedef struct {
    const char *s;
    size_t n;
    size_t i;
} RtxJw;

RtxTmRt *rtx_tm_c_rt(void);
RtxTmRt *rtx_tm_json_rt(void);
RtxTmRt *rtx_tm_md_rt(void);
const RtxTmRt *rtx_tm_for_path(const char *path);
/* 1 if the basename's last suffix is a loaded grammar. Includes the dot. */
int rtx_tm_ext_span(const char *name, size_t *off, size_t *n);

#endif /* RTX_TM_H */
