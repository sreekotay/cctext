#!ccc cch
/*
 * Order-statistic piece tree: page store (path original + spilled add) or
 * borrowed buffer, pieces in a red-black tree weighted by byte length and
 * '\n' count.
 *
 * Types + this allow-list live here; bodies in piece_tree.ccs (linked TU).
 * Still split for readability into that one unit — the file cut is not an API:
 *   piece_tree_rb.cch    — RB ops + find_node
 *   piece_tree_lines.cch — stride index + line_*
 *
 * Offset lookup is O(log pieces). Line lookup uses a stride index so a
 * single original piece is not an O(file) scan. Store-backed bytes are
 * not returnable views (DESIGN: lifetime is a field). Nodes and line
 * index share the tree arena (document epoch). Fragmented or store-backed
 * ranges copy onto caller scratch via read_at.
 *
 * Callers use the functions below. Content mutation is `replace`
 * (offset in `[0, len]`, `n <= len - off`). `insert` / `erase` stay in
 * the TU. Peel `.tree` for write_fd. Node walk, RB, and stride patch
 * stay in the TU.
 */
#ifndef RTX_PIECE_TREE_H
#define RTX_PIECE_TREE_H

#include <ccc/std/prelude.cch>
#include <string.h>

#include "page_store.cch"

/*
 * Progressive line-index faults. Distinct from CCError on purpose: no
 * `@typeview { as: base; }` — @errhandler must not merge with save/edit
 * (DESIGN Surfaces).
 */
typedef struct {
    const char *message;
} RtxIndexErr;

static inline RtxIndexErr rtx_index_err(const char *msg) {
    RtxIndexErr e;
    e.message = msg ? msg : "line index";
    return e;
}

static inline RtxIndexErr rtx_index_from_cc(CCError e) {
    return rtx_index_err(e.message);
}

/* Call-local scratch (row / replace / copy). Not the page cache. */
#define RTX_FRAME_SCRATCH 8192
/* Stride-index interval. Property smokes pin it; line_* hide the slots. */
#define RTX_LINE_STRIDE 64
/* Above this, edits stay progressive (scan to the offset, no suffix rebuild).
 * Same ballpark as RTX_HL_FULL_MAX / RTX_MARKUP_SCAN_MAX — a 2MiB first
 * keystroke must not finish a full-file index. */
#define RTX_LINE_SOFT_MIN (256 * 1024)
/* tree.replace rollback failed. Doc copies this kind onto `broken`. */
#define RTX_ERR_UNRESTORABLE ((CCErrorKind)(CC_ERR_USER + 1))

static inline int rtx_err_is_unrestorable(CCError e) {
    return e.kind == RTX_ERR_UNRESTORABLE;
}

typedef struct RtxNode RtxNode;
typedef struct RtxPieceTree RtxPieceTree;

/* Optional UI pulse while a long scan/save runs on this tree.
 * Frontends bind via w.busy_bind; headless smokes leave it NULL. */
typedef void (*RtxBusyFn)(void *ctx, const char *label, int pct);

/* Insert-path timings for insert_profile.ccs. Not a product surface. */
typedef struct {
    double prepare_ms;
    double split_ms;
    double add_ms;
    double note_ms;
    int lf_ready0;
    int lf_ready1;
    int huge;
    int extended;
    size_t scan0;
    size_t scan1;
    size_t line_off0;
    size_t line_off1;
} RtxInsertProf;

struct RtxPieceTree {
    RtxNode *root;
    RtxNode *free_list;
    CCArena arena_storage;
    CCArena *arena;
    /* Borrowed from_buffer only; empty for from_path (store-backed). */
    char[:] original;
    RtxPageStore store;
    size_t add_len; /* == store.add_len; tip-extend sentinel */
    /* Start offset of every RTX_LINE_STRIDE-th line. */
    size_t *line_off;
    size_t line_off_len;
    size_t line_off_cap;
    int line_off_ok;
    /* Set when a line_* scan hits I/O/OOM; clears line_off_ok. */
    int line_index_fault;
    /* When set, insert/erase skip stride updates (caller patches once). */
    int line_off_suspend;
    /* 0 after store-backed from_path until a newline pass reaches EOF.
     * Open must not scan the body (DESIGN: open is instant). */
    int lf_ready;
    /* Progressive newline scan (valid when !lf_ready). */
    size_t line_scan_off;  /* next byte to read */
    size_t scan_line;      /* newlines seen so far */
    /* One mid-file island. % jump plants it; a pump walks backward to the
     * prefix. Not a second line_off — gutter uses +N / -L until they meet. */
    size_t isle_anchor;
    size_t isle_from;
    size_t isle_to;
    size_t isle_before;    /* LFs in [isle_from, isle_anchor) */
    size_t isle_after;
    unsigned isle_live : 1;
    unsigned isle_cancel : 1;
    size_t want_line;      /* 1-based g L; 0 = none. Prefix pump, not isle. */
    /* UI progress drawer (session binding; survives destroy/reopen). */
    RtxBusyFn busy_fn;
    void *busy_ctx;
    double busy_last_ms;
};

static inline int RtxPieceTree_is_live(const RtxPieceTree *t) {
    return t && (t->arena != NULL || rtx_page_store_is_open(&t->store) ||
                 t->original.ptr != NULL);
}

static inline void RtxPieceTree_busy_bind(RtxPieceTree *t, RtxBusyFn fn, void *ctx) {
    if (!t) return;
    t->busy_fn = fn;
    t->busy_ctx = ctx;
    t->busy_last_ms = 0.0;
}

static inline int RtxPieceTree_lf_ready(const RtxPieceTree *t) {
    return t && t->lf_ready;
}

static inline int RtxPieceTree_index_fault(const RtxPieceTree *t) {
    return t && t->line_index_fault;
}

/* 1 if line_of(off) is a covered lookup (will not scan). */
static inline int RtxPieceTree_index_covers(const RtxPieceTree *t, size_t off) {
    if (!t) return 1;
    if (t->lf_ready) return 1;
    return off <= t->line_scan_off;
}

void RtxPieceTree_destroy(RtxPieceTree *t);
void !>(CCError) RtxPieceTree_empty(RtxPieceTree *t);
void !>(CCError) RtxPieceTree_from_buffer(RtxPieceTree *t, char[:] bytes);
void !>(CCError) RtxPieceTree_from_path(RtxPieceTree *t, const char *path);
size_t RtxPieceTree_len(const RtxPieceTree *t);
size_t !>(CCError) RtxPieceTree_read_at(const RtxPieceTree *t, size_t offset,
                                        char *dest, size_t n);
size_t !>(CCError) RtxPieceTree_read_uncached(const RtxPieceTree *t, size_t offset,
                                              char *dest, size_t n);
char[:] RtxPieceTree_span(const RtxPieceTree *t, size_t from, size_t n);
char[:] !>(CCError) RtxPieceTree_scratch_span(const RtxPieceTree *t, CCArena *scratch,
                                              size_t from, size_t n);
size_t RtxPieceTree_line_count(const RtxPieceTree *t);
size_t RtxPieceTree_line_known(const RtxPieceTree *t);
size_t RtxPieceTree_line_guess(const RtxPieceTree *t, size_t off);
size_t !>(RtxIndexErr) RtxPieceTree_line_start(const RtxPieceTree *t, size_t line);
/* Covered lookup only. Uncovered offsets error — they do not scan.
 * Pumps and tests that need the index call rtx_line_scan_to. */
size_t !>(RtxIndexErr) RtxPieceTree_line_of(const RtxPieceTree *t, size_t offset);
void !>(RtxIndexErr) rtx_line_scan_to(RtxPieceTree *t, size_t want_off);

#define RTX_LINE_ISLE_BUDGET (256 * 1024)
#define RTX_LINE_ISLE_WORK_MS 48
#define RTX_LINE_ISLE_PAINT_MS 50

void rtx_line_isle_kick(RtxPieceTree *t, size_t at);
void rtx_line_isle_cancel(RtxPieceTree *t);
size_t rtx_line_isle_step(RtxPieceTree *t, size_t budget);
void rtx_line_want_kick(RtxPieceTree *t, size_t line1);
void rtx_line_want_cancel(RtxPieceTree *t);
size_t rtx_line_want_step(RtxPieceTree *t, size_t budget);

static inline int rtx_line_isle_live(const RtxPieceTree *t) {
    return t && t->isle_live && !t->isle_cancel;
}

static inline int rtx_line_isle_pumping(const RtxPieceTree *t) {
    return rtx_line_isle_live(t) && !t->lf_ready && t->isle_from > t->line_scan_off;
}

static inline int rtx_line_isle_connected(const RtxPieceTree *t) {
    return rtx_line_isle_live(t) && t->isle_from <= t->line_scan_off;
}

/* `done * 100` as int32 wraps past ~21M (a 248M-line g L sits on 0%). */
static inline int rtx_pct(size_t done, size_t total) {
    unsigned long long d, t;
    if (total == 0) return 0;
    if (done >= total) return 100;
    d = (unsigned long long)done;
    t = (unsigned long long)total;
    return (int)((d * 100ull) / t);
}

static inline int rtx_line_isle_pct(const RtxPieceTree *t) {
    size_t span, done;
    if (!rtx_line_isle_pumping(t)) return -1;
    span = t->isle_anchor > t->line_scan_off ? t->isle_anchor - t->line_scan_off : 1;
    done = t->isle_anchor > t->isle_from ? t->isle_anchor - t->isle_from : 0;
    return rtx_pct(done, span);
}

static inline size_t rtx_line_known_now(const RtxPieceTree *t) {
    if (!t) return 1;
    return t->scan_line + 1;
}

static inline int rtx_line_want_reached(const RtxPieceTree *t) {
    size_t n;
    if (!t || !t->want_line) return 0;
    if (t->lf_ready) return 1;
    n = RtxPieceTree_len(t);
    if (t->line_scan_off >= n) return 1;
    return t->scan_line + 1 >= t->want_line;
}

static inline int rtx_line_want_pumping(const RtxPieceTree *t) {
    return t && t->want_line && !rtx_line_want_reached(t);
}

static inline int rtx_line_want_pct(const RtxPieceTree *t) {
    size_t have;
    if (!t || !t->want_line) return -1;
    if (rtx_line_want_reached(t)) return 100;
    have = t->scan_line + 1;
    return rtx_pct(have, t->want_line);
}
/* Descriptor of a (possibly clipped) piece covering a byte range.
 * `buf` is 0 original / 1 add. Bytes stay in those buffers; hist/undo
 * splice these back instead of copying the payload. */
typedef struct {
    unsigned char buf;
    size_t start;
    size_t len;
    size_t lf_count;
} RtxPieceRef;

void !>(CCError) RtxPieceTree_replace(RtxPieceTree *t, size_t off, size_t n, char[:] ins);
void !>(CCError) RtxPieceTree_capture_range(const RtxPieceTree *t, size_t off, size_t n,
                                            CCArena *a, RtxPieceRef **out, size_t *nout);
void !>(CCError) RtxPieceTree_splice_refs(RtxPieceTree *t, size_t off,
                                          const RtxPieceRef *refs, size_t nrefs);
size_t !>(CCError) RtxPieceTree_append_copy(RtxPieceTree *t, size_t from, size_t n);
void !>(CCError) RtxPieceTree_write_fd(RtxPieceTree *t, int fd);
int RtxPieceTree_check(const RtxPieceTree *t);
void RtxPieceTree_profile_insert(RtxPieceTree *t, int on);
RtxInsertProf RtxPieceTree_insert_prof(const RtxPieceTree *t);
/* One-shot diagnostic: next replace does not mutate.
 * unrestorable != 0 → RTX_ERR_UNRESTORABLE (doc sets broken). */
void RtxPieceTree_fail_next_replace(RtxPieceTree *t, int unrestorable);

@typehooks on RtxPieceTree {
    .destroy = RtxPieceTree_destroy,
};

#endif /* RTX_PIECE_TREE_H */
