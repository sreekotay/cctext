#!ccc cch
/*
 * Order-statistic piece tree: page store (path original + spilled add) or
 * borrowed buffer, pieces in a red-black tree weighted by byte length and
 * '\n' count.
 *
 * Offset lookup is O(log pieces). Line lookup uses a stride index so a
 * single original piece is not an O(file) scan. Store-backed bytes are
 * not returnable views (DESIGN: lifetime is a field). Nodes and line
 * index share the tree arena (document epoch). Fragmented or store-backed
 * ranges copy onto caller scratch via read_at.
 */
#ifndef RTX_PIECE_TREE_H
#define RTX_PIECE_TREE_H

#include <ccc/std/prelude.cch>
#include <errno.h>
#include <fcntl.h>
#include <unistd.h>
#include <stdlib.h>
#include <string.h>
#include <sys/stat.h>

/* Page store (document-epoch fds + LRU). Embedded here because Concurrent-C
 * does not lower nested local .cch includes — see FRICTION.md. */
#ifndef RTX_PAGE_STORE_H
#define RTX_PAGE_STORE_H

#include <ccc/std/prelude.cch>
#include <errno.h>
#include <fcntl.h>
#include <stdlib.h>
#include <string.h>
#include <sys/stat.h>
#include <unistd.h>

#define RTX_PAGE_SIZE (64 * 1024)
#define RTX_PAGE_CACHE_DEFAULT 256

typedef enum {
    RTX_STORE_ORIG = 0,
    RTX_STORE_ADD = 1,
} RtxStoreFile;

typedef struct {
    int file_id; /* -1 = empty slot; else RtxStoreFile */
    size_t page_index;
    char *bytes;
    size_t valid; /* valid prefix length in bytes[] */
    size_t lru_prev;
    size_t lru_next;
} RtxPageSlot;

typedef struct {
    int orig_fd; /* meaningful only if orig_open */
    int orig_open;
    size_t orig_len;
    int add_fd; /* meaningful only if add_open */
    int add_open;
    size_t add_len;
    RtxPageSlot *slots;
    size_t slot_n;
    size_t lru_head; /* MRU */
    size_t lru_tail; /* LRU */
    int slots_linked;
} RtxPageStore;

static void rtx_page_store_zero(RtxPageStore *s) {
    if (!s) return;
    memset(s, 0, sizeof(*s));
    s->orig_fd = -1;
    s->add_fd = -1;
}

static int rtx_page_store_is_open(const RtxPageStore *s) {
    return s && (s->orig_open || s->add_open);
}

static void rtx_page_lru_unlink(RtxPageStore *s, size_t i) {
    RtxPageSlot *p = &s->slots[i];
    if (p->lru_prev == (size_t)-1) s->lru_head = p->lru_next;
    else s->slots[p->lru_prev].lru_next = p->lru_next;
    if (p->lru_next == (size_t)-1) s->lru_tail = p->lru_prev;
    else s->slots[p->lru_next].lru_prev = p->lru_prev;
    p->lru_prev = (size_t)-1;
    p->lru_next = (size_t)-1;
}

static void rtx_page_lru_push_head(RtxPageStore *s, size_t i) {
    RtxPageSlot *p = &s->slots[i];
    p->lru_prev = (size_t)-1;
    p->lru_next = s->lru_head;
    if (s->lru_head == (size_t)-1) s->lru_tail = i;
    else s->slots[s->lru_head].lru_prev = i;
    s->lru_head = i;
}

static void rtx_page_lru_touch(RtxPageStore *s, size_t i) {
    if (s->lru_head == i) return;
    rtx_page_lru_unlink(s, i);
    rtx_page_lru_push_head(s, i);
}

static void !>(CCError) rtx_page_store_ensure_slots(RtxPageStore *s) {
    size_t i;
    if (!s) return cc_err(CC_ERR_INVALID_ARG, "null store");
    if (s->slots) return cc_ok();
    s->slot_n = RTX_PAGE_CACHE_DEFAULT;
    s->slots = (RtxPageSlot *)calloc(s->slot_n, sizeof(RtxPageSlot));
    if (!s->slots) return cc_err(CC_ERR_OUT_OF_MEMORY, "page slots");
    s->lru_head = (size_t)-1;
    s->lru_tail = (size_t)-1;
    for (i = 0; i < s->slot_n; i++) {
        s->slots[i].file_id = -1;
        s->slots[i].lru_prev = (size_t)-1;
        s->slots[i].lru_next = (size_t)-1;
        rtx_page_lru_push_head(s, i);
    }
    s->slots_linked = 1;
    return cc_ok();
}

static int rtx_page_fd(const RtxPageStore *s, RtxStoreFile f) {
    if (f == RTX_STORE_ORIG) return s->orig_fd;
    return s->add_fd;
}

static size_t rtx_page_file_len(const RtxPageStore *s, RtxStoreFile f) {
    if (f == RTX_STORE_ORIG) return s->orig_len;
    return s->add_len;
}

static void !>(CCError) rtx_page_store_ensure_add(RtxPageStore *s) {
    char path[] = "/tmp/raytext-add-XXXXXX";
    int fd;
    if (!s) return cc_err(CC_ERR_INVALID_ARG, "null store");
    if (s->add_open) return cc_ok();
    fd = mkstemp(path);
    if (fd < 0) return cc_err(CC_ERR_IO, "mkstemp add");
    unlink(path);
    s->add_fd = fd;
    s->add_open = 1;
    s->add_len = 0;
    return cc_ok();
}

static void !>(CCError) RtxPageStore_open_original(RtxPageStore *s, const char *path) {
    struct stat st;
    int fd;
    if (!s) return cc_err(CC_ERR_INVALID_ARG, "null store");
    if (rtx_page_store_is_open(s)) return cc_err(CC_ERR_INVALID_ARG, "store already open");
    if (!path || !path[0]) return cc_err(CC_ERR_INVALID_ARG, "empty path");
    fd = open(path, O_RDONLY);
    if (fd < 0) return cc_err(CC_ERR_IO, "open original");
    if (fstat(fd, &st) != 0) {
        close(fd);
        return cc_err(CC_ERR_IO, "fstat original");
    }
    if (st.st_size < 0) {
        close(fd);
        return cc_err(CC_ERR_IO, "negative size");
    }
    s->orig_fd = fd;
    s->orig_open = 1;
    s->orig_len = (size_t)st.st_size;
    return cc_ok();
}

static void RtxPageStore_destroy(RtxPageStore *s) {
    size_t i;
    if (!s) return;
    if (s->slots) {
        for (i = 0; i < s->slot_n; i++) {
            free(s->slots[i].bytes);
            s->slots[i].bytes = NULL;
        }
        free(s->slots);
        s->slots = NULL;
    }
    if (s->orig_open) close(s->orig_fd);
    if (s->add_open) close(s->add_fd);
    rtx_page_store_zero(s);
}

/* Load page into slot i (may allocate bytes). Range must be inside file. */
static void !>(CCError) rtx_page_load(RtxPageStore *s, size_t i, RtxStoreFile f,
                                     size_t page_index) {
    RtxPageSlot *slot;
    size_t file_len = rtx_page_file_len(s, f);
    size_t off = page_index * (size_t)RTX_PAGE_SIZE;
    size_t want;
    int fd = rtx_page_fd(s, f);
    size_t got = 0;
    if (fd < 0) return cc_err(CC_ERR_IO, "page load fd");
    if (off > file_len) return cc_err(CC_ERR_INTERNAL, "page past eof");
    want = file_len - off;
    if (want > (size_t)RTX_PAGE_SIZE) want = (size_t)RTX_PAGE_SIZE;
    slot = &s->slots[i];
    if (!slot->bytes) {
        slot->bytes = (char *)malloc(RTX_PAGE_SIZE);
        if (!slot->bytes) return cc_err(CC_ERR_OUT_OF_MEMORY, "page body");
    }
    while (got < want) {
        ssize_t r = pread(fd, slot->bytes + got, want - got, (off_t)(off + got));
        if (r < 0) {
            if (errno == EINTR) continue;
            return cc_err(CC_ERR_IO, "pread");
        }
        if (r == 0) return cc_err(CC_ERR_IO, "pread short");
        got += (size_t)r;
    }
    slot->file_id = (int)f;
    slot->page_index = page_index;
    slot->valid = want;
    return cc_ok();
}

static size_t !>(CCError) rtx_page_get(RtxPageStore *s, RtxStoreFile f, size_t page_index) {
    size_t i;
    size_t victim;
    rtx_page_store_ensure_slots(s) !>(e) { return cc_err(e); };
    for (i = 0; i < s->slot_n; i++) {
        if (s->slots[i].file_id == (int)f && s->slots[i].page_index == page_index &&
            s->slots[i].bytes) {
            rtx_page_lru_touch(s, i);
            return cc_ok(i);
        }
    }
    victim = s->lru_tail;
    if (victim == (size_t)-1) return cc_err(CC_ERR_INTERNAL, "empty lru");
    rtx_page_load(s, victim, f, page_index) !>(e) { return cc_err(e); };
    rtx_page_lru_touch(s, victim);
    return cc_ok(victim);
}

/* Read exactly n bytes at off from file f into dest. Mid-file short = error. */
static void !>(CCError) RtxPageStore_read(RtxPageStore *s, RtxStoreFile f, size_t off,
                                         char *dest, size_t n) {
    size_t file_len;
    size_t got = 0;
    if (!s || !dest) return cc_err(CC_ERR_INVALID_ARG, "page read");
    if (n == 0) return cc_ok();
    if (f == RTX_STORE_ORIG && !s->orig_open) {
        return cc_err(CC_ERR_INVALID_ARG, "no original");
    }
    if (f == RTX_STORE_ADD && !s->add_open) {
        return cc_err(CC_ERR_INVALID_ARG, "no add file");
    }
    file_len = rtx_page_file_len(s, f);
    if (off > file_len || n > file_len - off) {
        return cc_err(CC_ERR_INTERNAL, "page read range");
    }
    while (got < n) {
        size_t abs = off + got;
        size_t page_index = abs / (size_t)RTX_PAGE_SIZE;
        size_t local = abs % (size_t)RTX_PAGE_SIZE;
        size_t slot_i;
        size_t take;
        RtxPageSlot *slot;
        slot_i = rtx_page_get(s, f, page_index) !>(e) { return cc_err(e); };
        slot = &s->slots[slot_i];
        if (local >= slot->valid) return cc_err(CC_ERR_INTERNAL, "page hole");
        take = slot->valid - local;
        if (take > n - got) take = n - got;
        memcpy(dest + got, slot->bytes + local, take);
        got += take;
    }
    return cc_ok();
}

/* Append n bytes to the add file. Returns start offset in add file. */
static size_t !>(CCError) RtxPageStore_append_add(RtxPageStore *s, const char *src, size_t n) {
    size_t start;
    size_t wrote = 0;
    if (!s) return cc_err(CC_ERR_INVALID_ARG, "null store");
    if (n == 0) {
        return cc_ok(s->add_len);
    }
    if (!src) return cc_err(CC_ERR_INVALID_ARG, "null append");
    rtx_page_store_ensure_add(s) !>(e) { return cc_err(e); };
    start = s->add_len;
    while (wrote < n) {
        ssize_t w = pwrite(s->add_fd, src + wrote, n - wrote, (off_t)(start + wrote));
        if (w < 0) {
            if (errno == EINTR) continue;
            return cc_err(CC_ERR_IO, "pwrite add");
        }
        if (w == 0) return cc_err(CC_ERR_IO, "pwrite add");
        wrote += (size_t)w;
    }
    s->add_len = start + n;
    /* Invalidate any cached pages overlapping the new range. */
    if (s->slots) {
        size_t first = start / (size_t)RTX_PAGE_SIZE;
        size_t last = (start + n - 1) / (size_t)RTX_PAGE_SIZE;
        size_t i;
        for (i = 0; i < s->slot_n; i++) {
            if (s->slots[i].file_id == (int)RTX_STORE_ADD &&
                s->slots[i].page_index >= first && s->slots[i].page_index <= last) {
                s->slots[i].file_id = -1;
                s->slots[i].valid = 0;
            }
        }
    }
    return cc_ok(start);
}

@typehooks on RtxPageStore {
    .destroy = RtxPageStore_destroy,
};

#endif /* RTX_PAGE_STORE_H */


#define RTX_RB_RED 1
#define RTX_RB_BLACK 0
#define RTX_LINE_STRIDE 64
#define RTX_FRAME_SCRATCH 8192

typedef enum {
    RTX_BUF_ORIGINAL = 0,
    RTX_BUF_ADD = 1,
} RtxBufKind;

typedef struct {
    RtxBufKind buf;
    size_t start;
    size_t len;
    uint32_t lf_count;
} RtxPiece;

typedef struct RtxNode RtxNode;
typedef struct RtxPieceTree RtxPieceTree;

struct RtxNode {
    RtxPiece piece;
    RtxNode *left;
    RtxNode *right;
    RtxNode *parent;
    uint8_t color;
    size_t subtree_len;
    uint32_t subtree_lf;
};

struct RtxPieceTree {
    RtxNode *root;
    RtxNode *free_list;
    CCArena arena_storage;
    CCArena *arena;
    /* Borrowed from_buffer only; empty for from_path (store-backed). */
    char[:] original;
    RtxPageStore store;
    size_t add_len; /* == store.add_len; tip-extend sentinel */
    /* Start offset of every RTX_LINE_STRIDE-th line. */
    size_t *line_off;
    size_t line_off_len;
    size_t line_off_cap;
    int line_off_ok;
    /* When set, insert/erase skip stride updates (caller patches once). */
    int line_off_suspend;
    /* 0 after store-backed from_path until a newline pass reaches EOF.
     * Open must not scan the body (DESIGN: open is instant). */
    int lf_ready;
    /* Progressive newline scan (valid when !lf_ready). */
    size_t line_scan_off;  /* next byte to read */
    size_t scan_line;      /* newlines seen so far */
};

static uint32_t rtx_count_lf(const char *p, size_t n) {
    uint32_t c = 0;
    size_t i;
    if (!p) return 0;
    for (i = 0; i < n; i++) {
        if (p[i] == '\n') c++;
    }
    return c;
}

static size_t rtx_original_len(const RtxPieceTree *t) {
    if (!t) return 0;
    if (t->original.ptr) return t->original.len;
    return t->store.orig_len;
}

static int rtx_orig_is_mem(const RtxPieceTree *t) {
    return t && t->original.ptr != NULL;
}

/* Count newlines in a piece range. Store I/O surfaces as Result. */
static uint32_t !>(CCError) rtx_buf_count_lf(const RtxPieceTree *t, RtxBufKind buf,
                                            size_t start, size_t len) {
    char tmp[4096];
    size_t off = 0;
    uint32_t c = 0;
    if (!t) return cc_err(CC_ERR_INVALID_ARG, "count lf");
    if (len == 0) return cc_ok(0);
    if (buf == RTX_BUF_ORIGINAL && rtx_orig_is_mem(t)) {
        if (start > t->original.len || len > t->original.len - start) {
            return cc_err(CC_ERR_INTERNAL, "orig lf range");
        }
        return cc_ok(rtx_count_lf((const char *)t->original.ptr + start, len));
    }
    {
        RtxStoreFile f = (buf == RTX_BUF_ORIGINAL) ? RTX_STORE_ORIG : RTX_STORE_ADD;
        while (off < len) {
            size_t take = len - off;
            if (take > sizeof(tmp)) take = sizeof(tmp);
            RtxPageStore_read((RtxPageStore *)&t->store, f, start + off, tmp, take) !>(e) {
                return cc_err(e);
            };
            c += rtx_count_lf(tmp, take);
            off += take;
        }
    }
    return cc_ok(c);
}

/* Copy piece bytes [local, local+n) into dest. */
static void !>(CCError) rtx_piece_read(const RtxPieceTree *t, const RtxPiece *p,
                                      size_t local, char *dest, size_t n) {
    if (!t || !p || !dest) return cc_err(CC_ERR_INVALID_ARG, "piece read");
    if (n == 0) return cc_ok();
    if (local > p->len || n > p->len - local) {
        return cc_err(CC_ERR_INTERNAL, "piece read range");
    }
    if (p->buf == RTX_BUF_ORIGINAL && rtx_orig_is_mem(t)) {
        memcpy(dest, (const char *)t->original.ptr + p->start + local, n);
        return cc_ok();
    }
    {
        RtxStoreFile f = (p->buf == RTX_BUF_ORIGINAL) ? RTX_STORE_ORIG : RTX_STORE_ADD;
        return RtxPageStore_read((RtxPageStore *)&t->store, f, p->start + local, dest, n);
    }
}

static void rtx_node_pull(RtxNode *n) {
    size_t len;
    uint32_t lf;
    if (!n) return;
    len = n->piece.len;
    lf = n->piece.lf_count;
    if (n->left) {
        len += n->left->subtree_len;
        lf += n->left->subtree_lf;
    }
    if (n->right) {
        len += n->right->subtree_len;
        lf += n->right->subtree_lf;
    }
    n->subtree_len = len;
    n->subtree_lf = lf;
}

static void rtx_node_pull_up(RtxNode *n) {
    while (n) {
        rtx_node_pull(n);
        n = n->parent;
    }
}

static RtxNode *rtx_node_alloc(RtxPieceTree *t) {
    RtxNode *n;
    if (!t || !t->arena) return NULL;
    if (t->free_list) {
        n = t->free_list;
        t->free_list = n->right;
        memset(n, 0, sizeof(*n));
        return n;
    }
    n = (RtxNode *)cc_arena_alloc(t->arena, sizeof(RtxNode), _Alignof(RtxNode));
    if (n) memset(n, 0, sizeof(*n));
    return n;
}

static void rtx_node_recycle(RtxPieceTree *t, RtxNode *n) {
    if (!t || !n) return;
    memset(n, 0, sizeof(*n));
    n->right = t->free_list;
    t->free_list = n;
}

static RtxNode *rtx_node_new_piece_lf(RtxPieceTree *t, RtxBufKind buf, size_t start,
                                      size_t len, uint32_t lf) {
    RtxNode *n = rtx_node_alloc(t);
    RtxPiece piece;
    if (!n) return NULL;
    piece.buf = buf;
    piece.start = start;
    piece.len = len;
    piece.lf_count = lf;
    n->piece = piece;
    n->color = RTX_RB_RED;
    n->subtree_len = len;
    n->subtree_lf = lf;
    return n;
}

static void rtx_rotate_left(RtxPieceTree *t, RtxNode *x) {
    RtxNode *y;
    if (!t || !x || !x->right) return;
    y = x->right;
    x->right = y->left;
    if (y->left) y->left->parent = x;
    y->parent = x->parent;
    if (!x->parent) t->root = y;
    else if (x == x->parent->left) x->parent->left = y;
    else x->parent->right = y;
    y->left = x;
    x->parent = y;
    rtx_node_pull(x);
    rtx_node_pull(y);
}

static void rtx_rotate_right(RtxPieceTree *t, RtxNode *x) {
    RtxNode *y;
    if (!t || !x || !x->left) return;
    y = x->left;
    x->left = y->right;
    if (y->right) y->right->parent = x;
    y->parent = x->parent;
    if (!x->parent) t->root = y;
    else if (x == x->parent->right) x->parent->right = y;
    else x->parent->left = y;
    y->right = x;
    x->parent = y;
    rtx_node_pull(x);
    rtx_node_pull(y);
}

static void rtx_insert_fixup(RtxPieceTree *t, RtxNode *z) {
    while (z->parent && z->parent->color == RTX_RB_RED) {
        RtxNode *gp = z->parent->parent;
        if (!gp) break;
        if (z->parent == gp->left) {
            RtxNode *y = gp->right;
            if (y && y->color == RTX_RB_RED) {
                z->parent->color = RTX_RB_BLACK;
                y->color = RTX_RB_BLACK;
                gp->color = RTX_RB_RED;
                z = gp;
            } else {
                if (z == z->parent->right) {
                    z = z->parent;
                    rtx_rotate_left(t, z);
                }
                if (z->parent) z->parent->color = RTX_RB_BLACK;
                if (z->parent && z->parent->parent) {
                    z->parent->parent->color = RTX_RB_RED;
                    rtx_rotate_right(t, z->parent->parent);
                }
            }
        } else {
            RtxNode *y = gp->left;
            if (y && y->color == RTX_RB_RED) {
                z->parent->color = RTX_RB_BLACK;
                y->color = RTX_RB_BLACK;
                gp->color = RTX_RB_RED;
                z = gp;
            } else {
                if (z == z->parent->left) {
                    z = z->parent;
                    rtx_rotate_right(t, z);
                }
                if (z->parent) z->parent->color = RTX_RB_BLACK;
                if (z->parent && z->parent->parent) {
                    z->parent->parent->color = RTX_RB_RED;
                    rtx_rotate_left(t, z->parent->parent);
                }
            }
        }
    }
    if (t->root) t->root->color = RTX_RB_BLACK;
}

static void rtx_bst_insert(RtxPieceTree *t, RtxNode *z, size_t offset) {
    RtxNode *parent = NULL;
    RtxNode *cur = t->root;
    size_t remaining = offset;
    int go_left = 0;
    while (cur) {
        size_t left_len = cur->left ? cur->left->subtree_len : 0;
        parent = cur;
        if (remaining <= left_len) {
            go_left = 1;
            cur = cur->left;
        } else {
            remaining -= left_len + cur->piece.len;
            go_left = 0;
            cur = cur->right;
        }
    }
    z->parent = parent;
    if (!parent) t->root = z;
    else if (go_left) parent->left = z;
    else parent->right = z;
    rtx_node_pull_up(z);
    rtx_insert_fixup(t, z);
}

static RtxNode *rtx_tree_minimum(RtxNode *n) {
    while (n && n->left) n = n->left;
    return n;
}

static void rtx_transplant(RtxPieceTree *t, RtxNode *u, RtxNode *v) {
    if (!u->parent) t->root = v;
    else if (u == u->parent->left) u->parent->left = v;
    else u->parent->right = v;
    if (v) v->parent = u->parent;
}

static void rtx_delete_fixup(RtxPieceTree *t, RtxNode *x, RtxNode *xp) {
    while (x != t->root && (!x || x->color == RTX_RB_BLACK)) {
        if (x == (xp ? xp->left : NULL)) {
            RtxNode *w = xp ? xp->right : NULL;
            if (w && w->color == RTX_RB_RED) {
                w->color = RTX_RB_BLACK;
                xp->color = RTX_RB_RED;
                rtx_rotate_left(t, xp);
                w = xp->right;
            }
            if (w && (!w->left || w->left->color == RTX_RB_BLACK) &&
                (!w->right || w->right->color == RTX_RB_BLACK)) {
                if (w) w->color = RTX_RB_RED;
                x = xp;
                xp = x ? x->parent : NULL;
            } else {
                if (w && (!w->right || w->right->color == RTX_RB_BLACK)) {
                    if (w->left) w->left->color = RTX_RB_BLACK;
                    w->color = RTX_RB_RED;
                    rtx_rotate_right(t, w);
                    w = xp ? xp->right : NULL;
                }
                if (w) w->color = xp ? xp->color : RTX_RB_BLACK;
                if (xp) xp->color = RTX_RB_BLACK;
                if (w && w->right) w->right->color = RTX_RB_BLACK;
                if (xp) rtx_rotate_left(t, xp);
                x = t->root;
                xp = NULL;
            }
        } else {
            RtxNode *w = xp ? xp->left : NULL;
            if (w && w->color == RTX_RB_RED) {
                w->color = RTX_RB_BLACK;
                xp->color = RTX_RB_RED;
                rtx_rotate_right(t, xp);
                w = xp->left;
            }
            if (w && (!w->right || w->right->color == RTX_RB_BLACK) &&
                (!w->left || w->left->color == RTX_RB_BLACK)) {
                if (w) w->color = RTX_RB_RED;
                x = xp;
                xp = x ? x->parent : NULL;
            } else {
                if (w && (!w->left || w->left->color == RTX_RB_BLACK)) {
                    if (w->right) w->right->color = RTX_RB_BLACK;
                    w->color = RTX_RB_RED;
                    rtx_rotate_left(t, w);
                    w = xp ? xp->left : NULL;
                }
                if (w) w->color = xp ? xp->color : RTX_RB_BLACK;
                if (xp) xp->color = RTX_RB_BLACK;
                if (w && w->left) w->left->color = RTX_RB_BLACK;
                if (xp) rtx_rotate_right(t, xp);
                x = t->root;
                xp = NULL;
            }
        }
    }
    if (x) x->color = RTX_RB_BLACK;
}

static void rtx_rb_delete(RtxPieceTree *t, RtxNode *z) {
    RtxNode *y = z;
    RtxNode *x = NULL;
    RtxNode *xp = NULL;
    uint8_t y_color = z->color;
    if (!z->left) {
        x = z->right;
        xp = z->parent;
        rtx_transplant(t, z, z->right);
        if (xp) rtx_node_pull_up(xp);
    } else if (!z->right) {
        x = z->left;
        xp = z->parent;
        rtx_transplant(t, z, z->left);
        if (xp) rtx_node_pull_up(xp);
    } else {
        y = rtx_tree_minimum(z->right);
        y_color = y->color;
        x = y->right;
        if (y->parent == z) {
            xp = y;
            if (x) x->parent = y;
        } else {
            xp = y->parent;
            rtx_transplant(t, y, y->right);
            y->right = z->right;
            if (y->right) y->right->parent = y;
        }
        rtx_transplant(t, z, y);
        y->left = z->left;
        if (y->left) y->left->parent = y;
        y->color = z->color;
        rtx_node_pull(y);
        rtx_node_pull_up(y->parent);
        if (xp && xp != y) rtx_node_pull_up(xp);
    }
    rtx_node_recycle(t, z);
    if (y_color == RTX_RB_BLACK) rtx_delete_fixup(t, x, xp);
    if (t->root) t->root->color = RTX_RB_BLACK;
}

/* Node containing offset, and local byte offset inside that piece.
 * offset == len is not in any node (append). */
static RtxNode *rtx_find_node(const RtxPieceTree *t, size_t offset, size_t *local_out) {
    RtxNode *cur;
    size_t remaining;
    if (!t || !t->root) return NULL;
    if (offset >= t->root->subtree_len) return NULL;
    cur = t->root;
    remaining = offset;
    while (cur) {
        size_t left_len = cur->left ? cur->left->subtree_len : 0;
        if (remaining < left_len) {
            cur = cur->left;
        } else if (remaining < left_len + cur->piece.len) {
            if (local_out) *local_out = remaining - left_len;
            return cur;
        } else {
            remaining -= left_len + cur->piece.len;
            cur = cur->right;
        }
    }
    return NULL;
}

static int rtx_add_append(RtxPieceTree *t, char[:] bytes, size_t *start_out) {
    size_t start;
    if (!t || !start_out) return 0;
    if (bytes.len == 0) {
        *start_out = t->add_len;
        return 1;
    }
    if (!bytes.ptr) return 0;
    {
        @errhandler(CCError e) {
            (void)e;
            return 0;
        }
        start = RtxPageStore_append_add(&t->store, bytes.ptr, bytes.len) !>;
    }
    *start_out = start;
    t->add_len = t->store.add_len;
    return 1;
}

static void rtx_tree_zero(RtxPieceTree *t) {
    if (!t) return;
    memset(t, 0, sizeof(*t));
    rtx_page_store_zero(&t->store);
}

static int rtx_tree_is_live(const RtxPieceTree *t) {
    return t && (t->arena != NULL || rtx_page_store_is_open(&t->store) ||
                 t->original.ptr != NULL);
}

static int rtx_tree_init_arena(RtxPieceTree *t) {
    t->arena_storage = cc_arena_heap(kilobytes(64));
    if (!t->arena_storage.base) return 0;
    t->arena = &t->arena_storage;
    return 1;
}

static void !>(CCError) rtx_lf_recount_node(RtxPieceTree *t, RtxNode *n) {
    if (!n) return cc_ok();
    rtx_lf_recount_node(t, n->left) !>(e) { return cc_err(e); };
    n->piece.lf_count = rtx_buf_count_lf(t, n->piece.buf, n->piece.start,
                                          n->piece.len) !>(e) {
        return cc_err(e);
    };
    rtx_lf_recount_node(t, n->right) !>(e) { return cc_err(e); };
    rtx_node_pull(n);
    return cc_ok();
}

static int rtx_line_off_push(RtxPieceTree *t, size_t off);

static void !>(CCError) rtx_tree_seed_original(RtxPieceTree *t) {
    RtxNode *n;
    size_t olen;
    uint32_t lf;
    olen = rtx_original_len(t);
    if (!olen) {
        t->lf_ready = 1;
        return cc_ok();
    }
    if (rtx_orig_is_mem(t)) {
        lf = rtx_buf_count_lf(t, RTX_BUF_ORIGINAL, 0, olen) !>(e) {
            return cc_err(e);
        };
        t->lf_ready = 1;
        t->line_off_ok = 0;
    } else {
        lf = 0;
        t->lf_ready = 0;
        t->line_scan_off = 0;
        t->scan_line = 0;
        t->line_off_ok = 0;
    }
    n = rtx_node_new_piece_lf(t, RTX_BUF_ORIGINAL, 0, olen, lf);
    if (!n) return cc_err(CC_ERR_OUT_OF_MEMORY, "seed original");
    n->color = RTX_RB_BLACK;
    t->root = n;
    if (!t->lf_ready) {
        if (!rtx_line_off_push(t, 0)) return cc_err(CC_ERR_OUT_OF_MEMORY, "line_off");
    }
    return cc_ok();
}

static inline size_t RtxPieceTree_len(const RtxPieceTree *t) {
    if (!t || !t->root) return 0;
    return t->root->subtree_len;
}

/* Success: got = min(n, len-off). A hole inside that range is INTERNAL. */
static inline size_t !>(CCError) RtxPieceTree_read_at(const RtxPieceTree *t, size_t offset,
                                                      char *dest, size_t n) {
    size_t got = 0;
    size_t len;
    size_t need;
    if (!t || !dest) return cc_err(CC_ERR_INVALID_ARG, "read_at");
    if (n == 0) return cc_ok(0);
    len = RtxPieceTree_len(t);
    if (offset >= len) return cc_ok(0);
    if (n > len - offset) n = len - offset;
    need = n;
    while (got < n) {
        size_t local = 0;
        RtxNode *node = rtx_find_node(t, offset + got, &local);
        size_t take;
        if (!node) return cc_err(CC_ERR_INTERNAL, "read_at hole");
        take = node->piece.len - local;
        if (take > n - got) take = n - got;
        rtx_piece_read(t, &node->piece, local, dest + got, take) !>(e) {
            return cc_err(e);
        };
        got += take;
    }
    if (got != need) return cc_err(CC_ERR_INTERNAL, "read_at short");
    return cc_ok(got);
}

/*
 * Extend the progressive line scan through byte `want_off`.
 */
static void !>(CCError) rtx_line_scan_to(RtxPieceTree *t, size_t want_off) {
    size_t len;
    char buf[64 * 1024];
    if (!t) return cc_err(CC_ERR_INVALID_ARG, "scan");
    if (t->lf_ready) return cc_ok();
    len = RtxPieceTree_len(t);
    if (want_off > len) want_off = len;
    if (t->line_off_len == 0) {
        if (!rtx_line_off_push(t, 0)) return cc_err(CC_ERR_OUT_OF_MEMORY, "line_off");
    }
    while (t->line_scan_off < want_off) {
        size_t take = want_off - t->line_scan_off;
        size_t got, i;
        if (take > sizeof(buf)) take = sizeof(buf);
        got = RtxPieceTree_read_at(t, t->line_scan_off, buf, take) !>(e) {
            return cc_err(e);
        };
        if (!got) return cc_err(CC_ERR_INTERNAL, "line scan");
        for (i = 0; i < got; i++) {
            if (buf[i] == '\n') {
                t->scan_line++;
                if (t->scan_line % (size_t)RTX_LINE_STRIDE == 0) {
                    if (!rtx_line_off_push(t, t->line_scan_off + i + 1)) {
                        return cc_err(CC_ERR_OUT_OF_MEMORY, "line_off");
                    }
                }
            }
        }
        t->line_scan_off += got;
    }
    if (t->line_scan_off >= len) {
        if (t->root && !t->root->left && !t->root->right) {
            t->root->piece.lf_count = (uint32_t)t->scan_line;
            rtx_node_pull(t->root);
        } else {
            rtx_lf_recount_node(t, t->root) !>(e) { return cc_err(e); };
        }
        t->lf_ready = 1;
        t->line_off_ok = 1;
    }
    return cc_ok();
}

/* Scan until line index `want_line` is known (scan_line >= want_line) or EOF. */
static void !>(CCError) rtx_line_scan_through_line(RtxPieceTree *t, size_t want_line) {
    size_t len;
    char buf[64 * 1024];
    if (!t) return cc_err(CC_ERR_INVALID_ARG, "scan");
    if (t->lf_ready) return cc_ok();
    len = RtxPieceTree_len(t);
    if (t->line_off_len == 0) {
        if (!rtx_line_off_push(t, 0)) return cc_err(CC_ERR_OUT_OF_MEMORY, "line_off");
    }
    while (t->scan_line < want_line && t->line_scan_off < len) {
        size_t got, i;
        size_t take = sizeof(buf);
        if (take > len - t->line_scan_off) take = len - t->line_scan_off;
        got = RtxPieceTree_read_at(t, t->line_scan_off, buf, take) !>(e) {
            return cc_err(e);
        };
        if (!got) return cc_err(CC_ERR_INTERNAL, "line scan");
        for (i = 0; i < got; i++) {
            if (buf[i] == '\n') {
                t->scan_line++;
                if (t->scan_line % (size_t)RTX_LINE_STRIDE == 0) {
                    if (!rtx_line_off_push(t, t->line_scan_off + i + 1)) {
                        return cc_err(CC_ERR_OUT_OF_MEMORY, "line_off");
                    }
                }
                if (t->scan_line >= want_line) {
                    t->line_scan_off += i + 1;
                    break;
                }
            }
        }
        if (t->scan_line >= want_line) break;
        t->line_scan_off += got;
    }
    if (t->line_scan_off >= len) {
        if (t->root && !t->root->left && !t->root->right) {
            t->root->piece.lf_count = (uint32_t)t->scan_line;
            rtx_node_pull(t->root);
        } else if (t->root) {
            rtx_lf_recount_node(t, t->root) !>(e) { return cc_err(e); };
        }
        t->lf_ready = 1;
        t->line_off_ok = 1;
    }
    return cc_ok();
}

/* Finish newline weights. Completes any progressive scan to EOF. */
static void !>(CCError) rtx_lf_ensure(RtxPieceTree *t) {
    if (!t || t->lf_ready) return cc_ok();
    rtx_line_scan_to(t, RtxPieceTree_len(t)) !>(e) { return cc_err(e); };
    if (!t->lf_ready && t->root) {
        rtx_lf_recount_node(t, t->root) !>(e) { return cc_err(e); };
        t->lf_ready = 1;
        t->line_off_ok = 1;
    }
    return cc_ok();
}

/*
 * Append a copy of [from, from+n) at EOF via frame chunk + store append.
 * Does not touch the line index — set line_off_suspend and patch once afterward.
 * Returns newlines copied.
 */
static uint32_t !>(CCError) RtxPieceTree_append_copy(RtxPieceTree *t, size_t from,
                                                      size_t n) {
    size_t off = 0;
    size_t local = 0;
    RtxNode *tip;
    uint32_t lf = 0;
    char chunk[64 * 1024];
    if (!t) return cc_err(CC_ERR_INVALID_ARG, "null tree");
    if (n == 0) return cc_ok((uint32_t)0);
    if (from > RtxPieceTree_len(t) || n > RtxPieceTree_len(t) - from) {
        return cc_err(CC_ERR_INVALID_ARG, "append_copy range");
    }
    rtx_lf_ensure(t) !>(e) { return cc_err(e); };

    tip = NULL;
    if (RtxPieceTree_len(t) > 0) {
        tip = rtx_find_node(t, RtxPieceTree_len(t) - 1, &local);
        if (tip && tip->piece.buf == RTX_BUF_ADD &&
            tip->piece.start + tip->piece.len == t->add_len &&
            local + 1 == tip->piece.len) {
            /* extendable tip */
        } else {
            tip = NULL;
        }
    }
    if (!tip) {
        tip = rtx_node_new_piece_lf(t, RTX_BUF_ADD, t->add_len, 0, 0);
        if (!tip) return cc_err(CC_ERR_OUT_OF_MEMORY, "append tip");
        rtx_bst_insert(t, tip, RtxPieceTree_len(t));
    }

    while (off < n) {
        size_t take = n - off;
        size_t got, i;
        size_t start;
        if (take > sizeof(chunk)) take = sizeof(chunk);
        got = RtxPieceTree_read_at(t, from + off, chunk, take) !>(e) {
            return cc_err(e);
        };
        if (got != take) return cc_err(CC_ERR_INTERNAL, "append_copy read");
        start = RtxPageStore_append_add(&t->store, chunk, got) !>(e) {
            return cc_err(e);
        };
        if (tip->piece.len == 0) tip->piece.start = start;
        else if (start != tip->piece.start + tip->piece.len) {
            return cc_err(CC_ERR_INTERNAL, "append_copy gap");
        }
        for (i = 0; i < got; i++) {
            if (chunk[i] == '\n') lf++;
        }
        t->add_len = t->store.add_len;
        tip->piece.len += got;
        off += got;
    }
    tip->piece.lf_count += lf;
    rtx_node_pull_up(tip);
    return cc_ok(lf);
}

/* Contiguous borrowed original, or empty if store-backed / split. */
static inline char[:] RtxPieceTree_flat(const RtxPieceTree *t) {
    RtxNode *n;
    if (!t || !t->root || !rtx_orig_is_mem(t)) return cc_slice_empty();
    n = t->root;
    if (n->left || n->right) return cc_slice_empty();
    if (n->piece.buf != RTX_BUF_ORIGINAL) return cc_slice_empty();
    if (n->piece.start != 0 || n->piece.len != t->original.len) return cc_slice_empty();
    return t->original;
}

/* View of [from, from+n) when it sits in one borrowed contiguous piece.
 * Store-backed pieces return empty (DESIGN: no stable page views). */
static inline char[:] RtxPieceTree_span(const RtxPieceTree *t, size_t from, size_t n) {
    size_t local = 0;
    size_t len;
    RtxNode *node;
    char[:] piece;
    if (!t || n == 0) return cc_slice_empty();
    len = RtxPieceTree_len(t);
    if (from >= len) return cc_slice_empty();
    if (n > len - from) n = len - from;
    {
        char[:] flat = RtxPieceTree_flat(t);
        if (flat.ptr && from <= flat.len && n <= flat.len - from) {
            return flat.sub(from, from + n);
        }
    }
    node = rtx_find_node(t, from, &local);
    if (!node || local + n > node->piece.len) return cc_slice_empty();
    if (node->piece.buf != RTX_BUF_ORIGINAL || !rtx_orig_is_mem(t)) {
        return cc_slice_empty();
    }
    piece = t->original.sub(node->piece.start,
                            node->piece.start + node->piece.len);
    return piece.sub(local, local + n);
}

/* Document view if contiguous; otherwise a copy on `scratch` (scratch epoch).
 * Empty is a payload (n == 0 / past end). OOM and short read are errors. */
static inline char[:] !>(CCError) RtxPieceTree_scratch_span(const RtxPieceTree *t, CCArena *scratch,
                                                size_t from, size_t n) {
    char[:] view;
    char[:] copy;
    size_t len;
    if (!t) return cc_err(CC_ERR_INVALID_ARG, "null tree");
    if (n == 0) return cc_ok(cc_slice_empty());
    view = RtxPieceTree_span(t, from, n);
    if (view.ptr) return cc_ok(view);
    if (!scratch) return cc_err(CC_ERR_INVALID_ARG, "null scratch");
    len = RtxPieceTree_len(t);
    if (from >= len) return cc_ok(cc_slice_empty());
    if (n > len - from) n = len - from;
    if (n == 0) return cc_ok(cc_slice_empty());
    copy = scratch->alloc_slice_bytes(n);
    if (!copy.ptr || copy.len < n) return cc_err(CC_ERR_OUT_OF_MEMORY, "scratch span");
    {
        size_t got = t->read_at(from, copy.ptr, n) !>(e) { return cc_err(e); };
        if (got != n) return cc_err(CC_ERR_INTERNAL, "scratch span read");
    }
    return cc_ok(copy);
}

static inline void RtxPieceTree_destroy(RtxPieceTree *t) {
    if (!t) return;
    t->store.destroy();
    if (t->arena && t->arena->base) {
        t->arena_storage.destroy();
    }
    rtx_tree_zero(t);
}

static inline void !>(CCError) RtxPieceTree_empty(RtxPieceTree *t) {
    if (!t) return cc_err(CC_ERR_INVALID_ARG, "null tree");
    if (rtx_tree_is_live(t)) return cc_err(CC_ERR_INVALID_ARG, "tree already live");
    rtx_tree_zero(t);
    if (!rtx_tree_init_arena(t)) {
        return cc_err(CC_ERR_OUT_OF_MEMORY, "piece tree arena");
    }
    t->lf_ready = 1;
    return cc_ok();
}

static inline void !>(CCError) RtxPieceTree_from_buffer(RtxPieceTree *t, char[:] bytes) {
    if (!t) return cc_err(CC_ERR_INVALID_ARG, "null tree");
    if (rtx_tree_is_live(t)) return cc_err(CC_ERR_INVALID_ARG, "tree already live");
    if (bytes.len && cc_slice_is_untracked_id(bytes.id)) {
        return cc_err(CC_ERR_INVALID_ARG, "untracked buffer");
    }
    rtx_tree_zero(t);
    if (!rtx_tree_init_arena(t)) {
        return cc_err(CC_ERR_OUT_OF_MEMORY, "piece tree arena");
    }
    t->original = bytes;
    rtx_tree_seed_original(t) !>(e) {
        RtxPieceTree_destroy(t);
        return cc_err(e);
    };
    return cc_ok();
}

static inline void !>(CCError) RtxPieceTree_from_path(RtxPieceTree *t, const char *path) {
    if (!t) return cc_err(CC_ERR_INVALID_ARG, "null tree");
    if (rtx_tree_is_live(t)) return cc_err(CC_ERR_INVALID_ARG, "tree already live");
    rtx_tree_zero(t);
    if (!path || !path[0]) return cc_err(CC_ERR_INVALID_ARG, "empty path");
    if (!rtx_tree_init_arena(t)) {
        return cc_err(CC_ERR_OUT_OF_MEMORY, "piece tree arena");
    }
    RtxPageStore_open_original(&t->store, path) !>(e) {
        RtxPieceTree_destroy(t);
        return cc_err(e);
    };
    if (t->store.orig_len == 0) {
        t->lf_ready = 1;
        return cc_ok();
    }
    rtx_tree_seed_original(t) !>(e) {
        RtxPieceTree_destroy(t);
        return cc_err(e);
    };
    return cc_ok();
}

/* Split the piece containing `offset` so a node begins at `offset`.
 * Allocates the right node before shrinking the left. offset == len is a no-op. */
static void !>(CCError) rtx_split_at(RtxPieceTree *t, size_t offset) {
    size_t local = 0;
    RtxNode *n;
    RtxNode *right;
    size_t right_len;
    RtxBufKind buf;
    size_t start;
    uint32_t right_lf;
    if (!t) return cc_err(CC_ERR_INVALID_ARG, "null tree");
    if (offset == 0 || offset == RtxPieceTree_len(t)) return cc_ok();
    n = rtx_find_node(t, offset, &local);
    if (!n) return cc_err(CC_ERR_INTERNAL, "split node");
    if (local == 0) return cc_ok();
    right_len = n->piece.len - local;
    buf = n->piece.buf;
    start = n->piece.start + local;
    right_lf = rtx_buf_count_lf(t, buf, start, right_len) !>(e) { return cc_err(e); };
    right = rtx_node_new_piece_lf(t, buf, start, right_len, right_lf);
    if (!right) return cc_err(CC_ERR_OUT_OF_MEMORY, "split node");
    n->piece.len = local;
    if (n->piece.lf_count >= right->piece.lf_count) {
        n->piece.lf_count -= right->piece.lf_count;
    } else {
        n->piece.lf_count = rtx_buf_count_lf(t, n->piece.buf, n->piece.start,
                                              n->piece.len) !>(e) {
            return cc_err(e);
        };
    }
    rtx_node_pull_up(n);
    rtx_bst_insert(t, right, offset);
    return cc_ok();
}

static void rtx_line_index_note_insert(RtxPieceTree *t, size_t off, size_t ins_len,
                                       uint32_t lf);
static void rtx_line_index_note_erase(RtxPieceTree *t, size_t off, size_t n,
                                      uint32_t lf);
static size_t rtx_count_lf_range(const RtxPieceTree *t, size_t from, size_t n);

static int rtx_try_extend_add(RtxPieceTree *t, size_t offset, char[:] bytes) {
    size_t local = 0;
    RtxNode *n;
    if (!t || bytes.len == 0 || offset == 0) return 0;
    n = rtx_find_node(t, offset - 1, &local);
    if (!n) return 0;
    if (n->piece.buf != RTX_BUF_ADD) return 0;
    if (n->piece.start + n->piece.len != t->add_len) return 0;
    if (local + 1 != n->piece.len) return 0;
    {
        size_t start = 0;
        if (!rtx_add_append(t, bytes, &start)) return 0;
        (void)start;
        n->piece.len += bytes.len;
        n->piece.lf_count += rtx_count_lf(bytes.ptr, bytes.len);
        rtx_node_pull_up(n);
        return 1;
    }
}

static inline void !>(CCError) RtxPieceTree_insert(RtxPieceTree *t, size_t offset, char[:] bytes) {
    size_t start = 0;
    RtxNode *n;
    size_t len;
    uint32_t lf;
    if (!t) return cc_err(CC_ERR_INVALID_ARG, "null tree");
    len = RtxPieceTree_len(t);
    if (offset > len) return cc_err(CC_ERR_INVALID_ARG, "insert past end");
    if (bytes.len == 0) return cc_ok();
    rtx_lf_ensure(t) !>(e) { return cc_err(e); };
    if (rtx_try_extend_add(t, offset, bytes)) {
        if (!t->line_off_suspend) {
            rtx_line_index_note_insert(t, offset, bytes.len,
                                      rtx_count_lf(bytes.ptr, bytes.len));
        }
        return cc_ok();
    }
    rtx_split_at(t, offset) !>(e) { return cc_err(e); };
    if (!rtx_add_append(t, bytes, &start)) {
        return cc_err(CC_ERR_OUT_OF_MEMORY, "add buffer");
    }
    lf = rtx_count_lf(bytes.ptr, bytes.len);
    n = rtx_node_new_piece_lf(t, RTX_BUF_ADD, start, bytes.len, lf);
    if (!n) return cc_err(CC_ERR_OUT_OF_MEMORY, "piece node");
    rtx_bst_insert(t, n, offset);
    if (!t->line_off_suspend) {
        rtx_line_index_note_insert(t, offset, bytes.len, n->piece.lf_count);
    }
    return cc_ok();
}

static inline void !>(CCError) RtxPieceTree_erase(RtxPieceTree *t, size_t offset, size_t n) {
    size_t len;
    size_t end;
    size_t erased;
    uint32_t lf = 0;
    if (!t) return cc_err(CC_ERR_INVALID_ARG, "null tree");
    len = RtxPieceTree_len(t);
    if (offset > len || n > len - offset) {
        return cc_err(CC_ERR_INVALID_ARG, "erase out of range");
    }
    if (n == 0) return cc_ok();
    rtx_lf_ensure(t) !>(e) { return cc_err(e); };
    /* Count deleted newlines before the tree changes (for index patch). */
    lf = (uint32_t)rtx_count_lf_range(t, offset, n);
    end = offset + n;
    erased = n;
    rtx_split_at(t, offset) !>(e) { return cc_err(e); };
    rtx_split_at(t, end) !>(e) { return cc_err(e); };
    while (n > 0) {
        size_t local = 0;
        RtxNode *node = rtx_find_node(t, offset, &local);
        size_t piece_len;
        if (!node || local != 0) {
            t->line_off_ok = 0;
            return cc_err(CC_ERR_INTERNAL, "erase walk");
        }
        piece_len = node->piece.len;
        if (piece_len > n) {
            t->line_off_ok = 0;
            return cc_err(CC_ERR_INTERNAL, "erase piece");
        }
        rtx_rb_delete(t, node);
        n -= piece_len;
    }
    if (!t->line_off_suspend) {
        rtx_line_index_note_erase(t, offset, erased, lf);
    } else {
        t->line_off_ok = 0;
    }
    return cc_ok();
}

/* One user-visible change. Holds a copy of `del` so rollback survives
 * add-buffer growth. Insert-fail re-inserts that copy. */
static inline void !>(CCError) RtxPieceTree_replace(RtxPieceTree *t, size_t off, size_t n,
                                                   char[:] ins) {
    char[:] del = cc_slice_empty();
    CCArena hold = {0};
    if (!t) return cc_err(CC_ERR_INVALID_ARG, "null tree");
    if (n == 0 && ins.len == 0) return cc_ok();
    if (n) {
        hold = cc_arena_heap(n + 64);
        if (!hold.base) return cc_err(CC_ERR_OUT_OF_MEMORY, "replace hold");
    }
    @defer { if (hold.base) hold.destroy(); };
    if (n) {
        del = hold.alloc_slice_bytes(n);
        if (!del.ptr || del.len < n) return cc_err(CC_ERR_OUT_OF_MEMORY, "replace del");
        {
            size_t got = t->read_at(off, del.ptr, n) !>(e) { return cc_err(e); };
            if (got != n) return cc_err(CC_ERR_INTERNAL, "replace read");
        }
        t->erase(off, n) !>(e) { return cc_err(e); };
    }
    if (ins.len) {
        t->insert(off, ins) !>(e) {
            if (n && del.ptr) {
                t->insert(off, del) !>(e2) {
                    (void)e2;
                    return cc_err(CC_ERR_INTERNAL, "replace unrestorable");
                };
            }
            return cc_err(e);
        };
    }
    return cc_ok();
}

static void !>(CCError) rtx_write_all(int fd, const char *p, size_t n) {
    size_t off = 0;
    while (off < n) {
        ssize_t w = write(fd, p + off, n - off);
        if (w < 0) {
            if (errno == EINTR) continue;
            return cc_err(CC_ERR_IO, "write");
        }
        if (w == 0) return cc_err(CC_ERR_IO, "write");
        off += (size_t)w;
    }
    return cc_ok();
}

static void !>(CCError) rtx_write_node(const RtxPieceTree *t, const RtxNode *n, int fd) {
    char buf[RTX_PAGE_SIZE];
    size_t off;
    if (!n) return cc_ok();
    rtx_write_node(t, n->left, fd) !>(e) { return cc_err(e); };
    off = 0;
    while (off < n->piece.len) {
        size_t take = n->piece.len - off;
        if (take > sizeof(buf)) take = sizeof(buf);
        rtx_piece_read(t, &n->piece, off, buf, take) !>(e) { return cc_err(e); };
        rtx_write_all(fd, buf, take) !>(e) { return cc_err(e); };
        off += take;
    }
    return rtx_write_node(t, n->right, fd);
}

/* Stream pieces to fd. Does not load the document into one buffer. */
static inline void !>(CCError) RtxPieceTree_write_fd(const RtxPieceTree *t, int fd) {
    if (!t || fd < 0) return cc_err(CC_ERR_INVALID_ARG, "write_fd");
    if (!t->root) return cc_ok();
    return rtx_write_node(t, t->root, fd);
}

static int rtx_line_off_push(RtxPieceTree *t, size_t off) {
    if (t->line_off_len >= t->line_off_cap) {
        size_t c = t->line_off_cap ? t->line_off_cap * 2 : 256;
        size_t *p = (size_t *)cc_arena_alloc(t->arena, c * sizeof(size_t), 8);
        if (!p) return 0;
        if (t->line_off && t->line_off_len) {
            memcpy(p, t->line_off, t->line_off_len * sizeof(size_t));
        }
        t->line_off = p;
        t->line_off_cap = c;
    }
    t->line_off[t->line_off_len++] = off;
    return 1;
}

/* Rebuild stride slots from `from_slot` (inclusive) to EOF. Keeps
 * line_off[0..from_slot]. Sets line_off_ok only if the scan reaches len.
 * A full rebuild from slot 0 on a single original piece also sets lf_ready. */
static void rtx_line_index_rebuild_from(RtxPieceTree *t, size_t from_slot) {
    size_t len, off, line;
    char buf[4096];
    if (!t || from_slot >= t->line_off_len) {
        if (t) t->line_off_ok = 0;
        return;
    }
    t->line_off_ok = 0;
    line = from_slot * RTX_LINE_STRIDE;
    off = t->line_off[from_slot];
    len = RtxPieceTree_len(t);
    @errhandler(CCError e) {
        (void)e;
        return;
    }
    while (off < len) {
        size_t got = RtxPieceTree_read_at(t, off, buf, sizeof(buf)) !>;
        size_t i;
        if (!got) return;
        for (i = 0; i < got; i++) {
            if (buf[i] == '\n') {
                line++;
                if (line % RTX_LINE_STRIDE == 0) {
                    if (!rtx_line_off_push(t, off + i + 1)) return;
                }
            }
        }
        off += got;
    }
    if (off != len) return;
    t->line_off_ok = 1;
    if (!t->lf_ready && from_slot == 0 && t->root && !t->root->left && !t->root->right) {
        t->root->piece.lf_count = (uint32_t)line;
        rtx_node_pull(t->root);
        t->lf_ready = 1;
    }
}

static void rtx_line_index_build(RtxPieceTree *t) {
    if (!t) return;
    t->line_off_len = 0;
    t->line_off_ok = 0;
    if (!rtx_line_off_push(t, 0)) return;
    rtx_line_index_rebuild_from(t, 0);
}

/* Drop slots at/after `off`, rebuild suffix from the last still-valid slot. */
static void rtx_line_index_rebuild_suffix(RtxPieceTree *t, size_t off) {
    size_t keep, from_slot;
    if (!t || !t->line_off_ok || t->line_off_len == 0) {
        if (t) t->line_off_ok = 0;
        return;
    }
    keep = 0;
    while (keep < t->line_off_len && t->line_off[keep] < off) keep++;
    from_slot = keep > 0 ? keep - 1 : 0;
    t->line_off_len = from_slot + 1;
    rtx_line_index_rebuild_from(t, from_slot);
}

/* Shift every stride offset at/after `off` by `delta` (signed via size_t add). */
static void rtx_line_index_shift_from(RtxPieceTree *t, size_t off, size_t delta,
                                      int add) {
    size_t i;
    for (i = 0; i < t->line_off_len; i++) {
        if (t->line_off[i] < off) continue;
        if (add) t->line_off[i] += delta;
        else t->line_off[i] -= delta;
    }
}

/*
 * Insert at `off` of `ins_len` bytes containing `lf` newlines.
 * - lf == 0: shift later slots only (typing without newline).
 * - lf % STRIDE == 0: scan only the inserted span, then reattach the
 *   shifted old slots (BOF/mid paste of a stride-aligned block).
 * - else: rebuild from the edit through EOF (stride phase breaks).
 */
static void rtx_line_index_note_insert(RtxPieceTree *t, size_t off, size_t ins_len,
                                      uint32_t lf) {
    size_t first, i, tail_len, start_i;
    size_t *tail = NULL;
    if (!t || !t->line_off_ok || t->line_off_len == 0) {
        if (t) t->line_off_ok = 0;
        return;
    }
    if (ins_len == 0) return;

    if (lf == 0) {
        rtx_line_index_shift_from(t, off, ins_len, 1);
        return;
    }

    if (lf % (uint32_t)RTX_LINE_STRIDE != 0) {
        rtx_line_index_rebuild_suffix(t, off);
        return;
    }

    first = 0;
    while (first < t->line_off_len && t->line_off[first] < off) first++;
    tail_len = t->line_off_len - first;
    if (tail_len) {
        tail = (size_t *)malloc(tail_len * sizeof(size_t));
        if (!tail) {
            t->line_off_ok = 0;
            return;
        }
        memcpy(tail, t->line_off + first, tail_len * sizeof(size_t));
    }
    /* Keep slots strictly before the edit. */
    t->line_off_len = first > 0 ? first : 1;
    if (first == 0) t->line_off[0] = 0;

    {
        size_t line = first > 0 ? (first - 1) * RTX_LINE_STRIDE : 0;
        size_t at = first > 0 ? t->line_off[first - 1] : 0;
        size_t end = off + ins_len;
        char buf[4096];
        t->line_off_ok = 0;
        @errhandler(CCError e) {
            (void)e;
            free(tail);
            return;
        }
        while (at < end) {
            size_t want = end - at;
            size_t got, j;
            if (want > sizeof(buf)) want = sizeof(buf);
            got = RtxPieceTree_read_at(t, at, buf, want) !>;
            if (!got) {
                free(tail);
                return;
            }
            for (j = 0; j < got; j++) {
                if (buf[j] == '\n') {
                    line++;
                    if (line % RTX_LINE_STRIDE == 0) {
                        if (!rtx_line_off_push(t, at + j + 1)) {
                            free(tail);
                            return;
                        }
                    }
                }
            }
            at += got;
        }
        start_i = 0;
        if (tail_len && t->line_off_len > 0 &&
            t->line_off[t->line_off_len - 1] == tail[0] + ins_len) {
            start_i = 1; /* already pushed the old slot-0 / edit boundary */
        }
        for (i = start_i; i < tail_len; i++) {
            if (!rtx_line_off_push(t, tail[i] + ins_len)) {
                free(tail);
                return;
            }
        }
        free(tail);
        t->line_off_ok = 1;
    }
}

static void rtx_line_index_note_erase(RtxPieceTree *t, size_t off, size_t n,
                                     uint32_t lf) {
    size_t i, w;
    if (!t || !t->line_off_ok || t->line_off_len == 0) {
        if (t) t->line_off_ok = 0;
        return;
    }
    if (n == 0) return;

    if (lf == 0) {
        w = 0;
        for (i = 0; i < t->line_off_len; i++) {
            size_t o = t->line_off[i];
            if (o >= off && o < off + n) continue;
            if (o >= off + n) o -= n;
            t->line_off[w++] = o;
        }
        t->line_off_len = w;
        if (t->line_off_len == 0) t->line_off_ok = 0;
        return;
    }

    rtx_line_index_rebuild_suffix(t, off);
}

static void rtx_line_index_ensure(const RtxPieceTree *t) {
    (void)t;
    /* Progressive scan: line_start / line_of extend as needed. */
}

/* Soft line count while indexing: known lines + headroom so scroll can
 * advance without a full-file pass. Exact after lf_ready. Small files finish
 * eagerly on first line_count (cheap). */
#define RTX_LINE_SOFT_MIN (32 * 1024 * 1024)

static inline size_t RtxPieceTree_line_count(const RtxPieceTree *t) {
    size_t len;
    if (!t || !t->root) return 1;
    if (t->lf_ready) return (size_t)t->root->subtree_lf + 1;
    len = RtxPieceTree_len(t);
    if (len == 0) return 1;
    if (len <= (size_t)RTX_LINE_SOFT_MIN) {
        @errhandler(CCError e) {
            (void)e;
            return t->scan_line + 1;
        }
        rtx_line_scan_to((RtxPieceTree *)t, len) !>;
        if (t->lf_ready) return (size_t)t->root->subtree_lf + 1;
    }
    if (t->line_scan_off >= len) {
        @errhandler(CCError e) {
            (void)e;
            return t->scan_line + 1;
        }
        rtx_line_scan_to((RtxPieceTree *)t, len) !>;
        if (t->lf_ready) return (size_t)t->root->subtree_lf + 1;
    }
    return t->scan_line + 1 + (1024 * 1024);
}

/* Count newlines in [from, from+n). */
static size_t rtx_count_lf_range(const RtxPieceTree *t, size_t from, size_t n) {
    char buf[512];
    size_t seen = 0;
    size_t off = from;
    size_t end = from + n;
    size_t len = RtxPieceTree_len(t);
    if (end > len) end = len;
    @errhandler(CCError e) {
        (void)e;
        return seen;
    }
    while (off < end) {
        size_t want = end - off;
        size_t got;
        size_t i;
        if (want > sizeof(buf)) want = sizeof(buf);
        got = RtxPieceTree_read_at(t, off, buf, want) !>;
        if (!got) break;
        for (i = 0; i < got; i++) {
            if (buf[i] == '\n') seen++;
        }
        off += got;
    }
    return seen;
}

/* Byte offset after `nlines` newlines starting at `from`. */
static size_t rtx_advance_lines(const RtxPieceTree *t, size_t from, size_t nlines) {
    char buf[512];
    size_t seen = 0;
    size_t off = from;
    size_t len = RtxPieceTree_len(t);
    if (nlines == 0) return from;
    @errhandler(CCError e) {
        (void)e;
        return len;
    }
    while (off < len) {
        size_t got = RtxPieceTree_read_at(t, off, buf, sizeof(buf)) !>;
        size_t i;
        if (!got) break;
        for (i = 0; i < got; i++) {
            if (buf[i] == '\n') {
                seen++;
                if (seen == nlines) return off + i + 1;
            }
        }
        off += got;
    }
    return len;
}

static inline size_t RtxPieceTree_line_start(const RtxPieceTree *t, size_t line) {
    size_t slot, remain;
    RtxPieceTree *mut;
    if (!t || !t->root || line == 0) return 0;
    mut = (RtxPieceTree *)t;
    if (!t->lf_ready) {
        @errhandler(CCError e) {
            (void)e;
            return RtxPieceTree_len(t);
        }
        rtx_line_scan_through_line(mut, line) !>;
    }
    if (t->lf_ready) {
        if (line >= (size_t)t->root->subtree_lf + 1) return RtxPieceTree_len(t);
    } else if (line > t->scan_line) {
        return RtxPieceTree_len(t);
    }
    if (t->line_off_len == 0) return rtx_advance_lines(t, 0, line);
    slot = line / RTX_LINE_STRIDE;
    if (slot >= t->line_off_len) slot = t->line_off_len - 1;
    /* Don't use stride slots past the scan frontier. */
    while (!t->lf_ready && slot > 0 && t->line_off[slot] > t->line_scan_off) {
        slot--;
    }
    remain = line - slot * RTX_LINE_STRIDE;
    return rtx_advance_lines(t, t->line_off[slot], remain);
}

static inline size_t RtxPieceTree_line_of(const RtxPieceTree *t, size_t offset) {
    size_t len, lo, hi, slot;
    RtxPieceTree *mut;
    if (!t || !t->root) return 0;
    len = RtxPieceTree_len(t);
    if (offset > len) offset = len;
    mut = (RtxPieceTree *)t;
    if (!t->lf_ready) {
        @errhandler(CCError e) {
            (void)e;
            return 0;
        }
        rtx_line_scan_to(mut, offset == len ? len : offset) !>;
        if (offset == len) {
            if (t->lf_ready) return (size_t)t->root->subtree_lf;
            return t->scan_line;
        }
    }
    if (offset == len) {
        if (len == 0) return 0;
        return (size_t)t->root->subtree_lf;
    }
    if (t->line_off_len == 0) return rtx_count_lf_range(t, 0, offset);
    lo = 0;
    hi = t->line_off_len;
    while (lo + 1 < hi) {
        size_t mid = lo + (hi - lo) / 2;
        if (t->line_off[mid] <= offset) lo = mid;
        else hi = mid;
    }
    slot = lo;
    while (slot > 0 && !t->lf_ready && t->line_off[slot] > t->line_scan_off) {
        slot--;
    }
    return slot * RTX_LINE_STRIDE + rtx_count_lf_range(t, t->line_off[slot],
                                                       offset - t->line_off[slot]);
}

static int rtx_check_node(const RtxPieceTree *t, const RtxNode *n, const RtxNode *parent,
                          int *black_height, int *err) {
    int lh = 0;
    int rh = 0;
    size_t expect_len;
    uint32_t expect_lf;
    if (*err) return 0;
    if (!n) {
        *black_height = 1;
        return 1;
    }
    if (n->parent != parent) {
        *err = 1;
        return 0;
    }
    if (n->color == RTX_RB_RED) {
        if ((n->left && n->left->color == RTX_RB_RED) ||
            (n->right && n->right->color == RTX_RB_RED)) {
            *err = 2;
            return 0;
        }
    }
    {
        uint32_t got_lf = 0;
        @errhandler(CCError e) {
            (void)e;
            *err = 3;
            return 0;
        }
        got_lf = rtx_buf_count_lf(t, n->piece.buf, n->piece.start, n->piece.len) !>;
        if (n->piece.lf_count != got_lf) {
            *err = 3;
            return 0;
        }
    }
    rtx_check_node(t, n->left, n, &lh, err);
    rtx_check_node(t, n->right, n, &rh, err);
    if (*err) return 0;
    if (lh != rh) {
        *err = 4;
        return 0;
    }
    expect_len = n->piece.len + (n->left ? n->left->subtree_len : 0) +
                 (n->right ? n->right->subtree_len : 0);
    expect_lf = n->piece.lf_count + (n->left ? n->left->subtree_lf : 0) +
                (n->right ? n->right->subtree_lf : 0);
    if (n->subtree_len != expect_len || n->subtree_lf != expect_lf) {
        *err = 5;
        return 0;
    }
    *black_height = lh + (n->color == RTX_RB_BLACK ? 1 : 0);
    return 1;
}

static inline int RtxPieceTree_check(const RtxPieceTree *t) {
    int bh = 0;
    int err = 0;
    if (!t) return 0;
    if (!t->lf_ready) {
        @errhandler(CCError e) {
            (void)e;
            return 0;
        }
        rtx_lf_ensure((RtxPieceTree *)t) !>;
    }
    if (t->root && t->root->color != RTX_RB_BLACK) return 0;
    if (t->root && t->root->parent) return 0;
    rtx_check_node(t, t->root, NULL, &bh, &err);
    return err == 0;
}

@typehooks on RtxPieceTree {
    .destroy = RtxPieceTree_destroy,
};

#endif /* RTX_PIECE_TREE_H */
