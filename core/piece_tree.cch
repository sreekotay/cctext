#!ccc cch
/*
 * Order-statistic piece tree: page store (path original + spilled add) or
 * borrowed buffer, pieces in a red-black tree weighted by byte length and
 * '\n' count.
 *
 * Split for readability:
 *   piece_tree_rb.cch    — RB ops + find_node (textual include)
 *   piece_tree_lines.cch — stride index + line_* (textual include)
 *   page_store.cch/.ccs  — document-epoch page cache (linked TU)
 *   hex.cch/.ccs         — hex-view geometry (linked TU; via layout)
 *
 * Offset lookup is O(log pieces). Line lookup uses a stride index so a
 * single original piece is not an O(file) scan. Store-backed bytes are
 * not returnable views (DESIGN: lifetime is a field). Nodes and line
 * index share the tree arena (document epoch). Fragmented or store-backed
 * ranges copy onto caller scratch via read_at.
 */
#ifndef RTX_PIECE_TREE_H
#define RTX_PIECE_TREE_H

#include <ccc/std/prelude.cch>
#include <errno.h>
#include <unistd.h>
#include <stdlib.h>
#include <string.h>
#include <time.h>

#include "page_store.cch"

/*
 * Progressive line-index faults. Distinct from CCError on purpose: no
 * `@typeview { as: base; }` — @errhandler must not merge with save/edit
 * (DESIGN Surfaces).
 */
typedef struct {
    const char *message;
} RtxIndexErr;

static inline RtxIndexErr rtx_index_err(const char *msg) {
    RtxIndexErr e;
    e.message = msg ? msg : "line index";
    return e;
}

static inline RtxIndexErr rtx_index_from_cc(CCError e) {
    return rtx_index_err(e.message);
}

#define RTX_RB_RED 1
#define RTX_RB_BLACK 0
#define RTX_LINE_STRIDE 64
#define RTX_FRAME_SCRATCH 8192
/* Scratch for lf counting / stride rebuilds (not the page cache). */
#define RTX_IO_CHUNK 4096
/* Above this size, prefer progressive line index: edits must not scan to EOF. */
#define RTX_LINE_SOFT_MIN (32 * 1024 * 1024)

typedef enum {
    RTX_BUF_ORIGINAL = 0,
    RTX_BUF_ADD = 1,
} RtxBufKind;

typedef struct {
    RtxBufKind buf;
    size_t start;
    size_t len;
    size_t lf_count;
} RtxPiece;

typedef struct RtxNode RtxNode;
typedef struct RtxPieceTree RtxPieceTree;

/* Optional UI pulse while a long scan/save runs on this tree.
 * Frontends bind via w.busy_bind; headless smokes leave it NULL. */
typedef void (*RtxBusyFn)(void *ctx, const char *label, int pct);


struct RtxNode {
    RtxPiece piece;
    RtxNode *left;
    RtxNode *right;
    RtxNode *parent;
    uint8_t color;
    size_t subtree_len;
    size_t subtree_lf;
};

struct RtxPieceTree {
    RtxNode *root;
    RtxNode *free_list;
    CCArena arena_storage;
    CCArena *arena;
    /* Borrowed from_buffer only; empty for from_path (store-backed). */
    char[:] original;
    RtxPageStore store;
    size_t add_len; /* == store.add_len; tip-extend sentinel */
    /* Start offset of every RTX_LINE_STRIDE-th line. */
    size_t *line_off;
    size_t line_off_len;
    size_t line_off_cap;
    int line_off_ok;
    /* Set when a line_* scan hits I/O/OOM; clears line_off_ok. */
    int line_index_fault;
    /* When set, insert/erase skip stride updates (caller patches once). */
    int line_off_suspend;
    /* 0 after store-backed from_path until a newline pass reaches EOF.
     * Open must not scan the body (DESIGN: open is instant). */
    int lf_ready;
    /* Progressive newline scan (valid when !lf_ready). */
    size_t line_scan_off;  /* next byte to read */
    size_t scan_line;      /* newlines seen so far */
    /* UI progress drawer (session binding; survives destroy/reopen). */
    RtxBusyFn busy_fn;
    void *busy_ctx;
    double busy_last_ms;
};


static double rtx_mono_ms(void) {
    struct timespec ts;
    if (clock_gettime(CLOCK_MONOTONIC, &ts) != 0) return 0.0;
    return (double)ts.tv_sec * 1000.0 + (double)ts.tv_nsec / 1.0e6;
}

static void RtxPieceTree_busy_bind(RtxPieceTree *t, RtxBusyFn fn, void *ctx) {
    if (!t) return;
    t->busy_fn = fn;
    t->busy_ctx = ctx;
    t->busy_last_ms = 0.0;
}

static void rtx_busy_end(RtxPieceTree *t) {
    if (!t || !t->busy_fn) return;
    t->busy_fn(t->busy_ctx, NULL, 100);
    t->busy_last_ms = 0.0;
}

/* Throttled progress. pct is 0..100, or -1 when total is unknown.
 * Mutates busy_last_ms — not const. */
static void rtx_busy_pulse(RtxPieceTree *t, const char *label, size_t done,
                           size_t total) {
    double now;
    int pct;
    if (!t || !t->busy_fn || !label) return;
    now = rtx_mono_ms();
    if (t->busy_last_ms > 0.0 && now - t->busy_last_ms < 50.0 &&
        !(total > 0 && done >= total)) {
        return;
    }
    t->busy_last_ms = now;
    if (total == 0) pct = -1;
    else if (done >= total) pct = 100;
    else pct = (int)((done * 100) / total);
    t->busy_fn(t->busy_ctx, label, pct);
}

static size_t rtx_count_lf(const char *p, size_t n) {
    size_t c = 0;
    size_t i;
    if (!p) return 0;
    for (i = 0; i < n; i++) {
        if (p[i] == '\n') c++;
    }
    return c;
}

static size_t rtx_original_len(const RtxPieceTree *t) {
    if (!t) return 0;
    if (t->original.ptr) return t->original.len;
    return t->store.orig_len;
}

static int rtx_orig_is_mem(const RtxPieceTree *t) {
    return t && t->original.ptr != NULL;
}

/* Count newlines in a piece range. Store I/O surfaces as Result. */
static size_t !>(CCError) rtx_buf_count_lf(const RtxPieceTree *t, RtxBufKind buf,
                                            size_t start, size_t len) {
    char tmp[RTX_IO_CHUNK];
    size_t off = 0;
    size_t c = 0;
    if (!t) return cc_err(CC_ERR_INVALID_ARG, "count lf");
    if (len == 0) return cc_ok(0);
    if (buf == RTX_BUF_ORIGINAL && rtx_orig_is_mem(t)) {
        if (start > t->original.len || len > t->original.len - start) {
            return cc_err(CC_ERR_INTERNAL, "orig lf range");
        }
        return cc_ok(rtx_count_lf((const char *)t->original.ptr + start, len));
    }
    {
        RtxStoreFile f = (buf == RTX_BUF_ORIGINAL) ? RTX_STORE_ORIG : RTX_STORE_ADD;
        while (off < len) {
            size_t take = len - off;
            if (take > sizeof(tmp)) take = sizeof(tmp);
            RtxPageStore_read((RtxPageStore *)&t->store, f, start + off, tmp, take) !>(e) {
                return cc_err(e);
            };
            c += rtx_count_lf(tmp, take);
            off += take;
        }
    }
    return cc_ok(c);
}

/* Copy piece bytes [local, local+n) into dest. */
static void !>(CCError) rtx_piece_read(const RtxPieceTree *t, const RtxPiece *p,
                                      size_t local, char *dest, size_t n) {
    if (!t || !p || !dest) return cc_err(CC_ERR_INVALID_ARG, "piece read");
    if (n == 0) return cc_ok();
    if (local > p->len || n > p->len - local) {
        return cc_err(CC_ERR_INTERNAL, "piece read range");
    }
    if (p->buf == RTX_BUF_ORIGINAL && rtx_orig_is_mem(t)) {
        memcpy(dest, (const char *)t->original.ptr + p->start + local, n);
        return cc_ok();
    }
    {
        RtxStoreFile f = (p->buf == RTX_BUF_ORIGINAL) ? RTX_STORE_ORIG : RTX_STORE_ADD;
        return RtxPageStore_read((RtxPageStore *)&t->store, f, p->start + local, dest, n);
    }
}

#include "piece_tree_rb.cch"


static size_t !>(CCError) rtx_add_append(RtxPieceTree *t, char[:] bytes) {
    size_t start;
    if (!t) return cc_err(CC_ERR_INVALID_ARG, "add append");
    if (bytes.len == 0) return cc_ok(t->add_len);
    if (!bytes.ptr) return cc_err(CC_ERR_INVALID_ARG, "null add bytes");
    start = RtxPageStore_append_add(&t->store, bytes.ptr, bytes.len) !>(e) {
        return cc_err(e);
    };
    t->add_len = t->store.add_len;
    return cc_ok(start);
}

static void rtx_tree_zero(RtxPieceTree *t) {
    RtxBusyFn fn;
    void *ctx;
    if (!t) return;
    /* Busy is a UI session binding, not document-epoch state. */
    fn = t->busy_fn;
    ctx = t->busy_ctx;
    memset(t, 0, sizeof(*t));
    t->busy_fn = fn;
    t->busy_ctx = ctx;
    rtx_page_store_zero(&t->store);
}

static int rtx_tree_is_live(const RtxPieceTree *t) {
    return t && (t->arena != NULL || rtx_page_store_is_open(&t->store) ||
                 t->original.ptr != NULL);
}

static int rtx_tree_init_arena(RtxPieceTree *t) {
    t->arena_storage = cc_arena_heap(kilobytes(64));
    if (!t->arena_storage.base) return 0;
    t->arena = &t->arena_storage;
    return 1;
}

static void !>(CCError) rtx_lf_recount_node(RtxPieceTree *t, RtxNode *n) {
    if (!n) return cc_ok();
    rtx_lf_recount_node(t, n->left) !>(e) { return cc_err(e); };
    n->piece.lf_count = rtx_buf_count_lf(t, n->piece.buf, n->piece.start,
                                          n->piece.len) !>(e) {
        return cc_err(e);
    };
    rtx_lf_recount_node(t, n->right) !>(e) { return cc_err(e); };
    rtx_node_pull(n);
    return cc_ok();
}

static int rtx_line_off_push(RtxPieceTree *t, size_t off);

static void !>(CCError) rtx_tree_seed_original(RtxPieceTree *t) {
    RtxNode *n;
    size_t olen;
    size_t lf;
    olen = rtx_original_len(t);
    if (!olen) {
        t->lf_ready = 1;
        return cc_ok();
    }
    if (rtx_orig_is_mem(t)) {
        lf = rtx_buf_count_lf(t, RTX_BUF_ORIGINAL, 0, olen) !>(e) {
            return cc_err(e);
        };
        t->lf_ready = 1;
        t->line_off_ok = 0;
    } else {
        lf = 0;
        t->lf_ready = 0;
        t->line_scan_off = 0;
        t->scan_line = 0;
        t->line_off_ok = 0;
    }
    n = rtx_node_new_piece_lf(t, RTX_BUF_ORIGINAL, 0, olen, lf);
    if (!n) return cc_err(CC_ERR_OUT_OF_MEMORY, "seed original");
    n->color = RTX_RB_BLACK;
    t->root = n;
    if (!t->lf_ready) {
        if (!rtx_line_off_push(t, 0)) return cc_err(CC_ERR_OUT_OF_MEMORY, "line_off");
    }
    return cc_ok();
}

static inline size_t RtxPieceTree_len(const RtxPieceTree *t) {
    if (!t || !t->root) return 0;
    return t->root->subtree_len;
}

/* Success: got = min(n, len-off). A hole inside that range is INTERNAL. */
static inline size_t !>(CCError) RtxPieceTree_read_at(const RtxPieceTree *t, size_t offset,
                                                      char *dest, size_t n) {
    size_t got = 0;
    size_t len;
    size_t need;
    if (!t || !dest) return cc_err(CC_ERR_INVALID_ARG, "read_at");
    if (n == 0) return cc_ok(0);
    len = RtxPieceTree_len(t);
    if (offset >= len) return cc_ok(0);
    if (n > len - offset) n = len - offset;
    need = n;
    while (got < n) {
        size_t local = 0;
        RtxNode *node = rtx_find_node(t, offset + got, &local);
        size_t take;
        if (!node) return cc_err(CC_ERR_INTERNAL, "read_at hole");
        take = node->piece.len - local;
        if (take > n - got) take = n - got;
        rtx_piece_read(t, &node->piece, local, dest + got, take) !>(e) {
            return cc_err(e);
        };
        got += take;
    }
    if (got != need) return cc_err(CC_ERR_INTERNAL, "read_at short");
    return cc_ok(got);
}

/*
 * Extend the progressive line scan through byte `want_off`.
 */
static void !>(RtxIndexErr) rtx_line_scan_to(RtxPieceTree *t, size_t want_off) {
    size_t len;
    char buf[64 * 1024];
    if (!t) return cc_err(rtx_index_err("scan"));
    if (t->lf_ready) return cc_ok();
    len = RtxPieceTree_len(t);
    if (want_off > len) want_off = len;
    if (t->line_off_len == 0) {
        if (!rtx_line_off_push(t, 0)) return cc_err(rtx_index_err("line_off"));
    }
    while (t->line_scan_off < want_off) {
        size_t take = want_off - t->line_scan_off;
        size_t got, i;
        if (take > sizeof(buf)) take = sizeof(buf);
        rtx_busy_pulse(t, "indexing", t->line_scan_off, want_off);
        got = RtxPieceTree_read_at(t, t->line_scan_off, buf, take) !>(e) {
            rtx_busy_end(t);
            return cc_err(rtx_index_from_cc(e));
        };
        if (!got) {
            rtx_busy_end(t);
            return cc_err(rtx_index_err("line scan"));
        }
        for (i = 0; i < got; i++) {
            if (buf[i] == '\n') {
                t->scan_line++;
                if (t->scan_line % (size_t)RTX_LINE_STRIDE == 0) {
                    if (!rtx_line_off_push(t, t->line_scan_off + i + 1)) {
                        rtx_busy_end(t);
                        return cc_err(rtx_index_err("line_off"));
                    }
                }
            }
        }
        t->line_scan_off += got;
    }
    rtx_busy_end(t);
    if (t->line_scan_off >= len) {
        if (t->root && !t->root->left && !t->root->right) {
            t->root->piece.lf_count = t->scan_line;
            rtx_node_pull(t->root);
            t->lf_ready = 1;
            t->line_off_ok = 1;
        } else if (len <= (size_t)RTX_LINE_SOFT_MIN) {
            rtx_lf_recount_node(t, t->root) !>(e) {
                return cc_err(rtx_index_from_cc(e));
            };
            t->lf_ready = 1;
            t->line_off_ok = 1;
        } else {
            /* Edited huge doc: keep progressive; scan_line is exact at EOF. */
            t->line_off_ok = 1;
        }
    }
    return cc_ok();
}

/* Scan until line index `want_line` is known (scan_line >= want_line) or EOF. */
static void !>(RtxIndexErr) rtx_line_scan_through_line(RtxPieceTree *t, size_t want_line) {
    size_t len;
    char buf[64 * 1024];
    if (!t) return cc_err(rtx_index_err("scan"));
    if (t->lf_ready) return cc_ok();
    len = RtxPieceTree_len(t);
    if (t->line_off_len == 0) {
        if (!rtx_line_off_push(t, 0)) return cc_err(rtx_index_err("line_off"));
    }
    while (t->scan_line < want_line && t->line_scan_off < len) {
        size_t got, i;
        size_t take = sizeof(buf);
        if (take > len - t->line_scan_off) take = len - t->line_scan_off;
        rtx_busy_pulse(t, "jump", t->scan_line, want_line);
        got = RtxPieceTree_read_at(t, t->line_scan_off, buf, take) !>(e) {
            rtx_busy_end(t);
            return cc_err(rtx_index_from_cc(e));
        };
        if (!got) {
            rtx_busy_end(t);
            return cc_err(rtx_index_err("line scan"));
        }
        for (i = 0; i < got; i++) {
            if (buf[i] == '\n') {
                t->scan_line++;
                if (t->scan_line % (size_t)RTX_LINE_STRIDE == 0) {
                    if (!rtx_line_off_push(t, t->line_scan_off + i + 1)) {
                        rtx_busy_end(t);
                        return cc_err(rtx_index_err("line_off"));
                    }
                }
                if (t->scan_line >= want_line) {
                    t->line_scan_off += i + 1;
                    break;
                }
            }
        }
        if (t->scan_line >= want_line) break;
        t->line_scan_off += got;
    }
    rtx_busy_end(t);
    if (t->line_scan_off >= len) {
        if (t->root && !t->root->left && !t->root->right) {
            t->root->piece.lf_count = t->scan_line;
            rtx_node_pull(t->root);
            t->lf_ready = 1;
            t->line_off_ok = 1;
        } else if (len <= (size_t)RTX_LINE_SOFT_MIN) {
            rtx_lf_recount_node(t, t->root) !>(e) {
                return cc_err(rtx_index_from_cc(e));
            };
            t->lf_ready = 1;
            t->line_off_ok = 1;
        } else {
            t->line_off_ok = 1;
        }
    }
    return cc_ok();
}

/* Finish newline weights. Completes any progressive scan to EOF. */
static void !>(CCError) rtx_lf_ensure(RtxPieceTree *t) {
    if (!t || t->lf_ready) return cc_ok();
    rtx_line_scan_to(t, RtxPieceTree_len(t)) !>(e) {
        return cc_err(CC_ERR_IO, e.message ? e.message : "line index");
    };
    if (!t->lf_ready && t->root) {
        rtx_lf_recount_node(t, t->root) !>(e) { return cc_err(e); };
        t->lf_ready = 1;
        t->line_off_ok = 1;
    }
    return cc_ok();
}

/*
 * Append a copy of [from, from+n) at EOF via frame chunk + store append.
 * Does not touch the line index — set line_off_suspend and patch once afterward.
 * Returns newlines copied.
 */
static size_t !>(CCError) RtxPieceTree_append_copy(RtxPieceTree *t, size_t from,
                                                      size_t n) {
    size_t off = 0;
    size_t local = 0;
    RtxNode *tip;
    size_t lf = 0;
    char chunk[64 * 1024];
    if (!t) return cc_err(CC_ERR_INVALID_ARG, "null tree");
    if (n == 0) return cc_ok((size_t)0);
    if (from > RtxPieceTree_len(t) || n > RtxPieceTree_len(t) - from) {
        return cc_err(CC_ERR_INVALID_ARG, "append_copy range");
    }
    rtx_lf_ensure(t) !>(e) { return cc_err(e); };

    tip = NULL;
    if (RtxPieceTree_len(t) > 0) {
        tip = rtx_find_node(t, RtxPieceTree_len(t) - 1, &local);
        if (tip && tip->piece.buf == RTX_BUF_ADD &&
            tip->piece.start + tip->piece.len == t->add_len &&
            local + 1 == tip->piece.len) {
            /* extendable tip */
        } else {
            tip = NULL;
        }
    }
    if (!tip) {
        tip = rtx_node_new_piece_lf(t, RTX_BUF_ADD, t->add_len, 0, 0);
        if (!tip) return cc_err(CC_ERR_OUT_OF_MEMORY, "append tip");
        rtx_bst_insert(t, tip, RtxPieceTree_len(t));
    }

    while (off < n) {
        size_t take = n - off;
        size_t got, i;
        size_t start;
        if (take > sizeof(chunk)) take = sizeof(chunk);
        got = RtxPieceTree_read_at(t, from + off, chunk, take) !>(e) {
            return cc_err(e);
        };
        if (got != take) return cc_err(CC_ERR_INTERNAL, "append_copy read");
        start = RtxPageStore_append_add(&t->store, chunk, got) !>(e) {
            return cc_err(e);
        };
        if (tip->piece.len == 0) tip->piece.start = start;
        else if (start != tip->piece.start + tip->piece.len) {
            return cc_err(CC_ERR_INTERNAL, "append_copy gap");
        }
        for (i = 0; i < got; i++) {
            if (chunk[i] == '\n') lf++;
        }
        t->add_len = t->store.add_len;
        tip->piece.len += got;
        off += got;
    }
    tip->piece.lf_count += lf;
    rtx_node_pull_up(tip);
    return cc_ok(lf);
}

/* Contiguous borrowed original, or empty if store-backed / split. */
static inline char[:] RtxPieceTree_flat(const RtxPieceTree *t) {
    RtxNode *n;
    if (!t || !t->root || !rtx_orig_is_mem(t)) return cc_slice_empty();
    n = t->root;
    if (n->left || n->right) return cc_slice_empty();
    if (n->piece.buf != RTX_BUF_ORIGINAL) return cc_slice_empty();
    if (n->piece.start != 0 || n->piece.len != t->original.len) return cc_slice_empty();
    return t->original;
}

/* View of [from, from+n) when it sits in one borrowed contiguous piece.
 * Store-backed pieces return empty (DESIGN: no stable page views). */
static inline char[:] RtxPieceTree_span(const RtxPieceTree *t, size_t from, size_t n) {
    size_t local = 0;
    size_t len;
    RtxNode *node;
    char[:] piece;
    if (!t || n == 0) return cc_slice_empty();
    len = RtxPieceTree_len(t);
    if (from >= len) return cc_slice_empty();
    if (n > len - from) n = len - from;
    {
        char[:] flat = RtxPieceTree_flat(t);
        if (flat.ptr && from <= flat.len && n <= flat.len - from) {
            return flat.sub(from, from + n);
        }
    }
    node = rtx_find_node(t, from, &local);
    if (!node || local + n > node->piece.len) return cc_slice_empty();
    if (node->piece.buf != RTX_BUF_ORIGINAL || !rtx_orig_is_mem(t)) {
        return cc_slice_empty();
    }
    piece = t->original.sub(node->piece.start,
                            node->piece.start + node->piece.len);
    return piece.sub(local, local + n);
}

/* Document view if contiguous; otherwise a copy on `scratch` (scratch epoch).
 * Empty is a payload (n == 0 / past end). OOM and short read are errors. */
static inline char[:] !>(CCError) RtxPieceTree_scratch_span(const RtxPieceTree *t, CCArena *scratch,
                                                size_t from, size_t n) {
    char[:] view;
    char[:] copy;
    size_t len;
    if (!t) return cc_err(CC_ERR_INVALID_ARG, "null tree");
    if (n == 0) return cc_ok(cc_slice_empty());
    view = RtxPieceTree_span(t, from, n);
    if (view.ptr) return cc_ok(view);
    if (!scratch) return cc_err(CC_ERR_INVALID_ARG, "null scratch");
    len = RtxPieceTree_len(t);
    if (from >= len) return cc_ok(cc_slice_empty());
    if (n > len - from) n = len - from;
    if (n == 0) return cc_ok(cc_slice_empty());
    copy = scratch->alloc_slice_bytes(n);
    if (!copy.ptr || copy.len < n) return cc_err(CC_ERR_OUT_OF_MEMORY, "scratch span");
    {
        size_t got = t->read_at(from, copy.ptr, n) !>(e) { return cc_err(e); };
        if (got != n) return cc_err(CC_ERR_INTERNAL, "scratch span read");
    }
    return cc_ok(copy);
}

static inline void RtxPieceTree_destroy(RtxPieceTree *t) {
    if (!t) return;
    t->store.destroy();
    /* line_off lives on the piece-tree arena — do not free() it. */
    if (t->arena && t->arena->base) {
        t->arena_storage.destroy();
    }
    rtx_tree_zero(t);
}

static inline void !>(CCError) RtxPieceTree_empty(RtxPieceTree *t) {
    if (!t) return cc_err(CC_ERR_INVALID_ARG, "null tree");
    if (rtx_tree_is_live(t)) return cc_err(CC_ERR_INVALID_ARG, "tree already live");
    rtx_tree_zero(t);
    if (!rtx_tree_init_arena(t)) {
        return cc_err(CC_ERR_OUT_OF_MEMORY, "piece tree arena");
    }
    t->lf_ready = 1;
    return cc_ok();
}

static inline void !>(CCError) RtxPieceTree_from_buffer(RtxPieceTree *t, char[:] bytes) {
    if (!t) return cc_err(CC_ERR_INVALID_ARG, "null tree");
    if (rtx_tree_is_live(t)) return cc_err(CC_ERR_INVALID_ARG, "tree already live");
    if (bytes.len && cc_slice_is_untracked_id(bytes.id)) {
        return cc_err(CC_ERR_INVALID_ARG, "untracked buffer");
    }
    rtx_tree_zero(t);
    if (!rtx_tree_init_arena(t)) {
        return cc_err(CC_ERR_OUT_OF_MEMORY, "piece tree arena");
    }
    t->original = bytes;
    rtx_tree_seed_original(t) !>(e) {
        RtxPieceTree_destroy(t);
        return cc_err(e);
    };
    return cc_ok();
}

static inline void !>(CCError) RtxPieceTree_from_path(RtxPieceTree *t, const char *path) {
    if (!t) return cc_err(CC_ERR_INVALID_ARG, "null tree");
    if (rtx_tree_is_live(t)) return cc_err(CC_ERR_INVALID_ARG, "tree already live");
    rtx_tree_zero(t);
    if (!path || !path[0]) return cc_err(CC_ERR_INVALID_ARG, "empty path");
    if (!rtx_tree_init_arena(t)) {
        return cc_err(CC_ERR_OUT_OF_MEMORY, "piece tree arena");
    }
    RtxPageStore_open_original(&t->store, path) !>(e) {
        RtxPieceTree_destroy(t);
        return cc_err(e);
    };
    if (t->store.orig_len == 0) {
        t->lf_ready = 1;
        return cc_ok();
    }
    rtx_tree_seed_original(t) !>(e) {
        RtxPieceTree_destroy(t);
        return cc_err(e);
    };
    return cc_ok();
}

/* Split the piece containing `offset` so a node begins at `offset`.
 * Allocates the right node before shrinking the left. offset == len is a no-op.
 * When lf weights are not ready, both sides keep lf_count 0 (progressive index
 * does not need them). When ready, count only the shorter side and subtract. */
static void !>(CCError) rtx_split_at(RtxPieceTree *t, size_t offset) {
    size_t local = 0;
    RtxNode *n;
    RtxNode *right;
    size_t right_len;
    RtxBufKind buf;
    size_t start;
    size_t right_lf;
    size_t left_lf;
    if (!t) return cc_err(CC_ERR_INVALID_ARG, "null tree");
    if (offset == 0 || offset == RtxPieceTree_len(t)) return cc_ok();
    n = rtx_find_node(t, offset, &local);
    if (!n) return cc_err(CC_ERR_INTERNAL, "split node");
    if (local == 0) return cc_ok();
    right_len = n->piece.len - local;
    buf = n->piece.buf;
    start = n->piece.start + local;
    if (!t->lf_ready) {
        right_lf = 0;
        left_lf = 0;
    } else if (local <= right_len) {
        left_lf = rtx_buf_count_lf(t, buf, n->piece.start, local) !>(e) {
            return cc_err(e);
        };
        if (left_lf > n->piece.lf_count) {
            return cc_err(CC_ERR_INTERNAL, "split lf");
        }
        right_lf = n->piece.lf_count - left_lf;
    } else {
        right_lf = rtx_buf_count_lf(t, buf, start, right_len) !>(e) { return cc_err(e); };
        if (right_lf > n->piece.lf_count) {
            return cc_err(CC_ERR_INTERNAL, "split lf");
        }
        left_lf = n->piece.lf_count - right_lf;
    }
    right = rtx_node_new_piece_lf(t, buf, start, right_len, right_lf);
    if (!right) return cc_err(CC_ERR_OUT_OF_MEMORY, "split node");
    n->piece.len = local;
    n->piece.lf_count = left_lf;
    rtx_node_pull_up(n);
    rtx_bst_insert(t, right, offset);
    return cc_ok();
}

static void rtx_line_index_note_insert(RtxPieceTree *t, size_t off, size_t ins_len,
                                       size_t lf);
static void rtx_line_index_note_erase(RtxPieceTree *t, size_t off, size_t n,
                                      size_t lf);
static size_t !>(RtxIndexErr) rtx_count_lf_range(const RtxPieceTree *t, size_t from,
                                                 size_t n);

/* True when the body is large enough that edits must not finish a full lf scan. */
static int rtx_lf_huge(const RtxPieceTree *t) {
    return t && RtxPieceTree_len(t) > (size_t)RTX_LINE_SOFT_MIN;
}

/*
 * Truncate the progressive index at `off` and clear lf_ready so later
 * line_* resume from here. Does not read past `off`.
 */
static void !>(CCError) rtx_lf_invalidate_from(RtxPieceTree *t, size_t off) {
    size_t keep, from_slot, at;
    size_t extra;
    @errhandler(CCError e) {
        return cc_err(e);
    }
    @errhandler(RtxIndexErr ie) {
        return cc_err(CC_ERR_IO, ie.message ? ie.message : "line index");
    }
    if (!t) return cc_err(CC_ERR_INVALID_ARG, "invalidate");
    if (t->line_off_len == 0) {
        if (!rtx_line_off_push(t, 0)) return cc_err(CC_ERR_OUT_OF_MEMORY, "line_off");
    }
    keep = 0;
    while (keep < t->line_off_len && t->line_off[keep] < off) keep++;
    from_slot = keep > 0 ? keep - 1 : 0;
    t->line_off_len = from_slot + 1;
    at = t->line_off[from_slot];
    if (at > off) at = 0;
    extra = 0;
    if (off > at) {
        extra = rtx_count_lf_range(t, at, off - at) !>;
    }
    t->scan_line = from_slot * (size_t)RTX_LINE_STRIDE + extra;
    t->line_scan_off = off;
    t->lf_ready = 0;
    t->line_off_ok = 1;
    return cc_ok();
}

/*
 * Prepare for a mutation at `off`: on huge files scan only through `off`
 * (never to EOF). Tip inserts (`off == len`) keep the current frontier.
 * Small files still finish the index.
 */
static void !>(CCError) rtx_lf_prepare_edit(RtxPieceTree *t, size_t off) {
    size_t len;
    if (!t) return cc_err(CC_ERR_INVALID_ARG, "prepare edit");
    len = RtxPieceTree_len(t);
    if (off > len) off = len;
    if (rtx_lf_huge(t)) {
        if (off < len) {
            if (!t->lf_ready) {
                rtx_line_scan_to(t, off) !>(e) {
                    return cc_err(CC_ERR_IO, e.message ? e.message : "line index");
                };
            }
            rtx_lf_invalidate_from(t, off) !>(e) { return cc_err(e); };
        } else {
            /* Tip insert/erase: do not scan the unscanned tail. */
            t->lf_ready = 0;
            if (t->line_off_len == 0) {
                if (!rtx_line_off_push(t, 0)) {
                    return cc_err(CC_ERR_OUT_OF_MEMORY, "line_off");
                }
            }
            t->line_off_ok = 1;
        }
        return cc_ok();
    }
    rtx_lf_ensure(t) !>(e) { return cc_err(e); };
    return cc_ok();
}

/* 1 = tip-extended; 0 = not applicable (caller should split+insert). */
static int !>(CCError) rtx_try_extend_add(RtxPieceTree *t, size_t offset, char[:] bytes) {
    size_t local = 0;
    RtxNode *n;
    if (!t || bytes.len == 0 || offset == 0) return cc_ok(0);
    n = rtx_find_node(t, offset - 1, &local);
    if (!n) return cc_ok(0);
    if (n->piece.buf != RTX_BUF_ADD) return cc_ok(0);
    if (n->piece.start + n->piece.len != t->add_len) return cc_ok(0);
    if (local + 1 != n->piece.len) return cc_ok(0);
    rtx_add_append(t, bytes) !>(e) { return cc_err(e); };
    n->piece.len += bytes.len;
    n->piece.lf_count += rtx_count_lf(bytes.ptr, bytes.len);
    rtx_node_pull_up(n);
    return cc_ok(1);
}

static inline void !>(CCError) RtxPieceTree_insert(RtxPieceTree *t, size_t offset, char[:] bytes) {
    size_t start = 0;
    RtxNode *n;
    size_t len;
    size_t lf;
    int extended;
    if (!t) return cc_err(CC_ERR_INVALID_ARG, "null tree");
    len = RtxPieceTree_len(t);
    if (offset > len) return cc_err(CC_ERR_INVALID_ARG, "insert past end");
    if (bytes.len == 0) return cc_ok();
    rtx_lf_prepare_edit(t, offset) !>(e) { return cc_err(e); };
    extended = rtx_try_extend_add(t, offset, bytes) !>(e) { return cc_err(e); };
    if (extended) {
        if (!t->line_off_suspend) {
            rtx_line_index_note_insert(t, offset, bytes.len,
                                      rtx_count_lf(bytes.ptr, bytes.len));
        }
        return cc_ok();
    }
    rtx_split_at(t, offset) !>(e) { return cc_err(e); };
    start = rtx_add_append(t, bytes) !>(e) { return cc_err(e); };
    lf = rtx_count_lf(bytes.ptr, bytes.len);
    n = rtx_node_new_piece_lf(t, RTX_BUF_ADD, start, bytes.len, lf);
    if (!n) return cc_err(CC_ERR_OUT_OF_MEMORY, "piece node");
    rtx_bst_insert(t, n, offset);
    if (!t->line_off_suspend) {
        rtx_line_index_note_insert(t, offset, bytes.len, n->piece.lf_count);
    }
    return cc_ok();
}

static inline void !>(CCError) RtxPieceTree_erase(RtxPieceTree *t, size_t offset, size_t n) {
    size_t len;
    size_t end;
    size_t erased;
    size_t lf = 0;
    @errhandler(CCError e) {
        return cc_err(e);
    }
    @errhandler(RtxIndexErr ie) {
        return cc_err(CC_ERR_IO, ie.message ? ie.message : "line index");
    }
    if (!t) return cc_err(CC_ERR_INVALID_ARG, "null tree");
    len = RtxPieceTree_len(t);
    if (offset > len || n > len - offset) {
        return cc_err(CC_ERR_INVALID_ARG, "erase out of range");
    }
    if (n == 0) return cc_ok();
    rtx_lf_prepare_edit(t, offset) !>;
    /* Count deleted newlines before the tree changes (for index patch). */
    lf = rtx_count_lf_range(t, offset, n) !>;
    end = offset + n;
    erased = n;
    rtx_split_at(t, offset) !>;
    rtx_split_at(t, end) !>;
    while (n > 0) {
        size_t local = 0;
        RtxNode *node = rtx_find_node(t, offset, &local);
        size_t piece_len;
        if (!node || local != 0) {
            t->line_off_ok = 0;
            return cc_err(CC_ERR_INTERNAL, "erase walk");
        }
        piece_len = node->piece.len;
        if (piece_len > n) {
            t->line_off_ok = 0;
            return cc_err(CC_ERR_INTERNAL, "erase piece");
        }
        rtx_rb_delete(t, node);
        n -= piece_len;
    }
    if (!t->line_off_suspend) {
        rtx_line_index_note_erase(t, offset, erased, lf);
    } else {
        t->line_off_ok = 0;
    }
    return cc_ok();
}

/* One user-visible change. Holds a copy of `del` so rollback survives
 * add-buffer growth. Insert-fail re-inserts that copy. */
static inline void !>(CCError) RtxPieceTree_replace(RtxPieceTree *t, size_t off, size_t n,
                                                   char[:] ins) {
    char[:] del = cc_slice_empty();
    CCArena hold = {0};
    if (!t) return cc_err(CC_ERR_INVALID_ARG, "null tree");
    if (n == 0 && ins.len == 0) return cc_ok();
    if (n) {
        hold = cc_arena_heap(n + 64);
        if (!hold.base) return cc_err(CC_ERR_OUT_OF_MEMORY, "replace hold");
    }
    @defer { if (hold.base) hold.destroy(); };
    if (n) {
        del = hold.alloc_slice_bytes(n);
        if (!del.ptr || del.len < n) return cc_err(CC_ERR_OUT_OF_MEMORY, "replace del");
        {
            size_t got = t->read_at(off, del.ptr, n) !>(e) { return cc_err(e); };
            if (got != n) return cc_err(CC_ERR_INTERNAL, "replace read");
        }
        t->erase(off, n) !>(e) { return cc_err(e); };
    }
    if (ins.len) {
        t->insert(off, ins) !>(e) {
            if (n && del.ptr) {
                t->insert(off, del) !>(e2) {
                    (void)e2;
                    return cc_err(CC_ERR_INTERNAL, "replace unrestorable");
                };
            }
            return cc_err(e);
        };
    }
    return cc_ok();
}

static void !>(CCError) rtx_write_all(int fd, const char *p, size_t n) {
    size_t off = 0;
    while (off < n) {
        ssize_t w = write(fd, p + off, n - off);
        if (w < 0) {
            if (errno == EINTR) continue;
            return cc_err(CC_ERR_IO, "write");
        }
        if (w == 0) return cc_err(CC_ERR_IO, "write");
        off += (size_t)w;
    }
    return cc_ok();
}

static void !>(CCError) rtx_write_node(RtxPieceTree *t, const RtxNode *n, int fd,
                                         size_t *written, size_t total) {
    char buf[RTX_PAGE_SIZE];
    size_t off;
    if (!n) return cc_ok();
    rtx_write_node(t, n->left, fd, written, total) !>(e) { return cc_err(e); };
    off = 0;
    while (off < n->piece.len) {
        size_t take = n->piece.len - off;
        if (take > sizeof(buf)) take = sizeof(buf);
        rtx_piece_read(t, &n->piece, off, buf, take) !>(e) { return cc_err(e); };
        rtx_write_all(fd, buf, take) !>(e) { return cc_err(e); };
        off += take;
        if (written) {
            *written += take;
            rtx_busy_pulse(t, "saving", *written, total);
        }
    }
    return rtx_write_node(t, n->right, fd, written, total);
}

/* Stream pieces to fd. Does not load the document into one buffer. */
static inline void !>(CCError) RtxPieceTree_write_fd(RtxPieceTree *t, int fd) {
    size_t written = 0;
    size_t total;
    if (!t || fd < 0) return cc_err(CC_ERR_INVALID_ARG, "write_fd");
    if (!t->root) return cc_ok();
    total = RtxPieceTree_len(t);
    rtx_write_node(t, t->root, fd, &written, total) !>(e) {
        rtx_busy_end(t);
        return cc_err(e);
    };
    rtx_busy_end(t);
    return cc_ok();
}

#include "piece_tree_lines.cch"


static int rtx_check_node(const RtxPieceTree *t, const RtxNode *n, const RtxNode *parent,
                          int *black_height, int *err) {
    int lh = 0;
    int rh = 0;
    size_t expect_len;
    size_t expect_lf;
    if (*err) return 0;
    if (!n) {
        *black_height = 1;
        return 1;
    }
    if (n->parent != parent) {
        *err = 1;
        return 0;
    }
    if (n->color == RTX_RB_RED) {
        if ((n->left && n->left->color == RTX_RB_RED) ||
            (n->right && n->right->color == RTX_RB_RED)) {
            *err = 2;
            return 0;
        }
    }
    {
        size_t got_lf = 0;
        @errhandler(CCError e) {
            (void)e;
            *err = 3;
            return 0;
        }
        got_lf = rtx_buf_count_lf(t, n->piece.buf, n->piece.start, n->piece.len) !>;
        if (n->piece.lf_count != got_lf) {
            *err = 3;
            return 0;
        }
    }
    rtx_check_node(t, n->left, n, &lh, err);
    rtx_check_node(t, n->right, n, &rh, err);
    if (*err) return 0;
    if (lh != rh) {
        *err = 4;
        return 0;
    }
    expect_len = n->piece.len + (n->left ? n->left->subtree_len : 0) +
                 (n->right ? n->right->subtree_len : 0);
    expect_lf = n->piece.lf_count + (n->left ? n->left->subtree_lf : 0) +
                (n->right ? n->right->subtree_lf : 0);
    if (n->subtree_len != expect_len || n->subtree_lf != expect_lf) {
        *err = 5;
        return 0;
    }
    *black_height = lh + (n->color == RTX_RB_BLACK ? 1 : 0);
    return 1;
}

static inline int RtxPieceTree_check(const RtxPieceTree *t) {
    int bh = 0;
    int err = 0;
    if (!t) return 0;
    if (!t->lf_ready) {
        @errhandler(CCError e) {
            (void)e;
            return 0;
        }
        rtx_lf_ensure((RtxPieceTree *)t) !>;
    }
    if (t->root && t->root->color != RTX_RB_BLACK) return 0;
    if (t->root && t->root->parent) return 0;
    rtx_check_node(t, t->root, NULL, &bh, &err);
    return err == 0;
}

@typehooks on RtxPieceTree {
    .destroy = RtxPieceTree_destroy,
    .busy_bind = RtxPieceTree_busy_bind,
};

#endif /* RTX_PIECE_TREE_H */
