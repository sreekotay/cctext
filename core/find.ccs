#!ccc ccs
/*
 * Find refine (linked TU). Prefix-extend filters hits and keeps scan_off.
 * A cap resumes at the last accepted hit. Tests wait via finish.
 *
 * Scan: dest-live wrapper so the frame does not wait. The arm is the
 * sequential 2 MiB block loop with @parallel wait / cache / @stage.
 * Write stage appends hits in file order and polls h.paused.
 */
#include <ccc/std/prelude.cch>
#include <limits.h>
#include <stdlib.h>
#include <string.h>
#include "document.cch"
#include "find.cch"

typedef struct {
    char *buf;
    size_t *hits;
    size_t hit_cap;
} RtxFindScratch;

int rtx_find_is_extend(const RtxDoc *d, char[:] q) {
    if (!d || d->find.query.len == 0 || q.len <= d->find.query.len)
        return 0;
    if (!d->find.query.ptr) return 0;
    return q.starts_with(d->find.query);
}

/* Hits are in order. Refill a window when the next off falls out. */
static int !>(CCError) rtx_find_hit_ok(RtxDoc *d, size_t off, const char *q,
                                       size_t qn, char *win, size_t winsz,
                                       size_t *wlo, size_t *whi) {
    size_t n;
    size_t got;
    size_t want;
    if (!d || !q || !win || !wlo || !whi || qn == 0) return cc_ok(0);
    n = d->len();
    if (off >= n || qn > n - off) return cc_ok(0);
    if (off < *wlo || off + qn > *whi) {
        want = winsz;
        if (want < qn) want = qn;
        if (want > n - off) want = n - off;
        got = d->read_at(off, win, want) !>(e) { return cc_err(e); };
        *wlo = off;
        *whi = off + got;
        if (got < qn) return cc_ok(0);
    }
    {
        char[:] win_slice = cc_slice_from_buffer(win + (off - *wlo), qn);
        char[:] q_slice = cc_slice_from_buffer((void *)q, qn);
        return cc_ok(win_slice.eq(q_slice));
    }
}

void !>(CCError) rtx_find_refine(RtxDoc *d, char[:] q) {
    char win[4096];
    char[:] nq;
    size_t qn;
    size_t i;
    size_t o;
    size_t keep;
    size_t last;
    size_t wlo;
    size_t whi;
    size_t n;
    int was_trunc;
    if (!d || !d->find.store.base) return cc_err(CC_ERR_INVALID_ARG, "find refine");
    qn = q.len;
    nq = q.clone_into(d->find.store) !>;
    last = (d->find.truncated && d->find.len) ? d->find.offs[d->find.len - 1] : 0;
    was_trunc = d->find.truncated;
    keep = d->find.cur < d->find.len ? d->find.offs[d->find.cur] : (size_t)-1;
    d->find.query = nq;
    wlo = 1;
    whi = 0;
    o = 0;
    for (i = 0; i < d->find.len; i++) {
        size_t off = d->find.offs[i];
        int ok = rtx_find_hit_ok(d, off, nq.ptr, qn, win, sizeof(win), &wlo,
                                 &whi) !>(e) { return cc_err(e); };
        if (ok) d->find.offs[o++] = off;
    }
    d->find.len = o;
    if (keep != (size_t)-1 && o) {
        d->find.cur = 0;
        for (i = 0; i < o; i++) {
            d->find.cur = i;
            if (d->find.offs[i] >= keep) break;
        }
    } else {
        d->find.cur = 0;
    }
    if (was_trunc) {
        d->find.scan_off = last + 1;
        d->find.done = 0;
        d->find.truncated = 0;
    }
    d->find.cancel = 0;
    n = d->len();
    if (d->find.scan_off + qn > n) {
        d->find.scan_off = n;
        d->find.done = 1;
    }
    return cc_ok();
}

int RtxDoc_find_same_query(const RtxDoc *d, char[:] q) {
    if (!d) return 0;
    return q.eq(d->find.query);
}

static void !>(CCError) rtx_find_listing_start(RtxDoc *d);

void !>(CCError) RtxDoc_find_set(RtxDoc *d, char[:] q) {
    size_t qn;
    CCArena fresh;
    char[:] nq;
    if (!d) return cc_err(CC_ERR_INVALID_ARG, "null doc");
    qn = q.len;
    if (qn > RTX_FIND_QMAX) return cc_err(CC_ERR_INVALID_ARG, "find query too long");
    if (qn == 0) {
        rtx_find_handle_stop(&d->find);
        if (d->find.store.base) d->find.store.reset();
        d->find.query = cc_slice_empty();
        d->find.offs = NULL;
        d->find.cap = 0;
        rtx_find_scan_wipe(d);
        return cc_ok();
    }
    if (d->find_same_query(q)) return cc_ok();
    rtx_find_handle_stop(&d->find);
    if (rtx_find_is_extend(d, q) && d->find.store.base) {
        rtx_find_refine(d, q) !>(e) { return cc_err(e); };
        return rtx_find_listing_start(d);
    }
    fresh = cc_arena_heap(kilobytes(16));
    if (!fresh.base) return cc_err(CC_ERR_OUT_OF_MEMORY, "find store");
    nq = q.clone_into(fresh) !>(e) {
        fresh.destroy();
        return cc_err(e);
    };
    if (d->find.store.base) d->find.store.destroy();
    d->find.store = fresh;
    d->find.query = nq;
    d->find.offs = NULL;
    d->find.cap = 0;
    rtx_find_scan_wipe(d);
    return rtx_find_listing_start(d);
}

static size_t rtx_find_window_adv(size_t got, size_t qn, int last) {
    size_t overlap = qn > 0 ? qn - 1 : 0;
    if (last) return got;
    return got > overlap ? got - overlap : got;
}

static int rtx_find_scratch_ensure(RtxFindScratch *s) {
    if (!s) return 0;
    if (s->buf) return 1;
    s->buf = (char *)malloc((size_t)RTX_FIND_BLOCK + (size_t)RTX_FIND_QMAX);
    return s->buf != NULL;
}

static int rtx_find_scratch_hit(RtxFindScratch *s, size_t *n, size_t off) {
    if (!s || !n) return 0;
    if (*n >= s->hit_cap) {
        size_t c = s->hit_cap ? s->hit_cap * 2 : 64;
        size_t *p = (size_t *)realloc(s->hits, c * sizeof(size_t));
        if (!p) return 0;
        s->hits = p;
        s->hit_cap = c;
    }
    s->hits[(*n)++] = off;
    return 1;
}

static void !>(CCError) rtx_find_append(RtxDoc *d, const size_t *hits, size_t n) {
    size_t room;
    size_t take;
    if (!d || !n) return cc_ok();
    room = (size_t)RTX_FIND_MAX - d->find.len;
    if (!room) {
        d->find.truncated = 1;
        return cc_ok();
    }
    take = n < room ? n : room;
    rtx_arena_grow(d->find.store, (void **)&d->find.offs, &d->find.cap,
                   d->find.len + take, sizeof(size_t)) !>(e) {
        return cc_err(e);
    };
    if (hits) {
        char[:] dst = cc_slice_from_buffer(d->find.offs + d->find.len,
                                           take * sizeof(size_t));
        char[:] src = cc_slice_from_buffer((void *)hits, take * sizeof(size_t));
        dst.copy(src) !>;
    }
    d->find.len += take;
    if (take < n)
        d->find.truncated = 1;
    return cc_ok();
}

/* Swallow Result here — a `return` inside wait-for is a ticket return. */
static size_t rtx_find_read_block(RtxDoc *d, size_t start, char *buf, size_t want) {
    @errhandler(CCError e) {
        (void)e;
        if (d) d->find.cancel = 1;
        return 0;
    }
    if (!d || !buf || !want) return 0;
    return d->tree.read_uncached(start, buf, want) !>;
}

static void rtx_find_append_soft(RtxDoc *d, const size_t *hits, size_t n) {
    rtx_find_append(d, hits, n) !>(e) {
        (void)e;
        if (d) d->find.cancel = 1;
    };
}

/* Wait-for tickets. Joined inside this arm so the dest-live kick returns. */
static int rtx_find_run(RtxDoc *d) {
    size_t nfile;
    size_t span_lo;
    size_t remain;
    size_t n_sz;
    int n;
    int i;
    bool fin;
    if (!d) return 0;
    nfile = d->len();
    span_lo = d->find.scan_off;
    if (span_lo > nfile) span_lo = nfile;
    d->find.scan_base = span_lo;
    d->find.scan_bytes = span_lo;
    remain = nfile - span_lo;
    if (remain == 0 || !d->find.query.len) {
        d->find.done = 1;
        d->find.scan_off = nfile;
        d->find.scan_bytes = nfile;
        return 1;
    }
    n_sz = (remain + (size_t)RTX_FIND_BLOCK - 1) / (size_t)RTX_FIND_BLOCK;
    if (n_sz > (size_t)INT_MAX) return 0;
    n = (int)n_sz;

    {
        @errhandler(CCError e) {
            (void)e;
            return 0;
        }
        RtxFindScratch slot = {0} @destroy {
            if (slot.buf) free(slot.buf);
            if (slot.hits) free(slot.hits);
        };
        CCArena ta = cc_arena_heap(kilobytes(64)) @destroy;
        CCTurnstile ts@(RTX_FIND_CAP, 1, ta) !> @destroy;

        fin = @parallel wait (ts) cache (slot) for (i in 0..n) {
            size_t qn;
            size_t start;
            size_t commit;
            size_t want;
            size_t got;
            size_t adv;
            size_t hit_n;
            size_t lim;
            size_t k;
            size_t nfile_i;
            char q[RTX_FIND_QMAX];
            char *buf;
            size_t *hits;

            nfile_i = nfile;
            qn = d->find.query.len;
            start = span_lo + (size_t)i * (size_t)RTX_FIND_BLOCK;
            commit = (size_t)RTX_FIND_BLOCK;
            if (start >= nfile_i) commit = 0;
            else if (commit > nfile_i - start) commit = nfile_i - start;
            want = commit;
            if (qn > 1 && want > 0) want += qn - 1;
            if (start < nfile_i && want > nfile_i - start)
                want = nfile_i - start;
            if (want < qn) want = 0;
            if (qn && qn <= (size_t)RTX_FIND_QMAX && d->find.query.ptr) {
                char[:] qd = cc_slice_from_buffer(q, qn);
                qd.copy(d->find.query) !>(e) {
                    (void)e;
                    d->find.cancel = 1;
                    want = 0;
                };
            }
            hit_n = 0;
            if (want && !d->find.cancel && !d->find.truncated
                && rtx_find_scratch_ensure(&slot)) {
                buf = slot.buf;
                got = rtx_find_read_block(d, start, buf, want);
                adv = rtx_find_window_adv(got, qn, start + got >= nfile_i);
                if (adv > commit) adv = commit;
                if (got >= qn && adv && qn) {
                    lim = got - qn + 1;
                    if (adv < lim) lim = adv;
                    k = 0;
                    while (k < lim && hit_n < (size_t)RTX_FIND_MAX) {
                        const char *p =
                            (const char *)memmem(buf + k, got - k, q, qn);
                        size_t at;
                        size_t off;
                        if (!p) break;
                        at = (size_t)(p - buf);
                        if (at >= lim) break;
                        off = start + at;
                        if (off >= start + commit) break;
                        if (!rtx_find_scratch_hit(&slot, &hit_n, off))
                            break;
                        k = at + 1;
                    }
                }
            }
            hits = slot.hits;

            @stage (ts, 0, i) {
                while (d->find.h.paused && !d->find.cancel)
                    cc_yield();
                if (!d->find.cancel && !d->find.truncated) {
                    rtx_find_append_soft(d, hits, hit_n);
                    d->find.scan_bytes = start + commit;
                    if (d->find.scan_bytes > nfile_i)
                        d->find.scan_bytes = nfile_i;
                    if (d->find.len >= (size_t)RTX_FIND_MAX && d->find.len
                        && d->find.offs[d->find.len - 1] + 1 < nfile_i)
                        d->find.truncated = 1;
                    if (d->find.truncated && d->find.len)
                        d->find.scan_off =
                            d->find.offs[d->find.len - 1] + 1;
                    else
                        d->find.scan_off = start + commit;
                    if (d->find.truncated || start + commit >= nfile_i) {
                        d->find.done = 1;
                        if (!d->find.truncated) {
                            d->find.scan_off = nfile_i;
                            d->find.scan_bytes = nfile_i;
                        }
                    }
                }
            }

            if (d->find.truncated || d->find.cancel)
                break;
        } !>.wait()!>;
    }

    (void)fin;
    if (d->find.cancel) return 0;
    if (!d->find.done) {
        d->find.done = 1;
        d->find.scan_off = nfile;
        d->find.scan_bytes = nfile;
    }
    return 1;
}

void !>(CCError) RtxDoc_find_step(RtxDoc *d) {
    if (!d) return cc_err(CC_ERR_INVALID_ARG, "null doc");
    if (d->find.done || !d->find.query.len) return cc_ok();
    if (d->find.h_live) return cc_ok();
    return rtx_find_listing_start(d);
}

void !>(CCError) RtxDoc_find_finish(RtxDoc *d) {
    if (!d) return cc_err(CC_ERR_INVALID_ARG, "null doc");
    if (!d->find.h_live && !d->find.done && d->find.query.len
        && !d->find.cancel)
        rtx_find_listing_start(d) !>(e) { return cc_err(e); };
    if (d->find.h_live) {
        d->find.h.wait() !>(e) { return cc_err(e); };
        d->find.h_live = 0;
    }
    return cc_ok();
}

static void !>(CCError) rtx_find_listing_start(RtxDoc *d) {
    int noop = 0;
    if (!d) return cc_err(CC_ERR_INVALID_ARG, "find kick");
    if (d->find.done || !d->find.query.len) return cc_ok();
    if (d->find.cap < (size_t)RTX_FIND_MAX) {
        rtx_arena_grow(d->find.store, (void **)&d->find.offs, &d->find.cap,
                       (size_t)RTX_FIND_MAX, sizeof(size_t))
            !>(e) { return cc_err(e); };
    }
    d->find.h_live = 1;
    d->find.h = @parallel {
        @serial { noop = 0; }
        rtx_find_run(d);
    } !>;
    return cc_ok();
}

void rtx_find_pause(RtxDoc *d) {
    if (!d || !d->find.h_live || d->find.done) return;
    d->find.h.pause() !>(e) { (void)e; };
}

void rtx_find_resume(RtxDoc *d) {
    if (!d || !d->find.h_live || !d->find.h.paused) return;
    d->find.h.resume() !>(e) { (void)e; };
}

static size_t rtx_find_near(const RtxDoc *d) {
    size_t i;
    if (!d || d->find.len == 0) return (size_t)-1;
    for (i = 0; i < d->find.len; i++) {
        if (d->find.offs[i] >= d->find.origin) return i;
    }
    if (d->find.done) return 0;
    return (size_t)-1;
}

static void rtx_find_place(RtxDoc *d, size_t i) {
    size_t n;
    if (!d || d->find.len == 0) return;
    if (i >= d->find.len) i = d->find.len - 1;
    d->find.cur = i;
    d->caret = d->find.offs[i];
    n = d->len();
    d->sel_anchor = d->caret + d->find.query.len;
    if (d->sel_anchor > n) d->sel_anchor = n;
    d->break_coalesce();
}

/* List highlight only. The camera stays until the user selects a hit. */
void rtx_find_mark_near(RtxDoc *d) {
    size_t i;
    if (!d || d->find.pinned) return;
    i = rtx_find_near(d);
    if (i == (size_t)-1) return;
    d->find.cur = i;
}

void RtxDoc_find_goto(RtxDoc *d, size_t i) {
    if (!d) return;
    d->find.pinned = 1;
    rtx_find_place(d, i);
}

void RtxDoc_find_next(RtxDoc *d) {
    if (!d || d->find.len == 0) return;
    if (!d->find.pinned) {
        d->find_goto(d->find.cur);
        return;
    }
    d->find_goto((d->find.cur + 1) % d->find.len);
}

void RtxDoc_find_prev(RtxDoc *d) {
    if (!d || d->find.len == 0) return;
    if (!d->find.pinned) {
        d->find_goto(d->find.cur);
        return;
    }
    d->find_goto(d->find.cur == 0 ? d->find.len - 1 : d->find.cur - 1);
}

void !>(CCError) RtxDoc_find_hit_view(RtxDoc *d, size_t i, CCArena scratch,
                                      size_t maxn, RtxFindHitView *out) {
    size_t off;
    size_t n;
    size_t a;
    size_t z;
    size_t pad;
    @errhandler(CCError e) {
        return cc_err(e);
    }
    if (!d || !scratch.base || !out) return cc_err(CC_ERR_INVALID_ARG, "find hit");
    if (i >= d->find.len) return cc_err(CC_ERR_INVALID_ARG, "find hit");
    *out = (RtxFindHitView){0};
    off = d->find.offs[i];
    n = d->len();
    if (maxn < 8) maxn = 8;
    pad = maxn / 4;
    a = (off > pad) ? off - pad : 0;
    z = a + maxn;
    if (z > n) z = n;
    out->off = off;
    out->line1 = d->line_guess(off) + 1;
    out->col = (off >= a) ? off - a : 0;
    if (z <= a) {
        out->ctx = cc_slice_empty();
        return cc_ok();
    }
    {
        char[:] bytes = d->scratch_span(a, z - a, scratch) !>;
        out->ctx = bytes;
    }
    return cc_ok();
}
