#!ccc ccs
/*
 * Find refine (linked TU). Prefix-extend filters hits and keeps scan_off.
 * A cap resumes at the last accepted hit. Tests wait via finish.
 */
#include <ccc/std/prelude.cch>
#include <stdlib.h>
#include <string.h>
#include "document.cch"
#include "find.cch"

int rtx_find_is_extend(const RtxDoc *d, char[:] q) {
    if (!d || d->find.query.len == 0 || q.len <= d->find.query.len)
        return 0;
    if (!d->find.query.ptr) return 0;
    return memcmp(d->find.query.ptr, q.ptr, d->find.query.len) == 0;
}

/* Hits are in order. Refill a window when the next off falls out. */
static int !>(CCError) rtx_find_hit_ok(RtxDoc *d, size_t off, const char *q,
                                       size_t qn, char *win, size_t winsz,
                                       size_t *wlo, size_t *whi) {
    size_t n;
    size_t got;
    size_t want;
    if (!d || !q || !win || !wlo || !whi || qn == 0) return cc_ok(0);
    n = d->len();
    if (off >= n || qn > n - off) return cc_ok(0);
    if (off < *wlo || off + qn > *whi) {
        want = winsz;
        if (want < qn) want = qn;
        if (want > n - off) want = n - off;
        got = d->read_at(off, win, want) !>(e) { return cc_err(e); };
        *wlo = off;
        *whi = off + got;
        if (got < qn) return cc_ok(0);
    }
    return cc_ok(memcmp(win + (off - *wlo), q, qn) == 0);
}

void !>(CCError) rtx_find_refine(RtxDoc *d, char[:] q) {
    char qbuf[RTX_FIND_QMAX];
    char win[4096];
    char[:] nq;
    size_t qn;
    size_t i;
    size_t o;
    size_t keep;
    size_t last;
    size_t wlo;
    size_t whi;
    size_t n;
    int was_trunc;
    if (!d || !d->find.store.base) return cc_err(CC_ERR_INVALID_ARG, "find refine");
    qn = q.len;
    memcpy(qbuf, q.ptr, qn);
    nq = d->find.store.alloc_slice_bytes(qn);
    if (!nq.ptr || nq.len < qn)
        return cc_err(CC_ERR_OUT_OF_MEMORY, "find query");
    memcpy(nq.ptr, qbuf, qn);
    last = (d->find.truncated && d->find.len) ? d->find.offs[d->find.len - 1] : 0;
    was_trunc = d->find.truncated;
    keep = d->find.cur < d->find.len ? d->find.offs[d->find.cur] : (size_t)-1;
    d->find.query = nq;
    wlo = 1;
    whi = 0;
    o = 0;
    for (i = 0; i < d->find.len; i++) {
        size_t off = d->find.offs[i];
        int ok = rtx_find_hit_ok(d, off, qbuf, qn, win, sizeof(win), &wlo,
                                 &whi) !>(e) { return cc_err(e); };
        if (ok) d->find.offs[o++] = off;
    }
    d->find.len = o;
    if (keep != (size_t)-1 && o) {
        d->find.cur = 0;
        for (i = 0; i < o; i++) {
            d->find.cur = i;
            if (d->find.offs[i] >= keep) break;
        }
    } else {
        d->find.cur = 0;
    }
    if (was_trunc) {
        d->find.scan_off = last + 1;
        d->find.done = 0;
        d->find.truncated = 0;
    }
    d->find.cancel = 0;
    n = d->len();
    if (d->find.scan_off + qn > n) {
        d->find.scan_off = n;
        d->find.done = 1;
    }
    return cc_ok();
}

int RtxDoc_find_same_query(const RtxDoc *d, char[:] q) {
    if (!d) return 0;
    if (d->find.query.len != q.len) return 0;
    if (q.len == 0) return 1;
    return memcmp(d->find.query.ptr, q.ptr, q.len) == 0;
}

static void !>(CCError) rtx_find_wave(RtxDoc *d, int id);
static void !>(CCError) rtx_find_listing_start(RtxDoc *d);

void !>(CCError) RtxDoc_find_set(RtxDoc *d, char[:] q) {
    char qbuf[RTX_FIND_QMAX];
    size_t qn;
    CCArena fresh;
    char[:] nq;
    if (!d) return cc_err(CC_ERR_INVALID_ARG, "null doc");
    qn = q.len;
    if (qn > RTX_FIND_QMAX) return cc_err(CC_ERR_INVALID_ARG, "find query too long");
    if (qn) memcpy(qbuf, q.ptr, qn);
    if (qn == 0) {
        rtx_find_handle_stop(&d->find);
        if (d->find.store.base) d->find.store.reset();
        d->find.query = cc_slice_empty();
        d->find.offs = NULL;
        d->find.cap = 0;
        rtx_find_scan_wipe(d);
        return cc_ok();
    }
    if (d->find_same_query(q)) return cc_ok();
    rtx_find_handle_stop(&d->find);
    if (rtx_find_is_extend(d, q) && d->find.store.base) {
        rtx_find_refine(d, q) !>(e) { return cc_err(e); };
        return rtx_find_listing_start(d);
    }
    memset(&fresh, 0, sizeof(fresh));
    fresh = cc_arena_heap(kilobytes(16));
    if (!fresh.base) return cc_err(CC_ERR_OUT_OF_MEMORY, "find store");
    nq = fresh.alloc_slice_bytes(qn);
    if (!nq.ptr || nq.len < qn) {
        fresh.destroy();
        return cc_err(CC_ERR_OUT_OF_MEMORY, "find query");
    }
    memcpy(nq.ptr, qbuf, qn);
    if (d->find.store.base) d->find.store.destroy();
    d->find.store = fresh;
    d->find.query = nq;
    d->find.offs = NULL;
    d->find.cap = 0;
    rtx_find_scan_wipe(d);
    return rtx_find_listing_start(d);
}

static void !>(CCError) rtx_find_shard_reserve(RtxFindShard *s, size_t need) {
    if (!s) return cc_err(CC_ERR_INVALID_ARG, "find shard");
    if (need > (size_t)RTX_FIND_MAX) need = (size_t)RTX_FIND_MAX;
    if (need <= s->cap) return cc_ok();
    rtx_arena_grow(&s->lane, (void **)&s->offs, &s->cap, need, sizeof(size_t))
        !>(e) { return cc_err(e); };
    return cc_ok();
}

static size_t rtx_find_window_adv(size_t got, size_t qn, int last) {
    size_t overlap = qn > 0 ? qn - 1 : 0;
    if (last) return got;
    return got > overlap ? got - overlap : got;
}

static void !>(CCError) rtx_find_publish(RtxDoc *d) {
    int i;
    size_t o;
    size_t bytes;
    size_t front;
    int all_done;
    size_t n;
    size_t raw;
    size_t need;
    if (!d) return cc_ok();
    n = d->len();
    raw = 0;
    bytes = 0;
    front = n;
    all_done = 1;
    for (i = 0; i < d->find.nshard; i++) {
        RtxFindShard *s = &d->find.shard[i];
        raw += s->len;
        if (s->at >= s->lo) bytes += s->at - s->lo;
        if (!s->done && s->hi > s->lo) {
            all_done = 0;
            if (s->at < front) front = s->at;
        }
    }
    need = raw;
    if (need > (size_t)RTX_FIND_MAX) need = (size_t)RTX_FIND_MAX;
    if (need) {
        rtx_arena_grow(&d->find.store, (void **)&d->find.offs, &d->find.cap,
                       need, sizeof(size_t)) !>(e) { return cc_err(e); };
    }
    o = 0;
    for (i = 0; i < d->find.nshard && o < need; i++) {
        RtxFindShard *s = &d->find.shard[i];
        size_t take = s->len;
        if (take > need - o) take = need - o;
        if (take && s->offs)
            memcpy(d->find.offs + o, s->offs, take * sizeof(size_t));
        o += take;
    }
    d->find.len = o;
    if (o >= (size_t)RTX_FIND_MAX && (raw > (size_t)RTX_FIND_MAX || !all_done))
        d->find.truncated = 1;
    d->find.scan_bytes = d->find.scan_base + bytes;
    if (d->find.scan_bytes > n) d->find.scan_bytes = n;
    if (d->find.truncated || all_done) {
        d->find.done = 1;
        d->find.scan_off = n;
        if (d->find.truncated && d->find.len)
            d->find.scan_off = d->find.offs[d->find.len - 1] + 1;
    } else {
        d->find.scan_off = front;
    }
    return cc_ok();
}

void !>(CCError) RtxDoc_find_step(RtxDoc *d) {
    if (!d) return cc_err(CC_ERR_INVALID_ARG, "null doc");
    if (d->find.done || !d->find.query.len) return cc_ok();
    if (d->find.h_live) return cc_ok();
    return rtx_find_listing_start(d);
}

void !>(CCError) RtxDoc_find_finish(RtxDoc *d) {
    if (!d) return cc_err(CC_ERR_INVALID_ARG, "null doc");
    if (!d->find.h_live && !d->find.done && d->find.query.len
        && !d->find.cancel)
        rtx_find_listing_start(d) !>(e) { return cc_err(e); };
    if (d->find.h_live) {
        d->find.h.wait() !>(e) { return cc_err(e); };
        d->find.h_live = 0;
        rtx_find_publish(d) !>(e) { return cc_err(e); };
        rtx_find_shards_drop(&d->find);
    }
    return cc_ok();
}

static void !>(CCError) rtx_find_wave(RtxDoc *d, int id) {
    RtxFindShard *s;
    size_t qn, n, start, commit, want, got, adv;
    char q[RTX_FIND_QMAX];
    if (!d || id < 0 || id >= RTX_FIND_WORKERS)
        return cc_err(CC_ERR_INVALID_ARG, "null doc");
    s = &d->find.shard[id];
    qn = d->find.query.len;
    n = d->len();
    if (qn == 0 || s->hi <= s->lo || s->at >= s->hi ||
        s->len >= (size_t)RTX_FIND_MAX) {
        s->done = 1;
        return cc_ok();
    }
    memcpy(q, d->find.query.ptr, qn);
    if (d->find.cancel || d->find.truncated) {
        s->done = 1;
        return cc_ok();
    }
    start = s->at;
    if (start + qn > n) {
        s->at = s->hi;
        s->done = 1;
        return cc_ok();
    }
    commit = (size_t)RTX_FIND_BLOCK;
    if (commit > s->hi - start) commit = s->hi - start;
    if (commit > n - start) commit = n - start;
    want = commit;
    if (qn > 1 && want > 0) want += qn - 1;
    if (want > n - start) want = n - start;
    if (want < qn) want = 0;
    if (want && s->buf) {
        size_t room = (size_t)RTX_FIND_MAX - s->len;
        char *buf = s->buf;
        size_t i;
        got = d->tree.read_uncached(start, buf, want) !>(e) { return cc_err(e); };
        adv = rtx_find_window_adv(got, qn, start + got >= n);
        if (adv > commit) adv = commit;
        if (got >= qn && adv && room) {
            size_t lim = got - qn + 1;
            if (adv < lim) lim = adv;
            i = 0;
            while (i < lim && s->len < (size_t)RTX_FIND_MAX) {
                const char *p = (const char *)memmem(buf + i, got - i, q, qn);
                size_t at;
                size_t off;
                if (!p) break;
                at = (size_t)(p - buf);
                if (at >= lim) break;
                off = start + at;
                if (off >= s->hi) break;
                rtx_find_shard_reserve(s, s->len + 1) !>(e) { return cc_err(e); };
                s->offs[s->len++] = off;
                i = at + 1;
            }
        }
    }
    start += commit;
    if (start > s->hi) start = s->hi;
    s->at = start;
    if (s->at >= s->hi) s->done = 1;
    return cc_ok();
}

static int rtx_find_h_poll(CCParallel *h) {
    if (!h) return 0;
    while (h->paused && !h->cancelled) cc_yield();
    return !h->cancelled;
}

static int rtx_find_listing_arm(RtxDoc *d, int id) {
    RtxFindShard *s;
    if (!d || !d->find.h_live || id < 0 || id >= RTX_FIND_WORKERS) return 0;
    s = &d->find.shard[id];
    if (s->hi <= s->lo) {
        s->done = 1;
        return 0;
    }
    while (!s->done && !d->find.done && d->find.query.len && !d->find.truncated
           && !d->find.cancel && rtx_find_h_poll(&d->find.h)) {
        rtx_find_wave(d, id) !>(e) { (void)e; break; };
    }
    return 1;
}

static void rtx_find_lanes_init(RtxDoc *d) {
    size_t n;
    size_t span_lo;
    size_t span;
    int i;
    n = d->len();
    span_lo = d->find.scan_off;
    if (span_lo > n) span_lo = n;
    span = n - span_lo;
    d->find.scan_base = span_lo;
    d->find.scan_bytes = span_lo;
    d->find.nshard = RTX_FIND_WORKERS;
    for (i = 0; i < RTX_FIND_WORKERS; i++) {
        RtxFindShard *s = &d->find.shard[i];
        memset(s, 0, sizeof(*s));
        s->lo = span_lo + span * (size_t)i / (size_t)RTX_FIND_WORKERS;
        s->hi = span_lo + span * (size_t)(i + 1) / (size_t)RTX_FIND_WORKERS;
        s->at = s->lo;
        if (s->hi > s->lo) {
            s->lane = cc_arena_heap(kilobytes(16));
            s->buf = (char *)malloc((size_t)RTX_FIND_BLOCK +
                                    (size_t)RTX_FIND_QMAX);
            if (!s->buf) s->done = 1;
        } else {
            s->done = 1;
        }
    }
}

static void !>(CCError) rtx_find_listing_start(RtxDoc *d) {
    int noop = 0;
    if (!d) return cc_err(CC_ERR_INVALID_ARG, "find kick");
    if (d->find.done || !d->find.query.len) return cc_ok();
    rtx_find_lanes_init(d);
    d->find.h_live = 1;
    d->find.h = @parallel {
        @serial { noop = 0; }
        rtx_find_listing_arm(d, 0);
        rtx_find_listing_arm(d, 1);
    } !>;
    return cc_ok();
}

void rtx_find_pause(RtxDoc *d) {
    if (!d || !d->find.h_live || d->find.done) return;
    d->find.h.pause() !>(e) { (void)e; };
    rtx_find_publish(d) !>(e) { (void)e; };
}

void rtx_find_resume(RtxDoc *d) {
    if (!d || !d->find.h_live || !d->find.h.paused) return;
    d->find.h.resume() !>(e) { (void)e; };
}

static size_t rtx_find_near(const RtxDoc *d) {
    size_t i;
    if (!d || d->find.len == 0) return (size_t)-1;
    for (i = 0; i < d->find.len; i++) {
        if (d->find.offs[i] >= d->find.origin) return i;
    }
    if (d->find.done) return 0;
    return (size_t)-1;
}

static void rtx_find_place(RtxDoc *d, size_t i) {
    size_t n;
    if (!d || d->find.len == 0) return;
    if (i >= d->find.len) i = d->find.len - 1;
    d->find.cur = i;
    d->caret = d->find.offs[i];
    n = d->len();
    d->sel_anchor = d->caret + d->find.query.len;
    if (d->sel_anchor > n) d->sel_anchor = n;
    d->break_coalesce();
}

/* List highlight only. The camera stays until the user selects a hit. */
void rtx_find_mark_near(RtxDoc *d) {
    size_t i;
    if (!d || d->find.pinned) return;
    i = rtx_find_near(d);
    if (i == (size_t)-1) return;
    d->find.cur = i;
}

void RtxDoc_find_goto(RtxDoc *d, size_t i) {
    if (!d) return;
    d->find.pinned = 1;
    rtx_find_place(d, i);
}

void RtxDoc_find_next(RtxDoc *d) {
    if (!d || d->find.len == 0) return;
    if (!d->find.pinned) {
        d->find_goto(d->find.cur);
        return;
    }
    d->find_goto((d->find.cur + 1) % d->find.len);
}

void RtxDoc_find_prev(RtxDoc *d) {
    if (!d || d->find.len == 0) return;
    if (!d->find.pinned) {
        d->find_goto(d->find.cur);
        return;
    }
    d->find_goto(d->find.cur == 0 ? d->find.len - 1 : d->find.cur - 1);
}

void !>(CCError) RtxDoc_find_hit_view(RtxDoc *d, size_t i, CCArena *scratch,
                                      size_t maxn, RtxFindHitView *out) {
    size_t off;
    size_t n;
    size_t a;
    size_t z;
    size_t pad;
    @errhandler(CCError e) {
        return cc_err(e);
    }
    if (!d || !scratch || !out) return cc_err(CC_ERR_INVALID_ARG, "find hit");
    if (i >= d->find.len) return cc_err(CC_ERR_INVALID_ARG, "find hit");
    memset(out, 0, sizeof(*out));
    off = d->find.offs[i];
    n = d->len();
    if (maxn < 8) maxn = 8;
    pad = maxn / 4;
    a = (off > pad) ? off - pad : 0;
    z = a + maxn;
    if (z > n) z = n;
    out->off = off;
    out->line1 = d->line_guess(off) + 1;
    out->col = (off >= a) ? off - a : 0;
    if (z <= a) {
        out->ctx = cc_slice_empty();
        return cc_ok();
    }
    {
        char[:] bytes = d->scratch_span(a, z - a, scratch) !>;
        out->ctx = bytes;
    }
    return cc_ok();
}
