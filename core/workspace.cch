#!ccc cch
/*
 * Several documents, one or two panes. Each pane points at a buffer.
 */
#ifndef RTX_WORKSPACE_H
#define RTX_WORKSPACE_H

/* RtxDoc / RtxLayout / RtxDocLayout come from document.cch + layout.cch. */

typedef struct {
    RtxDoc doc;
    RtxLayout layout;
    size_t top;            /* first physical line in the window (text views) */
    size_t top_wrap;       /* visual rows skipped on that line */
    size_t top_byte;       /* first byte row start when view == HEX (16-aligned) */
    int seek_valid;        /* byte camera. The line index does not replace it. */
    size_t seek_off;       /* first visible byte while seek_valid */
    size_t drag_vis;       /* scrollbar map frozen at press; 0 if not dragging */
    size_t drag_len;
    int drag_grab;         /* thumb grab offset in track cells/pixels */
    int pin_view;          /* 1 after wheel/bar: do not reveal to the caret */
    int unlock;            /* 1: viewport does not follow caret (find/jump still land) */
    double scroll;
    double layout_width;
    RtxPref pref;          /* goal column for visual up/down */
} RtxBuf;

#ifndef RTX_BROWSE_TYPES
#define RTX_BROWSE_TYPES
enum {
    RTX_BROWSE_NAME = 256,
    RTX_BROWSE_DIR = 1024,
    RTX_BROWSE_GLOB = 96,
    RTX_BROWSE_MAX = 4096,
    RTX_BROWSE_HEAD = 2
};
typedef struct {
    int is_dir;
    char name[RTX_BROWSE_NAME];
} RtxBrowseEnt;
typedef struct {
    int on;
    int truncated;
    char dir[RTX_BROWSE_DIR];
    char glob[RTX_BROWSE_GLOB];
    size_t glob_len;
    RtxBrowseEnt *ents;
    size_t len, cap;
    size_t cur, top;
    CCArena store;
} RtxBrowse;
#endif

/* Camera + layout for the other pane when both show the same buf. */
typedef struct {
    int live;
    RtxLayout layout;
    size_t top, top_wrap, top_byte;
    int seek_valid;
    size_t seek_off;
    size_t drag_vis, drag_len;
    int drag_grab;
    int pin_view, unlock;
    double scroll, layout_width;
    RtxPref pref;
} RtxPaneSnap;

typedef struct {
    CCArena session;       /* workspace epoch: bufs + clipboard */
    RtxBuf *bufs;
    size_t len;
    size_t cap;
    int pane[2];
    int npanes;
    int focus;
    RtxPaneSnap side;
    RtxBrowse nav[2];
    char[:] clip;
    /* UI progress drawer; stamped onto each tree (and new add_path bufs). */
    RtxBusyFn busy_fn;
    void *busy_ctx;
} RtxWs;

static void rtx_browse_drop(RtxBrowse *br);

static int RtxWs_ensure(RtxWs *w) {
    if (!w) return 0;
    if (w->session.base) return 1;
    w->session = cc_arena_heap(kilobytes(8));
    return w->session.base != NULL;
}

static void RtxBuf_destroy(RtxBuf *b) {
    if (!b) return;
    b->layout.destroy();
    b->doc.destroy();
    memset(b, 0, sizeof(*b));
}

static void rtx_buf_swap_cam(RtxBuf *b, RtxPaneSnap *s) {
    RtxLayout L;
    size_t z;
    int i;
    double d;
    RtxPref pr;
    if (!b || !s) return;
    L = b->layout; b->layout = s->layout; s->layout = L;
    z = b->top; b->top = s->top; s->top = z;
    z = b->top_wrap; b->top_wrap = s->top_wrap; s->top_wrap = z;
    z = b->top_byte; b->top_byte = s->top_byte; s->top_byte = z;
    i = b->seek_valid; b->seek_valid = s->seek_valid; s->seek_valid = i;
    z = b->seek_off; b->seek_off = s->seek_off; s->seek_off = z;
    z = b->drag_vis; b->drag_vis = s->drag_vis; s->drag_vis = z;
    z = b->drag_len; b->drag_len = s->drag_len; s->drag_len = z;
    i = b->drag_grab; b->drag_grab = s->drag_grab; s->drag_grab = i;
    i = b->pin_view; b->pin_view = s->pin_view; s->pin_view = i;
    i = b->unlock; b->unlock = s->unlock; s->unlock = i;
    d = b->scroll; b->scroll = s->scroll; s->scroll = d;
    d = b->layout_width; b->layout_width = s->layout_width; s->layout_width = d;
    pr = b->pref; b->pref = s->pref; s->pref = pr;
}

static int RtxWs_same_split(const RtxWs *w) {
    return w && w->npanes == 2 && w->pane[0] == w->pane[1] && w->side.live;
}

/* Put pane p's camera on its buf. 1 = caller must RtxWs_drop_pane. */
static int RtxWs_hold_pane(RtxWs *w, int p) {
    if (!RtxWs_same_split(w) || p == w->focus) return 0;
    rtx_buf_swap_cam(&w->bufs[w->pane[p]], &w->side);
    return 1;
}

static void RtxWs_drop_pane(RtxWs *w, int p, int held) {
    if (held) rtx_buf_swap_cam(&w->bufs[w->pane[p]], &w->side);
}

static void rtx_ws_side_drop(RtxWs *w) {
    if (!w || !w->side.live) return;
    w->side.layout.destroy();
    memset(&w->side, 0, sizeof(w->side));
}

static void RtxWs_destroy(RtxWs *w) {
    size_t i;
    if (!w) return;
    rtx_ws_side_drop(w);
    rtx_browse_drop(&w->nav[0]);
    rtx_browse_drop(&w->nav[1]);
    for (i = 0; i < w->len; i++) {
        w->bufs[i].destroy();
    }
    if (w->session.base) w->session.destroy();
    memset(w, 0, sizeof(*w));
}

static RtxBuf *RtxWs_active(RtxWs *w) {
    int bi;
    if (!w || w->len == 0) return NULL;
    bi = w->pane[w->focus];
    if (bi < 0 || (size_t)bi >= w->len) return &w->bufs[0];
    return &w->bufs[bi];
}

static RtxDoc *RtxWs_doc(RtxWs *w) {
    RtxBuf *b = RtxWs_active(w);
    return b ? &b->doc : NULL;
}

static RtxLayout *RtxWs_layout(RtxWs *w) {
    RtxBuf *b = RtxWs_active(w);
    return b ? &b->layout : NULL;
}

static void !>(CCError) RtxWs_add_path(RtxWs *w, const char *path) {
    RtxBuf *b;
    if (!w) return cc_err(CC_ERR_INVALID_ARG, "null ws");
    if (!w->ensure()) return cc_err(CC_ERR_OUT_OF_MEMORY, "workspace");
    rtx_arena_grow(&w->session, (void **)&w->bufs, &w->cap, w->len + 1,
                   sizeof(RtxBuf)) !>(e) {
        return cc_err(e);
    };
    b = &w->bufs[w->len];
    memset(b, 0, sizeof(*b));
    b->doc.from_path(path) !>(e) { return cc_err(e); };
    b->doc.tree.busy_bind(w->busy_fn, w->busy_ctx);
    w->len++;
    return cc_ok();
}

static void RtxWs_busy_bind(RtxWs *w, RtxBusyFn fn, void *ctx) {
    size_t i;
    if (!w) return;
    w->busy_fn = fn;
    w->busy_ctx = ctx;
    for (i = 0; i < w->len; i++) {
        w->bufs[i].doc.tree.busy_bind(fn, ctx);
    }
}

static void !>(CCError) RtxWs_open_files(RtxWs *w, int npaths, char **paths) {
    int i;
    if (!w) return cc_err(CC_ERR_INVALID_ARG, "null ws");
    if (w->session.base || w->len) return cc_err(CC_ERR_INVALID_ARG, "ws already live");
    memset(w, 0, sizeof(*w));
    w->npanes = 1;
    w->focus = 0;
    w->pane[0] = 0;
    w->pane[1] = 0;
    if (npaths <= 0) return cc_err(CC_ERR_INVALID_ARG, "no files");
    for (i = 0; i < npaths; i++) {
        w->add_path(paths[i]) !>(e) {
            w->destroy();
            return cc_err(e);
        };
    }
    if (w->len >= 2) {
        w->npanes = 2;
        w->pane[1] = 1;
    }
    return cc_ok();
}

static void RtxWs_set_view(RtxWs *w, int view) {
    size_t i;
    if (!w) return;
    for (i = 0; i < w->len; i++) {
        rtx_layout_set_view(&w->bufs[i].layout, view);
    }
    if (w->side.live) rtx_layout_set_view(&w->side.layout, view);
}

static void RtxWs_set_views(RtxWs *w, const int *views, int n) {
    int i;
    if (!w || !views || n < 1) return;
    for (i = 0; i < n && i < (int)w->len; i++) {
        rtx_layout_set_view(&w->bufs[i].layout, views[i]);
    }
}

static void RtxWs_toggle_split(RtxWs *w) {
    RtxBuf *b;
    if (!w || w->len == 0) return;
    if (w->npanes == 1) {
        w->npanes = 2;
        if (w->len >= 2) w->pane[1] = (w->pane[0] + 1) % (int)w->len;
        else w->pane[1] = w->pane[0];
        w->focus = 1;
        if (w->pane[0] == w->pane[1]) {
            b = &w->bufs[w->pane[0]];
            memset(&w->side, 0, sizeof(w->side));
            w->side.live = 1;
            w->side.top = b->top;
            w->side.top_wrap = b->top_wrap;
            w->side.top_byte = b->top_byte;
            w->side.unlock = b->unlock;
            w->side.layout.view = b->layout.view;
            w->side.layout.wrap = b->layout.wrap;
        }
    } else {
        if (w->side.live) {
            b = &w->bufs[w->pane[0]];
            if (w->focus == 1) rtx_buf_swap_cam(b, &w->side);
            rtx_ws_side_drop(w);
        }
        w->npanes = 1;
        w->focus = 0;
    }
}

static void RtxWs_next_buf(RtxWs *w) {
    if (!w || w->len == 0) return;
    if (RtxWs_same_split(w)) {
        rtx_buf_swap_cam(&w->bufs[w->pane[0]], &w->side);
        rtx_ws_side_drop(w);
    }
    w->pane[w->focus] = (w->pane[w->focus] + 1) % (int)w->len;
}

static void RtxWs_prev_buf(RtxWs *w) {
    if (!w || w->len == 0) return;
    if (RtxWs_same_split(w)) {
        rtx_buf_swap_cam(&w->bufs[w->pane[0]], &w->side);
        rtx_ws_side_drop(w);
    }
    w->pane[w->focus] = (w->pane[w->focus] + (int)w->len - 1) % (int)w->len;
}

static void RtxWs_set_focus(RtxWs *w, int pane) {
    if (!w || pane < 0 || pane >= w->npanes || pane == w->focus) return;
    if (RtxWs_same_split(w))
        rtx_buf_swap_cam(&w->bufs[w->pane[0]], &w->side);
    w->focus = pane;
}

static void RtxWs_focus_other(RtxWs *w) {
    if (!w || w->npanes < 2) return;
    RtxWs_set_focus(w, 1 - w->focus);
}

static void !>(CCError) RtxWs_set_clip(RtxWs *w, char[:] src) {
    char[:] copy;
    if (!w) return cc_err(CC_ERR_INVALID_ARG, "null ws");
    if (!src.ptr || src.len == 0) {
        w->clip = cc_slice_empty();
        return cc_ok();
    }
    if (!w->ensure()) return cc_err(CC_ERR_OUT_OF_MEMORY, "workspace");
    copy = w->session.alloc_slice_bytes(src.len);
    if (!copy.ptr) return cc_err(CC_ERR_OUT_OF_MEMORY, "clipboard");
    memcpy(copy.ptr, src.ptr, src.len);
    w->clip = copy;
    return cc_ok();
}

/* 0 = nothing to do (no selection). 1 = copied. OOM is an error. */
static int !>(CCError) RtxWs_copy(RtxWs *w) {
    RtxDoc *d = w->doc();
    size_t lo, hi;
    if (!d || !d->has_sel()) return cc_ok(0);
    if (d->sel_box) {
        CCArena a = {0} @destroy;
        char[:] bytes;
        a = cc_arena_heap(kilobytes(8));
        if (!a.base) return cc_err(CC_ERR_OUT_OF_MEMORY, "clipboard");
        bytes = rtx_doc_box_text(d, &a) !>(e) { return cc_err(e); };
        w->set_clip(bytes) !>(e) { return cc_err(e); };
        return cc_ok(1);
    }
    lo = d->sel_lo();
    hi = d->sel_hi();
    {
        cc_arena_stack(scratch, RTX_FRAME_SCRATCH);
        char[:] bytes = d->scratch_span(&scratch, lo, hi - lo) !>(e) {
            return cc_err(e);
        };
        w->set_clip(bytes) !>(e) {
            return cc_err(e);
        };
    }
    return cc_ok(1);
}

static void !>(CCError) RtxWs_cut(RtxWs *w) {
    RtxDoc *d = w->doc();
    size_t lo, hi;
    char[:] copy = cc_slice_empty();
    if (!d) return cc_err(CC_ERR_INVALID_ARG, "no buffer");
    if (!d->has_sel()) return cc_ok();
    if (d->sel_box) {
        CCArena a = {0} @destroy;
        char[:] bytes;
        a = cc_arena_heap(kilobytes(8));
        if (!a.base) return cc_err(CC_ERR_OUT_OF_MEMORY, "clipboard");
        bytes = rtx_doc_box_text(d, &a) !>(e) { return cc_err(e); };
        if (bytes.len) {
            if (!w->ensure()) return cc_err(CC_ERR_OUT_OF_MEMORY, "workspace");
            copy = w->session.alloc_slice_bytes(bytes.len);
            if (!copy.ptr) return cc_err(CC_ERR_OUT_OF_MEMORY, "clipboard");
            memcpy(copy.ptr, bytes.ptr, bytes.len);
        }
        rtx_doc_box_apply(d, cc_slice_empty()) !>(e) { return cc_err(e); };
        d->sel_box = 0;
        d->sel_anchor = d->caret;
        w->clip = copy;
        return cc_ok();
    }
    lo = d->sel_lo();
    hi = d->sel_hi();
    {
        cc_arena_stack(scratch, RTX_FRAME_SCRATCH);
        char[:] bytes = d->scratch_span(&scratch, lo, hi - lo) !>(e) {
            return cc_err(e);
        };
        if (bytes.len) {
            if (!w->ensure()) return cc_err(CC_ERR_OUT_OF_MEMORY, "workspace");
            copy = w->session.alloc_slice_bytes(bytes.len);
            if (!copy.ptr) return cc_err(CC_ERR_OUT_OF_MEMORY, "clipboard");
            memcpy(copy.ptr, bytes.ptr, bytes.len);
        }
        d->replace(lo, hi - lo, cc_slice_empty()) !>(e) { return cc_err(e); };
        w->clip = copy;
        return cc_ok();
    }
}

static void !>(CCError) RtxWs_paste(RtxWs *w) {
    RtxDoc *d = w->doc();
    if (!d) return cc_err(CC_ERR_INVALID_ARG, "no buffer");
    if (!w->clip.ptr || w->clip.len == 0) return cc_ok();
    return d->type(w->clip);
}

static void RtxBuf_clear_pref(RtxBuf *b) {
    if (!b) return;
    b->pref.ok = 0;
    b->pref.eol = 0;
    b->pref.x = 0;
    b->pref.col = 0;
}

static void RtxBuf_stick_eol(RtxBuf *b) {
    if (!b) return;
    b->pref.ok = 1;
    b->pref.eol = 1;
}

static size_t !>(RtxIndexErr) rtx_buf_cur_col(const RtxBuf *b) {
    size_t line;
    size_t start;
    if (!b) return cc_ok((size_t)0);
    line = b->doc.line_of(b->doc.caret) !>(e) { return cc_err(e); };
    start = b->doc.line_start(line) !>(e) { return cc_err(e); };
    return cc_ok(b->doc.caret - start);
}

static void !>(RtxIndexErr) RtxBuf_box_begin(RtxBuf *b) {
    if (!b || b->doc.sel_box) return cc_ok();
    b->doc.sel_box = 1;
    if (b->pref.eol) b->doc.box_acol = (size_t)-1;
    else if (b->pref.ok) b->doc.box_acol = b->pref.col;
    else b->doc.box_acol = rtx_buf_cur_col(b) !>(e) { return cc_err(e); };
    b->doc.box_ccol = b->doc.box_acol;
    return cc_ok();
}

static void !>(RtxIndexErr) RtxBuf_box_sync(RtxBuf *b) {
    if (!b || !b->doc.sel_box) return cc_ok();
    if (b->pref.eol) b->doc.box_ccol = (size_t)-1;
    else if (b->pref.ok) b->doc.box_ccol = b->pref.col;
    else b->doc.box_ccol = rtx_buf_cur_col(b) !>(e) { return cc_err(e); };
    return cc_ok();
}

static void !>(RtxIndexErr) RtxBuf_box_move_col(RtxBuf *b, int dir) {
    size_t line, start, nlen, col, end;
    @errhandler(RtxIndexErr e) {
        return cc_err(e);
    }
    if (!b) return cc_ok();
    b->box_begin() !>;
    line = b->doc.line_of(b->doc.caret) !>;
    start = b->doc.line_start(line) !>;
    end = rtx_doc_line_end_caret(&b->doc, start) !>;
    nlen = end - start;
    col = b->doc.box_ccol;
    if (col == (size_t)-1) col = nlen;
    if (dir < 0) {
        if (col > 0) col--;
    } else {
        col++;
    }
    b->doc.box_ccol = col;
    b->pref.col = col;
    b->pref.ok = 1;
    b->pref.eol = 0;
    b->doc.caret = start + (col < nlen ? col : nlen);
    return cc_ok();
}

/* First visible layout row → `top` / `top_wrap`. */
static void rtx_buf_origin_from_row(RtxBuf *b, size_t origin) {
    size_t first;
    if (!b || b->layout.len == 0) return;
    if (origin >= b->layout.len) origin = b->layout.len - 1;
    b->top = b->layout.rows[origin].line;
    first = origin;
    while (first > 0 && b->layout.rows[first - 1].line == b->top) first--;
    b->top_wrap = origin - first;
}

/* First visible byte in the current view. Does not scan. */
static size_t RtxBuf_view_off(const RtxBuf *b) {
    size_t i;
    if (!b) return 0;
    if (rtx_layout_is_hex(&b->layout)) return b->top_byte;
    if (b->seek_valid) return b->seek_off;
    if (b->layout.len) {
        i = b->top_wrap < b->layout.len ? b->top_wrap : 0;
        return b->layout.rows[i].byte_start;
    }
    return 0;
}

/* Move the window so `off` is on screen in the active view. Caret stays. */
static void !>(RtxIndexErr) RtxBuf_reveal_off(RtxBuf *b, size_t off, int vis) {
    size_t cl;
    size_t ri;
    size_t n;
    size_t row;
    size_t top_row;
    if (!b) return cc_ok();
    if (vis < 1) vis = 1;
    n = b->len();
    if (off > n) off = n;
    if (rtx_layout_is_hex(&b->layout)) {
        b->top_byte = rtx_hex_align(b->top_byte);
        if (b->top_byte > n) b->top_byte = rtx_hex_align(n);
        row = off / (size_t)RTX_HEX_COLS;
        top_row = b->top_byte / (size_t)RTX_HEX_COLS;
        if (row < top_row) b->top_byte = row * (size_t)RTX_HEX_COLS;
        else if (row >= top_row + (size_t)vis) {
            b->top_byte = (row + 1 - (size_t)vis) * (size_t)RTX_HEX_COLS;
        }
        b->seek_valid = 0;
        return cc_ok();
    }
    /* A live seek stays a seek. index_covers is a cache hit, not a new camera. */
    if (b->seek_valid) {
        size_t floor = rtx_doc_line_floor_local(&b->doc, off) !>(e) {
            return cc_err(e);
        };
        if (b->layout.len && b->layout.rows[0].byte_start == b->seek_off) {
            RtxVisRow *last = &b->layout.rows[b->layout.len - 1];
            size_t z = last->byte_start + last->byte_len;
            if (off >= b->seek_off && off < z) return cc_ok();
        }
        b->seek_off = floor;
        b->top_wrap = 0;
        return cc_ok();
    }
    if (!b->layout.wrap) {
        b->top_wrap = 0;
        if (b->doc.index_covers(off)) {
            cl = b->line_of(off) !>(e) { return cc_err(e); };
            b->seek_valid = 0;
        } else {
            b->seek_off = rtx_doc_line_floor_local(&b->doc, off) !>(e) {
                return cc_err(e);
            };
            b->seek_valid = 1;
            cl = b->doc.line_guess(b->seek_off);
        }
        if (cl < b->top) b->top = cl;
        if (cl >= b->top + (size_t)vis) b->top = cl - (size_t)vis + 1;
        return cc_ok();
    }
    if (b->doc.index_covers(off)) {
        cl = b->line_of(off) !>(e) { return cc_err(e); };
        b->seek_valid = 0;
    } else {
        b->seek_off = rtx_doc_line_floor(&b->doc, off) !>(e) { return cc_err(e); };
        b->seek_valid = 1;
        cl = b->doc.line_guess(b->seek_off);
        b->top = cl;
        b->top_wrap = 0;
        return cc_ok();
    }
    if (b->layout.len == 0) {
        b->top = cl;
        b->top_wrap = 0;
        return cc_ok();
    }
    if (cl < b->top || off < b->layout.rows[0].byte_start) {
        b->top = cl;
        b->top_wrap = 0;
        return cc_ok();
    }
    {
        RtxVisRow *last = &b->layout.rows[b->layout.len - 1];
        if (cl > last->line && off >= last->byte_start + last->byte_len) {
            b->top = cl;
            b->top_wrap = 0;
            return cc_ok();
        }
    }
    ri = b->layout.row_of(off);
    if (ri < b->top_wrap) {
        rtx_buf_origin_from_row(b, ri);
        return cc_ok();
    }
    if (ri < b->top_wrap + (size_t)vis) return cc_ok();
    rtx_buf_origin_from_row(b, ri + 1 - (size_t)vis);
    return cc_ok();
}

/* Find land: byte seek. Do not write top from line_guess. */
static void !>(RtxIndexErr) RtxBuf_reveal_guess(RtxBuf *b, size_t off, int vis) {
    size_t n;
    size_t row;
    size_t top_row;
    if (!b) return cc_ok();
    if (vis < 1) vis = 1;
    n = b->len();
    if (off > n) off = n;
    if (rtx_layout_is_hex(&b->layout)) {
        b->top_byte = rtx_hex_align(b->top_byte);
        if (b->top_byte > n) b->top_byte = rtx_hex_align(n);
        row = off / (size_t)RTX_HEX_COLS;
        top_row = b->top_byte / (size_t)RTX_HEX_COLS;
        if (row < top_row) b->top_byte = row * (size_t)RTX_HEX_COLS;
        else if (row >= top_row + (size_t)vis) {
            b->top_byte = (row + 1 - (size_t)vis) * (size_t)RTX_HEX_COLS;
        }
        b->seek_valid = 0;
        return cc_ok();
    }
    b->seek_off = rtx_doc_line_floor_local(&b->doc, off) !>(e) { return cc_err(e); };
    b->seek_valid = 1;
    b->top_wrap = 0;
    return cc_ok();
}

/* Move `top` / `top_wrap` so the caret's visual row sits in [0, vis). */
static void !>(RtxIndexErr) RtxBuf_reveal(RtxBuf *b, int vis) {
    if (!b) return cc_ok();
    return b->reveal_off(b->doc.caret, vis);
}

static void !>(RtxIndexErr) RtxBuf_cycle_view(RtxBuf *b, int vis) {
    size_t keep;
    if (!b) return cc_ok();
    keep = b->view_off();
    rtx_layout_cycle_view(&b->layout);
    b->top_wrap = 0;
    b->layout.len = 0;
    b->seek_valid = 0;
    b->drag_vis = 0;
    b->drag_len = 0;
    b->clear_pref();
    if (b->unlock) return b->reveal_off(keep, vis);
    return b->reveal_off(b->doc.caret, vis);
}

static void !>(CCError) RtxBuf_scroll_vis(RtxBuf *b, const RtxMeasure *m, double width, int dir) {
    size_t nlines;
    size_t n;
    size_t rows;
    @errhandler(CCError e) {
        return cc_err(e);
    }
    @errhandler(RtxIndexErr ie) {
        return cc_err(CC_ERR_IO, ie.message ? ie.message : "line index");
    }
    if (!b) return cc_err(CC_ERR_INVALID_ARG, "scroll");
    b->pin_view = 1;
    if (rtx_layout_is_hex(&b->layout)) {
        n = b->len();
        rows = rtx_hex_row_count(n);
        b->top_byte = rtx_hex_align(b->top_byte);
        if (dir < 0) {
            if (b->top_byte >= (size_t)RTX_HEX_COLS) b->top_byte -= (size_t)RTX_HEX_COLS;
            else b->top_byte = 0;
        } else if (dir > 0) {
            size_t next = b->top_byte + (size_t)RTX_HEX_COLS;
            size_t last_top = rows > 1 ? (rows - 1) * (size_t)RTX_HEX_COLS : 0;
            if (next <= last_top) b->top_byte = next;
        }
        return cc_ok();
    }
    if (b->seek_valid && !b->doc.index_covers(b->seek_off)) {
        size_t nlen = b->len();
        if (dir < 0) {
            if (b->seek_off > 0)
                b->seek_off = rtx_doc_line_floor(&b->doc, b->seek_off - 1) !>;
        } else if (b->seek_off < nlen) {
            size_t next = rtx_doc_line_next(&b->doc, b->seek_off) !>;
            if (next > b->seek_off) b->seek_off = next;
        }
        b->top = b->doc.line_guess(b->seek_off);
        b->top_wrap = 0;
        return cc_ok();
    }
    b->seek_valid = 0;
    nlines = b->line_count();
    if (!b->layout.wrap) {
        b->top_wrap = 0;
        if (dir < 0 && b->top > 0) b->top--;
        if (dir > 0 && b->top + 1 < nlines) b->top++;
        return cc_ok();
    }
    if (dir < 0) {
        if (b->top_wrap > 0) b->top_wrap--;
        else if (b->top > 0) {
            RtxLayout tmp = {0} @destroy;
            size_t wraps;
            b->top--;
            tmp.wrap = 1;
            tmp.lines(&b->doc, m, width, b->top, 1) !>;
            wraps = tmp.len ? tmp.len : 1;
            b->top_wrap = wraps - 1;
        }
    } else {
        size_t wraps = b->layout.rows_for_line(b->top);
        if (wraps == 0) wraps = 1;
        b->top_wrap++;
        if (b->top_wrap >= wraps) {
            if (b->top + 1 < nlines) {
                b->top++;
                b->top_wrap = 0;
            } else {
                b->top_wrap = wraps - 1;
            }
        }
    }
    return cc_ok();
}

/* Fill / clamp the visible window for text or hex. Shared by both frontends. */
static void !>(CCError) RtxBuf_ensure_view(RtxBuf *b, RtxMeasure *m, double width, int vis) {
    size_t nlines;
    size_t want;
    size_t avail;
    size_t need;
    size_t n;
    size_t rows;
    @errhandler(CCError e) {
        return cc_err(e);
    }
    @errhandler(RtxIndexErr ie) {
        return cc_err(CC_ERR_IO, ie.message ? ie.message : "line index");
    }
    if (!b) return cc_err(CC_ERR_INVALID_ARG, "null buf");
    if (vis < 1) vis = 1;
    if (rtx_layout_is_hex(&b->layout)) {
        n = b->len();
        rows = rtx_hex_row_count(n);
        b->top_byte = rtx_hex_align(b->top_byte);
        if (rows > 0) {
            size_t last_top = (rows - 1) * (size_t)RTX_HEX_COLS;
            if (b->top_byte > last_top) b->top_byte = last_top;
        } else {
            b->top_byte = 0;
        }
        (void)m;
        (void)width;
        return cc_ok();
    }
    if (b->seek_valid) {
        size_t want = (size_t)vis + 8 + b->top_wrap;
        if (b->layout_width != width || b->layout.len == 0 ||
            b->layout.len < (size_t)vis ||
            (b->layout.len && b->layout.rows[0].byte_start != b->seek_off)) {
            b->layout.fill_off(&b->doc, m, width, b->seek_off, want) !>;
            b->layout_width = width;
        }
        return cc_ok();
    }
    nlines = b->line_count();
    if (b->top >= nlines && nlines) b->top = nlines - 1;
    want = (size_t)vis + 8;
    avail = (b->top < nlines) ? (nlines - b->top) : 0;
    need = want < avail ? want : avail;
    if (b->layout_width != width || b->layout.from_line != b->top ||
        b->layout.len == 0 || b->layout.nlines < need ||
        (b->layout.wrap && b->layout.len < want + b->top_wrap)) {
        size_t min_rows = want + b->top_wrap;
        b->layout.fill(&b->doc, m, width, b->top, min_rows) !>;
        b->layout_width = width;
    }
    return cc_ok();
}

/* Drop this camera's vis-row epoch and refill. `edited` clears goal-column / pin
 * (the pane the user typed in). Callers reparse first. */
static void !>(CCError) rtx_buf_refresh_view(RtxBuf *b, RtxMeasure *m, double width, int vis,
                                            int edited) {
    if (!b) return cc_err(CC_ERR_INVALID_ARG, "null buf");
    if (edited) {
        b->clear_pref();
        b->pin_view = 0;
    }
    b->seek_valid = 0;
    if (!rtx_layout_is_hex(&b->layout)) {
        b->layout.len = 0;
        b->layout_width = 0;
    }
    return RtxBuf_ensure_view(b, m, width, vis);
}

/* One camera. Same-file split: use RtxWs_after_edit so the other camera is not left
 * with vis rows whose byte ranges predate the mutation. */
static void !>(CCError) RtxBuf_after_edit(RtxBuf *b, RtxMeasure *m, double width, int vis) {
    if (!b) return cc_err(CC_ERR_INVALID_ARG, "null buf");
    b->doc.reparse_edit(b->doc.last_off, b->doc.last_markup) !>;
    return rtx_buf_refresh_view(b, m, width, vis, 1);
}

/* After a document mutation: reparse once, then rebuild every pane that shows
 * `bufi`. ensure_view keys on width / top / row count — not the edit — so a
 * mid-line delete looks cache-hot on the other camera until the epoch is dropped. */
static void !>(CCError) RtxWs_after_edit(RtxWs *w, int bufi, RtxMeasure *m,
                                        double width0, double width1, int vis) {
    int p;
    int parsed = 0;
    if (!w || !m || bufi < 0 || (size_t)bufi >= w->len)
        return cc_err(CC_ERR_INVALID_ARG, "ws after edit");
    for (p = 0; p < w->npanes; p++) {
        int held;
        double width;
        RtxBuf *b;
        if (w->pane[p] != bufi) continue;
        held = RtxWs_hold_pane(w, p);
        b = &w->bufs[bufi];
        if (!parsed) {
            b->doc.reparse_edit(b->doc.last_off, b->doc.last_markup) !>(e) {
                RtxWs_drop_pane(w, p, held);
                return cc_err(e);
            };
            parsed = 1;
        }
        width = (p == 0 || w->npanes < 2) ? width0 : width1;
        rtx_buf_refresh_view(b, m, width, vis, p == w->focus) !>(e) {
            RtxWs_drop_pane(w, p, held);
            return cc_err(e);
        };
        RtxWs_drop_pane(w, p, held);
    }
    return cc_ok();
}

static int RtxWs_any_dirty(const RtxWs *w) {
    size_t i;
    if (!w) return 0;
    for (i = 0; i < w->len; i++) {
        if (w->bufs[i].doc.dirty()) return 1;
    }
    return 0;
}

#include "browse.cch"
#include "ui.cch"

@typeview on RtxBuf {
    as: doc;
};
@typehooks on RtxBuf {
    .destroy = RtxBuf_destroy,
    .ensure_view = RtxBuf_ensure_view,
    .after_edit = RtxBuf_after_edit,
};
@typehooks on RtxWs {
    .destroy = RtxWs_destroy,
    .busy_bind = RtxWs_busy_bind,
    .after_edit = RtxWs_after_edit,
    .hold_pane = RtxWs_hold_pane,
    .drop_pane = RtxWs_drop_pane,
    .set_focus = RtxWs_set_focus,
    .browse = RtxWs_browse,
    .browsing = RtxWs_browsing,
    .browse_start = RtxWs_browse_start,
    .browse_close = RtxWs_browse_close,
    .browse_enter = RtxWs_browse_enter,
    .browse_parent = RtxWs_browse_parent,
    .browse_type = RtxWs_browse_type,
    .browse_backspace = RtxWs_browse_backspace,
    .browse_glob_set = RtxWs_browse_glob_set,
    .open_in_pane = RtxWs_open_in_pane,
};

#endif /* RTX_WORKSPACE_H */
