#!ccc cch
/*
 * RtxUi + caret/gutter helpers (decls). Bodies live in workspace.ccs —
 * workspace.cch includes this face. Paint TUs include this without ui.cch
 * (find methods stay in ui.cch, after find.cch on the host).
 */
#ifndef RTX_UI_TYPES_H
#define RTX_UI_TYPES_H

#include <time.h>
#include "ui_cmd.cch"
#include "palette.cch"

/* RtxUi.pick: the project picker overlay (core/ui_proj.cch). */
enum {
    RTX_PICK_NONE = 0,
    RTX_PICK_OPEN = 1,   /* quick-open: fuzzy file names */
    RTX_PICK_SEARCH = 2, /* project-wide search */
    RTX_PICK_QMAX = 256
};

struct RtxProj;

enum {
    RTX_UI_FIND_ROWS = 8,
    /* Caret phase: on this long, then off this long (Windows'
     * GetCaretBlinkTime default and GTK's gtk-cursor-blink-time / 2). */
    RTX_UI_BLINK_MS = 530,
    /* Blinking stops (caret solid, no timer) this long after the last
     * input or focus-in: GTK's gtk-cursor-blink-timeout default (10 s). */
    RTX_UI_BLINK_IDLE_MS = 10000
};

/* RtxUi.jump_kind: the jump prompt also asks a workbook rename's name. */
enum { RTX_JUMP_LINE = 0, RTX_JUMP_RENAME = 1 };

typedef struct {
    int help;
    size_t help_top; /* first visible line of the help overlay */
    int apply; /* on-screen apply palette (Cmd-. / then 1-9) */
    int palette; /* command palette (Ctrl-Shift-P / F1 / Esc :) */
    RtxPalette pal;
    int stats;
    int jump;
    char jump_buf[64];
    size_t jump_len;
    int jump_kind;       /* RTX_JUMP_LINE / RTX_JUMP_RENAME (workbook rename) */
    size_t jump_at;      /* rename: the caret the prompt opened at */
    char jump_msg[160];  /* rename: result for the status bar */
    int find;
    char find_buf[RTX_FIND_QMAX];
    size_t find_len;
    size_t find_caret;
    size_t find_sel;
    size_t find_top;
    unsigned find_opts;  /* RTX_FIND_ICASE / WORD / REGEX (Alt-C / W / R) */
    /* Replace row under the find field (Ctrl-F again / Alt-E). */
    int repl;            /* 1 = the row is shown */
    int repl_focus;      /* 1 = typing goes to the replace field (Tab) */
    char repl_buf[RTX_FIND_QMAX];
    size_t repl_len;
    size_t repl_caret;
    size_t repl_sel;
    int repl_whole;      /* Alt-L: 1 = ignore a multi-line selection */
    int repl_scoped;     /* the running replace-all is inside a selection */
    char repl_msg[112];  /* "N replaced" / a refusal, shown in the find head */
    RtxReplace rjob;     /* replace-all job (scan, then one edit group) */
    int ask_quit;
    int ask_conflict;    /* 1: file changed on disk; overwrite / cancel */
    int ask_xact;        /* 1: undo of a split workspace transaction; all /
                          * this file / cancel (xact_buf is the buffer) */
    int xact_buf;
    int ask_close;       /* RTX_CLOSE_*: unsaved buffers on a close; save /
                          * don't save / cancel (close_buf: the one buffer) */
    int close_buf;
    int blink;           /* 1 = caret / prompt visible */
    long blink_at;       /* monotonic ms; 0 = not started (visible) */
    int no_blink;        /* 1 = caret always on (--no-blink) */
    long input_at;       /* monotonic ms of the last input / focus-in */
    long blink_idle_ms;  /* stop blinking this long after input_at;
                          * 0 = RTX_UI_BLINK_IDLE_MS, < 0 = never stop */
    int unfocused;       /* 1 = window / terminal lost focus: solid, no timer */
    int caret_host;      /* 1 = the host shows the caret on its own layer (the
                          * terminal cursor, an OS caret layer): paint never
                          * draws the editor or prompt caret (rtx_ui_here = 0,
                          * rtx_ui_prompt_caret = ""); it notes where it is
                          * (rtx_ui_caret_at) */
    int host_blinks;     /* 1 = that layer blinks by itself (the terminal):
                          * no blink timer, the host never wakes for it */
    /* Project picker. [0] quick-open, [1] search: each mode keeps its
     * query, caret and list position. The project (index, pick list,
     * search results) is host-owned and outlives the overlay, so search
     * results survive switching files (F4 / Shift-F4 step them). */
    int pick;            /* RTX_PICK_* */
    char pick_q[2][RTX_PICK_QMAX];
    size_t pick_len[2], pick_caret[2], pick_sel[2];
    size_t pick_cur[2], pick_top[2];
    unsigned pick_opts;  /* search: RTX_FIND_ICASE / WORD / REGEX */
    long pick_due;       /* search debounce (monotonic ms); 0 = none */
    size_t pick_seen[2]; /* published counts at the last paint */
    size_t ps_hit;       /* 1 + the search hit last opened; 0 = none */
    char pick_msg[128];
    struct RtxProj *proj;
    char *proj_hint;     /* --project DIR, else the first file / start dir */
} RtxUi;

long rtx_ui_now_ms(void);

enum { RTX_CLICK_MS = 400 };

typedef struct {
    long at_ms;
    size_t off;
    int n;
} RtxClickSeq;

int rtx_click_count(RtxClickSeq *s, long now, size_t off);

/* Input (or focus-in): caret visible, blink clock and idle clock restart. */
void rtx_ui_blink_show(RtxUi *ui);

/* 1 = the visible state changed (repaint the caret). Toggles every
 * RTX_UI_BLINK_MS while the blink is live; once it is not (idle, no focus)
 * it settles on visible and stops. */
int rtx_ui_blink_step(RtxUi *ui);

int rtx_ui_blink(const RtxUi *ui);

/* Timer still running: not --no-blink, focused, input within the idle
 * window. */
int rtx_ui_blink_live(const RtxUi *ui, long now);

/* ms until rtx_ui_blink_step has work (0 = now), or -1 = never: the host
 * may sleep until input. */
long rtx_ui_blink_next_ms(const RtxUi *ui, long now);

/* Window / terminal focus. In restarts the blink; out settles the caret
 * solid. 1 = the caret's look changed. */
int rtx_ui_blink_focus(RtxUi *ui, int in);

/* RTX_BLINK_IDLE_MS from the environment (tests), else 0 (the default). */
long rtx_ui_blink_idle_env(void);

/* Find / jump own the blinking caret. The document does not. */
int rtx_ui_prompting(const RtxUi *ui);

/* The painted caret, lit this phase. 0 when the host shows the caret
 * (caret_host). */
int rtx_ui_here(const RtxUi *ui, int focused, int at);

/* Where the document caret is, whatever the phase or who draws it:
 * focused pane, the caret's position, no prompt owning the caret. */
int rtx_ui_caret_at(const RtxUi *ui, int focused, int at);

int rtx_gutter_cols(size_t nlines);

/* 0-based line of the seeking camera: gutter key (origin + seek_rel). */
size_t rtx_isle_cam_line(const RtxBuf *b);

/* Physical rows from the window origin — not line_guess(from_line). */
size_t rtx_gutter_win(const RtxBuf *b, size_t row_line);

/* 0 = 1-based abs in *abs. 1 = gap +N in *plus. -1 = gap -N in *plus. */
int rtx_gutter_gap(const RtxBuf *b, size_t byte_start, size_t row_line,
                          size_t *abs, size_t *plus);

/* 1-based dest line on vis row `win` while g L is pumping. 0 if not. */
static inline size_t rtx_jump_pending_abs(const RtxBuf *b, size_t win) {
    if (!b || !rtx_line_want_pumping(&b->doc.tree)) return 0;
    return b->top + win + 1;
}

/* Digit width from the current camera, not a growing scan frontier. */
int rtx_gutter_cols_buf(const RtxBuf *b, int vis);

/* Byte-rail scrollbar. Geometry uses file bytes, never soft line_count. */
typedef struct {
    size_t pos;
    size_t vis;
    size_t len;
    int ready;
} RtxScrollRail;

int rtx_scroll_rail_thumb_h(const RtxScrollRail *r, int track_h, int min_th);

void rtx_scroll_rail_thumb(const RtxScrollRail *r, int track_h, int min_th,
                                  int *thumb_y, int *thumb_h);

int rtx_scroll_rail_needed(const RtxScrollRail *r);

/* Byte → track row. Independent of thumb size so a caret tick can sit
 * on the rail or on the thumb. */
int rtx_scroll_rail_mark_y(const RtxScrollRail *r, int track_h, size_t off);

/* Caret row in the visible window (0 = first vis row). */
int rtx_buf_scroll_rel_row(const RtxBuf *b, int vis);

/* Gap caret tick sits on the thumb (file bytes), not the full track.
 * Mapping +1 onto the track put a 99% jump at y=0. */
int rtx_buf_scroll_rel_mark_y(const RtxBuf *b, const RtxScrollRail *rail,
                                     int track_h, int min_th, int vis);

/* Same gap as red +N / -L gutters. Hex has no relative lined camera. */
int rtx_buf_scroll_rel(const RtxBuf *b);

int RtxBuf_scroll_needed(const RtxBuf *b, int vis_rows);

size_t rtx_scroll_rail_pos_at(const RtxScrollRail *r, int track_h, int min_th,
                                    int thumb_top);

RtxScrollRail !>(RtxIndexErr) RtxBuf_scroll_rail(const RtxBuf *b, int vis_rows);

/* Preview camera + first window. No line_start. */
RtxScrollRail rtx_browse_prev_rail(const RtxBrowsePrev *p, int vis);
void !>(CCError) rtx_browse_prev_scroll_vis(RtxBrowsePrev *p, RtxMeasure *m,
                                            double width, int vis, int dir);
void !>(CCError) rtx_browse_prev_scroll_to_off(RtxBrowsePrev *p, RtxMeasure *m,
                                               double width, int vis, size_t off);
void rtx_browse_prev_drag_end(RtxBrowsePrev *p);

#endif
