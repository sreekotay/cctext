#!ccc cch
/*
 * RtxUi + caret/gutter helpers. Paint TUs include this without ui.cch
 * (find methods stay in ui.cch, after find.cch on the host).
 */
#ifndef RTX_UI_TYPES_H
#define RTX_UI_TYPES_H

#include <time.h>

enum {
    RTX_UI_FIND_ROWS = 8,
    RTX_UI_BLINK_MS = 400
};

typedef struct {
    int help;
    int stats;
    int jump;
    char jump_buf[16];
    size_t jump_len;
    int find;
    char find_buf[RTX_FIND_QMAX];
    size_t find_len;
    size_t find_caret;
    size_t find_sel;
    size_t find_top;
    int ask_quit;
    int blink;           /* 1 = caret / prompt visible */
    long blink_at;       /* monotonic ms; 0 = not started (visible) */
} RtxUi;

static long rtx_ui_now_ms(void) {
    struct timespec ts;
    clock_gettime(CLOCK_MONOTONIC, &ts);
    return (long)ts.tv_sec * 1000 + ts.tv_nsec / 1000000;
}

static void rtx_ui_blink_show(RtxUi *ui) {
    if (!ui) return;
    ui->blink = 1;
    ui->blink_at = rtx_ui_now_ms();
}

static int rtx_ui_blink_step(RtxUi *ui) {
    long now;
    if (!ui) return 0;
    now = rtx_ui_now_ms();
    if (ui->blink_at == 0) {
        ui->blink = 1;
        ui->blink_at = now;
        return 0;
    }
    if (now - ui->blink_at >= RTX_UI_BLINK_MS) {
        ui->blink = !ui->blink;
        ui->blink_at = now;
        return 1;
    }
    return 0;
}

static int rtx_ui_blink(const RtxUi *ui) {
    if (!ui || ui->blink_at == 0) return 1;
    return ui->blink;
}

/* Find / jump own the blinking caret. The document does not. */
static int rtx_ui_prompting(const RtxUi *ui) {
    return ui && (ui->find || ui->jump);
}

static int rtx_ui_here(const RtxUi *ui, int focused, int at) {
    return focused && at && !rtx_ui_prompting(ui) && rtx_ui_blink(ui);
}

static int rtx_gutter_cols(size_t nlines) {
    int w = 1;
    if (nlines == 0) nlines = 1;
    while (nlines >= 10) {
        nlines /= 10;
        w++;
    }
    return w + 1;
}

/* 0 = 1-based abs in *abs. 1 = gap +N in *plus. -1 = gap -N in *plus. */
static int rtx_gutter_gap(const RtxBuf *b, size_t byte_start, size_t row_line,
                          size_t *abs, size_t *plus) {
    size_t win;
    long rel;
    const RtxPieceTree *t;
    if (!b) return 0;
    win = row_line >= b->layout.from_line ? row_line - b->layout.from_line : 0;
    if (b->doc.index_covers(byte_start)) {
        if (abs) *abs = row_line + 1;
        return 0;
    }
    t = &b->doc.tree;
    if (b->seek_valid) rel = b->seek_rel + (long)win;
    else rel = (long)win;
    if (rtx_line_isle_connected(t)) {
        long n = (long)t->scan_line + (long)t->isle_before + rel;
        if (n < 0) n = 0;
        if (abs) *abs = (size_t)n + 1;
        return 0;
    }
    if (rel >= 0) {
        if (plus) *plus = (size_t)rel + 1;
        return 1;
    }
    if (plus) *plus = (size_t)(-rel);
    return -1;
}

/* Digit width from the current camera, not a growing scan frontier. */
static int rtx_gutter_cols_buf(const RtxBuf *b, int vis) {
    size_t need;
    size_t extra = (vis > 0 ? (size_t)vis : 32) + 8;
    if (!b) return 2;
    if (b->seek_valid && !b->doc.index_covers(b->seek_off) &&
        !rtx_line_isle_connected(&b->doc.tree))
        return rtx_gutter_cols(extra) + 1;
    if (b->seek_valid) {
        need = b->layout.from_line + extra;
        if (need < extra) need = extra;
        return rtx_gutter_cols(need);
    }
    need = b->doc.line_known();
    if (b->doc.lf_ready()) need = b->line_count();
    else {
        size_t tip = b->top + extra;
        if (tip > need) need = tip;
    }
    return rtx_gutter_cols(need);
}

/* Byte-rail scrollbar. Geometry uses file bytes, never soft line_count. */
typedef struct {
    size_t pos;
    size_t vis;
    size_t len;
    int ready;
} RtxScrollRail;

static int rtx_scroll_rail_thumb_h(const RtxScrollRail *r, int track_h, int min_th) {
    int th;
    if (!r || track_h < 1) return 0;
    if (min_th < 1) min_th = 1;
    if (r->len == 0 || r->vis >= r->len) return track_h;
    th = (int)((unsigned long long)track_h * r->vis / r->len);
    if (th < min_th) th = min_th;
    if (th > track_h) th = track_h;
    return th;
}

static void rtx_scroll_rail_thumb(const RtxScrollRail *r, int track_h, int min_th,
                                  int *thumb_y, int *thumb_h) {
    int th;
    size_t span;
    int y = 0;
    th = rtx_scroll_rail_thumb_h(r, track_h, min_th);
    if (thumb_h) *thumb_h = th;
    if (!r || track_h < 1 || r->len == 0 || r->vis >= r->len) {
        if (thumb_y) *thumb_y = 0;
        return;
    }
    span = r->len - r->vis;
    {
        int usable = track_h - th;
        size_t pos = r->pos > span ? span : r->pos;
        if (usable > 0 && span)
            y = (int)((unsigned long long)pos * (size_t)usable / span);
        if (y < 0) y = 0;
        if (y > usable) y = usable;
    }
    if (thumb_y) *thumb_y = y;
}

static int rtx_scroll_rail_needed(const RtxScrollRail *r) {
    return r && r->len > 0 && r->vis < r->len;
}

/* Byte → track row. Independent of thumb size so a caret tick can sit
 * on the rail or on the thumb. */
static int rtx_scroll_rail_mark_y(const RtxScrollRail *r, int track_h, size_t off) {
    size_t span;
    if (!r || track_h < 1 || r->len == 0) return 0;
    if (off >= r->len) off = r->len - 1;
    span = r->len - 1;
    if (span == 0 || track_h == 1) return 0;
    return (int)((unsigned long long)off * (size_t)(track_h - 1) / span);
}

/* Caret on the relative rail: 0 is the +0 / +1 origin row in this window.
 * File-byte mark_y is useless in a gap (8G barely moves a pixel). */
static int rtx_buf_scroll_rel_mark_y(const RtxBuf *b, int track_h, int vis) {
    size_t i, i0, i1;
    size_t caret;
    if (!b || track_h < 1 || vis < 1 || !b->layout.len) return 0;
    caret = b->doc.caret;
    i0 = b->top_wrap < b->layout.len ? b->top_wrap : 0;
    i1 = i0 + (size_t)vis;
    if (i1 > b->layout.len) i1 = b->layout.len;
    if (i1 <= i0) return 0;
    if (caret < b->layout.rows[i0].byte_start) return 0;
    {
        const RtxVisRow *last = &b->layout.rows[i1 - 1];
        if (caret > last->byte_start + last->byte_len) return track_h - 1;
    }
    for (i = i0; i < i1; i++) {
        const RtxVisRow *row = &b->layout.rows[i];
        if (caret >= row->byte_start && caret <= row->byte_start + row->byte_len) {
            size_t vr = i - i0;
            if (vis <= 1 || track_h <= 1) return 0;
            return (int)((unsigned long long)vr * (size_t)(track_h - 1) /
                         (size_t)(vis - 1));
        }
    }
    return 0;
}

/* Same gap as red +N / -L gutters. Hex has no relative line camera. */
static int rtx_buf_scroll_rel(const RtxBuf *b) {
    size_t off;
    if (!b || rtx_layout_is_hex(&b->layout)) return 0;
    if (rtx_line_isle_connected(&b->doc.tree)) return 0;
    if (b->layout.len) off = b->layout.rows[0].byte_start;
    else if (b->seek_valid) off = b->seek_off;
    else off = b->doc.caret;
    return !b->doc.index_covers(off);
}

static int RtxBuf_scroll_needed(const RtxBuf *b, int vis_rows) {
    size_t n;
    if (!b || vis_rows < 1) return 0;
    n = b->len();
    if (n == 0) return 0;
    if (rtx_layout_is_hex(&b->layout))
        return n > (size_t)vis_rows * (size_t)RTX_HEX_COLS;
    if (!b->doc.lf_ready()) return 1;
    if (b->top > 0 || b->top_wrap > 0) return 1;
    if (b->layout.len > (size_t)vis_rows) return 1;
    if (b->layout.len &&
        ((b->seek_valid && b->layout.rows[0].byte_start == b->seek_off) ||
         (!b->seek_valid && b->layout.from_line == b->top))) {
        const RtxVisRow *last = &b->layout.rows[b->layout.len - 1];
        if (last->byte_start + last->byte_len >= n) return 0;
    }
    return b->line_count() > (size_t)vis_rows;
}

static size_t rtx_scroll_rail_pos_at(const RtxScrollRail *r, int track_h, int min_th,
                                    int thumb_top) {
    int th;
    int usable;
    size_t span;
    if (!r || r->len == 0) return 0;
    if (r->vis >= r->len) return 0;
    span = r->len - r->vis;
    th = rtx_scroll_rail_thumb_h(r, track_h, min_th);
    usable = track_h - th;
    if (usable <= 0) return 0;
    if (thumb_top < 0) thumb_top = 0;
    if (thumb_top > usable) thumb_top = usable;
    return (size_t)((unsigned long long)thumb_top * span / (size_t)usable);
}

static RtxScrollRail !>(RtxIndexErr) RtxBuf_scroll_rail(const RtxBuf *b, int vis_rows) {
    RtxScrollRail r = {0};
    size_t n;
    if (!b) return cc_ok(r);
    n = b->len();
    r.len = n;
    if (vis_rows < 1) vis_rows = 1;
    if (rtx_layout_is_hex(&b->layout)) {
        r.pos = b->top_byte;
        r.vis = (size_t)vis_rows * (size_t)RTX_HEX_COLS;
        if (r.pos > n) r.pos = n;
        if (r.vis > n - r.pos) r.vis = n - r.pos;
        if (r.vis == 0 && n) r.vis = n < (size_t)RTX_HEX_COLS ? n : (size_t)RTX_HEX_COLS;
        r.ready = 1;
        return cc_ok(r);
    }
    r.ready = b->doc.lf_ready();
    if (b->layout.len &&
        ((b->seek_valid && b->layout.rows[0].byte_start == b->seek_off) ||
         (!b->seek_valid && b->layout.from_line == b->top))) {
        size_t i0 = b->top_wrap < b->layout.len ? b->top_wrap : 0;
        size_t i1 = i0;
        size_t shown = 1;
        r.pos = b->layout.rows[i0].byte_start;
        while (i1 + 1 < b->layout.len && shown < (size_t)vis_rows) {
            i1++;
            shown++;
        }
        r.vis = (b->layout.rows[i1].byte_start + b->layout.rows[i1].byte_len) - r.pos;
    } else if (b->seek_valid) {
        r.pos = b->seek_off;
        r.vis = 0;
    } else if (b->top < b->doc.line_known()) {
        r.pos = b->line_start(b->top) !>(e) { return cc_err(e); };
        r.vis = 0;
    } else {
        r.pos = 0;
        r.vis = 0;
    }
    if (r.pos > n) r.pos = n;
    if (r.vis > n - r.pos) r.vis = n - r.pos;
    if (r.vis == 0 && n) {
        r.vis = n < 64 ? n : 64;
        if (r.vis > n - r.pos) r.vis = n - r.pos;
    }
    return cc_ok(r);
}

#endif
