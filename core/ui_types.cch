#!ccc cch
/*
 * RtxUi + caret/gutter helpers (decls). Bodies live in workspace.ccs —
 * workspace.cch includes this face. Paint TUs include this without ui.cch
 * (find methods stay in ui.cch, after find.cch on the host).
 */
#ifndef RTX_UI_TYPES_H
#define RTX_UI_TYPES_H

#include <time.h>
#include "core/ui_cmd.h"

enum {
    RTX_UI_FIND_ROWS = 8,
    RTX_UI_BLINK_MS = 400
};

typedef struct {
    int help;
    int stats;
    int jump;
    char jump_buf[16];
    size_t jump_len;
    int find;
    char find_buf[RTX_FIND_QMAX];
    size_t find_len;
    size_t find_caret;
    size_t find_sel;
    size_t find_top;
    int ask_quit;
    int ask_conflict;    /* 1: file changed on disk; overwrite / cancel */
    int blink;           /* 1 = caret / prompt visible */
    long blink_at;       /* monotonic ms; 0 = not started (visible) */
    int no_blink;        /* 1 = caret always on (--no-blink) */
} RtxUi;

long rtx_ui_now_ms(void);

enum { RTX_CLICK_MS = 400 };

typedef struct {
    long at_ms;
    size_t off;
    int n;
} RtxClickSeq;

int rtx_click_count(RtxClickSeq *s, long now, size_t off);

void rtx_ui_blink_show(RtxUi *ui);

int rtx_ui_blink_step(RtxUi *ui);

int rtx_ui_blink(const RtxUi *ui);

/* Find / jump own the blinking caret. The document does not. */
int rtx_ui_prompting(const RtxUi *ui);

int rtx_ui_here(const RtxUi *ui, int focused, int at);

int rtx_gutter_cols(size_t nlines);

/* 0-based line of the seeking camera: gutter key (origin + seek_rel). */
size_t rtx_isle_cam_line(const RtxBuf *b);

/* Physical rows from the window origin — not line_guess(from_line). */
size_t rtx_gutter_win(const RtxBuf *b, size_t row_line);

/* 0 = 1-based abs in *abs. 1 = gap +N in *plus. -1 = gap -N in *plus. */
int rtx_gutter_gap(const RtxBuf *b, size_t byte_start, size_t row_line,
                          size_t *abs, size_t *plus);

/* 1-based dest line on vis row `win` while g L is pumping. 0 if not. */
static inline size_t rtx_jump_pending_abs(const RtxBuf *b, size_t win) {
    if (!b || !rtx_line_want_pumping(&b->doc.tree)) return 0;
    return b->top + win + 1;
}

/* Digit width from the current camera, not a growing scan frontier. */
int rtx_gutter_cols_buf(const RtxBuf *b, int vis);

/* Byte-rail scrollbar. Geometry uses file bytes, never soft line_count. */
typedef struct {
    size_t pos;
    size_t vis;
    size_t len;
    int ready;
} RtxScrollRail;

int rtx_scroll_rail_thumb_h(const RtxScrollRail *r, int track_h, int min_th);

void rtx_scroll_rail_thumb(const RtxScrollRail *r, int track_h, int min_th,
                                  int *thumb_y, int *thumb_h);

int rtx_scroll_rail_needed(const RtxScrollRail *r);

/* Byte → track row. Independent of thumb size so a caret tick can sit
 * on the rail or on the thumb. */
int rtx_scroll_rail_mark_y(const RtxScrollRail *r, int track_h, size_t off);

/* Caret row in the visible window (0 = first vis row). */
int rtx_buf_scroll_rel_row(const RtxBuf *b, int vis);

/* Gap caret tick sits on the thumb (file bytes), not the full track.
 * Mapping +1 onto the track put a 99% jump at y=0. */
int rtx_buf_scroll_rel_mark_y(const RtxBuf *b, const RtxScrollRail *rail,
                                     int track_h, int min_th, int vis);

/* Same gap as red +N / -L gutters. Hex has no relative lined camera. */
int rtx_buf_scroll_rel(const RtxBuf *b);

int RtxBuf_scroll_needed(const RtxBuf *b, int vis_rows);

size_t rtx_scroll_rail_pos_at(const RtxScrollRail *r, int track_h, int min_th,
                                    int thumb_top);

RtxScrollRail !>(RtxIndexErr) RtxBuf_scroll_rail(const RtxBuf *b, int vis_rows);

/* Preview camera + first window. No line_start. */
RtxScrollRail rtx_browse_prev_rail(const RtxBrowsePrev *p, int vis);

#endif
