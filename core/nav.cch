#!ccc cch
/*
 * In-window mark motion and fold. Bodies in nav.ccs (linked TU).
 * Host wrappers only; intern IDs live in scope.ccs.
 */
#ifndef RTX_NAV_H
#define RTX_NAV_H

int rtx_nav_step_at(const void *runs, size_t n, size_t *caret, size_t *anchor,
                    int *box, int dir, int (*want)(RtxScope),
                    const void *folds, size_t fold_n);
int rtx_nav_fold_at(size_t *caret, size_t *anchor, const void *runs, size_t n,
                    void *tree, void *folds, size_t *fold_n, size_t fold_max);
int rtx_nav_from_ctrl(int c);
int rtx_nav_from_letter(int c);
const char *rtx_nav_msg(int cmd, int r, int hex);
size_t rtx_nav_run_bytes(void);
size_t rtx_nav_fold_bytes(void);
size_t rtx_nav_snap(const void *folds, size_t fold_n, size_t off, int dir);
int rtx_nav_brace_pages(size_t caret, size_t doc_len, size_t *from, size_t *to);

static size_t RtxDoc_fold_snap(const RtxDoc *d, size_t off, int dir) {
    if (!d || !d->fold_n) return off;
    return rtx_nav_snap(d->folds, d->fold_n, off, dir);
}

static int RtxDoc_scope_step(RtxDoc *d, int dir, int invalid) {
    int r;
    if (!d) return 0;
    r = rtx_nav_step_at(d->runs, d->run_len, &d->caret, &d->sel_anchor,
                        &d->sel_box, dir,
                        invalid ? rtx_scope_is_invalid : rtx_scope_is_mark,
                        d->folds, d->fold_n);
    if (r) d->hist.coalesce = 0;
    return r;
}

static int RtxDoc_fold_toggle(RtxDoc *d) {
    int r;
    if (!d) return 0;
    r = rtx_nav_fold_at(&d->caret, &d->sel_anchor, d->runs, d->run_len,
                        &d->tree, d->folds, &d->fold_n, (size_t)RTX_FOLD_MAX);
    if (r) d->hist.coalesce = 0;
    return r;
}

#endif /* RTX_NAV_H */
