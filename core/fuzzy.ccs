#!ccc ccs
/*
 * Fuzzy subsequence scorer (linked TU; see fuzzy.cch).
 *
 * One pass per pattern byte over the string: H[j] is the best score with
 * the current pattern byte matched at s[j]. A match continues the
 * previous byte's alignment at j-1 (contiguous: the consecutive bonus) or
 * any earlier one across a gap (GAP_START + GAP_EXT per extra byte). R
 * carries the best gapped predecessor so a row is O(n). Two rows on the
 * stack; nothing allocates.
 */
#include <ccc/std/prelude.cch>
#include <stddef.h>
#include "fuzzy.cch"

enum {
    FZ_MATCH = 16,
    FZ_GAP_START = 3,
    FZ_GAP_EXT = 1,
    FZ_PREFIX = 12,    /* the string's first byte */
    FZ_BOUNDARY = 9,   /* after a separator */
    FZ_CAMEL = 7,      /* aB, a1 */
    FZ_CONSEC = 6,     /* right after the previous matched byte */
    FZ_FIRST_MUL = 2,  /* the first pattern byte's bonus counts twice */
    FZ_NEG = -1000000
};

static int fz_lower(int c) {
    return (c >= 'A' && c <= 'Z') ? c - 'A' + 'a' : c;
}

static int fz_is_upper(int c) { return c >= 'A' && c <= 'Z'; }
static int fz_is_lower(int c) { return c >= 'a' && c <= 'z'; }
static int fz_is_digit(int c) { return c >= '0' && c <= '9'; }
static int fz_is_alnum(int c) {
    return fz_is_upper(c) || fz_is_lower(c) || fz_is_digit(c) || c >= 0x80;
}

static int fz_bonus(const unsigned char *s, size_t j) {
    int c, p;
    if (j == 0) return FZ_PREFIX;
    c = s[j];
    p = s[j - 1];
    if (!fz_is_alnum(p)) return FZ_BOUNDARY;
    if (fz_is_lower(p) && fz_is_upper(c)) return FZ_CAMEL;
    if (!fz_is_digit(p) && fz_is_digit(c)) return FZ_CAMEL;
    return 0;
}

int rtx_fuzzy_score(const char *pat, size_t pn, const char *str, size_t sn) {
    int rowa[RTX_FUZZY_MAX_S];
    int rowb[RTX_FUZZY_MAX_S];
    int *prev = rowa;
    int *cur = rowb;
    const unsigned char *s;
    const unsigned char *p = (const unsigned char *)pat;
    size_t i, j, lo;
    int best, out;
    if (pn == 0) return 0;
    if (!pat || !str || pn > RTX_FUZZY_MAX_P || sn < pn) return -1;
    if (sn > RTX_FUZZY_MAX_S) {
        str += sn - RTX_FUZZY_MAX_S;
        sn = RTX_FUZZY_MAX_S;
    }
    s = (const unsigned char *)str;
    /* Quick reject: pat must be a subsequence at all. */
    for (i = 0, j = 0; i < pn && j < sn; j++)
        if (fz_lower(p[i]) == fz_lower(s[j])) i++;
    if (i < pn) return -1;
    lo = 0;
    for (i = 0; i < pn; i++) {
        int pc = fz_lower(p[i]);
        int r = FZ_NEG;
        int any = 0;
        size_t first = sn;
        for (j = 0; j < sn; j++) {
            int h = FZ_NEG;
            if (i > 0 && j >= 2) {
                int a = r - FZ_GAP_EXT;
                int b = prev[j - 2] > FZ_NEG ? prev[j - 2] - FZ_GAP_START : FZ_NEG;
                r = a > b ? a : b;
                if (r < FZ_NEG) r = FZ_NEG;
            }
            if (j >= lo && fz_lower(s[j]) == pc) {
                int bo = fz_bonus(s, j);
                if (i == 0) {
                    /* Earlier starts win ties (a little). */
                    int lead = (int)(j > 15 ? 15 : j) / 4;
                    h = FZ_MATCH + bo * FZ_FIRST_MUL - lead;
                } else {
                    int c1 = FZ_NEG, c2 = FZ_NEG;
                    if (j >= 1 && prev[j - 1] > FZ_NEG)
                        c1 = prev[j - 1] + FZ_MATCH + (bo > FZ_CONSEC ? bo : FZ_CONSEC);
                    if (r > FZ_NEG) c2 = r + FZ_MATCH + bo;
                    h = c1 > c2 ? c1 : c2;
                }
                if (h > FZ_NEG) {
                    any = 1;
                    if (j < first) first = j;
                }
            }
            cur[j] = h;
        }
        if (!any) return -1;
        lo = first + 1;
        {
            int *t = prev;
            prev = cur;
            cur = t;
        }
    }
    best = FZ_NEG;
    for (j = 0; j < sn; j++)
        if (prev[j] > best) best = prev[j];
    if (best <= FZ_NEG) return -1;
    /* x8 leaves room for the length tie-break (shorter wins). */
    out = best * 8 - (int)(sn > 255 ? 255 : sn) / 4;
    return out < 0 ? 0 : out;
}

int rtx_fuzzy_score_cstr(const char *pat, const char *s) {
    size_t pn = 0, sn = 0;
    if (!pat || !s) return -1;
    while (pat[pn]) pn++;
    while (s[sn]) sn++;
    return rtx_fuzzy_score(pat, pn, s, sn);
}
