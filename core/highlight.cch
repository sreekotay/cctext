#!ccc cch
/*
 * Syntax highlight for code sections. Spike lexer emits interned scopes;
 * a lowered TextMate runtime is used when the path matches a loaded grammar.
 * Frontends theme scope → color. Window lex + lookback replay, plus
 * stride checkpoints so a later window can restore the begin/end stack.
 */
#ifndef RTX_HIGHLIGHT_H
#define RTX_HIGHLIGHT_H

#include "tm.cch"

static int rtx_hl_ident_start(char c) {
    return (c >= 'A' && c <= 'Z') || (c >= 'a' && c <= 'z') || c == '_';
}

static int rtx_hl_ident(char c) {
    return rtx_hl_ident_start(c) || (c >= '0' && c <= '9');
}

static int rtx_hl_is_keyword(const char *s, size_t n) {
    static const char *kws[] = {
        "int", "void", "return", "if", "else", "for", "while", "do",
        "struct", "typedef", "static", "const", "char", "size_t",
        "unsigned", "long", "short", "enum", "union", "sizeof",
        "break", "continue", "switch", "case", "default", "goto",
        "extern", "inline", "bool", "true", "false", "NULL",
        "include", "define", "ifdef", "ifndef", "endif", "pragma",
        NULL
    };
    size_t i;
    for (i = 0; kws[i]; i++) {
        if (strlen(kws[i]) == n && memcmp(s, kws[i], n) == 0) return 1;
    }
    return 0;
}

static int rtx_hl_add_scope(RtxDoc *d, size_t start, size_t len, size_t emit_from,
                            RtxScope scope) {
    RtxStyle st = {0};
    size_t end;
    if (!d || len == 0 || scope == RTX_SCOPE_NONE) return 1;
    end = start + len;
    if (end <= emit_from) return 1;
    if (start < emit_from) {
        len = end - emit_from;
        start = emit_from;
    }
    st.scope = scope;
    return rtx_doc_add_run(d, start, len, st);
}

static void !>(CCError) rtx_hl_spike(RtxDoc *d, const char *buf, size_t base,
                                    size_t n, size_t emit_from) {
    size_t i = 0;
    RtxScope sc_comment;
    RtxScope sc_string;
    RtxScope sc_number;
    RtxScope sc_keyword;
    if (!d || !buf || n == 0) return cc_ok();
    if (!rtx_scope_put(&sc_comment, "comment") ||
        !rtx_scope_put(&sc_string, "string") ||
        !rtx_scope_put(&sc_number, "constant.numeric") ||
        !rtx_scope_put(&sc_keyword, "keyword")) {
        return cc_err(CC_ERR_OUT_OF_MEMORY, "scope intern");
    }
    while (i < n) {
        char c = buf[i];
        if (c == '/' && i + 1 < n && buf[i + 1] == '/') {
            size_t j = i + 2;
            while (j < n && buf[j] != '\n') j++;
            if (!rtx_hl_add_scope(d, base + i, j - i, emit_from, sc_comment)) {
                return cc_err(CC_ERR_OUT_OF_MEMORY, "hl run");
            }
            i = j;
        } else if (c == '/' && i + 1 < n && buf[i + 1] == '*') {
            size_t j = i + 2;
            while (j + 1 < n && !(buf[j] == '*' && buf[j + 1] == '/')) j++;
            if (j + 1 < n) j += 2;
            else j = n;
            if (!rtx_hl_add_scope(d, base + i, j - i, emit_from, sc_comment)) {
                return cc_err(CC_ERR_OUT_OF_MEMORY, "hl run");
            }
            i = j;
        } else if (c == '"') {
            size_t j = i + 1;
            while (j < n && buf[j] != '"') {
                if (buf[j] == '\\' && j + 1 < n) j += 2;
                else j++;
            }
            if (j < n) j++;
            if (!rtx_hl_add_scope(d, base + i, j - i, emit_from, sc_string)) {
                return cc_err(CC_ERR_OUT_OF_MEMORY, "hl run");
            }
            i = j;
        } else if (c == '\'') {
            size_t j = i + 1;
            while (j < n && buf[j] != '\'') {
                if (buf[j] == '\\' && j + 1 < n) j += 2;
                else j++;
            }
            if (j < n) j++;
            if (!rtx_hl_add_scope(d, base + i, j - i, emit_from, sc_string)) {
                return cc_err(CC_ERR_OUT_OF_MEMORY, "hl run");
            }
            i = j;
        } else if (c >= '0' && c <= '9') {
            size_t j = i + 1;
            while (j < n && ((buf[j] >= '0' && buf[j] <= '9') || buf[j] == 'x' ||
                             (buf[j] >= 'a' && buf[j] <= 'f') ||
                             (buf[j] >= 'A' && buf[j] <= 'F'))) {
                j++;
            }
            if (!rtx_hl_add_scope(d, base + i, j - i, emit_from, sc_number)) {
                return cc_err(CC_ERR_OUT_OF_MEMORY, "hl run");
            }
            i = j;
        } else if (rtx_hl_ident_start(c)) {
            size_t j = i + 1;
            while (j < n && rtx_hl_ident(buf[j])) j++;
            if (rtx_hl_is_keyword(buf + i, j - i)) {
                if (!rtx_hl_add_scope(d, base + i, j - i, emit_from, sc_keyword)) {
                    return cc_err(CC_ERR_OUT_OF_MEMORY, "hl run");
                }
            }
            i = j;
        } else {
            i++;
        }
    }
    return cc_ok();
}

static void !>(CCError) rtx_hl_range(RtxDoc *d, const char *buf, size_t base,
                                    size_t n, size_t emit_from,
                                    const RtxTmCkpt *seed, RtxTmWalk walk) {
    const RtxTmRt *rt;
    if (!d || !buf || n == 0) return cc_ok();
    rt = rtx_tm_for_path(d->path.ptr);
    if (rt) return rtx_tm_lex(d, rt, buf, base, n, emit_from, seed, walk);
    return rtx_hl_spike(d, buf, base, n, emit_from);
}

static void rtx_doc_hl_abort(RtxDoc *d) {
    size_t i;
    size_t o = 0;
    if (!d) return;
    for (i = 0; i < d->run_len; i++) {
        RtxRun r = d->runs[i];
        int hl_only = r.style.scope != RTX_SCOPE_NONE && !r.style.bold &&
                      !r.style.italic && !r.style.mono;
        if (hl_only) continue;
        d->runs[o++] = r;
    }
    d->run_len = o;
    for (i = 0; i < d->sec_len; i++) d->secs[i].hl_done = 0;
    d->hl_full = 0;
    d->tm_ckpt_len = 0;
}

static void !>(CCError) rtx_doc_highlight(RtxDoc *d) {
    size_t n, s;
    if (!d) return cc_err(CC_ERR_INVALID_ARG, "null doc");
    n = d->len();
    if (n == 0) return cc_ok();
    @defer(err) rtx_doc_hl_abort(d);
    for (s = 0; s < d->sec_len; s++) {
        size_t lo = d->secs[s].start;
        size_t hi = (s + 1 < d->sec_len) ? d->secs[s + 1].start : n;
        if (d->secs[s].kind != RTX_SEC_CODE) continue;
        if (hi > n) hi = n;
        if (lo >= hi) continue;
        {
            char[:] bytes = rtx_doc_analysis_span(d, lo, hi - lo) !>(e) {
                return cc_err(e);
            };
            rtx_hl_range(d, bytes.ptr, lo, bytes.len, lo, NULL,
                         RTX_TM_CATCHUP) !>(e) {
                return cc_err(e);
            };
        }
    }
    for (s = 0; s < d->sec_len; s++) {
        if (d->secs[s].kind == RTX_SEC_CODE) d->secs[s].hl_done = 1;
    }
    return cc_ok();
}

#endif /* RTX_HIGHLIGHT_H */
