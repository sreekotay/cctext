/*
 * Syntax highlight for code sections. Spike lexer: C / Concurrent-C keywords,
 * strings, comments, numbers. Produces RtxRun entries with .style.hl set.
 * Frontends map hl → color (ANSI or GPU). Not tree-sitter; replace later.
 */
#ifndef RTX_HIGHLIGHT_H
#define RTX_HIGHLIGHT_H

static int rtx_hl_ident_start(char c) {
    return (c >= 'A' && c <= 'Z') || (c >= 'a' && c <= 'z') || c == '_';
}

static int rtx_hl_ident(char c) {
    return rtx_hl_ident_start(c) || (c >= '0' && c <= '9');
}

static int rtx_hl_is_keyword(const char *s, size_t n) {
    static const char *kws[] = {
        "int", "void", "return", "if", "else", "for", "while", "do",
        "struct", "typedef", "static", "const", "char", "size_t",
        "unsigned", "long", "short", "enum", "union", "sizeof",
        "break", "continue", "switch", "case", "default", "goto",
        "extern", "inline", "bool", "true", "false", "NULL",
        "include", "define", "ifdef", "ifndef", "endif", "pragma",
        NULL
    };
    size_t i;
    for (i = 0; kws[i]; i++) {
        if (strlen(kws[i]) == n && memcmp(s, kws[i], n) == 0) return 1;
    }
    return 0;
}

static void rtx_hl_add(RtxDoc *d, size_t start, size_t len, RtxHlKind hl) {
    RtxStyle st = {0};
    if (!d || len == 0 || hl == RTX_HL_NONE) return;
    st.hl = hl;
    rtx_doc_add_run(d, start, len, st);
}

static void rtx_hl_range(RtxDoc *d, const char *buf, size_t base, size_t n) {
    size_t i = 0;
    if (!d || !buf || n == 0) return;
    while (i < n) {
        char c = buf[i];
        if (c == '/' && i + 1 < n && buf[i + 1] == '/') {
            size_t j = i + 2;
            while (j < n && buf[j] != '\n') j++;
            rtx_hl_add(d, base + i, j - i, RTX_HL_COMMENT);
            i = j;
        } else if (c == '/' && i + 1 < n && buf[i + 1] == '*') {
            size_t j = i + 2;
            while (j + 1 < n && !(buf[j] == '*' && buf[j + 1] == '/')) j++;
            if (j + 1 < n) j += 2;
            else j = n;
            rtx_hl_add(d, base + i, j - i, RTX_HL_COMMENT);
            i = j;
        } else if (c == '"') {
            size_t j = i + 1;
            while (j < n && buf[j] != '"') {
                if (buf[j] == '\\' && j + 1 < n) j += 2;
                else j++;
            }
            if (j < n) j++;
            rtx_hl_add(d, base + i, j - i, RTX_HL_STRING);
            i = j;
        } else if (c == '\'') {
            size_t j = i + 1;
            while (j < n && buf[j] != '\'') {
                if (buf[j] == '\\' && j + 1 < n) j += 2;
                else j++;
            }
            if (j < n) j++;
            rtx_hl_add(d, base + i, j - i, RTX_HL_STRING);
            i = j;
        } else if (c >= '0' && c <= '9') {
            size_t j = i + 1;
            while (j < n && ((buf[j] >= '0' && buf[j] <= '9') || buf[j] == 'x' ||
                             (buf[j] >= 'a' && buf[j] <= 'f') ||
                             (buf[j] >= 'A' && buf[j] <= 'F'))) {
                j++;
            }
            rtx_hl_add(d, base + i, j - i, RTX_HL_NUMBER);
            i = j;
        } else if (rtx_hl_ident_start(c)) {
            size_t j = i + 1;
            while (j < n && rtx_hl_ident(buf[j])) j++;
            if (rtx_hl_is_keyword(buf + i, j - i)) {
                rtx_hl_add(d, base + i, j - i, RTX_HL_KEYWORD);
            }
            i = j;
        } else {
            i++;
        }
    }
}

static void rtx_doc_highlight(RtxDoc *d) {
    size_t n;
    char *buf;
    size_t s;
    if (!d) return;
    n = rtx_piece_tree_len(&d->tree);
    if (n == 0) return;
    buf = (char *)malloc(n);
    if (!buf) return;
    rtx_piece_tree_read(&d->tree, 0, buf, n);
    for (s = 0; s < d->sec_len; s++) {
        size_t lo = d->secs[s].start;
        size_t hi = (s + 1 < d->sec_len) ? d->secs[s + 1].start : n;
        if (d->secs[s].kind != RTX_SEC_CODE) continue;
        if (hi > n) hi = n;
        if (lo >= hi) continue;
        rtx_hl_range(d, buf + lo, lo, hi - lo);
    }
    free(buf);
}

#endif /* RTX_HIGHLIGHT_H */
