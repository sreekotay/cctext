static int rtx_utf8_combining(uint32_t cp) {
    int n = (int)(sizeof(rtx_utf8_combining_tab) / sizeof(rtx_utf8_combining_tab[0]) / 2);
    return rtx_utf8_bisearch(cp, rtx_utf8_combining_tab, n);
}

static int rtx_utf8_cp_width(uint32_t cp) {
    if (cp == 0) return 0;
    if (cp < 32 || (cp >= 0x7F && cp < 0xA0)) return 1;
    if (rtx_utf8_combining(cp)) return 0;
    if (cp == 0x200B || cp == 0x200C || cp == 0x200D ||
        cp == 0x2060 || cp == 0xFEFF) return 0;
    if (cp >= 0x1100 && cp <= 0x115F) return 2;
    if (cp == 0x2329 || cp == 0x232A) return 2;
    if (cp >= 0x2E80 && cp <= 0xA4CF && cp != 0x303F) return 2;
    if (cp >= 0xAC00 && cp <= 0xD7A3) return 2;
    if (cp >= 0xF900 && cp <= 0xFAFF) return 2;
    if (cp >= 0xFE10 && cp <= 0xFE19) return 2;
    if (cp >= 0xFE30 && cp <= 0xFE6F) return 2;
    if (cp >= 0xFF00 && cp <= 0xFF60) return 2;
    if (cp >= 0xFFE0 && cp <= 0xFFE6) return 2;
    if (cp >= 0x1F300 && cp <= 0x1F64F) return 2;
    if (cp >= 0x1F680 && cp <= 0x1F6FF) return 2;
    if (cp >= 0x1F900 && cp <= 0x1F9FF) return 2;
    if (cp >= 0x1FA70 && cp <= 0x1FAFF) return 2;
    if (cp >= 0x20000 && cp <= 0x3FFFD) return 2;
    return 1;
}

static int rtx_utf8_lead_len(unsigned char b) {
    if (b < 0x80) return 1;
    if (b >= 0xC2 && b <= 0xDF) return 2;
    if (b >= 0xE0 && b <= 0xEF) return 3;
    if (b >= 0xF0 && b <= 0xF4) return 4;
    return 0;
}

/* Returns bytes consumed, or 0 if the sequence at p is invalid. */
static int rtx_utf8_decode(const char *p, size_t n, uint32_t *cp) {
    unsigned char b0, b1, b2, b3;
    uint32_t u;
    if (!p || n == 0) return 0;
    b0 = (unsigned char)p[0];
    if (b0 < 0x80) {
        if (cp) *cp = b0;
        return 1;
    }
    if (b0 >= 0xC2 && b0 <= 0xDF) {
        if (n < 2) return 0;
        b1 = (unsigned char)p[1];
        if ((b1 & 0xC0) != 0x80) return 0;
        u = ((uint32_t)(b0 & 0x1F) << 6) | (uint32_t)(b1 & 0x3F);
        if (u < 0x80) return 0;
        if (cp) *cp = u;
        return 2;
    }
    if (b0 >= 0xE0 && b0 <= 0xEF) {
        if (n < 3) return 0;
        b1 = (unsigned char)p[1];
        b2 = (unsigned char)p[2];
        if ((b1 & 0xC0) != 0x80 || (b2 & 0xC0) != 0x80) return 0;
        if (b0 == 0xE0 && b1 < 0xA0) return 0;
        if (b0 == 0xED && b1 >= 0xA0) return 0;
        u = ((uint32_t)(b0 & 0x0F) << 12) |
            ((uint32_t)(b1 & 0x3F) << 6) |
            (uint32_t)(b2 & 0x3F);
        if (u < 0x800) return 0;
        if (cp) *cp = u;
        return 3;
    }
    if (b0 >= 0xF0 && b0 <= 0xF4) {
        if (n < 4) return 0;
        b1 = (unsigned char)p[1];
        b2 = (unsigned char)p[2];
        b3 = (unsigned char)p[3];
        if ((b1 & 0xC0) != 0x80 || (b2 & 0xC0) != 0x80 || (b3 & 0xC0) != 0x80) {
            return 0;
        }
        if (b0 == 0xF0 && b1 < 0x90) return 0;
        if (b0 == 0xF4 && b1 >= 0x90) return 0;
        u = ((uint32_t)(b0 & 0x07) << 18) |
            ((uint32_t)(b1 & 0x3F) << 12) |
            ((uint32_t)(b2 & 0x3F) << 6) |
            (uint32_t)(b3 & 0x3F);
        if (u < 0x10000 || u > 0x10FFFF) return 0;
        if (cp) *cp = u;
        return 4;
    }
    return 0;
}

static int rtx_utf8_encode(uint32_t cp, char out[4]) {
    if (!out) return 0;
    if (cp < 0x80) {
        out[0] = (char)cp;
        return 1;
    }
    if (cp < 0x800) {
        out[0] = (char)(0xC0 | (cp >> 6));
        out[1] = (char)(0x80 | (cp & 0x3F));
        return 2;
    }
    if (cp >= 0xD800 && cp <= 0xDFFF) return 0;
    if (cp < 0x10000) {
        out[0] = (char)(0xE0 | (cp >> 12));
        out[1] = (char)(0x80 | ((cp >> 6) & 0x3F));
        out[2] = (char)(0x80 | (cp & 0x3F));
        return 3;
    }
    if (cp <= 0x10FFFF) {
        out[0] = (char)(0xF0 | (cp >> 18));
        out[1] = (char)(0x80 | ((cp >> 12) & 0x3F));
        out[2] = (char)(0x80 | ((cp >> 6) & 0x3F));
        out[3] = (char)(0x80 | (cp & 0x3F));
        return 4;
    }
    return 0;
}

static RtxUtf8Cl rtx_utf8_cluster(char[:] bytes, size_t i) {
    RtxUtf8Cl z;
    const char *p;
    size_t n, k;
    uint32_t cp;
    int nb;
    z.n = 0;
    z.cp = 0;
    z.cols = 0;
    if (!bytes.ptr || i >= bytes.len) return z;
    p = bytes.ptr;
    n = bytes.len;
    nb = rtx_utf8_decode(p + i, n - i, &cp);
    if (nb <= 0) {
        z.n = 1;
        z.cp = RTX_UTF8_FFFD;
        z.cols = 1;
        return z;
    }
    z.n = (size_t)nb;
    z.cp = cp;
    z.cols = rtx_utf8_cp_width(cp);
    k = i + z.n;
    while (k < n) {
        uint32_t cp2;
        int n2 = rtx_utf8_decode(p + k, n - k, &cp2);
        if (n2 <= 0 || !rtx_utf8_combining(cp2)) break;
        z.n += (size_t)n2;
        k += (size_t)n2;
    }
    if (z.cols <= 0) z.cols = 1;
    return z;
}

/* Text pane: never emit C0. CR homes a TTY, then [K wipes the row (hex
 * view is fine because it already substitutes). LF should not be in a
 * row; skip it too. Other C0/DEL become '.' like the hex dump. */
static int rtx_utf8_term_put(uint32_t cp, const char *raw, size_t raw_n,
                             char *out, size_t cap) {
    if (cp == '\r' || cp == '\n') return 0;
    if (cp < 0x20 || cp == 0x7F) {
        if (!out || cap < 1) return 0;
        out[0] = '.';
        return 1;
    }
    if (!raw || !out || raw_n == 0 || raw_n > cap) return 0;
    {
        char[:] dst = cc_slice_from_buffer(out, raw_n);
        char[:] src = cc_slice_from_buffer((void *)raw, raw_n);
        dst.copy(src) !>(e) { (void)e; return 0; };
    }
    return (int)raw_n;
}

static int rtx_utf8_term_cols(uint32_t cp, int raw_cols) {
    if (cp == '\r' || cp == '\n') return 0;
    if (cp < 0x20 || cp == 0x7F) return 1;
    return raw_cols;
}

static size_t rtx_utf8_align(char[:] bytes, size_t i) {
    size_t lo, k;
    if (!bytes.ptr) return 0;
    if (i > bytes.len) i = bytes.len;
    if (i == 0) return 0;
    lo = i > (size_t)RTX_UTF8_LOOK ? i - (size_t)RTX_UTF8_LOOK : 0;
    if (lo > 0) {
        while (lo < i && (((unsigned char)bytes.ptr[lo]) & 0xC0) == 0x80) lo++;
    }
    k = lo;
    while (k < i) {
        RtxUtf8Cl cl = rtx_utf8_cluster(bytes, k);
        size_t step = cl.n ? cl.n : 1;
        if (k + step > i) return k;
        k += step;
    }
    return k;
}

static size_t rtx_utf8_next(char[:] bytes, size_t i) {
    RtxUtf8Cl cl;
    if (!bytes.ptr) return 0;
    if (i >= bytes.len) return bytes.len;
    i = rtx_utf8_align(bytes, i);
    cl = rtx_utf8_cluster(bytes, i);
    if (cl.n == 0) return bytes.len;
    return i + cl.n;
}

static size_t rtx_utf8_prev(char[:] bytes, size_t i) {
    size_t a;
    if (!bytes.ptr || i == 0) return 0;
    if (i > bytes.len) i = bytes.len;
    a = rtx_utf8_align(bytes, i);
    if (a < i) return a;
    return rtx_utf8_align(bytes, a - 1);
}

static int rtx_utf8_cols(char[:] bytes) {
    size_t i = 0;
    int cols = 0;
    if (!bytes.ptr) return 0;
    while (i < bytes.len) {
        RtxUtf8Cl cl = rtx_utf8_cluster(bytes, i);
        size_t step = cl.n ? cl.n : 1;
        cols += cl.cols;
        i += step;
    }
    return cols;
}

/* Double-click classes. Clusters, not UAX #29 words. Non-ASCII that is
 * not whitespace counts as a word (CJK / letters without a table). */
static int rtx_utf8_space_cp(uint32_t cp) {
    if (cp == ' ' || cp == '\t' || cp == '\n' || cp == '\r') return 1;
    if (cp == 0x00A0 || cp == 0x1680 || (cp >= 0x2000 && cp <= 0x200A)) return 1;
    if (cp == 0x2028 || cp == 0x2029 || cp == 0x202F || cp == 0x205F ||
        cp == 0x3000)
        return 1;
    return 0;
}

static int rtx_utf8_word_cp(uint32_t cp) {
    if (cp == '_') return 1;
    if (cp < 0x80)
        return (cp >= '0' && cp <= '9') || (cp >= 'A' && cp <= 'Z') ||
               (cp >= 'a' && cp <= 'z');
    if (cp < 0xA0) return 0;
    return !rtx_utf8_space_cp(cp);
}

enum { RTX_CLICK_WORD = 1, RTX_CLICK_SPACE = 2, RTX_CLICK_PUNCT = 3 };

static int rtx_utf8_click_class(uint32_t cp) {
    if (rtx_utf8_space_cp(cp)) return RTX_CLICK_SPACE;
    if (rtx_utf8_word_cp(cp)) return RTX_CLICK_WORD;
    return RTX_CLICK_PUNCT;
}

static int rtx_utf8_prefix_cols(char[:] bytes, size_t n) {
    size_t i = 0;
    int cols = 0;
    if (!bytes.ptr) return 0;
    if (n > bytes.len) n = bytes.len;
    while (i < n) {
        RtxUtf8Cl cl = rtx_utf8_cluster(bytes, i);
        size_t step = cl.n ? cl.n : 1;
        if (i + step > n) break;
        cols += cl.cols;
        i += step;
    }
    return cols;
}

/* Display column → byte. Lands on the nearer cluster edge. */
static size_t rtx_utf8_hit_col(char[:] bytes, int col) {
    size_t i = 0;
    int x = 0;
    if (!bytes.ptr || col <= 0) return 0;
    while (i < bytes.len) {
        RtxUtf8Cl cl = rtx_utf8_cluster(bytes, i);
        size_t step = cl.n ? cl.n : 1;
        int next = x + cl.cols;
        if (col <= x + cl.cols / 2) return i;
        if (col <= next) return i + step;
        x = next;
        i += step;
    }
    return bytes.len;
}

static int rtx_utf8_append(char *buf, size_t *len, size_t cap, uint32_t cp) {
    char tmp[4];
    int n;
    if (!buf || !len) return 0;
    n = rtx_utf8_encode(cp, tmp);
    if (n <= 0) return 0;
    if (*len + (size_t)n >= cap) return 0;
    {
        char[:] dst = cc_slice_from_buffer(buf + *len, (size_t)n);
        char[:] src = cc_slice_from_buffer(tmp, (size_t)n);
        dst.copy(src) !>(e) { (void)e; return 0; };
    }
    *len += (size_t)n;
    buf[*len] = 0;
    return n;
}

/* One-line prompt (find / glob). Bytes; motion is clusters. */
typedef struct {
    char *buf;
    size_t *len;
    size_t cap;
    size_t *caret;
    size_t *sel;
} RtxField;

static char[:] rtx_field_bytes(RtxField f) {
    if (f.buf && f.len)
        return cc_slice_from_buffer(f.buf, *f.len);
    return cc_slice_empty();
}

static void rtx_field_clamp(RtxField f) {
    size_t n;
    char[:] bytes;
    if (!f.len || !f.caret || !f.sel) return;
    n = *f.len;
    if (*f.caret > n) *f.caret = n;
    if (*f.sel > n) *f.sel = n;
    bytes = rtx_field_bytes(f);
    *f.caret = rtx_utf8_align(bytes, *f.caret);
    *f.sel = rtx_utf8_align(bytes, *f.sel);
}

static int rtx_field_has_sel(RtxField f) {
    return f.caret && f.sel && *f.caret != *f.sel;
}

static size_t rtx_field_lo(RtxField f) {
    if (!f.caret || !f.sel) return 0;
    return *f.caret < *f.sel ? *f.caret : *f.sel;
}

static size_t rtx_field_hi(RtxField f) {
    if (!f.caret || !f.sel) return 0;
    return *f.caret > *f.sel ? *f.caret : *f.sel;
}

static char[:] rtx_field_sel_bytes(RtxField f) {
    size_t lo, hi;
    if (!f.buf || !rtx_field_has_sel(f)) return cc_slice_empty();
    lo = rtx_field_lo(f);
    hi = rtx_field_hi(f);
    return cc_slice_from_buffer(f.buf + lo, hi - lo);
}

static void rtx_field_collapse(RtxField f) {
    if (!f.caret || !f.sel) return;
    rtx_field_clamp(f);
    *f.sel = *f.caret;
}

static void rtx_field_select_all(RtxField f) {
    if (!f.len || !f.caret || !f.sel) return;
    *f.sel = 0;
    *f.caret = *f.len;
}

static int rtx_field_delete_sel(RtxField f) {
    size_t lo, hi, n;
    if (!f.buf || !f.len || !rtx_field_has_sel(f)) return 0;
    lo = rtx_field_lo(f);
    hi = rtx_field_hi(f);
    n = *f.len;
    if (hi > n) hi = n;
    if (lo >= hi) return 0;
    if (hi < n) {
        char[:] dst = cc_slice_from_buffer(f.buf + lo, n - hi);
        char[:] src = cc_slice_from_buffer(f.buf + hi, n - hi);
        dst.copy_overlap(src) !>(e) { (void)e; return 0; };
    }
    *f.len = lo + (n - hi);
    f.buf[*f.len] = 0;
    *f.caret = lo;
    *f.sel = lo;
    return 1;
}

static void rtx_field_move(RtxField f, int dir, int shift) {
    char[:] bytes;
    if (!f.caret || !f.sel || !f.len) return;
    rtx_field_clamp(f);
    bytes = rtx_field_bytes(f);
    if (dir < 0) *f.caret = rtx_utf8_prev(bytes, *f.caret);
    else *f.caret = rtx_utf8_next(bytes, *f.caret);
    if (!shift) *f.sel = *f.caret;
}

static void rtx_field_edge(RtxField f, int to_end, int shift) {
    if (!f.caret || !f.sel || !f.len) return;
    *f.caret = to_end ? *f.len : 0;
    if (!shift) *f.sel = *f.caret;
}

static void rtx_field_click(RtxField f, int col, int shift, int drag) {
    size_t at;
    if (!f.caret || !f.sel) return;
    at = rtx_utf8_hit_col(rtx_field_bytes(f), col);
    *f.caret = at;
    if (!drag && !shift) *f.sel = at;
}

static void rtx_field_backspace(RtxField f) {
    size_t prev, n;
    if (!f.buf || !f.len || !f.caret || !f.sel) return;
    if (rtx_field_delete_sel(f)) return;
    rtx_field_clamp(f);
    if (*f.caret == 0) return;
    n = *f.len;
    prev = rtx_utf8_prev(rtx_field_bytes(f), *f.caret);
    if (prev >= *f.caret) return;
    if (*f.caret < n) {
        char[:] dst = cc_slice_from_buffer(f.buf + prev, n - *f.caret);
        char[:] src = cc_slice_from_buffer(f.buf + *f.caret, n - *f.caret);
        dst.copy_overlap(src) !>(e) { return; };
    }
    *f.len = prev + (n - *f.caret);
    f.buf[*f.len] = 0;
    *f.caret = prev;
    *f.sel = prev;
}

static void rtx_field_delete(RtxField f) {
    size_t next, n;
    if (!f.buf || !f.len || !f.caret || !f.sel) return;
    if (rtx_field_delete_sel(f)) return;
    rtx_field_clamp(f);
    n = *f.len;
    if (*f.caret >= n) return;
    next = rtx_utf8_next(rtx_field_bytes(f), *f.caret);
    if (next <= *f.caret) return;
    if (next < n) {
        char[:] dst = cc_slice_from_buffer(f.buf + *f.caret, n - next);
        char[:] src = cc_slice_from_buffer(f.buf + next, n - next);
        dst.copy_overlap(src) !>(e) { return; };
    }
    *f.len = *f.caret + (n - next);
    f.buf[*f.len] = 0;
    *f.sel = *f.caret;
}

static size_t rtx_field_sanitize(const char *src, size_t n, char *dst, size_t cap) {
    size_t i, o = 0;
    if (!dst || cap == 0) return 0;
    for (i = 0; i < n && o + 1 < cap; i++) {
        unsigned char c = (unsigned char)src[i];
        if (c == '\t' || c == '\n' || c == '\r') c = ' ';
        else if (c < 32) continue;
        dst[o++] = (char)c;
    }
    return o;
}

static int rtx_field_insert(RtxField f, const char *p, size_t n) {
    char tmp[256];
    size_t sn, room, caret, rest;
    if (!f.buf || !f.len || !f.caret || !f.sel || f.cap < 2) return 0;
    rtx_field_delete_sel(f);
    rtx_field_clamp(f);
    sn = rtx_field_sanitize(p, n, tmp, sizeof(tmp));
    room = f.cap - 1;
    if (*f.len >= room) return 0;
    room -= *f.len;
    if (sn > room) sn = room;
    if (sn == 0) return 0;
    caret = *f.caret;
    rest = *f.len - caret;
    if (rest) {
        char[:] dst = cc_slice_from_buffer(f.buf + caret + sn, rest);
        char[:] src = cc_slice_from_buffer(f.buf + caret, rest);
        dst.copy_overlap(src) !>(e) { (void)e; return 0; };
    }
    {
        char[:] dst = cc_slice_from_buffer(f.buf + caret, sn);
        char[:] src = cc_slice_from_buffer(tmp, sn);
        dst.copy(src) !>(e) { (void)e; return 0; };
    }
    *f.len += sn;
    f.buf[*f.len] = 0;
    *f.caret = caret + sn;
    *f.sel = *f.caret;
    return 1;
}

static int rtx_field_type_cp(RtxField f, uint32_t cp) {
    char tmp[4];
    int n;
    if (cp < 32 || cp == 127) return 0;
    n = rtx_utf8_encode(cp, tmp);
    if (n <= 0) return 0;
    return rtx_field_insert(f, tmp, (size_t)n);
}

#endif /* RTX_UTF8_H */
