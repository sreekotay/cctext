#!ccc cch
/*
 * UTF-8 navigation / display-width chapter of the document TU.
 * Offsets stay bytes. A cluster is a scalar plus following combining
 * marks and variation selectors — not full UAX #29 (no ZWJ / flags).
 * Invalid bytes are one-byte clusters (U+FFFD, width 1). Hex motion
 * stays bytes; the dump column decodes with these helpers.
 */
#ifndef RTX_UTF8_H
#define RTX_UTF8_H

#include <stdint.h>
#include <stddef.h>

#define RTX_UTF8_FFFD 0xFFFDu
#define RTX_UTF8_LOOK 64

typedef struct {
    size_t n;      /* bytes in the cluster; 0 if i is past the end */
    uint32_t cp;   /* first scalar (U+FFFD if the first byte is invalid) */
    int cols;      /* terminal / layout columns (>= 1 unless n == 0) */
} RtxUtf8Cl;

static int rtx_utf8_bisearch(uint32_t cp, const uint32_t *lohi, int npairs) {
    int lo = 0;
    int hi = npairs - 1;
    if (npairs < 1 || cp < lohi[0] || cp > lohi[npairs * 2 - 1]) return 0;
    while (lo <= hi) {
        int mid = (lo + hi) / 2;
        uint32_t a = lohi[mid * 2];
        uint32_t b = lohi[mid * 2 + 1];
        if (cp < a) hi = mid - 1;
        else if (cp > b) lo = mid + 1;
        else return 1;
    }
    return 0;
}

