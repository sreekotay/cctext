#!ccc cch
/*
 * UTF-8 navigation / display-width chapter of the document TU.
 * Offsets stay bytes. A cluster is a UAX #29 extended grapheme cluster
 * (GB3–GB13, including ZWJ emoji, RI flags, Hangul, Indic GB9c).
 * Invalid bytes are one-byte clusters (U+FFFD, width 1). Hex motion
 * stays bytes; the dump column decodes with these helpers.
 */
#ifndef RTX_UTF8_H
#define RTX_UTF8_H

#include <stdint.h>
#include <stddef.h>
#include "unicode/utf8_break_tab.cch"

#define RTX_UTF8_FFFD 0xFFFDu
#define RTX_UTF8_LOOK 128

typedef struct {
    size_t n;      /* bytes in the cluster; 0 if i is past the end */
    uint32_t cp;   /* first scalar (U+FFFD if the first byte is invalid) */
    int cols;      /* terminal / layout columns (>= 1 unless n == 0) */
} RtxUtf8Cl;

int rtx_utf8_bisearch(uint32_t cp, const uint32_t *lohi, int npairs) {
    int lo = 0;
    int hi = npairs - 1;
    if (npairs < 1 || cp < lohi[0] || cp > lohi[npairs * 2 - 1]) return 0;
    while (lo <= hi) {
        int mid = (lo + hi) / 2;
        uint32_t a = lohi[mid * 2];
        uint32_t b = lohi[mid * 2 + 1];
        if (cp < a) hi = mid - 1;
        else if (cp > b) lo = mid + 1;
        else return 1;
    }
    return 0;
}

uint8_t rtx_utf8_ucd(uint32_t cp) {
    int lo = 0;
    int hi = RTX_UTF8_GCB_N - 1;
    if (cp > 0x10FFFFu) return 0;
    while (lo < hi) {
        int mid = (lo + hi + 1) / 2;
        if (rtx_utf8_gcb_start[mid] <= cp) lo = mid;
        else hi = mid - 1;
    }
    return rtx_utf8_gcb_prop[lo];
}

int rtx_utf8_combining(uint32_t cp) {
    int g = (int)(rtx_utf8_ucd(cp) & 0x0Fu);
    return g == RTX_GCB_EXTEND || g == RTX_GCB_ZWJ;
}

int rtx_utf8_cp_width(uint32_t cp) {
    if (cp == 0) return 0;
    if (cp < 32 || (cp >= 0x7F && cp < 0xA0)) return 1;
    if (rtx_utf8_combining(cp)) return 0;
    if (cp == 0x200B || cp == 0x2060 || cp == 0xFEFF) return 0;
    if (cp >= 0x1100 && cp <= 0x115F) return 2;
    if (cp == 0x2329 || cp == 0x232A) return 2;
    if (cp >= 0x2E80 && cp <= 0xA4CF && cp != 0x303F) return 2;
    if (cp >= 0xAC00 && cp <= 0xD7A3) return 2;
    if (cp >= 0xF900 && cp <= 0xFAFF) return 2;
    if (cp >= 0xFE10 && cp <= 0xFE19) return 2;
    if (cp >= 0xFE30 && cp <= 0xFE6F) return 2;
    if (cp >= 0xFF00 && cp <= 0xFF60) return 2;
    if (cp >= 0xFFE0 && cp <= 0xFFE6) return 2;
    if (cp >= 0x1F300 && cp <= 0x1F64F) return 2;
    if (cp >= 0x1F680 && cp <= 0x1F6FF) return 2;
    if (cp >= 0x1F900 && cp <= 0x1F9FF) return 2;
    if (cp >= 0x1FA70 && cp <= 0x1FAFF) return 2;
    if (cp >= 0x20000 && cp <= 0x3FFFD) return 2;
    return 1;
}

int rtx_utf8_lead_len(unsigned char b) {
    if (b < 0x80) return 1;
    if (b >= 0xC2 && b <= 0xDF) return 2;
    if (b >= 0xE0 && b <= 0xEF) return 3;
    if (b >= 0xF0 && b <= 0xF4) return 4;
    return 0;
}

/* Returns bytes consumed, or 0 if the sequence at p is invalid. */
int rtx_utf8_decode(const char *p, size_t n, uint32_t *cp) {
    unsigned char b0, b1, b2, b3;
    uint32_t u;
    if (!p || n == 0) return 0;
    b0 = (unsigned char)p[0];
    if (b0 < 0x80) {
        if (cp) *cp = b0;
        return 1;
    }
    if (b0 >= 0xC2 && b0 <= 0xDF) {
        if (n < 2) return 0;
        b1 = (unsigned char)p[1];
        if ((b1 & 0xC0) != 0x80) return 0;
        u = ((uint32_t)(b0 & 0x1F) << 6) | (uint32_t)(b1 & 0x3F);
        if (u < 0x80) return 0;
        if (cp) *cp = u;
        return 2;
    }
    if (b0 >= 0xE0 && b0 <= 0xEF) {
        if (n < 3) return 0;
        b1 = (unsigned char)p[1];
        b2 = (unsigned char)p[2];
        if ((b1 & 0xC0) != 0x80 || (b2 & 0xC0) != 0x80) return 0;
        if (b0 == 0xE0 && b1 < 0xA0) return 0;
        if (b0 == 0xED && b1 >= 0xA0) return 0;
        u = ((uint32_t)(b0 & 0x0F) << 12) |
            ((uint32_t)(b1 & 0x3F) << 6) |
            (uint32_t)(b2 & 0x3F);
        if (u < 0x800) return 0;
        if (cp) *cp = u;
        return 3;
    }
    if (b0 >= 0xF0 && b0 <= 0xF4) {
        if (n < 4) return 0;
        b1 = (unsigned char)p[1];
        b2 = (unsigned char)p[2];
        b3 = (unsigned char)p[3];
        if ((b1 & 0xC0) != 0x80 || (b2 & 0xC0) != 0x80 || (b3 & 0xC0) != 0x80) {
            return 0;
        }
        if (b0 == 0xF0 && b1 < 0x90) return 0;
        if (b0 == 0xF4 && b1 >= 0x90) return 0;
        u = ((uint32_t)(b0 & 0x07) << 18) |
            ((uint32_t)(b1 & 0x3F) << 12) |
            ((uint32_t)(b2 & 0x3F) << 6) |
            (uint32_t)(b3 & 0x3F);
        if (u < 0x10000 || u > 0x10FFFF) return 0;
        if (cp) *cp = u;
        return 4;
    }
    return 0;
}

int rtx_utf8_encode(uint32_t cp, char out[4]) {
    if (!out) return 0;
    if (cp < 0x80) {
        out[0] = (char)cp;
        return 1;
    }
    if (cp < 0x800) {
        out[0] = (char)(0xC0 | (cp >> 6));
        out[1] = (char)(0x80 | (cp & 0x3F));
        return 2;
    }
    if (cp >= 0xD800 && cp <= 0xDFFF) return 0;
    if (cp < 0x10000) {
        out[0] = (char)(0xE0 | (cp >> 12));
        out[1] = (char)(0x80 | ((cp >> 6) & 0x3F));
        out[2] = (char)(0x80 | (cp & 0x3F));
        return 3;
    }
    if (cp <= 0x10FFFF) {
        out[0] = (char)(0xF0 | (cp >> 18));
        out[1] = (char)(0x80 | ((cp >> 12) & 0x3F));
        out[2] = (char)(0x80 | ((cp >> 6) & 0x3F));
        out[3] = (char)(0x80 | (cp & 0x3F));
        return 4;
    }
    return 0;
}

typedef struct {
    uint8_t gcb;
    uint8_t ri_odd;
    uint8_t emoji; /* 0 none, 1 EP Extend*, 2 EP Extend* ZWJ */
    uint8_t incb;  /* 0 none, 1 consonant, 2 linker seen */
} RtxGcbSt;

static void rtx_gcb_feed(RtxGcbSt *s, uint8_t p) {
    int g = (int)(p & 0x0Fu);
    int ic = (int)((p >> RTX_INCB_SHIFT) & 3u);
    int ep = (p & RTX_UCD_EP) != 0;
    if (g == RTX_GCB_RI) s->ri_odd = s->ri_odd ? 0 : 1;
    else s->ri_odd = 0;
    if (ep) s->emoji = 1;
    else if (g == RTX_GCB_EXTEND && s->emoji == 1) s->emoji = 1;
    else if (g == RTX_GCB_ZWJ && s->emoji == 1) s->emoji = 2;
    else s->emoji = 0;
    if (ic == RTX_INCB_CONSONANT) s->incb = 1;
    else if (s->incb == 1 && ic == RTX_INCB_LINKER) s->incb = 2;
    else if (s->incb == 1 && ic == RTX_INCB_EXTEND) s->incb = 1;
    else if (s->incb == 2 &&
             (ic == RTX_INCB_EXTEND || ic == RTX_INCB_LINKER))
        s->incb = 2;
    else s->incb = 0;
    s->gcb = (uint8_t)g;
}

static int rtx_gcb_break(const RtxGcbSt *s, uint8_t p) {
    int prev = s->gcb;
    int curr = (int)(p & 0x0Fu);
    /* GB3 */
    if (prev == RTX_GCB_CR && curr == RTX_GCB_LF) return 0;
    /* GB4 */
    if (prev == RTX_GCB_CR || prev == RTX_GCB_LF || prev == RTX_GCB_CONTROL)
        return 1;
    /* GB5 */
    if (curr == RTX_GCB_CR || curr == RTX_GCB_LF || curr == RTX_GCB_CONTROL)
        return 1;
    /* GB6 */
    if (prev == RTX_GCB_L &&
        (curr == RTX_GCB_L || curr == RTX_GCB_V || curr == RTX_GCB_LV ||
         curr == RTX_GCB_LVT))
        return 0;
    /* GB7 */
    if ((prev == RTX_GCB_LV || prev == RTX_GCB_V) &&
        (curr == RTX_GCB_V || curr == RTX_GCB_T))
        return 0;
    /* GB8 */
    if ((prev == RTX_GCB_LVT || prev == RTX_GCB_T) && curr == RTX_GCB_T)
        return 0;
    /* GB9 */
    if (curr == RTX_GCB_EXTEND || curr == RTX_GCB_ZWJ) return 0;
    /* GB9a */
    if (curr == RTX_GCB_SPACINGMARK) return 0;
    /* GB9b */
    if (prev == RTX_GCB_PREPEND) return 0;
    /* GB9c */
    if (s->incb == 2 &&
        ((int)((p >> RTX_INCB_SHIFT) & 3u) == RTX_INCB_CONSONANT))
        return 0;
    /* GB11 */
    if (s->emoji == 2 && (p & RTX_UCD_EP)) return 0;
    /* GB12 / GB13 */
    if (prev == RTX_GCB_RI && curr == RTX_GCB_RI && s->ri_odd) return 0;
    /* GB999 */
    return 1;
}

RtxUtf8Cl rtx_utf8_cluster(char[:] bytes, size_t i) {
    RtxUtf8Cl z;
    RtxGcbSt st;
    const char *p;
    size_t n, k;
    uint32_t cp;
    uint8_t prop;
    int nb, ri_n, saw_vs16, saw_zwj_ep;
    z.n = 0;
    z.cp = 0;
    z.cols = 0;
    if (!bytes.ptr || i >= bytes.len) return z;
    p = bytes.ptr;
    n = bytes.len;
    nb = rtx_utf8_decode(p + i, n - i, &cp);
    if (nb <= 0) {
        z.n = 1;
        z.cp = RTX_UTF8_FFFD;
        z.cols = 1;
        return z;
    }
    z.n = (size_t)nb;
    z.cp = cp;
    z.cols = rtx_utf8_cp_width(cp);
    prop = rtx_utf8_ucd(cp);
    st.gcb = 0;
    st.ri_odd = 0;
    st.emoji = 0;
    st.incb = 0;
    rtx_gcb_feed(&st, prop);
    ri_n = ((prop & 0x0Fu) == RTX_GCB_RI) ? 1 : 0;
    saw_vs16 = (cp == 0xFE0Fu) ? 1 : 0;
    saw_zwj_ep = 0;
    k = i + z.n;
    while (k < n) {
        uint32_t cp2;
        uint8_t p2;
        int n2 = rtx_utf8_decode(p + k, n - k, &cp2);
        if (n2 <= 0) break;
        p2 = rtx_utf8_ucd(cp2);
        if (rtx_gcb_break(&st, p2)) break;
        if (st.emoji == 2 && (p2 & RTX_UCD_EP)) saw_zwj_ep = 1;
        if ((p2 & 0x0Fu) == RTX_GCB_RI) ri_n++;
        if (cp2 == 0xFE0Fu) saw_vs16 = 1;
        z.n += (size_t)n2;
        k += (size_t)n2;
        rtx_gcb_feed(&st, p2);
    }
    if (ri_n >= 2) z.cols = 2;
    else if (saw_zwj_ep) z.cols = 2;
    else if (saw_vs16) z.cols = 2;
    if (z.cols <= 0) z.cols = 1;
    return z;
}

/* Text pane: never emit C0. CR homes a TTY, then [K wipes the row (hex
 * view is fine because it already substitutes). LF should not be in a
 * row; skip it too. Other C0/DEL become '.' like the hex dump. */
int rtx_utf8_term_put(uint32_t cp, const char *raw, size_t raw_n,
                             char *out, size_t cap) {
    if (cp == '\r' || cp == '\n') return 0;
    if (cp < 0x20 || cp == 0x7F) {
        if (!out || cap < 1) return 0;
        out[0] = '.';
        return 1;
    }
    if (!raw || !out || raw_n == 0 || raw_n > cap) return 0;
    {
        char[:] dst = cc_slice_from_buffer(out, raw_n);
        char[:] src = cc_slice_from_buffer((void *)raw, raw_n);
        dst.copy(src) !>(e) { (void)e; return 0; };
    }
    return (int)raw_n;
}

int rtx_utf8_term_cols(uint32_t cp, int raw_cols) {
    if (cp == '\r' || cp == '\n') return 0;
    if (cp < 0x20 || cp == 0x7F) return 1;
    return raw_cols;
}

size_t rtx_utf8_align(char[:] bytes, size_t i) {
    size_t lo, k;
    if (!bytes.ptr) return 0;
    if (i > bytes.len) i = bytes.len;
    if (i == 0) return 0;
    lo = i > (size_t)RTX_UTF8_LOOK ? i - (size_t)RTX_UTF8_LOOK : 0;
    if (lo > 0) {
        while (lo < i && (((unsigned char)bytes.ptr[lo]) & 0xC0) == 0x80) lo++;
    }
    k = lo;
    while (k < i) {
        RtxUtf8Cl cl = rtx_utf8_cluster(bytes, k);
        size_t step = cl.n ? cl.n : 1;
        if (k + step > i) return k;
        k += step;
    }
    return k;
}

size_t rtx_utf8_next(char[:] bytes, size_t i) {
    RtxUtf8Cl cl;
    if (!bytes.ptr) return 0;
    if (i >= bytes.len) return bytes.len;
    i = rtx_utf8_align(bytes, i);
    cl = rtx_utf8_cluster(bytes, i);
    if (cl.n == 0) return bytes.len;
    return i + cl.n;
}

size_t rtx_utf8_prev(char[:] bytes, size_t i) {
    size_t a;
    if (!bytes.ptr || i == 0) return 0;
    if (i > bytes.len) i = bytes.len;
    a = rtx_utf8_align(bytes, i);
    if (a < i) return a;
    return rtx_utf8_align(bytes, a - 1);
}

int rtx_utf8_cols(char[:] bytes) {
    size_t i = 0;
    int cols = 0;
    if (!bytes.ptr) return 0;
    while (i < bytes.len) {
        RtxUtf8Cl cl = rtx_utf8_cluster(bytes, i);
        size_t step = cl.n ? cl.n : 1;
        cols += cl.cols;
        i += step;
    }
    return cols;
}

/* Double-click classes. Clusters, not UAX #29 words. Non-ASCII that is
 * not whitespace counts as a word (CJK / letters without a table). */
int rtx_utf8_space_cp(uint32_t cp) {
    if (cp == ' ' || cp == '\t' || cp == '\n' || cp == '\r') return 1;
    if (cp == 0x00A0 || cp == 0x1680 || (cp >= 0x2000 && cp <= 0x200A)) return 1;
    if (cp == 0x2028 || cp == 0x2029 || cp == 0x202F || cp == 0x205F ||
        cp == 0x3000)
        return 1;
    return 0;
}

int rtx_utf8_word_cp(uint32_t cp) {
    if (cp == '_') return 1;
    if (cp < 0x80)
        return (cp >= '0' && cp <= '9') || (cp >= 'A' && cp <= 'Z') ||
               (cp >= 'a' && cp <= 'z');
    if (cp < 0xA0) return 0;
    return !rtx_utf8_space_cp(cp);
}

enum { RTX_CLICK_WORD = 1, RTX_CLICK_SPACE = 2, RTX_CLICK_PUNCT = 3 };

int rtx_utf8_click_class(uint32_t cp) {
    if (rtx_utf8_space_cp(cp)) return RTX_CLICK_SPACE;
    if (rtx_utf8_word_cp(cp)) return RTX_CLICK_WORD;
    return RTX_CLICK_PUNCT;
}

int rtx_utf8_prefix_cols(char[:] bytes, size_t n) {
    size_t i = 0;
    int cols = 0;
    if (!bytes.ptr) return 0;
    if (n > bytes.len) n = bytes.len;
    while (i < n) {
        RtxUtf8Cl cl = rtx_utf8_cluster(bytes, i);
        size_t step = cl.n ? cl.n : 1;
        if (i + step > n) break;
        cols += cl.cols;
        i += step;
    }
    return cols;
}

/* Display column → byte. Lands on the nearer cluster edge. */
size_t rtx_utf8_hit_col(char[:] bytes, int col) {
    size_t i = 0;
    int x = 0;
    if (!bytes.ptr || col <= 0) return 0;
    while (i < bytes.len) {
        RtxUtf8Cl cl = rtx_utf8_cluster(bytes, i);
        size_t step = cl.n ? cl.n : 1;
        int next = x + cl.cols;
        if (col <= x + cl.cols / 2) return i;
        if (col <= next) return i + step;
        x = next;
        i += step;
    }
    return bytes.len;
}

int rtx_utf8_append(char *buf, size_t *len, size_t cap, uint32_t cp) {
    char tmp[4];
    int n;
    if (!buf || !len) return 0;
    n = rtx_utf8_encode(cp, tmp);
    if (n <= 0) return 0;
    if (*len + (size_t)n >= cap) return 0;
    {
        char[:] dst = cc_slice_from_buffer(buf + *len, (size_t)n);
        char[:] src = cc_slice_from_buffer(tmp, (size_t)n);
        dst.copy(src) !>(e) { (void)e; return 0; };
    }
    *len += (size_t)n;
    buf[*len] = 0;
    return n;
}

/* One-line prompt (find / glob). Bytes; motion is clusters. */
typedef struct {
    char *buf;
    size_t *len;
    size_t cap;
    size_t *caret;
    size_t *sel;
} RtxField;

char[:] rtx_field_bytes(RtxField f) {
    if (f.buf && f.len)
        return cc_slice_from_buffer(f.buf, *f.len);
    return cc_slice_empty();
}

void rtx_field_clamp(RtxField f) {
    size_t n;
    char[:] bytes;
    if (!f.len || !f.caret || !f.sel) return;
    n = *f.len;
    if (*f.caret > n) *f.caret = n;
    if (*f.sel > n) *f.sel = n;
    bytes = rtx_field_bytes(f);
    *f.caret = rtx_utf8_align(bytes, *f.caret);
    *f.sel = rtx_utf8_align(bytes, *f.sel);
}

int rtx_field_has_sel(RtxField f) {
    return f.caret && f.sel && *f.caret != *f.sel;
}

size_t rtx_field_lo(RtxField f) {
    if (!f.caret || !f.sel) return 0;
    return *f.caret < *f.sel ? *f.caret : *f.sel;
}

size_t rtx_field_hi(RtxField f) {
    if (!f.caret || !f.sel) return 0;
    return *f.caret > *f.sel ? *f.caret : *f.sel;
}

char[:] rtx_field_sel_bytes(RtxField f) {
    size_t lo, hi;
    if (!f.buf || !rtx_field_has_sel(f)) return cc_slice_empty();
    lo = rtx_field_lo(f);
    hi = rtx_field_hi(f);
    return cc_slice_from_buffer(f.buf + lo, hi - lo);
}

void rtx_field_collapse(RtxField f) {
    if (!f.caret || !f.sel) return;
    rtx_field_clamp(f);
    *f.sel = *f.caret;
}

void rtx_field_select_all(RtxField f) {
    if (!f.len || !f.caret || !f.sel) return;
    *f.sel = 0;
    *f.caret = *f.len;
}

int rtx_field_delete_sel(RtxField f) {
    size_t lo, hi, n;
    if (!f.buf || !f.len || !rtx_field_has_sel(f)) return 0;
    lo = rtx_field_lo(f);
    hi = rtx_field_hi(f);
    n = *f.len;
    if (hi > n) hi = n;
    if (lo >= hi) return 0;
    if (hi < n) {
        char[:] dst = cc_slice_from_buffer(f.buf + lo, n - hi);
        char[:] src = cc_slice_from_buffer(f.buf + hi, n - hi);
        dst.copy_overlap(src) !>(e) { (void)e; return 0; };
    }
    *f.len = lo + (n - hi);
    f.buf[*f.len] = 0;
    *f.caret = lo;
    *f.sel = lo;
    return 1;
}

void rtx_field_move(RtxField f, int dir, int shift) {
    char[:] bytes;
    if (!f.caret || !f.sel || !f.len) return;
    rtx_field_clamp(f);
    bytes = rtx_field_bytes(f);
    if (dir < 0) *f.caret = rtx_utf8_prev(bytes, *f.caret);
    else *f.caret = rtx_utf8_next(bytes, *f.caret);
    if (!shift) *f.sel = *f.caret;
}

void rtx_field_edge(RtxField f, int to_end, int shift) {
    if (!f.caret || !f.sel || !f.len) return;
    *f.caret = to_end ? *f.len : 0;
    if (!shift) *f.sel = *f.caret;
}

void rtx_field_click(RtxField f, int col, int shift, int drag) {
    size_t at;
    if (!f.caret || !f.sel) return;
    at = rtx_utf8_hit_col(rtx_field_bytes(f), col);
    *f.caret = at;
    if (!drag && !shift) *f.sel = at;
}

void rtx_field_backspace(RtxField f) {
    size_t prev, n;
    if (!f.buf || !f.len || !f.caret || !f.sel) return;
    if (rtx_field_delete_sel(f)) return;
    rtx_field_clamp(f);
    if (*f.caret == 0) return;
    n = *f.len;
    prev = rtx_utf8_prev(rtx_field_bytes(f), *f.caret);
    if (prev >= *f.caret) return;
    if (*f.caret < n) {
        char[:] dst = cc_slice_from_buffer(f.buf + prev, n - *f.caret);
        char[:] src = cc_slice_from_buffer(f.buf + *f.caret, n - *f.caret);
        dst.copy_overlap(src) !>(e) { return; };
    }
    *f.len = prev + (n - *f.caret);
    f.buf[*f.len] = 0;
    *f.caret = prev;
    *f.sel = prev;
}

void rtx_field_delete(RtxField f) {
    size_t next, n;
    if (!f.buf || !f.len || !f.caret || !f.sel) return;
    if (rtx_field_delete_sel(f)) return;
    rtx_field_clamp(f);
    n = *f.len;
    if (*f.caret >= n) return;
    next = rtx_utf8_next(rtx_field_bytes(f), *f.caret);
    if (next <= *f.caret) return;
    if (next < n) {
        char[:] dst = cc_slice_from_buffer(f.buf + *f.caret, n - next);
        char[:] src = cc_slice_from_buffer(f.buf + next, n - next);
        dst.copy_overlap(src) !>(e) { return; };
    }
    *f.len = *f.caret + (n - next);
    f.buf[*f.len] = 0;
    *f.sel = *f.caret;
}

size_t rtx_field_sanitize(const char *src, size_t n, char *dst, size_t cap) {
    size_t i, o = 0;
    if (!dst || cap == 0) return 0;
    for (i = 0; i < n && o + 1 < cap; i++) {
        unsigned char c = (unsigned char)src[i];
        if (c == '\t' || c == '\n' || c == '\r') c = ' ';
        else if (c < 32) continue;
        dst[o++] = (char)c;
    }
    return o;
}

int rtx_field_insert(RtxField f, const char *p, size_t n) {
    char tmp[256];
    size_t sn, room, caret, rest;
    if (!f.buf || !f.len || !f.caret || !f.sel || f.cap < 2) return 0;
    rtx_field_delete_sel(f);
    rtx_field_clamp(f);
    sn = rtx_field_sanitize(p, n, tmp, sizeof(tmp));
    room = f.cap - 1;
    if (*f.len >= room) return 0;
    room -= *f.len;
    if (sn > room) sn = room;
    if (sn == 0) return 0;
    caret = *f.caret;
    rest = *f.len - caret;
    if (rest) {
        char[:] dst = cc_slice_from_buffer(f.buf + caret + sn, rest);
        char[:] src = cc_slice_from_buffer(f.buf + caret, rest);
        dst.copy_overlap(src) !>(e) { (void)e; return 0; };
    }
    {
        char[:] dst = cc_slice_from_buffer(f.buf + caret, sn);
        char[:] src = cc_slice_from_buffer(tmp, sn);
        dst.copy(src) !>(e) { (void)e; return 0; };
    }
    *f.len += sn;
    f.buf[*f.len] = 0;
    *f.caret = caret + sn;
    *f.sel = *f.caret;
    return 1;
}

int rtx_field_type_cp(RtxField f, uint32_t cp) {
    char tmp[4];
    int n;
    if (cp < 32 || cp == 127) return 0;
    n = rtx_utf8_encode(cp, tmp);
    if (n <= 0) return 0;
    return rtx_field_insert(f, tmp, (size_t)n);
}

#endif /* RTX_UTF8_H */
