#!ccc ccs
/*
 * --batch command runner. Kick verbs that need coverage use await.
 */
#include <ccc/std/prelude.cch>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include "document.cch"
#include "workspace.cch"
#include "nav_pair.cch"
#include "batch.cch"

enum { RTX_BATCH_PRINT_DEFAULT = 40 };

static const char *rtx_batch_skip_ws(const char *s) {
    if (!s) return "";
    while (*s == ' ' || *s == '\t' || *s == '\r') s++;
    return s;
}

static int rtx_batch_word(const char *s, char *dst, size_t dstn, const char **rest) {
    size_t n = 0;
    s = rtx_batch_skip_ws(s);
    if (!dst || dstn == 0) return 0;
    while (*s && *s != ' ' && *s != '\t' && *s != '\r' && *s != '\n') {
        if (n + 1 >= dstn) return 0;
        dst[n++] = *s++;
    }
    dst[n] = 0;
    if (rest) *rest = rtx_batch_skip_ws(s);
    return n > 0;
}

static int rtx_batch_parse_u64(const char *s, unsigned long long *out) {
    char *end = NULL;
    unsigned long long v;
    if (!s || !s[0] || !out) return 0;
    v = strtoull(s, &end, 10);
    if (!end || end == s || *end) return 0;
    *out = v;
    return 1;
}

static RtxBuf *rtx_batch_buf(RtxWs *w) {
    return w ? w->active() : NULL;
}

static int rtx_batch_fail(FILE *err, const char *msg) {
    if (err) fprintf(err, "batch: %s\n", msg ? msg : "error");
    return RTX_BATCH_ERR;
}

static int rtx_batch_goto(RtxWs *w, const char *arg, FILE *err) {
    RtxBuf *b = rtx_batch_buf(w);
    RtxDoc *d;
    unsigned long long v;
    size_t off;
    size_t n;
    if (!b) return rtx_batch_fail(err, "no buffer");
    d = &b->doc;
    n = d->len();
    arg = rtx_batch_skip_ws(arg);
    if (!arg[0]) return rtx_batch_fail(err, "goto needs @N, N%, or LN");
    if (arg[0] == '@') {
        if (!rtx_batch_parse_u64(arg + 1, &v))
            return rtx_batch_fail(err, "goto @N: bad offset");
        off = (size_t)v;
        if (off > n) off = n;
        d->caret = off;
        d->sel_anchor = off;
        d->break_coalesce();
        b->seek_valid = 0;
        return RTX_BATCH_OK;
    }
    if (arg[0] == 'L' || arg[0] == 'l') {
        size_t line1;
        if (!rtx_batch_parse_u64(arg + 1, &v) || v == 0)
            return rtx_batch_fail(err, "goto LN: bad 1-based line");
        line1 = (size_t)v;
        if (!d->lf_ready())
            return rtx_batch_fail(err, "goto L: index not ready (await index)");
        {
            @errhandler(RtxIndexErr e) {
                return rtx_batch_fail(err, e.message ? e.message : "goto L");
            }
            size_t ls = d->line_start(line1 - 1) !>;
            d->caret = ls;
            d->sel_anchor = ls;
            d->break_coalesce();
            b->seek_valid = 0;
        }
        return RTX_BATCH_OK;
    }
    {
        size_t alen = strlen(arg);
        if (alen > 0 && arg[alen - 1] == '%') {
            char tmp[32];
            if (alen >= sizeof(tmp)) return rtx_batch_fail(err, "goto %: bad");
            memcpy(tmp, arg, alen - 1);
            tmp[alen - 1] = 0;
            if (!rtx_batch_parse_u64(tmp, &v))
                return rtx_batch_fail(err, "goto N%: bad percent");
            if (v > 100) v = 100;
            off = n ? (size_t)(((unsigned long long)(n - 1) * v) / 100ull) : 0;
            {
                @errhandler(RtxIndexErr e) {
                    return rtx_batch_fail(err,
                                          e.message ? e.message : "goto %");
                }
                off = rtx_doc_line_floor(d, off) !>;
            }
            d->caret = off;
            d->sel_anchor = off;
            d->break_coalesce();
            b->seek_valid = 0;
            return RTX_BATCH_OK;
        }
    }
    return rtx_batch_fail(err, "goto needs @N, N%, or LN");
}

static int rtx_batch_await(RtxWs *w, const char *arg, FILE *err) {
    RtxBuf *b = rtx_batch_buf(w);
    RtxDoc *d;
    char kind[32];
    const char *rest = NULL;
    if (!b) return rtx_batch_fail(err, "no buffer");
    d = &b->doc;
    if (!rtx_batch_word(arg, kind, sizeof(kind), &rest))
        return rtx_batch_fail(err, "await needs index|island");
    if (rest && rest[0]) return rtx_batch_fail(err, "await: extra args");
    if (strcmp(kind, "index") == 0) {
        @errhandler(RtxIndexErr e) {
            return rtx_batch_fail(err, e.message ? e.message : "await index");
        }
        rtx_line_scan_to(&d->tree, d->len()) !>;
        return RTX_BATCH_OK;
    }
    if (strcmp(kind, "island") == 0) {
        @errhandler(CCError e) {
            return rtx_batch_fail(err, e.message ? e.message : "await island");
        }
        if (!d->index_covers(d->caret) && !rtx_line_isle_live(&d->tree))
            rtx_line_isle_kick(&d->tree, d->caret);
        rtx_line_isle_finish(&d->tree) !>;
        return RTX_BATCH_OK;
    }
    return rtx_batch_fail(err, "await needs index|island");
}

static int rtx_batch_print(RtxWs *w, const char *arg, FILE *out, FILE *err) {
    RtxBuf *b = rtx_batch_buf(w);
    RtxDoc *d;
    unsigned long long nlines = RTX_BATCH_PRINT_DEFAULT;
    size_t from;
    size_t lines = 0;
    char buf[4096];
    arg = rtx_batch_skip_ws(arg);
    if (arg[0]) {
        if (!rtx_batch_parse_u64(arg, &nlines) || nlines == 0)
            return rtx_batch_fail(err, "print N: bad count");
    }
    if (!b || !out) return rtx_batch_fail(err, "print: no buffer");
    d = &b->doc;
    {
        @errhandler(RtxIndexErr e) {
            return rtx_batch_fail(err, e.message ? e.message : "print");
        }
        from = rtx_doc_line_floor_local(d, d->caret) !>;
    }
    while (lines < (size_t)nlines && from < d->len()) {
        size_t got;
        size_t i;
        size_t take = sizeof(buf);
        if (take > d->len() - from) take = d->len() - from;
        {
            @errhandler(CCError e) {
                return rtx_batch_fail(err, e.message ? e.message : "print read");
            }
            got = d->read_at(from, buf, take) !>;
        }
        if (!got) break;
        for (i = 0; i < got; i++) {
            fputc(buf[i], out);
            from++;
            if (buf[i] == '\n') {
                lines++;
                if (lines >= (size_t)nlines) break;
            }
        }
    }
    if (lines == 0 || (from > 0 && lines < (size_t)nlines)) {
        /* unterminated last line */
    }
    fflush(out);
    return RTX_BATCH_OK;
}

static int rtx_batch_read(RtxWs *w, const char *arg, FILE *out, FILE *err) {
    RtxBuf *b = rtx_batch_buf(w);
    RtxDoc *d;
    char a0[64], a1[64];
    const char *rest = NULL;
    unsigned long long off_u, n_u;
    size_t off, n, left;
    char buf[4096];
    if (!b || !out) return rtx_batch_fail(err, "read: no buffer");
    d = &b->doc;
    if (!rtx_batch_word(arg, a0, sizeof(a0), &rest))
        return rtx_batch_fail(err, "read @off n");
    if (a0[0] != '@' || !rtx_batch_parse_u64(a0 + 1, &off_u))
        return rtx_batch_fail(err, "read @off n");
    if (!rtx_batch_word(rest, a1, sizeof(a1), &rest) ||
        !rtx_batch_parse_u64(a1, &n_u))
        return rtx_batch_fail(err, "read @off n");
    if (rest && rest[0]) return rtx_batch_fail(err, "read: extra args");
    off = (size_t)off_u;
    n = (size_t)n_u;
    if (off > d->len()) off = d->len();
    if (n > d->len() - off) n = d->len() - off;
    left = n;
    while (left) {
        size_t take = sizeof(buf);
        size_t got;
        if (take > left) take = left;
        {
            @errhandler(CCError e) {
                return rtx_batch_fail(err, e.message ? e.message : "read");
            }
            got = d->read_at(off, buf, take) !>;
        }
        if (!got) break;
        fwrite(buf, 1, got, out);
        off += got;
        left -= got;
    }
    fflush(out);
    return RTX_BATCH_OK;
}

static int rtx_batch_insert(RtxWs *w, const char *arg, FILE *err) {
    RtxBuf *b = rtx_batch_buf(w);
    RtxDoc *d;
    char[:] bytes;
    size_t n;
    if (!b) return rtx_batch_fail(err, "no buffer");
    d = &b->doc;
    arg = rtx_batch_skip_ws(arg);
    if (!arg[0]) return rtx_batch_fail(err, "insert needs text");
    n = strlen(arg);
    /* Trim trailing \r from script lines. */
    while (n > 0 && (arg[n - 1] == '\r' || arg[n - 1] == '\n')) n--;
    bytes = cc_slice_from_buffer((void *)arg, n);
    {
        @errhandler(CCError e) {
            return rtx_batch_fail(err, e.message ? e.message : "insert");
        }
        d->type(bytes) !>;
    }
    return RTX_BATCH_OK;
}

static int rtx_batch_save(RtxWs *w, FILE *err) {
    RtxBuf *b = rtx_batch_buf(w);
    if (!b) return rtx_batch_fail(err, "no buffer");
    {
        @errhandler(CCError e) {
            return rtx_batch_fail(err, e.message ? e.message : "save");
        }
        b->doc.save() !>;
    }
    return RTX_BATCH_OK;
}

void rtx_batch_write_stats_json(FILE *fp, const RtxBuf *b) {
    const RtxDoc *d = b ? &b->doc : NULL;
    const RtxPageStore *st = d ? &d->tree.store : NULL;
    const RtxMarkupWin *last = NULL;
    size_t live = 0, si, livew = 0, walk = 0, wi;
    size_t from = 0, to = 0, plo = 0, phi = 0;
    int have = 0, covered = 0;
    const char *store = "-";
    const char *kindn = "unk";
    const char *findst = "walk";
    if (!fp) fp = stdout;
    if (st && st->slots) {
        for (si = 0; si < st->slot_n; si++)
            if (st->slots[si].file_id >= 0) live++;
    }
    if (d) {
        rtx_nav_brace_pages(d->caret, d->len(), &from, &to);
        have = rtx_nav_pair_ends((void *)&d->tree, d->runs.data, d->runs.len,
                                 d->caret, d->edit_gen, d->runs.len, &plo, &phi);
        covered = d->index_covers(d->caret);
        for (wi = 0; wi < (size_t)RTX_MARKUP_CACHE_WINDOWS; wi++) {
            const RtxMarkupWin *mw = &d->hl_win[wi];
            if (!mw->live) continue;
            livew++;
            if (!mw->ready) walk++;
            if (!last || mw->stamp >= last->stamp) last = mw;
        }
    }
    if (st && st->orig_open && st->add_open) store = "orig+add";
    else if (st && st->orig_open) store = "orig";
    else if (st && st->add_open) store = "add";
    fputc('{', fp);
    fputs("\"file\":{", fp);
    fprintf(fp, "\"bytes\":%zu,\"caret\":%zu,", d ? d->len() : (size_t)0,
            d ? d->caret : (size_t)0);
    fprintf(fp, "\"pages_live\":%zu,\"pages_slots\":%zu,\"store\":\"%s\"", live,
            st ? st->slot_n : (size_t)0, store);
    fputs("},\"lines\":{", fp);
    fprintf(fp,
            "\"scan_off\":%zu,\"scan_line\":%zu,\"lf_ready\":%s,"
            "\"line_off_len\":%zu,\"caret_index\":\"%s\"",
            d ? d->tree.line_scan_off : (size_t)0,
            d ? d->tree.scan_line : (size_t)0,
            d && d->tree.lf_ready ? "true" : "false",
            d ? d->tree.line_off_len : (size_t)0, covered ? "known" : "gap");
    if (b && b->seek_valid)
        fprintf(fp, ",\"seek_off\":%zu,\"seek_rel\":%ld", b->seek_off, b->seek_rel);
    else
        fputs(",\"seek_off\":null,\"seek_rel\":null", fp);
    if (d && rtx_line_isle_live(&d->tree)) {
        fprintf(fp,
                ",\"island\":{\"from\":%zu,\"anchor\":%zu,\"connected\":%s,"
                "\"pumping\":%s}",
                d->tree.isle_from, d->tree.isle_anchor,
                rtx_line_isle_connected(&d->tree) ? "true" : "false",
                rtx_line_isle_pumping(&d->tree) ? "true" : "false");
    } else {
        fputs(",\"island\":null", fp);
    }
    fputs("},\"grammar\":{", fp);
    fprintf(fp,
            "\"runs\":%zu,\"secs\":%zu,\"folds\":%zu,\"windows_live\":%zu,"
            "\"windows_cap\":%d,\"windows_walk\":%zu,\"hl_full\":%s,\"tm_ckpt\":%zu",
            d ? d->runs.len : (size_t)0, d ? d->secs.len : (size_t)0,
            d ? d->fold_n : (size_t)0, livew, RTX_MARKUP_CACHE_WINDOWS, walk,
            d && d->hl_full ? "true" : "false", d ? d->tm_ckpt.len : (size_t)0);
    if (last) {
        if (last->kind == RTX_SEC_CODE) kindn = "code";
        else if (last->kind == RTX_SEC_PROSE) kindn = "prose";
        fprintf(fp,
                ",\"last\":{\"from\":%zu,\"to\":%zu,\"kind\":\"%s\","
                "\"ready\":%s}",
                last->from, last->to, kindn, last->ready ? "true" : "false");
    } else {
        fputs(",\"last\":null", fp);
    }
    fputc('}', fp);
    if (d && d->find.query.len) {
        if (d->find.done) findst = d->find.truncated ? "trunc" : "done";
        fprintf(fp,
                ",\"find\":{\"hits\":%zu,\"scan_off\":%zu,\"done\":%s,"
                "\"truncated\":%s,\"state\":\"%s\"}",
                d->find.len, d->find.scan_off, d->find.done ? "true" : "false",
                d->find.truncated ? "true" : "false", findst);
    } else {
        fputs(",\"find\":null", fp);
    }
    fputs(",\"pair\":{", fp);
    fprintf(fp, "\"span\":%zu,", to > from ? to - from : (size_t)0);
    if (have)
        fprintf(fp, "\"match\":[%zu,%zu]", plo, phi);
    else
        fputs("\"match\":null", fp);
    fputs("}}\n", fp);
    fflush(fp);
}

int rtx_batch_exec(RtxWs *w, const char *line, FILE *out, FILE *err) {
    char cmd[32];
    const char *rest = NULL;
    const char *s;
    if (!out) out = stdout;
    if (!err) err = stderr;
    if (!line) return RTX_BATCH_OK;
    s = rtx_batch_skip_ws(line);
    if (!s[0] || s[0] == '#') return RTX_BATCH_OK;
    if (!rtx_batch_word(s, cmd, sizeof(cmd), &rest))
        return rtx_batch_fail(err, "empty command");
    if (strcmp(cmd, "goto") == 0) return rtx_batch_goto(w, rest, err);
    if (strcmp(cmd, "await") == 0) return rtx_batch_await(w, rest, err);
    if (strcmp(cmd, "print") == 0) return rtx_batch_print(w, rest, out, err);
    if (strcmp(cmd, "read") == 0) return rtx_batch_read(w, rest, out, err);
    if (strcmp(cmd, "insert") == 0) return rtx_batch_insert(w, rest, err);
    if (strcmp(cmd, "save") == 0) return rtx_batch_save(w, err);
    if (strcmp(cmd, "stats-json") == 0 || strcmp(cmd, "stats_json") == 0) {
        rtx_batch_write_stats_json(out, rtx_batch_buf(w));
        return RTX_BATCH_OK;
    }
    if (strcmp(cmd, "quit") == 0 || strcmp(cmd, "q") == 0)
        return RTX_BATCH_QUIT;
    return rtx_batch_fail(err, "unknown command");
}

int rtx_batch_run(RtxWs *w, char **cmds, int n, FILE *out, FILE *err) {
    int i;
    if (!w) return 1;
    for (i = 0; i < n; i++) {
        int rc = rtx_batch_exec(w, cmds[i], out, err);
        if (rc == RTX_BATCH_QUIT) return 0;
        if (rc == RTX_BATCH_ERR) return 1;
    }
    return 0;
}

int rtx_batch_run_fp(RtxWs *w, FILE *fp, FILE *out, FILE *err) {
    char line[4096];
    if (!w || !fp) return 1;
    while (fgets(line, sizeof(line), fp)) {
        size_t n = strlen(line);
        while (n > 0 && (line[n - 1] == '\n' || line[n - 1] == '\r'))
            line[--n] = 0;
        {
            int rc = rtx_batch_exec(w, line, out, err);
            if (rc == RTX_BATCH_QUIT) return 0;
            if (rc == RTX_BATCH_ERR) return 1;
        }
    }
    return 0;
}
