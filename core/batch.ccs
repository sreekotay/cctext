#!ccc ccs
/*
 * --batch command runner. Kick verbs that need coverage use await.
 */
#include <ccc/std/prelude.cch>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include "document.cch"
#include "workspace.cch"
#include "nav_pair.cch"
#include "find.cch"
#include "proj.cch"
#include "batch.cch"
#include "slides.cch"
#include "lf.cch"
#include <stdatomic.h>
#include <time.h>

static long rtx_batch_now_ms(void) {
    struct timespec ts;
    if (clock_gettime(CLOCK_MONOTONIC, &ts) != 0) return 0;
    return (long)ts.tv_sec * 1000L + ts.tv_nsec / 1000000L;
}

enum { RTX_BATCH_PRINT_DEFAULT = 40 };

static const char *rtx_batch_skip_ws(const char *s) {
    if (!s) return "";
    while (*s == ' ' || *s == '\t' || *s == '\r') s++;
    return s;
}

static int rtx_batch_word(const char *s, char *dst, size_t dstn, const char **rest) {
    size_t n = 0;
    s = rtx_batch_skip_ws(s);
    if (!dst || dstn == 0) return 0;
    while (*s && *s != ' ' && *s != '\t' && *s != '\r' && *s != '\n') {
        if (n + 1 >= dstn) return 0;
        dst[n++] = *s++;
    }
    dst[n] = 0;
    if (rest) *rest = rtx_batch_skip_ws(s);
    return n > 0;
}

static int rtx_batch_parse_u64(const char *s, unsigned long long *out) {
    char *end = NULL;
    unsigned long long v;
    if (!s || !s[0] || !out) return 0;
    v = strtoull(s, &end, 10);
    if (!end || end == s || *end) return 0;
    *out = v;
    return 1;
}

static RtxBuf *rtx_batch_buf(RtxWs *w) {
    return w ? w->active() : NULL;
}

static int rtx_batch_fail(FILE *err, const char *msg) {
    if (err) fprintf(err, "batch: %s\n", msg ? msg : "error");
    return RTX_BATCH_ERR;
}

static int rtx_batch_goto(RtxWs *w, const char *arg, FILE *err) {
    RtxBuf *b = rtx_batch_buf(w);
    RtxDoc *d;
    unsigned long long v;
    size_t off;
    size_t n;
    if (!b) return rtx_batch_fail(err, "no buffer");
    d = &b->doc;
    n = d->len();
    arg = rtx_batch_skip_ws(arg);
    if (!arg[0]) return rtx_batch_fail(err, "goto needs @N, N%, or LN");
    if (arg[0] == '@') {
        if (!rtx_batch_parse_u64(arg + 1, &v))
            return rtx_batch_fail(err, "goto @N: bad offset");
        off = (size_t)v;
        if (off > n) off = n;
        d->caret = off;
        d->sel_anchor = off;
        d->break_coalesce();
        b->seek_valid = 0;
        return RTX_BATCH_OK;
    }
    if (arg[0] == 'L' || arg[0] == 'l') {
        size_t line1;
        if (!rtx_batch_parse_u64(arg + 1, &v) || v == 0)
            return rtx_batch_fail(err, "goto LN: bad 1-based line");
        line1 = (size_t)v;
        if (!d->lf_ready())
            return rtx_batch_fail(err, "goto L: index not ready (await index)");
        {
            @errhandler(RtxIndexErr e) {
                return rtx_batch_fail(err, e.message ? e.message : "goto L");
            }
            size_t ls = d->line_start(line1 - 1) !>;
            d->caret = ls;
            d->sel_anchor = ls;
            d->break_coalesce();
            b->seek_valid = 0;
        }
        return RTX_BATCH_OK;
    }
    {
        size_t alen = cc_slice_cstr(arg).len;
        if (alen > 0 && arg[alen - 1] == '%') {
            char tmp[32];
            if (alen >= sizeof(tmp)) return rtx_batch_fail(err, "goto %: bad");
            memcpy(tmp, arg, alen - 1);
            tmp[alen - 1] = 0;
            if (!rtx_batch_parse_u64(tmp, &v))
                return rtx_batch_fail(err, "goto N%: bad percent");
            if (v > 100) v = 100;
            off = n ? (size_t)(((unsigned long long)(n - 1) * v) / 100ull) : 0;
            {
                @errhandler(RtxIndexErr e) {
                    return rtx_batch_fail(err,
                                          e.message ? e.message : "goto %");
                }
                off = rtx_doc_line_floor(d, off) !>;
            }
            d->caret = off;
            d->sel_anchor = off;
            d->break_coalesce();
            b->seek_valid = 0;
            return RTX_BATCH_OK;
        }
    }
    return rtx_batch_fail(err, "goto needs @N, N%, or LN");
}

static int rtx_batch_await(RtxWs *w, const char *arg, FILE *err) {
    RtxBuf *b = rtx_batch_buf(w);
    RtxDoc *d;
    char kind[32];
    const char *rest = NULL;
    if (!b) return rtx_batch_fail(err, "no buffer");
    d = &b->doc;
    if (!rtx_batch_word(arg, kind, sizeof(kind), &rest))
        return rtx_batch_fail(err, "await needs index|island");
    if (rest && rest[0]) return rtx_batch_fail(err, "await: extra args");
    {
        CCSlice k = cc_slice_cstr(kind);
        if (k.eq_cstr("index")) {
            @errhandler(RtxIndexErr e) {
                return rtx_batch_fail(err, e.message ? e.message : "await index");
            }
            rtx_line_scan_to(&d->tree, d->len()) !>;
            return RTX_BATCH_OK;
        }
        if (k.eq_cstr("island")) {
            @errhandler(CCError e) {
                return rtx_batch_fail(err, e.message ? e.message : "await island");
            }
            if (!d->index_covers(d->caret) && !rtx_line_isle_live(&d->tree))
                rtx_line_isle_kick(&d->tree, d->caret);
            rtx_line_isle_finish(&d->tree) !>;
            return RTX_BATCH_OK;
        }
    }
    return rtx_batch_fail(err, "await needs index|island");
}

static int rtx_batch_print(RtxWs *w, const char *arg, FILE *out, FILE *err) {
    RtxBuf *b = rtx_batch_buf(w);
    RtxDoc *d;
    unsigned long long nlines = RTX_BATCH_PRINT_DEFAULT;
    size_t from;
    size_t lines = 0;
    char buf[4096];
    arg = rtx_batch_skip_ws(arg);
    if (arg[0]) {
        if (!rtx_batch_parse_u64(arg, &nlines) || nlines == 0)
            return rtx_batch_fail(err, "print N: bad count");
    }
    if (!b || !out) return rtx_batch_fail(err, "print: no buffer");
    d = &b->doc;
    {
        @errhandler(RtxIndexErr e) {
            return rtx_batch_fail(err, e.message ? e.message : "print");
        }
        from = rtx_doc_line_floor_local(d, d->caret) !>;
    }
    while (lines < (size_t)nlines && from < d->len()) {
        size_t got, at, put, seen = 0;
        size_t take = sizeof(buf);
        if (take > d->len() - from) take = d->len() - from;
        {
            @errhandler(CCError e) {
                return rtx_batch_fail(err, e.message ? e.message : "print read");
            }
            got = d->read_at(from, cc_slice_from_buffer(buf, take)) !>;
        }
        if (!got) break;
        at = rtx_nth_lf(buf, got, (size_t)nlines - lines, &seen);
        put = at == (size_t)-1 ? got : at + 1;
        fwrite(buf, 1, put, out);
        from += put;
        lines += seen;
    }
    if (lines == 0 || (from > 0 && lines < (size_t)nlines)) {
        /* unterminated last line */
    }
    fflush(out);
    return RTX_BATCH_OK;
}

static int rtx_batch_read(RtxWs *w, const char *arg, FILE *out, FILE *err) {
    RtxBuf *b = rtx_batch_buf(w);
    RtxDoc *d;
    char a0[64], a1[64];
    const char *rest = NULL;
    unsigned long long off_u, n_u;
    size_t off, n, left;
    char buf[4096];
    if (!b || !out) return rtx_batch_fail(err, "read: no buffer");
    d = &b->doc;
    if (!rtx_batch_word(arg, a0, sizeof(a0), &rest))
        return rtx_batch_fail(err, "read @off n");
    if (a0[0] != '@' || !rtx_batch_parse_u64(a0 + 1, &off_u))
        return rtx_batch_fail(err, "read @off n");
    if (!rtx_batch_word(rest, a1, sizeof(a1), &rest) ||
        !rtx_batch_parse_u64(a1, &n_u))
        return rtx_batch_fail(err, "read @off n");
    if (rest && rest[0]) return rtx_batch_fail(err, "read: extra args");
    off = (size_t)off_u;
    n = (size_t)n_u;
    if (off > d->len()) off = d->len();
    if (n > d->len() - off) n = d->len() - off;
    left = n;
    while (left) {
        size_t take = sizeof(buf);
        size_t got;
        if (take > left) take = left;
        {
            @errhandler(CCError e) {
                return rtx_batch_fail(err, e.message ? e.message : "read");
            }
            got = d->read_at(off, cc_slice_from_buffer(buf, take)) !>;
        }
        if (!got) break;
        fwrite(buf, 1, got, out);
        off += got;
        left -= got;
    }
    fflush(out);
    return RTX_BATCH_OK;
}

static int rtx_batch_insert(RtxWs *w, const char *arg, FILE *err) {
    RtxBuf *b = rtx_batch_buf(w);
    RtxDoc *d;
    char[:] bytes;
    size_t n;
    if (!b) return rtx_batch_fail(err, "no buffer");
    d = &b->doc;
    arg = rtx_batch_skip_ws(arg);
    if (!arg[0]) return rtx_batch_fail(err, "insert needs text");
    n = cc_slice_cstr(arg).len;
    /* Trim trailing \r from script lines. */
    while (n > 0 && (arg[n - 1] == '\r' || arg[n - 1] == '\n')) n--;
    bytes = cc_slice_from_buffer((void *)arg, n);
    {
        @errhandler(CCError e) {
            return rtx_batch_fail(err, e.message ? e.message : "insert");
        }
        d->type(bytes) !>;
    }
    return RTX_BATCH_OK;
}

/* One argument of `replace`. Unquoted: bytes up to white space. '...':
 * bytes up to the next ' (no escapes). "...": up to an unescaped ", where
 * \" is a quote and every other backslash stays (so regex \d and the
 * template's \n pass through). 0 = none / malformed (*bad). */
static int rtx_batch_arg(const char *s, char *dst, size_t cap, size_t *outn,
                         const char **rest, int *bad) {
    size_t n = 0;
    *bad = 0;
    s = rtx_batch_skip_ws(s);
    if (!*s || *s == '\n') return 0;
    if (*s == '\'' || *s == '"') {
        char qc = *s++;
        while (*s && *s != qc) {
            char c = *s++;
            if (qc == '"' && c == '\\' && *s == '"') c = *s++;
            if (n + 1 >= cap) {
                *bad = 1;
                return 0;
            }
            dst[n++] = c;
        }
        if (*s != qc) {
            *bad = 1;
            return 0;
        }
        s++;
        if (*s && *s != ' ' && *s != '\t' && *s != '\r' && *s != '\n') {
            *bad = 1;
            return 0;
        }
    } else {
        while (*s && *s != ' ' && *s != '\t' && *s != '\r' && *s != '\n') {
            if (n + 1 >= cap) {
                *bad = 1;
                return 0;
            }
            dst[n++] = *s++;
        }
    }
    dst[n] = 0;
    *outn = n;
    if (rest) *rest = rtx_batch_skip_ws(s);
    return 1;
}

/* `--name` then white space or the end. */
static int rtx_batch_flag(const char *s, const char *name) {
    size_t n = strlen(name);
    return !strncmp(s, name, n) && (!s[n] || s[n] == ' ' || s[n] == '\t' || s[n] == '\r');
}

/* replace [--all] [--regex] [--icase] [--word] [--] FIND REPL
 * One: the first match at or after the caret (one undo step); the next
 * match is then selected. --all: every match as one edit group. */
static int rtx_batch_replace(RtxWs *w, const char *arg, FILE *out, FILE *err) {
    RtxBuf *b = rtx_batch_buf(w);
    RtxDoc *d;
    char q[RTX_FIND_QMAX + 1];
    char r[RTX_REPL_QMAX + 1];
    size_t qn = 0, rn = 0;
    unsigned opts = 0;
    int all = 0, bad = 0;
    const char *rest = arg;
    if (!b) return rtx_batch_fail(err, "no buffer");
    d = &b->doc;
    for (;;) {
        const char *s = rtx_batch_skip_ws(rest);
        if (rtx_batch_flag(s, "--all")) {
            all = 1;
            rest = s + 5;
        } else if (rtx_batch_flag(s, "--regex")) {
            opts |= RTX_FIND_REGEX;
            rest = s + 7;
        } else if (rtx_batch_flag(s, "--icase")) {
            opts |= RTX_FIND_ICASE;
            rest = s + 7;
        } else if (rtx_batch_flag(s, "--word")) {
            opts |= RTX_FIND_WORD;
            rest = s + 6;
        } else if (rtx_batch_flag(s, "--")) {
            rest = s + 2;
            break;
        } else {
            break;
        }
    }
    if (!rtx_batch_arg(rest, q, sizeof(q), &qn, &rest, &bad) || qn == 0 || bad)
        return rtx_batch_fail(err, "replace [--all] [--regex] [--icase] [--word] FIND REPL");
    if (!rtx_batch_arg(rest, r, sizeof(r), &rn, &rest, &bad) || bad)
        return rtx_batch_fail(err, "replace: REPL missing (\"\" is empty)");
    if (rest && rest[0]) return rtx_batch_fail(err, "replace: extra args (quote them)");
    {
        @errhandler(CCError e) {
            return rtx_batch_fail(err, e.message ? e.message : "replace");
        }
        char[:] qs = cc_slice_from_buffer(q, qn);
        char[:] rs = rn ? cc_slice_from_buffer(r, rn) : cc_slice_empty();
        const char *why = NULL;
        size_t i, nh, n;
        int hit;
        if (all) {
            n = d->replace_all(qs, opts, rs, 0, (size_t)-1) !>;
            if (out) {
                fprintf(out, "replaced %zu\n", n);
                fflush(out);
            }
            return RTX_BATCH_OK;
        }
        d->find_set_opt(qs, opts) !>;
        d->find_finish() !>;
        if (d->find.err) return rtx_batch_fail(err, d->find.err);
        nh = rtx_find_hits_n(&d->find);
        for (i = 0; i < nh; i++)
            if (d->find.hits.data[i].off >= d->caret) break;
        if (i == nh) return rtx_batch_fail(err, "replace: no match at or after the caret");
        d->find_goto(i);
        hit = d->replace_hit(rs, &why) !>;
        if (!hit) return rtx_batch_fail(err, why ? why : "replace: no match");
        if (out) {
            fprintf(out, "replaced 1\n");
            fflush(out);
        }
    }
    return RTX_BATCH_OK;
}

/* ------------------------------------------------------------ project
 * project-files / project-search run on one process-level project (the
 * batch host has no UI to own it). Root: --project DIR, else the git root
 * above the active buffer's path, else the cwd. */
static RtxProj *g_bproj;
static char g_bproj_dir[RTX_PROJ_PATH];

void rtx_batch_set_project(const char *dir) {
    snprintf(g_bproj_dir, sizeof g_bproj_dir, "%s", dir ? dir : "");
}

void rtx_batch_project_close(void) {
    if (!g_bproj) return;
    rtx_proj_close(g_bproj);
    free(g_bproj);
    g_bproj = NULL;
}

static RtxProj *rtx_batch_proj(RtxWs *w, unsigned flags, int rewalk, int wait_walk, FILE *err) {
    char root[RTX_PROJ_PATH];
    @errhandler(CCError e) {
        rtx_batch_fail(err, e.message ? e.message : "project");
        return NULL;
    }
    if (g_bproj && g_bproj->flags == flags && !rewalk) return g_bproj;
    if (g_bproj_dir[0]) {
        snprintf(root, sizeof root, "%s", g_bproj_dir);
    } else {
        RtxBuf *b = rtx_batch_buf(w);
        const char *start = (b && b->doc.path.ptr && b->doc.path.len) ? b->doc.path.ptr : ".";
        if (rtx_proj_root_of(start, root, sizeof root) < 0 &&
            rtx_proj_root_of(".", root, sizeof root) < 0) {
            rtx_batch_fail(err, "project: no root");
            return NULL;
        }
    }
    if (!g_bproj) {
        g_bproj = (RtxProj *)calloc(1, sizeof(RtxProj));
        if (!g_bproj) {
            rtx_batch_fail(err, "project: out of memory");
            return NULL;
        }
    }
    rtx_proj_open(g_bproj, cc_slice_cstr(root), flags) !>;
    {
        /* The search index file: only with Safe on (`--safe`), like the
         * journals (the Safe dir, never the project). */
        char cache[RTX_PROJ_PATH];
        if (rtx_safe_dir(cache, sizeof cache)) rtx_proj_index_dir(g_bproj, cache);
    }
    /* project-search does not wait: its arms chase the walk. */
    if (wait_walk) rtx_proj_finish(g_bproj) !>;
    return g_bproj;
}

static int rtx_batch_path_cmp(const void *a, const void *b) {
    return strcmp(*(const char *const *)a, *(const char *const *)b);
}

/* project-files [--rewalk] [--follow] [--no-ignore] [--stats] [QUERY]
 * No QUERY: every indexed path, sorted. QUERY: the quick-open ranking,
 * best first (at most RTX_PROJ_PICK_K). */
static int rtx_batch_project_files(RtxWs *w, const char *arg, FILE *out, FILE *err) {
    unsigned flags = 0;
    int rewalk = 0, stats = 0, bad = 0;
    const char *rest = arg;
    char q[RTX_PROJ_QMAX];
    size_t qn = 0, i, n;
    RtxProj *p;
    for (;;) {
        const char *s = rtx_batch_skip_ws(rest);
        if (rtx_batch_flag(s, "--rewalk")) {
            rewalk = 1;
            rest = s + 8;
        } else if (rtx_batch_flag(s, "--follow")) {
            flags |= RTX_PROJ_FOLLOW;
            rest = s + 8;
        } else if (rtx_batch_flag(s, "--no-ignore")) {
            flags |= RTX_PROJ_NO_IGNORE;
            rest = s + 11;
        } else if (rtx_batch_flag(s, "--stats")) {
            stats = 1;
            rest = s + 7;
        } else if (rtx_batch_flag(s, "--")) {
            rest = s + 2;
            break;
        } else {
            break;
        }
    }
    if (rtx_batch_arg(rest, q, sizeof q, &qn, &rest, &bad) && bad)
        return rtx_batch_fail(err, "project-files [--rewalk] [--follow] [--no-ignore] [QUERY]");
    if (rest && rest[0]) return rtx_batch_fail(err, "project-files: extra args (quote them)");
    p = rtx_batch_proj(w, flags, rewalk, 1, err);
    if (!p) return RTX_BATCH_ERR;
    n = rtx_proj_nfiles(p);
    if (stats) {
        const RtxProjIdx *x = p->cur;
        size_t nd = x ? (size_t)atomic_load(&x->pub_nd) : 0;
        /* Store bytes: file records, dir records, name / path pool. */
        size_t bytes = n * sizeof(RtxProjFile) + nd * sizeof(RtxProjDir) +
                       (x ? (size_t)x->npool : 0);
        fprintf(out, "# files %zu dirs %zu ignored %zu loops %zu walk_ms %ld store %zu B"
                     " (%.1f B/file)\n",
                n, nd, x ? x->n_ignored : 0, x ? x->n_loops : 0,
                x ? x->t_ms - x->t0_ms : 0, bytes, n ? (double)bytes / (double)n : 0.0);
    }
    if (qn == 0) {
        CCArena a = cc_arena_heap(megabytes(1)) @destroy;
        char **v = (char **)cc_arena_alloc(a, (n + 1) * sizeof(char *), 8);
        char path[RTX_PROJ_PATH];
        if (!v) return rtx_batch_fail(err, "project-files: out of memory");
        for (i = 0; i < n; i++) {
            size_t len = rtx_proj_path(p, (uint32_t)i, path, sizeof path);
            v[i] = (char *)cc_arena_alloc(a, len + 1, 1);
            if (!v[i]) return rtx_batch_fail(err, "project-files: out of memory");
            memcpy(v[i], path, len + 1);
        }
        qsort(v, n, sizeof(char *), rtx_batch_path_cmp);
        for (i = 0; i < n; i++) fprintf(out, "%s\n", v[i]);
    } else {
        @errhandler(CCError e) {
            return rtx_batch_fail(err, e.message ? e.message : "project-files");
        }
        char path[RTX_PROJ_PATH];
        if (stats) {
            /* Keystroke latency: each prefix of QUERY as typed (the
             * candidate list narrows), then the whole query cold. */
            size_t k;
            for (k = 1; k <= qn; k++) {
                rtx_proj_pick_set(p, cc_slice_from_buffer(q, k)) !>;
                fprintf(out, "# type %.*s: %zu rows, %ld us (%zu shards, %zu candidates)\n",
                        (int)k, q, rtx_proj_pick_n(p), p->pick.score_us,
                        p->pick.shards_last, p->pick.ncand);
            }
            rtx_proj_pick_set(p, cc_slice_from_buffer("\x01", 1)) !>;
        }
        rtx_proj_pick_set(p, cc_slice_from_buffer(q, qn)) !>;
        if (stats)
            fprintf(out, "# cold %s: %ld us (%zu shards)\n", q, p->pick.score_us,
                    p->pick.shards_last);
        for (i = 0; i < rtx_proj_pick_n(p); i++) {
            const RtxProjHit *h = rtx_proj_pick_at(p, i);
            if (!h) break;
            rtx_proj_path(p, h->id, path, sizeof path);
            if (stats) fprintf(out, "%d\t%s\n", h->score, path);
            else fprintf(out, "%s\n", path);
        }
    }
    fflush(out);
    return RTX_BATCH_OK;
}

/* project-index [--pct N] [--update] [--lanes N]
 * Build the project's search index in the Safe cache dir (needs
 * `--safe`), or update it (only the changed blocks; a full build when
 * there is none or too much changed), then report its size and cost. */
static int rtx_batch_project_index(RtxWs *w, const char *arg, FILE *out, FILE *err) {
    RtxProj *p;
    const char *rest = arg;
    int ok, bad = 0, upd = 0;
    unsigned long long lanes = 0;
    const RtxSiBuildOut *r;
    @errhandler(CCError e) {
        return rtx_batch_fail(err, e.message ? e.message : "project-index");
    }
    for (;;) {
        const char *s = rtx_batch_skip_ws(rest);
        if (rtx_batch_flag(s, "--pct")) {
            char num[32];
            size_t nn = 0;
            unsigned long long v = 0;
            if (!rtx_batch_arg(s + 5, num, sizeof num, &nn, &rest, &bad) || bad ||
                !rtx_batch_parse_u64(num, &v) || v < 1 || v > 50)
                return rtx_batch_fail(err, "project-index: --pct 1-50");
            rtx_si_set_pct((long)v);
        } else if (rtx_batch_flag(s, "--lanes")) {
            char num[32];
            size_t nn = 0;
            if (!rtx_batch_arg(s + 7, num, sizeof num, &nn, &rest, &bad) || bad ||
                !rtx_batch_parse_u64(num, &lanes) || lanes < 1 || lanes > 8)
                return rtx_batch_fail(err, "project-index: --lanes 1-8");
        } else if (rtx_batch_flag(s, "--update")) {
            upd = 1;
            rest = s + 8;
        } else {
            rest = s;
            break;
        }
    }
    if (rest && rest[0])
        return rtx_batch_fail(err, "project-index [--pct N] [--update] [--lanes N]");
    p = rtx_batch_proj(w, 0, 0, 1, err);
    if (!p) return RTX_BATCH_ERR;
    if (!p->si_path[0])
        return rtx_batch_fail(err, "project-index: needs --safe (the index lives in the Safe dir)");
    ok = rtx_proj_index_build_mode(p, upd, (int)lanes) !>;
    r = &p->si_last;
    if (!ok) return rtx_batch_fail(err, r->err ? r->err : "project-index failed");
    fprintf(out, "# index: %u files, %llu bytes indexed; %llu B (%.2f%% of them; budget %llu B)"
                 " = file table %llu (%.3f%%) + unit dir %llu + filters %llu\n",
            r->files, (unsigned long long)r->corpus, (unsigned long long)r->bytes,
            r->corpus ? 100.0 * (double)r->bytes / (double)r->corpus : 0.0,
            (unsigned long long)r->budget, (unsigned long long)r->ftab_bytes,
            r->corpus ? 100.0 * (double)r->ftab_bytes / (double)r->corpus : 0.0,
            (unsigned long long)r->udir_bytes, (unsigned long long)r->filt_bytes);
    fprintf(out, "# index: %u units (%u blocks, %u chunks), %llu distinct trigrams (per unit,"
                 " summed), fill %.3f; peak %.1f MiB\n",
            r->units, r->blocks, r->chunks, (unsigned long long)r->distinct, r->fill,
            (double)r->peak / 1048576.0);
    if (r->update)
        fprintf(out, "# update: %u same, %u changed, %u new, %u gone files; %u units re-read,"
                     " %u new; %llu bytes read; stat %ld ms, read %ld ms, write %ld ms,"
                     " total %ld ms (the last full build: %ld ms)\n",
                r->upd_same, r->upd_changed, r->upd_new, r->upd_gone, r->upd_dirty,
                r->upd_tail, (unsigned long long)r->upd_bytes, r->ms_stat, r->ms_pass2,
                r->ms_write, r->ms, r->full_ms);
    else
        fprintf(out, "# build%s%s%s: pass 1 %ld ms, pass 2 %ld ms, write %ld ms, total %ld ms\n",
                r->why_full ? " (update: " : "", r->why_full ? r->why_full : "",
                r->why_full ? ")" : "", r->ms_pass1, r->ms_pass2, r->ms_write, r->ms);
    return RTX_BATCH_OK;
}

/* project-search [--regex] [--icase] [--word] [--no-ignore] [--max-size N]
 *                [--stats] [--] QUERY
 * One line per match: path:line:col: preview. Then `# N matches in F
 * files` (and the binary / big files skipped, and the files the search
 * index skipped). --stats adds the index and time split lines. */
static int rtx_batch_project_search(RtxWs *w, const char *arg, FILE *out, FILE *err) {
    unsigned opts = 0;
    int bad = 0, stats = 0;
    unsigned long long maxb = 0;
    unsigned wflags = 0;
    const char *rest = arg;
    char q[RTX_PROJ_QMAX];
    size_t qn = 0, i, nh, ng;
    RtxProj *p;
    @errhandler(CCError e) {
        return rtx_batch_fail(err, e.message ? e.message : "project-search");
    }
    for (;;) {
        const char *s = rtx_batch_skip_ws(rest);
        if (rtx_batch_flag(s, "--regex")) {
            opts |= RTX_PS_REGEX;
            rest = s + 7;
        } else if (rtx_batch_flag(s, "--icase")) {
            opts |= RTX_PS_ICASE;
            rest = s + 7;
        } else if (rtx_batch_flag(s, "--word")) {
            opts |= RTX_PS_WORD;
            rest = s + 6;
        } else if (rtx_batch_flag(s, "--no-ignore")) {
            wflags |= RTX_PROJ_NO_IGNORE;
            rest = s + 11;
        } else if (rtx_batch_flag(s, "--stats")) {
            stats = 1;
            rest = s + 7;
        } else if (rtx_batch_flag(s, "--max-size")) {
            char num[32];
            size_t nn = 0;
            if (!rtx_batch_arg(s + 10, num, sizeof num, &nn, &rest, &bad) || bad ||
                !rtx_batch_parse_u64(num, &maxb))
                return rtx_batch_fail(err, "project-search: --max-size BYTES");
        } else if (rtx_batch_flag(s, "--")) {
            rest = s + 2;
            break;
        } else {
            break;
        }
    }
    if (!rtx_batch_arg(rest, q, sizeof q, &qn, &rest, &bad) || qn == 0 || bad)
        return rtx_batch_fail(err, "project-search [--regex] [--icase] [--word] QUERY");
    if (rest && rest[0]) return rtx_batch_fail(err, "project-search: extra args (quote them)");
    p = rtx_batch_proj(w, wflags, 0, 0, err);
    if (!p) return RTX_BATCH_ERR;
    rtx_proj_search_clear(p);
    if (maxb) p->ps.max_bytes = (size_t)maxb;
    rtx_proj_search_set(p, cc_slice_from_buffer(q, qn), opts) !>;
    if (p->ps.err) return rtx_batch_fail(err, p->ps.err);
    rtx_proj_search_finish(p) !>;
    nh = rtx_proj_search_nh(p);
    ng = rtx_proj_search_ng(p);
    ng -= p->ps.n_indet; /* the files with matches: an incomplete one may have none */
    {
        size_t g;
        for (g = 0; g < rtx_proj_search_ng(p); g++) {
            const RtxPsGroup *gr = rtx_proj_search_group(p, g);
            if (gr->indet_line && gr->n) ng++;
        }
    }
    {
        /* One path per group; lines are built in a buffer and written in
         * blocks (a per-byte fputc took ~270 ms for 262k hits). */
        enum { OUT_CAP = 64 * 1024 };
        CCArena oa = cc_arena_heap(OUT_CAP + 4096) @destroy;
        char *ob = (char *)cc_arena_alloc(oa, OUT_CAP, 1);
        char path[RTX_PROJ_PATH];
        size_t on = 0, g;
        int m0;
        if (!ob) return rtx_batch_fail(err, "project-search: out of memory");
        for (g = 0; g < rtx_proj_search_ng(p); g++) {
            const RtxPsGroup *gr = rtx_proj_search_group(p, g);
            size_t pn = rtx_proj_path(p, gr->file, path, sizeof path);
            if (gr->indet_line) {
                /* The file's hits stop before this line: say so first. */
                if (on + pn + 96 > OUT_CAP) {
                    fwrite(ob, 1, on, out);
                    on = 0;
                }
                memcpy(ob + on, path, pn);
                on += pn;
                m0 = snprintf(ob + on, OUT_CAP - on,
                              ":%u: search incomplete: pattern too complex (no match "
                              "listed from here)\n",
                              gr->indet_line);
                on += m0 > 0 ? (size_t)m0 : 0;
            }
            for (i = gr->first; i < (size_t)gr->first + gr->n; i++) {
                const RtxPsHit *h = rtx_proj_search_hit(p, i);
                const char *pv = rtx_proj_search_pv(p, h);
                size_t k;
                int m;
                if (on + pn + 32 + h->pvn + 1 > OUT_CAP) {
                    fwrite(ob, 1, on, out);
                    on = 0;
                }
                memcpy(ob + on, path, pn);
                on += pn;
                m = snprintf(ob + on, OUT_CAP - on, ":%u:%u: ", h->line, h->col);
                on += m > 0 ? (size_t)m : 0;
                for (k = 0; k < h->pvn; k++) {
                    unsigned char c = (unsigned char)pv[k];
                    ob[on++] = (char)(c == '\t' || c >= 0x20 ? c : '?');
                }
                ob[on++] = '\n';
            }
        }
        if (on) fwrite(ob, 1, on, out);
    }
    fprintf(out, "# %zu matches in %zu files (%zu binary, %zu over size skipped)%s;"
                 " %zu files, %llu bytes in %ld ms",
            nh, ng, p->ps.n_bin, p->ps.n_big, p->ps.truncated ? " capped" : "",
            (size_t)atomic_load(&p->ps.pub_files),
            (unsigned long long)atomic_load(&p->ps.pub_bytes), p->ps.t_ms - p->ps.t0_ms);
    if (p->ps.n_idx_skip) fprintf(out, "; %zu skipped by the index", p->ps.n_idx_skip);
    if (p->ps.n_idx_chunk) fprintf(out, "; %zu read by chunks", p->ps.n_idx_chunk);
    if (p->ps.n_indet)
        fprintf(out, "; search incomplete: %zu file%s incomplete (pattern too complex)",
                p->ps.n_indet, p->ps.n_indet == 1 ? "" : "s");
    fputc('\n', out);
    if (stats) {
        const RtxProjIdx *x = p->cur;
        fprintf(out, "# time: walk %ld ms, search %ld ms; lanes (summed) stat %.1f ms,"
                     " read %.1f ms, scan %.1f ms\n",
                x ? x->t_ms - x->t0_ms : 0, p->ps.t_ms - p->ps.t0_ms,
                (double)p->ps.us_stat / 1000.0, (double)p->ps.us_read / 1000.0,
                (double)p->ps.us_scan / 1000.0);
        if (p->si_path[0]) {
            const RtxSi *si = p->si;
            fprintf(out, "# index: %s", !si ? "not loaded" : si->load_rc > 0 ? "loaded"
                                          : si->load_rc < 0 ? "rejected" : "none");
            if (si && si->load_rc > 0)
                fprintf(out, " (%u files, %llu B, %u units) in %ld ms", si->nfiles,
                        (unsigned long long)si->file_bytes, si->nunits, si->load_ms);
            fprintf(out, "; %s", p->ps.si_state == 1 ? "pruning" : "plain scan");
            if (p->ps.si_state == 1)
                fprintf(out, ", %zu candidate files (%.2f%% of %u), %zu files skipped unread,"
                             " %zu read by chunks, plan %.2f ms",
                        p->ps.si_ncand,
                        si && si->nfiles ? 100.0 * (double)p->ps.si_ncand / si->nfiles : 0.0,
                        si ? si->nfiles : 0, p->ps.n_idx_skip, p->ps.n_idx_chunk,
                        (double)p->ps.si_us / 1000.0);
            fputc('\n', out);
        }
    }
    fflush(out);
    return RTX_BATCH_OK;
}

static int rtx_batch_undo(RtxWs *w, int redo, FILE *err) {
    RtxBuf *b = rtx_batch_buf(w);
    if (!b) return rtx_batch_fail(err, "no buffer");
    {
        @errhandler(CCError e) {
            return rtx_batch_fail(err, e.message ? e.message : "undo");
        }
        if (redo) {
            if (!b->doc.can_redo()) return rtx_batch_fail(err, "nothing to redo");
            b->doc.redo() !>;
        } else {
            if (!b->doc.can_undo()) return rtx_batch_fail(err, "nothing to undo");
            b->doc.undo() !>;
        }
    }
    return RTX_BATCH_OK;
}

static int rtx_batch_save(RtxWs *w, FILE *err) {
    RtxBuf *b = rtx_batch_buf(w);
    if (!b) return rtx_batch_fail(err, "no buffer");
    {
        @errhandler(CCError e) {
            return rtx_batch_fail(err, e.message ? e.message : "save");
        }
        b->doc.save() !>;
    }
    return RTX_BATCH_OK;
}

void rtx_batch_write_stats_json(FILE *fp, const RtxBuf *b) {
    const RtxDoc *d = b ? &b->doc : NULL;
    const RtxPageStore *st = d ? &d->tree.store : NULL;
    const RtxMarkupWin *last = NULL;
    size_t live = 0, si, livew = 0, walk = 0, wi;
    size_t from = 0, to = 0, plo = 0, phi = 0;
    int have = 0, covered = 0;
    const char *store = "-";
    const char *kindn = "unk";
    const char *findst = "walk";
    if (!fp) fp = stdout;
    if (st && st->slots) {
        for (si = 0; si < st->slot_n; si++)
            if (st->slots[si].file_id >= 0) live++;
    }
    if (d) {
        rtx_nav_brace_pages(d->caret, d->len(), &from, &to);
        have = rtx_nav_pair_ends((void *)&d->tree, d->runs.data, d->runs.len,
                                 d->caret, d->edit_gen, d->runs.len, &plo, &phi);
        covered = d->index_covers(d->caret);
        for (wi = 0; wi < (size_t)RTX_MARKUP_CACHE_WINDOWS; wi++) {
            const RtxMarkupWin *mw = &d->hl_win[wi];
            if (!mw->live) continue;
            livew++;
            if (!mw->ready) walk++;
            if (!last || mw->stamp >= last->stamp) last = mw;
        }
    }
    if (st && st->orig_open && st->add_open) store = "orig+add";
    else if (st && st->orig_open) store = "orig";
    else if (st && st->add_open) store = "add";
    fputc('{', fp);
    fputs("\"file\":{", fp);
    fprintf(fp, "\"bytes\":%zu,\"caret\":%zu,", d ? d->len() : (size_t)0,
            d ? d->caret : (size_t)0);
    fprintf(fp, "\"pages_live\":%zu,\"pages_slots\":%zu,\"store\":\"%s\"", live,
            st ? st->slot_n : (size_t)0, store);
    fputs("},\"lines\":{", fp);
    fprintf(fp,
            "\"scan_off\":%zu,\"scan_line\":%zu,\"lf_ready\":%s,"
            "\"line_off_len\":%zu,\"caret_index\":\"%s\"",
            d ? d->tree.line_scan_off : (size_t)0,
            d ? d->tree.scan_line : (size_t)0,
            d && d->tree.lf_ready ? "true" : "false",
            d ? d->tree.line_off_len : (size_t)0, covered ? "known" : "gap");
    if (b && b->seek_valid)
        fprintf(fp, ",\"seek_off\":%zu,\"seek_rel\":%ld", b->seek_off, b->seek_rel);
    else
        fputs(",\"seek_off\":null,\"seek_rel\":null", fp);
    if (d && rtx_line_isle_live(&d->tree)) {
        fprintf(fp,
                ",\"island\":{\"from\":%zu,\"anchor\":%zu,\"connected\":%s,"
                "\"pumping\":%s}",
                d->tree.isle_from, d->tree.isle_anchor,
                rtx_line_isle_connected(&d->tree) ? "true" : "false",
                rtx_line_isle_pumping(&d->tree) ? "true" : "false");
    } else {
        fputs(",\"island\":null", fp);
    }
    fputs("},\"grammar\":{", fp);
    fprintf(fp,
            "\"runs\":%zu,\"secs\":%zu,\"folds\":%zu,\"windows_live\":%zu,"
            "\"windows_cap\":%d,\"windows_walk\":%zu,\"hl_full\":%s,\"tm_ckpt\":%zu,"
            "\"rx_budget\":%zu,\"rx_errors\":%zu",
            d ? d->runs.len : (size_t)0, d ? d->secs.len : (size_t)0,
            d ? d->fold_n : (size_t)0, livew, RTX_MARKUP_CACHE_WINDOWS, walk,
            d && d->hl_full ? "true" : "false", d ? d->tm_ckpt.len : (size_t)0,
            rtx_rx_budget_hits(), rtx_tm_rx_errors);
    /* Registry: grammars listed by the dir scan, how many a document has
     * needed so far (loaded + compiled lazily), and the time both took. */
    fprintf(fp, ",\"langs\":%zu,\"langs_loaded\":%zu,\"load_us\":%zu", rtx_tm_nlangs,
            rtx_tm_nready, rtx_tm_load_us);
    if (last) {
        if (last->kind == RTX_SEC_CODE) kindn = "code";
        else if (last->kind == RTX_SEC_PROSE) kindn = "prose";
        else if (last->kind == RTX_SEC_MARKUP) kindn = "markup";
        fprintf(fp,
                ",\"last\":{\"from\":%zu,\"to\":%zu,\"kind\":\"%s\","
                "\"ready\":%s}",
                last->from, last->to, kindn, last->ready ? "true" : "false");
    } else {
        fputs(",\"last\":null", fp);
    }
    fputc('}', fp);
    if (d && d->find.query.len) {
        if (d->find.done) findst = d->find.truncated ? "trunc" : "done";
        fprintf(fp,
                ",\"find\":{\"hits\":%zu,\"scan_off\":%zu,\"done\":%s,"
                "\"truncated\":%s,\"state\":\"%s\",\"opts\":%u,\"long\":%zu,"
                "\"long_off\":%zu,\"err\":%s}",
                rtx_find_hits_n(&d->find), d->find.scan_off, d->find.done ? "true" : "false",
                d->find.truncated ? "true" : "false", findst, d->find.opts,
                (size_t)d->find.long_n, (size_t)d->find.long_off,
                d->find.err ? "true" : "false");
    } else {
        fputs(",\"find\":null", fp);
    }
    fputs(",\"pair\":{", fp);
    fprintf(fp, "\"span\":%zu,", to > from ? to - from : (size_t)0);
    if (have)
        fprintf(fp, "\"match\":[%zu,%zu]", plo, phi);
    else
        fputs("\"match\":null", fp);
    fputs("}}\n", fp);
    fflush(fp);
}

/* `slides`: the deck outline, one line per slide — number, 1-based line
 * of its first byte, build steps, transition into it, title
 * (docs/slides.md). */
static int rtx_batch_slides(RtxWs *w, FILE *out, FILE *err) {
    static const char *const trn[] = {"none", "fade", "fade-out", "slide", "push",
                                      "cover", "reveal", "wipe", "zoom", "morph", "frag"};
    RtxBuf *b = rtx_batch_buf(w);
    const RtxDeck *k;
    size_t i;
    if (!b || !out) return rtx_batch_fail(err, "slides: no buffer");
    k = rtx_deck_for(&b->doc);
    if (!k) return rtx_batch_fail(err, "slides: not a Marp deck (front matter needs marp: true)");
    size_t at = 0, lines = 0;
    fprintf(out, "# %zu slides%s  theme %s  %dx%d\n", k->n, k->complete ? "" : " (prefix)",
            k->theme, k->w, k->h);
    for (i = 0; i < k->n; i++) {
        const RtxSlide *s = &k->s[i];
        char title[160];
        size_t tn = s->title_hi > s->title_lo ? s->title_hi - s->title_lo : 0, got = 0, line;
        int tr = s->dir.trans < (int)(sizeof trn / sizeof trn[0]) ? s->dir.trans : 0;
        if (tn >= sizeof title) tn = sizeof title - 1;
        {
            @errhandler(CCError e) {
                (void)e;
                got = 0;
            }
            if (tn) got = b->doc.read_at(s->title_lo, cc_slice_from_buffer(title, tn)) !>;
        }
        title[got] = 0;
        {
            /* Newlines since the last slide (the deck is a bounded prefix;
             * no line index needed). */
            char chunk[8192];
            while (at < s->sep) {
                size_t take = s->sep - at > sizeof chunk ? sizeof chunk : s->sep - at, q;
                size_t n = 0;
                {
                    @errhandler(CCError e) {
                        return rtx_batch_fail(err, e.message ? e.message : "slides");
                    }
                    n = b->doc.read_at(at, cc_slice_from_buffer(chunk, take)) !>;
                }
                if (!n) break;
                for (q = 0; q < n; q++) lines += chunk[q] == '\n';
                at += n;
            }
            line = lines;
        }
        fprintf(out, "%zu\t%zu\t%d\t%s\t%s\n", i + 1, line + 1, s->nfrag, trn[tr], title);
    }
    fflush(out);
    return RTX_BATCH_OK;
}

int rtx_batch_exec(RtxWs *w, const char *line, FILE *out, FILE *err) {
    char cmd[32];
    const char *rest = NULL;
    const char *s;
    if (!out) out = stdout;
    if (!err) err = stderr;
    if (!line) return RTX_BATCH_OK;
    s = rtx_batch_skip_ws(line);
    if (!s[0] || s[0] == '#') return RTX_BATCH_OK;
    if (!rtx_batch_word(s, cmd, sizeof(cmd), &rest))
        return rtx_batch_fail(err, "empty command");
    {
        CCSlice c = cc_slice_cstr(cmd);
        if (c.eq_cstr("goto")) return rtx_batch_goto(w, rest, err);
        if (c.eq_cstr("await")) return rtx_batch_await(w, rest, err);
        if (c.eq_cstr("print")) return rtx_batch_print(w, rest, out, err);
        if (c.eq_cstr("slides")) return rtx_batch_slides(w, out, err);
        if (c.eq_cstr("read")) return rtx_batch_read(w, rest, out, err);
        if (c.eq_cstr("insert")) return rtx_batch_insert(w, rest, err);
        if (c.eq_cstr("save")) return rtx_batch_save(w, err);
        if (c.eq_cstr("replace")) return rtx_batch_replace(w, rest, out, err);
        if (c.eq_cstr("undo")) return rtx_batch_undo(w, 0, err);
        if (c.eq_cstr("redo")) return rtx_batch_undo(w, 1, err);
        if (c.eq_cstr("project-files")) return rtx_batch_project_files(w, rest, out, err);
        if (c.eq_cstr("project-search")) return rtx_batch_project_search(w, rest, out, err);
        if (c.eq_cstr("project-index")) return rtx_batch_project_index(w, rest, out, err);
        if (c.eq_cstr("stats-json") || c.eq_cstr("stats_json")) {
            rtx_batch_write_stats_json(out, rtx_batch_buf(w));
            return RTX_BATCH_OK;
        }
        if (c.eq_cstr("quit") || c.eq_cstr("q"))
            return RTX_BATCH_QUIT;
    }
    return rtx_batch_fail(err, "unknown command");
}

int rtx_batch_run(RtxWs *w, char **cmds, int n, FILE *out, FILE *err) {
    int i;
    if (!w) return 1;
    for (i = 0; i < n; i++) {
        int rc = rtx_batch_exec(w, cmds[i], out, err);
        if (rc == RTX_BATCH_QUIT) break;
        if (rc == RTX_BATCH_ERR) {
            rtx_batch_project_close();
            return 1;
        }
    }
    rtx_batch_project_close();
    return 0;
}

int rtx_batch_run_fp(RtxWs *w, FILE *fp, FILE *out, FILE *err) {
    char line[4096];
    if (!w || !fp) return 1;
    while (fgets(line, sizeof(line), fp)) {
        size_t n = cc_slice_cstr(line).len;
        while (n > 0 && (line[n - 1] == '\n' || line[n - 1] == '\r'))
            line[--n] = 0;
        {
            int rc = rtx_batch_exec(w, line, out, err);
            if (rc == RTX_BATCH_QUIT) break;
            if (rc == RTX_BATCH_ERR) {
                rtx_batch_project_close();
                return 1;
            }
        }
    }
    rtx_batch_project_close();
    return 0;
}
