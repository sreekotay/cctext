#!ccc cch
/*
 * Selection, undo/redo, save, and typed edits. Insert/erase on the tree
 * stay the primitives; every user-facing change is a replace recorded
 * on the history stack.
 */
#ifndef RTX_EDIT_H
#define RTX_EDIT_H

#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <fcntl.h>
#include <sys/stat.h>
#include <unistd.h>

static int RtxDoc_dirty(const RtxDoc *d) {
    return d && d->hist.head != d->saved_head;
}

static int RtxDoc_has_sel(const RtxDoc *d) {
    if (!d) return 0;
    if (d->sel_box) {
        if (d->sel_anchor != d->caret) return 1;
        return d->box_acol != d->box_ccol;
    }
    return d->sel_anchor != d->caret;
}

static size_t RtxDoc_sel_lo(const RtxDoc *d) {
    if (!d) return 0;
    return d->sel_anchor < d->caret ? d->sel_anchor : d->caret;
}

static size_t RtxDoc_sel_hi(const RtxDoc *d) {
    if (!d) return 0;
    return d->sel_anchor > d->caret ? d->sel_anchor : d->caret;
}

static void RtxDoc_clear_sel(RtxDoc *d) {
    if (!d) return;
    d->sel_anchor = d->caret;
    d->sel_box = 0;
}

static void RtxDoc_select_all(RtxDoc *d) {
    if (!d) return;
    d->sel_anchor = 0;
    d->caret = d->len();
    d->sel_box = 0;
    RtxDoc_break_coalesce(d);
}

#define RTX_COL_EOL ((size_t)-1)

static size_t !>(RtxIndexErr) rtx_doc_line_end_caret(const RtxDoc *d, size_t off) {
    size_t line, nlines, start, end;
    char ch;
    size_t got;
    if (!d) return cc_ok((size_t)0);
    line = d->line_of(off) !>(e) { return cc_err(e); };
    nlines = d->line_count();
    start = d->line_start(line) !>(e) { return cc_err(e); };
    if (line + 1 >= nlines) end = d->len();
    else end = d->line_start(line + 1) !>(e) { return cc_err(e); };
    if (end <= start) return cc_ok(end);
    got = d->read_at(end - 1, &ch, 1) !>(e) {
        return cc_err(rtx_index_from_cc(e));
    };
    if (got == 1 && ch == '\n') return cc_ok(end - 1);
    return cc_ok(end);
}

static size_t !>(RtxIndexErr) rtx_doc_line_nlen(const RtxDoc *d, size_t line) {
    size_t s, e;
    if (!d) return cc_ok((size_t)0);
    s = d->line_start(line) !>(e) { return cc_err(e); };
    e = rtx_doc_line_end_caret(d, s) !>(e) { return cc_err(e); };
    return cc_ok(e - s);
}

static size_t !>(RtxIndexErr) rtx_box_col_on_line(const RtxDoc *d, size_t line, size_t col) {
    size_t n = rtx_doc_line_nlen(d, line) !>(e) { return cc_err(e); };
    if (col == RTX_COL_EOL || col > n) return cc_ok(n);
    return cc_ok(col);
}

static void !>(RtxIndexErr) rtx_box_span_on_line(const RtxDoc *d, size_t line, size_t *a, size_t *b) {
    size_t n, lo, hi;
    n = rtx_doc_line_nlen(d, line) !>(e) { return cc_err(e); };
    lo = d->box_acol;
    hi = d->box_ccol;
    if (lo > hi) {
        size_t t = lo;
        lo = hi;
        hi = t;
    }
    if (lo == RTX_COL_EOL) lo = n;
    if (hi == RTX_COL_EOL) hi = n;
    if (lo > n) lo = n;
    if (hi > n) hi = n;
    *a = lo;
    *b = hi;
    return cc_ok();
}

static void !>(RtxIndexErr) rtx_doc_box_lines(const RtxDoc *d, size_t *l0, size_t *l1) {
    size_t a, c;
    a = d->line_of(d->sel_anchor) !>(e) { return cc_err(e); };
    c = d->line_of(d->caret) !>(e) { return cc_err(e); };
    *l0 = a < c ? a : c;
    *l1 = a > c ? a : c;
    return cc_ok();
}

static int !>(RtxIndexErr) RtxDoc_sel_covers(const RtxDoc *d, size_t off) {
    size_t l0, l1, line, start, a, b, col;
    if (!d || !d->has_sel()) return cc_ok(0);
    if (!d->sel_box) {
        return cc_ok(off >= d->sel_lo() && off < d->sel_hi() ? 1 : 0);
    }
    line = d->line_of(off) !>(e) { return cc_err(e); };
    rtx_doc_box_lines(d, &l0, &l1) !>(e) { return cc_err(e); };
    if (line < l0 || line > l1) return cc_ok(0);
    start = d->line_start(line) !>(e) { return cc_err(e); };
    rtx_box_span_on_line(d, line, &a, &b) !>(e) { return cc_err(e); };
    col = off - start;
    return cc_ok(col >= a && col < b ? 1 : 0);
}

static void rtx_box_nth_part(char[:] ins, size_t idx, char[:] *out) {
    size_t i, start, n;
    *out = cc_slice_empty();
    if (!ins.ptr) return;
    start = 0;
    n = 0;
    for (i = 0; i <= ins.len; i++) {
        if (i == ins.len || ins.ptr[i] == '\n') {
            if (n == idx) {
                *out = cc_slice_from_buffer((char *)ins.ptr + start, i - start);
                return;
            }
            n++;
            start = i + 1;
        }
    }
}

static size_t rtx_box_part_count(char[:] ins) {
    size_t i, n;
    if (!ins.ptr || ins.len == 0) return 1;
    n = 1;
    for (i = 0; i < ins.len; i++) {
        if (ins.ptr[i] == '\n') n++;
    }
    if (ins.ptr[ins.len - 1] == '\n' && n > 1) n--;
    return n;
}

/* to_end 0 = start of line, 1 = end. shift extends the selection. */
static void !>(RtxIndexErr) RtxDoc_move_line_edge(RtxDoc *d, int to_end, int shift) {
    size_t dest;
    if (!d) return cc_ok();
    if (to_end) dest = rtx_doc_line_end_caret(d, d->caret) !>(e) { return cc_err(e); };
    else {
        size_t ln = d->line_of(d->caret) !>(e) { return cc_err(e); };
        dest = d->line_start(ln) !>(e) { return cc_err(e); };
    }
    if (!shift) d->sel_anchor = dest;
    d->caret = dest;
    RtxDoc_break_coalesce(d);
    return cc_ok();
}

static int rtx_bytes_touch_markup(const char *p, size_t n) {
    size_t i;
    if (!p) return 0;
    for (i = 0; i < n; i++) {
        char c = p[i];
        if (c == '=' || c == '*' || c == '`') return 1;
    }
    return 0;
}

static void rtx_hist_drop_tail(RtxHistory *h) {
    if (!h || h->head >= h->len) return;
    h->len = h->head;
}

static void !>(CCError) rtx_hist_grow(RtxDoc *d) {
    return rtx_arena_grow(&d->session, (void **)&d->hist.recs, &d->hist.cap,
                          d->hist.len + 1, sizeof(RtxHistRec));
}

static int rtx_hist_can_coalesce_insert(const RtxHistRec *r, size_t off, char[:] ins) {
    if (!r || r->del_ref_n || r->del_used != 0 || ins.len == 0) return 0;
    if (off != r->off + r->ins_used) return 0;
    if (memchr(r->ins.ptr, '\n', r->ins_used) || memchr(ins.ptr, '\n', ins.len)) return 0;
    return 1;
}

static int rtx_hist_can_coalesce_erase(const RtxHistRec *r, size_t off, char[:] del) {
    if (!r || r->del_ref_n || r->ins_used != 0 || del.len == 0) return 0;
    if (del.len > RTX_HIST_INLINE_MAX) return 0;
    if (r->del_used + del.len > RTX_HIST_INLINE_MAX) return 0;
    if (off + del.len != r->off) return 0;
    if (memchr(r->del.ptr, '\n', r->del_used) || memchr(del.ptr, '\n', del.len)) return 0;
    return 1;
}

static char[:] rtx_hist_ins_view(const RtxHistRec *r) {
    if (!r || !r->ins.ptr || r->ins_used == 0) return cc_slice_empty();
    return r->ins.sub(0, r->ins_used);
}

static char[:] rtx_hist_del_view(const RtxHistRec *r) {
    if (!r || !r->del.ptr || r->del_used == 0) return cc_slice_empty();
    return r->del.sub(0, r->del_used);
}

/* Ensure capacity buffer has room for `need` logical bytes; keeps prior used. */
static void !>(CCError) rtx_hist_bytes_reserve(RtxDoc *d, char[:] *slot, size_t *used,
                                               size_t *cap, size_t need) {
    char[:] neu;
    size_t c;
    if (!d || !slot || !used || !cap) return cc_err(CC_ERR_INVALID_ARG, "hist reserve");
    if (need <= *cap && slot->ptr) return cc_ok();
    c = *cap ? *cap : 32;
    while (c < need) {
        size_t next = c * 2;
        if (next < c) return cc_err(CC_ERR_OUT_OF_MEMORY, "hist overflow");
        c = next;
    }
    neu = rtx_session_bytes(d, NULL, c) !>(e) { return cc_err(e); };
    if (*used && slot->ptr) memcpy(neu.ptr, slot->ptr, *used);
    *slot = neu;
    *cap = c;
    return cc_ok();
}

/* Reserve only — used is unchanged so a failed replace leaves hist intact. */
static void !>(CCError) rtx_hist_coalesce_ins_reserve(RtxDoc *d, RtxHistRec *last,
                                                      size_t add) {
    return rtx_hist_bytes_reserve(d, &last->ins, &last->ins_used, &last->ins_cap,
                                  last->ins_used + add);
}

static void rtx_hist_coalesce_ins_commit(RtxHistRec *last, char[:] ins) {
    memcpy(last->ins.ptr + last->ins_used, ins.ptr, ins.len);
    last->ins_used += ins.len;
}

static void !>(CCError) rtx_hist_coalesce_del_reserve(RtxDoc *d, RtxHistRec *last,
                                                      size_t add) {
    return rtx_hist_bytes_reserve(d, &last->del, &last->del_used, &last->del_cap,
                                  last->del_used + add);
}

static void rtx_hist_coalesce_del_commit(RtxHistRec *last, char[:] del) {
    memmove(last->del.ptr + del.len, last->del.ptr, last->del_used);
    memcpy(last->del.ptr, del.ptr, del.len);
    last->del_used += del.len;
    last->del_n = last->del_used;
}

static void !>(CCError) RtxDoc_replace(RtxDoc *d, size_t off, size_t n, char[:] ins) {
    char[:] del = cc_slice_empty();
    RtxHistRec rec;
    RtxHistRec *last = NULL;
    size_t len;
    size_t caret0;
    size_t sel0;
    int markup;
    int coalesced = 0;
    if (!d) return cc_err(CC_ERR_INVALID_ARG, "null doc");
    if (d->broken) return cc_err(CC_ERR_INTERNAL, "doc broken");
    len = d->len();
    if (off > len || n > len - off) return cc_err(CC_ERR_INVALID_ARG, "replace range");
    if (n == 0 && ins.len == 0) return cc_ok();
    caret0 = d->caret;
    sel0 = d->sel_anchor;
    memset(&rec, 0, sizeof(rec));
    rec.sel_box_before = d->sel_box;
    rec.box_acol_before = d->box_acol;
    rec.box_ccol_before = d->box_ccol;
    {
        cc_arena_stack(scratch, RTX_FRAME_SCRATCH);
        int del_on_session = 0;
        if (n && n <= RTX_HIST_INLINE_MAX) {
            if (n <= RTX_FRAME_SCRATCH) {
                char[:] got = d->scratch_span(&scratch, off, n) !>(e) {
                    return cc_err(e);
                };
                del = got;
            } else {
                char[:] got = rtx_session_bytes(d, NULL, n) !>(e) {
                    return cc_err(e);
                };
                {
                    size_t nr = d->read_at(off, got.ptr, n) !>(e) { return cc_err(e); };
                    if (nr != n) return cc_err(CC_ERR_INTERNAL, "replace del read");
                }
                del = got;
                del_on_session = 1;
            }
        }
        markup = (n > RTX_HIST_INLINE_MAX) ||
                 rtx_bytes_touch_markup(del.ptr, del.len) ||
                 rtx_bytes_touch_markup(ins.ptr, ins.len);
        if (!d->hist.applying) {
            if (d->hist.coalesce && d->hist.head > 0) {
                last = &d->hist.recs[d->hist.head - 1];
                if (rtx_hist_can_coalesce_insert(last, off, ins)) {
                    rtx_hist_coalesce_ins_reserve(d, last, ins.len) !>(e) {
                        return cc_err(e);
                    };
                    coalesced = 1;
                } else if (rtx_hist_can_coalesce_erase(last, off, del)) {
                    rtx_hist_coalesce_del_reserve(d, last, del.len) !>(e) {
                        return cc_err(e);
                    };
                    coalesced = 2;
                }
            }
            if (!coalesced) {
                rec.del_n = n;
                if (n > RTX_HIST_INLINE_MAX) {
                    RtxPieceTree_capture_range(&d->tree, off, n, &d->session,
                                               &rec.del_refs, &rec.del_ref_n) !>(e) {
                        return cc_err(e);
                    };
                } else if (del.len) {
                    if (del_on_session) rec.del = del;
                    else {
                        rec.del = rtx_session_bytes(d, del.ptr, del.len) !>(e) {
                            return cc_err(e);
                        };
                    }
                    rec.del_used = del.len;
                    rec.del_cap = rec.del.len;
                }
                if (ins.len) {
                    rec.ins = rtx_session_bytes(d, ins.ptr, ins.len) !>(e) {
                        return cc_err(e);
                    };
                    rec.ins_used = ins.len;
                    rec.ins_cap = ins.len;
                }
                rtx_hist_grow(d) !>(e) { return cc_err(e); };
            }
        }
        d->tree.replace(off, n, ins) !>(e) {
            if (rtx_err_is_unrestorable(e)) d->broken = 1;
            return cc_err(e);
        };
        d->edit_gen++;
        rtx_doc_shift_intervals(d, off, n, ins.len);
        d->find_invalidate();
        d->last_off = off;
        d->last_markup = markup;
        d->caret = off + ins.len;
        d->sel_anchor = d->caret;
        d->sel_box = 0;
        d->box_acol = 0;
        d->box_ccol = 0;
        if (!d->hist.applying) {
            if (coalesced == 1 && last) {
                rtx_hist_coalesce_ins_commit(last, ins);
                last->caret_after = d->caret;
                last->sel_after = d->sel_anchor;
                last->sel_box_after = d->sel_box;
                last->box_acol_after = d->box_acol;
                last->box_ccol_after = d->box_ccol;
            } else if (coalesced == 2 && last) {
                rtx_hist_coalesce_del_commit(last, del);
                last->off = off;
                last->caret_after = d->caret;
                last->sel_after = d->sel_anchor;
                last->sel_box_after = d->sel_box;
                last->box_acol_after = d->box_acol;
                last->box_ccol_after = d->box_ccol;
            } else {
                rtx_hist_drop_tail(&d->hist);
                rec.off = off;
                rec.caret_before = caret0;
                rec.sel_before = sel0;
                rec.caret_after = d->caret;
                rec.sel_after = d->sel_anchor;
                rec.sel_box_after = d->sel_box;
                rec.box_acol_after = d->box_acol;
                rec.box_ccol_after = d->box_ccol;
                d->hist.recs[d->hist.len++] = rec;
                d->hist.head = d->hist.len;
            }
            d->hist.coalesce = 1;
        }
        return cc_ok();
    }
}

static void !>(CCError) RtxDoc_insert(RtxDoc *d, size_t off, char[:] bytes) {
    return RtxDoc_replace(d, off, 0, bytes);
}

static void !>(CCError) RtxDoc_erase(RtxDoc *d, size_t off, size_t n) {
    return RtxDoc_replace(d, off, n, cc_slice_empty());
}

static int !>(RtxIndexErr) rtx_doc_line_has_nl(const RtxDoc *d, size_t line) {
    size_t nlines, s, e, next;
    nlines = d->line_count();
    s = d->line_start(line) !>(e) { return cc_err(e); };
    e = rtx_doc_line_end_caret(d, s) !>(e) { return cc_err(e); };
    if (line + 1 < nlines) next = d->line_start(line + 1) !>(e) { return cc_err(e); };
    else next = d->len();
    return cc_ok(next > e ? 1 : 0);
}

static char[:] !>(CCError) rtx_doc_box_text(RtxDoc *d, CCArena *a) {
    size_t l0, l1, i, need, used;
    char *p;
    @errhandler(CCError e) {
        return cc_err(e);
    }
    @errhandler(RtxIndexErr ie) {
        return cc_err(CC_ERR_IO, ie.message ? ie.message : "line index");
    }
    if (!d || !a) return cc_err(CC_ERR_INVALID_ARG, "box text");
    rtx_doc_box_lines(d, &l0, &l1) !>;
    need = 0;
    for (i = l0; i <= l1; i++) {
        size_t a0, b0;
        rtx_box_span_on_line(d, i, &a0, &b0) !>;
        need += b0 - a0;
        if (i < l1) need += 1;
    }
    if (need == 0) return cc_ok(cc_slice_empty());
    p = (char *)cc_arena_alloc(a, need, 1);
    if (!p) return cc_err(CC_ERR_OUT_OF_MEMORY, "box text");
    used = 0;
    for (i = l0; i <= l1; i++) {
        size_t start, a0, b0;
        start = d->line_start(i) !>;
        rtx_box_span_on_line(d, i, &a0, &b0) !>;
        if (b0 > a0) {
            size_t got = d->read_at(start + a0, p + used, b0 - a0) !>;
            if (got != b0 - a0) return cc_err(CC_ERR_INTERNAL, "box text read");
            used += got;
        }
        if (i < l1) p[used++] = '\n';
    }
    return cc_ok(cc_slice_from_buffer(p, used));
}

static void !>(CCError) rtx_doc_box_apply(RtxDoc *d, char[:] ins) {
    size_t l0, l1, nlines, i, off0, off1, need, used, dest_col, parts;
    size_t keep_l0, keep_l1;
    char *p;
    CCArena a = {0} @destroy;
    char[:] built;
    @errhandler(CCError e) {
        return cc_err(e);
    }
    @errhandler(RtxIndexErr ie) {
        return cc_err(CC_ERR_IO, ie.message ? ie.message : "line index");
    }
    if (!d) return cc_err(CC_ERR_INVALID_ARG, "box apply");
    rtx_doc_box_lines(d, &l0, &l1) !>;
    nlines = d->line_count();
    off0 = d->line_start(l0) !>;
    if (l1 + 1 < nlines) off1 = d->line_start(l1 + 1) !>;
    else off1 = d->len();
    parts = rtx_box_part_count(ins);
    need = 1;
    for (i = l0; i <= l1; i++) {
        size_t nlen, a0, b0;
        char[:] part;
        nlen = rtx_doc_line_nlen(d, i) !>;
        rtx_box_span_on_line(d, i, &a0, &b0) !>;
        if (parts <= 1) part = ins;
        else rtx_box_nth_part(ins, i - l0, &part);
        need += a0 + part.len + (nlen - b0) + 1;
    }
    a = cc_arena_heap(need + 64);
    if (!a.base) return cc_err(CC_ERR_OUT_OF_MEMORY, "box apply");
    p = (char *)cc_arena_alloc(&a, need, 1);
    if (!p) return cc_err(CC_ERR_OUT_OF_MEMORY, "box apply");
    used = 0;
    dest_col = 0;
    for (i = l0; i <= l1; i++) {
        size_t start, nlen, a0, b0;
        char[:] part;
        start = d->line_start(i) !>;
        nlen = rtx_doc_line_nlen(d, i) !>;
        rtx_box_span_on_line(d, i, &a0, &b0) !>;
        if (parts <= 1) part = ins;
        else rtx_box_nth_part(ins, i - l0, &part);
        if (i == l0) dest_col = a0 + part.len;
        if (a0) {
            size_t got = d->read_at(start, p + used, a0) !>;
            if (got != a0) return cc_err(CC_ERR_INTERNAL, "box apply read");
            used += got;
        }
        if (part.len && part.ptr) {
            memcpy(p + used, part.ptr, part.len);
            used += part.len;
        }
        if (nlen > b0) {
            size_t got = d->read_at(start + b0, p + used, nlen - b0) !>;
            if (got != nlen - b0) return cc_err(CC_ERR_INTERNAL, "box apply read");
            used += got;
        }
        if (rtx_doc_line_has_nl(d, i) !>) p[used++] = '\n';
    }
    built = cc_slice_from_buffer(p, used);
    keep_l0 = l0;
    keep_l1 = l1;
    d->replace(off0, off1 - off0, built) !>;
    d->sel_box = 1;
    d->box_acol = dest_col;
    d->box_ccol = dest_col;
    {
        size_t a0 = d->line_start(keep_l0) !>;
        size_t a1 = d->line_start(keep_l1) !>;
        size_t c0 = rtx_box_col_on_line(d, keep_l0, dest_col) !>;
        size_t c1 = rtx_box_col_on_line(d, keep_l1, dest_col) !>;
        d->sel_anchor = a0 + c0;
        d->caret = a1 + c1;
    }
    if (d->hist.head > 0) {
        RtxHistRec *r = &d->hist.recs[d->hist.head - 1];
        r->caret_after = d->caret;
        r->sel_after = d->sel_anchor;
        r->sel_box_after = d->sel_box;
        r->box_acol_after = d->box_acol;
        r->box_ccol_after = d->box_ccol;
    }
    return cc_ok();
}

static void !>(CCError) RtxDoc_type(RtxDoc *d, char[:] bytes) {
    if (!d) return cc_err(CC_ERR_INVALID_ARG, "null doc");
    if (d->sel_box && d->has_sel()) return rtx_doc_box_apply(d, bytes);
    if (d->has_sel()) {
        size_t lo = d->sel_lo();
        size_t hi = d->sel_hi();
        return d->replace(lo, hi - lo, bytes);
    }
    return d->replace(d->caret, 0, bytes);
}

static void !>(CCError) RtxDoc_type_cp(RtxDoc *d, uint32_t cp) {
    char buf[4];
    int n = rtx_utf8_encode(cp, buf);
    if (n <= 0) return cc_ok();
    return d->type(buf.to_slice_n((size_t)n));
}

static void !>(CCError) RtxDoc_backspace(RtxDoc *d) {
    @errhandler(RtxIndexErr ie) {
        return cc_err(CC_ERR_IO, ie.message ? ie.message : "line index");
    }
    if (!d) return cc_err(CC_ERR_INVALID_ARG, "null doc");
    if (d->sel_box && d->has_sel()) {
        size_t l0, l1, a, b;
        rtx_doc_box_lines(d, &l0, &l1) !>;
        rtx_box_span_on_line(d, l0, &a, &b) !>;
        if (a == b) {
            if (a == 0) return cc_ok();
            {
                size_t start = d->line_start(l0) !>;
                size_t prev = d->cluster_prev(start + a) !>(e) { return cc_err(e); };
                if (prev < start) return cc_ok();
                d->box_acol = prev - start;
                d->box_ccol = a;
            }
        }
        return rtx_doc_box_apply(d, cc_slice_empty());
    }
    if (d->has_sel()) {
        size_t lo = d->sel_lo();
        size_t hi = d->sel_hi();
        return d->replace(lo, hi - lo, cc_slice_empty());
    }
    if (d->caret == 0) return cc_ok();
    {
        size_t a = d->cluster_align(d->caret) !>(e) { return cc_err(e); };
        if (a < d->caret) {
            size_t b = d->cluster_next(a) !>(e) { return cc_err(e); };
            if (b <= a) return cc_ok();
            return d->replace(a, b - a, cc_slice_empty());
        }
        {
            size_t prev = d->cluster_prev(d->caret) !>(e) { return cc_err(e); };
            if (prev >= d->caret) return cc_ok();
            return d->replace(prev, d->caret - prev, cc_slice_empty());
        }
    }
}

static void !>(CCError) RtxDoc_delete_forward(RtxDoc *d) {
    size_t len;
    @errhandler(RtxIndexErr ie) {
        return cc_err(CC_ERR_IO, ie.message ? ie.message : "line index");
    }
    if (!d) return cc_err(CC_ERR_INVALID_ARG, "null doc");
    if (d->sel_box && d->has_sel()) {
        size_t l0, l1, a, b;
        rtx_doc_box_lines(d, &l0, &l1) !>;
        rtx_box_span_on_line(d, l0, &a, &b) !>;
        if (a == b) {
            size_t start = d->line_start(l0) !>;
            size_t next = d->cluster_next(start + a) !>(e) { return cc_err(e); };
            size_t end = rtx_doc_line_end_caret(d, start) !>;
            if (next > end) next = end;
            d->box_acol = a;
            d->box_ccol = next - start;
        }
        return rtx_doc_box_apply(d, cc_slice_empty());
    }
    if (d->has_sel()) return d->backspace();
    len = d->len();
    if (d->caret >= len) return cc_ok();
    {
        size_t a = d->cluster_align(d->caret) !>(e) { return cc_err(e); };
        size_t b = d->cluster_next(a) !>(e) { return cc_err(e); };
        if (b <= a) return cc_ok();
        return d->replace(a, b - a, cc_slice_empty());
    }
}

static int RtxDoc_can_undo(const RtxDoc *d) {
    return d && d->hist.head > 0;
}

static int RtxDoc_can_redo(const RtxDoc *d) {
    return d && d->hist.head < d->hist.len;
}

static void !>(CCError) RtxDoc_undo(RtxDoc *d) {
    RtxHistRec *r;
    char[:] del;
    char[:] ins;
    size_t restore_n;
    if (!d) return cc_err(CC_ERR_INVALID_ARG, "null doc");
    if (d->broken) return cc_err(CC_ERR_INTERNAL, "doc broken");
    if (d->hist.head == 0) return cc_ok();
    r = &d->hist.recs[d->hist.head - 1];
    del = rtx_hist_del_view(r);
    ins = rtx_hist_ins_view(r);
    restore_n = r->del_n;
    d->hist.applying = 1;
    d->hist.coalesce = 0;
    if (r->del_ref_n) {
        d->tree.replace(r->off, ins.len, cc_slice_empty()) !>(e) {
            d->hist.applying = 0;
            if (rtx_err_is_unrestorable(e)) d->broken = 1;
            return cc_err(e);
        };
        RtxPieceTree_splice_refs(&d->tree, r->off, r->del_refs, r->del_ref_n) !>(e) {
            d->hist.applying = 0;
            d->broken = 1;
            return cc_err(RTX_ERR_UNRESTORABLE, "undo unrestorable");
        };
    } else {
        d->tree.replace(r->off, ins.len, del) !>(e) {
            d->hist.applying = 0;
            if (rtx_err_is_unrestorable(e)) d->broken = 1;
            return cc_err(e);
        };
    }
    d->edit_gen++;
    rtx_doc_shift_intervals(d, r->off, ins.len, restore_n);
    d->last_off = r->off;
    d->last_markup = r->del_ref_n ? 1 :
                     (rtx_bytes_touch_markup(del.ptr, del.len) ||
                      rtx_bytes_touch_markup(ins.ptr, ins.len));
    d->caret = r->caret_before;
    d->sel_anchor = r->sel_before;
    d->sel_box = r->sel_box_before;
    d->box_acol = r->box_acol_before;
    d->box_ccol = r->box_ccol_before;
    d->hist.head--;
    d->hist.applying = 0;
    d->find_invalidate();
    return cc_ok();
}

static void !>(CCError) RtxDoc_redo(RtxDoc *d) {
    RtxHistRec *r;
    char[:] del;
    char[:] ins;
    size_t erase_n;
    if (!d) return cc_err(CC_ERR_INVALID_ARG, "null doc");
    if (d->broken) return cc_err(CC_ERR_INTERNAL, "doc broken");
    if (d->hist.head >= d->hist.len) return cc_ok();
    r = &d->hist.recs[d->hist.head];
    del = rtx_hist_del_view(r);
    ins = rtx_hist_ins_view(r);
    erase_n = r->del_n;
    d->hist.applying = 1;
    d->hist.coalesce = 0;
    d->tree.replace(r->off, erase_n, ins) !>(e) {
        d->hist.applying = 0;
        if (rtx_err_is_unrestorable(e)) d->broken = 1;
        return cc_err(e);
    };
    d->edit_gen++;
    rtx_doc_shift_intervals(d, r->off, erase_n, ins.len);
    d->last_off = r->off;
    d->last_markup = r->del_ref_n ? 1 :
                     (rtx_bytes_touch_markup(del.ptr, del.len) ||
                      rtx_bytes_touch_markup(ins.ptr, ins.len));
    d->caret = r->caret_after;
    d->sel_anchor = r->sel_after;
    d->sel_box = r->sel_box_after;
    d->box_acol = r->box_acol_after;
    d->box_ccol = r->box_ccol_after;
    d->hist.head++;
    d->hist.applying = 0;
    d->find_invalidate();
    return cc_ok();
}

static void !>(CCError) RtxDoc_save_as(RtxDoc *d, const char *path) {
    char tmp[4096];
    char[:] new_path = cc_slice_empty();
    int fd;
    size_t n;
    mode_t mode = 0666;
    int have_mode = 0;
    if (!d || !path || !path[0]) return cc_err(CC_ERR_INVALID_ARG, "save path");
    if (d->broken) return cc_err(CC_ERR_INTERNAL, "doc broken");
    n = strlen(path);
    if (n + 16 >= sizeof(tmp)) return cc_err(CC_ERR_INVALID_ARG, "path too long");
    if (!d->path.ptr || !d->path.eq_cstr(path)) {
        new_path = rtx_session_str(d, path) !>(e) { return cc_err(e); };
    }
    {
        struct stat st;
        if (stat(path, &st) == 0) {
            mode = st.st_mode & 0777;
            have_mode = 1;
        }
    }
    snprintf(tmp, sizeof(tmp), "%s.tmp.XXXXXX", path);
    fd = mkstemp(tmp);
    if (fd < 0) return cc_err(CC_ERR_IO, "save open");
    @defer(err) unlink(tmp);
    if (have_mode && fchmod(fd, mode) != 0) {
        close(fd);
        return cc_err(CC_ERR_IO, "save fchmod");
    }
    d->tree.write_fd(fd) !>(e) {
        close(fd);
        return cc_err(e);
    };
    if (fsync(fd) != 0) {
        close(fd);
        return cc_err(CC_ERR_IO, "save fsync");
    }
    if (close(fd) != 0) return cc_err(CC_ERR_IO, "save close");
    if (rename(tmp, path) != 0) return cc_err(CC_ERR_IO, "save rename");
    /* Best-effort directory fsync so the rename itself is durable. */
    {
        char dirbuf[4096];
        char *slash;
        int dfd;
        if (n + 1 < sizeof(dirbuf)) {
            memcpy(dirbuf, path, n + 1);
            slash = strrchr(dirbuf, '/');
            if (slash && slash != dirbuf) {
                *slash = 0;
                dfd = open(dirbuf, O_RDONLY);
            } else {
                dfd = open(".", O_RDONLY);
            }
            if (dfd >= 0) {
                (void)fsync(dfd);
                close(dfd);
            }
        }
    }
    if (new_path.ptr) d->path = new_path;
    d->saved_head = d->hist.head;
    return cc_ok();
}

static void !>(CCError) RtxDoc_save(RtxDoc *d) {
    if (!d) return cc_err(CC_ERR_INVALID_ARG, "null doc");
    if (!d->path.ptr || d->path.len == 0) return cc_err(CC_ERR_INVALID_ARG, "untitled");
    return d->save_as(d->path.ptr);
}

static void !>(CCError) rtx_doc_hl_bytes(RtxDoc *d, char[:] bytes, size_t start,
                                        size_t lo, const RtxTmCkpt *seed,
                                        RtxTmWalk walk, size_t saved_runs,
                                        size_t saved_ckpt) {
    size_t lex = 0;
    if (walk == RTX_TM_LOOKBACK && start > 0 && bytes.len) {
        while (lex < bytes.len && bytes.ptr[lex] != '\n') lex++;
        if (lex < bytes.len && start + lex < lo) lex++;
        else lex = 0;
    }
    rtx_hl_range(d, bytes.ptr + lex, start + lex, bytes.len - lex, lo, seed,
                 walk) !>(e) {
        d->run_len = saved_runs;
        d->tm_ckpt_len = saved_ckpt;
        return cc_err(e);
    };
    return cc_ok();
}

static void !>(CCError) rtx_doc_highlight_span(RtxDoc *d, size_t lo, size_t hi) {
    size_t saved_runs;
    size_t saved_ckpt;
    size_t start;
    const RtxTmCkpt *seed;
    RtxTmWalk walk;
    if (!d || hi <= lo) return cc_ok();
    if (hi - lo > (size_t)RTX_HL_WIN_MAX) hi = lo + (size_t)RTX_HL_WIN_MAX;
    saved_runs = d->run_len;
    saved_ckpt = d->tm_ckpt_len;
    rtx_doc_clip_runs(d, lo, hi, rtx_run_is_hl_only) !>(e) {
        return cc_err(e);
    };
    saved_runs = d->run_len;
    seed = rtx_tm_ckpt_find(d, lo);
    if (seed && lo - seed->off <= (size_t)RTX_TM_CATCHUP_MAX) {
        start = seed->off;
        walk = RTX_TM_CATCHUP;
    } else if (!seed && lo <= (size_t)RTX_TM_CATCHUP_MAX) {
        start = 0;
        seed = NULL;
        walk = RTX_TM_CATCHUP;
    } else {
        start = lo > (size_t)RTX_MARKUP_LOOKBACK ? lo - (size_t)RTX_MARKUP_LOOKBACK
                                                 : 0;
        seed = NULL;
        walk = RTX_TM_LOOKBACK;
    }
    {
        size_t need = hi - start;
        size_t stack_n = (size_t)RTX_MARKUP_LOOKBACK + (size_t)RTX_FRAME_SCRATCH;
        if (need <= stack_n) {
            cc_arena_stack(scratch, RTX_MARKUP_LOOKBACK + RTX_FRAME_SCRATCH);
            char[:] bytes = d->scratch_span(&scratch, start, need) !>(e) {
                return cc_err(e);
            };
            rtx_doc_hl_bytes(d, bytes, start, lo, seed, walk, saved_runs,
                             saved_ckpt) !>(e) {
                return cc_err(e);
            };
        } else {
            CCArena frame = cc_arena_heap(need + 64);
            char[:] bytes;
            if (!frame.base) return cc_err(CC_ERR_OUT_OF_MEMORY, "hl frame");
            bytes = d->scratch_span(&frame, start, need) !>(e) {
                frame.destroy();
                return cc_err(e);
            };
            rtx_doc_hl_bytes(d, bytes, start, lo, seed, walk, saved_runs,
                             saved_ckpt) !>(e) {
                frame.destroy();
                return cc_err(e);
            };
            frame.destroy();
        }
    }
    return cc_ok();
}

static void !>(CCError) RtxDoc_reparse_edit(RtxDoc *d, size_t off, int full_markup) {
    size_t s, lo, hi, n, win_lo, win_hi, sec_n;
    if (!d) return cc_err(CC_ERR_INVALID_ARG, "null doc");
    if (full_markup) return d->reparse();
    n = d->len();
    if (off > n) off = n;
    lo = 0;
    hi = n;
    for (s = 0; s < d->sec_len; s++) {
        if (d->secs[s].start <= off) {
            lo = d->secs[s].start;
            hi = (s + 1 < d->sec_len) ? d->secs[s + 1].start : n;
        }
    }
    if (d->section_at(off) == RTX_SEC_CODE) {
        sec_n = hi > lo ? hi - lo : 0;
        if (sec_n <= RTX_HL_FULL_MAX) {
            rtx_doc_highlight_span(d, lo, hi) !>(e) { return cc_err(e); };
            for (s = 0; s < d->sec_len; s++) {
                if (d->secs[s].start == lo) d->secs[s].hl_done = 1;
            }
        } else {
            /* Large section: only re-lex a local window around the edit. */
            win_lo = off > 4096 ? off - 4096 : 0;
            win_hi = off + 8192;
            if (win_lo < lo) win_lo = lo;
            if (win_hi > hi) win_hi = hi;
            rtx_doc_highlight_span(d, win_lo, win_hi) !>(e) { return cc_err(e); };
        }
        rtx_doc_sort_runs(d);
    }
    return cc_ok();
}

static void !>(CCError) RtxDoc_ensure_hl(RtxDoc *d, RtxHlWin w) {
    size_t s, n, lo, hi, from, to, win_lo, win_hi, sec_n;
    if (!d) return cc_err(CC_ERR_INVALID_ARG, "null doc");
    from = w.from;
    to = from + w.n;
    if (d->hl_full || to <= from) return cc_ok();
    n = d->len();
    if (from > n) from = n;
    if (to > n) to = n;
    if (to > from && to - from > (size_t)RTX_HL_WIN_MAX) {
        to = from + (size_t)RTX_HL_WIN_MAX;
    }
    if (n > RTX_MARKUP_SCAN_MAX) {
        rtx_doc_window_markup(d, from, to) !>(e) { return cc_err(e); };
    }
    for (s = 0; s < d->sec_len; s++) {
        if (d->secs[s].kind != RTX_SEC_CODE || d->secs[s].hl_done) continue;
        lo = d->secs[s].start;
        hi = (s + 1 < d->sec_len) ? d->secs[s + 1].start : n;
        if (hi <= from || lo >= to) continue;
        sec_n = hi > lo ? hi - lo : 0;
        if (sec_n <= RTX_HL_FULL_MAX) {
            rtx_doc_highlight_span(d, lo, hi) !>(e) { return cc_err(e); };
            d->secs[s].hl_done = 1;
        } else {
            win_lo = from > lo ? from : lo;
            win_hi = to < hi ? to : hi;
            rtx_doc_highlight_span(d, win_lo, win_hi) !>(e) { return cc_err(e); };
        }
    }
    rtx_doc_sort_runs(d);
    return cc_ok();
}

#endif /* RTX_EDIT_H */
