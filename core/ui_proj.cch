#!ccc cch
/*
 * Project picker: the shared modal UI for quick-open (Ctrl-P / Cmd-P,
 * command "workspace.quick_open") and project search (Ctrl-Shift-F /
 * Cmd-Shift-F, "workspace.search"). Bodies in ui_proj.ccs (a second
 * source of the rtx_ui target). The engine is core/proj.cch; this face
 * owns the overlay state on RtxUi (`pick*`), the row text both hosts
 * paint, and the open / step actions. Hosts map keys and draw.
 *
 * The project opens lazily on the first Ctrl-P / Ctrl-Shift-F; the walk
 * runs in the background after that and the host pumps it each frame
 * (rtx_ui_pick_pump). Quick-open rescans as you type and as the index
 * grows; search restarts ~120 ms after the last keystroke (Enter runs it
 * now). Results live on the project, not the overlay: Esc keeps them,
 * F4 / Shift-F4 step them, Ctrl-Shift-F shows them again.
 */
#ifndef RTX_UI_PROJ_H
#define RTX_UI_PROJ_H

#include "workspace.cch"
#include "proj.cch"

enum {
    RTX_PICK_ROW_FILE = 0,  /* quick-open: a relative path */
    RTX_PICK_ROW_GROUP = 1, /* search: a file with its match count */
    RTX_PICK_ROW_HIT = 2,   /* search: line number + preview */
    RTX_PICK_ROW_TEXT = 512,
    RTX_PICK_DEBOUNCE_MS = 120
};

/* One painted row. mark[i] styles text[i]: 0 plain, 1 matched, 2 dim
 * (directory part, counts, line numbers). Control bytes are already
 * replaced (one byte each), so offsets are the source's. */
typedef struct {
    int kind;
    char text[RTX_PICK_ROW_TEXT];
    size_t n;
    unsigned char mark[RTX_PICK_ROW_TEXT];
} RtxPickRow;

/* Host startup: `project` (--project DIR) is the root as given (hosts
 * also pass it to rtx_safe_ws_set_project, so the session snapshot is
 * that project's); else the git root above `start` (the first file /
 * directory argument); with no argument the session's project. Resolved
 * now, opened on first use. */
void rtx_ui_proj_hint(RtxUi *ui, const char *project, const char *start);
/* Host exit: cancel + join the walk and search, free the project. */
void rtx_ui_proj_close(RtxUi *ui);

/* Ctrl-P (RTX_PICK_OPEN) / Ctrl-Shift-F (RTX_PICK_SEARCH). Ctrl-P while
 * quick-open is up moves down one row. */
void !>(CCError) rtx_ui_pick_start(RtxUi *ui, RtxWs *w, int mode);
void rtx_ui_pick_close(RtxUi *ui);
RtxField rtx_ui_pick_field(RtxUi *ui);
/* The field text changed: rescore (open) or arm the debounce (search). */
void !>(CCError) rtx_ui_pick_changed(RtxUi *ui);
/* Alt-C / Alt-W / Alt-R in search. 1 = handled. */
int !>(CCError) rtx_ui_pick_toggle(RtxUi *ui, int letter);
/* F5: re-walk the index (no file watcher). */
void !>(CCError) rtx_ui_pick_rewalk(RtxUi *ui);
/* Build / update the project search index in the background (opens the
 * project first); pick_msg says what happened. */
void !>(CCError) rtx_ui_proj_index(RtxUi *ui);
void !>(CCError) rtx_ui_proj_index_update(RtxUi *ui);
/* Every frame: join finished arms, start due work, fold new files into
 * the list. 1 = the overlay (or the status) should repaint. */
int !>(CCError) rtx_ui_pick_pump(RtxUi *ui);
/* The walk or a search still publishes, or a debounce is armed. */
int rtx_ui_pick_busy(const RtxUi *ui);
/* ms until the pump has work (0 = now), or -1 = nothing timed. */
long rtx_ui_pick_next_ms(const RtxUi *ui, long now);

size_t rtx_ui_pick_nrows(const RtxUi *ui);
size_t rtx_ui_pick_cur(const RtxUi *ui);
size_t rtx_ui_pick_top(const RtxUi *ui);
void rtx_ui_pick_move(RtxUi *ui, long delta, int vis);
/* Select row top + i (a click). 0 = past the end. */
int rtx_ui_pick_select(RtxUi *ui, size_t row, int vis);
/* Row text (0 = no such row). */
int rtx_ui_pick_row(RtxUi *ui, size_t row, RtxPickRow *out);
/* Header: counts, progress, options. */
void rtx_ui_pick_head(const RtxUi *ui, char *dst, size_t n);
/* Field label: "open" / "search". */
const char *rtx_ui_pick_label(const RtxUi *ui);

/* Enter (other = Ctrl-Enter / Alt-Enter: the other pane, split if
 * needed). Opens the file (search: at the match, selected, landed) and
 * closes the overlay. 1 = a file opened. */
int !>(CCError) rtx_ui_pick_accept(RtxUi *ui, RtxWs *w, int other, int vis);
/* F4 / Shift-F4: open the next / previous search result. 1 = opened. */
int !>(CCError) rtx_ui_psearch_step(RtxUi *ui, RtxWs *w, int dir, int vis);

#endif /* RTX_UI_PROJ_H */
