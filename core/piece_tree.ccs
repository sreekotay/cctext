#!ccc ccs
/*
 * Piece-tree implementation (linked TU; see piece_tree.cch).
 * RB + line index stay textual includes into this one unit.
 * Live origin + 1/32 pins: pins re-key mark_off/mark_line.
 */
#include <ccc/std/prelude.cch>
#include <errno.h>
#include <limits.h>
#include <unistd.h>
#include <time.h>

#include "piece_tree_priv.cch"

void rtx_line_index_note_insert(RtxPieceTree *t, size_t off, size_t ins_len,
                                size_t lf);
void rtx_line_index_note_erase(RtxPieceTree *t, size_t off, size_t n,
                               size_t lf);
void !>(CCError) rtx_isle_listing_start(RtxPieceTree *t);

size_t RtxPieceTree_len(const RtxPieceTree *t) {
    if (!t || !t->root) return 0;
    return t->root->subtree_len;
}

static double rtx_mono_ms(void) {
    struct timespec ts;
    if (clock_gettime(CLOCK_MONOTONIC, &ts) != 0) return 0.0;
    return (double)ts.tv_sec * 1000.0 + (double)ts.tv_nsec / 1.0e6;
}

#define RTX_BUSY_DELAY_MS 100.0

static void rtx_busy_end(RtxPieceTree *t) {
    if (!t || !t->busy_fn) return;
    t->busy_t0_ms = 0.0;
    /* A line already in the scan still calls end. The TUI hook erases
     * the spinner and drops the row cache. busy_last_ms stays 0 until
     * a pulse is actually shown. */
    if (t->busy_last_ms <= 0.0) return;
    t->busy_fn(t->busy_ctx, NULL, 100);
    t->busy_last_ms = 0.0;
}

/* Throttled progress. pct is 0..100, or -1 when total is unknown.
 * Mutates busy_last_ms — not const. */
static void rtx_busy_pulse(RtxPieceTree *t, const char *label, size_t done,
                           size_t total) {
    double now;
    int pct;
    if (!t || !t->busy_fn || !label) return;
    now = rtx_mono_ms();
    /* Nothing shown before an op has run RTX_BUSY_DELAY_MS: a short scan
     * (every open's first window) must not paint and erase a spinner
     * ahead of the first frame. */
    if (t->busy_last_ms <= 0.0) {
        if (t->busy_t0_ms <= 0.0) t->busy_t0_ms = now;
        if (now - t->busy_t0_ms < RTX_BUSY_DELAY_MS) return;
    }
    if (t->busy_last_ms > 0.0 && now - t->busy_last_ms < 50.0 &&
        !(total > 0 && done >= total)) {
        return;
    }
    t->busy_last_ms = now;
    if (total == 0) pct = -1;
    else pct = rtx_pct(done, total);
    t->busy_fn(t->busy_ctx, label, pct);
}

static size_t rtx_original_len(const RtxPieceTree *t) {
    if (!t) return 0;
    if (t->original.ptr) return t->original.len;
    return t->store.orig_len;
}

static int rtx_orig_is_mem(const RtxPieceTree *t) {
    return t && t->original.ptr != NULL;
}

/* Count newlines in a piece range. Store I/O surfaces as Result. */
static size_t !>(CCError) rtx_buf_count_lf(const RtxPieceTree *t, RtxBufKind buf,
                                            size_t start, size_t len) {
    char tmp[16 * 1024];
    size_t off = 0;
    size_t c = 0;
    if (!t) return cc_err(CC_ERR_INVALID_ARG, "count lf");
    if (len == 0) return cc_ok(0);
    if (buf == RTX_BUF_ORIGINAL && rtx_orig_is_mem(t)) {
        if (start > t->original.len || len > t->original.len - start) {
            return cc_err(CC_ERR_INTERNAL, "orig lf range");
        }
        return cc_ok(rtx_count_lf((const char *)t->original.ptr + start, len));
    }
    {
        RtxStoreFile f = (buf == RTX_BUF_ORIGINAL) ? RTX_STORE_ORIG : RTX_STORE_ADD;
        while (off < len) {
            size_t take = len - off;
            if (take > sizeof(tmp)) take = sizeof(tmp);
            RtxPageStore_read((RtxPageStore *)&t->store, f, start + off, tmp, take) !>(e) {
                return cc_err(e);
            };
            c += rtx_count_lf(tmp, take);
            off += take;
        }
    }
    return cc_ok(c);
}

/* Copy piece bytes [local, local+dest.len) into dest. Peel .ptr at page store. */
static void !>(CCError) rtx_piece_read(const RtxPieceTree *t, const RtxPiece *p,
                                      size_t local, char[:] dest) {
    size_t n;
    if (!t || !p) return cc_err(CC_ERR_INVALID_ARG, "piece read");
    n = dest.len;
    if (n == 0) return cc_ok();
    if (!dest.ptr) return cc_err(CC_ERR_INVALID_ARG, "piece read");
    if (local > p->len || n > p->len - local) {
        return cc_err(CC_ERR_INTERNAL, "piece read range");
    }
    if (p->buf == RTX_BUF_ORIGINAL && rtx_orig_is_mem(t)) {
        char[:] src = cc_slice_from_buffer(
            (char *)t->original.ptr + p->start + local, n);
        dest.copy(src) !>(e) { return cc_err(e); };
        return cc_ok();
    }
    {
        RtxStoreFile f = (p->buf == RTX_BUF_ORIGINAL) ? RTX_STORE_ORIG : RTX_STORE_ADD;
        return RtxPageStore_read((RtxPageStore *)&t->store, f, p->start + local,
                                 dest.ptr, n);
    }
}

static void !>(CCError) rtx_piece_read_uncached(const RtxPieceTree *t, const RtxPiece *p,
                                               size_t local, char[:] dest) {
    size_t n;
    if (!t || !p) return cc_err(CC_ERR_INVALID_ARG, "piece read");
    n = dest.len;
    if (n == 0) return cc_ok();
    if (!dest.ptr) return cc_err(CC_ERR_INVALID_ARG, "piece read");
    if (local > p->len || n > p->len - local) {
        return cc_err(CC_ERR_INTERNAL, "piece read range");
    }
    if (p->buf == RTX_BUF_ORIGINAL && rtx_orig_is_mem(t)) {
        char[:] src = cc_slice_from_buffer(
            (char *)t->original.ptr + p->start + local, n);
        dest.copy(src) !>(e) { return cc_err(e); };
        return cc_ok();
    }
    {
        RtxStoreFile f = (p->buf == RTX_BUF_ORIGINAL) ? RTX_STORE_ORIG : RTX_STORE_ADD;
        return RtxPageStore_pread(&t->store, f, p->start + local, dest.ptr, n);
    }
}

#include "piece_tree_rb.cch"


static size_t !>(CCError) rtx_add_append(RtxPieceTree *t, char[:] bytes) {
    size_t start;
    if (!t) return cc_err(CC_ERR_INVALID_ARG, "add append");
    if (bytes.len == 0) return cc_ok(t->add_len);
    if (!bytes.ptr) return cc_err(CC_ERR_INVALID_ARG, "null add bytes");
    start = RtxPageStore_append_add(&t->store, bytes.ptr, bytes.len) !>(e) {
        return cc_err(e);
    };
    t->add_len = t->store.add_len;
    return cc_ok(start);
}

static void rtx_tree_zero(RtxPieceTree *t) {
    RtxBusyFn fn;
    void *ctx;
    if (!t) return;
    /* Busy is a UI session binding, not document-epoch state. */
    fn = t->busy_fn;
    ctx = t->busy_ctx;
    *t = (RtxPieceTree){0};
    t->busy_fn = fn;
    t->busy_ctx = ctx;
    rtx_page_store_zero(&t->store);
    rtx_line_pins_reset(t);
}

static int rtx_tree_init_arena(RtxPieceTree *t) {
    /* Nodes + line_off: exact overflow, not 1.5× heap slabs. */
    t->arena_storage = cc_arena_malloc(kilobytes(64));
    if (!t->arena_storage.base) return 0;
    t->arena = &t->arena_storage;
    return 1;
}

static void !>(CCError) rtx_lf_recount_node(RtxPieceTree *t, RtxNode *n) {
    if (!n) return cc_ok();
    rtx_lf_recount_node(t, n->left) !>(e) { return cc_err(e); };
    n->piece.lf_count = rtx_buf_count_lf(t, n->piece.buf, n->piece.start,
                                          n->piece.len) !>(e) {
        return cc_err(e);
    };
    rtx_lf_recount_node(t, n->right) !>(e) { return cc_err(e); };
    rtx_node_pull(n);
    return cc_ok();
}

int rtx_line_off_push(RtxPieceTree *t, size_t off);

/* Count the newlines of buf[0, n) (document bytes from `base`) onto *line,
 * pushing a stride slot after each newline that brings *line to a multiple
 * of RTX_LINE_STRIDE. With stop != RTX_LINE_NO_STOP, stop just past the
 * newline that brings *line to >= stop (*hit = 1); a *line already at or
 * past stop stops at the next newline. Returns the bytes consumed (n
 * without a stop), or RTX_LINE_EAT_FAIL when a slot push fails. Same
 * result as a byte loop; the counter jumps from slot to slot. */
size_t rtx_line_eat(RtxPieceTree *t, const char *buf, size_t n, size_t base,
                    size_t *line, size_t stop, int *hit) {
    size_t pos = 0;
    *hit = 0;
    while (pos < n) {
        size_t need = (size_t)RTX_LINE_STRIDE - *line % (size_t)RTX_LINE_STRIDE;
        size_t seen = 0, at;
        if (stop != RTX_LINE_NO_STOP) {
            size_t to = stop > *line ? stop - *line : 1;
            if (to < need) need = to;
        }
        at = rtx_nth_lf(buf + pos, n - pos, need, &seen);
        if (at == (size_t)-1) {
            *line += seen;
            return n;
        }
        *line += need;
        pos += at + 1;
        if (*line % (size_t)RTX_LINE_STRIDE == 0 && !rtx_line_off_push(t, base + pos))
            return RTX_LINE_EAT_FAIL;
        if (stop != RTX_LINE_NO_STOP && *line >= stop) {
            *hit = 1;
            return pos;
        }
    }
    return n;
}

static void !>(CCError) rtx_tree_seed_original(RtxPieceTree *t) {
    RtxNode *n;
    size_t olen;
    size_t lf;
    olen = rtx_original_len(t);
    if (!olen) {
        t->lf_ready = 1;
        return cc_ok();
    }
    if (rtx_orig_is_mem(t)) {
        lf = rtx_buf_count_lf(t, RTX_BUF_ORIGINAL, 0, olen) !>(e) {
            return cc_err(e);
        };
        t->lf_ready = 1;
        t->line_off_ok = 0;
    } else {
        lf = 0;
        t->lf_ready = 0;
        t->line_scan_off = 0;
        t->scan_line = 0;
        t->line_off_ok = 0;
    }
    n = rtx_node_new_piece_lf(t, RTX_BUF_ORIGINAL, 0, olen, lf);
    if (!n) return cc_err(CC_ERR_OUT_OF_MEMORY, "seed original");
    n->color = RTX_RB_BLACK;
    t->root = n;
    if (!t->lf_ready) {
        if (!rtx_line_off_push(t, 0)) return cc_err(CC_ERR_OUT_OF_MEMORY, "line_off");
    }
    return cc_ok();
}

/* Smoke probe. Not a product surface. Find / island lanes add to it
 * from worker threads, so it is one atomic counter. */
static _Atomic size_t rtx_read_accounted;

size_t rtx_read_account_take(void) {
    return atomic_exchange_explicit(&rtx_read_accounted, 0, memory_order_relaxed);
}

/* Success: got = min(dest.len, len-off). A hole inside that range is INTERNAL. */
size_t !>(CCError) RtxPieceTree_read_at(const RtxPieceTree *t, size_t offset,
                                        char[:] dest) {
    size_t got = 0;
    size_t len;
    size_t need;
    size_t n;
    if (!t) return cc_err(CC_ERR_INVALID_ARG, "read_at");
    n = dest.len;
    if (n == 0) return cc_ok(0);
    if (!dest.ptr) return cc_err(CC_ERR_INVALID_ARG, "read_at");
    len = RtxPieceTree_len(t);
    if (offset >= len) return cc_ok(0);
    if (n > len - offset) n = len - offset;
    need = n;
    while (got < n) {
        size_t local = 0;
        RtxNode *node = rtx_find_node(t, offset + got, &local);
        size_t take;
        if (!node) return cc_err(CC_ERR_INTERNAL, "read_at hole");
        take = node->piece.len - local;
        if (take > n - got) take = n - got;
        rtx_piece_read(t, &node->piece, local, dest.sub(got, got + take)) !>(e) {
            return cc_err(e);
        };
        got += take;
    }
    if (got != need) return cc_err(CC_ERR_INTERNAL, "read_at short");
    atomic_fetch_add_explicit(&rtx_read_accounted, got, memory_order_relaxed);
    return cc_ok(got);
}

size_t !>(CCError) RtxPieceTree_read_uncached(const RtxPieceTree *t, size_t offset,
                                              char[:] dest) {
    size_t got = 0;
    size_t len;
    size_t need;
    size_t n;
    if (!t) return cc_err(CC_ERR_INVALID_ARG, "read_uncached");
    n = dest.len;
    if (n == 0) return cc_ok(0);
    if (!dest.ptr) return cc_err(CC_ERR_INVALID_ARG, "read_uncached");
    len = RtxPieceTree_len(t);
    if (offset >= len) return cc_ok(0);
    if (n > len - offset) n = len - offset;
    need = n;
    while (got < n) {
        size_t local = 0;
        RtxNode *node = rtx_find_node(t, offset + got, &local);
        size_t take;
        if (!node) return cc_err(CC_ERR_INTERNAL, "read_uncached hole");
        take = node->piece.len - local;
        if (take > n - got) take = n - got;
        rtx_piece_read_uncached(t, &node->piece, local,
                                dest.sub(got, got + take)) !>(e) {
            return cc_err(e);
        };
        got += take;
    }
    if (got != need) return cc_err(CC_ERR_INTERNAL, "read_uncached short");
    atomic_fetch_add_explicit(&rtx_read_accounted, got, memory_order_relaxed);
    return cc_ok(got);
}

/*
 * Extend the progressive line scan through byte `want_off`.
 */
void !>(RtxIndexErr) rtx_line_scan_to(RtxPieceTree *t, size_t want_off) {
    size_t len;
    char buf[64 * 1024];
    if (!t) return cc_err(rtx_index_err("scan"));
    if (t->lf_ready) return cc_ok();
    len = RtxPieceTree_len(t);
    if (want_off > len) want_off = len;
    if (t->line_off_len == 0) {
        if (!rtx_line_off_push(t, 0)) return cc_err(rtx_index_err("line_off"));
    }
    while (t->line_scan_off < want_off) {
        size_t take = want_off - t->line_scan_off;
        size_t got;
        int hit;
        if (take > sizeof(buf)) take = sizeof(buf);
        rtx_busy_pulse(t, "indexing", t->line_scan_off, want_off);
        got = RtxPieceTree_read_uncached(t, t->line_scan_off, cc_slice_from_buffer(buf, take)) !>(e) {
            rtx_busy_end(t);
            return cc_err(rtx_index_from_cc(e));
        };
        if (!got) {
            rtx_busy_end(t);
            return cc_err(rtx_index_err("line scan"));
        }
        if (rtx_line_eat(t, buf, got, t->line_scan_off, &t->scan_line,
                         RTX_LINE_NO_STOP, &hit) == RTX_LINE_EAT_FAIL) {
            rtx_busy_end(t);
            return cc_err(rtx_index_err("line_off"));
        }
        t->line_scan_off += got;
    }
    rtx_busy_end(t);
    if (t->line_scan_off >= len) {
        if (t->root && !t->root->left && !t->root->right) {
            t->root->piece.lf_count = t->scan_line;
            rtx_node_pull(t->root);
            t->lf_ready = 1;
            t->line_off_ok = 1;
        } else if (len <= (size_t)RTX_LINE_SOFT_MIN) {
            rtx_lf_recount_node(t, t->root) !>(e) {
                return cc_err(rtx_index_from_cc(e));
            };
            t->lf_ready = 1;
            t->line_off_ok = 1;
        } else {
            /* Edited huge doc: keep progressive; scan_line is exact at EOF. */
            t->line_off_ok = 1;
        }
    }
    rtx_line_pins_from_prefix(t);
    return cc_ok();
}

/* Scan until line index `want_line` is known (scan_line >= want_line) or EOF. */
void !>(RtxIndexErr) rtx_line_scan_through_line(RtxPieceTree *t, size_t want_line) {
    size_t len;
    char buf[64 * 1024];
    if (!t) return cc_err(rtx_index_err("scan"));
    if (t->lf_ready) return cc_ok();
    len = RtxPieceTree_len(t);
    if (t->line_off_len == 0) {
        if (!rtx_line_off_push(t, 0)) return cc_err(rtx_index_err("line_off"));
    }
    while (t->scan_line < want_line && t->line_scan_off < len) {
        size_t got, used;
        int hit;
        size_t take = sizeof(buf);
        if (take > len - t->line_scan_off) take = len - t->line_scan_off;
        rtx_busy_pulse(t, "jump", t->scan_line, want_line);
        got = RtxPieceTree_read_uncached(t, t->line_scan_off, cc_slice_from_buffer(buf, take)) !>(e) {
            rtx_busy_end(t);
            return cc_err(rtx_index_from_cc(e));
        };
        if (!got) {
            rtx_busy_end(t);
            return cc_err(rtx_index_err("line scan"));
        }
        used = rtx_line_eat(t, buf, got, t->line_scan_off, &t->scan_line, want_line,
                            &hit);
        if (used == RTX_LINE_EAT_FAIL) {
            rtx_busy_end(t);
            return cc_err(rtx_index_err("line_off"));
        }
        t->line_scan_off += used;
        if (hit) break;
    }
    rtx_busy_end(t);
    if (t->line_scan_off >= len) {
        if (t->root && !t->root->left && !t->root->right) {
            t->root->piece.lf_count = t->scan_line;
            rtx_node_pull(t->root);
            t->lf_ready = 1;
            t->line_off_ok = 1;
        } else if (len <= (size_t)RTX_LINE_SOFT_MIN) {
            rtx_lf_recount_node(t, t->root) !>(e) {
                return cc_err(rtx_index_from_cc(e));
            };
            t->lf_ready = 1;
            t->line_off_ok = 1;
        } else {
            t->line_off_ok = 1;
        }
    }
    rtx_line_pins_from_prefix(t);
    return cc_ok();
}

/* Finish newline weights. Completes any progressive scan to EOF. */
static void !>(CCError) rtx_lf_ensure(RtxPieceTree *t) {
    if (!t || t->lf_ready) return cc_ok();
    rtx_line_scan_to(t, RtxPieceTree_len(t)) !>(e) {
        return cc_err(CC_ERR_IO, e.message ? e.message : "line index");
    };
    if (!t->lf_ready && t->root) {
        rtx_lf_recount_node(t, t->root) !>(e) { return cc_err(e); };
        t->lf_ready = 1;
        t->line_off_ok = 1;
    }
    return cc_ok();
}

/*
 * Append a copy of [from, from+n) at EOF via frame chunk + store append.
 * Maintains the line index (one patch after the copy).
 * Returns newlines copied. A read or append fault leaves the tree as it
 * was: the tip grows (or a fresh tip goes in) only after every chunk
 * landed. Bytes already appended to the add file stay there, unreferenced.
 */
size_t !>(CCError) RtxPieceTree_append_copy(RtxPieceTree *t, size_t from,
                                                      size_t n) {
    size_t off = 0;
    size_t local = 0;
    size_t at;
    RtxNode *tip;
    size_t lf = 0;
    size_t first = 0;
    char chunk[64 * 1024];
    if (!t) return cc_err(CC_ERR_INVALID_ARG, "null tree");
    if (n == 0) return cc_ok((size_t)0);
    at = RtxPieceTree_len(t);
    if (from > RtxPieceTree_len(t) || n > RtxPieceTree_len(t) - from) {
        return cc_err(CC_ERR_INVALID_ARG, "append_copy range");
    }
    /* Island lanes walk nodes and pread the add file. Join before any
     * node, weight, or add_len moves. */
    rtx_isle_handle_stop(t);
    rtx_lf_ensure(t) !>(e) { return cc_err(e); };

    tip = NULL;
    if (RtxPieceTree_len(t) > 0) {
        tip = rtx_find_node(t, RtxPieceTree_len(t) - 1, &local);
        if (tip && tip->piece.buf == RTX_BUF_ADD &&
            tip->piece.start + tip->piece.len == t->add_len &&
            local + 1 == tip->piece.len) {
            /* extendable tip */
        } else {
            tip = NULL;
        }
    }

    while (off < n) {
        size_t take = n - off;
        size_t got, i;
        size_t start, want_start;
        if (take > sizeof(chunk)) take = sizeof(chunk);
        got = RtxPieceTree_read_at(t, from + off, cc_slice_from_buffer(chunk, take)) !>(e) {
            return cc_err(e);
        };
        if (got != take) return cc_err(CC_ERR_INTERNAL, "append_copy read");
        start = RtxPageStore_append_add(&t->store, chunk, got) !>(e) {
            return cc_err(e);
        };
        t->add_len = t->store.add_len;
        if (off == 0) first = start;
        want_start = tip ? tip->piece.start + tip->piece.len + off : first + off;
        if (start != want_start) return cc_err(CC_ERR_INTERNAL, "append_copy gap");
        lf += rtx_count_lf(chunk, got);
        off += got;
    }
    if (tip) {
        tip->piece.len += n;
        tip->piece.lf_count += lf;
        rtx_node_pull_up(tip);
    } else {
        tip = rtx_node_new_piece_lf(t, RTX_BUF_ADD, first, n, lf);
        if (!tip) return cc_err(CC_ERR_OUT_OF_MEMORY, "append tip");
        rtx_bst_insert(t, tip, at);
    }
    rtx_line_index_note_insert(t, at, n, lf);
    return cc_ok(lf);
}

/* Contiguous borrowed original, or empty if store-backed / split. */
static char[:] rtx_tree_flat(const RtxPieceTree *t) {
    RtxNode *n;
    if (!t || !t->root || !rtx_orig_is_mem(t)) return cc_slice_empty();
    n = t->root;
    if (n->left || n->right) return cc_slice_empty();
    if (n->piece.buf != RTX_BUF_ORIGINAL) return cc_slice_empty();
    if (n->piece.start != 0 || n->piece.len != t->original.len) return cc_slice_empty();
    return t->original;
}

/* View of [from, from+n) when it sits in one borrowed contiguous piece.
 * Store-backed pieces leave *view empty (DESIGN: no stable page views). */
static int rtx_tree_span_into(const RtxPieceTree *t, size_t from, size_t n, char[:] *view) {
    size_t local = 0;
    size_t len;
    RtxNode *node;
    char[:] piece;
    if (view) *view = cc_slice_empty();
    if (!t || !view || n == 0) return 0;
    len = RtxPieceTree_len(t);
    if (from >= len) return 0;
    if (n > len - from) n = len - from;
    {
        char[:] flat = rtx_tree_flat(t);
        if (flat.ptr && from <= flat.len && n <= flat.len - from) {
            *view = flat.sub(from, from + n);
            return 1;
        }
    }
    node = rtx_find_node(t, from, &local);
    if (!node || local + n > node->piece.len) return 0;
    if (node->piece.buf != RTX_BUF_ORIGINAL || !rtx_orig_is_mem(t)) return 0;
    piece = t->original.sub(node->piece.start,
                            node->piece.start + node->piece.len);
    *view = piece.sub(local, local + n);
    return 1;
}

char[:] RtxPieceTree_span(const RtxPieceTree *t, size_t from, size_t n) {
    char[:] view = cc_slice_empty();
    (void)rtx_tree_span_into(t, from, n, &view);
    return view;
}

char[:] !>(CCError) RtxPieceTree_scratch_span(const RtxPieceTree *t, size_t from,
                                              size_t n, CCArena a) {
    char[:] view;
    char[:] copy;
    size_t len;
    if (!t) return cc_err(CC_ERR_INVALID_ARG, "null tree");
    if (n == 0) return cc_ok(cc_slice_empty());
    view = RtxPieceTree_span(t, from, n);
    if (view.ptr) return cc_ok(view);
    if (!a.base) return cc_err(CC_ERR_INVALID_ARG, "null scratch");
    len = RtxPieceTree_len(t);
    if (from >= len) return cc_ok(cc_slice_empty());
    if (n > len - from) n = len - from;
    if (n == 0) return cc_ok(cc_slice_empty());
    copy = a.alloc_slice_bytes(n);
    if (!copy.ptr || copy.len < n) return cc_err(CC_ERR_OUT_OF_MEMORY, "scratch span");
    {
        size_t got = RtxPieceTree_read_at(t, from, copy.sub(0, n)) !>(e) { return cc_err(e); };
        if (got != n) return cc_err(CC_ERR_INTERNAL, "scratch span read");
    }
    return cc_ok(copy);
}

void RtxPieceTree_destroy(RtxPieceTree *t) {
    if (!t) return;
    rtx_isle_handle_stop(t);
    t->store.destroy();
    /* line_off lives on the piece-tree arena — do not free() it. */
    if (t->arena && t->arena->base) {
        t->arena_storage.destroy();
    }
    rtx_tree_zero(t);
}

void !>(CCError) RtxPieceTree_empty(RtxPieceTree *t) {
    if (!t) return cc_err(CC_ERR_INVALID_ARG, "null tree");
    if (RtxPieceTree_is_live(t)) return cc_err(CC_ERR_INVALID_ARG, "tree already live");
    rtx_tree_zero(t);
    if (!rtx_tree_init_arena(t)) {
        return cc_err(CC_ERR_OUT_OF_MEMORY, "piece tree arena");
    }
    t->lf_ready = 1;
    return cc_ok();
}

void !>(CCError) RtxPieceTree_from_buffer(RtxPieceTree *t, char[:] bytes) {
    if (!t) return cc_err(CC_ERR_INVALID_ARG, "null tree");
    if (RtxPieceTree_is_live(t)) return cc_err(CC_ERR_INVALID_ARG, "tree already live");
    if (bytes.len && cc_slice_is_untracked_id(bytes.id)) {
        return cc_err(CC_ERR_INVALID_ARG, "untracked buffer");
    }
    rtx_tree_zero(t);
    if (!rtx_tree_init_arena(t)) {
        return cc_err(CC_ERR_OUT_OF_MEMORY, "piece tree arena");
    }
    t->original = bytes;
    rtx_tree_seed_original(t) !>(e) {
        RtxPieceTree_destroy(t);
        return cc_err(e);
    };
    return cc_ok();
}

void !>(CCError) RtxPieceTree_from_path(RtxPieceTree *t, char[:0] path) {
    if (!t) return cc_err(CC_ERR_INVALID_ARG, "null tree");
    if (RtxPieceTree_is_live(t)) return cc_err(CC_ERR_INVALID_ARG, "tree already live");
    rtx_tree_zero(t);
    if (!path.ptr || path.len == 0) return cc_err(CC_ERR_INVALID_ARG, "empty path");
    if (!rtx_tree_init_arena(t)) {
        return cc_err(CC_ERR_OUT_OF_MEMORY, "piece tree arena");
    }
    RtxPageStore_open_original(&t->store, path) !>(e) {
        RtxPieceTree_destroy(t);
        return cc_err(e);
    };
    if (t->store.orig_len == 0) {
        t->lf_ready = 1;
        return cc_ok();
    }
    rtx_tree_seed_original(t) !>(e) {
        RtxPieceTree_destroy(t);
        return cc_err(e);
    };
    return cc_ok();
}

/* Split the piece containing `offset` so a node begins at `offset`.
 * Allocates the right node before shrinking the left. offset == len is a no-op.
 * When lf weights are not ready, both sides keep lf_count 0 (progressive index
 * does not need them). When ready, count only the shorter side and subtract. */
static void !>(CCError) rtx_split_at(RtxPieceTree *t, size_t offset) {
    size_t local = 0;
    RtxNode *n;
    RtxNode *right;
    size_t right_len;
    RtxBufKind buf;
    size_t start;
    size_t right_lf;
    size_t left_lf;
    if (!t) return cc_err(CC_ERR_INVALID_ARG, "null tree");
    if (offset == 0 || offset == RtxPieceTree_len(t)) return cc_ok();
    n = rtx_find_node(t, offset, &local);
    if (!n) return cc_err(CC_ERR_INTERNAL, "split node");
    if (local == 0) return cc_ok();
    right_len = n->piece.len - local;
    buf = n->piece.buf;
    start = n->piece.start + local;
    if (!t->lf_ready) {
        right_lf = 0;
        left_lf = 0;
    } else if (local <= right_len) {
        left_lf = rtx_buf_count_lf(t, buf, n->piece.start, local) !>(e) {
            return cc_err(e);
        };
        if (left_lf > n->piece.lf_count) {
            return cc_err(CC_ERR_INTERNAL, "split lf");
        }
        right_lf = n->piece.lf_count - left_lf;
    } else {
        right_lf = rtx_buf_count_lf(t, buf, start, right_len) !>(e) { return cc_err(e); };
        if (right_lf > n->piece.lf_count) {
            return cc_err(CC_ERR_INTERNAL, "split lf");
        }
        left_lf = n->piece.lf_count - right_lf;
    }
    right = rtx_node_new_piece_lf(t, buf, start, right_len, right_lf);
    if (!right) return cc_err(CC_ERR_OUT_OF_MEMORY, "split node");
    n->piece.len = local;
    n->piece.lf_count = left_lf;
    rtx_node_pull_up(n);
    rtx_bst_insert(t, right, offset);
    return cc_ok();
}

size_t !>(RtxIndexErr) rtx_count_lf_range(const RtxPieceTree *t, size_t from,
                                         size_t n);

/* True when the body is large enough that edits must not finish a full lf scan. */
static int rtx_lf_huge(const RtxPieceTree *t) {
    return t && RtxPieceTree_len(t) > (size_t)RTX_LINE_SOFT_MIN;
}

/*
 * Truncate the progressive index at `off` and clear lf_ready so later
 * line_* resume from here. Does not read past `off`. A slot at `off`
 * itself stays (its newline is before `off`); dropping it loses the slot
 * for good, since the resumed scan starts past that newline. When the
 * last slot is more than RTX_LINE_ISLE_BUDGET back, the frontier parks on
 * that slot instead of counting up to `off`.
 */
void !>(CCError) rtx_lf_invalidate_from(RtxPieceTree *t, size_t off) {
    size_t keep, from_slot, at;
    size_t extra;
    @errhandler(RtxIndexErr ie) {
        return cc_err(CC_ERR_IO, ie.message ? ie.message : "line index");
    }
    if (!t) return cc_err(CC_ERR_INVALID_ARG, "invalidate");
    if (t->line_off_len == 0) {
        if (!rtx_line_off_push(t, 0)) return cc_err(CC_ERR_OUT_OF_MEMORY, "line_off");
    }
    keep = 0;
    while (keep < t->line_off_len && t->line_off[keep] <= off) keep++;
    from_slot = keep > 0 ? keep - 1 : 0;
    t->line_off_len = from_slot + 1;
    at = t->line_off[from_slot];
    if (at > off) at = 0;
    extra = 0;
    if (off > at) {
        if (off - at > (size_t)RTX_LINE_ISLE_BUDGET) {
            /* Long lines: do not claim [at, off) without counting it. */
            t->scan_line = from_slot * (size_t)RTX_LINE_STRIDE;
            t->line_scan_off = at;
            t->lf_ready = 0;
            t->line_off_ok = 1;
            return cc_ok();
        }
        extra = rtx_count_lf_range(t, at, off - at) !>;
    }
    t->scan_line = from_slot * (size_t)RTX_LINE_STRIDE + extra;
    t->line_scan_off = off;
    t->lf_ready = 0;
    t->line_off_ok = 1;
    return cc_ok();
}

/*
 * Prepare for a mutation at `off`. Huge files never scan to EOF. A gap
 * edit (off past the prefix cursor) does not scan_to — that was the
 * 8G type-to-hang. A letter edit inside the prefix must not drop the
 * suffix either — that was the 2G JSON type-to-rescan. Only an edit
 * that changes newlines truncates the stride index. Tip inserts keep
 * the current prefix cursor. Small files still finish the index.
 */
static void !>(CCError) rtx_lf_prepare_edit(RtxPieceTree *t, size_t off,
                                           int lines_change) {
    size_t len;
    if (!t) return cc_err(CC_ERR_INVALID_ARG, "prepare edit");
    len = RtxPieceTree_len(t);
    if (off > len) off = len;
    if (rtx_lf_huge(t)) {
        if (t->lf_ready) {
            /* Leaving exact weights (a small doc grew past SOFT_MIN). The
             * cursor stopped where the doc turned ready; the weights and a
             * complete stride index say where it is now. */
            if (t->line_off_ok && t->root &&
                t->line_off_len == (size_t)t->root->subtree_lf / (size_t)RTX_LINE_STRIDE + 1) {
                t->line_scan_off = len;
                t->scan_line = (size_t)t->root->subtree_lf;
            } else {
                t->line_off_len = 0;
                if (!rtx_line_off_push(t, 0)) {
                    return cc_err(CC_ERR_OUT_OF_MEMORY, "line_off");
                }
                t->line_scan_off = 0;
                t->scan_line = 0;
                t->line_off_ok = 1;
            }
            t->lf_ready = 0;
        }
        if (off < len) {
            if (lines_change && off <= t->line_scan_off) {
                rtx_lf_invalidate_from(t, off) !>(e) { return cc_err(e); };
            }
        } else {
            if (t->line_off_len == 0) {
                if (!rtx_line_off_push(t, 0)) {
                    return cc_err(CC_ERR_OUT_OF_MEMORY, "line_off");
                }
            }
            t->line_off_ok = 1;
        }
        return cc_ok();
    }
    rtx_lf_ensure(t) !>(e) { return cc_err(e); };
    return cc_ok();
}

/* 1 = tip-extended; 0 = not applicable (caller should split+insert). */
static int !>(CCError) rtx_try_extend_add(RtxPieceTree *t, size_t offset, char[:] bytes) {
    size_t local = 0;
    RtxNode *n;
    if (!t || bytes.len == 0 || offset == 0) return cc_ok(0);
    n = rtx_find_node(t, offset - 1, &local);
    if (!n) return cc_ok(0);
    if (n->piece.buf != RTX_BUF_ADD) return cc_ok(0);
    if (n->piece.start + n->piece.len != t->add_len) return cc_ok(0);
    if (local + 1 != n->piece.len) return cc_ok(0);
    rtx_add_append(t, bytes) !>(e) { return cc_err(e); };
    n->piece.len += bytes.len;
    n->piece.lf_count += rtx_count_lf(bytes.ptr, bytes.len);
    rtx_node_pull_up(n);
    return cc_ok(1);
}

static int rtx_ins_prof_on = 0;
static RtxInsertProf rtx_ins_prof;
static int rtx_fail_replace;
static int rtx_fail_replace_unrestorable;
static size_t rtx_fail_replace_skip;

void RtxPieceTree_fail_next_replace(RtxPieceTree *t, int unrestorable) {
    (void)t;
    rtx_fail_replace = 1;
    rtx_fail_replace_unrestorable = unrestorable ? 1 : 0;
    rtx_fail_replace_skip = 0;
}

void RtxPieceTree_fail_replace_after(RtxPieceTree *t, size_t skip, int unrestorable) {
    RtxPieceTree_fail_next_replace(t, unrestorable);
    rtx_fail_replace_skip = skip;
}

void RtxPieceTree_profile_insert(RtxPieceTree *t, int on) {
    (void)t;
    rtx_ins_prof_on = on;
    rtx_ins_prof = (RtxInsertProf){0};
}

RtxInsertProf RtxPieceTree_insert_prof(const RtxPieceTree *t) {
    (void)t;
    return rtx_ins_prof;
}

/* TU-internal. Public write is replace (range in [0, len]). */
static void !>(CCError) rtx_tree_insert(RtxPieceTree *t, size_t offset, char[:] bytes) {
    size_t start = 0;
    RtxNode *n;
    size_t len;
    size_t lf;
    int extended;
    int prof = rtx_ins_prof_on;
    double t0 = 0.0;
    if (!t) return cc_err(CC_ERR_INVALID_ARG, "null tree");
    len = RtxPieceTree_len(t);
    if (offset > len) return cc_err(CC_ERR_INVALID_ARG, "insert past end");
    if (bytes.len == 0) return cc_ok();
    if (prof) {
        rtx_ins_prof.lf_ready0 = t->lf_ready;
        rtx_ins_prof.huge = rtx_lf_huge(t);
        rtx_ins_prof.scan0 = t->line_scan_off;
        rtx_ins_prof.line_off0 = t->line_off_len;
        t0 = rtx_mono_ms();
    }
    rtx_lf_prepare_edit(t, offset, rtx_count_lf(bytes.ptr, bytes.len) != 0) !>(e) {
        return cc_err(e);
    };
    if (prof) {
        rtx_ins_prof.prepare_ms = rtx_mono_ms() - t0;
        t0 = rtx_mono_ms();
    }
    extended = rtx_try_extend_add(t, offset, bytes) !>(e) { return cc_err(e); };
    if (extended) {
        if (prof) {
            rtx_ins_prof.add_ms = rtx_mono_ms() - t0;
            rtx_ins_prof.extended = 1;
            t0 = rtx_mono_ms();
        }
        if (!t->line_off_suspend) {
            rtx_line_index_note_insert(t, offset, bytes.len,
                                      rtx_count_lf(bytes.ptr, bytes.len));
        }
        if (prof) {
            rtx_ins_prof.note_ms = rtx_mono_ms() - t0;
            rtx_ins_prof.lf_ready1 = t->lf_ready;
            rtx_ins_prof.scan1 = t->line_scan_off;
            rtx_ins_prof.line_off1 = t->line_off_len;
        }
        return cc_ok();
    }
    rtx_split_at(t, offset) !>(e) { return cc_err(e); };
    if (prof) {
        rtx_ins_prof.split_ms = rtx_mono_ms() - t0;
        t0 = rtx_mono_ms();
    }
    start = rtx_add_append(t, bytes) !>(e) { return cc_err(e); };
    if (prof) {
        rtx_ins_prof.add_ms = rtx_mono_ms() - t0;
        t0 = rtx_mono_ms();
    }
    lf = rtx_count_lf(bytes.ptr, bytes.len);
    n = rtx_node_new_piece_lf(t, RTX_BUF_ADD, start, bytes.len, lf);
    if (!n) return cc_err(CC_ERR_OUT_OF_MEMORY, "piece node");
    rtx_bst_insert(t, n, offset);
    if (prof) t0 = rtx_mono_ms();
    if (!t->line_off_suspend) {
        rtx_line_index_note_insert(t, offset, bytes.len, n->piece.lf_count);
    }
    if (prof) {
        rtx_ins_prof.note_ms = rtx_mono_ms() - t0;
        rtx_ins_prof.lf_ready1 = t->lf_ready;
        rtx_ins_prof.scan1 = t->line_scan_off;
        rtx_ins_prof.line_off1 = t->line_off_len;
    }
    return cc_ok();
}

static void !>(CCError) rtx_tree_erase(RtxPieceTree *t, size_t offset, size_t n) {
    size_t len;
    size_t end;
    size_t erased;
    size_t lf = 0;
    @errhandler(CCError e) {
        return cc_err(e);
    }
    @errhandler(RtxIndexErr ie) {
        return cc_err(CC_ERR_IO, ie.message ? ie.message : "line index");
    }
    if (!t) return cc_err(CC_ERR_INVALID_ARG, "null tree");
    len = RtxPieceTree_len(t);
    if (offset > len || n > len - offset) {
        return cc_err(CC_ERR_INVALID_ARG, "erase out of range");
    }
    if (n == 0) return cc_ok();
    {
        int lines = 0;
        if (n > (size_t)RTX_LINE_ISLE_BUDGET) lines = 1;
        else {
            lf = rtx_count_lf_range(t, offset, n) !>;
            lines = lf != 0;
        }
        rtx_lf_prepare_edit(t, offset, lines) !>;
    }
    if (t->lf_ready) {
        lf = rtx_count_lf_range(t, offset, n) !>;
    } else if (n > (size_t)RTX_LINE_ISLE_BUDGET) {
        lf = 0;
    }
    end = offset + n;
    erased = n;
    rtx_split_at(t, offset) !>;
    rtx_split_at(t, end) !>;
    while (n > 0) {
        size_t local = 0;
        RtxNode *node = rtx_find_node(t, offset, &local);
        size_t piece_len;
        if (!node || local != 0) {
            t->line_off_ok = 0;
            return cc_err(CC_ERR_INTERNAL, "erase walk");
        }
        piece_len = node->piece.len;
        if (piece_len > n) {
            t->line_off_ok = 0;
            return cc_err(CC_ERR_INTERNAL, "erase piece");
        }
        rtx_rb_delete(t, node);
        n -= piece_len;
    }
    if (!t->line_off_suspend) {
        rtx_line_index_note_erase(t, offset, erased, lf);
    } else {
        t->line_off_ok = 0;
    }
    return cc_ok();
}

/* Walk [off, off+n) without splitting. One entry per covering piece. */
static size_t !>(CCError) rtx_range_piece_count(const RtxPieceTree *t, size_t off,
                                                size_t n) {
    size_t np = 0;
    size_t at = off;
    size_t remain = n;
    size_t len;
    if (!t) return cc_err(CC_ERR_INVALID_ARG, "null tree");
    len = RtxPieceTree_len(t);
    if (off > len || n > len - off) return cc_err(CC_ERR_INVALID_ARG, "capture range");
    if (n == 0) return cc_ok((size_t)0);
    while (remain) {
        size_t local = 0;
        size_t take;
        RtxNode *node = rtx_find_node(t, at, &local);
        if (!node) return cc_err(CC_ERR_INTERNAL, "capture walk");
        take = node->piece.len - local;
        if (take > remain) take = remain;
        if (take == 0) return cc_err(CC_ERR_INTERNAL, "capture take");
        np++;
        at += take;
        remain -= take;
    }
    return cc_ok(np);
}

static void !>(CCError) rtx_range_piece_fill(const RtxPieceTree *t, size_t off, size_t n,
                                            RtxPieceRef *out, size_t nout) {
    size_t at = off;
    size_t remain = n;
    size_t i = 0;
    if (!t || !out) return cc_err(CC_ERR_INVALID_ARG, "capture fill");
    while (remain) {
        size_t local = 0;
        size_t take;
        size_t lf;
        RtxNode *node = rtx_find_node(t, at, &local);
        if (!node || i >= nout) return cc_err(CC_ERR_INTERNAL, "capture fill");
        take = node->piece.len - local;
        if (take > remain) take = remain;
        out[i].buf = (unsigned char)node->piece.buf;
        out[i].start = node->piece.start + local;
        out[i].len = take;
        /* Progressive weights are not counts (split halves and the seeded
         * original carry 0). Say so; splice recounts or treats as unknown. */
        out[i].lf_ok = t->lf_ready ? 1 : 0;
        if (!t->lf_ready) {
            lf = 0;
        } else if (local == 0 && take == node->piece.len) {
            lf = node->piece.lf_count;
        } else {
            lf = rtx_buf_count_lf(t, node->piece.buf, out[i].start, take) !>(e) {
                return cc_err(e);
            };
        }
        out[i].lf_count = lf;
        i++;
        at += take;
        remain -= take;
    }
    if (i != nout) return cc_err(CC_ERR_INTERNAL, "capture count");
    return cc_ok();
}

void !>(CCError) RtxPieceTree_capture_range(const RtxPieceTree *t, size_t off, size_t n,
                                            CCArena a, RtxPieceRef **out, size_t *nout) {
    size_t np;
    RtxPieceRef *refs;
    if (!t || !a.base || !out || !nout) return cc_err(CC_ERR_INVALID_ARG, "capture");
    *out = NULL;
    *nout = 0;
    np = rtx_range_piece_count(t, off, n) !>(e) { return cc_err(e); };
    if (np == 0) return cc_ok();
    refs = (RtxPieceRef *)cc_arena_alloc(a, np * sizeof(RtxPieceRef), 8);
    if (!refs) return cc_err(CC_ERR_OUT_OF_MEMORY, "capture refs");
    rtx_range_piece_fill(t, off, n, refs, np) !>(e) { return cc_err(e); };
    *out = refs;
    *nout = np;
    return cc_ok();
}

/* Insert captured pieces at `off` (does not erase). Original/add bytes stay. */
void !>(CCError) RtxPieceTree_splice_refs(RtxPieceTree *t, size_t off,
                                          const RtxPieceRef *refs, size_t nrefs) {
    size_t i;
    size_t at;
    size_t len;
    if (!t) return cc_err(CC_ERR_INVALID_ARG, "null tree");
    if (nrefs == 0) return cc_ok();
    if (!refs) return cc_err(CC_ERR_INVALID_ARG, "splice refs");
    len = RtxPieceTree_len(t);
    if (off > len) return cc_err(CC_ERR_INVALID_ARG, "splice off");
    rtx_isle_handle_stop(t);
    {
        /* An uncounted ref may hold newlines: treat it as a line change. */
        int lines = 0;
        for (i = 0; i < nrefs; i++) {
            if (refs[i].lf_count || !refs[i].lf_ok) {
                lines = 1;
                break;
            }
        }
        rtx_lf_prepare_edit(t, off, lines) !>(e) { return cc_err(e); };
    }
    rtx_split_at(t, off) !>(e) { return cc_err(e); };
    at = off;
    for (i = 0; i < nrefs; i++) {
        RtxNode *node;
        size_t lf;
        size_t note_lf;
        unsigned char buf = refs[i].buf;
        if (refs[i].len == 0) continue;
        if (buf != RTX_BUF_ORIGINAL && buf != RTX_BUF_ADD) {
            return cc_err(CC_ERR_INVALID_ARG, "splice buf");
        }
        if (buf == RTX_BUF_ORIGINAL) {
            if (refs[i].start + refs[i].len > rtx_original_len(t)) {
                return cc_err(CC_ERR_INVALID_ARG, "splice orig");
            }
        } else if (refs[i].start + refs[i].len > t->add_len) {
            return cc_err(CC_ERR_INVALID_ARG, "splice add");
        }
        /* Ready weights must be counts: recount a ref captured while the
         * index was progressive. Progressive nodes carry 0; the index
         * gets the count when there is one, else RTX_LF_UNKNOWN. */
        note_lf = refs[i].lf_ok ? refs[i].lf_count : RTX_LF_UNKNOWN;
        if (t->lf_ready) {
            if (refs[i].lf_ok) {
                lf = refs[i].lf_count;
            } else {
                lf = rtx_buf_count_lf(t, (RtxBufKind)buf, refs[i].start,
                                      refs[i].len) !>(e) { return cc_err(e); };
            }
            note_lf = lf;
        } else {
            lf = 0;
        }
        node = rtx_node_new_piece_lf(t, (RtxBufKind)buf, refs[i].start, refs[i].len, lf);
        if (!node) return cc_err(CC_ERR_OUT_OF_MEMORY, "splice node");
        rtx_bst_insert(t, node, at);
        if (!t->line_off_suspend) {
            rtx_line_index_note_insert(t, at, refs[i].len, note_lf);
        }
        at += refs[i].len;
    }
    return cc_ok();
}

/* One user-visible change. Pure erase recycles nodes; original/add bytes stay.
 * Insert-fail splices captured piece refs back (no byte hold of `del`). */
void !>(CCError) RtxPieceTree_replace(RtxPieceTree *t, size_t off, size_t n,
                                                   char[:] ins) {
    RtxPieceRef *refs = NULL;
    size_t nrefs = 0;
    CCArena hold = {0};
    if (!t) return cc_err(CC_ERR_INVALID_ARG, "null tree");
    if (rtx_fail_replace && rtx_fail_replace_skip) {
        rtx_fail_replace_skip--;
    } else if (rtx_fail_replace) {
        int unrest = rtx_fail_replace_unrestorable;
        rtx_fail_replace = 0;
        rtx_fail_replace_unrestorable = 0;
        if (unrest) return cc_err(RTX_ERR_UNRESTORABLE, "replace unrestorable");
        return cc_err(CC_ERR_INTERNAL, "replace failed");
    }
    {
        size_t len = RtxPieceTree_len(t);
        if (off > len || n > len - off) {
            return cc_err(CC_ERR_INVALID_ARG, "replace range");
        }
    }
    if (n == 0 && ins.len == 0) return cc_ok();
    /* Join the island before the first mutation: its lanes walk nodes
     * (read_uncached) and pause gates only the write stage. note_insert /
     * note_erase drop it after the tree already moved — too late. */
    rtx_isle_handle_stop(t);
    if (n && ins.len) {
        size_t np = rtx_range_piece_count(t, off, n) !>(e) { return cc_err(e); };
        size_t need = np * sizeof(RtxPieceRef) + 64;
        if (need < 64) need = 64;
        hold = cc_arena_heap(need);
        if (!hold.base) return cc_err(CC_ERR_OUT_OF_MEMORY, "replace hold");
    }
    @defer { if (hold.base) hold.destroy(); };
    if (n && ins.len) {
        RtxPieceTree_capture_range(t, off, n, hold, &refs, &nrefs) !>(e) {
            return cc_err(e);
        };
    }
    if (n) {
        rtx_tree_erase(t, off, n) !>(e) { return cc_err(e); };
    }
    if (ins.len) {
        rtx_tree_insert(t, off, ins) !>(e) {
            if (n && nrefs) {
                RtxPieceTree_splice_refs(t, off, refs, nrefs) !>(e2) {
                    (void)e2;
                    return cc_err(RTX_ERR_UNRESTORABLE, "replace unrestorable");
                };
            }
            return cc_err(e);
        };
    }
    return cc_ok();
}

static void !>(CCError) rtx_write_all(int fd, const char *p, size_t n) {
    size_t off = 0;
    while (off < n) {
        ssize_t w = write(fd, p + off, n - off);
        if (w < 0) {
            if (errno == EINTR) continue;
            return cc_err(CC_ERR_IO, "write");
        }
        if (w == 0) return cc_err(CC_ERR_IO, "write");
        off += (size_t)w;
    }
    return cc_ok();
}

void !>(CCError) RtxPieceTree_read_refs(const RtxPieceTree *t, const RtxPieceRef *refs,
                                        size_t nrefs, char *dst, size_t n) {
    size_t i;
    size_t at = 0;
    if (!t || (nrefs && !refs) || (n && !dst))
        return cc_err(CC_ERR_INVALID_ARG, "read refs");
    for (i = 0; i < nrefs; i++) {
        RtxPiece p;
        if (at + refs[i].len < at || at + refs[i].len > n)
            return cc_err(CC_ERR_INTERNAL, "read refs len");
        p = (RtxPiece){0};
        p.buf = (RtxBufKind)refs[i].buf;
        p.start = refs[i].start;
        p.len = refs[i].len;
        rtx_piece_read(t, &p, 0, cc_slice_from_buffer(dst + at, refs[i].len)) !>(e) { return cc_err(e); };
        at += refs[i].len;
    }
    if (at != n) return cc_err(CC_ERR_INTERNAL, "read refs short");
    return cc_ok();
}

/* Stream pieces to fd. Does not load the document into one buffer. */
void !>(CCError) RtxPieceTree_write_fd(RtxPieceTree *t, int fd) {
    return RtxPieceTree_write_fd_from(t, fd, 0, 0);
}

static void rtx_save_span_walk(const RtxNode *n, size_t *tree_off, size_t *lo,
                               int *prefix, size_t *suf0, int *insuf) {
    int aligned;
    if (!n) return;
    rtx_save_span_walk(n->left, tree_off, lo, prefix, suf0, insuf);
    aligned = (n->piece.buf == RTX_BUF_ORIGINAL && n->piece.start == *tree_off);
    if (*prefix) {
        if (aligned) *lo = *tree_off + n->piece.len;
        else {
            *prefix = 0;
            *insuf = 0;
        }
    } else if (aligned) {
        if (!*insuf) {
            *suf0 = *tree_off;
            *insuf = 1;
        }
    } else {
        *insuf = 0;
    }
    *tree_off += n->piece.len;
    rtx_save_span_walk(n->right, tree_off, lo, prefix, suf0, insuf);
}

size_t RtxPieceTree_save_span(const RtxPieceTree *t, size_t *lo, size_t *hi) {
    size_t oldn, newn, tree_off = 0, prefix = 0, suf0 = 0;
    int in_pref = 1, in_suf = 0;
    oldn = t ? rtx_original_len(t) : 0;
    newn = t ? RtxPieceTree_len(t) : 0;
    if (t && t->root)
        rtx_save_span_walk(t->root, &tree_off, &prefix, &in_pref, &suf0, &in_suf);
    if (lo) *lo = prefix > newn ? newn : prefix;
    if (hi) {
        if (newn == oldn && in_suf && suf0 >= prefix) *hi = suf0;
        else *hi = newn;
    }
    return oldn;
}

static void !>(CCError) rtx_piece_read_snap(const RtxPieceTree *t, const RtxPiece *p,
                                           size_t local, char *dest, size_t n,
                                           const char *snap, size_t snap_lo,
                                           size_t snap_n) {
    size_t fo;
    if (!snap || !snap_n || !p || p->buf != RTX_BUF_ORIGINAL)
        return rtx_piece_read(t, p, local, cc_slice_from_buffer(dest, n));
    fo = p->start + local;
    if (fo < snap_lo || fo - snap_lo > snap_n || n > snap_n - (fo - snap_lo))
        return cc_err(CC_ERR_INTERNAL, "save snap");
    {
        char[:] dst = cc_slice_from_buffer(dest, n);
        char[:] src = cc_slice_from_buffer((char *)snap + (fo - snap_lo), n);
        dst.copy(src) !>(e) { return cc_err(e); };
    }
    return cc_ok();
}

static void rtx_save_orig_walk(const RtxNode *n, size_t *cur, size_t from,
                               size_t to, size_t *flo, size_t *fhi, int *any) {
    size_t piece_lo, piece_hi, a, z;
    if (!n) return;
    rtx_save_orig_walk(n->left, cur, from, to, flo, fhi, any);
    piece_lo = *cur;
    piece_hi = *cur + n->piece.len;
    a = piece_lo < from ? from : piece_lo;
    z = piece_hi < to ? piece_hi : to;
    if (a < z && n->piece.buf == RTX_BUF_ORIGINAL) {
        size_t fo = n->piece.start + (a - piece_lo);
        size_t fz = fo + (z - a);
        if (!*any || fo < *flo) *flo = fo;
        if (!*any || fz > *fhi) *fhi = fz;
        *any = 1;
    }
    *cur = piece_hi;
    rtx_save_orig_walk(n->right, cur, from, to, flo, fhi, any);
}

size_t RtxPieceTree_save_orig_span(const RtxPieceTree *t, size_t from, size_t to,
                                   size_t *file_lo, size_t *file_hi) {
    size_t cur = 0, flo = 0, fhi = 0, total;
    int any = 0;
    if (!t || !t->root) return 0;
    total = RtxPieceTree_len(t);
    if (to == 0 || to > total) to = total;
    if (from >= to) return 0;
    rtx_save_orig_walk(t->root, &cur, from, to, &flo, &fhi, &any);
    if (!any) return 0;
    if (file_lo) *file_lo = flo;
    if (file_hi) *file_hi = fhi;
    return fhi > flo ? fhi - flo : 0;
}

static void !>(CCError) rtx_write_node_from(RtxPieceTree *t, const RtxNode *n,
                                           int fd, size_t *cur, size_t from,
                                           size_t to, size_t *written,
                                           size_t total, const char *snap,
                                           size_t snap_lo, size_t snap_n) {
    size_t piece_lo, piece_hi, a, z, off;
    char buf[RTX_PAGE_SIZE];
    if (!n) return cc_ok();
    rtx_write_node_from(t, n->left, fd, cur, from, to, written, total, snap,
                        snap_lo, snap_n) !>(e) {
        return cc_err(e);
    };
    piece_lo = *cur;
    piece_hi = *cur + n->piece.len;
    a = piece_lo < from ? from : piece_lo;
    z = piece_hi < to ? piece_hi : to;
    if (a < z) {
        off = a - piece_lo;
        while (a < z) {
            size_t take = z - a;
            if (take > sizeof(buf)) take = sizeof(buf);
            rtx_piece_read_snap(t, &n->piece, off, buf, take, snap, snap_lo,
                                snap_n) !>(e) {
                return cc_err(e);
            };
            rtx_write_all(fd, buf, take) !>(e) { return cc_err(e); };
            off += take;
            a += take;
            if (written) {
                *written += take;
                rtx_busy_pulse(t, "saving", *written, total);
            }
        }
    }
    *cur = piece_hi;
    return rtx_write_node_from(t, n->right, fd, cur, from, to, written, total,
                               snap, snap_lo, snap_n);
}

void !>(CCError) RtxPieceTree_write_fd_from_snap(RtxPieceTree *t, int fd,
                                                 size_t from, size_t to,
                                                 const char *snap, size_t snap_lo,
                                                 size_t snap_n) {
    size_t written = 0;
    size_t total;
    size_t cur = 0;
    if (!t || fd < 0) return cc_err(CC_ERR_INVALID_ARG, "write_fd");
    if (!t->root) return cc_ok();
    total = RtxPieceTree_len(t);
    if (to == 0 || to > total) to = total;
    if (from >= to) return cc_ok();
    total = to - from;
    rtx_write_node_from(t, t->root, fd, &cur, from, to, &written, total, snap,
                        snap_lo, snap_n) !>(e) {
        rtx_busy_end(t);
        return cc_err(e);
    };
    rtx_busy_end(t);
    return cc_ok();
}

void !>(CCError) RtxPieceTree_write_fd_from(RtxPieceTree *t, int fd, size_t from,
                                            size_t to) {
    return RtxPieceTree_write_fd_from_snap(t, fd, from, to, NULL, 0, 0);
}

#include "piece_tree_lines.cch"

/* ------------------------------------------------------------ bulk
 * DESIGN Edit groups (bulk): a large group lands as one piece-sequence
 * swap instead of one tree replace per site. */

size_t RtxPieceTree_add_end(const RtxPieceTree *t) {
    return t ? t->add_len : 0;
}

void !>(CCError) RtxPieceTree_stage_add(RtxPieceTree *t, size_t rel, char[:] bytes) {
    if (!t) return cc_err(CC_ERR_INVALID_ARG, "null tree");
    if (bytes.len == 0) return cc_ok();
    if (!bytes.ptr) return cc_err(CC_ERR_INVALID_ARG, "null stage bytes");
    return RtxPageStore_stage_add(&t->store, rel, bytes.ptr, bytes.len);
}

/* An RB tree over 2^60 pieces is at most 122 deep. */
#define RTX_BULK_STACK 128

static size_t !>(CCError) rtx_bulk_count(const RtxPieceTree *t) {
    const RtxNode *st[RTX_BULK_STACK];
    const RtxNode *n = t->root;
    size_t sp = 0, c = 0;
    while (n || sp) {
        while (n) {
            if (sp == RTX_BULK_STACK) return cc_err(CC_ERR_INTERNAL, "tree depth");
            st[sp++] = n;
            n = n->left;
        }
        n = st[--sp];
        c++;
        n = n->right;
    }
    return cc_ok(c);
}

typedef struct {
    RtxPiece *p;
    size_t n;
    size_t cap;
} RtxBulkSeq;

/* Append a piece; one that continues the last piece's bytes merges. */
static void rtx_bulk_push(RtxBulkSeq *o, RtxBufKind buf, size_t start, size_t len,
                          size_t lf) {
    RtxPiece *l;
    if (!len) return;
    if (o->n) {
        l = &o->p[o->n - 1];
        if (l->buf == buf && l->start + l->len == start) {
            l->len += len;
            l->lf_count += lf;
            return;
        }
    }
    o->p[o->n].buf = buf;
    o->p[o->n].start = start;
    o->p[o->n].len = len;
    o->p[o->n].lf_count = lf;
    o->n++;
}

/* Balanced subtree over p[a, b). With the middle split every level but
 * the last is full; the last level (`red`) is red, the rest black. */
static RtxNode *rtx_bulk_build(RtxPieceTree *t, const RtxPiece *p, size_t a, size_t b,
                               int depth, int red, RtxNode *parent) {
    size_t m;
    RtxNode *n;
    if (a >= b) return NULL;
    m = a + (b - a) / 2;
    n = rtx_node_alloc(t);
    if (!n) return NULL;
    n->piece = p[m];
    n->parent = parent;
    n->color = depth == red ? RTX_RB_RED : RTX_RB_BLACK;
    n->left = rtx_bulk_build(t, p, a, m, depth + 1, red, n);
    n->right = rtx_bulk_build(t, p, m + 1, b, depth + 1, red, n);
    rtx_node_pull(n);
    return n;
}

void !>(CCError) RtxPieceTree_bulk_swap(RtxPieceTree *t, size_t lo, size_t old_n,
                                        const RtxPieceRef *refs, size_t nrefs,
                                        size_t staged) {
    CCArena a = {0} @destroy;
    RtxBulkSeq o = {0};
    const RtxNode *st[RTX_BULK_STACK];
    const RtxNode *n;
    size_t len, hi, i, nodes, need, pos, sp, add_cap, olen, new_n = 0;
    int ready, placed = 0, levels, red;
    if (!t) return cc_err(CC_ERR_INVALID_ARG, "null tree");
    len = RtxPieceTree_len(t);
    if (lo > len || old_n > len - lo) return cc_err(CC_ERR_INVALID_ARG, "bulk range");
    if (nrefs && !refs) return cc_err(CC_ERR_INVALID_ARG, "bulk refs");
    if (staged && !t->store.add_open) return cc_err(CC_ERR_INVALID_ARG, "bulk staged");
    add_cap = t->add_len + staged;
    if (add_cap < t->add_len) return cc_err(CC_ERR_INVALID_ARG, "bulk staged");
    olen = rtx_original_len(t);
    for (i = 0; i < nrefs; i++) {
        size_t lim = refs[i].buf == RTX_BUF_ORIGINAL ? olen : add_cap;
        if (refs[i].buf != RTX_BUF_ORIGINAL && refs[i].buf != RTX_BUF_ADD)
            return cc_err(CC_ERR_INVALID_ARG, "bulk buf");
        if (refs[i].start > lim || refs[i].len > lim - refs[i].start)
            return cc_err(CC_ERR_INVALID_ARG, "bulk ref range");
        if (new_n + refs[i].len < new_n) return cc_err(CC_ERR_INVALID_ARG, "bulk size");
        new_n += refs[i].len;
    }
    if (len - old_n + new_n < new_n) return cc_err(CC_ERR_INVALID_ARG, "bulk size");
    hi = lo + old_n;
    /* Island lanes walk nodes: join before any node moves. */
    rtx_isle_handle_stop(t);
    if (staged) {
        /* Unreferenced until the rebuild: a later failure leaves them as
         * the bytes of a failed append. */
        RtxPageStore_commit_add(&t->store, staged);
        t->add_len = t->store.add_len;
    }
    rtx_lf_prepare_edit(t, lo, 1) !>(e) { return cc_err(e); };
    ready = t->lf_ready;
    nodes = rtx_bulk_count(t) !>(e) { return cc_err(e); };
    need = nodes + nrefs + 2;
    a = cc_arena_heap(need * sizeof(RtxPiece) + 64);
    if (!a.base) return cc_err(CC_ERR_OUT_OF_MEMORY, "bulk seq");
    o.p = (RtxPiece *)cc_arena_alloc(a, need * sizeof(RtxPiece), 8);
    if (!o.p) return cc_err(CC_ERR_OUT_OF_MEMORY, "bulk seq");
    o.cap = need;
    /* The new sequence: prefix pieces (the one across lo clipped), refs,
     * suffix pieces (the one across hi clipped). Every count that reads
     * happens here, before the tree is touched. */
    pos = 0;
    sp = 0;
    n = t->root;
    while (n || sp) {
        size_t pe;
        const RtxPiece *p;
        while (n) {
            st[sp++] = n;
            n = n->left;
        }
        n = st[--sp];
        p = &n->piece;
        pe = pos + p->len;
        if (!placed && pe > lo) {
            if (pos < lo) {
                size_t lf = 0;
                if (ready)
                    lf = rtx_buf_count_lf(t, p->buf, p->start, lo - pos) !>(e) {
                        return cc_err(e);
                    };
                rtx_bulk_push(&o, p->buf, p->start, lo - pos, lf);
            }
            for (i = 0; i < nrefs; i++) {
                size_t lf = 0;
                if (ready) {
                    if (refs[i].lf_ok) lf = refs[i].lf_count;
                    else
                        lf = rtx_buf_count_lf(t, (RtxBufKind)refs[i].buf, refs[i].start,
                                              refs[i].len) !>(e) { return cc_err(e); };
                }
                rtx_bulk_push(&o, (RtxBufKind)refs[i].buf, refs[i].start, refs[i].len, lf);
            }
            placed = 1;
        }
        if (pe <= lo) {
            rtx_bulk_push(&o, p->buf, p->start, p->len, p->lf_count);
        } else if (pe > hi) {
            if (pos >= hi) {
                rtx_bulk_push(&o, p->buf, p->start, p->len, p->lf_count);
            } else {
                size_t cut = hi - pos, lf = 0;
                if (ready)
                    lf = rtx_buf_count_lf(t, p->buf, p->start + cut, p->len - cut) !>(e) {
                        return cc_err(e);
                    };
                rtx_bulk_push(&o, p->buf, p->start + cut, p->len - cut, lf);
            }
        }
        pos = pe;
        n = n->right;
    }
    if (!placed) {
        for (i = 0; i < nrefs; i++) {
            size_t lf = 0;
            if (ready) {
                if (refs[i].lf_ok) lf = refs[i].lf_count;
                else
                    lf = rtx_buf_count_lf(t, (RtxBufKind)refs[i].buf, refs[i].start,
                                          refs[i].len) !>(e) { return cc_err(e); };
            }
            rtx_bulk_push(&o, (RtxBufKind)refs[i].buf, refs[i].start, refs[i].len, lf);
        }
    }
    /* Nodes for the new sequence exist before the old tree goes. */
    for (i = nodes; i < o.n; i++) {
        RtxNode *x = (RtxNode *)cc_arena_alloc(*t->arena, sizeof(RtxNode), _Alignof(RtxNode));
        if (!x) return cc_err(CC_ERR_OUT_OF_MEMORY, "bulk nodes");
        rtx_node_recycle(t, x);
    }
    /* From here nothing fails. */
    sp = 0;
    n = t->root;
    while (n || sp) {
        RtxNode *x;
        const RtxNode *next;
        while (n) {
            st[sp++] = n;
            n = n->left;
        }
        x = (RtxNode *)st[--sp];
        next = x->right;
        rtx_node_recycle(t, x);
        n = next;
    }
    t->root = NULL;
    levels = 0;
    for (i = o.n; i; i >>= 1) levels++;
    red = levels > 1 ? levels - 1 : -1;
    t->root = rtx_bulk_build(t, o.p, 0, o.n, 0, red, NULL);
    if (t->root) t->root->color = RTX_RB_BLACK;
    if (t->lf_ready) {
        if (t->line_off_ok && t->line_off_len) rtx_line_index_rebuild_suffix(t, lo);
        else rtx_line_index_build(t);
    }
    rtx_line_want_cancel(t);
    rtx_line_pins_wipe_from(t, lo);
    rtx_line_isle_drop(t);
    return cc_ok();
}

void rtx_isle_handle_stop(RtxPieceTree *t) {
    if (!t) return;
    rtx_isle_store_cancel(t, 1);
    if (!t->isle_h.live()) return;
    if (t->isle_h.paused())
        t->isle_h.resume() !>(e) { (void)e; };
    /* Drop/kick: cancel the wrapper and the block wave, then join.
     * Resume first — invalidate does not unpause a parked stage. */
    t->isle_h.invalidate();
}

static size_t rtx_isle_read_block(RtxPieceTree *t, size_t start, char *buf,
                                 size_t want) {
    @errhandler(CCError e) {
        (void)e;
        if (t) rtx_isle_store_cancel(t, 1);
        return 0;
    }
    if (!t || !buf || !want) return 0;
    return RtxPieceTree_read_uncached(t, start, cc_slice_from_buffer(buf, want)) !>;
}

/* Wait-for tickets. Joined inside this arm so the dest-live kick returns.
 * Block window is a per-iteration heap arena (this TU's chapter splice does
 * not bind @parallel cache the way find.ccs does). */
static int rtx_isle_run(RtxPieceTree *t) {
    size_t span_lo;
    size_t span_hi;
    size_t remain;
    size_t n_sz;
    size_t acc;
    size_t plen;
    int n;
    int i;
    bool fin;
    if (!t) return 0;
    /* Pin targets: the tree does not change while the arm runs (every
     * mutation joins the island first). */
    plen = RtxPieceTree_len(t);
    /* Planted by the caller before the kick. Do not read line_scan_off:
     * the host's prefix pump writes it while this arm runs. */
    span_lo = t->isle_floor;
    span_hi = t->isle_anchor;
    if (span_hi < span_lo) span_hi = span_lo;
    remain = span_hi - span_lo;
    /* isle_from / isle_before planted on kick; publish only in @stage below. */
    if (remain == 0 || !rtx_isle_load_live(t) || rtx_isle_load_cancel(t)) return 1;
    n_sz = (remain + (size_t)RTX_ISLE_BLOCK - 1) / (size_t)RTX_ISLE_BLOCK;
    if (n_sz > (size_t)INT_MAX) return 0;
    n = (int)n_sz;
    acc = 0;

    {
        @errhandler(CCError e) {
            (void)e;
            return 0;
        }
        CCArena ta = cc_arena_heap(kilobytes(64)) @destroy;
        CCTurnstile ts@(RTX_ISLE_CAP, 1, ta) !> @destroy;

        fin = @parallel wait (ts) for (i in 0..n) {
            size_t hi;
            size_t lo;
            size_t want;
            size_t got;
            size_t lfs;
            size_t npin;
            size_t pin_slot[RTX_LINE_MARK_MAX];
            size_t pin_tail[RTX_LINE_MARK_MAX];

            hi = span_hi - (size_t)i * (size_t)RTX_ISLE_BLOCK;
            lo = hi > (size_t)RTX_ISLE_BLOCK ? hi - (size_t)RTX_ISLE_BLOCK : 0;
            if (lo < span_lo) lo = span_lo;
            want = hi > lo ? hi - lo : 0;
            lfs = 0;
            npin = 0;
            if (want && !rtx_isle_load_cancel(t) && rtx_isle_load_live(t)) {
                CCArena lane =
                    cc_arena_heap((size_t)RTX_ISLE_BLOCK + kilobytes(64)) @destroy;
                char *buf =
                    (char *)cc_arena_alloc(lane, (size_t)RTX_ISLE_BLOCK, 1);
                if (buf) {
                    got = rtx_isle_read_block(t, lo, buf, want);
                    if (got < want && got) lo = hi - got;
                    if (got == want) {
                        /* Count down from hi in segments cut at the 1/32
                         * targets in (lo, hi]; each cut's tail is LFs in
                         * [target, hi). Same bytes as one count. */
                        size_t s = RTX_LINE_MARK_MAX;
                        size_t cut = got;
                        while (s-- > 0) {
                            size_t tgt = rtx_line_pin_target(s, plen);
                            if (tgt > hi) continue;
                            if (tgt <= lo) break;
                            lfs += rtx_count_lf(buf + (tgt - lo), cut - (tgt - lo));
                            cut = tgt - lo;
                            pin_slot[npin] = s;
                            pin_tail[npin] = lfs;
                            npin++;
                        }
                        lfs += rtx_count_lf(buf, cut);
                    } else {
                        lfs = rtx_count_lf(buf, got);
                    }
                } else {
                    rtx_isle_store_cancel(t, 1);
                }
            }

            @stage (ts, 0, i) {
                while ((t->isle_h.paused || rtx_isle_load_hold(t))
                       && !rtx_isle_load_cancel(t))
                    cc_yield();
                if (!rtx_isle_load_cancel(t) && rtx_isle_load_live(t)) {
                    size_t k;
                    for (k = 0; k < npin; k++) {
                        t->isle_pin_rel[pin_slot[k]] = acc + pin_tail[k];
                        t->isle_pin_set[pin_slot[k]] = 1;
                    }
                    acc += lfs;
                    /* before, then from: a reader that sees from connected
                     * reads this count. */
                    atomic_store_explicit(&t->isle_before, acc,
                                          memory_order_release);
                    atomic_store_explicit(&t->isle_from,
                                          lo <= span_lo ? span_lo : lo,
                                          memory_order_release);
                }
            }

            if (rtx_isle_load_cancel(t) || !rtx_isle_load_live(t)
                || t->isle_from <= span_lo)
                break;
        } !>.wait()!>;
    }

    (void)fin;
    return rtx_isle_load_cancel(t) ? 0 : 1;
}

void !>(CCError) rtx_isle_listing_start(RtxPieceTree *t) {
    int noop = 0;
    /* Not `t`: the handle lives on t->isle_h, and that owner is captured
     * by reference. `scan` is a different pointer name, so it is copied. */
    RtxPieceTree *scan;
    if (!t) return cc_err(CC_ERR_INVALID_ARG, "isle kick");
    scan = t;
    if (!rtx_isle_load_live(t) || rtx_isle_load_cancel(t) || t->lf_ready) return cc_ok();
    if (t->isle_anchor <= t->line_scan_off || t->isle_anchor <= t->isle_floor)
        return cc_ok();
    if (t->isle_h.live()) return cc_ok();
    /* Host thread, arm down: the prefix may have passed the floor since
     * the kick. The arm reads only the floor planted here. */
    if (t->line_scan_off > t->isle_floor) {
        t->isle_floor = t->line_scan_off;
        t->isle_base_line = t->scan_line;
    }
    t->isle_h = @parallel {
        @serial { noop = 0; }
        rtx_isle_run(scan);
    } !>;
    return cc_ok();
}

void !>(CCError) rtx_line_isle_finish(RtxPieceTree *t) {
    if (!t) return cc_ok();
    rtx_isle_store_hold(t, 0);
    if (rtx_isle_load_live(t) && !t->isle_h.live() && rtx_line_isle_pumping(t)
        && !rtx_isle_load_cancel(t))
        rtx_isle_listing_start(t) !>(e) { return cc_err(e); };
    if (t->isle_h.live()) {
        if (t->isle_h.paused())
            t->isle_h.resume() !>(e) { return cc_err(CC_ERR_IO, cc_io_error_str(e)); };
        t->isle_h.wait() !>(e) { return cc_err(e); };
    }
    return cc_ok();
}

void rtx_line_isle_pause(RtxPieceTree *t) {
    if (!t || !t->isle_h.live()) return;
    t->isle_h.pause() !>(e) { (void)e; };
}

void rtx_line_isle_resume(RtxPieceTree *t) {
    if (!t || !t->isle_h.live() || !t->isle_h.paused()) return;
    t->isle_h.resume() !>(e) { (void)e; };
}

void rtx_line_isle_hold(RtxPieceTree *t, int on) {
    rtx_isle_store_hold(t, on ? 1 : 0);
}

int RtxPieceTree_lf_ready(const RtxPieceTree *t) {
    return rtx_lf_weights_ok(t);
}

static int rtx_check_node(const RtxPieceTree *t, const RtxNode *n, const RtxNode *parent,
                          int *black_height, int *err) {
    int lh = 0;
    int rh = 0;
    size_t expect_len;
    size_t expect_lf;
    if (*err) return 0;
    if (!n) {
        *black_height = 1;
        return 1;
    }
    if (n->parent != parent) {
        *err = 1;
        return 0;
    }
    if (n->color == RTX_RB_RED) {
        if ((n->left && n->left->color == RTX_RB_RED) ||
            (n->right && n->right->color == RTX_RB_RED)) {
            *err = 2;
            return 0;
        }
    }
    {
        size_t got_lf = 0;
        @errhandler(CCError e) {
            (void)e;
            *err = 3;
            return 0;
        }
        got_lf = rtx_buf_count_lf(t, n->piece.buf, n->piece.start, n->piece.len) !>;
        if (n->piece.lf_count != got_lf) {
            *err = 3;
            return 0;
        }
    }
    rtx_check_node(t, n->left, n, &lh, err);
    rtx_check_node(t, n->right, n, &rh, err);
    if (*err) return 0;
    if (lh != rh) {
        *err = 4;
        return 0;
    }
    expect_len = n->piece.len + (n->left ? n->left->subtree_len : 0) +
                 (n->right ? n->right->subtree_len : 0);
    expect_lf = n->piece.lf_count + (n->left ? n->left->subtree_lf : 0) +
                (n->right ? n->right->subtree_lf : 0);
    if (n->subtree_len != expect_len || n->subtree_lf != expect_lf) {
        *err = 5;
        return 0;
    }
    *black_height = lh + (n->color == RTX_RB_BLACK ? 1 : 0);
    return 1;
}

size_t rtx_tree_read(void *tree, size_t off, char *dst, size_t n) {
    size_t got = 0;
    if (!tree || !dst || !n) return 0;
    @errhandler(CCError e) {
        (void)e;
        return 0;
    }
    got = RtxPieceTree_read_at((RtxPieceTree *)tree, off, cc_slice_from_buffer(dst, n)) !>;
    return got;
}

size_t rtx_tree_len(void *tree) {
    return RtxPieceTree_len((const RtxPieceTree *)tree);
}

int RtxPieceTree_check(const RtxPieceTree *t) {
    int bh = 0;
    int err = 0;
    if (!t) return 0;
    if (!t->lf_ready) {
        @errhandler(CCError e) {
            (void)e;
            return 0;
        }
        rtx_lf_ensure((RtxPieceTree *)t) !>;
    }
    if (t->root && t->root->color != RTX_RB_BLACK) return 0;
    if (t->root && t->root->parent) return 0;
    rtx_check_node(t, t->root, NULL, &bh, &err);
    return err == 0;
}

