#!ccc ccs
/*
 * Piece-tree implementation (linked TU; see piece_tree.cch).
 * RB + line index stay textual includes into this one unit.
 */
#include <ccc/std/prelude.cch>
#include <errno.h>
#include <unistd.h>
#include <stdlib.h>
#include <string.h>
#include <time.h>

#include "piece_tree_priv.cch"

static void rtx_line_index_note_insert(RtxPieceTree *t, size_t off, size_t ins_len,
                                       size_t lf);
static void rtx_line_index_note_erase(RtxPieceTree *t, size_t off, size_t n,
                                      size_t lf);

size_t RtxPieceTree_len(const RtxPieceTree *t) {
    if (!t || !t->root) return 0;
    return t->root->subtree_len;
}

static double rtx_mono_ms(void) {
    struct timespec ts;
    if (clock_gettime(CLOCK_MONOTONIC, &ts) != 0) return 0.0;
    return (double)ts.tv_sec * 1000.0 + (double)ts.tv_nsec / 1.0e6;
}

static void rtx_busy_end(RtxPieceTree *t) {
    if (!t || !t->busy_fn) return;
    t->busy_fn(t->busy_ctx, NULL, 100);
    t->busy_last_ms = 0.0;
}

/* Throttled progress. pct is 0..100, or -1 when total is unknown.
 * Mutates busy_last_ms — not const. */
static void rtx_busy_pulse(RtxPieceTree *t, const char *label, size_t done,
                           size_t total) {
    double now;
    int pct;
    if (!t || !t->busy_fn || !label) return;
    now = rtx_mono_ms();
    if (t->busy_last_ms > 0.0 && now - t->busy_last_ms < 50.0 &&
        !(total > 0 && done >= total)) {
        return;
    }
    t->busy_last_ms = now;
    if (total == 0) pct = -1;
    else pct = rtx_pct(done, total);
    t->busy_fn(t->busy_ctx, label, pct);
}

static size_t rtx_count_lf(const char *p, size_t n) {
    size_t c = 0;
    size_t i;
    if (!p) return 0;
    for (i = 0; i < n; i++) {
        if (p[i] == '\n') c++;
    }
    return c;
}

static size_t rtx_original_len(const RtxPieceTree *t) {
    if (!t) return 0;
    if (t->original.ptr) return t->original.len;
    return t->store.orig_len;
}

static int rtx_orig_is_mem(const RtxPieceTree *t) {
    return t && t->original.ptr != NULL;
}

/* Count newlines in a piece range. Store I/O surfaces as Result. */
static size_t !>(CCError) rtx_buf_count_lf(const RtxPieceTree *t, RtxBufKind buf,
                                            size_t start, size_t len) {
    char tmp[RTX_IO_CHUNK];
    size_t off = 0;
    size_t c = 0;
    if (!t) return cc_err(CC_ERR_INVALID_ARG, "count lf");
    if (len == 0) return cc_ok(0);
    if (buf == RTX_BUF_ORIGINAL && rtx_orig_is_mem(t)) {
        if (start > t->original.len || len > t->original.len - start) {
            return cc_err(CC_ERR_INTERNAL, "orig lf range");
        }
        return cc_ok(rtx_count_lf((const char *)t->original.ptr + start, len));
    }
    {
        RtxStoreFile f = (buf == RTX_BUF_ORIGINAL) ? RTX_STORE_ORIG : RTX_STORE_ADD;
        while (off < len) {
            size_t take = len - off;
            if (take > sizeof(tmp)) take = sizeof(tmp);
            RtxPageStore_read((RtxPageStore *)&t->store, f, start + off, tmp, take) !>(e) {
                return cc_err(e);
            };
            c += rtx_count_lf(tmp, take);
            off += take;
        }
    }
    return cc_ok(c);
}

/* Copy piece bytes [local, local+n) into dest. */
static void !>(CCError) rtx_piece_read(const RtxPieceTree *t, const RtxPiece *p,
                                      size_t local, char *dest, size_t n) {
    if (!t || !p || !dest) return cc_err(CC_ERR_INVALID_ARG, "piece read");
    if (n == 0) return cc_ok();
    if (local > p->len || n > p->len - local) {
        return cc_err(CC_ERR_INTERNAL, "piece read range");
    }
    if (p->buf == RTX_BUF_ORIGINAL && rtx_orig_is_mem(t)) {
        memcpy(dest, (const char *)t->original.ptr + p->start + local, n);
        return cc_ok();
    }
    {
        RtxStoreFile f = (p->buf == RTX_BUF_ORIGINAL) ? RTX_STORE_ORIG : RTX_STORE_ADD;
        return RtxPageStore_read((RtxPageStore *)&t->store, f, p->start + local, dest, n);
    }
}

static void !>(CCError) rtx_piece_read_uncached(const RtxPieceTree *t, const RtxPiece *p,
                                               size_t local, char *dest, size_t n) {
    if (!t || !p || !dest) return cc_err(CC_ERR_INVALID_ARG, "piece read");
    if (n == 0) return cc_ok();
    if (local > p->len || n > p->len - local) {
        return cc_err(CC_ERR_INTERNAL, "piece read range");
    }
    if (p->buf == RTX_BUF_ORIGINAL && rtx_orig_is_mem(t)) {
        memcpy(dest, (const char *)t->original.ptr + p->start + local, n);
        return cc_ok();
    }
    {
        RtxStoreFile f = (p->buf == RTX_BUF_ORIGINAL) ? RTX_STORE_ORIG : RTX_STORE_ADD;
        return RtxPageStore_pread(&t->store, f, p->start + local, dest, n);
    }
}

#include "piece_tree_rb.cch"


static size_t !>(CCError) rtx_add_append(RtxPieceTree *t, char[:] bytes) {
    size_t start;
    if (!t) return cc_err(CC_ERR_INVALID_ARG, "add append");
    if (bytes.len == 0) return cc_ok(t->add_len);
    if (!bytes.ptr) return cc_err(CC_ERR_INVALID_ARG, "null add bytes");
    start = RtxPageStore_append_add(&t->store, bytes.ptr, bytes.len) !>(e) {
        return cc_err(e);
    };
    t->add_len = t->store.add_len;
    return cc_ok(start);
}

static void rtx_tree_zero(RtxPieceTree *t) {
    RtxBusyFn fn;
    void *ctx;
    if (!t) return;
    /* Busy is a UI session binding, not document-epoch state. */
    fn = t->busy_fn;
    ctx = t->busy_ctx;
    memset(t, 0, sizeof(*t));
    t->busy_fn = fn;
    t->busy_ctx = ctx;
    rtx_page_store_zero(&t->store);
}

static int rtx_tree_init_arena(RtxPieceTree *t) {
    t->arena_storage = cc_arena_heap(kilobytes(64));
    if (!t->arena_storage.base) return 0;
    t->arena = &t->arena_storage;
    return 1;
}

static void !>(CCError) rtx_lf_recount_node(RtxPieceTree *t, RtxNode *n) {
    if (!n) return cc_ok();
    rtx_lf_recount_node(t, n->left) !>(e) { return cc_err(e); };
    n->piece.lf_count = rtx_buf_count_lf(t, n->piece.buf, n->piece.start,
                                          n->piece.len) !>(e) {
        return cc_err(e);
    };
    rtx_lf_recount_node(t, n->right) !>(e) { return cc_err(e); };
    rtx_node_pull(n);
    return cc_ok();
}

static int rtx_line_off_push(RtxPieceTree *t, size_t off);

static void !>(CCError) rtx_tree_seed_original(RtxPieceTree *t) {
    RtxNode *n;
    size_t olen;
    size_t lf;
    olen = rtx_original_len(t);
    if (!olen) {
        t->lf_ready = 1;
        return cc_ok();
    }
    if (rtx_orig_is_mem(t)) {
        lf = rtx_buf_count_lf(t, RTX_BUF_ORIGINAL, 0, olen) !>(e) {
            return cc_err(e);
        };
        t->lf_ready = 1;
        t->line_off_ok = 0;
    } else {
        lf = 0;
        t->lf_ready = 0;
        t->line_scan_off = 0;
        t->scan_line = 0;
        t->line_off_ok = 0;
    }
    n = rtx_node_new_piece_lf(t, RTX_BUF_ORIGINAL, 0, olen, lf);
    if (!n) return cc_err(CC_ERR_OUT_OF_MEMORY, "seed original");
    n->color = RTX_RB_BLACK;
    t->root = n;
    if (!t->lf_ready) {
        if (!rtx_line_off_push(t, 0)) return cc_err(CC_ERR_OUT_OF_MEMORY, "line_off");
    }
    return cc_ok();
}

/* Success: got = min(n, len-off). A hole inside that range is INTERNAL. */
size_t !>(CCError) RtxPieceTree_read_at(const RtxPieceTree *t, size_t offset,
                                                      char *dest, size_t n) {
    size_t got = 0;
    size_t len;
    size_t need;
    if (!t || !dest) return cc_err(CC_ERR_INVALID_ARG, "read_at");
    if (n == 0) return cc_ok(0);
    len = RtxPieceTree_len(t);
    if (offset >= len) return cc_ok(0);
    if (n > len - offset) n = len - offset;
    need = n;
    while (got < n) {
        size_t local = 0;
        RtxNode *node = rtx_find_node(t, offset + got, &local);
        size_t take;
        if (!node) return cc_err(CC_ERR_INTERNAL, "read_at hole");
        take = node->piece.len - local;
        if (take > n - got) take = n - got;
        rtx_piece_read(t, &node->piece, local, dest + got, take) !>(e) {
            return cc_err(e);
        };
        got += take;
    }
    if (got != need) return cc_err(CC_ERR_INTERNAL, "read_at short");
    return cc_ok(got);
}

size_t !>(CCError) RtxPieceTree_read_uncached(const RtxPieceTree *t, size_t offset,
                                             char *dest, size_t n) {
    size_t got = 0;
    size_t len;
    size_t need;
    if (!t || !dest) return cc_err(CC_ERR_INVALID_ARG, "read_uncached");
    if (n == 0) return cc_ok(0);
    len = RtxPieceTree_len(t);
    if (offset >= len) return cc_ok(0);
    if (n > len - offset) n = len - offset;
    need = n;
    while (got < n) {
        size_t local = 0;
        RtxNode *node = rtx_find_node(t, offset + got, &local);
        size_t take;
        if (!node) return cc_err(CC_ERR_INTERNAL, "read_uncached hole");
        take = node->piece.len - local;
        if (take > n - got) take = n - got;
        rtx_piece_read_uncached(t, &node->piece, local, dest + got, take) !>(e) {
            return cc_err(e);
        };
        got += take;
    }
    if (got != need) return cc_err(CC_ERR_INTERNAL, "read_uncached short");
    return cc_ok(got);
}

/*
 * Extend the progressive line scan through byte `want_off`.
 */
void !>(RtxIndexErr) rtx_line_scan_to(RtxPieceTree *t, size_t want_off) {
    size_t len;
    char buf[64 * 1024];
    if (!t) return cc_err(rtx_index_err("scan"));
    if (t->lf_ready) return cc_ok();
    len = RtxPieceTree_len(t);
    if (want_off > len) want_off = len;
    if (t->line_off_len == 0) {
        if (!rtx_line_off_push(t, 0)) return cc_err(rtx_index_err("line_off"));
    }
    while (t->line_scan_off < want_off) {
        size_t take = want_off - t->line_scan_off;
        size_t got, i;
        if (take > sizeof(buf)) take = sizeof(buf);
        rtx_busy_pulse(t, "indexing", t->line_scan_off, want_off);
        got = RtxPieceTree_read_at(t, t->line_scan_off, buf, take) !>(e) {
            rtx_busy_end(t);
            return cc_err(rtx_index_from_cc(e));
        };
        if (!got) {
            rtx_busy_end(t);
            return cc_err(rtx_index_err("line scan"));
        }
        for (i = 0; i < got; i++) {
            if (buf[i] == '\n') {
                t->scan_line++;
                if (t->scan_line % (size_t)RTX_LINE_STRIDE == 0) {
                    if (!rtx_line_off_push(t, t->line_scan_off + i + 1)) {
                        rtx_busy_end(t);
                        return cc_err(rtx_index_err("line_off"));
                    }
                }
            }
        }
        t->line_scan_off += got;
    }
    rtx_busy_end(t);
    if (t->line_scan_off >= len) {
        if (t->root && !t->root->left && !t->root->right) {
            t->root->piece.lf_count = t->scan_line;
            rtx_node_pull(t->root);
            t->lf_ready = 1;
            t->line_off_ok = 1;
        } else if (len <= (size_t)RTX_LINE_SOFT_MIN) {
            rtx_lf_recount_node(t, t->root) !>(e) {
                return cc_err(rtx_index_from_cc(e));
            };
            t->lf_ready = 1;
            t->line_off_ok = 1;
        } else {
            /* Edited huge doc: keep progressive; scan_line is exact at EOF. */
            t->line_off_ok = 1;
        }
    }
    return cc_ok();
}

/* Scan until line index `want_line` is known (scan_line >= want_line) or EOF. */
static void !>(RtxIndexErr) rtx_line_scan_through_line(RtxPieceTree *t, size_t want_line) {
    size_t len;
    char buf[64 * 1024];
    if (!t) return cc_err(rtx_index_err("scan"));
    if (t->lf_ready) return cc_ok();
    len = RtxPieceTree_len(t);
    if (t->line_off_len == 0) {
        if (!rtx_line_off_push(t, 0)) return cc_err(rtx_index_err("line_off"));
    }
    while (t->scan_line < want_line && t->line_scan_off < len) {
        size_t got, i;
        size_t take = sizeof(buf);
        if (take > len - t->line_scan_off) take = len - t->line_scan_off;
        rtx_busy_pulse(t, "jump", t->scan_line, want_line);
        got = RtxPieceTree_read_at(t, t->line_scan_off, buf, take) !>(e) {
            rtx_busy_end(t);
            return cc_err(rtx_index_from_cc(e));
        };
        if (!got) {
            rtx_busy_end(t);
            return cc_err(rtx_index_err("line scan"));
        }
        for (i = 0; i < got; i++) {
            if (buf[i] == '\n') {
                t->scan_line++;
                if (t->scan_line % (size_t)RTX_LINE_STRIDE == 0) {
                    if (!rtx_line_off_push(t, t->line_scan_off + i + 1)) {
                        rtx_busy_end(t);
                        return cc_err(rtx_index_err("line_off"));
                    }
                }
                if (t->scan_line >= want_line) {
                    t->line_scan_off += i + 1;
                    break;
                }
            }
        }
        if (t->scan_line >= want_line) break;
        t->line_scan_off += got;
    }
    rtx_busy_end(t);
    if (t->line_scan_off >= len) {
        if (t->root && !t->root->left && !t->root->right) {
            t->root->piece.lf_count = t->scan_line;
            rtx_node_pull(t->root);
            t->lf_ready = 1;
            t->line_off_ok = 1;
        } else if (len <= (size_t)RTX_LINE_SOFT_MIN) {
            rtx_lf_recount_node(t, t->root) !>(e) {
                return cc_err(rtx_index_from_cc(e));
            };
            t->lf_ready = 1;
            t->line_off_ok = 1;
        } else {
            t->line_off_ok = 1;
        }
    }
    return cc_ok();
}

/* Finish newline weights. Completes any progressive scan to EOF. */
static void !>(CCError) rtx_lf_ensure(RtxPieceTree *t) {
    if (!t || t->lf_ready) return cc_ok();
    rtx_line_scan_to(t, RtxPieceTree_len(t)) !>(e) {
        return cc_err(CC_ERR_IO, e.message ? e.message : "line index");
    };
    if (!t->lf_ready && t->root) {
        rtx_lf_recount_node(t, t->root) !>(e) { return cc_err(e); };
        t->lf_ready = 1;
        t->line_off_ok = 1;
    }
    return cc_ok();
}

/*
 * Append a copy of [from, from+n) at EOF via frame chunk + store append.
 * Maintains the line index (one patch after the copy).
 * Returns newlines copied.
 */
size_t !>(CCError) RtxPieceTree_append_copy(RtxPieceTree *t, size_t from,
                                                      size_t n) {
    size_t off = 0;
    size_t local = 0;
    size_t at;
    RtxNode *tip;
    size_t lf = 0;
    char chunk[64 * 1024];
    if (!t) return cc_err(CC_ERR_INVALID_ARG, "null tree");
    if (n == 0) return cc_ok((size_t)0);
    at = RtxPieceTree_len(t);
    if (from > RtxPieceTree_len(t) || n > RtxPieceTree_len(t) - from) {
        return cc_err(CC_ERR_INVALID_ARG, "append_copy range");
    }
    rtx_lf_ensure(t) !>(e) { return cc_err(e); };

    tip = NULL;
    if (RtxPieceTree_len(t) > 0) {
        tip = rtx_find_node(t, RtxPieceTree_len(t) - 1, &local);
        if (tip && tip->piece.buf == RTX_BUF_ADD &&
            tip->piece.start + tip->piece.len == t->add_len &&
            local + 1 == tip->piece.len) {
            /* extendable tip */
        } else {
            tip = NULL;
        }
    }
    if (!tip) {
        tip = rtx_node_new_piece_lf(t, RTX_BUF_ADD, t->add_len, 0, 0);
        if (!tip) return cc_err(CC_ERR_OUT_OF_MEMORY, "append tip");
        rtx_bst_insert(t, tip, RtxPieceTree_len(t));
    }

    while (off < n) {
        size_t take = n - off;
        size_t got, i;
        size_t start;
        if (take > sizeof(chunk)) take = sizeof(chunk);
        got = RtxPieceTree_read_at(t, from + off, chunk, take) !>(e) {
            return cc_err(e);
        };
        if (got != take) return cc_err(CC_ERR_INTERNAL, "append_copy read");
        start = RtxPageStore_append_add(&t->store, chunk, got) !>(e) {
            return cc_err(e);
        };
        if (tip->piece.len == 0) tip->piece.start = start;
        else if (start != tip->piece.start + tip->piece.len) {
            return cc_err(CC_ERR_INTERNAL, "append_copy gap");
        }
        for (i = 0; i < got; i++) {
            if (chunk[i] == '\n') lf++;
        }
        t->add_len = t->store.add_len;
        tip->piece.len += got;
        off += got;
    }
    tip->piece.lf_count += lf;
    rtx_node_pull_up(tip);
    rtx_line_index_note_insert(t, at, n, lf);
    return cc_ok(lf);
}

/* Contiguous borrowed original, or empty if store-backed / split. */
static char[:] rtx_tree_flat(const RtxPieceTree *t) {
    RtxNode *n;
    if (!t || !t->root || !rtx_orig_is_mem(t)) return cc_slice_empty();
    n = t->root;
    if (n->left || n->right) return cc_slice_empty();
    if (n->piece.buf != RTX_BUF_ORIGINAL) return cc_slice_empty();
    if (n->piece.start != 0 || n->piece.len != t->original.len) return cc_slice_empty();
    return t->original;
}

/* View of [from, from+n) when it sits in one borrowed contiguous piece.
 * Store-backed pieces leave *view empty (DESIGN: no stable page views). */
static int rtx_tree_span_into(const RtxPieceTree *t, size_t from, size_t n, char[:] *view) {
    size_t local = 0;
    size_t len;
    RtxNode *node;
    char[:] piece;
    if (view) *view = cc_slice_empty();
    if (!t || !view || n == 0) return 0;
    len = RtxPieceTree_len(t);
    if (from >= len) return 0;
    if (n > len - from) n = len - from;
    {
        char[:] flat = rtx_tree_flat(t);
        if (flat.ptr && from <= flat.len && n <= flat.len - from) {
            *view = flat.sub(from, from + n);
            return 1;
        }
    }
    node = rtx_find_node(t, from, &local);
    if (!node || local + n > node->piece.len) return 0;
    if (node->piece.buf != RTX_BUF_ORIGINAL || !rtx_orig_is_mem(t)) return 0;
    piece = t->original.sub(node->piece.start,
                            node->piece.start + node->piece.len);
    *view = piece.sub(local, local + n);
    return 1;
}

char[:] RtxPieceTree_span(const RtxPieceTree *t, size_t from, size_t n) {
    char[:] view = cc_slice_empty();
    (void)rtx_tree_span_into(t, from, n, &view);
    return view;
}

char[:] !>(CCError) RtxPieceTree_scratch_span(const RtxPieceTree *t, size_t from,
                                              size_t n, CCArena *a) {
    char[:] view;
    char[:] copy;
    size_t len;
    if (!t) return cc_err(CC_ERR_INVALID_ARG, "null tree");
    if (n == 0) return cc_ok(cc_slice_empty());
    view = RtxPieceTree_span(t, from, n);
    if (view.ptr) return cc_ok(view);
    if (!a) return cc_err(CC_ERR_INVALID_ARG, "null scratch");
    len = RtxPieceTree_len(t);
    if (from >= len) return cc_ok(cc_slice_empty());
    if (n > len - from) n = len - from;
    if (n == 0) return cc_ok(cc_slice_empty());
    copy = a->alloc_slice_bytes(n);
    if (!copy.ptr || copy.len < n) return cc_err(CC_ERR_OUT_OF_MEMORY, "scratch span");
    {
        size_t got = RtxPieceTree_read_at(t, from, copy.ptr, n) !>(e) { return cc_err(e); };
        if (got != n) return cc_err(CC_ERR_INTERNAL, "scratch span read");
    }
    return cc_ok(copy);
}

void RtxPieceTree_destroy(RtxPieceTree *t) {
    if (!t) return;
    t->store.destroy();
    /* line_off lives on the piece-tree arena — do not free() it. */
    if (t->arena && t->arena->base) {
        t->arena_storage.destroy();
    }
    rtx_tree_zero(t);
}

void !>(CCError) RtxPieceTree_empty(RtxPieceTree *t) {
    if (!t) return cc_err(CC_ERR_INVALID_ARG, "null tree");
    if (RtxPieceTree_is_live(t)) return cc_err(CC_ERR_INVALID_ARG, "tree already live");
    rtx_tree_zero(t);
    if (!rtx_tree_init_arena(t)) {
        return cc_err(CC_ERR_OUT_OF_MEMORY, "piece tree arena");
    }
    t->lf_ready = 1;
    return cc_ok();
}

void !>(CCError) RtxPieceTree_from_buffer(RtxPieceTree *t, char[:] bytes) {
    if (!t) return cc_err(CC_ERR_INVALID_ARG, "null tree");
    if (RtxPieceTree_is_live(t)) return cc_err(CC_ERR_INVALID_ARG, "tree already live");
    if (bytes.len && cc_slice_is_untracked_id(bytes.id)) {
        return cc_err(CC_ERR_INVALID_ARG, "untracked buffer");
    }
    rtx_tree_zero(t);
    if (!rtx_tree_init_arena(t)) {
        return cc_err(CC_ERR_OUT_OF_MEMORY, "piece tree arena");
    }
    t->original = bytes;
    rtx_tree_seed_original(t) !>(e) {
        RtxPieceTree_destroy(t);
        return cc_err(e);
    };
    return cc_ok();
}

void !>(CCError) RtxPieceTree_from_path(RtxPieceTree *t, const char *path) {
    if (!t) return cc_err(CC_ERR_INVALID_ARG, "null tree");
    if (RtxPieceTree_is_live(t)) return cc_err(CC_ERR_INVALID_ARG, "tree already live");
    rtx_tree_zero(t);
    if (!path || !path[0]) return cc_err(CC_ERR_INVALID_ARG, "empty path");
    if (!rtx_tree_init_arena(t)) {
        return cc_err(CC_ERR_OUT_OF_MEMORY, "piece tree arena");
    }
    RtxPageStore_open_original(&t->store, path) !>(e) {
        RtxPieceTree_destroy(t);
        return cc_err(e);
    };
    if (t->store.orig_len == 0) {
        t->lf_ready = 1;
        return cc_ok();
    }
    rtx_tree_seed_original(t) !>(e) {
        RtxPieceTree_destroy(t);
        return cc_err(e);
    };
    return cc_ok();
}

/* Split the piece containing `offset` so a node begins at `offset`.
 * Allocates the right node before shrinking the left. offset == len is a no-op.
 * When lf weights are not ready, both sides keep lf_count 0 (progressive index
 * does not need them). When ready, count only the shorter side and subtract. */
static void !>(CCError) rtx_split_at(RtxPieceTree *t, size_t offset) {
    size_t local = 0;
    RtxNode *n;
    RtxNode *right;
    size_t right_len;
    RtxBufKind buf;
    size_t start;
    size_t right_lf;
    size_t left_lf;
    if (!t) return cc_err(CC_ERR_INVALID_ARG, "null tree");
    if (offset == 0 || offset == RtxPieceTree_len(t)) return cc_ok();
    n = rtx_find_node(t, offset, &local);
    if (!n) return cc_err(CC_ERR_INTERNAL, "split node");
    if (local == 0) return cc_ok();
    right_len = n->piece.len - local;
    buf = n->piece.buf;
    start = n->piece.start + local;
    if (!t->lf_ready) {
        right_lf = 0;
        left_lf = 0;
    } else if (local <= right_len) {
        left_lf = rtx_buf_count_lf(t, buf, n->piece.start, local) !>(e) {
            return cc_err(e);
        };
        if (left_lf > n->piece.lf_count) {
            return cc_err(CC_ERR_INTERNAL, "split lf");
        }
        right_lf = n->piece.lf_count - left_lf;
    } else {
        right_lf = rtx_buf_count_lf(t, buf, start, right_len) !>(e) { return cc_err(e); };
        if (right_lf > n->piece.lf_count) {
            return cc_err(CC_ERR_INTERNAL, "split lf");
        }
        left_lf = n->piece.lf_count - right_lf;
    }
    right = rtx_node_new_piece_lf(t, buf, start, right_len, right_lf);
    if (!right) return cc_err(CC_ERR_OUT_OF_MEMORY, "split node");
    n->piece.len = local;
    n->piece.lf_count = left_lf;
    rtx_node_pull_up(n);
    rtx_bst_insert(t, right, offset);
    return cc_ok();
}

static size_t !>(RtxIndexErr) rtx_count_lf_range(const RtxPieceTree *t, size_t from,
                                                 size_t n);

/* True when the body is large enough that edits must not finish a full lf scan. */
static int rtx_lf_huge(const RtxPieceTree *t) {
    return t && RtxPieceTree_len(t) > (size_t)RTX_LINE_SOFT_MIN;
}

/*
 * Truncate the progressive index at `off` and clear lf_ready so later
 * line_* resume from here. Does not read past `off`.
 */
static void !>(CCError) rtx_lf_invalidate_from(RtxPieceTree *t, size_t off) {
    size_t keep, from_slot, at;
    size_t extra;
    @errhandler(CCError e) {
        return cc_err(e);
    }
    @errhandler(RtxIndexErr ie) {
        return cc_err(CC_ERR_IO, ie.message ? ie.message : "line index");
    }
    if (!t) return cc_err(CC_ERR_INVALID_ARG, "invalidate");
    if (t->line_off_len == 0) {
        if (!rtx_line_off_push(t, 0)) return cc_err(CC_ERR_OUT_OF_MEMORY, "line_off");
    }
    keep = 0;
    while (keep < t->line_off_len && t->line_off[keep] < off) keep++;
    from_slot = keep > 0 ? keep - 1 : 0;
    t->line_off_len = from_slot + 1;
    at = t->line_off[from_slot];
    if (at > off) at = 0;
    extra = 0;
    if (off > at) {
        if (off - at > (size_t)RTX_LINE_ISLE_BUDGET) {
            t->scan_line = from_slot * (size_t)RTX_LINE_STRIDE;
            t->line_scan_off = off;
            t->lf_ready = 0;
            t->line_off_ok = 0;
            return cc_ok();
        }
        extra = rtx_count_lf_range(t, at, off - at) !>;
    }
    t->scan_line = from_slot * (size_t)RTX_LINE_STRIDE + extra;
    t->line_scan_off = off;
    t->lf_ready = 0;
    t->line_off_ok = 1;
    return cc_ok();
}

/*
 * Prepare for a mutation at `off`. Huge files never scan to EOF. A gap
 * edit (off past the prefix frontier) does not scan_to — that was the
 * 8G type-to-hang. A letter edit inside the prefix must not drop the
 * suffix either — that was the 2G JSON type-to-rescan. Only an edit
 * that changes newlines truncates the stride index. Tip inserts keep
 * the current frontier. Small files still finish the index.
 */
static void !>(CCError) rtx_lf_prepare_edit(RtxPieceTree *t, size_t off,
                                           int lines_change) {
    size_t len;
    if (!t) return cc_err(CC_ERR_INVALID_ARG, "prepare edit");
    len = RtxPieceTree_len(t);
    if (off > len) off = len;
    if (rtx_lf_huge(t)) {
        if (t->lf_ready) t->lf_ready = 0;
        if (off < len) {
            if (lines_change && off <= t->line_scan_off) {
                rtx_lf_invalidate_from(t, off) !>(e) { return cc_err(e); };
            }
        } else {
            if (t->line_off_len == 0) {
                if (!rtx_line_off_push(t, 0)) {
                    return cc_err(CC_ERR_OUT_OF_MEMORY, "line_off");
                }
            }
            t->line_off_ok = 1;
        }
        return cc_ok();
    }
    rtx_lf_ensure(t) !>(e) { return cc_err(e); };
    return cc_ok();
}

/* 1 = tip-extended; 0 = not applicable (caller should split+insert). */
static int !>(CCError) rtx_try_extend_add(RtxPieceTree *t, size_t offset, char[:] bytes) {
    size_t local = 0;
    RtxNode *n;
    if (!t || bytes.len == 0 || offset == 0) return cc_ok(0);
    n = rtx_find_node(t, offset - 1, &local);
    if (!n) return cc_ok(0);
    if (n->piece.buf != RTX_BUF_ADD) return cc_ok(0);
    if (n->piece.start + n->piece.len != t->add_len) return cc_ok(0);
    if (local + 1 != n->piece.len) return cc_ok(0);
    rtx_add_append(t, bytes) !>(e) { return cc_err(e); };
    n->piece.len += bytes.len;
    n->piece.lf_count += rtx_count_lf(bytes.ptr, bytes.len);
    rtx_node_pull_up(n);
    return cc_ok(1);
}

static int rtx_ins_prof_on = 0;
static RtxInsertProf rtx_ins_prof;
static int rtx_fail_replace;
static int rtx_fail_replace_unrestorable;

void RtxPieceTree_fail_next_replace(RtxPieceTree *t, int unrestorable) {
    (void)t;
    rtx_fail_replace = 1;
    rtx_fail_replace_unrestorable = unrestorable ? 1 : 0;
}

void RtxPieceTree_profile_insert(RtxPieceTree *t, int on) {
    (void)t;
    rtx_ins_prof_on = on;
    memset(&rtx_ins_prof, 0, sizeof(rtx_ins_prof));
}

RtxInsertProf RtxPieceTree_insert_prof(const RtxPieceTree *t) {
    (void)t;
    return rtx_ins_prof;
}

/* TU-internal. Public write is replace (range in [0, len]). */
static void !>(CCError) rtx_tree_insert(RtxPieceTree *t, size_t offset, char[:] bytes) {
    size_t start = 0;
    RtxNode *n;
    size_t len;
    size_t lf;
    int extended;
    int prof = rtx_ins_prof_on;
    double t0 = 0.0;
    if (!t) return cc_err(CC_ERR_INVALID_ARG, "null tree");
    len = RtxPieceTree_len(t);
    if (offset > len) return cc_err(CC_ERR_INVALID_ARG, "insert past end");
    if (bytes.len == 0) return cc_ok();
    if (prof) {
        rtx_ins_prof.lf_ready0 = t->lf_ready;
        rtx_ins_prof.huge = rtx_lf_huge(t);
        rtx_ins_prof.scan0 = t->line_scan_off;
        rtx_ins_prof.line_off0 = t->line_off_len;
        t0 = rtx_mono_ms();
    }
    rtx_lf_prepare_edit(t, offset, rtx_count_lf(bytes.ptr, bytes.len) != 0) !>(e) {
        return cc_err(e);
    };
    if (prof) {
        rtx_ins_prof.prepare_ms = rtx_mono_ms() - t0;
        t0 = rtx_mono_ms();
    }
    extended = rtx_try_extend_add(t, offset, bytes) !>(e) { return cc_err(e); };
    if (extended) {
        if (prof) {
            rtx_ins_prof.add_ms = rtx_mono_ms() - t0;
            rtx_ins_prof.extended = 1;
            t0 = rtx_mono_ms();
        }
        if (!t->line_off_suspend) {
            rtx_line_index_note_insert(t, offset, bytes.len,
                                      rtx_count_lf(bytes.ptr, bytes.len));
        }
        if (prof) {
            rtx_ins_prof.note_ms = rtx_mono_ms() - t0;
            rtx_ins_prof.lf_ready1 = t->lf_ready;
            rtx_ins_prof.scan1 = t->line_scan_off;
            rtx_ins_prof.line_off1 = t->line_off_len;
        }
        return cc_ok();
    }
    rtx_split_at(t, offset) !>(e) { return cc_err(e); };
    if (prof) {
        rtx_ins_prof.split_ms = rtx_mono_ms() - t0;
        t0 = rtx_mono_ms();
    }
    start = rtx_add_append(t, bytes) !>(e) { return cc_err(e); };
    if (prof) {
        rtx_ins_prof.add_ms = rtx_mono_ms() - t0;
        t0 = rtx_mono_ms();
    }
    lf = rtx_count_lf(bytes.ptr, bytes.len);
    n = rtx_node_new_piece_lf(t, RTX_BUF_ADD, start, bytes.len, lf);
    if (!n) return cc_err(CC_ERR_OUT_OF_MEMORY, "piece node");
    rtx_bst_insert(t, n, offset);
    if (prof) t0 = rtx_mono_ms();
    if (!t->line_off_suspend) {
        rtx_line_index_note_insert(t, offset, bytes.len, n->piece.lf_count);
    }
    if (prof) {
        rtx_ins_prof.note_ms = rtx_mono_ms() - t0;
        rtx_ins_prof.lf_ready1 = t->lf_ready;
        rtx_ins_prof.scan1 = t->line_scan_off;
        rtx_ins_prof.line_off1 = t->line_off_len;
    }
    return cc_ok();
}

static void !>(CCError) rtx_tree_erase(RtxPieceTree *t, size_t offset, size_t n) {
    size_t len;
    size_t end;
    size_t erased;
    size_t lf = 0;
    @errhandler(CCError e) {
        return cc_err(e);
    }
    @errhandler(RtxIndexErr ie) {
        return cc_err(CC_ERR_IO, ie.message ? ie.message : "line index");
    }
    if (!t) return cc_err(CC_ERR_INVALID_ARG, "null tree");
    len = RtxPieceTree_len(t);
    if (offset > len || n > len - offset) {
        return cc_err(CC_ERR_INVALID_ARG, "erase out of range");
    }
    if (n == 0) return cc_ok();
    {
        int lines = 0;
        if (n > (size_t)RTX_LINE_ISLE_BUDGET) lines = 1;
        else {
            lf = rtx_count_lf_range(t, offset, n) !>;
            lines = lf != 0;
        }
        rtx_lf_prepare_edit(t, offset, lines) !>;
    }
    if (t->lf_ready) {
        lf = rtx_count_lf_range(t, offset, n) !>;
    } else if (n > (size_t)RTX_LINE_ISLE_BUDGET) {
        lf = 0;
    }
    end = offset + n;
    erased = n;
    rtx_split_at(t, offset) !>;
    rtx_split_at(t, end) !>;
    while (n > 0) {
        size_t local = 0;
        RtxNode *node = rtx_find_node(t, offset, &local);
        size_t piece_len;
        if (!node || local != 0) {
            t->line_off_ok = 0;
            return cc_err(CC_ERR_INTERNAL, "erase walk");
        }
        piece_len = node->piece.len;
        if (piece_len > n) {
            t->line_off_ok = 0;
            return cc_err(CC_ERR_INTERNAL, "erase piece");
        }
        rtx_rb_delete(t, node);
        n -= piece_len;
    }
    if (!t->line_off_suspend) {
        rtx_line_index_note_erase(t, offset, erased, lf);
    } else {
        t->line_off_ok = 0;
    }
    return cc_ok();
}

/* Walk [off, off+n) without splitting. One entry per covering piece. */
static size_t !>(CCError) rtx_range_piece_count(const RtxPieceTree *t, size_t off,
                                                size_t n) {
    size_t np = 0;
    size_t at = off;
    size_t remain = n;
    size_t len;
    if (!t) return cc_err(CC_ERR_INVALID_ARG, "null tree");
    len = RtxPieceTree_len(t);
    if (off > len || n > len - off) return cc_err(CC_ERR_INVALID_ARG, "capture range");
    if (n == 0) return cc_ok((size_t)0);
    while (remain) {
        size_t local = 0;
        size_t take;
        RtxNode *node = rtx_find_node(t, at, &local);
        if (!node) return cc_err(CC_ERR_INTERNAL, "capture walk");
        take = node->piece.len - local;
        if (take > remain) take = remain;
        if (take == 0) return cc_err(CC_ERR_INTERNAL, "capture take");
        np++;
        at += take;
        remain -= take;
    }
    return cc_ok(np);
}

static void !>(CCError) rtx_range_piece_fill(const RtxPieceTree *t, size_t off, size_t n,
                                            RtxPieceRef *out, size_t nout) {
    size_t at = off;
    size_t remain = n;
    size_t i = 0;
    if (!t || !out) return cc_err(CC_ERR_INVALID_ARG, "capture fill");
    while (remain) {
        size_t local = 0;
        size_t take;
        size_t lf;
        RtxNode *node = rtx_find_node(t, at, &local);
        if (!node || i >= nout) return cc_err(CC_ERR_INTERNAL, "capture fill");
        take = node->piece.len - local;
        if (take > remain) take = remain;
        out[i].buf = (unsigned char)node->piece.buf;
        out[i].start = node->piece.start + local;
        out[i].len = take;
        if (local == 0 && take == node->piece.len) {
            lf = node->piece.lf_count;
        } else if (t->lf_ready) {
            lf = rtx_buf_count_lf(t, node->piece.buf, out[i].start, take) !>(e) {
                return cc_err(e);
            };
        } else {
            lf = 0;
        }
        out[i].lf_count = lf;
        i++;
        at += take;
        remain -= take;
    }
    if (i != nout) return cc_err(CC_ERR_INTERNAL, "capture count");
    return cc_ok();
}

void !>(CCError) RtxPieceTree_capture_range(const RtxPieceTree *t, size_t off, size_t n,
                                            CCArena *a, RtxPieceRef **out, size_t *nout) {
    size_t np;
    RtxPieceRef *refs;
    if (!t || !a || !out || !nout) return cc_err(CC_ERR_INVALID_ARG, "capture");
    *out = NULL;
    *nout = 0;
    np = rtx_range_piece_count(t, off, n) !>(e) { return cc_err(e); };
    if (np == 0) return cc_ok();
    refs = (RtxPieceRef *)cc_arena_alloc(a, np * sizeof(RtxPieceRef), 8);
    if (!refs) return cc_err(CC_ERR_OUT_OF_MEMORY, "capture refs");
    rtx_range_piece_fill(t, off, n, refs, np) !>(e) { return cc_err(e); };
    *out = refs;
    *nout = np;
    return cc_ok();
}

/* Insert captured pieces at `off` (does not erase). Original/add bytes stay. */
void !>(CCError) RtxPieceTree_splice_refs(RtxPieceTree *t, size_t off,
                                          const RtxPieceRef *refs, size_t nrefs) {
    size_t i;
    size_t at;
    size_t len;
    if (!t) return cc_err(CC_ERR_INVALID_ARG, "null tree");
    if (nrefs == 0) return cc_ok();
    if (!refs) return cc_err(CC_ERR_INVALID_ARG, "splice refs");
    len = RtxPieceTree_len(t);
    if (off > len) return cc_err(CC_ERR_INVALID_ARG, "splice off");
    {
        int lines = 0;
        for (i = 0; i < nrefs; i++) {
            if (refs[i].lf_count) {
                lines = 1;
                break;
            }
        }
        rtx_lf_prepare_edit(t, off, lines) !>(e) { return cc_err(e); };
    }
    rtx_split_at(t, off) !>(e) { return cc_err(e); };
    at = off;
    for (i = 0; i < nrefs; i++) {
        RtxNode *node;
        size_t lf;
        unsigned char buf = refs[i].buf;
        if (refs[i].len == 0) continue;
        if (buf != RTX_BUF_ORIGINAL && buf != RTX_BUF_ADD) {
            return cc_err(CC_ERR_INVALID_ARG, "splice buf");
        }
        if (buf == RTX_BUF_ORIGINAL) {
            if (refs[i].start + refs[i].len > rtx_original_len(t)) {
                return cc_err(CC_ERR_INVALID_ARG, "splice orig");
            }
        } else if (refs[i].start + refs[i].len > t->add_len) {
            return cc_err(CC_ERR_INVALID_ARG, "splice add");
        }
        lf = t->lf_ready ? refs[i].lf_count : 0;
        node = rtx_node_new_piece_lf(t, (RtxBufKind)buf, refs[i].start, refs[i].len, lf);
        if (!node) return cc_err(CC_ERR_OUT_OF_MEMORY, "splice node");
        rtx_bst_insert(t, node, at);
        if (!t->line_off_suspend) {
            rtx_line_index_note_insert(t, at, refs[i].len, node->piece.lf_count);
        }
        at += refs[i].len;
    }
    return cc_ok();
}

/* One user-visible change. Pure erase recycles nodes; original/add bytes stay.
 * Insert-fail splices captured piece refs back (no byte hold of `del`). */
void !>(CCError) RtxPieceTree_replace(RtxPieceTree *t, size_t off, size_t n,
                                                   char[:] ins) {
    RtxPieceRef *refs = NULL;
    size_t nrefs = 0;
    CCArena hold = {0};
    if (!t) return cc_err(CC_ERR_INVALID_ARG, "null tree");
    if (rtx_fail_replace) {
        int unrest = rtx_fail_replace_unrestorable;
        rtx_fail_replace = 0;
        rtx_fail_replace_unrestorable = 0;
        if (unrest) return cc_err(RTX_ERR_UNRESTORABLE, "replace unrestorable");
        return cc_err(CC_ERR_INTERNAL, "replace failed");
    }
    {
        size_t len = RtxPieceTree_len(t);
        if (off > len || n > len - off) {
            return cc_err(CC_ERR_INVALID_ARG, "replace range");
        }
    }
    if (n == 0 && ins.len == 0) return cc_ok();
    if (n && ins.len) {
        size_t np = rtx_range_piece_count(t, off, n) !>(e) { return cc_err(e); };
        size_t need = np * sizeof(RtxPieceRef) + 64;
        if (need < 64) need = 64;
        hold = cc_arena_heap(need);
        if (!hold.base) return cc_err(CC_ERR_OUT_OF_MEMORY, "replace hold");
    }
    @defer { if (hold.base) hold.destroy(); };
    if (n && ins.len) {
        RtxPieceTree_capture_range(t, off, n, &hold, &refs, &nrefs) !>(e) {
            return cc_err(e);
        };
    }
    if (n) {
        rtx_tree_erase(t, off, n) !>(e) { return cc_err(e); };
    }
    if (ins.len) {
        rtx_tree_insert(t, off, ins) !>(e) {
            if (n && nrefs) {
                RtxPieceTree_splice_refs(t, off, refs, nrefs) !>(e2) {
                    (void)e2;
                    return cc_err(RTX_ERR_UNRESTORABLE, "replace unrestorable");
                };
            }
            return cc_err(e);
        };
    }
    return cc_ok();
}

static void !>(CCError) rtx_write_all(int fd, const char *p, size_t n) {
    size_t off = 0;
    while (off < n) {
        ssize_t w = write(fd, p + off, n - off);
        if (w < 0) {
            if (errno == EINTR) continue;
            return cc_err(CC_ERR_IO, "write");
        }
        if (w == 0) return cc_err(CC_ERR_IO, "write");
        off += (size_t)w;
    }
    return cc_ok();
}

static void !>(CCError) rtx_write_node(RtxPieceTree *t, const RtxNode *n, int fd,
                                         size_t *written, size_t total) {
    char buf[RTX_PAGE_SIZE];
    size_t off;
    if (!n) return cc_ok();
    rtx_write_node(t, n->left, fd, written, total) !>(e) { return cc_err(e); };
    off = 0;
    while (off < n->piece.len) {
        size_t take = n->piece.len - off;
        if (take > sizeof(buf)) take = sizeof(buf);
        rtx_piece_read(t, &n->piece, off, buf, take) !>(e) { return cc_err(e); };
        rtx_write_all(fd, buf, take) !>(e) { return cc_err(e); };
        off += take;
        if (written) {
            *written += take;
            rtx_busy_pulse(t, "saving", *written, total);
        }
    }
    return rtx_write_node(t, n->right, fd, written, total);
}

void !>(CCError) RtxPieceTree_read_refs(const RtxPieceTree *t, const RtxPieceRef *refs,
                                        size_t nrefs, char *dst, size_t n) {
    size_t i;
    size_t at = 0;
    if (!t || (nrefs && !refs) || (n && !dst))
        return cc_err(CC_ERR_INVALID_ARG, "read refs");
    for (i = 0; i < nrefs; i++) {
        RtxPiece p;
        if (at + refs[i].len < at || at + refs[i].len > n)
            return cc_err(CC_ERR_INTERNAL, "read refs len");
        memset(&p, 0, sizeof(p));
        p.buf = (RtxBufKind)refs[i].buf;
        p.start = refs[i].start;
        p.len = refs[i].len;
        rtx_piece_read(t, &p, 0, dst + at, refs[i].len) !>(e) { return cc_err(e); };
        at += refs[i].len;
    }
    if (at != n) return cc_err(CC_ERR_INTERNAL, "read refs short");
    return cc_ok();
}

/* Stream pieces to fd. Does not load the document into one buffer. */
void !>(CCError) RtxPieceTree_write_fd(RtxPieceTree *t, int fd) {
    size_t written = 0;
    size_t total;
    if (!t || fd < 0) return cc_err(CC_ERR_INVALID_ARG, "write_fd");
    if (!t->root) return cc_ok();
    total = RtxPieceTree_len(t);
    rtx_write_node(t, t->root, fd, &written, total) !>(e) {
        rtx_busy_end(t);
        return cc_err(e);
    };
    rtx_busy_end(t);
    return cc_ok();
}

#include "piece_tree_lines.cch"

int RtxPieceTree_lf_ready(const RtxPieceTree *t) {
    return rtx_lf_weights_ok(t);
}

static int rtx_check_node(const RtxPieceTree *t, const RtxNode *n, const RtxNode *parent,
                          int *black_height, int *err) {
    int lh = 0;
    int rh = 0;
    size_t expect_len;
    size_t expect_lf;
    if (*err) return 0;
    if (!n) {
        *black_height = 1;
        return 1;
    }
    if (n->parent != parent) {
        *err = 1;
        return 0;
    }
    if (n->color == RTX_RB_RED) {
        if ((n->left && n->left->color == RTX_RB_RED) ||
            (n->right && n->right->color == RTX_RB_RED)) {
            *err = 2;
            return 0;
        }
    }
    {
        size_t got_lf = 0;
        @errhandler(CCError e) {
            (void)e;
            *err = 3;
            return 0;
        }
        got_lf = rtx_buf_count_lf(t, n->piece.buf, n->piece.start, n->piece.len) !>;
        if (n->piece.lf_count != got_lf) {
            *err = 3;
            return 0;
        }
    }
    rtx_check_node(t, n->left, n, &lh, err);
    rtx_check_node(t, n->right, n, &rh, err);
    if (*err) return 0;
    if (lh != rh) {
        *err = 4;
        return 0;
    }
    expect_len = n->piece.len + (n->left ? n->left->subtree_len : 0) +
                 (n->right ? n->right->subtree_len : 0);
    expect_lf = n->piece.lf_count + (n->left ? n->left->subtree_lf : 0) +
                (n->right ? n->right->subtree_lf : 0);
    if (n->subtree_len != expect_len || n->subtree_lf != expect_lf) {
        *err = 5;
        return 0;
    }
    *black_height = lh + (n->color == RTX_RB_BLACK ? 1 : 0);
    return 1;
}

size_t rtx_tree_read(void *tree, size_t off, char *dst, size_t n) {
    size_t got = 0;
    if (!tree || !dst || !n) return 0;
    @errhandler(CCError e) {
        (void)e;
        return 0;
    }
    got = RtxPieceTree_read_at((RtxPieceTree *)tree, off, dst, n) !>;
    return got;
}

size_t rtx_tree_len(void *tree) {
    return RtxPieceTree_len((const RtxPieceTree *)tree);
}

int RtxPieceTree_check(const RtxPieceTree *t) {
    int bh = 0;
    int err = 0;
    if (!t) return 0;
    if (!t->lf_ready) {
        @errhandler(CCError e) {
            (void)e;
            return 0;
        }
        rtx_lf_ensure((RtxPieceTree *)t) !>;
    }
    if (t->root && t->root->color != RTX_RB_BLACK) return 0;
    if (t->root && t->root->parent) return 0;
    rtx_check_node(t, t->root, NULL, &bh, &err);
    return err == 0;
}

