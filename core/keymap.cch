/*
 * Keymap + settings files (owner: keymap.ccs). Plain C decls.
 *
 * One keymap per process (the host it runs in). Default chords come from
 * the command table (cmd.cch); keys.json adds, replaces and unbinds:
 *
 *   {
 *     "ctrl+shift+p": "palette.open",
 *     "ctrl+p": ["workspace.quick_open", "nav.prev_mark"],
 *     "ctrl+t": null,
 *     "tui": { "f2": "file.save" },
 *     "gui": { "ctrl+w": "buffer.close" }
 *   }
 *
 * A string binds, an array is a chain (the first available id runs),
 * null / "" / "-" unbinds (the chord does nothing, whatever it did before).
 * "tui" / "gui" objects hold entries for that host only; top-level
 * entries apply to both. A later entry for the same chord replaces an
 * earlier one. An id no row has is inert (the chord does nothing) and is
 * reported; a RESERVED id is inert until its command lands.
 *
 * Files: $RTX_KEYS or --keys FILE, else $XDG_CONFIG_HOME/cctext/keys.json,
 * else ~/.config/cctext/keys.json (macOS too: one path for the terminal
 * and cctext-ui). settings.json sits beside it ($RTX_SETTINGS /
 * --settings FILE override).
 */
#ifndef RTX_KEYMAP_H
#define RTX_KEYMAP_H

#include <stddef.h>
#include <stdint.h>
#include "cmd.cch"

/* rtx_keymap_lookup results besides a row index (>= 0). */
enum {
    RTX_KM_NONE = -1,  /* no binding: the host keeps its own meaning */
    RTX_KM_INERT = -2  /* bound to nothing (unbound / unknown / reserved) */
};

/* Reset to the table defaults for `host`, then load `path` (NULL: the
 * default path; a missing default file is fine). Errors land in err ("" =
 * none); the defaults stay for anything the file did not set. Returns the
 * number of user entries applied, -1 on a read / parse error. */
int rtx_keymap_setup(int host, const char *path, char *err, size_t errn);
/* Same, from text (tests). */
int rtx_keymap_load_text(int host, const char *text, size_t n, char *err,
                         size_t errn);
/* Table defaults only (after rtx_cmd_register adds rows, call again or
 * rtx_keymap_setup). */
void rtx_keymap_defaults(int host);
int rtx_keymap_host(void);

/* Row to run for a chord, or RTX_KM_NONE / RTX_KM_INERT. A letter chord
 * with Shift that nothing binds falls back to the chord without Shift (as
 * the hosts did before the table). */
int rtx_keymap_lookup(uint32_t chord);

/* Key hint for row i ("Ctrl-G", "Ctrl-B Ctrl-O"): the chords that run it
 * now, or for an unavailable row the chords that name it. "" if none. */
const char *rtx_keymap_hint(int row);
/* First chord that runs row i (0 if none). */
uint32_t rtx_keymap_first(int row);
/* Bumped by every rtx_keymap_defaults / load: text built from the keymap
 * (the help overlay) is stale when this or rtx_cmd_n() moved. */
unsigned rtx_keymap_gen(void);

/* The default path of a config file ("keys.json", "settings.json") into
 * dst. 0 if no HOME / XDG_CONFIG_HOME. */
int rtx_config_path(const char *name, char *dst, size_t n);

/* ---- settings.json ----------------------------------------------------
 *   { "tab_spaces": 4, "autopair": true, "blink": true,
 *     "caret": "cursor" | "cell", "caret_fade": false, "rich": true,
 *     "esc_timeout_ms": 10, "scroll_regions": true }
 * Unknown keys are ignored (reported). Flags still override. */
typedef struct {
    int tab_spaces, has_tab_spaces;
    int autopair, has_autopair;
    int blink, has_blink;
    int caret_cell, has_caret;
    int caret_fade, has_caret_fade;
    int rich, has_rich;
    int esc_timeout_ms, has_esc_timeout_ms;
    int scroll_regions, has_scroll_regions;
} RtxSettings;

/* path NULL: $RTX_SETTINGS, else the default path. 0 = ok or no file,
 * -1 = error (err filled; fields parsed before the error are kept). */
int rtx_settings_load(const char *path, RtxSettings *s, char *err, size_t errn);
int rtx_settings_parse(const char *text, size_t n, RtxSettings *s, char *err,
                       size_t errn);

#endif /* RTX_KEYMAP_H */
