#!ccc cch
/*
 * Shared hex-view geometry (offset | hex pairs | UTF-8 dump).
 * Bodies in hex.ccs (linked TU).
 */
#ifndef RTX_HEX_H
#define RTX_HEX_H

#include <ccc/std/prelude.cch>

#define RTX_HEX_COLS 16
#define RTX_HEX_OFF_W 11
#define RTX_HEX_GAP 2
#define RTX_HEX_DUMP_LOOK 3
#define RTX_HEX_DUMP_WIN (RTX_HEX_DUMP_LOOK * 2 + RTX_HEX_COLS)

enum {
    RTX_HEX_DUMP_EMPTY = 0,
    RTX_HEX_DUMP_DOT = 1,
    RTX_HEX_DUMP_LEAD = 2,
    RTX_HEX_DUMP_CONT = 3
};

/* One dump column. Always one cell; `utf8` is the glyph (lead) or `·` / `.`. */
typedef struct {
    int kind;
    char utf8[5];
    int n;
} RtxHexDumpCell;

size_t rtx_hex_row_count(size_t len);
size_t rtx_hex_align(size_t off);
size_t rtx_hex_row_off(size_t top_byte, size_t row);
char rtx_hex_ascii(unsigned char c);
int rtx_hex_ascii_col0(void);

/* Classify `got` dump cells. `win` is [lookback][row][lookahead]. */
void rtx_hex_dump_row(const unsigned char *win, size_t win_n,
                      size_t look, size_t got, RtxHexDumpCell out[RTX_HEX_COLS]);

static size_t rtx_hex_dump_look(size_t off) {
    return off < (size_t)RTX_HEX_DUMP_LOOK ? off : (size_t)RTX_HEX_DUMP_LOOK;
}

static size_t rtx_hex_dump_tail(size_t off, size_t take, size_t n) {
    size_t end = off + take;
    size_t left;
    if (end >= n) return 0;
    left = n - end;
    return left < (size_t)RTX_HEX_DUMP_LOOK ? left : (size_t)RTX_HEX_DUMP_LOOK;
}

/* 0–15, or -1 if not a hex digit. */
static int rtx_hex_digit(uint32_t cp) {
    if (cp >= '0' && cp <= '9') return (int)(cp - '0');
    if (cp >= 'a' && cp <= 'f') return (int)(cp - 'a' + 10);
    if (cp >= 'A' && cp <= 'F') return (int)(cp - 'A' + 10);
    return -1;
}

/* Which nibble a TTY column hits: 0 high, 1 low. Dump / offset → high. */
static int rtx_hex_nib_from_col(int col) {
    int h;
    if (col < RTX_HEX_OFF_W || col >= rtx_hex_ascii_col0()) return 0;
    h = col - RTX_HEX_OFF_W;
    return (h % 3) >= 1 ? 1 : 0;
}

static int rtx_hex_nib_from_x(float local_x, float cw) {
    float off_w, hex_w, hx, cell, rem;
    if (cw < 1.0f) cw = 1.0f;
    off_w = cw * (float)RTX_HEX_OFF_W;
    hex_w = cw * 3.0f * (float)RTX_HEX_COLS;
    if (local_x < off_w || local_x >= off_w + hex_w) return 0;
    hx = local_x - off_w;
    cell = cw * 3.0f;
    rem = hx - (float)((int)(hx / cell)) * cell;
    return rem >= cw ? 1 : 0;
}

/* Monospace cell hit-test (TTY columns). */
size_t rtx_hex_hit_col(size_t top_byte, size_t n, int row, int col);

/* Pixel hit-test: local_x is relative to pane origin; cw is mono cell width. */
size_t rtx_hex_hit_x(size_t top_byte, size_t n, int row, float local_x, float cw);

#endif /* RTX_HEX_H */
