#!ccc ccs
/*
 * A Mermaid file's picture (linked TU; see mmd_view.cch).
 */
#include <ccc/std/prelude.cch>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include "mmd_view.cch"

int rtx_mmd_view_ok(void) {
    return rtx_img_limits()->mermaid != 0;
}

void rtx_mmd_pic(RtxDoc *d, RtxMmdPic *P) {
    const RtxImgLimits *lim = rtx_img_limits();
    size_t n, cap = (size_t)lim->mm_max, got = 0;
    char *buf = NULL;
    static char why[160];
    memset(P, 0, sizeof *P);
    n = d ? d->len() : 0;
    if (n > cap) {
        /* Refused unread: a keyed source that errs (a fence's too). */
        rtx_img_src_mermaid("", 0, rtx_img_mm_theme(), &P->src);
        P->src.err = RTX_IMG_ESVGBIG;
    } else {
        buf = (char *)malloc(n + 1);
        if (buf && n) {
            @errhandler(CCError e) {
                (void)e;
                got = 0;
            }
            got = d->read_at(0, cc_slice_from_buffer(buf, n)) !>;
        }
        rtx_img_src_mermaid(buf ? buf : "", got, rtx_img_mm_theme(), &P->src);
        if (!buf) P->src.err = RTX_IMG_ENOMEM;
    }
    rtx_img_info(&P->src, &P->v);
    free(buf);
    /* The entry holds the bytes now; later asks go by key. */
    P->src.data = NULL;
    P->src.data_n = 0;
    if (P->v.have_info && P->v.state != RTX_IMG_S_ERR) {
        P->have = 1;
        P->w = P->v.info.w;
        P->h = P->v.info.h;
    }
    if (P->v.state == RTX_IMG_S_ERR) {
        if (n > cap) {
            snprintf(why, sizeof why, "diagram source over mermaid_max_kb (%zu KiB)",
                     (size_t)(cap >> 10));
            P->msg = why;
        } else if (!got) {
            P->msg = "empty diagram";
        } else if (P->v.msg && P->v.msg[0]) {
            P->msg = P->v.msg;
        } else {
            rtx_img_err_text(P->v.err ? P->v.err : P->src.err, why, sizeof why);
            P->msg = why;
        }
    }
    if (rtx_img_mm_prev(d, RTX_MMD_OWNER_LO, &P->prev) &&
        strcmp(P->prev.key, P->src.key) != 0 && P->prev.kind == P->src.kind) {
        rtx_img_info(&P->prev, &P->pv);
        if (P->pv.have_info && P->pv.state != RTX_IMG_S_ERR) {
            P->have_prev = 1;
            if (!P->have) {
                P->have = 1;
                P->stale = 1;
                P->w = P->pv.info.w;
                P->h = P->pv.info.h;
            }
        }
    }
    /* The last good diagram: one with pixels to show while the next one
     * renders (a source typed past before it was drawn never becomes it). */
    if (P->v.have_info && P->v.state != RTX_IMG_S_ERR && rtx_img_has_pixels(&P->src))
        rtx_img_mm_note(d, RTX_MMD_OWNER_LO, &P->src);
}

void rtx_mmd_rec(const RtxMmdPic *P, double w, double h, RtxImgRec *rec) {
    memset(rec, 0, sizeof *rec);
    rec->mm = 1;
    rec->w = w;
    rec->h = h;
    rec->state = P->v.state;
    (void)rtx_img_mermaid_key(&P->src, &rec->mm_h, &rec->mm_n, &rec->mm_theme);
    if (P->have_prev) {
        rec->mm_prev = 1;
        rec->mm_stale = P->stale;
        (void)rtx_img_mermaid_key(&P->prev, &rec->mm_prev_h, &rec->mm_prev_n,
                                  &rec->mm_prev_theme);
    }
}
