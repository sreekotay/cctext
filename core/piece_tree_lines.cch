/* Stride line index + line_* — chapter of the piece_tree TU.
 * Included from piece_tree.ccs; the link unit needs the face too. */
#include "piece_tree_priv.cch"
#include "piece_tree_rb.cch"

static void rtx_line_fault(RtxPieceTree *t) {
    if (!t) return;
    t->line_off_ok = 0;
    t->line_index_fault = 1;
}

int rtx_line_off_push(RtxPieceTree *t, size_t off) {
    if (t->line_off_len >= t->line_off_cap) {
        size_t c = t->line_off_cap ? t->line_off_cap * 2 : 256;
        size_t *p = (size_t *)cc_arena_alloc(*t->arena, c * sizeof(size_t), 8);
        if (!p) return 0;
        if (t->line_off && t->line_off_len) {
            char[:] dst = cc_slice_from_buffer(p, t->line_off_len * sizeof(size_t));
            char[:] src = cc_slice_from_buffer(t->line_off,
                                               t->line_off_len * sizeof(size_t));
            dst.copy(src) !>(e) { (void)e; return 0; };
        }
        t->line_off = p;
        t->line_off_cap = c;
    }
    t->line_off[t->line_off_len++] = off;
    return 1;
}

/* Rebuild stride slots from `from_slot` (inclusive) to EOF. Keeps
 * line_off[0..from_slot]. Sets line_off_ok only if the scan reaches len.
 * A full rebuild from slot 0 on a single original piece also sets lf_ready.
 *
 * Escape hatch — can walk the whole file. Soft-min / progressive paths must
 * not call this on huge docs; prefer rtx_line_scan_* / note_insert/erase. */
static void rtx_line_index_rebuild_from(RtxPieceTree *t, size_t from_slot) {
    size_t len, off, line;
    char buf[64 * 1024];
    if (!t || from_slot >= t->line_off_len) {
        if (t) t->line_off_ok = 0;
        return;
    }
    t->line_off_ok = 0;
    line = from_slot * RTX_LINE_STRIDE;
    off = t->line_off[from_slot];
    len = RtxPieceTree_len(t);
    @errhandler(CCError e) {
        (void)e;
        rtx_line_fault(t);
        return;
    }
    while (off < len) {
        size_t got = RtxPieceTree_read_at(t, off, cc_slice_from_buffer(buf, sizeof(buf))) !>;
        int hit;
        if (!got) return;
        if (rtx_line_eat(t, buf, got, off, &line, RTX_LINE_NO_STOP, &hit) ==
            RTX_LINE_EAT_FAIL)
            return;
        off += got;
    }
    if (off != len) return;
    t->line_off_ok = 1;
    t->line_index_fault = 0;
    if (!t->lf_ready && from_slot == 0 && t->root && !t->root->left && !t->root->right) {
        t->root->piece.lf_count = line;
        rtx_node_pull(t->root);
        t->lf_ready = 1;
    }
}

void rtx_line_index_build(RtxPieceTree *t) {
    if (!t) return;
    t->line_off_len = 0;
    t->line_off_ok = 0;
    if (!rtx_line_off_push(t, 0)) return;
    rtx_line_index_rebuild_from(t, 0);
}

/* Drop slots at/after `off`, rebuild suffix from the last still-valid slot. */
void rtx_line_index_rebuild_suffix(RtxPieceTree *t, size_t off) {
    size_t keep, from_slot;
    if (!t || !t->line_off_ok || t->line_off_len == 0) {
        if (t) t->line_off_ok = 0;
        return;
    }
    keep = 0;
    while (keep < t->line_off_len && t->line_off[keep] < off) keep++;
    from_slot = keep > 0 ? keep - 1 : 0;
    t->line_off_len = from_slot + 1;
    rtx_line_index_rebuild_from(t, from_slot);
}

/* Shift every stride offset strictly after `off` by `delta`.
 * Insert at `off` keeps a line that already starts at `off` in place. */
static void rtx_line_index_shift_from(RtxPieceTree *t, size_t off, size_t delta,
                                      int add) {
    size_t i;
    for (i = 0; i < t->line_off_len; i++) {
        if (t->line_off[i] <= off) continue;
        if (add) t->line_off[i] += delta;
        else t->line_off[i] -= delta;
    }
}

/*
 * Insert at `off` of `ins_len` bytes containing `lf` newlines
 * (RTX_LF_UNKNOWN: not counted).
 * Progressive (!lf_ready): never rebuild to EOF. No newline: slide the
 * cursor over the bytes. Newlines at the frontier: count them into the
 * stride slots when the insert is small, else park the frontier at `off`
 * (adding `lf` to scan_line skipped their slots).
 * Small lf_ready docs: shift, stride-splice, or rebuild suffix as before.
 */
void rtx_line_isle_drop(RtxPieceTree *t) {
    if (!t) return;
    rtx_isle_handle_stop(t);
    rtx_isle_store_live(t, 0);
    rtx_isle_store_cancel(t, 1);
    t->isle_before = 0;
    t->isle_after = 0;
}

void rtx_line_isle_cancel(RtxPieceTree *t) {
    rtx_line_isle_drop(t);
}

void rtx_line_want_cancel(RtxPieceTree *t) {
    if (!t) return;
    t->want_line = 0;
    t->want_off = t->line_scan_off;
    t->want_known = t->scan_line;
}

/* Best exact floor at or below 0-based line `max_line`: prefix frontier,
 * live gutter origin, or a planted 1/32 pin. Closest below wins. */
static int rtx_line_want_floor(const RtxPieceTree *t, size_t max_line,
                               size_t *off_out, size_t *line_out) {
    size_t best_off = 0, best_line = 0;
    size_t i;
    int found = 0;
    if (!t) return 0;
    if (t->scan_line <= max_line) {
        best_off = t->line_scan_off;
        best_line = t->scan_line;
        found = 1;
    }
    if (t->mark_valid && t->mark_line <= max_line) {
        if (!found || t->mark_line > best_line ||
            (t->mark_line == best_line && t->mark_off > best_off)) {
            best_off = t->mark_off;
            best_line = t->mark_line;
            found = 1;
        }
    }
    for (i = 0; i < RTX_LINE_MARK_MAX; i++) {
        if (t->pins[i].line == RTX_LINE_PIN_EMPTY) continue;
        if (t->pins[i].line > max_line) continue;
        if (!found || t->pins[i].line > best_line ||
            (t->pins[i].line == best_line && t->pins[i].off > best_off)) {
            best_off = t->pins[i].off;
            best_line = t->pins[i].line;
            found = 1;
        }
    }
    if (!found) return 0;
    if (off_out) *off_out = best_off;
    if (line_out) *line_out = best_line;
    return 1;
}

void rtx_line_want_kick(RtxPieceTree *t, size_t line1) {
    size_t floor_off = 0, floor_line = 0;
    size_t max_line;
    if (!t) return;
    rtx_line_isle_cancel(t);
    t->want_line = line1;
    if (!line1 || t->lf_ready) {
        t->want_line = 0;
        return;
    }
    max_line = line1 - 1;
    if (!rtx_line_want_floor(t, max_line, &floor_off, &floor_line)) {
        floor_off = t->line_scan_off;
        floor_line = t->scan_line;
    }
    t->want_off = floor_off;
    t->want_known = floor_line;
    if (rtx_line_want_reached(t)) t->want_line = 0;
}

/* Count from want_off without claiming prefix cover. When the jump
 * cursor still sits on the prefix frontier, advance that too. */
static size_t rtx_line_scan_wave(RtxPieceTree *t, size_t budget, size_t stop_line);

static size_t rtx_line_want_wave(RtxPieceTree *t, size_t budget) {
    char buf[64 * 1024];
    size_t len, take, got, need, at, seen = 0;
    size_t stop_line;
    int linked;
    @errhandler(CCError e) {
        (void)e;
        return 0;
    }
    if (!t || !t->want_line || t->lf_ready) return 0;
    stop_line = t->want_line - 1;
    linked = (t->want_off == t->line_scan_off && t->want_known == t->scan_line);
    if (linked)
        return rtx_line_scan_wave(t, budget, stop_line);
    len = RtxPieceTree_len(t);
    if (budget == 0 || budget > sizeof(buf)) budget = sizeof(buf);
    take = budget;
    if (t->want_off >= len) take = 0;
    else if (take > len - t->want_off) take = len - t->want_off;
    if (take == 0) return 0;
    got = RtxPieceTree_read_uncached(t, t->want_off, cc_slice_from_buffer(buf, take)) !>;
    if (!got) return 0;
    /* Stop past the newline that brings want_known to stop_line (the
     * next one when it is there already). */
    need = t->want_known < stop_line ? stop_line - t->want_known : 1;
    at = rtx_nth_lf(buf, got, need, &seen);
    if (at != (size_t)-1) {
        t->want_known += need;
        t->want_off += at + 1;
        return 1;
    }
    t->want_known += seen;
    t->want_off += got;
    return 1;
}

size_t rtx_line_want_step(RtxPieceTree *t, size_t budget) {
    size_t n;
    int linked;
    if (!rtx_line_want_pumping(t)) return 0;
    linked = (t->want_off == t->line_scan_off && t->want_known == t->scan_line);
    n = rtx_line_want_wave(t, budget);
    if (linked) {
        t->want_off = t->line_scan_off;
        t->want_known = t->scan_line;
    }
    if (!n) rtx_line_want_cancel(t);
    return n;
}

/* EOF on a single original piece can take node weights. A split / huge
 * tree must not: lf_ready with subtree_lf==0 made line_count()==1 and
 * snapped the camera to line 0 (2G JSON click-delete). */
static void rtx_line_scan_mark_eof(RtxPieceTree *t) {
    if (!t) return;
    t->line_off_ok = 1;
    if (t->root && !t->root->left && !t->root->right) {
        t->root->piece.lf_count = t->scan_line;
        rtx_node_pull(t->root);
        t->lf_ready = 1;
        return;
    }
    t->lf_ready = 0;
}

/* Node newline weights match the body. Huge + subtree 0 is a stale flag. */
int rtx_lf_weights_ok(const RtxPieceTree *t) {
    if (!t || !t->lf_ready || !t->root) return 0;
    if ((size_t)t->root->subtree_lf > 0) return 1;
    return RtxPieceTree_len(t) <= (size_t)RTX_LINE_SOFT_MIN;
}

/* One prefix wave. stop_line == (size_t)-1 means run the budget (idle). */
static size_t rtx_line_scan_wave(RtxPieceTree *t, size_t budget, size_t stop_line) {
    char buf[256 * 1024];
    size_t len, take, got, used;
    int hit = 0;
    int cap = stop_line != (size_t)-1;
    @errhandler(CCError e) {
        (void)e;
        return 0;
    }
    if (!t || t->lf_ready) return 0;
    len = RtxPieceTree_len(t);
    if (t->line_off_len == 0 && !rtx_line_off_push(t, 0)) return 0;
    if (budget == 0 || budget > sizeof(buf)) budget = sizeof(buf);
    take = budget;
    if (t->line_scan_off >= len) take = 0;
    else if (take > len - t->line_scan_off) take = len - t->line_scan_off;
    if (take == 0) {
        t->line_off_ok = 1;
        if (t->line_scan_off >= len) rtx_line_scan_mark_eof(t);
        return 0;
    }
    got = RtxPieceTree_read_uncached(t, t->line_scan_off, cc_slice_from_buffer(buf, take)) !>;
    if (!got) return 0;
    used = rtx_line_eat(t, buf, got, t->line_scan_off, &t->scan_line,
                        cap ? stop_line : RTX_LINE_NO_STOP, &hit);
    if (used == RTX_LINE_EAT_FAIL) return 0;
    if (hit) {
        t->line_scan_off += used;
        return 1;
    }
    t->line_scan_off += got;
    if (t->line_scan_off >= len) rtx_line_scan_mark_eof(t);
    rtx_line_pins_from_prefix(t);
    return 1;
}

size_t rtx_line_prefix_step(RtxPieceTree *t, size_t budget) {
    if (!rtx_line_prefix_pumping(t)) return 0;
    return rtx_line_scan_wave(t, budget, (size_t)-1);
}

/* Nearest planted pin in (line_scan_off, at]. After EOF plants all 32,
 * that gap is at most one 1/32 slice. */
static int rtx_isle_pin_floor(const RtxPieceTree *t, size_t at,
                              size_t *off, size_t *line) {
    size_t i, best_off = 0, best_line = 0;
    int found = 0;
    if (!t) return 0;
    for (i = 0; i < RTX_LINE_MARK_MAX; i++) {
        if (t->pins[i].line == RTX_LINE_PIN_EMPTY) continue;
        if (t->pins[i].off > at) continue;
        if (t->pins[i].off <= t->line_scan_off) continue;
        if (!found || t->pins[i].off > best_off) {
            best_off = t->pins[i].off;
            best_line = t->pins[i].line;
            found = 1;
        }
    }
    if (!found) return 0;
    if (off) *off = best_off;
    if (line) *line = best_line;
    return 1;
}

void rtx_line_isle_kick(RtxPieceTree *t, size_t at) {
    size_t n, i, poff, pline;
    if (!t || t->lf_ready) return;
    n = RtxPieceTree_len(t);
    if (at > n) at = n;
    if (at <= t->line_scan_off) {
        rtx_line_isle_drop(t);
        return;
    }
    if (rtx_isle_load_live(t) && !rtx_isle_load_cancel(t) && at == t->isle_anchor) return;
    rtx_isle_handle_stop(t);
    rtx_isle_store_cancel(t, 0);
    rtx_isle_store_live(t, 1);
    t->isle_anchor = at;
    t->isle_from = at;
    t->isle_to = at;
    t->isle_floor = t->line_scan_off;
    t->isle_base_line = t->scan_line;
    if (rtx_isle_pin_floor(t, at, &poff, &pline)) {
        t->isle_floor = poff;
        t->isle_base_line = pline;
    }
    t->isle_before = 0;
    t->isle_after = 0;
    for (i = 0; i < RTX_LINE_MARK_MAX; i++) t->isle_pin_set[i] = 0;
    rtx_isle_listing_start(t) !>(e) {
        (void)e;
        rtx_line_isle_drop(t);
    };
}

size_t rtx_line_isle_step(RtxPieceTree *t, size_t budget) {
    (void)budget;
    if (!rtx_line_isle_pumping(t)) return 0;
    if (!t->isle_h.live())
        rtx_isle_listing_start(t) !>(e) {
            (void)e;
            rtx_line_isle_drop(t);
            return 0;
        };
    return rtx_line_isle_pumping(t) ? 1 : 0;
}

/* Edit bookkeeping for the live origin: pins at or after `off` go. The
 * origin (mark_off / mark_line) stays when the edit is past it and adds or
 * removes no newline — no line number moves, so a letter typed below a
 * keyed camera does not narrow the gutter (a re-wrap of every row) until
 * an island re-keys it. */
static void rtx_line_edit_wipe(RtxPieceTree *t, size_t off, size_t lf) {
    int keep = lf == 0 && t->mark_valid && off > t->mark_off;
    size_t mo = t->mark_off, ml = t->mark_line;
    rtx_line_pins_wipe_from(t, off);
    if (keep) {
        t->mark_off = mo;
        t->mark_line = ml;
        t->mark_valid = 1;
    }
}

void rtx_line_index_note_insert(RtxPieceTree *t, size_t off, size_t ins_len,
                                      size_t lf) {
    size_t first, i, tail_len, start_i;
    if (!t || ins_len == 0) return;
    rtx_line_want_cancel(t);
    rtx_line_edit_wipe(t, off, lf);
    rtx_line_isle_drop(t);

    if (!t->lf_ready) {
        if (t->line_off_len == 0) {
            (void)rtx_line_off_push(t, 0);
        }
        if (t->line_off_len) {
            rtx_line_index_shift_from(t, off, ins_len, 1);
        }
        if (off <= t->line_scan_off && lf == 0) {
            t->line_scan_off += ins_len;
            t->line_off_ok = t->line_off_len > 0;
        } else if (off <= t->line_scan_off) {
            /* prepare_edit already put the frontier at `off` when it saw
             * newlines; an uncounted splice may not have. */
            if (off < t->line_scan_off) {
                rtx_lf_invalidate_from(t, off) !>(e) {
                    (void)e;
                    rtx_line_fault(t);
                    return;
                };
            }
            t->line_off_ok = t->line_off_len > 0;
            if (ins_len <= (size_t)RTX_LINE_ISLE_BUDGET) {
                rtx_line_scan_to(t, off + ins_len) !>(e) {
                    (void)e;
                    rtx_line_fault(t);
                    return;
                };
            }
        } else if (off + ins_len >= RtxPieceTree_len(t)) {
            /* Tip insert past the scan frontier: keep the prefix index. */
            t->line_off_ok = t->line_off_len > 0;
        } else {
            t->line_off_ok = 0;
        }
        return;
    }

    if (!t->line_off_ok || t->line_off_len == 0) {
        t->line_off_ok = 0;
        return;
    }

    if (lf == 0) {
        rtx_line_index_shift_from(t, off, ins_len, 1);
        return;
    }

    if (lf % (size_t)RTX_LINE_STRIDE != 0) {
        rtx_line_index_rebuild_suffix(t, off);
        return;
    }

    first = 0;
    while (first < t->line_off_len && t->line_off[first] < off) first++;
    tail_len = t->line_off_len - first;
    {
        CCArena hold = {0} @destroy {
            if (hold.base) hold.destroy();
        };
        size_t *tail = NULL;
        if (tail_len) {
            hold = cc_arena_heap(tail_len * sizeof(size_t) + 64);
            if (!hold.base) {
                t->line_off_ok = 0;
                return;
            }
            tail = (size_t *)cc_arena_alloc(hold, tail_len * sizeof(size_t), 8);
            if (!tail) {
                t->line_off_ok = 0;
                return;
            }
            {
                char[:] dst =
                    cc_slice_from_buffer(tail, tail_len * sizeof(size_t));
                char[:] src = cc_slice_from_buffer(t->line_off + first,
                                                   tail_len * sizeof(size_t));
                dst.copy(src) !>(e) {
                    (void)e;
                    t->line_off_ok = 0;
                    return;
                };
            }
        }
        /* Keep slots strictly before the edit. */
        t->line_off_len = first > 0 ? first : 1;
        if (first == 0) t->line_off[0] = 0;

        {
            size_t line = first > 0 ? (first - 1) * RTX_LINE_STRIDE : 0;
            size_t at = first > 0 ? t->line_off[first - 1] : 0;
            size_t end = off + ins_len;
            char buf[16 * 1024];
            t->line_off_ok = 0;
            @errhandler(CCError e) {
                (void)e;
                return;
            }
            while (at < end) {
                size_t want = end - at;
                size_t got;
                int hit;
                if (want > sizeof(buf)) want = sizeof(buf);
                got = RtxPieceTree_read_at(t, at, cc_slice_from_buffer(buf, want)) !>;
                if (!got) return;
                if (rtx_line_eat(t, buf, got, at, &line, RTX_LINE_NO_STOP, &hit) ==
                    RTX_LINE_EAT_FAIL)
                    return;
                at += got;
            }
            /* tail[i] was slot first+i; it is now slot first+i+k. The
             * rescan already pushed every slot below line_off_len (with
             * or without a trailing \n in the paste, and the edit-boundary
             * slot when off sat on one). Append only the rest. */
            {
                size_t k = lf / (size_t)RTX_LINE_STRIDE;
                size_t base = (first > 0 ? first : 0) + k;
                start_i = t->line_off_len > base ? t->line_off_len - base : 0;
                if (start_i > tail_len) start_i = tail_len;
            }
            for (i = start_i; i < tail_len; i++) {
                if (!rtx_line_off_push(t, tail[i] + ins_len)) return;
            }
            t->line_off_ok = 1;
            t->line_index_fault = 0;
        }
    }
}

void rtx_line_index_note_erase(RtxPieceTree *t, size_t off, size_t n,
                                     size_t lf) {
    size_t i, w;
    if (!t || n == 0) return;
    rtx_line_want_cancel(t);
    /* A large erase before lf_ready passes lf 0 uncounted. */
    rtx_line_edit_wipe(t, off,
                       (n > (size_t)RTX_LINE_ISLE_BUDGET && !t->lf_ready) ? 1 : lf);
    rtx_line_isle_drop(t);

    if (!t->lf_ready) {
        /* The prefix slots are line starts whatever line_off_ok says (a
         * gap edit clears it); they must slide with the bytes, or the next
         * edit inside the prefix reads a stale slot. A slot at `off` stays:
         * byte off-1 (its \n) was not erased. Only a slot strictly inside
         * the range lost its newline. */
        w = 0;
        for (i = 0; i < t->line_off_len; i++) {
            size_t o = t->line_off[i];
            if (o > off && o < off + n) continue;
            if (o >= off + n) o -= n;
            t->line_off[w++] = o;
        }
        t->line_off_len = w;
        if (t->line_off_len == 0) {
            if (!rtx_line_off_push(t, 0)) t->line_off_ok = 0;
        }
        /* prepare_edit left the scan at `off`; deleted bytes were at/after it. */
        if (off < t->line_scan_off) {
            size_t cut = t->line_scan_off - off;
            if (cut > n) cut = n;
            t->line_scan_off -= cut;
            if (t->scan_line >= lf) t->scan_line -= lf;
            else t->scan_line = 0;
        } else if (off > t->line_scan_off) {
            t->line_off_ok = 0;
        }
        (void)lf;
        return;
    }

    if (!t->line_off_ok || t->line_off_len == 0) {
        t->line_off_ok = 0;
        return;
    }

    if (lf == 0) {
        /* No newline erased: every line start survives. The one at `off`
         * stays put; later ones slide down. */
        w = 0;
        for (i = 0; i < t->line_off_len; i++) {
            size_t o = t->line_off[i];
            if (o > off && o < off + n) continue;
            if (o >= off + n) o -= n;
            t->line_off[w++] = o;
        }
        t->line_off_len = w;
        if (t->line_off_len == 0) t->line_off_ok = 0;
        return;
    }

    rtx_line_index_rebuild_suffix(t, off);
}

static void rtx_line_index_ensure(const RtxPieceTree *t) {
    (void)t;
    /* Progressive scan: line_start may extend. line_of does not. */
}

/* Soft line count while indexing: known lines + headroom so scroll can
 * advance without a full-file pass. Exact after lf_ready or scan-to-EOF.
 * Files at or under RTX_LINE_SOFT_MIN finish eagerly on first line_count.
 * UI status/gutter should use line_known() — the +1MiB is scroll budget only. */

static size_t rtx_line_known_raw(const RtxPieceTree *t) {
    size_t len;
    if (!t || !t->root) return 1;
    if (rtx_lf_weights_ok(t)) return (size_t)t->root->subtree_lf + 1;
    len = RtxPieceTree_len(t);
    if (len == 0) return 1;
    if (t->line_scan_off >= len && t->line_off_ok) return t->scan_line + 1;
    return t->scan_line + 1;
}

size_t RtxPieceTree_line_known(const RtxPieceTree *t) {
    size_t len;
    if (!t || !t->root) return 1;
    if (rtx_lf_weights_ok(t)) return (size_t)t->root->subtree_lf + 1;
    len = RtxPieceTree_len(t);
    if (len == 0) return 1;
    if (t->line_scan_off >= len && t->line_off_ok) return t->scan_line + 1;
    if (len <= (size_t)RTX_LINE_SOFT_MIN) {
        @errhandler(RtxIndexErr e) {
            (void)e;
            rtx_line_fault((RtxPieceTree *)t);
            return rtx_line_known_raw(t);
        }
        rtx_line_scan_to((RtxPieceTree *)t, len) !>;
        return rtx_line_known_raw(t);
    }
    return rtx_line_known_raw(t);
}

size_t RtxPieceTree_line_count(const RtxPieceTree *t) {
    size_t known;
    size_t len;
    if (!t || !t->root) return 1;
    if (rtx_lf_weights_ok(t)) return (size_t)t->root->subtree_lf + 1;
    len = RtxPieceTree_len(t);
    if (len == 0) return 1;
    known = RtxPieceTree_line_known(t);
    if (rtx_lf_weights_ok(t)) return known;
    if (t->line_scan_off >= len) return known;
    /* Scroll budget only — not a real line total for UI. */
    return known + (1024 * 1024);
}

/* Count newlines in [from, from+n). */
size_t !>(RtxIndexErr) rtx_count_lf_range(const RtxPieceTree *t, size_t from, size_t n) {
    char buf[16 * 1024];
    size_t seen = 0;
    size_t off = from;
    size_t end = from + n;
    size_t len = RtxPieceTree_len(t);
    if (end > len) end = len;
    while (off < end) {
        size_t want = end - off;
        size_t got;
        if (want > sizeof(buf)) want = sizeof(buf);
        got = RtxPieceTree_read_at(t, off, cc_slice_from_buffer(buf, want)) !>(e) {
            rtx_line_fault((RtxPieceTree *)t);
            return cc_err(rtx_index_from_cc(e));
        };
        if (!got) break;
        seen += rtx_count_lf(buf, got);
        off += got;
    }
    return cc_ok(seen);
}

/* Byte offset after `nlines` newlines starting at `from`. */
static size_t !>(RtxIndexErr) rtx_advance_lines(const RtxPieceTree *t, size_t from, size_t nlines) {
    char buf[4096];
    size_t seen = 0;
    size_t off = from;
    size_t len = RtxPieceTree_len(t);
    if (nlines == 0) return cc_ok(from);
    while (off < len) {
        size_t got = RtxPieceTree_read_at(t, off, cc_slice_from_buffer(buf, sizeof(buf))) !>(e) {
            rtx_line_fault((RtxPieceTree *)t);
            return cc_err(rtx_index_from_cc(e));
        };
        size_t at, got_lf = 0;
        if (!got) break;
        at = rtx_nth_lf(buf, got, nlines - seen, &got_lf);
        if (at != (size_t)-1) return cc_ok(off + at + 1);
        seen += got_lf;
        off += got;
    }
    return cc_ok(len);
}

size_t !>(RtxIndexErr) RtxPieceTree_line_start(const RtxPieceTree *t, size_t line) {
    size_t slot, remain;
    RtxPieceTree *mut;
    if (!t || !t->root || line == 0) return cc_ok((size_t)0);
    mut = (RtxPieceTree *)t;
    if (!t->lf_ready) {
        rtx_line_scan_through_line(mut, line) !>(e) {
            rtx_line_fault(mut);
            return cc_err(e);
        };
    }
    if (t->lf_ready) {
        if (line >= t->root->subtree_lf + 1) return cc_ok(RtxPieceTree_len(t));
    } else if (line > t->scan_line) {
        return cc_ok(RtxPieceTree_len(t));
    }
    if (t->line_off_len == 0) return rtx_advance_lines(t, 0, line);
    slot = line / RTX_LINE_STRIDE;
    if (slot >= t->line_off_len) slot = t->line_off_len - 1;
    /* Don't use stride slots past the scan frontier. */
    while (!t->lf_ready && slot > 0 && t->line_off[slot] > t->line_scan_off) {
        slot--;
    }
    remain = line - slot * RTX_LINE_STRIDE;
    return rtx_advance_lines(t, t->line_off[slot], remain);
}

size_t !>(RtxIndexErr) RtxPieceTree_line_of(const RtxPieceTree *t, size_t offset) {
    size_t len, lo, hi, slot, counted;
    if (!t || !t->root) return cc_ok((size_t)0);
    len = RtxPieceTree_len(t);
    if (offset > len) offset = len;
    if (!RtxPieceTree_index_covers(t, offset))
        return cc_err(rtx_index_err("line_of uncovered"));
    if (offset == len) {
        if (len == 0) return cc_ok((size_t)0);
        if (t->lf_ready) return cc_ok(t->root->subtree_lf);
        return cc_ok(t->scan_line);
    }
    if (t->line_off_len == 0) return rtx_count_lf_range(t, 0, offset);
    lo = 0;
    hi = t->line_off_len;
    while (lo + 1 < hi) {
        size_t mid = lo + (hi - lo) / 2;
        if (t->line_off[mid] <= offset) lo = mid;
        else hi = mid;
    }
    slot = lo;
    while (slot > 0 && !t->lf_ready && t->line_off[slot] > t->line_scan_off) {
        slot--;
    }
    counted = rtx_count_lf_range(t, t->line_off[slot], offset - t->line_off[slot]) !>(e) {
        return cc_err(e);
    };
    return cc_ok(slot * RTX_LINE_STRIDE + counted);
}

size_t rtx_line_marks_collect(const RtxPieceTree *t, RtxLineMark *out, size_t cap) {
    size_t i, n;
    if (!t || !out || !cap) return 0;
    n = 0;
    for (i = 0; i < RTX_LINE_MARK_MAX && n < cap; i++) {
        if (t->pins[i].line == RTX_LINE_PIN_EMPTY) continue;
        out[n] = t->pins[i];
        n++;
    }
    return n;
}

void rtx_line_pins_from_prefix(RtxPieceTree *t) {
    size_t i, len;
    if (!t) return;
    len = RtxPieceTree_len(t);
    for (i = 0; i < RTX_LINE_MARK_MAX; i++) {
        size_t tgt, ln;
        if (t->pins[i].line != RTX_LINE_PIN_EMPTY) continue;
        tgt = rtx_line_pin_target(i, len);
        if (!RtxPieceTree_index_covers(t, tgt)) continue;
        {
            int ok = 1;
            @errhandler(RtxIndexErr e) {
                (void)e;
                ok = 0;
            }
            ln = RtxPieceTree_line_of(t, tgt) !>;
            if (!ok) continue;
        }
        t->pins[i].off = tgt;
        t->pins[i].line = ln;
    }
}

/* The lanes counted each crossed slot's LFs to the anchor. A slot the
 * walk did not record (short read) stays vacant; the host does not
 * recount the span, which may be the whole file. */
void rtx_line_pin_from_isle(RtxPieceTree *t) {
    size_t i, len, line;
    if (!rtx_line_isle_connected(t)) return;
    line = rtx_line_isle_line(t);
    rtx_line_origin_key(t, t->isle_anchor, line);
    len = RtxPieceTree_len(t);
    for (i = 0; i < RTX_LINE_MARK_MAX; i++) {
        size_t tgt;
        if (!t->isle_pin_set[i] || t->pins[i].line != RTX_LINE_PIN_EMPTY) continue;
        tgt = rtx_line_pin_target(i, len);
        if (tgt <= t->isle_floor || tgt > t->isle_anchor) continue;
        if (t->isle_pin_rel[i] > line) continue;
        t->pins[i].off = tgt;
        t->pins[i].line = line - t->isle_pin_rel[i];
    }
}

/* Never reads. Density from the scan frontier; 0 before any scan. */
size_t RtxPieceTree_line_guess(const RtxPieceTree *t, size_t off) {
    size_t n;
    if (!t || !t->root) return 0;
    n = RtxPieceTree_len(t);
    if (off > n) off = n;
    if (t->line_scan_off == 0) return 0;
    /* scan_line * off wraps on a big file (2^30 lines x 2^41 bytes).
     * q * scan_line <= off (a line is at least a byte); the remainder
     * term is below scan_line. */
    {
        size_t q = off / t->line_scan_off;
        size_t r = off % t->line_scan_off;
        return q * t->scan_line +
               (size_t)((double)t->scan_line * (double)r / (double)t->line_scan_off);
    }
}
