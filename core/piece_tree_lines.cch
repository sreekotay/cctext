/* Stride line index + line_* — chapter of the piece_tree TU (not a standalone TU). */
static void rtx_line_fault(RtxPieceTree *t) {
    if (!t) return;
    t->line_off_ok = 0;
    t->line_index_fault = 1;
}

static int rtx_line_off_push(RtxPieceTree *t, size_t off) {
    if (t->line_off_len >= t->line_off_cap) {
        size_t c = t->line_off_cap ? t->line_off_cap * 2 : 256;
        size_t *p = (size_t *)cc_arena_alloc(t->arena, c * sizeof(size_t), 8);
        if (!p) return 0;
        if (t->line_off && t->line_off_len) {
            memcpy(p, t->line_off, t->line_off_len * sizeof(size_t));
        }
        t->line_off = p;
        t->line_off_cap = c;
    }
    t->line_off[t->line_off_len++] = off;
    return 1;
}

/* Rebuild stride slots from `from_slot` (inclusive) to EOF. Keeps
 * line_off[0..from_slot]. Sets line_off_ok only if the scan reaches len.
 * A full rebuild from slot 0 on a single original piece also sets lf_ready.
 *
 * Escape hatch — can walk the whole file. Soft-min / progressive paths must
 * not call this on huge docs; prefer rtx_line_scan_* / note_insert/erase. */
static void rtx_line_index_rebuild_from(RtxPieceTree *t, size_t from_slot) {
    size_t len, off, line;
    char buf[RTX_IO_CHUNK];
    if (!t || from_slot >= t->line_off_len) {
        if (t) t->line_off_ok = 0;
        return;
    }
    t->line_off_ok = 0;
    line = from_slot * RTX_LINE_STRIDE;
    off = t->line_off[from_slot];
    len = RtxPieceTree_len(t);
    @errhandler(CCError e) {
        (void)e;
        rtx_line_fault(t);
        return;
    }
    while (off < len) {
        size_t got = RtxPieceTree_read_at(t, off, buf, sizeof(buf)) !>;
        size_t i;
        if (!got) return;
        for (i = 0; i < got; i++) {
            if (buf[i] == '\n') {
                line++;
                if (line % RTX_LINE_STRIDE == 0) {
                    if (!rtx_line_off_push(t, off + i + 1)) return;
                }
            }
        }
        off += got;
    }
    if (off != len) return;
    t->line_off_ok = 1;
    t->line_index_fault = 0;
    if (!t->lf_ready && from_slot == 0 && t->root && !t->root->left && !t->root->right) {
        t->root->piece.lf_count = line;
        rtx_node_pull(t->root);
        t->lf_ready = 1;
    }
}

static void rtx_line_index_build(RtxPieceTree *t) {
    if (!t) return;
    t->line_off_len = 0;
    t->line_off_ok = 0;
    if (!rtx_line_off_push(t, 0)) return;
    rtx_line_index_rebuild_from(t, 0);
}

/* Drop slots at/after `off`, rebuild suffix from the last still-valid slot. */
static void rtx_line_index_rebuild_suffix(RtxPieceTree *t, size_t off) {
    size_t keep, from_slot;
    if (!t || !t->line_off_ok || t->line_off_len == 0) {
        if (t) t->line_off_ok = 0;
        return;
    }
    keep = 0;
    while (keep < t->line_off_len && t->line_off[keep] < off) keep++;
    from_slot = keep > 0 ? keep - 1 : 0;
    t->line_off_len = from_slot + 1;
    rtx_line_index_rebuild_from(t, from_slot);
}

/* Shift every stride offset strictly after `off` by `delta`.
 * Insert at `off` keeps a line that already starts at `off` in place. */
static void rtx_line_index_shift_from(RtxPieceTree *t, size_t off, size_t delta,
                                      int add) {
    size_t i;
    for (i = 0; i < t->line_off_len; i++) {
        if (t->line_off[i] <= off) continue;
        if (add) t->line_off[i] += delta;
        else t->line_off[i] -= delta;
    }
}

/*
 * Insert at `off` of `ins_len` bytes containing `lf` newlines.
 * Progressive (!lf_ready): bump scan cursor only — never rebuild to EOF.
 * Small lf_ready docs: shift, stride-splice, or rebuild suffix as before.
 */
static void rtx_line_index_note_insert(RtxPieceTree *t, size_t off, size_t ins_len,
                                      size_t lf) {
    size_t first, i, tail_len, start_i;
    size_t *tail = NULL;
    if (!t || ins_len == 0) return;

    if (!t->lf_ready) {
        if (t->line_off_len == 0) {
            (void)rtx_line_off_push(t, 0);
        }
        if (t->line_off_len) {
            rtx_line_index_shift_from(t, off, ins_len, 1);
        }
        if (off <= t->line_scan_off) {
            t->line_scan_off += ins_len;
            t->scan_line += lf;
            t->line_off_ok = t->line_off_len > 0;
        } else if (off + ins_len >= RtxPieceTree_len(t)) {
            /* Tip insert past the scan frontier: keep the prefix index. */
            t->line_off_ok = t->line_off_len > 0;
        } else {
            t->line_off_ok = 0;
        }
        return;
    }

    if (!t->line_off_ok || t->line_off_len == 0) {
        t->line_off_ok = 0;
        return;
    }

    if (lf == 0) {
        rtx_line_index_shift_from(t, off, ins_len, 1);
        return;
    }

    if (lf % (size_t)RTX_LINE_STRIDE != 0) {
        rtx_line_index_rebuild_suffix(t, off);
        return;
    }

    first = 0;
    while (first < t->line_off_len && t->line_off[first] < off) first++;
    tail_len = t->line_off_len - first;
    if (tail_len) {
        tail = (size_t *)malloc(tail_len * sizeof(size_t));
        if (!tail) {
            t->line_off_ok = 0;
            return;
        }
        memcpy(tail, t->line_off + first, tail_len * sizeof(size_t));
    }
    /* Keep slots strictly before the edit. */
    t->line_off_len = first > 0 ? first : 1;
    if (first == 0) t->line_off[0] = 0;

    {
        size_t line = first > 0 ? (first - 1) * RTX_LINE_STRIDE : 0;
        size_t at = first > 0 ? t->line_off[first - 1] : 0;
        size_t end = off + ins_len;
        char buf[RTX_IO_CHUNK];
        t->line_off_ok = 0;
        @errhandler(CCError e) {
            (void)e;
            free(tail);
            return;
        }
        while (at < end) {
            size_t want = end - at;
            size_t got, j;
            if (want > sizeof(buf)) want = sizeof(buf);
            got = RtxPieceTree_read_at(t, at, buf, want) !>;
            if (!got) {
                free(tail);
                return;
            }
            for (j = 0; j < got; j++) {
                if (buf[j] == '\n') {
                    line++;
                    if (line % RTX_LINE_STRIDE == 0) {
                        if (!rtx_line_off_push(t, at + j + 1)) {
                            free(tail);
                            return;
                        }
                    }
                }
            }
            at += got;
        }
        start_i = 0;
        if (tail_len && t->line_off_len > 0 &&
            t->line_off[t->line_off_len - 1] == tail[0] + ins_len) {
            start_i = 1; /* already pushed the old slot-0 / edit boundary */
        }
        for (i = start_i; i < tail_len; i++) {
            if (!rtx_line_off_push(t, tail[i] + ins_len)) {
                free(tail);
                return;
            }
        }
        free(tail);
        t->line_off_ok = 1;
        t->line_index_fault = 0;
    }
}

static void rtx_line_index_note_erase(RtxPieceTree *t, size_t off, size_t n,
                                     size_t lf) {
    size_t i, w;
    if (!t || n == 0) return;

    if (!t->lf_ready) {
        if (t->line_off_ok && t->line_off_len) {
            w = 0;
            for (i = 0; i < t->line_off_len; i++) {
                size_t o = t->line_off[i];
                if (o >= off && o < off + n) continue;
                if (o >= off + n) o -= n;
                t->line_off[w++] = o;
            }
            t->line_off_len = w;
            if (t->line_off_len == 0) {
                if (!rtx_line_off_push(t, 0)) t->line_off_ok = 0;
            }
        } else {
            t->line_off_ok = 0;
        }
        /* prepare_edit left the scan at `off`; deleted bytes were at/after it. */
        if (off < t->line_scan_off) {
            size_t cut = t->line_scan_off - off;
            if (cut > n) cut = n;
            t->line_scan_off -= cut;
            if (t->scan_line >= lf) t->scan_line -= lf;
            else t->scan_line = 0;
        } else if (off > t->line_scan_off) {
            t->line_off_ok = 0;
        }
        (void)lf;
        return;
    }

    if (!t->line_off_ok || t->line_off_len == 0) {
        t->line_off_ok = 0;
        return;
    }

    if (lf == 0) {
        w = 0;
        for (i = 0; i < t->line_off_len; i++) {
            size_t o = t->line_off[i];
            if (o >= off && o < off + n) continue;
            if (o >= off + n) o -= n;
            t->line_off[w++] = o;
        }
        t->line_off_len = w;
        if (t->line_off_len == 0) t->line_off_ok = 0;
        return;
    }

    rtx_line_index_rebuild_suffix(t, off);
}

static void rtx_line_index_ensure(const RtxPieceTree *t) {
    (void)t;
    /* Progressive scan: line_start / line_of extend as needed. */
}

/* Soft line count while indexing: known lines + headroom so scroll can
 * advance without a full-file pass. Exact after lf_ready or scan-to-EOF.
 * Files at or under RTX_LINE_SOFT_MIN finish eagerly on first line_count.
 * UI status/gutter should use line_known() — the +1MiB is scroll budget only. */

static size_t rtx_line_known_raw(const RtxPieceTree *t) {
    size_t len;
    if (!t || !t->root) return 1;
    if (t->lf_ready) return (size_t)t->root->subtree_lf + 1;
    len = RtxPieceTree_len(t);
    if (len == 0) return 1;
    if (t->line_scan_off >= len && t->line_off_ok) return t->scan_line + 1;
    return t->scan_line + 1;
}

size_t RtxPieceTree_line_known(const RtxPieceTree *t) {
    size_t len;
    if (!t || !t->root) return 1;
    if (t->lf_ready) return (size_t)t->root->subtree_lf + 1;
    len = RtxPieceTree_len(t);
    if (len == 0) return 1;
    if (t->line_scan_off >= len && t->line_off_ok) return t->scan_line + 1;
    if (len <= (size_t)RTX_LINE_SOFT_MIN) {
        @errhandler(RtxIndexErr e) {
            (void)e;
            rtx_line_fault((RtxPieceTree *)t);
            return rtx_line_known_raw(t);
        }
        rtx_line_scan_to((RtxPieceTree *)t, len) !>;
        return rtx_line_known_raw(t);
    }
    return rtx_line_known_raw(t);
}

size_t RtxPieceTree_line_count(const RtxPieceTree *t) {
    size_t known;
    size_t len;
    if (!t || !t->root) return 1;
    if (t->lf_ready) return (size_t)t->root->subtree_lf + 1;
    len = RtxPieceTree_len(t);
    if (len == 0) return 1;
    known = RtxPieceTree_line_known(t);
    if (t->lf_ready) return known;
    if (t->line_scan_off >= len) return known;
    /* Scroll budget only — not a real line total for UI. */
    return known + (1024 * 1024);
}

/* Count newlines in [from, from+n). */
static size_t !>(RtxIndexErr) rtx_count_lf_range(const RtxPieceTree *t, size_t from, size_t n) {
    char buf[512];
    size_t seen = 0;
    size_t off = from;
    size_t end = from + n;
    size_t len = RtxPieceTree_len(t);
    if (end > len) end = len;
    while (off < end) {
        size_t want = end - off;
        size_t got;
        size_t i;
        if (want > sizeof(buf)) want = sizeof(buf);
        got = RtxPieceTree_read_at(t, off, buf, want) !>(e) {
            rtx_line_fault((RtxPieceTree *)t);
            return cc_err(rtx_index_from_cc(e));
        };
        if (!got) break;
        for (i = 0; i < got; i++) {
            if (buf[i] == '\n') seen++;
        }
        off += got;
    }
    return cc_ok(seen);
}

/* Byte offset after `nlines` newlines starting at `from`. */
static size_t !>(RtxIndexErr) rtx_advance_lines(const RtxPieceTree *t, size_t from, size_t nlines) {
    char buf[512];
    size_t seen = 0;
    size_t off = from;
    size_t len = RtxPieceTree_len(t);
    if (nlines == 0) return cc_ok(from);
    while (off < len) {
        size_t got = RtxPieceTree_read_at(t, off, buf, sizeof(buf)) !>(e) {
            rtx_line_fault((RtxPieceTree *)t);
            return cc_err(rtx_index_from_cc(e));
        };
        size_t i;
        if (!got) break;
        for (i = 0; i < got; i++) {
            if (buf[i] == '\n') {
                seen++;
                if (seen == nlines) return cc_ok(off + i + 1);
            }
        }
        off += got;
    }
    return cc_ok(len);
}

size_t !>(RtxIndexErr) RtxPieceTree_line_start(const RtxPieceTree *t, size_t line) {
    size_t slot, remain;
    RtxPieceTree *mut;
    if (!t || !t->root || line == 0) return cc_ok((size_t)0);
    mut = (RtxPieceTree *)t;
    if (!t->lf_ready) {
        rtx_line_scan_through_line(mut, line) !>(e) {
            rtx_line_fault(mut);
            return cc_err(e);
        };
    }
    if (t->lf_ready) {
        if (line >= t->root->subtree_lf + 1) return cc_ok(RtxPieceTree_len(t));
    } else if (line > t->scan_line) {
        return cc_ok(RtxPieceTree_len(t));
    }
    if (t->line_off_len == 0) return rtx_advance_lines(t, 0, line);
    slot = line / RTX_LINE_STRIDE;
    if (slot >= t->line_off_len) slot = t->line_off_len - 1;
    /* Don't use stride slots past the scan frontier. */
    while (!t->lf_ready && slot > 0 && t->line_off[slot] > t->line_scan_off) {
        slot--;
    }
    remain = line - slot * RTX_LINE_STRIDE;
    return rtx_advance_lines(t, t->line_off[slot], remain);
}

size_t !>(RtxIndexErr) RtxPieceTree_line_of(const RtxPieceTree *t, size_t offset) {
    size_t len, lo, hi, slot, counted;
    RtxPieceTree *mut;
    if (!t || !t->root) return cc_ok((size_t)0);
    len = RtxPieceTree_len(t);
    if (offset > len) offset = len;
    mut = (RtxPieceTree *)t;
    if (!t->lf_ready) {
        rtx_line_scan_to(mut, offset == len ? len : offset) !>(e) {
            rtx_line_fault(mut);
            return cc_err(e);
        };
        if (offset == len) {
            if (t->lf_ready) return cc_ok(t->root->subtree_lf);
            return cc_ok(t->scan_line);
        }
    }
    if (offset == len) {
        if (len == 0) return cc_ok((size_t)0);
        return cc_ok(t->root->subtree_lf);
    }
    if (t->line_off_len == 0) return rtx_count_lf_range(t, 0, offset);
    lo = 0;
    hi = t->line_off_len;
    while (lo + 1 < hi) {
        size_t mid = lo + (hi - lo) / 2;
        if (t->line_off[mid] <= offset) lo = mid;
        else hi = mid;
    }
    slot = lo;
    while (slot > 0 && !t->lf_ready && t->line_off[slot] > t->line_scan_off) {
        slot--;
    }
    counted = rtx_count_lf_range(t, t->line_off[slot], offset - t->line_off[slot]) !>(e) {
        return cc_err(e);
    };
    return cc_ok(slot * RTX_LINE_STRIDE + counted);
}

/* Never reads. Density from the scan frontier; 0 before any scan. */
size_t RtxPieceTree_line_guess(const RtxPieceTree *t, size_t off) {
    size_t n;
    if (!t || !t->root) return 0;
    n = RtxPieceTree_len(t);
    if (off > n) off = n;
    if (t->line_scan_off == 0) return 0;
    return t->scan_line * off / t->line_scan_off;
}
