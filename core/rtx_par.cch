#!ccc cch
/*
 * Dest-live kick schedule. RTX_PARALLEL_INLINE=1 runs browse / find
 * wrappers on the caller so a one-core finish-during-kick schedule is
 * the default on any host. Inner @parallel wait is unchanged. Island
 * stays dest-live (seeking without cover is a live prefix).
 */
#ifndef RTX_PAR_H
#define RTX_PAR_H

#include <stdlib.h>

static inline int rtx_parallel_inline(void) {
    static int cached = -1;
    const char *s;
    if (cached >= 0) return cached;
    s = getenv("RTX_PARALLEL_INLINE");
    cached = (s && s[0] && s[0] != '0') ? 1 : 0;
    return cached;
}

#endif /* RTX_PAR_H */
