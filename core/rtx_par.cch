#!ccc cch
/*
 * Dest-live kick schedule. RTX_PARALLEL_INLINE=1 runs browse / find
 * wrappers on the caller so a one-core finish-during-kick schedule is
 * the default on any host. Inner @parallel wait is unchanged. Island
 * stays dest-live (seeking without cover is a live prefix).
 */
#ifndef RTX_PAR_H
#define RTX_PAR_H

#include <stdlib.h>

static inline int rtx_parallel_inline(void) {
    static int cached = -1;
    const char *s;
    if (cached >= 0) return cached;
    s = getenv("RTX_PARALLEL_INLINE");
    cached = (s && s[0] && s[0] != '0') ? 1 : 0;
    return cached;
}

/* Bring the runtime's worker pool up to one thread per core before a
 * wait-for whose tickets block in syscalls (project walk / search: open,
 * read, getdents). The V2 scheduler starts 2 workers and grows only on
 * backlog that does not park; a turnstile's handoff parks every ticket,
 * so it reads as I/O multiplexing and the lanes stay on 2 threads
 * (FRICTION.md). Idempotent; the filled pool stays up. */
void cc_parallel_noblock_prepare(void);
static inline void rtx_par_pool_up(void) {
    cc_parallel_noblock_prepare();
}

#endif /* RTX_PAR_H */
