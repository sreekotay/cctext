#!ccc cch
/*
 * Document epochs:
 *   tree     — page store + add + nodes (document lifetime)
 *   session  — path + undo log (survives reparse)
 *   analysis — sections + style runs (reset on reparse)
 *   find     — query + hit offsets (reset on new query; invalidate on edit)
 * Frame copies never land here; they take a scratch arena.
 * Intervals are byte offsets. Insert/erase shift them.
 */
#ifndef RTX_DOCUMENT_H
#define RTX_DOCUMENT_H

#include "piece_tree.cch"
#include <string.h>
#include <stdio.h>
#include <stdlib.h>
#include "utf8.cch"

typedef enum {
    RTX_SEC_CODE = 0,
    RTX_SEC_PROSE = 1,
    RTX_SEC_UNKNOWN = 2,
} RtxSectionKind;

#define RTX_HL_FULL_MAX 262144
#define RTX_MARKUP_SCAN_MAX 262144
#define RTX_HL_WIN_MAX RTX_MARKUP_SCAN_MAX
#define RTX_MARKUP_LOOKBACK 16384

typedef struct {
    size_t from;
    size_t n;
} RtxHlWin;

static RtxHlWin rtx_hl_win(size_t from, size_t n) {
    RtxHlWin w;
    w.from = from;
    w.n = n > (size_t)RTX_HL_WIN_MAX ? (size_t)RTX_HL_WIN_MAX : n;
    return w;
}

static RtxHlWin rtx_hl_span(size_t from, size_t to) {
    return rtx_hl_win(from, to > from ? to - from : 0);
}

typedef enum {
    RTX_TM_LOOKBACK = 0,
    RTX_TM_CATCHUP = 1,
} RtxTmWalk;
#define RTX_MARKUP_WIN_SECS 64
#define RTX_MARKUP_CACHE_WINDOWS 8
#define RTX_TM_CKPT_STRIDE 16384
#define RTX_TM_CKPT_MAX 256
#define RTX_TM_CKPT_DEPTH 32
#define RTX_TM_CATCHUP_MAX (512 * 1024)

typedef struct {
    size_t off;
    unsigned char n;
    unsigned short rule[RTX_TM_CKPT_DEPTH];
} RtxTmCkpt;
/* Hist copies deleted bytes only up to this (typing/backspace coalesce).
 * Larger deletes keep piece refs so undo/redo can splice them back. */
#define RTX_HIST_INLINE_MAX (256 * 1024)

typedef struct {
    size_t start;
    RtxSectionKind kind;
    unsigned hl_done : 1;
} RtxSection;

typedef enum {
    RTX_HL_NONE = 0,
    RTX_HL_KEYWORD,
    RTX_HL_STRING,
    RTX_HL_COMMENT,
    RTX_HL_NUMBER,
    RTX_HL_PUNCT,
} RtxHlKind;

#include "scope.cch"

typedef struct {
    unsigned bold : 1;
    unsigned italic : 1;
    unsigned mono : 1;
    RtxScope scope;
} RtxStyle;

typedef struct {
    size_t start;
    size_t len;
    RtxStyle style;
} RtxRun;

/* Bounded backward classifier for one visible camera. A miss advances `back`
 * by one budget; later draws continue until a header or BOF proves `kind`. */
typedef struct {
    size_t from;
    size_t to;
    size_t back;
    size_t anchor;
    size_t stamp;
    RtxSectionKind kind;
    unsigned live : 1;
    unsigned known : 1;
    unsigned ready : 1;
} RtxMarkupWin;

typedef struct {
    size_t off;
    char[:] del;           /* session buffer; .len is capacity when del_cap > 0 */
    char[:] ins;
    size_t del_used;       /* logical deleted bytes (≤ del.len) */
    size_t ins_used;       /* logical inserted bytes (≤ ins.len) */
    size_t del_cap;
    size_t ins_cap;
    size_t del_n;          /* deleted byte count (inline or piece-ref restore) */
    RtxPieceRef *del_refs; /* session; splice on undo when del_ref_n > 0 */
    size_t del_ref_n;
    size_t caret_before;
    size_t sel_before;
    size_t caret_after;
    size_t sel_after;
    int sel_box_before;
    size_t box_acol_before;
    size_t box_ccol_before;
    int sel_box_after;
    size_t box_acol_after;
    size_t box_ccol_after;
} RtxHistRec;

typedef struct {
    RtxHistRec *recs;
    size_t len;
    size_t cap;
    size_t head;
    int applying;
    int coalesce;
} RtxHistory;

typedef struct {
    CCArena store;         /* created on first find_set */
    char[:] query;
    size_t *offs;
    size_t len;
    size_t cap;
    size_t scan_off;
    size_t cur;
    size_t origin;         /* caret at find_set; auto-land prefers >= origin */
    unsigned done : 1;
    unsigned truncated : 1;
    unsigned pinned : 1;   /* next/prev/click; auto-land stops */
    unsigned cancel : 1;   /* written when a cancel key is consumed */
    unsigned idle : 1;     /* last step committed 0 and done */
} RtxFind;

typedef struct {
    RtxPieceTree tree;     /* document epoch: page store + nodes */
    CCArena session;       /* path + hist; lives until close */
    CCArena analysis;      /* secs + runs; reset on reparse */
    RtxSection *secs;
    size_t sec_len;
    size_t sec_cap;
    RtxRun *runs;
    size_t run_len;
    size_t run_cap;
    size_t caret;
    size_t sel_anchor;
    int sel_box;           /* 0 = stream [anchor, caret); 1 = column box */
    size_t box_acol;       /* virtual byte cols; (size_t)-1 = EOL */
    size_t box_ccol;
    char[:] path;
    size_t saved_head;
    size_t edit_gen;       /* bumps on every successful content change (incl. coalesce) */
    size_t last_off;
    int last_markup;
    int hl_full;
    RtxMarkupWin hl_win[RTX_MARKUP_CACHE_WINDOWS]; /* bounded visited-window cache */
    size_t hl_win_stamp;
    RtxTmCkpt *tm_ckpt;    /* stack at stride points; analysis epoch */
    size_t tm_ckpt_len;
    size_t tm_ckpt_cap;
    int broken;            /* unrestorable tree; refuse further edits */
    RtxHistory hist;
    RtxFind find;           /* find.cch: set / step / invalidate / goto */
} RtxDoc;

/* Grow a contiguous array on `a`. Old storage is abandoned until reset/destroy. */
static void !>(CCError) rtx_arena_grow(CCArena *a, void **p, size_t *cap, size_t need, size_t elem) {
    void *n;
    size_t c;
    if (!a) return cc_err(CC_ERR_INVALID_ARG, "grow");
    if (need <= *cap) return cc_ok();
    c = *cap ? *cap : 8;
    while (c < need) {
        size_t next = c * 2;
        if (next < c) return cc_err(CC_ERR_OUT_OF_MEMORY, "grow overflow");
        c = next;
    }
    n = cc_arena_alloc(a, c * elem, 8);
    if (!n) return cc_err(CC_ERR_OUT_OF_MEMORY, "grow");
    if (*p && *cap) memcpy(n, *p, (*cap) * elem);
    *p = n;
    *cap = c;
    return cc_ok();
}

static inline size_t RtxDoc_len(const RtxDoc *d) {
    return d ? RtxPieceTree_len(&d->tree) : 0;
}

static inline size_t RtxDoc_line_count(const RtxDoc *d) {
    return d ? RtxPieceTree_line_count(&d->tree) : 1;
}

static inline size_t RtxDoc_line_known(const RtxDoc *d) {
    return d ? RtxPieceTree_line_known(&d->tree) : 1;
}

static inline int RtxDoc_lf_ready(const RtxDoc *d) {
    return d ? RtxPieceTree_lf_ready(&d->tree) : 1;
}

static inline int RtxDoc_index_fault(const RtxDoc *d) {
    return d ? RtxPieceTree_index_fault(&d->tree) : 0;
}

static inline size_t !>(RtxIndexErr) RtxDoc_line_start(const RtxDoc *d, size_t line) {
    if (!d) return cc_ok((size_t)0);
    return RtxPieceTree_line_start(&d->tree, line);
}

static inline size_t !>(RtxIndexErr) RtxDoc_line_of(const RtxDoc *d, size_t offset) {
    if (!d) return cc_ok((size_t)0);
    return RtxPieceTree_line_of(&d->tree, offset);
}

static inline int RtxDoc_index_covers(const RtxDoc *d, size_t off) {
    return d ? RtxPieceTree_index_covers(&d->tree, off) : 1;
}

static inline size_t RtxDoc_line_guess(const RtxDoc *d, size_t off) {
    return d ? RtxPieceTree_line_guess(&d->tree, off) : 0;
}

static inline size_t !>(CCError) RtxDoc_read_at(const RtxDoc *d, size_t offset, char *dest, size_t n) {
    if (!d) return cc_err(CC_ERR_INVALID_ARG, "null doc");
    return RtxPieceTree_read_at(&d->tree, offset, dest, n);
}

static size_t !>(CCError) rtx_doc_utf8_win(const RtxDoc *d, size_t off,
                                          char *buf, size_t cap, size_t *base) {
    size_t n, lo, hi, got, take;
    if (!d || !buf || !base || cap == 0) {
        return cc_err(CC_ERR_INVALID_ARG, "utf8 win");
    }
    n = d->len();
    if (off > n) off = n;
    lo = off > (size_t)RTX_UTF8_LOOK ? off - (size_t)RTX_UTF8_LOOK : 0;
    hi = off + (size_t)RTX_UTF8_LOOK;
    if (hi > n) hi = n;
    if (hi < lo) hi = lo;
    take = hi - lo;
    if (take > cap) {
        size_t keep = cap / 2;
        if (off - lo > keep) lo = off - keep;
        if (hi > lo + cap) hi = lo + cap;
        take = hi - lo;
    }
    *base = lo;
    if (take == 0) return cc_ok((size_t)0);
    got = d->read_at(lo, buf, take) !>(e) { return cc_err(e); };
    return cc_ok(got);
}

static size_t !>(CCError) RtxDoc_cluster_align(const RtxDoc *d, size_t off) {
    char buf[RTX_UTF8_LOOK * 2];
    size_t base, got, rel, n;
    if (!d) return cc_err(CC_ERR_INVALID_ARG, "null doc");
    n = d->len();
    if (off > n) off = n;
    got = rtx_doc_utf8_win(d, off, buf, sizeof(buf), &base) !>(e) {
        return cc_err(e);
    };
    rel = off - base;
    if (rel > got) rel = got;
    return cc_ok(base + rtx_utf8_align(buf.to_slice_n(got), rel));
}

static size_t !>(CCError) RtxDoc_cluster_next(const RtxDoc *d, size_t off) {
    char buf[RTX_UTF8_LOOK * 2];
    size_t base, got, rel, n;
    if (!d) return cc_err(CC_ERR_INVALID_ARG, "null doc");
    n = d->len();
    if (off >= n) return cc_ok(n);
    got = rtx_doc_utf8_win(d, off, buf, sizeof(buf), &base) !>(e) {
        return cc_err(e);
    };
    rel = off - base;
    if (rel > got) rel = got;
    return cc_ok(base + rtx_utf8_next(buf.to_slice_n(got), rel));
}

static size_t !>(CCError) RtxDoc_cluster_prev(const RtxDoc *d, size_t off) {
    char buf[RTX_UTF8_LOOK * 2];
    size_t base, got, rel, n;
    if (!d) return cc_err(CC_ERR_INVALID_ARG, "null doc");
    n = d->len();
    if (off == 0) return cc_ok((size_t)0);
    if (off > n) off = n;
    got = rtx_doc_utf8_win(d, off, buf, sizeof(buf), &base) !>(e) {
        return cc_err(e);
    };
    rel = off - base;
    if (rel > got) rel = got;
    return cc_ok(base + rtx_utf8_prev(buf.to_slice_n(got), rel));
}

#define RTX_LINE_FLOOR_MAX 8192

/* Byte start of the line containing `off`. Local read; never line_of. */
static size_t !>(RtxIndexErr) rtx_doc_line_floor_local(const RtxDoc *d, size_t off) {
    char buf[512];
    size_t at, left;
    if (!d || off == 0) return cc_ok((size_t)0);
    at = off;
    left = (size_t)RTX_LINE_FLOOR_MAX;
    while (at > 0 && left > 0) {
        size_t take = at > sizeof(buf) ? sizeof(buf) : at;
        size_t got, i;
        if (take > left) take = left;
        got = d->read_at(at - take, buf, take) !>(e) {
            return cc_err(rtx_index_from_cc(e));
        };
        if (!got) return cc_ok((size_t)0);
        for (i = got; i > 0; i--) {
            if (buf[i - 1] == '\n') return cc_ok(at - take + i);
        }
        at -= got;
        left -= got;
    }
    return cc_ok(at);
}

/* Byte start of the line containing `off`. Local read when the index
 * does not cover `off` — never scans the prefix. */
static size_t !>(RtxIndexErr) rtx_doc_line_floor(const RtxDoc *d, size_t off) {
    if (!d || off == 0) return cc_ok((size_t)0);
    if (RtxDoc_index_covers(d, off)) {
        size_t ln = RtxDoc_line_of(d, off) !>(e) { return cc_err(e); };
        return RtxDoc_line_start(d, ln);
    }
    return rtx_doc_line_floor_local(d, off);
}

/* First byte of the next line after `off`, or len. Local read; no prefix scan. */
static size_t !>(RtxIndexErr) rtx_doc_line_next(const RtxDoc *d, size_t off) {
    char buf[512];
    size_t n, at, left;
    if (!d) return cc_ok((size_t)0);
    n = d->len();
    if (off >= n) return cc_ok(n);
    if (RtxDoc_index_covers(d, off)) {
        size_t ln = RtxDoc_line_of(d, off) !>(e) { return cc_err(e); };
        size_t known = RtxDoc_line_known(d);
        if (ln + 1 < known) return RtxDoc_line_start(d, ln + 1);
    }
    at = off;
    left = (size_t)RTX_LINE_FLOOR_MAX;
    while (at < n && left > 0) {
        size_t take = n - at;
        size_t got, i;
        if (take > sizeof(buf)) take = sizeof(buf);
        if (take > left) take = left;
        got = d->read_at(at, buf, take) !>(e) {
            return cc_err(rtx_index_from_cc(e));
        };
        if (!got) break;
        for (i = 0; i < got; i++) {
            if (buf[i] == '\n') return cc_ok(at + i + 1);
        }
        at += got;
        left -= got;
    }
    return cc_ok(at < n ? at : n);
}

static inline char[:] !>(CCError) RtxDoc_scratch_span(const RtxDoc *d, CCArena *scratch,
                                          size_t from, size_t n) {
    if (!d) return cc_err(CC_ERR_INVALID_ARG, "null doc");
    return RtxPieceTree_scratch_span(&d->tree, scratch, from, n);
}

static inline int RtxDoc_check(const RtxDoc *d) {
    return d ? RtxPieceTree_check(&d->tree) : 0;
}

static int RtxDoc_init_epochs(RtxDoc *d) {
    if (!d) return 0;
    d->session = cc_arena_heap(kilobytes(16));
    d->analysis = cc_arena_heap(kilobytes(16));
    return d->session.base != NULL && d->analysis.base != NULL;
}

static char[:] !>(CCError) rtx_session_bytes(RtxDoc *d, const char *p, size_t n) {
    char[:] out;
    if (!d) return cc_err(CC_ERR_INVALID_ARG, "session bytes");
    if (n == 0) return cc_ok(cc_slice_empty());
    out = d->session.alloc_slice_bytes(n);
    if (!out.ptr) return cc_err(CC_ERR_OUT_OF_MEMORY, "session bytes");
    if (p) memcpy(out.ptr, p, n);
    return cc_ok(out);
}

/* NUL-terminated path view; len excludes the sentinel. */
static char[:] !>(CCError) rtx_session_str(RtxDoc *d, const char *s) {
    size_t n;
    char[:] out;
    if (!d || !s) return cc_err(CC_ERR_INVALID_ARG, "session str");
    n = strlen(s);
    out = d->session.alloc_slice_bytes(n + 1);
    if (!out.ptr) return cc_err(CC_ERR_OUT_OF_MEMORY, "session str");
    memcpy(out.ptr, s, n + 1);
    return cc_ok(out.sub(0, n));
}

static int rtx_doc_add_section(RtxDoc *d, size_t start, RtxSectionKind kind);

static void RtxDoc_analysis_reset(RtxDoc *d) {
    if (!d) return;
    if (d->analysis.base) d->analysis.reset();
    d->secs = NULL;
    d->sec_len = 0;
    d->sec_cap = 0;
    d->runs = NULL;
    d->run_len = 0;
    d->run_cap = 0;
    d->tm_ckpt = NULL;
    d->tm_ckpt_len = 0;
    d->tm_ckpt_cap = 0;
    memset(d->hl_win, 0, sizeof(d->hl_win));
    d->hl_win_stamp = 0;
    d->hl_full = 0;
}

static void rtx_hist_clear(RtxHistory *h) {
    if (!h) return;
    memset(h, 0, sizeof(*h));
}

static void RtxDoc_break_coalesce(RtxDoc *d) {
    if (d) d->hist.coalesce = 0;
}

static void RtxDoc_destroy(RtxDoc *d) {
    if (!d) return;
    d->tree.destroy();
    rtx_hist_clear(&d->hist);
    if (d->session.base) d->session.destroy();
    if (d->analysis.base) d->analysis.destroy();
    if (d->find.store.base) d->find.store.destroy();
    memset(d, 0, sizeof(*d));
}

static int rtx_doc_is_live(const RtxDoc *d) {
    return d && (RtxPieceTree_is_live(&d->tree) || d->session.base || d->analysis.base);
}

/* Document view if contiguous; otherwise a copy on analysis (analysis epoch). */
static char[:] !>(CCError) rtx_doc_analysis_span(RtxDoc *d, size_t from, size_t n) {
    char[:] view;
    char[:] copy;
    if (!d) return cc_err(CC_ERR_INVALID_ARG, "null doc");
    if (n == 0) return cc_ok(cc_slice_empty());
    view = RtxPieceTree_span(&d->tree, from, n);
    if (view.ptr) return cc_ok(view);
    copy = d->analysis.alloc_slice_bytes(n);
    if (!copy.ptr || copy.len < n) return cc_err(CC_ERR_OUT_OF_MEMORY, "analysis span");
    {
        size_t got = d->read_at(from, copy.ptr, n) !>(e) { return cc_err(e); };
        if (got != n) return cc_err(CC_ERR_INTERNAL, "analysis span read");
    }
    return cc_ok(copy);
}

static void !>(CCError) RtxDoc_empty(RtxDoc *d) {
    if (!d) return cc_err(CC_ERR_INVALID_ARG, "null doc");
    if (rtx_doc_is_live(d)) return cc_err(CC_ERR_INVALID_ARG, "doc already live");
    memset(d, 0, sizeof(*d));
    d->tree.empty() !>(e) { return cc_err(e); };
    if (!RtxDoc_init_epochs(d) || !rtx_doc_add_section(d, 0, RTX_SEC_PROSE)) {
        d->destroy();
        return cc_err(CC_ERR_OUT_OF_MEMORY, "doc epochs");
    }
    return cc_ok();
}

static RtxSectionKind RtxDoc_section_at(const RtxDoc *d, size_t off) {
    size_t lo, hi, i;
    if (!d || d->sec_len == 0) return RTX_SEC_PROSE;
    if (d->len() > (size_t)RTX_MARKUP_SCAN_MAX && off > 0) {
        int covered = 0;
        for (i = 0; i < (size_t)RTX_MARKUP_CACHE_WINDOWS; i++) {
            const RtxMarkupWin *w = &d->hl_win[i];
            if (w->live && off >= w->anchor && off <= w->to) {
                covered = 1;
                break;
            }
        }
        if (!covered) return RTX_SEC_UNKNOWN;
    }
    lo = 0;
    hi = d->sec_len;
    while (lo + 1 < hi) {
        size_t mid = lo + (hi - lo) / 2;
        if (d->secs[mid].start <= off) lo = mid;
        else hi = mid;
    }
    return d->secs[lo].kind;
}

static int rtx_run_start_cmp(const void *a, const void *b) {
    const RtxRun *ra = (const RtxRun *)a;
    const RtxRun *rb = (const RtxRun *)b;
    if (ra->start < rb->start) return -1;
    if (ra->start > rb->start) return 1;
    return 0;
}

static void rtx_tm_ckpt_drop_from(RtxDoc *d, size_t off) {
    if (!d) return;
    while (d->tm_ckpt_len && d->tm_ckpt[d->tm_ckpt_len - 1].off >= off) {
        d->tm_ckpt_len--;
    }
}

static const RtxTmCkpt *rtx_tm_ckpt_find(const RtxDoc *d, size_t lo) {
    size_t a, b;
    if (!d || d->tm_ckpt_len == 0) return NULL;
    a = 0;
    b = d->tm_ckpt_len;
    while (a + 1 < b) {
        size_t mid = a + (b - a) / 2;
        if (d->tm_ckpt[mid].off <= lo) a = mid;
        else b = mid;
    }
    if (d->tm_ckpt[a].off <= lo) return &d->tm_ckpt[a];
    return NULL;
}

static int rtx_tm_ckpt_add(RtxDoc *d, size_t off, size_t sp, const size_t *stk_rule) {
    RtxTmCkpt *c;
    size_t i, n;
    if (!d) return 0;
    if (d->tm_ckpt_len && d->tm_ckpt[d->tm_ckpt_len - 1].off > off) {
        rtx_tm_ckpt_drop_from(d, off);
    }
    if (d->tm_ckpt_len && d->tm_ckpt[d->tm_ckpt_len - 1].off == off) {
        c = &d->tm_ckpt[d->tm_ckpt_len - 1];
    } else {
        if (d->tm_ckpt_len >= RTX_TM_CKPT_MAX) return 0;
        if (d->tm_ckpt_len >= d->tm_ckpt_cap) {
            size_t cap = d->tm_ckpt_cap;
            void *p = d->tm_ckpt;
            rtx_arena_grow(&d->analysis, &p, &cap, d->tm_ckpt_len + 1,
                           sizeof(RtxTmCkpt)) !>(e) {
                (void)e;
                return 0;
            };
            d->tm_ckpt = (RtxTmCkpt *)p;
            d->tm_ckpt_cap = cap;
        }
        c = &d->tm_ckpt[d->tm_ckpt_len++];
    }
    c->off = off;
    n = sp < (size_t)RTX_TM_CKPT_DEPTH ? sp : (size_t)RTX_TM_CKPT_DEPTH;
    c->n = (unsigned char)n;
    for (i = 0; i < n; i++) c->rule[i] = (unsigned short)stk_rule[i];
    return 1;
}

static void rtx_doc_sort_runs(RtxDoc *d) {
    if (d && d->run_len > 1) {
        qsort(d->runs, d->run_len, sizeof(RtxRun), rtx_run_start_cmp);
    }
}

static int rtx_run_is_hl_only(RtxRun r) {
    return r.style.scope != RTX_SCOPE_NONE && !r.style.bold && !r.style.italic &&
           !r.style.mono;
}

static int rtx_run_is_markup_only(RtxRun r) {
    return (r.style.bold || r.style.italic || r.style.mono) &&
           r.style.scope == RTX_SCOPE_NONE;
}

/* Keep prefix/suffix of overlapping pred runs; drop only [lo, hi). */
static void !>(CCError) rtx_doc_clip_runs(RtxDoc *d, size_t lo, size_t hi,
                                         int (*pred)(RtxRun)) {
    RtxRun *out;
    size_t i, n, cap;
    if (!d || !pred || hi <= lo) return cc_ok();
    n = 0;
    for (i = 0; i < d->run_len; i++) {
        RtxRun r = d->runs[i];
        size_t end = r.start + r.len;
        if (!pred(r) || end <= lo || r.start >= hi) n++;
        else {
            if (r.start < lo) n++;
            if (end > hi) n++;
        }
    }
    if (n == d->run_len) {
        int any = 0;
        for (i = 0; i < d->run_len; i++) {
            RtxRun r = d->runs[i];
            size_t end = r.start + r.len;
            if (pred(r) && end > lo && r.start < hi) any = 1;
        }
        if (!any) return cc_ok();
    }
    cap = 0;
    out = NULL;
    rtx_arena_grow(&d->analysis, (void **)&out, &cap, n ? n : 1,
                   sizeof(RtxRun)) !>(e) {
        return cc_err(e);
    };
    n = 0;
    for (i = 0; i < d->run_len; i++) {
        RtxRun r = d->runs[i];
        size_t end = r.start + r.len;
        if (!pred(r) || end <= lo || r.start >= hi) {
            out[n++] = r;
            continue;
        }
        if (r.start < lo) {
            RtxRun p = r;
            p.len = lo - r.start;
            out[n++] = p;
        }
        if (end > hi) {
            RtxRun s = r;
            s.start = hi;
            s.len = end - hi;
            out[n++] = s;
        }
    }
    d->runs = out;
    d->run_len = n;
    d->run_cap = cap;
    return cc_ok();
}

static void rtx_doc_shift_intervals(RtxDoc *d, size_t at, size_t erased, size_t inserted) {
    size_t i;
    if (!d || (erased == 0 && inserted == 0)) return;
    memset(d->hl_win, 0, sizeof(d->hl_win));
    d->hl_win_stamp = 0;
    rtx_tm_ckpt_drop_from(d, at);
    for (i = 0; i < d->sec_len; i++) {
        size_t s = d->secs[i].start;
        if (s <= at) continue;
        if (erased && s - at < erased) d->secs[i].start = at;
        else d->secs[i].start = s - erased + inserted;
    }
    for (i = 0; i < d->run_len; i++) {
        size_t start = d->runs[i].start;
        size_t rlen = d->runs[i].len;
        size_t end = start + rlen;
        if (end <= at) continue;
        if (start >= at) {
            if (erased && start - at < erased) {
                size_t cut = at + erased - start;
                if (cut >= rlen) {
                    d->runs[i].len = 0;
                    continue;
                }
                d->runs[i].start = at;
                d->runs[i].len = rlen - cut;
            } else {
                d->runs[i].start = start - erased + inserted;
            }
        } else {
            size_t overlap = 0;
            if (erased) {
                size_t er_end = at + erased;
                size_t ov_end = end < er_end ? end : er_end;
                overlap = ov_end > at ? ov_end - at : 0;
                if (overlap > rlen) overlap = rlen;
            }
            d->runs[i].len = rlen - overlap + inserted;
        }
    }
}

static int rtx_doc_add_section(RtxDoc *d, size_t start, RtxSectionKind kind) {
    rtx_arena_grow(&d->analysis, (void **)&d->secs, &d->sec_cap, d->sec_len + 1,
                   sizeof(RtxSection)) !>(e) {
        (void)e;
        return 0;
    };
    d->secs[d->sec_len].start = start;
    d->secs[d->sec_len].kind = kind;
    d->secs[d->sec_len].hl_done = 0;
    d->sec_len++;
    return 1;
}

static int rtx_doc_add_run(RtxDoc *d, size_t start, size_t len, RtxStyle style) {
    rtx_arena_grow(&d->analysis, (void **)&d->runs, &d->run_cap, d->run_len + 1,
                   sizeof(RtxRun)) !>(e) {
        (void)e;
        return 0;
    };
    d->runs[d->run_len].start = start;
    d->runs[d->run_len].len = len;
    d->runs[d->run_len].style = style;
    d->run_len++;
    return 1;
}

static int rtx_path_looks_code(const char *path);

static int rtx_markup_header_at(const char *buf, size_t i, size_t n, int at_bol,
                                RtxSectionKind *kind) {
    if (!buf || !kind || !at_bol) return 0;
    if (i + 12 <= n && memcmp(buf + i, "=== code ===", 12) == 0) {
        *kind = RTX_SEC_CODE;
        return 1;
    }
    if (i + 13 <= n && memcmp(buf + i, "=== prose ===", 13) == 0) {
        *kind = RTX_SEC_PROSE;
        return 1;
    }
    return 0;
}

static void !>(CCError) rtx_doc_scan_markup_runs(RtxDoc *d, const char *buf,
                                                size_t base, size_t n) {
    size_t i;
    if (!d || !buf || n == 0) return cc_ok();
    for (i = 0; i < n; i++) {
        if (buf[i] == '`') {
            size_t j = i + 1;
            while (j < n && buf[j] != '`' && buf[j] != '\n') j++;
            if (j < n && buf[j] == '`' && j > i + 1) {
                RtxStyle st = {0};
                st.mono = 1;
                if (!rtx_doc_add_run(d, base + i + 1, j - (i + 1), st)) {
                    return cc_err(CC_ERR_OUT_OF_MEMORY, "run");
                }
                i = j;
            }
        } else if (buf[i] == '*') {
            size_t j = i + 1;
            while (j < n && buf[j] != '*' && buf[j] != '\n') j++;
            if (j < n && buf[j] == '*' && j > i + 1) {
                RtxStyle st = {0};
                st.bold = 1;
                if (!rtx_doc_add_run(d, base + i + 1, j - (i + 1), st)) {
                    return cc_err(CC_ERR_OUT_OF_MEMORY, "run");
                }
                i = j;
            }
        }
    }
    return cc_ok();
}

static void !>(CCError) rtx_doc_scan_buf(RtxDoc *d, const char *buf, size_t n) {
    size_t i;
    if (!rtx_doc_add_section(d, 0, RTX_SEC_PROSE)) {
        return cc_err(CC_ERR_OUT_OF_MEMORY, "section");
    }
    if (!buf || n == 0) return cc_ok();
    for (i = 0; i < n; i++) {
        RtxSectionKind k;
        int at_bol = (i == 0 || buf[i - 1] == '\n');
        if (rtx_markup_header_at(buf, i, n, at_bol, &k)) {
            if (!rtx_doc_add_section(d, i, k)) {
                return cc_err(CC_ERR_OUT_OF_MEMORY, "section");
            }
        }
    }
    return rtx_doc_scan_markup_runs(d, buf, 0, n);
}

static int rtx_sec_start_cmp(const void *a, const void *b) {
    const RtxSection *sa = (const RtxSection *)a;
    const RtxSection *sb = (const RtxSection *)b;
    if (sa->start < sb->start) return -1;
    if (sa->start > sb->start) return 1;
    return 0;
}

/* Last === header in the one-budget chunk before `before`. Thirteen bytes of
 * lookahead finish a header that begins just before the chunk boundary. */
static void !>(CCError) rtx_doc_lookback_header(const RtxDoc *d, size_t before,
                                               int *found, size_t *hoff,
                                               RtxSectionKind *hk,
                                               size_t *next_before) {
    char back[RTX_MARKUP_LOOKBACK + 16];
    size_t lo, hi, got, i, n;
    int at_bol;
    if (!d || !found || !hoff || !hk || !next_before) {
        return cc_err(CC_ERR_INVALID_ARG, "lookback");
    }
    *found = 0;
    *next_before = 0;
    if (before == 0) return cc_ok();
    n = d->len();
    if (before > n) before = n;
    lo = before > (size_t)RTX_MARKUP_LOOKBACK
             ? before - (size_t)RTX_MARKUP_LOOKBACK
             : 0;
    hi = before + 13;
    if (hi > n) hi = n;
    *next_before = lo;
    if (hi <= lo) return cc_ok();
    got = d->read_at(lo, back, hi - lo) !>(e) { return cc_err(e); };
    at_bol = (lo == 0);
    if (lo > 0) {
        char p = 0;
        size_t pg = d->read_at(lo - 1, &p, 1) !>(e) { return cc_err(e); };
        at_bol = (pg == 1 && p == '\n');
    }
    for (i = 0; i < got; i++) {
        RtxSectionKind k;
        if (lo + i < before && rtx_markup_header_at(back, i, got, at_bol, &k)) {
            *found = 1;
            *hoff = lo + i;
            *hk = k;
        }
        at_bol = (back[i] == '\n');
    }
    return cc_ok();
}

static RtxSectionKind rtx_doc_path_kind(const RtxDoc *d) {
    return d && d->path.ptr && rtx_path_looks_code(d->path.ptr)
               ? RTX_SEC_CODE
               : RTX_SEC_PROSE;
}

static RtxMarkupWin *rtx_doc_markup_win(RtxDoc *d, size_t from, size_t to) {
    size_t i;
    size_t victim = 0;
    if (!d) return NULL;
    for (i = 0; i < (size_t)RTX_MARKUP_CACHE_WINDOWS; i++) {
        if (d->hl_win[i].live && d->hl_win[i].from == from &&
            d->hl_win[i].to == to) {
            d->hl_win[i].stamp = ++d->hl_win_stamp;
            return &d->hl_win[i];
        }
        if (!d->hl_win[i].live ||
            d->hl_win[i].stamp < d->hl_win[victim].stamp) {
            victim = i;
        }
    }
    memset(&d->hl_win[victim], 0, sizeof(d->hl_win[victim]));
    d->hl_win[victim].from = from;
    d->hl_win[victim].to = to;
    d->hl_win[victim].back = from;
    d->hl_win[victim].anchor = from;
    d->hl_win[victim].stamp = ++d->hl_win_stamp;
    d->hl_win[victim].kind = RTX_SEC_UNKNOWN;
    d->hl_win[victim].live = 1;
    if (from == 0) {
        d->hl_win[victim].known = 1;
        d->hl_win[victim].kind = rtx_doc_path_kind(d);
    }
    return &d->hl_win[victim];
}

static void !>(CCError) rtx_doc_resolve_markup_win(RtxDoc *d, RtxMarkupWin *w) {
    int found = 0;
    size_t hoff = 0;
    size_t next = 0;
    RtxSectionKind hk = RTX_SEC_UNKNOWN;
    if (!d || !w || !w->live || w->known) return cc_ok();
    rtx_doc_lookback_header(d, w->back, &found, &hoff, &hk, &next) !>(e) {
        return cc_err(e);
    };
    if (found) {
        w->known = 1;
        w->kind = hk;
        w->anchor = hoff;
    } else {
        w->back = next;
        if (next == 0) {
            w->known = 1;
            w->kind = rtx_doc_path_kind(d);
            w->anchor = 0;
        } else if (rtx_doc_path_kind(d) == RTX_SEC_CODE) {
            /* Grammar on the path already proved CODE. Waiting for BOF
             * would take ~len/LOOKBACK frames on a mid-file jump. */
            w->known = 1;
            w->kind = RTX_SEC_CODE;
            w->anchor = w->from;
        }
    }
    return cc_ok();
}

static void !>(CCError) rtx_doc_merge_window_secs(RtxDoc *d, size_t sec_lo, size_t to,
                                                 const RtxSection *neu, size_t nneu) {
    RtxSection keep[RTX_MARKUP_WIN_SECS * RTX_MARKUP_CACHE_WINDOWS];
    size_t nkeep = 0;
    size_t i, need, o;
    if (!d || !neu || nneu == 0) return cc_err(CC_ERR_INVALID_ARG, "window secs");
    for (i = 0; i < d->sec_len; i++) {
        size_t s = d->secs[i].start;
        size_t wi;
        int replaced = (s >= sec_lo && s <= to);
        int cached = 0;
        for (wi = 0; wi < (size_t)RTX_MARKUP_CACHE_WINDOWS; wi++) {
            RtxMarkupWin *w = &d->hl_win[wi];
            if (w->live && s >= w->anchor && s <= w->to) {
                cached = 1;
                break;
            }
        }
        if (!replaced && cached &&
            nkeep < (size_t)(RTX_MARKUP_WIN_SECS * RTX_MARKUP_CACHE_WINDOWS)) {
            keep[nkeep++] = d->secs[i];
        }
    }
    need = nkeep + nneu;
    rtx_arena_grow(&d->analysis, (void **)&d->secs, &d->sec_cap, need,
                   sizeof(RtxSection)) !>(e) { return cc_err(e); };
    for (i = 0; i < nkeep; i++) d->secs[i] = keep[i];
    for (i = 0; i < nneu; i++) d->secs[nkeep + i] = neu[i];
    d->sec_len = need;
    if (d->sec_len > 1) {
        qsort(d->secs, d->sec_len, sizeof(RtxSection), rtx_sec_start_cmp);
    }
    o = 0;
    for (i = 0; i < d->sec_len; i++) {
        if (i + 1 < d->sec_len && d->secs[i].start == d->secs[i + 1].start) continue;
        d->secs[o++] = d->secs[i];
    }
    d->sec_len = o;
    return cc_ok();
}

/* Classify [from, to] from one bounded backward step + visible bytes. A miss
 * on mixed markup stays UNKNOWN; a TM-backed path is CODE on this call. Later
 * cameras continue from the saved lookback edge. */
static void !>(CCError) rtx_doc_window_markup(RtxDoc *d, size_t from, size_t to) {
    RtxSection neu[RTX_MARKUP_WIN_SECS];
    size_t nneu = 0;
    size_t n, i, saved;
    RtxSectionKind kind;
    size_t sec_lo;
    RtxMarkupWin *win;
    if (!d) return cc_err(CC_ERR_INVALID_ARG, "null doc");
    saved = d->run_len;
    n = d->len();
    if (from > n) from = n;
    if (to > n) to = n;
    if (from > to) from = to;
    if (to > from && to - from > (size_t)RTX_MARKUP_SCAN_MAX) {
        to = from + (size_t)RTX_MARKUP_SCAN_MAX;
    }
    win = rtx_doc_markup_win(d, from, to);
    if (!win) return cc_err(CC_ERR_INTERNAL, "markup window");
    if (win->known && win->ready) return cc_ok();
    rtx_doc_resolve_markup_win(d, win) !>(e) { return cc_err(e); };
    kind = win->known ? win->kind : RTX_SEC_UNKNOWN;
    sec_lo = win->known ? win->anchor : from;
    neu[nneu].start = sec_lo;
    neu[nneu].kind = kind;
    neu[nneu].hl_done = 0;
    nneu++;
    if (to > from) {
        cc_arena_stack(scratch, RTX_FRAME_SCRATCH);
        char[:] bytes = d->scratch_span(&scratch, from, to - from) !>(e) {
            return cc_err(e);
        };
        int at_bol = (from == 0);
        if (from > 0) {
            char p = 0;
            size_t pg = d->read_at(from - 1, &p, 1) !>(e) { return cc_err(e); };
            at_bol = (pg == 1 && p == '\n');
        }
        for (i = 0; i < bytes.len; i++) {
            RtxSectionKind k;
            if (rtx_markup_header_at(bytes.ptr, i, bytes.len, at_bol, &k)) {
                size_t off = from + i;
                if (nneu > 0 && neu[nneu - 1].start == off) {
                    neu[nneu - 1].kind = k;
                    if (off == from) {
                        win->known = 1;
                        win->kind = k;
                        win->anchor = from;
                    }
                } else if (nneu < (size_t)RTX_MARKUP_WIN_SECS) {
                    neu[nneu].start = off;
                    neu[nneu].kind = k;
                    neu[nneu].hl_done = 0;
                    nneu++;
                }
            }
            at_bol = (bytes.ptr[i] == '\n');
        }
        {
            RtxRun *old_runs = d->runs;
            size_t old_len = d->run_len;
            size_t old_cap = d->run_cap;
            rtx_doc_clip_runs(d, from, to, rtx_run_is_markup_only) !>(e) {
                return cc_err(e);
            };
            rtx_doc_scan_markup_runs(d, bytes.ptr, from, bytes.len) !>(e) {
                d->runs = old_runs;
                d->run_len = old_len;
                d->run_cap = old_cap;
                return cc_err(e);
            };
            rtx_doc_merge_window_secs(d, sec_lo, to, neu, nneu) !>(e) {
                d->runs = old_runs;
                d->run_len = old_len;
                d->run_cap = old_cap;
                return cc_err(e);
            };
        }
    } else {
        rtx_doc_merge_window_secs(d, sec_lo, to, neu, nneu) !>(e) {
            d->run_len = saved;
            return cc_err(e);
        };
    }
    win->ready = win->known;
    return cc_ok();
}

/* Records on analysis. Bytes are a document view or an analysis-epoch copy.
 * Open stays O(open): above RTX_MARKUP_SCAN_MAX plant one section. ensure_hl
 * classifies the visible window (plus lookback) so an 8G file still colors. */
static void !>(CCError) rtx_doc_scan_markup(RtxDoc *d) {
    size_t n;
    if (!d) return cc_err(CC_ERR_INVALID_ARG, "null doc");
    d->analysis_reset();
    n = d->len();
    if (n == 0) {
        if (!rtx_doc_add_section(d, 0, RTX_SEC_PROSE)) {
            return cc_err(CC_ERR_OUT_OF_MEMORY, "section");
        }
        return cc_ok();
    }
    if (n > RTX_MARKUP_SCAN_MAX) {
        if (!rtx_doc_add_section(d, 0, RTX_SEC_PROSE)) {
            return cc_err(CC_ERR_OUT_OF_MEMORY, "section");
        }
        return cc_ok();
    }
    {
        char[:] bytes = rtx_doc_analysis_span(d, 0, n) !>(e) { return cc_err(e); };
        rtx_doc_scan_buf(d, bytes.ptr, bytes.len) !>(e) {
            d->analysis_reset();
            return cc_err(e);
        };
    }
    return cc_ok();
}

static void !>(CCError) rtx_doc_highlight(RtxDoc *d);
#include "highlight.cch"

static int rtx_path_looks_code(const char *path) {
    return rtx_tm_for_path(path) != NULL;
}

static void !>(CCError) RtxDoc_reparse(RtxDoc *d) {
    size_t n;
    if (!d) return cc_err(CC_ERR_INVALID_ARG, "null doc");
    rtx_doc_scan_markup(d) !>(e) { return cc_err(e); };
    n = d->len();
    if (n <= RTX_HL_FULL_MAX) {
        rtx_doc_highlight(d) !>(e) { return cc_err(e); };
        d->hl_full = 1;
    } else {
        d->hl_full = 0;
    }
    rtx_doc_sort_runs(d);
    return cc_ok();
}

static void !>(CCError) RtxDoc_from_path(RtxDoc *d, const char *path) {
    if (!d) return cc_err(CC_ERR_INVALID_ARG, "null doc");
    if (rtx_doc_is_live(d)) return cc_err(CC_ERR_INVALID_ARG, "doc already live");
    memset(d, 0, sizeof(*d));
    d->tree.from_path(path) !>(e) { return cc_err(e); };
    if (!RtxDoc_init_epochs(d)) {
        d->destroy();
        return cc_err(CC_ERR_OUT_OF_MEMORY, "doc epochs");
    }
    d->path = rtx_session_str(d, path) !>(e) {
        d->destroy();
        return cc_err(e);
    };
    rtx_doc_scan_markup(d) !>(e) {
        d->destroy();
        return cc_err(e);
    };
    if (d->sec_len == 1 && rtx_path_looks_code(path)) {
        d->secs[0].kind = RTX_SEC_CODE;
    }
    {
        size_t n = d->len();
        if (n <= RTX_HL_FULL_MAX) {
            rtx_doc_highlight(d) !>(e) {
                d->destroy();
                return cc_err(e);
            };
            d->hl_full = 1;
        }
    }
    rtx_doc_sort_runs(d);
    return cc_ok();
}

static void !>(CCError) RtxDoc_from_buffer(RtxDoc *d, char[:] bytes) {
    if (!d) return cc_err(CC_ERR_INVALID_ARG, "null doc");
    if (rtx_doc_is_live(d)) return cc_err(CC_ERR_INVALID_ARG, "doc already live");
    memset(d, 0, sizeof(*d));
    d->tree.from_buffer(bytes) !>(e) { return cc_err(e); };
    if (!RtxDoc_init_epochs(d)) {
        d->destroy();
        return cc_err(CC_ERR_OUT_OF_MEMORY, "doc epochs");
    }
    rtx_doc_scan_markup(d) !>(e) {
        d->destroy();
        return cc_err(e);
    };
    {
        size_t n = d->len();
        if (n <= RTX_HL_FULL_MAX) {
            rtx_doc_highlight(d) !>(e) {
                d->destroy();
                return cc_err(e);
            };
            d->hl_full = 1;
        }
    }
    rtx_doc_sort_runs(d);
    return cc_ok();
}

#include "find.cch"
#include "edit.cch"

@typehooks on RtxDoc {
    .destroy = RtxDoc_destroy,
};
@typeview on RtxDoc {
    as: tree;
};
typedef @typeview Highlight on RtxDoc {
    r: read_at, scratch_span, style_at, section_at, ensure_hl;
} *RtxDocHighlight;
typedef @typeview Layout on RtxDoc {
    r: len, line_count, line_start, line_of, line_guess, index_covers,
       read_at, scratch_span, style_at, section_at, ensure_hl;
} *RtxDocLayout;

#endif /* RTX_DOCUMENT_H */
