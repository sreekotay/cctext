#!ccc cch
/*
 * Document: tree + session + analysis + find field.
 * Face: RtxDoc_* plus the few rtx_* other TUs call.
 * Chapter faces: edit.cch, tm.cch. Bodies in document.ccs.
 * Intervals are byte offsets. Frame copies take a scratch arena.
 */
#ifndef RTX_DOCUMENT_H
#define RTX_DOCUMENT_H

#include <stdint.h>
#include "piece_tree.cch"
#include "scope.cch"

/* CODE and MARKUP are both lexed (TM / spike) and keep scope in style_at.
 * MARKUP is a grammar whose JSON declares `"cctext": { "kind": "markup" }`;
 * frontends may pick a prose face for it. PROSE has no grammar: the `*` /
 * `` ` `` scanner plants its runs. */
typedef enum {
    RTX_SEC_CODE = 0,
    RTX_SEC_PROSE = 1,
    RTX_SEC_UNKNOWN = 2,
    RTX_SEC_MARKUP = 3,
} RtxSectionKind;

#define RTX_HL_FULL_MAX 262144
#define RTX_MARKUP_SCAN_MAX 262144
#define RTX_HL_WIN_MAX RTX_MARKUP_SCAN_MAX
/* Mid-field grid cam_lo / TM lookback. Not RTX_FRAME_SCRATCH. */
#define RTX_MARKUP_LOOKBACK 16384

typedef struct {
    size_t from;
    size_t n;
    int keep; /* 1 = lex this window without dropping the rest of a long CODE */
} RtxHlWin;

RtxHlWin rtx_hl_win(size_t from, size_t n);
RtxHlWin rtx_hl_span(size_t from, size_t to);
/* Grid header / held lookback: same lex, do not clip the window. */
RtxHlWin rtx_hl_keep(size_t from, size_t n);

typedef enum {
    RTX_TM_LOOKBACK = 0,
    RTX_TM_CATCHUP = 1,
} RtxTmWalk;
#define RTX_MARKUP_WIN_SECS 64
#define RTX_MARKUP_CACHE_WINDOWS 8
#define RTX_TM_CKPT_STRIDE 16384
#define RTX_TM_CKPT_MAX 256
#define RTX_TM_CKPT_DEPTH 32
#define RTX_TM_CATCHUP_MAX (512 * 1024)
#define RTX_FOLD_MAX 8

typedef struct {
    size_t lo;
    size_t hi;
} RtxFold;

typedef struct {
    size_t off;
    unsigned char n;
    unsigned short rule[RTX_TM_CKPT_DEPTH];
    unsigned short lang[RTX_TM_CKPT_DEPTH];  /* rtx_tm_langs index */
    unsigned short embed[RTX_TM_CKPT_DEPTH]; /* guest lang, 0xffff = none */
} RtxTmCkpt;

/* Hist copies deleted bytes only up to this (typing/backspace coalesce).
 * Larger deletes keep piece refs so undo/redo can splice them back. */
#define RTX_HIST_INLINE_MAX (256 * 1024)

typedef struct {
    size_t start;
    RtxSectionKind kind;
    unsigned hl_done : 1;
} RtxSection;

typedef struct {
    unsigned bold : 1;
    unsigned italic : 1;
    unsigned mono : 1;
    RtxScope scope;
} RtxStyle;

/* Who planted a run. Clipping is by planter, not by which style bits the
 * run carries: a window re-lex clips its own planter's runs only. */
typedef enum {
    RTX_RUN_PROSE = 0, /* rtx_doc_scan_markup_runs (PROSE without a grammar) */
    RTX_RUN_TM = 1,    /* rtx_tm_lex / rtx_hl_spike (host grammar) */
    RTX_RUN_INJECT = 2 /* guest lex inside a host span (same walk; clipped with TM) */
} RtxRunPlanter;

enum {
    RTX_ARITY_PAIR = 0,
    RTX_ARITY_PREFIX = 1,
    RTX_ARITY_PATH = 2
};
#define RTX_MARK_ARITY 0x03
#define RTX_MARK_DEST 0x04

/* nav.ccs mirrors this layout as RtxNavRun (tm_grammar_smoke checks sizes). */
typedef struct {
    size_t start;
    size_t len;
    RtxStyle style;
    unsigned char planter; /* RtxRunPlanter */
    unsigned char hint_a;  /* span: matched begin bytes (clamp 255); else 0 */
    unsigned char hint_b;  /* span: matched end bytes; 0 = unclosed / not a span */
    unsigned char mark;    /* RTX_ARITY_* + RTX_MARK_DEST; copied from the rule */
} RtxRun;

static inline int rtx_run_arity(const RtxRun *r) {
    return r ? (int)(r->mark & RTX_MARK_ARITY) : RTX_ARITY_PAIR;
}
static inline int rtx_run_dest(const RtxRun *r) {
    return r && rtx_run_arity(r) == RTX_ARITY_PATH && (r->mark & RTX_MARK_DEST);
}

/* Bounded backward classifier for one visible camera. A miss advances `back`
 * by one budget; later draws continue until a header or BOF proves `kind`. */
typedef struct {
    size_t from;
    size_t to;
    size_t back;
    size_t anchor;
    size_t stamp;
    RtxSectionKind kind;
    unsigned live : 1;
    unsigned known : 1;
    unsigned ready : 1;
} RtxMarkupWin;

typedef struct {
    RtxPieceRef *refs;
    size_t n;
    size_t nbytes;
} RtxHistRefs;

/* Tagged restore. text / ins are session wraps (`vec_from`); do not
 * store into .len — assign a new from(). */
@variant RtxHistDel {
    text: Vec::[char];
    pieces: RtxHistRefs;
};

typedef struct {
    size_t off;
    RtxHistDel del;
    Vec::[char] ins;
    size_t caret_before;
    size_t sel_before;
    size_t caret_after;
    size_t sel_after;
    int sel_box_before;
    size_t box_acol_before;
    size_t box_ccol_before;
    int sel_box_after;
    size_t box_acol_after;
    size_t box_ccol_after;
} RtxHistRec;

RtxHistRec rtx_hist_rec_empty(void);
size_t rtx_hist_del_n(const RtxHistRec *r);
int rtx_hist_del_is_pieces(const RtxHistRec *r);
RtxHistRefs rtx_hist_del_pieces(const RtxHistRec *r);
char[:] rtx_hist_del_view(const RtxHistRec *r);
static inline Vec::[char] rtx_hist_from(char *p, size_t len, size_t cap) {
    return vec_from::[char](p, len, cap);
}

typedef struct {
    RtxHistRec *recs;
    size_t len;
    size_t cap;
    size_t head;
    int applying;
    int coalesce;
} RtxHistory;

#ifndef RTX_FIND_BUDGET
enum {
    RTX_FIND_BUDGET = 2 * 1024 * 1024,
    RTX_FIND_BLOCK = RTX_FIND_BUDGET,
    RTX_FIND_MAX = 32768,
    RTX_FIND_QMAX = 256
};
#endif

#ifndef RTX_FIND_CAP
#define RTX_FIND_CAP 4
#endif

typedef struct {
    CCArena store;         /* created on first find_set */
    char[:] query;
    size_t *offs;
    size_t len;
    size_t cap;
    size_t scan_off;
    size_t scan_base;      /* kick start; write stage advances scan_bytes */
    size_t scan_bytes;     /* published bytes done (chrome %) */
    size_t cur;
    size_t origin;         /* caret at find_set; list highlight prefers >= origin */
    unsigned done : 1;
    unsigned truncated : 1;
    unsigned pinned : 1;   /* user selected a hit (click / next / prev) */
    unsigned cancel : 1;   /* written when a cancel key is consumed */
    CCParallel h;
} RtxFind;

typedef struct {
    RtxPieceTree tree;     /* document epoch: page store + nodes */
    CCArena session;       /* path + hist; lives until close */
    CCArena analysis;      /* secs + runs + tm_ckpt; reset on reparse */
    Vec::[RtxSection] secs;
    Vec::[RtxRun] runs;
    size_t caret;
    size_t sel_anchor;
    int sel_box;           /* 0 = stream [anchor, caret); 1 = column box */
    size_t box_acol;       /* virtual byte cols; (size_t)-1 = EOL */
    size_t box_ccol;
    char[:] path;
    int disk_valid;        /* 1: disk_* is path at open / last save */
    int64_t disk_mtime;
    uint64_t disk_sz;
    uint64_t disk_ino;
    int save_overwrite;    /* one-shot: next save ignores disk_changed */
    size_t saved_head;
    size_t edit_gen;       /* bumps on every successful content change (incl. coalesce) */
    size_t last_off;
    int last_markup;       /* `=` / large delete — sections may have moved */
    int hl_full;
    RtxMarkupWin hl_win[RTX_MARKUP_CACHE_WINDOWS]; /* bounded visited-window cache */
    size_t hl_win_stamp;
    Vec::[RtxTmCkpt] tm_ckpt; /* stack at stride points; analysis epoch */
    int broken;            /* unrestorable tree; refuse further edits */
    RtxHistory hist;
    RtxFind find;           /* find.cch: set / step / invalidate / goto */
    RtxFold folds[RTX_FOLD_MAX]; /* session; in-window regions only */
    size_t fold_n;
} RtxDoc;

static inline size_t RtxDoc_len(const RtxDoc *d) {
    return d ? RtxPieceTree_len(&d->tree) : 0;
}

static inline size_t RtxDoc_line_count(const RtxDoc *d) {
    return d ? RtxPieceTree_line_count(&d->tree) : 1;
}

static inline size_t RtxDoc_line_known(const RtxDoc *d) {
    return d ? RtxPieceTree_line_known(&d->tree) : 1;
}

static inline int RtxDoc_lf_ready(const RtxDoc *d) {
    return d ? RtxPieceTree_lf_ready(&d->tree) : 1;
}

static inline int RtxDoc_index_fault(const RtxDoc *d) {
    return d ? RtxPieceTree_index_fault(&d->tree) : 0;
}

static inline size_t !>(RtxIndexErr) RtxDoc_line_start(const RtxDoc *d, size_t line) {
    if (!d) return cc_ok((size_t)0);
    return RtxPieceTree_line_start(&d->tree, line);
}

static inline size_t !>(RtxIndexErr) RtxDoc_line_of(const RtxDoc *d, size_t offset) {
    if (!d) return cc_ok((size_t)0);
    return RtxPieceTree_line_of(&d->tree, offset);
}

static inline int RtxDoc_index_covers(const RtxDoc *d, size_t off) {
    return d ? RtxPieceTree_index_covers(&d->tree, off) : 1;
}

static inline size_t RtxDoc_line_guess(const RtxDoc *d, size_t off) {
    return d ? RtxPieceTree_line_guess(&d->tree, off) : 0;
}

static inline size_t !>(CCError) RtxDoc_read_at(const RtxDoc *d, size_t offset, char *dest, size_t n) {
    if (!d) return cc_err(CC_ERR_INVALID_ARG, "null doc");
    return RtxPieceTree_read_at(&d->tree, offset, dest, n);
}

static inline char[:] !>(CCError) RtxDoc_scratch_span(const RtxDoc *d, size_t from,
                                          size_t n, CCArena a) {
    if (!d) return cc_err(CC_ERR_INVALID_ARG, "null doc");
    return RtxPieceTree_scratch_span(&d->tree, from, n, a);
}

static inline int RtxDoc_check(const RtxDoc *d) {
    return d ? RtxPieceTree_check(&d->tree) : 0;
}

#define RTX_LINE_FLOOR_MAX 8192

/* Byte start of the line containing `off`. Local read; never line_of. */
size_t !>(RtxIndexErr) rtx_doc_line_floor_local(const RtxDoc *d, size_t off);
/* Local read when the index does not cover `off` — never scans the prefix. */
size_t !>(RtxIndexErr) rtx_doc_line_floor(const RtxDoc *d, size_t off);
/* First byte of the next line after `off`, or len. */
size_t !>(RtxIndexErr) rtx_doc_line_next(const RtxDoc *d, size_t off);
/* Caret at end of the line containing `off` (before the newline, or len). */
size_t !>(RtxIndexErr) rtx_doc_line_end_caret(const RtxDoc *d, size_t off);
/* 1 and *next_out = first byte of the next line. 0 = last line. */
int !>(RtxIndexErr) rtx_doc_next_line_start(const RtxDoc *d, size_t start,
                                                   size_t *next_out);
/* Signed newline count in [from, to). 0 if wider than the local floor window. */
long rtx_doc_lf_delta_local(const RtxDoc *d, size_t from, size_t to);
char[:] !>(CCError) rtx_doc_box_text(RtxDoc *d, CCArena a);
void !>(CCError) rtx_doc_box_apply(RtxDoc *d, char[:] ins);

int RtxDoc_init_epochs(RtxDoc *d);
void RtxDoc_analysis_reset(RtxDoc *d);
void RtxDoc_break_coalesce(RtxDoc *d);
void RtxDoc_destroy(RtxDoc *d);
void !>(CCError) RtxDoc_empty(RtxDoc *d);
void !>(CCError) RtxDoc_from_path(RtxDoc *d, const char *path);
void !>(CCError) RtxDoc_from_buffer(RtxDoc *d, char[:] bytes);
void !>(CCError) RtxDoc_reparse(RtxDoc *d);
size_t !>(CCError) RtxDoc_cluster_align(const RtxDoc *d, size_t off);
size_t !>(CCError) RtxDoc_cluster_next(const RtxDoc *d, size_t off);
size_t !>(CCError) RtxDoc_cluster_prev(const RtxDoc *d, size_t off);
RtxSectionKind RtxDoc_section_at(const RtxDoc *d, size_t off);
RtxStyle RtxDoc_style_at(const RtxDoc *d, size_t off);
/* Smallest run start / end in (off, hi], else hi. style_at is constant on
 * [off, style_next(off, hi)). Layout's per-run measure walks this. */
size_t RtxDoc_style_next(const RtxDoc *d, size_t off, size_t hi);
/* Markup lens (docs/md_view.md). hint_at: `off` is inside a run's begin or
 * end hint → its [lo, hi). mark_at: a hinted run's [start, start+len]
 * holds `off` (inclusive end) → the run span; reveal-on-entry reads it. */
int RtxDoc_hint_at(const RtxDoc *d, size_t off, size_t *lo, size_t *hi);
int RtxDoc_mark_at(const RtxDoc *d, size_t off, size_t *lo, size_t *hi);
/* has_marks: any hinted run (per-fill gate). hint_next: next hint start in
 * (off, hi], else hi. */
int RtxDoc_has_marks(const RtxDoc *d);
size_t RtxDoc_hint_next(const RtxDoc *d, size_t off, size_t hi);
/* Path dest run covering `off` → [lo, hi) of that run. */
int RtxDoc_dest_at(const RtxDoc *d, size_t off, size_t *lo, size_t *hi);
/* Path faces around `off`: [lo, hi) is the label run union the adjacent
 * dest run (either order). keep is the label content. 1 if `off` is on a
 * path run. */
int RtxDoc_path_at(const RtxDoc *d, size_t off, size_t *lo, size_t *hi,
                   size_t *keep_lo, size_t *keep_hi);
/* Apply unwrap: keep the label content, drop the label opener and dest. */
void !>(CCError) RtxDoc_path_unwrap(RtxDoc *d, size_t off);
/* Prefix hint covering `off` → that hint's [lo, hi). */
int RtxDoc_prefix_at(const RtxDoc *d, size_t off, size_t *lo, size_t *hi);
/* Apply: drop the last `#` in the hint, or the whole hint when one remains
 * (or none). One replace. Quote / list markers without `#` unwrap. */
void !>(CCError) RtxDoc_prefix_apply(RtxDoc *d, size_t off);
/* Dest content (path) or pair interior (wrapped autolink). 1 if `off` is
 * on a followable mark. */
int RtxDoc_link_target(const RtxDoc *d, size_t off, size_t *lo, size_t *hi);
/* Rich join rule (DESIGN Encoding): a pair's hints are one atom in two
 * places, so a replace of [lo, hi) that touches a hint also removes that
 * hint whole and its partner. One replace over the union span, one hist
 * record; plain replace when no pair is touched or the union exceeds
 * RTX_HL_WIN_MAX. Caret lands after `bytes`. Callers gate on the pane's
 * `rich` — Source panes replace bytes. */
void !>(CCError) RtxDoc_replace_join(RtxDoc *d, size_t lo, size_t hi, char[:] bytes);
int RtxDoc_fold_covers(const RtxDoc *d, size_t off);
size_t RtxDoc_fold_snap(const RtxDoc *d, size_t off, int dir);
int RtxDoc_scope_step(RtxDoc *d, int dir, int invalid);
int RtxDoc_fold_toggle(RtxDoc *d);
void RtxDoc_find_invalidate(RtxDoc *d);
void rtx_find_handle_stop(RtxFind *f);
void rtx_find_scan_wipe(RtxDoc *d);

char[:] !>(CCError) rtx_session_bytes(RtxDoc *d, const char *p, size_t n);
void rtx_hist_clear(RtxHistory *h);
int rtx_doc_add_run(RtxDoc *d, size_t start, size_t len, RtxStyle style,
                    RtxRunPlanter planter);

#include "tm.cch"
#include "edit.cch"

@typehooks on RtxDoc {
    .destroy = RtxDoc_destroy,
};
@typeview on RtxDoc {
    as: tree;
};
typedef @typeview Highlight on RtxDoc {
    r: read_at, scratch_span, style_at, section_at, ensure_hl;
} *RtxDocHighlight;
typedef @typeview Layout on RtxDoc {
    r: len, line_count, line_start, line_guess, index_covers,
       read_at, scratch_span, style_at, style_next, hint_at, mark_at,
       has_marks, hint_next, dest_at, path_at, section_at, ensure_hl,
       fold_covers;
} *RtxDocLayout;

#endif /* RTX_DOCUMENT_H */
