#!ccc ccs
/*
 * Page-store implementation (linked TU; see page_store.cch).
 */
#define _POSIX_C_SOURCE 200809L
#include <ccc/std/prelude.cch>
#include <ccc/cc_runtime.cch>
#include <stdio.h>
#include <stdlib.h>
#include <errno.h>
#include <fcntl.h>
#include <limits.h>
#include <pthread.h>
#include <stdatomic.h>
#include <string.h>
#include <sys/stat.h>
#include <unistd.h>

#include "page_store.cch"

/* mkostemp is outside POSIX 2008, and the lowered unit includes libc
 * headers before any feature macro here could expose it. glibc and
 * Darwin both ship it with this signature. */
#if defined(__linux__) || defined(__APPLE__)
#define RTX_HAVE_MKOSTEMP 1
int mkostemp(char *tmpl, int flags);
#endif

/* ------------------------------------------------------------------
 * Original generation (header comment). The preserved set is an
 * immutable snapshot of sorted, disjoint, merged [lo, hi) spans; a
 * preserve publishes a new one (release) after its bytes are in the
 * preserve file, and keeps the old ones until destroy (a concurrent
 * reader may still hold one). */
typedef struct RtxOrigKeep {
    struct RtxOrigKeep *older;
    size_t n;
    size_t iv[]; /* lo0, hi0, lo1, hi1, ... */
} RtxOrigKeep;

typedef struct RtxOrigFile {
    int fd;              /* the store's orig_fd (not owned here) */
    size_t len;          /* orig_len */
    uint64_t dev, ino;
    size_t disk_len;     /* inode length as the owner last wrote it */
    int pres_fd;         /* -1 until the first preserve */
    _Atomic(RtxOrigKeep *) keep;
    struct RtxOrigFile *next; /* registry */
} RtxOrigFile;

static pthread_mutex_t rtx_orig_mu = PTHREAD_MUTEX_INITIALIZER;
static RtxOrigFile *rtx_orig_list;
static _Atomic size_t rtx_orig_pres_bytes;

size_t rtx_orig_preserved_bytes(void) {
    return atomic_load_explicit(&rtx_orig_pres_bytes, memory_order_relaxed);
}

static RtxOrigKeep *rtx_orig_keep(const RtxOrigFile *of) {
    return of ? atomic_load_explicit(&((RtxOrigFile *)of)->keep, memory_order_acquire)
              : NULL;
}

/* First span in k that ends after `off` (k->n if none). */
static size_t rtx_keep_find(const RtxOrigKeep *k, size_t off) {
    size_t lo = 0, hi = k ? k->n : 0;
    while (lo < hi) {
        size_t mid = lo + (hi - lo) / 2;
        if (k->iv[2 * mid + 1] <= off) lo = mid + 1;
        else hi = mid;
    }
    return lo;
}

static int rtx_keep_overlaps(const RtxOrigKeep *k, size_t lo, size_t hi) {
    size_t i;
    if (!k || lo >= hi) return 0;
    i = rtx_keep_find(k, lo);
    return i < k->n && k->iv[2 * i] < hi;
}

int RtxPageStore_orig_is(const RtxPageStore *s, uint64_t dev, uint64_t ino) {
    return s && s->orig_open && s->of && s->of->dev == dev && s->of->ino == ino;
}

int RtxPageStore_orig_on_disk(const RtxPageStore *s, size_t lo, size_t hi) {
    if (!s || !s->of) return 1;
    return !rtx_keep_overlaps(rtx_orig_keep(s->of), lo, hi);
}

size_t RtxPageStore_disk_len(const RtxPageStore *s) {
    if (!s) return 0;
    return s->of ? s->of->disk_len : s->orig_len;
}

void RtxPageStore_set_disk_len(RtxPageStore *s, size_t n) {
    if (s && s->of) s->of->disk_len = n;
}

static void !>(CCError) rtx_pread_all(int fd, char *dest, size_t n, size_t off) {
    size_t got = 0;
    while (got < n) {
        ssize_t r = pread(fd, dest + got, n - got, (off_t)(off + got));
        if (r < 0) {
            if (errno == EINTR) continue;
            return cc_err(CC_ERR_IO, "pread");
        }
        if (r == 0) return cc_err(CC_ERR_IO, "pread short");
        got += (size_t)r;
    }
    return cc_ok();
}

static void !>(CCError) rtx_pwrite_all(int fd, const char *src, size_t n, size_t off) {
    size_t put = 0;
    while (put < n) {
        ssize_t w = pwrite(fd, src + put, n - put, (off_t)(off + put));
        if (w < 0) {
            if (errno == EINTR) continue;
            return cc_err(CC_ERR_IO, "pwrite preserve");
        }
        if (w == 0) return cc_err(CC_ERR_IO, "pwrite preserve");
        put += (size_t)w;
    }
    return cc_ok();
}

/* Original bytes [off, off + n): preserved spans from the preserve file,
 * the rest from the inode. A span preserved while we read the inode (a
 * save on another document) is read again from the preserve file: the
 * preserve publishes only after its copy, and the write comes after. */
static void !>(CCError) rtx_orig_read(const RtxOrigFile *of, int fd, size_t off,
                                      char *dest, size_t n) {
    size_t at = 0;
    if (!of) return rtx_pread_all(fd, dest, n, off);
    while (at < n) {
        RtxOrigKeep *k = rtx_orig_keep(of);
        size_t pos = off + at, i = rtx_keep_find(k, pos), take;
        if (k && i < k->n && k->iv[2 * i] <= pos) {
            size_t end = k->iv[2 * i + 1];
            take = end - pos < n - at ? end - pos : n - at;
            rtx_pread_all(of->pres_fd, dest + at, take, pos) !>(e) { return cc_err(e); };
        } else {
            size_t next = (k && i < k->n) ? k->iv[2 * i] : (size_t)-1;
            take = next - pos < n - at ? next - pos : n - at;
            rtx_pread_all(fd, dest + at, take, pos) !>(e) { return cc_err(e); };
            if (rtx_orig_keep(of) != k) continue; /* re-route this span */
        }
        at += take;
    }
    return cc_ok();
}

static void rtx_orig_unregister(RtxOrigFile *of) {
    RtxOrigFile **pp;
    RtxOrigKeep *k;
    if (!of) return;
    pthread_mutex_lock(&rtx_orig_mu);
    for (pp = &rtx_orig_list; *pp; pp = &(*pp)->next) {
        if (*pp == of) {
            *pp = of->next;
            break;
        }
    }
    pthread_mutex_unlock(&rtx_orig_mu);
    k = rtx_orig_keep(of);
    while (k) {
        RtxOrigKeep *o = k->older;
        free(k);
        k = o;
    }
    if (of->pres_fd >= 0) close(of->pres_fd);
    free(of);
}

static void !>(CCError) rtx_orig_register(RtxPageStore *s, const struct stat *st) {
    RtxOrigFile *of = (RtxOrigFile *)calloc(1, sizeof(RtxOrigFile));
    if (!of) return cc_err(CC_ERR_OUT_OF_MEMORY, "orig file");
    of->fd = s->orig_fd;
    of->len = s->orig_len;
    of->dev = (uint64_t)st->st_dev;
    of->ino = (uint64_t)st->st_ino;
    of->disk_len = s->orig_len;
    of->pres_fd = -1;
    atomic_store_explicit(&of->keep, (RtxOrigKeep *)NULL, memory_order_relaxed);
    pthread_mutex_lock(&rtx_orig_mu);
    of->next = rtx_orig_list;
    rtx_orig_list = of;
    pthread_mutex_unlock(&rtx_orig_mu);
    s->of = of;
    return cc_ok();
}

static void !>(CCError) rtx_orig_pres_open(RtxOrigFile *of) {
    char path[PATH_MAX];
    const char *dir;
    int n, fd;
    if (of->pres_fd >= 0) return cc_ok();
    dir = getenv("TMPDIR");
    if (!dir || !dir[0]) dir = "/tmp";
    n = snprintf(path, sizeof(path), "%s/cctext-orig-XXXXXX", dir);
    if (n < 0 || n >= (int)sizeof(path)) return cc_err(CC_ERR_IO, "mkstemp orig");
#ifdef RTX_HAVE_MKOSTEMP
    fd = mkostemp(path, O_CLOEXEC);
#else
    fd = mkstemp(path);
    if (fd >= 0) (void)fcntl(fd, F_SETFD, FD_CLOEXEC);
#endif
    if (fd < 0) return cc_err(CC_ERR_IO, "mkstemp orig");
    unlink(path);
    of->pres_fd = fd;
    return cc_ok();
}

/* Copy original [lo, hi) minus what is held into the preserve file, then
 * publish the merged set. Caller holds rtx_orig_mu (one preserver). */
static void !>(CCError) rtx_orig_preserve(RtxOrigFile *of, size_t lo, size_t hi) {
    RtxOrigKeep *k, *nk;
    size_t i, a, n_new, w;
    char *buf = NULL;
    const size_t bufn = (size_t)1 << 20;
    if (hi > of->len) hi = of->len;
    if (lo >= hi) return cc_ok();
    k = rtx_orig_keep(of);
    /* Gaps of [lo, hi) not in k: copy each from the inode. */
    a = lo;
    i = rtx_keep_find(k, lo);
    while (a < hi) {
        size_t gz;
        if (k && i < k->n && k->iv[2 * i] <= a) {
            a = k->iv[2 * i + 1];
            i++;
            continue;
        }
        gz = (k && i < k->n && k->iv[2 * i] < hi) ? k->iv[2 * i] : hi;
        if (!buf) {
            rtx_orig_pres_open(of) !>(e) { return cc_err(e); };
            buf = (char *)malloc(bufn);
            if (!buf) return cc_err(CC_ERR_OUT_OF_MEMORY, "preserve");
        }
        while (a < gz) {
            size_t take = gz - a < bufn ? gz - a : bufn;
            rtx_pread_all(of->fd, buf, take, a) !>(e) {
                free(buf);
                return cc_err(e);
            };
            rtx_pwrite_all(of->pres_fd, buf, take, a) !>(e) {
                free(buf);
                return cc_err(e);
            };
            atomic_fetch_add_explicit(&rtx_orig_pres_bytes, take, memory_order_relaxed);
            a += take;
        }
    }
    if (!buf) return cc_ok(); /* all held already */
    free(buf);
    /* Merge [lo, hi) into k. */
    n_new = (k ? k->n : 0) + 1;
    nk = (RtxOrigKeep *)malloc(sizeof(RtxOrigKeep) + 2 * n_new * sizeof(size_t));
    if (!nk) return cc_err(CC_ERR_OUT_OF_MEMORY, "preserve");
    w = 0;
    {
        size_t clo = lo, chi = hi;
        int placed = 0;
        for (i = 0; k && i < k->n; i++) {
            size_t slo = k->iv[2 * i], shi = k->iv[2 * i + 1];
            if (shi < clo) {
                nk->iv[2 * w] = slo;
                nk->iv[2 * w + 1] = shi;
                w++;
            } else if (slo > chi) {
                if (!placed) {
                    nk->iv[2 * w] = clo;
                    nk->iv[2 * w + 1] = chi;
                    w++;
                    placed = 1;
                }
                nk->iv[2 * w] = slo;
                nk->iv[2 * w + 1] = shi;
                w++;
            } else {
                if (slo < clo) clo = slo;
                if (shi > chi) chi = shi;
            }
        }
        if (!placed) {
            nk->iv[2 * w] = clo;
            nk->iv[2 * w + 1] = chi;
            w++;
        }
    }
    nk->n = w;
    nk->older = k;
    atomic_store_explicit(&of->keep, nk, memory_order_release);
    return cc_ok();
}

void !>(CCError) rtx_orig_preserve_inode(uint64_t dev, uint64_t ino, size_t lo,
                                         size_t hi) {
    RtxOrigFile *of;
    pthread_mutex_lock(&rtx_orig_mu);
    for (of = rtx_orig_list; of; of = of->next) {
        if (of->dev != dev || of->ino != ino) continue;
        rtx_orig_preserve(of, lo, hi) !>(e) {
            pthread_mutex_unlock(&rtx_orig_mu);
            return cc_err(e);
        };
    }
    pthread_mutex_unlock(&rtx_orig_mu);
    return cc_ok();
}

void !>(CCError) rtx_orig_preserve_path(const char *path, size_t lo, size_t hi) {
    struct stat st;
    if (!path || stat(path, &st) != 0) return cc_ok();
    return rtx_orig_preserve_inode((uint64_t)st.st_dev, (uint64_t)st.st_ino, lo, hi);
}

static void rtx_page_lru_unlink(RtxPageStore *s, size_t i) {
    RtxPageSlot *p = &s->slots[i];
    if (p->lru_prev == (size_t)-1) s->lru_head = p->lru_next;
    else s->slots[p->lru_prev].lru_next = p->lru_next;
    if (p->lru_next == (size_t)-1) s->lru_tail = p->lru_prev;
    else s->slots[p->lru_next].lru_prev = p->lru_prev;
    p->lru_prev = (size_t)-1;
    p->lru_next = (size_t)-1;
}

static void rtx_page_lru_push_head(RtxPageStore *s, size_t i) {
    RtxPageSlot *p = &s->slots[i];
    p->lru_prev = (size_t)-1;
    p->lru_next = s->lru_head;
    if (s->lru_head == (size_t)-1) s->lru_tail = i;
    else s->slots[s->lru_head].lru_prev = i;
    s->lru_head = i;
}

static void rtx_page_lru_touch(RtxPageStore *s, size_t i) {
    if (s->lru_head == i) return;
    rtx_page_lru_unlink(s, i);
    rtx_page_lru_push_head(s, i);
}

static void !>(CCError) rtx_page_store_ensure_slots(RtxPageStore *s) {
    size_t i;
    if (!s) return cc_err(CC_ERR_INVALID_ARG, "null store");
    if (s->slots) return cc_ok();
    if (!s->arena.base) {
        /* Fixed L1 + per-page overflow. heap() grows 1.5× slabs and
         * over-commits (~2 MiB) to hold a 1 MiB jump. */
        s->arena = cc_arena_malloc(kilobytes(256));
        if (!s->arena.base) return cc_err(CC_ERR_OUT_OF_MEMORY, "page arena");
    }
    s->slot_n = RTX_PAGE_CACHE_DEFAULT;
    s->slots = (RtxPageSlot *)cc_arena_alloc(s->arena, s->slot_n * sizeof(RtxPageSlot), 8);
    if (!s->slots) return cc_err(CC_ERR_OUT_OF_MEMORY, "page slots");
    s->lru_head = (size_t)-1;
    s->lru_tail = (size_t)-1;
    for (i = 0; i < s->slot_n; i++) {
        s->slots[i] = (RtxPageSlot){0};
        s->slots[i].file_id = -1;
        s->slots[i].lru_prev = (size_t)-1;
        s->slots[i].lru_next = (size_t)-1;
        rtx_page_lru_push_head(s, i);
    }
    s->slots_linked = 1;
    return cc_ok();
}

static int rtx_page_fd(const RtxPageStore *s, RtxStoreFile f) {
    if (f == RTX_STORE_ORIG) return s->orig_fd;
    return s->add_fd;
}

static size_t rtx_page_file_len(const RtxPageStore *s, RtxStoreFile f) {
    if (f == RTX_STORE_ORIG) return s->orig_len;
    return s->add_len;
}

static void !>(CCError) rtx_page_store_ensure_add(RtxPageStore *s) {
    char path[PATH_MAX];
    const char *dir;
    int n;
    int fd;
    if (!s) return cc_err(CC_ERR_INVALID_ARG, "null store");
    if (s->add_open) return cc_ok();
    dir = getenv("TMPDIR");
    if (!dir || !dir[0]) dir = "/tmp";
    n = snprintf(path, sizeof(path), "%s/cctext-add-XXXXXX", dir);
    if (n < 0 || n >= (int)sizeof(path))
        return cc_err(CC_ERR_IO, "mkstemp add");
    /* Not inherited by a child the host spawns (browse du / open). */
#ifdef RTX_HAVE_MKOSTEMP
    fd = mkostemp(path, O_CLOEXEC);
    if (fd < 0) return cc_err(CC_ERR_IO, "mkstemp add");
#else
    fd = mkstemp(path);
    if (fd < 0) return cc_err(CC_ERR_IO, "mkstemp add");
    (void)fcntl(fd, F_SETFD, FD_CLOEXEC);
#endif
    unlink(path);
    s->add_fd = fd;
    s->add_open = 1;
    s->add_len = 0;
    return cc_ok();
}

static char rtx_store_err[160];

static const char *rtx_store_err_path(const char *what, const char *path) {
    if (path && path[0]) {
        snprintf(rtx_store_err, sizeof rtx_store_err, "%s: %s", what, path);
    } else {
        snprintf(rtx_store_err, sizeof rtx_store_err, "%s", what);
    }
    return rtx_store_err;
}

void !>(CCError) RtxPageStore_open_original(RtxPageStore *s, char[:0] path) {
    struct stat st;
    int fd;
    const char *p;
    if (!s) return cc_err(CC_ERR_INVALID_ARG, "null store");
    if (rtx_page_store_is_open(s)) return cc_err(CC_ERR_INVALID_ARG, "store already open");
    if (!path.ptr || path.len == 0) return cc_err(CC_ERR_INVALID_ARG, "empty path");
    p = path.ptr;
    /* O_NONBLOCK so a FIFO (browse preview walks onto one) cannot park the
     * UI thread in open() waiting for a writer. Only regular files are a
     * document; the flag comes off again before any read. */
    fd = open(p, O_RDONLY | O_NONBLOCK | O_CLOEXEC);
    if (fd < 0) {
        if (errno == ENOENT) {
            return cc_err(CC_ERR_NOT_FOUND,
                          rtx_store_err_path("file not found", p));
        }
        if (errno == EACCES || errno == EPERM) {
            return cc_err(CC_ERR_PERMISSION,
                          rtx_store_err_path("permission denied", p));
        }
        return cc_err(CC_ERR_IO, rtx_store_err_path("cannot open file", p));
    }
    if (fstat(fd, &st) != 0) {
        close(fd);
        return cc_err(CC_ERR_IO, rtx_store_err_path("cannot stat file", p));
    }
    if (!S_ISREG(st.st_mode)) {
        close(fd);
        return cc_err(CC_ERR_INVALID_ARG,
                      rtx_store_err_path(S_ISDIR(st.st_mode) ? "is a directory"
                                                             : "not a regular file",
                                         p));
    }
    if (st.st_size < 0) {
        close(fd);
        return cc_err(CC_ERR_IO, "negative size");
    }
    {
        int fl = fcntl(fd, F_GETFL);
        if (fl < 0 || fcntl(fd, F_SETFL, fl & ~O_NONBLOCK) != 0) {
            close(fd);
            return cc_err(CC_ERR_IO, rtx_store_err_path("cannot open file", p));
        }
    }
    s->orig_fd = fd;
    s->orig_open = 1;
    s->orig_len = (size_t)st.st_size;
    rtx_orig_register(s, &st) !>(e) {
        close(fd);
        rtx_page_store_zero(s);
        return cc_err(e);
    };
    return cc_ok();
}

void RtxPageStore_destroy(RtxPageStore *s) {
    if (!s) return;
    rtx_orig_unregister(s->of);
    s->of = NULL;
    if (s->orig_open) close(s->orig_fd);
    if (s->add_open) close(s->add_fd);
    if (s->arena.base) s->arena.destroy();
    rtx_page_store_zero(s);
}

static void !>(CCError) rtx_page_load(RtxPageStore *s, size_t i, RtxStoreFile f,
                                     size_t page_index) {
    RtxPageSlot *slot;
    size_t file_len = rtx_page_file_len(s, f);
    size_t off = page_index * (size_t)RTX_PAGE_SIZE;
    size_t want;
    int fd = rtx_page_fd(s, f);
    size_t got = 0;
    if (fd < 0) return cc_err(CC_ERR_IO, "page load fd");
    if (off > file_len) return cc_err(CC_ERR_INTERNAL, "page past eof");
    want = file_len - off;
    if (want > (size_t)RTX_PAGE_SIZE) want = (size_t)RTX_PAGE_SIZE;
    slot = &s->slots[i];
    if (!slot->bytes) {
        slot->bytes = (char *)cc_arena_alloc(s->arena, (size_t)RTX_PAGE_SIZE, 8);
        if (!slot->bytes) return cc_err(CC_ERR_OUT_OF_MEMORY, "page body");
    }
    /* The pread below overwrites the victim's bytes. Drop its identity
     * first: a failed or short read must leave an empty slot, not the
     * old page name over the new page's bytes. */
    slot->file_id = -1;
    slot->valid = 0;
    if (f == RTX_STORE_ORIG && s->of) {
        rtx_orig_read(s->of, fd, off, slot->bytes, want) !>(e) { return cc_err(e); };
        got = want;
    }
    while (got < want) {
        ssize_t r = pread(fd, slot->bytes + got, want - got, (off_t)(off + got));
        if (r < 0) {
            if (errno == EINTR) continue;
            return cc_err(CC_ERR_IO, "pread");
        }
        if (r == 0) return cc_err(CC_ERR_IO, "pread short");
        got += (size_t)r;
    }
    slot->file_id = (int)f;
    slot->page_index = page_index;
    slot->valid = want;
    return cc_ok();
}

static size_t !>(CCError) rtx_page_get(RtxPageStore *s, RtxStoreFile f, size_t page_index) {
    size_t i;
    size_t victim;
    rtx_page_store_ensure_slots(s) !>(e) { return cc_err(e); };
    for (i = 0; i < s->slot_n; i++) {
        if (s->slots[i].file_id == (int)f && s->slots[i].page_index == page_index &&
            s->slots[i].bytes) {
            rtx_page_lru_touch(s, i);
            return cc_ok(i);
        }
    }
    victim = s->lru_tail;
    if (victim == (size_t)-1) return cc_err(CC_ERR_INTERNAL, "empty lru");
    rtx_page_load(s, victim, f, page_index) !>(e) { return cc_err(e); };
    rtx_page_lru_touch(s, victim);
    return cc_ok(victim);
}

void !>(CCError) RtxPageStore_read(RtxPageStore *s, RtxStoreFile f, size_t off,
                                   char *dest, size_t n) {
    size_t file_len;
    size_t got = 0;
    if (!s || !dest) return cc_err(CC_ERR_INVALID_ARG, "page read");
    if (n == 0) return cc_ok();
    if (f == RTX_STORE_ORIG && !s->orig_open) {
        return cc_err(CC_ERR_INVALID_ARG, "no original");
    }
    if (f == RTX_STORE_ADD && !s->add_open) {
        return cc_err(CC_ERR_INVALID_ARG, "no add file");
    }
    file_len = rtx_page_file_len(s, f);
    if (off > file_len || n > file_len - off) {
        return cc_err(CC_ERR_INTERNAL, "page read range");
    }
    while (got < n) {
        size_t abs = off + got;
        size_t page_index = abs / (size_t)RTX_PAGE_SIZE;
        size_t local = abs % (size_t)RTX_PAGE_SIZE;
        size_t slot_i;
        size_t take;
        RtxPageSlot *slot;
        slot_i = rtx_page_get(s, f, page_index) !>(e) { return cc_err(e); };
        slot = &s->slots[slot_i];
        if (local >= slot->valid) return cc_err(CC_ERR_INTERNAL, "page hole");
        take = slot->valid - local;
        if (take > n - got) take = n - got;
        {
            char[:] dst = cc_slice_from_buffer(dest + got, take);
            char[:] src = cc_slice_from_buffer(slot->bytes + local, take);
            dst.copy(src) !>(e) { return cc_err(e); };
        }
        got += take;
    }
    return cc_ok();
}

void !>(CCError) RtxPageStore_pread(const RtxPageStore *s, RtxStoreFile f,
                                    size_t off, char *dest, size_t n) {
    int fd;
    size_t file_len;
    size_t got = 0;
    if (!s || !dest) return cc_err(CC_ERR_INVALID_ARG, "page pread");
    if (n == 0) return cc_ok();
    if (f == RTX_STORE_ORIG && !s->orig_open) {
        return cc_err(CC_ERR_INVALID_ARG, "no original");
    }
    if (f == RTX_STORE_ADD && !s->add_open) {
        return cc_err(CC_ERR_INVALID_ARG, "no add file");
    }
    fd = rtx_page_fd(s, f);
    if (fd < 0) return cc_err(CC_ERR_IO, "page pread fd");
    file_len = rtx_page_file_len(s, f);
    if (off > file_len || n > file_len - off) {
        return cc_err(CC_ERR_INTERNAL, "page pread range");
    }
    cc_external_wait_enter();
    @defer cc_external_wait_leave();
    if (f == RTX_STORE_ORIG && s->of) return rtx_orig_read(s->of, fd, off, dest, n);
    while (got < n) {
        ssize_t r = pread(fd, dest + got, n - got, (off_t)(off + got));
        if (r < 0) {
            if (errno == EINTR) continue;
            return cc_err(CC_ERR_IO, "pread");
        }
        if (r == 0) return cc_err(CC_ERR_IO, "pread short");
        got += (size_t)r;
    }
    return cc_ok();
}

size_t !>(CCError) RtxPageStore_append_add(RtxPageStore *s, const char *src, size_t n) {
    size_t start;
    size_t wrote = 0;
    if (!s) return cc_err(CC_ERR_INVALID_ARG, "null store");
    if (n == 0) {
        return cc_ok(s->add_len);
    }
    if (!src) return cc_err(CC_ERR_INVALID_ARG, "null append");
    rtx_page_store_ensure_add(s) !>(e) { return cc_err(e); };
    start = s->add_len;
    while (wrote < n) {
        ssize_t w = pwrite(s->add_fd, src + wrote, n - wrote, (off_t)(start + wrote));
        if (w < 0) {
            if (errno == EINTR) continue;
            return cc_err(CC_ERR_IO, "pwrite add");
        }
        if (w == 0) return cc_err(CC_ERR_IO, "pwrite add");
        wrote += (size_t)w;
    }
    s->add_len = start + n;
    if (s->slots) {
        size_t first = start / (size_t)RTX_PAGE_SIZE;
        size_t last = (start + n - 1) / (size_t)RTX_PAGE_SIZE;
        size_t i;
        for (i = 0; i < s->slot_n; i++) {
            if (s->slots[i].file_id == (int)RTX_STORE_ADD &&
                s->slots[i].page_index >= first && s->slots[i].page_index <= last) {
                s->slots[i].file_id = -1;
                s->slots[i].valid = 0;
            }
        }
    }
    return cc_ok(start);
}

void !>(CCError) RtxPageStore_stage_add(RtxPageStore *s, size_t rel, const char *src,
                                        size_t n) {
    size_t at;
    size_t wrote = 0;
    if (!s) return cc_err(CC_ERR_INVALID_ARG, "null store");
    if (n == 0) return cc_ok();
    if (!src) return cc_err(CC_ERR_INVALID_ARG, "null stage");
    rtx_page_store_ensure_add(s) !>(e) { return cc_err(e); };
    at = s->add_len + rel;
    if (at < s->add_len || at + n < at) return cc_err(CC_ERR_INVALID_ARG, "stage range");
    while (wrote < n) {
        ssize_t w = pwrite(s->add_fd, src + wrote, n - wrote, (off_t)(at + wrote));
        if (w < 0) {
            if (errno == EINTR) continue;
            return cc_err(CC_ERR_IO, "pwrite add");
        }
        if (w == 0) return cc_err(CC_ERR_IO, "pwrite add");
        wrote += (size_t)w;
    }
    return cc_ok();
}

void RtxPageStore_commit_add(RtxPageStore *s, size_t n) {
    size_t start;
    if (!s || n == 0) return;
    start = s->add_len;
    s->add_len = start + n;
    if (s->slots) {
        /* The last published page may be cached short: drop every page
         * the staged bytes reach. */
        size_t first = start / (size_t)RTX_PAGE_SIZE;
        size_t last = (start + n - 1) / (size_t)RTX_PAGE_SIZE;
        size_t i;
        for (i = 0; i < s->slot_n; i++) {
            if (s->slots[i].file_id == (int)RTX_STORE_ADD &&
                s->slots[i].page_index >= first && s->slots[i].page_index <= last) {
                s->slots[i].file_id = -1;
                s->slots[i].valid = 0;
            }
        }
    }
}
