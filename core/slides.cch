#!ccc cch
/*
 * Marp slides (docs/slides.md): the deck index, directives, one slide as
 * styled lines, and the presenter (steps, transitions). Bodies in
 * slides.ccs (linked into the rtx_document target).
 *
 * Bytes are truth. A deck is a view over the document: `marp: true` in
 * the front matter (RtxDoc_marp) turns the Markdown block pass's
 * top-level thematic breaks into slide boundaries (RTX_MDB_S_SLIDE); the
 * deck index is that block pass over a bounded prefix (RTX_DECK_SCAN_MAX)
 * keyed by the document's edit stamp, rebuilt when it moves. Nothing is
 * stored in the file; nothing here is a second document.
 *
 * The presenter is host-neutral: which slide / step is shown, the
 * transition in flight and its eased progress. The hosts lay the slide's
 * lines out (pixels in cctext-ui, cells in cctext) and paint.
 */
#ifndef RTX_SLIDES_H
#define RTX_SLIDES_H

#include <stddef.h>
#include <stdint.h>
#include "document.cch"

/* The deck index reads at most this prefix (a deck past it is indexed up
 * to here; later slides are unknown, never guessed). */
#define RTX_DECK_SCAN_MAX (8u << 20)
#define RTX_DECK_SLIDES_MAX 4096
/* Past this size the status bar does not re-index a changed deck on
 * every paint: it shows the last index as `slide ~N/M`. */
#define RTX_DECK_STATUS_MAX (1u << 20)
/* One slide's bytes a view copies and lexes (RTX_HL_WIN_MAX). */
#define RTX_SLIDE_BYTES_MAX RTX_HL_WIN_MAX

/* Transitions (Marp `transition` directive names; docs/slides.md). */
enum {
    RTX_TR_NONE = 0,
    RTX_TR_FADE,      /* cross-fade */
    RTX_TR_FADE_OUT,  /* old fades out, then new fades in */
    RTX_TR_SLIDE,     /* new slides in over the old, old slides out too */
    RTX_TR_PUSH,      /* new pushes the old out (same direction) */
    RTX_TR_COVER,     /* new slides in over the still old */
    RTX_TR_REVEAL,    /* old slides away, uncovering the still new */
    RTX_TR_WIPE,      /* new is revealed left to right */
    RTX_TR_ZOOM,      /* new grows from the centre while fading in */
    RTX_TR_MORPH,     /* matched elements move / resize (magic move);
                       * the rest cross-fades */
    RTX_TR_FRAG,      /* internal: a fragment appears (fade in) */
    RTX_TR__N
};

/* Resolved directives of one slide. */
typedef struct {
    unsigned char paginate;  /* show the page number */
    unsigned char bg_set;
    unsigned char fg_set;
    unsigned char lead;      /* class lead: content centred */
    unsigned char invert;    /* class invert: dark palette */
    unsigned char trans;     /* RTX_TR_* into this slide */
    unsigned short trans_ms;
    uint32_t bg;             /* 0xRRGGBB */
    uint32_t fg;
    char cls[32];
    char header[96];
    char footer[96];
} RtxSlideDir;

typedef struct {
    size_t sep;              /* separator line start (0 for the first) */
    size_t lo, hi;           /* body [lo, hi): after the separator line, up to
                              * the next separator line */
    size_t title_lo, title_hi; /* first heading (else first text line) */
    int nfrag;               /* fragmented list items (build steps) */
    int page;                /* page number shown (paginate skip / hold) */
    RtxSlideDir dir;
    unsigned char nbg;       /* `![bg …](…)` background images */
    unsigned char bg_side;   /* 0 whole slide, 1 left, 2 right (split) */
    unsigned char bg_pct;    /* split: image share of the width (%) */
    unsigned char bg_fit;    /* 0 cover, 1 contain / fit, 2 auto */
    size_t bg_src_lo, bg_src_hi; /* first bg image url bytes */
} RtxSlide;

typedef struct {
    const void *doc;         /* key: document, edit stamp, length */
    size_t gen;
    size_t len;
    int marp;                /* front matter holds `marp: true` */
    int complete;            /* the whole document was indexed */
    size_t scanned;          /* bytes the index read */
    RtxSlide *s;
    size_t n;
    size_t cap;
    char theme[24];          /* default / gaia / uncover (as written) */
    int w, h;                /* slide size in CSS px: 1280x720 (16:9) or
                              * 960x720 (4:3) */
    int hdiv;                /* headingDivider: split before h1..hN, 0 off */
    unsigned hdiv_mask;      /* array form: bit L = split before hL */
} RtxDeck;

/* Index `n` bytes (the document's first bytes; `complete` when that is
 * the whole document). Pure: the smoke feeds it strings. */
void rtx_deck_build(RtxDeck *k, const char *b, size_t n, int complete);
void rtx_deck_free(RtxDeck *k);
/* Slide holding byte `off` (a separator line belongs to the slide it
 * opens), or -1 when not a deck / past the index. */
int rtx_deck_slide_of(const RtxDeck *k, size_t off);

/* The deck of this document, from a one-entry cache keyed by the edit
 * stamp (rebuilt on change). NULL when the document is not a Marp deck.
 * UI thread only. */
const RtxDeck *rtx_deck_for(RtxDoc *d);
/* "slide 3/12" ("slide 3/12+" when the index stopped before EOF; "slide
 * ~3/12" from the last index of a deck over RTX_DECK_STATUS_MAX that has
 * changed since). 0 when not a deck. */
size_t rtx_slides_status(RtxDoc *d, size_t off, char *dst, size_t n);
/* Outline: one entry per slide (level 1, title bytes, slide start).
 * Returns the count written. */
size_t rtx_deck_outline(RtxDoc *d, RtxOutlineEnt *out, size_t cap);
/* Byte to put the caret on for slide `k` (0-based): its first content
 * line. (size_t)-1 when there is no such slide. */
size_t rtx_deck_slide_caret(RtxDoc *d, int k);

/* Palette of a slide: theme, class (invert / lead) and the
 * backgroundColor / color directives. */
typedef struct {
    uint32_t bg, fg, head, accent, code_bg, dim;
    int center;              /* lead / uncover: centre the content */
} RtxSlideTheme;
RtxSlideTheme rtx_slide_theme(const RtxDeck *k, const RtxSlide *s);

/* Transition name ("fade", "slide 0.5s", …) → RTX_TR_* and ms. Unknown
 * names fall back to fade (docs/slides.md). */
int rtx_slide_transition(const char *s, size_t n, int *ms);
/* CSS colour (#rgb, #rrggbb, a basic name) → 0xRRGGBB. 0 = not a colour. */
int rtx_slide_color(const char *s, size_t n, uint32_t *out);

/* ---- one slide as lines ------------------------------------------------ */

enum {
    RTX_SL_BLANK = 0,
    RTX_SL_PARA,     /* a paragraph line (Marp: every newline breaks) */
    RTX_SL_HEAD,     /* level 1-6 */
    RTX_SL_ITEM,     /* list item first line: marker, level = depth */
    RTX_SL_CODE,     /* fence / indented code / math line */
    RTX_SL_ROW,      /* table row: segments carry the cell index */
    RTX_SL_HR,
    RTX_SL_IMAGE     /* content image: alt / src in the segments */
};

typedef struct {
    size_t lo, hi;           /* document bytes (text[lo - base]) */
    RtxStyle st;
    unsigned char cell;      /* table cell */
    unsigned char link;      /* link text */
} RtxSlSeg;

typedef struct {
    unsigned char kind;      /* RTX_SL_* */
    unsigned char level;     /* heading level, list depth (1..), code: 0 */
    unsigned char quote;     /* block quote depth */
    unsigned char frag;      /* 0 always shown; k: shown from step k */
    unsigned char indent;    /* list continuation depth (no marker) */
    unsigned char header;    /* table header row */
    unsigned char ncells;
    unsigned char ordered;
    char marker[12];         /* "•", "3." */
    unsigned seg0, nseg;
    size_t lo;               /* line start in the document */
} RtxSlLine;

typedef struct {
    int slide;
    size_t gen;              /* document edit stamp it was built at */
    char *text;              /* slide bytes [base, base + tlen) */
    size_t base, tlen;
    RtxSlLine *lines;
    size_t nl, lcap;
    RtxSlSeg *segs;
    size_t ns, scap;
    int nfrag;
    unsigned char talign[16]; /* table column alignment (RTX_MD_ALIGN_*) */
} RtxSlideView;

/* Build slide `k` of `d`'s deck into v (lexes the slide's bytes so the
 * segments carry the grammar's styles; hints and link destinations are
 * dropped, as in Rich). 0 = no such slide. */
int rtx_slide_view(RtxDoc *d, int k, RtxSlideView *v);
void rtx_slide_view_free(RtxSlideView *v);
/* Plain text of a line's segments into dst (UTF-8, NUL-terminated). */
size_t rtx_sl_line_text(const RtxSlideView *v, const RtxSlLine *l, char *dst,
                        size_t n);

/* ---- presenter ---------------------------------------------------------- */

typedef struct {
    int on;
    int slide, step;         /* shown */
    int from_slide, from_step; /* animation source */
    int tr;                  /* RTX_TR_* in flight, 0 = idle */
    int dir;                 /* +1 forward, -1 back */
    long t0;                 /* ms the transition started */
    int ms;                  /* its duration */
    char num[8];             /* typed slide number (Enter goes) */
    size_t num_len;
    long frames;             /* animation frames painted (tests) */
    char msg[96];            /* why start refused */
} RtxPresent;

enum {
    RTX_PK_NONE = 0,         /* key not used */
    RTX_PK_SAME = 1,         /* used, nothing moved (typed digit) */
    RTX_PK_MOVE = 2,         /* slide / step changed: repaint */
    RTX_PK_EXIT = 3          /* leave presentation */
};

#define RTX_TR_DEFAULT_MS 300
#define RTX_TR_FRAG_MS 200
#define RTX_PRESENT_FRAME_MS 16

/* The process's presenter (hosts have one window). */
RtxPresent *rtx_present(void);
/* Start at the slide holding `caret`, step 0. 0 = not a deck (p->msg). */
int rtx_present_start(RtxPresent *p, RtxDoc *d, size_t caret, long now);
/* Stop; returns the caret for the slide shown (its first content line). */
size_t rtx_present_stop(RtxPresent *p, RtxDoc *d);
/* Navigation. `key` is an RTX_KEY_* (cmd.cch) or 0 with `ch` a character:
 * Right / Down / PgDn / Space / Enter(no number) / n  next step;
 * Left / Up / PgUp / Backspace / p  previous step; Home / End; digits then
 * Enter  go to that slide; Esc / q  exit. */
int rtx_present_key(RtxPresent *p, RtxDoc *d, int key, int ch, long now);
int rtx_present_next(RtxPresent *p, RtxDoc *d, long now);
int rtx_present_prev(RtxPresent *p, RtxDoc *d, long now);
int rtx_present_goto(RtxPresent *p, RtxDoc *d, int slide, int step, long now);
/* Transition progress 0..1 (linear), 1 when idle. */
double rtx_present_t(const RtxPresent *p, long now);
/* Ease in-out (cubic). */
double rtx_ease(double t);
/* After a paint: ends a finished transition. 1 = still animating (paint
 * again in RTX_PRESENT_FRAME_MS). */
int rtx_present_tick(RtxPresent *p, long now);
/* ms until the next animation frame, -1 when idle (the host sleeps until
 * input: no timer while a slide just sits there). */
long rtx_present_wait_ms(const RtxPresent *p, long now);

#endif
