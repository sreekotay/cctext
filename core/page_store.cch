#!ccc cch
/*
 * Document-epoch page cache (original fd + spilled add temp file).
 *
 * Types + API here; bodies live in page_store.ccs (linked TU).
 * Cache pool lives on a store-local arena (LRU reuses slot bodies; nothing
 * is freed per eviction). destroy() ends the arena with the store.
 */
#ifndef RTX_PAGE_STORE_H
#define RTX_PAGE_STORE_H

#include <ccc/std/prelude.cch>

#define RTX_PAGE_SIZE (64 * 1024)
#define RTX_PAGE_CACHE_DEFAULT 256

typedef enum {
    RTX_STORE_ORIG = 0,
    RTX_STORE_ADD = 1,
} RtxStoreFile;

typedef struct {
    int file_id; /* -1 = empty slot; else RtxStoreFile */
    size_t page_index;
    char *bytes;
    size_t valid; /* valid prefix length in bytes[] */
    size_t lru_prev;
    size_t lru_next;
} RtxPageSlot;

typedef struct {
    int orig_fd; /* meaningful only if orig_open */
    int orig_open;
    size_t orig_len;
    int add_fd; /* meaningful only if add_open */
    int add_open;
    size_t add_len;
    CCArena arena; /* slots + page bodies; store epoch */
    RtxPageSlot *slots;
    size_t slot_n;
    size_t lru_head; /* MRU */
    size_t lru_tail; /* LRU */
    int slots_linked;
} RtxPageStore;

static inline void rtx_page_store_zero(RtxPageStore *s) {
    if (!s) return;
    *s = (RtxPageStore){0};
    s->orig_fd = -1;
    s->add_fd = -1;
}

static inline int rtx_page_store_is_open(const RtxPageStore *s) {
    return s && (s->orig_open || s->add_open);
}

void !>(CCError) RtxPageStore_open_original(RtxPageStore *s, const char *path);
void RtxPageStore_destroy(RtxPageStore *s);
void !>(CCError) RtxPageStore_read(RtxPageStore *s, RtxStoreFile f, size_t off,
                                   char *dest, size_t n);
/* Cache-free pread. Safe for concurrent readers (no LRU). */
void !>(CCError) RtxPageStore_pread(const RtxPageStore *s, RtxStoreFile f,
                                    size_t off, char *dest, size_t n);
size_t !>(CCError) RtxPageStore_append_add(RtxPageStore *s, const char *src,
                                            size_t n);

@typehooks on RtxPageStore {
    .destroy = RtxPageStore_destroy,
};

#endif /* RTX_PAGE_STORE_H */
