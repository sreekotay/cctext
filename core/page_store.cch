#!ccc cch
/*
 * Document-epoch page cache (original fd + spilled add temp file).
 * The add file is mkstemp under $TMPDIR (else /tmp), then unlinked.
 *
 * Types + API here; bodies live in page_store.ccs (linked TU).
 * Cache pool lives on a store-local arena (LRU reuses slot bodies; nothing
 * is freed per eviction). destroy() ends the arena with the store.
 *
 * The original is an immutable generation (DESIGN Edits, save): every
 * ORIGINAL ref the tree and history hold keeps its bytes while the doc
 * lives. A write through the opened inode (a --backup save, a save-as
 * onto a hard link, another document's save onto this file) first copies
 * the original bytes it is about to change into this store's private
 * preserve file (unlinked temp, disk-backed, same offsets, sparse); reads
 * of those offsets go there from then on. Every open original is in a
 * process-wide registry keyed by (dev, ino) so a save through any path
 * preserves for every document on that inode.
 */
#ifndef RTX_PAGE_STORE_H
#define RTX_PAGE_STORE_H

#include <ccc/std/prelude.cch>

#define RTX_PAGE_SIZE (64 * 1024)
#define RTX_PAGE_CACHE_DEFAULT 256

typedef enum {
    RTX_STORE_ORIG = 0,
    RTX_STORE_ADD = 1,
} RtxStoreFile;

typedef struct {
    int file_id; /* -1 = empty slot; else RtxStoreFile */
    size_t page_index;
    char *bytes;
    size_t valid; /* valid prefix length in bytes[] */
    size_t lru_prev;
    size_t lru_next;
} RtxPageSlot;

struct RtxOrigFile;

typedef struct {
    int orig_fd; /* meaningful only if orig_open */
    int orig_open;
    size_t orig_len;
    struct RtxOrigFile *of; /* heap; identity + preserved spans (registry) */
    int add_fd; /* meaningful only if add_open */
    int add_open;
    size_t add_len;
    CCArena arena; /* slots + page bodies; store epoch */
    RtxPageSlot *slots;
    size_t slot_n;
    size_t lru_head; /* MRU */
    size_t lru_tail; /* LRU */
    int slots_linked;
} RtxPageStore;

static inline void rtx_page_store_zero(RtxPageStore *s) {
    if (!s) return;
    *s = (RtxPageStore){0};
    s->orig_fd = -1;
    s->add_fd = -1;
}

static inline int rtx_page_store_is_open(const RtxPageStore *s) {
    return s && (s->orig_open || s->add_open);
}

void !>(CCError) RtxPageStore_open_original(RtxPageStore *s, char[:0] path);
/* Same-inode writes (see the header comment). */
/* 1 if s's original is inode (dev, ino). */
int RtxPageStore_orig_is(const RtxPageStore *s, uint64_t dev, uint64_t ino);
/* 1 if original bytes [lo, hi) still sit on the inode (none preserved):
 * the inode and the original agree there. In-memory / no original: 1. */
int RtxPageStore_orig_on_disk(const RtxPageStore *s, size_t lo, size_t hi);
/* Inode length as this store last wrote it (orig_len at open). */
size_t RtxPageStore_disk_len(const RtxPageStore *s);
void RtxPageStore_set_disk_len(RtxPageStore *s, size_t n);
/* Before changing inode (dev, ino) bytes [lo, hi) — hi (size_t)-1: to the
 * end, truncation included — every open store whose original is that
 * inode preserves the original bytes there it does not hold yet. A
 * failure changes nothing on the inode (the caller must not write). */
void !>(CCError) rtx_orig_preserve_inode(uint64_t dev, uint64_t ino, size_t lo,
                                         size_t hi);
/* Same, for whatever inode `path` names now (no-op if missing / not an
 * open original). */
void !>(CCError) rtx_orig_preserve_path(const char *path, size_t lo, size_t hi);
/* Bytes copied to preserve files so far (smokes / perf). */
size_t rtx_orig_preserved_bytes(void);
void RtxPageStore_destroy(RtxPageStore *s);
void !>(CCError) RtxPageStore_read(RtxPageStore *s, RtxStoreFile f, size_t off,
                                   char *dest, size_t n);
/* Cache-free pread. Safe for concurrent readers (no LRU). */
void !>(CCError) RtxPageStore_pread(const RtxPageStore *s, RtxStoreFile f,
                                    size_t off, char *dest, size_t n);
size_t !>(CCError) RtxPageStore_append_add(RtxPageStore *s, const char *src,
                                            size_t n);
/* Write `n` bytes at add_len + rel without publishing them: add_len (what
 * readers may read) stays until commit_add. A bulk edit group stages its
 * one contiguous append while find lanes still read the add file. */
void !>(CCError) RtxPageStore_stage_add(RtxPageStore *s, size_t rel, const char *src,
                                        size_t n);
/* Publish `n` staged bytes (add_len += n). Joined readers only. */
void RtxPageStore_commit_add(RtxPageStore *s, size_t n);

@typehooks on RtxPageStore {
    .destroy = RtxPageStore_destroy,
};

#endif /* RTX_PAGE_STORE_H */
