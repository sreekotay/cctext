/* A Mermaid file's picture (docs/images.md "Mermaid files"), for both
 * frontends' viewers and browse previews. Bodies in mmd_view.ccs
 * (linked with layout.ccs in rtx_layout).
 *
 * A `.mermaid` file (or a `.mmd` whose first word is a diagram keyword;
 * RtxDoc_is_mermaid) is text in the editor; Ctrl-D swaps in its diagram,
 * as an `.svg` swaps in its picture. The diagram is the document's current
 * bytes (not the file on disk), keyed like a ```mermaid fence (source
 * hash, length, the Rich theme), so an edit renders lazily on the Mermaid
 * lane while the last diagram that had pixels stays up, dimmed — the
 * fence's stale display, owned by the document at RTX_MMD_OWNER_LO. The
 * limits are the fences' (mermaid_max_kb, mermaid_nodes,
 * mermaid_timeout_ms; `mermaid: false` leaves the file as text). */
#ifndef RTX_MMD_VIEW_CCH
#define RTX_MMD_VIEW_CCH

#include <stdint.h>
#include "document.cch"
#include "img.cch"
#include "layout.cch"

/* The stale display's key for a whole-file diagram (a fence's is its
 * opening offset, never this). */
#define RTX_MMD_OWNER_LO ((size_t)-1)

typedef struct {
    RtxImgSrc src;         /* the diagram of the document's bytes now */
    RtxImgView v;          /* its state */
    int have_prev;         /* the document's last diagram with pixels (another
                            * source or theme): what the stale display shows */
    RtxImgSrc prev;
    RtxImgView pv;
    int have;              /* a size to lay out: w x h */
    int stale;             /* that size is prev's (src has none yet) */
    uint32_t w, h;
    const char *msg;       /* why src is not drawn (ERR), else NULL; valid
                            * until the next rtx_img_pump */
} RtxMmdPic;

/* Mermaid rendering is on (settings `mermaid`). */
int rtx_mmd_view_ok(void);

/* The diagram of d's bytes (the Rich theme's colours; the renderer's
 * limits). Reads at most mermaid_max_kb: past it the source is refused
 * unread. Notes the stale display's diagram when this one has pixels. */
void rtx_mmd_pic(RtxDoc *d, RtxMmdPic *P);

/* A picture record for the fence painters (gui_img_mermaid, the terminal's
 * picture rows): P's keys, the stale one when there is one, at w x h. */
void rtx_mmd_rec(const RtxMmdPic *P, double w, double h, RtxImgRec *rec);

#endif
