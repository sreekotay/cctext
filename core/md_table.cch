#!ccc cch
/*
 * GFM table classify + cell split. Bytes are truth: a table is a header
 * line, a separator line, then pipe-rows. The separator is geom, not a
 * record. Window-honest: only the bytes passed in; a cut table is leftover
 * text, never a wrong nest (docs/md_view.md wedge 5).
 *
 * Cell spans are `RtxMdCell` (same lo/hi shape as a grid field). Not the
 * CSV grid view — MD tables live under default / wrap on a MARKUP pane.
 * Bodies in md_table.ccs.
 */
#ifndef RTX_MD_TABLE_H
#define RTX_MD_TABLE_H

#include <stddef.h>

#define RTX_MD_TABLE_COLS 16
#define RTX_MD_TABLE_GAP 1
#define RTX_MD_TABLE_RAIL 1
#define RTX_MD_TABLE_FILL 8
#define RTX_MD_PX_PAD 8
#define RTX_MD_PX_LINE 1
#define RTX_MD_PX_SEP 10

enum {
    RTX_MD_ROLE_NONE = 0,
    RTX_MD_ROLE_HDR = 1,
    RTX_MD_ROLE_SEP = 2,
    RTX_MD_ROLE_BODY = 3
};

typedef struct {
    size_t lo;
    size_t hi;
} RtxMdCell;

enum {
    RTX_MD_ALIGN_LEFT = 0,
    RTX_MD_ALIGN_CENTER = 1,
    RTX_MD_ALIGN_RIGHT = 2
};

typedef struct {
    size_t lo;      /* header line start (BOL) */
    size_t hi;      /* exclusive end of last body line (NL included if present) */
    size_t sep_lo;  /* separator line start */
    size_t sep_hi;  /* exclusive end of separator line (NL included if present) */
    size_t body_lo; /* first body line, or hi when the table is header+sep only */
    int ncols;      /* separator cell count; body extras are leftover */
    unsigned char align[RTX_MD_TABLE_COLS];
} RtxMdTable;

/* One physical line, no NL. `\|` is a literal pipe, not a break. A leading
 * `|` and a trailing `|` are delimiters, not cells. */
size_t rtx_md_row_split(const char *s, size_t n, RtxMdCell *out, size_t cap);

/* 1 if every cell is `:?-+:?` (GFM delimiter row) and there is at least one. */
int rtx_md_line_is_sep(const char *s, size_t n);

/* 1 if `at` is BOL and this line + the next are a GFM table. Fills *t. */
int rtx_md_table_at(const char *buf, size_t n, size_t at, RtxMdTable *t);

/* First table whose header starts at or after `from`. 1 if found. */
int rtx_md_table_next(const char *buf, size_t n, size_t from, RtxMdTable *t);

/* Display columns of a cell: trim, `\|` is one column, other bytes 1.
 * Layout recomputes with UTF-8 when it has the cluster walker. */
int rtx_md_disp_cols(const char *s, size_t n);

/* Max display columns per column over header ∪ body (not the sep). */
void rtx_md_table_widths(const char *buf, const RtxMdTable *t, int *col_w,
                         int cap);

/* Sum of col_w + inner gaps + outer rails. 0 if none. */
int rtx_md_row_width(const int *col_w, int ncols);

/* Which cell holds `rel` on one physical line (no NL). -1 = a `|` delimiter. */
int rtx_md_row_col_at(const char *s, size_t n, size_t rel, int ncols);

/* Cell `c` on that line. 0 if c is past the split (ragged leftover). */
int rtx_md_row_cell(const char *s, size_t n, int c, RtxMdCell *out);

/* hdr / sep / body / none for a document (or buffer) offset. */
int rtx_md_table_role(const RtxMdTable *t, size_t off);

/* In-place GFM trim of [lo, hi) (spaces and tabs). */
void rtx_md_span_trim(const char *s, size_t *lo, size_t *hi);

/* Display-column origin of column `c` (rail if c <= 0). */
int rtx_md_col_origin(const int *col_w, int ncols, int c);

/* Leading pad so `cell_w` sits in `col_w` under GFM align. */
int rtx_md_align_pad(int align, int col_w, int cell_w);

/* Pixel table: content box origin of column `c`, and full row width. */
int rtx_md_px_origin(const int *col_px, int ncols, int c);
int rtx_md_px_width(const int *col_px, int ncols);
int rtx_md_px_vline(const int *col_px, int ncols, int edge);

/* `|  |  | ... |\n` for `ncols`. 0 if dst is too small. */
size_t rtx_md_empty_row(int ncols, char *dst, size_t cap);
/* Append one column to a physical line (no NL). sep → `---|`. */
size_t rtx_md_line_add_col(const char *s, size_t n, int sep, char *dst,
                           size_t cap);
/* Drop column `c` from a physical line (no NL). Ragged past `c` is copied. */
size_t rtx_md_line_del_col(const char *s, size_t n, int c, char *dst,
                           size_t cap);

#endif
