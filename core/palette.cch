#!ccc cch
/*
 * Command palette model (owner: palette.ccs). Shared by both hosts: the
 * query field, the filtered + ranked row list, the selection. Hosts map
 * keys onto these calls, draw the rows (title, category, rtx_keymap_hint)
 * and run what rtx_palette_pick returns through their own dispatch.
 *
 * Rows: every enabled command in the table (cmd.cch) that is not HIDDEN,
 * plus RESERVED ids, listed last as "(unavailable)". An empty query shows
 * recently run commands first, then table order; a query ranks by
 * rtx_fuzzy_score over the title, "category title" and the id, with a
 * small bonus for recent use.
 */
#ifndef RTX_PALETTE_H
#define RTX_PALETTE_H

#include <stddef.h>
#include "utf8.cch"
#include "cmd.cch"

enum { RTX_PALETTE_QMAX = 96 };

typedef struct {
    char q[RTX_PALETTE_QMAX];
    size_t qlen;
    size_t qcaret;
    size_t qsel;
    unsigned ctx;          /* RTX_CTX_* snapshot at open */
    int rows[RTX_CMD_MAX]; /* table rows, best first */
    int nrows;
    int navail;            /* rows[0..navail) can run; the rest are reserved */
    int cur;               /* selected index into rows */
    int top;               /* first visible index */
} RtxPalette;

void rtx_palette_open(RtxPalette *p, unsigned ctx);
/* Recompute rows from the query (call after every field edit). */
void rtx_palette_refilter(RtxPalette *p);
RtxField rtx_palette_field(RtxPalette *p);
/* Move the selection by dir rows; vis = rows the host shows (keeps cur in
 * view). */
void rtx_palette_move(RtxPalette *p, int dir, int vis);
void rtx_palette_scroll_to(RtxPalette *p, int vis);
/* Row to run for the selection, noted as recent; -1 when nothing is
 * selected or it is unavailable. */
int rtx_palette_pick(RtxPalette *p);
/* Row at list index i (clicks), or -1. */
int rtx_palette_row(const RtxPalette *p, int i);
int rtx_palette_row_live(const RtxPalette *p, int i);

#endif /* RTX_PALETTE_H */
