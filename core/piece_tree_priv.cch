/* Tree-TU internals. Not a public header — included by piece_tree.ccs.
 * rb/lines chapters are spliced into that TU and see these types. */
#ifndef RTX_PIECE_TREE_PRIV_H
#define RTX_PIECE_TREE_PRIV_H

#include "piece_tree.cch"
#include "lf.cch"

#define RTX_RB_RED 1
#define RTX_RB_BLACK 0
#define RTX_IO_CHUNK 4096
/* note_insert `lf` when the inserted bytes were not counted (piece refs
 * captured while weights were progressive). */
#define RTX_LF_UNKNOWN ((size_t)-1)

/* rtx_line_eat: no stop line / a slot push failed. */
#define RTX_LINE_NO_STOP ((size_t)-1)
#define RTX_LINE_EAT_FAIL ((size_t)-1)
size_t rtx_line_eat(RtxPieceTree *t, const char *buf, size_t n, size_t base,
                    size_t *line, size_t stop, int *hit);
void !>(RtxIndexErr) rtx_line_scan_through_line(RtxPieceTree *t, size_t want_line);
void !>(CCError) rtx_isle_listing_start(RtxPieceTree *t);
void !>(CCError) rtx_lf_invalidate_from(RtxPieceTree *t, size_t off);
/* Chapter helpers the bulk swap (piece_tree.ccs) calls. */
RtxNode *rtx_node_alloc(RtxPieceTree *t);
void rtx_node_recycle(RtxPieceTree *t, RtxNode *n);
void rtx_line_index_build(RtxPieceTree *t);
void rtx_line_index_rebuild_suffix(RtxPieceTree *t, size_t off);
void rtx_line_isle_drop(RtxPieceTree *t);

#endif /* RTX_PIECE_TREE_PRIV_H */
