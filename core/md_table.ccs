#!ccc ccs
/*
 * GFM table classify (linked TU; see md_table.cch).
 */
#include <ccc/std/prelude.cch>
#include "md_table.cch"

static size_t rtx_md_trim_cr(const char *s, size_t n) {
    if (s && n > 0 && s[n - 1] == '\r') return n - 1;
    return n;
}

static size_t rtx_md_line_end(const char *buf, size_t n, size_t at) {
    while (at < n && buf[at] != '\n') at++;
    return at;
}

static int rtx_md_at_bol(const char *buf, size_t at) {
    return at == 0 || (buf && buf[at - 1] == '\n');
}

static int rtx_md_is_ws(char c) {
    return c == ' ' || c == '\t';
}

static void rtx_md_trim(const char *s, size_t *lo, size_t *hi) {
    while (*lo < *hi && rtx_md_is_ws(s[*lo])) (*lo)++;
    while (*hi > *lo && rtx_md_is_ws(s[*hi - 1])) (*hi)--;
}

static int rtx_md_line_has_pipe(const char *s, size_t n) {
    size_t i;
    int esc = 0;
    n = rtx_md_trim_cr(s, n);
    if (!s) return 0;
    for (i = 0; i < n; i++) {
        if (esc) {
            esc = 0;
            continue;
        }
        if (s[i] == '\\') {
            esc = 1;
            continue;
        }
        if (s[i] == '|') return 1;
    }
    return 0;
}

static int rtx_md_line_blank(const char *s, size_t n) {
    size_t i;
    n = rtx_md_trim_cr(s, n);
    if (!s) return 1;
    for (i = 0; i < n; i++) {
        if (!rtx_md_is_ws(s[i])) return 0;
    }
    return 1;
}

size_t rtx_md_row_split(const char *s, size_t n, RtxMdCell *out, size_t cap) {
    size_t i = 0, start, cells = 0;
    int esc = 0;
    if (!s) return 0;
    n = rtx_md_trim_cr(s, n);
    if (n && s[0] == '|') i = 1;
    start = i;
    for (; i < n; i++) {
        if (esc) {
            esc = 0;
            continue;
        }
        if (s[i] == '\\') {
            esc = 1;
            continue;
        }
        if (s[i] == '|') {
            if (out && cells < cap) {
                out[cells].lo = start;
                out[cells].hi = i;
            }
            cells++;
            start = i + 1;
        }
    }
    if (start < n) {
        if (out && cells < cap) {
            out[cells].lo = start;
            out[cells].hi = n;
        }
        cells++;
    }
    return cells;
}

static int rtx_md_cell_is_sep(const char *s, size_t lo, size_t hi) {
    size_t i;
    int dash = 0;
    rtx_md_trim(s, &lo, &hi);
    if (lo >= hi) return 0;
    if (s[lo] == ':') lo++;
    if (hi > lo && s[hi - 1] == ':') hi--;
    if (lo >= hi) return 0;
    for (i = lo; i < hi; i++) {
        if (s[i] != '-') return 0;
        dash = 1;
    }
    return dash;
}

static unsigned char rtx_md_cell_align(const char *s, size_t lo, size_t hi) {
    int left, right;
    rtx_md_trim(s, &lo, &hi);
    left = (lo < hi && s[lo] == ':');
    right = (lo < hi && s[hi - 1] == ':');
    if (left && right) return (unsigned char)RTX_MD_ALIGN_CENTER;
    if (right) return (unsigned char)RTX_MD_ALIGN_RIGHT;
    return (unsigned char)RTX_MD_ALIGN_LEFT;
}

int rtx_md_line_is_sep(const char *s, size_t n) {
    RtxMdCell cells[RTX_MD_TABLE_COLS];
    size_t ncells, i;
    n = rtx_md_trim_cr(s, n);
    ncells = rtx_md_row_split(s, n, cells, RTX_MD_TABLE_COLS);
    if (ncells == 0) return 0;
    if (ncells > RTX_MD_TABLE_COLS) ncells = RTX_MD_TABLE_COLS;
    for (i = 0; i < ncells; i++) {
        if (!rtx_md_cell_is_sep(s, cells[i].lo, cells[i].hi)) return 0;
    }
    return 1;
}

/* Cells of a line with its outer whitespace trimmed (GFM counts cells on
 * the trimmed row; a trailing `|` closes the last cell, it opens none). */
static size_t rtx_md_line_ncells(const char *s, size_t n) {
    size_t lo = 0, hi;
    if (!s) return 0;
    hi = rtx_md_trim_cr(s, n);
    rtx_md_trim(s, &lo, &hi);
    return rtx_md_row_split(s + lo, hi - lo, NULL, 0);
}

/* 1 when the line's last non-blank byte is an unescaped `|`. */
static int rtx_md_line_closed(const char *s, size_t n) {
    size_t lo = 0, hi, k, bs = 0;
    if (!s) return 0;
    hi = rtx_md_trim_cr(s, n);
    rtx_md_trim(s, &lo, &hi);
    if (hi <= lo || s[hi - 1] != '|') return 0;
    for (k = hi - 1; k > lo && s[k - 1] == '\\'; k--) bs++;
    return (bs & 1) == 0;
}

int rtx_md_line_pipe(const char *s, size_t n) {
    return rtx_md_line_has_pipe(s, n);
}

size_t rtx_md_line_cells(const char *s, size_t n) {
    return rtx_md_line_ncells(s, n);
}

int rtx_md_table_at(const char *buf, size_t n, size_t at, RtxMdTable *t) {
    size_t hdr_e, sep_at, sep_e, body, line, line_e;
    RtxMdCell cells[RTX_MD_TABLE_COLS];
    size_t ncells, i;
    if (!buf || !t || at >= n || !rtx_md_at_bol(buf, at)) return 0;
    hdr_e = rtx_md_line_end(buf, n, at);
    if (!rtx_md_line_has_pipe(buf + at, hdr_e - at)) return 0;
    if (hdr_e >= n || buf[hdr_e] != '\n') return 0;
    sep_at = hdr_e + 1;
    sep_e = rtx_md_line_end(buf, n, sep_at);
    if (!rtx_md_line_is_sep(buf + sep_at, sep_e - sep_at)) return 0;
    ncells = rtx_md_row_split(buf + sep_at, sep_e - sep_at, cells, RTX_MD_TABLE_COLS);
    if (ncells == 0) return 0;
    /* GFM: the header row's cells match the delimiter row's. */
    if (rtx_md_line_ncells(buf + at, hdr_e - at) !=
        rtx_md_line_ncells(buf + sep_at, sep_e - sep_at))
        return 0;
    *t = (RtxMdTable){0};
    t->lo = at;
    t->sep_lo = sep_at;
    t->sep_hi = (sep_e < n && buf[sep_e] == '\n') ? sep_e + 1 : sep_e;
    t->ncols = (int)ncells;
    if (t->ncols > RTX_MD_TABLE_COLS) t->ncols = RTX_MD_TABLE_COLS;
    for (i = 0; i < (size_t)t->ncols; i++) {
        t->align[i] = rtx_md_cell_align(buf + sep_at, cells[i].lo, cells[i].hi);
    }
    if (sep_e < n && buf[sep_e] == '\n') body = sep_e + 1;
    else body = sep_e;
    t->body_lo = body;
    line = body;
    while (line < n) {
        if (!rtx_md_at_bol(buf, line)) break;
        line_e = rtx_md_line_end(buf, n, line);
        if (rtx_md_line_blank(buf + line, line_e - line)) break;
        if (!rtx_md_line_has_pipe(buf + line, line_e - line)) break;
        if (line_e < n && buf[line_e] == '\n') line = line_e + 1;
        else {
            line = line_e;
            break;
        }
    }
    t->hi = line;
    if (t->body_lo > t->hi) t->body_lo = t->hi;
    return 1;
}

int rtx_md_table_next(const char *buf, size_t n, size_t from, RtxMdTable *t) {
    size_t i = from;
    if (!buf || !t) return 0;
    if (i > 0 && i < n && buf[i - 1] != '\n') {
        while (i < n && buf[i] != '\n') i++;
        if (i < n) i++;
    }
    while (i < n) {
        if (rtx_md_table_at(buf, n, i, t)) return 1;
        while (i < n && buf[i] != '\n') i++;
        if (i < n) i++;
    }
    return 0;
}

int rtx_md_table_cover(const char *buf, size_t n, size_t at, RtxMdTable *t) {
    size_t i;
    if (!buf || !t || n == 0) return 0;
    if (at > n) return 0;
    i = at < n ? at : n;
    if (i == n || (i > 0 && buf[i] == '\n')) {
        if (i == 0) return 0;
        i--;
    }
    while (i > 0 && buf[i - 1] != '\n') i--;
    for (;;) {
        RtxMdTable cand;
        if (rtx_md_table_at(buf, n, i, &cand)) {
            if (at >= cand.lo && at < cand.hi) {
                *t = cand;
                return 1;
            }
            return 0;
        }
        if (i == 0) return 0;
        i--;
        while (i > 0 && buf[i - 1] != '\n') i--;
    }
}

int rtx_md_disp_cols(const char *s, size_t n) {
    size_t lo = 0, hi, i;
    int w = 0;
    if (!s) return 0;
    n = rtx_md_trim_cr(s, n);
    hi = n;
    rtx_md_trim(s, &lo, &hi);
    for (i = lo; i < hi; ) {
        if (i + 1 < hi && s[i] == '\\' && s[i + 1] == '|') {
            w++;
            i += 2;
            continue;
        }
        w++;
        i++;
    }
    return w;
}

size_t rtx_md_wrap_field(const char *s, size_t n, int width, RtxMdCell *out,
                         size_t cap) {
    size_t i = 0;
    size_t nf = 0;
    if (!s || !out || cap == 0) return 0;
    if (width < 1) width = 1;
    if (n == 0) {
        out[0].lo = 0;
        out[0].hi = 0;
        return 1;
    }
    while (i < n && nf < cap) {
        size_t row_start = i;
        int cols = 0;
        size_t last_br = i;
        int last_br_cols = 0;
        while (i < n) {
            int pc = 1;
            if (s[i] == '\n' || s[i] == '\r') break;
            if (i + 1 < n && s[i] == '\\' && s[i + 1] == '|') {
                if (cols > 0 && cols + 1 > width) {
                    if (last_br > row_start) {
                        i = last_br;
                        cols = last_br_cols;
                    }
                    break;
                }
                cols += 1;
                i += 2;
                last_br = i;
                last_br_cols = cols;
                continue;
            }
            if (cols > 0 && cols + pc > width) {
                if (last_br > row_start) {
                    i = last_br;
                    cols = last_br_cols;
                }
                break;
            }
            cols += pc;
            i++;
            if (s[i - 1] == ' ' || s[i - 1] == '\t' || s[i - 1] == '-' ||
                s[i - 1] == '/') {
                last_br = i;
                last_br_cols = cols;
            }
        }
        if (i == row_start && i < n && s[i] != '\n' && s[i] != '\r') i++;
        if (nf + 1 == cap && i < n) i = n;
        out[nf].lo = row_start;
        out[nf].hi = i;
        nf++;
        if (i < n && (s[i] == '\n' || s[i] == '\r'))
            i = (s[i] == '\r' && i + 1 < n && s[i + 1] == '\n') ? i + 2 : i + 1;
    }
    return nf ? nf : 1;
}

static void rtx_md_widths_line(const char *line, size_t n, int *col_w, int ncols) {
    RtxMdCell cells[RTX_MD_TABLE_COLS];
    size_t nc, i, lim;
    if (!line || !col_w || ncols <= 0) return;
    nc = rtx_md_row_split(line, n, cells, RTX_MD_TABLE_COLS);
    lim = (size_t)ncols < nc ? (size_t)ncols : nc;
    for (i = 0; i < lim; i++) {
        int w = rtx_md_disp_cols(line + cells[i].lo, cells[i].hi - cells[i].lo);
        if (w > col_w[i]) col_w[i] = w;
    }
}

void rtx_md_table_widths(const char *buf, const RtxMdTable *t, int *col_w,
                         int cap) {
    size_t le, line;
    int nout, i;
    if (!buf || !t || !col_w || cap <= 0) return;
    nout = t->ncols < cap ? t->ncols : cap;
    for (i = 0; i < nout; i++) col_w[i] = 0;
    le = t->lo;
    while (le < t->sep_lo && buf[le] != '\n') le++;
    rtx_md_widths_line(buf + t->lo, le - t->lo, col_w, nout);
    line = t->body_lo;
    while (line < t->hi) {
        le = line;
        while (le < t->hi && buf[le] != '\n') le++;
        if (!rtx_md_line_blank(buf + line, le - line))
            rtx_md_widths_line(buf + line, le - line, col_w, nout);
        if (le < t->hi && buf[le] == '\n') line = le + 1;
        else break;
    }
}

/* out = lo + (avail - Σlo) shared in proportion to (hi - lo), whole
 * units, the leftover one each to the largest remainders; never past hi.
 * Callers hold Σlo <= avail < Σhi. */
static int rtx_md_fit_share(const int *lo, const int *hi, int ncols, int avail,
                            int *out) {
    long rem[RTX_MD_TABLE_COLS];
    long spread = 0;
    int i, slack, left, total = 0;
    for (i = 0; i < ncols; i++) spread += (long)(hi[i] - lo[i]);
    slack = avail;
    for (i = 0; i < ncols; i++) slack -= lo[i];
    if (slack < 0) slack = 0;
    left = slack;
    for (i = 0; i < ncols; i++) {
        long share = spread > 0 ? (long)slack * (long)(hi[i] - lo[i]) : 0;
        int whole = spread > 0 ? (int)(share / spread) : 0;
        rem[i] = spread > 0 ? share % spread : 0;
        out[i] = lo[i] + whole;
        left -= whole;
    }
    while (left > 0) {
        int best = -1;
        for (i = 0; i < ncols; i++) {
            if (out[i] >= hi[i]) continue;
            if (best < 0 || rem[i] > rem[best]) best = i;
        }
        if (best < 0) break;
        out[best]++;
        rem[best] = -1;
        left--;
    }
    for (i = 0; i < ncols; i++) total += out[i];
    return total;
}

int rtx_md_fit_cols(const int *nat, int ncols, int avail, int hard, int *out) {
    int n[RTX_MD_TABLE_COLS], mn[RTX_MD_TABLE_COLS], hd[RTX_MD_TABLE_COLS];
    int i, cap, sum_nat = 0, sum_min = 0, sum_hd = 0;
    if (!nat || !out || ncols <= 0) return 0;
    if (ncols > RTX_MD_TABLE_COLS) ncols = RTX_MD_TABLE_COLS;
    if (avail < 1) avail = 1;
    if (hard < 1) hard = 1;
    cap = avail / RTX_MD_FIT_MIN_DIV;
    if (cap < 1) cap = 1;
    for (i = 0; i < ncols; i++) {
        n[i] = nat[i] > 0 ? nat[i] : 0;
        mn[i] = n[i] < cap ? n[i] : cap;
        hd[i] = n[i] < hard ? n[i] : hard;
        if (hd[i] > mn[i]) hd[i] = mn[i];
        sum_nat += n[i];
        sum_min += mn[i];
        sum_hd += hd[i];
    }
    if (sum_nat <= avail) {
        for (i = 0; i < ncols; i++) out[i] = n[i];
        return sum_nat;
    }
    if (sum_min <= avail) return rtx_md_fit_share(mn, n, ncols, avail, out);
    /* Many wide columns: the 25% floors alone are wider than the room.
     * They give way in proportion down to the hard floor; past that the
     * table overflows. */
    if (sum_hd >= avail) {
        for (i = 0; i < ncols; i++) out[i] = hd[i];
        return sum_hd;
    }
    return rtx_md_fit_share(hd, mn, ncols, avail, out);
}

int rtx_md_row_width(const int *col_w, int ncols) {
    int i, w = 0;
    if (!col_w || ncols <= 0) return 0;
    for (i = 0; i < ncols; i++) w += col_w[i];
    if (ncols > 1) w += RTX_MD_TABLE_GAP * (ncols - 1);
    w += 2 * RTX_MD_TABLE_RAIL;
    return w;
}

int rtx_md_row_col_at(const char *s, size_t n, size_t rel, int ncols) {
    RtxMdCell cells[RTX_MD_TABLE_COLS];
    size_t nc, i;
    if (!s || ncols <= 0) return -1;
    n = rtx_md_trim_cr(s, n);
    nc = rtx_md_row_split(s, n, cells, RTX_MD_TABLE_COLS);
    if ((size_t)ncols < nc) nc = (size_t)ncols;
    for (i = 0; i < nc; i++) {
        if (rel >= cells[i].lo && rel < cells[i].hi) return (int)i;
    }
    return -1;
}

int rtx_md_row_cell(const char *s, size_t n, int c, RtxMdCell *out) {
    RtxMdCell cells[RTX_MD_TABLE_COLS];
    size_t nc;
    if (!s || !out || c < 0) return 0;
    n = rtx_md_trim_cr(s, n);
    nc = rtx_md_row_split(s, n, cells, RTX_MD_TABLE_COLS);
    if ((size_t)c >= nc) return 0;
    *out = cells[c];
    return 1;
}

int rtx_md_table_role(const RtxMdTable *t, size_t off) {
    if (!t || off < t->lo || off >= t->hi) return RTX_MD_ROLE_NONE;
    if (off < t->sep_lo) return RTX_MD_ROLE_HDR;
    if (off < t->sep_hi) return RTX_MD_ROLE_SEP;
    if (off >= t->body_lo) return RTX_MD_ROLE_BODY;
    return RTX_MD_ROLE_NONE;
}

void rtx_md_span_trim(const char *s, size_t *lo, size_t *hi) {
    if (!s || !lo || !hi) return;
    rtx_md_trim(s, lo, hi);
}

int rtx_md_col_origin(const int *col_w, int ncols, int c) {
    int i, x;
    if (!col_w || ncols <= 0) return 0;
    x = RTX_MD_TABLE_RAIL;
    if (c <= 0) return x;
    if (c > ncols) c = ncols;
    for (i = 0; i < c; i++) x += col_w[i] + RTX_MD_TABLE_GAP;
    return x;
}

int rtx_md_align_pad(int align, int col_w, int cell_w) {
    int extra = col_w - cell_w;
    if (extra < 0) extra = 0;
    if (align == RTX_MD_ALIGN_RIGHT) return extra;
    if (align == RTX_MD_ALIGN_CENTER) return extra / 2;
    return 0;
}

int rtx_md_px_origin(const int *col_px, int ncols, int c) {
    int i, x;
    if (!col_px || ncols <= 0) return 0;
    x = RTX_MD_PX_LINE + RTX_MD_PX_PAD;
    if (c <= 0) return x;
    if (c > ncols) c = ncols;
    for (i = 0; i < c; i++)
        x += col_px[i] + 2 * RTX_MD_PX_PAD + RTX_MD_PX_LINE;
    return x;
}

int rtx_md_px_width(const int *col_px, int ncols) {
    int i, w;
    if (!col_px || ncols <= 0) return 0;
    w = RTX_MD_PX_LINE;
    for (i = 0; i < ncols; i++)
        w += col_px[i] + 2 * RTX_MD_PX_PAD + RTX_MD_PX_LINE;
    return w;
}

int rtx_md_px_vline(const int *col_px, int ncols, int edge) {
    if (!col_px || ncols <= 0 || edge <= 0) return 0;
    if (edge >= ncols) return rtx_md_px_width(col_px, ncols) - RTX_MD_PX_LINE;
    return rtx_md_px_origin(col_px, ncols, edge) - RTX_MD_PX_PAD -
           RTX_MD_PX_LINE;
}

size_t rtx_md_empty_row(int ncols, char *dst, size_t cap) {
    size_t i, o = 0;
    if (!dst) return 0;
    if (ncols < 1) ncols = 1;
    if (ncols > RTX_MD_TABLE_COLS) ncols = RTX_MD_TABLE_COLS;
    if (cap < (size_t)(1 + 3 * ncols + 1)) return 0;
    dst[o++] = '|';
    for (i = 0; i < (size_t)ncols; i++) {
        dst[o++] = ' ';
        dst[o++] = ' ';
        dst[o++] = '|';
    }
    dst[o++] = '\n';
    return o;
}

size_t rtx_md_line_add_col(const char *s, size_t n, int sep, char *dst,
                           size_t cap) {
    size_t i, o, addn, cr;
    const char *add;
    if (!dst || (!s && n)) return 0;
    cr = n - rtx_md_trim_cr(s, n);
    n -= cr;
    add = sep ? "---|" : "  |";
    addn = sep ? 4 : 3;
    /* A row without a trailing pipe (`A | B`) closes its last cell first,
     * else the new `|` would only close that cell: `A | B  |` is 2 cells. */
    if (cap < n + 2 + addn + cr) return 0;
    for (o = 0; o < n; o++) dst[o] = s[o];
    if (!rtx_md_line_closed(s, n)) {
        if (!sep) dst[o++] = ' ';
        dst[o++] = '|';
    }
    for (i = 0; i < addn; i++) dst[o++] = add[i];
    if (cr) dst[o++] = '\r';
    return o;
}

size_t rtx_md_line_del_col(const char *s, size_t n, int c, char *dst,
                           size_t cap) {
    RtxMdCell cells[RTX_MD_TABLE_COLS];
    size_t nc, i, k, o, cn;
    int lead;
    if (!dst) return 0;
    n = rtx_md_trim_cr(s, n);
    if (!s) return 0;
    nc = rtx_md_row_split(s, n, cells, RTX_MD_TABLE_COLS);
    if (nc == 0 || c < 0 || (size_t)c >= nc) {
        if (cap < n) return 0;
        for (i = 0; i < n; i++) dst[i] = s[i];
        return n;
    }
    if (nc == 1) {
        if (cap < n) return 0;
        for (i = 0; i < n; i++) dst[i] = s[i];
        return n;
    }
    lead = s[0] == '|';
    o = 0;
    if (lead) {
        if (o >= cap) return 0;
        dst[o++] = '|';
    }
    for (i = 0; i < nc; i++) {
        if ((int)i == c) continue;
        cn = cells[i].hi - cells[i].lo;
        if (o + cn + 1 > cap) return 0;
        for (k = 0; k < cn; k++) dst[o++] = s[cells[i].lo + k];
        dst[o++] = '|';
    }
    return o;
}
