#!ccc ccs
/*
 * Hex-view geometry helpers (linked TU; see hex.cch).
 */
#include <ccc/std/prelude.cch>
#include "hex.cch"
#include "utf8.cch"

size_t rtx_hex_row_count(size_t len) {
    if (len == 0) return 1;
    return (len + (size_t)RTX_HEX_COLS - 1) / (size_t)RTX_HEX_COLS;
}

size_t rtx_hex_align(size_t off) {
    return off - (off % (size_t)RTX_HEX_COLS);
}

size_t rtx_hex_row_off(size_t top_byte, size_t row) {
    return rtx_hex_align(top_byte) + row * (size_t)RTX_HEX_COLS;
}

char rtx_hex_ascii(unsigned char c) {
    return (c >= 32 && c < 127) ? (char)c : '.';
}

int rtx_hex_ascii_col0(void) {
    return RTX_HEX_OFF_W + (RTX_HEX_COLS * 3) + RTX_HEX_GAP;
}

static int rtx_hex_dump_printable(uint32_t cp) {
    if (cp < 0x20 || cp == 0x7F) return 0;
    if (cp >= 0x80 && cp < 0xA0) return 0;
    if (rtx_utf8_combining(cp)) return 0;
    return rtx_utf8_cp_width(cp) == 1;
}

static void rtx_hex_dump_set(RtxHexDumpCell *c, int kind, const char *bytes, int n) {
    if (!c) return;
    c->kind = kind;
    c->n = 0;
    c->utf8[0] = 0;
    if (n < 0) n = 0;
    if (n > 4) n = 4;
    if (bytes && n) {
        char[:] dst = cc_slice_from_buffer(c->utf8, (size_t)n);
        char[:] src = cc_slice_from_buffer((void *)bytes, (size_t)n);
        dst.copy(src) !>(e) { (void)e; return; };
        c->n = n;
    }
    c->utf8[c->n] = 0;
}

void rtx_hex_dump_row(char[:] win, size_t look, size_t got,
                      RtxHexDumpCell out[RTX_HEX_COLS]) {
    size_t i;
    size_t win_n;
    if (!out) return;
    {
        size_t z;
        for (z = 0; z < (size_t)RTX_HEX_COLS; z++)
            out[z] = (RtxHexDumpCell){0};
    }
    win_n = win.len;
    if (!win.ptr || win_n == 0 || got == 0) return;
    if (look > win_n) look = win_n;
    if (got > (size_t)RTX_HEX_COLS) got = (size_t)RTX_HEX_COLS;
    if (look + got > win_n) got = win_n - look;
    i = 0;
    while (i < win_n) {
        uint32_t cp = 0;
        int nb = rtx_utf8_decode(win.ptr + i, win_n - i, &cp);
        RtxUtf8Cl cl;
        size_t n;
        size_t j;
        int show;
        char glyph[4];
        int enc;
        if (nb <= 0) {
            cl.n = 1;
            cl.cp = RTX_UTF8_FFFD;
            cl.cols = 1;
        } else {
            cl = rtx_utf8_cluster(win, i);
        }
        n = cl.n ? cl.n : 1;
        show = nb > 0 && rtx_hex_dump_printable(cl.cp);
        enc = show ? rtx_utf8_encode(cl.cp, glyph) : 0;
        if (enc <= 0) show = 0;
        for (j = 0; j < n; j++) {
            size_t at = i + j;
            size_t k;
            if (at < look || at >= look + got) continue;
            k = at - look;
            if (j == 0 && show) rtx_hex_dump_set(&out[k], RTX_HEX_DUMP_LEAD, glyph, enc);
            else if (show) rtx_hex_dump_set(&out[k], RTX_HEX_DUMP_CONT, "\xC2\xB7", 2);
            else rtx_hex_dump_set(&out[k], RTX_HEX_DUMP_DOT, ".", 1);
        }
        i += n;
    }
}

/* A hit stays on its row: the gap after the hex pairs and anything right
 * of the dump are the row's last byte, not the next row (then EOF). */
static size_t rtx_hex_hit_row(size_t base, size_t rel, size_t n) {
    size_t at;
    if (rel > (size_t)RTX_HEX_COLS - 1) rel = (size_t)RTX_HEX_COLS - 1;
    at = base + rel;
    if (at > n) at = n;
    return at;
}

size_t rtx_hex_hit_col(size_t top_byte, size_t n, int row, int col) {
    size_t base = rtx_hex_row_off(top_byte, (size_t)(row < 0 ? 0 : row));
    int ascii0 = rtx_hex_ascii_col0();
    size_t rel;
    if (col >= ascii0) {
        rel = (size_t)(col - ascii0);
    } else if (col >= RTX_HEX_OFF_W) {
        int h = col - RTX_HEX_OFF_W;
        rel = (size_t)(h / 3);
    } else {
        rel = 0;
    }
    return rtx_hex_hit_row(base, rel, n);
}

size_t rtx_hex_hit_x(size_t top_byte, size_t n, int row, float local_x, float cw) {
    size_t base = rtx_hex_row_off(top_byte, (size_t)(row < 0 ? 0 : row));
    size_t rel;
    float off_w;
    float hex_w;
    if (cw < 1.0f) cw = 1.0f;
    off_w = cw * (float)RTX_HEX_OFF_W;
    hex_w = cw * 3.0f * (float)RTX_HEX_COLS;
    if (local_x < off_w) {
        rel = 0;
    } else if (local_x < off_w + hex_w) {
        float hx = local_x - off_w;
        rel = (size_t)(hx / (cw * 3.0f));
    } else {
        float ax = local_x - (off_w + hex_w + cw * (float)RTX_HEX_GAP);
        if (ax < 0) ax = 0;
        rel = (size_t)(ax / cw);
    }
    return rtx_hex_hit_row(base, rel, n);
}
