#!ccc ccs
/*
 * Command palette model (linked TU; see palette.cch).
 */
#include <ccc/std/prelude.cch>
#include <stddef.h>
#include <string.h>
#include "utf8.cch"
#include "cmd.cch"
#include "fuzzy.cch"
#include "palette.cch"

/* Listed at all: not hidden, not shadowed by a real row of the same id,
 * and (unless reserved) enabled in ctx. 0 = skip, 1 = live, 2 = reserved. */
static int pal_listed(const RtxPalette *p, size_t i) {
    const RtxCmdDef *d = rtx_cmd_at(i);
    RtxCmdCtx c;
    if (!d || !d->id || (d->flags & RTX_CMDF_HIDDEN)) return 0;
    if (rtx_cmd_find(d->id) != (int)i) return 0;
    if (d->flags & RTX_CMDF_RESERVED) return 2;
    memset(&c, 0, sizeof c);
    c.flags = p->ctx;
    c.host = (p->ctx & RTX_CTX_GUI) ? RTX_HOST_GUI : RTX_HOST_TUI;
    return rtx_cmd_enabled(d, &c) ? 1 : 0;
}

static int pal_recent_rank(int row, const int *rec, size_t nrec) {
    size_t k;
    for (k = 0; k < nrec; k++)
        if (rec[k] == row) return (int)k;
    return -1;
}

static int pal_score(const RtxPalette *p, const RtxCmdDef *d) {
    char both[160];
    int best, s;
    size_t cn, tn;
    best = rtx_fuzzy_score(p->q, p->qlen, d->title, strlen(d->title));
    cn = d->cat ? strlen(d->cat) : 0;
    tn = strlen(d->title);
    if (cn + tn + 2 < sizeof both) {
        memcpy(both, d->cat, cn);
        both[cn] = ' ';
        memcpy(both + cn + 1, d->title, tn);
        s = rtx_fuzzy_score(p->q, p->qlen, both, cn + 1 + tn);
        if (s >= 0) s -= 64;
        if (s > best) best = s;
    }
    s = rtx_fuzzy_score(p->q, p->qlen, d->id, strlen(d->id));
    if (s >= 0) s -= 96;
    if (s > best) best = s;
    return best;
}

void rtx_palette_refilter(RtxPalette *p) {
    int key[RTX_CMD_MAX];
    int rec[16];
    size_t nrec, i, n;
    int k;
    if (!p) return;
    nrec = rtx_cmd_recent(rec, 16);
    n = rtx_cmd_n();
    p->nrows = 0;
    p->navail = 0;
    for (i = 0; i < n && p->nrows < RTX_CMD_MAX; i++) {
        const RtxCmdDef *d = rtx_cmd_at(i);
        int st = pal_listed(p, i);
        int rank, sc;
        if (!st) continue;
        rank = pal_recent_rank((int)i, rec, nrec);
        if (p->qlen) {
            sc = pal_score(p, d);
            if (sc < 0) continue;
            if (rank >= 0) sc += 8 * (16 - rank);
        } else {
            /* Recent first (newest first), then table order. */
            sc = rank >= 0 ? 100000 - rank : 0;
        }
        if (st == 2) sc -= 1000000; /* reserved: after everything live */
        /* Stable insert (ties keep table order). */
        k = p->nrows;
        while (k > 0 && key[k - 1] < sc) {
            key[k] = key[k - 1];
            p->rows[k] = p->rows[k - 1];
            k--;
        }
        key[k] = sc;
        p->rows[k] = (int)i;
        p->nrows++;
        if (st == 1) p->navail++;
    }
    p->cur = 0;
    p->top = 0;
}

void rtx_palette_open(RtxPalette *p, unsigned ctx) {
    if (!p) return;
    memset(p, 0, sizeof *p);
    p->ctx = ctx;
    rtx_palette_refilter(p);
}

RtxField rtx_palette_field(RtxPalette *p) {
    RtxField f;
    memset(&f, 0, sizeof f);
    if (!p) return f;
    f.buf = p->q;
    f.len = &p->qlen;
    f.cap = sizeof p->q;
    f.caret = &p->qcaret;
    f.sel = &p->qsel;
    return f;
}

void rtx_palette_scroll_to(RtxPalette *p, int vis) {
    if (!p) return;
    if (vis < 1) vis = 1;
    if (p->cur < p->top) p->top = p->cur;
    if (p->cur >= p->top + vis) p->top = p->cur - vis + 1;
    if (p->top < 0) p->top = 0;
}

void rtx_palette_move(RtxPalette *p, int dir, int vis) {
    if (!p || !p->nrows) return;
    p->cur += dir;
    if (p->cur < 0) p->cur = 0;
    if (p->cur >= p->nrows) p->cur = p->nrows - 1;
    rtx_palette_scroll_to(p, vis);
}

int rtx_palette_row(const RtxPalette *p, int i) {
    if (!p || i < 0 || i >= p->nrows) return -1;
    return p->rows[i];
}

int rtx_palette_row_live(const RtxPalette *p, int i) {
    int r = rtx_palette_row(p, i);
    return r >= 0 && rtx_cmd_available(rtx_cmd_at((size_t)r));
}

int rtx_palette_pick(RtxPalette *p) {
    int r;
    if (!p || !rtx_palette_row_live(p, p->cur)) return -1;
    r = p->rows[p->cur];
    rtx_cmd_note_run(r);
    return r;
}
