#define RTX_CMD_STATIC (sizeof(g_cmd_rows) / sizeof(g_cmd_rows[0]))
#define RTX_CMD_EXTRA 64

static RtxCmdDef g_cmd_extra[RTX_CMD_EXTRA];
static size_t g_cmd_extra_n;

size_t rtx_cmd_n(void) {
    return RTX_CMD_STATIC + g_cmd_extra_n;
}

const RtxCmdDef *rtx_cmd_at(size_t i) {
    if (i < RTX_CMD_STATIC) return &g_cmd_rows[i];
    i -= RTX_CMD_STATIC;
    if (i < g_cmd_extra_n) return &g_cmd_extra[i];
    return NULL;
}

int rtx_cmd_available(const RtxCmdDef *d) {
    if (!d || (d->flags & RTX_CMDF_RESERVED)) return 0;
    return d->cmd != CMD_NONE || d->run != NULL;
}

int rtx_cmd_find(const char *id) {
    size_t i, n = rtx_cmd_n();
    int reserved = -1;
    if (!id || !id[0]) return -1;
    for (i = 0; i < n; i++) {
        const RtxCmdDef *d = rtx_cmd_at(i);
        if (!d->id || strcmp(d->id, id) != 0) continue;
        if (!(d->flags & RTX_CMDF_RESERVED)) return (int)i;
        if (reserved < 0) reserved = (int)i;
    }
    return reserved;
}

int rtx_cmd_of(int cmd) {
    size_t i, n = rtx_cmd_n();
    if (cmd == CMD_NONE) return -1;
    for (i = 0; i < n; i++)
        if (rtx_cmd_at(i)->cmd == cmd) return (int)i;
    return -1;
}

int rtx_cmd_register(const RtxCmdDef *d) {
    if (!d || !d->id || !d->id[0] || !d->title) return -1;
    if (g_cmd_extra_n >= RTX_CMD_EXTRA) return -1;
    if (RTX_CMD_STATIC + g_cmd_extra_n >= RTX_CMD_MAX) return -1;
    g_cmd_extra[g_cmd_extra_n] = *d;
    g_cmd_extra_n++;
    return (int)(RTX_CMD_STATIC + g_cmd_extra_n - 1);
}

int rtx_cmd_enabled(const RtxCmdDef *d, const RtxCmdCtx *ctx) {
    if (!rtx_cmd_available(d)) return 0;
    if (!ctx) return 1;
    if ((ctx->flags & d->need) != d->need) return 0;
    if (ctx->flags & d->deny) return 0;
    if (d->enabled && !d->enabled(ctx)) return 0;
    return 1;
}

int rtx_cmd_letter_row(int c) {
    size_t i, n = rtx_cmd_n();
    if (c >= 'A' && c <= 'Z') c = c - 'A' + 'a';
    if (c <= 0) return -1;
    for (i = 0; i < n; i++) {
        const RtxCmdDef *d = rtx_cmd_at(i);
        const char *l = d->letters;
        if (!l || !rtx_cmd_available(d)) continue;
        for (; *l; l++)
            if ((unsigned char)*l == (unsigned)c) return (int)i;
    }
    return -1;
}

int rtx_cmd_letter(int c) {
    int r = rtx_cmd_letter_row(c);
    return r < 0 ? CMD_NONE : rtx_cmd_at((size_t)r)->cmd;
}

/* ---- recent ----------------------------------------------------------- */

enum { RTX_CMD_RECENT = 16 };
static int g_recent[RTX_CMD_RECENT];
static size_t g_recent_n;

void rtx_cmd_note_run(int row) {
    size_t i, at = g_recent_n;
    if (row < 0) return;
    for (i = 0; i < g_recent_n; i++)
        if (g_recent[i] == row) {
            at = i;
            break;
        }
    if (at == g_recent_n) {
        if (g_recent_n < RTX_CMD_RECENT) g_recent_n++;
        at = g_recent_n - 1;
    }
    while (at > 0) {
        g_recent[at] = g_recent[at - 1];
        at--;
    }
    g_recent[0] = row;
}

size_t rtx_cmd_recent(int *rows, size_t cap) {
    size_t i;
    for (i = 0; i < g_recent_n && i < cap; i++) rows[i] = g_recent[i];
    return i;
}

void rtx_cmd_recent_clear(void) {
    g_recent_n = 0;
}

size_t rtx_cmd_menu_rows(const char *menu, int *rows, size_t cap) {
    size_t i, n = rtx_cmd_n(), k = 0;
    if (!menu) return 0;
    for (i = 0; i < n && k < cap; i++) {
        const RtxCmdDef *d = rtx_cmd_at(i);
        if (!d->menu || strcmp(d->menu, menu) != 0) continue;
        if (d->flags & RTX_CMDF_RESERVED) continue;
        rows[k++] = (int)i;
    }
    return k;
}

/* ---- chords ----------------------------------------------------------- */

static const struct {
    const char *name;
    uint32_t key;
} g_key_names[] = {
    {"tab", RTX_KEY_TAB},       {"enter", RTX_KEY_ENTER},
    {"return", RTX_KEY_ENTER},  {"esc", RTX_KEY_ESC},
    {"escape", RTX_KEY_ESC},    {"backspace", RTX_KEY_BACKSPACE},
    {"delete", RTX_KEY_DELETE}, {"del", RTX_KEY_DELETE},
    {"insert", RTX_KEY_INSERT}, {"ins", RTX_KEY_INSERT},
    {"home", RTX_KEY_HOME},     {"end", RTX_KEY_END},
    {"pgup", RTX_KEY_PGUP},     {"pageup", RTX_KEY_PGUP},
    {"pgdn", RTX_KEY_PGDN},     {"pagedown", RTX_KEY_PGDN},
    {"up", RTX_KEY_UP},         {"down", RTX_KEY_DOWN},
    {"left", RTX_KEY_LEFT},     {"right", RTX_KEY_RIGHT},
    {"space", ' '},             {"plus", '+'},
    {"minus", '-'},             {"period", '.'},
    {"comma", ','},             {"slash", '/'},
    {"backslash", '\\'},        {"equal", '='},
};

static int chord_ieq(const char *a, size_t an, const char *b) {
    size_t i;
    for (i = 0; i < an; i++) {
        int x = (unsigned char)a[i], y = (unsigned char)b[i];
        if (!y) return 0;
        if (x >= 'A' && x <= 'Z') x = x - 'A' + 'a';
        if (x != y) return 0;
    }
    return b[an] == 0;
}

static uint32_t chord_key_of(const char *p, size_t n) {
    size_t i;
    if (n == 1) {
        int c = (unsigned char)p[0];
        if (c >= 'A' && c <= 'Z') c = c - 'A' + 'a';
        if (c > 0x20 && c < 0x7f) return (uint32_t)c;
        return 0;
    }
    if (n >= 2 && (p[0] == 'f' || p[0] == 'F')) {
        int v = 0;
        for (i = 1; i < n; i++) {
            if (p[i] < '0' || p[i] > '9') break;
            v = v * 10 + (p[i] - '0');
        }
        if (i == n && v >= 1 && v <= 12) return (uint32_t)(RTX_KEY_F1 + v - 1);
    }
    for (i = 0; i < sizeof(g_key_names) / sizeof(g_key_names[0]); i++)
        if (chord_ieq(p, n, g_key_names[i].name)) return g_key_names[i].key;
    return 0;
}

uint32_t rtx_chord_parse(const char *s, size_t n) {
    uint32_t mods = 0;
    size_t i = 0;
    while (n && (s[0] == ' ' || s[0] == '^')) {
        s++;
        n--;
    }
    while (n && s[n - 1] == ' ') n--;
    if (!s || !n) return 0;
    for (;;) {
        size_t j = i;
        size_t len;
        /* A part ends at '+' or '-' — but a lone '+' / '-' is the key. */
        while (j < n && !((s[j] == '+' || s[j] == '-') && j > i)) j++;
        len = j - i;
        if (j >= n) {
            uint32_t k = chord_key_of(s + i, len);
            if (!k) return 0;
            return k | mods;
        }
        if (chord_ieq(s + i, len, "ctrl") || chord_ieq(s + i, len, "control") ||
            chord_ieq(s + i, len, "cmd") || chord_ieq(s + i, len, "command") ||
            chord_ieq(s + i, len, "super") || chord_ieq(s + i, len, "mod") ||
            chord_ieq(s + i, len, "meta") || chord_ieq(s + i, len, "c"))
            mods |= RTX_CHORD_CTRL;
        else if (chord_ieq(s + i, len, "shift") || chord_ieq(s + i, len, "s"))
            mods |= RTX_CHORD_SHIFT;
        else if (chord_ieq(s + i, len, "alt") || chord_ieq(s + i, len, "opt") ||
                 chord_ieq(s + i, len, "option") || chord_ieq(s + i, len, "m"))
            mods |= RTX_CHORD_ALT;
        else
            return 0;
        i = j + 1;
        if (i >= n) return 0;
    }
}

static const char *chord_key_label(uint32_t k, char *one) {
    size_t i;
    if (k >= RTX_KEY_F1 && k < RTX_KEY_F1 + 12) {
        snprintf(one, 8, "F%u", (unsigned)(k - RTX_KEY_F1 + 1));
        return one;
    }
    switch (k) {
    case RTX_KEY_TAB: return "Tab";
    case RTX_KEY_ENTER: return "Enter";
    case RTX_KEY_ESC: return "Esc";
    case RTX_KEY_BACKSPACE: return "Backspace";
    case RTX_KEY_DELETE: return "Del";
    case RTX_KEY_INSERT: return "Ins";
    case RTX_KEY_HOME: return "Home";
    case RTX_KEY_END: return "End";
    case RTX_KEY_PGUP: return "PgUp";
    case RTX_KEY_PGDN: return "PgDn";
    case RTX_KEY_UP: return "Up";
    case RTX_KEY_DOWN: return "Down";
    case RTX_KEY_LEFT: return "Left";
    case RTX_KEY_RIGHT: return "Right";
    case ' ': return "Space";
    default: break;
    }
    (void)i;
    one[0] = (char)(k >= 'a' && k <= 'z' ? k - 'a' + 'A' : k);
    one[1] = 0;
    return one;
}

size_t rtx_chord_label(uint32_t chord, int host, char *dst, size_t n) {
    char one[8];
    int mac = 0;
    int w;
#if defined(__APPLE__)
    mac = host == RTX_HOST_GUI;
#endif
    (void)host;
    if (!dst || !n) return 0;
    dst[0] = 0;
    if (!chord) return 0;
    w = snprintf(dst, n, "%s%s%s%s",
                 (!mac && (chord & RTX_CHORD_CTRL)) ? "Ctrl-" : "",
                 (chord & RTX_CHORD_SHIFT) ? "Shift-" : "",
                 (chord & RTX_CHORD_ALT) ? "Alt-" : "",
                 (mac && (chord & RTX_CHORD_CTRL)) ? "Cmd-" : "");
    if (w < 0) w = 0;
    if ((size_t)w >= n) w = (int)n - 1;
    w += snprintf(dst + w, n - (size_t)w, "%s",
                  chord_key_label(chord & RTX_CHORD_KEY_MASK, one));
    if ((size_t)w >= n) w = (int)n - 1;
    return (size_t)w;
}

size_t rtx_chord_name(uint32_t chord, char *dst, size_t n) {
    char one[8];
    const char *k;
    char low[16];
    size_t i;
    int w;
    if (!dst || !n) return 0;
    dst[0] = 0;
    if (!chord) return 0;
    k = chord_key_label(chord & RTX_CHORD_KEY_MASK, one);
    for (i = 0; k[i] && i + 1 < sizeof low; i++)
        low[i] = (char)(k[i] >= 'A' && k[i] <= 'Z' ? k[i] - 'A' + 'a' : k[i]);
    low[i] = 0;
    w = snprintf(dst, n, "%s%s%s%s", (chord & RTX_CHORD_CTRL) ? "ctrl+" : "",
                 (chord & RTX_CHORD_SHIFT) ? "shift+" : "",
                 (chord & RTX_CHORD_ALT) ? "alt+" : "", low);
    if (w < 0) return 0;
    return (size_t)w >= n ? n - 1 : (size_t)w;
}
