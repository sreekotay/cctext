#!ccc ccs
/*
 * Command table (linked TU; see cmd.cch). Every command both hosts run,
 * with its id, title, keys and menu. The help overlay, key dispatch, the
 * GUI menus and the palette read these rows.
 */
#include <ccc/std/prelude.cch>
#include <stddef.h>
#include <stdint.h>
#include <stdio.h>
#include <string.h>
#include "cmd.cch"

static int cmd_gui_only(const RtxCmdCtx *c) {
    return c && (c->flags & RTX_CTX_GUI);
}

