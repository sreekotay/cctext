#!ccc ccs
/*
 * Scope intern table (linked TU; see scope.cch).
 */
#include <ccc/std/prelude.cch>
#include <string.h>
#include "scope.cch"

static const char *rtx_scope_tab[RTX_SCOPE_MAX];
static size_t rtx_scope_n;
/* Host overlays the front of the region; usable L1 is RTX_SCOPE_STORE. */
static uint8_t rtx_scope_store_buf[CC_ARENA_REGION_BYTES(RTX_SCOPE_STORE)];
static CCArena rtx_scope_store;
static int rtx_scope_store_ready;

static int rtx_scope_store_init(void) {
    if (rtx_scope_store_ready) return rtx_scope_store.base != NULL;
    rtx_scope_store = cc_arena_create_buffer(rtx_scope_store_buf,
                                             sizeof(rtx_scope_store_buf),
                                             CC_ARENA_FIXED);
    if (!rtx_scope_store.base) return 0;
    rtx_scope_store_ready = 1;
    return 1;
}

static int rtx_scope_intern_raw(const char *name, size_t n, RtxScope *out) {
    size_t i;
    char *copy;
    if (!out) return 0;
    if (!name || n == 0) {
        *out = RTX_SCOPE_NONE;
        return 1;
    }
    for (i = 1; i <= rtx_scope_n; i++) {
        if (rtx_scope_tab[i]) {
            char[:] tab = cc_slice_from_buffer((void *)rtx_scope_tab[i], n);
            char[:] nm = cc_slice_from_buffer((void *)name, n);
            if (tab.eq(nm)) {
                *out = (RtxScope)i;
                return 1;
            }
        }
    }
    if (rtx_scope_n + 1 >= RTX_SCOPE_MAX) return 0;
    if (!rtx_scope_store_init()) return 0;
    copy = (char *)cc_arena_alloc(rtx_scope_store, n + 1, 1);
    if (!copy) return 0;
    {
        char[:] dst = cc_slice_from_buffer(copy, n);
        char[:] src = cc_slice_from_buffer((void *)name, n);
        dst.copy(src) !>(e) { (void)e; return 0; };
    }
    copy[n] = 0;
    rtx_scope_n++;
    rtx_scope_tab[rtx_scope_n] = copy;
    *out = (RtxScope)rtx_scope_n;
    return 1;
}

int rtx_scope_put(RtxScope *out, const char *name) {
    return rtx_scope_intern_raw(name, name ? strlen(name) : 0, out);
}

const char *rtx_scope_name(RtxScope id) {
    if (id == RTX_SCOPE_NONE || id > rtx_scope_n) return "";
    return rtx_scope_tab[id] ? rtx_scope_tab[id] : "";
}

static int rtx_scope_has_prefix(RtxScope id, const char *prefix) {
    const char *s = rtx_scope_name(id);
    size_t n;
    if (!prefix || !prefix[0] || !s[0]) return 0;
    n = strlen(prefix);
    if (strncmp(s, prefix, n) != 0) return 0;
    return s[n] == 0 || s[n] == '.';
}

RtxHlKind rtx_scope_kind(RtxScope id) {
    if (id == RTX_SCOPE_NONE) return RTX_HL_NONE;
    if (rtx_scope_has_prefix(id, "comment") ||
        rtx_scope_has_prefix(id, "markup.quote")) {
        return RTX_HL_COMMENT;
    }
    if (rtx_scope_has_prefix(id, "string") ||
        rtx_scope_has_prefix(id, "markup.raw")) {
        return RTX_HL_STRING;
    }
    if (rtx_scope_has_prefix(id, "constant.numeric") ||
        rtx_scope_has_prefix(id, "constant")) {
        return RTX_HL_NUMBER;
    }
    if (rtx_scope_has_prefix(id, "keyword") ||
        rtx_scope_has_prefix(id, "storage") ||
        rtx_scope_has_prefix(id, "variable") ||
        rtx_scope_has_prefix(id, "entity.name") ||
        rtx_scope_has_prefix(id, "markup.heading") ||
        rtx_scope_has_prefix(id, "markup.bold") ||
        rtx_scope_has_prefix(id, "markup.italic") ||
        rtx_scope_has_prefix(id, "markup.underline")) {
        return RTX_HL_KEYWORD;
    }
    if (rtx_scope_has_prefix(id, "punctuation")) return RTX_HL_PUNCT;
    return RTX_HL_NONE;
}

/* Marks already painted by the window lex. Not a symbol index. */
int rtx_scope_is_invalid(RtxScope id) {
    return rtx_scope_has_prefix(id, "invalid");
}

int rtx_scope_is_heading(RtxScope id) {
    return rtx_scope_has_prefix(id, "markup.heading");
}

int rtx_scope_is_mark(RtxScope id) {
    if (id == RTX_SCOPE_NONE) return 0;
    if (rtx_scope_is_invalid(id)) return 0;
    if (rtx_scope_is_heading(id)) return 1;
    if (rtx_scope_has_prefix(id, "entity.name")) return 1;
    if (rtx_scope_has_prefix(id, "keyword")) return 1;
    if (rtx_scope_has_prefix(id, "storage")) return 1;
    return 0;
}

RtxThemeColor rtx_theme_color(RtxScope id) {
    RtxThemeColor z = {230, 230, 230, "\x1b[0m"};
    switch (rtx_scope_kind(id)) {
    case RTX_HL_KEYWORD:
        z.r = 80; z.g = 200; z.b = 220; z.ansi = "\x1b[36m";
        break;
    case RTX_HL_STRING:
        z.r = 120; z.g = 200; z.b = 120; z.ansi = "\x1b[32m";
        break;
    case RTX_HL_COMMENT:
        z.r = 140; z.g = 140; z.b = 140; z.ansi = "\x1b[90m";
        break;
    case RTX_HL_NUMBER:
        z.r = 220; z.g = 180; z.b = 80; z.ansi = "\x1b[33m";
        break;
    default:
        break;
    }
    return z;
}

RtxThemeColor rtx_theme_pair(void) {
    /* Sit just above the pane, not a yellow lamp. 256-color 58 is the
     * same olive when the terminal has no truecolor. */
    RtxThemeColor z = {42, 40, 24, "\x1b[48;5;58m"};
    return z;
}
