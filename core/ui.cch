#!ccc cch
/*
 * Shared modal UI: help overlay, jump-to-line, find panel, unsaved-quit.
 * Command ids and letter map live here; hosts map keys/menus onto CMD_*.
 * Find lists hits; the camera stays until the user selects one.
 */
#ifndef RTX_UI_H
#define RTX_UI_H

#include <stdio.h>
#include <string.h>
#include <time.h>
#include "utf8.cch"
#include "ui_types.cch"
#include "nav_pair.cch"
#include "batch.cch"

const char *rtx_help_line(size_t i);

/* Find / jump / browse field caret. Same clock; only these draw it. */
static const char *rtx_ui_prompt_caret(const RtxUi *ui) {
    return rtx_ui_blink(ui) ? "_" : " ";
}

static void rtx_ui_clear_jump(RtxUi *ui) {
    if (!ui) return;
    ui->jump = 0;
    ui->jump_len = 0;
    ui->jump_buf[0] = 0;
}

static void rtx_ui_cancel_jump(RtxUi *ui, RtxDoc *d) {
    if (d) rtx_line_want_cancel(&d->tree);
    rtx_ui_clear_jump(ui);
}

static void rtx_ui_clear_find(RtxUi *ui) {
    if (!ui) return;
    ui->find = 0;
}

static int rtx_cmd_from_letter(int c) {
    if (c >= 'A' && c <= 'Z') c = c - 'A' + 'a';
    switch (c) {
    case 'q': return CMD_QUIT;
    case 's': return CMD_SAVE;
    case 'z': return CMD_UNDO;
    case 'y': return CMD_REDO;
    case 'x': return CMD_CUT;
    case 'c': return CMD_COPY;
    case 'v': return CMD_PASTE;
    case 'w': return CMD_PANE;
    case 'n': return CMD_NEXT;
    case '\\': return CMD_SPLIT;
    case 'g': return CMD_JUMP;
    case 'f': return CMD_FIND;
    case 'b':
    case 'o': return CMD_BROWSE;
    case 'a': return CMD_SEL_ALL;
    case 'l': return CMD_VIEW;
    case 'u': return CMD_FOLLOW;
    case 'k': return CMD_NAV_NEXT;
    case 'p': return CMD_NAV_PREV;
    case 'e': return CMD_NAV_INV;
    case 'r': return CMD_NAV_INV_PREV;
    case 't': return CMD_FOLD;
    case '=': return CMD_STATS;
    default: return CMD_NONE;
    }
}

static int rtx_nav_from_cmd(int cmd) {
    if (cmd == CMD_NAV_NEXT) return 1;
    if (cmd == CMD_NAV_PREV) return 2;
    if (cmd == CMD_NAV_INV) return 3;
    if (cmd == CMD_NAV_INV_PREV) return 4;
    if (cmd == CMD_FOLD) return 5;
    return 0;
}

/* Unsaved-quit prompt. 0 = stay, 1 = save, 2 = discard, -1 = not a choice. */
static int rtx_ui_quit_letter(int ch) {
    if (ch == 'c' || ch == 'C') return 0;
    if (ch == 's' || ch == 'S') return 1;
    if (ch == 'q' || ch == 'Q' || ch == 'n' || ch == 'N' ||
        ch == 'd' || ch == 'D') return 2;
    return -1;
}

static void rtx_ui_toggle_help(RtxUi *ui) {
    if (!ui) return;
    ui->help = !ui->help;
    if (ui->help) ui->stats = 0;
}

static void rtx_ui_toggle_stats(RtxUi *ui) {
    if (!ui) return;
    ui->stats = !ui->stats;
    if (ui->stats) ui->help = 0;
}

static void rtx_ui_start_jump(RtxUi *ui, RtxDoc *d) {
    if (d) rtx_line_want_cancel(&d->tree);
    if (!ui) return;
    ui->help = 0;
    ui->find = 0;
    ui->jump = 1;
    ui->jump_len = 0;
    ui->jump_buf[0] = 0;
    rtx_ui_blink_show(ui);
}

static void rtx_ui_jump_header(const RtxUi *ui, const RtxDoc *d, char *dst, size_t n) {
    int pct;
    if (!dst || n == 0) return;
    pct = d ? rtx_line_want_pct(&d->tree) : -1;
    if (pct >= 0) {
        snprintf(dst, n, "jump line or N%%: %s  scanning... %d%%",
                 ui ? ui->jump_buf : "", pct);
        return;
    }
    snprintf(dst, n, "jump line or N%%: %s%s",
             ui ? ui->jump_buf : "",
             rtx_ui_prompt_caret(ui));
}

static RtxField rtx_ui_find_field(RtxUi *ui) {
    RtxField f = {0};
    if (!ui) return f;
    f.buf = ui->find_buf;
    f.len = &ui->find_len;
    f.cap = sizeof(ui->find_buf);
    f.caret = &ui->find_caret;
    f.sel = &ui->find_sel;
    return f;
}

static int !>(CCError) rtx_field_copy(RtxWs *w, RtxField f) {
    char[:] s;
    if (!w) return cc_err(CC_ERR_INVALID_ARG, "field copy");
    rtx_field_clamp(f);
    if (!rtx_field_has_sel(f)) return cc_ok(0);
    s = rtx_field_sel_bytes(f);
    w->set_clip(s) !>(e) { return cc_err(e); };
    return cc_ok(1);
}

static void !>(CCError) rtx_field_cut(RtxWs *w, RtxField f) {
    rtx_field_copy(w, f) !>(e) { return cc_err(e); };
    rtx_field_delete_sel(f);
    return cc_ok();
}

static void !>(CCError) rtx_field_paste(RtxWs *w, RtxField f) {
    if (!w) return cc_err(CC_ERR_INVALID_ARG, "field paste");
    if (!w->clip.ptr || w->clip.len == 0) return cc_ok();
    rtx_field_insert(f, w->clip.ptr, w->clip.len);
    return cc_ok();
}

/* Workspace clip only. Host loads OS clip before PASTE and syncs after COPY/CUT.
 * 1 = field text changed or a copy took bytes. */
static int !>(CCError) rtx_field_cmd(RtxWs *w, RtxField f, int cmd) {
    if (cmd == CMD_COPY) return rtx_field_copy(w, f);
    if (cmd == CMD_CUT) {
        rtx_field_cut(w, f) !>(e) { return cc_err(e); };
        return cc_ok(1);
    }
    if (cmd == CMD_PASTE) {
        rtx_field_paste(w, f) !>(e) { return cc_err(e); };
        return cc_ok(1);
    }
    if (cmd == CMD_SEL_ALL) {
        rtx_field_select_all(f);
        return cc_ok(0);
    }
    return cc_ok(0);
}

static void rtx_ui_start_find(RtxUi *ui, RtxDoc *d) {
    if (d) rtx_line_want_cancel(&d->tree);
    if (!ui) return;
    ui->help = 0;
    rtx_ui_clear_jump(ui);
    ui->find = 1;
    if (ui->find_len) rtx_field_select_all(rtx_ui_find_field(ui));
    else {
        ui->find_caret = 0;
        ui->find_sel = 0;
    }
    rtx_ui_blink_show(ui);
}

static int rtx_ui_find_rows(const RtxUi *ui, int rows) {
    int h = 0;
    if (ui && ui->find) h = RTX_UI_FIND_ROWS;
    if (h > rows - 2) h = rows - 2;
    if (h < 0) h = 0;
    return h;
}

static void rtx_ui_find_scroll(RtxUi *ui, const RtxDoc *d, size_t vis_hits) {
    if (!ui || !d || vis_hits == 0 || !d->find.pinned) return;
    if (d->find.cur < ui->find_top) ui->find_top = d->find.cur;
    if (d->find.cur >= ui->find_top + vis_hits) {
        ui->find_top = d->find.cur - vis_hits + 1;
    }
}

static int rtx_ui_find_pct(const RtxDoc *d) {
    if (!d || d->find.done || d->find.cancel || !d->find.query.len) return -1;
    return rtx_pct(d->find.scan_bytes, d->len());
}

static int rtx_ui_find_scanning(const RtxUi *ui, const RtxDoc *d) {
    return ui && ui->find && rtx_ui_find_pct(d) >= 0;
}

static void rtx_ui_fmt_bytes(char *dst, size_t n, size_t v) {
    if (!dst || n == 0) return;
    if (v >= (size_t)1024 * 1024 * 1024)
        snprintf(dst, n, "%.2f GiB", (double)v / (1024.0 * 1024.0 * 1024.0));
    else if (v >= (size_t)1024 * 1024)
        snprintf(dst, n, "%.2f MiB", (double)v / (1024.0 * 1024.0));
    else if (v >= 1024)
        snprintf(dst, n, "%.1f KiB", (double)v / 1024.0);
    else
        snprintf(dst, n, "%zu B", v);
}

static void rtx_ui_fmt_pct(char *dst, size_t n, size_t a, size_t b) {
    if (!dst || n == 0) return;
    if (!b) {
        snprintf(dst, n, "-");
        return;
    }
    snprintf(dst, n, "%.1f%%", (double)a * 100.0 / (double)b);
}

static void rtx_ui_find_stats(const RtxDoc *d, char *dst, size_t n) {
    char offb[16];
    char totb[16];
    int pct;
    size_t hits;
    size_t cur;
    if (!dst || n == 0) return;
    hits = d ? d->find.len : 0;
    cur = d && d->find.pinned && hits ? d->find.cur + 1 : 0;
    pct = rtx_ui_find_pct(d);
    if (pct >= 0) {
        rtx_ui_fmt_bytes(offb, sizeof(offb), d->find.scan_bytes);
        rtx_ui_fmt_bytes(totb, sizeof(totb), d->len());
        snprintf(dst, n, "%zu/%zu  scanning... %d%%  %s/%s%s",
                 cur, hits, pct, offb, totb,
                 d->find.truncated ? "  capped" : "");
        return;
    }
    snprintf(dst, n, "%zu/%zu%s",
             cur, hits, d && d->find.truncated ? "  capped" : "");
}

static size_t rtx_ui_sanitize(char[:] src, char *dst, size_t dstn) {
    size_t o = 0;
    if (!dst || dstn == 0) return 0;
    @for (ch in src) {
        unsigned char c;
        if (o + 1 >= dstn) break;
        c = (unsigned char)ch;
        if (c == '\t' || c == '\n' || c == '\r') c = ' ';
        else if (c < 32) c = '?';
        dst[o++] = (char)c;
    }
    dst[o] = 0;
    return o;
}

static void !>(CCError) rtx_ui_find_row_text(RtxDoc *d, size_t hit, size_t ctxn,
                                            char *dst, size_t dstn, size_t *line1) {
    RtxFindHitView v;
    cc_arena_stack(scratch, RTX_FRAME_SCRATCH);
    if (!d || !dst || !line1) return cc_err(CC_ERR_INVALID_ARG, "find row");
    d->find_hit_view(hit, scratch, ctxn, &v) !>(e) { return cc_err(e); };
    *line1 = v.line1;
    rtx_ui_sanitize(v.ctx, dst, dstn);
    return cc_ok();
}

static char[:] rtx_ui_find_query(const RtxUi *ui) {
    if (!ui || ui->find_len == 0) return cc_slice_empty();
    return ui->find_buf.to_slice_n(ui->find_len);
}

static void !>(CCError) rtx_ui_find_apply(RtxUi *ui, RtxDoc *d) {
    char[:] q;
    if (!ui || !d) return cc_err(CC_ERR_INVALID_ARG, "find apply");
    q = rtx_ui_find_query(ui);
    if (!d->find_same_query(q)) d->find_set(q) !>(e) { return cc_err(e); };
    d->find.cancel = 0;
    rtx_find_mark_near(d);
    return cc_ok();
}

/* Dest-live scan: kick if an edit dropped the handle, then mark the list. */
static void !>(CCError) rtx_ui_find_pump(RtxUi *ui, RtxDoc *d) {
    if (!ui || !ui->find || !d) return cc_ok();
    if (!d->find.done && !d->find.cancel)
        d->find_step() !>(e) { return cc_err(e); };
    rtx_find_mark_near(d);
    return cc_ok();
}

static int rtx_ui_find_char(RtxUi *ui, int ch) {
    if (!ui || !ui->find) return 0;
    return rtx_field_type_cp(rtx_ui_find_field(ui), (uint32_t)ch);
}

static void rtx_ui_find_backspace(RtxUi *ui) {
    if (!ui) return;
    rtx_field_backspace(rtx_ui_find_field(ui));
}

/* Viewport only — caret stays. Text snaps to the line at `off` (like jump %). */
static void !>(RtxIndexErr) RtxBuf_scroll_to_off(RtxBuf *b, size_t off) {
    size_t n;
    if (!b) return cc_ok();
    b->pin_view = 1;
    n = b->len();
    if (off > n) off = n;
    if (rtx_layout_is_hex(&b->layout)) {
        b->top_byte = rtx_hex_align(off);
        b->seek_valid = 0;
        return cc_ok();
    }
    {
        size_t floor = rtx_doc_line_floor(&b->doc, off) !>(e) { return cc_err(e); };
        rtx_buf_seek_set(b, floor);
    }
    b->top_wrap = 0;
    return cc_ok();
}

static void rtx_status_line_scan(const RtxDoc *d, char *dst, size_t dst_n) {
    size_t n;
    int pct;
    if (!d || !dst || dst_n == 0) return;
    pct = rtx_line_isle_pct(&d->tree);
    if (pct < 0) return;
    n = strlen(dst);
    if (n + 20 < dst_n)
        snprintf(dst + n, dst_n - n, "  scanning... %d%%", pct);
}

/* Status fragment: exact L, or +N in a gap until the island meets the prefix. */
static void !>(RtxIndexErr) rtx_status_line_pos(const RtxBuf *b, char *dst, size_t dst_n) {
    size_t cur, plus, abs, i;
    const RtxDoc *d;
    if (!dst || dst_n == 0) return cc_ok();
    d = b ? &b->doc : NULL;
    if (!d) {
        snprintf(dst, dst_n, "L1");
        return cc_ok();
    }
    plus = 1;
    abs = 0;
    if (b->layout.rows.len) {
        const RtxVisRow *use = NULL;
        for (i = 0; i < b->layout.rows.len; i++) {
            const RtxVisRow *row = &b->layout.rows.data[i];
            if (d->caret >= row->byte_start &&
                d->caret <= row->byte_start + row->byte_len) {
                use = row;
                break;
            }
        }
        /* Seek is the camera. Caret at BOF must not print L1 on a mid-file
         * window — that is the island label, not line_of(caret). */
        if (!use && b->seek_valid) use = &b->layout.rows.data[0];
        if (use) {
            int gap = rtx_gutter_gap(b, use->byte_start, use->line, &abs, &plus);
            if (gap) {
                snprintf(dst, dst_n, gap < 0 ? "-%zu" : "+%zu", plus);
                rtx_status_line_scan(d, dst, dst_n);
                return cc_ok();
            }
            cur = abs;
            if (d->index_fault()) {
                snprintf(dst, dst_n, "L%zu!", cur);
            } else if (d->lf_ready()) {
                snprintf(dst, dst_n, "L%zu/%zu", cur, d->line_count());
            } else {
                snprintf(dst, dst_n, "L%zu", cur);
            }
            rtx_status_line_scan(d, dst, dst_n);
            return cc_ok();
        }
    }
    if (!d->index_covers(d->caret) &&
        !rtx_line_mark_ok(&d->tree)) {
        snprintf(dst, dst_n, "+1");
        rtx_status_line_scan(d, dst, dst_n);
        return cc_ok();
    }
    if (d->index_covers(d->caret) && !b->seek_valid)
        cur = d->line_of(d->caret) !>(e) { return cc_err(e); };
    else
        cur = rtx_isle_cam_line(b);
    cur = cur + 1;
    if (d->index_fault()) {
        snprintf(dst, dst_n, "L%zu!", cur);
    } else if (d->lf_ready()) {
        snprintf(dst, dst_n, "L%zu/%zu", cur, d->line_count());
    } else {
        snprintf(dst, dst_n, "L%zu", cur);
    }
    rtx_status_line_scan(d, dst, dst_n);
    return cc_ok();
}

static void !>(RtxIndexErr) rtx_doc_goto_line_known(RtxDoc *d, size_t line1) {
    size_t known;
    if (!d) return cc_ok();
    if (line1 < 1) line1 = 1;
    if (d->lf_ready()) {
        size_t n = d->line_count();
        if (n && line1 > n) line1 = n;
    } else {
        known = rtx_line_known_now(&d->tree);
        if (known && line1 > known) line1 = known;
    }
    d->caret = d->line_start(line1 - 1) !>(e) { return cc_err(e); };
    d->sel_anchor = d->caret;
    d->break_coalesce();
    return cc_ok();
}

static void !>(RtxIndexErr) RtxDoc_goto_line(RtxDoc *d, size_t line1) {
    if (!d) return cc_ok();
    if (line1 < 1) line1 = 1;
    rtx_line_isle_cancel(&d->tree);
    if (d->lf_ready() || rtx_line_known_now(&d->tree) >= line1) {
        rtx_line_want_cancel(&d->tree);
        return rtx_doc_goto_line_known(d, line1);
    }
    rtx_line_want_kick(&d->tree, line1);
    return cc_ok();
}

/* Dest-live island: kick if an edit dropped the handle. Do not step
 * on the UI thread (same gate as find). */
static void rtx_ui_line_isle_pump(RtxDoc *d, int (*yield)(void)) {
    (void)yield;
    if (!d || !rtx_line_isle_pumping(&d->tree)) return;
    (void)rtx_line_isle_step(&d->tree, 0);
}

/* Commit the dest camera before the prefix scan finishes: line L at the
 * top, gutter already sized. Caret stays put; pin so reveal cannot
 * snap top back to the old line. */
static void rtx_ui_jump_arm_cam(RtxBuf *b, size_t line1) {
    if (!b) return;
    if (line1 < 1) line1 = 1;
    b->top = line1 - 1;
    b->top_wrap = 0;
    b->seek_valid = 0;
    b->pin_view = 1;
    b->layout.clear_rows();
    b->layout_width = 0;
}

/* Jump: digits = 1-based line. Digits then '%' = that percent of the file
 * by byte. Text snaps to the line start with a local read — no prefix
 * line_of. Hex keeps the byte. Soft line_count is not used for %. */
static int !>(RtxIndexErr) rtx_ui_apply_jump(RtxUi *ui, RtxBuf *b, int vis) {
    size_t val = 0;
    size_t i;
    int pct = 0;
    RtxDoc *d;
    @errhandler(RtxIndexErr e) {
        return cc_err(e);
    }
    d = b ? &b->doc : NULL;
    if (!ui || !d || ui->jump_len == 0) {
        rtx_ui_clear_jump(ui);
        return cc_ok(0);
    }
    for (i = 0; i < ui->jump_len; i++) {
        char c = ui->jump_buf[i];
        if (c >= '0' && c <= '9' && !pct) {
            val = val * 10 + (size_t)(c - '0');
        } else if (c == '%' && !pct && i > 0) {
            pct = 1;
        } else {
            rtx_ui_clear_jump(ui);
            return cc_ok(0);
        }
    }
    if (pct) {
        size_t n = d->len();
        size_t off;
        if (val > 100) val = 100;
        off = n ? (size_t)(((unsigned long long)(n - 1) * val) / 100ull) : 0;
        if (rtx_layout_is_hex(&b->layout)) {
            d->caret = off;
            d->sel_anchor = off;
            d->break_coalesce();
            rtx_line_isle_cancel(&d->tree);
            rtx_ui_clear_jump(ui);
            b->reveal_off(d->caret, vis) !>;
            return cc_ok(1);
        }
        d->caret = rtx_doc_line_floor(&b->doc, off) !>;
        d->sel_anchor = d->caret;
        d->break_coalesce();
        rtx_line_isle_kick(&d->tree, d->caret);
        rtx_ui_clear_jump(ui);
        b->land(vis) !>;
        return cc_ok(1);
    } else {
        rtx_line_isle_cancel(&d->tree);
        d->goto_line(val) !>;
        if (rtx_line_want_pumping(&d->tree)) {
            rtx_line_want_step(&d->tree, (size_t)RTX_LINE_ISLE_BUDGET);
            if (rtx_line_want_pumping(&d->tree)) {
                rtx_ui_jump_arm_cam(b, val);
                return cc_ok(1);
            }
            {
                size_t line1 = d->tree.want_line;
                rtx_line_want_cancel(&d->tree);
                rtx_doc_goto_line_known(d, line1) !>;
            }
        }
    }
    rtx_ui_clear_jump(ui);
    b->land(vis) !>;
    return cc_ok(1);
}

/* Same host gate as the island: 256 KiB waves until WORK_MS or a key.
 * Find's PUMP=8 is for miss-heavy search — a prefix LF scan can eat the
 * whole slice. Progress stays on the jump row. */
static void !>(RtxIndexErr) rtx_ui_jump_pump(RtxUi *ui, RtxBuf *b, int vis,
                                            int (*yield)(void)) {
    RtxPieceTree *t;
    long t0;
    size_t line1;
    @errhandler(RtxIndexErr e) {
        return cc_err(e);
    }
    if (!ui || !ui->jump || !b) return cc_ok();
    t = &b->doc.tree;
    if (!t->want_line) return cc_ok();
    t0 = rtx_ui_now_ms();
    for (;;) {
        if (rtx_line_want_reached(t)) break;
        if (yield && yield()) break;
        if (rtx_ui_now_ms() - t0 >= (long)RTX_LINE_ISLE_WORK_MS) break;
        if (!rtx_line_want_step(t, (size_t)RTX_LINE_ISLE_BUDGET)) break;
    }
    if (!rtx_line_want_reached(t)) return cc_ok();
    line1 = t->want_line;
    rtx_line_want_cancel(t);
    rtx_doc_goto_line_known(&b->doc, line1) !>;
    rtx_ui_clear_jump(ui);
    b->land(vis) !>;
    return cc_ok();
}

/* Host-step walks that own the frame clock. Dest-live find / island
 * do not — treating them as pumping set TUI timeout 0 and paused the
 * worker around chrome every spin. */
static int rtx_ui_work_pumping(const RtxUi *ui, const RtxDoc *d) {
    if (!d) return 0;
    return ui && ui->jump && rtx_line_want_pumping(&d->tree);
}

static void !>(RtxIndexErr) rtx_ui_work_pump(RtxUi *ui, RtxBuf *b, int vis,
                                            int (*yield)(void)) {
    @errhandler(CCError e) {
        return cc_err(rtx_index_from_cc(e));
    }
    @errhandler(RtxIndexErr e) {
        return cc_err(e);
    }
    if (ui && b && ui->find) rtx_ui_find_pump(ui, &b->doc) !>;
    if (ui && b && ui->jump) rtx_ui_jump_pump(ui, b, vis, yield) !>;
    if (b) rtx_ui_line_isle_pump(&b->doc, yield);
    return cc_ok();
}

/* 1 = clean, quit now. 0 = ask_quit is set. */
static int rtx_ui_offer_quit(RtxWs *w, RtxUi *ui) {
    size_t i;
    if (!w || !ui) return 1;
    /* Camera (view / caret) is not an edit. Flush even when clean. */
    w->safe_flush_all();
    if (!w->any_dirty()) return 1;
    for (i = 0; i < w->len; i++) {
        if (w->bufs[i].parked) continue;
        rtx_line_want_cancel(&w->bufs[i].doc.tree);
    }
    ui->help = 0;
    ui->jump = 0;
    ui->find = 0;
    ui->ask_quit = 1;
    return 0;
}

static void rtx_ui_jump_backspace(RtxUi *ui, RtxDoc *d) {
    if (d) rtx_line_want_cancel(&d->tree);
    if (!ui || ui->jump_len == 0) return;
    ui->jump_buf[--ui->jump_len] = 0;
}

static int rtx_ui_jump_char(RtxUi *ui, RtxDoc *d, int ch) {
    if (!ui || !ui->jump) return 0;
    if (d) rtx_line_want_cancel(&d->tree);
    if (ch >= '0' && ch <= '9' && ui->jump_len + 1 < sizeof(ui->jump_buf)) {
        /* Digits only before '%'. */
        size_t i;
        for (i = 0; i < ui->jump_len; i++) {
            if (ui->jump_buf[i] == '%') return 0;
        }
        ui->jump_buf[ui->jump_len++] = (char)ch;
        ui->jump_buf[ui->jump_len] = 0;
        return 1;
    }
    if (ch == '%' && ui->jump_len > 0 && ui->jump_len + 1 < sizeof(ui->jump_buf)) {
        size_t i;
        for (i = 0; i < ui->jump_len; i++) {
            if (ui->jump_buf[i] == '%') return 0;
        }
        ui->jump_buf[ui->jump_len++] = '%';
        ui->jump_buf[ui->jump_len] = 0;
        return 1;
    }
    return 0;
}

#ifndef RTX_VERSION
#define RTX_VERSION "0.1"
#endif

enum { RTX_CLI_MAX = 32, RTX_CLI_CMD_MAX = 64 };

typedef struct {
    int view;     /* sticky RTX_VIEW_* for the next file (and the default file) */
    int view_set; /* 1 after --wrap/--hex/--grid/--view (journal view otherwise) */
    int help;
    int version;
    int no_blink;
    int backup;
    int stats_json; /* dump engine stats JSON on exit */
    int batch;      /* headless command runner */
    int safe;       /* with --batch: keep Safe journals (off by default) */
    int ncmds;
    char *cmds[RTX_CLI_CMD_MAX];
    int nfiles;
    int file_view[RTX_CLI_MAX];
    int file_view_set[RTX_CLI_MAX];
} RtxCli;

static void rtx_ui_write_stats_json(FILE *fp, const RtxBuf *b) {
    rtx_batch_write_stats_json(fp, b);
}

static int rtx_cli_view_of(const char *s) {
    if (!s || !s[0]) return -1;
    if (strcmp(s, "default") == 0 || strcmp(s, "text") == 0) return RTX_VIEW_DEFAULT;
    if (strcmp(s, "wrap") == 0) return RTX_VIEW_WRAP;
    if (strcmp(s, "hex") == 0) return RTX_VIEW_HEX;
    if (strcmp(s, "grid") == 0 || strcmp(s, "csv") == 0) return RTX_VIEW_GRID;
    return -1;
}

static void rtx_cli_usage(FILE *fp, const char *prog) {
    if (!fp) fp = stderr;
    if (!prog || !prog[0]) prog = "cctext";
    fprintf(fp, "usage: %s [options] [file ...]\n", prog);
    fprintf(fp, "  (no files: open the file browser; missing files ask to create)\n");
    fprintf(fp, "  -h, --help                 this message\n");
    fprintf(fp, "  -v, --version              print version (%s)\n", RTX_VERSION);
    fprintf(fp, "  --no-blink                 solid caret (no blink)\n");
    fprintf(fp, "  --backup                   save in place (keep symlink); path~ is dirty span\n");
    fprintf(fp, "  --stats-json               print engine stats JSON on exit\n");
    fprintf(fp, "  --batch                    run -c / stdin cmds (no TTY)\n");
    fprintf(fp, "  -c CMD                     batch command (repeatable)\n");
    fprintf(fp, "  --safe                     with --batch: keep Safe journals\n");
    fprintf(fp, "  --wrap                     wrap view for the following files\n");
    fprintf(fp, "  batch cmds: goto @N / N%% / LN, await index|island, print [N],\n");
    fprintf(fp, "              read @off n, insert TEXT, save, stats-json, quit\n");
    fprintf(fp, "  --hex                      hex view for the following files\n");
    fprintf(fp, "  --grid                     column view for the following files\n");
    fprintf(fp, "  --view=default|wrap|hex|grid    view for the following files\n");
    fprintf(fp, "  --                         end of options\n");
}

static void rtx_cli_print_version(FILE *fp, const char *prog) {
    const char *slash;
    if (!fp) fp = stdout;
    if (!prog || !prog[0]) prog = "cctext";
    slash = strrchr(prog, '/');
    if (slash && slash[1]) prog = slash + 1;
    fprintf(fp, "%s %s\n", prog, RTX_VERSION);
}

/* Fill files[0..nfiles). 0 = ok (help sets cli->help), 1 = usage error. */
static int rtx_cli_parse(int argc, char **argv, char **files, int max_files,
                         RtxCli *cli) {
    int i;
    int end = 0;
    if (!cli || !files || max_files < 1) return 1;
    *cli = (RtxCli){0};
    cli->view = RTX_VIEW_DEFAULT;
    for (i = 1; i < argc; i++) {
        const char *a = argv[i];
        int v;
        if (!a) continue;
        if (!end && strcmp(a, "--") == 0) {
            end = 1;
            continue;
        }
        if (!end && a[0] == '-' && a[1]) {
            if (strcmp(a, "-h") == 0 || strcmp(a, "--help") == 0) {
                cli->help = 1;
                return 0;
            }
            if (strcmp(a, "-v") == 0 || strcmp(a, "--v") == 0 ||
                strcmp(a, "--version") == 0) {
                cli->version = 1;
                return 0;
            }
            if (strcmp(a, "--no-blink") == 0) {
                cli->no_blink = 1;
                continue;
            }
            if (strcmp(a, "--backup") == 0) {
                cli->backup = 1;
                continue;
            }
            if (strcmp(a, "--stats-json") == 0) {
                cli->stats_json = 1;
                continue;
            }
            if (strcmp(a, "--batch") == 0) {
                cli->batch = 1;
                continue;
            }
            if (strcmp(a, "--safe") == 0) {
                cli->safe = 1;
                continue;
            }
            if (strcmp(a, "-c") == 0) {
                if (i + 1 >= argc) {
                    fprintf(stderr, "-c needs a command\n");
                    return 1;
                }
                if (cli->ncmds >= RTX_CLI_CMD_MAX) {
                    fprintf(stderr, "too many -c commands\n");
                    return 1;
                }
                cli->cmds[cli->ncmds++] = argv[++i];
                continue;
            }
            if (strcmp(a, "--wrap") == 0) {
                cli->view = RTX_VIEW_WRAP;
                cli->view_set = 1;
                continue;
            }
            if (strcmp(a, "--hex") == 0) {
                cli->view = RTX_VIEW_HEX;
                cli->view_set = 1;
                continue;
            }
            if (strcmp(a, "--grid") == 0) {
                cli->view = RTX_VIEW_GRID;
                cli->view_set = 1;
                continue;
            }
            if (strncmp(a, "--view=", 7) == 0) {
                v = rtx_cli_view_of(a + 7);
                if (v < 0) {
                    fprintf(stderr, "unknown --view (default|wrap|hex|grid)\n");
                    return 1;
                }
                cli->view = v;
                cli->view_set = 1;
                continue;
            }
            if (strcmp(a, "--view") == 0) {
                if (i + 1 >= argc) {
                    fprintf(stderr, "--view needs default|wrap|hex|grid\n");
                    return 1;
                }
                v = rtx_cli_view_of(argv[++i]);
                if (v < 0) {
                    fprintf(stderr, "unknown --view (default|wrap|hex|grid)\n");
                    return 1;
                }
                cli->view = v;
                cli->view_set = 1;
                continue;
            }
            fprintf(stderr, "unknown option: %s\n", a);
            return 1;
        }
        if (cli->nfiles >= max_files || cli->nfiles >= RTX_CLI_MAX) {
            fprintf(stderr, "too many files\n");
            return 1;
        }
        cli->file_view[cli->nfiles] = cli->view;
        cli->file_view_set[cli->nfiles] = cli->view_set;
        files[cli->nfiles++] = argv[i];
    }
    return 0;
}

/* CLI --view overrides the journal; otherwise keep the restored camera. */
static void rtx_cli_apply_views(RtxWs *w, const RtxCli *cli) {
    int i;
    if (!w || !cli) return;
    if (cli->nfiles == 0) {
        if (cli->view_set && w->len) {
            rtx_layout_set_view(&w->bufs[0].layout, cli->view);
            rtx_buf_grid_bind(&w->bufs[0]);
        } else {
            for (i = 0; i < (int)w->len; i++) rtx_buf_grid_bind(&w->bufs[i]);
        }
        return;
    }
    for (i = 0; i < cli->nfiles && i < (int)w->len; i++) {
        if (cli->file_view_set[i])
            rtx_layout_set_view(&w->bufs[i].layout, cli->file_view[i]);
        rtx_buf_grid_bind(&w->bufs[i]);
    }
}

#endif /* RTX_UI_H */
