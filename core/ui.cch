/*
 * Shared modal UI: help overlay, jump-to-line, find panel, unsaved-quit.
 * Find mode pins the caret to find.cur while the panel is open.
 */
#ifndef RTX_UI_H
#define RTX_UI_H

enum { RTX_UI_FIND_ROWS = 8 };

static const char *rtx_help_lines[] = {
    "Esc          toggle this menu",
    "g  Ctrl-G/J  jump to line",
    "f  Ctrl-F    find",
    "s  Ctrl-S    save",
    "a  Ctrl-A    select all",
    "z  Ctrl-Z    undo",
    "y  Ctrl-Y    redo",
    "x  Ctrl-X    cut",
    "c  Ctrl-C    copy",
    "v  Ctrl-V    paste",
    "w  Ctrl-W    other pane",
    "n  Ctrl-N    next file",
    "\\  Ctrl-\\    split",
    "l  Ctrl-L    wrap lines",
    "q  Ctrl-Q    quit  (asks if unsaved)",
    "arrows       move   shift-arrows select",
    "Alt-arrows   box (column) select",
    "End then up/down stays on each line end",
    "Cmd-arrows   start/end of line",
    "click/drag   caret / selection   Alt-drag box",
    "wheel        scroll",
    NULL
};

typedef struct {
    int help;
    int jump;
    char jump_buf[16];
    size_t jump_len;
    int find;
    char find_buf[RTX_FIND_QMAX];
    size_t find_len;
    size_t find_top;
    int ask_quit;
} RtxUi;

static void rtx_ui_clear_jump(RtxUi *ui) {
    if (!ui) return;
    ui->jump = 0;
    ui->jump_len = 0;
    ui->jump_buf[0] = 0;
}

static void rtx_ui_clear_find(RtxUi *ui) {
    if (!ui) return;
    ui->find = 0;
}

static void rtx_ui_start_jump(RtxUi *ui) {
    if (!ui) return;
    ui->help = 0;
    ui->find = 0;
    ui->jump = 1;
    ui->jump_len = 0;
    ui->jump_buf[0] = 0;
}

static void rtx_ui_start_find(RtxUi *ui) {
    if (!ui) return;
    ui->help = 0;
    rtx_ui_clear_jump(ui);
    ui->find = 1;
}

static int rtx_ui_find_rows(const RtxUi *ui, int rows) {
    int h = 0;
    if (ui && ui->find) h = RTX_UI_FIND_ROWS;
    if (h > rows - 2) h = rows - 2;
    if (h < 0) h = 0;
    return h;
}

static void rtx_ui_find_scroll(RtxUi *ui, const RtxDoc *d, size_t vis_hits) {
    if (!ui || !d || vis_hits == 0) return;
    if (d->find.cur < ui->find_top) ui->find_top = d->find.cur;
    if (d->find.cur >= ui->find_top + vis_hits) {
        ui->find_top = d->find.cur - vis_hits + 1;
    }
}

static void rtx_ui_find_header(const RtxUi *ui, const RtxDoc *d, char *dst, size_t n) {
    if (!dst || n == 0) return;
    snprintf(dst, n, "find: %s_  %zu/%zu%s%s",
             ui ? ui->find_buf : "",
             d && d->find.len ? d->find.cur + 1 : 0,
             d ? d->find.len : 0,
             d && !d->find.done ? "  scanning..." : "",
             d && d->find.truncated ? "  capped" : "");
}

static size_t rtx_ui_sanitize(char[:] src, char *dst, size_t dstn) {
    size_t i;
    size_t o = 0;
    if (!dst || dstn == 0) return 0;
    for (i = 0; i < src.len && o + 1 < dstn; i++) {
        unsigned char c = (unsigned char)src.ptr[i];
        if (c == '\t' || c == '\n' || c == '\r') c = ' ';
        else if (c < 32) c = '?';
        dst[o++] = (char)c;
    }
    dst[o] = 0;
    return o;
}

static void !>(CCError) rtx_ui_find_row_text(RtxDoc *d, size_t hit, size_t ctxn,
                                            char *dst, size_t dstn, size_t *line1) {
    RtxFindHitView v;
    cc_arena_stack(scratch, RTX_FRAME_SCRATCH);
    if (!d || !dst || !line1) return cc_err(CC_ERR_INVALID_ARG, "find row");
    d->find_hit_view(hit, &scratch, ctxn, &v) !>(e) { return cc_err(e); };
    *line1 = v.line1;
    rtx_ui_sanitize(v.ctx, dst, dstn);
    return cc_ok();
}

static char[:] rtx_ui_find_query(const RtxUi *ui) {
    if (!ui || ui->find_len == 0) return cc_slice_empty();
    return ui->find_buf.to_slice_n(ui->find_len);
}

static void !>(CCError) rtx_ui_find_apply(RtxUi *ui, RtxDoc *d) {
    char[:] q;
    if (!ui || !d) return cc_err(CC_ERR_INVALID_ARG, "find apply");
    q = rtx_ui_find_query(ui);
    if (!d->find_same_query(q)) d->find_set(q) !>(e) { return cc_err(e); };
    d->find_step(RTX_FIND_BUDGET) !>(e) { return cc_err(e); };
    if (d->find.len) d->find_goto(d->find.cur);
    return cc_ok();
}

/*
 * Advance the scan one budget. Re-assert find.cur so a click in the
 * buffer cannot steal the selection while the panel is open.
 */
static void !>(CCError) rtx_ui_find_pump(RtxUi *ui, RtxDoc *d) {
    if (!ui || !ui->find || !d) return cc_ok();
    if (!d->find.done) d->find_step(RTX_FIND_BUDGET) !>(e) { return cc_err(e); };
    if (d->find.len) d->find_goto(d->find.cur);
    return cc_ok();
}

static int rtx_ui_find_char(RtxUi *ui, int ch) {
    if (!ui || !ui->find) return 0;
    if (ch >= 32 && ch < 127 && ui->find_len + 1 < sizeof(ui->find_buf)) {
        ui->find_buf[ui->find_len++] = (char)ch;
        ui->find_buf[ui->find_len] = 0;
        return 1;
    }
    return 0;
}

static int rtx_gutter_cols(size_t nlines) {
    int w = 1;
    if (nlines == 0) nlines = 1;
    while (nlines >= 10) {
        nlines /= 10;
        w++;
    }
    return w + 1;
}

static void RtxDoc_goto_line(RtxDoc *d, size_t line1) {
    size_t n;
    if (!d) return;
    n = d->line_count();
    if (n == 0) return;
    if (line1 < 1) line1 = 1;
    if (line1 > n) line1 = n;
    d->caret = d->line_start(line1 - 1);
    d->sel_anchor = d->caret;
    d->break_coalesce();
}

static int rtx_ui_apply_jump(RtxUi *ui, RtxDoc *d) {
    size_t line = 0;
    size_t i;
    if (!ui || !d || ui->jump_len == 0) {
        rtx_ui_clear_jump(ui);
        return 0;
    }
    for (i = 0; i < ui->jump_len; i++) {
        line = line * 10 + (size_t)(ui->jump_buf[i] - '0');
    }
    d->goto_line(line);
    rtx_ui_clear_jump(ui);
    return 1;
}

/* 1 = clean, quit now. 0 = ask_quit is set. */
static int rtx_ui_offer_quit(const RtxWs *w, RtxUi *ui) {
    if (!w || !ui) return 1;
    if (!w->any_dirty()) return 1;
    ui->help = 0;
    ui->jump = 0;
    ui->find = 0;
    ui->ask_quit = 1;
    return 0;
}

static int rtx_ui_jump_char(RtxUi *ui, int ch) {
    if (!ui || !ui->jump) return 0;
    if (ch >= '0' && ch <= '9' && ui->jump_len + 1 < sizeof(ui->jump_buf)) {
        ui->jump_buf[ui->jump_len++] = (char)ch;
        ui->jump_buf[ui->jump_len] = 0;
        return 1;
    }
    return 0;
}

#endif /* RTX_UI_H */
