#!ccc cch
/*
 * Shared modal UI: help overlay, jump-to-line, find panel, unsaved-quit.
 * Find mode pins the caret to find.cur while the panel is open.
 */
#ifndef RTX_UI_H
#define RTX_UI_H

#include <stdio.h>
#include <string.h>
#include <time.h>

enum {
    RTX_UI_FIND_ROWS = 8,
    RTX_UI_BLINK_MS = 400
};

static const char *rtx_help_lines[] = {
    "Esc          toggle this menu",
    "g  Ctrl-G/J  jump to line (or N%)",
    "f  Ctrl-F    find",
    "o  Ctrl-O    browse files in this view",
    "s  Ctrl-S    save",
    "a  Ctrl-A    select all",
    "z  Ctrl-Z    undo",
    "y  Ctrl-Y    redo",
    "x  Ctrl-X    cut",
    "c  Ctrl-C    copy",
    "v  Ctrl-V    paste",
    "w  Ctrl-W    other pane",
    "n  Ctrl-N    next file",
    "\\  Ctrl-\\    split",
    "l  Ctrl-L    cycle view (default / wrap / hex)",
    "u  Ctrl-U    follow lock (on / free scroll)",
    "q  Ctrl-Q    quit  (asks if unsaved)",
    "arrows       move   shift-arrows select",
    "Alt-arrows   box (column) select",
    "End then up/down stays on each line end",
    "Cmd-arrows   start/end of line",
    "click/drag   caret / selection   Alt-drag box",
    "wheel        scroll",
    "scrollbar    jump by file bytes",
    NULL
};

typedef struct {
    int help;
    int jump;
    char jump_buf[16];
    size_t jump_len;
    int find;
    char find_buf[RTX_FIND_QMAX];
    size_t find_len;
    size_t find_top;
    int ask_quit;
    int blink;           /* 1 = caret / prompt visible */
    long blink_at;       /* monotonic ms; 0 = not started (visible) */
} RtxUi;

static long rtx_ui_now_ms(void) {
    struct timespec ts;
    clock_gettime(CLOCK_MONOTONIC, &ts);
    return (long)ts.tv_sec * 1000 + ts.tv_nsec / 1000000;
}

static void rtx_ui_blink_show(RtxUi *ui) {
    if (!ui) return;
    ui->blink = 1;
    ui->blink_at = rtx_ui_now_ms();
}

static int rtx_ui_blink_step(RtxUi *ui) {
    long now;
    if (!ui) return 0;
    now = rtx_ui_now_ms();
    if (ui->blink_at == 0) {
        ui->blink = 1;
        ui->blink_at = now;
        return 0;
    }
    if (now - ui->blink_at >= RTX_UI_BLINK_MS) {
        ui->blink = !ui->blink;
        ui->blink_at = now;
        return 1;
    }
    return 0;
}

static int rtx_ui_blink(const RtxUi *ui) {
    if (!ui || ui->blink_at == 0) return 1;
    return ui->blink;
}

/* Find / jump own the blinking caret. The document does not. */
static int rtx_ui_prompting(const RtxUi *ui) {
    return ui && (ui->find || ui->jump);
}

static int rtx_ui_here(const RtxUi *ui, int focused, int at) {
    return focused && at && !rtx_ui_prompting(ui) && rtx_ui_blink(ui);
}

/* Find / jump / browse field caret. Same clock; only these draw it. */
static const char *rtx_ui_prompt_caret(const RtxUi *ui) {
    return rtx_ui_blink(ui) ? "_" : " ";
}

static void rtx_ui_clear_jump(RtxUi *ui) {
    if (!ui) return;
    ui->jump = 0;
    ui->jump_len = 0;
    ui->jump_buf[0] = 0;
}

static void rtx_ui_clear_find(RtxUi *ui) {
    if (!ui) return;
    ui->find = 0;
}

static void rtx_ui_start_jump(RtxUi *ui) {
    if (!ui) return;
    ui->help = 0;
    ui->find = 0;
    ui->jump = 1;
    ui->jump_len = 0;
    ui->jump_buf[0] = 0;
    rtx_ui_blink_show(ui);
}

static void rtx_ui_jump_header(const RtxUi *ui, char *dst, size_t n) {
    if (!dst || n == 0) return;
    snprintf(dst, n, "jump line or N%%: %s%s",
             ui ? ui->jump_buf : "",
             rtx_ui_prompt_caret(ui));
}

static void rtx_ui_start_find(RtxUi *ui) {
    if (!ui) return;
    ui->help = 0;
    rtx_ui_clear_jump(ui);
    ui->find = 1;
    rtx_ui_blink_show(ui);
}

static int rtx_ui_find_rows(const RtxUi *ui, int rows) {
    int h = 0;
    if (ui && ui->find) h = RTX_UI_FIND_ROWS;
    if (h > rows - 2) h = rows - 2;
    if (h < 0) h = 0;
    return h;
}

static void rtx_ui_find_scroll(RtxUi *ui, const RtxDoc *d, size_t vis_hits) {
    if (!ui || !d || vis_hits == 0) return;
    if (d->find.cur < ui->find_top) ui->find_top = d->find.cur;
    if (d->find.cur >= ui->find_top + vis_hits) {
        ui->find_top = d->find.cur - vis_hits + 1;
    }
}

static void rtx_ui_find_header(const RtxUi *ui, const RtxDoc *d, char *dst, size_t n) {
    if (!dst || n == 0) return;
    snprintf(dst, n, "find: %s%s  %zu/%zu%s%s",
             ui ? ui->find_buf : "",
             rtx_ui_prompt_caret(ui),
             d && d->find.len ? d->find.cur + 1 : 0,
             d ? d->find.len : 0,
             d && !d->find.done && !d->find.idle && !d->find.cancel
                 ? "  scanning..." : "",
             d && d->find.truncated ? "  capped" : "");
}

static size_t rtx_ui_sanitize(char[:] src, char *dst, size_t dstn) {
    size_t i;
    size_t o = 0;
    if (!dst || dstn == 0) return 0;
    for (i = 0; i < src.len && o + 1 < dstn; i++) {
        unsigned char c = (unsigned char)src.ptr[i];
        if (c == '\t' || c == '\n' || c == '\r') c = ' ';
        else if (c < 32) c = '?';
        dst[o++] = (char)c;
    }
    dst[o] = 0;
    return o;
}

static void !>(CCError) rtx_ui_find_row_text(RtxDoc *d, size_t hit, size_t ctxn,
                                            char *dst, size_t dstn, size_t *line1) {
    RtxFindHitView v;
    cc_arena_stack(scratch, RTX_FRAME_SCRATCH);
    if (!d || !dst || !line1) return cc_err(CC_ERR_INVALID_ARG, "find row");
    d->find_hit_view(hit, &scratch, ctxn, &v) !>(e) { return cc_err(e); };
    *line1 = v.line1;
    rtx_ui_sanitize(v.ctx, dst, dstn);
    return cc_ok();
}

static char[:] rtx_ui_find_query(const RtxUi *ui) {
    if (!ui || ui->find_len == 0) return cc_slice_empty();
    return ui->find_buf.to_slice_n(ui->find_len);
}

static void !>(CCError) rtx_ui_find_apply(RtxUi *ui, RtxDoc *d) {
    char[:] q;
    if (!ui || !d) return cc_err(CC_ERR_INVALID_ARG, "find apply");
    q = rtx_ui_find_query(ui);
    if (!d->find_same_query(q)) d->find_set(q) !>(e) { return cc_err(e); };
    d->find.cancel = 0;
    d->find.idle = 0;
    if (!d->find.done) d->find_step(RTX_FIND_BUDGET) !>(e) { return cc_err(e); };
    rtx_find_auto_land(d);
    return cc_ok();
}

/*
 * Host gate: one wait-for. Leaving is the join.
 * cancel is a written bit — not a stdin poll.
 */
static void !>(CCError) rtx_ui_find_pump(RtxUi *ui, RtxDoc *d) {
    if (!ui || !ui->find || !d) return cc_ok();
    if (d->find.done || d->find.cancel) {
        rtx_find_auto_land(d);
        return cc_ok();
    }
    d->find_step(RTX_FIND_BUDGET) !>(e) { return cc_err(e); };
    rtx_find_auto_land(d);
    return cc_ok();
}

static int rtx_ui_find_char(RtxUi *ui, int ch) {
    if (!ui || !ui->find) return 0;
    if (ch < 32 || ch == 127) return 0;
    return rtx_utf8_append(ui->find_buf, &ui->find_len, sizeof(ui->find_buf),
                           (uint32_t)ch) > 0;
}

static void rtx_ui_find_backspace(RtxUi *ui) {
    if (!ui || ui->find_len == 0) return;
    ui->find_len = rtx_utf8_prev(ui->find_buf.to_slice_n(ui->find_len), ui->find_len);
    ui->find_buf[ui->find_len] = 0;
}

static int rtx_gutter_cols(size_t nlines) {
    int w = 1;
    if (nlines == 0) nlines = 1;
    while (nlines >= 10) {
        nlines /= 10;
        w++;
    }
    return w + 1;
}

/* Digit width from the current camera, not a growing scan frontier.
 * A live seek uses the line stamp from the last fill_off — that number
 * does not move when the index later learns more lines. */
static int rtx_gutter_cols_buf(const RtxBuf *b, int vis) {
    size_t need;
    size_t extra = (vis > 0 ? (size_t)vis : 32) + 8;
    if (!b) return 2;
    if (b->seek_valid) {
        need = b->layout.from_line + extra;
        if (need < extra) need = extra;
        return rtx_gutter_cols(need);
    }
    need = b->doc.line_known();
    if (b->doc.lf_ready()) need = b->line_count();
    else {
        size_t tip = b->top + extra;
        if (tip > need) need = tip;
    }
    return rtx_gutter_cols(need);
}

/* Byte-rail scrollbar. Geometry uses file bytes, never soft line_count.
 * `ready` is the line-index mark (hex is always ready): paint cue only. */
typedef struct {
    size_t pos;
    size_t vis;
    size_t len;
    int ready;
} RtxScrollRail;

static int rtx_scroll_rail_thumb_h(const RtxScrollRail *r, int track_h, int min_th) {
    int th;
    if (!r || track_h < 1) return 0;
    if (min_th < 1) min_th = 1;
    if (r->len == 0 || r->vis >= r->len) return track_h;
    th = (int)((unsigned long long)track_h * r->vis / r->len);
    if (th < min_th) th = min_th;
    if (th > track_h) th = track_h;
    return th;
}

static void rtx_scroll_rail_thumb(const RtxScrollRail *r, int track_h, int min_th,
                                  int *thumb_y, int *thumb_h) {
    int th;
    size_t span;
    int y = 0;
    th = rtx_scroll_rail_thumb_h(r, track_h, min_th);
    if (thumb_h) *thumb_h = th;
    if (!r || track_h < 1 || r->len == 0 || r->vis >= r->len) {
        if (thumb_y) *thumb_y = 0;
        return;
    }
    span = r->len - r->vis;
    {
        int usable = track_h - th;
        size_t pos = r->pos > span ? span : r->pos;
        if (usable > 0 && span)
            y = (int)((unsigned long long)pos * (size_t)usable / span);
        if (y < 0) y = 0;
        if (y > usable) y = usable;
    }
    if (thumb_y) *thumb_y = y;
}

/* 0 if the window already covers the file — callers hide the rail. */
static int rtx_scroll_rail_needed(const RtxScrollRail *r) {
    return r && r->len > 0 && r->vis < r->len;
}

/* Viewport can move: unread tail, wrapped overflow, or more lines than rows.
 * Soft line_count is not consulted until lf_ready. */
static int RtxBuf_scroll_needed(const RtxBuf *b, int vis_rows) {
    size_t n;
    if (!b || vis_rows < 1) return 0;
    n = b->len();
    if (n == 0) return 0;
    if (rtx_layout_is_hex(&b->layout))
        return n > (size_t)vis_rows * (size_t)RTX_HEX_COLS;
    if (!b->doc.lf_ready()) return 1;
    if (b->top > 0 || b->top_wrap > 0) return 1;
    if (b->layout.len > (size_t)vis_rows) return 1;
    if (b->layout.len &&
        ((b->seek_valid && b->layout.rows[0].byte_start == b->seek_off) ||
         (!b->seek_valid && b->layout.from_line == b->top))) {
        const RtxVisRow *last = &b->layout.rows[b->layout.len - 1];
        if (last->byte_start + last->byte_len >= n) return 0;
    }
    return b->line_count() > (size_t)vis_rows;
}

/* `thumb_top` is pixels from the track origin (may be outside; clamped). */
static size_t rtx_scroll_rail_pos_at(const RtxScrollRail *r, int track_h, int min_th,
                                    int thumb_top) {
    int th;
    int usable;
    size_t span;
    if (!r || r->len == 0) return 0;
    if (r->vis >= r->len) return 0;
    span = r->len - r->vis;
    th = rtx_scroll_rail_thumb_h(r, track_h, min_th);
    usable = track_h - th;
    if (usable <= 0) return 0;
    if (thumb_top < 0) thumb_top = 0;
    if (thumb_top > usable) thumb_top = usable;
    return (size_t)((unsigned long long)thumb_top * span / (size_t)usable);
}

static RtxScrollRail !>(RtxIndexErr) RtxBuf_scroll_rail(const RtxBuf *b, int vis_rows) {
    RtxScrollRail r = {0};
    size_t n;
    if (!b) return cc_ok(r);
    n = b->len();
    r.len = n;
    if (vis_rows < 1) vis_rows = 1;
    if (rtx_layout_is_hex(&b->layout)) {
        r.pos = b->top_byte;
        r.vis = (size_t)vis_rows * (size_t)RTX_HEX_COLS;
        if (r.pos > n) r.pos = n;
        if (r.vis > n - r.pos) r.vis = n - r.pos;
        if (r.vis == 0 && n) r.vis = n < (size_t)RTX_HEX_COLS ? n : (size_t)RTX_HEX_COLS;
        r.ready = 1;
        return cc_ok(r);
    }
    r.ready = b->doc.lf_ready();
    if (b->layout.len &&
        ((b->seek_valid && b->layout.rows[0].byte_start == b->seek_off) ||
         (!b->seek_valid && b->layout.from_line == b->top))) {
        size_t i0 = b->top_wrap < b->layout.len ? b->top_wrap : 0;
        size_t i1 = i0;
        size_t shown = 1;
        r.pos = b->layout.rows[i0].byte_start;
        while (i1 + 1 < b->layout.len && shown < (size_t)vis_rows) {
            i1++;
            shown++;
        }
        r.vis = (b->layout.rows[i1].byte_start + b->layout.rows[i1].byte_len) - r.pos;
    } else if (b->seek_valid) {
        r.pos = b->seek_off;
        r.vis = 0;
    } else if (b->top < b->doc.line_known()) {
        r.pos = b->line_start(b->top) !>(e) { return cc_err(e); };
        r.vis = 0;
    } else {
        r.pos = 0;
        r.vis = 0;
    }
    if (r.pos > n) r.pos = n;
    if (r.vis > n - r.pos) r.vis = n - r.pos;
    if (r.vis == 0 && n) {
        r.vis = n < 64 ? n : 64;
        if (r.vis > n - r.pos) r.vis = n - r.pos;
    }
    return cc_ok(r);
}

/* Viewport only — caret stays. Text snaps to the line at `off` (like jump %). */
static void !>(RtxIndexErr) RtxBuf_scroll_to_off(RtxBuf *b, size_t off) {
    size_t n;
    if (!b) return cc_ok();
    b->pin_view = 1;
    n = b->len();
    if (off > n) off = n;
    if (rtx_layout_is_hex(&b->layout)) {
        b->top_byte = rtx_hex_align(off);
        b->seek_valid = 0;
        return cc_ok();
    }
    if (b->doc.index_covers(off)) {
        b->top = b->line_of(off) !>(e) { return cc_err(e); };
        b->top_wrap = 0;
        b->seek_valid = 0;
        return cc_ok();
    }
    b->seek_off = rtx_doc_line_floor(&b->doc, off) !>(e) { return cc_err(e); };
    b->seek_valid = 1;
    b->top = b->doc.line_guess(b->seek_off);
    b->top_wrap = 0;
    return cc_ok();
}

/* Status fragment: exact Lcur/total, or Lcur+ while the index is soft. */
static void !>(RtxIndexErr) rtx_status_line_pos(const RtxDoc *d, char *dst, size_t dst_n) {
    size_t cur;
    if (!dst || dst_n == 0) return cc_ok();
    if (!d) {
        snprintf(dst, dst_n, "L1");
        return cc_ok();
    }
    if (d->index_covers(d->caret))
        cur = d->line_of(d->caret) !>(e) { return cc_err(e); };
    else
        cur = d->line_guess(d->caret);
    cur = cur + 1;
    if (d->index_fault()) {
        snprintf(dst, dst_n, "L%zu!", cur);
    } else if (d->lf_ready()) {
        snprintf(dst, dst_n, "L%zu/%zu", cur, d->line_count());
    } else {
        snprintf(dst, dst_n, "L%zu+", cur);
    }
    return cc_ok();
}

static void !>(RtxIndexErr) RtxDoc_goto_line(RtxDoc *d, size_t line1) {
    size_t n;
    if (!d) return cc_ok();
    n = d->line_count();
    if (n == 0) return cc_ok();
    if (line1 < 1) line1 = 1;
    if (line1 > n) line1 = n;
    d->caret = d->line_start(line1 - 1) !>(e) { return cc_err(e); };
    d->sel_anchor = d->caret;
    d->break_coalesce();
    return cc_ok();
}

/* Jump: digits = 1-based line. Digits then '%' = that percent of the file
 * by byte. Text snaps to the line; hex keeps the byte. Soft line_count is
 * not used for %, so giant progressive docs stay honest. */
static int !>(RtxIndexErr) rtx_ui_apply_jump(RtxUi *ui, RtxBuf *b, int vis) {
    size_t val = 0;
    size_t i;
    int pct = 0;
    RtxDoc *d;
    @errhandler(RtxIndexErr e) {
        return cc_err(e);
    }
    d = b ? &b->doc : NULL;
    if (!ui || !d || ui->jump_len == 0) {
        rtx_ui_clear_jump(ui);
        return cc_ok(0);
    }
    for (i = 0; i < ui->jump_len; i++) {
        char c = ui->jump_buf[i];
        if (c >= '0' && c <= '9' && !pct) {
            val = val * 10 + (size_t)(c - '0');
        } else if (c == '%' && !pct && i > 0) {
            pct = 1;
        } else {
            rtx_ui_clear_jump(ui);
            return cc_ok(0);
        }
    }
    if (pct) {
        size_t n = d->len();
        size_t off;
        if (val > 100) val = 100;
        off = n ? (n - 1) * val / 100 : 0;
        if (rtx_layout_is_hex(&b->layout)) {
            d->caret = off;
            d->sel_anchor = off;
            d->break_coalesce();
        } else {
            size_t ln = d->line_of(off) !>;
            d->caret = d->line_start(ln) !>;
            d->sel_anchor = d->caret;
            d->break_coalesce();
        }
    } else {
        d->goto_line(val) !>;
    }
    rtx_ui_clear_jump(ui);
    b->reveal_off(d->caret, vis) !>;
    return cc_ok(1);
}

/* 1 = clean, quit now. 0 = ask_quit is set. */
static int rtx_ui_offer_quit(const RtxWs *w, RtxUi *ui) {
    if (!w || !ui) return 1;
    if (!w->any_dirty()) return 1;
    ui->help = 0;
    ui->jump = 0;
    ui->find = 0;
    ui->ask_quit = 1;
    return 0;
}

static int rtx_ui_jump_char(RtxUi *ui, int ch) {
    if (!ui || !ui->jump) return 0;
    if (ch >= '0' && ch <= '9' && ui->jump_len + 1 < sizeof(ui->jump_buf)) {
        /* Digits only before '%'. */
        size_t i;
        for (i = 0; i < ui->jump_len; i++) {
            if (ui->jump_buf[i] == '%') return 0;
        }
        ui->jump_buf[ui->jump_len++] = (char)ch;
        ui->jump_buf[ui->jump_len] = 0;
        return 1;
    }
    if (ch == '%' && ui->jump_len > 0 && ui->jump_len + 1 < sizeof(ui->jump_buf)) {
        size_t i;
        for (i = 0; i < ui->jump_len; i++) {
            if (ui->jump_buf[i] == '%') return 0;
        }
        ui->jump_buf[ui->jump_len++] = '%';
        ui->jump_buf[ui->jump_len] = 0;
        return 1;
    }
    return 0;
}

enum { RTX_CLI_MAX = 32 };

typedef struct {
    int view;     /* sticky RTX_VIEW_* for the next file (and the default file) */
    int help;
    int nfiles;
    int file_view[RTX_CLI_MAX];
} RtxCli;

static int rtx_cli_view_of(const char *s) {
    if (!s || !s[0]) return -1;
    if (strcmp(s, "default") == 0 || strcmp(s, "text") == 0) return RTX_VIEW_DEFAULT;
    if (strcmp(s, "wrap") == 0) return RTX_VIEW_WRAP;
    if (strcmp(s, "hex") == 0) return RTX_VIEW_HEX;
    return -1;
}

static void rtx_cli_usage(FILE *fp, const char *prog) {
    if (!fp) fp = stderr;
    if (!prog || !prog[0]) prog = "cctext";
    fprintf(fp, "usage: %s [options] [file ...]\n", prog);
    fprintf(fp, "  -h, --help                 this message\n");
    fprintf(fp, "  --wrap                     wrap view for the following files\n");
    fprintf(fp, "  --hex                      hex view for the following files\n");
    fprintf(fp, "  --view=default|wrap|hex    view for the following files\n");
    fprintf(fp, "  --                         end of options\n");
}

/* Fill files[0..nfiles). 0 = ok (help sets cli->help), 1 = usage error. */
static int rtx_cli_parse(int argc, char **argv, char **files, int max_files,
                         RtxCli *cli) {
    int i;
    int end = 0;
    if (!cli || !files || max_files < 1) return 1;
    memset(cli, 0, sizeof(*cli));
    cli->view = RTX_VIEW_DEFAULT;
    for (i = 1; i < argc; i++) {
        const char *a = argv[i];
        int v;
        if (!a) continue;
        if (!end && strcmp(a, "--") == 0) {
            end = 1;
            continue;
        }
        if (!end && a[0] == '-' && a[1]) {
            if (strcmp(a, "-h") == 0 || strcmp(a, "--help") == 0) {
                cli->help = 1;
                return 0;
            }
            if (strcmp(a, "--wrap") == 0) {
                cli->view = RTX_VIEW_WRAP;
                continue;
            }
            if (strcmp(a, "--hex") == 0) {
                cli->view = RTX_VIEW_HEX;
                continue;
            }
            if (strncmp(a, "--view=", 7) == 0) {
                v = rtx_cli_view_of(a + 7);
                if (v < 0) {
                    fprintf(stderr, "unknown --view (default|wrap|hex)\n");
                    return 1;
                }
                cli->view = v;
                continue;
            }
            if (strcmp(a, "--view") == 0) {
                if (i + 1 >= argc) {
                    fprintf(stderr, "--view needs default|wrap|hex\n");
                    return 1;
                }
                v = rtx_cli_view_of(argv[++i]);
                if (v < 0) {
                    fprintf(stderr, "unknown --view (default|wrap|hex)\n");
                    return 1;
                }
                cli->view = v;
                continue;
            }
            fprintf(stderr, "unknown option: %s\n", a);
            return 1;
        }
        if (cli->nfiles >= max_files || cli->nfiles >= RTX_CLI_MAX) {
            fprintf(stderr, "too many files\n");
            return 1;
        }
        cli->file_view[cli->nfiles] = cli->view;
        files[cli->nfiles++] = argv[i];
    }
    return 0;
}

#endif /* RTX_UI_H */
