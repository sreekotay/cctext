#!ccc cch
/*
 * Shared modal UI: help overlay, jump-to-line, find panel, unsaved-quit,
 * save-conflict (file changed on disk). Bodies stay on this face;
 * ui.ccs is the owner TU. Hosts include the face and link rtx_ui.
 * Command ids and letter map live here; hosts map keys/menus onto CMD_*.
 * Find lists hits; the camera stays until the user selects one.
 */
#ifndef RTX_UI_H
#define RTX_UI_H

#include <stdio.h>
#include <stdlib.h>
#include <time.h>
#include "utf8.cch"
#include "nav_pair.cch"
#include "batch.cch"
#include "find.cch"
#include "cmd.cch"
#include "keymap.cch"
#include "palette.cch"
#include "slides.cch"
#include "wb.cch"
#include "sindex.cch"

const char *rtx_help_line(size_t i);
/* Regenerate the help lines from the command table + keymap. */
void rtx_help_rebuild(void);
size_t rtx_help_n(void);
void rtx_help_bind_apply(const char **names, size_t n);
void rtx_help_bind_table(const char **names, const int *keys, size_t n);
size_t rtx_apply_menu_n(void);
const char *rtx_apply_menu_line(size_t i);

/* Find / jump / browse field caret. Same clock; only these draw it. A
 * host that shows the caret itself (caret_host) puts it at the field's
 * caret cell instead: nothing painted. */
const char *rtx_ui_prompt_caret(const RtxUi *ui) {
    if (ui && ui->caret_host) return "";
    return rtx_ui_blink(ui) ? "_" : " ";
}

void rtx_ui_clear_jump(RtxUi *ui) {
    if (!ui) return;
    ui->jump = 0;
    ui->jump_len = 0;
    ui->jump_buf[0] = 0;
    ui->jump_kind = RTX_JUMP_LINE;
}

void rtx_ui_cancel_jump(RtxUi *ui, RtxDoc *d) {
    if (d) rtx_line_want_cancel(&d->tree);
    rtx_ui_clear_jump(ui);
}

void rtx_ui_clear_find(RtxUi *ui) {
    if (!ui) return;
    ui->find = 0;
    /* A replace-all still collecting edits nothing: drop it. */
    rtx_replace_drop(&ui->rjob);
}

/* Esc-overlay / Alt letter -> CMD_*: the command table's letters column. */
int rtx_cmd_from_letter(int c) {
    return rtx_cmd_letter(c);
}

int rtx_nav_from_cmd(int cmd) {
    if (cmd == CMD_NAV_NEXT) return 1;
    if (cmd == CMD_NAV_PREV) return 2;
    if (cmd == CMD_NAV_INV) return 3;
    if (cmd == CMD_NAV_INV_PREV) return 4;
    if (cmd == CMD_FOLD) return 5;
    return 0;
}

/* Unsaved-quit prompt. 0 = stay, 1 = save, 2 = discard, -1 = not a choice. */
int rtx_ui_quit_letter(int ch) {
    if (ch == 'c' || ch == 'C') return 0;
    if (ch == 's' || ch == 'S') return 1;
    if (ch == 'q' || ch == 'Q' || ch == 'n' || ch == 'N' ||
        ch == 'd' || ch == 'D') return 2;
    return -1;
}

void rtx_ui_toggle_help(RtxUi *ui) {
    if (!ui) return;
    ui->help = !ui->help;
    if (ui->help) {
        ui->help_top = 0;
        ui->stats = 0;
        ui->apply = 0;
        ui->palette = 0;
    }
}

/* Move the help overlay by `dir` lines (negative = up). `vis` is how many
 * binding lines fit; 0 means do not clamp to a page (only floor at 0). */
void rtx_ui_help_scroll(RtxUi *ui, int dir, int vis) {
    size_t n, max_top;
    if (!ui || !ui->help || !dir) return;
    n = rtx_help_n();
    if (vis < 1) vis = 1;
    max_top = n > (size_t)vis ? n - (size_t)vis : 0;
    if (dir < 0) {
        size_t step = (size_t)(-dir);
        if (ui->help_top > step) ui->help_top -= step;
        else ui->help_top = 0;
    } else {
        ui->help_top += (size_t)dir;
        if (ui->help_top > max_top) ui->help_top = max_top;
    }
}

void rtx_ui_toggle_apply(RtxUi *ui) {
    if (!ui) return;
    ui->apply = !ui->apply;
    if (ui->apply) {
        ui->help = 0;
        ui->stats = 0;
        ui->palette = 0;
    }
}

/* RTX_CTX_* for the command table's enabled checks (palette, menus). */
unsigned rtx_ui_cmd_ctx(RtxWs *w, const RtxUi *ui, int gui) {
    unsigned f = gui ? RTX_CTX_GUI : 0;
    RtxBuf *b;
    if (!w) return f;
    b = w->active();
    if (w->browsing()) f |= RTX_CTX_BROWSE;
    else if (b) f |= RTX_CTX_DOC;
    if (ui && ui->find) f |= RTX_CTX_FIND;
    if (ui && ui->find && ui->repl) f |= RTX_CTX_REPL;
    if (w->npanes > 1) f |= RTX_CTX_SPLIT;
    if (w->len > 1) f |= RTX_CTX_MULTI;
    if (b && !w->browsing()) {
        RtxApplyEnt ents[RTX_APPLY_MAX];
        if (RtxBuf_in_table(b)) f |= RTX_CTX_TABLE;
        if (b->doc.sel_anchor != b->doc.caret) f |= RTX_CTX_SEL;
        if (b->doc.dirty()) f |= RTX_CTX_DIRTY;
        if (RtxDoc_apply_list(&b->doc, ents, RTX_APPLY_MAX)) f |= RTX_CTX_APPLY;
        if (RtxDoc_is_markup(&b->doc)) f |= RTX_CTX_MARKUP;
    }
    return f;
}

/* Command palette: opens over the pane (help / apply / stats close). */
void rtx_ui_open_palette(RtxUi *ui, unsigned ctx) {
    if (!ui) return;
    ui->palette = 1;
    ui->help = 0;
    ui->apply = 0;
    ui->stats = 0;
    rtx_palette_open(&ui->pal, ctx);
}

void rtx_ui_close_palette(RtxUi *ui) {
    if (ui) ui->palette = 0;
}

void rtx_ui_toggle_stats(RtxUi *ui) {
    if (!ui) return;
    ui->stats = !ui->stats;
    if (ui->stats) {
        ui->help = 0;
        ui->apply = 0;
        ui->palette = 0;
    }
}

void rtx_ui_start_jump(RtxUi *ui, RtxDoc *d) {
    if (d) rtx_line_want_cancel(&d->tree);
    if (!ui) return;
    ui->help = 0;
    ui->apply = 0;
    ui->find = 0;
    ui->jump = 1;
    ui->jump_len = 0;
    ui->jump_buf[0] = 0;
    ui->jump_kind = RTX_JUMP_LINE;
    rtx_ui_blink_show(ui);
}

/* The jump box's title (cctext-ui draws it over the field). */
const char *rtx_ui_jump_title(const RtxUi *ui) {
    if (ui && ui->jump_kind == RTX_JUMP_RENAME) return "rename across the workbook";
    return "jump to line or N%";
}

void rtx_ui_jump_header(const RtxUi *ui, const RtxDoc *d, char *dst, size_t n) {
    int pct;
    if (!dst || n == 0) return;
    if (ui && ui->jump_kind == RTX_JUMP_RENAME) {
        snprintf(dst, n, "rename to: %s%s  Enter rename  Esc cancel", ui->jump_buf,
                 rtx_ui_prompt_caret(ui));
        return;
    }
    pct = d ? rtx_line_want_pct(&d->tree) : -1;
    if (pct >= 0) {
        snprintf(dst, n, "jump line or N%%: %s  scanning... %d%%",
                 ui ? ui->jump_buf : "", pct);
        return;
    }
    if (ui && ui->jump_buf[0] == '#') {
        snprintf(dst, n, "go to slide: %s%s", ui->jump_buf, rtx_ui_prompt_caret(ui));
        return;
    }
    snprintf(dst, n, "jump line or N%%: %s%s",
             ui ? ui->jump_buf : "",
             rtx_ui_prompt_caret(ui));
}

/* Go to Slide: the jump field on `#` (docs/slides.md). */
void rtx_ui_start_slide_jump(RtxUi *ui, RtxDoc *d) {
    rtx_ui_start_jump(ui, d);
    if (!ui) return;
    ui->jump_buf[0] = '#';
    ui->jump_buf[1] = 0;
    ui->jump_len = 1;
}

RtxField rtx_ui_find_field(RtxUi *ui) {
    RtxField f = {0};
    if (!ui) return f;
    f.buf = ui->find_buf;
    f.len = &ui->find_len;
    f.cap = sizeof(ui->find_buf);
    f.caret = &ui->find_caret;
    f.sel = &ui->find_sel;
    return f;
}

int !>(CCError) rtx_field_copy(RtxWs *w, RtxField f) {
    char[:] s;
    if (!w) return cc_err(CC_ERR_INVALID_ARG, "field copy");
    rtx_field_clamp(f);
    if (!rtx_field_has_sel(f)) return cc_ok(0);
    s = rtx_field_sel_bytes(f);
    w->set_clip(s) !>(e) { return cc_err(e); };
    return cc_ok(1);
}

void !>(CCError) rtx_field_cut(RtxWs *w, RtxField f) {
    rtx_field_copy(w, f) !>(e) { return cc_err(e); };
    rtx_field_delete_sel(f);
    return cc_ok();
}

void !>(CCError) rtx_field_paste(RtxWs *w, RtxField f) {
    if (!w) return cc_err(CC_ERR_INVALID_ARG, "field paste");
    if (!w->clip.ptr || w->clip.len == 0) return cc_ok();
    rtx_field_insert(f, w->clip.ptr, w->clip.len);
    return cc_ok();
}

/* Workspace clip only. Host loads OS clip before PASTE and syncs after COPY/CUT.
 * 1 = field text changed or a copy took bytes. */
int !>(CCError) rtx_field_cmd(RtxWs *w, RtxField f, int cmd) {
    if (cmd == CMD_COPY) return rtx_field_copy(w, f);
    if (cmd == CMD_CUT) {
        rtx_field_cut(w, f) !>(e) { return cc_err(e); };
        return cc_ok(1);
    }
    if (cmd == CMD_PASTE) {
        rtx_field_paste(w, f) !>(e) { return cc_err(e); };
        return cc_ok(1);
    }
    if (cmd == CMD_SEL_ALL) {
        rtx_field_select_all(f);
        return cc_ok(0);
    }
    return cc_ok(0);
}

void rtx_ui_start_find(RtxUi *ui, RtxDoc *d) {
    if (d) rtx_line_want_cancel(&d->tree);
    if (!ui) return;
    ui->help = 0;
    ui->apply = 0;
    rtx_ui_clear_jump(ui);
    ui->find = 1;
    ui->repl = 0; /* Ctrl-F again (or Alt-E) opens the replace row */
    ui->repl_focus = 0;
    ui->repl_msg[0] = 0;
    if (ui->find_len) rtx_field_select_all(rtx_ui_find_field(ui));
    else {
        ui->find_caret = 0;
        ui->find_sel = 0;
    }
    rtx_ui_blink_show(ui);
}

int rtx_ui_find_rows(const RtxUi *ui, int rows) {
    int h = 0;
    if (ui && ui->find) h = RTX_UI_FIND_ROWS;
    if (h > rows - 2) h = rows - 2;
    if (h < 0) h = 0;
    return h;
}

void rtx_ui_find_scroll(RtxUi *ui, const RtxDoc *d, size_t vis_hits) {
    if (!ui || !d || vis_hits == 0 || !d->find.pinned) return;
    if (d->find.cur < ui->find_top) ui->find_top = d->find.cur;
    if (d->find.cur >= ui->find_top + vis_hits) {
        ui->find_top = d->find.cur - vis_hits + 1;
    }
}

int rtx_ui_find_pct(const RtxDoc *d) {
    if (!d || d->find.done || d->find.cancel || !d->find.query.len) return -1;
    return rtx_pct(d->find.scan_bytes, d->len());
}

int rtx_ui_find_scanning(const RtxUi *ui, const RtxDoc *d) {
    return ui && ui->find && rtx_ui_find_pct(d) >= 0;
}

void rtx_ui_fmt_bytes(char *dst, size_t n, size_t v) {
    if (!dst || n == 0) return;
    if (v >= (size_t)1024 * 1024 * 1024)
        snprintf(dst, n, "%.2f GiB", (double)v / (1024.0 * 1024.0 * 1024.0));
    else if (v >= (size_t)1024 * 1024)
        snprintf(dst, n, "%.2f MiB", (double)v / (1024.0 * 1024.0));
    else if (v >= 1024)
        snprintf(dst, n, "%.1f KiB", (double)v / 1024.0);
    else
        snprintf(dst, n, "%zu B", v);
}

void rtx_ui_fmt_pct(char *dst, size_t n, size_t a, size_t b) {
    if (!dst || n == 0) return;
    if (!b) {
        snprintf(dst, n, "-");
        return;
    }
    snprintf(dst, n, "%.1f%%", (double)a * 100.0 / (double)b);
}

/* Option tags for the find header: "icase+word+regex", or "" when none. */
void rtx_ui_find_opts_label(unsigned opts, char *dst, size_t n) {
    size_t o = 0;
    if (!dst || n == 0) return;
    dst[0] = 0;
    if (opts & RTX_FIND_ICASE) o += (size_t)snprintf(dst + o, n - o, "icase");
    if ((opts & RTX_FIND_WORD) && o < n)
        o += (size_t)snprintf(dst + o, n - o, "%sword", o ? "+" : "");
    if ((opts & RTX_FIND_REGEX) && o < n)
        o += (size_t)snprintf(dst + o, n - o, "%sregex", o ? "+" : "");
}

/* Alt-C / Alt-W / Alt-R in the find field (both hosts): toggle ignore-case,
 * whole word, regex. 1 = handled (the caller re-applies the query). */
int rtx_ui_find_toggle(RtxUi *ui, int letter) {
    unsigned bit = 0;
    if (!ui || !ui->find) return 0;
    if (letter == 'c' || letter == 'C') bit = RTX_FIND_ICASE;
    else if (letter == 'w' || letter == 'W') bit = RTX_FIND_WORD;
    else if (letter == 'r' || letter == 'R') bit = RTX_FIND_REGEX;
    if (!bit) return 0;
    ui->find_opts ^= bit;
    return 1;
}

void rtx_ui_find_stats(const RtxDoc *d, char *dst, size_t n) {
    char offb[16];
    char totb[16];
    char tags[32];
    char lng[64];
    int pct;
    size_t hits;
    size_t cur;
    size_t nlong;
    if (!dst || n == 0) return;
    hits = d ? rtx_find_hits_n(&d->find) : 0;
    cur = d && d->find.pinned && hits ? d->find.cur + 1 : 0;
    pct = rtx_ui_find_pct(d);
    rtx_ui_find_opts_label(d ? d->find.opts : 0, tags, sizeof(tags));
    if (d && d->find.err) {
        snprintf(dst, n, "%s%sregex: %s", tags, tags[0] ? "  " : "", d->find.err);
        return;
    }
    lng[0] = 0;
    nlong = d ? d->find.long_n : 0;
    if (nlong) {
        char ob[16];
        rtx_ui_fmt_bytes(ob, sizeof(ob), d->find.long_off);
        snprintf(lng, sizeof(lng), "  %zu over %d KiB @%s", nlong,
                 (int)(RTX_FIND_SPAN / 1024), ob);
    }
    if (pct >= 0) {
        rtx_ui_fmt_bytes(offb, sizeof(offb), d->find.scan_bytes);
        rtx_ui_fmt_bytes(totb, sizeof(totb), d->len());
        snprintf(dst, n, "%s%s%zu/%zu  scanning... %d%%  %s/%s%s%s", tags,
                 tags[0] ? "  " : "", cur, hits, pct, offb, totb,
                 d->find.truncated ? "  capped" : "", lng);
        return;
    }
    snprintf(dst, n, "%s%s%zu/%zu%s%s", tags, tags[0] ? "  " : "", cur, hits,
             d && d->find.truncated ? "  capped" : "", lng);
}

size_t rtx_ui_sanitize(char[:] src, char *dst, size_t dstn) {
    size_t o = 0;
    if (!dst || dstn == 0) return 0;
    @for (ch in src) {
        unsigned char c;
        if (o + 1 >= dstn) break;
        c = (unsigned char)ch;
        if (c == '\t' || c == '\n' || c == '\r') c = ' ';
        else if (c < 32) c = '?';
        dst[o++] = (char)c;
    }
    dst[o] = 0;
    return o;
}

/* One hit row: sanitized context (same byte count as the document text),
 * the hit's column in it and its byte length (may run past the row). */
void !>(CCError) rtx_ui_find_row_text(RtxDoc *d, size_t hit, size_t ctxn,
                                            char *dst, size_t dstn, size_t *line1,
                                            size_t *col, size_t *len) {
    RtxFindHitView v;
    cc_arena_stack(scratch, RTX_FRAME_SCRATCH);
    if (!d || !dst || !line1) return cc_err(CC_ERR_INVALID_ARG, "find row");
    d->find_hit_view(hit, scratch, ctxn, &v) !>(e) { return cc_err(e); };
    *line1 = v.line1;
    if (col) *col = v.col;
    if (len) *len = v.len;
    rtx_ui_sanitize(v.ctx, dst, dstn);
    return cc_ok();
}

char[:] rtx_ui_find_query(const RtxUi *ui) {
    if (!ui || ui->find_len == 0) return cc_slice_empty();
    return ui->find_buf.to_slice_n(ui->find_len);
}

void !>(CCError) rtx_ui_find_apply(RtxUi *ui, RtxDoc *d) {
    char[:] q;
    if (!ui || !d) return cc_err(CC_ERR_INVALID_ARG, "find apply");
    q = rtx_ui_find_query(ui);
    if (!d->find_same(q, ui->find_opts)) {
        ui->repl_msg[0] = 0;
        d->find_set_opt(q, ui->find_opts) !>(e) { return cc_err(e); };
    }
    d->find.cancel = 0;
    rtx_find_mark_near(d);
    return cc_ok();
}

/* Dest-live scan: kick if an edit dropped the handle, then mark the list. */
void !>(CCError) rtx_ui_find_pump(RtxUi *ui, RtxDoc *d) {
    if (!ui || !ui->find || !d) return cc_ok();
    if (!d->find.done && !d->find.cancel)
        d->find_step() !>(e) { return cc_err(e); };
    rtx_find_mark_near(d);
    return cc_ok();
}

int rtx_ui_find_char(RtxUi *ui, int ch) {
    if (!ui || !ui->find) return 0;
    return rtx_field_type_cp(rtx_ui_find_field(ui), (uint32_t)ch);
}

void rtx_ui_find_backspace(RtxUi *ui) {
    if (!ui) return;
    rtx_field_backspace(rtx_ui_find_field(ui));
}

/* ------------------------------------------------------------ replace
 * The replace row sits under the find field (DESIGN Replace). Keys in the
 * find panel: Ctrl-F again / Alt-E show or hide it, Tab / Shift-Tab move
 * between the fields, Enter in the replace field replaces the selected
 * hit and selects the next one, Alt-A replaces all, Alt-L toggles "keep
 * a multi-line selection as the scope". The query is the find field's. */

RtxField rtx_ui_repl_field(RtxUi *ui) {
    RtxField f = {0};
    if (!ui) return f;
    f.buf = ui->repl_buf;
    f.len = &ui->repl_len;
    f.cap = sizeof(ui->repl_buf);
    f.caret = &ui->repl_caret;
    f.sel = &ui->repl_sel;
    return f;
}

/* The field keys edit: replace when it has focus, else find. */
RtxField rtx_ui_focus_field(RtxUi *ui) {
    if (ui && ui->repl && ui->repl_focus) return rtx_ui_repl_field(ui);
    return rtx_ui_find_field(ui);
}

int rtx_ui_repl_focused(const RtxUi *ui) {
    return ui && ui->find && ui->repl && ui->repl_focus;
}

/* Rows above the hit list: the find field, and the replace row. */
int rtx_ui_find_head_rows(const RtxUi *ui) {
    return ui && ui->find && ui->repl ? 2 : 1;
}

char[:] rtx_ui_repl_text(const RtxUi *ui) {
    if (!ui || ui->repl_len == 0) return cc_slice_empty();
    return ui->repl_buf.to_slice_n(ui->repl_len);
}

void rtx_ui_toggle_repl(RtxUi *ui) {
    if (!ui || !ui->find) return;
    ui->repl = !ui->repl;
    ui->repl_focus = ui->repl;
    if (ui->repl) rtx_field_select_all(rtx_ui_repl_field(ui));
    rtx_ui_blink_show(ui);
}

/* Tab / Shift-Tab: the other field (there are two). 1 = handled. */
int rtx_ui_find_tab(RtxUi *ui) {
    if (!ui || !ui->find || !ui->repl) return 0;
    ui->repl_focus = !ui->repl_focus;
    rtx_field_select_all(rtx_ui_focus_field(ui));
    rtx_ui_blink_show(ui);
    return 1;
}

/* Find with the replace row open and focused (Edit > Replace). */
void rtx_ui_start_replace(RtxUi *ui, RtxDoc *d) {
    rtx_ui_start_find(ui, d);
    if (!ui) return;
    ui->repl = 1;
    ui->repl_focus = ui->find_len ? 1 : 0;
    rtx_field_select_all(rtx_ui_focus_field(ui));
}

/* Alt-L. 1 = handled. */
int rtx_ui_repl_toggle_scope(RtxUi *ui) {
    if (!ui || !ui->find || !ui->repl) return 0;
    ui->repl_whole = !ui->repl_whole;
    snprintf(ui->repl_msg, sizeof(ui->repl_msg), "%s",
             ui->repl_whole ? "replace all: whole file" : "replace all: in selection");
    return 1;
}

/* The selection a replace-all keeps to: multi-line, not the selected
 * hit, and Alt-L not set. 1 = [*lo, *hi). */
static int rtx_ui_repl_scope_n(const RtxUi *ui, RtxDoc *d, size_t *lo, size_t *hi,
                               size_t limit) {
    char buf[4096];
    size_t a, b, off;
    @errhandler(CCError e) {
        (void)e;
        return 0;
    }
    if (!ui || !d || ui->repl_whole || !d->has_sel() || d->sel_box) return 0;
    a = d->sel_lo();
    b = d->sel_hi();
    if (d->find.pinned && d->find.cur < rtx_find_hits_n(&d->find) &&
        d->find.hits.data[d->find.cur].off == a &&
        d->find.hits.data[d->find.cur].off + d->find.hits.data[d->find.cur].len == b)
        return 0;
    for (off = a; off < b && off - a < limit;) {
        size_t want = b - off < sizeof(buf) ? b - off : sizeof(buf);
        size_t got = d->read_at(off, cc_slice_from_buffer(buf, want)) !>;
        if (!got) return 0;
        if (memchr(buf, '\n', got)) {
            *lo = a;
            *hi = b;
            return 1;
        }
        off += got;
    }
    return 0;
}

int rtx_ui_repl_scope(const RtxUi *ui, RtxDoc *d, size_t *lo, size_t *hi) {
    return rtx_ui_repl_scope_n(ui, d, lo, hi, (size_t)-1);
}

/* Scan or commit still owed: the host keeps its frame clock running. */
int rtx_ui_repl_busy(const RtxUi *ui) {
    return ui && ui->find && ui->rjob.state != RTX_REPL_IDLE;
}

void rtx_ui_repl_cancel(RtxUi *ui) {
    if (!ui || ui->rjob.state == RTX_REPL_IDLE) return;
    rtx_replace_drop(&ui->rjob);
    snprintf(ui->repl_msg, sizeof(ui->repl_msg), "replace all cancelled; nothing replaced");
}

/* Commit a finished scan (or report a refusal). 1 = an edit landed: the
 * host runs after_edit. */
int !>(CCError) rtx_ui_repl_poll(RtxUi *ui, RtxDoc *d) {
    RtxReplace *j;
    size_t n, same;
    if (!ui) return cc_ok(0);
    j = &ui->rjob;
    if (j->state == RTX_REPL_FAIL) {
        char ob[16];
        rtx_ui_fmt_bytes(ob, sizeof(ob), j->err_off);
        snprintf(ui->repl_msg, sizeof(ui->repl_msg), "%s (@%s)",
                 j->err ? j->err : "replace refused", ob);
        rtx_replace_drop(j);
        return cc_ok(0);
    }
    if (j->state != RTX_REPL_READY || !d || j->doc != d) return cc_ok(0);
    same = j->same;
    n = rtx_replace_commit(j) !>(e) {
        rtx_replace_drop(j);
        snprintf(ui->repl_msg, sizeof(ui->repl_msg), "%s",
                 e.message ? e.message : "replace failed");
        return cc_ok(0);
    };
    snprintf(ui->repl_msg, sizeof(ui->repl_msg), "%zu replaced%s%s", n,
             ui->repl_scoped ? " in selection" : "",
             same ? " (some already matched)" : "");
    return cc_ok(n ? 1 : 0);
}

/* Enter in the replace field. 1 = an edit landed. */
int !>(CCError) rtx_ui_replace_one(RtxUi *ui, RtxDoc *d) {
    const char *why = NULL;
    int hit;
    if (!ui || !d || rtx_ui_repl_busy(ui)) return cc_ok(0);
    rtx_ui_find_apply(ui, d) !>(e) { return cc_err(e); };
    hit = d->replace_hit(rtx_ui_repl_text(ui), &why) !>(e) { return cc_err(e); };
    if (why) snprintf(ui->repl_msg, sizeof(ui->repl_msg), "%s", why);
    else if (hit) snprintf(ui->repl_msg, sizeof(ui->repl_msg), "replaced 1");
    else ui->repl_msg[0] = 0;
    return cc_ok(hit);
}

/* Alt-A. Kicks the job and runs its first slice; a small document is
 * done (and committed) here. 1 = an edit landed. */
int !>(CCError) rtx_ui_replace_all(RtxUi *ui, RtxDoc *d) {
    size_t lo = 0, hi = (size_t)-1;
    char[:] q;
    if (!ui || !d || rtx_ui_repl_busy(ui)) return cc_ok(0);
    q = rtx_ui_find_query(ui);
    if (!q.len) {
        snprintf(ui->repl_msg, sizeof(ui->repl_msg), "replace: nothing to find");
        return cc_ok(0);
    }
    ui->repl_scoped = rtx_ui_repl_scope(ui, d, &lo, &hi);
    rtx_replace_kick(&ui->rjob, d, q, ui->find_opts, rtx_ui_repl_text(ui), lo, hi) !>(e) {
        if (e.kind == CC_ERR_OUT_OF_MEMORY) return cc_err(e);
        snprintf(ui->repl_msg, sizeof(ui->repl_msg), "%s",
                 e.message ? e.message : "replace refused");
        return cc_ok(0);
    };
    ui->repl_msg[0] = 0;
    rtx_replace_step(&ui->rjob, (long)RTX_LINE_ISLE_WORK_MS, NULL) !>(e) {
        rtx_replace_drop(&ui->rjob);
        return cc_err(e);
    };
    return rtx_ui_repl_poll(ui, d);
}

/* Find header text: the stats, the replace job's progress or result. */
void rtx_ui_find_head(const RtxUi *ui, const RtxDoc *d, char *dst, size_t n) {
    size_t o;
    int pct;
    if (!dst || n == 0) return;
    pct = ui ? rtx_replace_pct(&ui->rjob) : -1;
    if (ui && ui->find && pct >= 0) {
        snprintf(dst, n, "replacing... %d%%  Esc cancel", pct);
        return;
    }
    if (ui && ui->find && ui->rjob.state == RTX_REPL_READY) {
        /* Painted the turn before the group lands (a large one blocks). */
        snprintf(dst, n, "applying %zu edits as one undo step...", ui->rjob.n);
        return;
    }
    rtx_ui_find_stats(d, dst, n);
    if (!ui || !ui->repl_msg[0]) return;
    o = cc_slice_cstr(dst).len;
    if (o + 3 < n) snprintf(dst + o, n - o, "  %s", ui->repl_msg);
}

/* Tags on the replace row: "regex" when the template expands, and the
 * scope a replace-all would take. */
void rtx_ui_repl_tags(const RtxUi *ui, RtxDoc *d, char *dst, size_t n) {
    size_t lo = 0, hi = 0;
    int sc;
    if (!dst || n == 0) return;
    dst[0] = 0;
    if (!ui) return;
    sc = rtx_ui_repl_scope_n(ui, d, &lo, &hi, (size_t)64 * 1024); /* a paint hint */
    snprintf(dst, n, "%s%sEnter one  Alt-A all%s",
             (ui->find_opts & RTX_FIND_REGEX) ? "$1 ${name} \\n  " : "",
             sc ? "in selection  " : "",
             ui->repl_whole ? "  (Alt-L: whole file)" : "");
}

/* Viewport only — caret stays. Text snaps to the line at `off` (like jump %). */
void !>(RtxIndexErr) RtxBuf_scroll_to_off(RtxBuf *b, size_t off) {
    size_t n;
    if (!b) return cc_ok();
    b->pin_view = 1;
    n = b->len();
    if (off > n) off = n;
    if (rtx_layout_is_hex(&b->layout)) {
        b->top_byte = rtx_hex_align(off);
        b->seek_valid = 0;
        return cc_ok();
    }
    {
        size_t floor = rtx_doc_line_floor(&b->doc, off) !>(e) { return cc_err(e); };
        rtx_buf_seek_set(b, floor);
    }
    b->top_wrap = 0;
    return cc_ok();
}

void rtx_status_line_scan(const RtxDoc *d, char *dst, size_t dst_n) {
    size_t n;
    int pct;
    if (!d || !dst || dst_n == 0) return;
    pct = rtx_line_isle_pct(&d->tree);
    if (pct < 0) return;
    n = cc_slice_cstr(dst).len;
    if (n + 20 < dst_n)
        snprintf(dst + n, dst_n - n, "  scanning... %d%%", pct);
}

/* Status fragment: exact L, or +N in a gap until the island meets the prefix. */
void !>(RtxIndexErr) rtx_status_line_pos(const RtxBuf *b, char *dst, size_t dst_n) {
    size_t cur, plus, abs, i;
    const RtxDoc *d;
    if (!dst || dst_n == 0) return cc_ok();
    d = b ? &b->doc : NULL;
    if (!d) {
        snprintf(dst, dst_n, "L1");
        return cc_ok();
    }
    plus = 1;
    abs = 0;
    /* rows.data is arena-backed; never walk a len without a pointer (a
     * torn fill / UAF would otherwise crash the status bar). */
    if (b->layout.rows.len && b->layout.rows.data) {
        const RtxVisRow *use = NULL;
        for (i = 0; i < b->layout.rows.len; i++) {
            const RtxVisRow *row = &b->layout.rows.data[i];
            if (d->caret >= row->byte_start &&
                d->caret <= row->byte_start + row->byte_len) {
                use = row;
                break;
            }
        }
        /* Seek is the camera. Caret at BOF must not print L1 on a mid-file
         * window — that is the island label, not line_of(caret). */
        if (!use && b->seek_valid) use = &b->layout.rows.data[0];
        if (use) {
            int gap = rtx_gutter_gap(b, use->byte_start, use->line, &abs, &plus);
            if (gap) {
                snprintf(dst, dst_n, gap < 0 ? "-%zu" : "+%zu", plus);
                rtx_status_line_scan(d, dst, dst_n);
                return cc_ok();
            }
            cur = abs;
            if (d->index_fault()) {
                snprintf(dst, dst_n, "L%zu!", cur);
            } else if (d->lf_ready()) {
                snprintf(dst, dst_n, "L%zu/%zu", cur, d->line_count());
            } else {
                snprintf(dst, dst_n, "L%zu", cur);
            }
            rtx_status_line_scan(d, dst, dst_n);
            return cc_ok();
        }
    }
    if (!d->index_covers(d->caret) &&
        !rtx_line_mark_ok(&d->tree)) {
        snprintf(dst, dst_n, "+1");
        rtx_status_line_scan(d, dst, dst_n);
        return cc_ok();
    }
    if (d->index_covers(d->caret) && !b->seek_valid)
        cur = d->line_of(d->caret) !>(e) { return cc_err(e); };
    else
        cur = rtx_isle_cam_line(b);
    cur = cur + 1;
    if (d->index_fault()) {
        snprintf(dst, dst_n, "L%zu!", cur);
    } else if (d->lf_ready()) {
        snprintf(dst, dst_n, "L%zu/%zu", cur, d->line_count());
    } else {
        snprintf(dst, dst_n, "L%zu", cur);
    }
    rtx_status_line_scan(d, dst, dst_n);
    return cc_ok();
}

void !>(RtxIndexErr) rtx_doc_goto_line_known(RtxDoc *d, size_t line1) {
    size_t known;
    if (!d) return cc_ok();
    if (line1 < 1) line1 = 1;
    /* Jump cursor may sit on a pin ahead of the prefix. Land there
     * instead of line_start, which would pump from BOF. Key the origin
     * on that exact floor so land does not kick a BOF island. */
    if (!d->lf_ready() && d->tree.want_known == line1 - 1) {
        d->caret = d->tree.want_off;
        d->sel_anchor = d->caret;
        d->break_coalesce();
        rtx_line_origin_key(&d->tree, d->tree.want_off, d->tree.want_known);
        rtx_line_want_cancel(&d->tree);
        return cc_ok();
    }
    if (d->lf_ready()) {
        size_t n = d->line_count();
        if (n && line1 > n) line1 = n;
    } else {
        known = rtx_line_known_now(&d->tree);
        if (known && line1 > known) line1 = known;
    }
    d->caret = d->line_start(line1 - 1) !>(e) { return cc_err(e); };
    d->sel_anchor = d->caret;
    d->break_coalesce();
    return cc_ok();
}

void !>(RtxIndexErr) RtxDoc_goto_line(RtxDoc *d, size_t line1) {
    if (!d) return cc_ok();
    if (line1 < 1) line1 = 1;
    rtx_line_isle_cancel(&d->tree);
    if (d->lf_ready() || rtx_line_known_now(&d->tree) >= line1) {
        rtx_line_want_cancel(&d->tree);
        return rtx_doc_goto_line_known(d, line1);
    }
    rtx_line_want_kick(&d->tree, line1);
    if (!rtx_line_want_pumping(&d->tree))
        return rtx_doc_goto_line_known(d, line1);
    return cc_ok();
}

/* Dest-live island: kick if an edit dropped the handle. Do not step
 * on the UI thread (same gate as find). */
void rtx_ui_line_isle_pump(RtxDoc *d, int (*yield)(void)) {
    (void)yield;
    if (!d || !rtx_line_isle_pumping(&d->tree)) return;
    (void)rtx_line_isle_step(&d->tree, 0);
}

/* Commit the dest camera before the prefix scan finishes: line L at the
 * top, gutter already sized. Caret stays put; pin so reveal cannot
 * snap top back to the old line. */
void rtx_ui_jump_arm_cam(RtxBuf *b, size_t line1) {
    if (!b) return;
    if (line1 < 1) line1 = 1;
    b->top = line1 - 1;
    b->top_wrap = 0;
    b->seek_valid = 0;
    b->pin_view = 1;
    b->layout.clear_rows();
    b->layout_width = 0;
}

/* Jump: digits = 1-based line. Digits then '%' = that percent of the file
 * by byte. Text snaps to the line start with a local read — no prefix
 * line_of. Hex keeps the byte. Soft line_count is not used for %. */
int !>(RtxIndexErr) rtx_ui_apply_jump(RtxUi *ui, RtxBuf *b, int vis) {
    size_t val = 0;
    size_t i;
    int pct = 0;
    RtxDoc *d;
    @errhandler(RtxIndexErr e) {
        return cc_err(e);
    }
    d = b ? &b->doc : NULL;
    if (ui && d && ui->jump_kind == RTX_JUMP_RENAME) {
        /* Workbook rename (docs/workbook.md): one edit group. */
        size_t k = rtx_wb_rename(d, ui->jump_at, ui->jump_buf, ui->jump_len, ui->jump_msg,
                                 sizeof(ui->jump_msg)) !>(e) {
            snprintf(ui->jump_msg, sizeof(ui->jump_msg), "rename: %s",
                     e.message ? e.message : "failed");
            rtx_ui_clear_jump(ui);
            return cc_ok(0);
        };
        rtx_ui_clear_jump(ui);
        return cc_ok(k ? 1 : 0);
    }
    if (!ui || !d || ui->jump_len == 0) {
        rtx_ui_clear_jump(ui);
        return cc_ok(0);
    }
    if (ui->jump_buf[0] == '#') {
        /* `#N`: slide N of a Marp deck (its first content line). */
        size_t at;
        for (i = 1; i < ui->jump_len; i++) {
            char c = ui->jump_buf[i];
            if (c >= '0' && c <= '9') val = val * 10 + (size_t)(c - '0');
        }
        at = val ? rtx_deck_slide_caret(d, (int)val - 1) : (size_t)-1;
        rtx_ui_clear_jump(ui);
        if (at == (size_t)-1) return cc_ok(0);
        d->caret = at;
        d->sel_anchor = at;
        d->break_coalesce();
        rtx_line_isle_kick(&d->tree, d->caret);
        b->land(vis) !>;
        return cc_ok(1);
    }
    for (i = 0; i < ui->jump_len; i++) {
        char c = ui->jump_buf[i];
        if (c >= '0' && c <= '9' && !pct) {
            val = val * 10 + (size_t)(c - '0');
        } else if (c == '%' && !pct && i > 0) {
            pct = 1;
        } else {
            rtx_ui_clear_jump(ui);
            return cc_ok(0);
        }
    }
    if (pct) {
        size_t n = d->len();
        size_t off;
        if (val > 100) val = 100;
        off = n ? (size_t)(((unsigned long long)(n - 1) * val) / 100ull) : 0;
        if (rtx_layout_is_hex(&b->layout)) {
            d->caret = off;
            d->sel_anchor = off;
            d->break_coalesce();
            rtx_line_isle_cancel(&d->tree);
            rtx_ui_clear_jump(ui);
            b->reveal_off(d->caret, vis) !>;
            return cc_ok(1);
        }
        d->caret = rtx_doc_line_floor(&b->doc, off) !>;
        d->sel_anchor = d->caret;
        d->break_coalesce();
        rtx_line_isle_kick(&d->tree, d->caret);
        rtx_ui_clear_jump(ui);
        b->land(vis) !>;
        return cc_ok(1);
    } else {
        rtx_line_isle_cancel(&d->tree);
        d->goto_line(val) !>;
        if (rtx_line_want_pumping(&d->tree)) {
            rtx_line_want_step(&d->tree, (size_t)RTX_LINE_ISLE_BUDGET);
            if (rtx_line_want_pumping(&d->tree)) {
                rtx_ui_jump_arm_cam(b, val);
                return cc_ok(1);
            }
            {
                size_t line1 = d->tree.want_line;
                rtx_doc_goto_line_known(d, line1) !>;
            }
        }
    }
    rtx_ui_clear_jump(ui);
    b->land(vis) !>;
    return cc_ok(1);
}

/* Same host gate as the island: 256 KiB waves until WORK_MS or a key.
 * Find's PUMP=8 is for miss-heavy search — a prefix LF scan can eat the
 * whole slice. Progress stays on the jump row. */
void !>(RtxIndexErr) rtx_ui_jump_pump(RtxUi *ui, RtxBuf *b, int vis,
                                            int (*yield)(void)) {
    RtxPieceTree *t;
    long t0;
    size_t line1;
    @errhandler(RtxIndexErr e) {
        return cc_err(e);
    }
    if (!ui || !ui->jump || !b) return cc_ok();
    t = &b->doc.tree;
    if (!t->want_line) return cc_ok();
    t0 = rtx_ui_now_ms();
    for (;;) {
        if (rtx_line_want_reached(t)) break;
        if (yield && yield()) break;
        if (rtx_ui_now_ms() - t0 >= (long)RTX_LINE_ISLE_WORK_MS) break;
        if (!rtx_line_want_step(t, (size_t)RTX_LINE_ISLE_BUDGET)) break;
    }
    if (!rtx_line_want_reached(t)) return cc_ok();
    line1 = t->want_line;
    rtx_doc_goto_line_known(&b->doc, line1) !>;
    rtx_ui_clear_jump(ui);
    b->land(vis) !>;
    return cc_ok();
}

/* Host-step walks that own the frame clock. Dest-live find / island
 * do not — treating them as pumping set TUI timeout 0 and paused the
 * worker around chrome every spin. */
int rtx_ui_work_pumping(const RtxUi *ui, const RtxDoc *d) {
    if (rtx_ui_repl_busy(ui)) return 1;
    if (!d) return 0;
    return ui && ui->jump && rtx_line_want_pumping(&d->tree);
}

void !>(RtxIndexErr) rtx_ui_work_pump(RtxUi *ui, RtxBuf *b, int vis,
                                            int (*yield)(void)) {
    @errhandler(CCError e) {
        return cc_err(rtx_index_from_cc(e));
    }
    @errhandler(RtxIndexErr e) {
        return cc_err(e);
    }
    if (ui && !ui->find && ui->rjob.state != RTX_REPL_IDLE)
        rtx_replace_drop(&ui->rjob); /* find closed: the job edits nothing */
    if (ui && ui->find && ui->rjob.state == RTX_REPL_SCAN) {
        rtx_replace_step(&ui->rjob, (long)RTX_LINE_ISLE_WORK_MS, yield) !>(e) {
            rtx_replace_drop(&ui->rjob);
            snprintf(ui->repl_msg, sizeof(ui->repl_msg), "%s",
                     e.message ? e.message : "replace failed");
        };
    }
    if (ui && b && ui->find) rtx_ui_find_pump(ui, &b->doc) !>;
    if (ui && b && ui->jump) rtx_ui_jump_pump(ui, b, vis, yield) !>;
    if (b) rtx_ui_line_isle_pump(&b->doc, yield);
    return cc_ok();
}

/* 1 = clean, quit now. 0 = ask_quit is set. */
int rtx_ui_offer_quit(RtxWs *w, RtxUi *ui) {
    size_t i;
    if (!w || !ui) return 1;
    /* Camera (view / caret) is not an edit. Flush even when clean. */
    w->safe_flush_all();
    if (!w->any_dirty()) return 1;
    for (i = 0; i < w->len; i++) {
        if (w->bufs[i]->parked) continue;
        rtx_line_want_cancel(&w->bufs[i]->doc.tree);
    }
    ui->help = 0;
    ui->apply = 0;
    ui->jump = 0;
    ui->find = 0;
    ui->ask_quit = 1;
    ui->ask_conflict = 0;
    return 0;
}

/* Overwrite / cancel. 0 = cancel, 1 = overwrite, -1 = not a choice. */
int rtx_ui_conflict_letter(int ch) {
    if (ch == 'c' || ch == 'C' || ch == 'n' || ch == 'N') return 0;
    if (ch == 'o' || ch == 'O' || ch == 's' || ch == 'S' ||
        ch == 'y' || ch == 'Y')
        return 1;
    return -1;
}

void rtx_ui_offer_conflict(RtxUi *ui) {
    if (!ui) return;
    ui->help = 0;
    ui->apply = 0;
    ui->jump = 0;
    ui->find = 0;
    ui->ask_quit = 0;
    ui->ask_xact = 0;
    ui->ask_conflict = 1;
}

/* Split transaction undo. 0 = cancel, 1 = all files, 2 = this file,
 * -1 = not a choice. */
int rtx_ui_xact_letter(int ch) {
    if (ch == 'c' || ch == 'C' || ch == 'n' || ch == 'N') return 0;
    if (ch == 'a' || ch == 'A' || ch == 'y' || ch == 'Y') return 1;
    if (ch == 't' || ch == 'T' || ch == 'o' || ch == 'O') return 2;
    return -1;
}

/* Undo on the focused buffer (DESIGN Edit groups). A workspace
 * transaction whose members all sit at head undoes in every member; a
 * split one opens ask_xact. 1 = an undo ran (host runs after_edit), 0 =
 * asking. */
int !>(CCError) rtx_ui_undo(RtxUi *ui, RtxWs *w) {
    int bufi, scope;
    if (!ui || !w || w->len == 0) return cc_ok(0);
    bufi = w->pane[w->focus];
    scope = RtxWs_undo_scope(w, bufi);
    if (scope == RTX_UNDO_ASK) {
        ui->help = 0;
        ui->apply = 0;
        ui->jump = 0;
        ui->find = 0;
        ui->ask_quit = 0;
        ui->ask_conflict = 0;
        ui->ask_xact = 1;
        ui->xact_buf = bufi;
        return cc_ok(0);
    }
    RtxWs_undo(w, bufi, scope) !>(e) { return cc_err(e); };
    return cc_ok(1);
}

/* --- close buffers (buffer.close / close_others / close_all) --- */
enum {
    RTX_CLOSE_NONE = 0,
    RTX_CLOSE_ONE,    /* the focused pane's buffer */
    RTX_CLOSE_OTHERS, /* every buffer but that one */
    RTX_CLOSE_ALL
};

static inline int rtx_ui_close_hit(int what, int keep, int i) {
    if (what == RTX_CLOSE_ONE) return i == keep;
    if (what == RTX_CLOSE_OTHERS) return i != keep;
    return what == RTX_CLOSE_ALL;
}

/* Unsaved buffers a close would drop. */
static inline int rtx_ui_close_unsaved(const RtxWs *w, int what, int keep) {
    size_t i;
    int n = 0;
    if (!w) return 0;
    for (i = 0; i < w->len; i++)
        if (rtx_ui_close_hit(what, keep, (int)i) && RtxWs_buf_dirty(w, (int)i)) n++;
    return n;
}

/* Close the set, last tab first so indices below stay put. */
void !>(CCError) rtx_ui_close_run(RtxWs *w, int what, int keep,
                                                int discard) {
    int i;
    if (what == RTX_CLOSE_ONE) return w->close_buf(keep, discard);
    for (i = (int)w->len - 1; i >= 0; i--) {
        if (!rtx_ui_close_hit(what, keep, i)) continue;
        w->close_buf(i, discard) !>(e) { return cc_err(e); };
        if (i < keep) keep--;
    }
    return cc_ok();
}

/* Close buffers. Clean ones close now (1). Unsaved ones open ask_close:
 * save / don't save / cancel (0). Closing the last buffer leaves an
 * untitled one; it never quits. */
int !>(CCError) rtx_ui_offer_close(RtxWs *w, RtxUi *ui, int what) {
    int keep;
    if (!w || !ui || w->len == 0) return cc_ok(1);
    RtxWs_panes_fix(w);
    keep = w->pane[w->focus];
    if (!rtx_ui_close_unsaved(w, what, keep)) {
        rtx_ui_close_run(w, what, keep, 0) !>(e) { return cc_err(e); };
        return cc_ok(1);
    }
    ui->help = 0;
    ui->apply = 0;
    ui->jump = 0;
    ui->find = 0;
    ui->ask_quit = 0;
    ui->ask_conflict = 0;
    ui->ask_xact = 0;
    ui->ask_close = what;
    ui->close_buf = keep;
    return cc_ok(0);
}

/* "close name.txt" / "close 3 unsaved files" for the prompt. */
void rtx_ui_close_label(const RtxUi *ui, const RtxWs *w, char *dst, size_t n) {
    int k;
    const char *p, *s;
    if (!dst || !n) return;
    dst[0] = 0;
    if (!ui || !w || !ui->ask_close) return;
    k = rtx_ui_close_unsaved(w, ui->ask_close, ui->close_buf);
    if (ui->ask_close == RTX_CLOSE_ONE || k == 1) {
        size_t i;
        for (i = 0; i < w->len; i++) {
            if (!rtx_ui_close_hit(ui->ask_close, ui->close_buf, (int)i)) continue;
            if (!RtxWs_buf_dirty(w, (int)i)) continue;
            p = RtxWs_buf_path(w, (int)i);
            s = p ? strrchr(p, '/') : NULL;
            snprintf(dst, n, "close %s", p ? (s ? s + 1 : p) : "untitled");
            return;
        }
    }
    snprintf(dst, n, "close %d unsaved files", k);
}

/* Answer ask_close (rtx_ui_quit_letter): 0 cancel, 1 save then close, 2
 * close without saving (their journals are dropped, as quit-q does).
 * 1 = closed. A save that fails (changed on disk, untitled) closes
 * nothing and returns the error. */
int !>(CCError) rtx_ui_close_answer(RtxUi *ui, RtxWs *w, int choice) {
    int what, keep;
    size_t i;
    if (!ui || !w) return cc_ok(0);
    what = ui->ask_close;
    keep = ui->close_buf;
    ui->ask_close = 0;
    if (!what || (choice != 1 && choice != 2)) return cc_ok(0);
    if (keep < 0 || (size_t)keep >= w->len) return cc_ok(0);
    if (choice == 1) {
        for (i = 0; i < w->len; i++) {
            if (!rtx_ui_close_hit(what, keep, (int)i) || !RtxWs_buf_dirty(w, (int)i))
                continue;
            w->save_buf((int)i) !>(e) { return cc_err(e); };
        }
    }
    rtx_ui_close_run(w, what, keep, choice == 2) !>(e) { return cc_err(e); };
    return cc_ok(1);
}

/* Answer ask_xact (rtx_ui_xact_letter). 1 = an undo ran. */
int !>(CCError) rtx_ui_xact_answer(RtxUi *ui, RtxWs *w, int choice) {
    int bufi;
    if (!ui || !w) return cc_ok(0);
    bufi = ui->xact_buf;
    ui->ask_xact = 0;
    if (choice != 1 && choice != 2) return cc_ok(0);
    if (bufi < 0 || (size_t)bufi >= w->len) return cc_ok(0);
    RtxWs_undo(w, bufi, choice == 1 ? RTX_UNDO_ALL : RTX_UNDO_ONE) !>(e) {
        return cc_err(e);
    };
    return cc_ok(1);
}

void rtx_ui_jump_backspace(RtxUi *ui, RtxDoc *d) {
    if (d) rtx_line_want_cancel(&d->tree);
    if (!ui || ui->jump_len == 0) return;
    /* one whole UTF-8 scalar (rename names are text) */
    do {
        ui->jump_buf[--ui->jump_len] = 0;
    } while (ui->jump_len > 0 &&
             ((unsigned char)ui->jump_buf[ui->jump_len] & 0xC0) == 0x80);
}

int rtx_ui_jump_char(RtxUi *ui, RtxDoc *d, int ch) {
    if (!ui || !ui->jump) return 0;
    if (d) rtx_line_want_cancel(&d->tree);
    if (ui->jump_kind == RTX_JUMP_RENAME) {
        char u[4];
        size_t k = 0;
        uint32_t cp = (uint32_t)ch;
        if (cp < 0x20 || cp == 0x7f || cp > 0x10ffff) return 0;
        if (cp < 0x80) {
            u[k++] = (char)cp;
        } else if (cp < 0x800) {
            u[k++] = (char)(0xC0 | (cp >> 6));
            u[k++] = (char)(0x80 | (cp & 0x3F));
        } else if (cp < 0x10000) {
            u[k++] = (char)(0xE0 | (cp >> 12));
            u[k++] = (char)(0x80 | ((cp >> 6) & 0x3F));
            u[k++] = (char)(0x80 | (cp & 0x3F));
        } else {
            u[k++] = (char)(0xF0 | (cp >> 18));
            u[k++] = (char)(0x80 | ((cp >> 12) & 0x3F));
            u[k++] = (char)(0x80 | ((cp >> 6) & 0x3F));
            u[k++] = (char)(0x80 | (cp & 0x3F));
        }
        if (ui->jump_len + k + 1 > sizeof(ui->jump_buf)) return 0;
        memcpy(ui->jump_buf + ui->jump_len, u, k);
        ui->jump_len += k;
        ui->jump_buf[ui->jump_len] = 0;
        return 1;
    }
    if (ch == '#' && ui->jump_len == 0) {
        /* `#N`: a slide number (Marp deck). */
        ui->jump_buf[ui->jump_len++] = '#';
        ui->jump_buf[ui->jump_len] = 0;
        return 1;
    }
    if (ch >= '0' && ch <= '9' && ui->jump_len + 1 < sizeof(ui->jump_buf)) {
        /* Digits only before '%'. */
        size_t i;
        for (i = 0; i < ui->jump_len; i++) {
            if (ui->jump_buf[i] == '%') return 0;
        }
        ui->jump_buf[ui->jump_len++] = (char)ch;
        ui->jump_buf[ui->jump_len] = 0;
        return 1;
    }
    if (ch == '%' && ui->jump_len > 0 && ui->jump_buf[0] != '#' &&
        ui->jump_len + 1 < sizeof(ui->jump_buf)) {
        size_t i;
        for (i = 0; i < ui->jump_len; i++) {
            if (ui->jump_buf[i] == '%') return 0;
        }
        ui->jump_buf[ui->jump_len++] = '%';
        ui->jump_buf[ui->jump_len] = 0;
        return 1;
    }
    return 0;
}

#ifndef RTX_VERSION
#define RTX_VERSION "0.1"
#endif

enum { RTX_CLI_MAX = 32, RTX_CLI_CMD_MAX = 64 };

typedef struct {
    int view;     /* sticky RTX_VIEW_* for the next file (and the default file) */
    int view_set; /* 1 after --hex/--grid/--view (journal view otherwise) */
    int wrap;     /* sticky wrap bit for the next file */
    int wrap_set; /* 1 after --wrap / --view=wrap */
    int help;
    int version;
    int no_blink;
    int no_scroll_regions; /* --no-scroll-regions / settings / RTX_SCROLL_REGIONS=0:
                            * the TUI rewrites scrolled rows instead of
                            * moving them with DECSTBM + DL / IL */
    int caret_cell; /* --caret=cell / RTX_CARET=cell: paint the caret into
                     * the text (reverse-video cell, painted bar) instead of
                     * the terminal cursor / OS caret layer */
    int caret_fade; /* --caret-fade: the GUI caret layer fades (~100 ms) */
    int backup;
    int no_autopair; /* --no-autopair: typed openers do not close themselves */
    int tab_spaces;  /* --tab-spaces=N: Tab inserts N spaces (0 = a tab) */
    int tabs;        /* --tabs=auto|always|never: 1 / 2 / 0 (tab bar); -1 unset
                      * (RTX_TABS, else auto: two or more buffers) */
    int stats_json; /* dump engine stats JSON on exit */
    int rich;       /* settings.json "rich": 1 / 0; -1 = built-in (Rich) */
    int esc_ms;     /* settings.json "esc_timeout_ms": a lone Esc's wait for
                     * the rest of a sequence; 0 = built-in (RTX_ESC_MS wins) */
    const char *keys_path;     /* --keys FILE (NULL: RTX_KEYS / default) */
    const char *settings_path; /* --settings FILE */
    char cfg_err[200];         /* settings.json trouble, for the status bar */
    int batch;      /* headless command runner */
    int safe;       /* with --batch: keep Safe journals (off by default) */
    const char *project; /* --project DIR: quick-open / search root */
    int ncmds;
    char *cmds[RTX_CLI_CMD_MAX];
    int nfiles;
    int file_view[RTX_CLI_MAX];
    int file_view_set[RTX_CLI_MAX];
    int file_wrap[RTX_CLI_MAX];
    int file_wrap_set[RTX_CLI_MAX];
} RtxCli;

void rtx_ui_write_stats_json(FILE *fp, const RtxBuf *b) {
    rtx_batch_write_stats_json(fp, b);
}

int rtx_cli_view_of(const char *s) {
    CCSlice v;
    if (!s || !s[0]) return -1;
    v = cc_slice_cstr(s);
    if (v.eq_cstr("default") || v.eq_cstr("text")) return RTX_VIEW_DEFAULT;
    if (v.eq_cstr("wrap")) return RTX_VIEW_WRAP; /* legacy: DEFAULT + wrap */
    if (v.eq_cstr("hex")) return RTX_VIEW_HEX;
    if (v.eq_cstr("grid") || v.eq_cstr("csv")) return RTX_VIEW_GRID;
    return -1;
}

/* auto 1 / always 2 / never 0; -1 = not a mode. */
int rtx_cli_tabs_of(const char *s) {
    if (!s) return -1;
    if (!strcmp(s, "auto")) return 1;
    if (!strcmp(s, "always") || !strcmp(s, "on") || !strcmp(s, "1")) return 2;
    if (!strcmp(s, "never") || !strcmp(s, "off") || !strcmp(s, "0")) return 0;
    return -1;
}

/* --tabs, else RTX_TABS, else auto. */
int rtx_cli_tabs(const RtxCli *cli) {
    const char *e;
    if (cli && cli->tabs >= 0) return cli->tabs;
    e = getenv("RTX_TABS");
    if (e && e[0] && rtx_cli_tabs_of(e) >= 0) return rtx_cli_tabs_of(e);
    return 1;
}

void rtx_cli_usage(FILE *fp, const char *prog) {
    if (!fp) fp = stderr;
    if (!prog || !prog[0]) prog = "cctext";
    fprintf(fp, "usage: %s [options] [file|dir ...]\n", prog);
    fprintf(fp, "  (no files: open the file browser; a directory opens browse there)\n");
    fprintf(fp, "  -h, --help                 this message\n");
    fprintf(fp, "  -v, --version              print version (%s)\n", RTX_VERSION);
    fprintf(fp, "  --no-blink                 solid caret (no blink)\n");
    fprintf(fp, "  --no-scroll-regions        cctext: rewrite scrolled rows (no DECSTBM\n");
    fprintf(fp, "                             region scroll; also RTX_SCROLL_REGIONS=0)\n");
    fprintf(fp, "  --caret=cursor|cell        caret: the terminal cursor / GUI caret layer\n");
    fprintf(fp, "                             (default), or painted into the text (cell;\n");
    fprintf(fp, "                             also RTX_CARET=cell)\n");
    fprintf(fp, "  --caret-fade               cctext-ui: the caret fades in and out\n");
    fprintf(fp, "  --backup                   save in place (keep symlink); path~ is dirty span\n");
    fprintf(fp, "  --no-autopair              typed ( [ { \" ` * _ do not insert their closer\n");
    fprintf(fp, "  --tab-spaces=N             Tab inserts N spaces (0-16; default a tab)\n");
    fprintf(fp, "  --keys FILE                key bindings (default: $RTX_KEYS, else\n");
    fprintf(fp, "                             $XDG_CONFIG_HOME/cctext/keys.json or\n");
    fprintf(fp, "                             ~/.config/cctext/keys.json)\n");
    fprintf(fp, "  --settings FILE            defaults (tab_spaces, autopair, blink, caret,\n");
    fprintf(fp, "                             caret_fade, rich, scroll_regions,\n");
    fprintf(fp, "                             search_index, search_index_pct); default\n");
    fprintf(fp, "                             settings.json beside keys.json\n");
    fprintf(fp, "                             ($RTX_SETTINGS); flags override\n");
    fprintf(fp, "  --tabs=auto|always|never   buffer tab bar (auto: 2+ buffers; also RTX_TABS)\n");
    fprintf(fp, "  --no-tabs                  same as --tabs=never\n");
    fprintf(fp, "  --stats-json               print engine stats JSON on exit\n");
    fprintf(fp, "  --batch                    run -c / stdin cmds (no TTY)\n");
    fprintf(fp, "  -c CMD                     batch command (repeatable)\n");
    fprintf(fp, "  --safe                     with --batch: keep Safe journals\n");
    fprintf(fp, "  --project DIR              project root for quick-open / search\n");
    fprintf(fp, "                             (default: git root of the file or cwd)\n");
    fprintf(fp, "  --wrap                     soft wrap on for the following files\n");
    fprintf(fp, "  batch cmds: goto @N / N%% / LN, await index|island, print [N],\n");
    fprintf(fp, "              read @off n, insert TEXT, save, stats-json, quit,\n");
    fprintf(fp, "              undo, redo, replace [--all] [--regex] [--icase]\n");
    fprintf(fp, "              [--word] FIND REPL  ('..' / \"..\" quote; \"\" = empty),\n");
    fprintf(fp, "              project-files [--rewalk] [--follow] [QUERY],\n");
    fprintf(fp, "              project-search [--regex] [--icase] [--word] QUERY,\n");
    fprintf(fp, "              project-index [--update] [--pct N]  (with --safe)\n");
    fprintf(fp, "  --hex                      hex view for the following files\n");
    fprintf(fp, "  --grid                     column view for the following files\n");
    fprintf(fp, "  --view=default|hex|grid    view for the following files\n");
    fprintf(fp, "  --                         end of options\n");
}

void rtx_cli_print_version(FILE *fp, const char *prog) {
    bool found = false;
    size_t slash;
    CCSlice p;
    if (!fp) fp = stdout;
    if (!prog || !prog[0]) prog = "cctext";
    p = cc_slice_cstr(prog);
    slash = cc_slice_last_index_of(p, CC_SLICE_LIT("/"), &found);
    if (found && slash + 1 < p.len) prog = p.ptr + slash + 1;
    fprintf(fp, "%s %s\n", prog, RTX_VERSION);
}

/* Fill files[0..nfiles). 0 = ok (help sets cli->help), 1 = usage error. */
int rtx_cli_parse(int argc, char **argv, char **files, int max_files,
                         RtxCli *cli) {
    int i;
    int end = 0;
    if (!cli || !files || max_files < 1) return 1;
    *cli = (RtxCli){0};
    cli->view = RTX_VIEW_DEFAULT;
    cli->rich = -1;
    /* --keys / --settings first: settings.json fills the defaults the
     * other flags then override. */
    for (i = 1; i < argc; i++) {
        const char *a = argv[i];
        CCSlice opt;
        if (!a) continue;
        opt = cc_slice_cstr(a);
        if (opt.eq_cstr("--")) break;
        if ((opt.eq_cstr("--keys") || opt.eq_cstr("--settings")) && i + 1 < argc) {
            if (opt.eq_cstr("--keys")) cli->keys_path = argv[i + 1];
            else cli->settings_path = argv[i + 1];
            i++;
        } else if (opt.starts_with(CC_SLICE_LIT("--keys="))) {
            cli->keys_path = a + 7;
        } else if (opt.starts_with(CC_SLICE_LIT("--settings="))) {
            cli->settings_path = a + 11;
        }
    }
    {
        RtxSettings st = {0};
        rtx_settings_load(cli->settings_path, &st, cli->cfg_err, sizeof cli->cfg_err);
        if (st.has_tab_spaces) cli->tab_spaces = st.tab_spaces;
        if (st.has_autopair) cli->no_autopair = !st.autopair;
        if (st.has_blink) cli->no_blink = !st.blink;
        if (st.has_caret) cli->caret_cell = st.caret_cell;
        if (st.has_caret_fade) cli->caret_fade = st.caret_fade;
        if (st.has_rich) cli->rich = st.rich;
        if (st.has_esc_timeout_ms) cli->esc_ms = st.esc_timeout_ms;
        if (st.has_scroll_regions) cli->no_scroll_regions = !st.scroll_regions;
        if (st.has_search_index) rtx_si_set_enabled(st.search_index);
        if (st.has_search_index_pct) rtx_si_set_pct(st.search_index_pct);
    }
    {
        const char *sr = getenv("RTX_SCROLL_REGIONS");
        if (sr && sr[0]) cli->no_scroll_regions = sr[0] == '0';
    }
    cli->tabs = -1;
    {
        const char *ce = getenv("RTX_CARET");
        if (ce && ce[0] && cc_slice_cstr(ce).eq_cstr("cell")) cli->caret_cell = 1;
    }
    for (i = 1; i < argc; i++) {
        const char *a = argv[i];
        CCSlice opt;
        int v;
        if (!a) continue;
        opt = cc_slice_cstr(a);
        if (!end && opt.eq_cstr("--")) {
            end = 1;
            continue;
        }
        if (!end && a[0] == '-' && a[1]) {
            if (opt.eq_cstr("-h") || opt.eq_cstr("--help")) {
                cli->help = 1;
                return 0;
            }
            if (opt.eq_cstr("-v") || opt.eq_cstr("--v") ||
                opt.eq_cstr("--version")) {
                cli->version = 1;
                return 0;
            }
            if (opt.eq_cstr("--no-blink")) {
                cli->no_blink = 1;
                continue;
            }
            if (opt.eq_cstr("--no-scroll-regions")) {
                cli->no_scroll_regions = 1;
                continue;
            }
            if (opt.starts_with(CC_SLICE_LIT("--caret="))) {
                CCSlice cv = cc_slice_cstr(a + 8);
                if (cv.eq_cstr("cell") || cv.eq_cstr("paint")) {
                    cli->caret_cell = 1;
                } else if (cv.eq_cstr("cursor") || cv.eq_cstr("layer") ||
                           cv.eq_cstr("hw")) {
                    cli->caret_cell = 0;
                } else {
                    fprintf(stderr, "unknown --caret (cursor|cell)\n");
                    return 1;
                }
                continue;
            }
            if (opt.eq_cstr("--caret-fade")) {
                cli->caret_fade = 1;
                continue;
            }
            if (opt.eq_cstr("--backup")) {
                cli->backup = 1;
                continue;
            }
            if (opt.eq_cstr("--no-autopair")) {
                cli->no_autopair = 1;
                continue;
            }
            if (opt.eq_cstr("--no-tabs")) {
                cli->tabs = 0;
                continue;
            }
            if (opt.starts_with(CC_SLICE_LIT("--tabs="))) {
                cli->tabs = rtx_cli_tabs_of(a + 7);
                if (cli->tabs < 0) {
                    fprintf(stderr, "--tabs takes auto|always|never\n");
                    return 1;
                }
                continue;
            }
            if (opt.starts_with(CC_SLICE_LIT("--tab-spaces="))) {
                int ts = atoi(a + 13);
                if (ts < 0 || ts > 16) {
                    fprintf(stderr, "--tab-spaces takes 0-16\n");
                    return 1;
                }
                cli->tab_spaces = ts;
                continue;
            }
            if (opt.eq_cstr("--stats-json")) {
                cli->stats_json = 1;
                continue;
            }
            if (opt.eq_cstr("--keys") || opt.eq_cstr("--settings")) {
                if (i + 1 >= argc) {
                    fprintf(stderr, "%s needs a file\n", a);
                    return 1;
                }
                i++; /* read in the first pass */
                continue;
            }
            if (opt.starts_with(CC_SLICE_LIT("--keys=")) ||
                opt.starts_with(CC_SLICE_LIT("--settings="))) {
                continue;
            }
            if (opt.eq_cstr("--batch")) {
                cli->batch = 1;
                continue;
            }
            if (opt.eq_cstr("--safe")) {
                cli->safe = 1;
                continue;
            }
            if (opt.starts_with(CC_SLICE_LIT("--project="))) {
                cli->project = a + 10;
                continue;
            }
            if (opt.eq_cstr("--project")) {
                if (i + 1 >= argc) {
                    fprintf(stderr, "--project needs a directory\n");
                    return 1;
                }
                cli->project = argv[++i];
                continue;
            }
            if (opt.eq_cstr("-c")) {
                if (i + 1 >= argc) {
                    fprintf(stderr, "-c needs a command\n");
                    return 1;
                }
                if (cli->ncmds >= RTX_CLI_CMD_MAX) {
                    fprintf(stderr, "too many -c commands\n");
                    return 1;
                }
                cli->cmds[cli->ncmds++] = argv[++i];
                continue;
            }
            if (opt.eq_cstr("--wrap")) {
                cli->wrap = 1;
                cli->wrap_set = 1;
                continue;
            }
            if (opt.eq_cstr("--hex")) {
                cli->view = RTX_VIEW_HEX;
                cli->view_set = 1;
                continue;
            }
            if (opt.eq_cstr("--grid")) {
                cli->view = RTX_VIEW_GRID;
                cli->view_set = 1;
                continue;
            }
            if (opt.starts_with(CC_SLICE_LIT("--view="))) {
                v = rtx_cli_view_of(a + 7);
                if (v < 0) {
                    fprintf(stderr, "unknown --view (default|hex|grid; wrap=soft-wrap)\n");
                    return 1;
                }
                if (v == RTX_VIEW_WRAP) {
                    cli->view = RTX_VIEW_DEFAULT;
                    cli->wrap = 1;
                    cli->wrap_set = 1;
                } else {
                    cli->view = v;
                }
                cli->view_set = 1;
                continue;
            }
            if (opt.eq_cstr("--view")) {
                if (i + 1 >= argc) {
                    fprintf(stderr, "--view needs default|hex|grid (or wrap)\n");
                    return 1;
                }
                v = rtx_cli_view_of(argv[++i]);
                if (v < 0) {
                    fprintf(stderr, "unknown --view (default|hex|grid; wrap=soft-wrap)\n");
                    return 1;
                }
                if (v == RTX_VIEW_WRAP) {
                    cli->view = RTX_VIEW_DEFAULT;
                    cli->wrap = 1;
                    cli->wrap_set = 1;
                } else {
                    cli->view = v;
                }
                cli->view_set = 1;
                continue;
            }
            fprintf(stderr, "unknown option: %s\n", a);
            return 1;
        }
        if (cli->nfiles >= max_files || cli->nfiles >= RTX_CLI_MAX) {
            fprintf(stderr, "too many files\n");
            return 1;
        }
        cli->file_view[cli->nfiles] = cli->view;
        cli->file_view_set[cli->nfiles] = cli->view_set;
        cli->file_wrap[cli->nfiles] = cli->wrap;
        cli->file_wrap_set[cli->nfiles] = cli->wrap_set;
        files[cli->nfiles++] = argv[i];
    }
    return 0;
}

/* ---- workbook (docs/workbook.md) -------------------------------------- */

/* Status fragment for the caret in a workbook: the cell / name there and
 * its value, or its error with the message ("" elsewhere). */
void rtx_status_wb(const RtxBuf *b, char *dst, size_t n) {
    RtxWb *wb;
    char tmp[240];
    if (!dst || !n) return;
    dst[0] = 0;
    if (!b) return;
    wb = rtx_wb_of(&b->doc);
    if (!wb || !rtx_wb_describe(wb, &b->doc, b->doc.caret, tmp, sizeof tmp)) return;
    snprintf(dst, n, "  %s", tmp);
}

int rtx_ui_wb_enabled(const RtxCmdCtx *c) {
    const RtxBuf *b = c ? (const RtxBuf *)c->act : NULL;
    return b && rtx_wb_of(&b->doc) != NULL;
}

/* "workbook.rename": the jump prompt, prefilled with the name at the
 * caret; Enter renames it everywhere (rtx_ui_apply_jump). */
int rtx_ui_wb_rename_run(RtxCmdCtx *c) {
    RtxUi *ui = c ? (RtxUi *)c->ui : NULL;
    RtxBuf *b = c ? (RtxBuf *)c->act : NULL;
    RtxWb *wb = b ? rtx_wb_of(&b->doc) : NULL;
    char name[64];
    if (!ui || !b) return 0;
    if (!wb) {
        snprintf(c->status, sizeof c->status, "rename: not a workbook (*.wb.md)");
        return 1;
    }
    if (!rtx_wb_rename_target(wb, &b->doc, b->doc.caret, name, sizeof name)) {
        snprintf(c->status, sizeof c->status,
                 "rename: put the caret on a table, column or name");
        return 1;
    }
    rtx_ui_start_jump(ui, &b->doc);
    ui->jump_kind = RTX_JUMP_RENAME;
    ui->jump_at = b->doc.caret;
    ui->jump_msg[0] = 0;
    snprintf(ui->jump_buf, sizeof ui->jump_buf, "%s", name);
    ui->jump_len = strlen(ui->jump_buf);
    return 1;
}

/* "workbook.recalc": reparse and recalc everything; report the shape. */
int rtx_ui_wb_recalc_run(RtxCmdCtx *c) {
    RtxBuf *b = c ? (RtxBuf *)c->act : NULL;
    RtxWb *wb = b ? rtx_wb_of(&b->doc) : NULL;
    RtxWbStats st;
    if (!wb) {
        if (c) snprintf(c->status, sizeof c->status, "recalc: not a workbook (*.wb.md)");
        return 1;
    }
    rtx_wb_recalc_all(wb, &b->doc);
    rtx_wb_stats(wb, &b->doc, &st);
    if (st.off) {
        snprintf(c->status, sizeof c->status, "workbook over 8 MiB: values off");
    } else {
        snprintf(c->status, sizeof c->status,
                 "workbook: %zu tables, %zu formulas, %zu nodes, %zu cycles, %zu errors (%.2f ms)",
                 st.tables, st.formulas, st.nodes, st.cycles, st.errors,
                 (double)st.last_us / 1000.0);
    }
    return 1;
}

/* Workbook rows join the command table once per process. */
void rtx_ui_wb_register(void) {
    static int done;
    RtxCmdDef row;
    if (done) return;
    done = 1;
    memset(&row, 0, sizeof row);
    row.id = "workbook.rename";
    row.title = "Workbook: Rename";
    row.cat = "Edit";
    row.cmd = CMD_NONE;
    row.tui = "f2";
    row.gui = "f2";
    row.need = RTX_CTX_DOC;
    row.deny = RTX_CTX_BROWSE;
    row.menu = "Edit";
    row.notes = "  table / column / name at the caret: every reference, one undo";
    row.enabled = rtx_ui_wb_enabled;
    row.run = rtx_ui_wb_rename_run;
    (void)rtx_cmd_register(&row);
    memset(&row, 0, sizeof row);
    row.id = "workbook.recalc";
    row.title = "Workbook: Recalculate";
    row.cat = "Edit";
    row.cmd = CMD_NONE;
    row.need = RTX_CTX_DOC;
    row.deny = RTX_CTX_BROWSE;
    row.enabled = rtx_ui_wb_enabled;
    row.run = rtx_ui_wb_recalc_run;
    (void)rtx_cmd_register(&row);
}

/* Host start: settings that live outside RtxCli (rich default), the
 * keymap for this host, and the help lines. Trouble with either file goes
 * to `status` (the status bar), never a failure. */
void rtx_cli_setup_keys(RtxCli *cli, int host, char *status, size_t status_n) {
    char kerr[200];
    kerr[0] = 0;
    if (!cli) return;
    if (cli->rich >= 0) rtx_safe_set_rich_default(cli->rich);
    rtx_ui_wb_register();
    rtx_keymap_setup(host, cli->keys_path, kerr, sizeof kerr);
    rtx_help_rebuild();
    if (!status || !status_n) return;
    if (kerr[0] && cli->cfg_err[0])
        snprintf(status, status_n, "%s; %s", kerr, cli->cfg_err);
    else if (kerr[0])
        snprintf(status, status_n, "%s", kerr);
    else if (cli->cfg_err[0])
        snprintf(status, status_n, "%s", cli->cfg_err);
}

/* CLI --view / --wrap overrides the journal; otherwise keep the restored camera. */
void rtx_cli_apply_views(RtxWs *w, const RtxCli *cli) {
    int i;
    if (!w || !cli) return;
    if (cli->nfiles == 0) {
        if (w->len) {
            if (cli->view_set)
                rtx_layout_set_view(&w->bufs[0]->layout, cli->view);
            if (cli->wrap_set)
                w->bufs[0]->layout.wrap = cli->wrap ? 1 : 0;
        }
        for (i = 0; i < (int)w->len; i++) rtx_buf_grid_bind(w->bufs[i]);
        return;
    }
    for (i = 0; i < cli->nfiles && i < (int)w->len; i++) {
        if (cli->file_view_set[i])
            rtx_layout_set_view(&w->bufs[i]->layout, cli->file_view[i]);
        if (cli->file_wrap_set[i])
            w->bufs[i]->layout.wrap = cli->file_wrap[i] ? 1 : 0;
        rtx_buf_grid_bind(w->bufs[i]);
    }
}

#endif /* RTX_UI_H */
