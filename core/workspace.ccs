#!ccc ccs
/*
 * Workspace (linked TU; see workspace.cch). Hosts include the face for
 * types / UFCS; this file owns the RtxBuf / RtxWs bodies and the
 * ui_types.cch helpers (blink / gutter / rail).
 */
#include <ccc/std/prelude.cch>
#include <limits.h>
#include <stdint.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <sys/stat.h>
#include <time.h>
#include <unistd.h>
#include "document.cch"
#include "layout.cch"
#include "find.cch"
#include "rtx_par.cch"
#include "workspace.cch"
#include <stdatomic.h>

int RtxWs_ensure(RtxWs *w) {
    if (!w) return 0;
    if (w->session.base) return 1;
    w->session = cc_arena_heap(kilobytes(8));
    return w->session.base != NULL;
}

void RtxBuf_destroy(RtxBuf *b) {
    if (!b) return;
    if (!b->parked) {
        b->layout.destroy();
        b->doc.destroy();
    }
    *b = (RtxBuf){0};
}

static int rtx_buf_rich(const RtxBuf *b);
static void !>(CCError) rtx_buf_pair_replace(RtxBuf *b, size_t lo, size_t hi,
                                            char[:] bytes);
static int rtx_ws_find_path(const RtxWs *w, char[:0] path);

static void rtx_ws_cam_from_buf(const RtxBuf *b, RtxSafeCam *c) {
    rtx_safe_cam_clear(c);
    if (!b) return;
    c->top = b->top;
    c->top_wrap = b->top_wrap;
    c->left_col = b->left_col;
    c->top_byte = b->top_byte;
    c->seek_off = b->seek_off;
    c->seek_rel = b->seek_rel;
    c->seek_valid = b->seek_valid;
    c->view = b->layout.view;
    c->rich = b->layout.rich;
    c->wrap = b->layout.wrap;
    c->hex_nib = b->hex_nib;
    c->unlock = b->unlock;
    c->pin_view = b->pin_view;
    if (rtx_line_mark_ok(&b->doc.tree)) {
        c->mark_valid = 1;
        c->mark_line = b->doc.tree.mark_line;
        c->mark_off = b->doc.tree.mark_off;
    } else if (rtx_line_isle_connected(&b->doc.tree)) {
        c->mark_valid = 1;
        c->mark_line = rtx_line_isle_line(&b->doc.tree);
    } else if (!b->seek_valid &&
               (b->doc.lf_ready() || b->doc.index_covers(b->doc.caret))) {
        c->mark_valid = 1;
        c->mark_line = b->top;
    }
}

static void rtx_ws_cam_to_buf(RtxBuf *b, const RtxSafeCam *c) {
    if (!b || !c) return;
    b->top = c->top;
    b->top_wrap = c->top_wrap;
    b->left_col = c->left_col;
    b->top_byte = c->top_byte;
    b->seek_off = c->seek_off;
    b->seek_rel = c->seek_rel;
    b->seek_valid = c->seek_valid;
    rtx_layout_set_view(&b->layout, c->view);
    b->layout.rich = c->rich;
    b->layout.wrap = c->wrap;
    rtx_buf_grid_bind(b);
    b->hex_nib = c->hex_nib;
    b->unlock = c->unlock;
    b->pin_view = c->pin_view;
}

static char[:] rtx_ws_session_str(RtxWs *w, const char *s) {
    char[:] out;
    size_t n;
    if (!w || !s) return cc_slice_empty();
    n = strlen(s);
    out = w->session.alloc_slice_bytes(n + 1);
    if (!out.ptr) return cc_slice_empty();
    {
        char[:] src = cc_slice_from_buffer((void *)s, n);
        out.copy(src) !>(e) { (void)e; return cc_slice_empty(); };
    }
    out.ptr[n] = 0;
    return out.sub(0, n);
}

static void rtx_ws_bind_path(RtxWs *w, RtxBuf *b, char[:0] path) {
    char real[PATH_MAX];
    const char *p = path.ptr;
    if (!w || !b || !path.ptr || path.len == 0) return;
    if (realpath(path.ptr, real)) p = real;
    b->park_path = rtx_ws_session_str(w, p);
}

static const char *rtx_ws_buf_path(const RtxBuf *b) {
    if (!b) return NULL;
    if (b->park_path.ptr && b->park_path.len) return b->park_path.ptr;
    if (!b->parked && b->doc.path.ptr && b->doc.path.len) return b->doc.path.ptr;
    return NULL;
}

static int rtx_ws_buf_dirty(const RtxBuf *b) {
    if (!b) return 0;
    /* A held journal is unsaved work even when the text on screen is clean. */
    if (b->safe_hold) return 1;
    if (b->parked) return b->park_dirty;
    return b->doc.dirty();
}

static long rtx_ws_now_ms(void) {
    struct timespec ts;
    if (clock_gettime(CLOCK_MONOTONIC, &ts) != 0) return 0;
    return (long)ts.tv_sec * 1000L + (long)(ts.tv_nsec / 1000000L);
}

static uint64_t rtx_ws_safe_sig(const RtxBuf *b) {
    uint64_t h = 1469598103934665603ull;
    if (!b) return 0;
    h ^= (uint64_t)b->doc.edit_gen; h *= 1099511628211ull;
    h ^= (uint64_t)b->doc.saved_head; h *= 1099511628211ull;
    h ^= (uint64_t)b->doc.caret; h *= 1099511628211ull;
    h ^= (uint64_t)b->doc.sel_anchor; h *= 1099511628211ull;
    h ^= (uint64_t)b->seek_off; h *= 1099511628211ull;
    h ^= (uint64_t)b->top; h *= 1099511628211ull;
    h ^= (uint64_t)b->top_wrap; h *= 1099511628211ull;
    h ^= (uint64_t)b->left_col; h *= 1099511628211ull;
    h ^= (uint64_t)b->top_byte; h *= 1099511628211ull;
    h ^= (uint64_t)(unsigned long)b->seek_rel; h *= 1099511628211ull;
    h ^= (uint64_t)b->seek_valid; h *= 1099511628211ull;
    h ^= (uint64_t)rtx_line_mark_ok(&b->doc.tree); h *= 1099511628211ull;
    h ^= (uint64_t)b->doc.tree.mark_line; h *= 1099511628211ull;
    h ^= (uint64_t)b->doc.tree.mark_off; h *= 1099511628211ull;
    h ^= (uint64_t)b->layout.view; h *= 1099511628211ull;
    h ^= (uint64_t)b->layout.wrap; h *= 1099511628211ull;
    h ^= (uint64_t)b->layout.rich; h *= 1099511628211ull;
    h ^= (uint64_t)b->hex_nib; h *= 1099511628211ull;
    h ^= (uint64_t)b->unlock; h *= 1099511628211ull;
    h ^= (uint64_t)b->pin_view; h *= 1099511628211ull;
    return h;
}

static void rtx_ws_safe_note(RtxBuf *b) {
    if (!b) return;
    b->safe_gen = b->doc.edit_gen;
    b->safe_saved = b->doc.saved_head;
    b->safe_caret = b->doc.caret;
    b->safe_sel = b->doc.sel_anchor;
    b->safe_seek = b->seek_off;
    b->safe_top = b->top;
    b->safe_tw = b->top_wrap;
    b->safe_left = b->left_col;
    b->safe_tbyte = b->top_byte;
    b->safe_moff = b->doc.tree.mark_off;
    b->safe_srel = b->seek_rel;
    b->safe_sv = b->seek_valid;
    b->safe_mark = rtx_line_mark_ok(&b->doc.tree);
    b->safe_mline = b->doc.tree.mark_line;
    b->safe_view = b->layout.view;
    b->safe_wrap = b->layout.wrap;
    b->safe_rich = b->layout.rich;
    b->safe_nib = b->hex_nib;
    b->safe_unlock = b->unlock;
    b->safe_pin = b->pin_view;
    b->park_dirty = b->doc.dirty();
    if (!b->park_dirty) b->safe_rebased = 0; /* saved or undone: no drift left */
    b->safe_seen_sig = rtx_ws_safe_sig(b);
    b->safe_due_ms = 0;
}

static int rtx_ws_safe_hist_stale(const RtxBuf *b) {
    if (!b || b->parked) return 0;
    return b->safe_gen != b->doc.edit_gen || b->safe_saved != b->doc.saved_head;
}

static int rtx_ws_safe_stale(const RtxBuf *b) {
    if (!b || b->parked) return 0;
    if (rtx_ws_safe_hist_stale(b))
        return 1;
    if (b->safe_caret != b->doc.caret || b->safe_sel != b->doc.sel_anchor)
        return 1;
    if (b->safe_seek != b->seek_off || b->safe_top != b->top)
        return 1;
    if (b->safe_tw != b->top_wrap || b->safe_left != b->left_col ||
        b->safe_tbyte != b->top_byte)
        return 1;
    if (b->safe_srel != b->seek_rel || b->safe_sv != b->seek_valid)
        return 1;
    if (b->safe_mark != rtx_line_mark_ok(&b->doc.tree) ||
        b->safe_mline != b->doc.tree.mark_line ||
        b->safe_moff != b->doc.tree.mark_off)
        return 1;
    if (b->safe_view != b->layout.view || b->safe_wrap != b->layout.wrap ||
        b->safe_rich != b->layout.rich || b->safe_nib != b->hex_nib ||
        b->safe_unlock != b->unlock || b->safe_pin != b->pin_view)
        return 1;
    return 0;
}

static int rtx_ws_flush_hist_buf(RtxBuf *b) {
    RtxSafeCam cam;
    int ok;
    if (!b || b->parked) return 1;
    if (!rtx_ws_buf_path(b)) return 1;
    /* The held journal is the only copy of those edits: never overwrite it. */
    if (b->safe_hold) return 0;
    rtx_ws_cam_from_buf(b, &cam);
    ok = rtx_safe_flush(&b->doc, &cam);
    if (ok) {
        b->safe_fault = 0;
        b->safe_backoff_ms = 0;
        b->safe_retry_ms = 0;
    } else if (b->doc.dirty()) {
        b->safe_fault = 1;
    }
    return ok;
}

static int rtx_ws_flush_state_buf(RtxBuf *b) {
    RtxSafeCam cam;
    if (!b || b->parked) return 1;
    if (!rtx_ws_buf_path(b)) return 1;
    rtx_ws_cam_from_buf(b, &cam);
    return rtx_safe_flush_state(&b->doc, &cam);
}

static void rtx_ws_flush_buf(RtxBuf *b) {
    if (!b || b->parked) return;
    if (!rtx_ws_buf_path(b)) return;
    if (rtx_ws_safe_hist_stale(b) && !rtx_ws_flush_hist_buf(b))
        return;
    (void)rtx_ws_flush_state_buf(b);
    rtx_ws_safe_note(b);
}

static void rtx_ws_park_buf(RtxBuf *b) {
    int view;
    if (!b || b->parked) return;
    if (!rtx_ws_buf_path(b)) return;
    if (b->doc.dirty() || rtx_ws_safe_hist_stale(b)) {
        if (!rtx_ws_flush_hist_buf(b) && b->doc.dirty()) return;
    }
    (void)rtx_ws_flush_state_buf(b);
    rtx_ws_safe_note(b);
    b->park_dirty = b->doc.dirty();
    view = b->layout.view;
    b->layout.destroy();
    b->doc.destroy();
    b->doc = (RtxDoc){0};
    b->layout = (RtxLayout){0};
    rtx_layout_set_view(&b->layout, view);
    b->parked = 1;
}

/* Open path + its journal. A dirty journal whose file drifted on disk
 * opens its pinned base instead (bytes as they were under the edits, named
 * path, stamped with the old identity so Save asks) and replays there;
 * *rebased says so. Anything that leaves bytes that are neither the file
 * nor the journal (a replay that fails midway, a pin whose journal does
 * not load) reopens the file clean; the journal stays on disk and the rc
 * (FAULT / CONFLICT) tells the caller to hold it. */
static int !>(CCError) rtx_ws_doc_open(RtxWs *w, RtxDoc *d, const char *path,
                                      RtxSafeCam *cam, int *rebased) {
    char base[4096];
    int64_t bm = 0;
    uint64_t bs = 0, bi = 0;
    int pinned, rc;
    if (rebased) *rebased = 0;
    pinned = rtx_safe_base(path, base, sizeof(base), &bm, &bs, &bi);
    if (pinned) {
        @errhandler(CCError e) {
            (void)e;
            d->destroy();
            pinned = 0;
        }
        d->from_base(cc_slice_cstr(base), cc_slice_cstr(path), bm, bs, bi) !>;
    }
    if (!pinned) d->from_path(cc_slice_cstr(path)) !>(e) { return cc_err(e); };
    if (w) d->tree.busy_bind(w->busy_fn, w->busy_ctx);
    rc = rtx_safe_load(d, cam);
    if (rc == RTX_SAFE_LOAD_FAULT || (pinned && rc != RTX_SAFE_LOAD_HIST)) {
        d->destroy();
        rtx_safe_cam_clear(cam);
        d->from_path(cc_slice_cstr(path)) !>(e) { return cc_err(e); };
        if (w) d->tree.busy_bind(w->busy_fn, w->busy_ctx);
    } else if (pinned && rebased) {
        *rebased = 1;
    }
    return cc_ok(rc);
}

static int rtx_ws_hold_of(int rc) {
    if (rc == RTX_SAFE_LOAD_FAULT) return RTX_SAFE_HOLD_REPLAY;
    if (rc == RTX_SAFE_LOAD_CONFLICT) return RTX_SAFE_HOLD_CONFLICT;
    return RTX_SAFE_HOLD_NONE;
}

static void !>(CCError) rtx_ws_unpark_buf(RtxWs *w, RtxBuf *b) {
    RtxSafeCam cam;
    const char *path;
    int rc;
    if (!b || !b->parked) return cc_ok();
    path = rtx_ws_buf_path(b);
    if (!path) return cc_err(CC_ERR_INVALID_ARG, "parked untitled");
    rtx_safe_cam_clear(&cam);
    rc = rtx_ws_doc_open(w, &b->doc, path, &cam, &b->safe_rebased) !>(e) {
        return cc_err(e);
    };
    b->safe_hold = rtx_ws_hold_of(rc);
    rtx_ws_cam_to_buf(b, &cam);
    b->parked = 0;
    rtx_ws_safe_note(b);
    return cc_ok();
}

static int rtx_ws_slot_live(const RtxWs *w, int p) {
    return w && p >= 0 && p < RTX_PANES_MAX && ((w->live_mask >> p) & 1u);
}

static int rtx_ws_buf_visible(const RtxWs *w, int bi) {
    int i;
    if (!w || bi < 0) return 0;
    for (i = 0; i < w->npanes && i < RTX_PANES_MAX; i++) {
        int p = w->order[i];
        if (rtx_ws_slot_live(w, p) && w->pane[p] == bi) return 1;
    }
    return 0;
}

/* Preorder copy of the pane tree into the snapshot's flat node table.
 * Leaves name an entry of the written path list (-1 = untitled). */
static int rtx_ws_snap_tree(const RtxWs *w, int n, const int *ent_of_buf,
                            RtxSafeWs *ws, int depth) {
    int k, a, b;
    const RtxPaneNode *nd;
    if (!w || n < 0 || n >= RTX_PANE_NODES || depth > RTX_PANE_NODES) return -1;
    if (ws->nnode >= RTX_SAFE_WS_NODES) return -1;
    nd = &w->node[n];
    k = ws->nnode++;
    ws->node[k] = (RtxSafeWsNode){0};
    if (nd->kind == RTX_PANE_NODE_LEAF) {
        int bi = w->pane[nd->pane];
        ws->node[k].kind = RTX_SAFE_WS_LEAF;
        ws->node[k].ent = (bi >= 0 && (size_t)bi < w->len && bi < 64) ? ent_of_buf[bi] : -1;
        ws->node[k].split = w->browse_split[nd->pane];
        ws->node[k].a = -1;
        ws->node[k].b = -1;
        if (nd->pane == w->focus) ws->focus_node = k;
        return k;
    }
    if (nd->kind != RTX_PANE_NODE_SPLIT) return -1;
    ws->node[k].kind = RTX_SAFE_WS_SPLIT;
    ws->node[k].dir = nd->dir;
    ws->node[k].ratio = nd->ratio;
    a = rtx_ws_snap_tree(w, nd->a, ent_of_buf, ws, depth + 1);
    b = rtx_ws_snap_tree(w, nd->b, ent_of_buf, ws, depth + 1);
    if (a < 0 || b < 0) return -1;
    ws->node[k].a = a;
    ws->node[k].b = b;
    return k;
}

static void rtx_ws_write_ws(RtxWs *w) {
    RtxSafeWs ws;
    RtxSafeWsEnt ents[64];
    int ent_of_buf[64];
    size_t i, n = 0;
    if (!w) return;
    if (!rtx_safe_enabled()) {
        /* --batch without --safe: nothing would land; skip the snapshot. */
        w->browse_split_dirty = 0;
        w->ws_pending = 0;
        return;
    }
    ws = (RtxSafeWs){0};
    for (i = 0; i < w->len; i++) {
        const char *path = rtx_ws_buf_path(w->bufs[i]);
        if (i < 64) ent_of_buf[i] = -1;
        if (!path || n >= 64 || i >= 64) continue;
        /* Panes name an entry of this list, not a buffer slot: untitled
         * buffers are not written, so slots and entries drift apart. */
        ent_of_buf[i] = (int)n;
        snprintf(ents[n].path, sizeof(ents[n].path), "%s", path);
        ents[n].view = w->bufs[i]->layout.view;
        ents[n].dirty = rtx_ws_buf_dirty(w->bufs[i]);
        n++;
    }
    ws.n = n;
    ws.ents = ents;
    ws.focus_node = -1;
    ws.root = -1;
    {
        /* Browse dividers: shown panes in tree order, then the rest. */
        int k, p, m = 0;
        for (k = 0; k < w->npanes && m < RTX_SAFE_WS_PANES; k++)
            if (w->order[k] >= 0) ws.splits[m++] = w->browse_split[w->order[k]];
        for (p = 0; p < RTX_PANES_MAX && m < RTX_SAFE_WS_PANES; p++)
            if (!rtx_ws_slot_live(w, p)) ws.splits[m++] = w->browse_split[p];
    }
    if (w->root >= 0 && w->root < RTX_PANE_NODES &&
        w->node[w->root].kind != RTX_PANE_NODE_FREE &&
        rtx_ws_snap_tree(w, w->root, ent_of_buf, &ws, 0) >= 0) {
        ws.root = 0;
    } else {
        ws.nnode = 0;
    }
    rtx_safe_ws_write(&ws);
    w->browse_split_dirty = 0;
    w->ws_pending = 0;
}

/* 0 = b stays parked (file moved, deleted, unreadable) and says so; its
 * journal is untouched and the evicted doc is never shown. */
static int rtx_ws_try_unpark(RtxWs *w, RtxBuf *b) {
    int ok = 1;
    {
        @errhandler(CCError e) {
            (void)e;
            ok = 0;
        }
        rtx_ws_unpark_buf(w, b) !>;
    }
    b->park_fault = !ok;
    return ok;
}

void !>(CCError) RtxWs_sync_live(RtxWs *w) {
    size_t i;
    int k;
    if (!w || w->len == 0) return cc_ok();
    RtxWs_panes_fix(w);
    /* Every visible pane shows a live doc. A buffer that cannot come back
     * hands its pane to the next one that can; the rest keep going. */
    for (k = 0; k < w->npanes; k++) {
        size_t tries;
        int p = w->order[k];
        int bi = w->pane[p];
        if (bi < 0 || (size_t)bi >= w->len) bi = 0;
        for (tries = 0; tries < w->len; tries++) {
            RtxBuf *b = w->bufs[bi];
            if (!b->parked || rtx_ws_try_unpark(w, b)) break;
            bi = (bi + 1) % (int)w->len;
        }
        if (tries == w->len) {
            w->add_empty() !>(e) { return cc_err(e); };
            bi = (int)w->len - 1;
        }
        w->pane[p] = bi;
    }
    RtxWs_panes_fix(w);
    for (i = 0; i < w->len; i++) {
        if (!rtx_ws_buf_visible(w, (int)i) && !w->bufs[i]->parked &&
            rtx_ws_buf_path(w->bufs[i]))
            rtx_ws_park_buf(w->bufs[i]);
    }
    if (w->ws_hold) w->ws_pending = 1;
    else rtx_ws_write_ws(w);
    return cc_ok();
}

/* Startup: open_files' sync leaves the snapshot (temp + fsync + rename)
 * to safe_pump, which the host runs after the frame — opening a file
 * paints first. */
static void !>(CCError) rtx_ws_sync_live_deferred(RtxWs *w) {
    w->ws_hold = 1;
    w->sync_live() !>(e) {
        w->ws_hold = 0;
        return cc_err(e);
    };
    w->ws_hold = 0;
    return cc_ok();
}

void RtxWs_safe_flush_all(RtxWs *w) {
    size_t i;
    if (!w) return;
    for (i = 0; i < w->len; i++) rtx_ws_flush_buf(w->bufs[i]);
    rtx_ws_write_ws(w);
}

void RtxWs_safe_flush_exit(RtxWs *w) {
    if (!w) return;
    /* Divider is a preference, not an edit. A dirty quit still skips the
     * buffer journals, but a drag that has not debounced yet must land. */
    if (w->any_dirty()) {
        if (w->browse_split_dirty || w->ws_pending) rtx_ws_write_ws(w);
        return;
    }
    RtxWs_safe_flush_all(w);
}

int rtx_ws_safe_fault(const RtxWs *w) {
    size_t i;
    if (!w) return 0;
    for (i = 0; i < w->len; i++)
        if (w->bufs[i]->safe_fault) return 1;
    return 0;
}

static const char *rtx_ws_base_name(const char *p) {
    const char *s = p ? strrchr(p, '/') : NULL;
    return s ? s + 1 : (p ? p : "");
}

int rtx_ws_safe_fault_msg(const RtxWs *w, char *out, size_t n) {
    size_t i;
    if (!w || !out || n == 0) return 0;
    out[0] = 0;
    for (i = 0; i < w->len; i++) {
        const RtxBuf *b = w->bufs[i];
        const char *name = rtx_ws_base_name(rtx_ws_buf_path(b));
        switch (b->safe_hold) {
        case RTX_SAFE_HOLD_REPLAY:
            snprintf(out, n,
                     "%s: Safe journal could not be replayed; showing the file, "
                     "journal kept (quit q drops it)", name);
            return 1;
        case RTX_SAFE_HOLD_CONFLICT:
            snprintf(out, n,
                     "%s changed on disk: unsaved edits held in Safe journal, "
                     "not applied (quit q drops them)", name);
            return 1;
        case RTX_SAFE_HOLD_NONE:
            break;
        }
    }
    for (i = 0; i < w->len; i++) {
        const RtxBuf *b = w->bufs[i];
        if (!b->park_fault) continue;
        snprintf(out, n,
                 "%s could not be reopened (moved or deleted?); its Safe journal is kept",
                 rtx_ws_base_name(rtx_ws_buf_path(b)));
        return 1;
    }
    for (i = 0; i < w->len; i++) {
        const RtxBuf *b = w->bufs[i];
        if (b->parked || !b->safe_rebased || !b->doc.dirty()) continue;
        snprintf(out, n,
                 "%s changed on disk: recovered edits are on the version you had "
                 "(Save asks to overwrite)",
                 rtx_ws_base_name(rtx_ws_buf_path(b)));
        return 1;
    }
    if (rtx_ws_safe_fault(w)) {
        snprintf(out, n, "Safe journal write failed — unsaved edits kept in memory");
        return 1;
    }
    return 0;
}

unsigned rtx_ws_safe_fault_sig(const RtxWs *w) {
    char msg[512];
    unsigned h = 2166136261u;
    size_t i;
    if (!rtx_ws_safe_fault_msg(w, msg, sizeof(msg))) return 0;
    for (i = 0; msg[i]; i++) h = (h ^ (unsigned char)msg[i]) * 16777619u;
    return h ? h : 1;
}

void RtxWs_safe_pump(RtxWs *w) {
    size_t i;
    long now;
    if (!w) return;
    now = rtx_ws_now_ms();
    if (w->browse_split_dirty && now >= w->browse_split_due) {
        rtx_ws_write_ws(w);
        w->browse_split_due = now + (long)RTX_SAFE_DEBOUNCE_MS;
    } else if (w->ws_pending) {
        rtx_ws_write_ws(w);
    }
    for (i = 0; i < w->len; i++) {
        RtxBuf *b = w->bufs[i];
        uint64_t sig;
        if (b->parked || !rtx_ws_buf_path(b)) continue;
        if (!rtx_ws_safe_stale(b)) {
            b->safe_due_ms = 0;
            b->safe_seen_sig = 0;
            continue;
        }
        sig = rtx_ws_safe_sig(b);
        if (sig != b->safe_seen_sig) {
            b->safe_seen_sig = sig;
            b->safe_due_ms = now + (long)RTX_SAFE_DEBOUNCE_MS;
            /* A new edit does not jump a failed write's backoff. */
            if (b->safe_due_ms < b->safe_retry_ms) b->safe_due_ms = b->safe_retry_ms;
        }
        if (now < b->safe_due_ms) continue;
        if (rtx_ws_safe_hist_stale(b) && !rtx_ws_flush_hist_buf(b)) {
            /* Idle retry doubles up to RTX_SAFE_BACKOFF_MAX_MS, not every
             * frame. Park / flush-all / save still try at once. */
            if (!b->safe_backoff_ms) b->safe_backoff_ms = (long)RTX_SAFE_DEBOUNCE_MS;
            else if (b->safe_backoff_ms < (long)RTX_SAFE_BACKOFF_MAX_MS)
                b->safe_backoff_ms *= 2;
            if (b->safe_backoff_ms > (long)RTX_SAFE_BACKOFF_MAX_MS)
                b->safe_backoff_ms = (long)RTX_SAFE_BACKOFF_MAX_MS;
            b->safe_retry_ms = now + b->safe_backoff_ms;
            b->safe_due_ms = b->safe_retry_ms;
            continue;
        }
        (void)rtx_ws_flush_state_buf(b);
        rtx_ws_safe_note(b);
    }
}

long RtxWs_safe_next_ms(const RtxWs *w, long now) {
    size_t i;
    long due = 0;
    if (!w) return -1;
    if (w->ws_pending) return 0;
    if (w->browse_split_dirty) due = w->browse_split_due;
    for (i = 0; i < w->len; i++) {
        const RtxBuf *b = w->bufs[i];
        if (b->parked || !b->safe_due_ms) continue;
        if (!due || b->safe_due_ms < due) due = b->safe_due_ms;
    }
    if (!due) return -1;
    return due > now ? due - now : 0;
}

int RtxWs_any_disk_changed(const RtxWs *w) {
    size_t i;
    if (!w) return 0;
    for (i = 0; i < w->len; i++) {
        const RtxBuf *b = w->bufs[i];
        if (b->parked) {
            /* Parked dirty edits live in the journal: compare its base. */
            const char *p = rtx_ws_buf_path(b);
            if (b->park_dirty && p && rtx_safe_peek_conflict(p)) return 1;
            continue;
        }
        if (!b->doc.dirty()) continue;
        if (b->doc.disk_changed()) return 1;
    }
    return 0;
}

void !>(CCError) RtxWs_save_dirty(RtxWs *w) {
    size_t i;
    if (!w) return cc_err(CC_ERR_INVALID_ARG, "null ws");
    for (i = 0; i < w->len; i++) {
        RtxBuf *b = w->bufs[i];
        if (b->parked && (b->park_dirty || b->safe_hold))
            rtx_ws_unpark_buf(w, b) !>(e) { return cc_err(e); };
        /* Those edits are in a journal this buffer could not apply: a Save
         * now would report success and leave them behind. */
        if (b->safe_hold)
            return cc_err(CC_ERR_IO, "unsaved edits held in Safe journal");
        if (b->parked || !b->doc.dirty()) continue;
        if (!b->doc.path.ptr || b->doc.path.len == 0)
            return cc_err(CC_ERR_INVALID_ARG, "untitled");
        if (b->doc.disk_changed())
            return cc_err(CC_ERR_IO, "file changed on disk");
    }
    for (i = 0; i < w->len; i++) {
        RtxBuf *b = w->bufs[i];
        if (b->parked || !b->doc.dirty()) continue;
        if (!b->doc.path.ptr || b->doc.path.len == 0)
            return cc_err(CC_ERR_INVALID_ARG, "untitled");
        b->doc.save() !>(e) { return cc_err(e); };
        b->doc.break_coalesce();
        rtx_ws_flush_buf(b);
    }
    rtx_ws_write_ws(w);
    return cc_ok();
}

void RtxWs_safe_discard_dirty(RtxWs *w) {
    size_t i;
    if (!w) return;
    for (i = 0; i < w->len; i++) {
        if (!rtx_ws_buf_dirty(w->bufs[i])) continue;
        {
            const char *p = rtx_ws_buf_path(w->bufs[i]);
            if (p) rtx_safe_drop(p);
        }
        w->bufs[i]->park_dirty = 0;
        w->bufs[i]->safe_hold = RTX_SAFE_HOLD_NONE;
    }
    rtx_ws_write_ws(w);
}

static void rtx_buf_swap_cam(RtxBuf *b, RtxPaneSnap *s) {
    RtxLayout L;
    size_t z;
    int i;
    double d;
    RtxPref pr;
    if (!b || !s) return;
    L = b->layout; b->layout = s->layout; s->layout = L;
    z = b->top; b->top = s->top; s->top = z;
    z = b->top_wrap; b->top_wrap = s->top_wrap; s->top_wrap = z;
    z = b->left_col; b->left_col = s->left_col; s->left_col = z;
    z = b->top_byte; b->top_byte = s->top_byte; s->top_byte = z;
    i = b->seek_valid; b->seek_valid = s->seek_valid; s->seek_valid = i;
    z = b->seek_off; b->seek_off = s->seek_off; s->seek_off = z;
    {
        long rel = b->seek_rel;
        b->seek_rel = s->seek_rel;
        s->seek_rel = rel;
    }
    z = b->drag_vis; b->drag_vis = s->drag_vis; s->drag_vis = z;
    z = b->drag_len; b->drag_len = s->drag_len; s->drag_len = z;
    i = b->drag_grab; b->drag_grab = s->drag_grab; s->drag_grab = i;
    i = b->drag_horiz; b->drag_horiz = s->drag_horiz; s->drag_horiz = i;
    i = b->pin_view; b->pin_view = s->pin_view; s->pin_view = i;
    i = b->unlock; b->unlock = s->unlock; s->unlock = i;
    i = b->hex_nib; b->hex_nib = s->hex_nib; s->hex_nib = i;
    d = b->scroll; b->scroll = s->scroll; s->scroll = d;
    d = b->layout_width; b->layout_width = s->layout_width; s->layout_width = d;
    pr = b->pref; b->pref = s->pref; s->pref = pr;
}

/* --- panes (DESIGN Interactive, Panes) ---
 *
 * A pane is a slot: its buf (pane[slot]), browse (nav / prev), and a
 * camera. The camera fields of RtxBuf belong to one pane that shows it
 * (b->cam_pane) — always the focused pane when it shows that buf, since
 * every RtxBuf_* motion and edit runs on those fields. Any other pane on
 * the same buf keeps its camera + layout in cam[slot] (`of` = that buf);
 * hold_pane swaps it onto the buf for a draw or a refresh. */

static void rtx_ws_cam_drop(RtxPaneSnap *s) {
    if (!s) return;
    if (s->live) s->layout.destroy();
    *s = (RtxPaneSnap){0};
}

/* A second camera on b: the same origin, its own layout. */
static void rtx_ws_cam_seed(RtxPaneSnap *s, const RtxBuf *b) {
    *s = (RtxPaneSnap){0};
    s->live = 1;
    s->of = b;
    s->top = b->top;
    s->top_wrap = b->top_wrap;
    s->left_col = b->left_col;
    s->top_byte = b->top_byte;
    s->seek_valid = b->seek_valid;
    s->seek_off = b->seek_off;
    s->seek_rel = b->seek_rel;
    s->unlock = b->unlock;
    s->layout.view = b->layout.view;
    s->layout.wrap = b->layout.wrap;
    s->layout.rich = b->layout.rich;
    s->layout.grid_delim = b->layout.grid_delim;
}

int RtxWs_pane_live(const RtxWs *w, int p) {
    return rtx_ws_slot_live(w, p);
}

static int rtx_ws_node_new(RtxWs *w) {
    int i;
    for (i = 0; i < RTX_PANE_NODES; i++) {
        if (w->node[i].kind != RTX_PANE_NODE_FREE) continue;
        w->node[i] = (RtxPaneNode){0};
        w->node[i].kind = RTX_PANE_NODE_LEAF;
        w->node[i].up = -1;
        w->node[i].a = -1;
        w->node[i].b = -1;
        return i;
    }
    return -1;
}

static int rtx_ws_leaf_of(const RtxWs *w, int p) {
    int i;
    for (i = 0; i < RTX_PANE_NODES; i++)
        if (w->node[i].kind == RTX_PANE_NODE_LEAF && w->node[i].pane == p) return i;
    return -1;
}

static int rtx_ws_node_ok(const RtxWs *w, int n) {
    return w && n >= 0 && n < RTX_PANE_NODES && w->node[n].kind != RTX_PANE_NODE_FREE;
}

/* Leaves under n, in order. -1 on a malformed tree (a cycle, a free
 * child, more than RTX_PANES_MAX leaves). */
static int rtx_ws_walk(const RtxWs *w, int n, int *out, int k, int depth) {
    const RtxPaneNode *nd;
    if (!rtx_ws_node_ok(w, n) || depth > RTX_PANE_NODES || k < 0) return -1;
    nd = &w->node[n];
    if (nd->kind == RTX_PANE_NODE_LEAF) {
        if (k >= RTX_PANES_MAX || nd->pane < 0 || nd->pane >= RTX_PANES_MAX) return -1;
        out[k] = nd->pane;
        return k + 1;
    }
    k = rtx_ws_walk(w, nd->a, out, k, depth + 1);
    return rtx_ws_walk(w, nd->b, out, k, depth + 1);
}

static int rtx_ws_first_leaf(const RtxWs *w, int n) {
    int guard = 0;
    while (rtx_ws_node_ok(w, n) && w->node[n].kind == RTX_PANE_NODE_SPLIT &&
           guard++ < RTX_PANE_NODES)
        n = w->node[n].a;
    return rtx_ws_node_ok(w, n) && w->node[n].kind == RTX_PANE_NODE_LEAF
               ? w->node[n].pane : -1;
}

static int rtx_ws_tree_ok(const RtxWs *w) {
    int leaves[RTX_PANES_MAX];
    unsigned seen = 0;
    int k, i;
    if (!rtx_ws_node_ok(w, w->root)) return 0;
    if (w->tree_n != w->npanes) return 0;
    k = rtx_ws_walk(w, w->root, leaves, 0, 0);
    if (k != w->npanes) return 0;
    for (i = 0; i < k; i++) {
        if (seen & (1u << leaves[i])) return 0;
        seen |= 1u << leaves[i];
    }
    return 1;
}

/* Slots 0..npanes-1 side by side, equal widths (a hand-set npanes). */
static void rtx_ws_tree_build(RtxWs *w) {
    int n = w->npanes, s, sub;
    int i;
    for (i = 0; i < RTX_PANE_NODES; i++) w->node[i] = (RtxPaneNode){0};
    if (n < 1) n = 1;
    if (n > RTX_PANES_MAX) n = RTX_PANES_MAX;
    sub = rtx_ws_node_new(w);
    w->node[sub].pane = n - 1;
    for (s = n - 2; s >= 0; s--) {
        int leaf = rtx_ws_node_new(w);
        int sp;
        w->node[leaf].pane = s;
        sp = rtx_ws_node_new(w);
        w->node[sp].kind = RTX_PANE_NODE_SPLIT;
        w->node[sp].dir = RTX_SPLIT_COLS;
        w->node[sp].ratio = 1000 / (n - s);
        w->node[sp].a = leaf;
        w->node[sp].b = sub;
        w->node[leaf].up = sp;
        w->node[sub].up = sp;
        sub = sp;
    }
    w->root = sub;
    w->npanes = n;
    w->tree_n = n;
}

static void rtx_ws_order(RtxWs *w) {
    int k = rtx_ws_walk(w, w->root, w->order, 0, 0);
    int i;
    if (k < 1) k = 0;
    w->live_mask = 0;
    for (i = 0; i < k; i++) w->live_mask |= 1u << w->order[i];
    for (i = k; i < RTX_PANES_MAX; i++) w->order[i] = -1;
    w->npanes = k;
    w->tree_n = k;
}

/* The focused pane's camera is its buf's own. */
static void rtx_ws_focus_own(RtxWs *w) {
    int p = w->focus, o;
    RtxBuf *b;
    if (!rtx_ws_slot_live(w, p) || w->pane[p] < 0 || (size_t)w->pane[p] >= w->len)
        return;
    b = w->bufs[w->pane[p]];
    o = b->cam_pane;
    if (o == p) return;
    if (!w->cam[p].live || w->cam[p].of != b) {
        b->cam_pane = p;
        return;
    }
    /* p's camera onto the buf; the owner's goes to its own slot. */
    rtx_buf_swap_cam(b, &w->cam[p]);
    if (rtx_ws_slot_live(w, o) && o != p) {
        rtx_ws_cam_drop(&w->cam[o]);
        w->cam[o] = w->cam[p];
        w->cam[o].of = b;
        w->cam[o].live = 1;
        w->cam[p] = (RtxPaneSnap){0};
    } else {
        rtx_ws_cam_drop(&w->cam[p]);
    }
    b->cam_pane = p;
}

static void rtx_ws_cams_fix(RtxWs *w) {
    int i, p;
    size_t bi;
    /* Dead slots and cameras on a buf the pane no longer shows. */
    for (p = 0; p < RTX_PANES_MAX; p++) {
        if (!w->cam[p].live) continue;
        if (!rtx_ws_slot_live(w, p) || w->pane[p] < 0 || (size_t)w->pane[p] >= w->len ||
            w->cam[p].of != w->bufs[w->pane[p]])
            rtx_ws_cam_drop(&w->cam[p]);
    }
    /* Each shown buf: its own camera belongs to a pane that shows it. */
    for (i = 0; i < w->npanes; i++) {
        RtxBuf *b;
        int o, q;
        p = w->order[i];
        if (w->pane[p] < 0 || (size_t)w->pane[p] >= w->len) continue;
        b = w->bufs[w->pane[p]];
        o = b->cam_pane;
        if (rtx_ws_slot_live(w, o) && w->pane[o] == w->pane[p]) continue;
        q = (rtx_ws_slot_live(w, w->focus) && w->pane[w->focus] == w->pane[p]) ? w->focus : p;
        if (w->cam[q].live) {
            /* The buf's camera was a pane's that left: q keeps its own. */
            rtx_buf_swap_cam(b, &w->cam[q]);
            rtx_ws_cam_drop(&w->cam[q]);
        }
        b->cam_pane = q;
    }
    for (i = 0; i < w->npanes; i++) {
        RtxBuf *b;
        p = w->order[i];
        if (w->pane[p] < 0 || (size_t)w->pane[p] >= w->len) continue;
        b = w->bufs[w->pane[p]];
        if (b->cam_pane == p) {
            if (w->cam[p].live) rtx_ws_cam_drop(&w->cam[p]);
        } else if (!w->cam[p].live) {
            rtx_ws_cam_seed(&w->cam[p], b);
        }
    }
    rtx_ws_focus_own(w);
    for (bi = 0; bi < w->len; bi++)
        if (!rtx_ws_buf_visible(w, (int)bi)) w->bufs[bi]->cam_pane = -1;
}

void RtxWs_panes_fix(RtxWs *w) {
    int i;
    if (!w) return;
    if (w->npanes < 1) w->npanes = 1;
    if (w->npanes > RTX_PANES_MAX) w->npanes = RTX_PANES_MAX;
    if (!rtx_ws_tree_ok(w)) rtx_ws_tree_build(w);
    rtx_ws_order(w);
    if (!rtx_ws_slot_live(w, w->focus)) w->focus = w->order[0];
    if (w->len == 0) return;
    for (i = 0; i < w->npanes; i++) {
        int p = w->order[i];
        if (w->pane[p] < 0 || (size_t)w->pane[p] >= w->len) w->pane[p] = 0;
    }
    rtx_ws_cams_fix(w);
}

int RtxWs_same_split(const RtxWs *w) {
    int i, j;
    if (!w) return 0;
    for (i = 0; i < w->npanes; i++)
        for (j = i + 1; j < w->npanes; j++)
            if (w->pane[w->order[i]] == w->pane[w->order[j]]) return 1;
    return 0;
}

int RtxWs_hold_pane(RtxWs *w, int p) {
    RtxBuf *b;
    if (!w || p < 0 || p >= RTX_PANES_MAX || w->len == 0) return 0;
    if (w->pane[p] < 0 || (size_t)w->pane[p] >= w->len) return 0;
    b = w->bufs[w->pane[p]];
    if (b->cam_pane == p || !w->cam[p].live || w->cam[p].of != b) return 0;
    rtx_buf_swap_cam(b, &w->cam[p]);
    return 1;
}

void RtxWs_drop_pane(RtxWs *w, int p, int held) {
    if (held) rtx_buf_swap_cam(w->bufs[w->pane[p]], &w->cam[p]);
}

/* A camera's window: its laid-out rows, else its origin. */
static void rtx_ws_cam_win(const RtxLayout *L, size_t origin, size_t *lo, size_t *hi) {
    if (L && L->rows.len) {
        *lo = L->rows.data[0].byte_start;
        *hi = L->rows.data[L->rows.len - 1].byte_start +
              L->rows.data[L->rows.len - 1].byte_len;
    } else {
        *lo = *hi = origin;
    }
}

void RtxBuf_hl_trim(RtxBuf *b) {
    size_t lo[2], hi[2];
    if (!b) return;
    rtx_ws_cam_win(&b->layout, b->seek_valid ? b->seek_off : b->doc.caret, &lo[0], &hi[0]);
    lo[1] = hi[1] = b->doc.caret;
    RtxDoc_hl_trim(&b->doc, lo, hi, 2);
}

/* Each buffer keeps the runs near every camera on it (panes showing it,
 * held or not) and near its caret; the rest go (RtxDoc_hl_trim). */
void RtxWs_hl_trim(RtxWs *w) {
    size_t lo[RTX_HL_TRIM_WINS], hi[RTX_HL_TRIM_WINS];
    size_t i;
    if (!w) return;
    for (i = 0; i < w->len; i++) {
        RtxBuf *b = w->bufs[i];
        size_t n = 0;
        int k;
        if (!b) continue;
        rtx_ws_cam_win(&b->layout, b->seek_valid ? b->seek_off : b->doc.caret, &lo[n],
                       &hi[n]);
        n++;
        lo[n] = hi[n] = b->doc.caret;
        n++;
        for (k = 0; k < RTX_PANES_MAX && n < (size_t)RTX_HL_TRIM_WINS; k++) {
            const RtxPaneSnap *s = &w->cam[k];
            if (!rtx_ws_slot_live(w, k) || w->pane[k] != (int)i || b->cam_pane == k ||
                !s->live || s->of != b)
                continue;
            rtx_ws_cam_win(&s->layout, s->seek_valid ? s->seek_off : b->doc.caret, &lo[n],
                           &hi[n]);
            n++;
        }
        RtxDoc_hl_trim(&b->doc, lo, hi, n);
    }
}

/* A slot that is about to show something new: no browse, no camera. */
static void rtx_ws_slot_clear(RtxWs *w, int s) {
    rtx_browse_drop(&w->nav[s]);
    RtxWs_browse_prev_drop(w, s);
    rtx_ws_cam_drop(&w->cam[s]);
    w->pane_w[s] = 0;
    w->pane_vis[s] = 0;
}

int RtxWs_split(RtxWs *w, int dir) {
    int f, s, L, S, N, up;
    if (!w || w->len == 0) return -1;
    RtxWs_panes_fix(w);
    if (w->npanes >= RTX_PANES_MAX) return -1;
    f = w->focus;
    for (s = 0; s < RTX_PANES_MAX; s++)
        if (!rtx_ws_slot_live(w, s)) break;
    L = rtx_ws_leaf_of(w, f);
    if (s >= RTX_PANES_MAX || L < 0) return -1;
    S = rtx_ws_node_new(w);
    if (S < 0) return -1;
    N = rtx_ws_node_new(w);
    if (N < 0) {
        w->node[S] = (RtxPaneNode){0};
        return -1;
    }
    up = w->node[L].up;
    w->node[S].kind = RTX_PANE_NODE_SPLIT;
    w->node[S].dir = dir == RTX_SPLIT_ROWS ? RTX_SPLIT_ROWS : RTX_SPLIT_COLS;
    w->node[S].ratio = 500;
    w->node[S].a = L;
    w->node[S].b = N;
    w->node[S].up = up;
    w->node[N].pane = s;
    w->node[N].up = S;
    w->node[L].up = S;
    if (up < 0) w->root = S;
    else if (w->node[up].a == L) w->node[up].a = S;
    else w->node[up].b = S;
    rtx_ws_slot_clear(w, s);
    w->browse_split[s] = w->browse_split[f];
    w->pane[s] = w->pane[f];
    rtx_ws_order(w);
    w->focus = s;
    RtxWs_panes_fix(w);
    return s;
}

int RtxWs_close_pane(RtxWs *w, int p) {
    int L, S, T, up;
    if (!w) return 0;
    RtxWs_panes_fix(w);
    if (!rtx_ws_slot_live(w, p) || w->npanes <= 1) return 0;
    L = rtx_ws_leaf_of(w, p);
    S = L >= 0 ? w->node[L].up : -1;
    if (S < 0) return 0;
    T = w->node[S].a == L ? w->node[S].b : w->node[S].a;
    up = w->node[S].up;
    w->node[T].up = up;
    if (up < 0) w->root = T;
    else if (w->node[up].a == S) w->node[up].a = T;
    else w->node[up].b = T;
    w->node[L] = (RtxPaneNode){0};
    w->node[S] = (RtxPaneNode){0};
    rtx_ws_slot_clear(w, p);
    w->browse_split[p] = 0;
    rtx_ws_order(w);
    if (w->focus == p) w->focus = rtx_ws_first_leaf(w, T);
    RtxWs_panes_fix(w);
    {
        @errhandler(CCError e) { (void)e; }
        w->sync_live() !>;
    }
    return 1;
}

void RtxWs_focus_step(RtxWs *w, int dir) {
    int i;
    if (!w) return;
    RtxWs_panes_fix(w);
    if (w->npanes < 2) return;
    for (i = 0; i < w->npanes; i++)
        if (w->order[i] == w->focus) break;
    if (i >= w->npanes) i = 0;
    i = (i + (dir < 0 ? w->npanes - 1 : 1)) % w->npanes;
    RtxWs_set_focus(w, w->order[i]);
}

static void rtx_ws_rects_walk(const RtxWs *w, int n, RtxPaneRect r, int gx, int gy,
                              RtxPaneRect *leaf, RtxPaneRect *nodes, int depth) {
    const RtxPaneNode *nd;
    RtxPaneRect ra, rb;
    int avail, first;
    if (!rtx_ws_node_ok(w, n) || depth > RTX_PANE_NODES) return;
    nd = &w->node[n];
    if (nodes) nodes[n] = r;
    if (nd->kind == RTX_PANE_NODE_LEAF) {
        if (leaf && nd->pane >= 0 && nd->pane < RTX_PANES_MAX) leaf[nd->pane] = r;
        return;
    }
    ra = r;
    rb = r;
    if (nd->dir == RTX_SPLIT_ROWS) {
        avail = r.h - gy;
        if (avail < 0) avail = 0;
        first = (int)((long)avail * nd->ratio / 1000);
        if (avail >= 2) {
            if (first < 1) first = 1;
            if (first > avail - 1) first = avail - 1;
        }
        ra.h = first;
        rb.y = r.y + first + gy;
        rb.h = avail - first;
    } else {
        avail = r.w - gx;
        if (avail < 0) avail = 0;
        first = (int)((long)avail * nd->ratio / 1000);
        if (avail >= 2) {
            if (first < 1) first = 1;
            if (first > avail - 1) first = avail - 1;
        }
        ra.w = first;
        rb.x = r.x + first + gx;
        rb.w = avail - first;
    }
    rtx_ws_rects_walk(w, nd->a, ra, gx, gy, leaf, nodes, depth + 1);
    rtx_ws_rects_walk(w, nd->b, rb, gx, gy, leaf, nodes, depth + 1);
}

void RtxWs_pane_rects(RtxWs *w, RtxPaneRect area, int gx, int gy, RtxPaneRect *out) {
    int i;
    if (!out) return;
    for (i = 0; i < RTX_PANES_MAX; i++) out[i] = (RtxPaneRect){0};
    if (!w) return;
    RtxWs_panes_fix(w);
    rtx_ws_rects_walk(w, w->root, area, gx, gy, out, NULL, 0);
}

/* The gap between a split's children. */
static RtxPaneRect rtx_ws_gap_rect(const RtxWs *w, int n, RtxPaneRect r, int gx, int gy) {
    RtxPaneRect g = r;
    const RtxPaneNode *nd = &w->node[n];
    int avail, first;
    if (nd->dir == RTX_SPLIT_ROWS) {
        avail = r.h - gy;
        if (avail < 0) avail = 0;
        first = (int)((long)avail * nd->ratio / 1000);
        if (avail >= 2) {
            if (first < 1) first = 1;
            if (first > avail - 1) first = avail - 1;
        }
        g.y = r.y + first;
        g.h = gy;
    } else {
        avail = r.w - gx;
        if (avail < 0) avail = 0;
        first = (int)((long)avail * nd->ratio / 1000);
        if (avail >= 2) {
            if (first < 1) first = 1;
            if (first > avail - 1) first = avail - 1;
        }
        g.x = r.x + first;
        g.w = gx;
    }
    return g;
}

int RtxWs_divider_at(RtxWs *w, RtxPaneRect area, int gx, int gy, int x, int y,
                     int slop) {
    RtxPaneRect leaf[RTX_PANES_MAX];
    RtxPaneRect nodes[RTX_PANE_NODES];
    int n;
    if (!w) return -1;
    RtxWs_panes_fix(w);
    for (n = 0; n < RTX_PANE_NODES; n++) nodes[n] = (RtxPaneRect){0};
    rtx_ws_rects_walk(w, w->root, area, gx, gy, leaf, nodes, 0);
    for (n = 0; n < RTX_PANE_NODES; n++) {
        RtxPaneRect g;
        if (w->node[n].kind != RTX_PANE_NODE_SPLIT) continue;
        g = rtx_ws_gap_rect(w, n, nodes[n], gx, gy);
        if (w->node[n].dir == RTX_SPLIT_ROWS) {
            if (x >= g.x && x < g.x + g.w && y >= g.y - slop && y < g.y + g.h + slop)
                return n;
        } else {
            if (y >= g.y && y < g.y + g.h && x >= g.x - slop && x < g.x + g.w + slop)
                return n;
        }
    }
    return -1;
}

int RtxWs_dividers(RtxWs *w, RtxPaneRect area, int gx, int gy, int *node,
                   RtxPaneRect *gap, int max) {
    RtxPaneRect leaf[RTX_PANES_MAX];
    RtxPaneRect nodes[RTX_PANE_NODES];
    int n, k = 0;
    if (!w) return 0;
    RtxWs_panes_fix(w);
    for (n = 0; n < RTX_PANE_NODES; n++) nodes[n] = (RtxPaneRect){0};
    rtx_ws_rects_walk(w, w->root, area, gx, gy, leaf, nodes, 0);
    for (n = 0; n < RTX_PANE_NODES && k < max; n++) {
        if (w->node[n].kind != RTX_PANE_NODE_SPLIT) continue;
        if (node) node[k] = n;
        if (gap) gap[k] = rtx_ws_gap_rect(w, n, nodes[n], gx, gy);
        k++;
    }
    return k;
}

int RtxWs_divider_dir(const RtxWs *w, int node) {
    if (!w || node < 0 || node >= RTX_PANE_NODES ||
        w->node[node].kind != RTX_PANE_NODE_SPLIT)
        return -1;
    return w->node[node].dir;
}

static int rtx_ws_ratio_clamp(int r) {
    if (r < 50) r = 50;
    if (r > 950) r = 950;
    return r;
}

int RtxWs_divider_drag(RtxWs *w, RtxPaneRect area, int gx, int gy, int node,
                       int x, int y) {
    RtxPaneRect leaf[RTX_PANES_MAX];
    RtxPaneRect nodes[RTX_PANE_NODES];
    RtxPaneRect r;
    int avail, at, ratio, n;
    if (!w || node < 0 || node >= RTX_PANE_NODES ||
        w->node[node].kind != RTX_PANE_NODE_SPLIT)
        return 0;
    for (n = 0; n < RTX_PANE_NODES; n++) nodes[n] = (RtxPaneRect){0};
    rtx_ws_rects_walk(w, w->root, area, gx, gy, leaf, nodes, 0);
    r = nodes[node];
    if (w->node[node].dir == RTX_SPLIT_ROWS) {
        avail = r.h - gy;
        at = y - r.y;
    } else {
        avail = r.w - gx;
        at = x - r.x;
    }
    if (avail < 2) return 0;
    if (at < 1) at = 1;
    if (at > avail - 1) at = avail - 1;
    ratio = rtx_ws_ratio_clamp((int)((long)at * 1000 / avail));
    /* Round-trip: keep the ratio whose rect puts the divider at `at`. */
    while (ratio < 950 && (int)((long)avail * ratio / 1000) < at) ratio++;
    if (ratio == w->node[node].ratio) return 0;
    w->node[node].ratio = ratio;
    return 1;
}

int RtxWs_pane_nudge(RtxWs *w, int axis, int delta) {
    int n, guard = 0;
    if (!w) return 0;
    RtxWs_panes_fix(w);
    n = rtx_ws_leaf_of(w, w->focus);
    while (n >= 0 && guard++ < RTX_PANE_NODES) {
        int u = w->node[n].up;
        if (u < 0) break;
        if (w->node[u].dir == axis) {
            int r = rtx_ws_ratio_clamp(w->node[u].ratio + delta);
            if (r == w->node[u].ratio) return 0;
            w->node[u].ratio = r;
            return 1;
        }
        n = u;
    }
    return 0;
}

int RtxWs_focus_dir(RtxWs *w, RtxPaneRect area, int gx, int gy, int dx, int dy) {
    RtxPaneRect r[RTX_PANES_MAX];
    RtxPaneRect f;
    long best = -1;
    int i, pick = -1;
    if (!w) return 0;
    RtxWs_pane_rects(w, area, gx, gy, r);
    if (!rtx_ws_slot_live(w, w->focus)) return 0;
    f = r[w->focus];
    for (i = 0; i < w->npanes; i++) {
        int p = w->order[i];
        RtxPaneRect c = r[p];
        long gap, over, score;
        if (p == w->focus) continue;
        if (dx > 0) gap = c.x - (f.x + f.w);
        else if (dx < 0) gap = f.x - (c.x + c.w);
        else if (dy > 0) gap = c.y - (f.y + f.h);
        else gap = f.y - (c.y + c.h);
        if (gap < 0) continue;
        if (dx) {
            long lo = c.y > f.y ? c.y : f.y;
            long hi = (c.y + c.h) < (f.y + f.h) ? (c.y + c.h) : (f.y + f.h);
            over = hi - lo;
        } else {
            long lo = c.x > f.x ? c.x : f.x;
            long hi = (c.x + c.w) < (f.x + f.w) ? (c.x + c.w) : (f.x + f.w);
            over = hi - lo;
        }
        if (over <= 0) continue;
        score = gap * 100000L - over;
        if (best < 0 || score < best) {
            best = score;
            pick = p;
        }
    }
    if (pick < 0) return 0;
    RtxWs_set_focus(w, pick);
    return 1;
}

void RtxWs_pane_geom(RtxWs *w, int p, double width, int vis) {
    if (!w || p < 0 || p >= RTX_PANES_MAX) return;
    w->pane_w[p] = width;
    w->pane_vis[p] = vis;
}

void RtxWs_destroy(RtxWs *w) {
    size_t i;
    int p;
    if (!w) return;
    /* A snapshot open deferred and no pump ran: it still lands. */
    if (w->ws_pending && w->len) rtx_ws_write_ws(w);
    for (p = 0; p < RTX_PANES_MAX; p++) {
        rtx_ws_cam_drop(&w->cam[p]);
        rtx_browse_drop(&w->nav[p]);
        RtxWs_browse_prev_drop(w, p);
    }
    for (i = 0; i < w->len; i++) {
        w->bufs[i]->destroy();
    }
    w->bufs = NULL;
    w->cap = 0;
    if (w->clip_a.base) w->clip_a.destroy();
    if (w->session.base) w->session.destroy();
    *w = (RtxWs){0};
}

RtxBuf *RtxWs_active(RtxWs *w) {
    int bi, f;
    if (!w || w->len == 0) return NULL;
    f = w->focus;
    if (f < 0 || f >= RTX_PANES_MAX) f = 0;
    bi = w->pane[f];
    if (bi < 0 || (size_t)bi >= w->len) return w->bufs[0];
    return w->bufs[bi];
}

RtxDoc *RtxWs_doc(RtxWs *w) {
    RtxBuf *b = RtxWs_active(w);
    return b ? &b->doc : NULL;
}

RtxLayout *RtxWs_layout(RtxWs *w) {
    RtxBuf *b = RtxWs_active(w);
    return b ? &b->layout : NULL;
}

static void !>(CCError) rtx_ws_fit_bufs(RtxWs *w, size_t need) {
    size_t c, elem, i;
    void *n;
    if (!w) return cc_err(CC_ERR_INVALID_ARG, "ws bufs");
    if (need <= w->cap) return cc_ok();
    if (!w->ensure()) return cc_err(CC_ERR_OUT_OF_MEMORY, "workspace");
    c = w->cap ? w->cap : 8;
    elem = sizeof(RtxBuf *);
    while (c < need) {
        size_t next = c * 2;
        if (next < c) return cc_err(CC_ERR_OUT_OF_MEMORY, "ws bufs overflow");
        c = next;
    }
    n = cc_arena_realloc(w->session, w->session, w->bufs, w->cap * elem, c * elem,
                         _Alignof(RtxBuf *));
    if (!n) return cc_err(CC_ERR_OUT_OF_MEMORY, "ws bufs");
    w->bufs = (RtxBuf **)n;
    for (i = w->cap; i < c; i++) w->bufs[i] = NULL;
    w->cap = c;
    return cc_ok();
}

/* One RtxBuf, allocated once. Growing the pointer table does not move it. */
static RtxBuf *!>(CCError) rtx_ws_new_buf(RtxWs *w) {
    RtxBuf *b;
    if (!w) return cc_err(CC_ERR_INVALID_ARG, "ws buf");
    rtx_ws_fit_bufs(w, w->len + 1) !>(e) { return cc_err(e); };
    b = w->bufs[w->len];
    if (!b) {
        b = (RtxBuf *)cc_arena_alloc(w->session, sizeof(RtxBuf), _Alignof(RtxBuf));
        if (!b) return cc_err(CC_ERR_OUT_OF_MEMORY, "ws buf");
        w->bufs[w->len] = b;
    }
    *b = (RtxBuf){0};
    return cc_ok(b);
}

void !>(CCError) RtxWs_add_path(RtxWs *w, char[:0] path) {
    RtxBuf *b;
    if (!w) return cc_err(CC_ERR_INVALID_ARG, "null ws");
    if (!w->ensure()) return cc_err(CC_ERR_OUT_OF_MEMORY, "workspace");
    b = rtx_ws_new_buf(w) !>(e) { return cc_err(e); };
    {
        RtxSafeCam cam;
        int rc;
        rtx_safe_cam_clear(&cam);
        rc = rtx_ws_doc_open(w, &b->doc, path.ptr, &cam, &b->safe_rebased) !>(e) {
            return cc_err(e);
        };
        rtx_ws_bind_path(w, b, path);
        b->safe_hold = rtx_ws_hold_of(rc);
        rtx_ws_cam_to_buf(b, &cam);
    }
    rtx_ws_safe_note(b);
    w->len++;
    return cc_ok();
}

void !>(CCError) RtxWs_add_parked(RtxWs *w, char[:0] path, int dirty,
                                         int view) {
    RtxBuf *b;
    if (!w || !path.ptr || path.len == 0) return cc_err(CC_ERR_INVALID_ARG, "parked path");
    if (!w->ensure()) return cc_err(CC_ERR_OUT_OF_MEMORY, "workspace");
    b = rtx_ws_new_buf(w) !>(e) { return cc_err(e); };
    rtx_ws_bind_path(w, b, path);
    rtx_layout_set_view(&b->layout, view);
    b->parked = 1;
    b->park_dirty = dirty;
    w->len++;
    return cc_ok();
}

void !>(CCError) RtxWs_add_empty(RtxWs *w) {
    RtxBuf *b;
    if (!w) return cc_err(CC_ERR_INVALID_ARG, "null ws");
    if (!w->ensure()) return cc_err(CC_ERR_OUT_OF_MEMORY, "workspace");
    b = rtx_ws_new_buf(w) !>(e) { return cc_err(e); };
    b->doc.empty() !>(e) { return cc_err(e); };
    b->doc.tree.busy_bind(w->busy_fn, w->busy_ctx);
    b->layout.rich = rtx_safe_rich_default();
    b->layout.wrap = 1;
    w->len++;
    return cc_ok();
}

int RtxWs_untitled(const RtxWs *w) {
    if (!w || w->len != 1) return 0;
    if (rtx_ws_buf_path(w->bufs[0])) return 0;
    return 1;
}

static int rtx_ws_ask_create(const char *path) {
    char line[8];
    if (!path || !path[0]) return 0;
    if (!isatty(STDIN_FILENO) || !isatty(STDERR_FILENO)) return 0;
    fprintf(stderr, "cctext: '%s' not found. Create? [y/n] ", path);
    fflush(stderr);
    if (!fgets(line, sizeof(line), stdin)) return 0;
    return line[0] == 'y' || line[0] == 'Y';
}

static int rtx_ws_touch_empty(const char *path) {
    int fd;
    if (!path || !path[0]) return 0;
    fd = open(path, O_WRONLY | O_CREAT | O_EXCL, 0666);
    if (fd < 0) return 0;
    close(fd);
    return 1;
}

static void !>(CCError) rtx_ws_add_path_or_create(RtxWs *w, char[:0] path) {
    w->add_path(path) !>(e) {
        if (e.kind != CC_ERR_NOT_FOUND) return cc_err(e);
        if (!rtx_ws_ask_create(path.ptr)) return cc_err(e);
        if (!rtx_ws_touch_empty(path.ptr))
            return cc_err(CC_ERR_IO, "create file");
        return w->add_path(path);
    };
    return cc_ok();
}

void RtxWs_busy_bind(RtxWs *w, RtxBusyFn fn, void *ctx) {
    size_t i;
    if (!w) return;
    w->busy_fn = fn;
    w->busy_ctx = ctx;
    for (i = 0; i < w->len; i++) {
        if (w->bufs[i]->parked) continue;
        w->bufs[i]->doc.tree.busy_bind(fn, ctx);
    }
}

/* Snapshot tree -> w->node. Leaves take slots in order; slot_buf[k] is
 * the k-th leaf's entry (the caller maps entries to buffers). */
static int rtx_ws_tree_from_snap(RtxWs *w, const RtxSafeWs *snap, int sn, int up,
                                 int *slot, int depth) {
    const RtxSafeWsNode *s;
    int n;
    if (sn < 0 || sn >= snap->nnode || depth > RTX_SAFE_WS_NODES) return -1;
    s = &snap->node[sn];
    n = rtx_ws_node_new(w);
    if (n < 0) return -1;
    w->node[n].up = up;
    if (s->kind == RTX_SAFE_WS_LEAF) {
        if (*slot >= RTX_PANES_MAX) return -1;
        w->node[n].pane = (*slot)++;
        return n;
    }
    if (s->kind != RTX_SAFE_WS_SPLIT) return -1;
    w->node[n].kind = RTX_PANE_NODE_SPLIT;
    w->node[n].dir = s->dir == RTX_SPLIT_ROWS ? RTX_SPLIT_ROWS : RTX_SPLIT_COLS;
    w->node[n].ratio = rtx_ws_ratio_clamp(s->ratio);
    w->node[n].a = rtx_ws_tree_from_snap(w, snap, s->a, n, slot, depth + 1);
    if (w->node[n].a < 0) return -1;
    w->node[n].b = rtx_ws_tree_from_snap(w, snap, s->b, n, slot, depth + 1);
    if (w->node[n].b < 0) return -1;
    return n;
}

/* Snapshot leaves in order (the slots rtx_ws_tree_from_snap hands out). */
static int rtx_ws_snap_leaves(const RtxSafeWs *snap, int sn, int *out, int k, int depth) {
    const RtxSafeWsNode *s;
    if (sn < 0 || sn >= snap->nnode || depth > RTX_SAFE_WS_NODES || k < 0) return -1;
    s = &snap->node[sn];
    if (s->kind == RTX_SAFE_WS_LEAF) {
        if (k >= RTX_PANES_MAX) return -1;
        out[k] = sn;
        return k + 1;
    }
    k = rtx_ws_snap_leaves(snap, s->a, out, k, depth + 1);
    return rtx_ws_snap_leaves(snap, s->b, out, k, depth + 1);
}

static void rtx_ws_load_browse_split(RtxWs *w) {
    CCArena hold;
    RtxSafeWs snap;
    int leaves[RTX_PANES_MAX];
    int k, i;
    if (!w) return;
    hold = cc_arena_heap(kilobytes(8));
    if (!hold.base) return;
    if (rtx_safe_ws_read(&snap, hold)) {
        for (i = 0; i < RTX_PANES_MAX && i < RTX_SAFE_WS_PANES; i++)
            w->browse_split[i] = snap.splits[i];
        (void)leaves;
        (void)k;
    }
    hold.destroy();
}

/* Restore the project's pane tree + buffers (parked until shown). */
static int !>(CCError) rtx_ws_restore(RtxWs *w, RtxSafeWs *snap, CCArena hold) {
    size_t k;
    int *slot;
    int leaves[RTX_PANES_MAX];
    int nleaf, i, next = 0, root;
    if (!snap->ok) return cc_ok(0);
    for (i = 0; i < RTX_PANES_MAX && i < RTX_SAFE_WS_PANES; i++)
        w->browse_split[i] = snap->splits[i];
    if (!snap->n) return cc_ok(0);
    /* Entry -> buffer slot. Entries that do not come back (gone, not a
     * file) leave -1, so a pane restores by path, not by a position that
     * has shifted. */
    slot = (int *)cc_arena_alloc(hold, snap->n * sizeof(int), _Alignof(int));
    if (!slot) return cc_err(CC_ERR_OUT_OF_MEMORY, "ws restore");
    for (k = 0; k < snap->n; k++) {
        struct stat st;
        slot[k] = -1;
        if (!snap->ents[k].path[0] || stat(snap->ents[k].path, &st) != 0)
            continue;
        w->add_parked(cc_slice_cstr(snap->ents[k].path), snap->ents[k].dirty,
                      snap->ents[k].view) !>(e) {
            continue;
        };
        slot[k] = (int)w->len - 1;
    }
    if (!w->len) return cc_ok(0);
    nleaf = rtx_ws_snap_leaves(snap, snap->root, leaves, 0, 0);
    root = nleaf > 0 ? rtx_ws_tree_from_snap(w, snap, snap->root, -1, &next, 0) : -1;
    if (root < 0 || next != nleaf) {
        for (i = 0; i < RTX_PANE_NODES; i++) w->node[i] = (RtxPaneNode){0};
        nleaf = 0;
        root = rtx_ws_node_new(w);
        w->node[root].pane = 0;
        w->pane[0] = 0;
        w->root = root;
        w->npanes = 1;
        w->tree_n = 1;
        w->focus = 0;
        return cc_ok(1);
    }
    w->root = root;
    w->npanes = nleaf;
    w->tree_n = nleaf;
    w->focus = 0;
    for (i = 0; i < nleaf; i++) {
        const RtxSafeWsNode *lf = &snap->node[leaves[i]];
        int bi = lf->ent >= 0 && (size_t)lf->ent < snap->n ? slot[lf->ent] : -1;
        w->pane[i] = bi;
        if (leaves[i] == snap->focus_node) w->focus = i;
    }
    /* A pane whose file is gone shows a buffer no other pane restored. */
    for (i = 0; i < nleaf; i++) {
        size_t b;
        if (w->pane[i] >= 0) continue;
        w->pane[i] = 0;
        for (b = 0; b < w->len; b++) {
            int j, used = 0;
            for (j = 0; j < nleaf; j++)
                if (w->pane[j] == (int)b && j != i) used = 1;
            if (!used) {
                w->pane[i] = (int)b;
                break;
            }
        }
    }
    return cc_ok(1);
}

void !>(CCError) RtxWs_open_files(RtxWs *w, int npaths, char **paths) {
    int i;
    if (!w) return cc_err(CC_ERR_INVALID_ARG, "null ws");
    if (w->session.base || w->len) return cc_err(CC_ERR_INVALID_ARG, "ws already live");
    *w = (RtxWs){0};
    w->npanes = 1;
    w->focus = 0;
    w->pane[0] = 0;
    w->pane[1] = 0;
    if (npaths <= 0) {
        CCArena hold = cc_arena_heap(kilobytes(8));
        RtxSafeWs snap = {0};
        int restored = 0;
        if (hold.base && rtx_safe_ws_read(&snap, hold)) {
            restored = rtx_ws_restore(w, &snap, hold) !>(e) {
                w->destroy();
                hold.destroy();
                return cc_err(e);
            };
        }
        if (restored) {
            /* The old global snapshot lands in this project once. */
            if (snap.legacy) rtx_safe_ws_migrated();
            rtx_ws_sync_live_deferred(w) !>(e) {
                w->destroy();
                if (hold.base) hold.destroy();
                return cc_err(e);
            };
        }
        if (hold.base) hold.destroy();
        if (restored) return cc_ok();
        w->add_empty() !>(e) {
            w->destroy();
            return cc_err(e);
        };
        RtxWs_panes_fix(w);
        return cc_ok();
    }
    rtx_ws_load_browse_split(w);
    for (i = 0; i < npaths; i++) {
        if (rtx_path_is_dir(cc_slice_cstr(paths[i]))) {
            if (!w->start_dir[0]) {
                if (!rtx_browse_abs(w->start_dir, sizeof(w->start_dir), cc_slice_cstr(paths[i])))
                    snprintf(w->start_dir, sizeof(w->start_dir), "%s", paths[i]);
            }
            continue;
        }
        /* `a.txt ./a.txt` is one file: one document, one journal. */
        if (rtx_ws_find_path(w, cc_slice_cstr(paths[i])) >= 0) continue;
        rtx_ws_add_path_or_create(w, cc_slice_cstr(paths[i])) !>(e) {
            if (e.kind == CC_ERR_NOT_FOUND &&
                isatty(STDIN_FILENO) && isatty(STDERR_FILENO))
                continue;
            w->destroy();
            return cc_err(e);
        };
    }
    if (w->len == 0) {
        w->add_empty() !>(e) {
            w->destroy();
            return cc_err(e);
        };
    }
    if (w->len >= 2) {
        w->npanes = 2;
        w->pane[1] = 1;
    }
    rtx_ws_sync_live_deferred(w) !>(e) {
        w->destroy();
        return cc_err(e);
    };
    return cc_ok();
}

void rtx_buf_grid_bind(RtxBuf *b) {
    char sample[RTX_GRID_PROBE];
    size_t got = 0;
    if (!b || b->parked || !rtx_layout_is_grid(&b->layout) || b->layout.grid_delim)
        return;
    {
        @errhandler(CCError e) {
            (void)e;
            got = 0;
        }
        got = b->doc.read_at(0, cc_slice_from_buffer(sample, sizeof(sample))) !>;
    }
    b->layout.grid_delim = rtx_grid_pick_delim(b->doc.path.ptr, sample, got);
}

void RtxWs_set_view(RtxWs *w, int view) {
    size_t i;
    int p;
    if (!w) return;
    for (i = 0; i < w->len; i++) {
        rtx_layout_set_view(&w->bufs[i]->layout, view);
        rtx_buf_grid_bind(w->bufs[i]);
    }
    for (p = 0; p < RTX_PANES_MAX; p++)
        if (w->cam[p].live) rtx_layout_set_view(&w->cam[p].layout, view);
}

void RtxWs_set_views(RtxWs *w, const int *views, int n) {
    int i;
    if (!w || !views || n < 1) return;
    for (i = 0; i < n && i < (int)w->len; i++) {
        rtx_layout_set_view(&w->bufs[i]->layout, views[i]);
        rtx_buf_grid_bind(w->bufs[i]);
    }
}

static void rtx_ws_sync_quiet(RtxWs *w) {
    @errhandler(CCError e) { (void)e; }
    w->sync_live() !>;
}

void RtxWs_toggle_split(RtxWs *w) {
    if (!w || w->len == 0) return;
    RtxWs_panes_fix(w);
    if (w->npanes == 1) {
        int f = w->focus;
        int s = RtxWs_split(w, RTX_SPLIT_COLS);
        if (s < 0) return;
        if (w->len >= 2) {
            w->pane[s] = (w->pane[f] + 1) % (int)w->len;
            RtxWs_panes_fix(w);
        }
    } else {
        /* Back to the first pane (in tree order). */
        int keep = w->order[0];
        int guard = 0;
        RtxWs_set_focus(w, keep);
        while (w->npanes > 1 && guard++ < RTX_PANES_MAX) {
            int k, victim = -1;
            for (k = 0; k < w->npanes; k++)
                if (w->order[k] != keep) victim = w->order[k];
            if (victim < 0 || !RtxWs_close_pane(w, victim)) break;
        }
    }
    rtx_ws_sync_quiet(w);
}

/* Step the focused pane by dir. Landing on another pane's buffer is a
 * same-file split: that pane keeps its camera, this one gets its own. */
static void rtx_ws_step_buf(RtxWs *w, int dir) {
    if (!w || w->len == 0) return;
    RtxWs_panes_fix(w);
    w->pane[w->focus] = (w->pane[w->focus] + (int)w->len + dir) % (int)w->len;
    RtxWs_panes_fix(w);
    rtx_ws_sync_quiet(w);
}

void RtxWs_next_buf(RtxWs *w) {
    rtx_ws_step_buf(w, 1);
}

void RtxWs_prev_buf(RtxWs *w) {
    rtx_ws_step_buf(w, -1);
}

void RtxWs_set_focus(RtxWs *w, int pane) {
    if (!w) return;
    RtxWs_panes_fix(w);
    if (!rtx_ws_slot_live(w, pane) || pane == w->focus) return;
    w->focus = pane;
    RtxWs_panes_fix(w);
}

void RtxWs_focus_other(RtxWs *w) {
    RtxWs_focus_step(w, 1);
}

void RtxWs_move_to_pane(RtxWs *w, int dir) {
    int i, src, dst, bi;
    if (!w || w->len == 0) return;
    RtxWs_panes_fix(w);
    if (w->npanes < 2) return;
    src = w->focus;
    for (i = 0; i < w->npanes; i++)
        if (w->order[i] == src) break;
    if (i >= w->npanes) return;
    dst = w->order[(i + (dir < 0 ? w->npanes - 1 : 1)) % w->npanes];
    bi = w->pane[src];
    w->pane[dst] = bi;
    if (w->len >= 2) w->pane[src] = (bi + 1) % (int)w->len;
    w->focus = dst;
    RtxWs_panes_fix(w);
    rtx_ws_sync_quiet(w);
}

/* --- buffer list --- */

const char *RtxWs_buf_path(const RtxWs *w, int bufi) {
    if (!w || bufi < 0 || (size_t)bufi >= w->len) return NULL;
    return rtx_ws_buf_path(w->bufs[bufi]);
}

int RtxWs_buf_dirty(const RtxWs *w, int bufi) {
    if (!w || bufi < 0 || (size_t)bufi >= w->len) return 0;
    return rtx_ws_buf_dirty(w->bufs[bufi]);
}

int RtxWs_buf_shown(const RtxWs *w, int bufi) {
    return rtx_ws_buf_visible(w, bufi);
}

void RtxWs_show_buf(RtxWs *w, int bufi) {
    if (!w || bufi < 0 || (size_t)bufi >= w->len) return;
    RtxWs_panes_fix(w);
    rtx_browse_drop(&w->nav[w->focus]);
    RtxWs_browse_prev_drop(w, w->focus);
    if (w->pane[w->focus] == bufi) return;
    w->pane[w->focus] = bufi;
    RtxWs_panes_fix(w);
    rtx_ws_sync_quiet(w);
}

void !>(CCError) RtxWs_save_buf(RtxWs *w, int bufi) {
    RtxBuf *b;
    if (!w || bufi < 0 || (size_t)bufi >= w->len)
        return cc_err(CC_ERR_INVALID_ARG, "save buf");
    b = w->bufs[bufi];
    if (b->parked && (b->park_dirty || b->safe_hold))
        rtx_ws_unpark_buf(w, b) !>(e) { return cc_err(e); };
    if (b->safe_hold) return cc_err(CC_ERR_IO, "unsaved edits held in Safe journal");
    if (b->parked || !b->doc.dirty()) return cc_ok();
    if (!b->doc.path.ptr || b->doc.path.len == 0)
        return cc_err(CC_ERR_INVALID_ARG, "untitled");
    if (b->doc.disk_changed()) return cc_err(CC_ERR_IO, "file changed on disk");
    b->doc.save() !>(e) { return cc_err(e); };
    b->doc.break_coalesce();
    rtx_ws_flush_buf(b);
    return cc_ok();
}

/* Forget buffer bufi in the transaction table: drop its membership, and
 * renumber members above it. */
static void rtx_ws_xact_forget(RtxWs *w, int bufi) {
    size_t i;
    int k, o;
    for (i = 0; i < w->xact_n; i++) {
        RtxWsXact *x = &w->xacts[i];
        for (k = 0, o = 0; k < x->nbuf; k++) {
            if (x->bufs[k] == bufi) continue;
            x->bufs[o++] = x->bufs[k] > bufi ? x->bufs[k] - 1 : x->bufs[k];
        }
        x->nbuf = o;
    }
}

void !>(CCError) RtxWs_close_buf(RtxWs *w, int bufi, int discard) {
    RtxBuf *b;
    const char *path;
    size_t i;
    int p, next;
    if (!w || bufi < 0 || (size_t)bufi >= w->len)
        return cc_err(CC_ERR_INVALID_ARG, "close buf");
    b = w->bufs[bufi];
    if (!discard && rtx_ws_buf_dirty(b))
        return cc_err(CC_ERR_INVALID_ARG, "unsaved");
    RtxWs_panes_fix(w);
    path = rtx_ws_buf_path(b);
    if (discard && rtx_ws_buf_dirty(b)) {
        if (path) rtx_safe_drop(path);
    } else if (!b->parked && path) {
        /* Clean: the camera (and a clean hist) stays for the next open. */
        rtx_ws_flush_buf(b);
    }
    /* The last buffer: an untitled one takes its place. */
    if (w->len == 1) {
        w->add_empty() !>(e) { return cc_err(e); };
    }
    next = (size_t)bufi + 1 < w->len ? bufi + 1 : bufi - 1;
    {
        /* Prefer the nearest tab no other pane shows (right, then left). */
        int k;
        for (k = bufi + 1; k < (int)w->len; k++)
            if (!rtx_ws_buf_visible(w, k)) break;
        if (k < (int)w->len) {
            next = k;
        } else {
            for (k = bufi - 1; k >= 0; k--)
                if (!rtx_ws_buf_visible(w, k)) break;
            if (k >= 0) next = k;
        }
    }
    for (p = 0; p < RTX_PANES_MAX; p++) {
        if (w->cam[p].live && w->cam[p].of == b) rtx_ws_cam_drop(&w->cam[p]);
        if (rtx_ws_slot_live(w, p) && w->pane[p] == bufi) {
            w->pane[p] = next;
            rtx_browse_drop(&w->nav[p]);
            RtxWs_browse_prev_drop(w, p);
        }
    }
    b->destroy();
    for (i = (size_t)bufi; i + 1 < w->len; i++) w->bufs[i] = w->bufs[i + 1];
    /* The struct is reused by the next add (allocated once). */
    w->bufs[w->len - 1] = b;
    w->len--;
    for (p = 0; p < RTX_PANES_MAX; p++)
        if (w->pane[p] > bufi) w->pane[p]--;
    rtx_ws_xact_forget(w, bufi);
    RtxWs_panes_fix(w);
    return w->sync_live();
}

/* The clip owns a heap arena of its own (not w.session, which lives until
 * close). A new value is built on a fresh arena, adopted after it exists,
 * and the old arena dies then. Empty is a real clear. */
static void rtx_ws_clip_adopt(RtxWs *w, CCArena a, char[:] bytes) {
    CCArena old = w->clip_a;
    if (!bytes.ptr || bytes.len == 0) {
        if (a.base) a.destroy();
        a = (CCArena){0};
        bytes = cc_slice_empty();
    }
    w->clip_a = a;
    w->clip = bytes;
    if (old.base) old.destroy();
}

static int rtx_ws_clip_same(const RtxWs *w, char[:] src) {
    if (!w->clip.ptr || w->clip.len != src.len) return 0;
    return src.len == 0 || memcmp(w->clip.ptr, src.ptr, src.len) == 0;
}

void !>(CCError) RtxWs_set_clip(RtxWs *w, char[:] src) {
    CCArena a;
    char[:] copy;
    if (!w) return cc_err(CC_ERR_INVALID_ARG, "null ws");
    if (!src.ptr || src.len == 0) {
        rtx_ws_clip_adopt(w, (CCArena){0}, cc_slice_empty());
        return cc_ok();
    }
    /* Hosts load the OS clipboard before every paste: same bytes, no copy. */
    if (rtx_ws_clip_same(w, src)) return cc_ok();
    a = cc_arena_heap(src.len + 64);
    if (!a.base) return cc_err(CC_ERR_OUT_OF_MEMORY, "clipboard");
    copy = src.clone_into(a) !>(e) {
        a.destroy();
        return cc_err(e);
    };
    rtx_ws_clip_adopt(w, a, copy);
    return cc_ok();
}

/* [lo, lo + n) of d onto a (arena last). */
static char[:] !>(CCError) rtx_ws_read_range(RtxDoc *d, size_t lo, size_t n, CCArena a) {
    char[:] copy;
    size_t got;
    if (!d || !a.base) return cc_err(CC_ERR_INVALID_ARG, "read range");
    if (n == 0) return cc_ok(cc_slice_empty());
    copy = a.alloc_slice_bytes(n);
    if (!copy.ptr) return cc_err(CC_ERR_OUT_OF_MEMORY, "clipboard");
    got = d->read_at(lo, copy.sub(0, n)) !>(e) { return cc_err(e); };
    if (got != n) return cc_err(CC_ERR_INTERNAL, "clipboard read");
    return cc_ok(copy);
}

int !>(CCError) RtxWs_copy(RtxWs *w) {
    RtxDoc *d = w->doc();
    size_t lo, hi;
    CCArena a;
    char[:] bytes;
    if (!d || !d->has_sel()) return cc_ok(0);
    if (d->sel_box) {
        a = cc_arena_heap(kilobytes(8));
        if (!a.base) return cc_err(CC_ERR_OUT_OF_MEMORY, "clipboard");
        bytes = rtx_doc_box_text(d, a) !>(e) {
            a.destroy();
            return cc_err(e);
        };
        rtx_ws_clip_adopt(w, a, bytes);
        return cc_ok(1);
    }
    lo = d->sel_lo();
    hi = d->sel_hi();
    a = cc_arena_heap(hi - lo + 64);
    if (!a.base) return cc_err(CC_ERR_OUT_OF_MEMORY, "clipboard");
    bytes = rtx_ws_read_range(d, lo, hi - lo, a) !>(e) {
        a.destroy();
        return cc_err(e);
    };
    rtx_ws_clip_adopt(w, a, bytes);
    return cc_ok(1);
}

void !>(CCError) RtxWs_cut(RtxWs *w) {
    RtxDoc *d = w->doc();
    size_t lo, hi;
    CCArena a;
    char[:] copy;
    if (!d) return cc_err(CC_ERR_INVALID_ARG, "no buffer");
    if (!d->has_sel()) return cc_ok();
    if (d->sel_box) {
        a = cc_arena_heap(kilobytes(8));
        if (!a.base) return cc_err(CC_ERR_OUT_OF_MEMORY, "clipboard");
        copy = rtx_doc_box_text(d, a) !>(e) {
            a.destroy();
            return cc_err(e);
        };
        rtx_doc_box_apply(d, cc_slice_empty()) !>(e) {
            a.destroy();
            return cc_err(e);
        };
        d->sel_box = 0;
        d->sel_anchor = d->caret;
        rtx_ws_clip_adopt(w, a, copy);
        return cc_ok();
    }
    lo = d->sel_lo();
    hi = d->sel_hi();
    a = cc_arena_heap(hi - lo + 64);
    if (!a.base) return cc_err(CC_ERR_OUT_OF_MEMORY, "clipboard");
    copy = rtx_ws_read_range(d, lo, hi - lo, a) !>(e) {
        a.destroy();
        return cc_err(e);
    };
    /* Copy is bytes as selected; the cut removes the pair (join rule). */
    if (rtx_buf_rich(w->active())) {
        rtx_buf_pair_replace(w->active(), lo, hi, cc_slice_empty()) !>(e) {
            a.destroy();
            return cc_err(e);
        };
    } else {
        d->replace(lo, hi - lo, cc_slice_empty()) !>(e) {
            a.destroy();
            return cc_err(e);
        };
    }
    /* Clip after a successful cut. */
    rtx_ws_clip_adopt(w, a, copy);
    return cc_ok();
}

void !>(CCError) RtxWs_paste(RtxWs *w) {
    RtxDoc *d = w->doc();
    if (!d) return cc_err(CC_ERR_INVALID_ARG, "no buffer");
    if (!w->clip.ptr || w->clip.len == 0) return cc_ok();
    return RtxBuf_paste_text(w->active(), w->clip);
}

static void rtx_buf_hex_nib_reset(RtxBuf *b) {
    if (b) b->hex_nib = 0;
}

void RtxBuf_clear_pref(RtxBuf *b) {
    if (!b) return;
    b->pref.ok = 0;
    b->pref.eol = 0;
    b->pref.x = 0;
    b->pref.col = 0;
}

void RtxBuf_stick_eol(RtxBuf *b) {
    if (!b) return;
    b->pref.ok = 1;
    b->pref.eol = 1;
}

static size_t !>(RtxIndexErr) rtx_buf_cur_col(const RtxBuf *b) {
    size_t start;
    if (!b) return cc_ok((size_t)0);
    start = rtx_doc_line_floor(&b->doc, b->doc.caret) !>(e) { return cc_err(e); };
    return cc_ok(b->doc.caret - start);
}

static int rtx_buf_adopt_pin(RtxBuf *b, size_t floor, const RtxLineMark *pin) {
    size_t a, z;
    if (!b || !pin) return 0;
    rtx_line_origin_key(&b->doc.tree, pin->off, pin->line);
    a = pin->off < floor ? pin->off : floor;
    z = pin->off < floor ? floor : pin->off;
    if (z - a <= (size_t)RTX_LINE_FLOOR_MAX)
        b->seek_rel = rtx_doc_lf_delta_local(&b->doc, pin->off, floor);
    else
        b->seek_rel = 0;
    return 1;
}

static int rtx_buf_key_from_pin(RtxBuf *b, size_t floor) {
    RtxLineMark pin;
    if (!b || !rtx_line_pin_near(&b->doc.tree, floor, &pin)) return 0;
    return rtx_buf_adopt_pin(b, floor, &pin);
}

/* Checkpoint for this 1/32 slice (or one slice away). Not the BOF pin
 * from mid-file — that would paint line 1 instead of +N. */
static int rtx_buf_pin_for_floor(const RtxPieceTree *t, size_t len, size_t off,
                                 RtxLineMark *out) {
    size_t i, slot, max_d, best_d = (size_t)-1;
    int found = 0;
    RtxLineMark best = {0};
    if (!t) return 0;
    if (len == 0) {
        if (t->pins[0].line == RTX_LINE_PIN_EMPTY) return 0;
        if (out) *out = t->pins[0];
        return 1;
    }
    slot = (size_t)(((unsigned long long)off * (unsigned long long)RTX_LINE_MARK_MAX) /
                    (unsigned long long)len);
    if (slot >= RTX_LINE_MARK_MAX) slot = RTX_LINE_MARK_MAX - 1;
    if (t->pins[slot].line != RTX_LINE_PIN_EMPTY) {
        if (out) *out = t->pins[slot];
        return 1;
    }
    max_d = len / (size_t)RTX_LINE_MARK_MAX;
    if (max_d < (size_t)RTX_LINE_PIN_NEAR) max_d = (size_t)RTX_LINE_PIN_NEAR;
    for (i = 0; i < RTX_LINE_MARK_MAX; i++) {
        size_t a, z, d;
        if (t->pins[i].line == RTX_LINE_PIN_EMPTY) continue;
        a = t->pins[i].off < off ? t->pins[i].off : off;
        z = t->pins[i].off < off ? off : t->pins[i].off;
        d = z - a;
        if (d > max_d) continue;
        if (!found || d < best_d) {
            best = t->pins[i];
            best_d = d;
            found = 1;
        }
    }
    if (found && out) *out = best;
    return found;
}

static int rtx_buf_key_from_slot_pin(RtxBuf *b, size_t floor) {
    RtxLineMark pin;
    if (!b || !rtx_buf_pin_for_floor(&b->doc.tree, b->len(), floor, &pin))
        return 0;
    return rtx_buf_adopt_pin(b, floor, &pin);
}

void rtx_buf_seek_set(RtxBuf *b, size_t floor) {
    size_t a, z;
    if (!b) return;
    if (b->seek_valid) {
        a = b->seek_off < floor ? b->seek_off : floor;
        z = b->seek_off < floor ? floor : b->seek_off;
        if (z - a > (size_t)RTX_LINE_FLOOR_MAX) {
            b->seek_rel = 0;
            if (!rtx_buf_key_from_slot_pin(b, floor)) {
                rtx_line_origin_clear(&b->doc.tree);
                /* Rail drag: drop the live island so only one exists, and
                 * do not kick again until mouse-up. */
                if (b->drag_len)
                    rtx_line_isle_cancel(&b->doc.tree);
                else
                    rtx_line_isle_kick(&b->doc.tree, floor);
            }
        } else {
            b->seek_rel += rtx_doc_lf_delta_local(&b->doc, b->seek_off, floor);
            (void)rtx_buf_key_from_pin(b, floor);
        }
    } else {
        b->seek_rel = 0;
        if (!rtx_buf_key_from_slot_pin(b, floor) &&
            !b->doc.index_covers(floor)) {
            rtx_line_origin_clear(&b->doc.tree);
            if (b->drag_len)
                rtx_line_isle_cancel(&b->doc.tree);
            else
                rtx_line_isle_kick(&b->doc.tree, floor);
        }
    }
    b->seek_off = floor;
    b->seek_valid = 1;
}

/* Mouse-up on a rail. One island at the final thumb, not one per drag pixel. */
void rtx_buf_drag_end(RtxBuf *b) {
    int was;
    if (!b) return;
    was = b->drag_len != 0;
    b->drag_vis = 0;
    b->drag_len = 0;
    b->drag_grab = 0;
    b->drag_horiz = 0;
    if (!was || !b->seek_valid || b->doc.lf_ready()) return;
    if (b->doc.index_covers(b->seek_off)) return;
    if (rtx_line_mark_ok(&b->doc.tree)) {
        size_t a = b->doc.tree.mark_off < b->seek_off ? b->doc.tree.mark_off
                                                     : b->seek_off;
        size_t z = b->doc.tree.mark_off < b->seek_off ? b->seek_off
                                                     : b->doc.tree.mark_off;
        /* Origin already local. A far pin still wants one ≤1/32 backfill. */
        if (z - a <= (size_t)RTX_LINE_FLOOR_MAX) return;
    }
    rtx_line_isle_kick(&b->doc.tree, b->seek_off);
}

static void !>(RtxIndexErr) rtx_buf_seek_label(RtxBuf *b) {
    size_t ln;
    if (!b || !b->seek_valid || !b->layout.rows.len) return cc_ok();
    if (!b->doc.index_covers(b->seek_off)) return cc_ok();
    ln = b->doc.line_of(b->seek_off) !>(e) { return cc_err(e); };
    rtx_layout_reline(&b->layout, ln);
    b->top = ln;
    b->seek_valid = 0;
    return cc_ok();
}

void !>(RtxIndexErr) RtxBuf_box_begin(RtxBuf *b) {
    if (!b || b->doc.sel_box) return cc_ok();
    b->doc.sel_box = 1;
    if (b->pref.eol) b->doc.box_acol = (size_t)-1;
    else if (b->pref.ok) b->doc.box_acol = b->pref.col;
    else b->doc.box_acol = rtx_buf_cur_col(b) !>(e) { return cc_err(e); };
    b->doc.box_ccol = b->doc.box_acol;
    return cc_ok();
}

void !>(RtxIndexErr) RtxBuf_box_sync(RtxBuf *b) {
    if (!b || !b->doc.sel_box) return cc_ok();
    if (b->pref.eol) b->doc.box_ccol = (size_t)-1;
    else if (b->pref.ok) b->doc.box_ccol = b->pref.col;
    else b->doc.box_ccol = rtx_buf_cur_col(b) !>(e) { return cc_err(e); };
    return cc_ok();
}

void !>(RtxIndexErr) RtxBuf_box_move_col(RtxBuf *b, int dir) {
    size_t start, nlen, col, end;
    @errhandler(RtxIndexErr e) {
        return cc_err(e);
    }
    @errhandler(CCError e) {
        return cc_err(rtx_index_from_cc(e));
    }
    if (!b) return cc_ok();
    if (rtx_layout_is_hex(&b->layout)) {
        size_t n = b->len();
        size_t at = b->doc.caret;
        b->box_begin() !>;
        if (dir < 0) {
            if (at > 0) at--;
        } else if (at < n) {
            at++;
        }
        b->doc.box_ccol = at;
        b->pref.col = at;
        b->pref.ok = 1;
        b->pref.eol = 0;
        b->doc.caret = b->doc.fold_snap(at, dir);
        rtx_buf_hex_nib_reset(b);
        return cc_ok();
    }
    b->box_begin() !>;
    start = rtx_doc_line_floor(&b->doc, b->doc.caret) !>;
    end = rtx_doc_line_end_caret(&b->doc, start) !>;
    nlen = end - start;
    col = b->doc.box_ccol;
    if (col == (size_t)-1) col = nlen;
    {
        size_t at = start + (col < nlen ? col : nlen);
        size_t next;
        if (dir < 0) {
            if (at <= start) return cc_ok();
            next = b->doc.cluster_prev(at) !>;
            if (next < start) next = start;
        } else {
            next = b->doc.cluster_next(at) !>;
            if (next > end) next = end;
        }
        col = next - start;
    }
    b->doc.box_ccol = col;
    b->pref.col = col;
    b->pref.ok = 1;
    b->pref.eol = 0;
    b->doc.caret = b->doc.fold_snap(start + (col < nlen ? col : nlen), dir);
    return cc_ok();
}

static int rtx_buf_byte_units(const RtxBuf *b) {
    return b && rtx_layout_is_hex(&b->layout);
}

static int rtx_buf_grid_gap(RtxBuf *b, size_t off) {
    char delim;
    if (!b || !rtx_layout_is_grid(&b->layout)) return 0;
    delim = b->layout.grid_delim ? b->layout.grid_delim : b->layout.grid.delim;
    return rtx_layout_grid_gap_at(&b->doc, off, delim);
}

static void !>(CCError) rtx_buf_grid_skip_gap(RtxBuf *b, int dir) {
    size_t n, guard = 0;
    @errhandler(CCError e) {
        return cc_err(e);
    }
    if (!b || !rtx_layout_is_grid(&b->layout)) return cc_ok();
    n = b->len();
    while (guard++ < 8 && b->doc.caret < n && rtx_buf_grid_gap(b, b->doc.caret)) {
        if (dir < 0) {
            if (b->doc.caret == 0) break;
            b->doc.caret = b->doc.cluster_prev(b->doc.caret) !>;
        } else {
            size_t next = b->doc.cluster_next(b->doc.caret) !>;
            if (next <= b->doc.caret) break;
            b->doc.caret = next;
        }
    }
    return cc_ok();
}

/* Rich pane with marks: hints are atoms (docs/md_view.md). */
static int rtx_buf_rich(const RtxBuf *b) {
    return b && b->layout.rich && !rtx_layout_is_hex(&b->layout) &&
           !rtx_layout_is_grid(&b->layout) && RtxDoc_has_marks(&b->doc);
}

/* Pair-arity join policy above one legal write (mark_arity / Encoding).
 * Call only from Rich pane paths — Source / hex / grid use replace. */
static void !>(CCError) rtx_buf_pair_replace(RtxBuf *b, size_t lo, size_t hi,
                                            char[:] bytes) {
    if (!b) return cc_err(CC_ERR_INVALID_ARG, "pair replace");
    return b->doc.replace_join(lo, hi, bytes);
}

/* Caret strictly inside a hint is never a position: step out in `dir`.
 * dir == 0 (hit / type): land on the hint start — the stand-in atom. */
static void rtx_buf_hint_snap(RtxBuf *b, int dir) {
    size_t lo, hi;
    if (!rtx_buf_rich(b)) return;
    if (!RtxDoc_hint_at(&b->doc, b->doc.caret, &lo, &hi)) return;
    if (b->doc.caret == lo) return;
    if (dir == 0) b->doc.caret = lo;
    else b->doc.caret = dir < 0 ? lo : hi;
}

/* Rich table: `|` and unpainted pad are not a caret landing. */
static void rtx_buf_md_snap(RtxBuf *b, int dir) {
    if (!b || !b->layout.rich) return;
    if (rtx_layout_is_hex(&b->layout) || rtx_layout_is_grid(&b->layout))
        return;
    b->doc.caret = rtx_layout_md_snap(&b->layout, &b->doc, b->doc.caret, dir);
}

void RtxBuf_snap_caret(RtxBuf *b, int dir) {
    if (!b) return;
    rtx_buf_hint_snap(b, dir);
    rtx_buf_md_snap(b, dir);
}

void !>(CCError) RtxBuf_move_horiz(RtxBuf *b, int dir, int shift) {
    size_t n;
    if (!b) return cc_err(CC_ERR_INVALID_ARG, "move horiz");
    if (!shift && b->doc.has_sel()) {
        b->doc.caret = dir < 0 ? b->doc.sel_lo() : b->doc.sel_hi();
        b->doc.clear_sel();
        b->doc.break_coalesce();
        b->clear_pref();
        rtx_buf_hex_nib_reset(b);
        return cc_ok();
    }
    n = b->len();
    if (dir < 0) {
        if (b->doc.caret > 0) {
            if (!shift) b->doc.sel_anchor = b->doc.caret;
            if (rtx_buf_byte_units(b)) b->doc.caret--;
            else b->doc.caret = b->doc.cluster_prev(b->doc.caret) !>(e) {
                return cc_err(e);
            };
            if (!shift) b->doc.sel_anchor = b->doc.caret;
            b->doc.sel_box = 0;
        }
    } else if (b->doc.caret < n) {
        if (!shift) b->doc.sel_anchor = b->doc.caret;
        if (rtx_buf_byte_units(b)) b->doc.caret++;
        else b->doc.caret = b->doc.cluster_next(b->doc.caret) !>(e) {
            return cc_err(e);
        };
        if (!shift) b->doc.sel_anchor = b->doc.caret;
        b->doc.sel_box = 0;
    }
    if (rtx_layout_is_grid(&b->layout))
        rtx_buf_grid_skip_gap(b, dir) !>(e) { return cc_err(e); };
    if (!rtx_buf_byte_units(b)) {
        b->doc.caret = b->doc.fold_snap(b->doc.caret, dir);
        rtx_buf_hint_snap(b, dir);
        rtx_buf_md_snap(b, dir);
        if (!shift) b->doc.sel_anchor = b->doc.caret;
    }
    b->doc.break_coalesce();
    b->clear_pref();
    rtx_buf_hex_nib_reset(b);
    return cc_ok();
}

void !>(CCError) RtxBuf_move_grid_col(RtxBuf *b, int dir) {
    RtxLayout *L;
    size_t start, rec_n, dlen, rel, col, nf, last, want;
    char[:] line = cc_slice_empty();
    CCArena frame = {0};
    int owned = 0;
    int hdr;
    @errhandler(CCError e) {
        if (owned) frame.destroy();
        return cc_err(e);
    }
    if (!b || !rtx_layout_is_grid(&b->layout))
        return cc_err(CC_ERR_INVALID_ARG, "grid col");
    L = &b->layout;
    dlen = b->len();
    hdr = L->grid_hdr_on && L->grid_hdr_end;
    if (!rtx_layout_grid_rec_in(L, b->doc.caret, &start, &rec_n)) {
        start = rtx_layout_grid_cam_lo(&b->doc, b->doc.caret, NULL) !>;
        rec_n = rtx_layout_grid_rec_len(&b->doc, start) !>;
    }
    if (rec_n) {
        frame = cc_arena_heap(rec_n + 64);
        if (!frame.base) return cc_err(CC_ERR_OUT_OF_MEMORY, "grid col");
        owned = 1;
        line = b->doc.scratch_span(start, rec_n, frame) !>;
    }
    rtx_grid_bind_span(&L->grid, start, rec_n);
    nf = rtx_grid_split_geom(&L->grid, line.ptr, line.len);
    last = nf;
    if (L->grid.ncols && last > L->grid.ncols) last = L->grid.ncols;
    if (!last) {
        if (owned) frame.destroy();
        return cc_ok();
    }
    rel = rtx_layout_grid_rel(b->doc.caret, start, rec_n);
    if (b->doc.caret >= start + rec_n) rel = 0;
    col = (size_t)rtx_grid_col_at(line.ptr, line.len, &L->grid, rel);
    if (col >= last) col = last - 1;
    if (dir > 0) {
        if (col + 1 < last) {
            want = start + L->grid.fields.data[col + 1].lo;
        } else {
            size_t next = rtx_layout_grid_after_rec(&b->doc, start, rec_n);
            if (next >= dlen) want = b->doc.caret;
            else want = next;
        }
    } else if (col > 0) {
        want = start + L->grid.fields.data[col - 1].lo;
    } else if (hdr && start > 0 &&
               start == rtx_layout_grid_after_rec(&b->doc, 0, L->grid_hdr_end)) {
        if (owned) {
            frame.destroy();
            owned = 0;
            line = cc_slice_empty();
        }
        start = 0;
        rec_n = L->grid_hdr_end;
        if (rec_n) {
            frame = cc_arena_heap(rec_n + 64);
            if (!frame.base) return cc_err(CC_ERR_OUT_OF_MEMORY, "grid col");
            owned = 1;
            line = b->doc.scratch_span(start, rec_n, frame) !>;
        }
        rtx_grid_bind_span(&L->grid, start, rec_n);
        nf = rtx_grid_split_geom(&L->grid, line.ptr, line.len);
        last = nf;
        if (L->grid.ncols && last > L->grid.ncols) last = L->grid.ncols;
        want = last ? start + L->grid.fields.data[last - 1].lo : start;
    } else if (start == 0) {
        want = start + (nf ? L->grid.fields.data[0].lo : 0);
    } else {
        if (owned) {
            frame.destroy();
            owned = 0;
            line = cc_slice_empty();
        }
        start = rtx_layout_grid_cam_lo(&b->doc, start - 1, NULL) !>;
        rec_n = rtx_layout_grid_rec_len(&b->doc, start) !>;
        if (rec_n) {
            frame = cc_arena_heap(rec_n + 64);
            if (!frame.base) return cc_err(CC_ERR_OUT_OF_MEMORY, "grid col");
            owned = 1;
            line = b->doc.scratch_span(start, rec_n, frame) !>;
        }
        rtx_grid_bind_span(&L->grid, start, rec_n);
        nf = rtx_grid_split_geom(&L->grid, line.ptr, line.len);
        last = nf;
        if (L->grid.ncols && last > L->grid.ncols) last = L->grid.ncols;
        want = last ? start + L->grid.fields.data[last - 1].lo : start;
    }
    if (owned) frame.destroy();
    b->doc.caret = want;
    b->doc.sel_anchor = want;
    b->doc.sel_box = 0;
    b->doc.break_coalesce();
    b->clear_pref();
    rtx_buf_hex_nib_reset(b);
    return cc_ok();
}

static int rtx_buf_in_md_table(const RtxBuf *b) {
    if (!b || !b->layout.rich) return 0;
    if (rtx_layout_is_hex(&b->layout) || rtx_layout_is_grid(&b->layout))
        return 0;
    return rtx_layout_md_index(&b->layout, b->doc.caret) >= 0;
}

/* One new body row. Header / sep Enter inserts the first body row. */
static void !>(CCError) rtx_buf_md_insert_row(RtxBuf *b) {
    int ti, role;
    const RtxMdTable *t;
    size_t insert_at, nlen, got, n, lead;
    char row[1 + 3 * RTX_MD_TABLE_COLS + 2];
    char ch;
    if (!b) return cc_err(CC_ERR_INVALID_ARG, "md row");
    ti = rtx_layout_md_index(&b->layout, b->doc.caret);
    if (ti < 0) return cc_ok();
    t = &b->layout.md_tab[ti];
    role = rtx_md_table_role(t, b->doc.caret);
    if (role == RTX_MD_ROLE_HDR || role == RTX_MD_ROLE_SEP)
        insert_at = t->body_lo;
    else {
        insert_at = b->doc.caret;
        nlen = b->len();
        if (insert_at < t->lo) insert_at = t->lo;
        if (insert_at > t->hi) insert_at = t->hi;
        while (insert_at < t->hi && insert_at < nlen) {
            ch = 0;
            got = b->doc.read_at(insert_at, cc_slice_from_buffer(&ch, 1)) !>(e) { return cc_err(e); };
            if (got != 1) break;
            insert_at++;
            if (ch == '\n') break;
        }
    }
    lead = 0;
    if (insert_at > 0) {
        ch = 0;
        got = b->doc.read_at(insert_at - 1, cc_slice_from_buffer(&ch, 1)) !>(e) { return cc_err(e); };
        if (got == 1 && ch != '\n') {
            row[0] = '\n';
            lead = 1;
        }
    }
    n = rtx_md_empty_row(t->ncols, row + lead, sizeof(row) - lead);
    if (!n) return cc_ok();
    b->doc.break_coalesce();
    b->doc.replace(insert_at, 0, row.to_slice_n(lead + n)) !>(e) {
        return cc_err(e);
    };
    b->doc.break_coalesce();
    b->doc.caret = insert_at + lead + 1;
    b->doc.sel_anchor = b->doc.caret;
    b->clear_pref();
    rtx_buf_hex_nib_reset(b);
    return cc_ok();
}

/* Append one column to every table line: one insert per line, one edit
 * group (one undo step). */
static void !>(CCError) rtx_buf_md_insert_col(RtxBuf *b) {
    int ti, sep;
    const RtxMdTable *t;
    size_t tlo, thi, n, i, start, used, dcap, caret_rel, new_caret, add, nl, ne;
    CCArena src_a = {0};
    char[:] span;
    char *dst = NULL;
    RtxEdit *eds = NULL;
    int src_on = 0;
    @errhandler(CCError e) {
        if (src_on) src_a.destroy();
        return cc_err(e);
    }
    if (!b) return cc_err(CC_ERR_INVALID_ARG, "md col ins");
    ti = rtx_layout_md_index(&b->layout, b->doc.caret);
    if (ti < 0) return cc_ok();
    t = &b->layout.md_tab[ti];
    if (t->ncols >= RTX_MD_TABLE_COLS) return cc_ok();
    tlo = t->lo;
    thi = t->hi;
    if (thi <= tlo) return cc_ok();
    n = thi - tlo;
    nl = 1;
    src_a = cc_arena_heap(n + 4 * n + 96);
    if (!src_a.base) return cc_err(CC_ERR_OUT_OF_MEMORY, "md col src");
    src_on = 1;
    span = b->doc.scratch_span(tlo, n, src_a) !>;
    for (i = 0; i < span.len; i++) {
        if (span.ptr[i] == '\n') nl++;
    }
    dcap = n + 4 * n + 32;
    dst = (char *)cc_arena_alloc(src_a, dcap, 1);
    eds = (RtxEdit *)cc_arena_alloc(src_a, nl * sizeof(RtxEdit), 8);
    if (!dst || !eds) {
        src_a.destroy();
        return cc_err(CC_ERR_OUT_OF_MEMORY, "md col dst");
    }
    used = 0;
    ne = 0;
    caret_rel = b->doc.caret >= tlo ? b->doc.caret - tlo : 0;
    new_caret = b->doc.caret;
    i = 0;
    while (i < span.len) {
        size_t ln, keep, cr;
        if (used >= dcap) {
            src_a.destroy();
            return cc_err(CC_ERR_OUT_OF_MEMORY, "md col nl");
        }
        start = i;
        while (i < span.len && span.ptr[i] != '\n') i++;
        ln = i - start;
        cr = ln && span.ptr[start + ln - 1] == '\r' ? 1 : 0;
        keep = ln - cr;
        sep = rtx_md_line_is_sep(span.ptr + start, ln);
        add = rtx_md_line_add_col(span.ptr + start, ln, sep, dst + used,
                                  dcap - used);
        if (!add || add < ln || ne >= nl) {
            src_a.destroy();
            return cc_err(CC_ERR_OUT_OF_MEMORY, "md col fit");
        }
        /* add_col copies the line and appends before a kept `\r`: the
         * site is that append. */
        eds[ne].off = tlo + start + keep;
        eds[ne].n = 0;
        eds[ne].ins = cc_slice_from_buffer(dst + used + keep, add - ln);
        ne++;
        used += add;
        if (caret_rel >= start && caret_rel <= i)
            /* Inside the new cell: before its `|` (and a kept `\r`). */
            new_caret = tlo + used - (add >= 2 ? 2 : 0) -
                        (add >= 3 && dst[used - 1] == '\r' ? 1 : 0);
        if (i < span.len && span.ptr[i] == '\n') {
            used++;
            i++;
        }
    }
    b->doc.replace_batch(eds, ne) !>;
    b->doc.caret = new_caret;
    b->doc.sel_anchor = new_caret;
    if (b->doc.hist.head > 0) {
        RtxHistRec *r = &b->doc.hist.recs[b->doc.hist.head - 1];
        r->caret_after = new_caret;
        r->sel_after = new_caret;
    }
    src_a.destroy();
    src_on = 0;
    b->clear_pref();
    rtx_buf_hex_nib_reset(b);
    return cc_ok();
}

/* Drop one body row (the physical line). Header / sep stay. */
static void !>(CCError) rtx_buf_md_delete_row(RtxBuf *b) {
    int ti, role;
    const RtxMdTable *t;
    size_t ls, le, nlen, got, del_n;
    char ch;
    if (!b) return cc_err(CC_ERR_INVALID_ARG, "md row del");
    ti = rtx_layout_md_index(&b->layout, b->doc.caret);
    if (ti < 0) return cc_ok();
    t = &b->layout.md_tab[ti];
    role = rtx_md_table_role(t, b->doc.caret);
    if (role != RTX_MD_ROLE_BODY) return cc_ok();
    ls = b->doc.caret;
    nlen = b->len();
    if (ls < t->lo) ls = t->lo;
    if (ls > t->hi) ls = t->hi;
    while (ls > t->lo) {
        ch = 0;
        got = b->doc.read_at(ls - 1, cc_slice_from_buffer(&ch, 1)) !>(e) { return cc_err(e); };
        if (got != 1 || ch == '\n') break;
        ls--;
    }
    le = ls;
    while (le < t->hi && le < nlen) {
        ch = 0;
        got = b->doc.read_at(le, cc_slice_from_buffer(&ch, 1)) !>(e) { return cc_err(e); };
        if (got != 1 || ch == '\n') break;
        le++;
    }
    del_n = le - ls;
    if (le < t->hi && le < nlen) {
        ch = 0;
        got = b->doc.read_at(le, cc_slice_from_buffer(&ch, 1)) !>(e) { return cc_err(e); };
        if (got == 1 && ch == '\n') del_n++;
    }
    if (!del_n) return cc_ok();
    b->doc.break_coalesce();
    b->doc.replace(ls, del_n, cc_slice_empty()) !>(e) { return cc_err(e); };
    b->doc.break_coalesce();
    b->clear_pref();
    rtx_buf_hex_nib_reset(b);
    return cc_ok();
}

void !>(CCError) RtxBuf_move_md_col(RtxBuf *b, int dir) {
    size_t want;
    int c, ti;
    const RtxMdTable *t;
    if (!b) return cc_err(CC_ERR_INVALID_ARG, "md col");
    if (!rtx_buf_in_md_table(b)) return cc_ok();
    ti = rtx_layout_md_index(&b->layout, b->doc.caret);
    t = ti >= 0 ? &b->layout.md_tab[ti] : NULL;
    c = rtx_layout_md_col_at(&b->layout, &b->doc, b->doc.caret);
    /* Tab past the last cell grows the table; Shift-Tab only moves (the
     * first cell steps to the row above, the table's first cell stays). */
    if (dir > 0 && t && c >= 0 && c + 1 >= t->ncols)
        return rtx_buf_md_insert_col(b);
    want = rtx_layout_md_step_cell(&b->layout, &b->doc, b->doc.caret, dir);
    if (want == b->doc.caret && dir > 0) return rtx_buf_md_insert_col(b);
    b->doc.caret = want;
    b->doc.sel_anchor = want;
    b->doc.sel_box = 0;
    b->doc.break_coalesce();
    b->clear_pref();
    rtx_buf_hex_nib_reset(b);
    return cc_ok();
}

void !>(CCError) RtxBuf_move_vert(RtxBuf *b, const RtxMeasure *m,
                                        double width, int dir, int shift) {
    size_t n, at;
    if (!b || !m) return cc_err(CC_ERR_INVALID_ARG, "move vert");
    if (rtx_layout_is_hex(&b->layout)) {
        n = b->len();
        at = b->doc.caret;
        if (dir < 0) {
            if (at >= (size_t)RTX_HEX_COLS) at -= (size_t)RTX_HEX_COLS;
            else at = 0;
        } else if (n) {
            at += (size_t)RTX_HEX_COLS;
            if (at >= n) at = n - 1;
        }
        if (!shift) b->doc.sel_anchor = at;
        b->doc.caret = at;
        rtx_buf_hex_nib_reset(b);
        b->doc.sel_box = 0;
        b->doc.break_coalesce();
        b->clear_pref();
        return cc_ok();
    }
    return b->layout.move_vert(&b->doc, m, width, dir, shift, &b->pref);
}

void !>(CCError) RtxBuf_page_vert(RtxBuf *b, const RtxMeasure *m,
                                        double width, int dir, size_t n, int shift) {
    size_t k;
    if (!b || !m) return cc_err(CC_ERR_INVALID_ARG, "page vert");
    if (rtx_layout_is_hex(&b->layout)) {
        for (k = 0; k < (n ? n : 1); k++)
            RtxBuf_move_vert(b, m, width, dir, shift) !>(e) { return cc_err(e); };
        return cc_ok();
    }
    return b->layout.page_vert(&b->doc, m, width, dir, n, shift, &b->pref,
                               b->layout_width == width);
}

void !>(CCError) RtxBuf_move_edge(RtxBuf *b, int to_end, int shift,
                                        int physical) {
    size_t n, row, at;
    @errhandler(RtxIndexErr e) {
        return cc_err(CC_ERR_IO, e.message ? e.message : "line index");
    }
    if (!b) return cc_err(CC_ERR_INVALID_ARG, "move edge");
    if (rtx_layout_is_hex(&b->layout)) {
        n = b->len();
        row = n ? b->doc.caret / (size_t)RTX_HEX_COLS : 0;
        if (!to_end) at = row * (size_t)RTX_HEX_COLS;
        else {
            at = row * (size_t)RTX_HEX_COLS + (size_t)RTX_HEX_COLS - 1;
            if (n == 0) at = 0;
            else if (at >= n) at = n - 1;
        }
        if (!shift) b->doc.sel_anchor = at;
        b->doc.caret = at;
        rtx_buf_hex_nib_reset(b);
        b->doc.sel_box = 0;
        b->doc.break_coalesce();
        b->clear_pref();
        return cc_ok();
    }
    if (!physical && rtx_layout_soft_wrap(&b->layout) && b->layout.rows.len) {
        b->layout.move_row_edge(&b->doc, to_end, shift);
    } else {
        b->doc.move_line_edge(to_end, shift) !>;
        rtx_buf_md_snap(b, 0);
        if (!shift) b->doc.sel_anchor = b->doc.caret;
    }
    if (to_end) b->stick_eol();
    else b->clear_pref();
    return cc_ok();
}

/* ------------------------------------------------------------------
 * Markdown editing affordances (docs/md_view.md, Editing). Enter keeps
 * list / quote containers going, Tab nests list items, typed pairs close
 * themselves, a URL pasted over a selection becomes a link, and table
 * rows / columns have explicit commands. Context comes from the line's
 * own bytes (rtx_md_line_parse) plus a window of lines around it — never
 * from the lexer — so none of this waits on a block pass. Every command
 * that writes several places is one edit group (one undo step).
 * ------------------------------------------------------------------ */

static int g_rtx_autopair = 1;
static int g_rtx_tab_spaces = 0;

void rtx_edit_set_autopair(int on) { g_rtx_autopair = on ? 1 : 0; }
int rtx_edit_autopair(void) { return g_rtx_autopair; }
void rtx_edit_set_tab_spaces(int n) {
    g_rtx_tab_spaces = n < 0 ? 0 : n > 16 ? 16 : n;
}
int rtx_edit_tab_spaces(void) { return g_rtx_tab_spaces; }

/* Window of whole lines around the edit: RTX_MARKUP_LOOKBACK above (the
 * block pass's reach), RTX_ME_AHEAD below. A list longer than that is
 * renumbered only inside the window (leftover, never a wrong edit). */
#define RTX_ME_AHEAD 65536
#define RTX_ME_SPAN_MAX (1u << 20)
#define RTX_ME_LINE_MAX 8192

typedef struct {
    size_t off;  /* doc offset of the line */
    size_t len;  /* bytes, no newline */
    int nl;      /* a newline follows */
    int cr;      /* the line ends in `\r` (kept on every rewrite) */
    const char *s;
    RtxMdLine L;
} RtxMeSrc;

typedef struct {
    char *t;     /* bytes (no newline, no `\r`) */
    size_t n;
    int src;     /* source line */
    int fresh;   /* a line this command adds */
    int moved;   /* indented / outdented by this command */
    int inst;    /* renumber level instance (-1: none) */
    RtxMdLine L;
} RtxMeV;

typedef struct {
    CCArena a;
    char *buf;
    size_t lo, n;       /* buf is doc [lo, lo + n) */
    RtxMeSrc *src;
    size_t ns;
    RtxMeV *v;
    size_t nv, vcap;
    size_t b0, b1;      /* block: src lines [b0, b1] */
} RtxMeWin;

static void rtx_me_drop(RtxMeWin *W) {
    if (W && W->a.base) W->a.destroy();
    if (W) *W = (RtxMeWin){0};
}

static char *rtx_me_alloc(RtxMeWin *W, size_t n) {
    return (char *)cc_arena_alloc(W->a, n ? n : 1, 1);
}

/* Byte at `off` (0 past the end). */
static char rtx_me_byte(const RtxDoc *d, size_t off) {
    char c = 0;
    size_t got;
    @errhandler(CCError e) {
        (void)e;
        return 0;
    }
    if (!d || off >= d->len()) return 0;
    got = d->read_at(off, cc_slice_from_buffer(&c, 1)) !>;
    return got == 1 ? c : 0;
}

/* Start of the line holding `off`. Local backward read; a line longer
 * than RTX_ME_SPAN_MAX answers (size_t)-1 (no context). */
static size_t rtx_me_bol(const RtxDoc *d, size_t off) {
    char tmp[256];
    size_t at = off, got, k, n;
    @errhandler(CCError e) {
        (void)e;
        return (size_t)-1;
    }
    while (at > 0) {
        n = at > sizeof tmp ? sizeof tmp : at;
        got = d->read_at(at - n, cc_slice_from_buffer(tmp, n)) !>;
        if (got != n) return (size_t)-1;
        for (k = n; k > 0; k--) {
            if (tmp[k - 1] == '\n') return at - n + k;
        }
        at -= n;
        if (off - at > RTX_ME_SPAN_MAX) return (size_t)-1;
    }
    return 0;
}

/* Read the window and split it into lines. [lo_bol, hi) must be inside. */
static int !>(CCError) rtx_me_load(RtxMeWin *W, const RtxDoc *d, size_t lo_bol,
                                  size_t hi) {
    size_t len = d->len(), wlo, whi, i, s0, e0, nl, cap;
    char[:] span;
    *W = (RtxMeWin){0};
    if (hi < lo_bol || hi - lo_bol > RTX_ME_SPAN_MAX) return cc_ok(0);
    wlo = lo_bol > (size_t)RTX_MARKUP_LOOKBACK ? lo_bol - (size_t)RTX_MARKUP_LOOKBACK : 0;
    whi = hi + RTX_ME_AHEAD;
    if (whi > len || whi < hi) whi = len;
    cap = 3 * (whi - wlo) + 8192;
    W->a = cc_arena_heap(cap + (whi - wlo + 2) * (sizeof(RtxMeSrc) + 2 * sizeof(RtxMeV)));
    if (!W->a.base) return cc_err(CC_ERR_OUT_OF_MEMORY, "md edit");
    span = d->scratch_span(wlo, whi - wlo, W->a) !>(e) {
        rtx_me_drop(W);
        return cc_err(e);
    };
    W->buf = span.ptr;
    W->n = span.len;
    W->lo = wlo;
    /* Whole lines only: drop a partial first / last line. */
    s0 = 0;
    if (wlo > 0) {
        while (s0 < W->n && W->buf[s0] != '\n') s0++;
        if (s0 < W->n) s0++;
        if (wlo + s0 > lo_bol) s0 = lo_bol - wlo;
    }
    e0 = W->n;
    if (whi < len) {
        while (e0 > s0 && W->buf[e0 - 1] != '\n') e0--;
        if (wlo + e0 < hi) e0 = W->n;
    }
    nl = 2;
    for (i = s0; i < e0; i++) {
        if (W->buf[i] == '\n') nl++;
    }
    W->src = (RtxMeSrc *)cc_arena_alloc(W->a, nl * sizeof(RtxMeSrc), 8);
    W->vcap = nl + 8;
    W->v = (RtxMeV *)cc_arena_alloc(W->a, W->vcap * sizeof(RtxMeV), 8);
    if (!W->src || !W->v) {
        rtx_me_drop(W);
        return cc_err(CC_ERR_OUT_OF_MEMORY, "md edit lines");
    }
    i = s0;
    for (;;) {
        size_t le = i;
        RtxMeSrc *S = &W->src[W->ns++];
        while (le < e0 && W->buf[le] != '\n') le++;
        S->off = wlo + i;
        S->s = W->buf + i;
        S->len = le - i;
        S->nl = le < e0;
        S->cr = S->len && S->s[S->len - 1] == '\r';
        rtx_md_line_parse(S->s, S->len, &S->L);
        if (le >= e0) break;
        i = le + 1;
        if (i == e0) {
            if (wlo + e0 == len) {
                /* A newline at EOF: the empty last line is a line. */
                RtxMeSrc *T = &W->src[W->ns++];
                T->off = wlo + i;
                T->s = W->buf + i;
                T->len = 0;
                T->nl = 0;
                T->cr = 0;
                rtx_md_line_parse(T->s, 0, &T->L);
            }
            break;
        }
    }
    return cc_ok(1);
}

static long rtx_me_line_of(const RtxMeWin *W, size_t off) {
    size_t i;
    for (i = 0; i < W->ns; i++) {
        size_t e = W->src[i].off + W->src[i].len;
        if (off >= W->src[i].off && (off <= e)) return (long)i;
    }
    return -1;
}

/* Blank after the quote prefix too (a `>` alone is not a blank line of
 * the list inside it, but it does not end it either). */
static int rtx_me_empty(const RtxMdLine *L) {
    return !L->kind && L->blank;
}

/* Block of list lines around [t0, t1]: up to a heading, a fence at the
 * margin, another quote depth, or a paragraph after a blank line. */
static void rtx_me_block(RtxMeWin *W, size_t t0, size_t t1) {
    int depth = W->src[t0].L.qdepth;
    size_t i = t0, j = t1;
    while (i > 0) {
        const RtxMdLine *P = &W->src[i - 1].L;
        if (!rtx_me_empty(P) && P->qdepth != depth) break;
        if (P->heading || (P->fence && P->ind == 0 && !P->kind)) break;
        if (!P->kind && !rtx_me_empty(P) && P->ind == 0) {
            /* Lazy continuation only right under a non-blank line. */
            if (i < 2 || rtx_me_empty(&W->src[i - 2].L)) break;
        }
        i--;
    }
    while (j + 1 < W->ns) {
        const RtxMdLine *N = &W->src[j + 1].L;
        if (!rtx_me_empty(N) && N->qdepth != depth) break;
        if (N->heading || (N->fence && N->ind == 0 && !N->kind)) break;
        if (!N->kind && !rtx_me_empty(N) && N->ind == 0 &&
            rtx_me_empty(&W->src[j].L))
            break;
        j++;
    }
    while (i < t0 && rtx_me_empty(&W->src[i].L)) i++;
    while (j > t1 && rtx_me_empty(&W->src[j].L)) j--;
    W->b0 = i;
    W->b1 = j;
}

/* Virtual lines for the block: one per source line (text without `\r`). */
static void rtx_me_virt(RtxMeWin *W) {
    size_t i;
    W->nv = 0;
    for (i = W->b0; i <= W->b1 && W->nv < W->vcap; i++) {
        RtxMeV *V = &W->v[W->nv++];
        *V = (RtxMeV){0};
        V->t = (char *)W->src[i].s;
        V->n = W->src[i].len - (size_t)W->src[i].cr;
        V->src = (int)i;
        V->inst = -1;
        V->L = W->src[i].L;
    }
}

static long rtx_me_vof(const RtxMeWin *W, size_t src) {
    size_t i;
    for (i = 0; i < W->nv; i++) {
        if ((size_t)W->v[i].src == src) return (long)i;
    }
    return -1;
}

static int rtx_me_set(RtxMeWin *W, RtxMeV *V, const char *a, size_t an,
                      const char *b, size_t bn, const char *c, size_t cn) {
    char *t = rtx_me_alloc(W, an + bn + cn);
    if (!t) return 0;
    if (an) memcpy(t, a, an);
    if (bn) memcpy(t + an, b, bn);
    if (cn) memcpy(t + an + bn, c, cn);
    V->t = t;
    V->n = an + bn + cn;
    rtx_md_line_parse(V->t, V->n, &V->L);
    return 1;
}

/* Insert a fresh virtual line after index `at`. */
static RtxMeV *rtx_me_insert(RtxMeWin *W, size_t at) {
    size_t k;
    if (W->nv >= W->vcap) return NULL;
    for (k = W->nv; k > at + 1; k--) W->v[k] = W->v[k - 1];
    W->nv++;
    W->v[at + 1] = (RtxMeV){0};
    W->v[at + 1].src = W->v[at].src;
    W->v[at + 1].fresh = 1;
    W->v[at + 1].inst = -1;
    return &W->v[at + 1];
}

static int rtx_me_same_list(const RtxMdLine *a, const RtxMdLine *b) {
    if (a->kind != b->kind) return 0;
    if (a->kind == RTX_MDL_BULLET) return a->bullet == b->bullet;
    return a->delim == b->delim;
}

typedef struct {
    size_t ind;
    RtxMdLine L;     /* first item of the level (kind / bullet / delim) */
    unsigned long first, last;
    int count;
    int inst;
} RtxMeLvl;

#define RTX_ME_LVLS 32
#define RTX_ME_INST 1024

/* Ordered lists count on: each level's number follows its previous
 * sibling. A level whose first two original items share a number is
 * lazy (`1.` `1.` `1.`) and keeps that number. An item this command moved
 * into a new level starts it at 1. Two passes: the first decides lazy
 * from original items only, the second writes. */
static void rtx_me_renumber(RtxMeWin *W) {
    RtxMeLvl lv[RTX_ME_LVLS];
    signed char lazy[RTX_ME_INST];
    int pass, ninst;
    for (pass = 0; pass < 2; pass++) {
        size_t i;
        int nl = 0, prev_blank = 0;
        char fch = 0;
        size_t fn = 0;
        ninst = 0;
        if (pass == 0) {
            for (i = 0; i < RTX_ME_INST; i++) lazy[i] = -1;
        }
        for (i = 0; i < W->nv; i++) {
            RtxMeV *V = &W->v[i];
            RtxMdLine *L = &V->L;
            if (fch) {
                if (L->fence == fch && L->fence_n >= fn && !L->fence_info) fch = 0;
                continue;
            }
            if (L->fence && !L->kind) {
                fch = L->fence;
                fn = L->fence_n;
                continue;
            }
            if (rtx_me_empty(L)) {
                prev_blank = 1;
                continue;
            }
            if (L->kind) {
                while (nl > 0 && lv[nl - 1].ind > L->ind) nl--;
                if (nl > 0 && lv[nl - 1].ind == L->ind &&
                    rtx_me_same_list(&lv[nl - 1].L, L)) {
                    RtxMeLvl *T = &lv[nl - 1];
                    if (L->kind == RTX_MDL_ORDERED) {
                        unsigned long want;
                        if (pass == 0 && T->inst >= 0 && lazy[T->inst] < 0 &&
                            !V->fresh && !V->moved)
                            lazy[T->inst] = L->num == T->first ? 1 : 0;
                        want = (T->inst >= 0 && lazy[T->inst] == 1) ? T->first
                                                                     : T->last + 1;
                        if (pass == 1 && L->num != want) {
                            char dg[24];
                            int dn = snprintf(dg, sizeof dg, "%lu", want);
                            if (dn > 0 &&
                                rtx_me_set(W, V, V->t, L->mlo, dg, (size_t)dn,
                                           V->t + L->mhi - 1, V->n - (L->mhi - 1)))
                                L = &V->L;
                        }
                        T->last = want;
                    }
                    T->count++;
                    V->inst = T->inst;
                } else {
                    RtxMeLvl *T;
                    if (nl > 0 && lv[nl - 1].ind == L->ind) nl--;
                    if (nl >= RTX_ME_LVLS) nl = RTX_ME_LVLS - 1;
                    T = &lv[nl++];
                    T->ind = L->ind;
                    T->L = *L;
                    T->count = 1;
                    T->inst = ninst < RTX_ME_INST ? ninst++ : -1;
                    T->first = L->num;
                    if (L->kind == RTX_MDL_ORDERED && V->moved) T->first = 1;
                    if (pass == 1 && L->kind == RTX_MDL_ORDERED && L->num != T->first) {
                        char dg[24];
                        int dn = snprintf(dg, sizeof dg, "%lu", T->first);
                        if (dn > 0)
                            rtx_me_set(W, V, V->t, L->mlo, dg, (size_t)dn,
                                       V->t + V->L.mhi - 1, V->n - (V->L.mhi - 1));
                    }
                    T->last = T->first;
                    V->inst = T->inst;
                }
            } else if (L->ind == 0 && prev_blank) {
                nl = 0;
            }
            prev_blank = 0;
        }
    }
}

/* Doc offset of (virtual line vi, column col) in the rewritten block. */
static size_t rtx_me_pos(const RtxMeWin *W, size_t vi, size_t col) {
    size_t pos = W->src[W->b0].off, i;
    for (i = 0; i < W->nv; i++) {
        const RtxMeV *V = &W->v[i];
        const RtxMeSrc *S = &W->src[V->src];
        int last = i + 1 >= W->nv || W->v[i + 1].src != V->src;
        if (i == vi) return pos + (col > V->n ? V->n : col);
        pos += V->n;
        if (!last) pos += S->cr ? 2 : 1;
        else pos += (size_t)S->cr + (size_t)S->nl;
    }
    return pos;
}

/* Rewrite the block: per source line, the joined virtual lines against
 * the old bytes, trimmed to the changed middle. One group. */
static size_t rtx_me_map(const RtxEdit *eds, size_t n, size_t x) {
    size_t i;
    ptrdiff_t acc = 0;
    for (i = 0; i < n; i++) {
        size_t o = eds[i].off, e = eds[i].off + eds[i].n;
        if (x < o) break;
        if (x < e) {
            size_t in = x - o;
            if (in > eds[i].ins.len) in = eds[i].ins.len;
            return (size_t)((ptrdiff_t)o + acc) + in;
        }
        acc += (ptrdiff_t)eds[i].ins.len - (ptrdiff_t)eds[i].n;
    }
    return (size_t)((ptrdiff_t)x + acc);
}

/* `map`: caret / anc are pre-edit offsets carried through the sites (an
 * insert at the offset lands before it); else they are final offsets. */
static void !>(CCError) rtx_me_commit(RtxMeWin *W, RtxDoc *d, size_t caret,
                                     size_t anc, int map) {
    RtxEdit *eds;
    size_t ne = 0, i, k;
    eds = (RtxEdit *)cc_arena_alloc(W->a, (W->b1 - W->b0 + 2) * sizeof(RtxEdit), 8);
    if (!eds) return cc_err(CC_ERR_OUT_OF_MEMORY, "md edit group");
    i = 0;
    while (i < W->nv) {
        const RtxMeSrc *S = &W->src[W->v[i].src];
        size_t j = i, tot = 0, o = 0, cp, cs, oldn, lim;
        char *nw;
        while (j < W->nv && W->v[j].src == W->v[i].src) {
            tot += W->v[j].n + (S->cr ? 2 : 1);
            j++;
        }
        nw = rtx_me_alloc(W, tot + 2);
        if (!nw) return cc_err(CC_ERR_OUT_OF_MEMORY, "md edit line");
        for (k = i; k < j; k++) {
            if (W->v[k].n) memcpy(nw + o, W->v[k].t, W->v[k].n);
            o += W->v[k].n;
            if (S->cr) nw[o++] = '\r';
            if (k + 1 < j) nw[o++] = '\n';
        }
        oldn = S->len;
        cp = 0;
        lim = oldn < o ? oldn : o;
        while (cp < lim && S->s[cp] == nw[cp]) cp++;
        cs = 0;
        while (cs < lim - cp && S->s[oldn - 1 - cs] == nw[o - 1 - cs]) cs++;
        if (cp != oldn || cp != o) {
            eds[ne].off = S->off + cp;
            eds[ne].n = oldn - cp - cs;
            eds[ne].ins = cc_slice_from_buffer(nw + cp, o - cp - cs);
            ne++;
        }
        i = j;
    }
    if (map) {
        caret = rtx_me_map(eds, ne, caret);
        anc = rtx_me_map(eds, ne, anc);
    }
    if (ne == 0) {
        d->caret = caret;
        d->sel_anchor = anc;
        return cc_ok();
    }
    RtxDoc_break_coalesce(d);
    d->replace_batch(eds, ne) !>(e) { return cc_err(e); };
    RtxDoc_break_coalesce(d);
    d->caret = caret;
    d->sel_anchor = anc;
    if (!d->hist.applying && d->hist.head > 0) {
        RtxHistRec *r = &d->hist.recs[d->hist.head - 1];
        r->caret_after = caret;
        r->sel_after = anc;
    }
    return cc_ok();
}

/* Fence state at `bol`: 1 when that line is inside a fenced block (its
 * body or its closer), scanning the window above. `open` (optional) is 1
 * when the line itself opens one. */
static int rtx_me_in_fence(const RtxMeWin *W, size_t line, int *open) {
    size_t i;
    char fch = 0;
    size_t fn = 0;
    if (open) *open = 0;
    for (i = 0; i < line && i < W->ns; i++) {
        const RtxMdLine *L = &W->src[i].L;
        if (fch) {
            if (L->fence == fch && L->fence_n >= fn && !L->fence_info) fch = 0;
        } else if (L->fence) {
            fch = L->fence;
            fn = L->fence_n;
        }
    }
    if (fch) return 1;
    if (open && line < W->ns && W->src[line].L.fence) *open = 1;
    return 0;
}

/* Previous list item above `line` at indent <= `ind` in the same quote. */
static long rtx_me_prev_item(const RtxMeWin *W, size_t line, size_t ind, int lt) {
    size_t i = line;
    int depth = W->src[line].L.qdepth;
    while (i > 0) {
        const RtxMdLine *P = &W->src[--i].L;
        if (rtx_me_empty(P)) continue;
        if (P->qdepth != depth) return -1;
        if (P->heading) return -1;
        if (P->kind) {
            if (lt ? P->ind < ind : P->ind <= ind) return (long)i;
            continue;
        }
        if (P->ind == 0 && i > 0 && rtx_me_empty(&W->src[i - 1].L)) return -1;
    }
    return -1;
}

/* Indent (dir > 0) / outdent (dir < 0) width for list item `line`: nest
 * under the previous sibling's content column, or back to the parent's
 * indent. Fallback unit: 2 for bullets, the marker width for ordered. */
static long rtx_me_indent_delta(const RtxMeWin *W, size_t line, int dir) {
    const RtxMdLine *L = &W->src[line].L;
    long p;
    size_t unit = L->kind == RTX_MDL_ORDERED ? L->chi - L->mlo : 2;
    if (unit < 2) unit = 2;
    if (dir > 0) {
        p = rtx_me_prev_item(W, line, L->ind, 0);
        if (p >= 0) {
            const RtxMdLine *P = &W->src[(size_t)p].L;
            if (P->ind == L->ind) {
                size_t col = P->chi - P->qhi;
                if (col > L->ind) return (long)(col - L->ind);
            }
        }
        return (long)unit;
    }
    if (L->ind == 0) return 0;
    p = rtx_me_prev_item(W, line, L->ind, 1);
    if (p >= 0) return -(long)(L->ind - W->src[(size_t)p].L.ind);
    return -(long)(L->ind < unit ? L->ind : unit);
}

/* Shift one virtual line's indent (after its quote prefix) by delta. */
static void rtx_me_shift(RtxMeWin *W, RtxMeV *V, long delta) {
    size_t q = V->L.qhi, ws = V->L.ind, cut;
    char sp[64];
    if (delta > 0) {
        size_t k, dn = (size_t)delta > sizeof sp ? sizeof sp : (size_t)delta;
        for (k = 0; k < dn; k++) sp[k] = ' ';
        rtx_me_set(W, V, V->t, q, sp, dn, V->t + q, V->n - q);
        return;
    }
    cut = (size_t)(-delta);
    /* A tab counts as reaching the next multiple of four. */
    {
        size_t col = 0, k = 0;
        while (k < ws && col < cut) {
            col = V->t[q + k] == '\t' ? (col / 4 + 1) * 4 : col + 1;
            k++;
        }
        cut = k;
    }
    if (cut) rtx_me_set(W, V, V->t, q, NULL, 0, V->t + q + cut, V->n - q - cut);
}

static int rtx_buf_md_ok(const RtxBuf *b) {
    return b && !rtx_layout_is_hex(&b->layout) && !rtx_layout_is_grid(&b->layout) &&
           !b->doc.sel_box && RtxDoc_is_markup(&b->doc);
}

/* Tab / Shift-Tab over list items. 1 = handled (edited or refused with
 * no change), 0 = not a list line (caller inserts a tab). */
static int !>(CCError) rtx_buf_list_indent(RtxBuf *b, int dir) {
    RtxDoc *d = &b->doc;
    RtxMeWin W = {0};
    size_t lo = d->sel_lo(), hi = d->sel_hi(), bol, t0, t1, i, prim;
    long lt0, lt1, delta;
    int any = 0, ok;
    if (!rtx_buf_md_ok(b)) return cc_ok(0);
    bol = rtx_me_bol(d, lo);
    if (bol == (size_t)-1) return cc_ok(0);
    if (hi > lo && rtx_me_byte(d, hi - 1) == '\n') hi--;
    ok = rtx_me_load(&W, d, bol, hi) !>(e) { return cc_err(e); };
    if (!ok) return cc_ok(0);
    lt0 = rtx_me_line_of(&W, lo);
    lt1 = rtx_me_line_of(&W, hi);
    if (lt0 < 0 || lt1 < lt0 || rtx_me_in_fence(&W, (size_t)lt0, NULL)) {
        rtx_me_drop(&W);
        return cc_ok(0);
    }
    t0 = (size_t)lt0;
    t1 = (size_t)lt1;
    prim = t1 + 1;
    for (i = t0; i <= t1; i++) {
        if (W.src[i].L.kind) {
            if (prim > t1) prim = i;
            any = 1;
        }
    }
    if (!any) {
        rtx_me_drop(&W);
        return cc_ok(0);
    }
    delta = rtx_me_indent_delta(&W, prim, dir);
    if (delta == 0) {
        rtx_me_drop(&W);
        return cc_ok(1);
    }
    rtx_me_block(&W, t0, t1);
    rtx_me_virt(&W);
    for (i = t0; i <= t1; i++) {
        long vi = rtx_me_vof(&W, i);
        RtxMeV *V;
        if (vi < 0) continue;
        V = &W.v[vi];
        if (rtx_me_empty(&V->L)) continue;
        rtx_me_shift(&W, V, delta);
        if (V->L.kind) V->moved = 1;
    }
    rtx_me_renumber(&W);
    rtx_me_commit(&W, d, d->caret, d->sel_anchor, 1) !>(e) {
        rtx_me_drop(&W);
        return cc_err(e);
    };
    rtx_me_drop(&W);
    return cc_ok(1);
}

/* Insert at the caret (replacing the selection) as one record. */
static void !>(CCError) rtx_buf_insert_plain(RtxBuf *b, char[:] bytes) {
    if (rtx_buf_rich(b) && b->doc.has_sel() && !b->doc.sel_box)
        return rtx_buf_pair_replace(b, b->doc.sel_lo(), b->doc.sel_hi(), bytes);
    return b->doc.type(bytes);
}

/* Enter / Shift-Enter in a Markdown document. 1 = handled. */
static int !>(CCError) rtx_buf_md_enter(RtxBuf *b, int soft) {
    RtxDoc *d = &b->doc;
    RtxMeWin W = {0};
    size_t lo = d->sel_lo(), hi = d->sel_hi(), bol, line, pcol, hcol, vi;
    const RtxMdLine *L;
    long lt;
    int ok, opens = 0;
    char pre[RTX_ME_LINE_MAX];
    size_t pn = 0;
    if (!rtx_buf_md_ok(b)) return cc_ok(0);
    bol = rtx_me_bol(d, lo);
    if (bol == (size_t)-1) return cc_ok(0);
    if (hi - bol > RTX_ME_LINE_MAX) return cc_ok(0);
    ok = rtx_me_load(&W, d, bol, hi) !>(e) { return cc_err(e); };
    if (!ok) return cc_ok(0);
    lt = rtx_me_line_of(&W, lo);
    if (lt < 0 || rtx_me_line_of(&W, hi) != lt) {
        rtx_me_drop(&W);
        return cc_ok(0);
    }
    line = (size_t)lt;
    L = &W.src[line].L;
    pcol = lo - W.src[line].off;
    hcol = hi - W.src[line].off;
    if (pcol > L->n) pcol = L->n;
    if (hcol > L->n) hcol = L->n;
    /* Fenced code: keep this line's indent (quote prefix included). */
    if (rtx_me_in_fence(&W, line, &opens) || opens) {
        size_t k = 0;
        const char *s = W.src[line].s;
        while (k < L->n && k < pcol && k < sizeof pre - 2 &&
               (s[k] == ' ' || s[k] == '\t' || (k < L->qhi))) {
            pre[k] = s[k];
            k++;
        }
        rtx_me_drop(&W);
        {
            char nl[RTX_ME_LINE_MAX + 2];
            nl[0] = '\n';
            if (k) memcpy(nl + 1, pre, k);
            rtx_buf_insert_plain(b, cc_slice_from_buffer(nl, k + 1)) !>(e) {
                return cc_err(e);
            };
        }
        return cc_ok(1);
    }
    if (L->heading || (!L->kind && !L->qdepth) || (pcol == 0 && hcol == 0)) {
        rtx_me_drop(&W);
        return cc_ok(0);
    }
    /* A caret inside the markers stands at the content start. */
    if (lo == hi && pcol < L->clo && pcol > 0) {
        pcol = hcol = L->clo;
    }
    rtx_me_block(&W, line, line);
    rtx_me_virt(&W);
    vi = (size_t)rtx_me_vof(&W, line);
    /* Enter on an empty item / quote line leaves the container. */
    if (!soft && L->blank && pcol >= L->clo) {
        RtxMeV *V = &W.v[vi];
        if (L->kind && L->ind > 0) {
            long delta = rtx_me_indent_delta(&W, line, -1);
            rtx_me_shift(&W, V, delta);
            V->moved = 1;
        } else if (L->kind) {
            size_t q = L->qhi;
            rtx_me_set(&W, V, V->t, q, NULL, 0, NULL, 0);
        } else {
            /* Quote only: drop the innermost `>`. */
            size_t g = L->qhi;
            while (g > 0 && V->t[g - 1] != '>') g--;
            if (g > 0) g--;
            if (L->qdepth <= 1) g = 0;
            rtx_me_set(&W, V, V->t, g, NULL, 0, NULL, 0);
        }
        rtx_me_renumber(&W);
        rtx_me_commit(&W, d, rtx_me_pos(&W, vi, W.v[vi].n),
                      rtx_me_pos(&W, vi, W.v[vi].n), 0) !>(e) {
            rtx_me_drop(&W);
            return cc_err(e);
        };
        rtx_me_drop(&W);
        return cc_ok(1);
    }
    /* Continuation prefix: the quote bytes, the indent, then the marker
     * (next number, a fresh `[ ]`) — or, soft, spaces to the content. */
    {
        const char *s = W.src[line].s;
        size_t k, after, an;
        RtxMeV *V, *F;
        if (L->chi > sizeof pre - 16) {
            rtx_me_drop(&W);
            return cc_ok(0);
        }
        memcpy(pre, s, L->qhi + L->ind);
        pn = L->qhi + L->ind;
        if (L->kind && soft) {
            for (k = L->mlo; k < L->chi; k++) pre[pn++] = ' ';
            if (L->chi == L->mhi) pre[pn++] = ' ';
        } else if (L->kind == RTX_MDL_BULLET) {
            pre[pn++] = L->bullet;
            for (k = L->mhi; k < L->chi; k++) pre[pn++] = s[k];
            if (L->chi == L->mhi) pre[pn++] = ' ';
        } else if (L->kind == RTX_MDL_ORDERED) {
            int dn = snprintf(pre + pn, 24, "%lu", L->num + 1);
            if (dn > 0) pn += (size_t)dn;
            pre[pn++] = L->delim;
            for (k = L->mhi; k < L->chi; k++) pre[pn++] = s[k];
            if (L->chi == L->mhi) pre[pn++] = ' ';
        }
        if (L->kind && !soft && L->task) {
            memcpy(pre + pn, "[ ] ", 4);
            pn += 4;
        }
        after = hcol;
        while (after < L->n && (s[after] == ' ' || s[after] == '\t')) after++;
        an = L->n - after;
        V = &W.v[vi];
        F = rtx_me_insert(&W, vi);
        if (!F) {
            rtx_me_drop(&W);
            return cc_ok(0);
        }
        V = &W.v[vi];
        rtx_me_set(&W, F, pre, pn, s + after, an, NULL, 0);
        rtx_me_set(&W, V, s, pcol, NULL, 0, NULL, 0);
        /* A lazy `1.` `1.` list keeps its number. */
        if (L->kind == RTX_MDL_ORDERED) {
            long p = rtx_me_prev_item(&W, line, L->ind, 0);
            int lazy = p >= 0 && W.src[(size_t)p].L.kind == RTX_MDL_ORDERED &&
                       W.src[(size_t)p].L.ind == L->ind &&
                       W.src[(size_t)p].L.num == L->num;
            if (!lazy) {
                size_t q;
                for (q = line + 1; q < W.ns && q <= W.b1; q++) {
                    const RtxMdLine *N = &W.src[q].L;
                    if (rtx_me_empty(N)) continue;
                    if (N->kind == RTX_MDL_ORDERED && N->ind == L->ind) {
                        lazy = N->num == L->num;
                        break;
                    }
                    if (N->kind && N->ind < L->ind) break;
                    if (!N->kind && N->ind == 0) break;
                }
            }
            if (lazy) {
                char dg[24];
                int dn = snprintf(dg, sizeof dg, "%lu", L->num);
                if (dn > 0)
                    rtx_me_set(&W, F, F->t, F->L.mlo, dg, (size_t)dn,
                               F->t + F->L.mhi - 1, F->n - (F->L.mhi - 1));
            }
        }
        if (!soft) rtx_me_renumber(&W);
        {
            /* Renumbering may widen the prefix; the moved text is `an`. */
            size_t col = W.v[vi + 1].n >= an ? W.v[vi + 1].n - an : 0;
            size_t at = rtx_me_pos(&W, vi + 1, col);
            rtx_me_commit(&W, d, at, at, 0) !>(e) {
                rtx_me_drop(&W);
                return cc_err(e);
            };
        }
    }
    rtx_me_drop(&W);
    return cc_ok(1);
}

/* ---- Auto-pairs (docs/md_view.md, Editing). A typed opener inserts its
 * closer when a selection exists (wrap) or at a word boundary; typing a
 * closer right before the one it auto-inserted steps over it; Backspace
 * between an empty auto pair deletes both. The auto closers form one run
 * [ap_lo, ap_hi) in front of the caret, valid only while nothing else
 * edited the document (ap_gen) and the caret sits at ap_lo. */

static int rtx_ap_valid(const RtxBuf *b) {
    return b && b->ap_on && b->ap_gen == b->doc.edit_gen &&
           b->doc.caret == b->ap_lo && !b->doc.has_sel() &&
           b->ap_lo < b->ap_hi && b->ap_hi <= b->doc.len();
}

static void rtx_ap_note(RtxBuf *b, size_t lo, size_t hi) {
    b->ap_open = (size_t)-1;
    b->ap_on = lo < hi;
    b->ap_lo = lo;
    b->ap_hi = hi;
    b->ap_gen = b->doc.edit_gen;
}

/* After a plain edit at the caret: keep the run in front of it. */
static void rtx_ap_follow(RtxBuf *b, int trk, size_t c0, size_t n0) {
    size_t c1 = b->doc.caret, n1 = b->doc.len();
    long dc = (long)c1 - (long)c0, dn = (long)n1 - (long)n0;
    if (!trk) return;
    if (dc != dn || b->doc.has_sel()) {
        b->ap_on = 0;
        return;
    }
    rtx_ap_note(b, (size_t)((long)b->ap_lo + dc), (size_t)((long)b->ap_hi + dc));
}

static const char *rtx_ap_table(const RtxBuf *b, int *md) {
    const char *t;
    *md = 0;
    if (!g_rtx_autopair || !b) return "";
    if (rtx_layout_is_hex(&b->layout) || rtx_layout_is_grid(&b->layout)) return "";
    t = RtxDoc_autopairs(&b->doc);
    *md = RtxDoc_is_markup(&b->doc);
    return t ? t : "";
}

int RtxBuf_autopair_live(const RtxBuf *b) {
    int md;
    return rtx_ap_table(b, &md)[0] != 0;
}

static int rtx_ap_ws(char c) {
    return c == 0 || c == ' ' || c == '\t' || c == '\n' || c == '\r';
}

static int rtx_ap_emph(char c) {
    return c == '*' || c == '_' || c == '~';
}

/* Wrap the selection in o…c. Markdown emphasis wraps each line's text
 * (trimmed); brackets / quotes wrap the whole range. The text stays
 * selected, so a second `*` makes it bold. */
static void !>(CCError) rtx_ap_wrap(RtxBuf *b, char o, char c, int per_line) {
    RtxDoc *d = &b->doc;
    size_t lo = d->sel_lo(), hi = d->sel_hi(), n = hi - lo, i, ne = 0, s0 = 0, e0 = 0;
    CCArena a = {0};
    char *buf;
    RtxEdit *eds;
    char oc[2];
    int fwd = d->caret >= d->sel_anchor;
    @errhandler(CCError e) {
        if (a.base) a.destroy();
        return cc_err(e);
    }
    if (n > RTX_ME_SPAN_MAX) return cc_ok();
    oc[0] = o;
    oc[1] = c;
    a = cc_arena_heap(n + 64 + (n + 2) * sizeof(RtxEdit));
    if (!a.base) return cc_err(CC_ERR_OUT_OF_MEMORY, "wrap");
    buf = (char *)cc_arena_alloc(a, n + 1, 1);
    eds = (RtxEdit *)cc_arena_alloc(a, (n + 2) * sizeof(RtxEdit), 8);
    if (!buf || !eds) {
        a.destroy();
        return cc_err(CC_ERR_OUT_OF_MEMORY, "wrap");
    }
    {
        size_t got = d->read_at(lo, cc_slice_from_buffer(buf, n)) !>;
        if (got != n) {
            a.destroy();
            return cc_err(CC_ERR_INTERNAL, "wrap read");
        }
    }
    i = 0;
    while (i < n) {
        size_t le = i, s, e;
        if (per_line) {
            while (le < n && buf[le] != '\n') le++;
        } else {
            le = n;
        }
        s = i;
        e = le;
        if (per_line) {
            while (s < e && (buf[s] == ' ' || buf[s] == '\t')) s++;
            while (e > s && rtx_ap_ws(buf[e - 1])) e--;
        } else {
            while (s < e && rtx_ap_ws(buf[s])) s++;
            while (e > s && rtx_ap_ws(buf[e - 1])) e--;
        }
        if (e > s) {
            if (ne == 0) s0 = lo + s;
            e0 = lo + e;
            eds[ne++] = (RtxEdit){ .off = lo + s, .n = 0, .ins = cc_slice_from_buffer(oc, 1) };
            eds[ne++] = (RtxEdit){ .off = lo + e, .n = 0, .ins = cc_slice_from_buffer(oc + 1, 1) };
        }
        i = le + 1;
    }
    if (ne == 0) {
        a.destroy();
        return cc_ok();
    }
    d->break_coalesce();
    d->replace_batch(eds, ne) !>;
    d->break_coalesce();
    {
        size_t na = s0 + 1, nc = e0 + (ne - 1);
        d->caret = fwd ? nc : na;
        d->sel_anchor = fwd ? na : nc;
        if (!d->hist.applying && d->hist.head > 0) {
            RtxHistRec *r = &d->hist.recs[d->hist.head - 1];
            r->caret_after = d->caret;
            r->sel_after = d->sel_anchor;
        }
    }
    a.destroy();
    b->ap_on = 0;
    return cc_ok();
}

/* Only whitespace and `>` between BOL and `c` (a list / quote marker
 * position, where `*` / `_` / `-` start a bullet or a rule, not a mark). */
static int rtx_ap_line_head(const RtxDoc *d, size_t c) {
    size_t k = 0;
    while (k < 64 && c > 0) {
        char x = rtx_me_byte(d, c - 1);
        if (x == '\n') return 1;
        if (x != ' ' && x != '\t' && x != '>') return 0;
        c--;
        k++;
    }
    return c == 0;
}

/* 1 = handled (pair inserted, stepped over, or selection wrapped). */
static int !>(CCError) rtx_buf_autopair(RtxBuf *b, char ch) {
    RtxDoc *d = &b->doc;
    const char *tab;
    int md, i, oi = -1, ci = -1, trk, nest;
    size_t c, len;
    char prev, next;
    if (d->sel_box) return cc_ok(0);
    tab = rtx_ap_table(b, &md);
    if (!tab[0]) return cc_ok(0);
    if (!memchr(tab, ch, cc_slice_cstr(tab).len) && !memchr("()[]{}\"'`", ch, 9))
        return cc_ok(0);
    if (md) {
        /* Inside a fence, code pairs. */
        RtxMeWin W = {0};
        size_t bol = rtx_me_bol(d, d->sel_lo());
        int ok, in = 0;
        if (bol != (size_t)-1) {
            ok = rtx_me_load(&W, d, bol, bol) !>(e) { return cc_err(e); };
            if (ok) {
                long lt = rtx_me_line_of(&W, bol);
                in = lt >= 0 && rtx_me_in_fence(&W, (size_t)lt, NULL);
                rtx_me_drop(&W);
            }
        }
        if (in) {
            tab = "()[]{}\"\"''``";
            md = 0;
        }
    }
    for (i = 0; tab[i] && tab[i + 1]; i += 2) {
        if (tab[i] == ch && oi < 0) oi = i;
        if (tab[i + 1] == ch && ci < 0) ci = i;
    }
    if (oi < 0 && ci < 0) return cc_ok(0);
    if (d->has_sel()) {
        if (oi < 0) return cc_ok(0);
        rtx_ap_wrap(b, tab[oi], tab[oi + 1], md && (rtx_ap_emph(ch) || ch == '`')) !>(e) {
            return cc_err(e);
        };
        return cc_ok(1);
    }
    c = d->caret;
    len = d->len();
    prev = c > 0 ? rtx_me_byte(d, c - 1) : 0;
    next = c < len ? rtx_me_byte(d, c) : 0;
    trk = rtx_ap_valid(b);
    nest = trk && c == b->ap_open && md && rtx_ap_emph(ch) && prev == ch &&
           next == ch && oi >= 0 && tab[oi] == tab[oi + 1];
    if (trk && ci >= 0 && next == ch) {
        /* `*|*` + `*` nests (`**|**`) — the start of bold; else step over. */
        if (!nest) {
            d->break_coalesce();
            d->caret = c + 1;
            d->sel_anchor = c + 1;
            rtx_ap_note(b, c + 1, b->ap_hi);
            return cc_ok(1);
        }
    }
    if (oi < 0) return cc_ok(0);
    {
        char o = tab[oi], cl = tab[oi + 1];
        int sym = o == cl;
        int next_ok = rtx_ap_ws(next) || next == ')' || next == ']' || next == '}' ||
                      (!sym && (next == ',' || next == ';' || next == ':' || next == '.'));
        int prev_ok = c == 0 || rtx_ap_ws(prev) || prev == '(' || prev == '[' ||
                      prev == '{';
        char pr[2];
        if (!nest) {
            if (!next_ok) return cc_ok(0);
            if (sym && !prev_ok) return cc_ok(0);
            if (sym && md && rtx_ap_emph(ch) && rtx_ap_line_head(d, c)) return cc_ok(0);
        }
        if (md && o == '(' && prev != ']') return cc_ok(0);
        pr[0] = o;
        pr[1] = cl;
        d->break_coalesce();
        d->replace(c, 0, cc_slice_from_buffer(pr, 2)) !>(e) { return cc_err(e); };
        d->break_coalesce();
        d->caret = c + 1;
        d->sel_anchor = c + 1;
        if (!d->hist.applying && d->hist.head > 0) {
            RtxHistRec *r = &d->hist.recs[d->hist.head - 1];
            r->caret_after = c + 1;
            r->sel_after = c + 1;
        }
        if (trk && c == b->ap_lo) rtx_ap_note(b, c + 1, b->ap_hi + 2);
        else rtx_ap_note(b, c + 1, c + 2);
        b->ap_open = c + 1; /* an empty pair: `*` here nests (`**|**`) */
    }
    return cc_ok(1);
}

/* Backspace between an auto pair: both go. 1 = handled. */
static int !>(CCError) rtx_buf_autopair_bs(RtxBuf *b) {
    RtxDoc *d = &b->doc;
    const char *tab;
    int md, i;
    size_t c = d->caret;
    char prev, next;
    if (!rtx_ap_valid(b) || c == 0) return cc_ok(0);
    tab = rtx_ap_table(b, &md);
    prev = rtx_me_byte(d, c - 1);
    next = rtx_me_byte(d, c);
    for (i = 0; tab[i] && tab[i + 1]; i += 2) {
        if (tab[i] == prev && tab[i + 1] == next) break;
    }
    if (!tab[i] || !tab[i + 1]) {
        /* The fence table (``` inside a fence) is not the doc's. */
        const char *code = "()[]{}\"\"''``";
        for (i = 0; code[i]; i += 2) {
            if (code[i] == prev && code[i + 1] == next) break;
        }
        if (!code[i]) return cc_ok(0);
    }
    d->break_coalesce();
    d->replace(c - 1, 2, cc_slice_empty()) !>(e) { return cc_err(e); };
    d->break_coalesce();
    d->caret = c - 1;
    d->sel_anchor = c - 1;
    rtx_ap_note(b, c - 1, b->ap_hi - 2);
    return cc_ok(1);
}

/* ---- Smart paste. A URL pasted over a one-line selection in a Markdown
 * document becomes `[selection](url)` (one undo step). Multi-line text
 * pasted on a block-quote line gets the quote prefix on each new line. */

static int rtx_paste_is_url(const char *s, size_t n) {
    size_t i, k;
    static const char *const sch[] = {"http://", "https://", "ftp://", "file://",
                                      "mailto:", NULL};
    if (!s || n < 8 || n > 4096) return 0;
    for (i = 0; i < n; i++) {
        if ((unsigned char)s[i] <= ' ' || s[i] == '<' || s[i] == '>' ||
            s[i] == '"' || s[i] == '`')
            return 0;
    }
    for (k = 0; sch[k]; k++) {
        size_t sl = cc_slice_cstr(sch[k]).len;
        if (n > sl && strncmp(s, sch[k], sl) == 0) return 1;
    }
    return 0;
}

void !>(CCError) RtxBuf_paste_text(RtxBuf *b, char[:] bytes) {
    RtxDoc *d;
    size_t s = 0, e;
    @errhandler(CCError er) {
        return cc_err(er);
    }
    if (!b) return cc_err(CC_ERR_INVALID_ARG, "paste");
    d = &b->doc;
    if (!bytes.ptr || bytes.len == 0) return cc_ok();
    b->ap_on = 0;
    e = bytes.len;
    while (s < e && rtx_ap_ws(bytes.ptr[s])) s++;
    while (e > s && rtx_ap_ws(bytes.ptr[e - 1])) e--;
    if (rtx_buf_md_ok(b) && d->has_sel() &&
        rtx_paste_is_url(bytes.ptr + s, e - s)) {
        size_t lo = d->sel_lo(), hi = d->sel_hi(), k;
        int one = hi - lo <= RTX_ME_LINE_MAX;
        for (k = lo; one && k < hi; k++) {
            char x = rtx_me_byte(d, k);
            if (x == '\n') one = 0;
        }
        while (one && lo < hi && rtx_ap_ws(rtx_me_byte(d, lo))) lo++;
        while (one && hi > lo && rtx_ap_ws(rtx_me_byte(d, hi - 1))) hi--;
        if (one && hi > lo) {
            CCArena a = cc_arena_heap(e - s + 64) @destroy;
            char *tail;
            RtxEdit eds[2];
            if (!a.base) return cc_err(CC_ERR_OUT_OF_MEMORY, "paste");
            tail = (char *)cc_arena_alloc(a, e - s + 3, 1);
            if (!tail) return cc_err(CC_ERR_OUT_OF_MEMORY, "paste");
            tail[0] = ']';
            tail[1] = '(';
            memcpy(tail + 2, bytes.ptr + s, e - s);
            tail[2 + e - s] = ')';
            eds[0] = (RtxEdit){ .off = lo, .n = 0, .ins = cc_slice_from_buffer((void *)"[", 1) };
            eds[1] = (RtxEdit){ .off = hi, .n = 0,
                                .ins = cc_slice_from_buffer(tail, e - s + 3) };
            d->break_coalesce();
            d->replace_batch(eds, 2) !>;
            d->break_coalesce();
            d->caret = hi + 1 + e - s + 3;
            d->sel_anchor = d->caret;
            if (!d->hist.applying && d->hist.head > 0) {
                RtxHistRec *r = &d->hist.recs[d->hist.head - 1];
                r->caret_after = d->caret;
                r->sel_after = d->caret;
            }
            return cc_ok();
        }
    }
    /* Quote continuation: `> ` on every pasted line after the first. */
    if (rtx_buf_md_ok(b) && memchr(bytes.ptr, '\n', bytes.len)) {
        size_t lo = d->sel_lo(), bol = rtx_me_bol(d, lo);
        char head[256];
        RtxMdLine L;
        size_t hn = 0;
        if (bol != (size_t)-1 && lo - bol < sizeof head) {
            hn = d->read_at(bol, cc_slice_from_buffer(head, lo - bol)) !>;
            rtx_md_line_parse(head, hn, &L);
            if (L.qdepth > 0 && !L.kind && hn >= L.qhi) {
                size_t k, nl = 0, o = 0;
                CCArena a = {0} @destroy;
                char *out;
                for (k = 0; k < bytes.len; k++) {
                    if (bytes.ptr[k] == '\n') nl++;
                }
                a = cc_arena_heap(bytes.len + nl * L.qhi + 64);
                if (!a.base) return cc_err(CC_ERR_OUT_OF_MEMORY, "paste");
                out = (char *)cc_arena_alloc(a, bytes.len + nl * L.qhi + 1, 1);
                if (!out) return cc_err(CC_ERR_OUT_OF_MEMORY, "paste");
                for (k = 0; k < bytes.len; k++) {
                    out[o++] = bytes.ptr[k];
                    if (bytes.ptr[k] == '\n' && k + 1 < bytes.len) {
                        memcpy(out + o, head, L.qhi);
                        o += L.qhi;
                    }
                }
                d->break_coalesce();
                rtx_buf_insert_plain(b, cc_slice_from_buffer(out, o)) !>;
                d->break_coalesce();
                return cc_ok();
            }
        }
    }
    d->break_coalesce();
    d->type(bytes) !>;
    d->break_coalesce();
    return cc_ok();
}

/* ---- Tab: grid / Rich table cells keep their own meaning; list items
 * nest; anything else inserts a tab (or `--tab-spaces` spaces) and
 * Shift-Tab takes one indent unit off the line. */
int !>(CCError) RtxBuf_tab(RtxBuf *b, int dir) {
    @errhandler(CCError e) {
        return cc_err(e);
    }
    if (!b) return cc_err(CC_ERR_INVALID_ARG, "tab");
    if (rtx_layout_is_hex(&b->layout)) return cc_ok(0);
    if (rtx_layout_is_grid(&b->layout)) {
        b->move_grid_col(dir < 0 ? -1 : 1) !>;
        return cc_ok(0);
    }
    if (rtx_buf_in_md_table(b)) {
        size_t n0 = b->len();
        b->move_md_col(dir < 0 ? -1 : 1) !>;
        return cc_ok(b->len() != n0);
    }
    b->ap_on = 0;
    if (rtx_buf_list_indent(b, dir < 0 ? -1 : 1) !>) return cc_ok(1);
    if (dir < 0) {
        /* Outdent this line by one tab / unit. */
        RtxDoc *d = &b->doc;
        size_t bol = rtx_me_bol(d, d->caret), k = 0, unit;
        if (bol == (size_t)-1 || d->has_sel()) return cc_ok(0);
        unit = g_rtx_tab_spaces ? (size_t)g_rtx_tab_spaces : 4;
        if (rtx_me_byte(d, bol) == '\t') k = 1;
        else {
            while (k < unit && rtx_me_byte(d, bol + k) == ' ') k++;
        }
        if (!k) return cc_ok(0);
        {
            size_t c = d->caret;
            d->break_coalesce();
            d->replace(bol, k, cc_slice_empty()) !>;
            d->break_coalesce();
            d->caret = c >= bol + k ? c - k : bol;
            d->sel_anchor = d->caret;
        }
        return cc_ok(1);
    }
    if (g_rtx_tab_spaces > 0) {
        char sp[16];
        size_t k, n = (size_t)g_rtx_tab_spaces;
        for (k = 0; k < n; k++) sp[k] = ' ';
        rtx_buf_insert_plain(b, cc_slice_from_buffer(sp, n)) !>;
        return cc_ok(1);
    }
    b->type_cp((uint32_t)'\t') !>;
    return cc_ok(1);
}

/* ---- Markdown table commands (Apply menu while the caret is in a
 * table; each one undo step). The table is found from the bytes around
 * the caret (rtx_md_table_cover over the window), in Source and Rich. */

typedef struct {
    RtxMeWin W;
    RtxMdTable t;      /* offsets into W.buf */
    size_t l0, l1;     /* src lines of the table */
    size_t cl;         /* caret line */
    int col;           /* caret column (0-based) */
} RtxMeTable;

static int rtx_tbl_col_of(const char *s, size_t n, size_t rel, int ncols) {
    int c = rtx_md_row_col_at(s, n, rel, ncols);
    if (c < 0 && rel + 1 <= n) c = rtx_md_row_col_at(s, n, rel + 1, ncols);
    if (c < 0 && rel > 0) c = rtx_md_row_col_at(s, n, rel - 1, ncols);
    if (c < 0) c = 0;
    if (c >= ncols) c = ncols - 1;
    return c;
}

static int !>(CCError) rtx_tbl_find(const RtxBuf *b, RtxMeTable *T) {
    const RtxDoc *d = &b->doc;
    size_t bol = rtx_me_bol(d, d->caret), i;
    long lt;
    int ok;
    *T = (RtxMeTable){0};
    if (bol == (size_t)-1) return cc_ok(0);
    ok = rtx_me_load(&T->W, d, bol, bol) !>(e) { return cc_err(e); };
    if (!ok) return cc_ok(0);
    if (!rtx_md_table_cover(T->W.buf, T->W.n, bol - T->W.lo, &T->t)) {
        rtx_me_drop(&T->W);
        return cc_ok(0);
    }
    lt = rtx_me_line_of(&T->W, bol);
    if (lt < 0) {
        rtx_me_drop(&T->W);
        return cc_ok(0);
    }
    T->cl = (size_t)lt;
    T->l0 = T->l1 = T->cl;
    for (i = 0; i < T->W.ns; i++) {
        size_t o = T->W.src[i].off - T->W.lo;
        if (o == T->t.lo) T->l0 = i;
        if (o < T->t.hi) T->l1 = i;
    }
    {
        const RtxMeSrc *S = &T->W.src[T->cl];
        T->col = rtx_tbl_col_of(S->s, S->len - (size_t)S->cr, d->caret - S->off,
                                T->t.ncols);
    }
    return cc_ok(1);
}

int RtxBuf_in_table(const RtxBuf *b) {
    RtxMeTable T;
    int ok;
    @errhandler(CCError e) {
        (void)e;
        return 0;
    }
    if (!b || rtx_layout_is_hex(&b->layout) || rtx_layout_is_grid(&b->layout))
        return 0;
    if (!RtxDoc_is_markup(&b->doc)) return 0;
    ok = rtx_tbl_find(b, &T) !>;
    if (ok) rtx_me_drop(&T.W);
    return ok;
}

/* Rebuild one row with column `c` inserted (op 0), deleted (1), or
 * swapped with c + 1 (2). Cells keep their bytes; the outer pipes and
 * surrounding whitespace keep their shape. */
static size_t rtx_tbl_row(const char *s, size_t n, int sep, int op, int c,
                          char *dst, size_t cap) {
    RtxMdCell cells[RTX_MD_TABLE_COLS + 1];
    size_t a = 0, z = n, nc, o = 0, i;
    int lead, trail;
    const char *blank = sep ? "---" : "  ";
    size_t bn = sep ? 3 : 2;
    while (a < z && (s[a] == ' ' || s[a] == '\t')) a++;
    while (z > a && (s[z - 1] == ' ' || s[z - 1] == '\t')) z--;
    lead = a < z && s[a] == '|';
    trail = z > a + (size_t)lead && s[z - 1] == '|' && (z < 2 || s[z - 2] != '\\');
    nc = rtx_md_row_split(s + a, z - a, cells, RTX_MD_TABLE_COLS);
    if (nc > RTX_MD_TABLE_COLS) nc = RTX_MD_TABLE_COLS;
#define RTX_TBL_PUT(p, m)                                       \
    do {                                                        \
        if (o + (m) > cap) return 0;                            \
        if (m) memcpy(dst + o, (p), (m));                       \
        o += (m);                                               \
    } while (0)
    RTX_TBL_PUT(s, a);
    if (lead) RTX_TBL_PUT("|", 1);
    {
        int first = 1;
        size_t outc = 0;
        size_t cols = nc;
        if (op == 0 && (size_t)c > cols) cols = (size_t)c;
        for (i = 0; i <= cols; i++) {
            const char *cp = NULL;
            size_t cn = 0;
            int emit = 1;
            if (op == 0 && (size_t)c == i) {
                if (!first) RTX_TBL_PUT("|", 1);
                RTX_TBL_PUT(blank, bn);
                first = 0;
                outc++;
            }
            if (i >= nc) {
                if (op == 0 && i < (size_t)c) {
                    cp = blank;
                    cn = bn;
                } else {
                    continue;
                }
            } else {
                size_t src = i;
                if (op == 1 && (size_t)c == i) emit = 0;
                if (op == 2 && (size_t)c == i && i + 1 < nc) src = i + 1;
                if (op == 2 && (size_t)c + 1 == i) src = i - 1;
                cp = s + a + cells[src].lo;
                cn = cells[src].hi - cells[src].lo;
            }
            if (!emit) continue;
            if (!first) RTX_TBL_PUT("|", 1);
            RTX_TBL_PUT(cp, cn);
            first = 0;
            outc++;
        }
        (void)outc;
    }
    if (trail || (op == 0 && (size_t)c >= nc && nc > 0)) RTX_TBL_PUT("|", 1);
    RTX_TBL_PUT(s + z, n - z);
#undef RTX_TBL_PUT
    return o;
}

static void !>(CCError) rtx_tbl_cols(RtxBuf *b, RtxMeTable *T, int op, int c,
                                    int want_col) {
    RtxMeWin *W = &T->W;
    size_t i, caret = b->doc.caret;
    long cvi;
    W->b0 = T->l0;
    W->b1 = T->l1;
    rtx_me_virt(W);
    for (i = 0; i < W->nv; i++) {
        RtxMeV *V = &W->v[i];
        size_t cap = V->n + 8 * (RTX_MD_TABLE_COLS + 2);
        char *dst = rtx_me_alloc(W, cap);
        int sep = rtx_md_line_is_sep(V->t, V->n);
        size_t got;
        if (!dst) return cc_err(CC_ERR_OUT_OF_MEMORY, "table col");
        got = rtx_tbl_row(V->t, V->n, sep, op, c, dst, cap);
        if (!got) return cc_err(CC_ERR_OUT_OF_MEMORY, "table row");
        V->t = dst;
        V->n = got;
    }
    cvi = rtx_me_vof(W, T->cl);
    if (cvi >= 0) {
        RtxMeV *V = &W->v[cvi];
        RtxMdCell cells[RTX_MD_TABLE_COLS];
        size_t nc = rtx_md_row_split(V->t, V->n, cells, RTX_MD_TABLE_COLS), lo, hi;
        if (nc) {
            if (want_col >= (int)nc) want_col = (int)nc - 1;
            if (want_col < 0) want_col = 0;
            lo = cells[want_col].lo;
            hi = cells[want_col].hi;
            rtx_md_span_trim(V->t, &lo, &hi);
            if (lo == hi && lo > cells[want_col].lo) lo = cells[want_col].lo + 1;
            if (lo > V->n) lo = V->n;
            caret = rtx_me_pos(W, (size_t)cvi, lo);
        }
    }
    return rtx_me_commit(W, &b->doc, caret, caret, 0);
}

void !>(CCError) RtxBuf_table_op(RtxBuf *b, int op) {
    RtxMeTable T;
    int ok, role;
    @errhandler(CCError e) {
        rtx_me_drop(&T.W);
        return cc_err(e);
    }
    T = (RtxMeTable){0};
    if (!b) return cc_err(CC_ERR_INVALID_ARG, "table op");
    if (rtx_layout_is_hex(&b->layout) || rtx_layout_is_grid(&b->layout))
        return cc_ok();
    ok = rtx_tbl_find(b, &T) !>;
    if (!ok) return cc_ok();
    b->ap_on = 0;
    role = rtx_md_table_role(&T.t, b->doc.caret >= T.W.lo ? b->doc.caret - T.W.lo : 0);
    switch (op) {
        case RTX_TBL_COL_LEFT:
            if (T.t.ncols >= RTX_MD_TABLE_COLS) break;
            rtx_tbl_cols(b, &T, 0, T.col, T.col) !>;
            break;
        case RTX_TBL_COL_RIGHT:
            if (T.t.ncols >= RTX_MD_TABLE_COLS) break;
            rtx_tbl_cols(b, &T, 0, T.col + 1, T.col + 1) !>;
            break;
        case RTX_TBL_COL_DEL:
            if (T.t.ncols <= 1) break;
            rtx_tbl_cols(b, &T, 1, T.col, T.col < T.t.ncols - 1 ? T.col : T.col - 1) !>;
            break;
        case RTX_TBL_COL_MOVE_L:
            if (T.col <= 0) break;
            rtx_tbl_cols(b, &T, 2, T.col - 1, T.col - 1) !>;
            break;
        case RTX_TBL_COL_MOVE_R:
            if (T.col + 1 >= T.t.ncols) break;
            rtx_tbl_cols(b, &T, 2, T.col, T.col + 1) !>;
            break;
        case RTX_TBL_ROW_ABOVE:
        case RTX_TBL_ROW_BELOW: {
            /* New body row: above / below a body row, or first body row
             * from the header / separator. */
            RtxMeWin *W = &T.W;
            size_t at = T.cl;
            long vi;
            RtxMeV *F;
            char row[1 + 3 * RTX_MD_TABLE_COLS + 2];
            size_t rn = rtx_md_empty_row(T.t.ncols, row, sizeof row);
            if (!rn) break;
            rn--; /* no newline: the join adds it */
            if (role != RTX_MD_ROLE_BODY) {
                at = T.l0 + 1;
                for (at = T.l0; at < T.l1 && T.W.src[at].off - W->lo < T.t.sep_lo; at++) {}
            } else if (op == RTX_TBL_ROW_ABOVE) {
                at = T.cl - 1;
            }
            W->b0 = T.l0;
            W->b1 = T.l1;
            rtx_me_virt(W);
            vi = rtx_me_vof(W, at);
            if (vi < 0) break;
            F = rtx_me_insert(W, (size_t)vi);
            if (!F) break;
            F->t = rtx_me_alloc(W, rn);
            if (!F->t) {
                rtx_me_drop(&T.W);
                return cc_err(CC_ERR_OUT_OF_MEMORY, "table row");
            }
            memcpy(F->t, row, rn);
            F->n = rn;
            rtx_me_commit(W, &b->doc, rtx_me_pos(W, (size_t)vi + 1, 2),
                          rtx_me_pos(W, (size_t)vi + 1, 2), 0) !>;
            break;
        }
        case RTX_TBL_ROW_DEL: {
            RtxMeWin *W = &T.W;
            size_t lo, hi, caret;
            RtxEdit ed;
            const RtxMeSrc *S = &W->src[T.cl];
            if (role != RTX_MD_ROLE_BODY) break;
            lo = S->off;
            hi = S->off + S->len + (size_t)S->nl;
            if (!S->nl && lo > 0) {
                lo--; /* last line: take the newline before it */
            }
            ed = (RtxEdit){ .off = lo, .n = hi - lo, .ins = cc_slice_empty() };
            caret = lo < S->off ? W->src[T.cl - 1].off : lo;
            b->doc.break_coalesce();
            b->doc.replace_batch(&ed, 1) !>;
            b->doc.break_coalesce();
            b->doc.caret = caret;
            b->doc.sel_anchor = caret;
            if (!b->doc.hist.applying && b->doc.hist.head > 0) {
                RtxHistRec *r = &b->doc.hist.recs[b->doc.hist.head - 1];
                r->caret_after = caret;
                r->sel_after = caret;
            }
            break;
        }
        default:
            break;
    }
    rtx_me_drop(&T.W);
    b->clear_pref();
    return cc_ok();
}

static const char *const rtx_tbl_names[RTX_TBL_OPS] = {
    "row above", "row below", "delete row", "column left", "column right",
    "delete column", "move column left", "move column right",
};
static const char rtx_tbl_keys[RTX_TBL_OPS] = {'a', 'b', 'd', 'l', 'r', 'x', '<', '>'};

const char *rtx_table_op_name(int op) {
    return op >= 0 && op < RTX_TBL_OPS ? rtx_tbl_names[op] : NULL;
}

int rtx_table_op_key(int op) {
    return op >= 0 && op < RTX_TBL_OPS ? rtx_tbl_keys[op] : 0;
}

int rtx_table_op_of_key(int ch) {
    int i;
    for (i = 0; i < RTX_TBL_OPS; i++) {
        if (rtx_tbl_keys[i] == ch) return i;
    }
    return -1;
}

void !>(CCError) RtxBuf_enter_soft(RtxBuf *b) {
    if (!b) return cc_err(CC_ERR_INVALID_ARG, "enter");
    if (rtx_layout_is_hex(&b->layout)) return cc_ok();
    b->ap_on = 0;
    if (rtx_buf_md_enter(b, 1) !>(e) { return cc_err(e); }) return cc_ok();
    return b->doc.type("\n");
}

void !>(CCError) RtxBuf_type_cp(RtxBuf *b, uint32_t cp) {
    int dig;
    size_t at, n, got;
    unsigned char cur = 0;
    char one[1];
    int existed;
    int hi;
    if (!b) return cc_err(CC_ERR_INVALID_ARG, "type");
    if (!rtx_layout_is_hex(&b->layout)) {
        if (!b->doc.has_sel()) {
            rtx_buf_md_snap(b, 0);
            b->doc.sel_anchor = b->doc.caret;
        }
        if (cp == (uint32_t)'|' && rtx_buf_in_md_table(b)) {
            int ti = rtx_layout_md_index(&b->layout, b->doc.caret);
            char esc[2];
            esc[0] = '\\';
            esc[1] = '|';
            if (ti >= 0 &&
                rtx_md_table_role(&b->layout.md_tab[ti], b->doc.caret) !=
                    RTX_MD_ROLE_SEP) {
                if (rtx_buf_rich(b) && b->doc.has_sel() && !b->doc.sel_box)
                    return rtx_buf_pair_replace(b, b->doc.sel_lo(),
                                                b->doc.sel_hi(),
                                                esc.to_slice_n(2));
                return b->doc.type(esc.to_slice_n(2));
            }
        }
        if (cp > 0 && cp < 0x80) {
            int done = rtx_buf_autopair(b, (char)cp) !>(e) { return cc_err(e); };
            if (done) return cc_ok();
        }
        {
            int trk = rtx_ap_valid(b);
            size_t c0 = b->doc.caret, n0 = b->doc.len();
            if (rtx_buf_rich(b) && b->doc.has_sel() && !b->doc.sel_box) {
                char buf[4];
                int n = rtx_utf8_encode(cp, buf);
                if (n <= 0) return cc_ok();
                b->ap_on = 0;
                return rtx_buf_pair_replace(b, b->doc.sel_lo(), b->doc.sel_hi(),
                                            buf.to_slice_n((size_t)n));
            }
            b->doc.type_cp(cp) !>(e) { return cc_err(e); };
            rtx_ap_follow(b, trk, c0, n0);
        }
        return cc_ok();
    }
    dig = rtx_hex_digit(cp);
    if (dig < 0) return cc_ok();
    if (b->doc.has_sel()) {
        at = b->doc.sel_lo();
        b->doc.caret = at;
        b->doc.clear_sel();
        b->hex_nib = 0;
    } else {
        at = b->doc.caret;
    }
    n = b->len();
    if (at > n) at = n;
    existed = at < n;
    if (existed) {
        got = b->doc.read_at(at, cc_slice_from_buffer((char *)&cur, 1)) !>(e) { return cc_err(e); };
        if (got != 1) cur = 0;
    }
    hi = !b->hex_nib;
    if (hi) cur = (unsigned char)((dig << 4) | (cur & 0x0F));
    else cur = (unsigned char)((cur & 0xF0) | dig);
    one[0] = (char)cur;
    b->doc.replace(at, existed ? 1 : 0, one.to_slice_n(1)) !>(e) { return cc_err(e); };
    if (hi) {
        b->doc.caret = at;
        b->doc.sel_anchor = at;
        b->hex_nib = 1;
    } else {
        b->hex_nib = 0;
    }
    return cc_ok();
}

void !>(CCError) RtxBuf_enter(RtxBuf *b) {
    if (!b) return cc_err(CC_ERR_INVALID_ARG, "enter");
    if (rtx_layout_is_hex(&b->layout)) return cc_ok();
    if (rtx_buf_in_md_table(b)) return rtx_buf_md_insert_row(b);
    b->ap_on = 0;
    if (rtx_buf_md_enter(b, 0) !>(e) { return cc_err(e); }) return cc_ok();
    return b->doc.type("\n");
}

static void !>(CCError) rtx_buf_backspace_raw(RtxBuf *b);

void !>(CCError) RtxBuf_backspace(RtxBuf *b) {
    int trk;
    size_t c0, n0;
    if (!b) return cc_err(CC_ERR_INVALID_ARG, "backspace");
    rtx_buf_hex_nib_reset(b);
    if (rtx_buf_autopair_bs(b) !>(e) { return cc_err(e); }) return cc_ok();
    trk = rtx_ap_valid(b);
    c0 = b->doc.caret;
    n0 = b->doc.len();
    rtx_buf_backspace_raw(b) !>(e) { return cc_err(e); };
    rtx_ap_follow(b, trk, c0, n0);
    return cc_ok();
}

static void !>(CCError) rtx_buf_backspace_raw(RtxBuf *b) {
    if (rtx_buf_byte_units(b) && !b->doc.has_sel() && b->doc.caret > 0) {
        return b->doc.replace(b->doc.caret - 1, 1, cc_slice_empty());
    }
    if (rtx_buf_rich(b) && !b->doc.sel_box) {
        size_t lo, hi;
        /* Join rule: a selection reaching a hint reaches the pair; a
         * backspace onto a hint is unwrap (both hints go). */
        if (b->doc.has_sel())
            return rtx_buf_pair_replace(b, b->doc.sel_lo(), b->doc.sel_hi(),
                                        cc_slice_empty());
        if (b->doc.caret > 0 && RtxDoc_hint_at(&b->doc, b->doc.caret - 1, &lo, &hi)) {
            if (RtxDoc_path_at(&b->doc, b->doc.caret - 1, NULL, NULL, NULL, NULL))
                return b->doc.path_unwrap(b->doc.caret - 1);
            if (RtxDoc_prefix_at(&b->doc, b->doc.caret - 1, NULL, NULL))
                return b->doc.prefix_apply(b->doc.caret - 1);
            return rtx_buf_pair_replace(b, lo, hi, cc_slice_empty());
        }
    }
    if (!b->doc.has_sel() && b->layout.rich &&
        !rtx_layout_is_hex(&b->layout) && !rtx_layout_is_grid(&b->layout)) {
        size_t clo, chi;
        rtx_buf_md_snap(b, 0);
        b->doc.sel_anchor = b->doc.caret;
        if (rtx_layout_md_cell_span(&b->layout, &b->doc, b->doc.caret, &clo,
                                    &chi) &&
            b->doc.caret <= clo) {
            int col = rtx_layout_md_col_at(&b->layout, &b->doc, b->doc.caret);
            int ti = rtx_layout_md_index(&b->layout, b->doc.caret);
            int role = ti >= 0
                           ? rtx_md_table_role(&b->layout.md_tab[ti],
                                               b->doc.caret)
                           : RTX_MD_ROLE_NONE;
            /* A cell start never eats a `|` or a column. */
            if (role == RTX_MD_ROLE_BODY && col == 0)
                return rtx_buf_md_delete_row(b);
            return cc_ok();
        }
    }
    return b->doc.backspace();
}

void !>(CCError) RtxBuf_delete_forward(RtxBuf *b) {
    if (!b) return cc_err(CC_ERR_INVALID_ARG, "delete");
    rtx_buf_hex_nib_reset(b);
    if (rtx_buf_byte_units(b) && !b->doc.has_sel() && b->doc.caret < b->len()) {
        return b->doc.replace(b->doc.caret, 1, cc_slice_empty());
    }
    if (rtx_buf_rich(b) && !b->doc.sel_box) {
        size_t lo, hi;
        if (b->doc.has_sel())
            return rtx_buf_pair_replace(b, b->doc.sel_lo(), b->doc.sel_hi(),
                                        cc_slice_empty());
        if (RtxDoc_hint_at(&b->doc, b->doc.caret, &lo, &hi)) {
            if (RtxDoc_path_at(&b->doc, b->doc.caret, NULL, NULL, NULL, NULL))
                return b->doc.path_unwrap(b->doc.caret);
            if (RtxDoc_prefix_at(&b->doc, b->doc.caret, NULL, NULL))
                return b->doc.prefix_apply(b->doc.caret);
            return rtx_buf_pair_replace(b, lo, hi, cc_slice_empty());
        }
    }
    if (!b->doc.has_sel() && b->layout.rich &&
        !rtx_layout_is_hex(&b->layout) && !rtx_layout_is_grid(&b->layout)) {
        size_t clo, chi;
        rtx_buf_md_snap(b, 0);
        b->doc.sel_anchor = b->doc.caret;
        if (rtx_layout_md_cell_span(&b->layout, &b->doc, b->doc.caret, &clo,
                                    &chi) &&
            b->doc.caret >= chi)
            return cc_ok();
    }
    return b->doc.delete_forward();
}

static void rtx_buf_origin_from_row(RtxBuf *b, size_t origin) {
    size_t first;
    if (!b || b->layout.rows.len == 0) return;
    if (origin >= b->layout.rows.len) origin = b->layout.rows.len - 1;
    b->top = b->layout.rows.data[origin].line;
    first = origin;
    while (first > 0 && b->layout.rows.data[first - 1].line == b->top) first--;
    b->top_wrap = origin - first;
    if (rtx_layout_is_grid(&b->layout)) b->top_wrap = 0;
}

size_t RtxBuf_view_off(const RtxBuf *b) {
    size_t i;
    if (!b) return 0;
    if (rtx_layout_is_hex(&b->layout)) return b->top_byte;
    if (b->seek_valid) return b->seek_off;
    if (b->layout.rows.len) {
        i = b->top_wrap < b->layout.rows.len ? b->top_wrap : 0;
        return b->layout.rows.data[i].byte_start;
    }
    return 0;
}

void !>(RtxIndexErr) RtxBuf_reveal_off(RtxBuf *b, size_t off, int vis) {
    size_t cl;
    size_t ri;
    size_t n;
    size_t row;
    size_t top_row;
    if (!b) return cc_ok();
    if (vis < 1) vis = 1;
    n = b->len();
    if (off > n) off = n;
    if (rtx_layout_is_hex(&b->layout)) {
        b->top_byte = rtx_hex_align(b->top_byte);
        if (b->top_byte > n) b->top_byte = rtx_hex_align(n);
        row = off / (size_t)RTX_HEX_COLS;
        top_row = b->top_byte / (size_t)RTX_HEX_COLS;
        if (row < top_row) b->top_byte = row * (size_t)RTX_HEX_COLS;
        else if (row >= top_row + (size_t)vis) {
            b->top_byte = (row + 1 - (size_t)vis) * (size_t)RTX_HEX_COLS;
        }
        b->seek_valid = 0;
        return cc_ok();
    }
    /* Follow: a live seek stays a seek. Stay if `off` is already on a
     * visible row. Snap-to-top is land (jump % / find hits). */
    if (b->seek_valid) {
        size_t floor;
        if (!b->layout.rows.len) return cc_ok();
        floor = rtx_doc_line_floor_local(&b->doc, off) !>(e) {
            return cc_err(e);
        };
        if (b->layout.rows.data[0].byte_start == b->seek_off) {
            size_t i0 = b->top_wrap < b->layout.rows.len ? b->top_wrap : 0;
            size_t i1 = i0 + (size_t)vis;
            size_t a, z;
            if (i1 > b->layout.rows.len) i1 = b->layout.rows.len;
            if (i1 > i0) {
                a = b->layout.rows.data[i0].byte_start;
                z = b->layout.rows.data[i1 - 1].byte_start +
                    b->layout.rows.data[i1 - 1].byte_len;
                if (off >= a && off <= z) return cc_ok();
            }
        }
        rtx_buf_seek_set(b, floor);
        b->top_wrap = 0;
        return cc_ok();
    }
    if (!b->doc.index_covers(off)) {
        size_t floor = rtx_doc_line_floor_local(&b->doc, off) !>(e) {
            return cc_err(e);
        };
        rtx_buf_seek_set(b, floor);
        b->top_wrap = 0;
        return cc_ok();
    }
    cl = b->line_of(off) !>(e) { return cc_err(e); };
    if (rtx_layout_is_grid(&b->layout)) {
        size_t floor = rtx_doc_line_floor_local(&b->doc, off) !>(e) {
            return cc_err(e);
        };
        size_t rec = rtx_layout_grid_cam_lo(&b->doc, floor, NULL) !>(e) {
            return cc_err(rtx_index_from_cc(e));
        };
        if (b->doc.index_covers(rec))
            cl = b->line_of(rec) !>(e) { return cc_err(e); };
    }
    if (!rtx_layout_soft_wrap(&b->layout)) {
        b->top_wrap = 0;
        if (cl < b->top) b->top = cl;
        if (cl >= b->top + (size_t)vis) b->top = cl - (size_t)vis + 1;
        return cc_ok();
    }
    if (b->layout.rows.len == 0) {
        b->top = cl;
        b->top_wrap = 0;
        return cc_ok();
    }
    if (cl < b->top || off < b->layout.rows.data[0].byte_start) {
        b->top = cl;
        b->top_wrap = 0;
        return cc_ok();
    }
    {
        RtxVisRow *last = &b->layout.rows.data[b->layout.rows.len - 1];
        if (cl > last->line && off >= last->byte_start + last->byte_len) {
            b->top = cl;
            b->top_wrap = 0;
            return cc_ok();
        }
    }
    ri = rtx_layout_is_grid(&b->layout)
             ? rtx_layout_grid_row_of(&b->layout, &b->doc, off)
             : b->layout.row_of(off);
    if (ri < b->top_wrap) {
        rtx_buf_origin_from_row(b, ri);
        return cc_ok();
    }
    {
        size_t screen = 0;
        size_t i;
        int rh;
        for (i = b->top_wrap; i < ri && i < b->layout.rows.len; i++) {
            int h = (int)(b->layout.rows.data[i].height + 0.0001);
            if (h < 1) h = 1;
            screen += (size_t)h;
        }
        rh = 1;
        if (ri < b->layout.rows.len) {
            rh = (int)(b->layout.rows.data[ri].height + 0.0001);
            if (rh < 1) rh = 1;
        }
        /* Row starts on-screen (may spill past the bottom). */
        if (screen < (size_t)vis) return cc_ok();
        (void)rh;
    }
    {
        /* Scroll so `ri` sits near the bottom of the pane by screen height. */
        size_t screen = 0;
        size_t i = ri < b->layout.rows.len ? ri : b->layout.rows.len - 1;
        int h = (int)(b->layout.rows.data[i].height + 0.0001);
        if (h < 1) h = 1;
        screen = (size_t)h;
        while (i > 0 && screen < (size_t)vis) {
            int nh;
            i--;
            nh = (int)(b->layout.rows.data[i].height + 0.0001);
            if (nh < 1) nh = 1;
            if (screen + (size_t)nh > (size_t)vis && screen > 0) {
                i++;
                break;
            }
            screen += (size_t)nh;
        }
        rtx_buf_origin_from_row(b, i);
    }
    return cc_ok();
}

/* A selected find hit carries its exact line (the scan counted every
 * newline before it). Key the gutter origin on its floor so land keeps
 * that camera instead of walking an island back to BOF for the label. */
static void rtx_buf_key_from_find(RtxBuf *b, size_t floor) {
    const RtxFindHit *h;
    size_t n;
    if (!b || !b->doc.find.pinned) return;
    n = rtx_find_hits_n(&b->doc.find);
    if (b->doc.find.cur >= n) return;
    h = &b->doc.find.hits.data[b->doc.find.cur];
    if (h->off != b->doc.caret || h->off < floor) return;
    if (b->doc.index_covers(floor)) return;
    rtx_line_origin_key(&b->doc.tree, floor, h->line);
}

void !>(RtxIndexErr) RtxBuf_land(RtxBuf *b, int vis) {
    size_t n;
    size_t off;
    size_t row;
    size_t top_row;
    if (!b) return cc_ok();
    if (vis < 1) vis = 1;
    b->pin_view = 0;
    n = b->len();
    off = b->doc.caret;
    if (off > n) off = n;
    if (rtx_layout_is_hex(&b->layout)) {
        b->top_byte = rtx_hex_align(b->top_byte);
        if (b->top_byte > n) b->top_byte = rtx_hex_align(n);
        row = off / (size_t)RTX_HEX_COLS;
        top_row = b->top_byte / (size_t)RTX_HEX_COLS;
        if (row < top_row) b->top_byte = row * (size_t)RTX_HEX_COLS;
        else if (row >= top_row + (size_t)vis) {
            b->top_byte = (row + 1 - (size_t)vis) * (size_t)RTX_HEX_COLS;
        }
        b->seek_valid = 0;
        return cc_ok();
    }
    {
        size_t floor = rtx_doc_line_floor_local(&b->doc, off) !>(e) {
            return cc_err(e);
        };
        rtx_buf_key_from_find(b, floor);
        /* Jump keyed the origin on this exact floor. Keep it — seek_set
         * would clear a mid-file mark and kick an island back to BOF. */
        if (rtx_line_mark_ok(&b->doc.tree) && b->doc.tree.mark_off == floor) {
            b->seek_off = floor;
            b->seek_rel = 0;
            b->seek_valid = 1;
            rtx_line_isle_cancel(&b->doc.tree);
        } else {
            rtx_buf_seek_set(b, floor);
            if (!b->doc.index_covers(floor) && !rtx_line_mark_ok(&b->doc.tree))
                rtx_line_isle_kick(&b->doc.tree, floor);
        }
    }
    b->top_wrap = 0;
    return cc_ok();
}

void !>(RtxIndexErr) RtxBuf_reveal(RtxBuf *b, int vis) {
    if (!b) return cc_ok();
    return b->reveal_off(b->doc.caret, vis);
}

void RtxBuf_toggle_rich(RtxBuf *b) {
    if (!b) return;
    b->layout.rich = !b->layout.rich;
    b->layout.reveal_lo = b->layout.reveal_hi = 0;
    b->layout.clear_rows();
}

void RtxBuf_toggle_wrap(RtxBuf *b) {
    if (!b) return;
    if (rtx_layout_is_hex(&b->layout) || rtx_layout_is_grid(&b->layout))
        return;
    b->layout.wrap = !b->layout.wrap;
    b->left_col = 0;
    b->top_wrap = 0;
    b->layout.clear_rows();
    rtx_ws_flush_buf(b);
}

void !>(CCError) RtxBuf_apply_set(RtxBuf *b, char[:0] name, int level) {
    if (!b) return cc_err(CC_ERR_INVALID_ARG, "apply set");
    if (rtx_layout_is_hex(&b->layout) || rtx_layout_is_grid(&b->layout))
        return cc_ok();
    return b->doc.apply_set(b->doc.caret, name, level);
}

void !>(CCError) RtxBuf_apply_cycle(RtxBuf *b) {
    if (!b) return cc_err(CC_ERR_INVALID_ARG, "apply cycle");
    if (rtx_layout_is_hex(&b->layout) || rtx_layout_is_grid(&b->layout))
        return cc_ok();
    return b->doc.apply_cycle(b->doc.caret);
}

void !>(CCError) RtxBuf_apply_named(RtxBuf *b, char[:0] name) {
    if (!b) return cc_err(CC_ERR_INVALID_ARG, "apply named");
    if (rtx_layout_is_hex(&b->layout) || rtx_layout_is_grid(&b->layout))
        return cc_ok();
    return b->doc.apply_named(name);
}

int !>(CCError) RtxBuf_activate(RtxBuf *b) {
    const char *nm;
    @errhandler(CCError e) {
        return cc_err(e);
    }
    if (!b || !rtx_buf_rich(b)) return cc_ok(0);
    nm = RtxDoc_mark_apply(&b->doc, b->doc.caret);
    if (!nm) return cc_ok(0);
    b->apply_named(cc_slice_cstr(nm)) !>;
    return cc_ok(1);
}

void !>(RtxIndexErr) RtxBuf_cycle_view(RtxBuf *b, int vis) {
    size_t keep;
    int was_hex;
    @errhandler(CCError e) {
        return cc_err(rtx_index_from_cc(e));
    }
    if (!b) return cc_ok();
    keep = b->view_off();
    was_hex = rtx_layout_is_hex(&b->layout);
    rtx_layout_cycle_view(&b->layout);
    rtx_buf_grid_bind(b);
    b->left_col = 0;
    if (rtx_layout_is_grid(&b->layout) && b->doc.caret > 0) {
        char c = 0;
        size_t got = 0;
        size_t was = b->doc.caret;
        {
            @errhandler(CCError e) {
                (void)e;
                got = 0;
            }
            got = b->doc.read_at(was, cc_slice_from_buffer(&c, 1)) !>;
        }
        /* Record NL is a gap. cluster_prev put the caret in the last
         * field and reveal_x panned left_col. Land on this record start. */
        if (got == 1 && (c == '\n' || c == '\r')) {
            size_t lo = rtx_layout_grid_cam_lo(&b->doc, was, NULL) !>;
            b->doc.caret = lo;
            if (b->doc.sel_anchor == was) b->doc.sel_anchor = lo;
        }
    }
    if (was_hex && !rtx_layout_is_hex(&b->layout) &&
        b->doc.sel_anchor == b->doc.caret) {
        b->doc.caret = b->doc.cluster_align(b->doc.caret) !>;
        b->doc.sel_anchor = b->doc.caret;
    }
    b->top_wrap = 0;
    b->layout.clear_rows();
    b->seek_valid = 0;
    b->drag_vis = 0;
    b->drag_len = 0;
    b->drag_horiz = 0;
    b->clear_pref();
    rtx_buf_hex_nib_reset(b);
    rtx_ws_flush_buf(b);
    if (b->unlock) return b->reveal_off(keep, vis);
    return b->reveal_off(b->doc.caret, vis);
}

static void !>(RtxIndexErr) rtx_buf_fold_skip_cam(RtxBuf *b, int dir) {
    size_t off;
    size_t snap;
    @errhandler(RtxIndexErr e) {
        return cc_err(e);
    }
    if (!b || !b->doc.fold_n) return cc_ok();
    if (rtx_layout_is_hex(&b->layout)) return cc_ok();
    if (b->seek_valid) {
        rtx_buf_seek_set(b, b->doc.fold_snap(b->seek_off, dir));
        return cc_ok();
    }
    off = b->doc.line_start(b->top) !>;
    snap = b->doc.fold_snap(off, dir);
    if (snap != off) {
        if (b->doc.index_covers(snap))
            b->top = b->doc.line_of(snap) !>;
        else
            rtx_buf_seek_set(b, snap);
        b->top_wrap = 0;
    }
    return cc_ok();
}

static void !>(CCError) rtx_buf_grid_scroll(RtxBuf *b, const RtxMeasure *m,
                                           double width, int dir) {
    @errhandler(CCError e) {
        return cc_err(e);
    }
    (void)m;
    (void)width;
    if (!b) return cc_err(CC_ERR_INVALID_ARG, "grid scroll");
    b->top_wrap = 0;
    if (dir < 0) {
        if (b->top > 0) b->top = rtx_layout_grid_prev_line(&b->doc, b->top) !>;
        return cc_ok();
    }
    if (dir > 0) {
        size_t nxt = rtx_layout_grid_next_line(&b->doc, b->top) !>;
        /* top==0 fill skips the header record, so the first body row is
         * already on screen. One next_line lands on that same row as a
         * camera start (visually a no-op). Step again. */
        if (b->top == 0 && nxt != b->top)
            nxt = rtx_layout_grid_next_line(&b->doc, nxt) !>;
        b->top = nxt;
    }
    return cc_ok();
}

void !>(CCError) RtxBuf_scroll_vis(RtxBuf *b, const RtxMeasure *m, double width, int dir) {
    size_t nlines;
    size_t n;
    size_t rows;
    @errhandler(CCError e) {
        return cc_err(e);
    }
    @errhandler(RtxIndexErr ie) {
        return cc_err(CC_ERR_IO, ie.message ? ie.message : "line index");
    }
    if (!b) return cc_err(CC_ERR_INVALID_ARG, "scroll");
    b->pin_view = 1;
    if (rtx_layout_is_hex(&b->layout)) {
        n = b->len();
        rows = rtx_hex_row_count(n);
        b->top_byte = rtx_hex_align(b->top_byte);
        if (dir < 0) {
            if (b->top_byte >= (size_t)RTX_HEX_COLS) b->top_byte -= (size_t)RTX_HEX_COLS;
            else b->top_byte = 0;
        } else if (dir > 0) {
            size_t next = b->top_byte + (size_t)RTX_HEX_COLS;
            size_t last_top = rows > 1 ? (rows - 1) * (size_t)RTX_HEX_COLS : 0;
            if (next <= last_top) b->top_byte = next;
        }
        return cc_ok();
    }
    if (b->seek_valid) {
        size_t nlen = b->len();
        if (rtx_layout_is_grid(&b->layout)) {
            size_t lo = rtx_layout_grid_cam_lo(&b->doc, b->seek_off, NULL) !>;
            if (dir < 0) {
                if (lo > 0)
                    lo = rtx_layout_grid_cam_lo(&b->doc, lo - 1, NULL) !>;
                rtx_buf_seek_set(b, lo);
            } else {
                size_t rec_n = rtx_layout_grid_rec_len(&b->doc, lo) !>;
                size_t next = rtx_layout_grid_after_rec(&b->doc, lo, rec_n);
                if (next < nlen) rtx_buf_seek_set(b, next);
            }
            b->top_wrap = 0;
            rtx_buf_fold_skip_cam(b, dir) !>;
            return cc_ok();
        }
        if (dir < 0) {
            if (b->seek_off > 0) {
                size_t floor = rtx_doc_line_floor(&b->doc, b->seek_off - 1) !>;
                rtx_buf_seek_set(b, floor);
            }
        } else if (b->seek_off < nlen) {
            size_t next;
            int has = rtx_doc_next_line_start(&b->doc, b->seek_off, &next) !>;
            if (has) rtx_buf_seek_set(b, next);
        }
        b->top_wrap = 0;
        rtx_buf_fold_skip_cam(b, dir) !>;
        return cc_ok();
    }
    nlines = b->line_count();
    if (rtx_layout_is_grid(&b->layout)) {
        rtx_buf_grid_scroll(b, m, width, dir) !>;
        rtx_buf_fold_skip_cam(b, dir) !>;
        return cc_ok();
    }
    if (!b->layout.wrap) {
        b->top_wrap = 0;
        if (dir < 0 && b->top > 0) b->top--;
        if (dir > 0 && b->top + 1 < nlines) b->top++;
        rtx_buf_fold_skip_cam(b, dir) !>;
        return cc_ok();
    }
    if (dir < 0) {
        if (b->top_wrap > 0) b->top_wrap--;
        else if (b->top > 0) {
            RtxLayout tmp = {0} @destroy;
            size_t wraps;
            b->top--;
            tmp.wrap = 1;
            tmp.lines(&b->doc, m, width, b->top, 1) !>;
            wraps = tmp.rows.len ? tmp.rows.len : 1;
            b->top_wrap = wraps - 1;
        }
    } else {
        size_t wraps = b->layout.rows_for_line(b->top);
        if (wraps == 0) wraps = 1;
        b->top_wrap++;
        if (b->top_wrap >= wraps) {
            if (b->top + 1 < nlines) {
                b->top++;
                b->top_wrap = 0;
            } else {
                b->top_wrap = wraps - 1;
            }
        }
    }
    rtx_buf_fold_skip_cam(b, dir) !>;
    return cc_ok();
}

static int rtx_buf_uses_left(const RtxBuf *b) {
    return b && rtx_layout_uses_left(&b->layout);
}

static size_t rtx_buf_row_max_w(const RtxBuf *b) {
    size_t i, mx = 0;
    if (!b) return 0;
    for (i = 0; i < b->layout.rows.len; i++) {
        size_t w = (size_t)b->layout.rows.data[i].width;
        if (w > mx) mx = w;
    }
    return mx;
}

static void rtx_buf_clamp_left(RtxBuf *b, double width) {
    size_t vis, mx;
    if (!b || width < 1.0) return;
    vis = (size_t)width;
    mx = rtx_buf_row_max_w(b);
    if (mx <= vis) {
        if (mx) b->left_col = 0;
        return;
    }
    if (b->left_col > mx - vis) b->left_col = mx - vis;
}

void !>(CCError) RtxBuf_scroll_x(RtxBuf *b, double width, int dir) {
    size_t step;
    if (!b) return cc_err(CC_ERR_INVALID_ARG, "scroll x");
    if (!rtx_buf_uses_left(b)) return cc_ok();
    b->pin_view = 1;
    if (width < 4.0) width = 4.0;
    /* Cell panes are tens of columns; pixel panes are hundreds of units.
     * width/4 was a quarter-page jump on the GUI (one wheel notch). */
    if (width > 160.0) {
        step = (size_t)(width / 24.0);
        if (step < 16) step = 16;
        if (step > 40) step = 40;
    } else {
        step = 4;
    }
    if (dir < 0) {
        if (b->left_col > step) b->left_col -= step;
        else b->left_col = 0;
    } else if (dir > 0) {
        b->left_col += step;
    }
    rtx_buf_clamp_left(b, width);
    return cc_ok();
}

static size_t rtx_buf_content_w(const RtxBuf *b) {
    size_t mx = rtx_buf_row_max_w(b);
    if (b && b->left_col + 1 > mx) mx = b->left_col + 1;
    return mx;
}

int RtxBuf_scroll_x_needed(const RtxBuf *b, double width) {
    size_t vis, cw;
    if (!rtx_buf_uses_left(b) || width < 1.0) return 0;
    if (b->left_col > 0 || (b->drag_horiz && b->drag_len)) return 1;
    vis = (size_t)width;
    cw = rtx_buf_content_w(b);
    return cw > vis;
}

RtxScrollRail RtxBuf_scroll_x_rail(const RtxBuf *b, double width) {
    RtxScrollRail r = {0};
    size_t vis, len;
    if (!b || width < 1.0) return r;
    vis = (size_t)width;
    if (vis < 1) vis = 1;
    len = rtx_buf_content_w(b);
    if (len < vis) len = vis;
    if (b->left_col + vis > len) len = b->left_col + vis;
    r.pos = b->left_col;
    r.vis = vis;
    r.len = len;
    r.ready = 1;
    return r;
}

void !>(CCError) RtxBuf_scroll_x_to(RtxBuf *b, double width, size_t pos) {
    RtxScrollRail r;
    if (!b) return cc_err(CC_ERR_INVALID_ARG, "scroll x");
    if (!rtx_buf_uses_left(b)) return cc_ok();
    b->pin_view = 1;
    r = RtxBuf_scroll_x_rail(b, width);
    if (r.vis >= r.len) {
        b->left_col = 0;
        return cc_ok();
    }
    if (pos > r.len - r.vis) pos = r.len - r.vis;
    b->left_col = pos;
    return cc_ok();
}

static void rtx_buf_reveal_x(RtxBuf *b, RtxMeasure *m, double width) {
    double x;
    if (!b) return;
    if (!rtx_buf_uses_left(b)) {
        b->left_col = 0;
        return;
    }
    if (width < 1.0) width = 1.0;
    if (!m || b->layout.rows.len == 0) return;
    {
        @errhandler(CCError e) {
            (void)e;
            return;
        }
        x = b->layout.x_of(&b->doc, m, b->doc.caret) !>;
    }
    if (x < (double)b->left_col) {
        b->left_col = (size_t)x;
    } else if (x >= (double)b->left_col + width) {
        double n = x - width + 1.0;
        b->left_col = n > 0 ? (size_t)n : 0;
    }
}

/* 1 if the filled window already starts at the seeking camera. Grid may
 * snap fill_off to the record that contains seek_off, so first.byte
 * need not equal seek_off. A later record still in the window is not
 * the camera — refill or reline-only leaves the cells stuck. */
int rtx_buf_seek_cam_row(const RtxBuf *b) {
    size_t first, rec0, recn;
    if (!b || !b->layout.rows.len) return 0;
    first = b->layout.rows.data[0].byte_start;
    if (!rtx_layout_is_grid(&b->layout))
        return first == b->seek_off;
    if (b->layout.grid_hdr_on && b->layout.grid_hdr_end &&
        b->seek_off < b->layout.grid_hdr_end)
        return 1;
    if (!rtx_layout_grid_rec_in(&b->layout, first, &rec0, &recn))
        return first == b->seek_off;
    return b->seek_off >= rec0 && b->seek_off < rec0 + recn;
}

void !>(CCError) RtxBuf_ensure_view(RtxBuf *b, RtxMeasure *m, double width, int vis) {
    size_t nlines;
    size_t want;
    size_t avail;
    size_t need;
    size_t n;
    size_t rows;
    @errhandler(CCError e) {
        return cc_err(e);
    }
    @errhandler(RtxIndexErr ie) {
        return cc_err(CC_ERR_IO, ie.message ? ie.message : "line index");
    }
    if (!b) return cc_err(CC_ERR_INVALID_ARG, "null buf");
    if (vis < 1) vis = 1;
    /* Rich: the mark under the caret / anchor shows its hints. A changed
     * reveal span changes row widths, so it invalidates the fill (one
     * compare when the pane is Source or the doc has no marks). */
    if (rtx_layout_reveal(&b->layout, &b->doc, b->doc.caret, b->doc.sel_anchor) &&
        b->layout.rows.len)
        b->layout.clear_rows();
    if (rtx_layout_is_hex(&b->layout)) {
        n = b->len();
        rows = rtx_hex_row_count(n);
        b->top_byte = rtx_hex_align(b->top_byte);
        if (rows > 0) {
            size_t last_top = (rows - 1) * (size_t)RTX_HEX_COLS;
            if (b->top_byte > last_top) b->top_byte = last_top;
        } else {
            b->top_byte = 0;
        }
        (void)m;
        (void)width;
        b->left_col = 0;
        return cc_ok();
    }
    /* g L dest camera: keep top / gutter. Do not line_start the dest. */
    if (rtx_line_want_pumping(&b->doc.tree)) {
        if (b->layout.rows.len) b->layout.clear_rows();
        b->layout_width = width;
        return cc_ok();
    }
    if (b->seek_valid) {
        size_t want = (size_t)vis + 8 + b->top_wrap;
        if (!b->drag_len && !b->doc.index_covers(b->seek_off) &&
            !rtx_line_isle_live(&b->doc.tree) &&
            !rtx_line_mark_ok(&b->doc.tree))
            rtx_line_isle_kick(&b->doc.tree, b->seek_off);
        rtx_line_pin_from_isle(&b->doc.tree);
        rtx_line_pins_from_prefix(&b->doc.tree);
        if (rtx_line_origin_from_pin(&b->doc.tree, b->seek_off) &&
            rtx_line_mark_ok(&b->doc.tree))
            b->seek_rel = rtx_doc_lf_delta_local(&b->doc, b->doc.tree.mark_off,
                                                b->seek_off);
        {
            int filled = 0;
            if (b->layout_width != width || b->layout.rows.len == 0 ||
                b->layout.rows.len < (size_t)vis || !rtx_buf_seek_cam_row(b)) {
                b->layout.fill_off(&b->doc, m, width, b->seek_off, want) !>;
                b->layout_width = width;
                filled = 1;
            }
            rtx_buf_seek_label(b) !>;
            if (b->seek_valid) {
                if (filled && rtx_line_mark_ok(&b->doc.tree) && b->layout.rows.len)
                    rtx_layout_reline(&b->layout, rtx_isle_cam_line(b));
                if (!b->unlock && !b->pin_view) rtx_buf_reveal_x(b, m, width);
                return cc_ok();
            }
        }
    }
    nlines = b->line_count();
    if (b->top >= nlines && nlines) b->top = nlines - 1;
    want = (size_t)vis + 8;
    /* Tall MD wrap rows consume multiple screen slots; fill extra vis rows. */
    if (rtx_layout_soft_wrap(&b->layout) && b->layout.rich)
        want = (size_t)vis * 3 + 8;
    avail = (b->top < nlines) ? (nlines - b->top) : 0;
    need = want < avail ? want : avail;
    if (b->layout_width != width || b->layout.from_line != b->top ||
        b->layout.rows.len == 0 || b->layout.nlines < need ||
        (rtx_layout_soft_wrap(&b->layout) &&
         b->layout.rows.len < want + b->top_wrap)) {
        size_t min_rows = want + b->top_wrap;
        b->layout.fill(&b->doc, m, width, b->top, min_rows) !>;
        b->layout_width = width;
    }
    if (!b->unlock && !b->pin_view) rtx_buf_reveal_x(b, m, width);
    else if (!rtx_buf_uses_left(b)) b->left_col = 0;
    return cc_ok();
}

static void !>(CCError) rtx_buf_refresh_view(RtxBuf *b, RtxMeasure *m, double width, int vis,
                                            int edited, int patched) {
    if (!b) return cc_err(CC_ERR_INVALID_ARG, "null buf");
    if (edited) {
        b->clear_pref();
        b->pin_view = 0;
    }
    /* Unlabeled seek stays a seek. line_of in ensure_view is the handoff.
     * A patched camera already holds the new rows (exact, see layout.cch);
     * ensure_view still refills if the camera moved or came up short. */
    if (!patched && !rtx_layout_is_hex(&b->layout)) {
        b->layout.clear_rows();
        b->layout_width = 0;
    }
    if (patched && b->seek_valid && b->layout.rows.len) {
        /* A patched seeking camera labels its rows as a refill would:
         * fill_off's line_guess, then the keyed origin (ensure_view does
         * that step only after its own fill). */
        rtx_layout_reline(&b->layout, b->doc.line_guess(b->seek_off));
        RtxBuf_ensure_view(b, m, width, vis) !>(e) { return cc_err(e); };
        if (b->seek_valid && rtx_line_mark_ok(&b->doc.tree) && b->layout.rows.len)
            rtx_layout_reline(&b->layout, rtx_isle_cam_line(b));
        return cc_ok();
    }
    return RtxBuf_ensure_view(b, m, width, vis);
}

/* Patch the camera at this width — lined, or seeking over whole lines
 * (fill_off); hex and a width change refill (the layout patch declines
 * the rest). */
static void !>(CCError) rtx_buf_patch_plan(RtxBuf *b, double width, RtxLayoutPatch *p,
                                          CCArena a) {
    *p = (RtxLayoutPatch){0};
    if (!b || b->layout_width != width ||
        rtx_layout_is_hex(&b->layout) || !a.base)
        return cc_ok();
    return rtx_layout_patch_plan(&b->layout, &b->doc, p, a);
}

void !>(CCError) RtxBuf_after_edit(RtxBuf *b, RtxMeasure *m, double width, int vis) {
    RtxLayoutPatch plan;
    CCArena a;
    if (!b) return cc_err(CC_ERR_INVALID_ARG, "null buf");
    a = cc_arena_heap(kilobytes(64));
    rtx_buf_patch_plan(b, width, &plan, a) !>(e) {
        if (a.base) a.destroy();
        return cc_err(e);
    };
    b->doc.reparse_edit(b->doc.last_off, b->doc.last_markup) !>(e) {
        if (a.base) a.destroy();
        return cc_err(e);
    };
    rtx_layout_patch(&b->layout, &b->doc, m, width, &plan, a) !>(e) {
        if (a.base) a.destroy();
        b->doc.span_reset();
        return cc_err(e);
    };
    if (a.base) a.destroy();
    b->doc.span_reset();
    return rtx_buf_refresh_view(b, m, width, vis, 1, plan.ok);
}

/* Text width / rows of pane p for a refresh: the focused pane's come
 * from the caller; others from RtxWs_pane_geom, else the legacy pair
 * (first pane width0, the rest width1). */
static double rtx_ws_pane_width(const RtxWs *w, int p, int k, double width0,
                                double width1) {
    if (p == w->focus) return width0;
    if (w->pane_w[p] > 0) return w->pane_w[p];
    return k == 0 ? width0 : width1;
}

static int rtx_ws_pane_vis(const RtxWs *w, int p, int vis) {
    if (p == w->focus) return vis;
    return w->pane_vis[p] > 0 ? w->pane_vis[p] : vis;
}

/* Same file in several panes: one reparse, every camera on the buf
 * patched or refilled (DESIGN Edits). Plans come before the reparse: they
 * snapshot the runs each camera's rows were laid out with. */
void !>(CCError) RtxWs_after_edit(RtxWs *w, int bufi, RtxMeasure *m,
                                        double width0, double width1, int vis) {
    int k;
    int parsed = 0;
    RtxLayoutPatch plan[RTX_PANES_MAX];
    CCArena a;
    RtxBuf *b;
    if (!w || !m || bufi < 0 || (size_t)bufi >= w->len)
        return cc_err(CC_ERR_INVALID_ARG, "ws after edit");
    RtxWs_panes_fix(w);
    b = w->bufs[bufi];
    a = cc_arena_heap(kilobytes(64));
    for (k = 0; k < RTX_PANES_MAX; k++) plan[k] = (RtxLayoutPatch){0};
    for (k = 0; k < w->npanes; k++) {
        int held, p = w->order[k];
        double width;
        if (w->pane[p] != bufi) continue;
        held = RtxWs_hold_pane(w, p);
        width = rtx_ws_pane_width(w, p, k, width0, width1);
        rtx_buf_patch_plan(b, width, &plan[p], a) !>(e) {
            RtxWs_drop_pane(w, p, held);
            if (a.base) a.destroy();
            return cc_err(e);
        };
        RtxWs_drop_pane(w, p, held);
    }
    for (k = 0; k < w->npanes; k++) {
        int held, p = w->order[k];
        double width;
        if (w->pane[p] != bufi) continue;
        held = RtxWs_hold_pane(w, p);
        if (!parsed) {
            b->doc.reparse_edit(b->doc.last_off, b->doc.last_markup) !>(e) {
                RtxWs_drop_pane(w, p, held);
                if (a.base) a.destroy();
                return cc_err(e);
            };
            parsed = 1;
        }
        width = rtx_ws_pane_width(w, p, k, width0, width1);
        rtx_layout_patch(&b->layout, &b->doc, m, width, &plan[p], a) !>(e) {
            RtxWs_drop_pane(w, p, held);
            if (a.base) a.destroy();
            b->doc.span_reset();
            return cc_err(e);
        };
        rtx_buf_refresh_view(b, m, width, rtx_ws_pane_vis(w, p, vis), p == w->focus,
                             plan[p].ok) !>(e) {
            RtxWs_drop_pane(w, p, held);
            if (a.base) a.destroy();
            b->doc.span_reset();
            return cc_err(e);
        };
        RtxWs_drop_pane(w, p, held);
    }
    if (a.base) a.destroy();
    if (parsed) b->doc.span_reset();
    return cc_ok();
}

void RtxWs_invalidate_buf_views(RtxWs *w, int bufi) {
    int k;
    if (!w || bufi < 0 || (size_t)bufi >= w->len) return;
    RtxWs_panes_fix(w);
    for (k = 0; k < w->npanes; k++) {
        RtxBuf *b;
        int held, p = w->order[k];
        if (w->pane[p] != bufi) continue;
        held = RtxWs_hold_pane(w, p);
        b = w->bufs[bufi];
        b->layout.clear_rows();
        b->layout_width = 0;
        RtxWs_drop_pane(w, p, held);
    }
}

/* --- workspace transactions (DESIGN Edit groups) --- */

static const RtxWsXact *rtx_ws_xact_find(const RtxWs *w, uint64_t id) {
    size_t i;
    if (!w || !id) return NULL;
    for (i = w->xact_n; i-- > 0;) {
        if (w->xacts[i].id == id) return &w->xacts[i];
    }
    return NULL;
}

static void !>(CCError) rtx_ws_xact_reserve(RtxWs *w) {
    size_t c;
    void *p;
    if (!w || !RtxWs_ensure(w)) return cc_err(CC_ERR_OUT_OF_MEMORY, "xact");
    if (w->xact_n < w->xact_cap) return cc_ok();
    c = w->xact_cap ? w->xact_cap * 2 : 8;
    p = cc_arena_realloc(w->session, w->session, w->xacts,
                         w->xact_cap * sizeof(RtxWsXact), c * sizeof(RtxWsXact), 8);
    if (!p) return cc_err(CC_ERR_OUT_OF_MEMORY, "xact");
    w->xacts = (RtxWsXact *)p;
    w->xact_cap = c;
    return cc_ok();
}

static uint64_t rtx_ws_xact_next(RtxWs *w) {
    if (!w->xact_last) {
        struct timespec ts;
        clock_gettime(CLOCK_REALTIME, &ts);
        w->xact_last = ((uint64_t)ts.tv_sec << 20) ^ (uint64_t)ts.tv_nsec;
    }
    if (++w->xact_last == 0) w->xact_last = 1;
    return w->xact_last;
}

static int rtx_ws_bufi_ok(const RtxWs *w, int bufi) {
    return w && bufi >= 0 && (size_t)bufi < w->len && w->bufs[bufi];
}

uint64_t !>(CCError) RtxWs_replace_xact(RtxWs *w, const RtxWsEdits *m, size_t n) {
    uint64_t id;
    size_t i, j, done;
    RtxWsXact x = {0};
    if (!w || (n && !m)) return cc_err(CC_ERR_INVALID_ARG, "xact");
    if (n == 0) return cc_ok((uint64_t)0);
    if (n > RTX_XACT_BUFS) return cc_err(CC_ERR_INVALID_ARG, "xact too many files");
    for (i = 0; i < n; i++) {
        if (!rtx_ws_bufi_ok(w, m[i].bufi)) return cc_err(CC_ERR_INVALID_ARG, "xact buf");
        if (w->bufs[m[i].bufi]->parked)
            return cc_err(CC_ERR_INVALID_ARG, "xact member parked");
        if (w->bufs[m[i].bufi]->doc.broken)
            return cc_err(CC_ERR_INTERNAL, "doc broken");
        for (j = 0; j < i; j++) {
            if (m[j].bufi == m[i].bufi) return cc_err(CC_ERR_INVALID_ARG, "xact buf twice");
        }
    }
    rtx_ws_xact_reserve(w) !>(e) { return cc_err(e); };
    id = rtx_ws_xact_next(w);
    x.id = id;
    for (done = 0; done < n; done++) {
        RtxDoc *d = &w->bufs[m[done].bufi]->doc;
        rtx_doc_replace_group(d, m[done].edits, m[done].n, id) !>(e) {
            /* All or nothing: undo the members that landed. */
            int k;
            for (k = x.nbuf; k-- > 0;) {
                RtxDoc *u = &w->bufs[x.bufs[k]]->doc;
                u->undo() !>(e2) {
                    (void)e2;
                    return cc_err(CC_ERR_INTERNAL, "xact rollback");
                };
                rtx_hist_cut_tail(u);
            }
            return cc_err(e);
        };
        if (RtxDoc_undo_xact(d) == id) x.bufs[x.nbuf++] = m[done].bufi;
    }
    if (!x.nbuf) return cc_ok((uint64_t)0);
    w->xacts[w->xact_n++] = x;
    return cc_ok(id);
}

int RtxWs_undo_scope(const RtxWs *w, int bufi) {
    const RtxWsXact *x;
    uint64_t id;
    int k, in = 0;
    if (!rtx_ws_bufi_ok(w, bufi) || w->bufs[bufi]->parked) return RTX_UNDO_ONE;
    id = RtxDoc_undo_xact(&w->bufs[bufi]->doc);
    x = rtx_ws_xact_find(w, id);
    if (!x) return RTX_UNDO_ONE;
    for (k = 0; k < x->nbuf; k++) {
        const RtxBuf *b = w->bufs[x->bufs[k]];
        if (x->bufs[k] == bufi) {
            in = 1;
            continue;
        }
        if (b->parked || RtxDoc_undo_xact(&b->doc) != id) return RTX_UNDO_ASK;
    }
    return in ? RTX_UNDO_ALL : RTX_UNDO_ONE;
}

/* 1 if a record below head carries `id` (undo has not passed it). */
static int rtx_ws_xact_below(const RtxDoc *d, uint64_t id) {
    size_t i;
    for (i = d->hist.head; i-- > 0;) {
        if (d->hist.recs[i].xact == id) return 1;
    }
    return 0;
}

static void !>(CCError) rtx_ws_member_refresh(RtxWs *w, int bufi) {
    RtxBuf *b = w->bufs[bufi];
    b->doc.reparse_edit(b->doc.last_off, b->doc.last_markup) !>(e) {
        return cc_err(e);
    };
    b->doc.span_reset();
    RtxWs_invalidate_buf_views(w, bufi);
    return cc_ok();
}

void !>(CCError) RtxWs_undo(RtxWs *w, int bufi, int scope) {
    const RtxWsXact *x;
    uint64_t id;
    int k;
    if (!rtx_ws_bufi_ok(w, bufi)) return cc_err(CC_ERR_INVALID_ARG, "undo buf");
    if (w->bufs[bufi]->parked) return cc_err(CC_ERR_INVALID_ARG, "undo parked");
    id = RtxDoc_undo_xact(&w->bufs[bufi]->doc);
    x = scope == RTX_UNDO_ALL ? rtx_ws_xact_find(w, id) : NULL;
    if (!x) return w->bufs[bufi]->doc.undo();
    for (k = 0; k < x->nbuf; k++) {
        if (w->bufs[x->bufs[k]]->parked)
            return cc_err(CC_ERR_INVALID_ARG, "transaction member parked");
    }
    for (k = 0; k < x->nbuf; k++) {
        RtxDoc *d = &w->bufs[x->bufs[k]]->doc;
        int moved = 0;
        while (rtx_ws_xact_below(d, id)) {
            d->undo() !>(e) { return cc_err(e); };
            moved = 1;
        }
        if (moved && x->bufs[k] != bufi) rtx_ws_member_refresh(w, x->bufs[k]) !>(e) {
            return cc_err(e);
        };
    }
    return cc_ok();
}

void !>(CCError) RtxWs_redo(RtxWs *w, int bufi) {
    const RtxWsXact *x;
    uint64_t id;
    int k;
    if (!rtx_ws_bufi_ok(w, bufi)) return cc_err(CC_ERR_INVALID_ARG, "redo buf");
    if (w->bufs[bufi]->parked) return cc_err(CC_ERR_INVALID_ARG, "redo parked");
    id = RtxDoc_redo_xact(&w->bufs[bufi]->doc);
    x = rtx_ws_xact_find(w, id);
    if (x) {
        for (k = 0; k < x->nbuf; k++) {
            const RtxBuf *b = w->bufs[x->bufs[k]];
            if (b->parked || RtxDoc_redo_xact(&b->doc) != id) {
                x = NULL;
                break;
            }
        }
    }
    if (!x) return w->bufs[bufi]->doc.redo();
    for (k = 0; k < x->nbuf; k++) {
        w->bufs[x->bufs[k]]->doc.redo() !>(e) { return cc_err(e); };
        if (x->bufs[k] != bufi) rtx_ws_member_refresh(w, x->bufs[k]) !>(e) {
            return cc_err(e);
        };
    }
    return cc_ok();
}

int RtxWs_any_dirty(const RtxWs *w) {
    size_t i;
    if (!w) return 0;
    for (i = 0; i < w->len; i++) {
        if (rtx_ws_buf_dirty(w->bufs[i])) return 1;
    }
    return 0;
}

int rtx_ws_close_heavy(const RtxWs *w) {
    size_t i;
    if (!w) return 0;
    for (i = 0; i < w->len; i++) {
        if (w->bufs[i]->parked) continue;
        if (w->bufs[i]->doc.tree.line_off_len >= ((size_t)1 << 20)) return 1;
    }
    return 0;
}

int RtxWs_nav_need_pump(const RtxBrowse *br) {
    const RtxBrowseEnt *e;
    if (!br || !br->on) return 0;
    if (rtx_browse_listing_live(br)) return 1;
    if (br->scanning || br->sizing) return 1;
    if (!br->ents.data || br->ents.len == 0 || br->cur >= br->ents.len) return 0;
    e = &br->ents.data[br->cur];
    return e->is_dir && strcmp(e->name, "..") != 0 && !e->sized;
}

void !>(CCError) RtxWs_browse_prev_pump(RtxWs *w);

void !>(CCError) RtxWs_browse_pump(RtxWs *w) {
    int p;
    if (!w) return cc_ok();
    for (p = 0; p < RTX_PANES_MAX; p++) {
        if (w->nav[p].on && RtxWs_nav_need_pump(&w->nav[p]))
            rtx_browse_pump(&w->nav[p]) !>(e) { return cc_err(e); };
    }
    RtxWs_browse_prev_pump(w) !>(e) { return cc_err(e); };
    return cc_ok();
}

void rtx_ws_scans_set(RtxWs *w, int pause) {
    size_t i;
    if (!w) return;
    if (pause) RtxWs_browse_pause(w);
    for (i = 0; i < w->len; i++) {
        RtxBuf *b = w->bufs[i];
        if (b->parked) continue;
        if (pause) {
            rtx_find_pause(&b->doc);
            rtx_line_isle_pause(&b->doc.tree);
        } else {
            rtx_line_isle_resume(&b->doc.tree);
            rtx_find_resume(&b->doc);
        }
    }
    if (!pause) RtxWs_browse_resume(w);
}

void RtxWs_browse_pause(RtxWs *w) {
    int p;
    if (!w) return;
    for (p = 0; p < RTX_PANES_MAX; p++) {
        if (w->nav[p].on)
            rtx_browse_pause(&w->nav[p]);
    }
}

void RtxWs_browse_resume(RtxWs *w) {
    int p;
    if (!w) return;
    for (p = 0; p < RTX_PANES_MAX; p++) {
        if (w->nav[p].on)
            rtx_browse_resume(&w->nav[p]);
    }
}

int RtxWs_browse_busy(const RtxWs *w) {
    int p;
    if (!w) return 0;
    for (p = 0; p < RTX_PANES_MAX; p++)
        if (w->nav[p].on && RtxWs_nav_need_pump(&w->nav[p])) return 1;
    return 0;
}

int RtxWs_browse_scanning(const RtxWs *w) {
    int p;
    if (!w) return 0;
    for (p = 0; p < RTX_PANES_MAX; p++) {
        if (!w->nav[p].on) continue;
        if (rtx_browse_listing_live(&w->nav[p])) return 1;
        if (w->nav[p].scanning) return 1;
    }
    return 0;
}

RtxBrowse *RtxWs_browse_at(RtxWs *w, int pane) {
    if (!w || pane < 0 || pane >= RTX_PANES_MAX) return NULL;
    return &w->nav[pane];
}

RtxBrowse *RtxWs_browse(RtxWs *w) {
    if (!w) return NULL;
    return &w->nav[w->focus];
}

int RtxWs_browsing(const RtxWs *w) {
    return w && w->nav[w->focus].on;
}

static int rtx_ws_find_path(const RtxWs *w, char[:0] path) {
    size_t i;
    if (!w || !path.ptr || path.len == 0) return -1;
    for (i = 0; i < w->len; i++) {
        const char *p = rtx_ws_buf_path(w->bufs[i]);
        char real[PATH_MAX];
        if (!p) continue;
        if (strcmp(p, path.ptr) == 0) return (int)i;
        if (realpath(path.ptr, real) && strcmp(p, real) == 0) return (int)i;
    }
    return -1;
}

void !>(CCError) RtxWs_open_in_pane(RtxWs *w, char[:0] path) {
    int pane, bufi, found;
    if (!w || !path.ptr || path.len == 0) return cc_err(CC_ERR_INVALID_ARG, "open path");
    RtxWs_panes_fix(w);
    pane = w->focus;
    /* Leave browse and drop any preview of this path before opening so
     * the buffer is not born beside a live from_path of the same file
     * (status / layout then walk a torn rows vec). */
    rtx_browse_drop(&w->nav[pane]);
    RtxWs_browse_prev_drop(w, pane);
    found = rtx_ws_find_path(w, path);
    if (found >= 0) bufi = found;
    else if (RtxWs_untitled(w)) {
        int p;
        if (w->bufs[0]->doc.dirty())
            return cc_err(CC_ERR_INVALID_ARG, "untitled dirty");
        /* Same struct, another document: no pane keeps a camera on it. */
        for (p = 0; p < RTX_PANES_MAX; p++)
            if (w->cam[p].of == w->bufs[0]) rtx_ws_cam_drop(&w->cam[p]);
        w->bufs[0]->destroy();
        *w->bufs[0] = (RtxBuf){0};
        w->len = 0;
        w->add_path(path) !>(e) { return cc_err(e); };
        bufi = 0;
    } else {
        w->add_path(path) !>(e) { return cc_err(e); };
        bufi = (int)w->len - 1;
    }
    w->pane[pane] = bufi;
    RtxWs_panes_fix(w);
    return w->sync_live();
}

static int rtx_link_is_url(const char *s) {
    if (!s || !s[0]) return 0;
    if (strncmp(s, "mailto:", 7) == 0) return 1;
    return strstr(s, "://") != NULL;
}

static void rtx_link_token(char *s) {
    char *p, *q;
    if (!s) return;
    p = s;
    while (*p == ' ' || *p == '\t' || *p == '\n' || *p == '\r') p++;
    if (p != s) memmove(s, p, strlen(p) + 1);
    q = s;
    while (*q && *q != ' ' && *q != '\t' && *q != '\n' && *q != '\r' &&
           *q != '"')
        q++;
    *q = 0;
}

void !>(CCError) RtxWs_follow_link(RtxWs *w, size_t off) {
    RtxBuf *b;
    size_t lo, hi, n, got;
    char buf[1024], full[PATH_MAX], dir[PATH_MAX];
    if (!w) return cc_err(CC_ERR_INVALID_ARG, "follow");
    b = RtxWs_active(w);
    if (!b) return cc_ok();
    if (!RtxDoc_link_target(&b->doc, off, &lo, &hi) || hi <= lo) return cc_ok();
    n = hi - lo;
    if (n >= sizeof(buf)) n = sizeof(buf) - 1;
    got = b->doc.read_at(lo, cc_slice_from_buffer(buf, n)) !>(e) { return cc_err(e); };
    buf[got < n ? got : n] = 0;
    rtx_link_token(buf);
    if (!buf[0]) return cc_ok();
    if (rtx_link_is_url(buf)) {
        if (!rtx_open_url(buf)) return cc_err(CC_ERR_INVALID_ARG, "open url");
        return cc_ok();
    }
    dir[0] = 0;
    if (b->doc.path.ptr && b->doc.path.len)
        rtx_browse_dirname(dir, sizeof(dir), cc_slice_cstr(b->doc.path.ptr));
    if (!dir[0]) snprintf(dir, sizeof(dir), ".");
    if (buf[0] == '/') {
        if (!rtx_browse_abs(full, sizeof(full), cc_slice_cstr(buf)))
            snprintf(full, sizeof(full), "%s", buf);
    } else if (!rtx_browse_join(full, sizeof(full), cc_slice_cstr(dir), cc_slice_cstr(buf))) {
        return cc_err(CC_ERR_INVALID_ARG, "follow path");
    }
    return RtxWs_open_in_pane(w, cc_slice_cstr(full));
}

void !>(CCError) RtxWs_browse_start(RtxWs *w) {
    RtxBrowse *br;
    RtxBuf *b;
    char want[RTX_BROWSE_NAME];
    if (!w) return cc_err(CC_ERR_INVALID_ARG, "null ws");
    br = &w->nav[w->focus];
    b = RtxWs_active(w);
    want[0] = 0;
    rtx_browse_drop(br);
    RtxWs_browse_prev_drop(w, w->focus);
    br->on = 1;
    br->boot = RtxWs_untitled(w);
    if (w->start_dir[0]) {
        if (!rtx_browse_abs(br->dir, sizeof(br->dir), cc_slice_cstr(w->start_dir)))
            snprintf(br->dir, sizeof(br->dir), "%s", w->start_dir);
    } else if (b && b->doc.path.ptr && b->doc.path.len) {
        char rel[RTX_BROWSE_DIR];
        rtx_browse_dirname(rel, sizeof(rel), cc_slice_cstr(b->doc.path.ptr));
        rtx_browse_basename(want, sizeof(want), cc_slice_cstr(b->doc.path.ptr));
        if (!rtx_browse_abs(br->dir, sizeof(br->dir), cc_slice_cstr(rel)))
            snprintf(br->dir, sizeof(br->dir), "%s", rel);
    }
    if (!br->dir[0] || strcmp(br->dir, ".") == 0) {
        if (!rtx_browse_abs(br->dir, sizeof(br->dir), "."))
            snprintf(br->dir, sizeof(br->dir), ".");
    }
    if (want[0]) rtx_browse_keep_set(br, cc_slice_cstr(want));
    return rtx_browse_kick(br);
}

int RtxWs_browse_close(RtxWs *w) {
    int quit = 0;
    if (!w) return 0;
    quit = w->nav[w->focus].boot && RtxWs_untitled(w);
    rtx_browse_drop(&w->nav[w->focus]);
    RtxWs_browse_prev_drop(w, w->focus);
    return quit;
}

void !>(CCError) RtxWs_browse_enter(RtxWs *w) {
    RtxBrowse *br;
    const RtxBrowseEnt *ent;
    const RtxBrowseEnt *ents;
    size_t len, cur;
    char full[RTX_BROWSE_DIR];
    if (!w) return cc_err(CC_ERR_INVALID_ARG, "null ws");
    br = &w->nav[w->focus];
    {
        RtxBrowsePub v = rtx_browse_view_snap(br);
        ents = v.ents;
        len = v.len;
        cur = v.cur;
    }
    if (!br->on || !ents || !len || cur >= len) return cc_ok();
    ent = &ents[cur];
    if (ent->sep) return cc_ok();
    if (!rtx_browse_join(full, sizeof(full), cc_slice_cstr(br->dir), cc_slice_cstr(ent->name)))
        return cc_err(CC_ERR_INVALID_ARG, "browse path");
    if (ent->is_dir) {
        if (!rtx_browse_abs(br->dir, sizeof(br->dir), cc_slice_cstr(full)))
            snprintf(br->dir, sizeof(br->dir), "%s", full);
        br->glob[0] = 0;
        br->glob_len = 0;
        br->glob_caret = 0;
        br->glob_sel = 0;
        return rtx_browse_kick(br);
    }
    return RtxWs_open_in_pane(w, cc_slice_cstr(full));
}

void !>(CCError) RtxWs_browse_parent(RtxWs *w) {
    RtxBrowse *br;
    char next[RTX_BROWSE_DIR];
    if (!w) return cc_err(CC_ERR_INVALID_ARG, "null ws");
    br = &w->nav[w->focus];
    if (!br->on) return cc_ok();
    if (!rtx_browse_join(next, sizeof(next), cc_slice_cstr(br->dir), "..")) return cc_ok();
    snprintf(br->dir, sizeof(br->dir), "%s", next);
    return rtx_browse_kick(br);
}

void !>(CCError) RtxWs_browse_glob_set(RtxWs *w, char[:0] glob) {
    RtxBrowse *br;
    if (!w) return cc_err(CC_ERR_INVALID_ARG, "null ws");
    br = &w->nav[w->focus];
    if (!br->on) return cc_ok();
    if (!glob.ptr) glob = "";
    snprintf(br->glob, sizeof(br->glob), "%s", glob.ptr);
    br->glob_len = strlen(br->glob);
    br->glob_caret = br->glob_len;
    br->glob_sel = br->glob_len;
    return rtx_browse_kick_keep(br);
}

RtxField rtx_browse_field(RtxBrowse *br) {
    RtxField f = {0};
    if (!br) return f;
    f.buf = br->glob;
    f.len = &br->glob_len;
    f.cap = sizeof(br->glob);
    f.caret = &br->glob_caret;
    f.sel = &br->glob_sel;
    return f;
}

void !>(CCError) RtxWs_browse_type(RtxWs *w, int ch) {
    RtxBrowse *br;
    if (!w) return cc_err(CC_ERR_INVALID_ARG, "null ws");
    br = &w->nav[w->focus];
    if (!br->on) return cc_ok();
    if (rtx_field_type_cp(rtx_browse_field(br), (uint32_t)ch))
        return rtx_browse_kick_keep(br);
    return cc_ok();
}

void !>(CCError) RtxWs_browse_backspace(RtxWs *w) {
    RtxBrowse *br;
    RtxField f;
    if (!w) return cc_err(CC_ERR_INVALID_ARG, "null ws");
    br = &w->nav[w->focus];
    if (!br->on) return cc_ok();
    f = rtx_browse_field(br);
    if (br->glob_len == 0 && !rtx_field_has_sel(f))
        return cc_ok();
    rtx_field_backspace(f);
    return rtx_browse_kick_keep(br);
}

void RtxWs_browse_prev_drop(RtxWs *w, int pane) {
    RtxBrowsePrev *p;
    int view;
    if (!w || pane < 0 || pane >= RTX_PANES_MAX) return;
    p = &w->prev[pane];
    view = p->layout.view;
    p->gen++;
    if (p->h.live()) {
        if (p->h.paused())
            p->h.resume() !>(e) { (void)e; };
        p->h.wait() !>(e) { (void)e; };
    }
    if (p->staging_live) {
        p->staging.destroy();
        p->staging_live = 0;
    }
    if (p->live) {
        p->layout.destroy();
        p->doc.destroy();
    } else if (p->layout.store.base) {
        p->layout.destroy();
    }
    *p = (RtxBrowsePrev){0};
    rtx_layout_set_view(&p->layout, view);
}

static void rtx_browse_prev_join(RtxBrowsePrev *p) {
    if (!p || !p->h.live()) return;
    if (p->h.paused())
        p->h.resume() !>(e) { (void)e; };
    p->h.wait() !>(e) { (void)e; };
}

static void rtx_browse_prev_staging_drop(RtxBrowsePrev *p) {
    if (!p) return;
    if (p->staging_live) {
        p->staging.destroy();
        p->staging_live = 0;
    }
    rtx_safe_cam_clear(&p->staging_cam);
    p->load_fail = 0;
    atomic_store_explicit(&p->load_done, 0, memory_order_release);
}

/* Drop the painted doc; keep view / warmed / want / gen / open arm. */
static void rtx_browse_prev_drop_doc(RtxBrowsePrev *p) {
    int view;
    if (!p || !p->live) {
        if (p && p->layout.store.base && !p->live) {
            view = p->layout.view;
            p->layout.destroy();
            rtx_layout_set_view(&p->layout, view);
        }
        return;
    }
    view = p->layout.view;
    p->layout.destroy();
    p->doc.destroy();
    p->live = 0;
    p->path[0] = 0;
    p->kind = RTX_BROWSE_PREV_EMPTY;
    p->fill_w = 0;
    p->fill_vis = 0;
    p->fill_view = -1;
    p->fill_char = 0;
    rtx_safe_cam_clear(&p->cam);
    rtx_layout_set_view(&p->layout, view);
}

void RtxWs_browse_prev_cycle(RtxWs *w, int pane) {
    RtxBrowsePrev *p;
    if (!w || pane < 0 || pane >= RTX_PANES_MAX) return;
    p = &w->prev[pane];
    rtx_layout_cycle_view(&p->layout);
    p->fill_view = -1;
}

void RtxWs_browse_prev_toggle_wrap(RtxWs *w, int pane) {
    RtxBrowsePrev *p;
    if (!w || pane < 0 || pane >= RTX_PANES_MAX) return;
    p = &w->prev[pane];
    if (!p->live) return;
    if (rtx_layout_is_hex(&p->layout) || rtx_layout_is_grid(&p->layout))
        return;
    p->layout.wrap = !p->layout.wrap;
    p->cam.left_col = 0;
    p->cam.top_wrap = 0;
    p->fill_view = -1;
}

static void !>(CCError) rtx_ws_prev_fill(RtxBrowsePrev *p, RtxMeasure *m,
                                        double width, int vis) {
    @errhandler(RtxIndexErr ie) {
        return cc_err(CC_ERR_IO, ie.message ? ie.message : "line index");
    }
    if (!p || !p->live) return cc_ok();
    if (vis < 1) vis = 1;
    {
        size_t want = (size_t)vis + p->cam.top_wrap;
        if (want < (size_t)vis) want = (size_t)vis;
        if (rtx_layout_is_hex(&p->layout)) {
            p->fill_w = width;
            p->fill_vis = vis;
            p->fill_view = p->layout.view;
            return cc_ok();
        }
        if (p->fill_w == width && p->fill_vis == vis &&
            p->fill_view == p->layout.view &&
            p->fill_char == p->layout.wrap_char &&
            p->layout.rows.len >= want)
            return cc_ok();
        if (!m) return cc_ok();
        {
            size_t from = 0;
            if (p->cam.seek_valid) from = p->cam.seek_off;
            else if (p->cam.top_byte) from = p->cam.top_byte;
            else from = p->doc.caret;
            if (!rtx_layout_is_grid(&p->layout))
                from = rtx_doc_line_floor(&p->doc, from) !>;
            p->layout.fill_off(&p->doc, m, width, from, want) !>(e) {
                return cc_err(e);
            };
        }
    }
    p->fill_w = width;
    p->fill_vis = vis;
    p->fill_view = p->layout.view;
    p->fill_char = p->layout.wrap_char;
    return cc_ok();
}

/* Worker: open into staging only. Host adopts on pump / flush. */
static void rtx_browse_prev_run(RtxBrowsePrev *p, uint64_t gen) {
    RtxSafeCam cam;
    if (!p || !p->want[0]) {
        if (p) {
            p->load_fail = 1;
            atomic_store_explicit(&p->load_done, 1, memory_order_release);
        }
        return;
    }
    rtx_safe_cam_clear(&cam);
    rtx_ws_doc_open(NULL, &p->staging, p->want, &cam, NULL) !>(e) {
        (void)e;
        if (p->gen == gen) {
            p->load_fail = 1;
            atomic_store_explicit(&p->load_done, 1, memory_order_release);
        }
        return;
    };
    if (p->gen != gen) {
        p->staging.destroy();
        return;
    }
    p->staging_cam = cam;
    p->staging_live = 1;
    p->load_fail = 0;
    atomic_store_explicit(&p->load_done, 1, memory_order_release);
}

static void !>(CCError) rtx_browse_prev_kick(RtxBrowsePrev *p) {
    int noop = 0;
    RtxBrowsePrev *scan;
    uint64_t gen;
    if (!p || !p->want[0]) return cc_ok();
    if (p->h.live()) return cc_ok();
    rtx_browse_prev_staging_drop(p);
    gen = p->gen;
    scan = p;
    atomic_store_explicit(&p->load_done, 0, memory_order_release);
    p->load_fail = 0;
    if (rtx_parallel_inline()) {
        rtx_browse_prev_run(p, gen);
        return cc_ok();
    }
    p->h = @parallel {
        @serial { noop = 0; }
        rtx_browse_prev_run(scan, gen);
    } !>;
    return cc_ok();
}

static void rtx_browse_prev_cancel(RtxBrowsePrev *p) {
    if (!p) return;
    p->gen++;
    rtx_browse_prev_join(p);
    rtx_browse_prev_staging_drop(p);
}

/* Move staging → painted doc when the arm finished for the current want.
 * Returns 1 when the painted preview changed (host should dirty). */
static int rtx_browse_prev_adopt(RtxBrowsePrev *p) {
    int view;
    if (!p) return 0;
    rtx_browse_prev_join(p);
    if (!atomic_load_explicit(&p->load_done, memory_order_acquire)) return 0;
    if (!p->want[0]) {
        rtx_browse_prev_staging_drop(p);
        return 0;
    }
    view = p->layout.view;
    if (p->load_fail || !p->staging_live) {
        if (p->live) {
            p->layout.destroy();
            p->doc.destroy();
            p->live = 0;
        }
        snprintf(p->path, sizeof(p->path), "%s", p->want);
        p->kind = RTX_BROWSE_PREV_FAIL;
        rtx_browse_prev_staging_drop(p);
        rtx_layout_set_view(&p->layout, view);
        p->ready_seq++;
        return 1;
    }
    if (p->live) {
        p->layout.destroy();
        p->doc.destroy();
    } else if (p->layout.store.base) {
        p->layout.destroy();
    }
    p->doc = p->staging;
    p->staging = (RtxDoc){0};
    p->staging_live = 0;
    p->cam = p->staging_cam;
    rtx_safe_cam_clear(&p->staging_cam);
    snprintf(p->path, sizeof(p->path), "%s", p->want);
    p->want[0] = 0;
    rtx_layout_set_view(&p->layout, p->cam.view ? p->cam.view : view);
    p->layout.rich = p->cam.rich;
    p->layout.wrap = p->cam.wrap;
    p->layout.wrap_char = 1;
    p->live = 1;
    p->kind = RTX_BROWSE_PREV_FILE;
    p->warmed = 1;
    p->fill_view = -1;
    atomic_store_explicit(&p->load_done, 0, memory_order_release);
    p->load_fail = 0;
    p->ready_seq++;
    return 1;
}

int RtxWs_browse_prev_busy(const RtxWs *w) {
    int p;
    if (!w) return 0;
    for (p = 0; p < RTX_PANES_MAX; p++) {
        if (w->prev[p].h.live()) return 1;
        if (atomic_load_explicit(&w->prev[p].load_done, memory_order_acquire) &&
            w->prev[p].want[0])
            return 1;
    }
    return 0;
}

unsigned RtxWs_browse_prev_ready_seq(const RtxWs *w) {
    unsigned s = 0;
    int p;
    if (!w) return 0;
    for (p = 0; p < RTX_PANES_MAX; p++) s += w->prev[p].ready_seq;
    return s;
}

void !>(CCError) RtxWs_browse_prev_pump(RtxWs *w) {
    int p;
    if (!w) return cc_ok();
    for (p = 0; p < RTX_PANES_MAX; p++) {
        RtxBrowsePrev *pv = &w->prev[p];
        if (!atomic_load_explicit(&pv->load_done, memory_order_acquire))
            continue;
        rtx_browse_prev_adopt(pv);
    }
    return cc_ok();
}

void !>(CCError) RtxWs_browse_prev_flush(RtxWs *w, int pane) {
    RtxBrowsePrev *p;
    if (!w || pane < 0 || pane >= RTX_PANES_MAX)
        return cc_err(CC_ERR_INVALID_ARG, "browse preview flush");
    p = &w->prev[pane];
    if (p->want[0] && !p->h.live() &&
        !atomic_load_explicit(&p->load_done, memory_order_acquire))
        rtx_browse_prev_kick(p) !>(e) { return cc_err(e); };
    rtx_browse_prev_join(p);
    rtx_browse_prev_adopt(p);
    return cc_ok();
}

void !>(CCError) RtxWs_browse_prev_sync(RtxWs *w, int pane, RtxMeasure *m,
                                        double width, int vis) {
    RtxBrowse *br;
    RtxBrowsePrev *p;
    char path[RTX_BROWSE_DIR];
    int is_dir = 0;
    int have;
    if (!w || pane < 0 || pane >= RTX_PANES_MAX)
        return cc_err(CC_ERR_INVALID_ARG, "browse preview");
    br = &w->nav[pane];
    p = &w->prev[pane];
    if (!br->on) {
        RtxWs_browse_prev_drop(w, pane);
        return cc_ok();
    }
    have = rtx_browse_sel_path(br, path, sizeof(path), &is_dir);
    if (!have) {
        if (p->live || p->kind != RTX_BROWSE_PREV_EMPTY || p->want[0] ||
            p->h.live())
            RtxWs_browse_prev_drop(w, pane);
        p->kind = RTX_BROWSE_PREV_EMPTY;
        return cc_ok();
    }
    if (is_dir) {
        if (p->live || p->kind != RTX_BROWSE_PREV_DIR ||
            strcmp(p->path, path) != 0 || p->want[0] || p->h.live()) {
            int warmed = p->warmed;
            RtxWs_browse_prev_drop(w, pane);
            p->warmed = warmed;
            snprintf(p->path, sizeof(p->path), "%s", path);
            p->kind = RTX_BROWSE_PREV_DIR;
        }
        return cc_ok();
    }
    if (atomic_load_explicit(&p->load_done, memory_order_acquire))
        rtx_browse_prev_adopt(p);
    if (p->live && p->kind == RTX_BROWSE_PREV_FILE &&
        strcmp(p->path, path) == 0) {
        p->want[0] = 0;
        p->layout.wrap_char = 1;
        return rtx_ws_prev_fill(p, m, width, vis);
    }
    /* New selection: cancel any in-flight open and kick off-main. Keep
     * a live file painted until adopt so navigate does not flash empty. */
    if (strcmp(p->want, path) != 0 ||
        (!p->h.live() && !p->live &&
         !atomic_load_explicit(&p->load_done, memory_order_acquire))) {
        if (p->h.live() || p->want[0]) rtx_browse_prev_cancel(p);
        else p->gen++;
        snprintf(p->want, sizeof(p->want), "%s", path);
        if (!(p->live && p->kind == RTX_BROWSE_PREV_FILE)) {
            p->path[0] = 0;
            p->kind = RTX_BROWSE_PREV_EMPTY;
        }
        rtx_browse_prev_kick(p) !>(e) { return cc_err(e); };
    } else if (!p->h.live() && p->want[0] &&
               !atomic_load_explicit(&p->load_done, memory_order_acquire)) {
        rtx_browse_prev_kick(p) !>(e) { return cc_err(e); };
    }
    if (atomic_load_explicit(&p->load_done, memory_order_acquire)) {
        rtx_browse_prev_adopt(p);
        if (p->live) {
            p->layout.wrap_char = 1;
            return rtx_ws_prev_fill(p, m, width, vis);
        }
    }
    /* Still opening: redraw the previous file if we kept it. */
    if (p->live && p->kind == RTX_BROWSE_PREV_FILE) {
        p->layout.wrap_char = 1;
        return rtx_ws_prev_fill(p, m, width, vis);
    }
    return cc_ok();
}


/* ui_types.cch bodies (this TU owns the face). */

long rtx_ui_now_ms(void) {
    struct timespec ts;
    clock_gettime(CLOCK_MONOTONIC, &ts);
    return (long)ts.tv_sec * 1000 + ts.tv_nsec / 1000000;
}

int rtx_click_count(RtxClickSeq *s, long now, size_t off) {
    if (!s) return 1;
    if (s->n > 0 && now - s->at_ms <= (long)RTX_CLICK_MS && s->off == off) {
        if (s->n < 3) s->n++;
        else s->n = 1;
    } else {
        s->n = 1;
        s->off = off;
    }
    s->at_ms = now;
    return s->n;
}

void rtx_ui_blink_show(RtxUi *ui) {
    long now;
    if (!ui) return;
    ui->blink = 1;
    if (ui->no_blink) {
        ui->blink_at = 0;
        return;
    }
    now = rtx_ui_now_ms();
    ui->blink_at = now;
    ui->input_at = now;
}

static long rtx_ui_blink_idle(const RtxUi *ui) {
    return ui->blink_idle_ms ? ui->blink_idle_ms : (long)RTX_UI_BLINK_IDLE_MS;
}

int rtx_ui_blink_live(const RtxUi *ui, long now) {
    long idle;
    if (!ui || ui->no_blink || ui->unfocused) return 0;
    if (ui->blink_at == 0 || ui->input_at == 0) return 1; /* not started */
    idle = rtx_ui_blink_idle(ui);
    return idle < 0 || now - ui->input_at < idle;
}

int rtx_ui_blink_step(RtxUi *ui) {
    long now;
    if (!ui || ui->no_blink || ui->host_blinks) return 0;
    now = rtx_ui_now_ms();
    if (ui->blink_at == 0) {
        ui->blink = 1;
        ui->blink_at = now;
        if (!ui->input_at) ui->input_at = now; /* launch counts as input */
        return 0;
    }
    if (!rtx_ui_blink_live(ui, now)) {
        /* Settle visible. Idle stops on the phase boundary, so a caret that
         * is on stays on without a paint. */
        if (ui->blink) return 0;
        if (!ui->unfocused && now - ui->blink_at < RTX_UI_BLINK_MS) return 0;
        ui->blink = 1;
        ui->blink_at = now;
        return 1;
    }
    if (now - ui->blink_at >= RTX_UI_BLINK_MS) {
        ui->blink = !ui->blink;
        ui->blink_at = now;
        return 1;
    }
    return 0;
}

long rtx_ui_blink_next_ms(const RtxUi *ui, long now) {
    long left;
    if (!ui || ui->no_blink || ui->host_blinks) return -1;
    if (ui->blink_at == 0) return 0;
    if (!rtx_ui_blink_live(ui, now)) {
        if (ui->blink) return -1;
        if (ui->unfocused) return 0;
    }
    left = (long)RTX_UI_BLINK_MS - (now - ui->blink_at);
    return left > 0 ? left : 0;
}

int rtx_ui_blink_focus(RtxUi *ui, int in) {
    int was;
    if (!ui) return 0;
    was = rtx_ui_blink(ui);
    if (in) {
        ui->unfocused = 0;
        rtx_ui_blink_show(ui);
    } else {
        ui->unfocused = 1;
        ui->blink = 1;
    }
    return was != rtx_ui_blink(ui);
}

long rtx_ui_blink_idle_env(void) {
    const char *s = getenv("RTX_BLINK_IDLE_MS");
    if (!s || !s[0]) return 0;
    return strtol(s, NULL, 10);
}

int rtx_ui_blink(const RtxUi *ui) {
    if (!ui || ui->no_blink || ui->host_blinks || ui->blink_at == 0 ||
        ui->unfocused)
        return 1;
    return ui->blink;
}

int rtx_ui_prompting(const RtxUi *ui) {
    return ui && (ui->find || ui->jump || ui->palette || ui->pick);
}

int rtx_ui_here(const RtxUi *ui, int focused, int at) {
    if (ui && ui->caret_host) return 0;
    return focused && at && !rtx_ui_prompting(ui) && rtx_ui_blink(ui);
}

int rtx_ui_caret_at(const RtxUi *ui, int focused, int at) {
    return focused && at && !rtx_ui_prompting(ui);
}

int rtx_gutter_cols(size_t nlines) {
    int w = 1;
    if (nlines == 0) nlines = 1;
    while (nlines >= 10) {
        nlines /= 10;
        w++;
    }
    return w + 1;
}

size_t rtx_isle_cam_line(const RtxBuf *b) {
    long n;
    if (!b || !rtx_line_mark_ok(&b->doc.tree)) return 0;
    n = (long)b->doc.tree.mark_line + (b->seek_valid ? b->seek_rel : 0);
    if (n < 0) n = 0;
    return (size_t)n;
}

size_t rtx_gutter_win(const RtxBuf *b, size_t row_line) {
    size_t base;
    if (!b) return 0;
    if (b->layout.rows.len) base = b->layout.rows.data[0].line;
    else base = b->layout.from_line;
    return row_line >= base ? row_line - base : 0;
}

int rtx_gutter_gap(const RtxBuf *b, size_t byte_start, size_t row_line,
                          size_t *abs, size_t *plus) {
    size_t win;
    long rel;
    const RtxPieceTree *t;
    if (!b) return 0;
    win = rtx_gutter_win(b, row_line);
    if (b->doc.index_covers(byte_start)) {
        if (abs) *abs = row_line + 1;
        return 0;
    }
    t = &b->doc.tree;
    if (rtx_line_mark_ok(t)) {
        long n = (long)t->mark_line + (b->seek_valid ? b->seek_rel : 0) +
                 (long)win;
        if (n < 0) n = 0;
        if (abs) *abs = (size_t)n + 1;
        return 0;
    }
    if (b->seek_valid) rel = b->seek_rel + (long)win;
    else rel = (long)win;
    if (rel >= 0) {
        if (plus) *plus = (size_t)rel + 1;
        return 1;
    }
    if (plus) *plus = (size_t)(-rel);
    return -1;
}

int rtx_gutter_cols_buf(const RtxBuf *b, int vis) {
    size_t need;
    size_t extra = (vis > 0 ? (size_t)vis : 32) + 8;
    if (!b) return 2;
    if (b->doc.tree.want_line) {
        need = b->doc.tree.want_line + extra;
        return rtx_gutter_cols(need);
    }
    if (b->seek_valid && !b->doc.index_covers(b->seek_off) &&
        !rtx_line_mark_ok(&b->doc.tree))
        return rtx_gutter_cols(extra) + 1;
    if (b->seek_valid && rtx_line_mark_ok(&b->doc.tree)) {
        need = rtx_isle_cam_line(b) + extra;
        return rtx_gutter_cols(need);
    }
    if (b->seek_valid) {
        need = b->layout.from_line + extra;
        if (need < extra) need = extra;
        return rtx_gutter_cols(need);
    }
    need = b->doc.line_known();
    if (b->doc.lf_ready()) need = b->line_count();
    else {
        size_t tip = b->top + extra;
        if (tip > need) need = tip;
    }
    return rtx_gutter_cols(need);
}

int rtx_scroll_rail_thumb_h(const RtxScrollRail *r, int track_h, int min_th) {
    int th;
    if (!r || track_h < 1) return 0;
    if (min_th < 1) min_th = 1;
    if (r->len == 0 || r->vis >= r->len) return track_h;
    th = (int)((unsigned long long)track_h * r->vis / r->len);
    if (th < min_th) th = min_th;
    if (th > track_h) th = track_h;
    return th;
}

void rtx_scroll_rail_thumb(const RtxScrollRail *r, int track_h, int min_th,
                                  int *thumb_y, int *thumb_h) {
    int th;
    size_t span;
    int y = 0;
    th = rtx_scroll_rail_thumb_h(r, track_h, min_th);
    if (thumb_h) *thumb_h = th;
    if (!r || track_h < 1 || r->len == 0 || r->vis >= r->len) {
        if (thumb_y) *thumb_y = 0;
        return;
    }
    span = r->len - r->vis;
    {
        int usable = track_h - th;
        size_t pos = r->pos > span ? span : r->pos;
        if (usable > 0 && span)
            y = (int)((unsigned long long)pos * (size_t)usable / span);
        if (y < 0) y = 0;
        if (y > usable) y = usable;
    }
    if (thumb_y) *thumb_y = y;
}

int rtx_scroll_rail_needed(const RtxScrollRail *r) {
    return r && r->len > 0 && r->vis < r->len;
}

int rtx_scroll_rail_mark_y(const RtxScrollRail *r, int track_h, size_t off) {
    size_t span;
    if (!r || track_h < 1 || r->len == 0) return 0;
    if (off >= r->len) off = r->len - 1;
    span = r->len - 1;
    if (span == 0 || track_h == 1) return 0;
    return (int)((unsigned long long)off * (size_t)(track_h - 1) / span);
}

int rtx_buf_scroll_rel_row(const RtxBuf *b, int vis) {
    size_t i, i0;
    size_t caret;
    size_t screen = 0;
    if (!b || vis < 1 || !b->layout.rows.len) return 0;
    caret = b->doc.caret;
    i0 = b->top_wrap < b->layout.rows.len ? b->top_wrap : 0;
    if (caret < b->layout.rows.data[i0].byte_start) return 0;
    for (i = i0; i < b->layout.rows.len && screen < (size_t)vis; i++) {
        const RtxVisRow *row = &b->layout.rows.data[i];
        int h = (int)(row->height + 0.0001);
        if (h < 1) h = 1;
        if (caret >= row->byte_start && caret <= row->byte_start + row->byte_len) {
            int at = (int)screen;
            if (at >= vis) at = vis - 1;
            return at;
        }
        screen += (size_t)h;
    }
    return vis > 1 ? vis - 1 : 0;
}

int rtx_buf_scroll_rel_mark_y(const RtxBuf *b, const RtxScrollRail *rail,
                                     int track_h, int min_th, int vis) {
    int ty = 0, th = 0;
    int row;
    if (!b || track_h < 1 || vis < 1) return 0;
    if (rail) rtx_scroll_rail_thumb(rail, track_h, min_th, &ty, &th);
    else th = track_h;
    if (th < 1) th = 1;
    if (ty < 0) ty = 0;
    if (ty + th > track_h) th = track_h - ty;
    if (th < 1) return ty;
    row = rtx_buf_scroll_rel_row(b, vis);
    if (row < 0) row = 0;
    if (vis > 1 && row >= vis) row = vis - 1;
    if (th <= 1 || vis <= 1) return ty;
    return ty + (int)((unsigned long long)row * (size_t)(th - 1) /
                      (size_t)(vis - 1));
}

int rtx_buf_scroll_rel(const RtxBuf *b) {
    size_t off;
    if (!b || rtx_layout_is_hex(&b->layout)) return 0;
    if (rtx_line_isle_connected(&b->doc.tree)) return 0;
    if (b->layout.rows.len) off = b->layout.rows.data[0].byte_start;
    else if (b->seek_valid) off = b->seek_off;
    else off = b->doc.caret;
    if (rtx_line_mark_ok(&b->doc.tree)) return 0;
    return !b->doc.index_covers(off);
}

int RtxBuf_scroll_needed(const RtxBuf *b, int vis_rows) {
    size_t n;
    if (!b || vis_rows < 1) return 0;
    n = b->len();
    if (n == 0) return 0;
    if (rtx_layout_is_hex(&b->layout))
        return n > (size_t)vis_rows * (size_t)RTX_HEX_COLS;
    if (!b->doc.lf_ready()) return 1;
    if (b->top > 0 || b->top_wrap > 0) return 1;
    if (b->layout.rows.len > (size_t)vis_rows) return 1;
    if (b->layout.rows.len &&
        ((b->seek_valid && b->layout.rows.data[0].byte_start == b->seek_off) ||
         (!b->seek_valid && b->layout.from_line == b->top))) {
        const RtxVisRow *last = &b->layout.rows.data[b->layout.rows.len - 1];
        if (last->byte_start + last->byte_len >= n) return 0;
    }
    return b->line_count() > (size_t)vis_rows;
}

size_t rtx_scroll_rail_pos_at(const RtxScrollRail *r, int track_h, int min_th,
                                    int thumb_top) {
    int th;
    int usable;
    size_t span;
    if (!r || r->len == 0) return 0;
    if (r->vis >= r->len) return 0;
    span = r->len - r->vis;
    th = rtx_scroll_rail_thumb_h(r, track_h, min_th);
    usable = track_h - th;
    if (usable <= 0) return 0;
    if (thumb_top < 0) thumb_top = 0;
    if (thumb_top > usable) thumb_top = usable;
    return (size_t)((unsigned long long)thumb_top * span / (size_t)usable);
}

RtxScrollRail !>(RtxIndexErr) RtxBuf_scroll_rail(const RtxBuf *b, int vis_rows) {
    RtxScrollRail r = {0};
    size_t n;
    if (!b) return cc_ok(r);
    n = b->len();
    r.len = n;
    if (vis_rows < 1) vis_rows = 1;
    if (rtx_layout_is_hex(&b->layout)) {
        r.pos = b->top_byte;
        r.vis = (size_t)vis_rows * (size_t)RTX_HEX_COLS;
        if (r.pos > n) r.pos = n;
        if (r.vis > n - r.pos) r.vis = n - r.pos;
        if (r.vis == 0 && n) r.vis = n < (size_t)RTX_HEX_COLS ? n : (size_t)RTX_HEX_COLS;
        r.ready = 1;
        return cc_ok(r);
    }
    r.ready = b->doc.lf_ready();
    if (b->layout.rows.len &&
        ((b->seek_valid && b->layout.rows.data[0].byte_start == b->seek_off) ||
         (!b->seek_valid && b->layout.from_line == b->top))) {
        size_t i0 = b->top_wrap < b->layout.rows.len ? b->top_wrap : 0;
        size_t i1 = i0;
        size_t shown = 0;
        int h0 = (int)(b->layout.rows.data[i0].height + 0.0001);
        if (h0 < 1) h0 = 1;
        shown = (size_t)h0;
        r.pos = b->layout.rows.data[i0].byte_start;
        while (i1 + 1 < b->layout.rows.len && shown < (size_t)vis_rows) {
            int h;
            i1++;
            h = (int)(b->layout.rows.data[i1].height + 0.0001);
            if (h < 1) h = 1;
            shown += (size_t)h;
        }
        r.vis = (b->layout.rows.data[i1].byte_start + b->layout.rows.data[i1].byte_len) - r.pos;
    } else if (b->seek_valid) {
        r.pos = b->seek_off;
        r.vis = 0;
    } else if (b->top < b->doc.line_known()) {
        r.pos = b->line_start(b->top) !>(e) { return cc_err(e); };
        r.vis = 0;
    } else {
        r.pos = 0;
        r.vis = 0;
    }
    if (r.pos > n) r.pos = n;
    if (r.vis > n - r.pos) r.vis = n - r.pos;
    if (r.vis == 0 && n) {
        r.vis = n < 64 ? n : 64;
        if (r.vis > n - r.pos) r.vis = n - r.pos;
    }
    return cc_ok(r);
}

RtxScrollRail rtx_browse_prev_rail(const RtxBrowsePrev *p, int vis) {
    RtxScrollRail r = {0};
    size_t n;
    if (!p || !p->live) return r;
    n = p->doc.len();
    r.len = n;
    if (vis < 1) vis = 1;
    if (rtx_layout_is_hex(&p->layout)) {
        r.pos = p->cam.top_byte ? p->cam.top_byte : p->cam.seek_off;
        r.vis = (size_t)vis * (size_t)RTX_HEX_COLS;
        r.ready = 1;
    } else if (p->layout.rows.len) {
        size_t i0 = p->cam.top_wrap < p->layout.rows.len ? p->cam.top_wrap : 0;
        size_t i1 = i0;
        size_t shown = 1;
        r.pos = p->layout.rows.data[i0].byte_start;
        while (i1 + 1 < p->layout.rows.len && shown < (size_t)vis) {
            i1++;
            shown++;
        }
        r.vis = (p->layout.rows.data[i1].byte_start +
                 p->layout.rows.data[i1].byte_len) - r.pos;
        r.ready = p->doc.lf_ready();
    } else if (p->cam.seek_valid) {
        r.pos = p->cam.seek_off;
        r.ready = p->doc.lf_ready();
    } else {
        r.ready = p->doc.lf_ready();
    }
    if (r.pos > n) r.pos = n;
    if (r.vis > n - r.pos) r.vis = n - r.pos;
    if (r.vis == 0 && n) {
        r.vis = n < 64 ? n : 64;
        if (r.vis > n - r.pos) r.vis = n - r.pos;
    }
    return r;
}

static void rtx_browse_prev_invalidate(RtxBrowsePrev *p) {
    if (p) p->fill_view = -1;
}

void rtx_browse_prev_drag_end(RtxBrowsePrev *p) {
    if (!p) return;
    p->drag_vis = 0;
    p->drag_len = 0;
    p->drag_grab = 0;
}

/* Rebase seek onto the first visible row so top_wrap stays small. */
static void !>(CCError) rtx_browse_prev_rebase(RtxBrowsePrev *p, RtxMeasure *m,
                                               double width, int vis) {
    size_t keep, floor, i;
    @errhandler(CCError e) {
        return cc_err(e);
    }
    @errhandler(RtxIndexErr ie) {
        return cc_err(CC_ERR_IO, ie.message ? ie.message : "line index");
    }
    if (!p || !p->live || !p->layout.rows.len) return cc_ok();
    if (p->cam.top_wrap == 0 || p->cam.top_wrap >= p->layout.rows.len)
        return cc_ok();
    keep = p->layout.rows.data[p->cam.top_wrap].byte_start;
    floor = rtx_doc_line_floor(&p->doc, keep) !>;
    p->cam.seek_off = floor;
    p->cam.seek_valid = 1;
    p->cam.top_wrap = 0;
    rtx_browse_prev_invalidate(p);
    rtx_ws_prev_fill(p, m, width, vis) !>;
    for (i = 0; i < p->layout.rows.len; i++) {
        if (p->layout.rows.data[i].byte_start == keep) {
            p->cam.top_wrap = i;
            break;
        }
        if (p->layout.rows.data[i].byte_start > keep) break;
    }
    if (p->cam.top_wrap &&
        (size_t)vis + p->cam.top_wrap > p->layout.rows.len) {
        rtx_browse_prev_invalidate(p);
        rtx_ws_prev_fill(p, m, width, vis) !>;
    }
    return cc_ok();
}

void !>(CCError) rtx_browse_prev_scroll_vis(RtxBrowsePrev *p, RtxMeasure *m,
                                            double width, int vis, int dir) {
    size_t from, n;
    @errhandler(CCError e) {
        return cc_err(e);
    }
    @errhandler(RtxIndexErr ie) {
        return cc_err(CC_ERR_IO, ie.message ? ie.message : "line index");
    }
    if (!p || !p->live) return cc_ok();
    if (vis < 1) vis = 1;
    if (rtx_layout_is_hex(&p->layout)) {
        size_t top, rows, last;
        n = p->doc.len();
        rows = rtx_hex_row_count(n);
        top = p->cam.top_byte ? p->cam.top_byte
                              : (p->cam.seek_valid ? p->cam.seek_off : 0);
        top = rtx_hex_align(top);
        if (dir < 0) {
            if (top >= (size_t)RTX_HEX_COLS) top -= (size_t)RTX_HEX_COLS;
            else top = 0;
        } else if (dir > 0) {
            size_t next = top + (size_t)RTX_HEX_COLS;
            last = rows > 1 ? (rows - 1) * (size_t)RTX_HEX_COLS : 0;
            if (next <= last) top = next;
        }
        p->cam.top_byte = top;
        p->cam.seek_off = top;
        p->cam.seek_valid = 1;
        p->cam.top_wrap = 0;
        return cc_ok();
    }
    if (p->cam.seek_valid) from = p->cam.seek_off;
    else if (p->cam.top_byte) from = p->cam.top_byte;
    else from = p->doc.caret;
    if (!rtx_layout_is_grid(&p->layout))
        from = rtx_doc_line_floor(&p->doc, from) !>;
    p->cam.seek_off = from;
    p->cam.seek_valid = 1;
    /* Room to step one row past the window. */
    {
        size_t need = p->cam.top_wrap + (size_t)vis + (dir > 0 ? 1 : 0);
        size_t save = p->cam.top_wrap;
        if (p->layout.rows.len < need || p->fill_view < 0) {
            p->cam.top_wrap = need > (size_t)vis ? need - (size_t)vis : 0;
            rtx_browse_prev_invalidate(p);
            rtx_ws_prev_fill(p, m, width, vis) !>(e) {
                p->cam.top_wrap = save;
                return cc_err(e);
            };
            p->cam.top_wrap = save;
        }
    }
    if (dir < 0) {
        if (p->cam.top_wrap > 0) {
            p->cam.top_wrap--;
        } else if (from > 0) {
            size_t prev = rtx_doc_line_floor(&p->doc, from - 1) !>;
            size_t wraps = 1, i;
            p->cam.seek_off = prev;
            p->cam.seek_valid = 1;
            p->cam.top_wrap = 0;
            rtx_browse_prev_invalidate(p);
            rtx_ws_prev_fill(p, m, width, vis) !>;
            if (p->layout.rows.len) {
                size_t line = p->layout.rows.data[0].line;
                for (i = 1; i < p->layout.rows.len; i++) {
                    if (p->layout.rows.data[i].line != line) break;
                    wraps++;
                }
            }
            if (wraps > 1) {
                p->cam.top_wrap = wraps - 1;
                if (p->layout.rows.len < (size_t)vis + p->cam.top_wrap) {
                    rtx_browse_prev_invalidate(p);
                    rtx_ws_prev_fill(p, m, width, vis) !>;
                }
            }
        }
    } else if (dir > 0) {
        if (p->cam.top_wrap + (size_t)vis < p->layout.rows.len) {
            p->cam.top_wrap++;
        } else {
            size_t idx = p->cam.top_wrap < p->layout.rows.len ? p->cam.top_wrap
                                                              : 0;
            size_t at, next;
            int has;
            if (!p->layout.rows.len) return cc_ok();
            at = p->layout.rows.data[idx].byte_start;
            has = rtx_doc_next_line_start(&p->doc, at, &next) !>;
            if (has) {
                p->cam.seek_off = next;
                p->cam.seek_valid = 1;
                p->cam.top_wrap = 0;
                rtx_browse_prev_invalidate(p);
            }
        }
    }
    rtx_browse_prev_rebase(p, m, width, vis) !>;
    return cc_ok();
}

void !>(CCError) rtx_browse_prev_scroll_to_off(RtxBrowsePrev *p, RtxMeasure *m,
                                               double width, int vis,
                                               size_t off) {
    size_t n, floor;
    @errhandler(CCError e) {
        return cc_err(e);
    }
    @errhandler(RtxIndexErr ie) {
        return cc_err(CC_ERR_IO, ie.message ? ie.message : "line index");
    }
    if (!p || !p->live) return cc_ok();
    n = p->doc.len();
    if (off > n) off = n;
    if (rtx_layout_is_hex(&p->layout)) {
        p->cam.top_byte = rtx_hex_align(off);
        p->cam.seek_off = p->cam.top_byte;
        p->cam.seek_valid = 1;
        p->cam.top_wrap = 0;
        return cc_ok();
    }
    floor = rtx_doc_line_floor(&p->doc, off) !>;
    p->cam.seek_off = floor;
    p->cam.seek_valid = 1;
    p->cam.top_wrap = 0;
    p->cam.top_byte = 0;
    rtx_browse_prev_invalidate(p);
    rtx_ws_prev_fill(p, m, width, vis) !>;
    return cc_ok();
}

