#!ccc ccs
/*
 * In-window mark / fold (linked TU; see nav.cch).
 * Walks runs the host already lexed. No extra scan. Types here must match
 * RtxRun / RtxFold in document.cch (tm_grammar_smoke checks sizes).
 * Mark nav is hint_a > 0 (grammar marks / apply vocabulary), not a scope list.
 */
#include <ccc/std/prelude.cch>
#include <stddef.h>
#include <stdint.h>
#include <string.h>
#include "scope.cch"

size_t rtx_tree_read(void *tree, size_t off, char *dst, size_t n);
size_t rtx_tree_len(void *tree);

typedef uint32_t RtxNavScope;

typedef struct {
    unsigned bold : 1;
    unsigned italic : 1;
    unsigned mono : 1;
    unsigned strike : 1;
    RtxNavScope scope;
} RtxNavStyle;

typedef struct {
    size_t start;
    size_t len;
    RtxNavStyle style;
    unsigned char planter; /* RtxRun.planter / hint_a / hint_b / mark / rule */
    unsigned char hint_a;
    unsigned char hint_b;
    unsigned char mark;
    unsigned short rule; /* unread here; layout must match RtxRun */
} RtxNavRun;

typedef struct {
    size_t lo;
    size_t hi;
} RtxNavFold;

typedef struct {
    size_t lo;
    size_t hi;
    size_t at;
    size_t edit;
    size_t runs;
    const void *runp;
    size_t vis_lo; /* !exact: no pair touches [vis_lo, vis_hi) */
    size_t vis_hi;
    unsigned have : 1;
    unsigned ready : 1;
    unsigned exact : 1;
} RtxNavPair;

static int nav_hidden(const RtxNavFold *folds, size_t fold_n, size_t off) {
    size_t i;
    if (!folds) return 0;
    for (i = 0; i < fold_n; i++) {
        if (off > folds[i].lo && off < folds[i].hi) return 1;
    }
    return 0;
}

size_t rtx_nav_run_bytes(void) {
    return sizeof(RtxNavRun);
}

size_t rtx_nav_fold_bytes(void) {
    return sizeof(RtxNavFold);
}

size_t rtx_nav_snap(const void *folds_v, size_t fold_n, size_t off, int dir) {
    const RtxNavFold *folds = (const RtxNavFold *)folds_v;
    size_t i;
    if (!folds) return off;
    for (i = 0; i < fold_n; i++) {
        if (off > folds[i].lo && off < folds[i].hi)
            return dir < 0 ? folds[i].lo : folds[i].hi;
    }
    return off;
}

int rtx_nav_from_ctrl(int c) {
    if (c == 11) return 1;  /* Ctrl-K */
    if (c == 16) return 2;  /* Ctrl-P prev mark */
    if (c == 5) return 3;
    if (c == 18) return 4;
    if (c == 20) return 5;
    return 0;
}

int rtx_nav_from_letter(int c) {
    if (c >= 'A' && c <= 'Z') c = c - 'A' + 'a';
    if (c == 'k') return 1;
    if (c == 'p') return 2;
    if (c == 'e') return 3;
    if (c == 'r') return 4;
    if (c == 't') return 5;
    return 0;
}

const char *rtx_nav_msg(int cmd, int r, int hex) {
    if (cmd == 5) {
        if (hex) return "hex has no fold";
        if (r == 1) return "folded";
        if (r == 2) return "unfolded";
        return "no region";
    }
    if (cmd == 3 || cmd == 4) return r ? "invalid" : "no invalid";
    return r ? "mark" : "no mark";
}

int rtx_nav_want_mark(const void *run_v) {
    const RtxNavRun *r = (const RtxNavRun *)run_v;
    return r && r->hint_a > 0;
}

int rtx_nav_want_invalid(const void *run_v) {
    const RtxNavRun *r = (const RtxNavRun *)run_v;
    return r && rtx_scope_is_invalid(r->style.scope);
}

int rtx_nav_step_at(const void *runs_v, size_t n, size_t *caret, size_t *anchor,
                    int *box, int dir, int (*want)(const void *run),
                    const void *folds_v, size_t fold_n) {
    const RtxNavRun *runs = (const RtxNavRun *)runs_v;
    const RtxNavFold *folds = (const RtxNavFold *)folds_v;
    size_t i;
    size_t at;
    size_t best;
    if (!runs || !caret || !want || n == 0) return 0;
    at = *caret;
    best = (size_t)-1;
    for (i = 0; i < n; i++) {
        size_t s = runs[i].start;
        if (runs[i].len == 0) continue;
        if (!want(&runs[i])) continue;
        if (nav_hidden(folds, fold_n, s)) continue;
        if (dir < 0) {
            if (s < at && (best == (size_t)-1 || s > best)) best = s;
        } else if (s > at && (best == (size_t)-1 || s < best)) {
            best = s;
        }
    }
    if (best == (size_t)-1) return 0;
    *caret = best;
    if (anchor) *anchor = best;
    if (box) *box = 0;
    return 1;
}

/* Heading section holding `at`. `end` is the document length when the
 * caller's lexed window reaches EOF, else 0: with no later heading in the
 * runs the section is closed by EOF only if the window got there. A window
 * that stops short is a miss (leftover), not a fold to its edge. */
static int nav_at_bol(void *tree, size_t start) {
    char c;
    if (start == 0) return 1;
    if (!tree) return 1;
    if (rtx_tree_read(tree, start - 1, &c, 1) != 1) return 0;
    return c == '\n';
}

/* Trailing ` ##` is a second heading-scoped prefix on the same line. It
 * is not a section start. Empty `#` at BOL is. */
static int nav_heading_start(const RtxNavRun *r, void *tree) {
    if (!r || !rtx_scope_is_heading(r->style.scope)) return 0;
    return nav_at_bol(tree, r->start);
}

/* Level of a heading start: the leading run of its prefix hint's first
 * byte (`###` → 3, same unit as apply's `insert`). A setext title (the
 * Markdown block pass plants it with no hint) reads its underline: the
 * next line's first byte past up to 3 spaces, `=` → 1, `-` → 2. 0 when
 * neither (a grammar without prefix marks): that heading closes, and is
 * closed by, a heading of any level. */
static int nav_heading_level(const RtxNavRun *r, void *tree) {
    char buf[16];
    size_t n, k;
    if (!r || !tree) return 0;
    if (r->hint_a == 0) {
        n = rtx_tree_read(tree, r->start + r->len, buf, 6);
        if (n < 2 || buf[0] != '\n') return 0;
        for (k = 1; k < n && k < 4 && buf[k] == ' '; k++) {
        }
        if (k < n && buf[k] == '=') return 1;
        if (k < n && buf[k] == '-') return 2;
        return 0;
    }
    n = r->hint_a < sizeof buf ? r->hint_a : sizeof buf;
    if (rtx_tree_read(tree, r->start, buf, n) != n) return 0;
    k = 1;
    while (k < n && buf[k] == buf[0]) k++;
    return (int)k;
}

int rtx_nav_heading(const void *run_v, void *tree) {
    const RtxNavRun *r = (const RtxNavRun *)run_v;
    if (!nav_heading_start(r, tree)) return -1;
    return nav_heading_level(r, tree);
}

/* Section of the last heading at or before `at`: up to the next heading
 * of the same or a higher level (fewer `#`); deeper headings stay inside. */
static int nav_region(const RtxNavRun *runs, size_t n, size_t at, size_t end,
                      size_t *lo, size_t *hi, void *tree) {
    size_t i;
    size_t prev = (size_t)-1;
    int lvl = 0;
    if (!runs || !lo || !hi || n == 0) return 0;
    for (i = 0; i < n; i++) {
        size_t a = runs[i].start;
        int la;
        if (!nav_heading_start(&runs[i], tree)) continue;
        la = nav_heading_level(&runs[i], tree);
        if (a <= at) {
            if (a != prev) lvl = la;
            else if (la > lvl) lvl = la;
            prev = a;
            continue;
        }
        if (prev == (size_t)-1) return 0;
        if (lvl && la > lvl) continue;
        if (a > prev + 1) {
            *lo = prev;
            *hi = a;
            return 1;
        }
        return 0;
    }
    if (end && prev != (size_t)-1 && at >= prev && at < end && end > prev + 1) {
        *lo = prev;
        *hi = end;
        return 1;
    }
    return 0;
}

/* Analysis page (RTX_HL_WIN_MAX), not the 64KiB store page. */
#define RTX_NAV_BRACE_PAGE 262144

int rtx_nav_brace_pages(size_t caret, size_t doc_len, size_t *from, size_t *to) {
    size_t page = (size_t)RTX_NAV_BRACE_PAGE;
    size_t p;
    size_t lo;
    size_t hi;
    if (!from || !to || !doc_len) return 0;
    if (caret > doc_len) caret = doc_len;
    p = caret / page;
    lo = p > 0 ? (p - 1) * page : 0;
    hi = (p + 2) * page; /* pages p-1, p, p+1 */
    if (hi > doc_len) hi = doc_len;
    if (hi <= lo) return 0;
    *from = lo;
    *to = hi;
    return 1;
}

static int nav_is_open(char c) {
    return c == '{' || c == '[' || c == '(';
}

static int nav_is_close(char c) {
    return c == '}' || c == ']' || c == ')';
}

static char nav_mate(char c) {
    if (c == '{') return '}';
    if (c == '[') return ']';
    if (c == '(') return ')';
    if (c == '}') return '{';
    if (c == ']') return '[';
    if (c == ')') return '(';
    return 0;
}

/* Brace bytes in a window: eight at a time. A pair scan walks up to three
 * 256 KiB pages per caret move; testing every byte against the runs made
 * that the whole frame. `& ~0x20` folds {} onto [], `| 1` folds ( onto ). */
#define NAV_ONES 0x0101010101010101ULL
#define NAV_HIGH 0x8080808080808080ULL
#define NAV_ZERO(v) (((v) - NAV_ONES) & ~(v) & NAV_HIGH)

static int nav_brace_byte(char c) {
    return nav_is_open(c) || nav_is_close(c);
}

static int nav_brace_word(const char *p) {
    uint64_t x, y, z;
    memcpy(&x, p, sizeof x);
    y = x & ~(0x20 * NAV_ONES);
    z = x | NAV_ONES;
    return (NAV_ZERO(y ^ (0x5B * NAV_ONES)) | NAV_ZERO(y ^ (0x5D * NAV_ONES)) |
            NAV_ZERO(z ^ (0x29 * NAV_ONES))) != 0;
}

/* First brace byte at or after `i` (< n), else n. */
static size_t nav_next_brace(const char *b, size_t i, size_t n) {
    while (i < n && (i & 7)) {
        if (nav_brace_byte(b[i])) return i;
        i++;
    }
    while (i + 8 <= n && !nav_brace_word(b + i)) i += 8;
    while (i < n && !nav_brace_byte(b[i])) i++;
    return i;
}

/* Last brace byte before `i` (at or after lo), else (size_t)-1. */
static size_t nav_prev_brace(const char *b, size_t lo, size_t i) {
    while (i > lo && (i & 7)) {
        i--;
        if (nav_brace_byte(b[i])) return i;
    }
    while (i >= lo + 8 && !nav_brace_word(b + i - 8)) i -= 8;
    while (i > lo) {
        i--;
        if (nav_brace_byte(b[i])) return i;
    }
    return (size_t)-1;
}

static int nav_skip_at(const RtxNavRun *runs, size_t n, size_t off, size_t *hint) {
    size_t i;
    int k;
    if (!runs || n == 0) return 0;
    i = hint && *hint < n ? *hint : 0;
    while (i + 1 < n && runs[i + 1].start <= off) i++;
    while (i > 0 && runs[i].start > off) i--;
    if (hint) *hint = i;
    if (off >= runs[i].start && off < runs[i].start + runs[i].len) {
        k = rtx_scope_kind(runs[i].style.scope);
        return k == RTX_HL_STRING || k == RTX_HL_COMMENT;
    }
    return 0;
}

static int nav_brace_win(const RtxNavRun *runs, size_t n, size_t caret,
                         size_t doc_len, size_t *from, size_t *to) {
    (void)runs;
    (void)n;
    return rtx_nav_brace_pages(caret, doc_len, from, to);
}

/* The pair window (three 256 KiB pages), read on demand from the caret
 * out. One heap arena for the UI thread, kept between calls: a fresh
 * ~800 KiB arena and a whole-window read per caret move were most of a
 * keystroke's paint. [lo, hi) is what has been read. */
typedef struct {
    void *tree;
    char *buf; /* byte `off` is buf[off - base] */
    size_t base;
    size_t from; /* window start (raised past a read hole) */
    size_t to;
    size_t lo;
    size_t hi;
} NavWin;

#define NAV_CHUNK 16384

static CCArena g_nav_win_a;
static char *g_nav_win;
static size_t g_nav_win_cap;

static char *nav_win_buf(size_t need) {
    if (g_nav_win && need <= g_nav_win_cap) return g_nav_win;
    if (g_nav_win_a.base) g_nav_win_a.destroy();
    g_nav_win_a = (CCArena){0};
    g_nav_win = NULL;
    g_nav_win_cap = 0;
    g_nav_win_a = cc_arena_heap(need + 64);
    if (!g_nav_win_a.base) return NULL;
    g_nav_win = (char *)cc_arena_alloc(g_nav_win_a, need, 1);
    if (!g_nav_win) {
        g_nav_win_a.destroy();
        g_nav_win_a = (CCArena){0};
        return NULL;
    }
    g_nav_win_cap = need;
    return g_nav_win;
}

/* Read further back (doubling). 0 when nothing more is readable. */
static int nav_win_back(NavWin *w) {
    size_t step, lo, got;
    if (w->lo <= w->from) return 0;
    step = w->hi - w->lo;
    if (step < NAV_CHUNK) step = NAV_CHUNK;
    lo = w->lo - w->from > step ? w->lo - step : w->from;
    got = rtx_tree_read(w->tree, lo, w->buf + (lo - w->base), w->lo - lo);
    if (got < w->lo - lo) {
        w->from = w->lo; /* a hole: the window starts where reads worked */
        return 0;
    }
    w->lo = lo;
    return 1;
}

/* Read further forward (doubling). 0 at the window end. */
static int nav_win_fwd(NavWin *w) {
    size_t step, hi, got;
    if (w->hi >= w->to) return 0;
    step = w->hi - w->lo;
    if (step < NAV_CHUNK) step = NAV_CHUNK;
    hi = w->to - w->hi > step ? w->hi + step : w->to;
    got = rtx_tree_read(w->tree, w->hi, w->buf + (w->hi - w->base), hi - w->hi);
    if (got < hi - w->hi) w->to = w->hi + got; /* short read: the window ends */
    w->hi += got;
    return got > 0;
}

/* Last brace byte before `off` and at or after `floor`, else (size_t)-1. */
static size_t nav_win_prev(NavWin *w, size_t off, size_t floor) {
    if (floor < w->from) floor = w->from;
    for (;;) {
        if (off > w->hi) off = w->hi;
        if (off > w->lo && off > floor) {
            size_t lo = w->lo > floor ? w->lo : floor;
            size_t k = nav_prev_brace(w->buf, lo - w->base, off - w->base);
            if (k != (size_t)-1) return w->base + k;
            off = lo;
        }
        if (off <= floor) return (size_t)-1;
        if (!nav_win_back(w)) return (size_t)-1;
    }
}

/* First brace byte at or after `off` (before the window end), else to. */
static size_t nav_win_next(NavWin *w, size_t off) {
    for (;;) {
        if (off < w->hi) {
            size_t k = nav_next_brace(w->buf, off - w->base, w->hi - w->base);
            if (w->base + k < w->hi) return w->base + k;
            off = w->hi;
        }
        if (!nav_win_fwd(w)) return w->to;
    }
}

static size_t nav_brace_close(NavWin *w, const RtxNavRun *runs, size_t n,
                              size_t opener) {
    char stk[64];
    size_t sp = 1;
    size_t off;
    size_t hint = 0;
    stk[0] = w->buf[opener - w->base];
    for (off = opener + 1; off < w->to; off++) {
        char c;
        off = nav_win_next(w, off);
        if (off >= w->to) break;
        if (nav_skip_at(runs, n, off, &hint)) continue;
        c = w->buf[off - w->base];
        if (nav_is_open(c)) {
            if (sp >= 64) return (size_t)-1;
            stk[sp] = c;
            sp++;
            continue;
        }
        if (!nav_is_close(c)) continue;
        if (sp == 0 || nav_mate(stk[sp - 1]) != c) return (size_t)-1;
        sp--;
        if (sp == 0) return off;
    }
    return (size_t)-1;
}

/* Nearest unmatched opener before the caret (or the caret's own brace).
 * `floor`: give up below it, *below = 1 (the caller resumes at *resume). */
static size_t nav_brace_open(NavWin *w, const RtxNavRun *runs, size_t n,
                             size_t at, size_t floor, int *depth_io,
                             size_t *resume, int *below) {
    size_t off;
    size_t hint = 0;
    int depth = depth_io ? *depth_io : 0;
    if (below) *below = 0;
    if (!resume || *resume == (size_t)-1) {
        if (at >= w->from && at < w->hi && !nav_skip_at(runs, n, at, &hint)) {
            char c = w->buf[at - w->base];
            if (nav_is_open(c)) return at;
            if (nav_is_close(c)) {
                char want = nav_mate(c);
                for (off = at; off > w->from; ) {
                    char b;
                    off = nav_win_prev(w, off, w->from);
                    if (off == (size_t)-1) break;
                    if (nav_skip_at(runs, n, off, &hint)) continue;
                    b = w->buf[off - w->base];
                    if (nav_is_close(b)) {
                        depth++;
                        continue;
                    }
                    if (!nav_is_open(b)) continue;
                    if (depth) {
                        depth--;
                        continue;
                    }
                    if (b == want) return off;
                    return (size_t)-1;
                }
                return (size_t)-1;
            }
        }
        if (at == 0) return (size_t)-1;
        off = at < w->to ? at : w->to;
    } else {
        off = *resume;
    }
    for (; off > w->from; ) {
        char b;
        size_t k = nav_win_prev(w, off, floor);
        if (k == (size_t)-1) {
            if (floor > w->from && below) {
                *below = 1;
                if (resume) *resume = off < floor ? off : floor;
                if (depth_io) *depth_io = depth;
            }
            break;
        }
        off = k;
        if (nav_skip_at(runs, n, off, &hint)) continue;
        b = w->buf[off - w->base];
        if (nav_is_close(b)) {
            depth++;
            continue;
        }
        if (!nav_is_open(b)) continue;
        if (depth) {
            depth--;
            continue;
        }
        return off;
    }
    return (size_t)-1;
}

/* Does anything in [at, end) close past the caret's depth? Count only:
 * the enclosing closer (if any) is where this first goes below zero. */
static int nav_closes_before(NavWin *w, const RtxNavRun *runs, size_t n,
                             size_t at, size_t end) {
    size_t off;
    size_t hint = 0;
    long depth = 0;
    if (end > w->to) end = w->to;
    for (off = at; off < end; off++) {
        char c;
        off = nav_win_next(w, off);
        if (off >= end) break;
        if (nav_skip_at(runs, n, off, &hint)) continue;
        c = w->buf[off - w->base];
        if (nav_is_open(c)) depth++;
        else if (nav_is_close(c) && --depth < 0) return 1;
    }
    return 0;
}

/* Opener and closer bytes. Same-line pairs are a hit (fold may still refuse).
 * With vis_hi > vis_lo only a pair with an end in [vis_lo, vis_hi) must be
 * exact: when the opener is above vis_lo and nothing on screen closes the
 * caret's depth, neither end is visible and *exact = 0. */
static int nav_brace_ends_vis(const RtxNavRun *runs, size_t n, size_t at,
                              void *tree, size_t doc_len, size_t vis_lo,
                              size_t vis_hi, size_t *lo, size_t *hi, int *exact) {
    NavWin w;
    size_t opener;
    size_t closer;
    size_t head;
    size_t floor = 0;
    size_t resume = (size_t)-1;
    int depth = 0;
    int below = 0;
    if (exact) *exact = 1;
    if (!tree || !lo || !hi) return 0;
    w.tree = tree;
    if (!nav_brace_win(runs, n, at, doc_len, &w.from, &w.to)) return 0;
    w.base = w.from;
    w.buf = nav_win_buf(w.to > w.from ? w.to - w.from : 1);
    if (!w.buf) return 0;
    head = at < w.to ? at + 1 : w.to;
    if (head < w.from) head = w.from;
    w.lo = head - w.from > NAV_CHUNK ? head - NAV_CHUNK : w.from;
    w.hi = w.lo;
    {
        size_t got = rtx_tree_read(tree, w.lo, w.buf + (w.lo - w.base), head - w.lo);
        w.hi = w.lo + got;
        if (got < head - w.lo) w.to = w.hi;
    }
    if (exact && vis_hi > vis_lo && at >= vis_lo && at < vis_hi && vis_lo > w.from)
        floor = vis_lo;
    opener = nav_brace_open(&w, runs, n, at, floor, &depth, &resume, &below);
    if (opener == (size_t)-1 && below) {
        if (!nav_closes_before(&w, runs, n, at, vis_hi)) {
            *exact = 0;
            return 0;
        }
        opener = nav_brace_open(&w, runs, n, at, w.from, &depth, &resume, NULL);
    }
    if (opener == (size_t)-1) return 0;
    closer = nav_brace_close(&w, runs, n, opener);
    /* Task box `[ ]` / `[x]` / `[X]` is a 3-byte hint atom, not a brace
     * pair — painting both ends looks like double carets. */
    if (closer != (size_t)-1 && closer == opener + 2 && opener >= w.from &&
        closer < w.hi) {
        char o = w.buf[opener - w.base];
        char mid = w.buf[opener + 1 - w.base];
        char c = w.buf[closer - w.base];
        if (o == '[' && c == ']' &&
            (mid == ' ' || mid == 'x' || mid == 'X'))
            return 0;
    }
    if (closer == (size_t)-1) return 0;
    *lo = opener;
    *hi = closer;
    return 1;
}

static int nav_brace_ends(const RtxNavRun *runs, size_t n, size_t at,
                          void *tree, size_t doc_len, size_t *lo, size_t *hi) {
    return nav_brace_ends_vis(runs, n, at, tree, doc_len, 0, 0, lo, hi, NULL);
}

static int nav_brace_region(const RtxNavRun *runs, size_t n, size_t at,
                            void *tree, size_t doc_len, size_t *lo, size_t *hi) {
    size_t opener;
    size_t closer;
    size_t line;
    char c;
    if (!nav_brace_ends(runs, n, at, tree, doc_len, &opener, &closer))
        return 0;
    line = closer;
    while (line > opener) {
        if (rtx_tree_read(tree, line - 1, &c, 1) != 1) break;
        if (c == '\n') break;
        line--;
    }
    if (line <= opener) return 0;
    *lo = opener;
    *hi = line;
    return 1;
}

static RtxNavPair g_pair_slot[4];
static void *g_pair_key[4];
static unsigned g_pair_clock;

/* vis_hi > vis_lo: the caller paints only [vis_lo, vis_hi). */
int rtx_nav_pair_ends_vis(void *tree, const void *runs, size_t n, size_t caret,
                          size_t edit, size_t run_len, size_t vis_lo,
                          size_t vis_hi, size_t *lo, size_t *hi) {
    RtxNavPair *p;
    unsigned i;
    int exact = 1;
    if (!tree) return 0;
    p = NULL;
    for (i = 0; i < 4; i++) {
        if (g_pair_key[i] == tree) {
            p = &g_pair_slot[i];
            break;
        }
    }
    if (!p) {
        i = g_pair_clock++ & 3;
        g_pair_key[i] = tree;
        p = &g_pair_slot[i];
        p->ready = 0;
    }
    if (p->ready && p->at == caret && p->edit == edit && p->runs == run_len &&
        p->runp == runs &&
        (p->exact || (vis_hi > vis_lo && p->vis_lo == vis_lo && p->vis_hi == vis_hi))) {
        if (!p->have) return 0;
        if (lo) *lo = p->lo;
        if (hi) *hi = p->hi;
        return 1;
    }
    p->at = caret;
    p->edit = edit;
    p->runs = run_len;
    p->runp = runs;
    p->vis_lo = vis_lo;
    p->vis_hi = vis_hi;
    p->ready = 1;
    p->have = nav_brace_ends_vis((const RtxNavRun *)runs, n, caret, tree,
                                 rtx_tree_len(tree), vis_lo, vis_hi, &p->lo,
                                 &p->hi, &exact);
    p->exact = exact ? 1 : 0;
    if (!p->have) return 0;
    if (lo) *lo = p->lo;
    if (hi) *hi = p->hi;
    return 1;
}

int rtx_nav_pair_ends(void *tree, const void *runs, size_t n, size_t caret,
                      size_t edit, size_t run_len, size_t *lo, size_t *hi) {
    return rtx_nav_pair_ends_vis(tree, runs, n, caret, edit, run_len, 0, 0, lo, hi);
}

int rtx_nav_fold_at(size_t *caret, size_t *anchor, const void *runs_v, size_t n,
                    void *tree, void *folds_v, size_t *fold_n, size_t fold_max,
                    int at_eof) {
    RtxNavRun *runs = (RtxNavRun *)runs_v;
    RtxNavFold *folds = (RtxNavFold *)folds_v;
    size_t lo = 0;
    size_t hi = 0;
    size_t i;
    size_t at;
    size_t doc_len;
    size_t bo = 0, bc = 0;
    int brace = -1;
    if (!caret || !folds || !fold_n) return 0;
    at = *caret;
    doc_len = tree ? rtx_tree_len(tree) : 0;
    for (i = 0; i < *fold_n; i++) {
        int hit = (at >= folds[i].lo && at < folds[i].hi);
        /* Closer sits at hi (line start). Pair paint lands there; that
         * must unfold, not add a second fold of the same pair. The pair
         * at the caret does not depend on i: match it once. */
        if (!hit && tree) {
            if (brace < 0)
                brace = nav_brace_ends(runs, n, at, tree, doc_len, &bo, &bc);
            if (brace && bo == folds[i].lo) hit = 1;
        }
        if (hit) {
            for (; i + 1 < *fold_n; i++) folds[i] = folds[i + 1];
            (*fold_n)--;
            return 2;
        }
    }
    if (n) nav_region(runs, n, at, at_eof ? doc_len : 0, &lo, &hi, tree);
    if (!hi) {
        if (!nav_brace_region(runs, n, at, tree, doc_len, &lo, &hi))
            return 0;
    }
    if (*fold_n >= fold_max) return 0;
    folds[*fold_n].lo = lo;
    folds[*fold_n].hi = hi;
    (*fold_n)++;
    if (at > lo && at < hi) {
        *caret = lo;
        if (anchor) *anchor = lo;
    }
    return 1;
}
