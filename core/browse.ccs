#!ccc ccs
/*
 * Directory listing (linked TU; see browse.cch).
 * Hosts include the header for types/chrome; this file owns kick / pump.
 * Listing: dest-live wrapper; wait-for directory jobs; write stage
 * appends ents. The frame pauses / resumes / cancel+wait.
 */
#include <ccc/std/prelude.cch>
#include <ctype.h>
#include <dirent.h>
#include <errno.h>
#include <fcntl.h>
#include <limits.h>
#include <stdio.h>
#include <string.h>
#include <stdlib.h>
#include <spawn.h>
#include <sys/stat.h>
#include <time.h>
#include <unistd.h>
#ifdef __APPLE__
#include <mach-o/dyld.h>
#include <crt_externs.h>
#endif
#include "browse.cch"

enum {
    RTX_BROWSE_WALK = 24,
    RTX_BROWSE_DU = 4,      /* opendir + lstat per interval */
    RTX_BROWSE_DU_MS = 8,   /* yield if a syscall already burned this */
    RTX_BROWSE_DU_HOLD = 8, /* paused live stacks */
    RTX_BROWSE_DU_HAVE = 64 /* finished abs totals; survive kick */
};

typedef struct {
    char abs[RTX_BROWSE_DIR];
    char rel[RTX_BROWSE_NAME];
    int depth;
} RtxBrowseJob;

typedef struct {
    char abs[RTX_BROWSE_DIR];
    char skip[RTX_BROWSE_NAME];
    int depth;
} RtxBrowseDuFrame;

typedef struct {
    char name[RTX_BROWSE_NAME];
    char abs[RTX_BROWSE_DIR];
    uint64_t size;
    RtxBrowseDuFrame stk[RTX_BROWSE_WALK];
    size_t sp;
    int done;
    int denied;
} RtxBrowseDuHold;

typedef struct {
    char abs[RTX_BROWSE_DIR];
    uint64_t size;
    int denied;
} RtxBrowseDuHave;

typedef struct RtxBrowseWalk {
    CCArena arena;
    RtxBrowseJob *jobs;
    size_t jlen, jcap, jhead;
    char keep[RTX_BROWSE_NAME];
    char du_name[RTX_BROWSE_NAME];
    RtxBrowseDuFrame du_stk[RTX_BROWSE_WALK];
    size_t du_sp;
    DIR *du_dp;
    char du_last[RTX_BROWSE_NAME];
    char du_skip[RTX_BROWSE_NAME];
    RtxBrowseDuHold hold[RTX_BROWSE_DU_HOLD];
    size_t nhold;
    RtxBrowseDuHave have[RTX_BROWSE_DU_HAVE];
    size_t nhave;
    int du_defer;          /* 1: movement owns this turn; no du I/O */
    int deep_phase;        /* 1: local listing done, appending flatten */
    int cancel;            /* 1: drop / kick asked the wave to leave */
    CCParallel h;
} RtxBrowseWalk;

typedef struct {
    RtxBrowseEnt *ents;
    size_t n, cap;
    RtxBrowseJob *kids;
    size_t kn, kcap;
    int denied;
} RtxBrowseScratch;

static long rtx_browse_now_ms(void) {
    struct timespec ts;
    if (clock_gettime(CLOCK_MONOTONIC, &ts) != 0) return 0;
    return (long)ts.tv_sec * 1000L + ts.tv_nsec / 1000000L;
}

static RtxBrowseWalk *rtx_br_wk(RtxBrowse *br) {
    return br ? (RtxBrowseWalk *)br->wk : NULL;
}

static int rtx_browse_run(RtxBrowse *br);
static void !>(CCError) rtx_browse_listing_start(RtxBrowse *br);

static int rtx_browse_stat_path(const char *path, RtxBrowseEnt *e) {
    struct stat st;
    if (!path || !path[0] || !e) return 0;
    if (stat(path, &st) != 0) return 0;
    e->has_stat = 1;
    e->is_dir = S_ISDIR(st.st_mode);
    e->size = (uint64_t)st.st_size;
    e->mtime = st.st_mtime;
    return 1;
}

static int rtx_browse_cmp(const void *a, const void *b) {
    const RtxBrowseEnt *x = (const RtxBrowseEnt *)a;
    const RtxBrowseEnt *y = (const RtxBrowseEnt *)b;
    if (x->is_dir != y->is_dir) return y->is_dir - x->is_dir;
    return strcmp(x->name, y->name);
}

static int rtx_browse_filter_blank(const char *f) {
    const char *p;
    if (!f || !f[0]) return 1;
    for (p = f; *p; p++) {
        if (*p != '.') return 0;
    }
    return 1;
}

static int rtx_browse_glob_meta(const char *pat) {
    const char *p;
    if (!pat) return 0;
    for (p = pat; *p; p++) {
        if (*p == '*' || *p == '?' || *p == '[') return 1;
    }
    return 0;
}

/* Text after `>`. Dots still here — they mean "show hidden", not a needle. */
static const char *rtx_browse_raw_filter(const RtxBrowse *br) {
    if (!br || !br->glob_len) return "";
    return (br->glob[0] == '>') ? br->glob + 1 : br->glob;
}

static int rtx_browse_want_hidden(const RtxBrowse *br) {
    const char *f = rtx_browse_raw_filter(br);
    return f && f[0] == '.';
}

/* Name match. Leading dots stripped on a fragment; a real glob keeps them. */
static const char *rtx_browse_filter(const RtxBrowse *br) {
    const char *f = rtx_browse_raw_filter(br);
    if (rtx_browse_filter_blank(f)) return "";
    if (!rtx_browse_glob_meta(f)) {
        while (*f == '.') f++;
        if (rtx_browse_filter_blank(f)) return "";
    }
    return f;
}

static const char *rtx_browse_rel_base(const char *name) {
    const char *slash;
    if (!name) return "";
    slash = strrchr(name, '/');
    return slash ? slash + 1 : name;
}

static int rtx_browse_explicit_deep(const RtxBrowse *br) {
    return br && br->glob_len && br->glob[0] == '>';
}

static int rtx_browse_deep(const RtxBrowse *br) {
    const RtxBrowseWalk *wk;
    if (rtx_browse_explicit_deep(br)) return 1;
    if (!br || !br->flat || !br->wk) return 0;
    wk = (const RtxBrowseWalk *)br->wk;
    return wk->deep_phase;
}

/* Typed fragment (not empty, not `.`, not `*.txt`) flattens on kick. */
static int rtx_browse_auto_flat(const RtxBrowse *br) {
    const char *filter;
    if (!br || !br->glob_len) return 0;
    if (br->glob[0] == '>') return 0;
    filter = rtx_browse_filter(br);
    if (!filter[0] || rtx_browse_glob_meta(filter)) return 0;
    return 1;
}

static int rtx_browse_find_ci(const char *name, const char *pat, size_t *off) {
    size_t n, p, i, j;
    if (!name || !pat || !pat[0]) return 0;
    n = strlen(name);
    p = strlen(pat);
    if (p > n) return 0;
    for (i = 0; i + p <= n; i++) {
        for (j = 0; j < p; j++) {
            unsigned char a = (unsigned char)name[i + j];
            unsigned char b = (unsigned char)pat[j];
            if (tolower(a) != tolower(b)) break;
        }
        if (j == p) {
            if (off) *off = i;
            return 1;
        }
    }
    return 0;
}

static int rtx_browse_contains(const char *name, const char *pat) {
    if (!pat || !pat[0]) return 1;
    return rtx_browse_find_ci(name, pat, NULL);
}

static void rtx_browse_glob_needle(const char *pat, char *dst, size_t cap) {
    const char *p, *cur_s, *best_s;
    size_t cur, best;
    if (!dst || cap == 0) return;
    dst[0] = 0;
    if (!pat) return;
    best = 0;
    cur = 0;
    best_s = pat;
    cur_s = pat;
    for (p = pat; ; p++) {
        int meta = (*p == '*' || *p == '?' || *p == '[' || *p == 0);
        if (meta) {
            if (cur > best) {
                best = cur;
                best_s = cur_s;
            }
            if (!*p) break;
            cur = 0;
            cur_s = p + 1;
        } else {
            if (cur == 0) cur_s = p;
            cur++;
        }
    }
    if (best == 0) return;
    if (best >= cap) best = cap - 1;
    {
        char[:] d = cc_slice_from_buffer(dst, best);
        char[:] s = cc_slice_from_buffer((void *)best_s, best);
        d.copy(s) !>(e) { (void)e; return; };
    }
    dst[best] = 0;
}

int rtx_browse_hit_span(const RtxBrowse *br, const char *name,
                        size_t *off, size_t *n) {
    const char *filter;
    char needle[RTX_BROWSE_GLOB];
    size_t at;
    if (off) *off = 0;
    if (n) *n = 0;
    if (!br || !name || !name[0]) return 0;
    filter = rtx_browse_filter(br);
    if (!filter[0]) return 0;
    if (rtx_browse_glob_meta(filter)) {
        rtx_browse_glob_needle(filter, needle, sizeof(needle));
        if (!needle[0]) return 0;
        filter = needle;
    }
    if (!rtx_browse_find_ci(name, filter, &at)) return 0;
    if (off) *off = at;
    if (n) *n = strlen(filter);
    return 1;
}

static int rtx_browse_glob_match(const char *pat, const char *name) {
    if (!pat || !pat[0] || !name) return 1;
    if (rtx_browse_glob_meta(pat))
        return cc_glob_match(cc_slice_cstr(pat), cc_slice_cstr(name));
    return rtx_browse_contains(name, pat);
}

static int rtx_browse_hidden(const RtxBrowse *br, const char *name) {
    const char *base = rtx_browse_rel_base(name);
    if (!base || base[0] != '.') return 0;
    if (rtx_browse_want_hidden(br)) return 0;
    return 1;
}

static int rtx_browse_show_name(const RtxBrowse *br, const char *name, int is_dir) {
    const char *filter;
    if (!name || name[0] == 0) return 0;
    if (strcmp(name, ".") == 0 || strcmp(name, "..") == 0) return 0;
    if (rtx_browse_hidden(br, name)) return 0;
    filter = rtx_browse_filter(br);
    if (!filter[0]) return 1;
    if (is_dir && !rtx_browse_deep(br) && rtx_browse_glob_meta(filter)) return 1;
    if (rtx_browse_glob_match(filter, name)) return 1;
    if (rtx_browse_deep(br))
        return rtx_browse_glob_match(filter, rtx_browse_rel_base(name));
    return 0;
}

static void rtx_browse_keep_cur(RtxBrowse *br, const char *keep) {
    size_t i;
    if (!br || !keep || !keep[0] || br->len == 0) {
        if (br) br->cur = 0;
        return;
    }
    for (i = 0; i < br->len; i++) {
        if (strcmp(br->ents[i].name, keep) == 0) {
            br->cur = i;
            return;
        }
    }
    if (br->cur >= br->len) br->cur = br->len - 1;
}

void rtx_browse_keep_set(RtxBrowse *br, const char *name) {
    if (!br || !name || !rtx_br_wk(br)) return;
    snprintf(rtx_br_wk(br)->keep, sizeof(rtx_br_wk(br)->keep), "%s", name);
}

void rtx_browse_walk_stop(RtxBrowse *br) {
    RtxBrowseWalk *wk = rtx_br_wk(br);
    if (!wk) return;
    wk->cancel = 1;
    if (wk->h.live()) {
        if (wk->h.paused())
            wk->h.resume() !>(e) { (void)e; };
        wk->h.wait() !>(e) { (void)e; };
    }
    if (wk->du_dp) closedir(wk->du_dp);
    if (wk->arena.base) wk->arena.destroy();
    free(wk);
    br->wk = NULL;
    br->sizing = 0;
}

static int rtx_browse_grow(RtxBrowse *br, size_t need) {
    void *n;
    size_t c;
    if (!br) return -1;
    if (need <= br->cap) return 0;
    c = br->cap ? br->cap : 8;
    while (c < need) {
        size_t next = c * 2;
        if (next < c) return -1;
        c = next;
    }
    n = cc_arena_alloc(br->store, c * sizeof(RtxBrowseEnt), 8);
    if (!n) return -1;
    if (br->ents && br->cap) {
        char[:] dst = cc_slice_from_buffer(n, br->cap * sizeof(RtxBrowseEnt));
        char[:] src = cc_slice_from_buffer(br->ents, br->cap * sizeof(RtxBrowseEnt));
        dst.copy(src) !>(e) { (void)e; return -1; };
    }
    br->ents = (RtxBrowseEnt *)n;
    br->cap = c;
    return 0;
}

/* Same idea as find_push: MAX is a stop, not an error. Status shows "capped". */
static int rtx_browse_push(RtxBrowse *br, const RtxBrowseEnt *rec) {
    if (!br || !rec) return -1;
    if (br->len >= (size_t)RTX_BROWSE_MAX) {
        br->truncated = 1;
        return 0;
    }
    if (rtx_browse_grow(br, br->len + 1) < 0) return -1;
    br->ents[br->len] = *rec;
    br->len++;
    return 0;
}

static int rtx_browse_job_push(RtxBrowse *br, const char *abs, const char *rel,
                              int depth) {
    RtxBrowseWalk *wk;
    RtxBrowseJob *n;
    size_t c;
    if (!br || !br->wk || !abs || !abs[0]) return -1;
    wk = br->wk;
    if (wk->jlen >= wk->jcap) {
        c = wk->jcap ? wk->jcap * 2 : 8;
        n = (RtxBrowseJob *)cc_arena_alloc(wk->arena, c * sizeof(RtxBrowseJob), 8);
        if (!n) return -1;
        if (wk->jobs && wk->jcap) {
            char[:] dst = cc_slice_from_buffer(n, wk->jcap * sizeof(RtxBrowseJob));
            char[:] src = cc_slice_from_buffer(wk->jobs,
                                               wk->jcap * sizeof(RtxBrowseJob));
            dst.copy(src) !>(e) { (void)e; return -1; };
        }
        wk->jobs = n;
        wk->jcap = c;
    }
    wk->jobs[wk->jlen] = (RtxBrowseJob){0};
    snprintf(wk->jobs[wk->jlen].abs, sizeof(wk->jobs[wk->jlen].abs), "%s", abs);
    snprintf(wk->jobs[wk->jlen].rel, sizeof(wk->jobs[wk->jlen].rel), "%s",
             rel ? rel : "");
    wk->jobs[wk->jlen].depth = depth;
    wk->jlen++;
    return 0;
}

static void rtx_browse_scratch_free(RtxBrowseScratch *s) {
    if (!s) return;
    free(s->ents);
    free(s->kids);
    *s = (RtxBrowseScratch){0};
}

static int rtx_browse_scratch_ent(RtxBrowseScratch *s, const RtxBrowseEnt *rec) {
    if (!s || !rec) return -1;
    if (s->n >= s->cap) {
        size_t c = s->cap ? s->cap * 2 : 32;
        RtxBrowseEnt *p = (RtxBrowseEnt *)realloc(s->ents, c * sizeof(*p));
        if (!p) return -1;
        s->ents = p;
        s->cap = c;
    }
    s->ents[s->n++] = *rec;
    return 0;
}

static int rtx_browse_scratch_kid(RtxBrowseScratch *s, const RtxBrowseJob *job,
                                 const char *name) {
    char full[RTX_BROWSE_DIR];
    char child[RTX_BROWSE_NAME];
    int wr;
    if (!s || !job || !name || job->depth >= RTX_BROWSE_WALK) return 0;
    wr = (job->rel[0])
             ? snprintf(child, sizeof(child), "%s/%s", job->rel, name)
             : snprintf(child, sizeof(child), "%s", name);
    if (wr <= 0 || (size_t)wr >= sizeof(child)) return 0;
    if (!rtx_browse_join(full, sizeof(full), job->abs, name)) return 0;
    if (s->kn >= s->kcap) {
        size_t c = s->kcap ? s->kcap * 2 : 8;
        RtxBrowseJob *p = (RtxBrowseJob *)realloc(s->kids, c * sizeof(*p));
        if (!p) return -1;
        s->kids = p;
        s->kcap = c;
    }
    s->kids[s->kn] = (RtxBrowseJob){0};
    snprintf(s->kids[s->kn].abs, sizeof(s->kids[s->kn].abs), "%s", full);
    snprintf(s->kids[s->kn].rel, sizeof(s->kids[s->kn].rel), "%s", child);
    s->kids[s->kn].depth = job->depth + 1;
    s->kn++;
    return 0;
}

/* Ticket-local. Do not write br->ents / jobs. */
static void rtx_browse_collect_shallow(const RtxBrowse *br, const RtxBrowseJob *job,
                                      RtxBrowseScratch *s) {
    DIR *dp;
    if (!br || !job || !s) return;
    dp = opendir(job->abs);
    if (!dp) {
        if ((errno == EACCES || errno == EPERM) &&
            strcmp(job->abs, br->dir) == 0)
            s->denied = 1;
        return;
    }
    for (;;) {
        struct dirent *de;
        const char *name;
        RtxBrowseEnt rec;
        char full[RTX_BROWSE_DIR];
        int hint_dir = 0;
        de = readdir(dp);
        if (!de) break;
        name = de->d_name;
        if (!name || strcmp(name, ".") == 0 || strcmp(name, "..") == 0) continue;
        rec = (RtxBrowseEnt){0};
        snprintf(rec.name, sizeof(rec.name), "%s", name);
        rtx_browse_join(full, sizeof(full), br->dir, name);
#ifdef DT_DIR
        hint_dir = (de->d_type == DT_DIR);
#endif
        if (!rtx_browse_stat_path(full, &rec))
            rec.is_dir = hint_dir;
        if (!rtx_browse_show_name(br, rec.name, rec.is_dir)) continue;
        if (rtx_browse_scratch_ent(s, &rec) < 0) break;
    }
    closedir(dp);
}

static void rtx_browse_collect_deep(const RtxBrowse *br, const RtxBrowseJob *job,
                                   RtxBrowseScratch *s) {
    DIR *dp;
    if (!br || !job || !s) return;
    dp = opendir(job->abs);
    if (!dp) {
        if (strcmp(job->abs, br->dir) == 0 &&
            (errno == EACCES || errno == EPERM))
            s->denied = 1;
        return;
    }
    for (;;) {
        struct dirent *de;
        const char *name;
        char full[RTX_BROWSE_DIR];
        char child[RTX_BROWSE_NAME];
        struct stat st;
        RtxBrowseEnt rec;
        int wr;
        de = readdir(dp);
        if (!de) break;
        name = de->d_name;
        if (!name || strcmp(name, ".") == 0 || strcmp(name, "..") == 0)
            continue;
        if (rtx_browse_hidden(br, name)) continue;
#ifdef DT_LNK
        if (de->d_type == DT_LNK) continue;
#endif
        wr = (job->rel[0])
                 ? snprintf(child, sizeof(child), "%s/%s", job->rel, name)
                 : snprintf(child, sizeof(child), "%s", name);
        if (wr <= 0 || (size_t)wr >= sizeof(child)) continue;
#ifdef DT_DIR
        if (de->d_type == DT_DIR) {
            if (rtx_browse_scratch_kid(s, job, name) < 0) break;
            continue;
        }
#endif
        if (!rtx_browse_show_name(br, child, 0)) continue;
        if (br->flat && !rtx_browse_explicit_deep(br) && !strchr(child, '/'))
            continue;
        if (!rtx_browse_join(full, sizeof(full), job->abs, name)) continue;
        if (lstat(full, &st) != 0 || S_ISLNK(st.st_mode)) continue;
        if (S_ISDIR(st.st_mode)) {
            if (rtx_browse_scratch_kid(s, job, name) < 0) break;
            continue;
        }
        rec = (RtxBrowseEnt){0};
        snprintf(rec.name, sizeof(rec.name), "%s", child);
        rec.has_stat = 1;
        rec.is_dir = 0;
        rec.size = (uint64_t)st.st_size;
        rec.mtime = st.st_mtime;
        if (rtx_browse_scratch_ent(s, &rec) < 0) break;
    }
    closedir(dp);
}

static RtxBrowseEnt *rtx_browse_named_ent(RtxBrowse *br, const char *name) {
    size_t i;
    if (!br || !name || !name[0] || !br->ents) return NULL;
    for (i = 0; i < br->len; i++) {
        if (strcmp(br->ents[i].name, name) == 0) return &br->ents[i];
    }
    return NULL;
}

static RtxBrowseEnt *rtx_browse_du_ent(RtxBrowse *br) {
    RtxBrowseWalk *wk = rtx_br_wk(br);
    if (!wk) return NULL;
    return rtx_browse_named_ent(br, wk->du_name);
}

static int rtx_browse_du_hold_i(RtxBrowseWalk *wk, const char *name) {
    size_t i;
    if (!wk || !name || !name[0]) return -1;
    for (i = 0; i < wk->nhold; i++) {
        if (strcmp(wk->hold[i].name, name) == 0) return (int)i;
    }
    return -1;
}

static int rtx_browse_du_have_i(const RtxBrowseWalk *wk, const char *abs) {
    size_t i;
    if (!wk || !abs || !abs[0]) return -1;
    for (i = 0; i < wk->nhave; i++) {
        if (strcmp(wk->have[i].abs, abs) == 0) return (int)i;
    }
    return -1;
}

static void rtx_browse_du_have_put(RtxBrowseWalk *wk, const char *abs,
                                  uint64_t size, int denied) {
    int slot;
    if (!wk || !abs || !abs[0]) return;
    slot = rtx_browse_du_have_i(wk, abs);
    if (slot < 0) {
        if (wk->nhave >= (size_t)RTX_BROWSE_DU_HAVE) {
            char[:] dst = cc_slice_from_buffer(
                &wk->have[0], (wk->nhave - 1) * sizeof(wk->have[0]));
            char[:] src = cc_slice_from_buffer(
                &wk->have[1], (wk->nhave - 1) * sizeof(wk->have[0]));
            dst.copy_overlap(src) !>(e) { (void)e; return; };
            wk->nhave--;
        }
        slot = (int)wk->nhave;
        wk->nhave++;
        wk->have[slot] = (RtxBrowseDuHave){0};
        snprintf(wk->have[slot].abs, sizeof(wk->have[slot].abs), "%s", abs);
    } else if ((size_t)slot + 1 < wk->nhave) {
        RtxBrowseDuHave keep = wk->have[slot];
        char[:] dst = cc_slice_from_buffer(
            &wk->have[slot],
            (wk->nhave - (size_t)slot - 1) * sizeof(wk->have[0]));
        char[:] src = cc_slice_from_buffer(
            &wk->have[slot + 1],
            (wk->nhave - (size_t)slot - 1) * sizeof(wk->have[0]));
        dst.copy_overlap(src) !>(e) { (void)e; return; };
        wk->have[wk->nhave - 1] = keep;
        slot = (int)wk->nhave - 1;
    }
    wk->have[slot].size = size;
    wk->have[slot].denied = denied ? 1 : 0;
}

static int rtx_browse_du_have_get(const RtxBrowseWalk *wk, const char *abs,
                                 uint64_t *size, int *denied) {
    int slot = rtx_browse_du_have_i(wk, abs);
    if (slot < 0) return 0;
    if (size) *size = wk->have[slot].size;
    if (denied) *denied = wk->have[slot].denied;
    return 1;
}

static int rtx_browse_du_ent_abs(const RtxBrowse *br, const RtxBrowseEnt *e,
                                char *dst, size_t n) {
    if (!br || !e || !dst || n == 0 || !e->is_dir || e->sep) return 0;
    if (strcmp(e->name, "..") == 0) return 0;
    return rtx_browse_join(dst, n, br->dir, e->name);
}

static void rtx_browse_du_stamp(RtxBrowseEnt *e, uint64_t size, int denied) {
    if (!e) return;
    e->sized = 1;
    e->has_stat = 1;
    e->size = size;
    e->size_done = 1;
    e->size_denied = denied ? 1 : 0;
}

static void rtx_browse_du_reapply(RtxBrowse *br) {
    RtxBrowseWalk *wk = rtx_br_wk(br);
    size_t i;
    if (!br || !wk || !br->ents) return;
    for (i = 0; i < br->len; i++) {
        char abs[RTX_BROWSE_DIR];
        uint64_t size;
        int denied;
        if (!rtx_browse_du_ent_abs(br, &br->ents[i], abs, sizeof(abs)))
            continue;
        if (!rtx_browse_du_have_get(wk, abs, &size, &denied)) continue;
        rtx_browse_du_stamp(&br->ents[i], size, denied);
    }
}

static int rtx_browse_du_done(const RtxBrowseWalk *wk) {
    return !wk || (wk->du_sp == 0 && !wk->du_dp);
}

static void rtx_browse_du_live_reset(RtxBrowseWalk *wk) {
    if (!wk) return;
    if (wk->du_dp) {
        closedir(wk->du_dp);
        wk->du_dp = NULL;
    }
    wk->du_sp = 0;
    wk->du_name[0] = 0;
    wk->du_last[0] = 0;
    wk->du_skip[0] = 0;
}

static void rtx_browse_du_park_skip(RtxBrowseWalk *wk) {
    if (!wk || !wk->du_dp || wk->du_sp == 0) return;
    if (wk->du_skip[0])
        snprintf(wk->du_stk[wk->du_sp - 1].skip,
                 sizeof(wk->du_stk[wk->du_sp - 1].skip), "%s", wk->du_skip);
    else if (wk->du_last[0])
        snprintf(wk->du_stk[wk->du_sp - 1].skip,
                 sizeof(wk->du_stk[wk->du_sp - 1].skip), "%s", wk->du_last);
}

static int rtx_browse_du_dive(RtxBrowseWalk *wk, const char *full) {
    RtxBrowseDuFrame *cur;
    int depth;
    if (!wk || !full || !full[0] || wk->du_sp == 0) return 0;
    cur = &wk->du_stk[wk->du_sp - 1];
    depth = cur->depth;
    if (depth + 1 >= RTX_BROWSE_WALK || wk->du_sp >= (size_t)RTX_BROWSE_WALK)
        return 0;
    rtx_browse_du_park_skip(wk);
    if (wk->du_dp) {
        closedir(wk->du_dp);
        wk->du_dp = NULL;
    }
    wk->du_stk[wk->du_sp] = (RtxBrowseDuFrame){0};
    snprintf(wk->du_stk[wk->du_sp].abs, sizeof(wk->du_stk[wk->du_sp].abs),
             "%s", full);
    wk->du_stk[wk->du_sp].depth = depth + 1;
    wk->du_sp++;
    wk->du_last[0] = 0;
    wk->du_skip[0] = 0;
    return 1;
}

static void rtx_browse_du_park(RtxBrowse *br) {
    RtxBrowseWalk *wk = rtx_br_wk(br);
    RtxBrowseEnt *e;
    int slot;
    if (!br || !wk || !wk->du_name[0]) return;
    e = rtx_browse_du_ent(br);
    slot = rtx_browse_du_hold_i(wk, wk->du_name);
    if (slot < 0) {
        if (wk->nhold >= (size_t)RTX_BROWSE_DU_HOLD) {
            char[:] dst = cc_slice_from_buffer(
                &wk->hold[0], (wk->nhold - 1) * sizeof(wk->hold[0]));
            char[:] src = cc_slice_from_buffer(
                &wk->hold[1], (wk->nhold - 1) * sizeof(wk->hold[0]));
            dst.copy_overlap(src) !>(e) { (void)e; return; };
            wk->nhold--;
        }
        slot = (int)wk->nhold;
        wk->nhold++;
        wk->hold[slot] = (RtxBrowseDuHold){0};
        snprintf(wk->hold[slot].name, sizeof(wk->hold[slot].name), "%s",
                 wk->du_name);
    }
    if (wk->du_sp && wk->du_stk[0].abs[0])
        snprintf(wk->hold[slot].abs, sizeof(wk->hold[slot].abs), "%s",
                 wk->du_stk[0].abs);
    else if (e)
        rtx_browse_du_ent_abs(br, e, wk->hold[slot].abs,
                              sizeof(wk->hold[slot].abs));
    rtx_browse_du_park_skip(wk);
    wk->hold[slot].size = e ? e->size : 0;
    wk->hold[slot].denied = e && e->size_denied ? 1 : 0;
    wk->hold[slot].done = (e && e->size_done) || rtx_browse_du_done(wk);
    if (wk->hold[slot].done && wk->hold[slot].abs[0])
        rtx_browse_du_have_put(wk, wk->hold[slot].abs, wk->hold[slot].size,
                              wk->hold[slot].denied);
    if (wk->hold[slot].done) {
        wk->hold[slot].sp = 0;
    } else {
        {
            char[:] dst = cc_slice_from_buffer(
                wk->hold[slot].stk, wk->du_sp * sizeof(wk->du_stk[0]));
            char[:] src = cc_slice_from_buffer(
                wk->du_stk, wk->du_sp * sizeof(wk->du_stk[0]));
            dst.copy(src) !>(e) { (void)e; return; };
        }
        wk->hold[slot].sp = wk->du_sp;
    }
    if (e) {
        e->size_done = wk->hold[slot].done;
        e->size_denied = wk->hold[slot].denied;
    }
    br->sizing = 0;
    rtx_browse_du_live_reset(wk);
}

static int rtx_browse_du_resume(RtxBrowse *br, const char *name) {
    RtxBrowseWalk *wk = rtx_br_wk(br);
    RtxBrowseEnt *e;
    int slot;
    char abs[RTX_BROWSE_DIR];
    uint64_t have_sz;
    int have_den;
    if (!br || !wk || !name) return 0;
    e = rtx_browse_named_ent(br, name);
    if (e && rtx_browse_du_ent_abs(br, e, abs, sizeof(abs)) &&
        rtx_browse_du_have_get(wk, abs, &have_sz, &have_den)) {
        rtx_browse_du_stamp(e, have_sz, have_den);
        br->sizing = 0;
        return 1;
    }
    slot = rtx_browse_du_hold_i(wk, name);
    if (slot < 0 || !e) return 0;
    e->sized = 1;
    e->has_stat = 1;
    e->size = wk->hold[slot].size;
    e->size_done = wk->hold[slot].done;
    e->size_denied = wk->hold[slot].denied;
    if (wk->hold[slot].done || wk->hold[slot].denied) {
        br->sizing = 0;
        return 1;
    }
    snprintf(wk->du_name, sizeof(wk->du_name), "%s", name);
    {
        char[:] dst = cc_slice_from_buffer(
            wk->du_stk, wk->hold[slot].sp * sizeof(wk->du_stk[0]));
        char[:] src = cc_slice_from_buffer(
            wk->hold[slot].stk, wk->hold[slot].sp * sizeof(wk->du_stk[0]));
        dst.copy(src) !>(e) { (void)e; return 0; };
    }
    wk->du_sp = wk->hold[slot].sp;
    wk->du_last[0] = 0;
    wk->du_skip[0] = 0;
    br->sizing = 1;
    return 1;
}

static void rtx_browse_du_start(RtxBrowse *br, RtxBrowseEnt *ent) {
    RtxBrowseWalk *wk = rtx_br_wk(br);
    char full[RTX_BROWSE_DIR];
    if (!br || !wk || !ent) return;
    if (!rtx_browse_join(full, sizeof(full), br->dir, ent->name)) return;
    snprintf(wk->du_name, sizeof(wk->du_name), "%s", ent->name);
    wk->du_stk[0] = (RtxBrowseDuFrame){0};
    snprintf(wk->du_stk[0].abs, sizeof(wk->du_stk[0].abs), "%s", full);
    wk->du_sp = 1;
    wk->du_last[0] = 0;
    wk->du_skip[0] = 0;
    ent->size = 0;
    ent->sized = 1;
    ent->size_done = 0;
    ent->size_denied = 0;
    ent->has_stat = 1;
    br->sizing = 1;
}

static void rtx_browse_du_retarget(RtxBrowse *br) {
    RtxBrowseWalk *wk;
    RtxBrowseEnt *ent;
    if (!br || !br->ents || br->len == 0 || br->cur >= br->len) {
        rtx_browse_du_park(br);
        return;
    }
    ent = &br->ents[br->cur];
    wk = rtx_br_wk(br);
    if (ent->is_dir && ent->size_done) {
        rtx_browse_du_park(br);
        return;
    }
    {
        char abs[RTX_BROWSE_DIR];
        uint64_t size;
        int denied;
        if (wk && rtx_browse_du_ent_abs(br, ent, abs, sizeof(abs)) &&
            rtx_browse_du_have_get(wk, abs, &size, &denied)) {
            rtx_browse_du_stamp(ent, size, denied);
            rtx_browse_du_park(br);
            return;
        }
    }
    if (wk && br->sizing && wk->du_name[0] &&
        strcmp(wk->du_name, ent->name) == 0)
        return;
    rtx_browse_du_park(br);
    if (!ent->is_dir || strcmp(ent->name, "..") == 0) return;
    if (rtx_browse_du_resume(br, ent->name)) {
        if (br->sizing && wk) wk->du_defer = 1;
        return;
    }
    rtx_browse_du_start(br, ent);
    if (br->sizing && wk) wk->du_defer = 1;
}

static size_t rtx_browse_pump_du(RtxBrowse *br) {
    RtxBrowseWalk *wk;
    RtxBrowseEnt *e;
    int work = 0;
    long t0;
    if (!br || !br->sizing) return 0;
    wk = rtx_br_wk(br);
    t0 = rtx_browse_now_ms();
    e = rtx_browse_du_ent(br);
    if (!wk || !e) {
        br->sizing = 0;
        rtx_browse_du_live_reset(wk);
        return 0;
    }
    for (;;) {
        struct dirent *de;
        const char *name;
        char full[RTX_BROWSE_DIR];
        struct stat st;
        RtxBrowseDuFrame *cur;
        int hint_dir, hint_lnk;
        if (work >= RTX_BROWSE_DU) break;
        if (work > 0 && rtx_browse_now_ms() - t0 >= (long)RTX_BROWSE_DU_MS)
            break;
        if (!wk->du_dp) {
            if (wk->du_sp == 0) {
                br->sizing = 0;
                rtx_browse_du_park(br);
                return (size_t)work;
            }
            cur = &wk->du_stk[wk->du_sp - 1];
            wk->du_dp = opendir(cur->abs);
            work++;
            if (!wk->du_dp) {
                if ((errno == EACCES || errno == EPERM) && cur->depth == 0) {
                    e->size_denied = 1;
                    e->size_done = 1;
                    br->sizing = 0;
                    rtx_browse_du_park(br);
                    return (size_t)work;
                }
                wk->du_sp--;
                wk->du_last[0] = 0;
                wk->du_skip[0] = 0;
                continue;
            }
            snprintf(wk->du_skip, sizeof(wk->du_skip), "%s", cur->skip);
            wk->du_last[0] = 0;
            if (work >= RTX_BROWSE_DU) break;
        }
        de = readdir(wk->du_dp);
        if (!de) {
            closedir(wk->du_dp);
            wk->du_dp = NULL;
            if (wk->du_sp) wk->du_sp--;
            wk->du_last[0] = 0;
            wk->du_skip[0] = 0;
            continue;
        }
        name = de->d_name;
        if (!name || strcmp(name, ".") == 0 || strcmp(name, "..") == 0)
            continue;
        if (wk->du_skip[0]) {
            if (strcmp(name, wk->du_skip) != 0) continue;
            wk->du_skip[0] = 0;
            continue;
        }
        snprintf(wk->du_last, sizeof(wk->du_last), "%s", name);
        hint_dir = 0;
        hint_lnk = 0;
#ifdef DT_DIR
        hint_dir = (de->d_type == DT_DIR);
        hint_lnk = (de->d_type == DT_LNK);
#endif
        if (hint_lnk) continue;
        if (!rtx_browse_join(full, sizeof(full),
                             wk->du_stk[wk->du_sp - 1].abs, name))
            continue;
        if (hint_dir) {
            rtx_browse_du_dive(wk, full);
            continue;
        }
        work++;
        if (lstat(full, &st) != 0 || S_ISLNK(st.st_mode)) continue;
        if (S_ISDIR(st.st_mode)) {
            rtx_browse_du_dive(wk, full);
            continue;
        }
        e->size += (uint64_t)st.st_size;
    }
    if (rtx_browse_du_done(wk)) {
        br->sizing = 0;
        rtx_browse_du_park(br);
    }
    return (size_t)work;
}

static size_t rtx_browse_sep_i(const RtxBrowse *br) {
    size_t i;
    if (!br || !br->ents) return (size_t)-1;
    for (i = 0; i < br->len; i++) {
        if (br->ents[i].sep) return i;
    }
    return (size_t)-1;
}

static size_t rtx_browse_sep_last(const RtxBrowse *br) {
    size_t i, last;
    last = (size_t)-1;
    if (!br || !br->ents) return last;
    for (i = 0; i < br->len; i++) {
        if (br->ents[i].sep) last = i;
    }
    return last;
}

static void rtx_browse_sort_keep(RtxBrowse *br) {
    size_t from, sep;
    RtxBrowseWalk *wk = rtx_br_wk(br);
    if (!br || br->len <= 1) {
        rtx_browse_keep_cur(br, br && br->wk ? rtx_br_wk(br)->keep : NULL);
        rtx_browse_du_reapply(br);
        return;
    }
    sep = rtx_browse_sep_last(br);
    if (wk && wk->deep_phase && sep != (size_t)-1) {
        if (br->len > sep + 1)
            qsort(br->ents + sep + 1, br->len - sep - 1, sizeof(RtxBrowseEnt),
                  rtx_browse_cmp);
        rtx_browse_keep_cur(br, br->wk ? rtx_br_wk(br)->keep : NULL);
        rtx_browse_du_reapply(br);
        return;
    }
    from = rtx_browse_is_root(br->dir) ? 0 : 1;
    if (br->len > from)
        qsort(br->ents + from, br->len - from, sizeof(RtxBrowseEnt),
              rtx_browse_cmp);
    rtx_browse_keep_cur(br, br->wk ? rtx_br_wk(br)->keep : NULL);
    rtx_browse_du_reapply(br);
}

static int rtx_browse_plant_flat_row(RtxBrowse *br) {
    RtxBrowseEnt rec;
    if (!br) return -1;
    if (rtx_browse_sep_i(br) != (size_t)-1) return 0;
    rec = (RtxBrowseEnt){0};
    rec.sep = 1;
    if (rtx_browse_push(br, &rec) < 0) return -1;
    rec = (RtxBrowseEnt){0};
    rec.sep = 1;
    snprintf(rec.name, sizeof(rec.name), "> Flattened search");
    return rtx_browse_push(br, &rec);
}

static void rtx_browse_begin_flat(RtxBrowse *br) {
    RtxBrowseWalk *wk = rtx_br_wk(br);
    DIR *dp;
    if (!br || !wk || wk->deep_phase) return;
    if (rtx_browse_plant_flat_row(br) < 0) return;
    /* Enqueue every sibling dir first; then flip deep_phase so peers can pop. */
    dp = opendir(br->dir);
    if (dp) {
        struct dirent *de;
        char full[RTX_BROWSE_DIR];
        while ((de = readdir(dp)) != NULL) {
            const char *name = de->d_name;
            int is_dir = 0;
            if (!name || strcmp(name, ".") == 0 || strcmp(name, "..") == 0)
                continue;
            if (rtx_browse_hidden(br, name)) continue;
#ifdef DT_DIR
            if (de->d_type == DT_DIR) is_dir = 1;
            else if (de->d_type != DT_UNKNOWN && de->d_type != DT_LNK)
                continue;
#endif
            if (!rtx_browse_join(full, sizeof(full), br->dir, name)) continue;
            if (!is_dir) {
                struct stat st;
                if (stat(full, &st) != 0 || !S_ISDIR(st.st_mode)) continue;
            }
            if (rtx_browse_job_push(br, full, name, 1) < 0) break;
        }
        closedir(dp);
    }
    wk->deep_phase = 1;
    if (wk->jhead < wk->jlen) br->scanning = 1;
}

static void rtx_browse_shallow_done(RtxBrowse *br) {
    rtx_browse_sort_keep(br);
    if (br && br->flat) rtx_browse_begin_flat(br);
}

static int rtx_browse_plant_dotdot(RtxBrowse *br) {
    char parent[RTX_BROWSE_DIR];
    if (!br || rtx_browse_is_root(br->dir)) return 0;
    if (rtx_browse_grow(br, 1) < 0) return -1;
    br->ents[0] = (RtxBrowseEnt){0};
    snprintf(br->ents[0].name, sizeof(br->ents[0].name), "..");
    br->ents[0].is_dir = 1;
    if (rtx_browse_join(parent, sizeof(parent), br->dir, ".."))
        rtx_browse_stat_path(parent, &br->ents[0]);
    br->ents[0].is_dir = 1;
    br->len = 1;
    return 0;
}

void !>(CCError) rtx_browse_kick(RtxBrowse *br) {
    char keep[RTX_BROWSE_NAME];
    RtxBrowseDuHave keep_have[RTX_BROWSE_DU_HAVE];
    size_t n_have = 0;
    RtxBrowseWalk *old;
    if (!br || !br->dir[0]) return cc_err(CC_ERR_INVALID_ARG, "browse dir");
    keep[0] = 0;
    if (br->ents && br->cur < br->len)
        snprintf(keep, sizeof(keep), "%s", br->ents[br->cur].name);
    rtx_browse_du_park(br);
    old = rtx_br_wk(br);
    if (old) {
        n_have = old->nhave;
        if (n_have) {
            char[:] dst = cc_slice_from_buffer(keep_have, n_have * sizeof(keep_have[0]));
            char[:] src = cc_slice_from_buffer(old->have, n_have * sizeof(keep_have[0]));
            dst.copy(src) !>(e) { return cc_err(e); };
        }
    }
    rtx_browse_walk_stop(br);
    if (br->store.base) br->store.reset();
    else {
        br->store = cc_arena_heap(kilobytes(8));
        if (!br->store.base) return cc_err(CC_ERR_OUT_OF_MEMORY, "browse");
    }
    br->wk = (RtxBrowseWalk *)calloc(1, sizeof(RtxBrowseWalk));
    if (!br->wk) return cc_err(CC_ERR_OUT_OF_MEMORY, "browse walk");
    rtx_br_wk(br)->arena = cc_arena_heap(kilobytes(8));
    if (!rtx_br_wk(br)->arena.base) {
        free(br->wk);
        br->wk = NULL;
        return cc_err(CC_ERR_OUT_OF_MEMORY, "browse walk");
    }
    br->ents = NULL;
    br->len = 0;
    br->cap = 0;
    snprintf(rtx_br_wk(br)->keep, sizeof(rtx_br_wk(br)->keep), "%s", keep);
    br->scanning = 1;
    br->flat = rtx_browse_auto_flat(br);
    br->truncated = 0;
    br->denied = 0;
    /* `>` is flatten without the typed-fragment chrome. Start deep so the
     * first ticket walks files and enqueues dirs — shallow_done only
     * begin_flat()s when br->flat. */
    if (rtx_browse_explicit_deep(br))
        rtx_br_wk(br)->deep_phase = 1;
    if (rtx_browse_plant_dotdot(br) < 0)
        return cc_err(CC_ERR_OUT_OF_MEMORY, "browse");
    if (rtx_browse_job_push(br, br->dir, "", 0) < 0)
        return cc_err(CC_ERR_OUT_OF_MEMORY, "browse job");
    old = rtx_br_wk(br);
    if (old) {
        old->nhave = n_have;
        if (n_have) {
            char[:] dst = cc_slice_from_buffer(old->have, n_have * sizeof(old->have[0]));
            char[:] src = cc_slice_from_buffer(keep_have, n_have * sizeof(old->have[0]));
            dst.copy(src) !>(e) { return cc_err(e); };
        }
    }
    rtx_browse_du_reapply(br);
    return rtx_browse_listing_start(br);
}

/* Wait-for tickets. Joined inside this arm so the dest-live kick returns. */
static int rtx_browse_run(RtxBrowse *br) {
    RtxBrowseWalk *wk;
    @errhandler(CCError e) {
        (void)e;
        return 0;
    }
    if (!br) return 0;
    wk = rtx_br_wk(br);
    if (!wk) return 0;

    while (!wk->cancel && !br->truncated && wk->jhead < wk->jlen) {
        size_t base = wk->jhead;
        size_t remain = wk->jlen - base;
        size_t n_sz;
        int n;
        int i;
        bool fin;
        CCArena ta = cc_arena_heap(kilobytes(64)) @destroy;
        CCTurnstile ts@(RTX_BROWSE_CAP, 1, ta) !> @destroy;

        n_sz = remain;
        if (n_sz > (size_t)INT_MAX) n_sz = (size_t)INT_MAX;
        n = (int)n_sz;

        fin = @parallel wait (ts) for (i in 0..n) {
            RtxBrowseJob job;
            RtxBrowseScratch slot = {0} @destroy {
                rtx_browse_scratch_free(&slot);
            };
            int shallow;

            job = wk->jobs[base + (size_t)i];
            shallow = (job.depth == 0 && !wk->deep_phase);
            if (!wk->cancel && !br->truncated) {
                if (shallow)
                    rtx_browse_collect_shallow(br, &job, &slot);
                else
                    rtx_browse_collect_deep(br, &job, &slot);
            }

            @stage (ts, 0, i) {
                size_t k;
                while (wk->h.paused && !wk->cancel)
                    cc_yield();
                if (!wk->cancel && !br->truncated) {
                    if (slot.denied) br->denied = 1;
                    for (k = 0; k < slot.n && !br->truncated; k++) {
                        if (rtx_browse_push(br, &slot.ents[k]) < 0)
                            br->truncated = 1;
                    }
                    for (k = 0; k < slot.kn && !br->truncated; k++) {
                        if (rtx_browse_job_push(br, slot.kids[k].abs,
                                               slot.kids[k].rel,
                                               slot.kids[k].depth) < 0)
                            br->truncated = 1;
                    }
                    wk->jhead = base + (size_t)i + 1;
                    if (shallow && !br->truncated && !wk->cancel)
                        rtx_browse_shallow_done(br);
                }
            }

            if (wk->cancel || br->truncated)
                break;
        } !>.wait()!>;
        (void)fin;
        if (wk->jhead == base)
            break;
    }

    br->scanning = 0;
    rtx_browse_sort_keep(br);
    return wk->cancel ? 0 : 1;
}

static void !>(CCError) rtx_browse_listing_start(RtxBrowse *br) {
    RtxBrowseWalk *wk = rtx_br_wk(br);
    int noop = 0;
    if (!br || !wk) return cc_err(CC_ERR_INVALID_ARG, "browse kick");
    if (wk->h.live()) return cc_ok();
    wk->h = @parallel {
        @serial { noop = 0; }
        rtx_browse_run(br);
    } !>;
    return cc_ok();
}

void rtx_browse_pause(RtxBrowse *br) {
    RtxBrowseWalk *wk = rtx_br_wk(br);
    if (!wk || !wk->h.live() || !br->scanning) return;
    wk->h.pause() !>(e) { (void)e; };
    rtx_browse_sort_keep(br);
}

void rtx_browse_resume(RtxBrowse *br) {
    RtxBrowseWalk *wk = rtx_br_wk(br);
    if (!wk || !wk->h.live() || !wk->h.paused()) return;
    wk->h.resume() !>(e) { (void)e; };
}

size_t !>(CCError) rtx_browse_pump(RtxBrowse *br) {
    size_t n = 0;
    if (!br) return cc_err(CC_ERR_INVALID_ARG, "browse");
    rtx_browse_du_retarget(br);
    {
        RtxBrowseWalk *wk = rtx_br_wk(br);
        if (wk && wk->du_defer) {
            wk->du_defer = 0;
            return cc_ok(n);
        }
    }
    if (br->sizing) n += rtx_browse_pump_du(br);
    return cc_ok(n);
}

void !>(CCError) rtx_browse_finish(RtxBrowse *br) {
    RtxBrowseWalk *wk;
    int n = 0;
    if (!br) return cc_err(CC_ERR_INVALID_ARG, "browse");
    wk = rtx_br_wk(br);
    if (wk && wk->h.live()) {
        if (wk->h.paused())
            wk->h.resume() !>(e) { return cc_err(e); };
        wk->h.wait() !>(e) { return cc_err(e); };
        br->scanning = 0;
    }
    while (br->sizing && n++ < 100000) {
        wk = rtx_br_wk(br);
        if (wk) wk->du_defer = 0;
        rtx_browse_pump(br) !>(e) { return cc_err(e); };
    }
    return cc_ok();
}

void rtx_browse_drop(RtxBrowse *br) {
    if (!br) return;
    rtx_browse_walk_stop(br);
    if (br->store.base) br->store.destroy();
    *br = (RtxBrowse){0};
}

int rtx_browse_is_root(const char *dir) {
    return dir && dir[0] == '/' && dir[1] == 0;
}

void rtx_browse_basename(char *dst, size_t n, const char *path) {
    const char *slash;
    if (!dst || n == 0) return;
    dst[0] = 0;
    if (!path || !path[0]) return;
    slash = strrchr(path, '/');
    snprintf(dst, n, "%s", slash ? slash + 1 : path);
}

void rtx_browse_dirname(char *dst, size_t n, const char *path) {
    const char *slash;
    size_t len;
    if (!dst || n == 0) return;
    if (!path || !path[0]) {
        snprintf(dst, n, ".");
        return;
    }
    slash = strrchr(path, '/');
    if (!slash) {
        snprintf(dst, n, ".");
        return;
    }
    if (slash == path) {
        snprintf(dst, n, "/");
        return;
    }
    len = (size_t)(slash - path);
    if (len >= n) len = n - 1;
    {
        char[:] d = cc_slice_from_buffer(dst, len);
        char[:] s = cc_slice_from_buffer((void *)path, len);
        d.copy(s) !>(e) { (void)e; return; };
    }
    dst[len] = 0;
}

int rtx_browse_abs(char *dst, size_t n, const char *path) {
    char raw[RTX_BROWSE_DIR];
    char resolved[PATH_MAX];
    if (!dst || n == 0) return 0;
    dst[0] = 0;
    if (!path || !path[0] || strcmp(path, ".") == 0) {
        cc_arena_stack(scratch, 1024);
        CCSlice cwd = cc_dir_cwd(scratch);
        if (!(cwd.ptr && cwd.len)) return 0;
        snprintf(raw, sizeof(raw), "%s", cwd.ptr);
    } else if (path[0] == '/') {
        snprintf(raw, sizeof(raw), "%s", path);
    } else {
        cc_arena_stack(scratch, 1024);
        CCSlice cwd = cc_dir_cwd(scratch);
        if (cwd.ptr && cwd.len)
            snprintf(raw, sizeof(raw), "%s/%s", cwd.ptr, path);
        else
            snprintf(raw, sizeof(raw), "%s", path);
    }
    if (realpath(raw, resolved) && resolved[0]) {
        if (strlen(resolved) >= n) return 0;
        snprintf(dst, n, "%s", resolved);
        return 1;
    }
    if (!raw[0] || strlen(raw) >= n) return 0;
    snprintf(dst, n, "%s", raw);
    return 1;
}

int rtx_browse_join(char *dst, size_t n, const char *dir, const char *name) {
    int wr;
    char abs[RTX_BROWSE_DIR];
    if (!dst || n == 0 || !dir || !name) return 0;
    if (strcmp(name, "..") == 0) {
        if (!rtx_browse_abs(abs, sizeof(abs), dir)) return 0;
        rtx_browse_dirname(dst, n, abs);
        return dst[0] != 0;
    }
    if (strcmp(dir, "/") == 0) wr = snprintf(dst, n, "/%s", name);
    else wr = snprintf(dst, n, "%s/%s", dir, name);
    return wr > 0 && (size_t)wr < n;
}

RtxThemeColor rtx_browse_face(RtxBrowseFace face) {
    RtxThemeColor z;
    z.r = 230; z.g = 230; z.b = 230; z.ansi = "\x1b[0m";
    switch (face) {
    case RTX_BROWSE_FACE_PATH:
        z.r = 120; z.g = 160; z.b = 210; z.ansi = "\x1b[34m";
        break;
    case RTX_BROWSE_FACE_GLOB:
        z.r = 220; z.g = 180; z.b = 80; z.ansi = "\x1b[33m";
        break;
    case RTX_BROWSE_FACE_DIR:
        z.r = 80; z.g = 200; z.b = 220; z.ansi = "\x1b[36;1m";
        break;
    case RTX_BROWSE_FACE_FILE:
        z.r = 230; z.g = 230; z.b = 230; z.ansi = "\x1b[37m";
        break;
    case RTX_BROWSE_FACE_SIZE:
        z.r = 220; z.g = 180; z.b = 80; z.ansi = "\x1b[33m";
        break;
    case RTX_BROWSE_FACE_DATE:
        z.r = 140; z.g = 140; z.b = 140; z.ansi = "\x1b[90m";
        break;
    case RTX_BROWSE_FACE_HIT:
        z.r = 255; z.g = 220; z.b = 80; z.ansi = "\x1b[43;30m";
        break;
    case RTX_BROWSE_FACE_EXT:
        z.r = 120; z.g = 210; z.b = 130; z.ansi = "\x1b[32m";
        break;
    case RTX_BROWSE_FACE_DENY:
        z.r = 255; z.g = 255; z.b = 255; z.ansi = "\x1b[41;97m";
        break;
    }
    return z;
}

const char *rtx_browse_scan_msg(const RtxBrowse *br) {
    if (!br) return "";
    if (br->scanning) return "  scanning...";
    if (br->sizing) return "  sizing...";
    if (br->denied) return "  denied";
    if (br->truncated) return "  capped";
    return "";
}

void rtx_browse_fmt_size(char *dst, size_t n, const RtxBrowseEnt *e) {
    uint64_t s;
    double v;
    char u;
    if (!dst || n == 0) return;
    if (!e || !e->has_stat || (e->is_dir && !e->sized && !e->size_denied)) {
        snprintf(dst, n, "%*s", RTX_BROWSE_SIZE_W, "");
        return;
    }
    if (e->is_dir && e->size_denied) {
        snprintf(dst, n, "%*s", RTX_BROWSE_SIZE_W, "denied");
        return;
    }
    s = e->size;
    if (s < 1024ull) {
        snprintf(dst, n, "%*llu", RTX_BROWSE_SIZE_W, (unsigned long long)s);
        return;
    }
    if (s < 1024ull * 1024) {
        v = (double)s / 1024.0;
        u = 'K';
    } else if (s < 1024ull * 1024 * 1024) {
        v = (double)s / (1024.0 * 1024.0);
        u = 'M';
    } else {
        v = (double)s / (1024.0 * 1024.0 * 1024.0);
        u = 'G';
    }
    snprintf(dst, n, "%*.1f%c", RTX_BROWSE_SIZE_W - 1, v, u);
}

void rtx_browse_fmt_mtime(char *dst, size_t n, const RtxBrowseEnt *e) {
    struct tm tm;
    if (!dst || n == 0) return;
    if (!e || !e->has_stat || !localtime_r(&e->mtime, &tm) ||
        strftime(dst, n, "%Y-%m-%d %H:%M", &tm) == 0) {
        snprintf(dst, n, "%*s", RTX_BROWSE_MTIME_W, "");
    }
}

void rtx_browse_fmt_meta(char *dst, size_t n, const RtxBrowseEnt *e) {
    char size[12];
    char when[24];
    rtx_browse_fmt_size(size, sizeof(size), e);
    rtx_browse_fmt_mtime(when, sizeof(when), e);
    snprintf(dst, n, "%s  %s", size, when);
}

void rtx_browse_fmt_row(char *dst, size_t n, int cols, const RtxBrowseEnt *e) {
    char name[RTX_BROWSE_NAME + 2];
    char size[12];
    char when[24];
    int meta = RTX_BROWSE_SIZE_W + 2 + RTX_BROWSE_MTIME_W;
    int name_w, i, show, size_at;

    if (!dst || n == 0) return;
    dst[0] = 0;
    if (!e) return;
    if (cols < 2) cols = 2;
    if ((size_t)cols >= n) cols = (int)n - 1;
    {
        char[:] d = cc_slice_from_buffer(dst, (size_t)cols);
        d.fill(' ') !>(e) { (void)e; return; };
    }
    dst[cols] = 0;

    snprintf(name, sizeof(name), "%s%s", e->name, e->is_dir ? "/" : "");
    show = cols >= 10 + meta;
    size_at = show ? cols - meta : cols;
    name_w = size_at - 2;
    if (name_w < 1) name_w = 1;
    for (i = 0; name[i] && i < name_w; i++)
        dst[1 + i] = name[i];
    if (!show) return;
    rtx_browse_fmt_size(size, sizeof(size), e);
    rtx_browse_fmt_mtime(when, sizeof(when), e);
    for (i = 0; size[i] && size_at + i < cols; i++)
        dst[size_at + i] = size[i];
    for (i = 0; when[i] && cols - RTX_BROWSE_MTIME_W + i < cols; i++)
        dst[cols - RTX_BROWSE_MTIME_W + i] = when[i];
}

size_t rtx_browse_dir_prefix(const char *name) {
    const char *slash;
    if (!name) return 0;
    slash = strrchr(name, '/');
    if (!slash) return 0;
    return (size_t)(slash - name + 1);
}

int rtx_browse_head(const RtxBrowse *br) {
    (void)br;
    return RTX_BROWSE_HEAD;
}

void rtx_browse_scroll(RtxBrowse *br, int vis) {
    size_t list;
    int head;
    if (!br) return;
    head = rtx_browse_head(br);
    list = (vis > head) ? (size_t)(vis - head) : 1;
    if (br->len == 0) {
        br->cur = 0;
        br->top = 0;
        return;
    }
    if (br->cur >= br->len) br->cur = br->len - 1;
    if (br->cur < br->top) br->top = br->cur;
    if (br->cur >= br->top + list) br->top = br->cur - list + 1;
}

void rtx_browse_move(RtxBrowse *br, int dir, int vis) {
    if (br) br->glob_focus = 0;
    if (!br || br->len == 0) return;
    if (dir < 0) {
        if (br->cur > 0) br->cur--;
    } else if (br->cur + 1 < br->len) {
        br->cur++;
    }
    {
        size_t n = 0;
        while (br->ents && br->cur < br->len && br->ents[br->cur].sep &&
               n++ < br->len) {
            if (dir < 0) {
                if (br->cur > 0) br->cur--;
                else if (br->cur + 1 < br->len) br->cur++;
                else break;
            } else if (br->cur + 1 < br->len) {
                br->cur++;
            } else if (br->cur > 0) {
                br->cur--;
            } else {
                break;
            }
        }
    }
    rtx_browse_scroll(br, vis);
    rtx_browse_du_retarget(br);
}

int rtx_browse_need_pump(const RtxBrowse *br) {
    const RtxBrowseEnt *e;
    if (!br || !br->on) return 0;
    if (br->scanning || br->sizing) return 1;
    if (!br->ents || br->len == 0 || br->cur >= br->len) return 0;
    e = &br->ents[br->cur];
    return e->is_dir && strcmp(e->name, "..") != 0 && !e->sized;
}

void rtx_browse_select(RtxBrowse *br, size_t idx, int vis) {
    if (!br || br->len == 0) return;
    if (idx >= br->len) idx = br->len - 1;
    br->cur = idx;
    br->glob_focus = 0;
    rtx_browse_scroll(br, vis);
    rtx_browse_du_retarget(br);
}

int rtx_browse_hit(const RtxBrowse *br, int row, int vis) {
    size_t list, idx;
    int head = rtx_browse_head(br);
    (void)vis;
    if (!br || row < head) return -1;
    list = (size_t)(row - head);
    idx = br->top + list;
    if (idx >= br->len) return -1;
    return (int)idx;
}

static char rtx_host_exe[PATH_MAX];

static const char *rtx_host_base(const char *exe) {
    const char *slash;
    if (!exe || !exe[0]) return "";
    slash = strrchr(exe, '/');
    return slash ? slash + 1 : exe;
}

int rtx_host_is_ray(const char *exe) {
    const char *b = rtx_host_base(exe);
    /* GUI host (Cocoa cctext-gui). */
    return strcmp(b, "cctext-gui") == 0 || strcmp(b, "cctext_gui") == 0;
}

int rtx_host_peer_path(const char *exe, int other, char *dst, size_t n) {
    char dir[PATH_MAX];
    const char *peer;
    int wr;
    if (!dst || n == 0) return 0;
    dst[0] = 0;
    if (!exe || !exe[0]) exe = "cctext";
    if (!other) {
        snprintf(dst, n, "%s", exe);
        return dst[0] != 0;
    }
    rtx_browse_dirname(dir, sizeof(dir), exe);
    peer = rtx_host_is_ray(exe) ? "cctext" : "cctext-gui";
    if (!strchr(exe, '/')) wr = snprintf(dst, n, "%s", peer);
    else if (strcmp(dir, "/") == 0) wr = snprintf(dst, n, "/%s", peer);
    else wr = snprintf(dst, n, "%s/%s", dir, peer);
    return wr > 0 && (size_t)wr < n;
}

const char *rtx_host_peer_name(int other) {
    int gui = rtx_host_is_ray(rtx_host_exe[0] ? rtx_host_exe : "cctext");
    if (other) return gui ? "cctext" : "cctext-gui";
    return gui ? "cctext-gui" : "cctext";
}

void rtx_host_set_exe(const char *argv0) {
    char raw[PATH_MAX];
    rtx_host_exe[0] = 0;
#ifdef __APPLE__
    {
        uint32_t n = (uint32_t)sizeof(raw);
        if (_NSGetExecutablePath(raw, &n) == 0) {
            if (realpath(raw, rtx_host_exe)) return;
            snprintf(rtx_host_exe, sizeof(rtx_host_exe), "%s", raw);
            return;
        }
    }
#else
    {
        ssize_t n = readlink("/proc/self/exe", raw, sizeof(raw) - 1);
        if (n > 0) {
            raw[n] = 0;
            snprintf(rtx_host_exe, sizeof(rtx_host_exe), "%s", raw);
            return;
        }
    }
#endif
    if (argv0 && argv0[0] == '/') {
        if (!realpath(argv0, rtx_host_exe))
            snprintf(rtx_host_exe, sizeof(rtx_host_exe), "%s", argv0);
    } else if (argv0 && argv0[0]) {
        if (!rtx_browse_abs(rtx_host_exe, sizeof(rtx_host_exe), argv0))
            snprintf(rtx_host_exe, sizeof(rtx_host_exe), "%s", argv0);
    } else {
        snprintf(rtx_host_exe, sizeof(rtx_host_exe), "cctext");
    }
}

int rtx_browse_sel_path(const RtxBrowse *br, char *dst, size_t n, int *is_dir) {
    const RtxBrowseEnt *ent;
    if (is_dir) *is_dir = 0;
    if (!br || !br->on || br->len == 0 || br->cur >= br->len || !dst || n == 0)
        return 0;
    ent = &br->ents[br->cur];
    if (ent->sep) return 0;
    if (!rtx_browse_join(dst, n, br->dir, ent->name)) return 0;
    if (is_dir) *is_dir = ent->is_dir;
    return 1;
}

static int rtx_sh_single_quote(char *dst, size_t n, const char *s) {
    size_t i = 0;
    if (!dst || n < 3) return 0;
    dst[i++] = '\'';
    for (; s && *s; s++) {
        if (*s == '\'') {
            if (i + 5 >= n) return 0;
            dst[i++] = '\'';
            dst[i++] = '"';
            dst[i++] = '\'';
            dst[i++] = '"';
            dst[i++] = '\'';
        } else {
            if (i + 1 >= n) return 0;
            dst[i++] = *s;
        }
    }
    if (i + 1 >= n) return 0;
    dst[i++] = '\'';
    dst[i] = 0;
    return 1;
}

static int rtx_host_pick_exe(int other, char *dst, size_t n) {
    char want[PATH_MAX];
    const char *self = rtx_host_exe[0] ? rtx_host_exe : "cctext";
    if (!rtx_host_peer_path(self, other, want, sizeof(want))) return 0;
    if (access(want, X_OK) == 0) {
        if (want[0] == '/') {
            snprintf(dst, n, "%s", want);
            return 1;
        }
        return rtx_browse_abs(dst, n, want);
    }
    snprintf(dst, n, "%s", want);
    return dst[0] != 0;
}

static char **rtx_host_env(void) {
#ifdef __APPLE__
    return *_NSGetEnviron();
#else
    static char *empty[1];
    empty[0] = 0;
    return empty;
#endif
}

static int rtx_host_spawn_direct(const char *exe, const char *path, int is_dir) {
    posix_spawn_file_actions_t fa;
    posix_spawnattr_t attr;
    pid_t pid;
    char *argv[3];
    int rc;
    if (!exe || !exe[0]) return 0;
    argv[0] = (char *)exe;
    if (is_dir || !path || !path[0]) {
        argv[1] = NULL;
    } else {
        argv[1] = (char *)path;
        argv[2] = NULL;
    }
    posix_spawn_file_actions_init(&fa);
    posix_spawnattr_init(&attr);
#ifdef POSIX_SPAWN_SETSID
    posix_spawnattr_setflags(&attr, POSIX_SPAWN_SETSID);
#endif
    if (is_dir && path && path[0]) {
#if defined(__APPLE__)
        /* macOS 15+ SDK has addchdir; 14 (CI) only has the _np name. */
#if defined(__MAC_OS_X_VERSION_MAX_ALLOWED) && \
    __MAC_OS_X_VERSION_MAX_ALLOWED >= 150000
        posix_spawn_file_actions_addchdir(&fa, path);
#else
        posix_spawn_file_actions_addchdir_np(&fa, path);
#endif
#elif defined(__linux__)
        posix_spawn_file_actions_addchdir_np(&fa, path);
#endif
    }
    posix_spawn_file_actions_addopen(&fa, STDIN_FILENO, "/dev/null", O_RDWR, 0);
    rc = posix_spawn(&pid, exe, &fa, &attr, argv, rtx_host_env());
    posix_spawn_file_actions_destroy(&fa);
    posix_spawnattr_destroy(&attr);
    return rc == 0;
}

#ifdef __APPLE__
static int rtx_env_has(const char *key, const char *needle) {
    const char *s = getenv(key);
    return s && needle && strstr(s, needle) != NULL;
}

const char *rtx_host_tty_app(void) {
    const char *p = getenv("TERM_PROGRAM");
    const char *trace = getenv("CURSOR_TRACE_ID");
    int cursor_env = (trace && trace[0]) ||
        rtx_env_has("GIT_ASKPASS", "Cursor.app") ||
        rtx_env_has("VSCODE_GIT_ASKPASS_NODE", "Cursor.app") ||
        rtx_env_has("VSCODE_GIT_ASKPASS_MAIN", "Cursor.app");
    int code_env =
        rtx_env_has("GIT_ASKPASS", "Visual Studio Code") ||
        rtx_env_has("VSCODE_GIT_ASKPASS_NODE", "Visual Studio Code");
    if (p && strcmp(p, "iTerm.app") == 0) return "iTerm";
    if (p && strcmp(p, "Apple_Terminal") == 0) return "Terminal";
    if (p && strcmp(p, "vscode") == 0) return code_env ? "Code" : "Cursor";
    if (cursor_env) return "Cursor";
    if (code_env) return "Code";
    return "Terminal";
}

static int rtx_host_as_escape(char *dst, size_t n, const char *s) {
    size_t i;
    size_t j;
    if (!dst || n < 2) return 0;
    j = 0;
    for (i = 0; s && s[i]; i++) {
        if (j + 2 >= n) return 0;
        if (s[i] == '\\' || s[i] == '"') {
            dst[j] = '\\';
            j++;
        }
        dst[j] = s[i];
        j++;
    }
    dst[j] = 0;
    return 1;
}

static int rtx_host_osascript(const char *script) {
    posix_spawn_file_actions_t fa;
    posix_spawnattr_t attr;
    pid_t pid;
    char *argv[4];
    int rc;
    if (!script || !script[0]) return 0;
    argv[0] = (char *)"/usr/bin/osascript";
    argv[1] = (char *)"-e";
    argv[2] = (char *)script;
    argv[3] = NULL;
    posix_spawn_file_actions_init(&fa);
    posix_spawnattr_init(&attr);
    rc = posix_spawn(&pid, argv[0], &fa, &attr, argv, rtx_host_env());
    posix_spawn_file_actions_destroy(&fa);
    posix_spawnattr_destroy(&attr);
    return rc == 0;
}

static int rtx_host_spawn_terminal(const char *esc) {
    char script[PATH_MAX * 4 + 160];
    int wr;
    wr = snprintf(script, sizeof(script),
                  "tell application \"Terminal\" to do script \"%s\"", esc);
    if (wr <= 0 || (size_t)wr >= sizeof(script)) return 0;
    return rtx_host_osascript(script);
}

static int rtx_host_spawn_iterm(const char *esc) {
    char script[PATH_MAX * 4 + 200];
    int wr;
    wr = snprintf(script, sizeof(script),
                  "tell application \"iTerm\" to create window with default "
                  "profile command \"%s\"", esc);
    if (wr <= 0 || (size_t)wr >= sizeof(script)) return 0;
    return rtx_host_osascript(script);
}

static int rtx_host_spawn_ide(const char *app, const char *esc) {
    char script[PATH_MAX * 4 + 700];
    int wr;
    if (!app || !app[0]) return 0;
    wr = snprintf(script, sizeof(script),
        "tell application \"System Events\"\n"
        "tell process \"%s\"\n"
        "set frontmost to true\n"
        "try\n"
        "click menu item \"New Terminal\" of menu \"Terminal\" of "
        "menu item \"Terminal\" of menu \"View\" of menu bar 1\n"
        "on error\n"
        "keystroke \"`\" using {control down, shift down}\n"
        "end try\n"
        "delay 0.4\n"
        "keystroke \"%s\"\n"
        "keystroke return\n"
        "end tell\n"
        "end tell\n", app, esc);
    if (wr <= 0 || (size_t)wr >= sizeof(script)) return 0;
    return rtx_host_osascript(script);
}

static int rtx_host_spawn_tty(const char *exe, const char *path, int is_dir) {
    char qexe[PATH_MAX * 2];
    char qpath[PATH_MAX * 2];
    char cmd[PATH_MAX * 4 + 80];
    char esc[PATH_MAX * 4 + 80];
    const char *app;
    int wr;
    if (!rtx_sh_single_quote(qexe, sizeof(qexe), exe)) return 0;
    if (is_dir && path && path[0]) {
        if (!rtx_sh_single_quote(qpath, sizeof(qpath), path)) return 0;
        wr = snprintf(cmd, sizeof(cmd), "cd %s && exec %s", qpath, qexe);
    } else if (path && path[0]) {
        if (!rtx_sh_single_quote(qpath, sizeof(qpath), path)) return 0;
        wr = snprintf(cmd, sizeof(cmd), "exec %s %s", qexe, qpath);
    } else {
        wr = snprintf(cmd, sizeof(cmd), "exec %s", qexe);
    }
    if (wr <= 0 || (size_t)wr >= sizeof(cmd)) return 0;
    if (!rtx_host_as_escape(esc, sizeof(esc), cmd)) return 0;
    app = rtx_host_tty_app();
    if ((strcmp(app, "Cursor") == 0 || strcmp(app, "Code") == 0) &&
        rtx_host_spawn_ide(app, esc))
        return 1;
    if (strcmp(app, "iTerm") == 0 && rtx_host_spawn_iterm(esc)) return 1;
    return rtx_host_spawn_terminal(esc);
}
#else
const char *rtx_host_tty_app(void) {
    return "Terminal";
}
#endif

int rtx_browse_spawn(const RtxBrowse *br, int other) {
    char full[RTX_BROWSE_DIR];
    char exe[PATH_MAX];
    int is_dir = 0;
    if (!rtx_browse_sel_path(br, full, sizeof(full), &is_dir)) return 0;
    if (!rtx_host_pick_exe(other, exe, sizeof(exe))) return 0;
    if (rtx_host_is_ray(exe))
        return rtx_host_spawn_direct(exe, full, is_dir);
#ifdef __APPLE__
    return rtx_host_spawn_tty(exe, full, is_dir);
#else
    return rtx_host_spawn_direct(exe, full, is_dir);
#endif
}
