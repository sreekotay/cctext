#!ccc ccs
/*
 * Directory listing (linked TU; see browse.cch).
 * Hosts include the header for types/chrome; this file owns kick / pump.
 * Listing: dest-live wrapper; one WAVE of directory jobs per arm;
 * dest-live stays live until wait, so the host pump joins a finished
 * arm then starts the next wave. Flatten skips vendor trees,
 * caps the job queue, and splits huge folders. finish drains waves
 * then folder-size. Drop/kick cancel the tree and join.
 */
#include <ccc/std/prelude.cch>
#include <ctype.h>
#include <dirent.h>
#include <errno.h>
#include <fcntl.h>
#include <limits.h>
#include <stdatomic.h>
#include <stdio.h>
#include <string.h>
#include <stdlib.h>
#include <spawn.h>
#include <sys/stat.h>
#include <sys/wait.h>
#include <time.h>
#include <unistd.h>
#ifdef __APPLE__
#include <mach-o/dyld.h>
#include <crt_externs.h>
#endif
#include "browse.cch"
#include "rtx_par.cch"

enum {
    RTX_BROWSE_WALK = 24,
    RTX_BROWSE_DU = 4,      /* opendir + lstat per interval */
    RTX_BROWSE_DU_MS = 8,   /* yield if a syscall already burned this */
    RTX_BROWSE_DU_HOLD = 8, /* paused live stacks */
    RTX_BROWSE_DU_HAVE = 64 /* finished abs totals; survive kick */
};

typedef struct {
    char abs[RTX_BROWSE_DIR];
    char rel[RTX_BROWSE_NAME];
    int depth;
    int skip;              /* raw readdir count already consumed */
} RtxBrowseJob;

typedef struct {
    char abs[RTX_BROWSE_DIR];
    char skip[RTX_BROWSE_NAME];
    int depth;
} RtxBrowseDuFrame;

typedef struct {
    char name[RTX_BROWSE_NAME];
    char abs[RTX_BROWSE_DIR];
    uint64_t size;
    RtxBrowseDuFrame stk[RTX_BROWSE_WALK];
    size_t sp;
    int done;
    int denied;
} RtxBrowseDuHold;

typedef struct {
    char abs[RTX_BROWSE_DIR];
    uint64_t size;
    int denied;
} RtxBrowseDuHave;

typedef struct {
    CCArena arena;
    RtxBrowseEnt *ents;
    size_t n, cap;
    RtxBrowseJob *kids;
    size_t kn, kcap;
    int denied;
} RtxBrowseScratch;

/* The query a walk runs: dir + glob + flat, copied at kick. Workers read
 * this, never br->dir / br->glob — the host edits those (typing, enter,
 * parent) before the kick that joins this walk. */
typedef struct {
    char dir[RTX_BROWSE_DIR];
    char glob[RTX_BROWSE_GLOB];
    size_t glob_len;
    int flat;
} RtxBrowseQ;

typedef struct RtxBrowseWalk {
    RtxBrowseQ q;
    CCArena arena;
    RtxBrowseJob *jobs;
    size_t jlen, jcap, jhead;
    /* This wave's jobs, copied before the lanes start: a stage's job_push
     * grows (moves) `jobs` while later bodies of the wave still read. */
    RtxBrowseJob wave[RTX_BROWSE_WAVE];
    /* Lane i's collect scratch. The arm frees every slot after the join:
     * a lane whose stage wait fails leaves the body without running its
     * locals' @destroy, so the scratch cannot be a body local. */
    RtxBrowseScratch wslot[RTX_BROWSE_WAVE];
    char keep[RTX_BROWSE_NAME];
    char du_name[RTX_BROWSE_NAME];
    RtxBrowseDuFrame du_stk[RTX_BROWSE_WALK];
    size_t du_sp;
    DIR *du_dp;
    char du_last[RTX_BROWSE_NAME];
    char du_skip[RTX_BROWSE_NAME];
    RtxBrowseDuHold hold[RTX_BROWSE_DU_HOLD];
    size_t nhold;
    RtxBrowseDuHave have[RTX_BROWSE_DU_HAVE];
    size_t nhave;
    int du_defer;          /* 1: movement owns this turn; no du I/O */
    int deep_phase;        /* 1: local listing done, appending flatten */
    _Atomic unsigned char cancel; /* drop / kick asked the wave to leave */
    _Atomic unsigned char wave_stop; /* a stage capped the walk; bodies leave */
    _Atomic unsigned char done;   /* 1: dest-live arm returned; host may wait */
    CCParallel h;
} RtxBrowseWalk;

static inline unsigned char rtx_browse_load_cancel(const RtxBrowseWalk *wk) {
    return wk ? atomic_load_explicit(&wk->cancel, memory_order_acquire) : 1;
}

static inline void rtx_browse_store_cancel(RtxBrowseWalk *wk, unsigned char v) {
    if (wk) atomic_store_explicit(&wk->cancel, v, memory_order_release);
}

static inline unsigned char rtx_browse_load_done(const RtxBrowseWalk *wk) {
    return wk ? atomic_load_explicit(&wk->done, memory_order_acquire) : 1;
}

static inline void rtx_browse_store_done(RtxBrowseWalk *wk, unsigned char v) {
    if (wk) atomic_store_explicit(&wk->done, v, memory_order_release);
}

/* A stage capped the walk (br->truncated is the stage's; bodies read this). */
static inline unsigned char rtx_browse_wave_stopped(const RtxBrowseWalk *wk) {
    return wk ? atomic_load_explicit(&wk->wave_stop, memory_order_acquire) : 1;
}

static long rtx_browse_now_ms(void) {
    struct timespec ts;
    if (clock_gettime(CLOCK_MONOTONIC, &ts) != 0) return 0;
    return (long)ts.tv_sec * 1000L + ts.tv_nsec / 1000000L;
}

static void rtx_browse_wave_scratch_free(RtxBrowseWalk *wk);

static RtxBrowseWalk *rtx_br_wk(RtxBrowse *br) {
    return br ? (RtxBrowseWalk *)br->wk : NULL;
}

int rtx_browse_listing_live(const RtxBrowse *br) {
    RtxBrowseWalk *wk = rtx_br_wk((RtxBrowse *)br);
    return wk && wk->h.live();
}

/* Copy ents before qsort/du stamps them, if that buffer is the one
 * the host is still reading. */
static void rtx_browse_detach_pub(RtxBrowse *br) {
    RtxBrowsePub *pub;
    Vec::[RtxBrowseEnt] neu;
    size_t bytes;
    size_t old_len;
    if (!br || !br->ents.data || !br->ents.len || !br->store.base) return;
    pub = atomic_load_explicit(&br->pub, memory_order_relaxed);
    if (!pub || pub->ents != br->ents.data) return;
    old_len = br->ents.len;
    bytes = old_len * sizeof(RtxBrowseEnt);
    neu = vec_new::[RtxBrowseEnt](br->store);
    if (!neu.data) return;
    if (neu.reserve(old_len) != 0) return;
    {
        char[:] dst = cc_slice_from_buffer(neu.data, bytes);
        char[:] src = cc_slice_from_buffer(br->ents.data, bytes);
        dst.copy(src) !>(e) { (void)e; return; };
    }
    if (!neu.at_grow(old_len - 1)) return;
    br->ents = neu;
}

static void rtx_browse_publish(RtxBrowse *br) {
    RtxBrowsePub *p;
    int use_hold;
    if (!br || !br->store.base) return;
    p = (RtxBrowsePub *)cc_arena_alloc(br->store, sizeof(RtxBrowsePub), 8);
    if (!p) return;
    use_hold = br->hold && br->hold_len && !rtx_browse_ents_ready(br);
    if (use_hold) {
        p->ents = br->hold;
        p->len = br->hold_len;
        p->cur = br->hold_cur;
        p->top = br->hold_top;
    } else {
        p->ents = br->ents.data;
        p->len = br->ents.len;
        p->cur = br->cur;
        p->top = br->top;
    }
    p->truncated = br->truncated;
    p->denied = br->denied;
    atomic_store_explicit(&br->pub, p, memory_order_release);
}

/* Cancel and join so a key can read ents. Does not free the walk. */
static void rtx_browse_join_for_host(RtxBrowse *br) {
    RtxBrowseWalk *wk = rtx_br_wk(br);
    if (!wk || !wk->h.live()) return;
    rtx_browse_store_cancel(wk, 1);
    if (wk->h.paused())
        wk->h.resume() !>(e) { (void)e; };
    wk->h.invalidate();
}

static int rtx_browse_run(RtxBrowse *br);
static void !>(CCError) rtx_browse_listing_start(RtxBrowse *br);

static int rtx_browse_stat_path(const char *path, RtxBrowseEnt *e) {
    struct stat st;
    if (!path || !path[0] || !e) return 0;
    if (stat(path, &st) != 0) return 0;
    e->has_stat = 1;
    e->is_dir = S_ISDIR(st.st_mode);
    e->size = (uint64_t)st.st_size;
    e->mtime = st.st_mtime;
    return 1;
}

static int rtx_browse_cmp(const void *a, const void *b) {
    const RtxBrowseEnt *x = (const RtxBrowseEnt *)a;
    const RtxBrowseEnt *y = (const RtxBrowseEnt *)b;
    if (x->is_dir != y->is_dir) return y->is_dir - x->is_dir;
    return strcmp(x->name, y->name);
}

static int rtx_browse_filter_blank(const char *f) {
    const char *p;
    if (!f || !f[0]) return 1;
    for (p = f; *p; p++) {
        if (*p != '.') return 0;
    }
    return 1;
}

static int rtx_browse_glob_meta(const char *pat) {
    const char *p;
    if (!pat) return 0;
    for (p = pat; *p; p++) {
        if (*p == '*' || *p == '?' || *p == '[') return 1;
    }
    return 0;
}

/* Text after `>`. Dots still here — they mean "show hidden", not a needle. */
static const char *rtx_browse_raw_filter_g(const char *glob, size_t glob_len) {
    if (!glob || !glob_len) return "";
    return (glob[0] == '>') ? glob + 1 : glob;
}

static int rtx_browse_want_hidden_g(const char *glob, size_t glob_len) {
    const char *f = rtx_browse_raw_filter_g(glob, glob_len);
    return f && f[0] == '.';
}

/* Name match. Leading dots stripped on a fragment; a real glob keeps them. */
static const char *rtx_browse_filter_g(const char *glob, size_t glob_len) {
    const char *f = rtx_browse_raw_filter_g(glob, glob_len);
    if (rtx_browse_filter_blank(f)) return "";
    if (!rtx_browse_glob_meta(f)) {
        while (*f == '.') f++;
        if (rtx_browse_filter_blank(f)) return "";
    }
    return f;
}

static const char *rtx_browse_filter(const RtxBrowse *br) {
    return br ? rtx_browse_filter_g(br->glob, br->glob_len) : "";
}

static const char *rtx_browse_rel_base(const char *name) {
    const char *slash;
    if (!name) return "";
    slash = strrchr(name, '/');
    return slash ? slash + 1 : name;
}

static int rtx_browse_explicit_deep(const RtxBrowse *br) {
    return br && br->glob_len && br->glob[0] == '>';
}

static int rtx_browse_q_explicit_deep(const RtxBrowseQ *q) {
    return q && q->glob_len && q->glob[0] == '>';
}

/* `deep_phase` is the wave's copy: a stage (begin_flat) writes the walk's
 * field while other bodies of that wave still collect. */
static int rtx_browse_q_deep(const RtxBrowseWalk *wk, int deep_phase) {
    if (!wk) return 0;
    if (rtx_browse_q_explicit_deep(&wk->q)) return 1;
    return wk->q.flat && deep_phase;
}

/* Typed fragment (not empty, not `.`, not `*.txt`) flattens on kick. */
static int rtx_browse_auto_flat(const RtxBrowse *br) {
    const char *filter;
    if (!br || !br->glob_len) return 0;
    if (br->glob[0] == '>') return 0;
    filter = rtx_browse_filter(br);
    if (!filter[0] || rtx_browse_glob_meta(filter)) return 0;
    return 1;
}

/* Flatten descent only. Local listing still shows these names. */
static int rtx_browse_skip_deep(const char *name) {
    static const char *const skip[] = {
        "node_modules", "target", "dist", "build", "out", "__pycache__",
        "vendor", ".venv", "venv", "Pods", ".build", ".gradle", ".cargo",
        ".git", ".cc-build",
        NULL
    };
    const char *base;
    size_t i;
    base = rtx_browse_rel_base(name);
    if (!base || !base[0]) return 0;
    for (i = 0; skip[i]; i++)
        if (strcmp(base, skip[i]) == 0) return 1;
    return 0;
}

static int rtx_browse_find_ci(const char *name, const char *pat, size_t *off) {
    size_t n, p, i, j;
    if (!name || !pat || !pat[0]) return 0;
    n = strlen(name);
    p = strlen(pat);
    if (p > n) return 0;
    for (i = 0; i + p <= n; i++) {
        for (j = 0; j < p; j++) {
            unsigned char a = (unsigned char)name[i + j];
            unsigned char b = (unsigned char)pat[j];
            if (tolower(a) != tolower(b)) break;
        }
        if (j == p) {
            if (off) *off = i;
            return 1;
        }
    }
    return 0;
}

static int rtx_browse_contains(const char *name, const char *pat) {
    if (!pat || !pat[0]) return 1;
    return rtx_browse_find_ci(name, pat, NULL);
}

static void rtx_browse_glob_needle(const char *pat, char *dst, size_t cap) {
    const char *p, *cur_s, *best_s;
    size_t cur, best;
    if (!dst || cap == 0) return;
    dst[0] = 0;
    if (!pat) return;
    best = 0;
    cur = 0;
    best_s = pat;
    cur_s = pat;
    for (p = pat; ; p++) {
        int meta = (*p == '*' || *p == '?' || *p == '[' || *p == 0);
        if (meta) {
            if (cur > best) {
                best = cur;
                best_s = cur_s;
            }
            if (!*p) break;
            cur = 0;
            cur_s = p + 1;
        } else {
            if (cur == 0) cur_s = p;
            cur++;
        }
    }
    if (best == 0) return;
    if (best >= cap) best = cap - 1;
    {
        char[:] d = cc_slice_from_buffer(dst, best);
        char[:] s = cc_slice_from_buffer((void *)best_s, best);
        d.copy(s) !>(e) { (void)e; return; };
    }
    dst[best] = 0;
}

int rtx_browse_hit_span(const RtxBrowse *br, const char *name,
                        size_t *off, size_t *n) {
    const char *filter;
    char needle[RTX_BROWSE_GLOB];
    size_t at;
    if (off) *off = 0;
    if (n) *n = 0;
    if (!br || !name || !name[0]) return 0;
    filter = rtx_browse_filter(br);
    if (!filter[0]) return 0;
    if (rtx_browse_glob_meta(filter)) {
        rtx_browse_glob_needle(filter, needle, sizeof(needle));
        if (!needle[0]) return 0;
        filter = needle;
    }
    if (!rtx_browse_find_ci(name, filter, &at)) return 0;
    if (off) *off = at;
    if (n) *n = strlen(filter);
    return 1;
}

static int rtx_browse_glob_match(const char *pat, const char *name) {
    if (!pat || !pat[0] || !name) return 1;
    if (rtx_browse_glob_meta(pat))
        return cc_glob_match(cc_slice_cstr(pat), cc_slice_cstr(name));
    return rtx_browse_contains(name, pat);
}

static int rtx_browse_q_hidden(const RtxBrowseQ *q, const char *name) {
    const char *base = rtx_browse_rel_base(name);
    if (!base || base[0] != '.') return 0;
    if (q && rtx_browse_want_hidden_g(q->glob, q->glob_len)) return 0;
    return 1;
}

/* Worker side: the walk's own query. */
static int rtx_browse_q_show(const RtxBrowseWalk *wk, int deep_phase,
                             const char *name, int is_dir) {
    const char *filter;
    int deep = rtx_browse_q_deep(wk, deep_phase);
    if (!wk || !name || name[0] == 0) return 0;
    if (strcmp(name, ".") == 0 || strcmp(name, "..") == 0) return 0;
    if (rtx_browse_q_hidden(&wk->q, name)) return 0;
    filter = rtx_browse_filter_g(wk->q.glob, wk->q.glob_len);
    if (!filter[0]) return 1;
    if (is_dir && !deep && rtx_browse_glob_meta(filter)) return 1;
    if (rtx_browse_glob_match(filter, name)) return 1;
    if (deep) return rtx_browse_glob_match(filter, rtx_browse_rel_base(name));
    return 0;
}

static void rtx_browse_keep_cur(RtxBrowse *br, const char *keep) {
    if (!br || !keep || !keep[0] || br->ents.len == 0) {
        if (br) br->cur = 0;
        return;
    }
    @for (i, e in br->ents) {
        if (strcmp(e.name, keep) == 0) {
            br->cur = i;
            return;
        }
    }
    if (br->cur >= br->ents.len) br->cur = br->ents.len - 1;
}

static void rtx_browse_hold_drop(RtxBrowse *br) {
    if (!br) return;
    if (br->hold_a.base) br->hold_a.destroy();
    br->hold = NULL;
    br->hold_len = 0;
    br->hold_cap = 0;
    br->hold_cur = 0;
    br->hold_top = 0;
}

static void rtx_browse_hold_save(RtxBrowse *br) {
    size_t c, elem;
    void *n;
    if (!br || !br->ents.data || !br->ents.len) return;
    if (br->hold_cap < br->ents.len) {
        c = br->ents.len;
        elem = sizeof(RtxBrowseEnt);
        if (!br->hold_a.base) {
            br->hold_a = cc_arena_heap(c * elem + 64);
            if (!br->hold_a.base) return;
            br->hold = NULL;
            br->hold_cap = 0;
        }
        n = cc_arena_alloc(br->hold_a, c * elem, 8);
        if (!n) return;
        if (br->hold && br->hold_cap) {
            char[:] dst = cc_slice_from_buffer(n, br->hold_cap * elem);
            char[:] src = cc_slice_from_buffer(br->hold, br->hold_cap * elem);
            dst.copy(src) !>(e) { (void)e; return; };
        }
        br->hold = (RtxBrowseEnt *)n;
        br->hold_cap = c;
    }
    {
        char[:] dst = cc_slice_from_buffer(br->hold, br->ents.len * sizeof(RtxBrowseEnt));
        char[:] src = cc_slice_from_buffer(br->ents.data, br->ents.len * sizeof(RtxBrowseEnt));
        dst.copy(src) !>(e) { (void)e; return; };
    }
    br->hold_len = br->ents.len;
    br->hold_cur = br->cur;
    br->hold_top = br->top;
}

/* Walk side (a stage or the arm's return). Freeing hold here would race a
 * host still painting the old pub, and `wk->h` is the host's handle (the
 * kick stores it after the arm may already run), so only mark it: the
 * host frees after the join (pump / finish). */
static void rtx_browse_hold_maybe_drop(RtxBrowse *br) {
    if (!br || !br->hold_len) return;
    if (!rtx_browse_ents_ready(br)) return;
    br->hold_drop_later = 1;
}

/* Host, arm joined. */
static void rtx_browse_hold_drop_joined(RtxBrowse *br) {
    if (!br || !br->hold_drop_later) return;
    br->hold_drop_later = 0;
    rtx_browse_hold_drop(br);
}

void rtx_browse_keep_set(RtxBrowse *br, char[:0] name) {
    if (!br || !name.ptr) return;
    snprintf(br->keep, sizeof(br->keep), "%s", name.ptr);
    /* The live walk reads its own keep (sort_keep). Follow the name the
     * way a host move does: the join remaps by it. */
    if (rtx_browse_listing_live(br)) {
        RtxBrowsePub v = rtx_browse_view_snap(br);
        br->host_cur = v.cur;
        br->host_top = v.top;
        br->host_nav = 1;
        snprintf(br->host_name, sizeof(br->host_name), "%s", name.ptr);
        return;
    }
    if (rtx_br_wk(br))
        snprintf(rtx_br_wk(br)->keep, sizeof(rtx_br_wk(br)->keep), "%s", name.ptr);
    /* Dest-live may have finished inline; re-apply now. */
    if (!br->scanning) rtx_browse_keep_cur(br, name.ptr);
}

void rtx_browse_walk_stop(RtxBrowse *br) {
    RtxBrowseWalk *wk = rtx_br_wk(br);
    if (!wk) return;
    rtx_browse_store_cancel(wk, 1);
    if (wk->h.live()) {
        if (wk->h.paused())
            wk->h.resume() !>(e) { (void)e; };
        /* Drop/kick: cancel the wrapper and any adopted wave, then join. */
        wk->h.invalidate();
    }
    if (wk->du_dp) closedir(wk->du_dp);
    rtx_browse_wave_scratch_free(wk);
    if (wk->arena.base) wk->arena.destroy();
    free(wk);
    br->wk = NULL;
    br->sizing = 0;
}

static int rtx_browse_grow(RtxBrowse *br, size_t need) {
    if (!br || !br->store.base) return -1;
    if (!br->ents.data) {
        br->ents = vec_new::[RtxBrowseEnt](br->store);
        if (!br->ents.data) return -1;
    }
    return br->ents.reserve(need) == 0 ? 0 : -1;
}

/* Same idea as find_push: MAX is a stop, not an error. Status shows "capped". */
static int rtx_browse_push(RtxBrowse *br, const RtxBrowseEnt *rec) {
    if (!br || !rec) return -1;
    if (br->ents.len >= (size_t)RTX_BROWSE_MAX) {
        br->truncated = 1;
        return 0;
    }
    if (rtx_browse_grow(br, br->ents.len + 1) < 0) return -1;
    if (br->ents.push(*rec) != 0) return -1;
    rtx_browse_hold_maybe_drop(br);
    return 0;
}

static int rtx_browse_job_push(RtxBrowse *br, const RtxBrowseJob *job) {
    RtxBrowseWalk *wk;
    RtxBrowseJob *n;
    size_t c;
    if (!br || !br->wk || !job || !job->abs[0]) return -1;
    wk = br->wk;
    /* The cap is the queue still to walk, not every job ever queued: a deep
     * search over more than JOB_MAX folders is not a truncation. */
    if (wk->jlen - wk->jhead >= (size_t)RTX_BROWSE_JOB_MAX) {
        br->truncated = 1;
        return 0;
    }
    if (wk->jlen >= wk->jcap) {
        c = wk->jcap ? wk->jcap * 2 : 8;
        n = (RtxBrowseJob *)cc_arena_alloc(wk->arena, c * sizeof(RtxBrowseJob), 8);
        if (!n) return -1;
        if (wk->jobs && wk->jcap) {
            char[:] dst = cc_slice_from_buffer(n, wk->jcap * sizeof(RtxBrowseJob));
            char[:] src = cc_slice_from_buffer(wk->jobs,
                                               wk->jcap * sizeof(RtxBrowseJob));
            dst.copy(src) !>(e) { (void)e; return -1; };
        }
        wk->jobs = n;
        wk->jcap = c;
    }
    wk->jobs[wk->jlen] = *job;
    wk->jlen++;
    return 0;
}

static void rtx_browse_scratch_free(RtxBrowseScratch *s) {
    if (!s) return;
    if (s->arena.base) s->arena.destroy();
    *s = (RtxBrowseScratch){0};
}

static void rtx_browse_wave_scratch_free(RtxBrowseWalk *wk) {
    size_t i;
    if (!wk) return;
    for (i = 0; i < (size_t)RTX_BROWSE_WAVE; i++)
        rtx_browse_scratch_free(&wk->wslot[i]);
}

static int rtx_browse_scratch_arena(RtxBrowseScratch *s) {
    if (!s) return -1;
    if (s->arena.base) return 0;
    /* Room for a fat directory listing before publish (RTX_BROWSE_MAX ents). */
    s->arena = cc_arena_heap(megabytes(1));
    return s->arena.base ? 0 : -1;
}

static int rtx_browse_scratch_ent(RtxBrowseScratch *s, const RtxBrowseEnt *rec) {
    size_t c, elem;
    void *n;
    if (!s || !rec) return -1;
    if (s->n >= s->cap) {
        if (rtx_browse_scratch_arena(s) < 0) return -1;
        c = s->cap ? s->cap * 2 : 32;
        elem = sizeof(RtxBrowseEnt);
        n = cc_arena_alloc(s->arena, c * elem, 8);
        if (!n) return -1;
        if (s->ents && s->cap) {
            char[:] dst = cc_slice_from_buffer(n, s->cap * elem);
            char[:] src = cc_slice_from_buffer(s->ents, s->cap * elem);
            dst.copy(src) !>(e) { (void)e; return -1; };
        }
        s->ents = (RtxBrowseEnt *)n;
        s->cap = c;
    }
    s->ents[s->n++] = *rec;
    return 0;
}

static int rtx_browse_scratch_kid(RtxBrowseScratch *s, const RtxBrowseJob *job,
                                 const char *name) {
    char full[RTX_BROWSE_DIR];
    char child[RTX_BROWSE_NAME];
    int wr;
    size_t c, elem;
    void *n;
    if (!s || !job || !name || job->depth >= RTX_BROWSE_WALK) return 0;
    wr = (job->rel[0])
             ? snprintf(child, sizeof(child), "%s/%s", job->rel, name)
             : snprintf(child, sizeof(child), "%s", name);
    if (wr <= 0 || (size_t)wr >= sizeof(child)) return 0;
    if (!rtx_browse_join(full, sizeof(full), cc_slice_cstr(job->abs), cc_slice_cstr(name))) return 0;
    if (s->kn >= s->kcap) {
        if (rtx_browse_scratch_arena(s) < 0) return -1;
        c = s->kcap ? s->kcap * 2 : 8;
        elem = sizeof(RtxBrowseJob);
        n = cc_arena_alloc(s->arena, c * elem, 8);
        if (!n) return -1;
        if (s->kids && s->kcap) {
            char[:] dst = cc_slice_from_buffer(n, s->kcap * elem);
            char[:] src = cc_slice_from_buffer(s->kids, s->kcap * elem);
            dst.copy(src) !>(e) { (void)e; return -1; };
        }
        s->kids = (RtxBrowseJob *)n;
        s->kcap = c;
    }
    s->kids[s->kn] = (RtxBrowseJob){0};
    snprintf(s->kids[s->kn].abs, sizeof(s->kids[s->kn].abs), "%s", full);
    snprintf(s->kids[s->kn].rel, sizeof(s->kids[s->kn].rel), "%s", child);
    s->kids[s->kn].depth = job->depth + 1;
    s->kids[s->kn].skip = 0;
    s->kn++;
    return 0;
}

static int rtx_browse_scratch_resume(RtxBrowseScratch *s, const RtxBrowseJob *job,
                                    int skip) {
    size_t c, elem;
    void *n;
    if (!s || !job) return -1;
    if (s->kn >= s->kcap) {
        if (rtx_browse_scratch_arena(s) < 0) return -1;
        c = s->kcap ? s->kcap * 2 : 8;
        elem = sizeof(RtxBrowseJob);
        n = cc_arena_alloc(s->arena, c * elem, 8);
        if (!n) return -1;
        if (s->kids && s->kcap) {
            char[:] dst = cc_slice_from_buffer(n, s->kcap * elem);
            char[:] src = cc_slice_from_buffer(s->kids, s->kcap * elem);
            dst.copy(src) !>(e) { (void)e; return -1; };
        }
        s->kids = (RtxBrowseJob *)n;
        s->kcap = c;
    }
    s->kids[s->kn] = *job;
    s->kids[s->kn].skip = skip;
    s->kn++;
    return 0;
}

/* Ticket-local. Do not write br->ents / jobs; read the walk's query. */
static void rtx_browse_collect_shallow(const RtxBrowseWalk *wk, int deep_phase,
                                      const RtxBrowseJob *job,
                                      RtxBrowseScratch *s) {
    DIR *dp;
    if (!wk || !job || !s) return;
    dp = opendir(job->abs);
    if (!dp) {
        if ((errno == EACCES || errno == EPERM) &&
            strcmp(job->abs, wk->q.dir) == 0)
            s->denied = 1;
        return;
    }
    for (;;) {
        struct dirent *de;
        const char *name;
        RtxBrowseEnt rec;
        char full[RTX_BROWSE_DIR];
        int hint_dir = 0;
        de = readdir(dp);
        if (!de) break;
        name = de->d_name;
        if (!name || strcmp(name, ".") == 0 || strcmp(name, "..") == 0) continue;
        rec = (RtxBrowseEnt){0};
        snprintf(rec.name, sizeof(rec.name), "%s", name);
        rtx_browse_join(full, sizeof(full), cc_slice_cstr(job->abs), cc_slice_cstr(name));
#ifdef DT_DIR
        hint_dir = (de->d_type == DT_DIR);
#endif
        if (!rtx_browse_stat_path(full, &rec))
            rec.is_dir = hint_dir;
        if (!rtx_browse_q_show(wk, deep_phase, rec.name, rec.is_dir)) continue;
        if (rtx_browse_scratch_ent(s, &rec) < 0) break;
    }
    closedir(dp);
}

static void rtx_browse_collect_deep(const RtxBrowseWalk *wk, int deep_phase,
                                   const RtxBrowseJob *job,
                                   RtxBrowseScratch *s) {
    DIR *dp;
    int seen = 0;
    int work = 0;
    if (!wk || !job || !s) return;
    dp = opendir(job->abs);
    if (!dp) {
        if (strcmp(job->abs, wk->q.dir) == 0 &&
            (errno == EACCES || errno == EPERM))
            s->denied = 1;
        return;
    }
    for (;;) {
        struct dirent *de;
        const char *name;
        char full[RTX_BROWSE_DIR];
        char child[RTX_BROWSE_NAME];
        struct stat st;
        RtxBrowseEnt rec;
        int wr;
        de = readdir(dp);
        if (!de) break;
        seen++;
        if (seen <= job->skip) continue;
        work++;
        name = de->d_name;
        if (!name || strcmp(name, ".") == 0 || strcmp(name, "..") == 0)
            goto budget;
        if (rtx_browse_q_hidden(&wk->q, name)) goto budget;
        if (rtx_browse_load_cancel(wk)) break;
#ifdef DT_LNK
        if (de->d_type == DT_LNK) goto budget;
#endif
        wr = (job->rel[0])
                 ? snprintf(child, sizeof(child), "%s/%s", job->rel, name)
                 : snprintf(child, sizeof(child), "%s", name);
        if (wr <= 0 || (size_t)wr >= sizeof(child)) goto budget;
#ifdef DT_DIR
        if (de->d_type == DT_DIR) {
            if (rtx_browse_skip_deep(name)) goto budget;
            if (rtx_browse_scratch_kid(s, job, name) < 0) break;
            goto budget;
        }
#endif
        if (!rtx_browse_q_show(wk, deep_phase, child, 0)) goto budget;
        if (wk->q.flat && !rtx_browse_q_explicit_deep(&wk->q) && !strchr(child, '/'))
            goto budget;
        if (!rtx_browse_join(full, sizeof(full), cc_slice_cstr(job->abs), cc_slice_cstr(name))) goto budget;
        if (lstat(full, &st) != 0 || S_ISLNK(st.st_mode)) goto budget;
        if (S_ISDIR(st.st_mode)) {
            if (rtx_browse_skip_deep(name)) goto budget;
            if (rtx_browse_scratch_kid(s, job, name) < 0) break;
            goto budget;
        }
        rec = (RtxBrowseEnt){0};
        snprintf(rec.name, sizeof(rec.name), "%s", child);
        rec.has_stat = 1;
        rec.is_dir = 0;
        rec.size = (uint64_t)st.st_size;
        rec.mtime = st.st_mtime;
        if (rtx_browse_scratch_ent(s, &rec) < 0) break;
    budget:
        if (work >= RTX_BROWSE_DIR_BUDGET) {
            if (rtx_browse_scratch_resume(s, job, seen) < 0) break;
            break;
        }
    }
    closedir(dp);
}

static RtxBrowseEnt *rtx_browse_named_ent(RtxBrowse *br, const char *name) {
    size_t i;
    if (!br || !name || !name[0] || !br->ents.data) return NULL;
    for (i = 0; i < br->ents.len; i++) {
        if (strcmp(br->ents.data[i].name, name) == 0) return &br->ents.data[i];
    }
    return NULL;
}

static RtxBrowseEnt *rtx_browse_du_ent(RtxBrowse *br) {
    RtxBrowseWalk *wk = rtx_br_wk(br);
    if (!wk) return NULL;
    return rtx_browse_named_ent(br, wk->du_name);
}

static int rtx_browse_du_hold_i(RtxBrowseWalk *wk, const char *name) {
    size_t i;
    if (!wk || !name || !name[0]) return -1;
    for (i = 0; i < wk->nhold; i++) {
        if (strcmp(wk->hold[i].name, name) == 0) return (int)i;
    }
    return -1;
}

static int rtx_browse_du_have_i(const RtxBrowseWalk *wk, const char *abs) {
    size_t i;
    if (!wk || !abs || !abs[0]) return -1;
    for (i = 0; i < wk->nhave; i++) {
        if (strcmp(wk->have[i].abs, abs) == 0) return (int)i;
    }
    return -1;
}

static void rtx_browse_du_have_put(RtxBrowseWalk *wk, const char *abs,
                                  uint64_t size, int denied) {
    int slot;
    if (!wk || !abs || !abs[0]) return;
    slot = rtx_browse_du_have_i(wk, abs);
    if (slot < 0) {
        if (wk->nhave >= (size_t)RTX_BROWSE_DU_HAVE) {
            char[:] dst = cc_slice_from_buffer(
                &wk->have[0], (wk->nhave - 1) * sizeof(wk->have[0]));
            char[:] src = cc_slice_from_buffer(
                &wk->have[1], (wk->nhave - 1) * sizeof(wk->have[0]));
            dst.copy_overlap(src) !>(e) { (void)e; return; };
            wk->nhave--;
        }
        slot = (int)wk->nhave;
        wk->nhave++;
        wk->have[slot] = (RtxBrowseDuHave){0};
        snprintf(wk->have[slot].abs, sizeof(wk->have[slot].abs), "%s", abs);
    } else if ((size_t)slot + 1 < wk->nhave) {
        RtxBrowseDuHave keep = wk->have[slot];
        char[:] dst = cc_slice_from_buffer(
            &wk->have[slot],
            (wk->nhave - (size_t)slot - 1) * sizeof(wk->have[0]));
        char[:] src = cc_slice_from_buffer(
            &wk->have[slot + 1],
            (wk->nhave - (size_t)slot - 1) * sizeof(wk->have[0]));
        dst.copy_overlap(src) !>(e) { (void)e; return; };
        wk->have[wk->nhave - 1] = keep;
        slot = (int)wk->nhave - 1;
    }
    wk->have[slot].size = size;
    wk->have[slot].denied = denied ? 1 : 0;
}

static int rtx_browse_du_have_get(const RtxBrowseWalk *wk, const char *abs,
                                 uint64_t *size, int *denied) {
    int slot = rtx_browse_du_have_i(wk, abs);
    if (slot < 0) return 0;
    if (size) *size = wk->have[slot].size;
    if (denied) *denied = wk->have[slot].denied;
    return 1;
}

/* The listing's own dir (the walk's query), not br->dir: du_reapply runs
 * in a stage while the host may be editing br->dir for the next kick. */
static const char *rtx_browse_list_dir(const RtxBrowse *br) {
    const RtxBrowseWalk *wk = br ? (const RtxBrowseWalk *)br->wk : NULL;
    if (wk && wk->q.dir[0]) return wk->q.dir;
    return br ? br->dir : "";
}

static int rtx_browse_du_ent_abs(const RtxBrowse *br, const RtxBrowseEnt *e,
                                char *dst, size_t n) {
    if (!br || !e || !dst || n == 0 || !e->is_dir || e->sep) return 0;
    if (strcmp(e->name, "..") == 0) return 0;
    return rtx_browse_join(dst, n, cc_slice_cstr(rtx_browse_list_dir(br)),
                           cc_slice_cstr(e->name));
}

static void rtx_browse_du_stamp(RtxBrowseEnt *e, uint64_t size, int denied) {
    if (!e) return;
    e->sized = 1;
    e->has_stat = 1;
    e->size = size;
    e->size_done = 1;
    e->size_denied = denied ? 1 : 0;
}

static void rtx_browse_du_reapply(RtxBrowse *br) {
    RtxBrowseWalk *wk = rtx_br_wk(br);
    size_t i;
    if (!br || !wk || !br->ents.data) return;
    for (i = 0; i < br->ents.len; i++) {
        char abs[RTX_BROWSE_DIR];
        uint64_t size;
        int denied;
        if (!rtx_browse_du_ent_abs(br, &br->ents.data[i], abs, sizeof(abs)))
            continue;
        if (!rtx_browse_du_have_get(wk, abs, &size, &denied)) continue;
        rtx_browse_du_stamp(&br->ents.data[i], size, denied);
    }
}

static int rtx_browse_du_done(const RtxBrowseWalk *wk) {
    return !wk || (wk->du_sp == 0 && !wk->du_dp);
}

static void rtx_browse_du_live_reset(RtxBrowseWalk *wk) {
    if (!wk) return;
    if (wk->du_dp) {
        closedir(wk->du_dp);
        wk->du_dp = NULL;
    }
    wk->du_sp = 0;
    wk->du_name[0] = 0;
    wk->du_last[0] = 0;
    wk->du_skip[0] = 0;
}

static void rtx_browse_du_park_skip(RtxBrowseWalk *wk) {
    if (!wk || !wk->du_dp || wk->du_sp == 0) return;
    if (wk->du_skip[0])
        snprintf(wk->du_stk[wk->du_sp - 1].skip,
                 sizeof(wk->du_stk[wk->du_sp - 1].skip), "%s", wk->du_skip);
    else if (wk->du_last[0])
        snprintf(wk->du_stk[wk->du_sp - 1].skip,
                 sizeof(wk->du_stk[wk->du_sp - 1].skip), "%s", wk->du_last);
}

static int rtx_browse_du_dive(RtxBrowseWalk *wk, const char *full) {
    RtxBrowseDuFrame *cur;
    int depth;
    if (!wk || !full || !full[0] || wk->du_sp == 0) return 0;
    cur = &wk->du_stk[wk->du_sp - 1];
    depth = cur->depth;
    if (depth + 1 >= RTX_BROWSE_WALK || wk->du_sp >= (size_t)RTX_BROWSE_WALK)
        return 0;
    rtx_browse_du_park_skip(wk);
    if (wk->du_dp) {
        closedir(wk->du_dp);
        wk->du_dp = NULL;
    }
    wk->du_stk[wk->du_sp] = (RtxBrowseDuFrame){0};
    snprintf(wk->du_stk[wk->du_sp].abs, sizeof(wk->du_stk[wk->du_sp].abs),
             "%s", full);
    wk->du_stk[wk->du_sp].depth = depth + 1;
    wk->du_sp++;
    wk->du_last[0] = 0;
    wk->du_skip[0] = 0;
    return 1;
}

static void rtx_browse_du_park(RtxBrowse *br) {
    RtxBrowseWalk *wk = rtx_br_wk(br);
    RtxBrowseEnt *e;
    int slot;
    if (!br || !wk || !wk->du_name[0]) return;
    e = rtx_browse_du_ent(br);
    slot = rtx_browse_du_hold_i(wk, wk->du_name);
    if (slot < 0) {
        if (wk->nhold >= (size_t)RTX_BROWSE_DU_HOLD) {
            char[:] dst = cc_slice_from_buffer(
                &wk->hold[0], (wk->nhold - 1) * sizeof(wk->hold[0]));
            char[:] src = cc_slice_from_buffer(
                &wk->hold[1], (wk->nhold - 1) * sizeof(wk->hold[0]));
            dst.copy_overlap(src) !>(e) { (void)e; return; };
            wk->nhold--;
        }
        slot = (int)wk->nhold;
        wk->nhold++;
        wk->hold[slot] = (RtxBrowseDuHold){0};
        snprintf(wk->hold[slot].name, sizeof(wk->hold[slot].name), "%s",
                 wk->du_name);
    }
    if (wk->du_sp && wk->du_stk[0].abs[0])
        snprintf(wk->hold[slot].abs, sizeof(wk->hold[slot].abs), "%s",
                 wk->du_stk[0].abs);
    else if (e)
        rtx_browse_du_ent_abs(br, e, wk->hold[slot].abs,
                              sizeof(wk->hold[slot].abs));
    rtx_browse_du_park_skip(wk);
    wk->hold[slot].size = e ? e->size : 0;
    wk->hold[slot].denied = e && e->size_denied ? 1 : 0;
    wk->hold[slot].done = (e && e->size_done) || rtx_browse_du_done(wk);
    if (wk->hold[slot].done && wk->hold[slot].abs[0])
        rtx_browse_du_have_put(wk, wk->hold[slot].abs, wk->hold[slot].size,
                              wk->hold[slot].denied);
    if (wk->hold[slot].done) {
        wk->hold[slot].sp = 0;
    } else {
        {
            char[:] dst = cc_slice_from_buffer(
                wk->hold[slot].stk, wk->du_sp * sizeof(wk->du_stk[0]));
            char[:] src = cc_slice_from_buffer(
                wk->du_stk, wk->du_sp * sizeof(wk->du_stk[0]));
            dst.copy(src) !>(e) { (void)e; return; };
        }
        wk->hold[slot].sp = wk->du_sp;
    }
    if (e) {
        e->size_done = wk->hold[slot].done;
        e->size_denied = wk->hold[slot].denied;
    }
    br->sizing = 0;
    rtx_browse_du_live_reset(wk);
}

static int rtx_browse_du_resume(RtxBrowse *br, const char *name) {
    RtxBrowseWalk *wk = rtx_br_wk(br);
    RtxBrowseEnt *e;
    int slot;
    char abs[RTX_BROWSE_DIR];
    uint64_t have_sz;
    int have_den;
    if (!br || !wk || !name) return 0;
    e = rtx_browse_named_ent(br, name);
    if (e && rtx_browse_du_ent_abs(br, e, abs, sizeof(abs)) &&
        rtx_browse_du_have_get(wk, abs, &have_sz, &have_den)) {
        rtx_browse_du_stamp(e, have_sz, have_den);
        br->sizing = 0;
        return 1;
    }
    slot = rtx_browse_du_hold_i(wk, name);
    if (slot < 0 || !e) return 0;
    e->sized = 1;
    e->has_stat = 1;
    e->size = wk->hold[slot].size;
    e->size_done = wk->hold[slot].done;
    e->size_denied = wk->hold[slot].denied;
    if (wk->hold[slot].done || wk->hold[slot].denied) {
        br->sizing = 0;
        return 1;
    }
    snprintf(wk->du_name, sizeof(wk->du_name), "%s", name);
    {
        char[:] dst = cc_slice_from_buffer(
            wk->du_stk, wk->hold[slot].sp * sizeof(wk->du_stk[0]));
        char[:] src = cc_slice_from_buffer(
            wk->hold[slot].stk, wk->hold[slot].sp * sizeof(wk->du_stk[0]));
        dst.copy(src) !>(e) { (void)e; return 0; };
    }
    wk->du_sp = wk->hold[slot].sp;
    wk->du_last[0] = 0;
    wk->du_skip[0] = 0;
    br->sizing = 1;
    return 1;
}

static void rtx_browse_du_start(RtxBrowse *br, RtxBrowseEnt *ent) {
    RtxBrowseWalk *wk = rtx_br_wk(br);
    char full[RTX_BROWSE_DIR];
    if (!br || !wk || !ent) return;
    if (!rtx_browse_join(full, sizeof(full), cc_slice_cstr(rtx_browse_list_dir(br)),
                         cc_slice_cstr(ent->name)))
        return;
    snprintf(wk->du_name, sizeof(wk->du_name), "%s", ent->name);
    wk->du_stk[0] = (RtxBrowseDuFrame){0};
    snprintf(wk->du_stk[0].abs, sizeof(wk->du_stk[0].abs), "%s", full);
    wk->du_sp = 1;
    wk->du_last[0] = 0;
    wk->du_skip[0] = 0;
    ent->size = 0;
    ent->sized = 1;
    ent->size_done = 0;
    ent->size_denied = 0;
    ent->has_stat = 1;
    br->sizing = 1;
}

static void rtx_browse_du_retarget(RtxBrowse *br) {
    RtxBrowseWalk *wk;
    RtxBrowseEnt *ent;
    if (rtx_browse_hold_on(br)) {
        rtx_browse_du_park(br);
        return;
    }
    if (!br || br->no_du || !br->ents.data || br->ents.len == 0 ||
        br->cur >= br->ents.len) {
        rtx_browse_du_park(br);
        return;
    }
    ent = &br->ents.data[br->cur];
    wk = rtx_br_wk(br);
    if (ent->is_dir && ent->size_done) {
        rtx_browse_du_park(br);
        return;
    }
    {
        char abs[RTX_BROWSE_DIR];
        uint64_t size;
        int denied;
        if (wk && rtx_browse_du_ent_abs(br, ent, abs, sizeof(abs)) &&
            rtx_browse_du_have_get(wk, abs, &size, &denied)) {
            rtx_browse_du_stamp(ent, size, denied);
            rtx_browse_du_park(br);
            return;
        }
    }
    if (wk && br->sizing && wk->du_name[0] &&
        strcmp(wk->du_name, ent->name) == 0)
        return;
    rtx_browse_du_park(br);
    if (!ent->is_dir || strcmp(ent->name, "..") == 0) return;
    if (rtx_browse_du_resume(br, ent->name)) {
        if (br->sizing && wk) wk->du_defer = 1;
        return;
    }
    rtx_browse_du_start(br, ent);
    if (br->sizing && wk) wk->du_defer = 1;
}

static size_t rtx_browse_pump_du(RtxBrowse *br) {
    RtxBrowseWalk *wk;
    RtxBrowseEnt *e;
    int work = 0;
    long t0;
    if (!br || !br->sizing) return 0;
    wk = rtx_br_wk(br);
    t0 = rtx_browse_now_ms();
    e = rtx_browse_du_ent(br);
    if (!wk || !e) {
        br->sizing = 0;
        rtx_browse_du_live_reset(wk);
        return 0;
    }
    for (;;) {
        struct dirent *de;
        const char *name;
        char full[RTX_BROWSE_DIR];
        struct stat st;
        RtxBrowseDuFrame *cur;
        int hint_dir, hint_lnk;
        if (work >= RTX_BROWSE_DU) break;
        if (work > 0 && rtx_browse_now_ms() - t0 >= (long)RTX_BROWSE_DU_MS)
            break;
        if (!wk->du_dp) {
            if (wk->du_sp == 0) {
                br->sizing = 0;
                rtx_browse_du_park(br);
                return (size_t)work;
            }
            cur = &wk->du_stk[wk->du_sp - 1];
            wk->du_dp = opendir(cur->abs);
            work++;
            if (!wk->du_dp) {
                if ((errno == EACCES || errno == EPERM) && cur->depth == 0) {
                    e->size_denied = 1;
                    e->size_done = 1;
                    br->sizing = 0;
                    rtx_browse_du_park(br);
                    return (size_t)work;
                }
                wk->du_sp--;
                wk->du_last[0] = 0;
                wk->du_skip[0] = 0;
                continue;
            }
            snprintf(wk->du_skip, sizeof(wk->du_skip), "%s", cur->skip);
            wk->du_last[0] = 0;
            if (work >= RTX_BROWSE_DU) break;
        }
        de = readdir(wk->du_dp);
        if (!de) {
            closedir(wk->du_dp);
            wk->du_dp = NULL;
            if (wk->du_sp) wk->du_sp--;
            wk->du_last[0] = 0;
            wk->du_skip[0] = 0;
            continue;
        }
        name = de->d_name;
        if (!name || strcmp(name, ".") == 0 || strcmp(name, "..") == 0)
            continue;
        if (wk->du_skip[0]) {
            if (strcmp(name, wk->du_skip) != 0) continue;
            wk->du_skip[0] = 0;
            continue;
        }
        snprintf(wk->du_last, sizeof(wk->du_last), "%s", name);
        hint_dir = 0;
        hint_lnk = 0;
#ifdef DT_DIR
        hint_dir = (de->d_type == DT_DIR);
        hint_lnk = (de->d_type == DT_LNK);
#endif
        if (hint_lnk) continue;
        if (!rtx_browse_join(full, sizeof(full),
                             cc_slice_cstr(wk->du_stk[wk->du_sp - 1].abs),
                             cc_slice_cstr(name)))
            continue;
        if (hint_dir) {
            rtx_browse_du_dive(wk, full);
            continue;
        }
        work++;
        if (lstat(full, &st) != 0 || S_ISLNK(st.st_mode)) continue;
        if (S_ISDIR(st.st_mode)) {
            rtx_browse_du_dive(wk, full);
            continue;
        }
        e->size += (uint64_t)st.st_size;
    }
    if (rtx_browse_du_done(wk)) {
        br->sizing = 0;
        rtx_browse_du_park(br);
    }
    return (size_t)work;
}

static size_t rtx_browse_sep_i(const RtxBrowse *br) {
    if (!br || !br->ents.data) return (size_t)-1;
    @for (i, e in br->ents) {
        if (e.sep) return i;
    }
    return (size_t)-1;
}

static size_t rtx_browse_sep_last(const RtxBrowse *br) {
    size_t last = (size_t)-1;
    if (!br || !br->ents.data) return last;
    @for (i, e in br->ents) {
        if (e.sep) last = i;
    }
    return last;
}

static void rtx_browse_sort_keep(RtxBrowse *br) {
    size_t from, sep;
    RtxBrowseWalk *wk = rtx_br_wk(br);
    rtx_browse_detach_pub(br);
    if (!br || br->ents.len <= 1) {
        rtx_browse_keep_cur(br, br && br->wk ? rtx_br_wk(br)->keep : NULL);
        rtx_browse_du_reapply(br);
        return;
    }
    sep = rtx_browse_sep_last(br);
    if (wk && wk->deep_phase && sep != (size_t)-1) {
        if (br->ents.len > sep + 1)
            qsort(br->ents.data + sep + 1, br->ents.len - sep - 1, sizeof(RtxBrowseEnt),
                  rtx_browse_cmp);
        rtx_browse_keep_cur(br, br->wk ? rtx_br_wk(br)->keep : NULL);
        rtx_browse_du_reapply(br);
        return;
    }
    from = rtx_browse_is_root(cc_slice_cstr(wk ? wk->q.dir : br->dir)) ? 0 : 1;
    if (br->ents.len > from)
        qsort(br->ents.data + from, br->ents.len - from, sizeof(RtxBrowseEnt),
              rtx_browse_cmp);
    rtx_browse_keep_cur(br, br->wk ? rtx_br_wk(br)->keep : NULL);
    rtx_browse_du_reapply(br);
}

static int rtx_browse_plant_flat_row(RtxBrowse *br) {
    RtxBrowseEnt rec;
    if (!br) return -1;
    if (rtx_browse_sep_i(br) != (size_t)-1) return 0;
    rec = (RtxBrowseEnt){0};
    rec.sep = 1;
    if (rtx_browse_push(br, &rec) < 0) return -1;
    rec = (RtxBrowseEnt){0};
    rec.sep = 1;
    snprintf(rec.name, sizeof(rec.name), "> Flattened search");
    return rtx_browse_push(br, &rec);
}

static void rtx_browse_begin_flat(RtxBrowse *br) {
    RtxBrowseWalk *wk = rtx_br_wk(br);
    RtxBrowseJob job = {0};
    if (!br || !wk || wk->deep_phase) return;
    if (rtx_browse_plant_flat_row(br) < 0) return;
    /* One deep job on this folder. Waves walk children; do not stat every
     * sibling on this write-stage turn (a /code-sized listing froze kick). */
    snprintf(job.abs, sizeof(job.abs), "%s", wk->q.dir);
    job.depth = 1;
    wk->deep_phase = 1;
    if (rtx_browse_job_push(br, &job) < 0) return;
    if (wk->jhead < wk->jlen) br->scanning = 1;
}

static void rtx_browse_shallow_done(RtxBrowse *br) {
    RtxBrowseWalk *wk = rtx_br_wk(br);
    rtx_browse_sort_keep(br);
    if (wk && wk->q.flat) rtx_browse_begin_flat(br);
}

static int rtx_browse_plant_dotdot(RtxBrowse *br) {
    char parent[RTX_BROWSE_DIR];
    RtxBrowseEnt rec = {0};
    if (!br || rtx_browse_is_root(cc_slice_cstr(br->dir))) return 0;
    snprintf(rec.name, sizeof(rec.name), "..");
    rec.is_dir = 1;
    if (rtx_browse_join(parent, sizeof(parent), cc_slice_cstr(br->dir), ".."))
        rtx_browse_stat_path(parent, &rec);
    rec.is_dir = 1;
    if (rtx_browse_push(br, &rec) < 0) return -1;
    return 0;
}

static void !>(CCError) rtx_browse_restart(RtxBrowse *br, int keep_list) {
    char keep[RTX_BROWSE_NAME];
    RtxBrowseDuHave keep_have[RTX_BROWSE_DU_HAVE];
    size_t n_have = 0;
    RtxBrowseWalk *old;
    if (!br || !br->dir[0]) return cc_err(CC_ERR_INVALID_ARG, "browse dir");
    rtx_browse_join_for_host(br);
    keep[0] = 0;
    if (keep_list && rtx_browse_hold_on(br) && br->hold_cur < br->hold_len)
        snprintf(keep, sizeof(keep), "%s", br->hold[br->hold_cur].name);
    else if (br->ents.data && br->cur < br->ents.len)
        snprintf(keep, sizeof(keep), "%s", br->ents.data[br->cur].name);
    else if (br->keep[0])
        snprintf(keep, sizeof(keep), "%s", br->keep);
    if (keep_list) {
        if (!rtx_browse_hold_on(br))
            rtx_browse_hold_save(br);
    } else {
        rtx_browse_hold_drop(br);
    }
    br->hold_drop_later = 0;
    rtx_browse_du_park(br);
    old = rtx_br_wk(br);
    if (old) {
        n_have = old->nhave;
        if (n_have) {
            char[:] dst = cc_slice_from_buffer(keep_have, n_have * sizeof(keep_have[0]));
            char[:] src = cc_slice_from_buffer(old->have, n_have * sizeof(keep_have[0]));
            dst.copy(src) !>(e) { return cc_err(e); };
        }
    }
    rtx_browse_walk_stop(br);
    atomic_store_explicit(&br->pub, NULL, memory_order_release);
    if (br->store.base) br->store.reset();
    else {
        br->store = cc_arena_heap(kilobytes(8));
        if (!br->store.base) return cc_err(CC_ERR_OUT_OF_MEMORY, "browse");
    }
    /* Walk embeds CCParallel — keep it on calloc, not a bump arena. */
    br->wk = (RtxBrowseWalk *)calloc(1, sizeof(RtxBrowseWalk));
    if (!br->wk) return cc_err(CC_ERR_OUT_OF_MEMORY, "browse walk");
    rtx_br_wk(br)->arena = cc_arena_heap(kilobytes(8));
    if (!rtx_br_wk(br)->arena.base) {
        free(br->wk);
        br->wk = NULL;
        return cc_err(CC_ERR_OUT_OF_MEMORY, "browse walk");
    }
    br->ents = vec_new::[RtxBrowseEnt](br->store);
    if (!br->ents.data) return cc_err(CC_ERR_OUT_OF_MEMORY, "browse ents");
    snprintf(rtx_br_wk(br)->keep, sizeof(rtx_br_wk(br)->keep), "%s", keep);
    br->scanning = 1;
    br->flat = rtx_browse_auto_flat(br);
    {
        RtxBrowseQ *q = &rtx_br_wk(br)->q;
        snprintf(q->dir, sizeof(q->dir), "%s", br->dir);
        q->glob_len = br->glob_len < sizeof(q->glob) ? br->glob_len
                                                     : sizeof(q->glob) - 1;
        {
            char[:] dst = cc_slice_from_buffer(q->glob, q->glob_len);
            char[:] src = cc_slice_from_buffer(br->glob, q->glob_len);
            dst.copy(src) !>(e) { return cc_err(e); };
        }
        q->glob[q->glob_len] = 0;
        q->flat = br->flat;
    }
    br->truncated = 0;
    br->denied = 0;
    /* `>` is flatten without the typed-fragment chrome. Start deep so the
     * first ticket walks files and enqueues dirs — shallow_done only
     * begin_flat()s when br->flat. */
    if (rtx_browse_explicit_deep(br))
        rtx_br_wk(br)->deep_phase = 1;
    if (rtx_browse_plant_dotdot(br) < 0)
        return cc_err(CC_ERR_OUT_OF_MEMORY, "browse");
    {
        RtxBrowseJob job = {0};
        snprintf(job.abs, sizeof(job.abs), "%s", br->dir);
        if (rtx_browse_job_push(br, &job) < 0)
            return cc_err(CC_ERR_OUT_OF_MEMORY, "browse job");
    }
    old = rtx_br_wk(br);
    if (old) {
        old->nhave = n_have;
        if (n_have) {
            char[:] dst = cc_slice_from_buffer(old->have, n_have * sizeof(old->have[0]));
            char[:] src = cc_slice_from_buffer(keep_have, n_have * sizeof(old->have[0]));
            dst.copy(src) !>(e) { return cc_err(e); };
        }
    }
    rtx_browse_du_reapply(br);
    return rtx_browse_listing_start(br);
}

void !>(CCError) rtx_browse_kick(RtxBrowse *br) {
    return rtx_browse_restart(br, 0);
}

void !>(CCError) rtx_browse_kick_keep(RtxBrowse *br) {
    return rtx_browse_restart(br, 1);
}

static _Atomic int g_browse_fail_waves;

void rtx_browse_test_fail_waves(int n) {
    atomic_store(&g_browse_fail_waves, n);
}

int rtx_browse_test_fail_left(void) {
    return atomic_load(&g_browse_fail_waves);
}

/* A wave that cannot run (turnstile / wait error) gives up here and says
 * so (`capped`). It is not pending: the pump must not restart it. */
static void rtx_browse_wave_fail(RtxBrowse *br) {
    RtxBrowseWalk *wk = rtx_br_wk(br);
    if (!br) return;
    br->truncated = 1;
    br->scanning = 0;
    rtx_browse_store_done(wk, 1);
    rtx_browse_publish(br);
}

/* Jobs before jhead are walked. Slide the rest down between waves (no
 * worker holds an index then) so a long walk does not grow the table. */
static void rtx_browse_jobs_compact(RtxBrowseWalk *wk) {
    size_t live;
    if (!wk || !wk->jobs || wk->jhead == 0) return;
    if (wk->jhead < wk->jlen - wk->jhead && wk->jhead < 64) return;
    live = wk->jlen - wk->jhead;
    if (live) {
        char[:] dst = cc_slice_from_buffer(wk->jobs, live * sizeof(RtxBrowseJob));
        char[:] src = cc_slice_from_buffer(wk->jobs + wk->jhead,
                                           live * sizeof(RtxBrowseJob));
        dst.copy_overlap(src) !>(e) { (void)e; return; };
    }
    wk->jlen = live;
    wk->jhead = 0;
}

/* Wait-for tickets. Joined inside this arm so the dest-live kick returns. */
static int rtx_browse_run(RtxBrowse *br) {
    RtxBrowseWalk *wk;
    @errhandler(CCError e) {
        (void)e;
        rtx_browse_wave_scratch_free(rtx_br_wk(br));
        rtx_browse_wave_fail(br);
        return 0;
    }
    if (!br) return 0;
    wk = rtx_br_wk(br);
    if (!wk) return 0;
    if (atomic_load(&g_browse_fail_waves) > 0) {
        atomic_fetch_sub(&g_browse_fail_waves, 1);
        rtx_browse_wave_fail(br);
        return 0;
    }
    rtx_browse_jobs_compact(wk);

    if (!rtx_browse_load_cancel(wk) && !br->truncated && wk->jhead < wk->jlen) {
        size_t base = wk->jhead;
        size_t remain = wk->jlen - base;
        size_t n_sz;
        int n;
        int i;
        int deep0;
        bool fin;
        RtxBrowseJob *wave = wk->wave;
        RtxBrowseScratch *wslot = wk->wslot;
        CCArena ta = cc_arena_heap(kilobytes(64)) @destroy;
        CCTurnstile ts@(RTX_BROWSE_CAP, 1, ta) !> @destroy;

        n_sz = remain;
        if (n_sz > (size_t)RTX_BROWSE_WAVE) n_sz = (size_t)RTX_BROWSE_WAVE;
        n = (int)n_sz;
        /* Lanes read the wave's own copy of their jobs and of deep_phase:
         * a stage's job_push grows (moves) wk->jobs and begin_flat sets
         * deep_phase while later bodies of this wave still start. Stages
         * own the walk; bodies see only this snapshot and the atomics. */
        {
            char[:] dst = cc_slice_from_buffer(wave, n_sz * sizeof(RtxBrowseJob));
            char[:] src = cc_slice_from_buffer(wk->jobs + base,
                                               n_sz * sizeof(RtxBrowseJob));
            dst.copy(src) !>;
        }
        deep0 = wk->deep_phase;
        atomic_store_explicit(&wk->wave_stop, 0, memory_order_relaxed);

        rtx_browse_wave_scratch_free(wk);
        fin = @parallel wait (ts) for (i in 0..n) {
            RtxBrowseJob job;
            RtxBrowseScratch *slot;
            int shallow;

            job = wave[i];
            slot = &wslot[i];
            shallow = (job.depth == 0 && !deep0);
            if (!rtx_browse_load_cancel(wk) && !rtx_browse_wave_stopped(wk)) {
                if (shallow)
                    rtx_browse_collect_shallow(wk, deep0, &job, slot);
                else
                    rtx_browse_collect_deep(wk, deep0, &job, slot);
            }

            @stage (ts, 0, i) {
                size_t k;
                while (wk->h.paused && !rtx_browse_load_cancel(wk))
                    cc_yield();
                if (!rtx_browse_load_cancel(wk) && !br->truncated) {
                    if (slot->denied) br->denied = 1;
                    for (k = 0; k < slot->n && !br->truncated; k++) {
                        if (rtx_browse_push(br, &slot->ents[k]) < 0)
                            br->truncated = 1;
                    }
                    for (k = 0; k < slot->kn && !br->truncated; k++) {
                        if (rtx_browse_job_push(br, &slot->kids[k]) < 0)
                            br->truncated = 1;
                    }
                    wk->jhead = base + (size_t)i + 1;
                    if (shallow && !br->truncated && !rtx_browse_load_cancel(wk))
                        rtx_browse_shallow_done(br);
                }
                if (br->truncated)
                    atomic_store_explicit(&wk->wave_stop, 1, memory_order_release);
            }

            rtx_browse_scratch_free(slot);
            if (rtx_browse_load_cancel(wk) || rtx_browse_wave_stopped(wk))
                break;
        } !>.wait()!>;
        (void)fin;
        rtx_browse_wave_scratch_free(wk);
    }

    if (rtx_browse_load_cancel(wk) || br->truncated || wk->jhead >= wk->jlen) {
        br->scanning = 0;
        rtx_browse_sort_keep(br);
        rtx_browse_hold_maybe_drop(br);
    }
    rtx_browse_store_done(wk, 1);
    rtx_browse_publish(br);
    return rtx_browse_load_cancel(wk) ? 0 : 1;
}

static void !>(CCError) rtx_browse_listing_start(RtxBrowse *br) {
    RtxBrowseWalk *wk = rtx_br_wk(br);
    int noop = 0;
    if (!br || !wk) return cc_err(CC_ERR_INVALID_ARG, "browse kick");
    if (wk->h.live()) return cc_ok();
    rtx_browse_store_done(wk, 0);
    rtx_browse_publish(br);
    if (rtx_parallel_inline()) {
        rtx_browse_run(br);
        return cc_ok();
    }
    wk->h = @parallel {
        @serial { noop = 0; }
        rtx_browse_run(br);
    } !>;
    return cc_ok();
}

void rtx_browse_pause(RtxBrowse *br) {
    RtxBrowseWalk *wk = rtx_br_wk(br);
    if (!wk || !wk->h.live()) return;
    wk->h.pause() !>(e) { (void)e; };
}

void rtx_browse_resume(RtxBrowse *br) {
    RtxBrowseWalk *wk = rtx_br_wk(br);
    if (!wk || !wk->h.live() || !wk->h.paused()) return;
    wk->h.resume() !>(e) { (void)e; };
}

int rtx_browse_paused(const RtxBrowse *br) {
    RtxBrowseWalk *wk = rtx_br_wk((RtxBrowse *)br);
    if (!wk || !wk->h.live()) return 0;
    return wk->h.paused() ? 1 : 0;
}

static int rtx_browse_listing_pending(RtxBrowse *br) {
    RtxBrowseWalk *wk = rtx_br_wk(br);
    if (!br || !wk || !br->scanning) return 0;
    if (rtx_browse_load_cancel(wk) || br->truncated) return 0;
    return wk->jhead < wk->jlen;
}

/* A move while the arm was live indexed the published view (a wave or the
 * hold list). After the join the list is sorted / replaced: follow the
 * name, not the index. */
static void rtx_browse_host_apply(RtxBrowse *br) {
    const RtxBrowseEnt *ents;
    size_t len, i;
    size_t *cur, *top;
    if (!br || !br->host_nav) return;
    br->host_nav = 0;
    if (rtx_browse_hold_on(br)) {
        ents = br->hold;
        len = br->hold_len;
        cur = &br->hold_cur;
        top = &br->hold_top;
    } else {
        ents = br->ents.data;
        len = br->ents.len;
        cur = &br->cur;
        top = &br->top;
    }
    *cur = br->host_cur;
    *top = br->host_top;
    if (br->host_name[0] && ents) {
        for (i = 0; i < len; i++) {
            if (!ents[i].sep && strcmp(ents[i].name, br->host_name) == 0) {
                *cur = i;
                break;
            }
        }
    }
    if (len == 0) *cur = 0;
    else if (*cur >= len) *cur = len - 1;
    if (*top > *cur) *top = *cur;
    br->host_name[0] = 0;
}

/* Dest-live stays live() until wait, even after the wave body returns. */
static void !>(CCError) rtx_browse_listing_join_done(RtxBrowse *br) {
    RtxBrowseWalk *wk = rtx_br_wk(br);
    if (!wk || !wk->h.live() || !rtx_browse_load_done(wk)) return cc_ok();
    if (wk->h.paused())
        wk->h.resume() !>(e) { return cc_err(CC_ERR_IO, cc_io_error_str(e)); };
    wk->h.wait() !>(e) { return cc_err(e); };
    return cc_ok();
}

size_t !>(CCError) rtx_browse_pump(RtxBrowse *br) {
    size_t n = 0;
    RtxBrowseWalk *wk;
    if (!br) return cc_err(CC_ERR_INVALID_ARG, "browse");
    rtx_host_reap();
    rtx_browse_listing_join_done(br) !>(e) { return cc_err(e); };
    wk = rtx_br_wk(br);
    /* One wave is the step. sched_yield does not run the fiber, and a
     * lost worker wake only gets the ~20ms sysmon tick — a tight pump
     * loop gives up first. Do not join a paused stage: it is parked
     * until resume, and wait would hang the frame. */
    if (wk && wk->h.live() && !rtx_browse_load_done(wk)) {
        if (wk->h.paused())
            cc_yield();
        else
            wk->h.wait() !>(e) { return cc_err(e); };
    }
    rtx_browse_listing_join_done(br) !>(e) { return cc_err(e); };
    wk = rtx_br_wk(br);
    /* Retarget and du read / stamp ents and the walk's du table. Only
     * after the arm is joined (a paused stage is still the writer) and
     * before the next wave is kicked — a live wave pushes (moves) ents
     * and sort_keep re-stamps them from `have`. */
    if (wk && wk->h.live()) return cc_ok(n);
    rtx_browse_host_apply(br);
    rtx_browse_hold_drop_joined(br);
    rtx_browse_du_retarget(br);
    wk = rtx_br_wk(br);
    if (wk && wk->du_defer)
        wk->du_defer = 0;
    else if (br->sizing)
        n += rtx_browse_pump_du(br);
    wk = rtx_br_wk(br);
    if (wk && rtx_browse_listing_pending(br))
        rtx_browse_listing_start(br) !>(e) { return cc_err(e); };
    return cc_ok(n);
}

void !>(CCError) rtx_browse_finish(RtxBrowse *br) {
    RtxBrowseWalk *wk;
    int n = 0;
    int guard = 0;
    if (!br) return cc_err(CC_ERR_INVALID_ARG, "browse");
    while (guard++ < 1000000) {
        wk = rtx_br_wk(br);
        if (wk && wk->h.live()) {
            if (wk->h.paused())
                wk->h.resume() !>(e) { return cc_err(CC_ERR_IO, cc_io_error_str(e)); };
            wk->h.wait() !>(e) { return cc_err(e); };
            continue;
        }
        if (rtx_browse_listing_pending(br)) {
            rtx_browse_listing_start(br) !>(e) { return cc_err(e); };
            continue;
        }
        break;
    }
    br->scanning = 0;
    rtx_browse_host_apply(br);
    rtx_browse_hold_drop_joined(br);
    /* Listing is joined. Start du for the current row if needed — the
     * while (sizing) loop used to skip when retarget had not run yet.
     * du_defer is a one-turn skip for a key; finish is not a key. */
    wk = rtx_br_wk(br);
    if (wk) wk->du_defer = 0;
    rtx_browse_du_retarget(br);
    wk = rtx_br_wk(br);
    if (wk) wk->du_defer = 0;
    while (br->sizing && n++ < 100000) {
        wk = rtx_br_wk(br);
        if (wk) wk->du_defer = 0;
        rtx_browse_pump(br) !>(e) { return cc_err(e); };
    }
    return cc_ok();
}

void rtx_browse_drop(RtxBrowse *br) {
    if (!br) return;
    rtx_browse_walk_stop(br);
    rtx_browse_hold_drop(br);
    if (br->store.base) br->store.destroy();
    *br = (RtxBrowse){0};
}

int rtx_browse_is_root(char[:0] dir) {
    return dir.ptr && dir.len == 1 && dir.ptr[0] == '/';
}

void rtx_browse_basename(char *dst, size_t n, char[:0] path) {
    const char *slash;
    if (!dst || n == 0) return;
    dst[0] = 0;
    if (!path.ptr || path.len == 0) return;
    slash = strrchr(path.ptr, '/');
    snprintf(dst, n, "%s", slash ? slash + 1 : path.ptr);
}

void rtx_browse_dirname(char *dst, size_t n, char[:0] path) {
    const char *slash;
    size_t len;
    if (!dst || n == 0) return;
    if (!path.ptr || path.len == 0) {
        snprintf(dst, n, ".");
        return;
    }
    slash = strrchr(path.ptr, '/');
    if (!slash) {
        snprintf(dst, n, ".");
        return;
    }
    if (slash == path.ptr) {
        snprintf(dst, n, "/");
        return;
    }
    len = (size_t)(slash - path.ptr);
    if (len >= n) len = n - 1;
    {
        char[:] d = cc_slice_from_buffer(dst, len);
        char[:] s = cc_slice_from_buffer((void *)path.ptr, len);
        d.copy(s) !>(e) { (void)e; return; };
    }
    dst[len] = 0;
}

int rtx_browse_abs(char *dst, size_t n, char[:0] path) {
    char raw[RTX_BROWSE_DIR];
    char resolved[PATH_MAX];
    if (!dst || n == 0) return 0;
    dst[0] = 0;
    if (!path.ptr || path.len == 0 || strcmp(path.ptr, ".") == 0) {
        cc_arena_stack(scratch, 1024);
        CCSlice cwd = cc_dir_cwd(scratch);
        if (!(cwd.ptr && cwd.len)) return 0;
        snprintf(raw, sizeof(raw), "%s", cwd.ptr);
    } else if (path.ptr[0] == '/') {
        snprintf(raw, sizeof(raw), "%s", path.ptr);
    } else {
        cc_arena_stack(scratch, 1024);
        CCSlice cwd = cc_dir_cwd(scratch);
        if (cwd.ptr && cwd.len)
            snprintf(raw, sizeof(raw), "%s/%s", cwd.ptr, path.ptr);
        else
            snprintf(raw, sizeof(raw), "%s", path.ptr);
    }
    if (realpath(raw, resolved) && resolved[0]) {
        if (strlen(resolved) >= n) return 0;
        snprintf(dst, n, "%s", resolved);
        return 1;
    }
    if (!raw[0] || strlen(raw) >= n) return 0;
    snprintf(dst, n, "%s", raw);
    return 1;
}

int rtx_browse_join(char *dst, size_t n, char[:0] dir, char[:0] name) {
    int wr;
    char abs[RTX_BROWSE_DIR];
    if (!dst || n == 0 || !dir.ptr || !name.ptr) return 0;
    if (strcmp(name.ptr, "..") == 0) {
        if (!rtx_browse_abs(abs, sizeof(abs), dir)) return 0;
        rtx_browse_dirname(dst, n, cc_slice_cstr(abs));
        return dst[0] != 0;
    }
    if (strcmp(dir.ptr, "/") == 0) wr = snprintf(dst, n, "/%s", name.ptr);
    else wr = snprintf(dst, n, "%s/%s", dir.ptr, name.ptr);
    return wr > 0 && (size_t)wr < n;
}

RtxThemeColor rtx_browse_face(RtxBrowseFace face) {
    RtxThemeColor z;
    z.r = 230; z.g = 230; z.b = 230; z.ansi = "\x1b[0m";
    switch (face) {
    case RTX_BROWSE_FACE_PATH:
        z.r = 120; z.g = 160; z.b = 210; z.ansi = "\x1b[34m";
        break;
    case RTX_BROWSE_FACE_GLOB:
        z.r = 220; z.g = 180; z.b = 80; z.ansi = "\x1b[33m";
        break;
    case RTX_BROWSE_FACE_DIR:
        z.r = 80; z.g = 200; z.b = 220; z.ansi = "\x1b[36;1m";
        break;
    case RTX_BROWSE_FACE_FILE:
        z.r = 230; z.g = 230; z.b = 230; z.ansi = "\x1b[37m";
        break;
    case RTX_BROWSE_FACE_SIZE:
        z.r = 220; z.g = 180; z.b = 80; z.ansi = "\x1b[33m";
        break;
    case RTX_BROWSE_FACE_DATE:
        z.r = 140; z.g = 140; z.b = 140; z.ansi = "\x1b[90m";
        break;
    case RTX_BROWSE_FACE_HIT:
        z.r = 255; z.g = 220; z.b = 80; z.ansi = "\x1b[43;30m";
        break;
    case RTX_BROWSE_FACE_EXT:
        z.r = 120; z.g = 210; z.b = 130; z.ansi = "\x1b[32m";
        break;
    case RTX_BROWSE_FACE_DENY:
        z.r = 255; z.g = 255; z.b = 255; z.ansi = "\x1b[41;97m";
        break;
    }
    return z;
}

const char *rtx_browse_scan_msg(const RtxBrowse *br) {
    if (!br) return "";
    if (rtx_browse_scanning(br)) return "  scanning...";
    if (br->sizing) return "  sizing...";
    if (rtx_browse_denied(br)) return "  denied";
    if (rtx_browse_truncated(br)) return "  capped";
    return "";
}

void rtx_browse_fmt_size(char *dst, size_t n, const RtxBrowseEnt *e) {
    uint64_t s;
    double v;
    char u;
    if (!dst || n == 0) return;
    if (!e || !e->has_stat || (e->is_dir && !e->sized && !e->size_denied)) {
        snprintf(dst, n, "%*s", RTX_BROWSE_SIZE_W, "");
        return;
    }
    if (e->is_dir && e->size_denied) {
        snprintf(dst, n, "%*s", RTX_BROWSE_SIZE_W, "denied");
        return;
    }
    s = e->size;
    if (s < 1024ull) {
        snprintf(dst, n, "%*llu", RTX_BROWSE_SIZE_W, (unsigned long long)s);
        return;
    }
    if (s < 1024ull * 1024) {
        v = (double)s / 1024.0;
        u = 'K';
    } else if (s < 1024ull * 1024 * 1024) {
        v = (double)s / (1024.0 * 1024.0);
        u = 'M';
    } else {
        v = (double)s / (1024.0 * 1024.0 * 1024.0);
        u = 'G';
    }
    snprintf(dst, n, "%*.1f%c", RTX_BROWSE_SIZE_W - 1, v, u);
}

void rtx_browse_fmt_mtime(char *dst, size_t n, const RtxBrowseEnt *e) {
    struct tm tm;
    if (!dst || n == 0) return;
    if (!e || !e->has_stat || !localtime_r(&e->mtime, &tm) ||
        strftime(dst, n, "%Y-%m-%d %H:%M", &tm) == 0) {
        snprintf(dst, n, "%*s", RTX_BROWSE_MTIME_W, "");
    }
}

void rtx_browse_fmt_meta(char *dst, size_t n, const RtxBrowseEnt *e) {
    char size[12];
    char when[24];
    rtx_browse_fmt_size(size, sizeof(size), e);
    rtx_browse_fmt_mtime(when, sizeof(when), e);
    snprintf(dst, n, "%s  %s", size, when);
}

void rtx_browse_fmt_row(char *dst, size_t n, int cols, const RtxBrowseEnt *e) {
    char name[RTX_BROWSE_NAME + 2];
    char size[12];
    char when[24];
    int meta = RTX_BROWSE_SIZE_W + 2 + RTX_BROWSE_MTIME_W;
    int name_w, i, show, size_at;

    if (!dst || n == 0) return;
    dst[0] = 0;
    if (!e) return;
    if (cols < 2) cols = 2;
    if ((size_t)cols >= n) cols = (int)n - 1;
    {
        char[:] d = cc_slice_from_buffer(dst, (size_t)cols);
        d.fill(' ') !>(e) { (void)e; return; };
    }
    dst[cols] = 0;

    snprintf(name, sizeof(name), "%s%s", e->name, e->is_dir ? "/" : "");
    show = !e->sep && cols >= 10 + meta;
    size_at = show ? cols - meta : cols;
    name_w = size_at - 2;
    if (name_w < 1) name_w = 1;
    {
        size_t head_n = 0, tail_off = 0;
        int ellip = 0;
        rtx_browse_name_window(name, name_w, &head_n, &tail_off, &ellip);
        i = 0;
        if (ellip) {
            size_t k;
            for (k = 0; k < head_n && i < name_w; k++, i++)
                dst[1 + i] = name[k];
            if (i < name_w) dst[1 + i++] = '~';
            for (k = tail_off; name[k] && i < name_w; k++, i++)
                dst[1 + i] = name[k];
        } else {
            for (; name[i] && i < name_w; i++)
                dst[1 + i] = name[i];
        }
    }
    if (!show) return;
    rtx_browse_fmt_size(size, sizeof(size), e);
    rtx_browse_fmt_mtime(when, sizeof(when), e);
    for (i = 0; size[i] && size_at + i < cols; i++)
        dst[size_at + i] = size[i];
    for (i = 0; when[i] && cols - RTX_BROWSE_MTIME_W + i < cols; i++)
        dst[cols - RTX_BROWSE_MTIME_W + i] = when[i];
}

size_t rtx_browse_dir_prefix(const char *name) {
    const char *slash;
    if (!name) return 0;
    slash = strrchr(name, '/');
    if (!slash) return 0;
    return (size_t)(slash - name + 1);
}

int rtx_browse_head(const RtxBrowse *br) {
    (void)br;
    return RTX_BROWSE_HEAD;
}

/* Host move on the live view: index for paint, name for after the join. */
static void rtx_browse_host_pin(RtxBrowse *br, const RtxBrowsePub *v, size_t c,
                                size_t t) {
    br->host_cur = c;
    br->host_top = t;
    br->host_nav = 1;
    if (v && v->ents && c < v->len && !v->ents[c].sep)
        snprintf(br->host_name, sizeof(br->host_name), "%s", v->ents[c].name);
    else
        br->host_name[0] = 0;
}

void rtx_browse_scroll(RtxBrowse *br, int vis) {
    size_t list;
    size_t len;
    size_t *cur;
    size_t *top;
    int head;
    if (!br) return;
    head = rtx_browse_head(br);
    list = (vis > head) ? (size_t)(vis - head) : 1;
    if (rtx_browse_listing_live(br)) {
        RtxBrowsePub *p =
            atomic_load_explicit(&br->pub, memory_order_acquire);
        RtxBrowsePub v = rtx_browse_view_snap(br);
        size_t c = v.cur;
        size_t t = v.top;
        size_t base_c = p ? p->cur : 0;
        size_t base_t = p ? p->top : 0;
        if (v.len == 0) {
            if (!br->host_nav) rtx_browse_host_pin(br, &v, 0, 0);
            return;
        }
        if (c >= v.len) c = v.len - 1;
        if (c < t) t = c;
        if (c >= t + list) t = c - list + 1;
        if (!br->host_nav && c == base_c && t == base_t) return;
        rtx_browse_host_pin(br, &v, c, t);
        return;
    }
    if (rtx_browse_hold_on(br)) {
        len = br->hold_len;
        cur = &br->hold_cur;
        top = &br->hold_top;
    } else {
        len = br->ents.len;
        cur = &br->cur;
        top = &br->top;
    }
    if (len == 0) {
        *cur = 0;
        *top = 0;
        return;
    }
    if (*cur >= len) *cur = len - 1;
    if (*cur < *top) *top = *cur;
    if (*cur >= *top + list) *top = *cur - list + 1;
}

void rtx_browse_move(RtxBrowse *br, int dir, int vis) {
    const RtxBrowseEnt *ents;
    size_t len;
    size_t *cur;
    if (br) br->glob_focus = 0;
    if (!br) return;
    if (rtx_browse_listing_live(br)) {
        RtxBrowsePub v = rtx_browse_view_snap(br);
        const RtxBrowseEnt *ents = v.ents;
        size_t len = v.len;
        size_t c = v.cur;
        if (!ents || len == 0) return;
        if (dir < 0) {
            if (c > 0) c--;
        } else if (c + 1 < len) {
            c++;
        }
        {
            size_t n = 0;
            while (c < len && ents[c].sep && n++ < len) {
                if (dir < 0) {
                    if (c > 0) c--;
                    else if (c + 1 < len) c++;
                    else break;
                } else if (c + 1 < len) {
                    c++;
                } else if (c > 0) {
                    c--;
                } else {
                    break;
                }
            }
        }
        rtx_browse_host_pin(br, &v, c, v.top);
        rtx_browse_scroll(br, vis);
        return;
    }
    if (rtx_browse_hold_on(br)) {
        ents = br->hold;
        len = br->hold_len;
        cur = &br->hold_cur;
    } else {
        ents = br->ents.data;
        len = br->ents.len;
        cur = &br->cur;
    }
    if (!ents || len == 0) return;
    if (dir < 0) {
        if (*cur > 0) (*cur)--;
    } else if (*cur + 1 < len) {
        (*cur)++;
    }
    {
        size_t n = 0;
        while (*cur < len && ents[*cur].sep && n++ < len) {
            if (dir < 0) {
                if (*cur > 0) (*cur)--;
                else if (*cur + 1 < len) (*cur)++;
                else break;
            } else if (*cur + 1 < len) {
                (*cur)++;
            } else if (*cur > 0) {
                (*cur)--;
            } else {
                break;
            }
        }
    }
    rtx_browse_scroll(br, vis);
    rtx_browse_du_retarget(br);
}

int rtx_browse_need_pump(const RtxBrowse *br) {
    const RtxBrowseEnt *e;
    if (!br || !br->on) return 0;
    if (rtx_browse_listing_live(br)) return 1;
    if (br->scanning || br->sizing) return 1;
    if (br->no_du) return 0;
    if (!br->ents.data || br->ents.len == 0 || br->cur >= br->ents.len) return 0;
    e = &br->ents.data[br->cur];
    return e->is_dir && strcmp(e->name, "..") != 0 && !e->sized;
}

void rtx_browse_select(RtxBrowse *br, size_t idx, int vis) {
    size_t len;
    size_t *cur;
    if (!br) return;
    if (rtx_browse_listing_live(br)) {
        RtxBrowsePub v = rtx_browse_view_snap(br);
        if (v.len == 0) return;
        if (idx >= v.len) idx = v.len - 1;
        rtx_browse_host_pin(br, &v, idx, v.top);
        br->glob_focus = 0;
        rtx_browse_scroll(br, vis);
        return;
    }
    if (rtx_browse_hold_on(br)) {
        len = br->hold_len;
        cur = &br->hold_cur;
    } else {
        len = br->ents.len;
        cur = &br->cur;
    }
    if (len == 0) return;
    if (idx >= len) idx = len - 1;
    *cur = idx;
    br->glob_focus = 0;
    rtx_browse_scroll(br, vis);
    rtx_browse_du_retarget(br);
}

int rtx_browse_hit(const RtxBrowse *br, int row, int vis) {
    size_t list, idx, len, top;
    int head = rtx_browse_head(br);
    (void)vis;
    if (!br || row < head) return -1;
    list = (size_t)(row - head);
    {
        RtxBrowsePub v = rtx_browse_view_snap(br);
        top = v.top;
        len = v.len;
    }
    idx = top + list;
    if (idx >= len) return -1;
    return (int)idx;
}

static char rtx_host_exe[PATH_MAX];

static const char *rtx_host_base(const char *exe) {
    const char *slash;
    if (!exe || !exe[0]) return "";
    slash = strrchr(exe, '/');
    return slash ? slash + 1 : exe;
}

int rtx_host_is_ray(const char *exe) {
    const char *b = rtx_host_base(exe);
    /* Windowed host. Its peer is the console editor, and back. */
    return strcmp(b, "cctext-ui") == 0 || strcmp(b, "cctext_ui") == 0;
}

int rtx_host_peer_path(const char *exe, int other, char *dst, size_t n) {
    char dir[PATH_MAX];
    const char *peer;
    int wr;
    if (!dst || n == 0) return 0;
    dst[0] = 0;
    if (!exe || !exe[0]) exe = "cctext";
    if (!other) {
        snprintf(dst, n, "%s", exe);
        return dst[0] != 0;
    }
    rtx_browse_dirname(dir, sizeof(dir), cc_slice_cstr(exe));
    peer = rtx_host_is_ray(exe) ? "cctext" : "cctext-ui";
    if (!strchr(exe, '/')) wr = snprintf(dst, n, "%s", peer);
    else if (strcmp(dir, "/") == 0) wr = snprintf(dst, n, "/%s", peer);
    else wr = snprintf(dst, n, "%s/%s", dir, peer);
    return wr > 0 && (size_t)wr < n;
}

const char *rtx_host_peer_name(int other) {
    int gui = rtx_host_is_ray(rtx_host_exe[0] ? rtx_host_exe : "cctext");
    if (other) return gui ? "cctext" : "cctext-ui";
    return gui ? "cctext-ui" : "cctext";
}

void rtx_host_set_exe(const char *argv0) {
    char raw[PATH_MAX];
    rtx_host_exe[0] = 0;
#ifdef __APPLE__
    {
        uint32_t n = (uint32_t)sizeof(raw);
        if (_NSGetExecutablePath(raw, &n) == 0) {
            if (realpath(raw, rtx_host_exe)) return;
            snprintf(rtx_host_exe, sizeof(rtx_host_exe), "%s", raw);
            return;
        }
    }
#else
    {
        ssize_t n = readlink("/proc/self/exe", raw, sizeof(raw) - 1);
        if (n > 0) {
            raw[n] = 0;
            snprintf(rtx_host_exe, sizeof(rtx_host_exe), "%s", raw);
            return;
        }
    }
#endif
    if (argv0 && argv0[0] == '/') {
        if (!realpath(argv0, rtx_host_exe))
            snprintf(rtx_host_exe, sizeof(rtx_host_exe), "%s", argv0);
    } else if (argv0 && argv0[0]) {
        if (!rtx_browse_abs(rtx_host_exe, sizeof(rtx_host_exe), cc_slice_cstr(argv0)))
            snprintf(rtx_host_exe, sizeof(rtx_host_exe), "%s", argv0);
    } else {
        snprintf(rtx_host_exe, sizeof(rtx_host_exe), "cctext");
    }
}

int rtx_browse_sel_path(const RtxBrowse *br, char *dst, size_t n, int *is_dir) {
    const RtxBrowseEnt *ents;
    const RtxBrowseEnt *ent;
    size_t len, cur;
    if (is_dir) *is_dir = 0;
    {
        RtxBrowsePub v = rtx_browse_view_snap(br);
        ents = v.ents;
        len = v.len;
        cur = v.cur;
    }
    if (!br || !br->on || !ents || !len || cur >= len || !dst || n == 0)
        return 0;
    ent = &ents[cur];
    if (ent->sep) return 0;
    if (!rtx_browse_join(dst, n, cc_slice_cstr(br->dir), cc_slice_cstr(ent->name))) return 0;
    if (is_dir) *is_dir = ent->is_dir;
    return 1;
}

static int rtx_sh_single_quote(char *dst, size_t n, const char *s) {
    size_t i = 0;
    if (!dst || n < 3) return 0;
    dst[i++] = '\'';
    for (; s && *s; s++) {
        if (*s == '\'') {
            if (i + 5 >= n) return 0;
            dst[i++] = '\'';
            dst[i++] = '"';
            dst[i++] = '\'';
            dst[i++] = '"';
            dst[i++] = '\'';
        } else {
            if (i + 1 >= n) return 0;
            dst[i++] = *s;
        }
    }
    if (i + 1 >= n) return 0;
    dst[i++] = '\'';
    dst[i] = 0;
    return 1;
}

static int rtx_host_pick_exe(int other, char *dst, size_t n) {
    char want[PATH_MAX];
    const char *self = rtx_host_exe[0] ? rtx_host_exe : "cctext";
    if (!rtx_host_peer_path(self, other, want, sizeof(want))) return 0;
    if (access(want, X_OK) == 0) {
        if (want[0] == '/') {
            snprintf(dst, n, "%s", want);
            return 1;
        }
        return rtx_browse_abs(dst, n, cc_slice_cstr(want));
    }
    snprintf(dst, n, "%s", want);
    return dst[0] != 0;
}

#ifndef __APPLE__
extern char **environ;
#endif

/* The peer inherits this environment: PATH, and a GTK cctext-ui needs
 * DISPLAY / WAYLAND_DISPLAY, a console cctext needs TERM. */
static char **rtx_host_env(void) {
#ifdef __APPLE__
    return *_NSGetEnviron();
#else
    return environ;
#endif
}

/* Children we started and do not wait for. rtx_host_reap collects the ones
 * that exited (WNOHANG, by pid — never waitpid(-1), which would steal a
 * popen / osascript child). */
enum { RTX_HOST_KIDS = 32 };
static pid_t g_host_kids[RTX_HOST_KIDS];
static char g_spawn_why[128];

int rtx_host_reap(void) {
    int i, live = 0;
    for (i = 0; i < RTX_HOST_KIDS; i++) {
        pid_t r;
        int st;
        if (g_host_kids[i] <= 0) continue;
        r = waitpid(g_host_kids[i], &st, WNOHANG);
        if (r == g_host_kids[i] || (r < 0 && errno == ECHILD)) g_host_kids[i] = 0;
        else live++;
    }
    return live;
}

static void rtx_host_kid(pid_t pid) {
    int i;
    if (pid <= 0) return;
    rtx_host_reap();
    for (i = 0; i < RTX_HOST_KIDS; i++) {
        if (g_host_kids[i] <= 0) {
            g_host_kids[i] = pid;
            return;
        }
    }
}

const char *rtx_host_spawn_why(void) {
    return g_spawn_why;
}

/* stdin from /dev/null; stdout / stderr too, so a child's chatter never
 * lands on the editor's screen. */
static void rtx_host_quiet_fa(posix_spawn_file_actions_t *fa) {
    posix_spawn_file_actions_addopen(fa, STDIN_FILENO, "/dev/null", O_RDWR, 0);
    posix_spawn_file_actions_addopen(fa, STDOUT_FILENO, "/dev/null", O_WRONLY, 0);
    posix_spawn_file_actions_addopen(fa, STDERR_FILENO, "/dev/null", O_WRONLY, 0);
}

static int rtx_host_spawn_direct(const char *exe, const char *path, int is_dir) {
    posix_spawn_file_actions_t fa;
    posix_spawnattr_t attr;
    pid_t pid;
    char *argv[3];
    int rc;
    if (!exe || !exe[0]) return 0;
    argv[0] = (char *)exe;
    if (is_dir || !path || !path[0]) {
        argv[1] = NULL;
    } else {
        argv[1] = (char *)path;
        argv[2] = NULL;
    }
    posix_spawn_file_actions_init(&fa);
    posix_spawnattr_init(&attr);
#ifdef POSIX_SPAWN_SETSID
    posix_spawnattr_setflags(&attr, POSIX_SPAWN_SETSID);
#endif
    if (is_dir && path && path[0]) {
#if defined(__APPLE__) || defined(__linux__)
        /* POSIX addchdir is not declared on the macOS 15 SDK. _np is. */
        posix_spawn_file_actions_addchdir_np(&fa, path);
#endif
    }
    rtx_host_quiet_fa(&fa);
    rc = posix_spawn(&pid, exe, &fa, &attr, argv, rtx_host_env());
    posix_spawn_file_actions_destroy(&fa);
    posix_spawnattr_destroy(&attr);
    if (rc == 0) rtx_host_kid(pid);
    return rc == 0;
}

int rtx_open_url(const char *url) {
    posix_spawn_file_actions_t fa;
    posix_spawnattr_t attr;
    pid_t pid;
    char *argv[3];
    int rc;
    const char *exe;
    if (!url || !url[0]) return 0;
#ifdef __APPLE__
    exe = "/usr/bin/open";
#else
    exe = "/usr/bin/xdg-open";
#endif
    argv[0] = (char *)exe;
    argv[1] = (char *)url;
    argv[2] = NULL;
    posix_spawn_file_actions_init(&fa);
    posix_spawnattr_init(&attr);
    rtx_host_quiet_fa(&fa);
    rc = posix_spawn(&pid, exe, &fa, &attr, argv, rtx_host_env());
    posix_spawn_file_actions_destroy(&fa);
    posix_spawnattr_destroy(&attr);
    if (rc == 0) rtx_host_kid(pid);
    return rc == 0;
}

#ifdef __APPLE__
static int rtx_env_has(const char *key, const char *needle) {
    const char *s = getenv(key);
    return s && needle && strstr(s, needle) != NULL;
}

const char *rtx_host_tty_app(void) {
    const char *p = getenv("TERM_PROGRAM");
    const char *trace = getenv("CURSOR_TRACE_ID");
    int cursor_env = (trace && trace[0]) ||
        rtx_env_has("GIT_ASKPASS", "Cursor.app") ||
        rtx_env_has("VSCODE_GIT_ASKPASS_NODE", "Cursor.app") ||
        rtx_env_has("VSCODE_GIT_ASKPASS_MAIN", "Cursor.app");
    int code_env =
        rtx_env_has("GIT_ASKPASS", "Visual Studio Code") ||
        rtx_env_has("VSCODE_GIT_ASKPASS_NODE", "Visual Studio Code");
    if (p && strcmp(p, "iTerm.app") == 0) return "iTerm";
    if (p && strcmp(p, "Apple_Terminal") == 0) return "Terminal";
    if (p && strcmp(p, "vscode") == 0) return code_env ? "Code" : "Cursor";
    if (cursor_env) return "Cursor";
    if (code_env) return "Code";
    return "Terminal";
}

static int rtx_host_as_escape(char *dst, size_t n, const char *s) {
    size_t i;
    size_t j;
    if (!dst || n < 2) return 0;
    j = 0;
    for (i = 0; s && s[i]; i++) {
        if (j + 2 >= n) return 0;
        if (s[i] == '\\' || s[i] == '"') {
            dst[j] = '\\';
            j++;
        }
        dst[j] = s[i];
        j++;
    }
    dst[j] = 0;
    return 1;
}

int rtx_host_osascript_ok(const char *script) {
    posix_spawn_file_actions_t fa;
    posix_spawnattr_t attr;
    pid_t pid;
    char *argv[4];
    int rc;
    int st;
    if (!script || !script[0]) return 0;
    argv[0] = (char *)"/usr/bin/osascript";
    argv[1] = (char *)"-e";
    argv[2] = (char *)script;
    argv[3] = NULL;
    posix_spawn_file_actions_init(&fa);
    posix_spawnattr_init(&attr);
    posix_spawn_file_actions_addopen(&fa, STDOUT_FILENO, "/dev/null", O_WRONLY, 0);
    posix_spawn_file_actions_addopen(&fa, STDERR_FILENO, "/dev/null", O_WRONLY, 0);
    rc = posix_spawn(&pid, argv[0], &fa, &attr, argv, rtx_host_env());
    posix_spawn_file_actions_destroy(&fa);
    posix_spawnattr_destroy(&attr);
    if (rc != 0) return 0;
    if (waitpid(pid, &st, 0) < 0) return 0;
    return WIFEXITED(st) && WEXITSTATUS(st) == 0;
}

int rtx_host_terminal_script(char *dst, size_t n, const char *esc) {
    int wr;
    if (!dst || n == 0) return 0;
    wr = snprintf(dst, n, "tell application \"Terminal\" to do script \"%s\"",
                  esc ? esc : "");
    return wr > 0 && (size_t)wr < n;
}

int rtx_host_ide_script(char *dst, size_t n, const char *app, const char *esc) {
    int wr;
    if (!dst || n == 0 || !app || !app[0]) return 0;
    wr = snprintf(dst, n,
        "tell application \"System Events\"\n"
        "tell process \"%s\"\n"
        "set frontmost to true\n"
        "try\n"
        "click menu item \"New Terminal\" of menu \"Terminal\" of "
        "menu item \"Terminal\" of menu \"View\" of menu bar 1\n"
        "on error\n"
        "keystroke \"`\" using {control down, shift down}\n"
        "end try\n"
        "delay 0.4\n"
        "keystroke \"%s\"\n"
        "keystroke return\n"
        "end tell\n"
        "end tell\n",
        app, esc ? esc : "");
    return wr > 0 && (size_t)wr < n;
}

static int rtx_host_spawn_terminal(const char *esc) {
    char script[PATH_MAX * 4 + 160];
    if (!rtx_host_terminal_script(script, sizeof(script), esc)) return 0;
    return rtx_host_osascript_ok(script);
}

static int rtx_host_spawn_iterm(const char *esc) {
    char script[PATH_MAX * 4 + 200];
    int wr;
    wr = snprintf(script, sizeof(script),
                  "tell application \"iTerm\" to create window with default "
                  "profile command \"%s\"", esc);
    if (wr <= 0 || (size_t)wr >= sizeof(script)) return 0;
    return rtx_host_osascript_ok(script);
}

static int rtx_host_spawn_ide(const char *app, const char *esc) {
    char script[PATH_MAX * 4 + 700];
    if (!rtx_host_ide_script(script, sizeof(script), app, esc)) return 0;
    return rtx_host_osascript_ok(script);
}

static int rtx_host_spawn_tty(const char *exe, const char *path, int is_dir) {
    char qexe[PATH_MAX * 2];
    char qpath[PATH_MAX * 2];
    char cmd[PATH_MAX * 4 + 80];
    char esc[PATH_MAX * 4 + 80];
    const char *app;
    int wr;
    if (!rtx_sh_single_quote(qexe, sizeof(qexe), exe)) return 0;
    if (is_dir && path && path[0]) {
        if (!rtx_sh_single_quote(qpath, sizeof(qpath), path)) return 0;
        wr = snprintf(cmd, sizeof(cmd), "cd %s && exec %s", qpath, qexe);
    } else if (path && path[0]) {
        if (!rtx_sh_single_quote(qpath, sizeof(qpath), path)) return 0;
        wr = snprintf(cmd, sizeof(cmd), "exec %s %s", qexe, qpath);
    } else {
        wr = snprintf(cmd, sizeof(cmd), "exec %s", qexe);
    }
    if (wr <= 0 || (size_t)wr >= sizeof(cmd)) return 0;
    if (!rtx_host_as_escape(esc, sizeof(esc), cmd)) return 0;
    app = rtx_host_tty_app();
    /* System Events keystrokes are denied on current macOS (error 1002).
     * Waiting out that script, then falling through, still failed to
     * open a window in time and used to be reported as success. Set
     * RTX_HOST_IDE_KEYS to try the IDE terminal anyway. */
    if (getenv("RTX_HOST_IDE_KEYS") &&
        (strcmp(app, "Cursor") == 0 || strcmp(app, "Code") == 0) &&
        rtx_host_spawn_ide(app, esc))
        return 1;
    if (strcmp(app, "iTerm") == 0 && rtx_host_spawn_iterm(esc)) return 1;
    return rtx_host_spawn_terminal(esc);
}
#else
const char *rtx_host_tty_app(void) {
    return "Terminal";
}

/* `name` on PATH (or a path) that we may exec. */
static int rtx_host_which(const char *name, char *dst, size_t n) {
    const char *path, *p;
    if (!name || !name[0] || !dst || n == 0) return 0;
    if (strchr(name, '/')) {
        if (access(name, X_OK) != 0) return 0;
        snprintf(dst, n, "%s", name);
        return 1;
    }
    path = getenv("PATH");
    if (!path || !path[0]) path = "/usr/local/bin:/usr/bin:/bin";
    for (p = path; *p;) {
        const char *e = strchr(p, ':');
        size_t len = e ? (size_t)(e - p) : strlen(p);
        int wr = snprintf(dst, n, "%.*s/%s", (int)len, len ? p : ".", name);
        if (wr > 0 && (size_t)wr < n && access(dst, X_OK) == 0) return 1;
        if (!e) break;
        p = e + 1;
    }
    dst[0] = 0;
    return 0;
}

/* A console editor needs its own terminal. Starting it on this tty would
 * put two editors on one screen. Use $TERMINAL or x-terminal-emulator in a
 * graphical session; otherwise refuse and say why. */
static int rtx_host_spawn_term(const char *exe, const char *path, int is_dir) {
    char term[PATH_MAX];
    const char *t = getenv("TERMINAL");
    const char *dpy = getenv("DISPLAY");
    const char *way = getenv("WAYLAND_DISPLAY");
    posix_spawn_file_actions_t fa;
    posix_spawnattr_t attr;
    pid_t pid;
    char *argv[5];
    int rc;
    if (!(dpy && dpy[0]) && !(way && way[0])) {
        snprintf(g_spawn_why, sizeof(g_spawn_why),
                 "no terminal window here (no DISPLAY): not starting a second editor on this tty");
        return 0;
    }
    /* $TERMINAL, the Debian alternative, then common emulators; each takes
     * `-e prog args` except gnome-terminal (`--`). */
    {
        static const char *const cands[] = {"x-terminal-emulator", "gnome-terminal",
                                            "konsole", "xfce4-terminal", "xterm"};
        size_t i;
        int got = t && t[0] && rtx_host_which(t, term, sizeof(term));
        for (i = 0; !got && i < sizeof(cands) / sizeof(cands[0]); i++)
            got = rtx_host_which(cands[i], term, sizeof(term));
        if (!got) {
            snprintf(g_spawn_why, sizeof(g_spawn_why),
                     "set $TERMINAL (no terminal emulator found) to open a new window");
            return 0;
        }
    }
    argv[0] = term;
    {
        const char *base = strrchr(term, '/');
        base = base ? base + 1 : term;
        argv[1] = (char *)(strcmp(base, "gnome-terminal") == 0 ? "--" : "-e");
    }
    argv[2] = (char *)exe;
    argv[3] = (!is_dir && path && path[0]) ? (char *)path : NULL;
    argv[4] = NULL;
    posix_spawn_file_actions_init(&fa);
    posix_spawnattr_init(&attr);
#ifdef POSIX_SPAWN_SETSID
    posix_spawnattr_setflags(&attr, POSIX_SPAWN_SETSID);
#endif
    if (is_dir && path && path[0])
        posix_spawn_file_actions_addchdir_np(&fa, path);
    rtx_host_quiet_fa(&fa);
    rc = posix_spawn(&pid, term, &fa, &attr, argv, rtx_host_env());
    posix_spawn_file_actions_destroy(&fa);
    posix_spawnattr_destroy(&attr);
    if (rc != 0) {
        snprintf(g_spawn_why, sizeof(g_spawn_why), "could not start %s", term);
        return 0;
    }
    rtx_host_kid(pid);
    return 1;
}
#endif

int rtx_browse_spawn(const RtxBrowse *br, int other) {
    char full[RTX_BROWSE_DIR];
    char exe[PATH_MAX];
    int is_dir = 0;
    g_spawn_why[0] = 0;
    if (!rtx_browse_sel_path(br, full, sizeof(full), &is_dir)) return 0;
    if (!rtx_host_pick_exe(other, exe, sizeof(exe))) return 0;
    if (rtx_host_is_ray(exe))
        return rtx_host_spawn_direct(exe, full, is_dir);
#ifdef __APPLE__
    return rtx_host_spawn_tty(exe, full, is_dir);
#else
    return rtx_host_spawn_term(exe, full, is_dir);
#endif
}
