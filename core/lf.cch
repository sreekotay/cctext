/*
 * Line-feed counting (owner: lf.ccs). Plain C decls; every newline count in
 * core goes through these (line index scans, island, find blocks, project
 * search, replace, batch).
 *
 * x86-64: SSE2 always, AVX2 when the CPU has it (runtime check, so a build
 * runs on older CPUs). arm64: NEON. Elsewhere: 8-byte SWAR. Every path is
 * exact; lf_smoke checks them against a byte loop.
 */
#ifndef RTX_LF_H
#define RTX_LF_H

#include <stddef.h>

/* Newlines in p[0, n). */
size_t rtx_count_lf(const char *p, size_t n);

/* Index of the k-th newline (k >= 1) in p[0, n), or (size_t)-1 when there
 * are fewer than k; *seen (may be NULL) gets the newlines counted: k on a
 * hit, else the total in p[0, n). k == 0 returns (size_t)-1 and 0 seen. */
size_t rtx_nth_lf(const char *p, size_t n, size_t k, size_t *seen);

/* Index of the last newline in p[0, n), or (size_t)-1. */
size_t rtx_last_lf(const char *p, size_t n);

/* Paths, slowest first. */
enum {
    RTX_LF_BEST = 0, /* the widest this CPU has (the default) */
    RTX_LF_SWAR = 1, /* 8-byte words, any CPU */
    RTX_LF_SIMD = 2, /* SSE2 (x86-64) or NEON (arm64) */
    RTX_LF_WIDE = 3  /* AVX2 (x86-64) */
};

/* Which path runs: "avx2", "sse2", "neon" or "swar". */
const char *rtx_lf_impl(void);

/* Tests: cap the path at `level` (RTX_LF_BEST lifts the cap). Returns 0
 * when this CPU / build does not have that level. */
int rtx_lf_force(int level);

#endif
