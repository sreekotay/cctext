/*
 * Editor themes: dark and light (README "Settings", DESIGN "Themes").
 *
 * One palette of named roles, each with a dark and a light colour
 * (0xRRGGBB, what cctext-ui paints) and, for the roles the terminal
 * paints, an SGR per theme (256 colours or the terminal's own ANSI ones:
 * cctext never guesses a truecolor pair for text). The current theme is
 * process state: rtx_theme_set flips it and bumps a generation the
 * painters and renderers key on. Plain C: the GUI shims include it too.
 *
 * rtx_pal_pairs lists the (text, background) pairs the painters use,
 * each with the contrast it must keep (WCAG 2 AA: 4.5:1 for text, 3:1
 * for dimmed text and non-text marks); tests/theme_smoke.ccs checks every
 * pair in both themes.
 */
#ifndef RTX_THEME_H
#define RTX_THEME_H

#include <stddef.h>
#include <stdint.h>

enum { RTX_THEME_DARK = 0, RTX_THEME_LIGHT = 1, RTX_THEME_AUTO = 2 };

typedef enum {
    RTX_P_WIN_BG,
    RTX_P_PANE_BG,
    RTX_P_PANE_BG_DIM,
    RTX_P_GUTTER_BG,
    RTX_P_GUTTER_BG_DIM,
    RTX_P_BROWSE_BG,
    RTX_P_PREVIEW_BG,
    RTX_P_PANE_RULE,
    RTX_P_PANE_RULE_DIM,
    RTX_P_FOCUS_BAR,
    RTX_P_FOCUS_EDGE,
    RTX_P_DIVIDER,
    RTX_P_TEXT,
    RTX_P_TEXT_DIM,
    RTX_P_SEL,
    RTX_P_CARET,
    RTX_P_PAIR,
    RTX_P_HL,
    RTX_P_GUTTER,
    RTX_P_GUTTER_DIM,
    RTX_P_GUTTER_ERR,
    RTX_P_RAIL,
    RTX_P_HEAD_BG,
    RTX_P_HEAD_FG,
    RTX_P_HEAD_FG_DIM,
    RTX_P_SYN_KEYWORD,
    RTX_P_SYN_STRING,
    RTX_P_SYN_COMMENT,
    RTX_P_SYN_NUMBER,
    RTX_P_SYN_MATH,
    RTX_P_SYN_ANNOT,
    RTX_P_SYN_STALE,
    RTX_P_SYN_ANCHOR,
    RTX_P_BR_PATH,
    RTX_P_BR_GLOB,
    RTX_P_BR_DIR,
    RTX_P_BR_FILE,
    RTX_P_BR_SIZE,
    RTX_P_BR_DATE,
    RTX_P_BR_HIT,
    RTX_P_BR_EXT,
    RTX_P_BR_DENY,
    RTX_P_TAB_BAR,
    RTX_P_TAB_BG,
    RTX_P_TAB_FG,
    RTX_P_TAB_SHOWN_BG,
    RTX_P_TAB_SHOWN_FG,
    RTX_P_TAB_LIT_BG,
    RTX_P_TAB_LIT_FG,
    RTX_P_TAB_DIRTY,
    RTX_P_TAB_CLOSE,
    RTX_P_TAB_ARROW,
    RTX_P_STATUS_BG,
    RTX_P_STATUS_FG,
    RTX_P_ERR_BG,
    RTX_P_ERR_FG,
    RTX_P_SCRIM,
    RTX_P_PANEL_BG,
    RTX_P_PANEL_BORDER,
    RTX_P_PANEL_ACCENT,
    RTX_P_PANEL_FG,
    RTX_P_PANEL_FG2,
    RTX_P_PANEL_DIM,
    RTX_P_PANEL_OFF,
    RTX_P_PANEL_SEL,
    RTX_P_PANEL_CAT,
    RTX_P_FIELD_SEL,
    RTX_P_FIND_BG,
    RTX_P_FIND_RULE,
    RTX_P_FIND_CUR_BG,
    RTX_P_FIND_CUR_FG,
    RTX_P_FIND_FG,
    RTX_P_PICK_BG,
    RTX_P_PICK_BORDER,
    RTX_P_PICK_FIELD,
    RTX_P_PICK_HEAD,
    RTX_P_PICK_SEL,
    RTX_P_PICK_MATCH,
    RTX_P_PICK_DIM,
    RTX_P_PICK_GROUP,
    RTX_P_PICK_CUR,
    RTX_P_PICK_FG,
    RTX_P_JUMP_BG,
    RTX_P_JUMP_BORDER,
    RTX_P_JUMP_TITLE,
    RTX_P_STAT_BG,
    RTX_P_STAT_BORDER,
    RTX_P_STAT_TITLE,
    RTX_P_STAT_HEAD,
    RTX_P_STAT_WARN,
    RTX_P_STAT_FG,
    RTX_P_HEX_OFF,
    RTX_P_HEX_FG,
    RTX_P_HEX_ASCII,
    RTX_P_HEX_CONT,
    RTX_P_ROW_FG,
    RTX_P_TRACK,
    RTX_P_TRACK_DIM,
    RTX_P_THUMB,
    RTX_P_THUMB_DIM,
    RTX_P_THUMB2,
    RTX_P_THUMB2_DIM,
    RTX_P_RAIL_WAIT,
    RTX_P_RAIL_MARK,
    RTX_P_RAIL_MARK_DIM,
    RTX_P_RAIL_ERR,
    RTX_P_RAIL_ERR_DIM,
    RTX_P_TBL_HDR,
    RTX_P_TBL_SEP,
    RTX_P_TBL_ROW,
    RTX_P_TBL_RULE,
    RTX_P_TOAST_BG,
    RTX_P_TOAST_FG,
    RTX_P_IMG_TEXT,
    RTX_P_PH_BG,
    RTX_P_PH_BORDER,
    RTX_P_PH_ALT,
    RTX_P_PH_DIM,
    RTX_P_PH_MSG,
    RTX_P_PH_ERR,
    RTX_P_CAP_BG,
    RTX_P_PRESENT_BG,
    RTX_P_PRESENT_FG,
    RTX_P_MSG_FG,
    RTX_P_MM_BG,
    RTX_P_MM_FG,
    RTX_P_MM_ACCENT,
    RTX_P_MATH_FG,
    RTX_P__N
} RtxPalId;

/* The role's colour in the current theme / in the given one. */
uint32_t rtx_pal(RtxPalId id);
uint32_t rtx_pal_of(int light, RtxPalId id);
/* The role's terminal SGR (ESC [ .. m) in the current theme; NULL when
 * the terminal does not paint that role. */
const char *rtx_pal_sgr(RtxPalId id);
const char *rtx_pal_sgr_of(int light, RtxPalId id);
const char *rtx_pal_name(RtxPalId id);

/* The current theme: 1 light, 0 dark. set returns 1 when it changed. */
int rtx_theme_light(void);
int rtx_theme_set(int light);
/* Bumped by every change (painters' caches key on it). */
unsigned rtx_theme_gen(void);
/* The chosen mode (RTX_THEME_*; the host resolves auto into the theme
 * above from the OS appearance or the terminal's background). */
int rtx_theme_mode(void);
void rtx_theme_mode_set(int mode);
/* The terminal's background (OSC 11), 0xRRGGBB, or -1 when unknown
 * (cctext-ui, a terminal that did not answer). */
int32_t rtx_theme_term_bg(void);
void rtx_theme_term_bg_set(int32_t rgb);
/* "dark" / "light" / "auto" → RTX_THEME_*; -1 otherwise. */
int rtx_theme_mode_parse(const char *s);
const char *rtx_theme_mode_name(int mode);

/* WCAG 2 relative luminance and contrast ratio of 0xRRGGBB colours. */
double rtx_rgb_luminance(uint32_t rgb);
double rtx_rgb_contrast(uint32_t a, uint32_t b);
/* A background is light when black text on it contrasts more than white
 * (relative luminance above ~0.18). */
int rtx_rgb_is_light(uint32_t rgb);

enum { RTX_PAL_TEXT = 0, RTX_PAL_DIM = 1 };
typedef struct {
    RtxPalId fg, bg;
    int kind;      /* RTX_PAL_TEXT: 4.5:1; RTX_PAL_DIM: 3:1 */
} RtxPalPair;
size_t rtx_pal_pairs(const RtxPalPair **out);
double rtx_pal_pair_min(int kind);

/* An X11 colour spec as terminals answer OSC 10 / 11: "rgb:R/G/B" with
 * 1-4 hex digits a channel, "rgba:R/G/B/A", or "#rgb" / "#rrggbb".
 * 1 = parsed into *rgb. */
int rtx_theme_parse_rgb(const char *s, size_t n, uint32_t *rgb);
/* A whole OSC 11 reply: ESC ] 11 ; <spec> then BEL or ESC \ (b[0, n)).
 * 1 = a background colour. */
int rtx_theme_osc11(const unsigned char *b, size_t n, uint32_t *rgb);
/* COLORFGBG ("15;0", "0;default;15"): the last field is the background's
 * ANSI index. 1 light, 0 dark, -1 unknown. */
int rtx_theme_colorfgbg(const char *v);

/* The colours an SGR sets (xterm's 256-colour and ANSI values; -1 = not
 * set / the terminal's default). For the contrast test. */
void rtx_pal_sgr_rgb(const char *sgr, int32_t *fg, int32_t *bg);
/* xterm's colour for palette index i (0-255). */
uint32_t rtx_theme_x256(int i);

#endif /* RTX_THEME_H */
