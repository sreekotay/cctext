#!ccc cch
/*
 * Find epoch: query copy, compiled query (core/rx.cch), and hit offsets,
 * lengths and lines on `d.find.store`. Options (RTX_FIND_ICASE / WORD /
 * REGEX, document.cch) are part of the query.
 * The scan wave is a call-local heap, not this store — destroy the store
 * on RtxDoc_destroy even if `.base` looks empty.
 * Bodies in find.ccs (linked TU). Kick / wave / refine share that TU.
 * Scan model (DESIGN.md): find_set plants a dest-live wrapper; the arm
 * runs `@parallel wait` over 2 MiB blocks and publishes in the write
 * stage. finish waits the wrapper.
 * find_step kicks if the handle is down. Tests call finish (wait).
 */
#ifndef RTX_FIND_H
#define RTX_FIND_H

typedef struct {
    size_t off;
    size_t line1;
    size_t col;
    size_t len; /* hit bytes from ctx[col] (may run past ctx) */
    char[:] ctx;
} RtxFindHitView;

/* RtxDoc_find_invalidate is in document.cch (edit.cch UFCS). */

int RtxDoc_find_same_query(const RtxDoc *d, char[:] q);
/* Same query text and options: find_set_opt would be a no-op. */
int RtxDoc_find_same(const RtxDoc *d, char[:] q, unsigned opts);
int rtx_find_is_extend(const RtxDoc *d, char[:] q);
void !>(CCError) rtx_find_refine(RtxDoc *d, char[:] q);
/* Keeps the current options. */
void !>(CCError) RtxDoc_find_set(RtxDoc *d, char[:] q);
/* A regex that does not compile sets find.err (static text) and scans
 * nothing; it is not a Result failure. */
void !>(CCError) RtxDoc_find_set_opt(RtxDoc *d, char[:] q, unsigned opts);
void !>(CCError) RtxDoc_find_step(RtxDoc *d);
void !>(CCError) RtxDoc_find_finish(RtxDoc *d);
void rtx_find_pause(RtxDoc *d);
void rtx_find_resume(RtxDoc *d);
void rtx_find_mark_near(RtxDoc *d);
void RtxDoc_find_goto(RtxDoc *d, size_t i);
void RtxDoc_find_next(RtxDoc *d);
void RtxDoc_find_prev(RtxDoc *d);
void !>(CCError) RtxDoc_find_hit_view(RtxDoc *d, size_t i, CCArena scratch,
                                      size_t maxn, RtxFindHitView *out);

/* ------------------------------------------------------------- replace
 * DESIGN Replace. The replacement is bytes. With RTX_FIND_REGEX it is a
 * template: $0-$9 (one digit: `$10` is $1 then '0'), ${N}, ${name} (a
 * (?<name>…) group), $$ = '$', \n = LF, \t = TAB, \\ = '\'. Any other
 * `$` or `\` is itself. A group that did not take part is empty. A group
 * the pattern does not have, or one above 9, is an error before any
 * edit. Without REGEX the replacement is taken verbatim. */
#define RTX_REPL_QMAX 4096
/* Staged ins + del bytes one replace-all may hold (hist copies both). */
#ifndef RTX_REPL_BYTES_MAX
#define RTX_REPL_BYTES_MAX ((size_t)256 << 20)
#endif
/* Starts searched per window read. */
#define RTX_REPL_SLICE ((size_t)1 << 20)

/* Replace one: if the selection is exactly the current (pinned) hit,
 * replace it (one hist record) and select the next hit at or after the
 * replacement's end; otherwise select the next hit (no edit). 1 = an
 * edit landed. `*why` (static) says why nothing happened, or NULL. The
 * query is the find list's (d->find.query / opts). */
int !>(CCError) RtxDoc_replace_hit(RtxDoc *d, char[:] tpl, const char **why);

/* Replace-all job over [lo, hi) (hi = (size_t)-1: the whole document,
 * where a zero-width match at EOF also counts). Matches are the
 * leftmost non-overlapping chain of the query (a literal too); a
 * zero-width match is replaced once per position and the search steps
 * one scalar past it; a match must end at or before hi. A bad query or
 * template fails the Result (nothing staged). */
void !>(CCError) rtx_replace_kick(RtxReplace *j, RtxDoc *d, char[:] q,
                                  unsigned opts, char[:] tpl, size_t lo, size_t hi);
/* Collect sites for about `budget_ms` (<= 0: to the end), or until
 * `yield()` says input waits. Returns the state. A refusal (long match,
 * cap, an edit since kick) is RTX_REPL_FAIL with j->err. */
int !>(CCError) rtx_replace_step(RtxReplace *j, long budget_ms, int (*yield)(void));
/* READY: apply every site as one edit group (one undo step), map the
 * caret / anchor through it, drop the job. Returns sites replaced. */
size_t !>(CCError) rtx_replace_commit(RtxReplace *j);
void rtx_replace_drop(RtxReplace *j);
/* Scan progress 0-100 while RTX_REPL_SCAN, else -1. */
int rtx_replace_pct(const RtxReplace *j);
/* Kick + step to the end + commit. Refusals are CC_ERR_INVALID_ARG with
 * the job's message. Returns sites replaced. */
size_t !>(CCError) RtxDoc_replace_all(RtxDoc *d, char[:] q, unsigned opts,
                                      char[:] tpl, size_t lo, size_t hi);


#endif /* RTX_FIND_H */
