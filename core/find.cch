#!ccc cch
/*
 * Find epoch: query copy + hit offsets on `d.find.store`.
 * Context is computed when drawing the visible rows, not stored.
 * One closed interval per find_step (at most `RTX_FIND_WAVE` tickets).
 * Returning is the yield; the next call is the resume (`scan_off`).
 * The host decides whether to enter. `break` / `return` inside the
 * wait-for are nursery cancel (truncated, I/O) from `@stage` — not a
 * UI pause. The turnstile still handshakes. Workers pread (no LRU).
 * The step returns how many `@stage` bodies ran; 0 is not progress.
 */
#ifndef RTX_FIND_H
#define RTX_FIND_H

#include <ccc/cc_turnstile.cch>

enum {
    RTX_FIND_CHUNK = 8192,
    RTX_FIND_BUDGET = 262144,
    RTX_FIND_BLOCK = RTX_FIND_BUDGET,
    RTX_FIND_WAVE = 8,
    RTX_FIND_CAP = RTX_FIND_WAVE,
    RTX_FIND_LOCAL = 256,
    RTX_FIND_MAX = 32768,
    RTX_FIND_QMAX = 256
};

typedef struct {
    size_t off;
    size_t line1;
    size_t col;
    char[:] ctx;
} RtxFindHitView;

static void RtxDoc_find_invalidate(RtxDoc *d) {
    if (!d) return;
    d->find.len = 0;
    d->find.scan_off = 0;
    d->find.cur = 0;
    d->find.origin = d->caret;
    d->find.pinned = 0;
    d->find.wave_commit = 0;
    d->find.truncated = 0;
    d->find.done = (d->find.query.len == 0);
    d->find.cancel = 0;
    d->find.idle = 0;
}

static int RtxDoc_find_same_query(const RtxDoc *d, char[:] q) {
    if (!d) return 0;
    if (d->find.query.len != q.len) return 0;
    if (q.len == 0) return 1;
    return memcmp(d->find.query.ptr, q.ptr, q.len) == 0;
}

static void !>(CCError) RtxDoc_find_set(RtxDoc *d, char[:] q) {
    char qbuf[RTX_FIND_QMAX];
    size_t qn;
    CCArena fresh;
    char[:] nq;
    if (!d) return cc_err(CC_ERR_INVALID_ARG, "null doc");
    qn = q.len;
    if (qn > RTX_FIND_QMAX) return cc_err(CC_ERR_INVALID_ARG, "find query too long");
    if (qn) memcpy(qbuf, q.ptr, qn);
    if (qn == 0) {
        if (d->find.store.base) d->find.store.reset();
        d->find.query = cc_slice_empty();
        d->find.offs = NULL;
        d->find.len = 0;
        d->find.cap = 0;
        d->find.scan_off = 0;
        d->find.cur = 0;
        d->find.origin = d->caret;
        d->find.pinned = 0;
        d->find.wave_commit = 0;
        d->find.truncated = 0;
        d->find.done = 1;
        d->find.cancel = 0;
        d->find.idle = 0;
        return cc_ok();
    }
    memset(&fresh, 0, sizeof(fresh));
    fresh = cc_arena_heap(kilobytes(16));
    if (!fresh.base) return cc_err(CC_ERR_OUT_OF_MEMORY, "find store");
    nq = fresh.alloc_slice_bytes(qn);
    if (!nq.ptr || nq.len < qn) {
        fresh.destroy();
        return cc_err(CC_ERR_OUT_OF_MEMORY, "find query");
    }
    memcpy(nq.ptr, qbuf, qn);
    if (d->find.store.base) d->find.store.destroy();
    d->find.store = fresh;
    d->find.query = nq;
    d->find.offs = NULL;
    d->find.len = 0;
    d->find.cap = 0;
    d->find.scan_off = 0;
    d->find.cur = 0;
    d->find.origin = d->caret;
    d->find.pinned = 0;
    d->find.wave_commit = 0;
    d->find.truncated = 0;
    d->find.done = 0;
    d->find.cancel = 0;
    d->find.idle = 0;
    return cc_ok();
}

static void !>(CCError) rtx_find_push(RtxDoc *d, size_t off) {
    if (d->find.len >= RTX_FIND_MAX) {
        d->find.truncated = 1;
        d->find.done = 1;
        return cc_ok();
    }
    rtx_arena_grow(&d->find.store, (void **)&d->find.offs, &d->find.cap,
                   d->find.len + 1, sizeof(size_t)) !>(e) {
        return cc_err(e);
    };
    d->find.offs[d->find.len++] = off;
    return cc_ok();
}

/*
 * scan_off is the next match-start to consider.
 * A window keeps query.len-1 bytes uncommitted so a hit cannot
 * straddle unread input. The return is how far this window commits.
 */
static size_t rtx_find_window_adv(size_t got, size_t qn, int last) {
    size_t overlap = qn > 0 ? qn - 1 : 0;
    if (last) return got;
    return got > overlap ? got - overlap : got;
}

static size_t rtx_find_match_rel(const char *buf, size_t got, size_t qn,
                                 const char *q, size_t adv, size_t skip,
                                 size_t *hits, size_t maxh) {
    size_t i;
    size_t n;
    size_t seen;
    size_t max_i;
    n = 0;
    seen = 0;
    if (!buf || !q || got < qn || maxh == 0) return 0;
    max_i = got - qn;
    for (i = 0; i <= max_i && i < adv; i++) {
        if (memcmp(buf + i, q, qn) != 0) continue;
        if (seen++ < skip) continue;
        if (n >= maxh) break;
        hits[n++] = i;
    }
    return n;
}

static size_t rtx_find_finish_step(RtxDoc *d, size_t committed) {
    d->find.wave_commit = committed;
    d->find.idle = (committed == 0);
    return committed;
}

static size_t !>(CCError) rtx_find_step_serial(RtxDoc *d, size_t budget) {
    size_t qn;
    size_t n;
    size_t spent = 0;
    size_t committed = 0;
    char buf[RTX_FIND_CHUNK];
    qn = d->find.query.len;
    n = d->len();
    while (spent < budget && !d->find.done) {
        size_t want = RTX_FIND_CHUNK;
        size_t got;
        size_t adv;
        size_t max_i;
        size_t i;
        int last;
        if (d->find.scan_off + qn > n) {
            d->find.done = 1;
            break;
        }
        if (want < qn) want = qn;
        if (d->find.scan_off + want > n) want = n - d->find.scan_off;
        if (want > sizeof(buf)) want = sizeof(buf);
        got = d->read_at(d->find.scan_off, buf, want) !>(e) { return cc_err(e); };
        if (got == 0 && d->find.scan_off < n) {
            return cc_err(CC_ERR_INTERNAL, "find read");
        }
        spent += got;
        if (got < qn) {
            return cc_err(CC_ERR_INTERNAL, "find read");
        }
        last = (d->find.scan_off + got >= n);
        adv = rtx_find_window_adv(got, qn, last);
        max_i = got - qn;
        for (i = 0; i <= max_i && i < adv; i++) {
            if (memcmp(buf + i, d->find.query.ptr, qn) == 0) {
                rtx_find_push(d, d->find.scan_off + i) !>(e) { return cc_err(e); };
                if (d->find.done) {
                    d->find.scan_off += adv;
                    return cc_ok(rtx_find_finish_step(d, committed + 1));
                }
            }
        }
        d->find.scan_off += adv;
        committed++;
        if (d->find.scan_off + qn > n) d->find.done = 1;
    }
    return cc_ok(rtx_find_finish_step(d, committed));
}

/* The body is the serial scan. `seq` is the runtime denial; `wait` is
 * ticket order so hits append in file order. The host already gated. */
static size_t !>(CCError) rtx_find_step_parallel(RtxDoc *d) {
    @errhandler(CCError e) { return cc_err(e); }
    size_t qn = d->find.query.len;
    size_t n = d->len();
    size_t start = d->find.scan_off;
    size_t committed = start;
    size_t stages = 0;
    size_t remain;
    size_t arena_n;
    int nb, cap, use_par, i;
    if (start + qn > n) {
        d->find.done = 1;
        return cc_ok(rtx_find_finish_step(d, 0));
    }
    remain = n - start;
    nb = (int)((remain + (size_t)RTX_FIND_BLOCK - 1) / (size_t)RTX_FIND_BLOCK);
    if (nb < 1) nb = 1;
    if (nb > RTX_FIND_WAVE) nb = RTX_FIND_WAVE;
    cap = RTX_FIND_CAP;
    if (cap > nb) cap = nb;
    arena_n = megabytes(2);
    CCArena ts_arena = cc_arena_heap(arena_n) @destroy;
    CCTurnstileRW ts@(nb, cap, &ts_arena) @destroy;
    if (!ts.core.excl) return cc_err(CC_ERR_OUT_OF_MEMORY, "find turnstile");
    use_par = (nb > 1);
    @parallel seq (use_par) wait (ts) for (i in 0..nb) {
        size_t base = start + (size_t)i * (size_t)RTX_FIND_BLOCK;
        size_t commit = (size_t)RTX_FIND_BLOCK;
        size_t want, got, adv, k, nloc;
        size_t local[RTX_FIND_LOCAL];
        char buf[RTX_FIND_BLOCK + RTX_FIND_QMAX];
        int overflow = 0;
        nloc = 0;
        got = 0;
        adv = 0;
        if (base < n && commit > n - base) commit = n - base;
        want = commit;
        if (qn > 1 && want > 0) want += qn - 1;
        if (base < n && want > n - base) want = n - base;
        if (want < qn) want = 0;
        if (want) {
            got = d->tree.read_uncached(base, buf, want) !>;
            adv = rtx_find_window_adv(got, qn, base + got >= n);
            if (adv > commit) adv = commit;
            nloc = rtx_find_match_rel(buf, got, qn, d->find.query.ptr, adv,
                                      0, local, (size_t)RTX_FIND_LOCAL);
            overflow = (nloc == (size_t)RTX_FIND_LOCAL);
        }
        @stage (ts.write, i) {
            for (k = 0; k < nloc && !d->find.truncated; k++) {
                rtx_find_push(d, base + local[k]) !>;
            }
            if (overflow && !d->find.truncated) {
                size_t skip = (size_t)RTX_FIND_LOCAL;
                for (;;) {
                    nloc = rtx_find_match_rel(buf, got, qn, d->find.query.ptr,
                                              adv, skip, local,
                                              (size_t)RTX_FIND_LOCAL);
                    for (k = 0; k < nloc && !d->find.truncated; k++) {
                        rtx_find_push(d, base + local[k]) !>;
                    }
                    if (nloc < (size_t)RTX_FIND_LOCAL || d->find.truncated)
                        break;
                    skip += nloc;
                }
            }
            committed = start + (size_t)(i + 1) * (size_t)RTX_FIND_BLOCK;
            if (committed > n) committed = n;
            stages++;
        }
        if (d->find.truncated) break;
    }
    d->find.scan_off = committed;
    if (d->find.scan_off + qn > n) {
        d->find.scan_off = n;
        d->find.done = 1;
    }
    return cc_ok(rtx_find_finish_step(d, stages));
}

static size_t !>(CCError) RtxDoc_find_step(RtxDoc *d, size_t budget) {
    size_t qn;
    if (!d) return cc_err(CC_ERR_INVALID_ARG, "null doc");
    qn = d->find.query.len;
    if (qn == 0 || qn > d->len()) {
        d->find.done = 1;
        return cc_ok(rtx_find_finish_step(d, 0));
    }
    if (budget == 0) budget = RTX_FIND_BUDGET;
    if (budget >= RTX_FIND_BUDGET) return rtx_find_step_parallel(d);
    return rtx_find_step_serial(d, budget);
}

static size_t rtx_find_near(const RtxDoc *d) {
    size_t i;
    if (!d || d->find.len == 0) return (size_t)-1;
    for (i = 0; i < d->find.len; i++) {
        if (d->find.offs[i] >= d->find.origin) return i;
    }
    if (d->find.done) return 0;
    return (size_t)-1;
}

static void rtx_find_place(RtxDoc *d, size_t i) {
    size_t n;
    if (!d || d->find.len == 0) return;
    if (i >= d->find.len) i = d->find.len - 1;
    d->find.cur = i;
    d->caret = d->find.offs[i];
    n = d->len();
    d->sel_anchor = d->caret + d->find.query.len;
    if (d->sel_anchor > n) d->sel_anchor = n;
    d->break_coalesce();
}

static void rtx_find_auto_land(RtxDoc *d) {
    size_t i;
    if (!d || d->find.pinned) return;
    i = rtx_find_near(d);
    if (i == (size_t)-1) return;
    if (d->find.cur == i && d->caret == d->find.offs[i]) return;
    rtx_find_place(d, i);
}

static void RtxDoc_find_goto(RtxDoc *d, size_t i) {
    if (!d) return;
    d->find.pinned = 1;
    rtx_find_place(d, i);
}

static void RtxDoc_find_next(RtxDoc *d) {
    if (!d || d->find.len == 0) return;
    d->find_goto((d->find.cur + 1) % d->find.len);
}

static void RtxDoc_find_prev(RtxDoc *d) {
    if (!d || d->find.len == 0) return;
    d->find_goto(d->find.cur == 0 ? d->find.len - 1 : d->find.cur - 1);
}

static void !>(CCError) RtxDoc_find_hit_view(RtxDoc *d, size_t i, CCArena *scratch,
                                            size_t maxn, RtxFindHitView *out) {
    size_t off;
    size_t n;
    size_t a;
    size_t z;
    size_t pad;
    @errhandler(CCError e) {
        return cc_err(e);
    }
    if (!d || !scratch || !out) return cc_err(CC_ERR_INVALID_ARG, "find hit");
    if (i >= d->find.len) return cc_err(CC_ERR_INVALID_ARG, "find hit");
    memset(out, 0, sizeof(*out));
    off = d->find.offs[i];
    n = d->len();
    if (maxn < 8) maxn = 8;
    pad = maxn / 4;
    a = (off > pad) ? off - pad : 0;
    z = a + maxn;
    if (z > n) z = n;
    out->off = off;
    out->line1 = d->line_guess(off) + 1;
    out->col = (off >= a) ? off - a : 0;
    if (z <= a) {
        out->ctx = cc_slice_empty();
        return cc_ok();
    }
    {
        char[:] bytes = d->scratch_span(scratch, a, z - a) !>;
        out->ctx = bytes;
    }
    return cc_ok();
}

#endif /* RTX_FIND_H */
