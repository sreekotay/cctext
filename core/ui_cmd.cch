/*
 * Shared command ids. Closed dispatch (no default: at the call site).
 * Hosts map platform events onto these; native menus use the same tags.
 * The command table (cmd.cch) names each one ("file.save") and carries
 * its title, keys and menu.
 */
#ifndef RTX_UI_CMD_H
#define RTX_UI_CMD_H

enum {
    CMD_NONE = 0,
    CMD_SAVE,
    CMD_UNDO,
    CMD_REDO,
    CMD_CUT,
    CMD_COPY,
    CMD_PASTE,
    CMD_PANE,
    CMD_NEXT,
    CMD_SPLIT,
    CMD_QUIT,
    CMD_JUMP,
    CMD_FIND,
    CMD_OPEN,
    CMD_BROWSE,
    CMD_HELP,
    CMD_SEL_ALL,
    CMD_VIEW,
    CMD_FOLLOW,
    CMD_NAV_NEXT,
    CMD_NAV_PREV,
    CMD_NAV_INV,
    CMD_NAV_INV_PREV,
    CMD_FOLD,
    CMD_STATS,
    CMD_RICH, /* markup lens: Source / Rich per pane */
    CMD_WRAP, /* soft wrap on / off per pane */
    CMD_APPLY,      /* cycle the first prefix apply on this line / off */
    CMD_APPLY_NAMED, /* toolbar / help digit: name from the grammar table */
    CMD_APPLY_MENU,  /* toggle the on-screen apply palette */
    CMD_REPLACE,     /* find with the replace row open (Edit > Replace) */
    /* Markdown table commands, in RTX_TBL_* order (Apply > Table). */
    CMD_TBL_ROW_ABOVE,
    CMD_TBL_ROW_BELOW,
    CMD_TBL_ROW_DEL,
    CMD_TBL_COL_LEFT,
    CMD_TBL_COL_RIGHT,
    CMD_TBL_COL_DEL,
    CMD_TBL_COL_MOVE_L,
    CMD_TBL_COL_MOVE_R,
    CMD_PALETTE,     /* command palette (core/cmd.cch table) */
    /* Find-field toggles (Alt-C / W / R / E / A / L while find is open). */
    CMD_FIND_ICASE,
    CMD_FIND_WORD,
    CMD_FIND_REGEX,
    CMD_FIND_REPL_ROW,
    CMD_REPL_ALL,
    CMD_REPL_SCOPE,
    CMD_ROW,         /* a table row with its own `run` (the host keeps the row) */
    /* Host-dispatched ids for rows other agents add go here; a row with a
     * `run` hook needs none. */
    /* Buffers and panes (rows buffer.* / pane.* / view.tabs in cmd.ccs).
     * CMD_PANE is pane.focus_next; CMD_NEXT stays file.next (Ctrl-N, which
     * in browse launches this frontend). */
    CMD_BUF_NEXT,     /* buffer.next */
    CMD_PREV,         /* buffer.prev */
    CMD_CLOSE,        /* buffer.close: the focused buffer (asks when unsaved) */
    CMD_CLOSE_OTHERS, /* buffer.close_others */
    CMD_CLOSE_ALL,    /* buffer.close_all */
    CMD_SPLIT_RIGHT,  /* pane.split_right */
    CMD_SPLIT_DOWN,   /* pane.split_down */
    CMD_PANE_CLOSE,   /* pane.close */
    CMD_PANE_PREV,    /* pane.focus_prev */
    CMD_PANE_MOVE,    /* pane.move_buffer: this buffer into the next pane */
    CMD_PANE_LEFT,    /* pane.resize_left: the nearest divider moves left */
    CMD_PANE_RIGHT,   /* pane.resize_right */
    CMD_PANE_UP,      /* pane.resize_up */
    CMD_PANE_DOWN,    /* pane.resize_down */
    CMD_TABS,         /* view.tabs: tab bar on / off */
    /* Project (core/ui_proj.cch): rows "workspace.quick_open" (Ctrl-P /
     * Cmd-P), "workspace.search" (Ctrl-Shift-F / Cmd-Shift-F; Alt-Shift-F
     * in a terminal that sends Ctrl-F for both), "workspace.search_next" /
     * "workspace.search_prev" (F4 / Shift-F4), "workspace.reindex" (F5). */
    CMD_QUICK_OPEN,
    CMD_PROJ_SEARCH,
    CMD_PROJ_NEXT,
    CMD_PROJ_PREV,
    CMD_PROJ_REWALK,
    /* Marp slides (core/slides.cch, docs/slides.md): "slides.present"
     * (Shift-F5) shows the deck full-window; "go.slide" opens the jump
     * field on `#` (a slide number). */
    CMD_PRESENT,
    CMD_SLIDE_GOTO,
    CMD__END
};

#endif /* RTX_UI_CMD_H */
