#!ccc ccs
/*
 * Document (linked TU; see document.cch). Hosts include the face for
 * types / UFCS; this file owns the RtxDoc bodies, including edit,
 * highlight, and tm.
 */
#include <ccc/std/prelude.cch>
#include <stdint.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <pthread.h>
#include <sys/stat.h>
#include "utf8.cch"
#include "document.cch"
#include "md_table.cch"
#include "nav.cch"
#include "lf.cch"
#include "wb.cch"


static int rtx_cstr_eq(const char *a, const char *b) {
    CCSlice aa, bb;
    if (!a || !b) return 0;
    aa = cc_slice_cstr(a);
    bb = cc_slice_cstr(b);
    return cc_slice_eq(&aa, bb);
}

static int rtx_cstr_eq_lit(const char *a, const char *lit) {
    CCSlice aa;
    if (!a || !lit) return 0;
    aa = cc_slice_cstr(a);
    return cc_slice_eq_cstr(&aa, lit);
}

static void !>(CCError) rtx_doc_highlight(RtxDoc *d);
static void rtx_doc_hl_abort(RtxDoc *d);
static void rtx_doc_ident_stamp(RtxDoc *d, char[:0] path);
static int rtx_doc_add_section(RtxDoc *d, size_t start, RtxSectionKind kind);
static RtxSectionKind rtx_doc_path_kind(const RtxDoc *d);
static int !>(CCError) rtx_doc_cluster_at(const RtxDoc *d, size_t off,
                                         size_t *start, RtxUtf8Cl *cl);

RtxHlWin rtx_hl_win(size_t from, size_t n) {
    RtxHlWin w;
    w.from = from;
    w.n = n > (size_t)RTX_HL_WIN_MAX ? (size_t)RTX_HL_WIN_MAX : n;
    w.keep = 0;
    return w;
}

RtxHlWin rtx_hl_span(size_t from, size_t to) {
    return rtx_hl_win(from, to > from ? to - from : 0);
}

RtxHlWin rtx_hl_keep(size_t from, size_t n) {
    RtxHlWin w = rtx_hl_win(from, n);
    w.keep = 1;
    return w;
}

void rtx_find_handle_stop(RtxFind *f) {
    if (!f) return;
    f->cancel = 1;
    if (!f->h.live()) return;
    /* Resume first so a write-stage pause poll can see cancel and leave. */
    if (f->h.paused())
        f->h.resume() !>(e) { (void)e; };
    f->h.wait() !>(e) { (void)e; };
}

/* Join the find arm before the tree moves. Its lanes walk nodes and
 * pread the store; a pause gates only the write stage. The cancel the
 * stop raised was ours: put back what the host had, so the list resumes
 * from scan_off (or the edit patch republishes it). The tree joins its
 * own island on every mutating entry. */
static void rtx_find_join(RtxFind *f) {
    unsigned char was;
    if (!f || !f->h.live()) return;
    was = f->cancel;
    rtx_find_handle_stop(f);
    f->cancel = was;
}

static size_t !>(CCError) rtx_doc_utf8_win(const RtxDoc *d, size_t off,
                                          char *buf, size_t cap, size_t *base) {
    size_t n, lo, hi, got, take;
    if (!d || !buf || !base || cap == 0) {
        return cc_err(CC_ERR_INVALID_ARG, "utf8 win");
    }
    n = d->len();
    if (off > n) off = n;
    lo = off > (size_t)RTX_UTF8_LOOK ? off - (size_t)RTX_UTF8_LOOK : 0;
    hi = off + (size_t)RTX_UTF8_LOOK;
    if (hi > n) hi = n;
    if (hi < lo) hi = lo;
    take = hi - lo;
    if (take > cap) {
        size_t keep = cap / 2;
        if (off - lo > keep) lo = off - keep;
        if (hi > lo + cap) hi = lo + cap;
        take = hi - lo;
    }
    *base = lo;
    if (take == 0) return cc_ok((size_t)0);
    got = d->read_at(lo, cc_slice_from_buffer(buf, take)) !>(e) { return cc_err(e); };
    return cc_ok(got);
}

size_t !>(CCError) RtxDoc_cluster_align(const RtxDoc *d, size_t off) {
    char buf[RTX_UTF8_LOOK * 2];
    size_t base, got, rel, n;
    if (!d) return cc_err(CC_ERR_INVALID_ARG, "null doc");
    n = d->len();
    if (off > n) off = n;
    got = rtx_doc_utf8_win(d, off, buf, sizeof(buf), &base) !>(e) {
        return cc_err(e);
    };
    rel = off - base;
    if (rel > got) rel = got;
    return cc_ok(base + rtx_utf8_align(buf.to_slice_n(got), rel));
}

size_t !>(CCError) RtxDoc_cluster_next(const RtxDoc *d, size_t off) {
    char buf[RTX_UTF8_LOOK * 2];
    size_t base, got, rel, n;
    if (!d) return cc_err(CC_ERR_INVALID_ARG, "null doc");
    n = d->len();
    if (off >= n) return cc_ok(n);
    got = rtx_doc_utf8_win(d, off, buf, sizeof(buf), &base) !>(e) {
        return cc_err(e);
    };
    rel = off - base;
    if (rel > got) rel = got;
    return cc_ok(base + rtx_utf8_next(buf.to_slice_n(got), rel));
}

size_t !>(CCError) RtxDoc_cluster_prev(const RtxDoc *d, size_t off) {
    char buf[RTX_UTF8_LOOK * 2];
    size_t base, got, rel, n;
    if (!d) return cc_err(CC_ERR_INVALID_ARG, "null doc");
    n = d->len();
    if (off == 0) return cc_ok((size_t)0);
    if (off > n) off = n;
    got = rtx_doc_utf8_win(d, off, buf, sizeof(buf), &base) !>(e) {
        return cc_err(e);
    };
    rel = off - base;
    if (rel > got) rel = got;
    return cc_ok(base + rtx_utf8_prev(buf.to_slice_n(got), rel));
}

size_t !>(RtxIndexErr) rtx_doc_line_floor_local(const RtxDoc *d, size_t off) {
    char buf[512];
    size_t at, left;
    if (!d || off == 0) return cc_ok((size_t)0);
    at = off;
    left = (size_t)RTX_LINE_FLOOR_MAX;
    while (at > 0 && left > 0) {
        size_t take = at > sizeof(buf) ? sizeof(buf) : at;
        size_t got, i;
        if (take > left) take = left;
        got = d->read_at(at - take, cc_slice_from_buffer(buf, take)) !>(e) {
            return cc_err(rtx_index_from_cc(e));
        };
        if (!got) return cc_ok((size_t)0);
        i = rtx_last_lf(buf, got);
        if (i != (size_t)-1) return cc_ok(at - take + i + 1);
        at -= got;
        left -= got;
    }
    return cc_ok(at);
}

size_t !>(RtxIndexErr) rtx_doc_line_floor(const RtxDoc *d, size_t off) {
    if (!d || off == 0) return cc_ok((size_t)0);
    if (RtxDoc_index_covers(d, off)) {
        size_t ln = RtxDoc_line_of(d, off) !>(e) { return cc_err(e); };
        return RtxDoc_line_start(d, ln);
    }
    return rtx_doc_line_floor_local(d, off);
}

size_t !>(RtxIndexErr) rtx_doc_line_next(const RtxDoc *d, size_t off) {
    char buf[512];
    size_t n, at, left;
    if (!d) return cc_ok((size_t)0);
    n = d->len();
    if (off >= n) return cc_ok(n);
    if (RtxDoc_index_covers(d, off)) {
        size_t ln = RtxDoc_line_of(d, off) !>(e) { return cc_err(e); };
        size_t known = RtxDoc_line_known(d);
        if (ln + 1 < known) return RtxDoc_line_start(d, ln + 1);
    }
    at = off;
    left = (size_t)RTX_LINE_FLOOR_MAX;
    while (at < n && left > 0) {
        size_t take = n - at;
        size_t got, i;
        if (take > sizeof(buf)) take = sizeof(buf);
        if (take > left) take = left;
        got = d->read_at(at, cc_slice_from_buffer(buf, take)) !>(e) {
            return cc_err(rtx_index_from_cc(e));
        };
        if (!got) break;
        for (i = 0; i < got; i++) {
            if (buf[i] == '\n') return cc_ok(at + i + 1);
        }
        at += got;
        left -= got;
    }
    return cc_ok(at < n ? at : n);
}

int !>(RtxIndexErr) rtx_doc_next_line_start(const RtxDoc *d, size_t start,
                                                   size_t *next_out) {
    size_t next;
    char ch = 0;
    size_t got;
    if (!d) return cc_ok(0);
    next = rtx_doc_line_next(d, start) !>(e) { return cc_err(e); };
    if (next_out) *next_out = next;
    if (next <= start) return cc_ok(0);
    got = d->read_at(next - 1, cc_slice_from_buffer(&ch, 1)) !>(e) {
        return cc_err(rtx_index_from_cc(e));
    };
    return cc_ok(got == 1 && ch == '\n' ? 1 : 0);
}

long rtx_doc_lf_delta_local(const RtxDoc *d, size_t from, size_t to) {
    char buf[512];
    size_t a, b, left, seen;
    int neg;
    @errhandler(CCError e) {
        (void)e;
        return 0;
    }
    if (!d || from == to) return 0;
    if (to < from) {
        a = to;
        b = from;
        neg = 1;
    } else {
        a = from;
        b = to;
        neg = 0;
    }
    if (b - a > (size_t)RTX_LINE_FLOOR_MAX) return 0;
    left = b - a;
    seen = 0;
    while (left) {
        size_t take = left > sizeof(buf) ? sizeof(buf) : left;
        size_t got;
        got = d->read_at(a, cc_slice_from_buffer(buf, take)) !>;
        if (!got) break;
        seen += rtx_count_lf(buf, got);
        a += got;
        left -= got;
    }
    return neg ? -(long)seen : (long)seen;
}

int RtxDoc_init_epochs(RtxDoc *d) {
    if (!d) return 0;
    d->session = cc_arena_malloc(kilobytes(16));
    d->analysis = cc_arena_malloc(kilobytes(16));
    return d->session.base != NULL && d->analysis.base != NULL;
}

char[:] !>(CCError) rtx_session_bytes(RtxDoc *d, char[:] src) {
    char[:] out;
    if (!d) return cc_err(CC_ERR_INVALID_ARG, "session bytes");
    if (src.len == 0) return cc_ok(cc_slice_empty());
    if (!src.ptr) {
        out = d->session.alloc_slice_bytes(src.len);
        if (!out.ptr) return cc_err(CC_ERR_OUT_OF_MEMORY, "session bytes");
        return cc_ok(out);
    }
    return src.clone_into(d->session);
}

Vec::[char] !>(CCError) rtx_hist_buf(RtxDoc *d, size_t n) {
    Vec::[char] v;
    if (!d) return cc_err(CC_ERR_INVALID_ARG, "hist buf");
    if (n == 0) return cc_ok((Vec::[char]){0});
    v = vec_new::[char](d->session);
    if (!v.data() || v.reserve(n) != 0 || !v.at_grow(n - 1))
        return cc_err(CC_ERR_OUT_OF_MEMORY, "hist buf");
    return cc_ok(v);
}

Vec::[char] !>(CCError) rtx_hist_own(RtxDoc *d, char[:] src) {
    Vec::[char] v;
    @errhandler(CCError e) { return cc_err(e); }
    if (!d) return cc_err(CC_ERR_INVALID_ARG, "hist own");
    if (src.len == 0) return cc_ok((Vec::[char]){0});
    if (!src.ptr) return rtx_hist_buf(d, src.len);
    v = rtx_hist_buf(d, src.len) !>;
    {
        char[:] dst = v.as_slice();
        dst.copy(src) !>;
    }
    return cc_ok(v);
}

static char[:] !>(CCError) rtx_session_str(RtxDoc *d, char[:0] s) {
    size_t n;
    char[:] out;
    @errhandler(CCError e) { return cc_err(e); }
    if (!d || !s.ptr) return cc_err(CC_ERR_INVALID_ARG, "session str");
    n = s.len;
    {
        char[:] src = cc_slice_from_buffer((void *)s.ptr, n + 1);
        out = src.clone_into(d->session) !>;
    }
    return cc_ok(out.sub(0, n));
}

static void rtx_doc_unbind_analysis(RtxDoc *d) {
    if (!d) return;
    d->secs.destroy();
    d->runs.destroy();
    d->run_top.destroy();
    d->run_top_n = 0;
    d->run_top_of = NULL;
    d->runs_sorted = 0;
    d->runs_maxlen = 0;
    d->runs_marks = 0;
    d->runs_trim = 0;
    d->tm_ckpt.destroy();
    d->hl_cov = (RtxHlCov){0};
}

void RtxDoc_analysis_reset(RtxDoc *d) {
    if (!d) return;
    rtx_doc_unbind_analysis(d);
    if (d->analysis.base) d->analysis.reset();
    {
        size_t i;
        for (i = 0; i < (size_t)RTX_MARKUP_CACHE_WINDOWS; i++)
            d->hl_win[i] = (RtxMarkupWin){0};
    }
    d->hl_win_stamp = 0;
    d->hl_full = 0;
    d->fold_n = 0;
}

void rtx_hist_clear(RtxHistory *h) {
    if (!h) return;
    *h = (RtxHistory){0};
}

RtxHistRec rtx_hist_rec_empty(void) {
    RtxHistRec r = {0};
    r.del = (RtxHistDel){ .text = {0} };
    return r;
}

size_t rtx_hist_del_n(const RtxHistRec *r) {
    if (!r) return 0;
    @switch (r->del) {
        case .text: {
            Vec::[char] buf = r->del.text;
            return buf.len();
        }
        case .pieces(refs):
            return refs.nbytes;
    }
    return 0;
}

int rtx_hist_del_is_pieces(const RtxHistRec *r) {
    if (!r) return 0;
    @switch (r->del) {
        case .pieces:
            return 1;
        case .text:
            return 0;
    }
    return 0;
}

RtxHistRefs rtx_hist_del_pieces(const RtxHistRec *r) {
    RtxHistRefs z = {0};
    if (!r) return z;
    @switch (r->del) {
        case .pieces(refs):
            return refs;
        case .text:
            return z;
    }
    return z;
}

void RtxDoc_break_coalesce(RtxDoc *d) {
    if (d) d->hist.coalesce = 0;
}

/* Mark policy (join, apply, unwrap, toggle) is one `replace` and its own
 * hist record: typing before it does not absorb it, typing after it does
 * not extend it. */
static void !>(CCError) rtx_doc_policy_replace(RtxDoc *d, size_t off, size_t n,
                                              char[:] ins) {
    RtxDoc_break_coalesce(d);
    d->replace(off, n, ins) !>(e) { return cc_err(e); };
    RtxDoc_break_coalesce(d);
    return cc_ok();
}

int RtxDoc_dirty(const RtxDoc *d) {
    return d && d->hist.head != d->saved_head;
}

int RtxDoc_has_sel(const RtxDoc *d) {
    if (!d) return 0;
    if (d->sel_box) {
        if (d->sel_anchor != d->caret) return 1;
        return d->box_acol != d->box_ccol;
    }
    return d->sel_anchor != d->caret;
}

size_t RtxDoc_sel_lo(const RtxDoc *d) {
    if (!d) return 0;
    return d->sel_anchor < d->caret ? d->sel_anchor : d->caret;
}

size_t RtxDoc_sel_hi(const RtxDoc *d) {
    if (!d) return 0;
    return d->sel_anchor > d->caret ? d->sel_anchor : d->caret;
}

void RtxDoc_clear_sel(RtxDoc *d) {
    if (!d) return;
    d->sel_anchor = d->caret;
    d->sel_box = 0;
}

void RtxDoc_select_all(RtxDoc *d) {
    if (!d) return;
    d->sel_anchor = 0;
    d->caret = d->len();
    d->sel_box = 0;
    RtxDoc_break_coalesce(d);
}

int RtxDoc_can_undo(const RtxDoc *d) {
    return d && d->hist.head > 0;
}

int RtxDoc_can_redo(const RtxDoc *d) {
    return d && d->hist.head < d->hist.len;
}

void RtxDoc_destroy(RtxDoc *d) {
    if (!d) return;
    /* Find lanes read the tree: join them before it goes. The tree
     * joins its island first thing in its own destroy. */
    rtx_find_handle_stop(&d->find);
    if (d->derived && d->derived->destroy) d->derived->destroy(d->derived->ctx);
    d->derived = NULL;
    d->tree.destroy();
    rtx_hist_clear(&d->hist);
    if (d->session.base) d->session.destroy();
    rtx_doc_unbind_analysis(d);
    if (d->analysis.base) d->analysis.destroy();
    rtx_mdref_free(&d->mdref);
    /* Always run — overflow slabs can outlive `.base` after a reset. */
    if (d->find.store.base) d->find.store.reset();
    d->find.store.destroy();
    *d = (RtxDoc){0};
}

static int rtx_doc_is_live(const RtxDoc *d) {
    return d && (RtxPieceTree_is_live(&d->tree) || d->session.base || d->analysis.base);
}

void !>(CCError) RtxDoc_empty(RtxDoc *d) {
    if (!d) return cc_err(CC_ERR_INVALID_ARG, "null doc");
    if (rtx_doc_is_live(d)) return cc_err(CC_ERR_INVALID_ARG, "doc already live");
    *d = (RtxDoc){0};
    d->tree.empty() !>(e) { return cc_err(e); };
    if (!RtxDoc_init_epochs(d) || !rtx_doc_add_section(d, 0, RTX_SEC_PROSE)) {
        d->destroy();
        return cc_err(CC_ERR_OUT_OF_MEMORY, "doc epochs");
    }
    return cc_ok();
}

RtxSectionKind RtxDoc_section_at(const RtxDoc *d, size_t off) {
    size_t lo, hi, i;
    if (!d || d->secs.len == 0) return RTX_SEC_PROSE;
    if (d->len() > (size_t)RTX_MARKUP_SCAN_MAX && off > 0) {
        int covered = 0;
        for (i = 0; i < (size_t)RTX_MARKUP_CACHE_WINDOWS; i++) {
            const RtxMarkupWin *w = &d->hl_win[i];
            if (w->live && off >= w->anchor && off <= w->to) {
                covered = 1;
                break;
            }
        }
        if (!covered) return RTX_SEC_UNKNOWN;
    }
    lo = 0;
    hi = d->secs.len;
    while (lo + 1 < hi) {
        size_t mid = lo + (hi - lo) / 2;
        if (d->secs.data[mid].start <= off) lo = mid;
        else hi = mid;
    }
    return d->secs.data[lo].kind;
}

/* Run order: start, then the longer (outer) first, so an inner run that
 * shares its start (a capture, an HTML block's first tag) paints over it
 * whichever lex — full or edit relex — planted them. */
static int rtx_run_start_cmp(const void *a, const void *b) {
    const RtxRun *ra = (const RtxRun *)a;
    const RtxRun *rb = (const RtxRun *)b;
    if (ra->start < rb->start) return -1;
    if (ra->start > rb->start) return 1;
    /* Same start after window emit clip: outer (longer) before inner so
     * style_at's last-covering-wins is the innermost scope. */
    if (ra->len > rb->len) return -1;
    if (ra->len < rb->len) return 1;
    return 0;
}

/* A checkpoint past an edit is shifted and marked stale (RtxTmCkpt.n high
 * bit): never a seed, only a place where an edit relex may prove it has
 * converged with the old lex (rtx_doc_relex_edit). A window checkpoint
 * (WIN) is the state of a lookback lex from its anchor (d->hl_cov), not of
 * a lex from the section start: an edit relex inside that window seeds
 * from it; a catch-up (rtx_tm_ckpt_find) never does. */
#define RTX_TM_CKPT_STALE 0x80
#define RTX_TM_CKPT_WIN 0x40
#define RTX_TM_CKPT_N(c)                                                       \
    ((c)->n & (unsigned char)~(RTX_TM_CKPT_STALE | RTX_TM_CKPT_WIN))

static void rtx_tm_ckpt_drop_from(RtxDoc *d, size_t off) {
    if (!d) return;
    if (d->hl_cov.live && off <= d->hl_cov.hi) d->hl_cov.live = 0;
    while (d->tm_ckpt.len && d->tm_ckpt.data[d->tm_ckpt.len - 1].off >= off) {
        RtxTmCkpt dump;
        d->tm_ckpt.pop(&dump);
    }
}

static const RtxTmCkpt *rtx_tm_ckpt_find(const RtxDoc *d, size_t lo) {
    size_t a, b;
    if (!d || d->tm_ckpt.len == 0) return NULL;
    a = 0;
    b = d->tm_ckpt.len;
    while (a + 1 < b) {
        size_t mid = a + (b - a) / 2;
        if (d->tm_ckpt.data[mid].off <= lo) a = mid;
        else b = mid;
    }
    while (a > 0 && (d->tm_ckpt.data[a].n & (RTX_TM_CKPT_STALE | RTX_TM_CKPT_WIN))) a--;
    if (d->tm_ckpt.data[a].n & (RTX_TM_CKPT_STALE | RTX_TM_CKPT_WIN)) return NULL;
    if (d->tm_ckpt.data[a].off <= lo) return &d->tm_ckpt.data[a];
    return NULL;
}

/* A stale checkpoint lives from the edit that shifted it to that edit's
 * reparse: whatever the relex did not re-prove is dropped there. */
static void rtx_tm_ckpt_drop_stale(RtxDoc *d) {
    size_t i, w = 0;
    if (!d) return;
    for (i = 0; i < d->tm_ckpt.len; i++) {
        if (d->tm_ckpt.data[i].n & RTX_TM_CKPT_STALE) continue;
        d->tm_ckpt.data[w++] = d->tm_ckpt.data[i];
    }
    d->tm_ckpt.truncate(w);
}

/* Edit at `at`: checkpoints at or before it keep their state; inside the
 * erased bytes they go; past it they shift and go stale. */
static void rtx_tm_ckpt_shift(RtxDoc *d, size_t at, size_t erased, size_t inserted) {
    size_t i, w = 0;
    if (!d) return;
    for (i = 0; i < d->tm_ckpt.len; i++) {
        RtxTmCkpt c = d->tm_ckpt.data[i];
        if (c.off > at) {
            if (c.off <= at + erased) continue;
            c.off = c.off - erased + inserted;
            c.n |= RTX_TM_CKPT_STALE;
        }
        d->tm_ckpt.data[w++] = c;
    }
    d->tm_ckpt.truncate(w);
}


static int rtx_tm_ckpt_add(RtxDoc *d, size_t off, size_t sp,
                           const size_t *stk_rule, const size_t *stk_lang,
                           const size_t *stk_embed, unsigned char flag,
                           const RtxMdb *mdb) {
    RtxTmCkpt *c;
    size_t i, n;
    if (!d) return 0;
    if (!d->tm_ckpt.data) {
        Vec::[RtxTmCkpt] planted = vec_new::[RtxTmCkpt](d->analysis);
        if (!planted.data) return 0;
        d->tm_ckpt = planted;
    }
    if (d->tm_ckpt.len && d->tm_ckpt.data[d->tm_ckpt.len - 1].off > off) {
        rtx_tm_ckpt_drop_from(d, off);
    }
    if (d->tm_ckpt.len && d->tm_ckpt.data[d->tm_ckpt.len - 1].off == off) {
        c = &d->tm_ckpt.data[d->tm_ckpt.len - 1];
    } else {
        if (d->tm_ckpt.len >= RTX_TM_CKPT_MAX) {
            /* Full (a camera that scrolled megabytes on): every other one
             * in the lower half goes. Each left is still that offset's
             * state; the far ones are just sparser seeds, and the lex keeps
             * planting where the camera is. */
            size_t k, w = 0, half = d->tm_ckpt.len / 2;
            for (k = 0; k < d->tm_ckpt.len; k++)
                if (k >= half || !(k & 1)) d->tm_ckpt.data[w++] = d->tm_ckpt.data[k];
            d->tm_ckpt.truncate(w);
        }
        c = d->tm_ckpt.push_ptr();
        if (!c) return 0;
    }
    c->off = off;
    n = sp < (size_t)RTX_TM_CKPT_DEPTH ? sp : (size_t)RTX_TM_CKPT_DEPTH;
    c->n = (unsigned char)(n | flag);
    c->md = mdb != NULL;
    if (mdb) c->mdb = *mdb;
    for (i = 0; i < n; i++) {
        c->rule[i] = (unsigned short)stk_rule[i];
        c->lang[i] = (unsigned short)stk_lang[i];
        c->embed[i] = (unsigned short)stk_embed[i];
    }
    return 1;
}

/* Run index: a max-of-end tree over runs in start order (leaves at
 * [P, P + len), node p = max of 2p, 2p+1). "Leftmost run at or after i
 * whose end reaches x" is one descent, so a lookup skips every earlier
 * sibling instead of walking back to index 0. Built only where runs are
 * known sorted; any other write leaves it stale (n / data no longer match)
 * and lookups take the linear walk. Lives on d.analysis with the runs. */
static void rtx_doc_run_top_build(RtxDoc *d) {
    size_t n, leaves, i, mx = 0;
    size_t *t;
    int marks = 0;
    if (!d) return;
    d->run_top_n = 0;
    d->run_top_of = NULL;
    n = d->runs.len;
    /* Callers build only over sorted runs: the whole list is the clip's
     * sorted prefix, and one pass notes the longest run and any hint. */
    for (i = 0; i < n; i++) {
        if (d->runs.data[i].len > mx) mx = d->runs.data[i].len;
        if (d->runs.data[i].hint_a) marks = 1;
    }
    d->runs_sorted = n;
    d->runs_maxlen = mx;
    d->runs_marks = marks;
    if (n == 0) return;
    leaves = 1;
    while (leaves < n) leaves <<= 1;
    if (!d->run_top.data) {
        Vec::[size_t] planted = vec_new::[size_t](d->analysis);
        if (!planted.data) return;
        d->run_top = planted;
    }
    d->run_top.truncate(0);
    if (!d->run_top.at_grow(2 * leaves - 1)) return;
    t = d->run_top.data;
    for (i = 0; i < leaves; i++)
        t[leaves + i] = i < n ? d->runs.data[i].start + d->runs.data[i].len : 0;
    for (i = leaves - 1; i > 0; i--)
        t[i] = t[2 * i] > t[2 * i + 1] ? t[2 * i] : t[2 * i + 1];
    d->run_top_n = n;
    d->run_top_of = d->runs.data;
}

/* Every write to runs other than sort drops the index. */
static void rtx_doc_run_top_drop(RtxDoc *d) {
    d->run_top_n = 0;
    d->run_top_of = NULL;
}

static int rtx_doc_run_top_live(const RtxDoc *d) {
    return d->run_top_n && d->run_top_n == d->runs.len &&
           d->run_top_of == d->runs.data;
}

/* Back to an earlier length: what stays below `w` did not move. */
static void rtx_doc_runs_cut(RtxDoc *d, size_t w) {
    d->runs.truncate(w);
    if (d->runs_sorted > w) d->runs_sorted = w;
}

/* Leftmost index k >= a with end(k) >= x, else runs.len. Requires live. */
static size_t rtx_doc_run_top_find(const RtxDoc *d, size_t a, size_t x) {
    const size_t *t = d->run_top.data;
    size_t n = d->runs.len, leaves = d->run_top.len / 2, p;
    if (a >= n) return n;
    p = leaves + a;
    while (t[p] < x) {
        while (p & 1) p >>= 1;
        if (p == 0) return n;
        p++;
    }
    while (p < leaves) {
        p <<= 1;
        if (t[p] < x) p++;
    }
    return p - leaves < n ? p - leaves : n;
}

/* Runs are a sorted prefix (clip and shift keep order) plus what a lex just
 * appended. Sort the tail and merge it in from the back: a full qsort of
 * every run in the document per keystroke was most of a small-file edit.
 * Equal starts: outer (longer) before inner — same as rtx_run_start_cmp. */
static int rtx_run_before(const RtxRun *a, const RtxRun *b) {
    if (a->start != b->start) return a->start < b->start;
    return a->len > b->len;
}

/* Stable natural merge sort: a lex appends its runs nearly in order (a
 * span lands after the tokens inside it), so the ascending stretches are
 * long and a pass merges them without a comparator call per pair. */
static void rtx_runs_msort(RtxRun *a, size_t n, RtxRun *tmp) {
    RtxRun *src = a, *dst = tmp;
    if (n < 2) return;
    for (;;) {
        size_t i = 0, merges = 0;
        while (i < n) {
            size_t m = i + 1, e, x, y, w;
            while (m < n && !rtx_run_before(&src[m], &src[m - 1])) m++;
            if (m == n) {
                memcpy(dst + i, src + i, (n - i) * sizeof(RtxRun));
                i = n;
                merges++;
                break;
            }
            e = m + 1;
            while (e < n && !rtx_run_before(&src[e], &src[e - 1])) e++;
            x = i;
            y = m;
            w = i;
            while (x < m && y < e) {
                if (rtx_run_before(&src[y], &src[x])) dst[w++] = src[y++];
                else dst[w++] = src[x++];
            }
            while (x < m) dst[w++] = src[x++];
            while (y < e) dst[w++] = src[y++];
            i = e;
            merges++;
        }
        {
            RtxRun *t = src;
            src = dst;
            dst = t;
        }
        if (merges <= 1) break;
    }
    if (src != a) memcpy(a, src, n * sizeof(RtxRun));
}

static void rtx_doc_sort_runs(RtxDoc *d) {
    size_t n, k, tn, i, j, w;
    RtxRun *a;
    CCArena t;
    RtxRun *tail, *tmp;
    if (!d) return;
    /* Nothing written since the last sort (every write but a cut to a
     * shorter length drops the index; a cut changes len). */
    if (rtx_doc_run_top_live(d)) return;
    if (d->runs.len < 2) {
        rtx_doc_run_top_build(d);
        return;
    }
    a = d->runs.data;
    n = d->runs.len;
    k = d->runs_sorted < n ? d->runs_sorted : n;
    if (k == 0) k = 1;
    while (k < n && !rtx_run_before(&a[k], &a[k - 1])) k++;
    if (k == n) {
        rtx_doc_run_top_build(d);
        return;
    }
    tn = n - k;
    t = cc_arena_heap((tn * 2 + (tn * 4 > n ? n : 0)) * sizeof(RtxRun) + 256);
    if (!t.base) {
        qsort(a, n, sizeof(RtxRun), rtx_run_start_cmp);
        rtx_doc_run_top_build(d);
        return;
    }
    if (tn * 4 > n) {
        tmp = (RtxRun *)cc_arena_alloc(t, n * sizeof(RtxRun), _Alignof(RtxRun));
        if (tmp) rtx_runs_msort(a, n, tmp);
        else qsort(a, n, sizeof(RtxRun), rtx_run_start_cmp);
        t.destroy();
        rtx_doc_run_top_build(d);
        return;
    }
    tail = (RtxRun *)cc_arena_alloc(t, tn * sizeof(RtxRun), _Alignof(RtxRun));
    tmp = (RtxRun *)cc_arena_alloc(t, tn * sizeof(RtxRun), _Alignof(RtxRun));
    if (!tail || !tmp) {
        t.destroy();
        qsort(a, n, sizeof(RtxRun), rtx_run_start_cmp);
        rtx_doc_run_top_build(d);
        return;
    }
    memcpy(tail, a + k, tn * sizeof(RtxRun));
    rtx_runs_msort(tail, tn, tmp);
    i = k;
    j = tn;
    w = n;
    while (j > 0) {
        if (i > 0 && rtx_run_before(&tail[j - 1], &a[i - 1])) a[--w] = a[--i];
        else a[--w] = tail[--j];
    }
    t.destroy();
    rtx_doc_run_top_build(d);
}

/* Clip rule: a run belongs to the pass that planted it (RtxRun.planter), not
 * to the style bits it carries. A TM / spike window re-lex clips RTX_RUN_TM
 * runs; the prose `*` / `` ` `` scanner clips RTX_RUN_PROSE runs. A run that
 * carries both a scope and a bold/italic/mono bit (grammar sidecar, injected
 * lex) is still owned by exactly one planter, so it is re-clipped on scroll
 * instead of growing forever. */
static int rtx_run_planted_tm(RtxRun r) {
    return r.planter == (unsigned char)RTX_RUN_TM ||
           r.planter == (unsigned char)RTX_RUN_INJECT;
}

static int rtx_run_planted_prose(RtxRun r) {
    return r.planter == (unsigned char)RTX_RUN_PROSE;
}

/* First index in [0, n) of the sorted prefix whose start >= x. */
static size_t rtx_doc_runs_lb(const RtxDoc *d, size_t n, size_t x) {
    size_t lo = 0, hi = n;
    while (lo < hi) {
        size_t mid = lo + (hi - lo) / 2;
        if (d->runs.data[mid].start < x) lo = mid + 1;
        else hi = mid;
    }
    return lo;
}

/* Drop `pred` runs inside [lo, hi) and keep the fragments outside, in
 * place. Only runs that can overlap [lo, hi) are read: in the sorted
 * prefix those start in [lo - longest run, hi) (or, with the index live,
 * reach past lo), then the unsorted tail a lex appended. Nothing to drop
 * reads O(log n + k); a drop moves the runs after the first one. A fresh
 * Vec per clip left the old backing live on the analysis arena until the
 * next full reparse — hundreds of MiB after a few dozen keys. A right
 * fragment [hi, end) of a prefix run ends the sorted prefix there.
 * `upto`: only runs before this index are candidates (an edit relex clips
 * the old runs it replaced, not the ones it just planted). */
static void !>(CCError) rtx_doc_clip_runs_upto(RtxDoc *d, size_t lo, size_t hi,
                                              int (*pred)(RtxRun), size_t upto) {
    size_t n, s, a, b, i, k, w, first = (size_t)-1, s_out, count;
    CCArena ta;
    RtxRun *src, *out;
    if (!d || !pred || hi <= lo || d->runs.len == 0) return cc_ok();
    n = d->runs.len;
    s = d->runs_sorted < n ? d->runs_sorted : n;
    /* Candidates in the sorted prefix: [a, b). */
    b = rtx_doc_runs_lb(d, s, hi);
    if (d->runs_maxlen == (size_t)-1) a = 0;
    else a = rtx_doc_runs_lb(d, b, lo > d->runs_maxlen ? lo - d->runs_maxlen : 0);
    if (rtx_doc_run_top_live(d)) {
        size_t t = rtx_doc_run_top_find(d, 0, lo + 1);
        if (t > a) a = t < b ? t : b;
    }
    for (i = a; i < b && i < upto; i++) {
        RtxRun r = d->runs.data[i];
        if (pred(r) && r.start + r.len > lo) {
            first = i;
            break;
        }
    }
    if (first == (size_t)-1) {
        for (i = s; i < n && i < upto; i++) {
            RtxRun r = d->runs.data[i];
            if (pred(r) && r.start < hi && r.start + r.len > lo) {
                first = i;
                break;
            }
        }
    }
    if (first == (size_t)-1) return cc_ok();
    /* Rewrite [first, n) from a copy: a run across both edges leaves two
     * fragments. */
    count = n - first;
    ta = cc_arena_heap(count * sizeof(RtxRun) + 128);
    src = ta.base ? (RtxRun *)cc_arena_alloc(ta, count * sizeof(RtxRun), _Alignof(RtxRun))
                  : NULL;
    if (!src || !d->runs.at_grow(first + 2 * count - 1)) {
        if (ta.base) ta.destroy();
        d->runs.truncate(n);
        return cc_err(CC_ERR_OUT_OF_MEMORY, "clip runs");
    }
    out = d->runs.data;
    memcpy(src, out + first, count * sizeof(RtxRun));
    w = first;
    s_out = s;
    for (k = 0; k < count; k++) {
        RtxRun r = src[k];
        size_t end = r.start + r.len;
        i = first + k;
        if (i == s && s_out == s) s_out = w;
        if (i >= upto || !pred(r) || end <= lo || r.start >= hi) {
            out[w++] = r;
            continue;
        }
        /* A fragment keeps only the hint whose edge it kept. */
        if (r.start < lo) {
            RtxRun p = r;
            p.len = lo - r.start;
            p.hint_b = 0;
            if (p.hint_a > p.len) p.hint_a = (unsigned char)p.len;
            out[w++] = p;
        }
        if (end > hi) {
            RtxRun q = r;
            q.start = hi;
            q.len = end - hi;
            q.hint_a = 0;
            if (q.hint_b > q.len) q.hint_b = (unsigned char)q.len;
            /* Its start moved past runs that follow: the sorted prefix
             * ends here (the next sort merges the rest). */
            if (i < s && w < s_out) s_out = w;
            out[w++] = q;
        }
    }
    if (s >= n && s_out == s) s_out = w;
    ta.destroy();
    d->runs.truncate(w);
    d->runs_sorted = s_out < w ? s_out : w;
    rtx_doc_run_top_drop(d);
    return cc_ok();
}

static void !>(CCError) rtx_doc_clip_runs(RtxDoc *d, size_t lo, size_t hi,
                                         int (*pred)(RtxRun)) {
    return rtx_doc_clip_runs_upto(d, lo, hi, pred, (size_t)-1);
}

int RtxDoc_fold_covers(const RtxDoc *d, size_t off) {
    size_t i;
    if (!d) return 0;
    for (i = 0; i < d->fold_n; i++) {
        if (off > d->folds[i].lo && off < d->folds[i].hi) return 1;
    }
    return 0;
}

size_t RtxDoc_fold_snap(const RtxDoc *d, size_t off, int dir) {
    if (!d || !d->fold_n) return off;
    return rtx_nav_snap(d->folds, d->fold_n, off, dir);
}

int RtxDoc_scope_step(RtxDoc *d, int dir, int invalid) {
    int r;
    if (!d) return 0;
    r = rtx_nav_step_at(d->runs.data, d->runs.len, &d->caret, &d->sel_anchor,
                        &d->sel_box, dir,
                        invalid ? rtx_nav_want_invalid : rtx_nav_want_mark,
                        d->folds, d->fold_n);
    if (r) d->hist.coalesce = 0;
    return r;
}

int RtxDoc_fold_toggle(RtxDoc *d) {
    int r;
    int at_eof;
    if (!d) return 0;
    /* Runs reach EOF: whole doc lexed, or the caret's markup window ends there. */
    at_eof = d->hl_full;
    if (!at_eof) {
        size_t i;
        size_t n = d->len();
        for (i = 0; i < (size_t)RTX_MARKUP_CACHE_WINDOWS; i++) {
            const RtxMarkupWin *w = &d->hl_win[i];
            if (w->live && w->ready && w->from <= d->caret && w->to == n) {
                at_eof = 1;
                break;
            }
        }
    }
    r = rtx_nav_fold_at(&d->caret, &d->sel_anchor, d->runs.data, d->runs.len,
                        &d->tree, d->folds, &d->fold_n, (size_t)RTX_FOLD_MAX,
                        at_eof);
    if (r) d->hist.coalesce = 0;
    return r;
}

static void rtx_doc_fold_shift(RtxDoc *d, size_t at, size_t erased, size_t inserted) {
    size_t i;
    size_t o = 0;
    if (!d) return;
    for (i = 0; i < d->fold_n; i++) {
        size_t lo = d->folds[i].lo;
        size_t hi = d->folds[i].hi;
        if (hi <= at) {
            d->folds[o++] = d->folds[i];
            continue;
        }
        if (lo >= at + erased) {
            d->folds[o].lo = lo - erased + inserted;
            d->folds[o].hi = hi - erased + inserted;
            o++;
            continue;
        }
    }
    d->fold_n = o;
}

/* Grow the edit span by one replace (old [at, at+erased) -> [at, at+inserted)).
 * The union stays one span: old bytes outside the pending span are
 * unchanged since gen0, so extending over them maps 1:1. */
static void rtx_doc_span_note(RtxDoc *d, size_t at, size_t erased, size_t inserted) {
    RtxEditSpan *s;
    size_t lo, hi_cur, hi_old;
    if (!d) return;
    if (d->derived) d->derived->note(d->derived->ctx, at, erased, inserted);
    s = &d->span;
    if (!s->live) {
        s->lo = at;
        s->hi = at + inserted;
        s->old_n = erased;
        s->live = 1;
        return;
    }
    lo = at < s->lo ? at : s->lo;
    hi_cur = s->hi > at + erased ? s->hi : at + erased;
    hi_old = s->lo + s->old_n + (hi_cur - s->hi);
    s->old_n = hi_old - lo;
    s->hi = hi_cur - erased + inserted;
    s->lo = lo;
}

/* One replace over one run (old [at, at+erased) -> inserted bytes).
 * Until the reparse, a run keeps a hint only while its bytes are intact:
 * an edit that eats or splits the opener / closer trims it. */
static void rtx_run_shift_one(RtxRun *r, size_t at, size_t erased, size_t inserted) {
    size_t start = r->start;
    size_t rlen = r->len;
    size_t end = start + rlen;
    if (end <= at) return;
    if (start >= at) {
        if (erased && start - at < erased) {
            size_t cut = at + erased - start;
            if (cut >= rlen) {
                r->len = 0;
                return;
            }
            r->start = at;
            r->len = rlen - cut;
            r->hint_a = 0;
            if (r->hint_b > r->len) r->hint_b = (unsigned char)r->len;
        } else {
            r->start = start - erased + inserted;
        }
    } else {
        size_t overlap = 0;
        if (erased) {
            size_t er_end = at + erased;
            size_t ov_end = end < er_end ? end : er_end;
            overlap = ov_end > at ? ov_end - at : 0;
            if (overlap > rlen) overlap = rlen;
        }
        if (at < start + r->hint_a) r->hint_a = (unsigned char)(at - start);
        if (r->hint_b && at + erased > end - r->hint_b)
            r->hint_b = at + erased >= end
                            ? 0
                            : (unsigned char)(end - (at + erased));
        r->len = rlen - overlap + inserted;
    }
}

static void rtx_doc_shift_intervals(RtxDoc *d, size_t at, size_t erased, size_t inserted) {
    size_t i;
    if (!d || (erased == 0 && inserted == 0)) return;
    rtx_doc_span_note(d, at, erased, inserted);
    {
        size_t i;
        for (i = 0; i < (size_t)RTX_MARKUP_CACHE_WINDOWS; i++)
            d->hl_win[i] = (RtxMarkupWin){0};
    }
    d->hl_win_stamp = 0;
    if (d->hl_cov.live) {
        if (at >= d->hl_cov.lo && at + erased <= d->hl_cov.hi)
            d->hl_cov.hi = d->hl_cov.hi - erased + inserted;
        else
            d->hl_cov.live = 0;
    }
    rtx_tm_ckpt_shift(d, at, erased, inserted);
    rtx_mdref_shift(&d->mdref, at, erased, inserted);
    rtx_doc_fold_shift(d, at, erased, inserted);
    for (i = 0; i < d->secs.len; i++) {
        size_t s = d->secs.data[i].start;
        if (s <= at) continue;
        if (erased && s - at < erased) d->secs.data[i].start = at;
        else d->secs.data[i].start = s - erased + inserted;
    }
    rtx_doc_run_top_drop(d);
    /* A run the insert lands in grows by it (none grows more). */
    if (d->runs_maxlen != (size_t)-1) d->runs_maxlen += inserted;
    for (i = 0; i < d->runs.len; i++)
        rtx_run_shift_one(&d->runs.data[i], at, erased, inserted);
}

static int rtx_doc_add_section(RtxDoc *d, size_t start, RtxSectionKind kind) {
    RtxSection s;
    if (!d) return 0;
    if (!d->secs.data) {
        Vec::[RtxSection] planted = vec_new::[RtxSection](d->analysis);
        if (!planted.data) return 0;
        d->secs = planted;
    }
    s.start = start;
    s.kind = kind;
    s.hl_done = 0;
    return d->secs.push(s) == 0;
}

static int rtx_doc_push_run(RtxDoc *d, RtxRun r) {
    if (!d) return 0;
    if (!d->runs.data) {
        Vec::[RtxRun] planted = vec_new::[RtxRun](d->analysis);
        if (!planted.data) return 0;
        d->runs = planted;
    }
    rtx_doc_run_top_drop(d);
    return d->runs.push(r) == 0;
}

int rtx_doc_add_run(RtxDoc *d, size_t start, size_t len, RtxStyle style,
                    RtxRunPlanter planter) {
    RtxRun r = {0};
    r.start = start;
    r.len = len;
    r.style = style;
    r.planter = (unsigned char)planter;
    r.rule = (unsigned short)RTX_RUN_NO_RULE;
    return rtx_doc_push_run(d, r);
}

/* A window's prose rescan reaches this far past its edges for the rest of
 * a line it cuts (a longer line keeps the cut). >= the longest header. */
#define RTX_PROSE_EDGE_MAX 4096

static int rtx_markup_header_at(const char *buf, size_t i, size_t n, int at_bol,
                                RtxSectionKind *kind) {
    if (!buf || !kind || !at_bol) return 0;
    if (i + 12 <= n) {
        char[:] hdr = cc_slice_from_buffer((void *)(buf + i), 12);
        if (hdr.eq_cstr("=== code ===")) {
            *kind = RTX_SEC_CODE;
            return 1;
        }
    }
    if (i + 13 <= n) {
        char[:] hdr = cc_slice_from_buffer((void *)(buf + i), 13);
        if (hdr.eq_cstr("=== prose ===")) {
            *kind = RTX_SEC_PROSE;
            return 1;
        }
    }
    return 0;
}

/* Prose style scanner, for PROSE without a grammar (a path no grammar
 * claims, or a `=== prose ===` block). Grammared sections (CODE / MARKUP)
 * style through TM scopes and never see this: the edit-refresh path calls
 * it for a PROSE section only, and scan_buf / the >256K window scan go
 * through rtx_doc_scan_prose_runs, which walks only the PROSE (or still
 * unknown) sub-ranges of the buffer.
 * Same-line, non-empty spans: `` `x` `` → mono, `**x**` → bold, `*x*` → italic. */
static void !>(CCError) rtx_doc_scan_markup_runs(RtxDoc *d, char[:] buf,
                                                size_t base) {
    size_t i;
    size_t n;
    const char *p;
    if (!d || !buf.ptr || buf.len == 0) return cc_ok();
    p = buf.ptr;
    n = buf.len;
    for (i = 0; i < n; i++) {
        if (p[i] == '`') {
            size_t j = i + 1;
            while (j < n && p[j] != '`' && p[j] != '\n') j++;
            if (j < n && p[j] == '`' && j > i + 1) {
                RtxStyle st = {0};
                st.mono = 1;
                if (!rtx_doc_add_run(d, base + i + 1, j - (i + 1), st,
                                     RTX_RUN_PROSE)) {
                    return cc_err(CC_ERR_OUT_OF_MEMORY, "run");
                }
                i = j;
            }
        } else if (p[i] == '*') {
            /* `**` opens bold and needs a `**` closer; `*` opens italic. */
            size_t k = (i + 1 < n && p[i + 1] == '*') ? 2 : 1;
            size_t j = i + k;
            while (j < n && p[j] != '*' && p[j] != '\n') j++;
            if (j < n && p[j] == '*' && j > i + k &&
                (k == 1 || (j + 1 < n && p[j + 1] == '*'))) {
                RtxStyle st = {0};
                if (k == 2) st.bold = 1;
                else st.italic = 1;
                if (!rtx_doc_add_run(d, base + i + k, j - (i + k), st,
                                     RTX_RUN_PROSE)) {
                    return cc_err(CC_ERR_OUT_OF_MEMORY, "run");
                }
                i = j + k - 1;
            }
        }
    }
    return cc_ok();
}

/* Scanner over the PROSE / UNKNOWN sub-ranges of buf[0..n) at `base`, given
 * the section starts that govern it (sorted by start; a range before the
 * first start is PROSE, as section_at reports). CODE / MARKUP ranges are
 * skipped so a grammared section carries no RTX_RUN_PROSE runs. */
static void !>(CCError) rtx_doc_scan_prose_runs(RtxDoc *d, char[:] buf,
                                               size_t base,
                                               const RtxSection *secs, size_t nsecs) {
    size_t end = base + buf.len;
    size_t off = base;
    size_t k = 0;
    if (!d || !buf.ptr || buf.len == 0) return cc_ok();
    while (k < nsecs && secs[k].start <= base) k++;
    while (off < end) {
        RtxSectionKind kind = k > 0 ? secs[k - 1].kind : RTX_SEC_PROSE;
        size_t next = (k < nsecs && secs[k].start < end) ? secs[k].start : end;
        if (next < off) next = off;
        if (kind == RTX_SEC_PROSE || kind == RTX_SEC_UNKNOWN) {
            rtx_doc_scan_markup_runs(d, buf.sub(off - base, next - base), off) !>(e) {
                return cc_err(e);
            };
        }
        off = next;
        k++;
    }
    return cc_ok();
}

static void !>(CCError) rtx_doc_refresh_prose_runs(RtxDoc *d, size_t lo, size_t hi) {
    size_t n, need;
    if (!d) return cc_err(CC_ERR_INVALID_ARG, "prose runs");
    n = d->len();
    if (lo > n) lo = n;
    if (hi > n) hi = n;
    if (hi <= lo) return cc_ok();
    rtx_doc_clip_runs(d, lo, hi, rtx_run_planted_tm) !>(e) {
        return cc_err(e);
    };
    rtx_doc_clip_runs(d, lo, hi, rtx_run_planted_prose) !>(e) {
        return cc_err(e);
    };
    need = hi - lo;
    {
        CCArena frame = cc_arena_heap(need + 64);
        char[:] bytes;
        if (!frame.base) return cc_err(CC_ERR_OUT_OF_MEMORY, "prose runs");
        bytes = d->scratch_span(lo, need, frame) !>(e) {
            frame.destroy();
            return cc_err(e);
        };
        rtx_doc_scan_markup_runs(d, bytes, lo) !>(e) {
            frame.destroy();
            return cc_err(e);
        };
        frame.destroy();
        return cc_ok();
    }
}

static void !>(CCError) rtx_doc_scan_buf(RtxDoc *d, char[:] buf) {
    size_t i;
    size_t n;
    const char *p;
    if (!rtx_doc_add_section(d, 0, rtx_doc_path_kind(d))) {
        return cc_err(CC_ERR_OUT_OF_MEMORY, "section");
    }
    if (!buf.ptr || buf.len == 0) return cc_ok();
    p = buf.ptr;
    n = buf.len;
    for (i = 0; i < n; i++) {
        RtxSectionKind k;
        int at_bol = (i == 0 || p[i - 1] == '\n');
        if (rtx_markup_header_at(p, i, n, at_bol, &k)) {
            if (!rtx_doc_add_section(d, i, k)) {
                return cc_err(CC_ERR_OUT_OF_MEMORY, "section");
            }
        }
    }
    return rtx_doc_scan_prose_runs(d, buf, 0, d->secs.data, d->secs.len);
}

static int rtx_sec_start_cmp(const void *a, const void *b) {
    const RtxSection *sa = (const RtxSection *)a;
    const RtxSection *sb = (const RtxSection *)b;
    if (sa->start < sb->start) return -1;
    if (sa->start > sb->start) return 1;
    return 0;
}

static void !>(CCError) rtx_doc_lookback_header(const RtxDoc *d, size_t before,
                                               int *found, size_t *hoff,
                                               RtxSectionKind *hk,
                                               size_t *next_before) {
    char back[RTX_MARKUP_LOOKBACK + 16];
    size_t lo, hi, got, i, n;
    int at_bol;
    if (!d || !found || !hoff || !hk || !next_before) {
        return cc_err(CC_ERR_INVALID_ARG, "lookback");
    }
    *found = 0;
    *next_before = 0;
    if (before == 0) return cc_ok();
    n = d->len();
    if (before > n) before = n;
    lo = before > (size_t)RTX_MARKUP_LOOKBACK
             ? before - (size_t)RTX_MARKUP_LOOKBACK
             : 0;
    hi = before + 13;
    if (hi > n) hi = n;
    *next_before = lo;
    if (hi <= lo) return cc_ok();
    got = d->read_at(lo, cc_slice_from_buffer(back, hi - lo)) !>(e) { return cc_err(e); };
    at_bol = (lo == 0);
    if (lo > 0) {
        char p = 0;
        size_t pg = d->read_at(lo - 1, cc_slice_from_buffer(&p, 1)) !>(e) { return cc_err(e); };
        at_bol = (pg == 1 && p == '\n');
    }
    for (i = 0; i < got; i++) {
        RtxSectionKind k;
        if (lo + i < before && rtx_markup_header_at(back, i, got, at_bol, &k)) {
            *found = 1;
            *hoff = lo + i;
            *hk = k;
        }
        at_bol = (back[i] == '\n');
    }
    return cc_ok();
}

/* 1 for the kinds a grammar / spike lexes and style_at keeps scope for. */
static int rtx_sec_lexed(RtxSectionKind k) {
    return k == RTX_SEC_CODE || k == RTX_SEC_MARKUP;
}

/* Root section is the path kind: a grammar match is CODE, or MARKUP when
 * that grammar declares `"cctext": { "kind": "markup" }`; no grammar is
 * PROSE. The shipped markdown grammar does not opt in, so `.md` is CODE. */
static RtxSectionKind rtx_doc_path_kind(const RtxDoc *d) {
    const RtxTmRt *rt = d && d->path.ptr ? rtx_tm_for_path(d->path.ptr) : NULL;
    if (!rt) return RTX_SEC_PROSE;
    return rt->markup ? RTX_SEC_MARKUP : RTX_SEC_CODE;
}

int RtxDoc_is_markup(const RtxDoc *d) {
    return rtx_doc_path_kind(d) == RTX_SEC_MARKUP;
}

/* Auto-close table for this path's grammar (opener, closer; one byte
 * each): the grammar's own (`cctext.pairs` / `autoClosingPairs`), else a
 * built-in one by kind. Grammarless prose pairs nothing. */
const char *RtxDoc_autopairs(const RtxDoc *d) {
    const RtxTmRt *rt = d && d->path.ptr ? rtx_tm_for_path(d->path.ptr) : NULL;
    if (!rt) return "";
    if (rt->pairs_set) return rt->pairs;
    if (rt->markup) return "``**__\"\"[]()";
    return "()[]{}\"\"''``";
}

static RtxMarkupWin *rtx_doc_markup_win(RtxDoc *d, size_t from, size_t to) {
    size_t i;
    size_t victim = 0;
    if (!d) return NULL;
    for (i = 0; i < (size_t)RTX_MARKUP_CACHE_WINDOWS; i++) {
        if (d->hl_win[i].live && d->hl_win[i].from == from &&
            d->hl_win[i].to == to) {
            d->hl_win[i].stamp = ++d->hl_win_stamp;
            return &d->hl_win[i];
        }
        if (!d->hl_win[i].live ||
            d->hl_win[i].stamp < d->hl_win[victim].stamp) {
            victim = i;
        }
    }
    d->hl_win[victim] = (RtxMarkupWin){0};
    d->hl_win[victim].from = from;
    d->hl_win[victim].to = to;
    d->hl_win[victim].back = from;
    d->hl_win[victim].anchor = from;
    d->hl_win[victim].stamp = ++d->hl_win_stamp;
    d->hl_win[victim].kind = RTX_SEC_UNKNOWN;
    d->hl_win[victim].live = 1;
    if (from == 0) {
        d->hl_win[victim].known = 1;
        d->hl_win[victim].kind = rtx_doc_path_kind(d);
    }
    return &d->hl_win[victim];
}

static void !>(CCError) rtx_doc_resolve_markup_win(RtxDoc *d, RtxMarkupWin *w) {
    int found = 0;
    size_t hoff = 0;
    size_t next = 0;
    RtxSectionKind hk = RTX_SEC_UNKNOWN;
    if (!d || !w || !w->live || w->known) return cc_ok();
    rtx_doc_lookback_header(d, w->back, &found, &hoff, &hk, &next) !>(e) {
        return cc_err(e);
    };
    if (found) {
        w->known = 1;
        w->kind = hk;
        w->anchor = hoff;
    } else {
        size_t prev_back = w->back;
        w->back = next;
        if (next == 0) {
            w->known = 1;
            w->kind = rtx_doc_path_kind(d);
            w->anchor = 0;
        } else if (rtx_sec_lexed(rtx_doc_path_kind(d)) && prev_back == w->from) {
            /* Grammar on the path already proved CODE / MARKUP. Only on the
             * first budget at the window origin — later draws keep walking back. */
            w->known = 1;
            w->kind = rtx_doc_path_kind(d);
            w->anchor = w->from;
        }
    }
    return cc_ok();
}

/* A `===` header starts a fresh lex (rtx_doc_highlight does the same). A
 * window's first section may start at the window instead (the path grammar
 * proved its kind without a header): that is not a lex boundary. */
static size_t rtx_doc_sec_floor(const RtxDoc *d, size_t start) {
    char buf[14];
    size_t got;
    RtxSectionKind k;
    @errhandler(CCError e) {
        (void)e;
        return 0;
    }
    if (!d || start == 0) return 0;
    got = d->read_at(start - 1, cc_slice_from_buffer(buf, sizeof buf)) !>;
    if (got < 2 || buf[0] != '\n') return 0;
    return rtx_markup_header_at(buf + 1, 0, got - 1, 1, &k) ? start : 0;
}

/* Lexed state survives a window rescan. Header edits (`=`, a large
 * delete) reparse, so a header section that comes back with the same start
 * and kind has the same bounds, and its runs were shifted by the edit (or
 * relexed by reparse_edit when the edit was inside it). A window's own
 * first section may not start at a header: it is not carried. An edit
 * clears every window; without the carry each keystroke relexed every
 * section on screen and in the markup lookback. */
static void !>(CCError) rtx_doc_merge_window_secs(RtxDoc *d, size_t sec_lo, size_t to,
                                                 const RtxSection *neu, size_t nneu) {
    RtxSection *keep, *was;
    size_t *was_end;
    size_t nkeep = 0, nwas = 0;
    size_t i, need, o, n = d ? d->len() : 0, ns;
    CCArena tmp;
    if (!d || !neu || nneu == 0) return cc_err(CC_ERR_INVALID_ARG, "window secs");
    /* Every section the doc holds may be kept or carried: no cap. */
    ns = d->secs.len;
    tmp = cc_arena_heap(ns * (2 * sizeof(RtxSection) + sizeof(size_t)) + 256);
    if (!tmp.base) return cc_err(CC_ERR_OUT_OF_MEMORY, "window secs");
    keep = (RtxSection *)cc_arena_alloc(tmp, (ns ? ns : 1) * sizeof(RtxSection),
                                        _Alignof(RtxSection));
    was = (RtxSection *)cc_arena_alloc(tmp, (ns ? ns : 1) * sizeof(RtxSection),
                                       _Alignof(RtxSection));
    was_end = (size_t *)cc_arena_alloc(tmp, (ns ? ns : 1) * sizeof(size_t), _Alignof(size_t));
    if (!keep || !was || !was_end) {
        tmp.destroy();
        return cc_err(CC_ERR_OUT_OF_MEMORY, "window secs");
    }
    for (i = 0; i < d->secs.len; i++) {
        if (!d->secs.data[i].hl_done) continue;
        was_end[nwas] = i + 1 < d->secs.len ? d->secs.data[i + 1].start : n;
        was[nwas++] = d->secs.data[i];
    }
    for (i = 0; i < d->secs.len; i++) {
        size_t s = d->secs.data[i].start;
        size_t wi;
        int replaced = (s >= sec_lo && s <= to);
        /* Next to this window (the markup lookback of the same fill):
         * keep it so the lookback pass finds it lexed. */
        int cached = s + 2 * (size_t)RTX_MARKUP_LOOKBACK >= sec_lo &&
                     s <= to + 2 * (size_t)RTX_MARKUP_LOOKBACK;
        for (wi = 0; wi < (size_t)RTX_MARKUP_CACHE_WINDOWS && !cached; wi++) {
            RtxMarkupWin *w = &d->hl_win[wi];
            if (w->live && s >= w->anchor && s <= w->to) {
                cached = 1;
                break;
            }
        }
        if (!replaced && cached) keep[nkeep++] = d->secs.data[i];
    }
    need = nkeep + nneu;
    if (!d->secs.data) {
        Vec::[RtxSection] planted = vec_new::[RtxSection](d->analysis);
        if (!planted.data) {
            tmp.destroy();
            return cc_err(CC_ERR_OUT_OF_MEMORY, "window secs");
        }
        d->secs = planted;
    }
    d->secs.clear();
    if (d->secs.reserve(need) != 0) {
        tmp.destroy();
        return cc_err(CC_ERR_OUT_OF_MEMORY, "window secs");
    }
    for (i = 0; i < need; i++) {
        if (d->secs.push(i < nkeep ? keep[i] : neu[i - nkeep]) != 0) {
            tmp.destroy();
            return cc_err(CC_ERR_OUT_OF_MEMORY, "window secs");
        }
    }
    if (d->secs.len > 1) {
        qsort(d->secs.data, d->secs.len, sizeof(RtxSection), rtx_sec_start_cmp);
    }
    o = 0;
    for (i = 0; i < d->secs.len; i++) {
        if (i + 1 < d->secs.len && d->secs.data[i].start == d->secs.data[i + 1].start)
            continue;
        d->secs.data[o++] = d->secs.data[i];
    }
    d->secs.truncate(o);
    /* Both lists are sorted by start. Same end too: a section whose
     * window-anchored neighbour went away is longer than what was
     * lexed (a 600 KiB file's [0, anchor) fragment is not the file). */
    {
        size_t k = 0;
        for (i = 0; i < d->secs.len && k < nwas; i++) {
            RtxSection *sc = &d->secs.data[i];
            size_t end = i + 1 < d->secs.len ? d->secs.data[i + 1].start : n;
            while (k < nwas && was[k].start < sc->start) k++;
            if (k < nwas && was[k].start == sc->start && was[k].kind == sc->kind &&
                was_end[k] == end &&
                (sc->start == 0 || rtx_doc_sec_floor(d, sc->start) == sc->start))
                sc->hl_done = 1;
        }
    }
    tmp.destroy();
    return cc_ok();
}

static void !>(CCError) rtx_doc_window_markup(RtxDoc *d, size_t from, size_t to) {
    RtxSection first[1];
    RtxSection *neu = first;
    size_t nneu = 0;
    size_t n, saved, ext, pf;
    RtxSectionKind kind;
    size_t sec_lo;
    RtxMarkupWin *win;
    if (!d) return cc_err(CC_ERR_INVALID_ARG, "null doc");
    saved = d->runs.len;
    n = d->len();
    if (from > n) from = n;
    if (to > n) to = n;
    if (from > to) from = to;
    if (to > from && to - from > (size_t)RTX_MARKUP_SCAN_MAX) {
        to = from + (size_t)RTX_MARKUP_SCAN_MAX;
    }
    win = rtx_doc_markup_win(d, from, to);
    if (!win) return cc_err(CC_ERR_INTERNAL, "markup window");
    /* Known+ready: cached. !known+ready: later draw — one more lookback step. */
    if (win->known && win->ready) return cc_ok();
    rtx_doc_resolve_markup_win(d, win) !>(e) { return cc_err(e); };
    kind = win->known ? win->kind : RTX_SEC_UNKNOWN;
    sec_lo = win->known ? win->anchor : from;
    neu[nneu].start = sec_lo;
    neu[nneu].kind = kind;
    neu[nneu].hl_done = 0;
    nneu++;
    /* The merge replaces every section starting in [sec_lo, to], so the
     * scan must see every header starting there: a header at `to` or cut
     * by it (its 12 / 13 bytes past `to`) is read whole. Missing it was a
     * section boundary lost at a window's edge: the section above it ran on
     * over it (wrong kind, and the lex went on past the header).
     * Prose spans are one line: the prose rescan covers the window's first
     * and last lines whole (up to RTX_PROSE_EDGE_MAX past its edges), or a
     * window cut mid-line clipped a span it could not plant again. */
    pf = from > (size_t)RTX_PROSE_EDGE_MAX ? from - (size_t)RTX_PROSE_EDGE_MAX : 0;
    ext = to + (size_t)RTX_PROSE_EDGE_MAX < n ? to + (size_t)RTX_PROSE_EDGE_MAX : n;
    if (ext > from) {
        /* A header is 12 bytes and starts a line: one per 13 bytes at most,
         * so every header the window holds has a slot (none dropped). */
        size_t cap = (to - from) / 13 + 2;
        size_t lf = from, lt = to, j;
        CCArena frame = cc_arena_heap((ext - pf) + cap * sizeof(RtxSection) + 128);
        char[:] bytes;
        int at_bol;
        if (!frame.base) return cc_err(CC_ERR_OUT_OF_MEMORY, "markup span");
        neu = (RtxSection *)cc_arena_alloc(frame, cap * sizeof(RtxSection),
                                           _Alignof(RtxSection));
        if (!neu) {
            frame.destroy();
            return cc_err(CC_ERR_OUT_OF_MEMORY, "markup secs");
        }
        neu[0] = first[0];
        bytes = d->scratch_span(pf, ext - pf, frame) !>(e) {
            frame.destroy();
            return cc_err(e);
        };
        if (bytes.len != ext - pf) {
            frame.destroy();
            return cc_err(CC_ERR_IO, "markup span");
        }
        at_bol = from == 0 || bytes.ptr[from - 1 - pf] == '\n';
        /* First line's start (not above the window's own first section). */
        if (!at_bol) {
            for (j = from - pf; j > 0 && bytes.ptr[j - 1] != '\n'; j--) {}
            if (j > 0 || pf == 0) lf = pf + j;
            if (lf < sec_lo) lf = sec_lo;
        }
        /* Last line's end. */
        if (to > from && bytes.ptr[to - 1 - pf] != '\n') {
            for (j = to - pf; j < bytes.len && bytes.ptr[j] != '\n'; j++) {}
            if (j < bytes.len || ext == n) lt = pf + j;
        }
        for (j = from - pf; j < bytes.len && pf + j <= to; j++) {
            RtxSectionKind k;
            if (rtx_markup_header_at(bytes.ptr, j, bytes.len, at_bol, &k)) {
                size_t off = pf + j;
                if (nneu > 0 && neu[nneu - 1].start == off) {
                    neu[nneu - 1].kind = k;
                    if (off == from) {
                        win->known = 1;
                        win->kind = k;
                        win->anchor = from;
                    }
                } else if (nneu < cap) {
                    neu[nneu].start = off;
                    neu[nneu].kind = k;
                    neu[nneu].hl_done = 0;
                    nneu++;
                }
            }
            at_bol = (bytes.ptr[j] == '\n');
        }
        {
            size_t clipped = d->runs.len;
            if (to > from) {
                rtx_doc_clip_runs(d, lf, lt, rtx_run_planted_prose) !>(e) {
                    frame.destroy();
                    return cc_err(e);
                };
                /* Clip is in place. A failed rescan leaves this window without
                 * prose runs and not ready (the next draw rescans it). */
                clipped = d->runs.len;
                rtx_doc_scan_prose_runs(d, bytes.sub(lf - pf, lt - pf), lf, neu, nneu) !>(e) {
                    rtx_doc_runs_cut(d, clipped);
                    frame.destroy();
                    return cc_err(e);
                };
            }
            rtx_doc_merge_window_secs(d, sec_lo, to, neu, nneu) !>(e) {
                rtx_doc_runs_cut(d, clipped);
                frame.destroy();
                return cc_err(e);
            };
        }
        frame.destroy();
    } else {
        rtx_doc_merge_window_secs(d, sec_lo, to, neu, nneu) !>(e) {
            rtx_doc_runs_cut(d, saved);
            return cc_err(e);
        };
    }
    win->ready = 1;
    return cc_ok();
}

static void !>(CCError) rtx_doc_scan_markup(RtxDoc *d) {
    size_t n;
    if (!d) return cc_err(CC_ERR_INVALID_ARG, "null doc");
    d->analysis_reset();
    n = d->len();
    if (n == 0 || n > RTX_MARKUP_SCAN_MAX) {
        if (!rtx_doc_add_section(d, 0, rtx_doc_path_kind(d))) {
            return cc_err(CC_ERR_OUT_OF_MEMORY, "section");
        }
        return cc_ok();
    }
    {
        CCArena frame = cc_arena_heap(n + 64);
        char[:] bytes;
        if (!frame.base) return cc_err(CC_ERR_OUT_OF_MEMORY, "markup scan");
        bytes = d->scratch_span(0, n, frame) !>(e) {
            frame.destroy();
            return cc_err(e);
        };
        rtx_doc_scan_buf(d, bytes) !>(e) {
            frame.destroy();
            d->analysis_reset();
            return cc_err(e);
        };
        frame.destroy();
    }
    return cc_ok();
}

/* ---- Markdown link definitions (md_refs.cch) ----
 *
 * The map a shortcut `[foo]` resolves through is staged by the lex walk
 * (the definitions of the lines it classified) and shifted by edits. A
 * document between RTX_HL_FULL_MAX and RTX_MDREF_SWEEP_MAX is swept once
 * (the block pass alone, classify only) so a definition below the window
 * resolves too; a larger one knows the definitions its windows lexed.
 * When a label the lex asked about comes or goes, the runs it planted
 * from the old answer are wrong: relex (a small document whole, a large
 * one around `off`; the next fill lexes its window). */

/* Sweep (full: the whole document; else the dirty range, to where the
 * block state meets an unchanged checkpoint). Reads 1 MiB at a time. */
static void !>(CCError) rtx_doc_mdref_sweep(RtxDoc *d, int full) {
    RtxMdRefs *m = &d->mdref;
    RtxMdRefSweep sw;
    size_t n = d->len(), chunk = (size_t)1 << 20;
    CCArena frame;
    if (!rtx_mdref_sweep_begin(m, &sw, full)) return cc_ok();
    frame = cc_arena_heap(chunk + 64);
    if (!frame.base) {
        rtx_mdref_sweep_off(m);
        return cc_err(CC_ERR_OUT_OF_MEMORY, "md refs sweep");
    }
    while (sw.at < n && !sw.done) {
        size_t take = n - sw.at < chunk ? n - sw.at : chunk, used;
        int last;
        char[:] bytes;
        frame.reset();
        bytes = d->scratch_span(sw.at, take, frame) !>(e) {
            frame.destroy();
            free(sw.nk);
            rtx_mdref_stage_reset(m);
            rtx_mdref_sweep_off(m);
            return cc_err(e);
        };
        last = sw.at + bytes.len >= n;
        used = rtx_mdref_sweep_feed(m, &sw, bytes.ptr, bytes.len, last);
        /* A line longer than a chunk: classify what fits as one line. */
        if (used == 0 && !sw.done) used = rtx_mdref_sweep_feed(m, &sw, bytes.ptr, bytes.len, 1);
        if (used == 0) break;
    }
    frame.destroy();
    rtx_mdref_sweep_end(m, &sw, n);
    return cc_ok();
}

/* The sweep owns the map of a document in (RTX_HL_FULL_MAX,
 * RTX_MDREF_SWEEP_MAX]: start it once, re-sweep what edits dirtied; out
 * of that range the lex's own definitions stand. */
static void !>(CCError) rtx_doc_mdref_update(RtxDoc *d) {
    RtxMdRefs *m = &d->mdref;
    size_t n = d->len();
    if (n > RTX_HL_FULL_MAX && n <= RTX_MDREF_SWEEP_MAX) {
        if (m->sweep_on) {
            if (m->dirty) return rtx_doc_mdref_sweep(d, 0);
        } else if (!m->swept) {
            const RtxTmRt *rt = rtx_tm_for_path(d->path.ptr);
            m->swept = 1;
            if (rt && rt->blocks) return rtx_doc_mdref_sweep(d, 1);
        }
        return cc_ok();
    }
    if (m->sweep_on || m->swept) {
        rtx_mdref_sweep_off(m);
        m->swept = 0;
    }
    return cc_ok();
}

static void rtx_doc_mdref_drop(RtxDoc *d) {
    rtx_mdref_relexed(&d->mdref);
    rtx_doc_hl_abort(d);
    d->hl_cov.live = 0;
}

static void !>(CCError) rtx_doc_ensure_hl_once(RtxDoc *d, RtxHlWin w);

/* After a lex: a label the lex asked about came or went → relex. `lex`:
 * a large document relexes around `off` here (an edit: the patch diffs
 * the runs), else the caller's window lex does it. */
static void !>(CCError) rtx_doc_mdref_fix(RtxDoc *d, size_t off, int lex) {
    size_t n;
    if (!d || !rtx_mdref_settle(&d->mdref)) return cc_ok();
    n = d->len();
    rtx_doc_mdref_drop(d);
    if (n <= RTX_HL_FULL_MAX) {
        rtx_doc_highlight(d) !>(e) { return cc_err(e); };
        d->hl_full = 1;
    } else if (lex) {
        size_t lo = off > (size_t)RTX_MARKUP_LOOKBACK ? off - (size_t)RTX_MARKUP_LOOKBACK : 0;
        size_t hi = off + (size_t)RTX_HL_WIN_MAX / 4;
        if (hi > n) hi = n;
        rtx_doc_ensure_hl_once(d, rtx_hl_span(lo, hi)) !>(e) { return cc_err(e); };
    }
    rtx_doc_sort_runs(d);
    (void)rtx_mdref_settle(&d->mdref);
    return cc_ok();
}

void !>(CCError) RtxDoc_reparse(RtxDoc *d) {
    size_t n;
    if (!d) return cc_err(CC_ERR_INVALID_ARG, "null doc");
    rtx_doc_scan_markup(d) !>(e) { return cc_err(e); };
    n = d->len();
    if (n <= RTX_HL_FULL_MAX) {
        rtx_doc_highlight(d) !>(e) { return cc_err(e); };
        d->hl_full = 1;
    } else {
        d->hl_full = 0;
    }
    rtx_doc_sort_runs(d);
    rtx_doc_mdref_update(d) !>(e) { return cc_err(e); };
    return rtx_doc_mdref_fix(d, 0, 0);
}

/* Bytes from `src`, named `path` (grammar, save, journal key). The caller
 * stamps the disk identity. */
static void !>(CCError) rtx_doc_open_as(RtxDoc *d, char[:0] src, char[:0] path) {
    if (!d) return cc_err(CC_ERR_INVALID_ARG, "null doc");
    if (rtx_doc_is_live(d)) return cc_err(CC_ERR_INVALID_ARG, "doc already live");
    *d = (RtxDoc){0};
    d->tree.from_path(src) !>(e) { return cc_err(e); };
    if (!RtxDoc_init_epochs(d)) {
        d->destroy();
        return cc_err(CC_ERR_OUT_OF_MEMORY, "doc epochs");
    }
    d->path = rtx_session_str(d, path) !>(e) {
        d->destroy();
        return cc_err(e);
    };
    rtx_doc_scan_markup(d) !>(e) {
        d->destroy();
        return cc_err(e);
    };
    {
        size_t n = d->len();
        if (n <= RTX_HL_FULL_MAX) {
            rtx_doc_highlight(d) !>(e) {
                d->destroy();
                return cc_err(e);
            };
            d->hl_full = 1;
        }
    }
    rtx_doc_sort_runs(d);
    rtx_doc_mdref_fix(d, 0, 0) !>(e) {
        d->destroy();
        return cc_err(e);
    };
    return cc_ok();
}

void !>(CCError) RtxDoc_from_path(RtxDoc *d, char[:0] path) {
    rtx_doc_open_as(d, path, path) !>(e) { return cc_err(e); };
    rtx_doc_ident_stamp(d, path);
    /* A `*.wb.md` path is a workbook (docs/workbook.md); no other file
     * gets the derived-value hook. */
    if (rtx_wb_path(path.ptr, path.len)) (void)rtx_wb_attach(d);
    return cc_ok();
}

void !>(CCError) RtxDoc_from_base(RtxDoc *d, char[:0] base, char[:0] path,
                                  int64_t mtime_ns, uint64_t sz, uint64_t ino) {
    rtx_doc_open_as(d, base, path) !>(e) { return cc_err(e); };
    if (rtx_wb_path(path.ptr, path.len)) (void)rtx_wb_attach(d);
    d->disk_mtime = mtime_ns;
    d->disk_sz = sz;
    d->disk_ino = ino;
    d->disk_valid = 1;
    return cc_ok();
}

void !>(CCError) RtxDoc_from_buffer(RtxDoc *d, char[:] bytes) {
    if (!d) return cc_err(CC_ERR_INVALID_ARG, "null doc");
    if (rtx_doc_is_live(d)) return cc_err(CC_ERR_INVALID_ARG, "doc already live");
    *d = (RtxDoc){0};
    d->tree.from_buffer(bytes) !>(e) { return cc_err(e); };
    if (!RtxDoc_init_epochs(d)) {
        d->destroy();
        return cc_err(CC_ERR_OUT_OF_MEMORY, "doc epochs");
    }
    rtx_doc_scan_markup(d) !>(e) {
        d->destroy();
        return cc_err(e);
    };
    {
        size_t n = d->len();
        if (n <= RTX_HL_FULL_MAX) {
            rtx_doc_highlight(d) !>(e) {
                d->destroy();
                return cc_err(e);
            };
            d->hl_full = 1;
        }
    }
    rtx_doc_sort_runs(d);
    return cc_ok();
}

void rtx_find_scan_wipe(RtxDoc *d) {
    if (!d) return;
    d->find.hits.truncate(0);
    rtx_find_hits_publish(&d->find);
    d->find.scan_off = 0;
    d->find.scan_line = 0;
    d->find.scan_base = 0;
    d->find.scan_bytes = 0;
    d->find.cur = 0;
    d->find.origin = d->caret;
    d->find.pinned = 0;
    d->find.truncated = 0;
    d->find.done = (d->find.query.len == 0 || d->find.err != NULL);
    d->find.cancel = 0;
    d->find.chain_end = 0;
    d->find.long_n = 0;
    d->find.long_off = 0;
    d->find.indet = 0;
    d->find.indet_off = 0;
    d->find.indet_line = 0;
}

void RtxDoc_find_invalidate(RtxDoc *d) {
    if (!d) return;
    rtx_find_handle_stop(&d->find);
    rtx_find_scan_wipe(d);
}

/* Last run index whose start <= off (0 when none). */
static size_t rtx_doc_run_last_le(const RtxDoc *d, size_t off) {
    size_t lo = 0, hi = d->runs.len;
    while (lo + 1 < hi) {
        size_t mid = lo + (hi - lo) / 2;
        if (d->runs.data[mid].start <= off) lo = mid;
        else hi = mid;
    }
    return lo;
}

/* First run index to walk for `off`: binary search to the last start <= off,
 * then back to the outermost run that still covers `off` (a long CSV string
 * span has inner runs that do not cover it, so `really` after `""` stays
 * string). Callers iterate while runs[i].start <= off. Requires runs.len > 0.
 *
 * Do not stop at a sibling that ended before the current cover: a fence
 * with a guest keyword then a docstring still covers the docstring, and
 * that keyword sits between them in start order. The index finds that
 * outermost cover in one descent (the leftmost end > off; sorted starts
 * put it at or before the search hit); stale, walk back to 0. */
static size_t rtx_doc_run_first(const RtxDoc *d, size_t off) {
    size_t lo = rtx_doc_run_last_le(d, off), i, j;
    if (rtx_doc_run_top_live(d)) {
        j = rtx_doc_run_top_find(d, 0, off + 1);
        return j < lo ? j : lo;
    }
    i = lo;
    j = lo;
    while (j > 0) {
        j--;
        if (d->runs.data[j].start <= off &&
            d->runs.data[j].start + d->runs.data[j].len > off) {
            i = j;
        }
    }
    return i;
}

/* Next run index after i for a walk at `off`: skips runs that end before
 * `off` (no caller reads one — each needs end >= off), so a cover with
 * thousands of inner tokens costs its depth, not its width. Runs past
 * `off` have end > off and are never skipped, so a caller's own bound
 * (start <= off, start < eol) still stops the loop. */
static size_t rtx_doc_run_step(const RtxDoc *d, size_t i, size_t off) {
    if (!rtx_doc_run_top_live(d)) return i + 1;
    return rtx_doc_run_top_find(d, i + 1, off);
}

RtxStyle RtxDoc_style_at(const RtxDoc *d, size_t off) {
    RtxStyle z = {0};
    size_t i;
    if (!d || d->runs.len == 0) return z;
    i = rtx_doc_run_first(d, off);
    for (; i < d->runs.len && d->runs.data[i].start <= off;
         i = rtx_doc_run_step(d, i, off)) {
        if (off < d->runs.data[i].start + d->runs.data[i].len) {
            if (d->runs.data[i].style.bold) z.bold = 1;
            if (d->runs.data[i].style.italic) z.italic = 1;
            if (d->runs.data[i].style.mono) z.mono = 1;
            if (d->runs.data[i].style.strike) z.strike = 1;
            if (d->runs.data[i].style.hl) z.hl = 1;
            if (d->runs.data[i].style.scope != RTX_SCOPE_NONE) {
                z.scope = d->runs.data[i].style.scope;
            }
        }
    }
    /* Lex leftover from a CODE-to-EOF window must not paint in prose.
     * CODE and MARKUP both keep scope. */
    if (z.scope != RTX_SCOPE_NONE && !rtx_sec_lexed(d->section_at(off))) {
        z.scope = RTX_SCOPE_NONE;
    }
    return z;
}

/* Next run edge in (off, hi]: the smallest run start or end > off, or hi.
 * style_at is constant on [off, style_next(off)). Same binary search and
 * outer-cover back-walk as style_at, so nested runs (CSV string with
 * inner runs) report the inner edge, not just the cover's. */
size_t RtxDoc_style_next(const RtxDoc *d, size_t off, size_t hi) {
    size_t lo, j, next = hi;
    if (!d || d->runs.len == 0 || off >= hi) return hi;
    lo = rtx_doc_run_last_le(d, off);
    /* First run starting after off. */
    for (j = lo; j < d->runs.len; j++) {
        if (d->runs.data[j].start > off) {
            if (d->runs.data[j].start < next) next = d->runs.data[j].start;
            break;
        }
    }
    /* Ends of runs that cover off (walk back like style_at). A sibling
     * between an outer fence and an inner guest must not hide the fence. */
    if (rtx_doc_run_top_live(d)) {
        for (j = rtx_doc_run_top_find(d, 0, off + 1); j <= lo;
             j = rtx_doc_run_top_find(d, j + 1, off + 1)) {
            size_t e = d->runs.data[j].start + d->runs.data[j].len;
            if (d->runs.data[j].start <= off && e < next) next = e;
        }
        return next;
    }
    j = lo + 1;
    while (j > 0) {
        size_t e;
        j--;
        if (d->runs.data[j].start > off) continue;
        e = d->runs.data[j].start + d->runs.data[j].len;
        if (e > off && e < next) next = e;
    }
    return next;
}

/* section_at(off) and the span [*lo, *hi) around off where it cannot
 * change: the section entry, and on a windowed doc the markup window
 * that covers off (or the gap between windows). Conservative spans. */
static RtxSectionKind rtx_doc_section_span(const RtxDoc *d, size_t off, size_t *lo_out,
                                           size_t *hi_out) {
    size_t lo = 0, hi = (size_t)-1, a, b, i;
    RtxSectionKind k;
    if (!d || d->secs.len == 0) {
        *lo_out = 0;
        *hi_out = (size_t)-1;
        return RTX_SEC_PROSE;
    }
    if (d->len() > (size_t)RTX_MARKUP_SCAN_MAX) {
        if (off == 0) {
            hi = 1;
        } else {
            int covered = 0;
            lo = 1;
            for (i = 0; i < (size_t)RTX_MARKUP_CACHE_WINDOWS; i++) {
                const RtxMarkupWin *w = &d->hl_win[i];
                if (w->live && off >= w->anchor && off <= w->to) {
                    covered = 1;
                    if (w->anchor > lo) lo = w->anchor;
                    if (w->to + 1 < hi) hi = w->to + 1;
                    break;
                }
            }
            if (!covered) {
                for (i = 0; i < (size_t)RTX_MARKUP_CACHE_WINDOWS; i++) {
                    const RtxMarkupWin *w = &d->hl_win[i];
                    if (!w->live) continue;
                    if (w->anchor > off && w->anchor < hi) hi = w->anchor;
                    if (w->to < off && w->to + 1 > lo) lo = w->to + 1;
                }
                *lo_out = lo;
                *hi_out = hi;
                return RTX_SEC_UNKNOWN;
            }
        }
    }
    a = 0;
    b = d->secs.len;
    while (a + 1 < b) {
        size_t mid = a + (b - a) / 2;
        if (d->secs.data[mid].start <= off) a = mid;
        else b = mid;
    }
    k = d->secs.data[a].kind;
    if (d->secs.data[a].start <= off && d->secs.data[a].start > lo)
        lo = d->secs.data[a].start;
    if (a + 1 < d->secs.len && d->secs.data[a + 1].start < hi)
        hi = d->secs.data[a + 1].start;
    *lo_out = lo;
    *hi_out = hi;
    return k;
}

static void rtx_style_cur_seek(const RtxDoc *d, RtxStyleCur *c, size_t off) {
    size_t n = d->runs.len, lo, i;
    c->runs = d->runs.data;
    c->nruns = n;
    c->ok = 1;
    c->slow = 0;
    c->nact = 0;
    c->at = off;
    c->sec_ok = 0;
    if (n == 0) {
        c->nxt = 0;
        return;
    }
    if (!rtx_doc_run_top_live(d)) {
        c->slow = 1;
        return;
    }
    lo = rtx_doc_run_last_le(d, off);
    c->nxt = d->runs.data[lo].start <= off ? lo + 1 : 0;
    i = rtx_doc_run_first(d, off);
    for (; i < n && d->runs.data[i].start <= off; i = rtx_doc_run_step(d, i, off)) {
        if (off >= d->runs.data[i].start + d->runs.data[i].len) continue;
        if (c->nact >= (unsigned)RTX_STYLE_CUR_DEPTH) {
            c->slow = 1;
            return;
        }
        c->act[c->nact++] = i;
    }
}

/* Covering set at `off` >= c->at: drop runs that ended, add runs that
 * started (index order is start order, so act stays ascending). */
static void rtx_style_cur_walk(const RtxDoc *d, RtxStyleCur *c, size_t off) {
    const RtxRun *r = d->runs.data;
    size_t n = d->runs.len;
    unsigned k, w = 0;
    for (k = 0; k < c->nact; k++) {
        size_t j = c->act[k];
        if (off < r[j].start + r[j].len) c->act[w++] = j;
    }
    c->nact = w;
    while (c->nxt < n && r[c->nxt].start <= off) {
        size_t j = c->nxt++;
        if (off >= r[j].start + r[j].len) continue;
        if (c->nact >= (unsigned)RTX_STYLE_CUR_DEPTH) {
            c->slow = 1;
            return;
        }
        c->act[c->nact++] = j;
    }
    c->at = off;
}

/* Bring the cursor to `off`; 0 when the caller must use the plain query. */
static int rtx_style_cur_to(const RtxDoc *d, RtxStyleCur *c, size_t off) {
    if (!c->ok || c->runs != (const void *)d->runs.data || c->nruns != d->runs.len ||
        off < c->at || off - c->at > 4096) {
        rtx_style_cur_seek(d, c, off);
    } else if (!c->slow && off >= c->lim) {
        rtx_style_cur_walk(d, c, off);
    } else if (!c->slow) {
        c->at = off; /* same raw style: no run starts or ends in [at, lim) */
        return 1;
    }
    if (c->slow) return 0;
    {
        const RtxRun *r = d->runs.data;
        size_t lim = c->nxt < d->runs.len ? r[c->nxt].start : (size_t)-1;
        RtxStyle z = {0};
        unsigned k;
        for (k = 0; k < c->nact; k++) {
            const RtxRun *x = &r[c->act[k]];
            size_t e = x->start + x->len;
            if (e < lim) lim = e;
            if (x->style.bold) z.bold = 1;
            if (x->style.italic) z.italic = 1;
            if (x->style.mono) z.mono = 1;
            if (x->style.strike) z.strike = 1;
            if (x->style.hl) z.hl = 1;
            if (x->style.scope != RTX_SCOPE_NONE) z.scope = x->style.scope;
        }
        c->lim = lim;
        c->raw = z;
    }
    return 1;
}

RtxStyle RtxDoc_style_cur(const RtxDoc *d, RtxStyleCur *c, size_t off) {
    RtxStyle z = {0};
    if (!d || !c) return RtxDoc_style_at(d, off);
    if (d->runs.len == 0) return z;
    if (!rtx_style_cur_to(d, c, off)) return RtxDoc_style_at(d, off);
    z = c->raw;
    if (z.scope != RTX_SCOPE_NONE) {
        if (!c->sec_ok || off < c->sec_lo || off >= c->sec_hi) {
            c->sec = rtx_doc_section_span(d, off, &c->sec_lo, &c->sec_hi);
            c->sec_ok = 1;
        }
        if (!rtx_sec_lexed(c->sec)) z.scope = RTX_SCOPE_NONE;
    }
    return z;
}

size_t RtxDoc_style_cur_next(const RtxDoc *d, RtxStyleCur *c, size_t off, size_t hi) {
    if (!d || !c || d->runs.len == 0 || off >= hi) return RtxDoc_style_next(d, off, hi);
    if (!rtx_style_cur_to(d, c, off)) return RtxDoc_style_next(d, off, hi);
    return c->lim < hi ? c->lim : hi;
}

size_t RtxDoc_mark_edges(const RtxDoc *d, size_t lo, size_t hi, size_t *out,
                         size_t cap) {
    size_t i, n, k = 0;
    if (!d || !out || hi <= lo) return 0;
    if (d->derived) {
        k = d->derived->edges(d->derived->ctx, d, lo, hi, out, cap);
        if (k == (size_t)-1) return k;
    }
    if (d->runs.len == 0) return k;
    if (!rtx_doc_run_top_live(d)) return (size_t)-1; /* order not proven */
    n = d->runs.len;
    i = rtx_doc_run_first(d, lo ? lo - 1 : 0);
    for (; i < n && d->runs.data[i].start <= hi; i++) {
        const RtxRun *r = &d->runs.data[i];
        size_t e = r->start + r->len, c[5];
        int j;
        if (r->hint_a == 0 && rtx_run_arity(r) != RTX_ARITY_PATH) continue;
        if (e + 1 < lo) continue;
        c[0] = r->start;
        c[1] = r->start + r->hint_a;
        c[2] = r->hint_b <= r->len ? e - r->hint_b : r->start;
        c[3] = e;
        c[4] = e + 1;
        for (j = 0; j < 5; j++) {
            if (c[j] <= lo || c[j] >= hi) continue;
            if (k >= cap) return (size_t)-1;
            out[k++] = c[j];
        }
    }
    return k;
}

/* Hint bytes at `off`: the innermost covering run whose begin hint
 * [start, start+hint_a) or end hint [start+len-hint_b, start+len) holds
 * `off`. Out: that hint's [lo, hi). 0 when `off` is content or unmarked. */
int RtxDoc_hint_at(const RtxDoc *d, size_t off, size_t *lo, size_t *hi) {
    size_t i;
    int hit = 0;
    if (!d || d->runs.len == 0) return 0;
    i = rtx_doc_run_first(d, off);
    for (; i < d->runs.len && d->runs.data[i].start <= off;
         i = rtx_doc_run_step(d, i, off)) {
        const RtxRun *r = &d->runs.data[i];
        size_t end = r->start + r->len;
        if (off >= end || r->hint_a == 0) continue;
        if (off < r->start + r->hint_a) {
            if (lo) *lo = r->start;
            if (hi) *hi = r->start + r->hint_a;
            hit = 1;
        } else if (r->hint_b && off >= end - r->hint_b) {
            if (lo) *lo = end - r->hint_b;
            if (hi) *hi = end;
            hit = 1;
        }
    }
    return hit;
}

/* Mark whose span [start, start+len] (inclusive: a caret just past the end
 * hint is adjacent) holds `off`. Innermost wins. Out: [lo, hi) of the run.
 * Used for reveal-on-entry; 0 when no hinted run touches `off`. */
int RtxDoc_mark_at(const RtxDoc *d, size_t off, size_t *lo, size_t *hi) {
    size_t i;
    int hit = 0;
    if (!d || d->runs.len == 0) return 0;
    i = rtx_doc_run_first(d, off);
    for (; i < d->runs.len && d->runs.data[i].start <= off;
         i = rtx_doc_run_step(d, i, off)) {
        const RtxRun *r = &d->runs.data[i];
        if (r->hint_a == 0 || off > r->start + r->len) continue;
        if (lo) *lo = r->start;
        if (hi) *hi = r->start + r->len;
        hit = 1;
    }
    return hit;
}

int RtxDoc_dest_at(const RtxDoc *d, size_t off, size_t *lo, size_t *hi) {
    size_t i;
    int hit = 0;
    if (!d || d->runs.len == 0) return 0;
    i = rtx_doc_run_first(d, off);
    for (; i < d->runs.len && d->runs.data[i].start <= off;
         i = rtx_doc_run_step(d, i, off)) {
        const RtxRun *r = &d->runs.data[i];
        if (!rtx_run_dest(r) || off >= r->start + r->len) continue;
        if (lo) *lo = r->start;
        if (hi) *hi = r->start + r->len;
        hit = 1;
    }
    return hit;
}

int RtxDoc_path_at(const RtxDoc *d, size_t off, size_t *lo, size_t *hi,
                   size_t *keep_lo, size_t *keep_hi) {
    size_t i, j;
    const RtxRun *lab = NULL, *dest = NULL;
    if (!d || d->runs.len == 0) return 0;
    i = rtx_doc_run_first(d, off);
    for (; i < d->runs.len && d->runs.data[i].start <= off;
         i = rtx_doc_run_step(d, i, off)) {
        const RtxRun *r = &d->runs.data[i];
        if (rtx_run_arity(r) != RTX_ARITY_PATH) continue;
        if (off > r->start + r->len) continue;
        if (rtx_run_dest(r)) dest = r;
        else lab = r;
    }
    if (!lab && !dest) return 0;
    if (lab && !dest) {
        size_t edge = lab->start + lab->len;
        j = rtx_doc_run_first(d, edge);
        for (; j < d->runs.len && d->runs.data[j].start <= edge; j++) {
            const RtxRun *r = &d->runs.data[j];
            if (rtx_run_dest(r) && r->start == edge) {
                dest = r;
                break;
            }
        }
        if (!dest && lab->start) {
            j = rtx_doc_run_first(d, lab->start - 1);
            for (; j < d->runs.len && d->runs.data[j].start < lab->start; j++) {
                const RtxRun *r = &d->runs.data[j];
                if (rtx_run_dest(r) && r->start + r->len == lab->start) {
                    dest = r;
                    break;
                }
            }
        }
    }
    if (dest && !lab) {
        j = rtx_doc_run_first(d, dest->start ? dest->start - 1 : 0);
        for (; j < d->runs.len && d->runs.data[j].start < dest->start; j++) {
            const RtxRun *r = &d->runs.data[j];
            if (rtx_run_arity(r) == RTX_ARITY_PATH && !rtx_run_dest(r) &&
                r->start + r->len == dest->start)
                lab = r;
        }
        if (!lab) {
            size_t edge = dest->start + dest->len;
            j = rtx_doc_run_first(d, edge);
            for (; j < d->runs.len && d->runs.data[j].start <= edge; j++) {
                const RtxRun *r = &d->runs.data[j];
                if (rtx_run_arity(r) == RTX_ARITY_PATH && !rtx_run_dest(r) &&
                    r->start == edge)
                    lab = r;
            }
        }
    }
    if (!lab) return 0;
    {
        size_t a = lab->start, b = lab->start + lab->len;
        size_t c = dest ? dest->start : a;
        size_t e = dest ? dest->start + dest->len : b;
        if (lo) *lo = a < c ? a : c;
        if (hi) *hi = b > e ? b : e;
        if (keep_lo) *keep_lo = lab->start + lab->hint_a;
        if (keep_hi)
            *keep_hi = lab->hint_b ? lab->start + lab->len - lab->hint_b
                                   : lab->start + lab->len;
    }
    return 1;
}

void !>(CCError) RtxDoc_path_unwrap(RtxDoc *d, size_t off) {
    size_t lo, hi, klo, khi, n, got;
    char *buf;
    CCArena frame = {0};
    @errhandler(CCError e) {
        if (frame.base) frame.destroy();
        return cc_err(e);
    }
    if (!d) return cc_err(CC_ERR_INVALID_ARG, "path unwrap");
    lo = hi = klo = khi = 0;
    if (!RtxDoc_path_at(d, off, &lo, &hi, &klo, &khi) || hi <= lo)
        return cc_ok();
    n = khi > klo ? khi - klo : 0;
    if (n) {
        frame = cc_arena_heap(n + 8);
        if (!frame.base) return cc_err(CC_ERR_OUT_OF_MEMORY, "path unwrap");
        buf = (char *)cc_arena_alloc(frame, n, 1);
        if (!buf) {
            frame.destroy();
            return cc_err(CC_ERR_OUT_OF_MEMORY, "path unwrap");
        }
        got = d->read_at(klo, cc_slice_from_buffer(buf, n)) !>;
        if (got != n) {
            frame.destroy();
            return cc_err(CC_ERR_INTERNAL, "path unwrap read");
        }
        rtx_doc_policy_replace(d, lo, hi - lo, cc_slice_from_buffer(buf, n)) !>;
        frame.destroy();
        return cc_ok();
    }
    return rtx_doc_policy_replace(d, lo, hi - lo, cc_slice_empty());
}

int RtxDoc_prefix_at(const RtxDoc *d, size_t off, size_t *lo, size_t *hi) {
    size_t i;
    int hit = 0;
    if (!d || d->runs.len == 0) return 0;
    i = rtx_doc_run_first(d, off);
    for (; i < d->runs.len && d->runs.data[i].start <= off;
         i = rtx_doc_run_step(d, i, off)) {
        const RtxRun *r = &d->runs.data[i];
        size_t a0, a1;
        if (rtx_run_arity(r) != RTX_ARITY_PREFIX || r->hint_a == 0) continue;
        a0 = r->start;
        a1 = r->start + r->hint_a;
        if (off < a0 || off >= a1) continue;
        if (lo) *lo = a0;
        if (hi) *hi = a1;
        hit = 1;
    }
    return hit;
}

size_t rtx_tree_read(void *tree, size_t off, char *dst, size_t n);

static size_t rtx_doc_bol_byte(const RtxDoc *d, size_t off) {
    char c;
    size_t n;
    if (!d) return 0;
    n = d->len();
    if (off > n) off = n;
    while (off > 0) {
        if (rtx_tree_read((void *)&d->tree, off - 1, &c, 1) != 1) break;
        if (c == '\n') break;
        off--;
    }
    return off;
}

static int rtx_tm_rule_is_prefix(const RtxTmRule *r) {
    return r && (r->mark & RTX_MARK_ARITY) == RTX_ARITY_PREFIX;
}

static const RtxTmRule *rtx_tm_prefix_by_scope(const RtxTmRt *rt, RtxScope scope) {
    size_t i;
    if (!rt) return NULL;
    for (i = 0; i < rt->rules.len; i++) {
        const RtxTmRule *r = &rt->rules.data[i];
        if (!rtx_tm_rule_is_prefix(r) || r->scope != scope) continue;
        if (r->sc_insert && r->sc_insert[0]) return r;
    }
    for (i = 0; i < rt->inners.len; i++) {
        const RtxTmRule *r = &rt->inners.data[i];
        if (!rtx_tm_rule_is_prefix(r) || r->scope != scope) continue;
        if (r->sc_insert && r->sc_insert[0]) return r;
    }
    return NULL;
}

static const RtxTmRule *rtx_tm_prefix_by_apply(const RtxTmRt *rt, const char *name) {
    size_t i;
    if (!rt || !name || !name[0]) return NULL;
    for (i = 0; i < rt->rules.len; i++) {
        const RtxTmRule *r = &rt->rules.data[i];
        if (!rtx_tm_rule_is_prefix(r) || !r->sc_apply) continue;
        if (!rtx_cstr_eq(r->sc_apply, name)) continue;
        if (r->sc_insert && r->sc_insert[0]) return r;
    }
    return NULL;
}

static const RtxTmRule *rtx_tm_first_prefix_apply(const RtxTmRt *rt) {
    size_t i;
    if (!rt) return NULL;
    for (i = 0; i < rt->rules.len; i++) {
        const RtxTmRule *r = &rt->rules.data[i];
        if (!rtx_tm_rule_is_prefix(r)) continue;
        if (r->sc_apply && r->sc_apply[0] && r->sc_insert && r->sc_insert[0])
            return r;
    }
    return NULL;
}

/* `insert: "off/on"` — same-length states. Third client of insert
 * (prefix unit, pair bookends, toggle pair). */
static int rtx_apply_toggle_parts(const char *ins, const char **off, size_t *offn,
                                  const char **on, size_t *onn) {
    const char *slash;
    size_t a, b;
    if (!ins || !ins[0]) return 0;
    slash = strchr(ins, '/');
    if (!slash || slash == ins || !slash[1]) return 0;
    a = (size_t)(slash - ins);
    b = cc_slice_cstr(slash + 1).len;
    if (!a || a != b) return 0;
    if (off) *off = ins;
    if (offn) *offn = a;
    if (on) *on = slash + 1;
    if (onn) *onn = b;
    return 1;
}

/* Derived: arity plus “this rule can transform” (`insert` / `wrap` / lit
 * span). Not stored on the rule or the run. */
static int rtx_tm_apply_kind(const RtxTmRule *r) {
    unsigned ar;
    if (!r || !r->sc_apply || !r->sc_apply[0]) return 0;
    ar = (unsigned)(r->mark & RTX_MARK_ARITY);
    if (ar == (unsigned)RTX_ARITY_PREFIX && r->sc_insert && r->sc_insert[0])
        return RTX_APPLY_PREFIX;
    if (ar == (unsigned)RTX_ARITY_PATH && !(r->mark & RTX_MARK_DEST))
        return RTX_APPLY_PATH;
    if (rtx_apply_toggle_parts(r->sc_insert, NULL, NULL, NULL, NULL))
        return RTX_APPLY_TOGGLE;
    if (r->sc_wrap) return RTX_APPLY_PAIR;
    if (r->op == RTX_TM_LIT_SPAN && r->a && r->b && r->alen && r->blen)
        return RTX_APPLY_PAIR;
    return 0;
}

static int rtx_apply_name_eq(const char *a, const char *b) {
    return a && b && a[0] && rtx_cstr_eq(a, b);
}

static const RtxTmRule *rtx_tm_apply_walk(const RtxTmRule *rs, size_t n,
                                          const char *name) {
    size_t i;
    if (!rs || !name || !name[0]) return NULL;
    for (i = 0; i < n; i++) {
        const RtxTmRule *r = &rs[i];
        if (!rtx_apply_name_eq(r->sc_apply, name)) continue;
        if (rtx_tm_apply_kind(r)) return r;
    }
    return NULL;
}

static const RtxTmRule *rtx_tm_apply_rule(const RtxTmRt *rt, const char *name) {
    const RtxTmRule *r;
    if (!rt) return NULL;
    r = rtx_tm_apply_walk(rt->rules.data, rt->rules.len, name);
    if (r) return r;
    return rtx_tm_apply_walk(rt->inners.data, rt->inners.len, name);
}

static size_t rtx_tm_apply_collect(const RtxTmRule *rs, size_t n,
                                   RtxApplyEnt *out, size_t cap, size_t have) {
    size_t i, k;
    if (!rs) return have;
    for (i = 0; i < n; i++) {
        const RtxTmRule *r = &rs[i];
        int kind = rtx_tm_apply_kind(r);
        if (!kind) continue;
        for (k = 0; k < have; k++) {
            if (rtx_apply_name_eq(out[k].name, r->sc_apply)) break;
        }
        if (k < have) continue;
        if (have < cap) {
            out[have].name = r->sc_apply;
            out[have].kind = (unsigned char)kind;
        }
        have++;
    }
    return have;
}

size_t rtx_tm_apply_list(const RtxTmRt *rt, RtxApplyEnt *out, size_t cap) {
    size_t n = 0;
    if (!rt || !out || !cap) return 0;
    n = rtx_tm_apply_collect(rt->rules.data, rt->rules.len, out, cap, 0);
    n = rtx_tm_apply_collect(rt->inners.data, rt->inners.len, out, cap, n);
    return n > cap ? cap : n;
}

static int rtx_apply_delims(const RtxTmRule *r, const char **a, size_t *an,
                            const char **b, size_t *bn) {
    size_t w, il;
    if (!r || !a || !an || !b || !bn) return 0;
    if (r->sc_wrap && r->sc_insert && r->sc_insert[0]) {
        w = (size_t)r->sc_wrap;
        il = cc_slice_cstr(r->sc_insert).len;
        if (!w || il < 2 * w) return 0;
        *a = r->sc_insert;
        *an = w;
        *b = r->sc_insert + (il - w);
        *bn = w;
        return 1;
    }
    if (r->op == RTX_TM_LIT_SPAN && r->a && r->b && r->alen && r->blen) {
        *a = r->a;
        *an = r->alen;
        *b = r->b;
        *bn = r->blen;
        return 1;
    }
    return 0;
}

static int rtx_apply_max(const RtxTmRule *r) {
    if (!r || !r->sc_max) return 1;
    return (int)r->sc_max;
}

static int rtx_apply_unit_n(const char *buf, size_t n, const char *ins) {
    size_t i, il;
    int u = 0;
    if (!buf || !n || !ins || !ins[0]) return n ? 1 : 0;
    il = cc_slice_cstr(ins).len;
    if (il != 1) return 1;
    for (i = 0; i < n; i++) {
        if (buf[i] == ins[0]) u++;
        else if (buf[i] != ' ' && buf[i] != '\t') break;
    }
    return u;
}

static size_t rtx_apply_fill(char *dst, size_t cap, const char *ins, int level,
                             int want_space) {
    size_t il, n = 0;
    int i;
    if (!dst || !ins || level <= 0) return 0;
    il = cc_slice_cstr(ins).len;
    if (!il) return 0;
    for (i = 0; i < level; i++) {
        char[:] to;
        char[:] from;
        if (n + il > cap) break;
        to = cc_slice_from_buffer(dst + n, il);
        from = cc_slice_from_buffer((void *)ins, il);
        to.copy(from) !>(e) {
            (void)e;
            break;
        };
        n += il;
    }
    if (want_space && n && dst[n - 1] != ' ' && dst[n - 1] != '\t' && n < cap)
        dst[n++] = ' ';
    return n;
}

static int rtx_doc_range_ws(const RtxDoc *d, size_t lo, size_t hi) {
    char buf[64];
    size_t n, k;
    if (!d) return 0;
    while (lo < hi) {
        n = hi - lo;
        if (n > sizeof(buf)) n = sizeof(buf);
        if (rtx_tree_read((void *)&d->tree, lo, buf, n) != n) return 0;
        for (k = 0; k < n; k++) {
            if (buf[k] == '\n') return 0;
            if (buf[k] != ' ' && buf[k] != '\t') return 0;
        }
        lo += n;
    }
    return 1;
}

static size_t rtx_doc_eol_byte(const RtxDoc *d, size_t bol) {
    char c;
    size_t n, off;
    if (!d) return 0;
    n = d->len();
    off = bol;
    while (off < n) {
        if (rtx_tree_read((void *)&d->tree, off, &c, 1) != 1) break;
        if (c == '\n') break;
        off++;
    }
    return off;
}

static size_t rtx_doc_indent_end(const RtxDoc *d, size_t bol) {
    char c;
    size_t n, off;
    if (!d) return 0;
    n = d->len();
    off = bol;
    while (off < n) {
        if (rtx_tree_read((void *)&d->tree, off, &c, 1) != 1) break;
        if (c != ' ' && c != '\t') break;
        off++;
    }
    return off;
}

static const RtxRun *rtx_doc_prefix_run_at(const RtxDoc *d, size_t off) {
    const RtxRun *hit = NULL;
    size_t i;
    if (!d || d->runs.len == 0) return NULL;
    i = rtx_doc_run_first(d, off);
    for (; i < d->runs.len && d->runs.data[i].start <= off;
         i = rtx_doc_run_step(d, i, off)) {
        const RtxRun *r = &d->runs.data[i];
        size_t a0, a1;
        if (rtx_run_arity(r) != RTX_ARITY_PREFIX || r->hint_a == 0) continue;
        a0 = r->start;
        a1 = r->start + r->hint_a;
        if (off < a0 || off >= a1) continue;
        hit = r;
    }
    return hit;
}

/* Leading prefix on the line: indent may precede the marker. Trailing
 * ` ##` is skipped because title bytes sit between BOL and that hint. */
static const RtxRun *rtx_doc_line_prefix(const RtxDoc *d, size_t off) {
    size_t bol, eol, i;
    if (!d || d->runs.len == 0) return NULL;
    bol = rtx_doc_bol_byte(d, off);
    eol = rtx_doc_eol_byte(d, bol);
    i = rtx_doc_run_first(d, bol);
    for (; i < d->runs.len && d->runs.data[i].start < eol; i++) {
        const RtxRun *r = &d->runs.data[i];
        if (rtx_run_arity(r) != RTX_ARITY_PREFIX || r->hint_a == 0) continue;
        if (r->start < bol) continue;
        if (r->start > bol && !rtx_doc_range_ws(d, bol, r->start)) continue;
        return r;
    }
    return NULL;
}

static const RtxTmRt *rtx_doc_tm(const RtxDoc *d) {
    return d && d->path.ptr ? rtx_tm_for_path(d->path.ptr) : NULL;
}

/* Grammar of this path, not the caret. Untitled / no grammar → 0. */
size_t RtxDoc_apply_list(const RtxDoc *d, RtxApplyEnt *out, size_t cap) {
    return rtx_tm_apply_list(rtx_doc_tm(d), out, cap);
}

static RtxTmRule *rtx_tm_rule_from_tag(const RtxTmRt *rt, size_t tag);

/* A run's rule tag indexes its planter's grammar; only a host TM run's tag
 * names a rule of the path grammar. */
static const RtxTmRule *rtx_doc_run_rule(const RtxDoc *d, const RtxRun *r) {
    if (!d || !r || r->planter != (unsigned char)RTX_RUN_TM) return NULL;
    return rtx_tm_rule_from_tag(rtx_doc_tm(d), (size_t)r->rule);
}

static const char *rtx_doc_prefix_insert(const RtxDoc *d, const RtxRun *r) {
    const RtxTmRule *rule;
    if (!d || !r || r->planter != (unsigned char)RTX_RUN_TM) return NULL;
    rule = rtx_doc_run_rule(d, r);
    if (rule && rule->sc_insert && rule->sc_insert[0]) return rule->sc_insert;
    rule = rtx_tm_prefix_by_scope(rtx_doc_tm(d), r->style.scope);
    return rule ? rule->sc_insert : NULL;
}

void !>(CCError) RtxDoc_prefix_apply(RtxDoc *d, size_t off) {
    const RtxRun *r;
    const char *ins;
    size_t lo, hi, n, got, i, last;
    int units;
    char buf[256];
    @errhandler(CCError e) {
        return cc_err(e);
    }
    if (!d) return cc_err(CC_ERR_INVALID_ARG, "prefix apply");
    r = rtx_doc_prefix_run_at(d, off);
    if (!r) return cc_ok();
    lo = r->start;
    hi = r->start + r->hint_a;
    if (hi <= lo) return cc_ok();
    n = hi - lo;
    if (n > sizeof(buf)) n = sizeof(buf);
    got = d->read_at(lo, cc_slice_from_buffer(buf, n)) !>;
    if (got != n) return cc_err(CC_ERR_INTERNAL, "prefix apply read");
    ins = rtx_doc_prefix_insert(d, r);
    if (!ins || !ins[0] || ins[1] != 0)
        return rtx_doc_policy_replace(d, lo, hi - lo, cc_slice_empty());
    last = (size_t)-1;
    units = 0;
    for (i = 0; i < got; i++) {
        if (buf[i] == ins[0]) {
            last = i;
            units++;
        }
    }
    if (units <= 1 || last == (size_t)-1)
        return rtx_doc_policy_replace(d, lo, hi - lo, cc_slice_empty());
    memmove(buf + last, buf + last + 1, got - last - 1);
    return rtx_doc_policy_replace(d, lo, hi - lo,
                                  cc_slice_from_buffer(buf, got - 1));
}

int RtxDoc_apply_at(const RtxDoc *d, size_t off, size_t *lo, size_t *hi,
                    const char **name) {
    const RtxRun *r;
    const RtxTmRule *rule;
    char buf[64];
    size_t a0, a1, got;
    int units;
    if (name) *name = NULL;
    r = rtx_doc_line_prefix(d, off);
    if (!r) return 0;
    a0 = r->start;
    a1 = r->start + r->hint_a;
    rule = rtx_tm_prefix_by_scope(rtx_doc_tm(d), r->style.scope);
    got = a1 - a0;
    if (got > sizeof(buf)) got = sizeof(buf);
    if (rtx_tree_read((void *)&d->tree, a0, buf, got) != got) return 0;
    units = rtx_apply_unit_n(buf, got, rule ? rule->sc_insert : NULL);
    if (units <= 0) units = 1;
    if (lo) *lo = a0;
    if (hi) *hi = a1;
    if (name && rule && rule->sc_apply) *name = rule->sc_apply;
    return units;
}

/* Fence bodies stay MARKUP as a section; guest / raw.block runs are not
 * a prefix-apply client. */
static int rtx_doc_apply_blocked(const RtxDoc *d, size_t off) {
    size_t i;
    if (!d) return 1;
    if (d->section_at(off) != RTX_SEC_MARKUP) return 1;
    if (d->runs.len == 0) return 0;
    i = rtx_doc_run_first(d, off);
    for (; i < d->runs.len && d->runs.data[i].start <= off;
         i = rtx_doc_run_step(d, i, off)) {
        const RtxRun *r = &d->runs.data[i];
        const char *s;
        if (off >= r->start + r->len) continue;
        if (r->planter == RTX_RUN_INJECT) return 1;
        s = rtx_scope_name(r->style.scope);
        if (s && strstr(s, "raw.block")) return 1;
    }
    return 0;
}

void !>(CCError) RtxDoc_apply_set(RtxDoc *d, size_t off, char[:0] name, int level) {
    const RtxTmRule *rule;
    const char *cur_name;
    size_t bol, lo, hi, n, got, caret0, anc0;
    char old[64], neu[64], peek;
    int cur, want_space, maxv;
    @errhandler(CCError e) {
        return cc_err(e);
    }
    if (!d) return cc_err(CC_ERR_INVALID_ARG, "apply set");
    rule = rtx_tm_prefix_by_apply(rtx_doc_tm(d), name.ptr);
    if (!rule || !rule->sc_insert) return cc_ok();
    maxv = rtx_apply_max(rule);
    if (level < 0) level = 0;
    if (level > maxv) level = maxv;
    bol = rtx_doc_bol_byte(d, off);
    if (rtx_doc_apply_blocked(d, bol)) return cc_ok();
    lo = hi = bol;
    cur_name = NULL;
    cur = RtxDoc_apply_at(d, off, &lo, &hi, &cur_name);
    if (cur == 0) {
        lo = rtx_doc_indent_end(d, bol);
        hi = lo;
    }
    peek = 0;
    if (hi < d->len()) {
        got = d->read_at(hi, cc_slice_from_buffer(&peek, 1)) !>;
        if (got != 1) peek = 0;
    }
    want_space = peek && peek != '\n';
    n = rtx_apply_fill(neu, sizeof neu, rule->sc_insert, level, want_space);
    if (hi > lo) {
        size_t oldn = hi - lo;
        if (oldn > sizeof(old)) oldn = sizeof(old);
        got = d->read_at(lo, cc_slice_from_buffer(old, oldn)) !>;
        if (got == n && n && memcmp(old, neu, n) == 0) return cc_ok();
    } else if (n == 0) {
        return cc_ok();
    }
    caret0 = d->caret;
    anc0 = d->sel_anchor;
    rtx_doc_policy_replace(d, lo, hi - lo,
                           n ? cc_slice_from_buffer(neu, n) : cc_slice_empty()) !>;
    {
        long delta = (long)n - (long)(hi - lo);
        if (caret0 >= hi) caret0 = (size_t)((long)caret0 + delta);
        else if (caret0 > lo) caret0 = lo + n;
        if (anc0 >= hi) anc0 = (size_t)((long)anc0 + delta);
        else if (anc0 > lo) anc0 = lo + n;
        d->caret = caret0;
        d->sel_anchor = anc0;
        if (!d->hist.applying && d->hist.head > 0) {
            RtxHistRec *last = &d->hist.recs[d->hist.head - 1];
            last->caret_after = d->caret;
            last->sel_after = d->sel_anchor;
        }
    }
    return cc_ok();
}

void !>(CCError) RtxDoc_apply_cycle(RtxDoc *d, size_t off) {
    const RtxTmRule *rule;
    const char *name = NULL;
    size_t lo, hi;
    int cur, next;
    if (!d) return cc_err(CC_ERR_INVALID_ARG, "apply cycle");
    lo = hi = 0;
    cur = RtxDoc_apply_at(d, off, &lo, &hi, &name);
    if (cur && name && name[0]) {
        rule = rtx_tm_prefix_by_apply(rtx_doc_tm(d), name);
        next = cur >= rtx_apply_max(rule) ? 0 : cur + 1;
        return d->apply_set(off, cc_slice_cstr(name), next);
    }
    if (cur) {
        return rtx_doc_policy_replace(d, lo, hi - lo, cc_slice_empty());
    }
    rule = rtx_tm_first_prefix_apply(rtx_doc_tm(d));
    if (!rule || !rule->sc_apply) return cc_ok();
    return d->apply_set(off, cc_slice_cstr(rule->sc_apply), 1);
}

static int rtx_mdl_ws(char c) {
    return c == ' ' || c == '\t';
}

void rtx_md_line_parse(const char *s, size_t n, RtxMdLine *out) {
    size_t i = 0, k, j;
    RtxMdLine L = {0};
    if (!out) return;
    if (!s) n = 0;
    if (n && s[n - 1] == '\r') n--;
    L.n = n;
    /* Quote markers: up to three spaces, `>`, one optional space. */
    for (;;) {
        size_t sp = 0;
        j = i;
        while (j < n && s[j] == ' ' && sp < 3) {
            j++;
            sp++;
        }
        if (j < n && s[j] == '>') {
            j++;
            if (j < n && rtx_mdl_ws(s[j])) j++;
            i = j;
            L.qdepth++;
            continue;
        }
        break;
    }
    L.qhi = i;
    k = i;
    while (k < n && rtx_mdl_ws(s[k])) k++;
    L.ind = k - i;
    L.clo = L.chi = k;
    if (k < n && (s[k] == '`' || s[k] == '~')) {
        size_t r = k;
        while (r < n && s[r] == s[k]) r++;
        if (r - k >= 3) {
            int ok = 1;
            size_t t;
            for (t = r; t < n; t++) {
                if (s[k] == '`' && s[t] == '`') ok = 0;
                if (!rtx_mdl_ws(s[t])) L.fence_info = 1;
            }
            if (ok) {
                L.fence = s[k];
                L.fence_n = r - k;
            }
        }
    }
    if (L.ind <= 3 && k < n && s[k] == '#') {
        size_t h = k;
        while (h < n && s[h] == '#') h++;
        if (h - k <= 6 && (h == n || rtx_mdl_ws(s[h]))) {
            L.heading = 1;
            while (h < n && rtx_mdl_ws(s[h])) h++;
            L.clo = L.chi = h;
        }
    }
    if (!L.heading && !L.fence && k < n &&
        (s[k] == '-' || s[k] == '*' || s[k] == '+') &&
        (k + 1 == n || rtx_mdl_ws(s[k + 1]))) {
        /* `* * *` / `- - -` is a thematic break, not an item. */
        size_t t, cnt = 0;
        int other = 0;
        for (t = k; t < n; t++) {
            if (s[t] == s[k]) cnt++;
            else if (!rtx_mdl_ws(s[t])) other = 1;
        }
        if (other || cnt < 3) {
            L.kind = RTX_MDL_BULLET;
            L.bullet = s[k];
            L.mlo = k;
            L.mhi = k + 1;
        }
    } else if (!L.heading && !L.fence && k < n && s[k] >= '0' && s[k] <= '9') {
        size_t d = k;
        unsigned long v = 0;
        while (d < n && d - k < 9 && s[d] >= '0' && s[d] <= '9') {
            v = v * 10 + (unsigned long)(s[d] - '0');
            d++;
        }
        if (d < n && (s[d] == '.' || s[d] == ')') &&
            (d + 1 == n || rtx_mdl_ws(s[d + 1]))) {
            L.kind = RTX_MDL_ORDERED;
            L.delim = s[d];
            L.num = v;
            L.mlo = k;
            L.mhi = d + 1;
        }
    }
    if (L.kind) {
        size_t sp = 0, c = L.mhi;
        while (c < n && rtx_mdl_ws(s[c])) {
            c++;
            sp++;
        }
        /* Five or more spaces: the item text is indented code; the
         * content column is one space past the marker (CommonMark). */
        if (c < n && sp > 4) c = L.mhi + 1;
        L.chi = L.clo = c;
        if (n - c >= 3 && s[c] == '[' && s[c + 2] == ']' &&
            (s[c + 1] == ' ' || s[c + 1] == 'x' || s[c + 1] == 'X') &&
            (c + 3 == n || rtx_mdl_ws(s[c + 3]))) {
            L.task = 1;
            L.clo = c + 3 < n ? c + 4 : c + 3;
        }
    }
    L.blank = 1;
    for (j = L.clo; j < n; j++) {
        if (!rtx_mdl_ws(s[j])) {
            L.blank = 0;
            break;
        }
    }
    *out = L;
}

static int rtx_doc_is_word(char c) {
    return c != ' ' && c != '\t' && c != '\n' && c != '\r';
}

static void rtx_doc_word_span(const RtxDoc *d, size_t off, size_t *lo, size_t *hi) {
    size_t n, a, b;
    char c;
    int on = 0;
    if (!d) {
        if (lo) *lo = 0;
        if (hi) *hi = 0;
        return;
    }
    n = d->len();
    if (off > n) off = n;
    if (off < n) {
        if (rtx_tree_read((void *)&d->tree, off, &c, 1) == 1 && rtx_doc_is_word(c))
            on = 1;
    } else if (off > 0) {
        if (rtx_tree_read((void *)&d->tree, off - 1, &c, 1) == 1 &&
            rtx_doc_is_word(c))
            on = 1;
    }
    if (!on) {
        if (lo) *lo = off;
        if (hi) *hi = off;
        return;
    }
    a = b = off;
    if (a == n && a > 0) a--;
    while (a > 0) {
        if (rtx_tree_read((void *)&d->tree, a - 1, &c, 1) != 1) break;
        if (!rtx_doc_is_word(c)) break;
        a--;
    }
    while (b < n) {
        if (rtx_tree_read((void *)&d->tree, b, &c, 1) != 1) break;
        if (!rtx_doc_is_word(c)) break;
        b++;
    }
    if (lo) *lo = a;
    if (hi) *hi = b;
}

static int rtx_run_covers_off(const RtxRun *r, size_t off) {
    return r && r->hint_a && off >= r->start && off <= r->start + r->len;
}

/* Planter + rule id, not bit shape or scope. Include clones share
 * `cctext.apply`; tag equality would miss an inner `#bold`. */
static int rtx_run_apply_match(const RtxTmRt *rt, const RtxTmRule *want,
                               const RtxRun *r) {
    const RtxTmRule *got;
    if (!want || !r || !rt) return 0;
    if (r->planter != (unsigned char)RTX_RUN_TM) return 0;
    if (!r->hint_a || rtx_run_arity(r) != RTX_ARITY_PAIR) return 0;
    got = rtx_tm_rule_from_tag(rt, (size_t)r->rule);
    if (!got) return 0;
    if (want->sc_apply && want->sc_apply[0])
        return got->sc_apply && rtx_apply_name_eq(got->sc_apply, want->sc_apply);
    return got == want;
}

static const RtxRun *rtx_doc_pair_apply_at(const RtxDoc *d, size_t off,
                                           const RtxTmRule *want) {
    const RtxRun *hit = NULL;
    const RtxTmRt *rt;
    size_t i;
    if (!d || !want || d->runs.len == 0) return NULL;
    rt = rtx_doc_tm(d);
    i = rtx_doc_run_first(d, off);
    for (; i < d->runs.len && d->runs.data[i].start <= off;
         i = rtx_doc_run_step(d, i, off)) {
        const RtxRun *r = &d->runs.data[i];
        if (!rtx_run_covers_off(r, off)) continue;
        if (!rtx_run_apply_match(rt, want, r)) continue;
        hit = r;
    }
    return hit;
}

static const RtxRun *rtx_doc_pair_apply_sel(const RtxDoc *d, const RtxTmRule *want) {
    const RtxRun *r;
    size_t lo, hi;
    if (!d) return NULL;
    lo = RtxDoc_sel_lo(d);
    hi = RtxDoc_sel_hi(d);
    if (hi > lo) {
        r = rtx_doc_pair_apply_at(d, lo, want);
        if (r) return r;
        r = rtx_doc_pair_apply_at(d, hi - 1, want);
        if (r) return r;
    }
    return rtx_doc_pair_apply_at(d, d->caret, want);
}

static void rtx_doc_apply_caret(RtxDoc *d, size_t caret, size_t anc) {
    if (!d) return;
    d->caret = caret;
    d->sel_anchor = anc;
    if (!d->hist.applying && d->hist.head > 0) {
        RtxHistRec *last = &d->hist.recs[d->hist.head - 1];
        last->caret_after = d->caret;
        last->sel_after = d->sel_anchor;
    }
}

static int rtx_doc_apply_range_blocked(const RtxDoc *d, size_t lo, size_t hi) {
    if (rtx_doc_apply_blocked(d, lo)) return 1;
    if (hi > lo && rtx_doc_apply_blocked(d, hi - 1)) return 1;
    return 0;
}

static void !>(CCError) rtx_doc_apply_unwrap_pair(RtxDoc *d, const RtxRun *r) {
    size_t lo, hi, klo, khi, n, got;
    char *buf;
    CCArena frame = {0};
    @errhandler(CCError e) {
        if (frame.base) frame.destroy();
        return cc_err(e);
    }
    if (!d || !r) return cc_ok();
    lo = r->start;
    hi = r->start + r->len;
    klo = lo + r->hint_a;
    khi = r->hint_b ? hi - r->hint_b : hi;
    if (khi < klo) khi = klo;
    n = khi - klo;
    if (n > (size_t)RTX_HL_WIN_MAX) return cc_ok();
    if (n) {
        frame = cc_arena_heap(n + 8);
        if (!frame.base) return cc_err(CC_ERR_OUT_OF_MEMORY, "apply unwrap");
        buf = (char *)cc_arena_alloc(frame, n, 1);
        if (!buf) {
            frame.destroy();
            return cc_err(CC_ERR_OUT_OF_MEMORY, "apply unwrap");
        }
        got = d->read_at(klo, cc_slice_from_buffer(buf, n)) !>;
        if (got != n) {
            frame.destroy();
            return cc_err(CC_ERR_INTERNAL, "apply unwrap read");
        }
        rtx_doc_policy_replace(d, lo, hi - lo, cc_slice_from_buffer(buf, n)) !>;
        frame.destroy();
    } else {
        rtx_doc_policy_replace(d, lo, hi - lo, cc_slice_empty()) !>;
    }
    rtx_doc_apply_caret(d, lo + n, lo);
    return cc_ok();
}

/* ---- Pair apply (docs/md_view.md, Apply). Whitespace around a selection
 * stays outside the mark; a multi-line selection wraps each line's text
 * (inline marks do not cross lines); a range that already carries the
 * mark toggles it off instead of nesting it again. Coverage is exclusive
 * at the end: a caret just after `**bold**` is outside it. */

static size_t rtx_doc_peek(const RtxDoc *d, size_t off, char *dst, size_t n) {
    size_t len;
    if (!d || !dst) return 0;
    len = d->len();
    if (off >= len) return 0;
    if (n > len - off) n = len - off;
    return rtx_tree_read((void *)&d->tree, off, dst, n);
}

static char rtx_apply_one_char(const char *a, size_t an) {
    size_t i;
    if (!a || !an) return 0;
    for (i = 1; i < an; i++) {
        if (a[i] != a[0]) return 0;
    }
    return a[0];
}

/* Delimiter run test. `kl` / `kr` are the runs of the delimiter char at
 * the left / right boundary (emphasis-like marks), or 0 / 1 when `a` / `b`
 * sit exactly there (other marks). */
static int rtx_apply_run_ok(char ch, size_t an, size_t kl, size_t kr) {
    size_t k = kl < kr ? kl : kr;
    if (k < an) return 0;
    if (k == an) return 1;
    /* `***x***` holds both bold and italic. */
    return k == 3 && an <= 2 && (ch == '*' || ch == '_');
}

/* Marks just outside [s, e). */
static int rtx_apply_outside(const RtxDoc *d, const char *a, size_t an,
                             const char *b, size_t bn, size_t s, size_t e) {
    char pre[8], post[8];
    size_t pn, qn, lo, kl = 0, kr = 0;
    char ch = rtx_apply_one_char(a, an);
    if (!d || s < an) return 0;
    lo = s >= sizeof pre ? s - sizeof pre : 0;
    pn = rtx_doc_peek(d, lo, pre, s - lo);
    qn = rtx_doc_peek(d, e, post, sizeof post);
    if (ch && an == bn && ch == rtx_apply_one_char(b, bn)) {
        while (kl < pn && pre[pn - 1 - kl] == ch) kl++;
        while (kr < qn && post[kr] == ch) kr++;
        return rtx_apply_run_ok(ch, an, kl, kr);
    }
    return pn >= an && qn >= bn && memcmp(pre + pn - an, a, an) == 0 &&
           memcmp(post, b, bn) == 0;
}

/* Marks at the edges of the bytes `seg` (already inside the range). */
static int rtx_apply_inside(const char *a, size_t an, const char *b, size_t bn,
                            const char *seg, size_t n) {
    size_t kl = 0, kr = 0;
    char ch = rtx_apply_one_char(a, an);
    if (!seg || n < an + bn) return 0;
    if (ch && an == bn && ch == rtx_apply_one_char(b, bn)) {
        while (kl < n && seg[kl] == ch) kl++;
        while (kr < n && seg[n - 1 - kr] == ch) kr++;
        /* `**` alone is one run, not two ends. */
        if (kl == n) return n == an + bn;
        return rtx_apply_run_ok(ch, an, kl, kr);
    }
    return memcmp(seg, a, an) == 0 && memcmp(seg + n - bn, b, bn) == 0;
}

/* Position after a group of sorted edits. `push`: an insert exactly at
 * `x` lands before it (x moves past the inserted bytes). */
static size_t rtx_edits_map(const RtxEdit *eds, size_t n, size_t x, int push) {
    size_t i;
    ptrdiff_t acc = 0;
    for (i = 0; i < n; i++) {
        size_t o = eds[i].off, e = eds[i].off + eds[i].n;
        if (x < o) break;
        if (x == o && eds[i].n == 0) {
            if (!push) break;
        } else if (x < e) {
            size_t in = x - o;
            if (in > eds[i].ins.len) in = eds[i].ins.len;
            return (size_t)((ptrdiff_t)o + acc) + in;
        }
        acc += (ptrdiff_t)eds[i].ins.len - (ptrdiff_t)eds[i].n;
    }
    return (size_t)((ptrdiff_t)x + acc);
}

static const RtxRun *rtx_doc_pair_cover(const RtxDoc *d, size_t off,
                                        const RtxTmRule *want, int strict) {
    const RtxRun *hit = NULL;
    const RtxTmRt *rt;
    size_t i;
    if (!d || !want || d->runs.len == 0) return NULL;
    rt = rtx_doc_tm(d);
    i = rtx_doc_run_first(d, off);
    for (; i < d->runs.len && d->runs.data[i].start <= off;
         i = rtx_doc_run_step(d, i, off)) {
        const RtxRun *r = &d->runs.data[i];
        size_t s = r->start, e = r->start + r->len;
        if (strict ? !(off > s && off < e) : !(off >= s && off < e)) continue;
        if (!rtx_run_apply_match(rt, want, r)) continue;
        hit = r;
    }
    return hit;
}

static void !>(CCError) rtx_doc_apply_group(RtxDoc *d, const RtxEdit *eds,
                                           size_t n, size_t caret, size_t anc) {
    RtxDoc_break_coalesce(d);
    RtxDoc_replace_batch(d, eds, n) !>(e) { return cc_err(e); };
    RtxDoc_break_coalesce(d);
    rtx_doc_apply_caret(d, caret, anc);
    return cc_ok();
}

/* Empty selection: inside a mark → unwrap it; between an empty pair →
 * drop it; on a word → wrap the word (content selected); else insert the
 * pair with the caret between (`**|**`). */
static void !>(CCError) rtx_doc_apply_pair_caret(RtxDoc *d, const RtxTmRule *rule,
                                                const char *a, size_t an,
                                                const char *b, size_t bn) {
    const RtxRun *pr;
    size_t c = d->caret, wlo, whi;
    RtxEdit eds[2];
    char pair[32];
    if (rtx_doc_apply_blocked(d, c)) return cc_ok();
    pr = rtx_doc_pair_cover(d, c, rule, 1);
    if (pr) return rtx_doc_apply_unwrap_pair(d, pr);
    if (rtx_apply_outside(d, a, an, b, bn, c, c)) {
        eds[0] = (RtxEdit){ .off = c - an, .n = an, .ins = cc_slice_empty() };
        eds[1] = (RtxEdit){ .off = c, .n = bn, .ins = cc_slice_empty() };
        return rtx_doc_apply_group(d, eds, 2, c - an, c - an);
    }
    rtx_doc_word_span(d, c, &wlo, &whi);
    if (whi > wlo && whi - wlo <= 4096) {
        char w[4096];
        size_t got = rtx_doc_peek(d, wlo, w, whi - wlo);
        if (got == whi - wlo && rtx_apply_inside(a, an, b, bn, w, got)) {
            eds[0] = (RtxEdit){ .off = wlo, .n = an, .ins = cc_slice_empty() };
            eds[1] = (RtxEdit){ .off = whi - bn, .n = bn, .ins = cc_slice_empty() };
            return rtx_doc_apply_group(d, eds, 2, whi - an - bn, wlo);
        }
        if (rtx_doc_apply_range_blocked(d, wlo, whi)) return cc_ok();
        eds[0] = (RtxEdit){ .off = wlo, .n = 0, .ins = cc_slice_from_buffer((void *)a, an) };
        eds[1] = (RtxEdit){ .off = whi, .n = 0, .ins = cc_slice_from_buffer((void *)b, bn) };
        return rtx_doc_apply_group(d, eds, 2, whi + an, wlo + an);
    }
    if (an + bn > sizeof pair) return cc_ok();
    memcpy(pair, a, an);
    memcpy(pair + an, b, bn);
    eds[0] = (RtxEdit){ .off = c, .n = 0, .ins = cc_slice_from_buffer(pair, an + bn) };
    return rtx_doc_apply_group(d, eds, 1, c + an, c + an);
}

typedef struct {
    size_t s, e;       /* trimmed text of one line in the selection */
    const RtxRun *run; /* covering mark, if any */
    int in, out;       /* delimiters inside / just outside [s, e) */
} RtxApplySeg;

static void !>(CCError) rtx_doc_apply_pair(RtxDoc *d, const RtxTmRule *rule) {
    const char *a, *b;
    size_t an, bn, lo, hi, n, got, i, nseg, k, ne, ls, bol0, keep;
    char *buf;
    CCArena frame = {0};
    RtxApplySeg *segs;
    RtxEdit *eds;
    int all;
    @errhandler(CCError e) {
        if (frame.base) frame.destroy();
        return cc_err(e);
    }
    if (!d || !rtx_apply_delims(rule, &a, &an, &b, &bn)) return cc_ok();
    lo = RtxDoc_sel_lo(d);
    hi = RtxDoc_sel_hi(d);
    if (lo == hi || d->sel_box) return rtx_doc_apply_pair_caret(d, rule, a, an, b, bn);
    n = hi - lo;
    if (n > (size_t)RTX_HL_WIN_MAX) return cc_ok();
    /* The first line's prefix may sit before the selection: read from BOL. */
    bol0 = rtx_doc_bol_byte(d, lo);
    if (lo - bol0 > 4096) bol0 = lo;
    keep = lo - bol0;
    frame = cc_arena_heap(keep + n + 64 + (n / 2 + 2) * (sizeof(RtxApplySeg) + 2 * sizeof(RtxEdit)));
    if (!frame.base) return cc_err(CC_ERR_OUT_OF_MEMORY, "apply pair");
    buf = (char *)cc_arena_alloc(frame, keep + n + 1, 1);
    segs = (RtxApplySeg *)cc_arena_alloc(frame, (n / 2 + 2) * sizeof(RtxApplySeg), 8);
    eds = (RtxEdit *)cc_arena_alloc(frame, (n / 2 + 2) * 2 * sizeof(RtxEdit), 8);
    if (!buf || !segs || !eds) {
        frame.destroy();
        return cc_err(CC_ERR_OUT_OF_MEMORY, "apply pair");
    }
    got = rtx_doc_peek(d, bol0, buf, keep + n);
    if (got != keep + n) {
        frame.destroy();
        return cc_err(CC_ERR_INTERNAL, "apply pair read");
    }
    /* One segment per line: after the line's quote / list / heading
     * prefix, inside the selection, whitespace trimmed. */
    nseg = 0;
    ls = 0;
    while (ls < keep + n) {
        size_t le = ls, s, e;
        RtxMdLine L;
        while (le < keep + n && buf[le] != '\n') le++;
        rtx_md_line_parse(buf + ls, le - ls, &L);
        s = ls + L.clo;
        if (s < keep) s = keep;
        if (s > le) s = le;
        e = le;
        while (s < e && (buf[s] == ' ' || buf[s] == '\t')) s++;
        while (e > s && (buf[e - 1] == ' ' || buf[e - 1] == '\t' || buf[e - 1] == '\r')) e--;
        if (e > s && !L.fence) {
            RtxApplySeg *g = &segs[nseg++];
            g->s = bol0 + s;
            g->e = bol0 + e;
            g->run = rtx_doc_pair_cover(d, g->s, rule, 0);
            if (!g->run) g->run = rtx_doc_pair_cover(d, g->e - 1, rule, 0);
            g->in = rtx_apply_inside(a, an, b, bn, buf + s, e - s);
            g->out = !g->in && rtx_apply_outside(d, a, an, b, bn, g->s, g->e);
        }
        ls = le + 1;
    }
    if (nseg == 0) {
        frame.destroy();
        return cc_ok();
    }
    for (i = 0; i < nseg; i++) {
        if (rtx_doc_apply_range_blocked(d, segs[i].s, segs[i].e)) {
            frame.destroy();
            return cc_ok();
        }
    }
    /* One line inside a mark planted by the lexer: its whole run. */
    if (nseg == 1 && segs[0].run && !segs[0].in && !segs[0].out) {
        const RtxRun *r = segs[0].run;
        frame.destroy();
        return rtx_doc_apply_unwrap_pair(d, r);
    }
    all = 1;
    for (i = 0; i < nseg; i++) {
        if (!segs[i].in && !segs[i].out && !segs[i].run) all = 0;
    }
    ne = 0;
    for (i = 0; i < nseg; i++) {
        RtxApplySeg *g = &segs[i];
        if (all) {
            if (g->in) {
                eds[ne++] = (RtxEdit){ .off = g->s, .n = an, .ins = cc_slice_empty() };
                eds[ne++] = (RtxEdit){ .off = g->e - bn, .n = bn, .ins = cc_slice_empty() };
            } else if (g->out) {
                eds[ne++] = (RtxEdit){ .off = g->s - an, .n = an, .ins = cc_slice_empty() };
                eds[ne++] = (RtxEdit){ .off = g->e, .n = bn, .ins = cc_slice_empty() };
            } else if (g->run && g->run->hint_a && g->run->hint_b &&
                       (ne == 0 || eds[ne - 1].off + eds[ne - 1].n <= g->run->start)) {
                size_t rs = g->run->start, re = g->run->start + g->run->len;
                eds[ne++] = (RtxEdit){ .off = rs, .n = g->run->hint_a, .ins = cc_slice_empty() };
                eds[ne++] = (RtxEdit){ .off = re - g->run->hint_b, .n = g->run->hint_b,
                                       .ins = cc_slice_empty() };
            }
        } else if (!g->in && !g->out && !g->run) {
            eds[ne++] = (RtxEdit){ .off = g->s, .n = 0,
                                   .ins = cc_slice_from_buffer((void *)a, an) };
            eds[ne++] = (RtxEdit){ .off = g->e, .n = 0,
                                   .ins = cc_slice_from_buffer((void *)b, bn) };
        }
    }
    if (ne == 0) {
        frame.destroy();
        return cc_ok();
    }
    /* Selection after: the marked text, first segment to last. */
    k = rtx_edits_map(eds, ne, segs[0].s, !all);
    i = rtx_edits_map(eds, ne, segs[nseg - 1].e, 0);
    if (all && segs[nseg - 1].in) i = rtx_edits_map(eds, ne, segs[nseg - 1].e - bn, 0);
    rtx_doc_apply_group(d, eds, ne, i, k) !>;
    frame.destroy();
    return cc_ok();
}

/* `[sel]()` — dest empty. Plant is two runs (label + dest). Caret lands
 * in dest so the URL can be typed. */
static void !>(CCError) rtx_doc_apply_wrap_path(RtxDoc *d) {
    size_t lo, hi, n, got, need;
    char *buf;
    CCArena frame = {0};
    @errhandler(CCError e) {
        if (frame.base) frame.destroy();
        return cc_err(e);
    }
    if (!d) return cc_ok();
    lo = RtxDoc_sel_lo(d);
    hi = RtxDoc_sel_hi(d);
    if (lo == hi) rtx_doc_word_span(d, d->caret, &lo, &hi);
    /* The label is the text, not the whitespace around it. */
    while (lo < hi) {
        char c;
        if (rtx_doc_peek(d, lo, &c, 1) != 1 || (c != ' ' && c != '\t')) break;
        lo++;
    }
    while (hi > lo) {
        char c;
        if (rtx_doc_peek(d, hi - 1, &c, 1) != 1 ||
            (c != ' ' && c != '\t' && c != '\n' && c != '\r'))
            break;
        hi--;
    }
    if (rtx_doc_apply_range_blocked(d, lo, hi)) return cc_ok();
    n = hi > lo ? hi - lo : 0;
    need = n + 4; /* [ + sel + ]() */
    if (need > (size_t)RTX_HL_WIN_MAX) return cc_ok();
    frame = cc_arena_heap(need + 8);
    if (!frame.base) return cc_err(CC_ERR_OUT_OF_MEMORY, "path wrap");
    buf = (char *)cc_arena_alloc(frame, need ? need : 1, 1);
    if (!buf) {
        frame.destroy();
        return cc_err(CC_ERR_OUT_OF_MEMORY, "path wrap");
    }
    buf[0] = '[';
    if (n) {
        got = d->read_at(lo, cc_slice_from_buffer(buf + 1, n)) !>;
        if (got != n) {
            frame.destroy();
            return cc_err(CC_ERR_INTERNAL, "path wrap read");
        }
    }
    buf[1 + n] = ']';
    buf[2 + n] = '(';
    buf[3 + n] = ')';
    rtx_doc_policy_replace(d, lo, n, cc_slice_from_buffer(buf, need)) !>;
    frame.destroy();
    rtx_doc_apply_caret(d, lo + 1 + n + 2, lo + 1 + n + 2);
    return cc_ok();
}

static int rtx_doc_path_hit(const RtxDoc *d, size_t off) {
    return RtxDoc_path_at(d, off, NULL, NULL, NULL, NULL);
}

static const RtxRun *rtx_doc_toggle_run(const RtxDoc *d, const RtxTmRule *want) {
    const RtxRun *r, *pre;
    const RtxTmRt *rt;
    size_t i, box;
    r = rtx_doc_pair_apply_sel(d, want);
    if (r) return r;
    if (!d) return NULL;
    pre = rtx_doc_line_prefix(d, d->caret);
    if (!pre) return NULL;
    box = pre->start + pre->hint_a;
    rt = rtx_doc_tm(d);
    i = rtx_doc_run_first(d, box);
    for (; i < d->runs.len && d->runs.data[i].start <= box; i++) {
        r = &d->runs.data[i];
        if (r->start != box) continue;
        if (rtx_run_apply_match(rt, want, r)) return r;
    }
    return NULL;
}

static void !>(CCError) rtx_doc_apply_toggle(RtxDoc *d, const RtxTmRule *rule) {
    const RtxRun *r;
    const char *off, *on;
    size_t offn, onn, n, got;
    char cur[16];
    int is_on;
    @errhandler(CCError e) {
        return cc_err(e);
    }
    if (!d || !rtx_apply_toggle_parts(rule ? rule->sc_insert : NULL, &off, &offn,
                                      &on, &onn))
        return cc_ok();
    r = rtx_doc_toggle_run(d, rule);
    if (!r) return cc_ok();
    n = r->len;
    if (n != offn || n != onn || n >= sizeof(cur)) return cc_ok();
    got = d->read_at(r->start, cc_slice_from_buffer(cur, n)) !>;
    if (got != n) return cc_err(CC_ERR_INTERNAL, "toggle read");
    is_on = memcmp(cur, on, n) == 0;
    if (!is_on && n >= 2 && (cur[1] == 'x' || cur[1] == 'X')) is_on = 1;
    rtx_doc_policy_replace(d, r->start, n,
                           cc_slice_from_buffer((void *)(is_on ? off : on), n)) !>;
    rtx_doc_apply_caret(d, r->start, r->start);
    return cc_ok();
}

void !>(CCError) RtxDoc_apply_named(RtxDoc *d, char[:0] name) {
    const RtxTmRule *rule;
    const char *cur = NULL;
    size_t lo, hi;
    int kind, lvl;
    if (!d) return cc_err(CC_ERR_INVALID_ARG, "apply named");
    rule = rtx_tm_apply_rule(rtx_doc_tm(d), name.ptr);
    kind = rtx_tm_apply_kind(rule);
    if (!kind) return cc_ok();
    if (kind == RTX_APPLY_PREFIX)
        {
            lvl = RtxDoc_apply_at(d, d->caret, &lo, &hi, &cur);
            if (lvl && rtx_apply_name_eq(cur, rule->sc_apply))
                return d->apply_cycle(d->caret);
            return d->apply_set(d->caret, cc_slice_cstr(rule->sc_apply), 1);
        }
    if (kind == RTX_APPLY_PATH) {
        lo = RtxDoc_sel_lo(d);
        hi = RtxDoc_sel_hi(d);
        if (rtx_doc_path_hit(d, d->caret))
            return d->path_unwrap(d->caret);
        if (hi > lo && rtx_doc_path_hit(d, lo))
            return d->path_unwrap(lo);
        if (hi > lo && rtx_doc_path_hit(d, hi - 1))
            return d->path_unwrap(hi - 1);
        return rtx_doc_apply_wrap_path(d);
    }
    if (kind == RTX_APPLY_TOGGLE) return rtx_doc_apply_toggle(d, rule);
    return rtx_doc_apply_pair(d, rule);
}

/* Hint at `off` → that run's `cctext.apply`, innermost wins. Same coverage
 * as hint_at; style-only / content bytes return NULL. */
const char *RtxDoc_mark_apply(const RtxDoc *d, size_t off) {
    const RtxTmRt *rt;
    const char *name = NULL;
    size_t i;
    if (!d || d->runs.len == 0) return NULL;
    rt = rtx_doc_tm(d);
    if (!rt) return NULL;
    i = rtx_doc_run_first(d, off);
    for (; i < d->runs.len && d->runs.data[i].start <= off;
         i = rtx_doc_run_step(d, i, off)) {
        const RtxRun *r = &d->runs.data[i];
        const RtxTmRule *rule;
        size_t end;
        if (off >= (end = r->start + r->len) || r->hint_a == 0) continue;
        if (off >= r->start + r->hint_a &&
            !(r->hint_b && off >= end - r->hint_b))
            continue;
        rule = rtx_doc_run_rule(d, r);
        if (!rule || !rtx_tm_apply_kind(rule) || !rule->sc_apply ||
            !rule->sc_apply[0])
            continue;
        name = rule->sc_apply;
    }
    return name;
}

int RtxDoc_md_block_at(const RtxDoc *d, size_t off) {
    size_t i;
    int role = 0;
    if (!d || d->runs.len == 0) return 0;
    i = rtx_doc_run_first(d, off);
    for (; i < d->runs.len && d->runs.data[i].start <= off;
         i = rtx_doc_run_step(d, i, off)) {
        const RtxRun *r = &d->runs.data[i];
        const RtxTmRule *rule;
        if (off >= r->start + r->len || r->planter != (unsigned char)RTX_RUN_TM) continue;
        rule = rtx_doc_run_rule(d, r);
        if (rule && rule->block) role = rule->block;
    }
    return role;
}

/* ---- Block context for editing (md_edit in workspace.ccs) ---- */

static int rtx_mdb_role_code(int role) {
    return role == RTX_MDB_ROLE_FENCE || role == RTX_MDB_ROLE_CODE ||
           role == RTX_MDB_ROLE_HTML || role == RTX_MDB_ROLE_MATH ||
           role == RTX_MDB_ROLE_FRONT;
}

/* The range around *klo whose runs are the block pass's current answer:
 * the whole document lexed, the live window lex, or a section lexed
 * whole. 0 when there is none (or the grammar has no block pass). */
static int rtx_doc_md_known(const RtxDoc *d, size_t *klo, size_t *khi) {
    const RtxTmRt *rt;
    if (!d || !d->path.ptr) return 0;
    rt = rtx_tm_for_path(d->path.ptr);
    if (!rt || !rt->blocks) return 0;
    if (d->hl_full) {
        *klo = 0;
        *khi = d->len();
        return 1;
    }
    if (d->hl_cov.live && d->hl_cov.hi > d->hl_cov.lo && d->hl_cov.lo <= *klo &&
        *klo <= d->hl_cov.hi) {
        *klo = d->hl_cov.lo;
        *khi = d->hl_cov.hi;
        return 1;
    }
    {
        /* A section lexed whole (the window's own sections of a large
         * document are): its runs stand. */
        size_t s, n = d->len(), at = *klo;
        for (s = 0; s < d->secs.len; s++) {
            size_t a = d->secs.data[s].start;
            size_t b = s + 1 < d->secs.len ? d->secs.data[s + 1].start : n;
            if (a > at || at > b) continue;
            if (!d->secs.data[s].hl_done || !rtx_sec_lexed(d->secs.data[s].kind)) continue;
            *klo = a;
            *khi = b;
            return 1;
        }
    }
    return 0;
}

int RtxDoc_md_leaf_at(const RtxDoc *d, size_t off) {
    size_t klo = off, khi = off, i, n;
    int role = 0;
    if (!rtx_doc_md_known(d, &klo, &khi) || off < klo || off > khi) return -1;
    if (d->runs.len == 0) return 0;
    n = d->len();
    for (int pass = 0; pass < 2; pass++) {
        /* At the end of the document, an unclosed leaf runs to it. */
        size_t at = pass ? off - 1 : off;
        if (pass && (off != n || off == 0)) break;
        i = rtx_doc_run_first(d, at);
        for (; i < d->runs.len && d->runs.data[i].start <= at;
             i = rtx_doc_run_step(d, i, at)) {
            const RtxRun *r = &d->runs.data[i];
            const RtxTmRule *rule;
            if (at >= r->start + r->len || r->planter != (unsigned char)RTX_RUN_TM) continue;
            if (pass && r->hint_b) continue;
            rule = rtx_doc_run_rule(d, r);
            if (rule && rtx_mdb_role_code(rule->block)) role = rule->block;
        }
        if (role) break;
    }
    return role;
}

long RtxDoc_md_code_leaves(const RtxDoc *d, size_t lo, size_t hi, size_t *los,
                           size_t *his, size_t cap, size_t *klo, size_t *khi) {
    size_t i, k = 0;
    if (!d || !los || !his || !klo || !khi) return -1;
    *klo = *khi = lo;
    if (!rtx_doc_md_known(d, klo, khi)) return -1;
    if (lo < *klo) lo = *klo;
    if (hi > *khi) hi = *khi;
    if (hi <= lo || d->runs.len == 0) return 0;
    for (i = rtx_doc_run_first(d, lo); i < d->runs.len && d->runs.data[i].start < hi; i++) {
        const RtxRun *r = &d->runs.data[i];
        const RtxTmRule *rule;
        size_t a, b;
        if (r->planter != (unsigned char)RTX_RUN_TM || r->start + r->len <= lo) continue;
        rule = rtx_doc_run_rule(d, r);
        if (!rule || !rtx_mdb_role_code(rule->block)) continue;
        a = r->start > lo ? r->start : lo;
        b = r->start + r->len < hi ? r->start + r->len : hi;
        /* An unclosed leaf at the document's end holds its end too. */
        if (!r->hint_b && r->start + r->len == d->len()) b = b + 1;
        if (k && a <= his[k - 1]) {
            if (b > his[k - 1]) his[k - 1] = b;
            continue;
        }
        if (k == cap) break;
        los[k] = a;
        his[k] = b;
        k++;
    }
    return (long)k;
}

int RtxDoc_md_role_covers(const RtxDoc *d, size_t off, int role) {
    size_t i;
    if (!d || d->runs.len == 0) return 0;
    i = rtx_doc_run_first(d, off);
    for (; i < d->runs.len && d->runs.data[i].start <= off;
         i = rtx_doc_run_step(d, i, off)) {
        const RtxRun *r = &d->runs.data[i];
        const RtxTmRule *rule;
        if (off >= r->start + r->len || r->planter != (unsigned char)RTX_RUN_TM) continue;
        rule = rtx_doc_run_rule(d, r);
        if (rule && rule->block == role) return 1;
    }
    return 0;
}

int RtxDoc_md_code_span_at(const RtxDoc *d, size_t off) {
    size_t i;
    if (!d || d->runs.len == 0 || off == 0) return 0;
    i = rtx_doc_run_first(d, off - 1);
    for (; i < d->runs.len && d->runs.data[i].start < off;
         i = rtx_doc_run_step(d, i, off - 1)) {
        const RtxRun *r = &d->runs.data[i];
        const RtxTmRule *rule;
        size_t end = r->start + r->len;
        if (r->planter != (unsigned char)RTX_RUN_TM || !r->hint_a || !r->hint_b) continue;
        if (off < r->start + r->hint_a || off > end - r->hint_b) continue;
        rule = rtx_doc_run_rule(d, r);
        if (rule && !rule->block && (rule->exact || rule->flank == RTX_FLANK_MATH)) return 1;
    }
    return 0;
}

size_t RtxDoc_outline(const RtxDoc *d, size_t lo, size_t hi, RtxOutlineEnt *out,
                      size_t cap) {
    size_t i, k = 0;
    if (!d || !out || !cap || d->runs.len == 0 || hi <= lo) return 0;
    i = rtx_doc_run_last_le(d, lo);
    while (i > 0 && d->runs.data[i].start >= lo) i--;
    for (; i < d->runs.len && d->runs.data[i].start < hi && k < cap; i++) {
        const RtxRun *r = &d->runs.data[i];
        int lvl;
        if (r->start < lo || !r->len) continue;
        lvl = rtx_nav_heading(r, (void *)&d->tree);
        if (lvl < 0) continue;
        out[k].off = r->start;
        out[k].level = lvl;
        out[k].title_lo = r->start + r->hint_a;
        out[k].title_hi = r->start + r->len;
        /* A trailing `##` prefix on the same line is not title. */
        {
            size_t j;
            for (j = i + 1; j < d->runs.len && d->runs.data[j].start < out[k].title_hi; j++) {
                const RtxRun *t = &d->runs.data[j];
                if (rtx_run_arity(t) == RTX_ARITY_PREFIX && t->hint_a &&
                    rtx_scope_is_heading(t->style.scope) && t->start > r->start) {
                    out[k].title_hi = t->start;
                    break;
                }
            }
        }
        while (out[k].title_hi > out[k].title_lo) {
            char c = 0;
            if (rtx_tree_read((void *)&d->tree, out[k].title_hi - 1, &c, 1) != 1) break;
            if (c != ' ' && c != '\t' && c != '\r') break;
            out[k].title_hi--;
        }
        k++;
    }
    return k;
}

/* Label bytes [llo, lhi) → its definition's destination (doc offsets,
 * `<>` stripped). 0 when the label has no definition in the map. */
static int rtx_doc_ref_target(const RtxDoc *d, size_t llo, size_t lhi, size_t *lo,
                              size_t *hi) {
    char lab[1000];
    char line[4096];
    const RtxMdRef *r;
    size_t n = lhi - llo, a, b, ln;
    if (lhi <= llo || n >= sizeof lab) return 0;
    if (rtx_tree_read((void *)&d->tree, llo, lab, n) != n) return 0;
    r = rtx_mdref_get(&d->mdref, rtx_mdref_hash(lab, n));
    if (!r) return 0;
    ln = r->llen < sizeof line ? r->llen : sizeof line;
    if (rtx_tree_read((void *)&d->tree, r->line, line, ln) != ln) return 0;
    if (!rtx_mdref_dest(r, line, ln, &a, &b)) return 0;
    if (lo) *lo = r->line + a;
    if (hi) *hi = r->line + b;
    return 1;
}

int RtxDoc_ref_target(const RtxDoc *d, size_t llo, size_t lhi, size_t *lo, size_t *hi) {
    return d ? rtx_doc_ref_target(d, llo, lhi, lo, hi) : 0;
}

int RtxDoc_link_target(const RtxDoc *d, size_t off, size_t *lo, size_t *hi) {
    size_t plo, phi, klo, khi, dlo, dhi, ahi, blo, tlo, thi;
    if (!d) return 0;
    if (RtxDoc_path_at(d, off, &plo, &phi, &klo, &khi)) {
        if (khi < phi && RtxDoc_dest_at(d, khi, &dlo, &dhi)) {
            /* dest after label */
        } else if (plo < klo && RtxDoc_dest_at(d, plo, &dlo, &dhi)) {
            /* dest before label */
        } else {
            return 0;
        }
        tlo = RtxDoc_hint_at(d, dlo, NULL, &ahi) ? ahi : dlo;
        thi = (dhi && RtxDoc_hint_at(d, dhi - 1, &blo, NULL)) ? blo : dhi;
        {
            /* A reference: `[x]` (dest is the lone `]`), `[x][]`, `[x][y]`
             * — the target is its definition's destination. */
            char h2[2] = {0, 0};
            size_t got = dhi - dlo >= 2 ? 2 : dhi - dlo;
            if (got && rtx_tree_read((void *)&d->tree, dlo, h2, got) == got &&
                h2[0] == ']' && (got == 1 || h2[1] == '[')) {
                if (got == 1 || thi <= tlo) return rtx_doc_ref_target(d, klo, khi, lo, hi);
                return rtx_doc_ref_target(d, tlo, thi, lo, hi);
            }
        }
        if (thi <= tlo) return 0;
        if (lo) *lo = tlo;
        if (hi) *hi = thi;
        return 1;
    }
    if (!RtxDoc_mark_at(d, off, &dlo, &dhi)) return 0;
    if (!rtx_scope_is_underline(RtxDoc_style_at(d, off).scope)) return 0;
    tlo = RtxDoc_hint_at(d, dlo, NULL, &ahi) ? ahi : dlo;
    thi = (dhi && RtxDoc_hint_at(d, dhi - 1, &blo, NULL)) ? blo : dhi;
    if (thi <= tlo) return 0;
    if (lo) *lo = tlo;
    if (hi) *hi = thi;
    return 1;
}

/* Any run with hints in the doc. Layout gates every Rich check on this per
 * fill, so a plain file pays one compare (runs.len == 0). */
int RtxDoc_has_marks(const RtxDoc *d) {
    size_t i;
    if (!d) return 0;
    if (d->derived && d->derived->any(d->derived->ctx, d)) return 1;
    if (rtx_doc_run_top_live(d)) return d->runs_marks;
    for (i = 0; i < d->runs.len; i++) {
        if (d->runs.data[i].hint_a) return 1;
    }
    return 0;
}

/* Derived values (docs/workbook.md): forwarded to the owner; one compare
 * on a document that is not a workbook. */
int RtxDoc_derived_at(const RtxDoc *d, size_t off, int incl, size_t *lo,
                      size_t *hi, char *g, size_t cap, size_t *gn) {
    if (gn) *gn = 0;
    if (!d || !d->derived) return 0;
    return d->derived->at(d->derived->ctx, d, off, incl, lo, hi, g, cap, gn);
}

size_t RtxDoc_derived_changed(const RtxDoc *d, size_t *lo, size_t *hi,
                              size_t cap) {
    if (!d || !d->derived) return 0;
    return d->derived->changed(d->derived->ctx, d, lo, hi, cap);
}

/* A section the markup lens may read: a MARKUP grammar, or grammarless
 * PROSE (untitled, `.txt`, `=== prose ===`). An unresolved window reads
 * as the path kind. Only a code grammar's section is not. */
static int rtx_sec_lens(RtxSectionKind k, RtxSectionKind path) {
    if (k == RTX_SEC_UNKNOWN) k = path;
    return k != RTX_SEC_CODE;
}

int RtxDoc_markup_near(const RtxDoc *d, size_t lo, size_t hi) {
    RtxSectionKind path;
    size_t i, n;
    if (!d) return 0;
    path = rtx_doc_path_kind(d);
    if (d->secs.len == 0 || lo < d->secs.data[0].start)
        return rtx_sec_lens(RTX_SEC_UNKNOWN, path);
    n = d->len();
    for (i = 0; i < d->secs.len; i++) {
        size_t a = d->secs.data[i].start;
        size_t b = i + 1 < d->secs.len ? d->secs.data[i + 1].start : n;
        if (a > hi) break;
        if (b <= lo && b < n) continue;
        if (rtx_sec_lens(d->secs.data[i].kind, path)) return 1;
    }
    return 0;
}

/* Next hint start in (off, hi]: a hinted run's begin (start) or end hint
 * (start + len - hint_b) strictly after `off`, else hi. Row measure walks
 * this between style edges so hidden hints split a segment. */
size_t RtxDoc_hint_next(const RtxDoc *d, size_t off, size_t hi) {
    size_t i, next = hi;
    if (!d || d->runs.len == 0 || off >= hi) return hi;
    i = rtx_doc_run_first(d, off);
    for (; i < d->runs.len && d->runs.data[i].start < next;
         i = rtx_doc_run_step(d, i, off)) {
        const RtxRun *r = &d->runs.data[i];
        size_t end = r->start + r->len;
        if (r->hint_a == 0) continue;
        if (r->start > off && r->start < next) next = r->start;
        if (r->hint_b && end - r->hint_b > off && end - r->hint_b < next)
            next = end - r->hint_b;
    }
    return next;
}

#define RTX_JOIN_MAX 64
typedef struct {
    size_t lo;
    size_t hi;
} RtxJoinRange;

static void rtx_join_add(RtxJoinRange *xs, int *nx, size_t lo, size_t hi) {
    int k;
    if (hi <= lo || *nx >= RTX_JOIN_MAX) return;
    for (k = 0; k < *nx; k++) {
        if (xs[k].lo == lo && xs[k].hi == hi) return;
    }
    xs[*nx].lo = lo;
    xs[*nx].hi = hi;
    (*nx)++;
}

void !>(CCError) RtxDoc_replace_join(RtxDoc *d, size_t lo, size_t hi, char[:] bytes) {
    /* Pair-arity policy above the one legal write — see mark_arity.md.
     * One `replace` when only [lo, hi) moves; the partner hints it pulls
     * in make one edit group (one undo step). Rich panes reach here
     * through rtx_buf_pair_replace. */
    RtxJoinRange xs[RTX_JOIN_MAX];
    RtxJoinRange ms[RTX_JOIN_MAX + 1];
    RtxEdit eds[RTX_JOIN_MAX + 2];
    int nx = 0, nm = 0, ne = 0, k, extra = 0, put = 0;
    size_t ulo, uhi, i, len, below = 0, caret_new;
    if (!d) return cc_err(CC_ERR_INVALID_ARG, "replace join");
    len = d->len();
    if (hi > len) hi = len;
    if (lo > hi) lo = hi;
    ulo = lo;
    uhi = hi;
    if (d->runs.len && lo < hi) {
        i = rtx_doc_run_first(d, lo);
        for (; i < d->runs.len && d->runs.data[i].start < hi; i++) {
            const RtxRun *r = &d->runs.data[i];
            size_t end = r->start + r->len;
            size_t alo, ahi, blo, bhi;
            int a_in, b_in;
            if (r->hint_a == 0) continue;
            /* Path / prefix are not pair-join. Dest hints must not pull
             * the label, and the label opener must not pull dest. */
            if (rtx_run_arity(r) != RTX_ARITY_PAIR) continue;
            alo = r->start;
            ahi = alo + r->hint_a;
            blo = r->hint_b ? end - r->hint_b : end;
            bhi = end;
            a_in = alo < hi && ahi > lo;
            b_in = r->hint_b && blo < hi && bhi > lo;
            if (!a_in && !b_in) continue;
            rtx_join_add(xs, &nx, alo, ahi);
            if (r->hint_b) rtx_join_add(xs, &nx, blo, bhi);
        }
    }
    for (k = 0; k < nx; k++) {
        if (xs[k].lo < lo || xs[k].hi > hi) extra = 1;
        if (xs[k].lo < ulo) ulo = xs[k].lo;
        if (xs[k].hi > uhi) uhi = xs[k].hi;
    }
    if (!extra || uhi - ulo > (size_t)RTX_HL_WIN_MAX) {
        return rtx_doc_policy_replace(d, lo, hi - lo, bytes);
    }
    /* Removed bytes: [lo, hi) plus every pulled hint, merged in order. */
    for (k = 0; k < nx; k++) ms[nm++] = xs[k];
    if (hi > lo) {
        ms[nm].lo = lo;
        ms[nm].hi = hi;
        nm++;
    }
    for (k = 1; k < nm; k++) {
        RtxJoinRange v = ms[k];
        int j = k;
        while (j > 0 && ms[j - 1].lo > v.lo) {
            ms[j] = ms[j - 1];
            j--;
        }
        ms[j] = v;
    }
    for (k = 0; k < nm; k++) {
        if (ne && ms[k].lo <= eds[ne - 1].off + eds[ne - 1].n) {
            size_t e = eds[ne - 1].off + eds[ne - 1].n;
            if (ms[k].hi > e) eds[ne - 1].n = ms[k].hi - eds[ne - 1].off;
            continue;
        }
        eds[ne].off = ms[k].lo;
        eds[ne].n = ms[k].hi - ms[k].lo;
        eds[ne].ins = cc_slice_empty();
        ne++;
    }
    /* `bytes` land at lo: on the removed run that holds or touches it,
     * else as an insert of its own. */
    for (k = 0; k < ne; k++) {
        if (eds[k].off <= lo && lo <= eds[k].off + eds[k].n) {
            eds[k].ins = bytes;
            below += lo - eds[k].off;
            put = 1;
            break;
        }
        if (eds[k].off > lo) break;
        below += eds[k].n;
    }
    if (!put) {
        int j = ne;
        while (j > k) {
            eds[j] = eds[j - 1];
            j--;
        }
        eds[k].off = lo;
        eds[k].n = 0;
        eds[k].ins = bytes;
        ne++;
    }
    caret_new = lo - below + bytes.len;
    RtxDoc_replace_batch(d, eds, (size_t)ne) !>(e) { return cc_err(e); };
    d->caret = caret_new;
    d->sel_anchor = caret_new;
    if (!d->hist.applying && d->hist.head > 0) {
        RtxHistRec *last = &d->hist.recs[d->hist.head - 1];
        last->caret_after = d->caret;
        last->sel_after = d->sel_anchor;
    }
    return cc_ok();
}


/* --- edit / highlight / tm (this TU) --- */

static int rtx_tm_starts(const char *buf, size_t i, size_t n, const char *lit,
                         size_t ln) {
    char[:] at;
    char[:] want;
    if (!lit || ln == 0 || i + ln > n) return 0;
    /* LIT_LINE keeps a pointing at ">.*" / "//.*" and alen is the prefix. */
    at = cc_slice_from_buffer((void *)(buf + i), ln);
    want = cc_slice_from_buffer((void *)lit, ln);
    return at.eq(want);
}

static int rtx_tm_op_span(RtxTmOp op) {
    return op == RTX_TM_LIT_SPAN || op == RTX_TM_RE_SPAN;
}

/* `*` is a metachar but also italic, block comments, and `**`. Those stay
 * LIT_SPAN; `\\` / classes / groups are enough to spot a real regex
 * begin/end (`<script\\b[^>]*>`). */
static int rtx_tm_pat_re_meta(const char *s) {
    size_t i;
    if (!s) return 0;
    for (i = 0; s[i]; i++) {
        char c = s[i];
        if (c == '\\' || c == '+' || c == '?' || c == '[' || c == ']' ||
            c == '(' || c == ')' || c == '|' || c == '.' || c == '{' ||
            c == '}' || c == '^' || c == '$') {
            return 1;
        }
    }
    return 0;
}

static int rtx_tm_is_re_span(const char *begin, const char *end) {
    return rtx_tm_pat_re_meta(begin) || rtx_tm_pat_re_meta(end);
}

static int rtx_tm_lower_rule(const char *name, const char *match,
                             const char *begin, const char *end,
                             const char *incl, RtxTmRule *out) {
    RtxTmRule z = {0};
    if (!out) return 0;
    z.first = -1;
    *out = z;
    if (incl && incl[0] && !(begin && begin[0] && end && end[0])) {
        *out = z;
        return 1;
    }
    if (name && name[0] && !rtx_scope_put(&z.scope, name)) return 0;
    if (begin && begin[0] && end && end[0]) {
        z.op = rtx_tm_is_re_span(begin, end) ? RTX_TM_RE_SPAN : RTX_TM_LIT_SPAN;
        z.a = begin;
        z.b = end;
        z.alen = cc_slice_cstr(begin).len;
        z.blen = cc_slice_cstr(end).len;
        *out = z;
        return 1;
    }
    if (match && match[0]) {
        size_t mlen = cc_slice_cstr(match).len;
        if (mlen >= 3 && match[mlen - 1] == '*' && match[mlen - 2] == '.') {
            size_t k;
            int meta = 0;
            for (k = 0; k + 2 < mlen; k++) {
                char ch = match[k];
                if (ch == '\\' || ch == '+' || ch == '*' || ch == '?' ||
                    ch == '[' || ch == '(' || ch == '|' || ch == '.' ||
                    ch == '{') {
                    meta = 1;
                    break;
                }
            }
            if (!meta) {
                z.op = RTX_TM_LIT_LINE;
                z.a = match;
                z.alen = mlen - 2;
                *out = z;
                return 1;
            }
        }
        if (rtx_cstr_eq_lit(match, "\\b[0-9]+\\b") ||
            rtx_cstr_eq_lit(match, "[0-9]+") || rtx_cstr_eq_lit(match, "\\d+") ||
            rtx_cstr_eq_lit(match, "\\b\\d+\\b")) {
            z.op = RTX_TM_DIGITS;
            *out = z;
            return 1;
        }
        if (mlen >= 4 && match[0] == '\\' && match[1] == 'b' &&
            match[2] == '(') {
            const char *close = strstr(match, ")\\b");
            if (close && close > match + 3) {
                z.op = RTX_TM_KEYWORDS;
                z.a = match + 3;
                z.alen = (size_t)(close - (match + 3));
                *out = z;
                return 1;
            }
        }
        if (mlen == 3 && match[0] == '\\' && match[1] == '\\' &&
            match[2] == '.') {
            z.op = RTX_TM_ESC_DOT;
            z.a = match;
            z.alen = 3;
            *out = z;
            return 1;
        }
        z.op = RTX_TM_REGEX;
        z.a = match;
        z.alen = mlen;
        *out = z;
        return 1;
    }
    return 1;
}

static int rtx_tm_word_in_list(const char *word, size_t n, const char *list,
                               size_t list_n) {
    size_t i = 0;
    if (!word || !list || n == 0) return 0;
    while (i < list_n) {
        size_t j = i;
        while (j < list_n && list[j] != '|') j++;
        if (j - i == n) {
            char[:] word_slice = cc_slice_from_buffer((void *)(list + i), j - i);
            char[:] key = cc_slice_from_buffer((void *)word, n);
            if (word_slice.eq(key)) return 1;
        }
        i = j < list_n ? j + 1 : j;
    }
    return 0;
}

static unsigned char rtx_tm_hint(size_t n) {
    return n > 255 ? (unsigned char)255 : (unsigned char)n;
}

/* Rule's effective style bits, packed RTX_SBIT_*. */
static unsigned char rtx_tm_rule_bits(const RtxTmRule *rule) {
    unsigned char bits = 0;
    if (rule->sc_bold) bits |= (unsigned char)RTX_SBIT_BOLD;
    if (rule->sc_italic) bits |= (unsigned char)RTX_SBIT_ITALIC;
    if (rule->sc_mono) bits |= (unsigned char)RTX_SBIT_MONO;
    if (rule->sc_strike) bits |= (unsigned char)RTX_SBIT_STRIKE;
    if (rule->sc_hl) bits |= (unsigned char)RTX_SBIT_HL;
    return bits;
}

static size_t rtx_tm_rule_tag(const RtxTmRt *rt, const RtxTmRule *rule);

/* Hints are the markup lens: a host MARKUP grammar's rules, or a rule
 * that sets a topology key. Never a guest (INJECT) run, never a CODE
 * grammar's paint span — a `.c` string or comment has no marks. */
static int rtx_tm_hints(const RtxTmRt *rt, const RtxTmRule *rule,
                        unsigned char planter) {
    if (!rt || !rule || planter != (unsigned char)RTX_RUN_TM) return 0;
    return rt->markup || rule->sc_mark;
}

/* TM run: scope plus the rule's style bits, with span matched-byte
 * counts. hint_b = 0 for an unclosed span (window end reached). Regex /
 * line / keyword runs pass 0, 0. A start clipped to `emit_from` drops
 * `alen` (its opener is not in the run). `rule` is rtx_tm_rule_tag
 * (RTX_RUN_NO_RULE for captures). */
static int rtx_tm_add_span(RtxDoc *d, size_t start, size_t end, size_t emit_from,
                           RtxScope scope, unsigned char bits, size_t alen,
                           size_t blen, unsigned char planter, unsigned char mark,
                           unsigned short rule) {
    RtxRun r = {0};
    if (!d || end <= start || scope == RTX_SCOPE_NONE) return 1;
    if (end <= emit_from) return 1;
    if (start < emit_from) {
        start = emit_from; /* the opener is behind the emit edge */
        alen = 0;
    }
    if (end <= start) return 1;
    if (alen > end - start) alen = end - start;
    if (blen > end - start - alen) blen = end - start - alen;
    r.start = start;
    r.len = end - start;
    r.style.scope = scope;
    r.style.bold = (bits & RTX_SBIT_BOLD) != 0;
    r.style.italic = (bits & RTX_SBIT_ITALIC) != 0;
    r.style.mono = (bits & RTX_SBIT_MONO) != 0;
    r.style.strike = (bits & RTX_SBIT_STRIKE) != 0;
    r.style.hl = (bits & RTX_SBIT_HL) != 0;
    r.planter = planter;
    r.hint_a = rtx_tm_hint(alen);
    r.hint_b = rtx_tm_hint(blen);
    r.mark = mark;
    r.rule = rule;
    return rtx_doc_push_run(d, r);
}

static int rtx_tm_path_label(const RtxTmRule *fr) {
    return fr && (fr->mark & RTX_MARK_ARITY) == RTX_ARITY_PATH &&
           !(fr->mark & RTX_MARK_DEST);
}

static int rtx_tm_prefix(const RtxTmRule *fr) {
    return fr && (fr->mark & RTX_MARK_ARITY) == RTX_ARITY_PREFIX;
}

/* Path label closer starts dest. Prefix closer is EOL — not hint_b, not
 * consumed. Any grammar with those arities. */
static size_t rtx_tm_span_end(const RtxTmRule *fr, size_t i, size_t endn,
                              size_t *blen) {
    if (rtx_tm_path_label(fr) || rtx_tm_prefix(fr)) {
        if (blen) *blen = 0;
        return i;
    }
    if (blen) *blen = endn;
    return i + endn;
}

static int rtx_tm_add(RtxDoc *d, size_t start, size_t end, size_t emit_from,
                      const RtxTmRt *rt, const RtxTmRule *rule,
                      unsigned char planter) {
    size_t ha = 0, hb = 0, w;
    if (!rtx_tm_hints(rt, rule, planter)) {
        /* paint only */
    } else if (rule->sc_wrap) {
        w = (size_t)rule->sc_wrap;
        if (end >= start + 2 * w) {
            ha = w;
            hb = w;
        }
    } else if (rtx_tm_prefix(rule) && end > start) {
        ha = end - start;
        hb = 0;
    } else if (rtx_tm_apply_kind(rule) == RTX_APPLY_TOGGLE && end > start) {
        ha = end - start;
        hb = 0;
    } else if ((rule->mark & RTX_MARK_ARITY) == RTX_ARITY_PATH && end > start &&
               (rule->op == RTX_TM_LIT_SPAN || rule->op == RTX_TM_LIT_LINE)) {
        /* Label: opener only. Dest: begin + end. Regex path stays 0,0. */
        size_t al = rule->alen, bl = 0;
        if (rule->mark & RTX_MARK_DEST) bl = rule->blen;
        if (end >= start + al + bl) {
            ha = al;
            hb = bl;
        } else if (end >= start + al) {
            ha = al;
            hb = 0;
        }
    }
    return rtx_tm_add_span(d, start, end, emit_from, rule->scope,
                           rtx_tm_rule_bits(rule), ha, hb, planter,
                           rule ? rule->mark : 0,
                           (unsigned short)rtx_tm_rule_tag(rt, rule));
}

/* Line start inside the lex buffer. `bol0` is whether buf[0] is at BOL
 * (base == 0, or the byte before the window is '\n'). */
static int rtx_tm_at_bol(const char *buf, size_t i, int bol0) {
    return i == 0 ? bol0 : buf[i - 1] == '\n';
}

static int rtx_tm_is_ws(char c) {
    return c == ' ' || c == '\t' || c == '\n' || c == '\r';
}

/* ASCII punctuation (CommonMark's for delimiter runs; bytes >= 0x80 count
 * as letters). */
static int rtx_tm_is_punct(char c) {
    unsigned char u = (unsigned char)c;
    return (u >= 0x21 && u <= 0x2f) || (u >= 0x3a && u <= 0x40) ||
           (u >= 0x5b && u <= 0x60) || (u >= 0x7b && u <= 0x7e);
}

/* The bytes around a delimiter run [i, i + len): outside the buffer or
 * the line reads as whitespace (a line end is whitespace). */
static char rtx_tm_before(const char *buf, size_t i) {
    return i > 0 ? buf[i - 1] : '\n';
}
static char rtx_tm_after(const char *buf, size_t i, size_t n) {
    return i < n ? buf[i] : '\n';
}

/* CommonMark left- / right-flanking delimiter run [i, i + len). */
static int rtx_tm_left_flank(const char *buf, size_t i, size_t n, size_t len) {
    char a = rtx_tm_after(buf, i + len, n), b = rtx_tm_before(buf, i);
    if (rtx_tm_is_ws(a)) return 0;
    return !rtx_tm_is_punct(a) || rtx_tm_is_ws(b) || rtx_tm_is_punct(b);
}
static int rtx_tm_right_flank(const char *buf, size_t i, size_t n, size_t len) {
    char a = rtx_tm_after(buf, i + len, n), b = rtx_tm_before(buf, i);
    if (rtx_tm_is_ws(b)) return 0;
    return !rtx_tm_is_punct(b) || rtx_tm_is_ws(a) || rtx_tm_is_punct(a);
}

/* The whole delimiter run holding byte i: [*rs, *re). */
static void rtx_tm_run_at(const char *buf, size_t i, size_t n, size_t *rs, size_t *re) {
    char c = buf[i];
    size_t a = i, b = i;
    while (a > 0 && buf[a - 1] == c) a--;
    while (b < n && buf[b] == c) b++;
    *rs = a;
    *re = b;
}

/* The run [rs, re) may open (`_`: not intraword unless after punctuation). */
static int rtx_tm_run_can_open(const char *buf, size_t rs, size_t re, size_t n,
                               unsigned char mode) {
    if (!rtx_tm_left_flank(buf, rs, n, re - rs)) return 0;
    if (mode == RTX_FLANK_UNDER && rtx_tm_right_flank(buf, rs, n, re - rs) &&
        !rtx_tm_is_punct(rtx_tm_before(buf, rs)))
        return 0;
    return 1;
}
static int rtx_tm_run_can_close(const char *buf, size_t rs, size_t re, size_t n,
                                unsigned char mode) {
    if (!rtx_tm_right_flank(buf, rs, n, re - rs)) return 0;
    if (mode == RTX_FLANK_UNDER && rtx_tm_left_flank(buf, rs, n, re - rs) &&
        !rtx_tm_is_punct(rtx_tm_after(buf, re, n)))
        return 0;
    return 1;
}

/* `cctext.flank` opener at i (alen bytes), on its whole delimiter run.
 * STAR: left-flanking (`2 * 3` opens nothing). UNDER: also not intraword
 * (`snake_case`). MATH: not before whitespace (`$ 5`). */
static int rtx_tm_flank_open(const char *buf, size_t i, size_t n, size_t alen,
                             unsigned char mode) {
    size_t rs, re;
    if (mode == RTX_FLANK_MATH) return !rtx_tm_is_ws(rtx_tm_after(buf, i + alen, n));
    rtx_tm_run_at(buf, i, n, &rs, &re);
    return rtx_tm_run_can_open(buf, rs, re, n, mode);
}
/* Closer at i (len bytes): its run can close; MATH not after whitespace
 * and not before a digit (`$5 and $10`). `open` is the opener byte (or
 * (size_t)-1 when behind the lex): CommonMark's rule of 3 — when either
 * run can both open and close, run lengths summing to a multiple of 3 do
 * not pair unless both are (`*x**y**z*` nests the strong). */
static int rtx_tm_flank_close(const char *buf, size_t i, size_t n, size_t len,
                              unsigned char mode, size_t open) {
    size_t rs, re, os, oe;
    if (mode == RTX_FLANK_MATH) {
        char a = rtx_tm_after(buf, i + len, n);
        return !rtx_tm_is_ws(rtx_tm_before(buf, i)) && !(a >= '0' && a <= '9');
    }
    rtx_tm_run_at(buf, i, n, &rs, &re);
    if (!rtx_tm_run_can_close(buf, rs, re, n, mode)) return 0;
    if (open != (size_t)-1 && open < n && buf[open] == buf[i]) {
        size_t cl = re - rs, ol;
        rtx_tm_run_at(buf, open, n, &os, &oe);
        ol = oe - os;
        if ((rtx_tm_run_can_open(buf, rs, re, n, mode) ||
             rtx_tm_run_can_close(buf, os, oe, n, mode)) &&
            (ol + cl) % 3 == 0 && !(ol % 3 == 0 && cl % 3 == 0))
            return 0;
    }
    return 1;
}


/* `cctext.exact`: [i, i + len) is a whole run of its byte — `` ` `` does not
 * open or close inside ```` `` ````. */
static int rtx_tm_exact_run(const char *buf, size_t i, size_t n, size_t len) {
    char c;
    if (!len) return 1;
    c = buf[i];
    return rtx_tm_before(buf, i) != c && rtx_tm_after(buf, i + len, n) != c;
}

typedef struct {
    RtxDoc *d;
    const RtxTmRt *host;
    const char *buf;
    size_t base;
    size_t n;
    size_t emit_from;
    size_t *i;
    size_t *sp;
    size_t *stk_rule;
    size_t *stk_lang;
    size_t *stk_embed;
    size_t *stk_off;
    size_t *stk_cs; /* RTX_TM_STACK * RTX_TM_CAPS begin captures (buf offsets) */
    size_t *stk_ce;
    size_t *stk_g;  /* \\G: end of the frame's begin match; RTX_RX_UNSET seeded */
    unsigned char *stk_alen; /* matched begin length (hint) */
    int bol0;
    RtxRxScratch *rxs; /* this lex call's matcher scratch */
    size_t eol_lo;     /* [eol_lo, eol_hi): the line a regex sees */
    size_t eol_hi;
    int md;            /* Markdown block pass owns lines: an inline span is
                        * bounded by its paragraph, not by the line end */
} RtxTmWalkSt;

static size_t rtx_tm_lang_id(const RtxTmRt *rt);
static const RtxTmRt *rtx_tm_rt_at(size_t id);
static size_t rtx_tm_rule_tag(const RtxTmRt *rt, const RtxTmRule *rule);
static RtxTmRule *rtx_tm_rule_from_tag(const RtxTmRt *rt, size_t tag);
static unsigned char rtx_tm_planter(const RtxTmRt *host, const RtxTmRt *rt);
static size_t rtx_tm_info_lang(const char *s, size_t n);
static size_t rtx_tm_scope_lang(const char *scope);
static int rtx_tm_span_close(RtxTmWalkSt *W, const RtxTmRule *fr, size_t i,
                             size_t slot, size_t *endn);
static int rtx_tm_open_span(RtxTmWalkSt *W, const RtxTmRt *rt,
                            const RtxTmRule *rule, size_t matched,
                            const RtxRxCaps *caps);

/* Regex input at `i`: the current line with its newline (TextMate hands
 * Oniguruma one line), offsets stay window-relative so lookbehind sees
 * the line's earlier bytes. `\\G` is the open frame's begin end. */
static void rtx_tm_rx_in(RtxTmWalkSt *W, size_t i, RtxRxIn *in) {
    if (i < W->eol_lo || i >= W->eol_hi) {
        const char *nl = i < W->n ? (const char *)memchr(W->buf + i, '\n', W->n - i)
                                  : NULL;
        W->eol_lo = i;
        W->eol_hi = nl ? (size_t)(nl - W->buf) + 1 : W->n;
    }
    memset(in, 0, sizeof(*in));
    in->s = W->buf;
    in->n = W->eol_hi;
    in->gpos = (W->sp && *W->sp) ? W->stk_g[*W->sp - 1] : RTX_RX_UNSET;
    in->ctx = (W->bol0 ? RTX_RX_CTX_BOL0 : 0u) | (W->base == 0 ? RTX_RX_CTX_BOT0 : 0u);
}

/* `cctext.bol`: physical BOL, or only whitespace since an open prefix
 * opener. The prefix frame is on the TM stack — it is not planted until
 * close, so planted runs cannot answer this. Closers stay physical BOL. */
static int rtx_tm_at_vbol(const RtxTmWalkSt *W) {
    size_t k, i, start, alen;
    if (!W || !W->i || !W->buf) return 0;
    if (rtx_tm_at_bol(W->buf, *W->i, W->bol0)) return 1;
    if (!W->sp || *W->sp == 0) return 0;
    for (k = *W->sp; k > 0; k--) {
        const RtxTmRt *frt = rtx_tm_rt_at(W->stk_lang[k - 1]);
        const RtxTmRule *fr;
        if (!frt) frt = W->host;
        fr = rtx_tm_rule_from_tag(frt, W->stk_rule[k - 1]);
        if (!rtx_tm_prefix(fr)) continue;
        alen = W->stk_alen ? (size_t)W->stk_alen[k - 1] : 0; /* 0: seeded */
        start = W->stk_off[k - 1] + alen;
        if (start > *W->i) continue;
        for (i = start; i < *W->i; i++) {
            if (W->buf[i] != ' ' && W->buf[i] != '\t') return 0;
        }
        return 1;
    }
    return 0;
}

static int rtx_tm_open_span(RtxTmWalkSt *W, const RtxTmRt *rt,
                            const RtxTmRule *rule, size_t matched,
                            const RtxRxCaps *caps) {
    size_t slot, g;
    if (!W || !rule || !W->sp || !W->i || *W->sp >= RTX_TM_STACK) return -1;
    slot = *W->sp;
    W->stk_rule[slot] = rtx_tm_rule_tag(rt, rule);
    W->stk_lang[slot] = rtx_tm_lang_id(rt);
    W->stk_embed[slot] = (size_t)RTX_TM_NO_LANG;
    W->stk_off[slot] = *W->i;
    if (W->stk_alen) W->stk_alen[slot] = rtx_tm_hint(matched);
    if (rtx_tm_prefix(rule) && W->buf) {
        size_t lead = 0;
        while (lead < matched &&
               (W->buf[*W->i + lead] == ' ' || W->buf[*W->i + lead] == '\t'))
            lead++;
        if (lead) {
            W->stk_off[slot] = *W->i + lead;
            if (W->stk_alen)
                W->stk_alen[slot] = rtx_tm_hint(matched - lead);
        }
    }
    /* Begin captures stay window offsets for the end's \\1–\\9. */
    for (g = 0; g < (size_t)RTX_TM_CAPS; g++) {
        size_t cs = RTX_RX_UNSET, ce = RTX_RX_UNSET;
        if (caps && g < (size_t)RTX_RX_CAPS) {
            cs = caps->s[g];
            ce = caps->e[g];
        }
        W->stk_cs[slot * (size_t)RTX_TM_CAPS + g] = cs;
        W->stk_ce[slot * (size_t)RTX_TM_CAPS + g] = ce;
    }
    (*W->sp)++;
    *W->i += matched;
    W->stk_g[slot] = *W->i;
    if (rule->info) {
        size_t lo;
        while (*W->i < W->n && (W->buf[*W->i] == ' ' || W->buf[*W->i] == '\t'))
            (*W->i)++;
        lo = *W->i;
        while (*W->i < W->n && W->buf[*W->i] != '\n') (*W->i)++;
        W->stk_embed[*W->sp - 1] = rtx_tm_info_lang(W->buf + lo, *W->i - lo);
        if (*W->i < W->n && W->buf[*W->i] == '\n') (*W->i)++;
    } else if (rule->embed_scope && rule->embed_scope[0]) {
        W->stk_embed[*W->sp - 1] = rtx_tm_scope_lang(rule->embed_scope);
    }
    return 1;
}

static int rtx_tm_try_rule(RtxTmWalkSt *W, const RtxTmRt *rt,
                           const RtxTmRule *rule, int allow_span) {
    unsigned char c;
    unsigned char plant;
    const char *buf;
    size_t n, base, emit_from;
    if (!W || !rule || !W->i) return 0;
    buf = W->buf;
    n = W->n;
    base = W->base;
    emit_from = W->emit_from;
    plant = rtx_tm_planter(W->host, rt);
    c = (unsigned char)buf[*W->i];
    if (rule->first >= 0 && c != (unsigned char)rule->first) return 0;
    switch (rule->op) {
    case RTX_TM_SKIP:
        return 0;
    case RTX_TM_LIT_LINE:
        if (!rtx_tm_starts(buf, *W->i, n, rule->a, rule->alen)) return 0;
        {
            size_t j = *W->i + rule->alen;
            while (j < n && buf[j] != '\n') j++;
            if (!rtx_tm_add(W->d, base + *W->i, base + j, emit_from, rt, rule, plant))
                return -1;
            *W->i = j;
            return 1;
        }
    case RTX_TM_LIT_SPAN:
        if (!allow_span || !rtx_tm_starts(buf, *W->i, n, rule->a, rule->alen))
            return 0;
        if (rule->bol && !rtx_tm_at_vbol(W)) return 0;
        if (rule->flank && !rtx_tm_flank_open(buf, *W->i, n, rule->alen, rule->flank))
            return 0;
        if (rule->exact && !rtx_tm_exact_run(buf, *W->i, n, rule->alen)) return 0;
        return rtx_tm_open_span(W, rt, rule, rule->alen, NULL);
    case RTX_TM_RE_SPAN: {
        size_t e = 0;
        RtxRxCaps caps;
        RtxRxIn in;
        if (!allow_span || !rule->ra || !rtx_rx_can_start(rule->ra, c)) return 0;
        if (rule->bol && !rtx_tm_at_vbol(W)) return 0;
        rtx_tm_rx_in(W, *W->i, &in);
        if (rtx_rx_at(rule->ra, &in, *W->i, W->rxs, &e, &caps) != RTX_RX_MATCH ||
            e <= *W->i)
            return 0;
        if (rule->flank && !rtx_tm_flank_open(buf, *W->i, n, e - *W->i, rule->flank))
            return 0;
        if (rule->exact && !rtx_tm_exact_run(buf, *W->i, n, e - *W->i)) return 0;
        return rtx_tm_open_span(W, rt, rule, e - *W->i, &caps);
    }
    case RTX_TM_DIGITS:
        if (c < '0' || c > '9') return 0;
        {
            size_t j = *W->i + 1;
            while (j < n && ((buf[j] >= '0' && buf[j] <= '9') || buf[j] == 'x' ||
                             (buf[j] >= 'a' && buf[j] <= 'f') ||
                             (buf[j] >= 'A' && buf[j] <= 'F'))) {
                j++;
            }
            if (!rtx_tm_add(W->d, base + *W->i, base + j, emit_from, rt, rule, plant))
                return -1;
            *W->i = j;
            return 1;
        }
    case RTX_TM_REGEX: {
        size_t e = 0, s;
        RtxRxCaps caps;
        RtxRxIn in;
        int g;
        if (!rule->ra || !rtx_rx_can_start(rule->ra, c)) return 0;
        if (rule->bol && !rtx_tm_at_vbol(W)) return 0;
        rtx_tm_rx_in(W, *W->i, &in);
        if (rtx_rx_at(rule->ra, &in, *W->i, W->rxs, &e, rule->has_cap ? &caps : NULL) !=
                RTX_RX_MATCH ||
            e <= *W->i)
            return 0; /* zero-width match rules would not advance */
        if (rtx_tm_apply_kind(rule) == RTX_APPLY_TOGGLE && (e >= n || buf[e] != ' '))
            return 0;
        s = *W->i;
        if (rtx_tm_prefix(rule)) {
            while (s < e && (buf[s] == ' ' || buf[s] == '\t')) s++;
        }
        if (!rtx_tm_add(W->d, base + s, base + e, emit_from, rt, rule, plant)) return -1;
        for (g = 1; rule->has_cap && g < RTX_RX_CAPS && g < RTX_TM_CAPS; g++) {
            size_t cs = caps.s[g], ce = caps.e[g];
            if (!rule->cap[g] || cs == RTX_RX_UNSET || ce == RTX_RX_UNSET) continue;
            /* lookaround may capture outside the match: keep runs inside it */
            if (cs < *W->i) cs = *W->i;
            if (ce > e) ce = e;
            if (ce <= cs) continue;
            if (!rtx_tm_add_span(W->d, base + cs, base + ce, emit_from, rule->cap[g],
                                 rule->cap_bits[g], 0, 0, plant, 0, RTX_RUN_NO_RULE))
                return -1;
        }
        *W->i = e;
        return 1;
    }
    case RTX_TM_ESC_DOT:
        if (c != '\\' || *W->i + 1 >= n || buf[*W->i + 1] == '\n') return 0;
        if (!rtx_tm_add(W->d, base + *W->i, base + *W->i + 2, emit_from, rt, rule,
                        plant)) {
            return -1;
        }
        *W->i += 2;
        return 1;
    case RTX_TM_KEYWORDS:
        if (!((c >= 'A' && c <= 'Z') || (c >= 'a' && c <= 'z') || c == '_')) return 0;
        {
            size_t j = *W->i + 1;
            while (j < n && ((buf[j] >= 'A' && buf[j] <= 'Z') ||
                             (buf[j] >= 'a' && buf[j] <= 'z') ||
                             (buf[j] >= '0' && buf[j] <= '9') || buf[j] == '_')) {
                j++;
            }
            if (rtx_tm_word_in_list(buf + *W->i, j - *W->i, rule->a, rule->alen)) {
                if (!rtx_tm_add(W->d, base + *W->i, base + j, emit_from, rt, rule,
                                plant)) {
                    return -1;
                }
            }
            *W->i = j;
            return 1;
        }
    }
    return 0;
}

static int rtx_tm_span_other_inner(const RtxTmRt *rt, const RtxTmRule *fr) {
    size_t k;
    if (!rt || !fr) return 0;
    for (k = 0; k < fr->innern; k++) {
        if (rt->inners.data[fr->inner0 + k].op != RTX_TM_ESC_DOT) return 1;
    }
    return 0;
}

/* Closer at i. `slot` is the frame (its begin captures feed the end's
 * backrefs), or (size_t)-1. A zero-width end (`(?=…)`, `$`) closes
 * without consuming: popping the frame is the progress. */
/* Opener byte of the top frame, or (size_t)-1 when it was seeded. */
static size_t rtx_tm_top_open(const RtxTmWalkSt *W) {
    size_t top;
    if (!W->sp || !*W->sp || !W->stk_alen) return (size_t)-1;
    top = *W->sp - 1;
    if (!W->stk_alen[top]) return (size_t)-1;
    return W->stk_off[top];
}

/* A flank (emphasis) span with nothing inside does not close: `**` at a
 * line end is not an empty italic. The frame is the top one. */
static int rtx_tm_span_empty(const RtxTmWalkSt *W, size_t i) {
    size_t top;
    if (!W->sp || !*W->sp || !W->stk_alen) return 0;
    top = *W->sp - 1;
    if (!W->stk_alen[top]) return 0; /* seeded: its opener is behind */
    return i == W->stk_off[top] + (size_t)W->stk_alen[top];
}

static int rtx_tm_span_close(RtxTmWalkSt *W, const RtxTmRule *fr, size_t i,
                             size_t slot, size_t *endn) {
    const char *buf = W->buf;
    size_t n = W->n;
    int bol0 = W->bol0;
    size_t e = 0;
    if (!fr) return 0;
    if (fr->op == RTX_TM_RE_SPAN) {
        RtxRxIn in;
        if (!fr->rb || i >= n || !rtx_rx_can_start(fr->rb, (unsigned char)buf[i]))
            return 0;
        rtx_tm_rx_in(W, i, &in);
        if (slot != (size_t)-1) {
            in.ext = buf;
            in.ext_s = W->stk_cs + slot * (size_t)RTX_TM_CAPS;
            in.ext_e = W->stk_ce + slot * (size_t)RTX_TM_CAPS;
            in.ext_n = RTX_TM_CAPS;
        }
        if (rtx_rx_at(fr->rb, &in, i, W->rxs, &e, NULL) != RTX_RX_MATCH || e < i)
            return 0;
        if (fr->bol && !rtx_tm_prefix(fr) && !rtx_tm_at_bol(buf, i, bol0))
            return 0;
        if (fr->flank && (!rtx_tm_flank_close(buf, i, n, e - i, fr->flank,
                                              rtx_tm_top_open(W)) ||
                          rtx_tm_span_empty(W, i)))
            return 0;
        if (fr->exact && !rtx_tm_exact_run(buf, i, n, e - i)) return 0;
        if (endn) *endn = e - i;
        return 1;
    }
    if (!fr->b || fr->blen == 0) return 0;
    if (!rtx_tm_starts(buf, i, n, fr->b, fr->blen)) return 0;
    if (fr->bol && !rtx_tm_prefix(fr) && !rtx_tm_at_bol(buf, i, bol0))
        return 0;
    if (fr->flank && (!rtx_tm_flank_close(buf, i, n, fr->blen, fr->flank,
                                          rtx_tm_top_open(W)) ||
                      rtx_tm_span_empty(W, i)))
        return 0;
    if (fr->exact && !rtx_tm_exact_run(buf, i, n, fr->blen)) return 0;
    if (endn) *endn = fr->blen;
    return 1;
}

static int rtx_tm_span_advance(RtxTmWalkSt *W, const RtxTmRt *rt, RtxTmRule *fr) {
    const char *hit_end;
    const char *hit_bs;
    const char *buf;
    size_t k, n;
    unsigned char plant;
    if (!W || !fr || !fr->b || fr->blen == 0 || !W->i || *W->i >= W->n) {
        if (W && W->i && *W->i < W->n) (*W->i)++;
        return 1;
    }
    buf = W->buf;
    n = W->n;
    plant = rtx_tm_planter(W->host, rt);
    hit_end = (const char *)memchr(buf + *W->i, fr->b[0], n - *W->i);
    hit_bs = NULL;
    if (fr->blen == 1) {
        hit_bs = (const char *)memchr(buf + *W->i, '\\', n - *W->i);
    }
    if (fr->inl && !W->md) {
        /* `cctext.inline`: a closer past the line end does not close. The
         * opener was plain text (CommonMark's unmatched delimiter); drop the
         * frame at the newline and let the outer loop lex on from there. */
        const char *nl = (const char *)memchr(buf + *W->i, '\n', n - *W->i);
        if (nl && (!hit_end || nl < hit_end) && (!hit_bs || nl < hit_bs)) {
            *W->i = (size_t)(nl - buf);
            (*W->sp)--;
            return 1;
        }
    }
    if (!hit_end && !hit_bs) {
        *W->i = n;
        return 1;
    }
    if (hit_bs && (!hit_end || hit_bs < hit_end)) {
        *W->i = (size_t)(hit_bs - buf);
        for (k = 0; k < fr->innern; k++) {
            int t = rtx_tm_try_rule(W, rt, &rt->inners.data[fr->inner0 + k], 0);
            if (t < 0) return -1;
            if (t > 0) return 1;
        }
        if (*W->i + 1 < n) {
            *W->i += 2;
            return 1;
        }
        (*W->i)++;
        return 1;
    }
    *W->i = (size_t)(hit_end - buf);
    {
        size_t endn = fr->blen;
        if (rtx_tm_span_close(W, fr, *W->i, (size_t)-1, &endn)) {
            size_t blen = endn;
            size_t ha, end;
            /* A seeded frame (opener behind the lex start) has alen 0. */
            ha = W->stk_alen ? (size_t)W->stk_alen[*W->sp - 1] : 0;
            end = rtx_tm_span_end(fr, *W->i, endn, &blen);
            if (!rtx_tm_hints(rt, fr, plant)) ha = blen = 0;
            if (!rtx_tm_add_span(W->d, W->base + W->stk_off[*W->sp - 1],
                                 W->base + end, W->emit_from, fr->scope,
                                 rtx_tm_rule_bits(fr), ha, blen, plant,
                                 fr->mark,
                                 (unsigned short)rtx_tm_rule_tag(rt, fr))) {
                return -1;
            }
            *W->i = end == *W->i && blen == 0 ? *W->i : end;
            (*W->sp)--;
            return 1;
        }
    }
    (*W->i)++;
    return 1;
}

typedef struct {
    char name[128];
    char match[512];
    char begin[512];
    char end[512];
    char incl[64];
    char capn[RTX_TM_CAPS][128];
    size_t kid0;
    size_t n_kids;
    unsigned char sc_has;
    unsigned char sc_bol;
    unsigned char sc_inl;
    unsigned char sc_flank;
    unsigned char sc_exact;
    unsigned char sc_abort;
    unsigned char sc_block;
    unsigned char sc_strike;
    unsigned char sc_hl;
    unsigned char sc_info;
    unsigned char sc_bold;
    unsigned char sc_italic;
    unsigned char sc_mono;
    char sc_apply[64];
    char sc_insert[16];
    unsigned char sc_arity;
    unsigned char sc_dest;
    unsigned char sc_lit;
    unsigned char sc_wrap;
    unsigned char sc_max;
    unsigned char sc_mark;
} RtxTmPatRaw;

static int rtx_jw_pattern(RtxJw *j, RtxTmPatRaw *p);

static CCArena rtx_tm_store;
static int rtx_tm_store_ready;
static Vec::[RtxTmLang] rtx_tm_langs;
size_t rtx_tm_nlangs;
static int rtx_tm_reg_ready;
static RtxTmLang *rtx_tm_cur;
char rtx_tm_load_dir[256];
size_t rtx_tm_load_us;
size_t rtx_tm_load_files;
size_t rtx_tm_nready;
/* The registry scan and every lazy grammar load (a browse preview opens
 * documents on a worker): rtx_tm_cur, the store arena and the slot being
 * loaded are only written under it. */
static pthread_mutex_t rtx_tm_load_mu = PTHREAD_MUTEX_INITIALIZER;
void rtx_jw_ws(RtxJw *j) {
    while (j->i < j->n) {
        char c = j->s[j->i];
        if (c != ' ' && c != '\t' && c != '\n' && c != '\r') break;
        j->i++;
    }
}

int rtx_jw_eat(RtxJw *j, char c) {
    rtx_jw_ws(j);
    if (j->i >= j->n || j->s[j->i] != c) return 0;
    j->i++;
    return 1;
}

int rtx_jw_string(RtxJw *j, char *dst, size_t cap) {
    size_t o = 0;
    rtx_jw_ws(j);
    if (j->i >= j->n || j->s[j->i] != '"') return 0;
    j->i++;
    while (j->i < j->n && j->s[j->i] != '"') {
        char c = j->s[j->i++];
        if (c == '\\' && j->i < j->n) {
            char e = j->s[j->i++];
            if (e == 'n') c = '\n';
            else if (e == 't') c = '\t';
            else if (e == 'r') c = '\r';
            else c = e;
        }
        if (o + 1 < cap) dst[o++] = c;
    }
    if (j->i >= j->n || j->s[j->i] != '"') return 0;
    j->i++;
    if (dst && cap) dst[o] = 0;
    return 1;
}

static int rtx_jw_skip_object(RtxJw *j) {
    if (!rtx_jw_eat(j, '{')) return 0;
    rtx_jw_ws(j);
    if (rtx_jw_eat(j, '}')) return 1;
    for (;;) {
        char k[64];
        if (!rtx_jw_string(j, k, sizeof k) || !rtx_jw_eat(j, ':') ||
            !rtx_jw_skip(j)) {
            return 0;
        }
        rtx_jw_ws(j);
        if (rtx_jw_eat(j, '}')) return 1;
        if (!rtx_jw_eat(j, ',')) return 0;
    }
}

int rtx_jw_skip(RtxJw *j) {
    rtx_jw_ws(j);
    if (j->i >= j->n) return 0;
    if (j->s[j->i] == '"') {
        char tmp[8];
        return rtx_jw_string(j, tmp, sizeof tmp);
    }
    if (j->s[j->i] == '{') return rtx_jw_skip_object(j);
    if (j->s[j->i] == '[') {
        j->i++;
        rtx_jw_ws(j);
        if (rtx_jw_eat(j, ']')) return 1;
        for (;;) {
            if (!rtx_jw_skip(j)) return 0;
            rtx_jw_ws(j);
            if (rtx_jw_eat(j, ']')) return 1;
            if (!rtx_jw_eat(j, ',')) return 0;
        }
    }
    while (j->i < j->n) {
        char c = j->s[j->i];
        if (c == ',' || c == '}' || c == ']' || c == ' ' || c == '\n' ||
            c == '\t' || c == '\r') {
            break;
        }
        j->i++;
    }
    return 1;
}

static int rtx_tm_store_init(void) {
    if (rtx_tm_store_ready) return rtx_tm_store.base != NULL;
    rtx_tm_store = cc_arena_heap(kilobytes(64));
    rtx_tm_store_ready = 1;
    return rtx_tm_store.base != NULL;
}

static int rtx_tm_lang_plant(RtxTmLang *lang) {
    if (!lang || !rtx_tm_store_init()) return 0;
    lang->pats = vec_new::[RtxTmPat](rtx_tm_store);
    lang->kids = vec_new::[RtxTmPat](rtx_tm_store);
    lang->rt.rules = vec_new::[RtxTmRule](rtx_tm_store);
    lang->rt.inners = vec_new::[RtxTmRule](rtx_tm_store);
    return lang->pats.data && lang->kids.data && lang->rt.rules.data &&
           lang->rt.inners.data;
}

static const char *rtx_tm_intern(const char *s) {
    char[:] src;
    char[:] out;
    size_t n;
    if (!s || !s[0]) return "";
    if (!rtx_tm_store_init()) return NULL;
    n = cc_slice_cstr(s).len;
    src = cc_slice_from_buffer((void *)s, n + 1);
    out = src.clone_into(rtx_tm_store) !>(e) {
        (void)e;
        return NULL;
    };
    return out.ptr;
}

static int rtx_tm_pat_from_raw(const RtxTmPatRaw *raw, RtxTmPat *out) {
    size_t i;
    if (!raw || !out) return 0;
    *out = (RtxTmPat){0};
    out->name = rtx_tm_intern(raw->name);
    out->match = rtx_tm_intern(raw->match);
    out->begin = rtx_tm_intern(raw->begin);
    out->end = rtx_tm_intern(raw->end);
    out->incl = rtx_tm_intern(raw->incl);
    if (!out->name || !out->match || !out->begin || !out->end || !out->incl)
        return 0;
    for (i = 0; i < (size_t)RTX_TM_CAPS; i++) {
        out->capn[i] = rtx_tm_intern(raw->capn[i]);
        if (!out->capn[i]) return 0;
    }
    out->kid0 = raw->kid0;
    out->n_kids = raw->n_kids;
    out->sc_has = raw->sc_has;
    out->sc_bol = raw->sc_bol;
    out->sc_inl = raw->sc_inl;
    out->sc_flank = raw->sc_flank;
    out->sc_exact = raw->sc_exact;
    out->sc_abort = raw->sc_abort;
    out->sc_block = raw->sc_block;
    out->sc_strike = raw->sc_strike;
    out->sc_hl = raw->sc_hl;
    out->sc_info = raw->sc_info;
    out->sc_bold = raw->sc_bold;
    out->sc_italic = raw->sc_italic;
    out->sc_mono = raw->sc_mono;
    out->sc_apply = rtx_tm_intern(raw->sc_apply);
    if (!out->sc_apply) return 0;
    out->sc_insert = rtx_tm_intern(raw->sc_insert);
    if (!out->sc_insert) return 0;
    out->sc_arity = raw->sc_arity;
    out->sc_dest = raw->sc_dest;
    out->sc_lit = raw->sc_lit;
    out->sc_wrap = raw->sc_wrap;
    out->sc_max = raw->sc_max;
    out->sc_mark = raw->sc_mark;
    return 1;
}

static void rtx_tm_pat_clear(RtxTmPatRaw *p) {
    size_t i;
    if (!p) return;
    p->name[0] = p->match[0] = p->begin[0] = p->end[0] = p->incl[0] = 0;
    p->kid0 = 0;
    p->n_kids = 0;
    for (i = 0; i < (size_t)RTX_TM_CAPS; i++) p->capn[i][0] = 0;
    p->sc_has = p->sc_bol = p->sc_inl = p->sc_flank = p->sc_info = 0;
    p->sc_exact = p->sc_abort = p->sc_block = p->sc_strike = p->sc_hl = 0;
    p->sc_bold = p->sc_italic = p->sc_mono = 0;
    p->sc_apply[0] = 0;
    p->sc_insert[0] = 0;
    p->sc_arity = 0;
    p->sc_dest = 0;
    p->sc_lit = 0;
    p->sc_wrap = 0;
    p->sc_max = 0;
    p->sc_mark = 0;
}

/* JSON `true` / `false` literal. */
int rtx_jw_bool(RtxJw *j, int *out) {
    CCSlice h;
    rtx_jw_ws(j);
    if (j->i + 4 <= j->n) {
        h = cc_slice_from_buffer((void *)(j->s + j->i), 4);
        if (cc_slice_eq(&h, CC_SLICE_LIT("true"))) {
            j->i += 4;
            if (out) *out = 1;
            return 1;
        }
    }
    if (j->i + 5 <= j->n) {
        h = cc_slice_from_buffer((void *)(j->s + j->i), 5);
        if (cc_slice_eq(&h, CC_SLICE_LIT("false"))) {
            j->i += 5;
            if (out) *out = 0;
            return 1;
        }
    }
    return 0;
}

/* JSON unsigned 0–255. */
static int rtx_jw_u8(RtxJw *j, unsigned char *out) {
    unsigned v = 0;
    int n = 0;
    rtx_jw_ws(j);
    if (j->i >= j->n || j->s[j->i] < '0' || j->s[j->i] > '9') return 0;
    while (j->i < j->n && j->s[j->i] >= '0' && j->s[j->i] <= '9') {
        v = v * 10u + (unsigned)(j->s[j->i] - '0');
        if (v > 255) return 0;
        j->i++;
        n++;
    }
    if (!n) return 0;
    if (out) *out = (unsigned char)v;
    return 1;
}

/* Pattern-level sidecar: `"cctext": { "bold", "italic", "mono",
 * "apply", "insert", "max", "bol" }`. Unknown keys skip. Any
 * style key present replaces the default scope→bits map for this pattern;
 * `bol` anchors a literal begin / end to line start (fence closers). */
static int rtx_jw_cctext_pat(RtxJw *j, RtxTmPatRaw *p) {
    if (!rtx_jw_eat(j, '{')) return 0;
    rtx_jw_ws(j);
    if (rtx_jw_eat(j, '}')) return 1;
    for (;;) {
        char key[32];
        int b = 0;
        if (!rtx_jw_string(j, key, sizeof key) || !rtx_jw_eat(j, ':')) return 0;
        if (rtx_cstr_eq_lit(key, "bold")) {
            if (!rtx_jw_bool(j, &b)) return 0;
            p->sc_bold = (unsigned char)b;
            p->sc_has = 1;
        } else if (rtx_cstr_eq_lit(key, "italic")) {
            if (!rtx_jw_bool(j, &b)) return 0;
            p->sc_italic = (unsigned char)b;
            p->sc_has = 1;
        } else if (rtx_cstr_eq_lit(key, "mono")) {
            if (!rtx_jw_bool(j, &b)) return 0;
            p->sc_mono = (unsigned char)b;
            p->sc_has = 1;
        } else if (rtx_cstr_eq_lit(key, "bol")) {
            if (!rtx_jw_bool(j, &b)) return 0;
            p->sc_bol = (unsigned char)b;
        } else if (rtx_cstr_eq_lit(key, "inline")) {
            if (!rtx_jw_bool(j, &b)) return 0;
            p->sc_inl = (unsigned char)b;
        } else if (rtx_cstr_eq_lit(key, "flank")) {
            rtx_jw_ws(j);
            if (j->i < j->n && j->s[j->i] == '"') {
                char v[16];
                if (!rtx_jw_string(j, v, sizeof v)) return 0;
                if (rtx_cstr_eq_lit(v, "under")) p->sc_flank = (unsigned char)RTX_FLANK_UNDER;
                else if (rtx_cstr_eq_lit(v, "math")) p->sc_flank = (unsigned char)RTX_FLANK_MATH;
                else p->sc_flank = (unsigned char)RTX_FLANK_STAR;
            } else {
                if (!rtx_jw_bool(j, &b)) return 0;
                p->sc_flank = (unsigned char)(b ? RTX_FLANK_STAR : RTX_FLANK_NONE);
            }
        } else if (rtx_cstr_eq_lit(key, "exact")) {
            if (!rtx_jw_bool(j, &b)) return 0;
            p->sc_exact = (unsigned char)b;
        } else if (rtx_cstr_eq_lit(key, "abort")) {
            char v[8];
            if (!rtx_jw_string(j, v, sizeof v)) return 0;
            p->sc_abort = (unsigned char)v[0];
        } else if (rtx_cstr_eq_lit(key, "strike")) {
            if (!rtx_jw_bool(j, &b)) return 0;
            p->sc_strike = (unsigned char)b;
            p->sc_has = 1;
        } else if (rtx_cstr_eq_lit(key, "highlight")) {
            if (!rtx_jw_bool(j, &b)) return 0;
            p->sc_hl = (unsigned char)b;
            p->sc_has = 1;
        } else if (rtx_cstr_eq_lit(key, "block")) {
            char v[24];
            static const char *const roles[] = {
                "", "fence", "heading", "heading_close", "setext", "quote", "list",
                "task", "hr", "code", "html", "math", "front", "ref", "ref_dest",
                "foot", NULL,
            };
            int r;
            if (!rtx_jw_string(j, v, sizeof v)) return 0;
            p->sc_block = 0;
            for (r = 1; roles[r]; r++) {
                if (rtx_cstr_eq(v, roles[r])) p->sc_block = (unsigned char)r;
            }
        } else if (rtx_cstr_eq_lit(key, "info")) {
            if (!rtx_jw_bool(j, &b)) return 0;
            p->sc_info = (unsigned char)b;
        } else if (rtx_cstr_eq_lit(key, "apply")) {
            if (!rtx_jw_string(j, p->sc_apply, sizeof p->sc_apply)) return 0;
        } else if (rtx_cstr_eq_lit(key, "insert")) {
            if (!rtx_jw_string(j, p->sc_insert, sizeof p->sc_insert)) return 0;
        } else if (rtx_cstr_eq_lit(key, "max")) {
            if (!rtx_jw_u8(j, &p->sc_max)) return 0;
        } else if (rtx_cstr_eq_lit(key, "arity")) {
            char v[16];
            if (!rtx_jw_string(j, v, sizeof v)) return 0;
            p->sc_mark = 1;
            if (rtx_cstr_eq_lit(v, "prefix")) p->sc_arity = (unsigned char)RTX_ARITY_PREFIX;
            else if (rtx_cstr_eq_lit(v, "path")) p->sc_arity = (unsigned char)RTX_ARITY_PATH;
            else p->sc_arity = (unsigned char)RTX_ARITY_PAIR;
        } else if (rtx_cstr_eq_lit(key, "face")) {
            char v[16];
            if (!rtx_jw_string(j, v, sizeof v)) return 0;
            p->sc_dest = (unsigned char)(rtx_cstr_eq_lit(v, "dest"));
            p->sc_mark = 1;
        } else if (rtx_cstr_eq_lit(key, "lit")) {
            if (!rtx_jw_bool(j, &b)) return 0;
            p->sc_lit = (unsigned char)b;
        } else if (rtx_cstr_eq_lit(key, "wrap")) {
            unsigned char w = 0;
            p->sc_mark = 1;
            if (rtx_jw_u8(j, &w)) {
                p->sc_wrap = w;
            } else if (rtx_jw_bool(j, &b)) {
                p->sc_wrap = b ? 1 : 0;
            } else {
                return 0;
            }
        } else if (!rtx_jw_skip(j)) {
            return 0;
        }
        rtx_jw_ws(j);
        if (rtx_jw_eat(j, '}')) return 1;
        if (!rtx_jw_eat(j, ',')) return 0;
    }
}

/* One `autoClosingPairs` entry: `["(", ")"]` or `{"open": "(", "close":
 * ")", ...}`. Only single-byte pairs are kept (the editor's pairs are one
 * byte each); others parse and drop. */
static int rtx_jw_auto_pair(RtxJw *j, RtxTmRt *rt) {
    char o[8], c[8];
    size_t at;
    o[0] = c[0] = 0;
    rtx_jw_ws(j);
    if (j->i < j->n && j->s[j->i] == '[') {
        j->i++;
        if (!rtx_jw_string(j, o, sizeof o) || !rtx_jw_eat(j, ',') ||
            !rtx_jw_string(j, c, sizeof c) || !rtx_jw_eat(j, ']'))
            return 0;
    } else {
        if (!rtx_jw_eat(j, '{')) return 0;
        rtx_jw_ws(j);
        if (!rtx_jw_eat(j, '}')) {
            for (;;) {
                char k[16];
                if (!rtx_jw_string(j, k, sizeof k) || !rtx_jw_eat(j, ':')) return 0;
                if (rtx_cstr_eq_lit(k, "open")) {
                    if (!rtx_jw_string(j, o, sizeof o)) return 0;
                } else if (rtx_cstr_eq_lit(k, "close")) {
                    if (!rtx_jw_string(j, c, sizeof c)) return 0;
                } else if (!rtx_jw_skip(j)) {
                    return 0;
                }
                rtx_jw_ws(j);
                if (rtx_jw_eat(j, '}')) break;
                if (!rtx_jw_eat(j, ',')) return 0;
            }
        }
    }
    if (!o[0] || o[1] || !c[0] || c[1]) return 1;
    at = cc_slice_cstr(rt->pairs).len;
    if (at + 2 >= sizeof rt->pairs) return 1;
    rt->pairs[at] = o[0];
    rt->pairs[at + 1] = c[0];
    rt->pairs[at + 2] = 0;
    return 1;
}

static int rtx_jw_auto_pairs(RtxJw *j, RtxTmRt *rt) {
    if (!rtx_jw_eat(j, '[')) return 0;
    if (!rt->pairs_set) rt->pairs[0] = 0;
    rt->pairs_set = 1;
    rtx_jw_ws(j);
    if (rtx_jw_eat(j, ']')) return 1;
    for (;;) {
        if (!rtx_jw_auto_pair(j, rt)) return 0;
        rtx_jw_ws(j);
        if (rtx_jw_eat(j, ']')) return 1;
        if (!rtx_jw_eat(j, ',')) return 0;
    }
}

/* Grammar-level sidecar: `"cctext": { "kind": "markup" }` → rt->markup.
 * Unknown keys / kinds skip. */
static int rtx_jw_cctext_lang(RtxJw *j, RtxTmRt *rt) {
    if (!rtx_jw_eat(j, '{')) return 0;
    rtx_jw_ws(j);
    if (rtx_jw_eat(j, '}')) return 1;
    for (;;) {
        char key[32];
        if (!rtx_jw_string(j, key, sizeof key) || !rtx_jw_eat(j, ':')) return 0;
        if (rtx_cstr_eq_lit(key, "kind")) {
            char kind[32];
            if (!rtx_jw_string(j, kind, sizeof kind)) return 0;
            if (rtx_cstr_eq_lit(kind, "markup")) rt->markup = 1;
        } else if (rtx_cstr_eq_lit(key, "pairs")) {
            char pv[64];
            size_t k, o = 0;
            if (!rtx_jw_string(j, pv, sizeof pv)) return 0;
            for (k = 0; pv[k] && pv[k + 1] && o + 2 < sizeof rt->pairs; k += 2) {
                rt->pairs[o++] = pv[k];
                rt->pairs[o++] = pv[k + 1];
            }
            rt->pairs[o] = 0;
            rt->pairs_set = 1;
        } else if (rtx_cstr_eq_lit(key, "blocks")) {
            char kind[32];
            if (!rtx_jw_string(j, kind, sizeof kind)) return 0;
            if (rtx_cstr_eq_lit(kind, "commonmark")) rt->blocks = 1;
        } else if (!rtx_jw_skip(j)) {
            return 0;
        }
        rtx_jw_ws(j);
        if (rtx_jw_eat(j, '}')) return 1;
        if (!rtx_jw_eat(j, ',')) return 0;
    }
}

static int rtx_jw_pattern_fields(RtxJw *j, RtxTmPatRaw *p) {
    rtx_tm_pat_clear(p);
    if (!rtx_jw_eat(j, '{')) return 0;
    rtx_jw_ws(j);
    if (rtx_jw_eat(j, '}')) return 1;
    for (;;) {
        char key[32];
        if (!rtx_jw_string(j, key, sizeof key) || !rtx_jw_eat(j, ':')) return 0;
        if (rtx_cstr_eq_lit(key, "name")) {
            if (!rtx_jw_string(j, p->name, sizeof p->name)) return 0;
        } else if (rtx_cstr_eq_lit(key, "match")) {
            if (!rtx_jw_string(j, p->match, sizeof p->match)) return 0;
        } else if (rtx_cstr_eq_lit(key, "begin")) {
            if (!rtx_jw_string(j, p->begin, sizeof p->begin)) return 0;
        } else if (rtx_cstr_eq_lit(key, "end")) {
            if (!rtx_jw_string(j, p->end, sizeof p->end)) return 0;
        } else if (rtx_cstr_eq_lit(key, "include")) {
            if (!rtx_jw_string(j, p->incl, sizeof p->incl)) return 0;
        } else if (rtx_cstr_eq_lit(key, "patterns")) {
            if (!rtx_jw_eat(j, '[')) return 0;
            rtx_jw_ws(j);
            p->kid0 = rtx_tm_cur ? rtx_tm_cur->kids.len : 0;
            p->n_kids = 0;
            if (!rtx_jw_eat(j, ']')) {
                for (;;) {
                    RtxTmPatRaw child;
                    RtxTmPat slim;
                    if (!rtx_tm_cur) return 0;
                    if (!rtx_jw_pattern(j, &child)) return 0;
                    if (!rtx_tm_pat_from_raw(&child, &slim)) return 0;
                    if (rtx_tm_cur->kids.push(slim) != 0) return 0;
                    p->n_kids++;
                    rtx_jw_ws(j);
                    if (rtx_jw_eat(j, ']')) break;
                    if (!rtx_jw_eat(j, ',')) return 0;
                }
            }
        } else if (rtx_cstr_eq_lit(key, "captures") ||
                   rtx_cstr_eq_lit(key, "beginCaptures")) {
            if (!rtx_jw_eat(j, '{')) return 0;
            rtx_jw_ws(j);
            if (!rtx_jw_eat(j, '}')) {
                for (;;) {
                    char gk[8];
                    int gi;
                    RtxTmPatRaw cap;
                    if (!rtx_jw_string(j, gk, sizeof gk) || !rtx_jw_eat(j, ':')) {
                        return 0;
                    }
                    gi = atoi(gk);
                    if (!rtx_jw_pattern(j, &cap)) return 0;
                    if (gi >= 0 && gi < RTX_TM_CAPS && cap.name[0]) {
                        strncpy(p->capn[gi], cap.name, 127);
                        p->capn[gi][127] = 0;
                    }
                    rtx_jw_ws(j);
                    if (rtx_jw_eat(j, '}')) break;
                    if (!rtx_jw_eat(j, ',')) return 0;
                }
            }
        } else if (rtx_cstr_eq_lit(key, "cctext")) {
            if (!rtx_jw_cctext_pat(j, p)) return 0;
        } else if (!rtx_jw_skip(j)) {
            return 0;
        }
        rtx_jw_ws(j);
        if (rtx_jw_eat(j, '}')) return 1;
        if (!rtx_jw_eat(j, ',')) return 0;
    }
}

static int rtx_jw_pattern(RtxJw *j, RtxTmPatRaw *p) {
    return rtx_jw_pattern_fields(j, p);
}

static int rtx_tm_add_lowered(RtxTmRt *rt, const RtxTmPat *p) {
    RtxTmRule rule;
    if (!rt || !p) return 0;
    if (!rtx_tm_lower_rule(p->name, p->match, p->begin, p->end, p->incl, &rule)) {
        return 0;
    }
    /* A block-pass rule may have no pattern: it is kept (never tried) for
     * its scope, bits, arity, apply and tag. */
    if (rule.op == RTX_TM_SKIP && !p->sc_block) return 1;
    if (rule.op == RTX_TM_SKIP && p->name && p->name[0] &&
        !rtx_scope_put(&rule.scope, p->name))
        return 0;
    return rt->rules.push(rule) == 0;
}

static int rtx_tm_intern_caps(RtxTmRule *rule, const RtxTmPat *p) {
    size_t i;
    if (!rule || !p) return 0;
    rule->has_cap = 0;
    for (i = 0; i < (size_t)RTX_TM_CAPS; i++) {
        rule->cap_bits[i] = 0;
        if (!p->capn[i] || !p->capn[i][0]) {
            rule->cap[i] = RTX_SCOPE_NONE;
            continue;
        }
        if (!rtx_scope_put(&rule->cap[i], p->capn[i])) return 0;
        rule->cap_bits[i] = rtx_scope_default_bits(rule->cap[i]);
        if (i > 0) rule->has_cap = 1;
    }
    return 1;
}

size_t rtx_tm_rx_errors;
char rtx_tm_rx_err[160];

/* One compiled pattern on the TM store (process lifetime, like the
 * interned strings). A refused pattern drops its rule and is counted. */
static const RtxRx *rtx_tm_rx(const char *p, size_t n, unsigned fl) {
    RtxRx *rx;
    if (!p || !rtx_tm_store_init()) return NULL;
    rx = rtx_rx_compile(cc_slice_from_buffer((void *)p, n), fl, rtx_tm_store) !>(e) {
        rtx_tm_rx_errors++;
        if (!rtx_tm_rx_err[0])
            snprintf(rtx_tm_rx_err, sizeof rtx_tm_rx_err, "%s: /%.*s/",
                     e.message ? e.message : "regex", (int)(n > 100 ? 100 : n), p);
        return NULL;
    };
    return rx;
}

static void rtx_tm_rule_finish(RtxTmRule *rule) {
    if (!rule) return;
    rule->first = -1;
    rule->ra = NULL;
    rule->rb = NULL;
    if (rule->op == RTX_TM_LIT_LINE || rule->op == RTX_TM_LIT_SPAN) {
        if (rule->a && rule->alen) rule->first = (signed short)(unsigned char)rule->a[0];
        return;
    }
    if (rule->op == RTX_TM_ESC_DOT) {
        rule->first = (signed short)'\\';
        return;
    }
    if (rule->op == RTX_TM_REGEX || rule->op == RTX_TM_RE_SPAN) {
        rule->ra = rtx_tm_rx(rule->a, rule->alen, 0);
        if (rule->op == RTX_TM_RE_SPAN)
            rule->rb = rtx_tm_rx(rule->b, rule->blen, RTX_RX_EXTREF);
        if (!rule->ra || (rule->op == RTX_TM_RE_SPAN && !rule->rb)) {
            rule->op = RTX_TM_SKIP;
            return;
        }
        rule->first = (signed short)rtx_rx_first_byte(rule->ra);
    }
}

/* Effective bits: sidecar when the pattern has one, else the default
 * scope map. Capture scopes take the default map in rtx_tm_intern_caps. */
static void rtx_tm_bind_bits(RtxTmRule *rule, const RtxTmPat *stable) {
    if (stable->sc_has) {
        rule->sc_bold = stable->sc_bold;
        rule->sc_italic = stable->sc_italic;
        rule->sc_mono = stable->sc_mono;
        rule->sc_strike = stable->sc_strike;
        rule->sc_hl = stable->sc_hl;
    } else {
        unsigned char bits = rtx_scope_default_bits(rule->scope);
        rule->sc_bold = (bits & RTX_SBIT_BOLD) != 0;
        rule->sc_italic = (bits & RTX_SBIT_ITALIC) != 0;
        rule->sc_mono = (bits & RTX_SBIT_MONO) != 0;
        rule->sc_strike = (bits & RTX_SBIT_STRIKE) != 0;
        rule->sc_hl = (bits & RTX_SBIT_HL) != 0;
    }
}

static void rtx_tm_bind_rule(RtxTmRule *rule, RtxTmPat *stable) {
    if (!rule || !stable) return;
    rtx_tm_bind_bits(rule, stable);
    rule->bol = stable->sc_bol;
    rule->inl = stable->sc_inl;
    rule->flank = stable->sc_flank;
    rule->exact = stable->sc_exact;
    rule->abort = stable->sc_abort;
    rule->block = stable->sc_block;
    rule->self_in = 0;
    rule->info = stable->sc_info;
    rule->embed_scope = NULL;
    rule->sc_apply = stable->sc_apply && stable->sc_apply[0] ? stable->sc_apply : NULL;
    rule->sc_insert = stable->sc_insert && stable->sc_insert[0] ? stable->sc_insert : NULL;
    rule->sc_max = stable->sc_max;
    rule->mark = (unsigned char)(stable->sc_arity & RTX_MARK_ARITY);
    if (stable->sc_dest) rule->mark |= (unsigned char)RTX_MARK_DEST;
    rule->sc_wrap = stable->sc_wrap;
    rule->sc_mark = stable->sc_mark;
    if (stable->sc_lit && (rule->op == RTX_TM_RE_SPAN))
        rule->op = RTX_TM_LIT_SPAN;
    switch (rule->op) {
    case RTX_TM_SKIP:
    case RTX_TM_DIGITS:
    case RTX_TM_ESC_DOT:
        return;
    case RTX_TM_LIT_LINE: {
        size_t m;
        rule->a = stable->match;
        m = cc_slice_cstr(rule->a).len;
        rule->alen = (m >= 2) ? m - 2 : m;
        return;
    }
    case RTX_TM_KEYWORDS: {
        const char *m = stable->match;
        const char *close = strstr(m, ")\\b");
        rule->a = stable->match;
        if (m[0] == '\\' && m[1] == 'b' && m[2] == '(' && close) {
            rule->a = m + 3;
            rule->alen = (size_t)(close - (m + 3));
        }
        return;
    }
    case RTX_TM_REGEX:
        rule->a = stable->match;
        rule->alen = cc_slice_cstr(rule->a).len;
        return;
    case RTX_TM_RE_SPAN:
    case RTX_TM_LIT_SPAN:
        rule->a = stable->begin;
        rule->b = stable->end;
        rule->alen = cc_slice_cstr(rule->a).len;
        rule->blen = cc_slice_cstr(rule->b).len;
        return;
    }
}

static int rtx_tm_add_inner(RtxTmRt *rt, const RtxTmPat *p) {
    RtxTmRule rule;
    RtxTmPat *stable;
    if (!rt || !p || !rtx_tm_cur) return 0;
    if (rtx_tm_cur->pats.push(*p) != 0) return 0;
    stable = &rtx_tm_cur->pats.data[rtx_tm_cur->pats.len - 1];
    if (!rtx_tm_lower_rule(stable->name, stable->match, stable->begin,
                           stable->end, stable->incl, &rule)) {
        return 0;
    }
    if (rule.op == RTX_TM_SKIP) return 1;
    rtx_tm_bind_rule(&rule, stable);
    if (!rtx_tm_intern_caps(&rule, stable)) return 0;
    rtx_tm_rule_finish(&rule);
    return rt->inners.push(rule) == 0;
}

static int rtx_tm_add_inner_resolved(RtxTmRt *rt, const RtxTmPat *p,
                                    const RtxTmRepoEnt *repo, size_t nrepo,
                                    int depth);

static int rtx_tm_attach_inners(RtxTmRt *rt, size_t rule_i, const RtxTmPat *p,
                                const RtxTmRepoEnt *repo, size_t nrepo,
                                int depth) {
    RtxTmRule *last;
    size_t inner0, k;
    if (!rt || !p || rule_i >= rt->inners.len) return 0;
    last = &rt->inners.data[rule_i];
    if (!rtx_tm_op_span(last->op)) return 1;
    inner0 = rt->inners.len;
    last->inner0 = inner0;
    if (p->incl && p->incl[0] == '#' && p->incl[1]) {
        size_t r;
        for (r = 0; r < nrepo; r++) {
            if (repo[r].key && rtx_cstr_eq(repo[r].key, p->incl + 1)) {
                if (!rtx_tm_add_inner_resolved(rt, &repo[r].pat, repo, nrepo,
                                               depth + 1)) {
                    return 0;
                }
                break;
            }
        }
    }
    for (k = 0; k < p->n_kids; k++) {
        const RtxTmPat *kid = &rtx_tm_cur->kids.data[p->kid0 + k];
        if (rtx_cstr_eq_lit(kid->incl, "$self")) {
            rt->inners.data[rule_i].self_in = 1;
            continue;
        }
        if (!rtx_tm_add_inner_resolved(rt, kid, repo, nrepo, depth + 1)) {
            return 0;
        }
    }
    rt->inners.data[rule_i].innern = rt->inners.len - inner0;
    return 1;
}

static int rtx_tm_add_inner_resolved(RtxTmRt *rt, const RtxTmPat *p,
                                    const RtxTmRepoEnt *repo, size_t nrepo,
                                    int depth) {
    size_t idx;
    if (!rt || !p || depth > 4) return 1;
    if (p->incl && p->incl[0] == '#' && p->incl[1] &&
        !(p->begin && p->begin[0] && p->end && p->end[0])) {
        size_t r;
        for (r = 0; r < nrepo; r++) {
            if (repo[r].key && rtx_cstr_eq(repo[r].key, p->incl + 1)) {
                return rtx_tm_add_inner_resolved(rt, &repo[r].pat, repo, nrepo,
                                                 depth + 1);
            }
        }
        return 1;
    }
    if (!rtx_tm_add_inner(rt, p)) return 0;
    idx = rt->inners.len - 1;
    if (rtx_tm_op_span(rt->inners.data[idx].op)) {
        if (!rtx_tm_attach_inners(rt, idx, p, repo, nrepo, depth)) return 0;
    }
    return 1;
}

static int rtx_tm_flatten(RtxTmRt *rt, const RtxTmPat *src, size_t nsrc,
                          const RtxTmRepoEnt *repo, size_t nrepo, int depth) {
    size_t i;
    if (depth > 8) return 0;
    for (i = 0; i < nsrc; i++) {
        const RtxTmPat *p = &src[i];
        int is_span = p->begin && p->begin[0] && p->end && p->end[0];
        if (p->incl && p->incl[0] == '#' && p->incl[1] && !is_span) {
            size_t r;
            int found = 0;
            for (r = 0; r < nrepo; r++) {
                if (repo[r].key && rtx_cstr_eq(repo[r].key, p->incl + 1)) {
                    if (!rtx_tm_flatten(rt, &repo[r].pat, 1, repo, nrepo,
                                        depth + 1)) {
                        return 0;
                    }
                    found = 1;
                    break;
                }
            }
            (void)found;
            continue;
        }
        if (!rtx_tm_cur) return 0;
        {
            size_t before = rt->rules.len;
            RtxTmPat *stable;
            if (rtx_tm_cur->pats.push(*p) != 0) return 0;
            stable = &rtx_tm_cur->pats.data[rtx_tm_cur->pats.len - 1];
            if (!rtx_tm_add_lowered(rt, stable)) return 0;
            if (rt->rules.len == before) {
                size_t k;
                for (k = 0; k < p->n_kids; k++) {
                    if (!rtx_tm_flatten(rt, &rtx_tm_cur->kids.data[p->kid0 + k], 1,
                                        repo, nrepo, depth + 1)) {
                        return 0;
                    }
                }
                continue;
            }
            {
                RtxTmRule *last = &rt->rules.data[rt->rules.len - 1];
                rtx_tm_bind_rule(last, stable);
                if (!rtx_tm_intern_caps(last, stable)) return 0;
                rtx_tm_rule_finish(last);
                if (rtx_tm_op_span(last->op)) {
                    size_t last_i = rt->rules.len - 1;
                    size_t inner0 = rt->inners.len;
                    size_t k;
                    last->inner0 = inner0;
                    if (p->incl && p->incl[0] && p->incl[0] != '#') {
                        last->embed_scope = p->incl;
                    }
                    if (p->incl && p->incl[0] == '#' && p->incl[1]) {
                        size_t r;
                        for (r = 0; r < nrepo; r++) {
                            if (repo[r].key &&
                                rtx_cstr_eq(repo[r].key, p->incl + 1)) {
                                if (!rtx_tm_add_inner_resolved(
                                        rt, &repo[r].pat, repo, nrepo, 1)) {
                                    return 0;
                                }
                                break;
                            }
                        }
                    }
                    for (k = 0; k < p->n_kids; k++) {
                        const RtxTmPat *kid = &rtx_tm_cur->kids.data[p->kid0 + k];
                        if (rtx_cstr_eq_lit(kid->incl, "$self")) {
                            rt->rules.data[last_i].self_in = 1;
                            continue;
                        }
                        if (!rtx_tm_add_inner_resolved(rt, kid, repo, nrepo, 1)) {
                            return 0;
                        }
                    }
                    rt->rules.data[last_i].innern = rt->inners.len - inner0;
                } else if (last->block && p->incl && p->incl[0] && p->incl[0] != '#') {
                    last->embed_scope = p->incl; /* block-pass guest (HTML, YAML) */
                }
            }
        }
    }
    return 1;
}

static int rtx_tm_load_json(const char *json, size_t n, RtxTmLang *lang) {
    RtxJw j;
    CCArena load = {0};
    Vec::[RtxTmPat] top = {0};
    Vec::[RtxTmRepoEnt] repo = {0};
    int ok = 0;
    if (!json || !lang) return 0;
    if (!rtx_tm_lang_plant(lang)) return 0;
    load = cc_arena_heap(kilobytes(16));
    if (!load.base) return 0;
    top = vec_new::[RtxTmPat](load);
    repo = vec_new::[RtxTmRepoEnt](load);
    if (!top.data || !repo.data) {
        load.destroy();
        return 0;
    }
    rtx_tm_cur = lang;
    j.s = json;
    j.n = n;
    j.i = 0;
    if (!rtx_jw_eat(&j, '{')) goto done;
    rtx_jw_ws(&j);
    if (rtx_jw_eat(&j, '}')) {
        ok = 1;
        goto done;
    }
    for (;;) {
        char key[32];
        if (!rtx_jw_string(&j, key, sizeof key) || !rtx_jw_eat(&j, ':')) goto done;
        /* name / scopeName / fileTypes: a lang registered by the scan
         * already holds them, and lookups on other threads read them
         * while this load runs — parsed, not rewritten. */
        if (rtx_cstr_eq_lit(key, "name")) {
            char title[128];
            if (!rtx_jw_string(&j, title, sizeof title)) goto done;
            if (!lang->meta) lang->rt.title = rtx_tm_intern(title);
        } else if (rtx_cstr_eq_lit(key, "scopeName")) {
            char scope[128];
            if (!rtx_jw_string(&j, scope, sizeof scope)) goto done;
            if (!lang->meta) lang->rt.scope = rtx_tm_intern(scope);
        } else if (rtx_cstr_eq_lit(key, "fileTypes")) {
            if (!rtx_jw_eat(&j, '[')) goto done;
            rtx_jw_ws(&j);
            if (!rtx_jw_eat(&j, ']')) {
                for (;;) {
                    char ext[16];
                    if (!rtx_jw_string(&j, ext, sizeof ext)) goto done;
                    if (!lang->meta && lang->rt.n_exts < 16) {
                        strncpy(lang->rt.exts[lang->rt.n_exts], ext, 15);
                        lang->rt.exts[lang->rt.n_exts][15] = 0;
                        lang->rt.n_exts++;
                    }
                    rtx_jw_ws(&j);
                    if (rtx_jw_eat(&j, ']')) break;
                    if (!rtx_jw_eat(&j, ',')) goto done;
                }
            }
        } else if (rtx_cstr_eq_lit(key, "patterns")) {
            if (!rtx_jw_eat(&j, '[')) goto done;
            rtx_jw_ws(&j);
            if (!rtx_jw_eat(&j, ']')) {
                for (;;) {
                    RtxTmPatRaw raw;
                    RtxTmPat slim;
                    if (!rtx_jw_pattern(&j, &raw)) goto done;
                    if (!rtx_tm_pat_from_raw(&raw, &slim)) goto done;
                    if (top.push(slim) != 0) goto done;
                    rtx_jw_ws(&j);
                    if (rtx_jw_eat(&j, ']')) break;
                    if (!rtx_jw_eat(&j, ',')) goto done;
                }
            }
        } else if (rtx_cstr_eq_lit(key, "repository")) {
            if (!rtx_jw_eat(&j, '{')) goto done;
            rtx_jw_ws(&j);
            if (!rtx_jw_eat(&j, '}')) {
                for (;;) {
                    char rkey[64];
                    RtxTmPatRaw raw;
                    RtxTmRepoEnt ent;
                    if (!rtx_jw_string(&j, rkey, sizeof rkey)) goto done;
                    if (!rtx_jw_eat(&j, ':')) goto done;
                    if (!rtx_jw_pattern(&j, &raw)) goto done;
                    ent.key = rtx_tm_intern(rkey);
                    if (!ent.key || !rtx_tm_pat_from_raw(&raw, &ent.pat)) goto done;
                    if (repo.push(ent) != 0) goto done;
                    rtx_jw_ws(&j);
                    if (rtx_jw_eat(&j, '}')) break;
                    if (!rtx_jw_eat(&j, ',')) goto done;
                }
            }
        } else if (rtx_cstr_eq_lit(key, "cctext")) {
            if (!rtx_jw_cctext_lang(&j, &lang->rt)) goto done;
        } else if (rtx_cstr_eq_lit(key, "autoClosingPairs")) {
            if (!rtx_jw_auto_pairs(&j, &lang->rt)) goto done;
        } else if (!rtx_jw_skip(&j)) {
            goto done;
        }
        rtx_jw_ws(&j);
        if (rtx_jw_eat(&j, '}')) break;
        if (!rtx_jw_eat(&j, ',')) goto done;
    }
    ok = rtx_tm_flatten(&lang->rt, top.data, top.len, repo.data, repo.len, 0);
    if (ok) {
        size_t r;
        int k;
        for (k = 0; k < RTX_MDB_ROLE_N; k++) lang->rt.blk[k] = -1;
        for (r = lang->rt.rules.len; r > 0; r--) {
            unsigned char role = lang->rt.rules.data[r - 1].block;
            if (role && role < RTX_MDB_ROLE_N && r - 1 < 0x7fff)
                lang->rt.blk[role] = (short)(r - 1);
        }
    }
done:
    rtx_tm_cur = NULL;
    load.destroy();
    return ok;
}

/* Registry scan: only name / scopeName / fileTypes (what the lookups
 * match on); the rest is skipped, not lowered or compiled. */
static int rtx_tm_meta_json(const char *json, size_t n, RtxTmLang *lang) {
    RtxJw j;
    if (!json || !lang) return 0;
    j.s = json;
    j.n = n;
    j.i = 0;
    if (!rtx_jw_eat(&j, '{')) return 0;
    rtx_jw_ws(&j);
    if (rtx_jw_eat(&j, '}')) return 1;
    for (;;) {
        char key[32];
        if (!rtx_jw_string(&j, key, sizeof key) || !rtx_jw_eat(&j, ':')) return 0;
        if (rtx_cstr_eq_lit(key, "name")) {
            char title[128];
            if (!rtx_jw_string(&j, title, sizeof title)) return 0;
            lang->rt.title = rtx_tm_intern(title);
        } else if (rtx_cstr_eq_lit(key, "scopeName")) {
            char scope[128];
            if (!rtx_jw_string(&j, scope, sizeof scope)) return 0;
            lang->rt.scope = rtx_tm_intern(scope);
        } else if (rtx_cstr_eq_lit(key, "fileTypes")) {
            if (!rtx_jw_eat(&j, '[')) return 0;
            rtx_jw_ws(&j);
            if (!rtx_jw_eat(&j, ']')) {
                for (;;) {
                    char ext[16];
                    if (!rtx_jw_string(&j, ext, sizeof ext)) return 0;
                    if (lang->rt.n_exts < 16) {
                        strncpy(lang->rt.exts[lang->rt.n_exts], ext, 15);
                        lang->rt.exts[lang->rt.n_exts][15] = 0;
                        lang->rt.n_exts++;
                    }
                    rtx_jw_ws(&j);
                    if (rtx_jw_eat(&j, ']')) break;
                    if (!rtx_jw_eat(&j, ',')) return 0;
                }
            }
        } else if (!rtx_jw_skip(&j)) {
            return 0;
        }
        rtx_jw_ws(&j);
        if (rtx_jw_eat(&j, '}')) break;
        if (!rtx_jw_eat(&j, ',')) return 0;
    }
    lang->meta = 1;
    return 1;
}

/* meta: the scan's metadata parse; else the full load (rules, regex). */
static int rtx_tm_load_path(const char *path, RtxTmLang *lang, int meta) {
    FILE *fp;
    long sz;
    if (!path || !lang) return 0;
    fp = fopen(path, "rb");
    if (!fp) return 0;
    if (fseek(fp, 0, SEEK_END) != 0) {
        fclose(fp);
        return 0;
    }
    sz = ftell(fp);
    if (sz <= 0) {
        fclose(fp);
        return 0;
    }
    rewind(fp);
    {
        CCArena store = cc_arena_heap((size_t)sz + 64) @destroy;
        char *buf;
        if (!store.base) {
            fclose(fp);
            return 0;
        }
        buf = (char *)cc_arena_alloc(store, (size_t)sz + 1, 1);
        if (!buf) {
            fclose(fp);
            return 0;
        }
        if (fread(buf, 1, (size_t)sz, fp) != (size_t)sz) {
            fclose(fp);
            return 0;
        }
        fclose(fp);
        buf[sz] = 0;
        if (meta) return rtx_tm_meta_json(buf, (size_t)sz, lang);
        return rtx_tm_load_json(buf, (size_t)sz, lang);
    }
}

static int rtx_tm_langs_ensure(void) {
    if (rtx_tm_langs.data) return 1;
    if (!rtx_tm_store_init()) return 0;
    rtx_tm_langs = vec_new::[RtxTmLang](rtx_tm_store);
    if (!rtx_tm_langs.data) return 0;
    return rtx_tm_langs.reserve(64) == 0;
}

/* Registers the grammar from its metadata; its rules load on first use
 * (rtx_tm_lang_ensure). */
static int rtx_tm_reg_add_path(const char *path) {
    RtxTmLang lang = {0};
    if (!rtx_tm_load_path(path, &lang, 1)) return 0;
    lang.src = rtx_tm_intern(path);
    if (!lang.src) return 0;
    if (!rtx_tm_langs_ensure()) return 0;
    if (rtx_tm_langs.push(lang) != 0) return 0;
    rtx_tm_nlangs = rtx_tm_langs.len;
    return 1;
}

static long rtx_tm_us_since(const struct timespec *a) {
    struct timespec b;
    clock_gettime(CLOCK_MONOTONIC, &b);
    return (long)((b.tv_sec - a->tv_sec) * 1000000L + (b.tv_nsec - a->tv_nsec) / 1000L);
}

/* 1 when lang i is loaded (now or before); 0 when its full load failed —
 * a lookup then goes on as if the scan had never listed it. */
static int rtx_tm_lang_ensure(size_t i) {
    RtxTmLang *l;
    int ok;
    if (i >= rtx_tm_langs.len) return 0;
    l = &rtx_tm_langs.data[i];
    if (__atomic_load_n(&l->ready, __ATOMIC_ACQUIRE)) return 1;
    if (__atomic_load_n(&l->failed, __ATOMIC_ACQUIRE)) return 0;
    pthread_mutex_lock(&rtx_tm_load_mu);
    if (l->ready) {
        ok = 1;
    } else if (l->failed) {
        ok = 0;
    } else {
        struct timespec a;
        clock_gettime(CLOCK_MONOTONIC, &a);
        ok = rtx_tm_load_path(l->src, l, 0);
        rtx_tm_load_us += (size_t)rtx_tm_us_since(&a);
        if (ok) {
            rtx_tm_nready++;
            __atomic_store_n(&l->ready, 1, __ATOMIC_RELEASE);
        } else {
            __atomic_store_n(&l->failed, 1, __ATOMIC_RELEASE);
        }
    }
    pthread_mutex_unlock(&rtx_tm_load_mu);
    return ok;
}

static int rtx_tm_lang_dead(size_t i) {
    return __atomic_load_n(&rtx_tm_langs.data[i].failed, __ATOMIC_ACQUIRE);
}

static int rtx_tm_is_tmlang(const char *name) {
    const char *suf = ".tmLanguage.json";
    if (!name) return 0;
    {
        CCSlice nm = cc_slice_cstr(name);
        CCSlice sf = cc_slice_cstr(suf);
        return nm.len > sf.len && nm.ends_with(sf);
    }
}

static size_t rtx_tm_reg_load_dir(const char *dir) {
    DIR *d;
    struct dirent *e;
    size_t added = 0;
    if (!dir || !dir[0]) return 0;
    d = opendir(dir);
    if (!d) return 0;
    while ((e = readdir(d))) {
        char path[512];
        int n;
        if (!rtx_tm_is_tmlang(e->d_name)) continue;
        n = snprintf(path, sizeof path, "%s/%s", dir, e->d_name);
        if (n < 0 || (size_t)n >= sizeof path) continue;
        if (rtx_tm_reg_add_path(path)) added++;
    }
    closedir(d);
    return added;
}

static int rtx_tm_copy_path(char *dst, size_t cap, const char *src) {
    size_t n;
    if (!dst || !src || cap == 0) return 0;
    n = cc_slice_cstr(src).len;
    if (n + 1 > cap) return 0;
    {
        char[:] d = cc_slice_from_buffer(dst, n + 1);
        char[:] s = cc_slice_from_buffer((void *)src, n + 1);
        d.copy(s) !>(e) { (void)e; return 0; };
    }
    return 1;
}

static int rtx_tm_exe_dir(char *dst, size_t cap) {
    char exe[PATH_MAX];
    char *slash;
#ifdef __APPLE__
    char raw[PATH_MAX];
    uint32_t n = (uint32_t)sizeof raw;
    if (_NSGetExecutablePath(raw, &n) != 0) return 0;
    if (!realpath(raw, exe)) return 0;
#else
    ssize_t n = readlink("/proc/self/exe", exe, sizeof exe - 1);
    if (n <= 0) return 0;
    exe[n] = 0;
#endif
    slash = strrchr(exe, '/');
    if (!slash || slash == exe) return 0;
    *slash = 0;
    return rtx_tm_copy_path(dst, cap, exe);
}

static int rtx_tm_dir_has_tmlang(const char *dir) {
    DIR *d;
    struct dirent *e;
    if (!dir || !dir[0]) return 0;
    d = opendir(dir);
    if (!d) return 0;
    while ((e = readdir(d))) {
        if (rtx_tm_is_tmlang(e->d_name)) {
            closedir(d);
            return 1;
        }
    }
    closedir(d);
    return 0;
}

static int rtx_tm_store_dir(char *dst, size_t cap, const char *path) {
    char resolved[PATH_MAX];
    if (realpath(path, resolved)) return rtx_tm_copy_path(dst, cap, resolved);
    return rtx_tm_copy_path(dst, cap, path);
}

static int rtx_tm_pick_dir(char *dst, size_t cap) {
    const char *env = getenv("RTX_GRAMMARS");
    char exe[PATH_MAX];
    char cand[PATH_MAX];
    int n;
    if (env && env[0]) return rtx_tm_store_dir(dst, cap, env);
    if (!rtx_tm_exe_dir(exe, sizeof exe)) return 0;
    n = snprintf(cand, sizeof cand, "%s/grammars", exe);
    if (n > 0 && (size_t)n < sizeof cand && rtx_tm_dir_has_tmlang(cand)) {
        return rtx_tm_store_dir(dst, cap, cand);
    }
    n = snprintf(cand, sizeof cand, "%s/../testdata/grammars", exe);
    if (n > 0 && (size_t)n < sizeof cand && rtx_tm_dir_has_tmlang(cand)) {
        return rtx_tm_store_dir(dst, cap, cand);
    }
    n = snprintf(cand, sizeof cand, "%s/grammars", exe);
    if (n <= 0 || (size_t)n >= sizeof cand) return 0;
    return rtx_tm_store_dir(dst, cap, cand);
}

/* Scan once: every grammar is listed from its metadata; none is lowered
 * or compiled until a document needs it. */
static void rtx_tm_reg_init(void) {
    struct timespec a;
    if (__atomic_load_n(&rtx_tm_reg_ready, __ATOMIC_ACQUIRE)) return;
    pthread_mutex_lock(&rtx_tm_load_mu);
    if (!rtx_tm_reg_ready) {
        if (!rtx_tm_pick_dir(rtx_tm_load_dir, sizeof rtx_tm_load_dir)) {
            rtx_tm_load_dir[0] = 0;
        }
        clock_gettime(CLOCK_MONOTONIC, &a);
        rtx_tm_load_files = rtx_tm_reg_load_dir(rtx_tm_load_dir);
        rtx_tm_load_us += (size_t)rtx_tm_us_since(&a);
        __atomic_store_n(&rtx_tm_reg_ready, 1, __ATOMIC_RELEASE);
    }
    pthread_mutex_unlock(&rtx_tm_load_mu);
}

static int rtx_tm_ext_ok(const RtxTmRt *rt, const char *ext) {
    size_t i;
    if (!rt || !ext || rt->n_exts == 0) return 0;
    for (i = 0; i < rt->n_exts; i++) {
        if (rtx_cstr_eq(rt->exts[i], ext)) return 1;
    }
    return 0;
}

static int rtx_tm_ext_plain(const char *ext) {
    return ext && rtx_cstr_eq_lit(ext, "txt");
}

static RtxTmRt *rtx_tm_rt_for_ext(const char *ext) {
    size_t i;
    if (!ext || rtx_tm_ext_plain(ext)) return NULL;
    rtx_tm_reg_init();
    for (i = 0; i < rtx_tm_langs.len; i++) {
        if (!rtx_tm_lang_dead(i) &&
            rtx_tm_ext_ok(&rtx_tm_langs.data[i].rt, ext) &&
            rtx_tm_lang_ensure(i)) {
            return &rtx_tm_langs.data[i].rt;
        }
    }
    return NULL;
}

/* Same match as rtx_tm_rt_for_ext, without loading the grammar (browse
 * listings tint extensions for every entry). */
static int rtx_tm_ext_listed(const char *ext) {
    size_t i;
    if (!ext || rtx_tm_ext_plain(ext)) return 0;
    rtx_tm_reg_init();
    for (i = 0; i < rtx_tm_langs.len; i++) {
        if (!rtx_tm_lang_dead(i) && rtx_tm_ext_ok(&rtx_tm_langs.data[i].rt, ext))
            return 1;
    }
    return 0;
}

RtxTmRt *rtx_tm_c_rt(void) {
    return rtx_tm_rt_for_ext("c");
}

RtxTmRt *rtx_tm_json_rt(void) {
    return rtx_tm_rt_for_ext("json");
}

RtxTmRt *rtx_tm_md_rt(void) {
    return rtx_tm_rt_for_ext("md");
}

const RtxTmRt *rtx_tm_for_path(const char *path) {
    const char *dot;
    if (!path) return NULL;
    dot = strrchr(path, '.');
    if (!dot || !dot[1]) return NULL;
    return rtx_tm_rt_for_ext(dot + 1);
}

static int rtx_tm_memieq(const char *a, size_t an, const char *b) {
    size_t i, bn;
    if (!a || !b) return 0;
    bn = cc_slice_cstr(b).len;
    if (an != bn) return 0;
    for (i = 0; i < an; i++) {
        unsigned char ca = (unsigned char)a[i];
        unsigned char cb = (unsigned char)b[i];
        if (ca >= 'A' && ca <= 'Z') ca = (unsigned char)(ca - 'A' + 'a');
        if (cb >= 'A' && cb <= 'Z') cb = (unsigned char)(cb - 'A' + 'a');
        if (ca != cb) return 0;
    }
    return 1;
}

static size_t rtx_tm_lang_id(const RtxTmRt *rt) {
    size_t i;
    if (!rt) return (size_t)RTX_TM_NO_LANG;
    for (i = 0; i < rtx_tm_langs.len; i++) {
        if (&rtx_tm_langs.data[i].rt == rt) return i;
    }
    return (size_t)RTX_TM_NO_LANG;
}

static const RtxTmRt *rtx_tm_rt_at(size_t id) {
    if (id >= rtx_tm_langs.len) return NULL;
    return &rtx_tm_langs.data[id].rt;
}

/* Rule index (inners flagged RTX_TM_INNER), or RTX_RUN_NO_RULE. */
static size_t rtx_tm_rule_tag(const RtxTmRt *rt, const RtxTmRule *rule) {
    size_t i;
    if (!rt || !rule) return (size_t)RTX_RUN_NO_RULE;
    if (rt->rules.data && rule >= rt->rules.data &&
        rule < rt->rules.data + rt->rules.len) {
        i = (size_t)(rule - rt->rules.data);
        if (i < (size_t)RTX_TM_INNER) return i;
    }
    if (rt->inners.data && rule >= rt->inners.data &&
        rule < rt->inners.data + rt->inners.len) {
        i = (size_t)(rule - rt->inners.data) | (size_t)RTX_TM_INNER;
        if (i < (size_t)RTX_RUN_NO_RULE) return i;
    }
    return (size_t)RTX_RUN_NO_RULE;
}

static RtxTmRule *rtx_tm_rule_from_tag(const RtxTmRt *rt, size_t tag) {
    size_t i;
    if (!rt || tag == (size_t)RTX_RUN_NO_RULE) return NULL;
    if (tag & (size_t)RTX_TM_INNER) {
        i = tag & ~(size_t)RTX_TM_INNER;
        if (i < rt->inners.len) return &rt->inners.data[i];
        return NULL;
    }
    if (tag < rt->rules.len) return &rt->rules.data[tag];
    return NULL;
}

static unsigned char rtx_tm_planter(const RtxTmRt *host, const RtxTmRt *rt) {
    if (host && rt && host != rt) return (unsigned char)RTX_RUN_INJECT;
    return (unsigned char)RTX_RUN_TM;
}

static size_t rtx_tm_scope_lang(const char *scope) {
    size_t i;
    const RtxTmRt *rt;
    if (!scope || !scope[0]) return (size_t)RTX_TM_NO_LANG;
    rtx_tm_reg_init();
    rt = rtx_tm_rt_for_scope(scope);
    if (!rt) return (size_t)RTX_TM_NO_LANG;
    i = rtx_tm_lang_id(rt);
    return i;
}

const RtxTmRt *rtx_tm_rt_for_scope(const char *scope) {
    size_t i;
    if (!scope || !scope[0]) return NULL;
    rtx_tm_reg_init();
    for (i = 0; i < rtx_tm_langs.len; i++) {
        const char *s = rtx_tm_langs.data[i].rt.scope;
        if (rtx_tm_lang_dead(i)) continue;
        if (s && rtx_cstr_eq(s, scope) && rtx_tm_lang_ensure(i))
            return &rtx_tm_langs.data[i].rt;
    }
    return NULL;
}

const RtxTmRt *rtx_tm_rt_for_info(const char *s, size_t n) {
    size_t i, lo, hi;
    if (!s || n == 0) return NULL;
    lo = 0;
    hi = n;
    while (lo < hi && (s[lo] == ' ' || s[lo] == '\t')) lo++;
    while (hi > lo && (s[hi - 1] == ' ' || s[hi - 1] == '\t' || s[hi - 1] == '\r'))
        hi--;
    i = lo;
    while (i < hi && s[i] != ' ' && s[i] != '\t') i++;
    hi = i;
    n = hi - lo;
    if (n == 0) return NULL;
    s += lo;
    rtx_tm_reg_init();
    for (i = 0; i < rtx_tm_langs.len; i++) {
        const RtxTmRt *rt = &rtx_tm_langs.data[i].rt;
        size_t e;
        const char *dot;
        int hit = 0;
        if (rtx_tm_lang_dead(i)) continue;
        if (rt->title && rtx_tm_memieq(s, n, rt->title)) hit = 1;
        if (!hit && rt->scope && rtx_tm_memieq(s, n, rt->scope)) hit = 1;
        if (!hit && rt->scope) {
            dot = strrchr(rt->scope, '.');
            if (dot && dot[1] && rtx_tm_memieq(s, n, dot + 1)) hit = 1;
        }
        for (e = 0; !hit && e < rt->n_exts; e++) {
            if (rtx_tm_memieq(s, n, rt->exts[e])) hit = 1;
        }
        if (hit && rtx_tm_lang_ensure(i)) return rt;
    }
    return NULL;
}

static size_t rtx_tm_info_lang(const char *s, size_t n) {
    const RtxTmRt *rt = rtx_tm_rt_for_info(s, n);
    return rtx_tm_lang_id(rt);
}

int rtx_tm_ext_span(const char *name, size_t *off, size_t *n) {
    const char *base;
    const char *dot;
    const char *slash;
    if (off) *off = 0;
    if (n) *n = 0;
    if (!name || !name[0]) return 0;
    slash = strrchr(name, '/');
    base = slash ? slash + 1 : name;
    dot = strrchr(base, '.');
    if (!dot || !dot[1] || dot == base) return 0;
    if (!rtx_tm_ext_listed(dot + 1)) return 0;
    if (off) *off = (size_t)(dot - name);
    if (n) *n = cc_slice_cstr(dot).len;
    return 1;
}

static int rtx_hl_ident_start(char c) {
    return (c >= 'A' && c <= 'Z') || (c >= 'a' && c <= 'z') || c == '_';
}

static int rtx_hl_ident(char c) {
    return rtx_hl_ident_start(c) || (c >= '0' && c <= '9');
}

static int rtx_hl_is_keyword(const char *s, size_t n) {
    static const char *kws[] = {
        "int", "void", "return", "if", "else", "for", "while", "do",
        "struct", "typedef", "static", "const", "char", "size_t",
        "unsigned", "long", "short", "enum", "union", "sizeof",
        "break", "continue", "switch", "case", "default", "goto",
        "extern", "inline", "bool", "true", "false", "NULL",
        "include", "define", "ifdef", "ifndef", "endif", "pragma",
        NULL
    };
    size_t i;
    /* Keywords are 2..8 bytes; first byte before a strlen per entry. */
    if (n < 2 || n > 8) return 0;
    for (i = 0; kws[i]; i++) {
        char[:] kw = cc_slice_from_buffer((void *)s, n);
        if (kws[i][0] != s[0]) continue;
        if (kw.eq_cstr(kws[i])) return 1;
    }
    return 0;
}

static int rtx_hl_add_scope(RtxDoc *d, size_t start, size_t len, size_t emit_from,
                            RtxScope scope) {
    RtxStyle st = {0};
    size_t end;
    if (!d || len == 0 || scope == RTX_SCOPE_NONE) return 1;
    end = start + len;
    if (end <= emit_from) return 1;
    if (start < emit_from) {
        len = end - emit_from;
        start = emit_from;
    }
    st.scope = scope;
    return rtx_doc_add_run(d, start, len, st, RTX_RUN_TM);
}

static void rtx_doc_hl_abort(RtxDoc *d) {
    size_t i;
    size_t o = 0;
    if (!d) return;
    rtx_doc_run_top_drop(d);
    for (i = 0; i < d->runs.len; i++) {
        RtxRun r = d->runs.data[i];
        if (rtx_run_planted_tm(r)) continue;
        d->runs.data[o++] = r;
    }
    {
        d->runs.truncate(o);
        d->runs_sorted = 0;
        d->tm_ckpt.clear();
    }
    for (i = 0; i < d->secs.len; i++) d->secs.data[i].hl_done = 0;
    d->hl_full = 0;
}

void !>(RtxIndexErr) RtxDoc_select_word(RtxDoc *d, size_t off) {
    size_t a, lo, hi, n;
    RtxUtf8Cl cl;
    int have, cls;
    @errhandler(CCError e) {
        return cc_err(rtx_index_from_cc(e));
    }
    if (!d) return cc_ok();
    n = d->len();
    if (off > n) off = n;
    have = rtx_doc_cluster_at(d, off, &a, &cl) !>;
    if (!have) {
        if (n == 0) {
            d->sel_anchor = 0;
            d->caret = 0;
            d->sel_box = 0;
            d->break_coalesce();
            return cc_ok();
        }
        off = d->cluster_prev(n) !>;
        have = rtx_doc_cluster_at(d, off, &a, &cl) !>;
        if (!have) return cc_ok();
    }
    if (cl.cp == '\n' || cl.cp == '\r') {
        d->sel_anchor = a;
        d->caret = a + cl.n;
        d->sel_box = 0;
        d->break_coalesce();
        return cc_ok();
    }
    cls = rtx_utf8_click_class(cl.cp);
    lo = a;
    hi = a + (cl.n ? cl.n : 1);
    while (lo > 0) {
        size_t p = d->cluster_prev(lo) !>;
        RtxUtf8Cl pcl;
        size_t ps;
        if (!rtx_doc_cluster_at(d, p, &ps, &pcl) !>) break;
        if (pcl.cp == '\n' || pcl.cp == '\r') break;
        if (rtx_utf8_click_class(pcl.cp) != cls) break;
        lo = ps;
    }
    while (hi < n) {
        RtxUtf8Cl ncl;
        size_t ns;
        if (!rtx_doc_cluster_at(d, hi, &ns, &ncl) !>) break;
        if (ncl.cp == '\n' || ncl.cp == '\r') break;
        if (rtx_utf8_click_class(ncl.cp) != cls) break;
        hi = ns + (ncl.n ? ncl.n : 1);
    }
    d->sel_anchor = lo;
    d->caret = hi;
    d->sel_box = 0;
    d->break_coalesce();
    return cc_ok();
}

void !>(RtxIndexErr) RtxDoc_select_line(RtxDoc *d, size_t off) {
    size_t start, next;
    if (!d) return cc_ok();
    start = rtx_doc_line_floor(d, off) !>(e) { return cc_err(e); };
    rtx_doc_next_line_start(d, start, &next) !>(e) { return cc_err(e); };
    d->sel_anchor = start;
    d->caret = next;
    d->sel_box = 0;
    d->break_coalesce();
    return cc_ok();
}

size_t !>(RtxIndexErr) rtx_doc_line_end_caret(const RtxDoc *d, size_t off) {
    size_t start, next;
    int has;
    if (!d) return cc_ok((size_t)0);
    start = rtx_doc_line_floor(d, off) !>(e) { return cc_err(e); };
    has = rtx_doc_next_line_start(d, start, &next) !>(e) { return cc_err(e); };
    if (has) return cc_ok(next - 1);
    return cc_ok(next);
}

static size_t !>(RtxIndexErr) rtx_doc_line_nlen_at(const RtxDoc *d, size_t ls) {
    size_t e;
    if (!d) return cc_ok((size_t)0);
    e = rtx_doc_line_end_caret(d, ls) !>(e) { return cc_err(e); };
    return cc_ok(e - ls);
}

static size_t !>(RtxIndexErr) rtx_box_col_at(const RtxDoc *d, size_t ls, size_t col) {
    size_t n = rtx_doc_line_nlen_at(d, ls) !>(e) { return cc_err(e); };
    if (col == RTX_COL_EOL || col > n) return cc_ok(n);
    return cc_ok(col);
}

static void !>(RtxIndexErr) rtx_box_span_at(const RtxDoc *d, size_t ls, size_t *a, size_t *b) {
    size_t n, lo, hi;
    n = rtx_doc_line_nlen_at(d, ls) !>(e) { return cc_err(e); };
    lo = d->box_acol;
    hi = d->box_ccol;
    if (lo > hi) {
        size_t t = lo;
        lo = hi;
        hi = t;
    }
    if (lo == RTX_COL_EOL) lo = n;
    if (hi == RTX_COL_EOL) hi = n;
    if (lo > n) lo = n;
    if (hi > n) hi = n;
    *a = lo;
    *b = hi;
    return cc_ok();
}

static void !>(RtxIndexErr) rtx_doc_box_floors(const RtxDoc *d, size_t *lo, size_t *hi) {
    size_t a, c;
    if (!d) {
        if (lo) *lo = 0;
        if (hi) *hi = 0;
        return cc_ok();
    }
    a = rtx_doc_line_floor(d, d->sel_anchor) !>(e) { return cc_err(e); };
    c = rtx_doc_line_floor(d, d->caret) !>(e) { return cc_err(e); };
    if (lo) *lo = a < c ? a : c;
    if (hi) *hi = a > c ? a : c;
    return cc_ok();
}

int !>(RtxIndexErr) RtxDoc_sel_covers(const RtxDoc *d, size_t off) {
    size_t ls, lo, hi, a, b, col;
    if (!d || !d->has_sel()) return cc_ok(0);
    if (!d->sel_box) {
        return cc_ok(off >= d->sel_lo() && off < d->sel_hi() ? 1 : 0);
    }
    ls = rtx_doc_line_floor(d, off) !>(e) { return cc_err(e); };
    rtx_doc_box_floors(d, &lo, &hi) !>(e) { return cc_err(e); };
    if (ls < lo || ls > hi) return cc_ok(0);
    rtx_box_span_at(d, ls, &a, &b) !>(e) { return cc_err(e); };
    col = off - ls;
    return cc_ok(col >= a && col < b ? 1 : 0);
}

int !>(RtxIndexErr) RtxDoc_box_caret_at(const RtxDoc *d, size_t line_start,
                                       size_t *off) {
    size_t lo, hi, col;
    if (off) *off = 0;
    if (!d || !d->sel_box) return cc_ok(0);
    rtx_doc_box_floors(d, &lo, &hi) !>(e) { return cc_err(e); };
    if (line_start < lo || line_start > hi) return cc_ok(0);
    col = rtx_box_col_at(d, line_start, d->box_ccol) !>(e) { return cc_err(e); };
    if (off) *off = line_start + col;
    return cc_ok(1);
}

static void rtx_box_nth_part(char[:] ins, size_t idx, char[:] *out) {
    size_t i, start, n;
    *out = cc_slice_empty();
    if (!ins.ptr) return;
    start = 0;
    n = 0;
    for (i = 0; i <= ins.len; i++) {
        if (i == ins.len || ins.ptr[i] == '\n') {
            if (n == idx) {
                *out = cc_slice_from_buffer((char *)ins.ptr + start, i - start);
                return;
            }
            n++;
            start = i + 1;
        }
    }
}

static size_t rtx_box_part_count(char[:] ins) {
    size_t n;
    if (!ins.ptr || ins.len == 0) return 1;
    n = 1;
    @for (ch in ins) {
        if (ch == '\n') n++;
    }
    if (ins.ptr[ins.len - 1] == '\n' && n > 1) n--;
    return n;
}

void !>(RtxIndexErr) RtxDoc_move_line_edge(RtxDoc *d, int to_end, int shift) {
    size_t dest;
    if (!d) return cc_ok();
    if (to_end) dest = rtx_doc_line_end_caret(d, d->caret) !>(e) { return cc_err(e); };
    else dest = rtx_doc_line_floor(d, d->caret) !>(e) { return cc_err(e); };
    if (!shift) d->sel_anchor = dest;
    d->caret = dest;
    RtxDoc_break_coalesce(d);
    return cc_ok();
}

static int rtx_bytes_touch_section(char[:] p) {
    @for (ch in p) {
        if (ch == '=') return 1;
    }
    return 0;
}

static void rtx_hist_drop_tail(RtxHistory *h) {
    if (!h || h->head >= h->len) return;
    h->len = h->head;
}

/* Coalesce only a pure insert onto a pure insert, or a pure erase onto a
 * pure erase: the commit extends one side of the record. A replace that
 * deletes and inserts (join, apply, type-over) is always its own record. */
static int rtx_hist_can_coalesce_insert(const RtxHistRec *r, size_t off, size_t n,
                                        char[:] ins) {
    char[:] have;
    if (!r || ins.len == 0 || n != 0) return 0;
    if (r->group) return 0; /* typing never coalesces into a group */
    if (rtx_hist_del_is_pieces(r)) return 0;
    if (rtx_hist_del_view(r).len != 0) return 0;
    have = r->ins.as_slice();
    if (off != r->off + have.len) return 0;
    if (memchr(have.ptr, '\n', have.len) ||
        memchr(ins.ptr, '\n', ins.len))
        return 0;
    return 1;
}

static int rtx_hist_can_coalesce_erase(const RtxHistRec *r, size_t off, char[:] del,
                                       char[:] ins) {
    char[:] old;
    if (!r || del.len == 0 || ins.len != 0 || r->ins.len != 0) return 0;
    if (r->group) return 0;
    if (del.len > RTX_HIST_INLINE_MAX) return 0;
    if (rtx_hist_del_is_pieces(r)) return 0;
    old = rtx_hist_del_view(r);
    if (old.len + del.len > RTX_HIST_INLINE_MAX) return 0;
    if (off + del.len != r->off) return 0;
    if (memchr(old.ptr, '\n', old.len) ||
        memchr(del.ptr, '\n', del.len))
        return 0;
    return 1;
}

static char[:] rtx_hist_ins_view(const RtxHistRec *r) {
    char[:] sl;
    if (!r) return cc_slice_empty();
    sl = r->ins.as_slice();
    if (!sl.ptr || sl.len == 0) return cc_slice_empty();
    return sl;
}

char[:] rtx_hist_del_view(const RtxHistRec *r) {
    if (!r) return cc_slice_empty();
    @switch (r->del) {
        case .text: {
            Vec::[char] buf = r->del.text;
            return buf.as_slice();
        }
        case .pieces:
            return cc_slice_empty();
    }
    return cc_slice_empty();
}

static int rtx_fail_coalesce_commit;

static void !>(CCError) rtx_hist_coalesce_ins_commit(RtxHistRec *last, char[:] ins) {
    size_t base;
    char[:] dst;
    @errhandler(CCError e) { return cc_err(e); }
    if (rtx_fail_coalesce_commit) {
        rtx_fail_coalesce_commit = 0;
        return cc_err(CC_ERR_INTERNAL, "coalesce commit");
    }
    base = last->ins.len();
    dst = cc_slice_from_buffer(last->ins.data() + base, ins.len);
    dst.copy(ins) !>;
    if (!last->ins.at_grow(base + ins.len - 1))
        return cc_err(CC_ERR_OUT_OF_MEMORY, "coalesce ins len");
    return cc_ok();
}

static void !>(CCError) rtx_hist_coalesce_del_commit(RtxHistRec *last, char[:] del) {
    @errhandler(CCError e) { return cc_err(e); }
    if (rtx_fail_coalesce_commit) {
        rtx_fail_coalesce_commit = 0;
        return cc_err(CC_ERR_INTERNAL, "coalesce commit");
    }
    @switch (last->del) {
        case .text: {
            Vec::[char] *b = &last->del.text;
            char[:] used = b->as_slice();
            char[:] all = cc_slice_from_buffer(b->data(), b->cap());
            size_t n;
            {
                char[:] dst = all.sub(del.len, del.len + used.len);
                dst.copy_overlap(used) !>;
            }
            {
                char[:] head = all.sub(0, del.len);
                head.copy(del) !>;
            }
            n = used.len + del.len;
            if (!n || !b->at_grow(n - 1))
                return cc_err(CC_ERR_OUT_OF_MEMORY, "coalesce del len");
            return cc_ok();
        }
        case .pieces:
            return cc_err(CC_ERR_INTERNAL, "coalesce del arm");
    }
    return cc_err(CC_ERR_INTERNAL, "coalesce del arm");
}

static int !>(RtxIndexErr) rtx_doc_line_has_nl_at(const RtxDoc *d, size_t ls) {
    size_t e, next;
    int has;
    if (!d) return cc_ok(0);
    e = rtx_doc_line_end_caret(d, ls) !>(e) { return cc_err(e); };
    has = rtx_doc_next_line_start(d, ls, &next) !>(e) { return cc_err(e); };
    return cc_ok(has && next > e ? 1 : 0);
}

/* Edit relex: stale checkpoints past the edit, in offset order. The lex
 * stops at the first one it reaches in the same state (hit), where the old
 * lex's runs and later checkpoints are still right. */
typedef struct {
    const RtxTmCkpt *at;
    size_t n;
    size_t k;
    size_t hit; /* index into `at`, or (size_t)-1 */
    /* Frames open at the hit, outermost first: the old lex's run for each
     * goes on past it and takes this opener (not re-emitted here). */
    size_t osp;
    size_t orule[RTX_TM_STACK];
    size_t ooff[RTX_TM_STACK];
    unsigned char oalen[RTX_TM_STACK];
    unsigned char plant; /* flag for the checkpoints this relex plants */
} RtxTmConv;

/* A frame whose end reads its begin (\1-\9, \k<>, \G) or a prefix
 * frame (`cctext.bol` reads its opener) carries more than a checkpoint
 * keeps: never a seed, never a place to call two lexes equal. */
static int rtx_tm_frame_pos_bound(const RtxTmRt *rt, size_t lang, size_t tag) {
    const RtxTmRt *frt = rtx_tm_rt_at(lang);
    const RtxTmRule *fr;
    size_t k;
    if (!frt) frt = rt;
    fr = rtx_tm_rule_from_tag(frt, tag);
    if (!fr) return 1;
    if (rtx_tm_prefix(fr)) return 1;
    for (k = 0; fr->b && k + 1 < fr->blen; k++) {
        char c;
        if (fr->b[k] != '\\') continue;
        c = fr->b[k + 1];
        if ((c >= '1' && c <= '9') || c == 'k' || c == 'G') return 1;
        k++;
    }
    return 0;
}

static int rtx_tm_conv_eq(const RtxTmRt *rt, const RtxTmCkpt *c, size_t sp,
                          const size_t *rule, const size_t *lang,
                          const size_t *embed) {
    size_t k;
    if (sp > (size_t)RTX_TM_CKPT_DEPTH || sp != (size_t)RTX_TM_CKPT_N(c)) return 0;
    for (k = 0; k < sp; k++) {
        if (c->rule[k] != (unsigned short)rule[k] ||
            c->lang[k] != (unsigned short)lang[k] ||
            c->embed[k] != (unsigned short)embed[k])
            return 0;
        if (rtx_tm_frame_pos_bound(rt, lang[k], rule[k])) return 0;
    }
    return 1;
}

static void !>(CCError) rtx_tm_lex_walk(RtxDoc *d, const RtxTmRt *rt, char[:] src,
                                       size_t base, size_t emit_from,
                                       const RtxTmCkpt *seed, RtxTmWalk walk,
                                       RtxRxScratch *rxs, RtxTmConv *cv) {
    const char *buf;
    size_t n;
    size_t i = 0;
    size_t sp = 0;
    size_t stk_rule[RTX_TM_STACK];
    size_t stk_lang[RTX_TM_STACK];
    size_t stk_embed[RTX_TM_STACK];
    size_t stk_off[RTX_TM_STACK];
    size_t stk_cs[RTX_TM_STACK * RTX_TM_CAPS];
    size_t stk_ce[RTX_TM_STACK * RTX_TM_CAPS];
    size_t stk_g[RTX_TM_STACK];
    unsigned char stk_alen[RTX_TM_STACK];
    size_t next_stride, stride;
    /* A lookback lex plants too (WIN): an edit in its window relexes from
     * that state, which is what the same lex from its anchor gives. */
    unsigned char pflag = (walk == RTX_TM_LOOKBACK ||
                           (seed && (seed->n & RTX_TM_CKPT_WIN)) ||
                           (cv && cv->plant))
                              ? (unsigned char)RTX_TM_CKPT_WIN
                              : 0;
    int bol0 = 1;
    RtxTmWalkSt W;
    if (!d || !rt || !src.ptr || src.len == 0) return cc_ok();
    buf = src.ptr;
    n = src.len;
    if (base > 0) {
        char pc = 0;
        size_t got = d->read_at(base - 1, cc_slice_from_buffer(&pc, 1)) !>(e) { (void)e; return cc_ok(); };
        bol0 = (got == 1 && pc == '\n');
    }
    if (seed && RTX_TM_CKPT_N(seed)) {
        size_t k, lim;
        lim = RTX_TM_CKPT_N(seed) < (unsigned char)RTX_TM_STACK
                  ? RTX_TM_CKPT_N(seed)
                  : (unsigned char)RTX_TM_STACK;
        for (k = 0; k < lim; k++) {
            stk_rule[k] = seed->rule[k];
            stk_lang[k] = seed->lang[k];
            stk_embed[k] = seed->embed[k];
            stk_off[k] = 0; /* opener is behind the lex start: stk_alen 0 */
        }
        sp = lim;
    }
    W.d = d;
    W.host = rt;
    W.buf = buf;
    W.base = base;
    W.n = n;
    W.emit_from = emit_from;
    W.i = &i;
    W.sp = &sp;
    W.stk_rule = stk_rule;
    W.stk_lang = stk_lang;
    W.stk_embed = stk_embed;
    W.stk_off = stk_off;
    W.stk_cs = stk_cs;
    W.stk_ce = stk_ce;
    W.stk_g = stk_g;
    W.stk_alen = stk_alen;
    W.bol0 = bol0;
    W.rxs = rxs;
    W.eol_lo = 1;
    W.eol_hi = 0;
    W.md = 0;
    {
        size_t z;
        for (z = 0; z < (size_t)RTX_TM_STACK; z++) {
            stk_alen[z] = 0;
            stk_g[z] = RTX_RX_UNSET; /* a seeded frame has no begin here */
        }
        for (z = 0; z < (size_t)RTX_TM_STACK * (size_t)RTX_TM_CAPS; z++)
            stk_cs[z] = stk_ce[z] = RTX_RX_UNSET;
    }
    /* Window checkpoints are denser: an edit relexes from one 2 KiB back,
     * so the stride is most of what a keystroke lexes. */
    stride = pflag ? (size_t)RTX_TM_WIN_STRIDE : (size_t)RTX_TM_CKPT_STRIDE;
    next_stride = ((base / stride) + 1) * stride;
    if (cv) cv->hit = (size_t)-1;
    while (i < n) {
        if (cv) {
            while (cv->k < cv->n && cv->at[cv->k].off < base + i) cv->k++;
            if (cv->k < cv->n && cv->at[cv->k].off == base + i &&
                rtx_tm_conv_eq(rt, &cv->at[cv->k], sp, stk_rule, stk_lang,
                               stk_embed)) {
                size_t k;
                cv->hit = cv->k;
                cv->osp = sp;
                for (k = 0; k < sp; k++) {
                    const RtxTmRt *frt = rtx_tm_rt_at(stk_lang[k]);
                    const RtxTmRule *fr;
                    if (!frt) frt = rt;
                    fr = rtx_tm_rule_from_tag(frt, stk_rule[k]);
                    cv->orule[k] = stk_rule[k];
                    cv->ooff[k] = base + stk_off[k];
                    cv->oalen[k] =
                        fr && rtx_tm_hints(frt, fr, rtx_tm_planter(rt, frt))
                            ? stk_alen[k]
                            : 0;
                }
                n = i;
                break;
            }
        }
        if (sp > 0) {
            const RtxTmRt *frt = rtx_tm_rt_at(stk_lang[sp - 1]);
            RtxTmRule *fr;
            size_t guest = stk_embed[sp - 1];
            if (!frt) frt = rt;
            fr = rtx_tm_rule_from_tag(frt, stk_rule[sp - 1]);
            if (!fr) {
                sp--;
                continue;
            }
            if (fr->op == RTX_TM_LIT_SPAN && !rtx_tm_span_other_inner(frt, fr) &&
                guest == (size_t)RTX_TM_NO_LANG && !fr->info && !fr->embed_scope) {
                int t = rtx_tm_span_advance(&W, frt, fr);
                if (t < 0) return cc_err(CC_ERR_OUT_OF_MEMORY, "tm run");
                continue;
            }
            {
                size_t k;
                int inner_hit = 0;
                unsigned char plant_fr = rtx_tm_planter(rt, frt);
                if (fr->inl && rtx_tm_op_span(fr->op) && buf[i] == '\n') {
                    sp--; /* `cctext.inline`: unclosed at EOL, opener was text */
                    continue;
                }
                /* Closer first: italic's `*` must not steal bold's `**`, and
                 * a fence ``` / `</script>` must win over an unclosed guest.
                 * Flank keeps `*outer **inner**` from closing on the space
                 * before `**`, so the inner bold still opens. */
                {
                    size_t endn = fr->blen, ha;
                    if (rtx_tm_span_close(&W, fr, i, sp - 1, &endn)) {
                        size_t blen = endn;
                        size_t end;
                        ha = (size_t)stk_alen[sp - 1]; /* 0: seeded frame */
                        end = rtx_tm_span_end(fr, i, endn, &blen);
                        if (!rtx_tm_hints(frt, fr, plant_fr)) ha = blen = 0;
                        if (!rtx_tm_add_span(d, base + stk_off[sp - 1],
                                             base + end, emit_from, fr->scope,
                                             rtx_tm_rule_bits(fr), ha, blen,
                                             plant_fr, fr->mark,
                                             (unsigned short)rtx_tm_rule_tag(frt, fr))) {
                            return cc_err(CC_ERR_OUT_OF_MEMORY, "tm run");
                        }
                        i = end == i && blen == 0 ? i : end;
                        sp--;
                        continue;
                    }
                }
                if (guest != (size_t)RTX_TM_NO_LANG) {
                    const RtxTmRt *grt = rtx_tm_rt_at(guest);
                    if (grt) {
                        size_t r;
                        for (r = 0; r < grt->rules.len; r++) {
                            int t = rtx_tm_try_rule(&W, grt, &grt->rules.data[r],
                                                    1);
                            if (t < 0)
                                return cc_err(CC_ERR_OUT_OF_MEMORY, "tm run");
                            if (t > 0) {
                                inner_hit = 1;
                                break;
                            }
                        }
                    }
                    if (inner_hit) continue;
                }
                for (k = 0; k < fr->innern; k++) {
                    int t = rtx_tm_try_rule(&W, frt,
                                            &frt->inners.data[fr->inner0 + k], 1);
                    if (t < 0) return cc_err(CC_ERR_OUT_OF_MEMORY, "tm run");
                    if (t > 0) {
                        inner_hit = 1;
                        break;
                    }
                }
                if (inner_hit) continue;
                if (buf[i] == '\\' && i + 1 < n && buf[i + 1] != '\n') {
                    i += 2;
                    continue;
                }
                i++;
                continue;
            }
        }
        {
            size_t r;
            int hit = 0;
            for (r = 0; r < rt->rules.len; r++) {
                int t = rtx_tm_try_rule(&W, rt, &rt->rules.data[r], 1);
                if (t < 0) return cc_err(CC_ERR_OUT_OF_MEMORY, "tm run");
                if (t > 0) {
                    hit = 1;
                    break;
                }
            }
            if (!hit) i++;
        }
        if (base + i >= next_stride) {
            rtx_tm_ckpt_add(d, base + i, sp, stk_rule, stk_lang, stk_embed, pflag, NULL);
            next_stride += stride;
        }
    }
    rtx_tm_ckpt_add(d, base + n, sp, stk_rule, stk_lang, stk_embed, pflag, NULL);
    if (cv && cv->hit != (size_t)-1) sp = 0; /* the old lex closes these */
    while (sp > 0) {
        const RtxTmRt *frt = rtx_tm_rt_at(stk_lang[sp - 1]);
        RtxTmRule *fr;
        unsigned char plant_fr;
        if (!frt) frt = rt;
        fr = rtx_tm_rule_from_tag(frt, stk_rule[sp - 1]);
        plant_fr = rtx_tm_planter(rt, frt);
        if (fr && !rtx_tm_add_span(d, base + stk_off[sp - 1], base + n, emit_from,
                                   fr->scope, rtx_tm_rule_bits(fr),
                                   rtx_tm_hints(frt, fr, plant_fr)
                                       ? (size_t)stk_alen[sp - 1]
                                       : 0,
                                   0, plant_fr, fr->mark,
                                   (unsigned short)rtx_tm_rule_tag(frt, fr))) {
            return cc_err(CC_ERR_OUT_OF_MEMORY, "tm run");
        }
        sp--;
    }
    return cc_ok();
}

/* One lex call owns one matcher scratch (heap arenas, freed here): the
 * walk may run on any thread, so nothing is shared but the programs. */
static void !>(CCError) rtx_tm_lex(RtxDoc *d, const RtxTmRt *rt, char[:] src,
                                  size_t base, size_t emit_from,
                                  const RtxTmCkpt *seed, RtxTmWalk walk,
                                  RtxTmConv *cv) {
    RtxRxScratch rxs = {0};
    rtx_tm_lex_walk(d, rt, src, base, emit_from, seed, walk, &rxs, cv) !>(e) {
        rtx_rx_scratch_drop(&rxs);
        return cc_err(e);
    };
    rtx_rx_scratch_drop(&rxs);
    return cc_ok();
}

static void !>(CCError) rtx_hl_spike(RtxDoc *d, char[:] src, size_t base,
                                    size_t emit_from) {
    const char *buf;
    size_t n;
    size_t i = 0;
    RtxScope sc_comment;
    RtxScope sc_string;
    RtxScope sc_number;
    RtxScope sc_keyword;
    if (!d || !src.ptr || src.len == 0) return cc_ok();
    buf = src.ptr;
    n = src.len;
    if (!rtx_scope_put(&sc_comment, "comment") ||
        !rtx_scope_put(&sc_string, "string") ||
        !rtx_scope_put(&sc_number, "constant.numeric") ||
        !rtx_scope_put(&sc_keyword, "keyword")) {
        return cc_err(CC_ERR_OUT_OF_MEMORY, "scope intern");
    }
    while (i < n) {
        char c = buf[i];
        if (c == '/' && i + 1 < n && buf[i + 1] == '/') {
            size_t j = i + 2;
            while (j < n && buf[j] != '\n') j++;
            if (!rtx_hl_add_scope(d, base + i, j - i, emit_from, sc_comment)) {
                return cc_err(CC_ERR_OUT_OF_MEMORY, "hl run");
            }
            i = j;
        } else if (c == '/' && i + 1 < n && buf[i + 1] == '*') {
            size_t j = i + 2;
            while (j + 1 < n && !(buf[j] == '*' && buf[j + 1] == '/')) j++;
            if (j + 1 < n) j += 2;
            else j = n;
            if (!rtx_hl_add_scope(d, base + i, j - i, emit_from, sc_comment)) {
                return cc_err(CC_ERR_OUT_OF_MEMORY, "hl run");
            }
            i = j;
        } else if (c == '"') {
            size_t j = i + 1;
            while (j < n && buf[j] != '"') {
                if (buf[j] == '\\' && j + 1 < n) j += 2;
                else j++;
            }
            if (j < n) j++;
            if (!rtx_hl_add_scope(d, base + i, j - i, emit_from, sc_string)) {
                return cc_err(CC_ERR_OUT_OF_MEMORY, "hl run");
            }
            i = j;
        } else if (c == '\'') {
            size_t j = i + 1;
            while (j < n && buf[j] != '\'') {
                if (buf[j] == '\\' && j + 1 < n) j += 2;
                else j++;
            }
            if (j < n) j++;
            if (!rtx_hl_add_scope(d, base + i, j - i, emit_from, sc_string)) {
                return cc_err(CC_ERR_OUT_OF_MEMORY, "hl run");
            }
            i = j;
        } else if (c >= '0' && c <= '9') {
            size_t j = i + 1;
            while (j < n && ((buf[j] >= '0' && buf[j] <= '9') || buf[j] == 'x' ||
                             (buf[j] >= 'a' && buf[j] <= 'f') ||
                             (buf[j] >= 'A' && buf[j] <= 'F'))) {
                j++;
            }
            if (!rtx_hl_add_scope(d, base + i, j - i, emit_from, sc_number)) {
                return cc_err(CC_ERR_OUT_OF_MEMORY, "hl run");
            }
            i = j;
        } else if (rtx_hl_ident_start(c)) {
            size_t j = i + 1;
            while (j < n && rtx_hl_ident(buf[j])) j++;
            if (rtx_hl_is_keyword(buf + i, j - i)) {
                if (!rtx_hl_add_scope(d, base + i, j - i, emit_from, sc_keyword)) {
                    return cc_err(CC_ERR_OUT_OF_MEMORY, "hl run");
                }
            }
            i = j;
        } else {
            i++;
        }
    }
    return cc_ok();
}

/* ---- Markdown: block pass + inline lex (docs/md_view.md, Blocks) ----
 *
 * A grammar with `"cctext": { "blocks": "commonmark" }` is lexed a line at
 * a time: the block pass (md_block.cch) classifies the line and returns
 * spans; this walk plants them with the grammar's `cctext.block` rules and
 * runs the grammar's inline rules over the content it names (paragraph,
 * heading, table cell), or the guest grammar over a fence / HTML / front
 * matter body. Multi-line leaves (fence, HTML, math, front matter) are
 * frames on the TM stack, so a checkpoint, a seed and a converge carry
 * them the way they carry any span; the block state rides beside the
 * stack in the checkpoint (RtxTmCkpt.mdb), planted only at a line start.
 *
 * An inline span may cross lines inside its paragraph; the paragraph's
 * end drops it (its opener was text). A span dropped (or aborted, `]`
 * with no `(`) within RTX_MD_REWIND_MAX of its opener is rewound: its
 * runs and checkpoints go and the lex resumes one byte past the opener,
 * so what it swallowed lexes as if it had never opened. Below `inl` (the
 * lead-in of an anchor further back) lines are classified, not lexed. */

#define RTX_MD_REWIND_MAX 8192

static int rtx_tm_ckpt_seedable(const RtxTmRt *rt, const RtxTmCkpt *c);

typedef struct {
    RtxMdb bprev;  /* block state before the opener's line */
    size_t line;   /* opener's line (buffer offset) */
    size_t runs;   /* runs.len at the open */
    size_t ck;     /* tm_ckpt.len at the open */
    size_t stride; /* next checkpoint stride at the open */
    size_t cvk;
    int seg;
    int here;      /* opened by this walk (a seeded frame is not) */
    unsigned char flank; /* its rule's RTX_FLANK_* */
} RtxMdSnap;

/* Where a Markdown lex starts: inline lex from `inl` (absolute), block
 * flags for a start that is not the document's first byte. */
typedef struct {
    size_t inl;
    unsigned char flags; /* RTX_MDB_SOFT / RTX_MDB_UNSURE */
    int bol;             /* the start is a line start: no partial-line skip */
} RtxMdStart;

typedef struct {
    RtxTmWalkSt W;
    const RtxTmRt *rt;
    size_t host;          /* rt's lang id */
    RtxDoc *d;
    const char *buf;
    size_t n;             /* buffer length */
    size_t base;
    size_t emit_from;
    size_t i;
    size_t sp;
    size_t *stk_rule;
    size_t *stk_lang;
    size_t *stk_embed;
    size_t *stk_off;
    unsigned char *stk_alen;
    RtxMdSnap snap[RTX_TM_STACK];
    RtxMdb B;
    RtxMdb bprev;
    RtxMdbLine L;
    size_t line;          /* current line start (buffer) */
    size_t eol;           /* its NL (or n) */
    size_t nl;            /* next line start */
    int seg;              /* current segment; -1 = none left */
    size_t seg_hi;
    int seg_hard;
    RtxMdCell cells[RTX_MD_TABLE_COLS];
    size_t ncells;
    size_t inl;           /* buffer offset: lines before it are classified only */
    size_t budget;        /* rewind bytes left */
    size_t next_stride;
    size_t stride;
    unsigned char pflag;
    RtxTmConv *cv;
    int eof;              /* buffer end is the document end */
    int lend;             /* the current line's end is processed */
    size_t hv_lo;         /* first line classified from a sure state: link
                           * definitions from here on are staged */
    int hv_set;
} RtxMdCtx;

static const RtxTmRule *rtx_md_role(const RtxTmRt *rt, int role) {
    if (!rt || role <= 0 || role >= RTX_MDB_ROLE_N || rt->blk[role] < 0) return NULL;
    if ((size_t)rt->blk[role] >= rt->rules.len) return NULL;
    return &rt->rules.data[rt->blk[role]];
}

/* Plant one block run with the role's rule (hints only on a markup rule). */
static int rtx_md_plant(RtxMdCtx *X, int role, size_t lo, size_t hi, size_t ha,
                        size_t hb) {
    const RtxTmRule *r = rtx_md_role(X->rt, role);
    if (!r) return 1;
    if (!rtx_tm_hints(X->rt, r, (unsigned char)RTX_RUN_TM)) ha = hb = 0;
    return rtx_tm_add_span(X->d, lo, hi, X->emit_from, r->scope, rtx_tm_rule_bits(r),
                           ha, hb, (unsigned char)RTX_RUN_TM, r->mark,
                           (unsigned short)rtx_tm_rule_tag(X->rt, r));
}

static const RtxTmRule *rtx_md_frame(const RtxMdCtx *X, size_t k,
                                     const RtxTmRt **frt_out) {
    const RtxTmRt *frt = rtx_tm_rt_at(X->stk_lang[k]);
    if (!frt) frt = X->rt;
    if (frt_out) *frt_out = frt;
    return rtx_tm_rule_from_tag(frt, X->stk_rule[k]);
}

/* A host frame the inline lex opened (not a block-pass leaf, not a guest). */
static int rtx_md_inline_frame(const RtxMdCtx *X, size_t k) {
    const RtxTmRule *fr;
    if (X->stk_lang[k] != X->host) return 0;
    fr = rtx_md_frame(X, k, NULL);
    return fr && !fr->block;
}

/* Emit frame k..top unclosed at `end` (buffer offset) and pop them. */
static int rtx_md_pop_to(RtxMdCtx *X, size_t k, size_t end) {
    while (X->sp > k) {
        const RtxTmRt *frt;
        const RtxTmRule *fr = rtx_md_frame(X, X->sp - 1, &frt);
        unsigned char plant = rtx_tm_planter(X->rt, frt);
        if (fr && !rtx_tm_add_span(X->d, X->base + X->stk_off[X->sp - 1], X->base + end,
                                   X->emit_from, fr->scope, rtx_tm_rule_bits(fr),
                                   rtx_tm_hints(frt, fr, plant)
                                       ? (size_t)X->stk_alen[X->sp - 1]
                                       : 0,
                                   0, plant, fr->mark,
                                   (unsigned short)rtx_tm_rule_tag(frt, fr)))
            return 0;
        X->sp--;
    }
    return 1;
}

/* The open block leaf (the lowest host block frame) closes at `end` with
 * `hb` closer bytes; guest frames above it end there unclosed. */
static int rtx_md_leaf_close(RtxMdCtx *X, size_t end, size_t hb) {
    size_t k;
    const RtxTmRule *fr;
    for (k = 0; k < X->sp; k++) {
        fr = rtx_md_frame(X, k, NULL);
        if (X->stk_lang[k] == X->host && fr && fr->block) break;
    }
    if (k >= X->sp) return 1;
    if (!rtx_md_pop_to(X, k + 1, end)) return 0;
    fr = rtx_md_frame(X, k, NULL);
    if (fr) {
        size_t ha = X->stk_alen[k];
        if (!rtx_tm_hints(X->rt, fr, (unsigned char)RTX_RUN_TM)) ha = hb = 0;
        if (!rtx_tm_add_span(X->d, X->base + X->stk_off[k], X->base + end, X->emit_from,
                             fr->scope, rtx_tm_rule_bits(fr), ha, hb,
                             (unsigned char)RTX_RUN_TM, fr->mark,
                             (unsigned short)rtx_tm_rule_tag(X->rt, fr)))
            return 0;
    }
    X->sp = k;
    return 1;
}

static int rtx_md_leaf_open(RtxMdCtx *X, int role, size_t at, size_t alen,
                            size_t embed) {
    const RtxTmRule *r = rtx_md_role(X->rt, role);
    size_t g, s = X->sp;
    if (!r || s >= (size_t)RTX_TM_STACK) return 1;
    X->stk_rule[s] = rtx_tm_rule_tag(X->rt, r);
    X->stk_lang[s] = X->host;
    X->stk_embed[s] = embed;
    X->stk_off[s] = at;
    X->stk_alen[s] = rtx_tm_hint(alen);
    for (g = 0; g < (size_t)RTX_TM_CAPS; g++)
        X->W.stk_cs[s * (size_t)RTX_TM_CAPS + g] = X->W.stk_ce[s * (size_t)RTX_TM_CAPS + g] =
            RTX_RX_UNSET;
    X->W.stk_g[s] = RTX_RX_UNSET;
    X->snap[s].here = 0;
    X->sp++;
    return 1;
}

static size_t rtx_md_embed(const RtxTmRule *r) {
    return r && r->embed_scope ? rtx_tm_scope_lang(r->embed_scope)
                               : (size_t)RTX_TM_NO_LANG;
}

/* Segment `seg` of the current line: [*lo, *hi), 0 when none. */
static int rtx_md_seg(RtxMdCtx *X, int seg, size_t *lo, size_t *hi, int *hard) {
    const RtxMdbLine *L = &X->L;
    if (seg < 0 || X->line < X->inl) return 0;
    if (L->mode == RTX_MDB_M_INLINE && L->row) {
        X->ncells = rtx_md_row_split(X->buf + L->c_lo, L->c_hi - L->c_lo, X->cells,
                                     RTX_MD_TABLE_COLS);
        if (X->ncells > RTX_MD_TABLE_COLS) X->ncells = RTX_MD_TABLE_COLS;
        if ((size_t)seg >= X->ncells) return 0;
        *lo = L->c_lo + X->cells[seg].lo;
        *hi = L->c_lo + X->cells[seg].hi;
        *hard = 1;
        return 1;
    }
    if (seg != 0) return 0;
    if (L->mode == RTX_MDB_M_INLINE) {
        *lo = L->c_lo;
        *hi = L->hard ? L->c_hi : X->nl;
        *hard = L->hard;
        return 1;
    }
    if (L->mode == RTX_MDB_M_GUEST) {
        *lo = L->c_lo;
        *hi = X->nl;
        *hard = 0;
        return 1;
    }
    return 0;
}

/* Enter segment `seg` (or none left: -1). */
static void rtx_md_seg_go(RtxMdCtx *X, int seg) {
    size_t lo = 0, hi = 0;
    int hard = 0;
    if (!rtx_md_seg(X, seg, &lo, &hi, &hard)) {
        X->seg = -1;
        X->i = X->nl;
        return;
    }
    if (lo > hi) lo = hi;
    X->seg = seg;
    X->i = lo;
    X->seg_hi = hi;
    X->seg_hard = hard;
}

/* Rewind to frame k: its runs and checkpoints go; the lex resumes one
 * byte past its opener, in the line and segment it opened in. */
static void rtx_md_rewind(RtxMdCtx *X, size_t k) {
    const RtxMdSnap *S = &X->snap[k];
    size_t open = X->stk_off[k];
    X->budget -= X->i > open ? X->i - open : 0;
    if (X->d->runs.len > S->runs) {
        rtx_doc_runs_cut(X->d, S->runs);
        rtx_doc_run_top_drop(X->d);
    }
    if (X->d->tm_ckpt.len > S->ck) X->d->tm_ckpt.truncate(S->ck);
    X->next_stride = S->stride;
    if (X->cv) X->cv->k = S->cvk;
    X->sp = k;
    if (S->line != X->line) {
        const char *nlp;
        X->B = S->bprev;
        X->bprev = S->bprev;
        X->line = S->line;
        nlp = (const char *)memchr(X->buf + X->line, '\n', X->n - X->line);
        X->eol = nlp ? (size_t)(nlp - X->buf) : X->n;
        X->nl = nlp ? X->eol + 1 : X->n;
        rtx_mdb_line(&X->B, X->buf, X->line, X->eol, &X->L);
    }
    rtx_md_seg_go(X, S->seg);
    X->lend = 0;
    if (X->seg >= 0) {
        /* Past the opener; an emphasis opener's whole delimiter run is text. */
        X->i = open + 1;
        if (S->flank && S->flank != RTX_FLANK_MATH) {
            while (X->i < X->seg_hi && X->buf[X->i] == X->buf[open]) X->i++;
        }
        if (X->i > X->seg_hi) X->i = X->seg_hi;
    }
}

/* Frame k (and those above it) is dropped: rewind when its opener is
 * near, else pop without a run. 1 when the walk moved back. */
static int rtx_md_drop(RtxMdCtx *X, size_t k) {
    size_t j;
    for (j = k; j < X->sp; j++) {
        const RtxMdSnap *S = &X->snap[j];
        size_t open = X->stk_off[j];
        if (!S->here || X->i < open || X->i - open > (size_t)RTX_MD_REWIND_MAX ||
            X->i - open > X->budget)
            continue;
        rtx_md_rewind(X, j);
        return 1;
    }
    X->sp = k;
    return 0;
}

/* The paragraph ended: drop its open inline frames. */
static int rtx_md_drop_inline(RtxMdCtx *X) {
    size_t k = X->sp;
    while (k > 0 && rtx_md_inline_frame(X, k - 1)) k--;
    if (k == X->sp) return 0;
    return rtx_md_drop(X, k);
}

/* The dest face a resolved shortcut reference plants on its `]`: the
 * grammar's `][` reference dest (a path dest rule whose begin is `][`),
 * so it hides, joins and unwraps as `[x][]` does. */
static const RtxTmRule *rtx_md_ref_dest_rule(const RtxTmRt *rt) {
    size_t k;
    for (k = 0; k < rt->rules.len; k++) {
        const RtxTmRule *r = &rt->rules.data[k];
        if ((r->mark & RTX_MARK_DEST) && r->a && r->alen >= 2 && r->a[0] == ']' &&
            r->a[1] == '[')
            return r;
    }
    return NULL;
}

/* A path label (`[` / `![`) met its `]` with no `(` / `[` after it: a
 * shortcut reference `[foo]` when a definition of `foo` is in the map —
 * the label run plus a one-byte dest face on the `]`. 1 = planted and the
 * frame popped, 0 = not a reference (the caller drops the frame), -1 =
 * OOM. Every label asked is `seen`: a definition coming or going later
 * relexes (md_refs.cch). */
static int rtx_md_shortcut(RtxMdCtx *X, const RtxTmRule *fr) {
    size_t k = X->sp - 1, open = X->stk_off[k], alen = X->stk_alen[k], lo, n;
    const RtxTmRule *dr;
    uint64_t h;
    unsigned char pl = (unsigned char)RTX_RUN_TM;
    if (fr->abort != ']' || (fr->mark & RTX_MARK_ARITY) != RTX_ARITY_PATH ||
        (fr->mark & RTX_MARK_DEST))
        return 0;
    if (!X->snap[k].here || X->i < open + alen) return 0;
    lo = open + alen;
    n = X->i - lo;
    if (n == 0 || n > 999) return 0;
    h = rtx_mdref_hash(X->buf + lo, n);
    if (!h) return 0;
    rtx_mdref_see(&X->d->mdref, h);
    if (!rtx_mdref_has(&X->d->mdref, h) && !rtx_mdref_staged(&X->d->mdref, h)) return 0;
    dr = rtx_md_ref_dest_rule(X->rt);
    if (!dr) return 0;
    if (!rtx_tm_add_span(X->d, X->base + open, X->base + X->i, X->emit_from, fr->scope,
                         rtx_tm_rule_bits(fr), rtx_tm_hints(X->rt, fr, pl) ? alen : 0, 0,
                         pl, fr->mark, (unsigned short)rtx_tm_rule_tag(X->rt, fr)))
        return -1;
    if (!rtx_tm_add_span(X->d, X->base + X->i, X->base + X->i + 1, X->emit_from, dr->scope,
                         rtx_tm_rule_bits(dr), rtx_tm_hints(X->rt, dr, pl) ? 1 : 0, 0, pl,
                         dr->mark, (unsigned short)rtx_tm_rule_tag(X->rt, dr)))
        return -1;
    X->sp = k;
    X->i++;
    return 1;
}

/* One step of the inline / guest lex at X->i (< X->seg_hi). -1 = OOM. */
static int rtx_md_step(RtxMdCtx *X) {
    RtxTmWalkSt *W = &X->W;
    const RtxTmRt *rt = X->rt;
    const char *buf = X->buf;
    size_t sp0 = X->sp, k;
    int hit = 0;
    W->n = X->seg_hi;
    if (X->sp > 0) {
        const RtxTmRt *frt;
        RtxTmRule *fr = (RtxTmRule *)rtx_md_frame(X, X->sp - 1, &frt);
        size_t guest = X->stk_embed[X->sp - 1];
        unsigned char plant_fr = rtx_tm_planter(rt, frt);
        if (!fr) {
            X->sp--;
            return 1;
        }
        if (frt == rt && fr->block) {
            /* A leaf body: the block pass closes it; a guest lexes it. */
            const RtxTmRt *grt = guest != (size_t)RTX_TM_NO_LANG ? rtx_tm_rt_at(guest) : NULL;
            if (!grt) {
                X->i = X->seg_hi;
                return 1;
            }
            for (k = 0; k < grt->rules.len; k++) {
                int t = rtx_tm_try_rule(W, grt, &grt->rules.data[k], 1);
                if (t < 0) return -1;
                if (t > 0) {
                    hit = 1;
                    break;
                }
            }
            if (!hit) {
                if (buf[X->i] == '\\' && X->i + 1 < X->seg_hi && buf[X->i + 1] != '\n')
                    X->i += 2;
                else
                    X->i++;
            }
            goto opened;
        }
        if (fr->op == RTX_TM_LIT_SPAN && !rtx_tm_span_other_inner(frt, fr) &&
            guest == (size_t)RTX_TM_NO_LANG && !fr->info && !fr->embed_scope &&
            !fr->self_in && !fr->abort) {
            return rtx_tm_span_advance(W, frt, fr) < 0 ? -1 : 1;
        }
        {
            size_t endn = fr->blen, ha;
            if (rtx_tm_span_close(W, fr, X->i, X->sp - 1, &endn)) {
                size_t blen = endn, end;
                ha = (size_t)X->stk_alen[X->sp - 1];
                end = rtx_tm_span_end(fr, X->i, endn, &blen);
                if (!rtx_tm_hints(frt, fr, plant_fr)) ha = blen = 0;
                if (!rtx_tm_add_span(X->d, X->base + X->stk_off[X->sp - 1], X->base + end,
                                     X->emit_from, fr->scope, rtx_tm_rule_bits(fr), ha,
                                     blen, plant_fr, fr->mark,
                                     (unsigned short)rtx_tm_rule_tag(frt, fr)))
                    return -1;
                X->i = end == X->i && blen == 0 ? X->i : end;
                X->sp--;
                return 1;
            }
        }
        if (fr->abort && (unsigned char)buf[X->i] == fr->abort && frt == rt) {
            int sc = rtx_md_shortcut(X, fr);
            if (sc < 0) return -1;
            if (!sc) rtx_md_drop(X, X->sp - 1);
            return 1;
        }
        if (fr->flank && frt == rt && X->sp > 1) {
            /* CommonMark looks back past openers that cannot pair for one
             * that can: `**a****b**` is one strong. The openers skipped
             * are text (their frames drop). */
            char c = buf[X->i];
            if (c == '*' || c == '_' || c == '~' || c == '=') {
                size_t k2, top = X->sp;
                for (k2 = top - 1; k2 > 0; k2--) {
                    const RtxTmRt *krt;
                    const RtxTmRule *kr;
                    size_t endn;
                    if (!rtx_md_inline_frame(X, k2 - 1)) break;
                    kr = rtx_md_frame(X, k2 - 1, &krt);
                    if (!kr || !kr->flank || !kr->b || kr->b[0] != c) continue;
                    X->sp = k2;
                    endn = kr->blen;
                    if (rtx_tm_span_close(W, kr, X->i, k2 - 1, &endn)) {
                        size_t blen = endn, end, ha = (size_t)X->stk_alen[k2 - 1];
                        unsigned char pl = rtx_tm_planter(rt, krt);
                        end = rtx_tm_span_end(kr, X->i, endn, &blen);
                        if (!rtx_tm_hints(krt, kr, pl)) ha = blen = 0;
                        if (!rtx_tm_add_span(X->d, X->base + X->stk_off[k2 - 1],
                                             X->base + end, X->emit_from, kr->scope,
                                             rtx_tm_rule_bits(kr), ha, blen, pl, kr->mark,
                                             (unsigned short)rtx_tm_rule_tag(krt, kr)))
                            return -1;
                        X->i = end;
                        X->sp = k2 - 1;
                        return 1;
                    }
                    X->sp = top;
                }
                X->sp = top;
            }
        }
        if (guest != (size_t)RTX_TM_NO_LANG) {
            const RtxTmRt *grt = rtx_tm_rt_at(guest);
            if (grt) {
                for (k = 0; k < grt->rules.len; k++) {
                    int t = rtx_tm_try_rule(W, grt, &grt->rules.data[k], 1);
                    if (t < 0) return -1;
                    if (t > 0) {
                        hit = 1;
                        break;
                    }
                }
            }
        }
        for (k = 0; !hit && k < fr->innern; k++) {
            int t = rtx_tm_try_rule(W, frt, &frt->inners.data[fr->inner0 + k], 1);
            if (t < 0) return -1;
            if (t > 0) hit = 1;
        }
        if (!hit && fr->self_in) {
            for (k = 0; k < frt->rules.len; k++) {
                const RtxTmRule *r = &frt->rules.data[k];
                int t;
                if (r->block) continue;
                t = rtx_tm_try_rule(W, frt, r, 1);
                if (t < 0) return -1;
                if (t > 0) {
                    hit = 1;
                    break;
                }
            }
        }
        if (!hit) {
            if (buf[X->i] == '\\' && X->i + 1 < X->seg_hi && buf[X->i + 1] != '\n')
                X->i += 2;
            else
                X->i++;
        }
    } else {
        for (k = 0; k < rt->rules.len; k++) {
            const RtxTmRule *r = &rt->rules.data[k];
            int t;
            if (r->block) continue;
            t = rtx_tm_try_rule(W, rt, r, 1);
            if (t < 0) return -1;
            if (t > 0) {
                hit = 1;
                break;
            }
        }
        if (!hit) X->i++;
    }
opened:
    for (k = sp0; k < X->sp; k++) {
        RtxMdSnap *S = &X->snap[k];
        S->bprev = X->bprev;
        S->line = X->line;
        S->runs = X->d->runs.len;
        S->ck = X->d->tm_ckpt.len;
        S->stride = X->next_stride;
        S->cvk = X->cv ? X->cv->k : 0;
        S->seg = X->seg;
        S->here = 1;
        {
            const RtxTmRule *fr = rtx_md_frame(X, k, NULL);
            S->flank = fr ? fr->flank : 0;
        }
    }
    return 1;
}

/* Plant the line's block spans and open / close its leaf frames. */
static int rtx_md_line_spans(RtxMdCtx *X) {
    const RtxMdbLine *L = &X->L;
    size_t base = X->base, eol = X->eol;
    int s;
    if (L->close0 && !rtx_md_leaf_close(X, X->line, 0)) return 0;
    for (s = 0; s < L->nsp; s++) {
        const RtxMdbSpan *p = &L->sp[s];
        size_t lo = base + p->lo, hi = base + p->hi;
        int ok = 1;
        switch (p->kind) {
        case RTX_MDB_S_QUOTE:
            ok = rtx_md_plant(X, RTX_MDB_ROLE_QUOTE, lo, base + eol, p->hi - p->lo, 0);
            break;
        case RTX_MDB_S_ITEM:
            ok = rtx_md_plant(X, RTX_MDB_ROLE_LIST, lo, base + eol, p->hi - p->lo, 0);
            break;
        case RTX_MDB_S_TASK:
            ok = rtx_md_plant(X, RTX_MDB_ROLE_TASK, lo, hi, p->hi - p->lo, 0);
            break;
        case RTX_MDB_S_ATX:
            ok = rtx_md_plant(X, RTX_MDB_ROLE_HEADING, lo, base + eol, p->hi - p->lo, 0);
            break;
        case RTX_MDB_S_ATX_CLOSE:
            ok = rtx_md_plant(X, RTX_MDB_ROLE_HEADING_CLOSE, lo, hi, p->hi - p->lo, 0);
            break;
        case RTX_MDB_S_SETEXT: {
            size_t at = base + X->line;
            size_t tlo = L->title_back <= at ? at - L->title_back : 0;
            if (at > tlo + 1)
                ok = rtx_md_plant(X, RTX_MDB_ROLE_HEADING, tlo, at - 1, 0, 0);
            if (ok) ok = rtx_md_plant(X, RTX_MDB_ROLE_SETEXT, lo, hi, p->hi - p->lo, 0);
            break;
        }
        case RTX_MDB_S_HR:
        case RTX_MDB_S_SLIDE: /* Marp slide separator: painted as the rule */
            ok = rtx_md_plant(X, RTX_MDB_ROLE_HR, lo, hi, 0, 0);
            break;
        case RTX_MDB_S_ICODE:
            ok = rtx_md_plant(X, RTX_MDB_ROLE_CODE, lo, hi, 0, 0);
            break;
        case RTX_MDB_S_REF_LABEL:
            ok = rtx_md_plant(X, RTX_MDB_ROLE_REF, lo, hi, 0, 0);
            if (X->hv_set && !X->d->mdref.sweep_on && p->hi >= p->lo + 3) {
                /* A link reference definition: the shortcut map's entry. */
                RtxMdRef e = {0};
                int t;
                e.line = base + X->line;
                e.llen = (uint32_t)(eol - X->line);
                e.h = rtx_mdref_hash(X->buf + p->lo + 1, p->hi - p->lo - 3);
                for (t = s + 1; t < L->nsp; t++) {
                    if (L->sp[t].kind == RTX_MDB_S_REF_DEST) {
                        e.dlo = (uint32_t)(L->sp[t].lo - X->line);
                        e.dhi = (uint32_t)(L->sp[t].hi - X->line);
                        break;
                    }
                }
                rtx_mdref_stage_add(&X->d->mdref, &e);
            }
            break;
        case RTX_MDB_S_REF_DEST:
        case RTX_MDB_S_REF_TITLE:
            ok = rtx_md_plant(X, RTX_MDB_ROLE_REF_DEST, lo, hi, 0, 0);
            break;
        case RTX_MDB_S_FOOT_LABEL:
            ok = rtx_md_plant(X, RTX_MDB_ROLE_FOOT, lo, hi, 0, 0);
            break;
        case RTX_MDB_S_FENCE_OPEN: {
            size_t emb = L->info_hi > L->info_lo
                             ? rtx_tm_info_lang(X->buf + L->info_lo, L->info_hi - L->info_lo)
                             : (size_t)RTX_TM_NO_LANG;
            const RtxTmRt *grt = rtx_tm_rt_at(emb);
            /* Markdown in a Markdown fence is its source: raw, no marks. */
            if (grt && grt->blocks) emb = (size_t)RTX_TM_NO_LANG;
            ok = rtx_md_leaf_open(X, RTX_MDB_ROLE_FENCE, p->lo, p->hi - p->lo, emb);
            break;
        }
        case RTX_MDB_S_FENCE_CLOSE:
            ok = rtx_md_leaf_close(X, p->hi, p->hi - p->lo);
            break;
        case RTX_MDB_S_MATH_OPEN:
            ok = rtx_md_leaf_open(X, RTX_MDB_ROLE_MATH, p->lo, p->hi - p->lo,
                                  (size_t)RTX_TM_NO_LANG);
            break;
        case RTX_MDB_S_MATH_CLOSE:
            ok = rtx_md_leaf_close(X, p->hi, p->hi - p->lo);
            break;
        case RTX_MDB_S_FRONT_OPEN: {
            const RtxTmRule *r = rtx_md_role(X->rt, RTX_MDB_ROLE_FRONT);
            ok = rtx_md_leaf_open(X, RTX_MDB_ROLE_FRONT, p->lo, p->hi - p->lo,
                                  X->buf[p->lo] == '-' ? rtx_md_embed(r)
                                                       : (size_t)RTX_TM_NO_LANG);
            break;
        }
        case RTX_MDB_S_FRONT_CLOSE:
            ok = rtx_md_leaf_close(X, p->hi, p->hi - p->lo);
            break;
        case RTX_MDB_S_HTML:
            ok = rtx_md_leaf_open(X, RTX_MDB_ROLE_HTML, p->lo, 0,
                                  rtx_md_embed(rtx_md_role(X->rt, RTX_MDB_ROLE_HTML)));
            break;
        default:
            break;
        }
        if (!ok) return 0;
    }
    return 1;
}

/* Converge at this line start: same stack, same block state — and nothing
 * the old lex planted across it from behind. Not inside a paragraph (a
 * setext underline below restyles its title lines), and not on a line
 * that ends a leaf at its start (the old leaf run ends here, it does not
 * run on past it for the converge to reopen). */
static int rtx_md_conv_eq(const RtxMdCtx *X, const RtxTmCkpt *c, size_t i) {
    RtxMdb tmp;
    RtxMdbLine tl;
    const char *nlp;
    if (!c->md || X->B.leaf == RTX_MDB_LEAF_PARA || !rtx_mdb_eq(&c->mdb, &X->B) ||
        !rtx_tm_conv_eq(X->rt, c, X->sp, X->stk_rule, X->stk_lang, X->stk_embed))
        return 0;
    tmp = X->B;
    nlp = (const char *)memchr(X->buf + i, '\n', X->n - i);
    rtx_mdb_line(&tmp, X->buf, i, nlp ? (size_t)(nlp - X->buf) : X->n, &tl);
    return !tl.close0;
}

/* Marp deck: front matter at BOF with `marp: true` (docs/slides.md). One
 * bounded read of the first RTX_MDB_MARP_PROBE bytes, never a scan. */
int RtxDoc_marp(const RtxDoc *d) {
    size_t n;
    int on;
    CCArena a;
    char[:] b;
    if (!d) return 0;
    n = d->len();
    if (n < 8) return 0;
    if (n > (size_t)RTX_MDB_MARP_PROBE) n = (size_t)RTX_MDB_MARP_PROBE;
    a = cc_arena_heap(n + 64);
    if (!a.base) return 0;
    b = d->scratch_span(0, n, a) !>(e) {
        (void)e;
        a.destroy();
        return 0;
    };
    on = rtx_mdb_marp_front(b.ptr, b.len);
    a.destroy();
    return on;
}

static void !>(CCError) rtx_md_lex_walk(RtxDoc *d, const RtxTmRt *rt, char[:] src,
                                       size_t base, size_t emit_from,
                                       const RtxTmCkpt *seed, RtxTmWalk walk,
                                       RtxRxScratch *rxs, RtxTmConv *cv,
                                       const RtxMdStart *ms) {
    size_t stk_rule[RTX_TM_STACK];
    size_t stk_lang[RTX_TM_STACK];
    size_t stk_embed[RTX_TM_STACK];
    size_t stk_off[RTX_TM_STACK];
    size_t stk_cs[RTX_TM_STACK * RTX_TM_CAPS];
    size_t stk_ce[RTX_TM_STACK * RTX_TM_CAPS];
    size_t stk_g[RTX_TM_STACK];
    unsigned char stk_alen[RTX_TM_STACK];
    RtxMdCtx *X;
    CCArena xa;
    int bol0 = 1;
    size_t z;
    if (!d || !rt || !src.ptr || src.len == 0) return cc_ok();
    xa = cc_arena_heap(sizeof(RtxMdCtx) + 256);
    if (!xa.base) return cc_err(CC_ERR_OUT_OF_MEMORY, "md walk");
    X = (RtxMdCtx *)cc_arena_alloc(xa, sizeof(RtxMdCtx), _Alignof(RtxMdCtx));
    if (!X) {
        xa.destroy();
        return cc_err(CC_ERR_OUT_OF_MEMORY, "md walk");
    }
    memset(X, 0, sizeof *X);
    if (base > 0) {
        char pc = 0;
        size_t got = d->read_at(base - 1, cc_slice_from_buffer(&pc, 1)) !>(e) {
            (void)e;
            xa.destroy();
            return cc_ok();
        };
        bol0 = (got == 1 && pc == '\n');
    }
    X->rt = rt;
    X->host = rtx_tm_lang_id(rt);
    X->d = d;
    X->buf = src.ptr;
    X->n = src.len;
    X->base = base;
    X->emit_from = emit_from;
    X->stk_rule = stk_rule;
    X->stk_lang = stk_lang;
    X->stk_embed = stk_embed;
    X->stk_off = stk_off;
    X->stk_alen = stk_alen;
    X->cv = cv;
    X->eof = base + src.len >= d->len();
    X->budget = 4 * src.len + (64u << 10);
    for (z = 0; z < (size_t)RTX_TM_STACK; z++) {
        stk_alen[z] = 0;
        stk_g[z] = RTX_RX_UNSET;
    }
    for (z = 0; z < (size_t)RTX_TM_STACK * (size_t)RTX_TM_CAPS; z++)
        stk_cs[z] = stk_ce[z] = RTX_RX_UNSET;
    if (seed && RTX_TM_CKPT_N(seed)) {
        size_t lim = RTX_TM_CKPT_N(seed) < (unsigned char)RTX_TM_STACK
                         ? RTX_TM_CKPT_N(seed)
                         : (unsigned char)RTX_TM_STACK;
        for (z = 0; z < lim; z++) {
            stk_rule[z] = seed->rule[z];
            stk_lang[z] = seed->lang[z];
            stk_embed[z] = seed->embed[z];
            stk_off[z] = 0;
        }
        X->sp = lim;
    }
    if (seed && seed->md) {
        X->B = seed->mdb;
    } else {
        unsigned char fl = ms ? ms->flags : 0;
        rtx_mdb_init(&X->B, base == 0, (fl & RTX_MDB_SOFT) != 0,
                     (fl & RTX_MDB_UNSURE) != 0);
        d->marp = RtxDoc_marp(d);
        rtx_mdb_set_marp(&X->B, d->marp);
    }
    X->inl = ms && ms->inl > base ? ms->inl - base : 0;
    rtx_mdref_stage_reset(&d->mdref);
    X->W.d = d;
    X->W.host = rt;
    X->W.buf = src.ptr;
    X->W.base = base;
    X->W.n = src.len;
    X->W.emit_from = emit_from;
    X->W.i = &X->i;
    X->W.sp = &X->sp;
    X->W.stk_rule = stk_rule;
    X->W.stk_lang = stk_lang;
    X->W.stk_embed = stk_embed;
    X->W.stk_off = stk_off;
    X->W.stk_cs = stk_cs;
    X->W.stk_ce = stk_ce;
    X->W.stk_g = stk_g;
    X->W.stk_alen = stk_alen;
    X->W.bol0 = bol0;
    X->W.rxs = rxs;
    X->W.eol_lo = 1;
    X->W.eol_hi = 0;
    X->W.md = 1;
    X->pflag = (walk == RTX_TM_LOOKBACK || (seed && (seed->n & RTX_TM_CKPT_WIN)) ||
                (cv && cv->plant))
                   ? (unsigned char)RTX_TM_CKPT_WIN
                   : 0;
    X->stride = X->pflag ? (size_t)RTX_TM_WIN_STRIDE : (size_t)RTX_TM_CKPT_STRIDE;
    X->next_stride = ((base / X->stride) + 1) * X->stride;
    if (cv) cv->hit = (size_t)-1;
    /* A lex that starts mid-line (a lookback's partial line) finishes that
     * line as unclassified text. */
    X->i = 0;
    X->nl = 0;
    X->seg = -1;
    if (!bol0) {
        const char *nlp = (const char *)memchr(X->buf, '\n', X->n);
        X->nl = nlp ? (size_t)(nlp - X->buf) + 1 : X->n;
        X->i = X->nl;
    }
    X->lend = 1;
    for (;;) {
        if (X->seg >= 0 && X->i >= X->seg_hi) {
            /* Segment end: a heading / cell ends its inline spans. */
            if (X->seg_hard && rtx_md_drop_inline(X)) continue;
            rtx_md_seg_go(X, X->seg + 1);
            continue;
        }
        if (X->seg < 0) {
            const char *nlp;
            size_t i;
            if (!X->lend) {
                /* HTML kinds 1-5 end with the line holding their marker. */
                X->lend = 1;
                if (X->L.close == RTX_MDB_LEAF_HTML && !rtx_md_leaf_close(X, X->eol, 0)) {
                    xa.destroy();
                    return cc_err(CC_ERR_OUT_OF_MEMORY, "md run");
                }
            }
            if (X->nl >= X->n) {
                /* The document ends its last paragraph; a window end does
                 * not know it closes: an inline span open here is text
                 * (leftover, never a span painted to the window's edge). */
                if (rtx_md_drop_inline(X)) continue;
                break;
            }
            i = X->nl;
            X->line = i;
            if (cv) {
                while (cv->k < cv->n && cv->at[cv->k].off < base + i) cv->k++;
                if (cv->k < cv->n && cv->at[cv->k].off == base + i &&
                    rtx_md_conv_eq(X, &cv->at[cv->k], i)) {
                    size_t k;
                    cv->hit = cv->k;
                    cv->osp = X->sp;
                    for (k = 0; k < X->sp; k++) {
                        const RtxTmRt *frt;
                        const RtxTmRule *fr = rtx_md_frame(X, k, &frt);
                        cv->orule[k] = stk_rule[k];
                        cv->ooff[k] = base + stk_off[k];
                        cv->oalen[k] =
                            fr && rtx_tm_hints(frt, fr, rtx_tm_planter(rt, frt))
                                ? stk_alen[k]
                                : 0;
                    }
                    X->n = i;
                    break;
                }
            }
            if (base + i >= X->next_stride) {
                if (i >= X->inl)
                    rtx_tm_ckpt_add(d, base + i, X->sp, stk_rule, stk_lang, stk_embed,
                                    X->pflag, &X->B);
                X->next_stride = ((base + i) / X->stride + 1) * X->stride;
            }
            X->bprev = X->B;
            if (!X->hv_set && !(X->B.flags & (RTX_MDB_SOFT | RTX_MDB_UNSURE))) {
                X->hv_set = 1;
                X->hv_lo = i;
            }
            nlp = (const char *)memchr(X->buf + i, '\n', X->n - i);
            X->eol = nlp ? (size_t)(nlp - X->buf) : X->n;
            X->nl = nlp ? X->eol + 1 : X->n;
            rtx_mdb_line(&X->B, X->buf, i, X->eol, &X->L);
            if (X->L.drop && rtx_md_drop_inline(X)) continue;
            if (!rtx_md_line_spans(X)) {
                xa.destroy();
                return cc_err(CC_ERR_OUT_OF_MEMORY, "md run");
            }
            X->lend = 0;
            rtx_md_seg_go(X, 0);
            continue;
        }
        if (rtx_md_step(X) < 0) {
            xa.destroy();
            return cc_err(CC_ERR_OUT_OF_MEMORY, "md run");
        }
    }
    /* Link definitions: the lines this walk classified from a sure state
     * replace what the map held there. */
    if (X->hv_set && !d->mdref.sweep_on)
        rtx_mdref_commit(&d->mdref, base + X->hv_lo, base + X->n);
    rtx_mdref_stage_reset(&d->mdref);
    if (cv && cv->hit != (size_t)-1) {
        /* The old lex from here stands (its frames close there). */
        rtx_tm_ckpt_add(d, base + X->n, X->sp, stk_rule, stk_lang, stk_embed, X->pflag,
                        &X->B);
    } else {
        if (X->n == 0 || X->buf[X->n - 1] == '\n' || X->eof)
            rtx_tm_ckpt_add(d, base + X->n, X->sp, stk_rule, stk_lang, stk_embed,
                            X->pflag, &X->B);
        if (!rtx_md_pop_to(X, 0, X->n)) {
            xa.destroy();
            return cc_err(CC_ERR_OUT_OF_MEMORY, "md run");
        }
    }
    xa.destroy();
    return cc_ok();
}

static void !>(CCError) rtx_md_lex(RtxDoc *d, const RtxTmRt *rt, char[:] src,
                                  size_t base, size_t emit_from,
                                  const RtxTmCkpt *seed, RtxTmWalk walk,
                                  RtxTmConv *cv, const RtxMdStart *ms) {
    RtxRxScratch rxs = {0};
    rtx_md_lex_walk(d, rt, src, base, emit_from, seed, walk, &rxs, cv, ms) !>(e) {
        rtx_rx_scratch_drop(&rxs);
        return cc_err(e);
    };
    rtx_rx_scratch_drop(&rxs);
    return cc_ok();
}

/* The grammar's walk: the Markdown block pass for a `blocks` grammar. */
static void !>(CCError) rtx_doc_lex(RtxDoc *d, const RtxTmRt *rt, char[:] src,
                                   size_t base, size_t emit_from,
                                   const RtxTmCkpt *seed, RtxTmWalk walk,
                                   RtxTmConv *cv, const RtxMdStart *ms) {
    if (rt && rt->blocks) return rtx_md_lex(d, rt, src, base, emit_from, seed, walk, cv, ms);
    return rtx_tm_lex(d, rt, src, base, emit_from, seed, walk, cv);
}

#define RTX_MD_ANCHOR_MAX (256u * 1024u)
#define RTX_MD_ANCHOR_CHUNK (32u * 1024u)

/* Where a Markdown window lex starts when no checkpoint seeds it: the
 * nearest line at or before `s0` that fixes the block state — the section
 * floor, or a fence line with an info string (an opener: what follows is
 * its body, not prose) — within RTX_MD_ANCHOR_MAX. None: `s0` with SOFT
 * (no container context yet) and UNSURE (a fence opened above may still
 * be open: bare fences stay text until an info-string fence). Leftover,
 * never a wrong nest, and never a walk to BOF. */
static size_t rtx_md_anchor(const RtxDoc *d, size_t floor, size_t s0,
                            unsigned char *flags) {
    size_t lo, hi;
    *flags = (unsigned char)RTX_MDB_SOFT;
    if (s0 <= floor) {
        *flags = 0;
        return floor;
    }
    lo = s0 - floor > (size_t)RTX_MD_ANCHOR_MAX ? s0 - (size_t)RTX_MD_ANCHOR_MAX : floor;
    /* Chunks from the lookback up: the nearest anchor is usually close. A
     * chunk reads a little past its top so a line crossing it is whole. */
    hi = s0;
    while (hi > lo) {
        size_t c_lo = hi - lo > (size_t)RTX_MD_ANCHOR_CHUNK ? hi - (size_t)RTX_MD_ANCHOR_CHUNK
                                                             : lo;
        size_t r_hi = s0 - hi > 512 ? hi + 512 : s0;
        size_t k, len;
        CCArena a = cc_arena_heap(r_hi - c_lo + 64);
        char[:] b;
        if (!a.base) break;
        b = d->scratch_span(c_lo, r_hi - c_lo, a) !>(err) {
            (void)err;
            a.destroy();
            break;
        };
        len = b.len;
        for (k = hi - c_lo + 1; k > 0; k--) {
            size_t at = k - 1, eol;
            const char *nl;
            int info = 0;
            if (at > 0 ? b.ptr[at - 1] != '\n' : c_lo != floor) continue;
            if (at >= len) continue;
            nl = (const char *)memchr(b.ptr + at, '\n', len - at);
            eol = nl ? (size_t)(nl - b.ptr) : len;
            if (!nl && r_hi < s0) continue; /* longer than the overlap: no fence */
            if (rtx_mdb_fence_line(b.ptr + at, eol - at, &info) && info) {
                a.destroy();
                return c_lo + at;
            }
        }
        a.destroy();
        hi = c_lo;
    }
    if (hi <= lo && lo == floor) {
        *flags = 0;
        return floor;
    }
    *flags |= (unsigned char)RTX_MDB_UNSURE;
    return s0;
}

/* Walk back from `c` to a checkpoint a Markdown catch-up may resume from. */
static const RtxTmCkpt *rtx_md_seed_back(const RtxDoc *d, const RtxTmRt *rt,
                                         const RtxTmCkpt *c) {
    size_t i;
    if (!c || !rt || !rt->blocks) return c;
    i = (size_t)(c - d->tm_ckpt.data) + 1;
    while (i > 0) {
        const RtxTmCkpt *x = &d->tm_ckpt.data[i - 1];
        i--;
        if (x->n & (RTX_TM_CKPT_STALE | RTX_TM_CKPT_WIN)) continue;
        if (rtx_tm_ckpt_seedable(rt, x)) return x;
    }
    return NULL;
}

/* One document lexes with one runtime, chosen from d->path: a guest
 * grammar lexes inside a host span (RTX_RUN_INJECT, clipped with TM). A
 * `blocks` grammar runs the Markdown block pass (`ms`: where its inline
 * lex begins and how sure its first line is; NULL = everything, sure). */
static void !>(CCError) rtx_hl_range(RtxDoc *d, char[:] buf, size_t base,
                                    size_t emit_from,
                                    const RtxTmCkpt *seed, RtxTmWalk walk,
                                    const RtxMdStart *ms) {
    const RtxTmRt *rt;
    if (!d || !buf.ptr || buf.len == 0) return cc_ok();
    rt = rtx_tm_for_path(d->path.ptr);
    if (rt) return rtx_doc_lex(d, rt, buf, base, emit_from, seed, walk, NULL, ms);
    return rtx_hl_spike(d, buf, base, emit_from);
}

static void !>(CCError) rtx_doc_highlight(RtxDoc *d) {
    size_t n, s;
    if (!d) return cc_err(CC_ERR_INVALID_ARG, "null doc");
    n = d->len();
    if (n == 0) return cc_ok();
    @defer(err) rtx_doc_hl_abort(d);
    for (s = 0; s < d->secs.len; s++) {
        size_t lo = d->secs.data[s].start;
        size_t hi = (s + 1 < d->secs.len) ? d->secs.data[s + 1].start : n;
        if (!rtx_sec_lexed(d->secs.data[s].kind)) continue;
        if (hi > n) hi = n;
        if (lo >= hi) continue;
        {
            CCArena frame = cc_arena_heap((hi - lo) + 64);
            char[:] bytes;
            if (!frame.base) return cc_err(CC_ERR_OUT_OF_MEMORY, "highlight span");
            bytes = d->scratch_span(lo, hi - lo, frame) !>(e) {
                frame.destroy();
                return cc_err(e);
            };
            rtx_hl_range(d, bytes, lo, lo, NULL,
                         RTX_TM_CATCHUP, NULL) !>(e) {
                frame.destroy();
                return cc_err(e);
            };
            frame.destroy();
        }
    }
    for (s = 0; s < d->secs.len; s++) {
        if (rtx_sec_lexed(d->secs.data[s].kind)) d->secs.data[s].hl_done = 1;
    }
    return cc_ok();
}

static int !>(CCError) rtx_doc_cluster_at(const RtxDoc *d, size_t off,
                                         size_t *start, RtxUtf8Cl *cl) {
    char buf[RTX_UTF8_LOOK * 2];
    size_t base, got, rel, n, a;
    RtxUtf8Cl z = {0};
    @errhandler(CCError e) { return cc_err(e); }
    if (!d) return cc_err(CC_ERR_INVALID_ARG, "null doc");
    n = d->len();
    if (off >= n) {
        if (start) *start = n;
        if (cl) *cl = z;
        return cc_ok(0);
    }
    a = d->cluster_align(off) !>;
    got = rtx_doc_utf8_win(d, a, buf, sizeof(buf), &base) !>;
    rel = a - base;
    if (rel > got) rel = got;
    z = rtx_utf8_cluster(buf.to_slice_n(got), rel);
    if (start) *start = a;
    if (cl) *cl = z;
    return cc_ok(z.n ? 1 : 0);
}

/* Room for `need` recs. Recs stay raw + cc_arena_realloc (FRICTION). */
static void !>(CCError) rtx_hist_reserve(RtxDoc *d, size_t need) {
    size_t c, elem;
    void *n;
    if (!d) return cc_err(CC_ERR_INVALID_ARG, "hist grow");
    if (need < d->hist.len) need = d->hist.len;
    if (need <= d->hist.cap) return cc_ok();
    c = d->hist.cap ? d->hist.cap : 8;
    elem = sizeof(RtxHistRec);
    while (c < need) {
        size_t next = c * 2;
        if (next < c) return cc_err(CC_ERR_OUT_OF_MEMORY, "hist grow overflow");
        c = next;
    }
    n = cc_arena_realloc(d->session, d->session, d->hist.recs, d->hist.cap * elem,
                         c * elem, 8);
    if (!n) return cc_err(CC_ERR_OUT_OF_MEMORY, "hist grow");
    d->hist.recs = (RtxHistRec *)n;
    d->hist.cap = c;
    return cc_ok();
}

static void !>(CCError) rtx_hist_grow(RtxDoc *d) {
    if (!d) return cc_err(CC_ERR_INVALID_ARG, "hist grow");
    return rtx_hist_reserve(d, d->hist.len + 1);
}

static void !>(CCError) rtx_hist_buf_reserve(RtxDoc *d, Vec::[char] *b, size_t need) {
    if (!d || !b) return cc_err(CC_ERR_INVALID_ARG, "hist reserve");
    if (need <= b->cap() && b->data()) return cc_ok();
    if (!b->data()) {
        *b = vec_new::[char](d->session);
        if (!b->data() && need > 0)
            return cc_err(CC_ERR_OUT_OF_MEMORY, "hist reserve");
    }
    if (b->reserve(need) != 0)
        return cc_err(CC_ERR_OUT_OF_MEMORY, "hist reserve");
    return cc_ok();
}

static void !>(CCError) rtx_hist_coalesce_ins_reserve(RtxDoc *d, RtxHistRec *last,
                                                      size_t add) {
    return rtx_hist_buf_reserve(d, &last->ins, last->ins.len + add);
}

static void !>(CCError) rtx_hist_coalesce_del_reserve(RtxDoc *d, RtxHistRec *last,
                                                      size_t add) {
    if (!last) return cc_err(CC_ERR_INTERNAL, "coalesce del arm");
    @switch (last->del) {
        case .text: {
            Vec::[char] *b = &last->del.text;
            /* In-place only — same-arm variant assign would destroy the live Vec. */
            return rtx_hist_buf_reserve(d, b, b->len() + add);
        }
        case .pieces:
            return cc_err(CC_ERR_INTERNAL, "coalesce del arm");
    }
    return cc_err(CC_ERR_INTERNAL, "coalesce del arm");
}

void !>(CCError) RtxDoc_replace(RtxDoc *d, size_t off, size_t n, char[:] ins) {
    char[:] del = cc_slice_empty();
    RtxHistRec rec;
    RtxHistRec *last = NULL;
    size_t len;
    size_t caret0;
    size_t sel0;
    int markup;
    int coalesced = 0;
    if (!d) return cc_err(CC_ERR_INVALID_ARG, "null doc");
    if (d->broken) return cc_err(CC_ERR_INTERNAL, "doc broken");
    len = d->len();
    if (off > len || n > len - off) return cc_err(CC_ERR_INVALID_ARG, "replace range");
    if (n == 0 && ins.len == 0) return cc_ok();
    caret0 = d->caret;
    sel0 = d->sel_anchor;
    rec = rtx_hist_rec_empty();
    rec.sel_box_before = d->sel_box;
    rec.box_acol_before = d->box_acol;
    rec.box_ccol_before = d->box_ccol;
    {
        cc_arena_stack(scratch, RTX_FRAME_SCRATCH);
        Vec::[char] del_own = {0};
        int del_owned = 0;
        if (n && n <= RTX_HIST_INLINE_MAX) {
            if (n <= RTX_FRAME_SCRATCH) {
                char[:] got = d->scratch_span(off, n, scratch) !>(e) {
                    return cc_err(e);
                };
                del = got;
            } else {
                del_own = rtx_hist_buf(d, n) !>(e) { return cc_err(e); };
                {
                    size_t nr = d->read_at(off, del_own.as_slice()) !>(e) {
                        return cc_err(e);
                    };
                    if (nr != n) return cc_err(CC_ERR_INTERNAL, "replace del read");
                }
                del = del_own.as_slice();
                del_owned = 1;
            }
        }
        markup = (n > RTX_HIST_INLINE_MAX) ||
                 rtx_bytes_touch_section(del) ||
                 rtx_bytes_touch_section(ins);
        if (!d->hist.applying) {
            if (d->hist.coalesce && d->hist.head > 0) {
                last = &d->hist.recs[d->hist.head - 1];
                if (rtx_hist_can_coalesce_insert(last, off, n, ins)) {
                    rtx_hist_coalesce_ins_reserve(d, last, ins.len) !>(e) {
                        return cc_err(e);
                    };
                    coalesced = 1;
                } else if (rtx_hist_can_coalesce_erase(last, off, del, ins)) {
                    rtx_hist_coalesce_del_reserve(d, last, del.len) !>(e) {
                        return cc_err(e);
                    };
                    coalesced = 2;
                }
            }
            if (!coalesced) {
                if (n > RTX_HIST_INLINE_MAX) {
                    RtxPieceRef *refs = NULL;
                    size_t nrefs = 0;
                    RtxPieceTree_capture_range(&d->tree, off, n, d->session,
                                               &refs, &nrefs) !>(e) {
                        return cc_err(e);
                    };
                    rec.del = (RtxHistDel){
                        .pieces = { .refs = refs, .n = nrefs, .nbytes = n }
                    };
                } else if (del.len) {
                    if (del_owned) {
                        rec.del = (RtxHistDel){ .text = del_own };
                        del_owned = 0;
                    } else {
                        Vec::[char] keep = rtx_hist_own(d, del) !>(e) {
                            return cc_err(e);
                        };
                        rec.del = (RtxHistDel){ .text = keep };
                    }
                }
                if (ins.len) {
                    Vec::[char] keep = rtx_hist_own(d, ins) !>(e) {
                        return cc_err(e);
                    };
                    rec.ins = keep;
                }
                rtx_hist_grow(d) !>(e) { return cc_err(e); };
            }
        }
        rtx_find_join(&d->find);
        d->tree.replace(off, n, ins) !>(e) {
            if (rtx_err_is_unrestorable(e)) d->broken = 1;
            return cc_err(e);
        };
        d->edit_gen++;
        rtx_doc_shift_intervals(d, off, n, ins.len);
        if (n > 0 && del.len != n)
            d->find_invalidate();
        else
            d->find_after_edit(off, del, ins);
        d->last_off = off;
        d->last_markup = markup;
        d->caret = off + ins.len;
        d->sel_anchor = d->caret;
        d->sel_box = 0;
        d->box_acol = 0;
        d->box_ccol = 0;
        if (!d->hist.applying) {
            if (coalesced == 1 && last) {
                rtx_hist_coalesce_ins_commit(last, ins) !>(e) {
                    /* Tree already mutated; hist still pre-commit. */
                    d->broken = 1;
                    return cc_err(RTX_ERR_UNRESTORABLE, "coalesce commit");
                };
                last->caret_after = d->caret;
                last->sel_after = d->sel_anchor;
                last->sel_box_after = d->sel_box;
                last->box_acol_after = d->box_acol;
                last->box_ccol_after = d->box_ccol;
            } else if (coalesced == 2 && last) {
                rtx_hist_coalesce_del_commit(last, del) !>(e) {
                    d->broken = 1;
                    return cc_err(RTX_ERR_UNRESTORABLE, "coalesce commit");
                };
                last->off = off;
                last->caret_after = d->caret;
                last->sel_after = d->sel_anchor;
                last->sel_box_after = d->sel_box;
                last->box_acol_after = d->box_acol;
                last->box_ccol_after = d->box_ccol;
            } else {
                rtx_hist_drop_tail(&d->hist);
                rec.off = off;
                rec.caret_before = caret0;
                rec.sel_before = sel0;
                rec.caret_after = d->caret;
                rec.sel_after = d->sel_anchor;
                rec.sel_box_after = d->sel_box;
                rec.box_acol_after = d->box_acol;
                rec.box_ccol_after = d->box_ccol;
                d->hist.recs[d->hist.len++] = rec;
                d->hist.head = d->hist.len;
            }
            d->hist.coalesce = 1;
        }
        return cc_ok();
    }
}

void !>(CCError) RtxDoc_insert(RtxDoc *d, size_t off, char[:] bytes) {
    return RtxDoc_replace(d, off, 0, bytes);
}

void !>(CCError) RtxDoc_erase(RtxDoc *d, size_t off, size_t n) {
    return RtxDoc_replace(d, off, n, cc_slice_empty());
}

char[:] !>(CCError) rtx_doc_box_text(RtxDoc *d, CCArena a) {
    size_t ls0, ls1, at, need, used;
    char *p;
    @errhandler(CCError e) {
        return cc_err(e);
    }
    @errhandler(RtxIndexErr ie) {
        return cc_err(CC_ERR_IO, ie.message ? ie.message : "line index");
    }
    if (!d || !a.base) return cc_err(CC_ERR_INVALID_ARG, "box text");
    rtx_doc_box_floors(d, &ls0, &ls1) !>;
    need = 0;
    at = ls0;
    for (;;) {
        size_t a0, b0;
        rtx_box_span_at(d, at, &a0, &b0) !>;
        need += b0 - a0;
        if (at < ls1) need += 1;
        if (at == ls1) break;
        {
            size_t next;
            int has = rtx_doc_next_line_start(d, at, &next) !>;
            if (!has) break;
            at = next;
        }
    }
    if (need == 0) return cc_ok(cc_slice_empty());
    p = (char *)cc_arena_alloc(a, need, 1);
    if (!p) return cc_err(CC_ERR_OUT_OF_MEMORY, "box text");
    used = 0;
    at = ls0;
    for (;;) {
        size_t a0, b0;
        rtx_box_span_at(d, at, &a0, &b0) !>;
        if (b0 > a0) {
            size_t got = d->read_at(at + a0, cc_slice_from_buffer(p + used, b0 - a0)) !>;
            if (got != b0 - a0) return cc_err(CC_ERR_INTERNAL, "box text read");
            used += got;
        }
        if (at < ls1) p[used++] = '\n';
        if (at == ls1) break;
        {
            size_t next;
            int has = rtx_doc_next_line_start(d, at, &next) !>;
            if (!has) break;
            at = next;
        }
    }
    return cc_ok(cc_slice_from_buffer(p, used));
}

void !>(CCError) rtx_doc_box_apply(RtxDoc *d, char[:] ins) {
    size_t ls0, ls1, off0, off1, need, used, dest_col, parts, at, idx;
    char *p;
    CCArena a = {0} @destroy;
    char[:] built;
    @errhandler(CCError e) {
        return cc_err(e);
    }
    @errhandler(RtxIndexErr ie) {
        return cc_err(CC_ERR_IO, ie.message ? ie.message : "line index");
    }
    if (!d) return cc_err(CC_ERR_INVALID_ARG, "box apply");
    rtx_doc_box_floors(d, &ls0, &ls1) !>;
    off0 = ls0;
    {
        int has = rtx_doc_next_line_start(d, ls1, &off1) !>;
        if (!has) off1 = d->len();
    }
    parts = rtx_box_part_count(ins);
    need = 1;
    at = ls0;
    idx = 0;
    for (;;) {
        size_t nlen, a0, b0;
        char[:] part;
        nlen = rtx_doc_line_nlen_at(d, at) !>;
        rtx_box_span_at(d, at, &a0, &b0) !>;
        if (parts <= 1) part = ins;
        else rtx_box_nth_part(ins, idx, &part);
        need += a0 + part.len + (nlen - b0) + 1;
        if (at == ls1) break;
        {
            size_t next;
            int has = rtx_doc_next_line_start(d, at, &next) !>;
            if (!has) break;
            at = next;
            idx++;
        }
    }
    a = cc_arena_heap(need + 64);
    if (!a.base) return cc_err(CC_ERR_OUT_OF_MEMORY, "box apply");
    p = (char *)cc_arena_alloc(a, need, 1);
    if (!p) return cc_err(CC_ERR_OUT_OF_MEMORY, "box apply");
    used = 0;
    dest_col = 0;
    at = ls0;
    idx = 0;
    for (;;) {
        size_t nlen, a0, b0;
        char[:] part;
        nlen = rtx_doc_line_nlen_at(d, at) !>;
        rtx_box_span_at(d, at, &a0, &b0) !>;
        if (parts <= 1) part = ins;
        else rtx_box_nth_part(ins, idx, &part);
        if (idx == 0) dest_col = a0 + part.len;
        if (a0) {
            size_t got = d->read_at(at, cc_slice_from_buffer(p + used, a0)) !>;
            if (got != a0) return cc_err(CC_ERR_INTERNAL, "box apply read");
            used += got;
        }
        if (part.len && part.ptr) {
            char[:] dst = cc_slice_from_buffer(p + used, part.len);
            dst.copy(part) !>;
            used += part.len;
        }
        if (nlen > b0) {
            size_t got = d->read_at(at + b0, cc_slice_from_buffer(p + used, nlen - b0)) !>;
            if (got != nlen - b0) return cc_err(CC_ERR_INTERNAL, "box apply read");
            used += got;
        }
        if (rtx_doc_line_has_nl_at(d, at) !>) p[used++] = '\n';
        if (at == ls1) break;
        {
            size_t next;
            int has = rtx_doc_next_line_start(d, at, &next) !>;
            if (!has) break;
            at = next;
            idx++;
        }
    }
    built = cc_slice_from_buffer(p, used);
    d->replace(off0, off1 - off0, built) !>;
    d->sel_box = 1;
    d->box_acol = dest_col;
    d->box_ccol = dest_col;
    {
        size_t a0 = off0;
        size_t a1 = off0;
        size_t c0, c1;
        @for (i, ch in built) {
            if (ch == '\n' && i + 1 < built.len) a1 = off0 + i + 1;
        }
        c0 = rtx_box_col_at(d, a0, dest_col) !>;
        c1 = rtx_box_col_at(d, a1, dest_col) !>;
        d->sel_anchor = a0 + c0;
        d->caret = a1 + c1;
    }
    if (d->hist.head > 0) {
        RtxHistRec *r = &d->hist.recs[d->hist.head - 1];
        r->caret_after = d->caret;
        r->sel_after = d->sel_anchor;
        r->sel_box_after = d->sel_box;
        r->box_acol_after = d->box_acol;
        r->box_ccol_after = d->box_ccol;
    }
    return cc_ok();
}

void !>(CCError) RtxDoc_type(RtxDoc *d, char[:] bytes) {
    if (!d) return cc_err(CC_ERR_INVALID_ARG, "null doc");
    if (d->sel_box && d->has_sel()) return rtx_doc_box_apply(d, bytes);
    if (d->has_sel()) {
        size_t lo = d->sel_lo();
        size_t hi = d->sel_hi();
        return d->replace(lo, hi - lo, bytes);
    }
    return d->replace(d->caret, 0, bytes);
}

void !>(CCError) RtxDoc_type_cp(RtxDoc *d, uint32_t cp) {
    char buf[4];
    int n = rtx_utf8_encode(cp, buf);
    if (n <= 0) return cc_ok();
    return d->type(buf.to_slice_n((size_t)n));
}

void !>(CCError) RtxDoc_backspace(RtxDoc *d) {
    @errhandler(RtxIndexErr ie) {
        return cc_err(CC_ERR_IO, ie.message ? ie.message : "line index");
    }
    if (!d) return cc_err(CC_ERR_INVALID_ARG, "null doc");
    if (d->sel_box && d->has_sel()) {
        size_t ls0, ls1, a, b;
        rtx_doc_box_floors(d, &ls0, &ls1) !>;
        (void)ls1;
        rtx_box_span_at(d, ls0, &a, &b) !>;
        if (a == b) {
            if (a == 0) return cc_ok();
            {
                size_t prev = d->cluster_prev(ls0 + a) !>(e) { return cc_err(e); };
                if (prev < ls0) return cc_ok();
                d->box_acol = prev - ls0;
                d->box_ccol = a;
            }
        }
        return rtx_doc_box_apply(d, cc_slice_empty());
    }
    if (d->has_sel()) {
        size_t lo = d->sel_lo();
        size_t hi = d->sel_hi();
        return d->replace(lo, hi - lo, cc_slice_empty());
    }
    if (d->caret == 0) return cc_ok();
    {
        size_t a = d->cluster_align(d->caret) !>(e) { return cc_err(e); };
        if (a < d->caret) {
            size_t b = d->cluster_next(a) !>(e) { return cc_err(e); };
            if (b <= a) return cc_ok();
            return d->replace(a, b - a, cc_slice_empty());
        }
        {
            size_t prev = d->cluster_prev(d->caret) !>(e) { return cc_err(e); };
            if (prev >= d->caret) return cc_ok();
            return d->replace(prev, d->caret - prev, cc_slice_empty());
        }
    }
}

void !>(CCError) RtxDoc_delete_forward(RtxDoc *d) {
    size_t len;
    @errhandler(RtxIndexErr ie) {
        return cc_err(CC_ERR_IO, ie.message ? ie.message : "line index");
    }
    if (!d) return cc_err(CC_ERR_INVALID_ARG, "null doc");
    if (d->sel_box && d->has_sel()) {
        size_t ls0, ls1, a, b;
        rtx_doc_box_floors(d, &ls0, &ls1) !>;
        (void)ls1;
        rtx_box_span_at(d, ls0, &a, &b) !>;
        if (a == b) {
            size_t next = d->cluster_next(ls0 + a) !>(e) { return cc_err(e); };
            size_t end = rtx_doc_line_end_caret(d, ls0) !>;
            if (next > end) next = end;
            d->box_acol = a;
            d->box_ccol = next - ls0;
        }
        return rtx_doc_box_apply(d, cc_slice_empty());
    }
    if (d->has_sel()) return d->backspace();
    len = d->len();
    if (d->caret >= len) return cc_ok();
    {
        size_t a = d->cluster_align(d->caret) !>(e) { return cc_err(e); };
        size_t b = d->cluster_next(a) !>(e) { return cc_err(e); };
        if (b <= a) return cc_ok();
        return d->replace(a, b - a, cc_slice_empty());
    }
}

/* --- edit groups (DESIGN Edit groups) ---
 * A group is several `replace`s recorded as one undo step. Every path
 * that moves a group (replace_batch, undo, redo) builds ops sorted by
 * offset in the coordinates before the group and hands them to
 * rtx_group_apply: one find / island join, tree writes in descending
 * offset order, then one interval / span / find patch. */

/* One side of an op: bytes, or piece refs (a delete above INLINE_MAX). */
typedef struct {
    char[:] text;
    const RtxPieceRef *refs;
    size_t nrefs;
    size_t n;
} RtxGroupSide;

/* [at, at + del.n) holds `del` now and becomes `ins`. */
typedef struct {
    size_t at;
    RtxGroupSide del;
    RtxGroupSide ins;
} RtxGroupOp;

/* Up to this many sites patch the find list per site (seam reread);
 * above it the list wipes once and the next pump rescans. */
#define RTX_GROUP_FIND_PATCH 16

static RtxGroupSide rtx_group_text(char[:] t) {
    RtxGroupSide s = {0};
    s.text = t.len ? t : cc_slice_empty();
    s.n = t.len;
    return s;
}

static RtxGroupSide rtx_group_rec_del(const RtxHistRec *r) {
    RtxGroupSide s = {0};
    if (rtx_hist_del_is_pieces(r)) {
        RtxHistRefs refs = rtx_hist_del_pieces(r);
        s.text = cc_slice_empty();
        s.refs = refs.refs;
        s.nrefs = refs.n;
        s.n = refs.nbytes;
        return s;
    }
    return rtx_group_text(rtx_hist_del_view(r));
}

static RtxGroupSide rtx_group_rec_ins(const RtxHistRec *r) {
    return rtx_group_text(rtx_hist_ins_view(r));
}

/* Tree write: [at, at + old_n) -> put. Unchanged on a plain failure. A
 * splice that fails after the erase landed is RTX_ERR_UNRESTORABLE (the
 * rule single undo keeps). */
static void !>(CCError) rtx_group_put(RtxDoc *d, size_t at, size_t old_n,
                                     const RtxGroupSide *put) {
    if (!put->nrefs) return d->tree.replace(at, old_n, put->text);
    if (old_n) {
        d->tree.replace(at, old_n, cc_slice_empty()) !>(e) { return cc_err(e); };
    }
    d->tree.splice_refs(at, put->refs, put->nrefs) !>(e) {
        (void)e;
        return cc_err(RTX_ERR_UNRESTORABLE, "group splice");
    };
    return cc_ok();
}

/* Ops sorted by `at`, non-overlapping, in range, none empty. Two ops may
 * share `at` when the first erases nothing: undo of a pure delete that
 * touches the next site puts both at one post-edit offset (descending
 * order inserts the lower site's bytes in front, as it should). */
static int rtx_group_ops_ok(const RtxGroupOp *ops, size_t k, size_t len) {
    size_t i;
    if (!ops || k == 0) return 0;
    for (i = 0; i < k; i++) {
        if (ops[i].del.n == 0 && ops[i].ins.n == 0) return 0;
        if (ops[i].at > len || ops[i].del.n > len - ops[i].at) return 0;
        if (ops[i].del.n && !ops[i].del.nrefs && ops[i].del.text.len != ops[i].del.n)
            return 0;
        if (ops[i].ins.n && !ops[i].ins.nrefs && ops[i].ins.text.len != ops[i].ins.n)
            return 0;
        if (i && (ops[i - 1].at > ops[i].at ||
                  (ops[i - 1].at == ops[i].at && ops[i - 1].del.n) ||
                  ops[i - 1].at + ops[i - 1].del.n > ops[i].at))
            return 0;
    }
    return 1;
}

/* Ops with at < x. */
static size_t rtx_group_n_before(const RtxGroupOp *ops, size_t k, size_t x) {
    size_t lo = 0, hi = k;
    while (lo < hi) {
        size_t mid = lo + (hi - lo) / 2;
        if (ops[mid].at < x) lo = mid + 1;
        else hi = mid;
    }
    return lo;
}

/* Ops whose erase ends at or before x (at + del.n is non-decreasing). */
static size_t rtx_group_n_clear(const RtxGroupOp *ops, size_t k, size_t x) {
    size_t lo = 0, hi = k;
    while (lo < hi) {
        size_t mid = lo + (hi - lo) / 2;
        if (ops[mid].at + ops[mid].del.n <= x) lo = mid + 1;
        else hi = mid;
    }
    return lo;
}

static size_t rtx_group_add(size_t x, ptrdiff_t dv) {
    return dv < 0 ? x - (size_t)(-dv) : x + (size_t)dv;
}

/* rtx_doc_shift_intervals for every op in descending order, in one pass
 * over secs and runs (pre[i] is the length change of ops [0, i)). */
static void rtx_group_shift(RtxDoc *d, const RtxGroupOp *ops, size_t k,
                            const ptrdiff_t *pre) {
    size_t i;
    if (k == 1) {
        rtx_doc_shift_intervals(d, ops[0].at, ops[0].del.n, ops[0].ins.n);
        return;
    }
    for (i = k; i-- > 0;) {
        rtx_doc_span_note(d, ops[i].at, ops[i].del.n, ops[i].ins.n);
        if (d->fold_n) rtx_doc_fold_shift(d, ops[i].at, ops[i].del.n, ops[i].ins.n);
    }
    for (i = 0; i < (size_t)RTX_MARKUP_CACHE_WINDOWS; i++)
        d->hl_win[i] = (RtxMarkupWin){0};
    d->hl_win_stamp = 0;
    d->hl_cov.live = 0;
    rtx_tm_ckpt_drop_from(d, ops[0].at);
    for (i = 0; i < d->secs.len; i++) {
        size_t s = d->secs.data[i].start;
        size_t j = rtx_group_n_before(ops, k, s);
        if (j == 0) continue;
        if (ops[j - 1].del.n && s - ops[j - 1].at < ops[j - 1].del.n)
            d->secs.data[i].start = rtx_group_add(ops[j - 1].at, pre[j - 1]);
        else
            d->secs.data[i].start = rtx_group_add(s, pre[j]);
    }
    rtx_doc_run_top_drop(d);
    d->runs_maxlen = (size_t)-1;
    for (i = 0; i < d->runs.len; i++) {
        RtxRun *r = &d->runs.data[i];
        size_t j = rtx_group_n_before(ops, k, r->start + r->len);
        size_t m = rtx_group_n_clear(ops, k, r->start);
        size_t t;
        if (m > j) m = j;
        /* Ops that touch the run, literally; then one shift for the ops
         * wholly below it. */
        for (t = j; t-- > m;)
            rtx_run_shift_one(r, ops[t].at, ops[t].del.n, ops[t].ins.n);
        if (m) r->start = rtx_group_add(r->start, pre[m]);
    }
}

/* Put back ops [from, to) that already landed. Ascending: each `at` is
 * still exact while the ops above it stay applied. */
static void !>(CCError) rtx_group_rollback(RtxDoc *d, const RtxGroupOp *ops,
                                          size_t from, size_t to) {
    size_t i;
    for (i = from; i < to; i++) {
        rtx_group_put(d, ops[i].at, ops[i].ins.n, &ops[i].del) !>(e) {
            return cc_err(e);
        };
    }
    return cc_ok();
}

/* Apply a group's ops. Unchanged on failure (members already written are
 * rolled back), or broken when a member or its rollback could not be put
 * back. On success: edit_gen, intervals, span, find, last_off / markup. */
static void !>(CCError) rtx_group_apply(RtxDoc *d, const RtxGroupOp *ops, size_t k) {
    CCArena a = {0} @destroy;
    ptrdiff_t *pre;
    size_t i;
    int patch_find, markup = 0;
    if (!d) return cc_err(CC_ERR_INVALID_ARG, "group apply");
    if (d->broken) return cc_err(CC_ERR_INTERNAL, "doc broken");
    if (!rtx_group_ops_ok(ops, k, d->len()))
        return cc_err(CC_ERR_INVALID_ARG, "group ops");
    a = cc_arena_heap((k + 1) * sizeof(ptrdiff_t) + 64);
    if (!a.base) return cc_err(CC_ERR_OUT_OF_MEMORY, "group apply");
    pre = (ptrdiff_t *)cc_arena_alloc(a, (k + 1) * sizeof(ptrdiff_t), 8);
    if (!pre) return cc_err(CC_ERR_OUT_OF_MEMORY, "group apply");
    pre[0] = 0;
    patch_find = d->find.query.len && k <= (size_t)RTX_GROUP_FIND_PATCH;
    for (i = 0; i < k; i++) {
        pre[i + 1] = pre[i] + (ptrdiff_t)ops[i].ins.n - (ptrdiff_t)ops[i].del.n;
        if (ops[i].del.nrefs || ops[i].ins.nrefs) {
            markup = 1;
            patch_find = 0;
        } else if (ops[i].del.n > RTX_HIST_INLINE_MAX ||
                   rtx_bytes_touch_section(ops[i].del.text) ||
                   rtx_bytes_touch_section(ops[i].ins.text)) {
            markup = 1;
        }
    }
    /* Find and island lanes read nodes: join both once before the first
     * write. The tree's per-write island stop is then a no-op. */
    rtx_find_join(&d->find);
    rtx_isle_handle_stop(&d->tree);
    for (i = k; i-- > 0;) {
        rtx_group_put(d, ops[i].at, ops[i].del.n, &ops[i].ins) !>(e) {
            if (rtx_err_is_unrestorable(e)) {
                d->broken = 1;
                return cc_err(e);
            }
            rtx_group_rollback(d, ops, i + 1, k) !>(e2) {
                (void)e2;
                d->broken = 1;
                return cc_err(RTX_ERR_UNRESTORABLE, "group rollback");
            };
            if (patch_find && i + 1 < k) d->find_invalidate();
            return cc_err(e);
        };
        if (patch_find)
            d->find_after_edit(ops[i].at, ops[i].del.text, ops[i].ins.text);
    }
    d->edit_gen++;
    rtx_group_shift(d, ops, k, pre);
    if (!patch_find) d->find_invalidate();
    d->last_off = ops[0].at;
    /* reparse_edit relexes the section at last_off: sites that reach
     * another section need the full pass. */
    if (!markup) {
        size_t lo = ops[0].at;
        size_t hi = rtx_group_add(ops[k - 1].at, pre[k - 1]) + ops[k - 1].ins.n;
        for (i = 0; i < d->secs.len; i++) {
            size_t s = d->secs.data[i].start;
            if (s > lo && s <= hi) {
                markup = 1;
                break;
            }
        }
    }
    d->last_markup = markup;
    return cc_ok();
}

void !>(CCError) rtx_doc_replace_group(RtxDoc *d, const RtxEdit *edits, size_t n,
                                       uint64_t xact) {
    CCArena a = {0} @destroy;
    RtxGroupOp *ops;
    RtxHistRec *prep;
    size_t i, k, t, len, caret0, sel0, bac0, bcc0, caret1;
    int box0;
    ptrdiff_t acc;
    @errhandler(CCError e) {
        return cc_err(e);
    }
    if (!d) return cc_err(CC_ERR_INVALID_ARG, "null doc");
    if (d->broken) return cc_err(CC_ERR_INTERNAL, "doc broken");
    if (n == 0) return cc_ok();
    if (!edits) return cc_err(CC_ERR_INVALID_ARG, "group edits");
    if (n > RTX_GROUP_MAX) return cc_err(CC_ERR_INVALID_ARG, "group too large");
    len = d->len();
    k = 0;
    for (i = 0; i < n; i++) {
        if (edits[i].off > len || edits[i].n > len - edits[i].off)
            return cc_err(CC_ERR_INVALID_ARG, "group range");
        if (edits[i].ins.len && !edits[i].ins.ptr)
            return cc_err(CC_ERR_INVALID_ARG, "group bytes");
        if (i && (edits[i - 1].off >= edits[i].off ||
                  edits[i - 1].off + edits[i - 1].n > edits[i].off))
            return cc_err(CC_ERR_INVALID_ARG, "group order");
        if (edits[i].n || edits[i].ins.len) k++;
    }
    if (k == 0) return cc_ok();
    if (k == 1 && !xact) {
        for (i = 0; i < n; i++) {
            if (edits[i].n || edits[i].ins.len)
                return rtx_doc_policy_replace(d, edits[i].off, edits[i].n,
                                              edits[i].ins);
        }
    }
    if (rtx_group_is_bulk(edits, n)) {
        /* One sequence swap and one record, not k replaces (bulk). */
        RtxBulk b = {0} @destroy { rtx_bulk_drop(&b); };
        rtx_bulk_kick(&b, d, edits, n) !>;
        (void)rtx_bulk_step(&b, 0, NULL) !>;
        rtx_bulk_commit(&b, xact) !>;
        return cc_ok();
    }
    a = cc_arena_heap(k * (sizeof(RtxGroupOp) + sizeof(RtxHistRec)) + 64);
    if (!a.base) return cc_err(CC_ERR_OUT_OF_MEMORY, "group");
    ops = (RtxGroupOp *)cc_arena_alloc(a, k * sizeof(RtxGroupOp), 8);
    prep = (RtxHistRec *)cc_arena_alloc(a, k * sizeof(RtxHistRec), 8);
    if (!ops || !prep) return cc_err(CC_ERR_OUT_OF_MEMORY, "group");
    /* Everything hist needs exists before the first byte moves. */
    if (!d->hist.applying) {
        size_t need = d->hist.head + k;
        if (need < d->hist.head) return cc_err(CC_ERR_OUT_OF_MEMORY, "group hist");
        rtx_hist_reserve(d, need) !>;
    }
    caret0 = d->caret;
    sel0 = d->sel_anchor;
    box0 = d->sel_box;
    bac0 = d->box_acol;
    bcc0 = d->box_ccol;
    t = 0;
    acc = 0;
    caret1 = 0;
    for (i = 0; i < n; i++) {
        const RtxEdit *ed = &edits[i];
        RtxGroupOp *op;
        RtxHistRec *rec;
        if (!ed->n && !ed->ins.len) continue;
        op = &ops[t];
        rec = &prep[t];
        *rec = rtx_hist_rec_empty();
        op->at = ed->off;
        op->del = rtx_group_text(cc_slice_empty());
        op->ins = rtx_group_text(cc_slice_empty());
        if (ed->n > RTX_HIST_INLINE_MAX) {
            RtxPieceRef *refs = NULL;
            size_t nrefs = 0;
            RtxPieceTree_capture_range(&d->tree, ed->off, ed->n, d->session,
                                       &refs, &nrefs) !>;
            rec->del = (RtxHistDel){
                .pieces = { .refs = refs, .n = nrefs, .nbytes = ed->n }
            };
            op->del.refs = refs;
            op->del.nrefs = nrefs;
            op->del.n = ed->n;
        } else if (ed->n) {
            Vec::[char] keep = rtx_hist_buf(d, ed->n) !>;
            size_t got = d->read_at(ed->off, keep.as_slice()) !>;
            if (got != ed->n) return cc_err(CC_ERR_INTERNAL, "group del read");
            rec->del = (RtxHistDel){ .text = keep };
            op->del = rtx_group_text(keep.as_slice());
        }
        if (ed->ins.len) {
            Vec::[char] keep = rtx_hist_own(d, ed->ins) !>;
            rec->ins = keep;
            op->ins = rtx_group_text(keep.as_slice());
        }
        caret1 = rtx_group_add(ed->off, acc) + ed->ins.len;
        acc += (ptrdiff_t)ed->ins.len - (ptrdiff_t)ed->n;
        t++;
    }
    RtxDoc_break_coalesce(d);
    rtx_group_apply(d, ops, k) !>;
    d->caret = caret1;
    d->sel_anchor = caret1;
    d->sel_box = 0;
    d->box_acol = 0;
    d->box_ccol = 0;
    if (!d->hist.applying) {
        size_t gid;
        rtx_hist_drop_tail(&d->hist);
        gid = ++d->hist.group_next;
        /* Apply order: the highest site first. */
        for (t = k; t-- > 0;) {
            RtxHistRec rec = prep[t];
            rec.off = ops[t].at;
            rec.caret_before = caret0;
            rec.sel_before = sel0;
            rec.sel_box_before = box0;
            rec.box_acol_before = bac0;
            rec.box_ccol_before = bcc0;
            rec.caret_after = d->caret;
            rec.sel_after = d->sel_anchor;
            rec.sel_box_after = 0;
            rec.box_acol_after = 0;
            rec.box_ccol_after = 0;
            rec.group = gid;
            rec.xact = xact;
            d->hist.recs[d->hist.len++] = rec;
        }
        d->hist.head = d->hist.len;
    }
    RtxDoc_break_coalesce(d);
    return cc_ok();
}

void !>(CCError) RtxDoc_replace_batch(RtxDoc *d, const RtxEdit *edits, size_t n) {
    return rtx_doc_replace_group(d, edits, n, 0);
}

/* ------------------------------------------------------------ bulk groups
 * DESIGN Edit groups (bulk). A large group is not n tree replaces: one
 * pass over the sites builds the post-edit piece sequence of the touched
 * range [lo, hi) — untouched spans of at least gap_ref bytes stay refs
 * into the original / add buffers; shorter spans and every inserted byte
 * go, in order, into ONE contiguous add append staged past the published
 * add end — and commit swaps it in (RtxPieceTree_bulk_swap: O(pieces)).
 * The record keeps both sequences, so undo / redo are swaps too, and the
 * site list once (`enc`, deduped against the previous site) for Safe. */

static size_t rtx_bulk_min = 0;
static size_t rtx_bulk_gap = 0;

void rtx_bulk_tune(size_t bulk_min, size_t gap_ref) {
    rtx_bulk_min = bulk_min;
    rtx_bulk_gap = gap_ref;
}

static size_t rtx_bulk_min_now(void) {
    return rtx_bulk_min ? rtx_bulk_min : (size_t)RTX_GROUP_BULK_MIN;
}

static size_t rtx_bulk_gap_now(void) {
    return rtx_bulk_gap ? rtx_bulk_gap : (size_t)RTX_BULK_GAP_REF;
}

size_t rtx_group_bulk_min(void) {
    size_t m = rtx_bulk_min_now();
    return m < 2 ? 2 : m;
}

int rtx_group_is_bulk(const RtxEdit *edits, size_t n) {
    size_t i, k = 0, min = rtx_bulk_min_now();
    if (!edits || min == (size_t)-1) return 0;
    for (i = 0; i < n; i++) {
        if (edits[i].n > (size_t)RTX_HIST_INLINE_MAX) return 0;
        if (edits[i].n || edits[i].ins.len) k++;
    }
    return k >= 2 && k >= min;
}

static long rtx_bulk_ms(void) {
    struct timespec ts;
    clock_gettime(CLOCK_MONOTONIC, &ts);
    return (long)ts.tv_sec * 1000L + (long)(ts.tv_nsec / 1000000L);
}

static size_t rtx_vput(char *p, size_t v) {
    size_t k = 0;
    while (v >= 0x80) {
        p[k++] = (char)(unsigned char)(v | 0x80);
        v >>= 7;
    }
    p[k++] = (char)(unsigned char)v;
    return k;
}

static int rtx_vget(const char *p, size_t n, size_t *pos, size_t *v) {
    size_t x = 0;
    unsigned sh = 0;
    while (*pos < n && sh < 64) {
        unsigned char c = (unsigned char)p[(*pos)++];
        x |= (size_t)(c & 0x7f) << sh;
        if (!(c & 0x80)) {
            *v = x;
            return 1;
        }
        sh += 7;
    }
    return 0;
}

/* Next site: 1 = *out, 0 = end, -1 = a malformed enc. */
static int rtx_site_next(RtxSiteSrc *s, RtxEdit *out) {
    size_t gap, dv, iv, dn, in, off;
    const char *del = NULL, *ins = NULL;
    if (s->eds) {
        while (s->i < s->n) {
            const RtxEdit *e = &s->eds[s->i++];
            if (!e->n && !e->ins.len) continue;
            *out = *e;
            return 1;
        }
        return 0;
    }
    if (!s->left) return 0;
    if (!rtx_vget(s->enc, s->enc_n, &s->pos, &gap) ||
        !rtx_vget(s->enc, s->enc_n, &s->pos, &dv) ||
        !rtx_vget(s->enc, s->enc_n, &s->pos, &iv))
        return -1;
    dn = dv >> 1;
    in = iv >> 1;
    if (!dn && !in) return -1;
    if (s->old_at + gap < s->old_at) return -1;
    off = s->old_at + gap;
    if (dn) {
        if (dv & 1) {
            if (s->pdel_n != dn) return -1;
            del = s->pdel;
        } else {
            if (dn > s->enc_n - s->pos) return -1;
            del = s->enc + s->pos;
            s->pos += dn;
            s->pdel = del;
            s->pdel_n = dn;
        }
    } else if (dv & 1) {
        return -1;
    }
    if (in) {
        if (iv & 1) {
            if (s->pins_n != in) return -1;
            ins = s->pins;
        } else {
            if (in > s->enc_n - s->pos) return -1;
            ins = s->enc + s->pos;
            s->pos += in;
            s->pins = ins;
            s->pins_n = in;
        }
    } else if (iv & 1) {
        return -1;
    }
    if (off + dn < off) return -1;
    s->old_at = off + dn;
    if (!s->inverse) {
        out->off = off;
        out->n = dn;
        out->ins = in ? cc_slice_from_buffer((char *)ins, in) : cc_slice_empty();
    } else {
        out->off = (size_t)((ptrdiff_t)off + s->acc);
        out->n = in;
        out->ins = dn ? cc_slice_from_buffer((char *)del, dn) : cc_slice_empty();
    }
    s->acc += (ptrdiff_t)in - (ptrdiff_t)dn;
    s->left--;
    return 1;
}

/* Every site of an enc decodes and the totals match the record. */
static int rtx_bulk_enc_ok(const RtxHistBulk *hb) {
    RtxSiteSrc s = {0};
    RtxEdit e;
    size_t n = 0, first = 0, end = 0, prev = 0;
    int r;
    if (!hb || !hb->nsites || !hb->enc) return 0;
    s.enc = hb->enc;
    s.enc_n = hb->enc_n;
    s.left = hb->nsites;
    s.old_at = hb->lo;
    while ((r = rtx_site_next(&s, &e)) == 1) {
        if (n && e.off <= prev) return 0;
        if (!n) first = e.off;
        prev = e.off;
        end = e.off + e.n;
        n++;
    }
    if (r < 0 || n != hb->nsites || s.pos != hb->enc_n || first != hb->lo) return 0;
    if (end - hb->lo != hb->old_n) return 0;
    if ((ptrdiff_t)hb->old_n + s.acc != (ptrdiff_t)hb->new_n) return 0;
    return 1;
}

int rtx_hist_bulk_enc_ok(const RtxHistBulk *hb) {
    return rtx_bulk_enc_ok(hb);
}

void rtx_bulk_drop(RtxBulk *b) {
    if (!b) return;
    if (b->a.base) b->a.destroy();
    if (b->ra.base) b->ra.destroy();
    if (b->ea.base) b->ea.destroy();
    *b = (RtxBulk){0};
}

/* Shared kick: range, capture of the old sequence, scratch. */
static void !>(CCError) rtx_bulk_start(RtxBulk *b, RtxDoc *d, size_t lo, size_t old_n,
                                       size_t nsites) {
    size_t len;
    if (!d) return cc_err(CC_ERR_INVALID_ARG, "bulk doc");
    if (d->broken) return cc_err(CC_ERR_INTERNAL, "doc broken");
    len = d->len();
    if (lo > len || old_n > len - lo) return cc_err(CC_ERR_INVALID_ARG, "bulk range");
    b->d = d;
    b->gen = d->edit_gen;
    b->nsites = nsites;
    b->lo = lo;
    b->old_n = old_n;
    b->cur = lo;
    b->add_base = RtxPieceTree_add_end(&d->tree);
    b->gap_ref = rtx_bulk_gap_now();
    /* A huge doc's swap goes progressive (weights unread): skip counting. */
    b->count_lf = len <= (size_t)RTX_LINE_SOFT_MIN;
    b->wcap = (size_t)1 << 20;
    b->bcap = (size_t)1 << 20;
    b->wchunk = kilobytes(64);
    b->a = cc_arena_heap(b->wcap + b->bcap + (b->want_enc ? RTX_HIST_INLINE_MAX : 0) +
                         kilobytes(64));
    b->ra = cc_arena_heap(kilobytes(64));
    b->ea = cc_arena_heap(b->want_enc ? kilobytes(256) : kilobytes(4));
    if (!b->a.base || !b->ra.base || !b->ea.base)
        return cc_err(CC_ERR_OUT_OF_MEMORY, "bulk scratch");
    b->win = (char *)cc_arena_alloc(b->a, b->wcap, 16);
    b->blob = (char *)cc_arena_alloc(b->a, b->bcap, 16);
    if (b->want_enc) b->pdel = (char *)cc_arena_alloc(b->a, RTX_HIST_INLINE_MAX, 16);
    if (!b->win || !b->blob || (b->want_enc && !b->pdel))
        return cc_err(CC_ERR_OUT_OF_MEMORY, "bulk scratch");
    RtxPieceTree_capture_range(&d->tree, lo, old_n, b->a, &b->olds, &b->nold) !>(e) {
        return cc_err(e);
    };
    b->opos = lo;
    return cc_ok();
}

void !>(CCError) rtx_bulk_kick(RtxBulk *b, RtxDoc *d, const RtxEdit *edits, size_t n) {
    size_t i, k = 0, lo = 0, hi = 0;
    if (!b || !d || (n && !edits)) return cc_err(CC_ERR_INVALID_ARG, "bulk kick");
    rtx_bulk_drop(b);
    for (i = 0; i < n; i++) {
        if (!edits[i].n && !edits[i].ins.len) continue;
        if (edits[i].n > (size_t)RTX_HIST_INLINE_MAX)
            return cc_err(CC_ERR_INVALID_ARG, "bulk: a site deletes too much");
        if (!k) lo = edits[i].off;
        hi = edits[i].off + edits[i].n;
        k++;
    }
    if (!k) return cc_err(CC_ERR_INVALID_ARG, "bulk: no site");
    b->src.eds = edits;
    b->src.n = n;
    b->want_enc = 1;
    rtx_bulk_start(b, d, lo, hi - lo, k) !>(e) {
        rtx_bulk_drop(b);
        return cc_err(e);
    };
    return cc_ok();
}

/* A record's own sites (a journal load): forward rebuilds redo's
 * sequence from the pre-state, inverse undo's from the post-state. */
static void !>(CCError) rtx_bulk_kick_enc(RtxBulk *b, RtxDoc *d, const RtxHistBulk *hb,
                                          int inverse) {
    rtx_bulk_drop(b);
    b->src.enc = hb->enc;
    b->src.enc_n = hb->enc_n;
    b->src.left = hb->nsites;
    b->src.old_at = hb->lo;
    b->src.inverse = inverse;
    b->want_enc = 0;
    rtx_bulk_start(b, d, hb->lo, inverse ? hb->new_n : hb->old_n, hb->nsites) !>(e) {
        rtx_bulk_drop(b);
        return cc_err(e);
    };
    return cc_ok();
}

static void !>(CCError) rtx_bulk_ref_push(RtxBulk *b, RtxPieceRef r) {
    if (!r.len) return cc_ok();
    if (b->nnew && !b->run_open) {
        RtxPieceRef *l = &b->news[b->nnew - 1];
        if (l->buf == r.buf && l->start + l->len == r.start) {
            l->len += r.len;
            l->lf_count += r.lf_count;
            l->lf_ok = l->lf_ok && r.lf_ok;
            return cc_ok();
        }
    }
    if (b->nnew == b->ncap) {
        size_t nc = b->ncap ? b->ncap * 2 : 256;
        void *p = cc_arena_realloc(b->ra, b->ra, b->news, b->ncap * sizeof(RtxPieceRef),
                                   nc * sizeof(RtxPieceRef), 8);
        if (!p) return cc_err(CC_ERR_OUT_OF_MEMORY, "bulk refs");
        b->news = (RtxPieceRef *)p;
        b->ncap = nc;
    }
    b->news[b->nnew++] = r;
    return cc_ok();
}

static void !>(CCError) rtx_bulk_flush(RtxBulk *b) {
    if (!b->bn) return cc_ok();
    RtxPieceTree_stage_add(&b->d->tree, b->staged,
                           cc_slice_from_buffer(b->blob, b->bn)) !>(e) {
        return cc_err(e);
    };
    b->staged += b->bn;
    b->bn = 0;
    return cc_ok();
}

/* Bytes of the new sequence that live in the group's add append. */
static void !>(CCError) rtx_bulk_blob(RtxBulk *b, const char *p, size_t n) {
    size_t lf = 0;
    if (!n) return cc_ok();
    if (b->count_lf) lf = rtx_count_lf(p, n);
    if (!b->run_open) {
        RtxPieceRef r = {0};
        r.buf = RTX_BUF_ADD;
        r.lf_ok = b->count_lf ? 1 : 0;
        r.start = b->add_base + b->staged + b->bn;
        r.len = 0;
        r.lf_count = 0;
        if (b->nnew == b->ncap) {
            size_t nc = b->ncap ? b->ncap * 2 : 256;
            void *q = cc_arena_realloc(b->ra, b->ra, b->news,
                                       b->ncap * sizeof(RtxPieceRef),
                                       nc * sizeof(RtxPieceRef), 8);
            if (!q) return cc_err(CC_ERR_OUT_OF_MEMORY, "bulk refs");
            b->news = (RtxPieceRef *)q;
            b->ncap = nc;
        }
        b->news[b->nnew++] = r;
        b->run_open = 1;
    }
    b->news[b->nnew - 1].len += n;
    b->news[b->nnew - 1].lf_count += lf;
    b->new_n += n;
    while (n) {
        size_t take = b->bcap - b->bn;
        if (take > n) take = n;
        memcpy(b->blob + b->bn, p, take);
        b->bn += take;
        p += take;
        n -= take;
        if (b->bn == b->bcap) rtx_bulk_flush(b) !>(e) { return cc_err(e); };
    }
    return cc_ok();
}

/* Old bytes [from, from + n) buffered (n <= wcap). Sequential needs grow
 * the read to 1 MiB; a jump reads 64 KiB (a page, as a replace would). */
static const char *!>(CCError) rtx_bulk_need(RtxBulk *b, size_t from, size_t n) {
    size_t want, hi = b->lo + b->old_n, got;
    if (n > b->wcap || from < b->lo || from > hi || n > hi - from)
        return cc_err(CC_ERR_INTERNAL, "bulk read range");
    if (from >= b->w0 && from + n <= b->w1 && b->w1 > b->w0) return cc_ok(b->win + (from - b->w0));
    if (from == b->w1 && b->w1 > b->w0) {
        b->wchunk *= 2;
        if (b->wchunk > b->wcap) b->wchunk = b->wcap;
    } else {
        b->wchunk = kilobytes(64);
    }
    want = b->wchunk > n ? b->wchunk : n;
    if (want > hi - from) want = hi - from;
    got = RtxPieceTree_read_uncached(&b->d->tree, from,
                                     cc_slice_from_buffer(b->win, want)) !>(e) {
        return cc_err(e);
    };
    if (got != want) return cc_err(CC_ERR_IO, "bulk: short read");
    b->w0 = from;
    b->w1 = from + want;
    return cc_ok(b->win);
}

/* Untouched old bytes [from, from + n) into the new sequence: refs for a
 * long span, a copy into the add append for a short one. */
static void !>(CCError) rtx_bulk_keep(RtxBulk *b, size_t from, size_t n) {
    if (!n) return cc_ok();
    if (n >= b->gap_ref) {
        size_t end = from + n;
        b->run_open = 0;
        while (b->oi < b->nold && b->opos + b->olds[b->oi].len <= from) {
            b->opos += b->olds[b->oi].len;
            b->oi++;
        }
        while (from < end) {
            const RtxPieceRef *o;
            size_t s, z;
            RtxPieceRef r = {0};
            if (b->oi >= b->nold) return cc_err(CC_ERR_INTERNAL, "bulk old walk");
            o = &b->olds[b->oi];
            s = from - b->opos;
            z = o->len - s;
            if (z > end - from) z = end - from;
            r.buf = o->buf;
            r.start = o->start + s;
            r.len = z;
            r.lf_ok = (s == 0 && z == o->len) ? o->lf_ok : 0;
            r.lf_count = r.lf_ok ? o->lf_count : 0;
            rtx_bulk_ref_push(b, r) !>(e) { return cc_err(e); };
            from += z;
            if (s + z == o->len) {
                b->opos += o->len;
                b->oi++;
            }
        }
        b->new_n += n;
        return cc_ok();
    }
    while (n) {
        size_t take = n > b->wcap ? b->wcap : n;
        const char *p = rtx_bulk_need(b, from, take) !>(e) { return cc_err(e); };
        rtx_bulk_blob(b, p, take) !>(e) { return cc_err(e); };
        from += take;
        n -= take;
    }
    return cc_ok();
}

static void !>(CCError) rtx_bulk_enc_room(RtxBulk *b, size_t add) {
    size_t need = b->enc_n + add, nc;
    void *p;
    if (need < b->enc_n) return cc_err(CC_ERR_OUT_OF_MEMORY, "bulk enc");
    if (need <= b->enc_cap) return cc_ok();
    nc = b->enc_cap ? b->enc_cap : kilobytes(64);
    while (nc < need) nc *= 2;
    p = cc_arena_realloc(b->ea, b->ea, b->enc, b->enc_cap, nc, 8);
    if (!p) return cc_err(CC_ERR_OUT_OF_MEMORY, "bulk enc");
    b->enc = (char *)p;
    b->enc_cap = nc;
    return cc_ok();
}

static void !>(CCError) rtx_bulk_site(RtxBulk *b, const RtxEdit *e) {
    size_t hi = b->lo + b->old_n, gap;
    const char *del = NULL;
    /* Sites do not overlap. An inverse list (undo) may repeat an offset
     * after a site that erases nothing: a pure delete touching the next
     * site maps both to one post-edit offset. */
    if (e->off < b->cur || e->off > hi || e->n > hi - e->off ||
        (e->ins.len && !e->ins.ptr))
        return cc_err(CC_ERR_INVALID_ARG, "bulk: sites out of order");
    gap = e->off - b->cur;
    rtx_bulk_keep(b, b->cur, gap) !>(err) { return cc_err(err); };
    if (e->n && b->want_enc) {
        del = rtx_bulk_need(b, e->off, e->n) !>(err) { return cc_err(err); };
    }
    if (b->want_enc) {
        int dsame = e->n && e->n == b->pdel_n && !memcmp(del, b->pdel, e->n);
        int isame = e->ins.len && e->ins.len == b->pins_n &&
                    (e->ins.ptr == b->pins || !memcmp(e->ins.ptr, b->pins, e->ins.len));
        rtx_bulk_enc_room(b, 30 + (dsame ? 0 : e->n) + (isame ? 0 : e->ins.len)) !>(err) {
            return cc_err(err);
        };
        b->enc_n += rtx_vput(b->enc + b->enc_n, gap);
        b->enc_n += rtx_vput(b->enc + b->enc_n, (e->n << 1) | (size_t)dsame);
        b->enc_n += rtx_vput(b->enc + b->enc_n, (e->ins.len << 1) | (size_t)isame);
        if (e->n && !dsame) {
            memcpy(b->enc + b->enc_n, del, e->n);
            b->enc_n += e->n;
            memcpy(b->pdel, del, e->n);
            b->pdel_n = e->n;
        }
        if (e->ins.len && !isame) {
            memcpy(b->enc + b->enc_n, e->ins.ptr, e->ins.len);
            b->enc_n += e->ins.len;
            b->pins = e->ins.ptr;
            b->pins_n = e->ins.len;
        }
    }
    rtx_bulk_blob(b, e->ins.ptr, e->ins.len) !>(err) { return cc_err(err); };
    b->cur = e->off + e->n;
    b->caret = b->lo + b->new_n;
    b->done++;
    return cc_ok();
}

int !>(CCError) rtx_bulk_step(RtxBulk *b, long budget_ms, int (*yield)(void)) {
    long t0;
    if (!b || !b->d) return cc_err(CC_ERR_INVALID_ARG, "bulk step");
    if (b->built) return cc_ok(1);
    if (b->d->edit_gen != b->gen || b->d->broken)
        return cc_err(CC_ERR_INVALID_ARG, "bulk: the document changed");
    t0 = rtx_bulk_ms();
    for (;;) {
        RtxEdit e;
        int r = rtx_site_next(&b->src, &e);
        if (r < 0) return cc_err(CC_ERR_INVALID_ARG, "bulk: malformed site list");
        if (r == 0) break;
        rtx_bulk_site(b, &e) !>(err) { return cc_err(err); };
        if ((b->done & 1023) == 0) {
            if (budget_ms > 0 && rtx_bulk_ms() - t0 >= budget_ms) return cc_ok(0);
            if (yield && yield()) return cc_ok(0);
        }
    }
    if (b->done != b->nsites || b->cur != b->lo + b->old_n)
        return cc_err(CC_ERR_INVALID_ARG, "bulk: sites do not cover the range");
    rtx_bulk_flush(b) !>(err) { return cc_err(err); };
    b->built = 1;
    return cc_ok(1);
}

void !>(CCError) rtx_bulk_open(RtxBulk *b, RtxDoc *d, size_t lo) {
    size_t len;
    if (!b || !d) return cc_err(CC_ERR_INVALID_ARG, "bulk open");
    rtx_bulk_drop(b);
    len = d->len();
    if (lo > len) return cc_err(CC_ERR_INVALID_ARG, "bulk range");
    b->want_enc = 1;
    /* The old capture runs to EOF until close knows the range's end. */
    rtx_bulk_start(b, d, lo, len - lo, 0) !>(e) {
        rtx_bulk_drop(b);
        return cc_err(e);
    };
    b->open = 1;
    return cc_ok();
}

void !>(CCError) rtx_bulk_feed(RtxBulk *b, const RtxEdit *e) {
    if (!b || !b->d || !b->open || !e) return cc_err(CC_ERR_INVALID_ARG, "bulk feed");
    if (!e->n && !e->ins.len) return cc_ok();
    if (e->n > (size_t)RTX_HIST_INLINE_MAX)
        return cc_err(CC_ERR_INVALID_ARG, "bulk: a site deletes too much");
    if (b->d->edit_gen != b->gen || b->d->broken)
        return cc_err(CC_ERR_INVALID_ARG, "bulk: the document changed");
    rtx_bulk_site(b, e) !>(err) { return cc_err(err); };
    b->nsites = b->done;
    return cc_ok();
}

void !>(CCError) rtx_bulk_close(RtxBulk *b) {
    size_t acc = 0, k = 0;
    if (!b || !b->d || !b->open) return cc_err(CC_ERR_INVALID_ARG, "bulk close");
    if (!b->done) return cc_err(CC_ERR_INVALID_ARG, "bulk: no site");
    if (b->d->edit_gen != b->gen || b->d->broken)
        return cc_err(CC_ERR_INVALID_ARG, "bulk: the document changed");
    b->old_n = b->cur - b->lo;
    while (k < b->nold && acc < b->old_n) {
        if (acc + b->olds[k].len > b->old_n) {
            b->olds[k].len = b->old_n - acc;
            b->olds[k].lf_ok = 0;
            b->olds[k].lf_count = 0;
        }
        acc += b->olds[k].len;
        k++;
    }
    b->nold = k;
    rtx_bulk_flush(b) !>(e) { return cc_err(e); };
    b->nsites = b->done;
    b->open = 0;
    b->built = 1;
    return cc_ok();
}

/* After a bulk swap of [lo, lo + old_n) -> new_n bytes: one edit as far
 * as analysis is concerned (span, intervals, a full reparse), find wiped. */
static void rtx_bulk_patch(RtxDoc *d, size_t lo, size_t old_n, size_t new_n) {
    d->edit_gen++;
    rtx_doc_shift_intervals(d, lo, old_n, new_n);
    d->find_invalidate();
    d->last_off = lo;
    d->last_markup = 1;
}

static RtxPieceRef *rtx_bulk_refs_keep(RtxDoc *d, const RtxPieceRef *src, size_t n) {
    RtxPieceRef *p;
    if (!n) return NULL;
    p = (RtxPieceRef *)cc_arena_alloc(d->session, n * sizeof(RtxPieceRef), 8);
    if (p) memcpy(p, src, n * sizeof(RtxPieceRef));
    return p;
}

/* Swap a built sequence in. The captured old / built new sequences are
 * copied onto session first (everything hist needs exists before the
 * first byte moves). */
static void !>(CCError) rtx_bulk_land(RtxBulk *b, RtxPieceRef **olds, RtxPieceRef **news) {
    RtxDoc *d = b->d;
    if (!b->built) return cc_err(CC_ERR_INVALID_ARG, "bulk: not built");
    if (d->edit_gen != b->gen || d->broken ||
        RtxPieceTree_add_end(&d->tree) != b->add_base)
        return cc_err(CC_ERR_INVALID_ARG, "bulk: the document changed");
    *olds = rtx_bulk_refs_keep(d, b->olds, b->nold);
    *news = rtx_bulk_refs_keep(d, b->news, b->nnew);
    if ((b->nold && !*olds) || (b->nnew && !*news))
        return cc_err(CC_ERR_OUT_OF_MEMORY, "bulk hist");
    rtx_find_join(&d->find);
    RtxPieceTree_bulk_swap(&d->tree, b->lo, b->old_n, b->news, b->nnew, b->staged) !>(e) {
        if (rtx_err_is_unrestorable(e)) d->broken = 1;
        return cc_err(e);
    };
    rtx_bulk_patch(d, b->lo, b->old_n, b->new_n);
    return cc_ok();
}

void !>(CCError) rtx_bulk_commit(RtxBulk *b, uint64_t xact) {
    RtxDoc *d;
    RtxHistBulk *hb = NULL;
    RtxPieceRef *olds = NULL, *news = NULL;
    size_t caret0, sel0, bac0, bcc0;
    int box0, rec;
    if (!b || !b->d) return cc_err(CC_ERR_INVALID_ARG, "bulk commit");
    d = b->d;
    rec = !d->hist.applying;
    if (rec) {
        size_t need = d->hist.head + 1;
        char *enc;
        rtx_hist_reserve(d, need) !>(e) {
            rtx_bulk_drop(b);
            return cc_err(e);
        };
        hb = (RtxHistBulk *)cc_arena_alloc(d->session, sizeof(RtxHistBulk), 8);
        enc = b->enc_n ? (char *)cc_arena_alloc(d->session, b->enc_n, 1) : NULL;
        if (!hb || (b->enc_n && !enc)) {
            rtx_bulk_drop(b);
            return cc_err(CC_ERR_OUT_OF_MEMORY, "bulk hist");
        }
        if (b->enc_n) memcpy(enc, b->enc, b->enc_n);
        *hb = (RtxHistBulk){0};
        hb->enc = enc;
        hb->enc_n = b->enc_n;
    }
    caret0 = d->caret;
    sel0 = d->sel_anchor;
    box0 = d->sel_box;
    bac0 = d->box_acol;
    bcc0 = d->box_ccol;
    RtxDoc_break_coalesce(d);
    rtx_bulk_land(b, &olds, &news) !>(e) {
        rtx_bulk_drop(b);
        return cc_err(e);
    };
    d->caret = b->caret;
    d->sel_anchor = b->caret;
    d->sel_box = 0;
    d->box_acol = 0;
    d->box_ccol = 0;
    if (rec) {
        RtxHistRec r = rtx_hist_rec_empty();
        hb->lo = b->lo;
        hb->old_n = b->old_n;
        hb->new_n = b->new_n;
        hb->nsites = b->nsites;
        hb->olds = olds;
        hb->nold = b->nold;
        hb->news = news;
        hb->nnew = b->nnew;
        hb->ready = 1;
        rtx_hist_drop_tail(&d->hist);
        r.off = b->lo;
        r.caret_before = caret0;
        r.sel_before = sel0;
        r.sel_box_before = box0;
        r.box_acol_before = bac0;
        r.box_ccol_before = bcc0;
        r.caret_after = d->caret;
        r.sel_after = d->sel_anchor;
        r.group = ++d->hist.group_next;
        r.xact = xact;
        r.bulk = hb;
        d->hist.recs[d->hist.len++] = r;
        d->hist.head = d->hist.len;
    }
    RtxDoc_break_coalesce(d);
    rtx_bulk_drop(b);
    return cc_ok();
}

/* Undo (redo = 0) or redo of a bulk record: the other sequence swapped
 * in. A record loaded from a journal rebuilds its sequences from `enc`
 * the first time it moves. */
static void !>(CCError) rtx_hist_bulk_move(RtxDoc *d, RtxHistRec *r, int redo) {
    RtxHistBulk *hb = r->bulk;
    size_t cur_n = redo ? hb->old_n : hb->new_n;
    size_t to_n = redo ? hb->new_n : hb->old_n;
    if (d->broken) return cc_err(CC_ERR_INTERNAL, "doc broken");
    if (!hb->ready) {
        RtxBulk b = {0} @destroy { rtx_bulk_drop(&b); };
        RtxPieceRef *cap = NULL, *built = NULL;
        size_t ncap, nbuilt;
        rtx_bulk_kick_enc(&b, d, hb, !redo) !>(e) { return cc_err(e); };
        (void)rtx_bulk_step(&b, 0, NULL) !>(e) { return cc_err(e); };
        if (b.new_n != to_n) return cc_err(CC_ERR_INVALID_ARG, "bulk: record length");
        ncap = b.nold;
        nbuilt = b.nnew;
        rtx_bulk_land(&b, &cap, &built) !>(e) { return cc_err(e); };
        if (redo) {
            hb->olds = cap;
            hb->nold = ncap;
            hb->news = built;
            hb->nnew = nbuilt;
        } else {
            hb->news = cap;
            hb->nnew = ncap;
            hb->olds = built;
            hb->nold = nbuilt;
        }
        hb->ready = 1;
    } else {
        rtx_find_join(&d->find);
        RtxPieceTree_bulk_swap(&d->tree, hb->lo, cur_n, redo ? hb->news : hb->olds,
                               redo ? hb->nnew : hb->nold, 0) !>(e) {
            if (rtx_err_is_unrestorable(e)) d->broken = 1;
            return cc_err(e);
        };
        rtx_bulk_patch(d, hb->lo, cur_n, to_n);
    }
    d->hist.coalesce = 0;
    if (redo) {
        d->caret = r->caret_after;
        d->sel_anchor = r->sel_after;
        d->sel_box = r->sel_box_after;
        d->box_acol = r->box_acol_after;
        d->box_ccol = r->box_ccol_after;
        d->hist.head++;
    } else {
        d->caret = r->caret_before;
        d->sel_anchor = r->sel_before;
        d->sel_box = r->sel_box_before;
        d->box_acol = r->box_acol_before;
        d->box_ccol = r->box_ccol_before;
        d->hist.head--;
    }
    return cc_ok();
}

/* First record of the group that ends at `hi` (exclusive). */
static size_t rtx_hist_group_lo(const RtxHistory *h, size_t hi) {
    size_t g, lo;
    if (!h || hi == 0) return 0;
    lo = hi - 1;
    g = h->recs[lo].group;
    if (!g) return lo;
    while (lo > 0 && h->recs[lo - 1].group == g) lo--;
    return lo;
}

/* One past the last record of the group that starts at `lo`. */
static size_t rtx_hist_group_hi(const RtxHistory *h, size_t lo) {
    size_t g, hi;
    if (!h || lo >= h->len) return lo;
    hi = lo + 1;
    g = h->recs[lo].group;
    if (!g) return hi;
    while (hi < h->len && h->recs[hi].group == g) hi++;
    return hi;
}

/* recs[lo, hi) are one group in apply order (descending offset). */
static void !>(CCError) rtx_hist_undo_group(RtxDoc *d, size_t lo, size_t hi) {
    CCArena a = {0} @destroy;
    RtxGroupOp *ops;
    size_t k = hi - lo, t;
    ptrdiff_t acc = 0;
    const RtxHistRec *first;
    a = cc_arena_heap(k * sizeof(RtxGroupOp) + 64);
    if (!a.base) return cc_err(CC_ERR_OUT_OF_MEMORY, "undo group");
    ops = (RtxGroupOp *)cc_arena_alloc(a, k * sizeof(RtxGroupOp), 8);
    if (!ops) return cc_err(CC_ERR_OUT_OF_MEMORY, "undo group");
    /* Ascending: the member applied last is the lowest site. After the
     * group its offset is its own plus the change of the members below. */
    for (t = 0; t < k; t++) {
        const RtxHistRec *r = &d->hist.recs[hi - 1 - t];
        RtxGroupOp *op = &ops[t];
        op->ins = rtx_group_rec_del(r);
        op->del = rtx_group_rec_ins(r);
        op->at = rtx_group_add(r->off, acc);
        acc += (ptrdiff_t)op->del.n - (ptrdiff_t)op->ins.n;
    }
    d->hist.applying = 1;
    d->hist.coalesce = 0;
    rtx_group_apply(d, ops, k) !>(e) {
        d->hist.applying = 0;
        return cc_err(e);
    };
    d->hist.applying = 0;
    first = &d->hist.recs[lo];
    d->caret = first->caret_before;
    d->sel_anchor = first->sel_before;
    d->sel_box = first->sel_box_before;
    d->box_acol = first->box_acol_before;
    d->box_ccol = first->box_ccol_before;
    d->hist.head = lo;
    return cc_ok();
}

static void !>(CCError) rtx_hist_redo_group(RtxDoc *d, size_t lo, size_t hi) {
    CCArena a = {0} @destroy;
    RtxGroupOp *ops;
    size_t k = hi - lo, t;
    const RtxHistRec *last;
    a = cc_arena_heap(k * sizeof(RtxGroupOp) + 64);
    if (!a.base) return cc_err(CC_ERR_OUT_OF_MEMORY, "redo group");
    ops = (RtxGroupOp *)cc_arena_alloc(a, k * sizeof(RtxGroupOp), 8);
    if (!ops) return cc_err(CC_ERR_OUT_OF_MEMORY, "redo group");
    for (t = 0; t < k; t++) {
        const RtxHistRec *r = &d->hist.recs[hi - 1 - t];
        RtxGroupOp *op = &ops[t];
        op->at = r->off;
        op->del = rtx_group_rec_del(r);
        op->ins = rtx_group_rec_ins(r);
    }
    d->hist.applying = 1;
    d->hist.coalesce = 0;
    rtx_group_apply(d, ops, k) !>(e) {
        d->hist.applying = 0;
        return cc_err(e);
    };
    d->hist.applying = 0;
    last = &d->hist.recs[hi - 1];
    d->caret = last->caret_after;
    d->sel_anchor = last->sel_after;
    d->sel_box = last->sel_box_after;
    d->box_acol = last->box_acol_after;
    d->box_ccol = last->box_ccol_after;
    d->hist.head = hi;
    return cc_ok();
}

uint64_t RtxDoc_undo_xact(const RtxDoc *d) {
    if (!d || d->hist.head == 0) return 0;
    return d->hist.recs[d->hist.head - 1].xact;
}

uint64_t RtxDoc_redo_xact(const RtxDoc *d) {
    if (!d || d->hist.head >= d->hist.len) return 0;
    return d->hist.recs[d->hist.head].xact;
}

size_t RtxDoc_undo_width(const RtxDoc *d) {
    if (!d || d->hist.head == 0) return 0;
    return d->hist.head - rtx_hist_group_lo(&d->hist, d->hist.head);
}

int RtxDoc_hist_has_xact(const RtxDoc *d, uint64_t xact) {
    size_t i;
    if (!d || !xact) return 0;
    for (i = 0; i < d->hist.len; i++) {
        if (d->hist.recs[i].xact == xact) return 1;
    }
    return 0;
}

void rtx_hist_cut_tail(RtxDoc *d) {
    if (d) rtx_hist_drop_tail(&d->hist);
}

void !>(CCError) RtxDoc_undo(RtxDoc *d) {
    RtxHistRec *r;
    RtxHistRefs refs = {0};
    char[:] del;
    char[:] ins;
    size_t restore_n;
    int markup;
    int pieces = 0;
    if (!d) return cc_err(CC_ERR_INVALID_ARG, "null doc");
    if (d->broken) return cc_err(CC_ERR_INTERNAL, "doc broken");
    if (d->hist.head == 0) return cc_ok();
    r = &d->hist.recs[d->hist.head - 1];
    if (r->bulk) return rtx_hist_bulk_move(d, r, 0);
    if (r->group)
        return rtx_hist_undo_group(d, rtx_hist_group_lo(&d->hist, d->hist.head),
                                   d->hist.head);
    ins = rtx_hist_ins_view(r);
    del = cc_slice_empty();
    restore_n = 0;
    markup = 0;
    d->hist.applying = 1;
    d->hist.coalesce = 0;
    rtx_find_join(&d->find);
    @switch (r->del) {
        case .pieces(got):
            refs = got;
            restore_n = refs.nbytes;
            markup = 1;
            pieces = 1;
            d->tree.replace(r->off, ins.len, cc_slice_empty()) !>(e) {
                d->hist.applying = 0;
                if (rtx_err_is_unrestorable(e)) d->broken = 1;
                return cc_err(e);
            };
            d->tree.splice_refs(r->off, refs.refs, refs.n) !>(e) {
                d->hist.applying = 0;
                d->broken = 1;
                return cc_err(RTX_ERR_UNRESTORABLE, "undo unrestorable");
            };
            break;
        case .text: {
            Vec::[char] buf = r->del.text;
            del = buf.as_slice();
            restore_n = del.len;
            markup = rtx_bytes_touch_section(del) ||
                     rtx_bytes_touch_section(ins);
            d->tree.replace(r->off, ins.len, del) !>(e) {
                d->hist.applying = 0;
                if (rtx_err_is_unrestorable(e)) d->broken = 1;
                return cc_err(e);
            };
            break;
        }
    }
    d->edit_gen++;
    rtx_doc_shift_intervals(d, r->off, ins.len, restore_n);
    d->last_off = r->off;
    d->last_markup = markup;
    d->caret = r->caret_before;
    d->sel_anchor = r->sel_before;
    d->sel_box = r->sel_box_before;
    d->box_acol = r->box_acol_before;
    d->box_ccol = r->box_ccol_before;
    d->hist.head--;
    d->hist.applying = 0;
    if (pieces)
        d->find_invalidate();
    else
        d->find_after_edit(r->off, ins, del);
    return cc_ok();
}

void !>(CCError) RtxDoc_redo(RtxDoc *d) {
    RtxHistRec *r;
    char[:] del;
    char[:] ins;
    size_t erase_n;
    if (!d) return cc_err(CC_ERR_INVALID_ARG, "null doc");
    if (d->broken) return cc_err(CC_ERR_INTERNAL, "doc broken");
    if (d->hist.head >= d->hist.len) return cc_ok();
    r = &d->hist.recs[d->hist.head];
    if (r->bulk) return rtx_hist_bulk_move(d, r, 1);
    if (r->group)
        return rtx_hist_redo_group(d, d->hist.head,
                                   rtx_hist_group_hi(&d->hist, d->hist.head));
    del = rtx_hist_del_view(r);
    ins = rtx_hist_ins_view(r);
    erase_n = rtx_hist_del_n(r);
    d->hist.applying = 1;
    d->hist.coalesce = 0;
    rtx_find_join(&d->find);
    d->tree.replace(r->off, erase_n, ins) !>(e) {
        d->hist.applying = 0;
        if (rtx_err_is_unrestorable(e)) d->broken = 1;
        return cc_err(e);
    };
    d->edit_gen++;
    rtx_doc_shift_intervals(d, r->off, erase_n, ins.len);
    d->last_off = r->off;
    {
        d->last_markup = rtx_hist_del_is_pieces(r) ? 1 :
                         (rtx_bytes_touch_section(del) ||
                          rtx_bytes_touch_section(ins));
    }
    d->caret = r->caret_after;
    d->sel_anchor = r->sel_after;
    d->sel_box = r->sel_box_after;
    d->box_acol = r->box_acol_after;
    d->box_ccol = r->box_ccol_after;
    d->hist.head++;
    d->hist.applying = 0;
    if (del.len != erase_n)
        d->find_invalidate();
    else
        d->find_after_edit(r->off, del, ins);
    return cc_ok();
}

static int rtx_save_backup;

void rtx_doc_set_save_backup(int on) {
    rtx_save_backup = on ? 1 : 0;
}

int rtx_doc_save_backup(void) {
    return rtx_save_backup;
}

/* Nanosecond mtime where the platform has it (Linux st_mtim, Darwin
 * st_mtimespec): a same-second, same-size rewrite still drifts. */
static int rtx_doc_ident_read(const char *path, int64_t *mtime, uint64_t *sz,
                              uint64_t *ino) {
    struct stat st;
    if (!path || !mtime || !sz || !ino || stat(path, &st) != 0) return 0;
#if defined(__APPLE__)
    *mtime = (int64_t)st.st_mtimespec.tv_sec * 1000000000LL +
             (int64_t)st.st_mtimespec.tv_nsec;
#else
    *mtime = (int64_t)st.st_mtim.tv_sec * 1000000000LL +
             (int64_t)st.st_mtim.tv_nsec;
#endif
    *sz = (uint64_t)st.st_size;
    *ino = (uint64_t)st.st_ino;
    return 1;
}

static void rtx_doc_ident_stamp(RtxDoc *d, char[:0] path) {
    if (!d) return;
    if (!rtx_doc_ident_read(path.ptr, &d->disk_mtime, &d->disk_sz, &d->disk_ino)) {
        d->disk_valid = 0;
        return;
    }
    d->disk_valid = 1;
}

int RtxDoc_disk_changed(const RtxDoc *d) {
    int64_t mtime;
    uint64_t sz, ino;
    if (!d || !d->disk_valid || !d->path.ptr || d->path.len == 0) return 0;
    if (!rtx_doc_ident_read(d->path.ptr, &mtime, &sz, &ino)) return 0;
    return mtime != d->disk_mtime || sz != d->disk_sz || ino != d->disk_ino;
}

void RtxDoc_save_overwrite(RtxDoc *d) {
    if (d) d->save_overwrite = 1;
}

void rtx_hist_fail_next_coalesce_commit(void) {
    rtx_fail_coalesce_commit = 1;
}

static void rtx_save_fsync_dir(const char *path, size_t n) {
    char dirbuf[4096];
    char *slash;
    int dfd;
    if (!path || n + 1 >= sizeof(dirbuf)) return;
    {
        char[:] dst = cc_slice_from_buffer(dirbuf, n + 1);
        char[:] src = cc_slice_from_buffer((void *)path, n + 1);
        dst.copy(src) !>(e) { (void)e; return; };
    }
    slash = strrchr(dirbuf, '/');
    if (slash && slash != dirbuf) {
        *slash = 0;
        dfd = open(dirbuf, O_RDONLY);
    } else {
        dfd = open(".", O_RDONLY);
    }
    if (dfd >= 0) {
        (void)fsync(dfd);
        close(dfd);
    }
}

#define RTX_BAK_MAGIC 0x42585452u /* 'RTXB' LE */
#define RTX_BAK_VER 1u

static void rtx_bak_u32le(unsigned char *p, uint32_t v) {
    p[0] = (unsigned char)v;
    p[1] = (unsigned char)(v >> 8);
    p[2] = (unsigned char)(v >> 16);
    p[3] = (unsigned char)(v >> 24);
}

static void rtx_bak_u64le(unsigned char *p, uint64_t v) {
    p[0] = (unsigned char)v;
    p[1] = (unsigned char)(v >> 8);
    p[2] = (unsigned char)(v >> 16);
    p[3] = (unsigned char)(v >> 24);
    p[4] = (unsigned char)(v >> 32);
    p[5] = (unsigned char)(v >> 40);
    p[6] = (unsigned char)(v >> 48);
    p[7] = (unsigned char)(v >> 56);
}

/* Copy src → dst (follows symlinks). Fallback when the dest is not the opened file. */
static void !>(CCError) rtx_save_copy_path(const char *src, const char *dst,
                                          mode_t mode, int have_mode) {
    char buf[64 * 1024];
    int in = -1;
    int out = -1;
    ssize_t nr;
    if (!src || !dst) return cc_err(CC_ERR_INVALID_ARG, "copy path");
    in = open(src, O_RDONLY);
    if (in < 0) return cc_err(CC_ERR_IO, "backup open");
    out = open(dst, O_WRONLY | O_CREAT | O_TRUNC, have_mode ? mode : 0666);
    if (out < 0) {
        close(in);
        return cc_err(CC_ERR_IO, "backup create");
    }
    if (have_mode && fchmod(out, mode) != 0) {
        close(in);
        close(out);
        unlink(dst);
        return cc_err(CC_ERR_IO, "backup fchmod");
    }
    for (;;) {
        nr = read(in, buf, sizeof(buf));
        if (nr < 0) {
            close(in);
            close(out);
            unlink(dst);
            return cc_err(CC_ERR_IO, "backup read");
        }
        if (nr == 0) break;
        {
            ssize_t off = 0;
            while (off < nr) {
                ssize_t w = write(out, buf + off, (size_t)(nr - off));
                if (w <= 0) {
                    close(in);
                    close(out);
                    unlink(dst);
                    return cc_err(CC_ERR_IO, "backup write");
                }
                off += w;
            }
        }
    }
    if (fsync(out) != 0) {
        close(in);
        close(out);
        unlink(dst);
        return cc_err(CC_ERR_IO, "backup fsync");
    }
    close(in);
    if (close(out) != 0) {
        unlink(dst);
        return cc_err(CC_ERR_IO, "backup close");
    }
    return cc_ok();
}

/* path~ = RTXB header + old bytes [lo, bak_to). Empty span: drop path~. */
static void !>(CCError) rtx_save_copy_span(const char *src, const char *dst,
                                          size_t lo, size_t bak_to, size_t old_len,
                                          mode_t mode, int have_mode) {
    char buf[64 * 1024];
    unsigned char hdr[24];
    int in = -1;
    int out = -1;
    size_t left;
    if (!src || !dst) return cc_err(CC_ERR_INVALID_ARG, "copy span");
    if (lo > bak_to || bak_to > old_len) return cc_err(CC_ERR_INVALID_ARG, "span");
    if (lo == bak_to) {
        unlink(dst);
        return cc_ok();
    }
    in = open(src, O_RDONLY);
    if (in < 0) return cc_err(CC_ERR_IO, "backup open");
    out = open(dst, O_WRONLY | O_CREAT | O_TRUNC, have_mode ? mode : 0666);
    if (out < 0) {
        close(in);
        return cc_err(CC_ERR_IO, "backup create");
    }
    if (have_mode && fchmod(out, mode) != 0) {
        close(in);
        close(out);
        unlink(dst);
        return cc_err(CC_ERR_IO, "backup fchmod");
    }
    rtx_bak_u32le(hdr, RTX_BAK_MAGIC);
    rtx_bak_u32le(hdr + 4, RTX_BAK_VER);
    rtx_bak_u64le(hdr + 8, (uint64_t)old_len);
    rtx_bak_u64le(hdr + 16, (uint64_t)lo);
    {
        ssize_t off = 0;
        while (off < (ssize_t)sizeof(hdr)) {
            ssize_t w = write(out, hdr + off, sizeof(hdr) - (size_t)off);
            if (w <= 0) {
                close(in);
                close(out);
                unlink(dst);
                return cc_err(CC_ERR_IO, "backup write");
            }
            off += w;
        }
    }
    if (lo && lseek(in, (off_t)lo, SEEK_SET) < 0) {
        close(in);
        close(out);
        unlink(dst);
        return cc_err(CC_ERR_IO, "backup lseek");
    }
    left = bak_to - lo;
    while (left) {
        size_t take = left > sizeof(buf) ? sizeof(buf) : left;
        ssize_t nr = read(in, buf, take);
        if (nr <= 0) {
            close(in);
            close(out);
            unlink(dst);
            return cc_err(CC_ERR_IO, "backup read");
        }
        {
            ssize_t off = 0;
            while (off < nr) {
                ssize_t w = write(out, buf + off, (size_t)(nr - off));
                if (w <= 0) {
                    close(in);
                    close(out);
                    unlink(dst);
                    return cc_err(CC_ERR_IO, "backup write");
                }
                off += w;
            }
        }
        left -= (size_t)nr;
    }
    if (fsync(out) != 0) {
        close(in);
        close(out);
        unlink(dst);
        return cc_err(CC_ERR_IO, "backup fsync");
    }
    close(in);
    if (close(out) != 0) {
        unlink(dst);
        return cc_err(CC_ERR_IO, "backup close");
    }
    return cc_ok();
}

void !>(CCError) RtxDoc_save_as(RtxDoc *d, char[:0] path) {
    const char *p;
    char tmp[4096];
    char[:] new_path = cc_slice_empty();
    int fd;
    size_t n;
    mode_t mode = 0666;
    int have_mode = 0;
    int have_st = 0;
    struct stat st;
    if (!d || !path.ptr || path.len == 0) return cc_err(CC_ERR_INVALID_ARG, "save path");
    if (d->broken) return cc_err(CC_ERR_INTERNAL, "doc broken");
    p = path.ptr;
    n = path.len;
    if (n + 16 >= sizeof(tmp)) return cc_err(CC_ERR_INVALID_ARG, "path too long");
    if (!d->path.ptr || !d->path.eq(path)) {
        new_path = rtx_session_str(d, path) !>(e) { return cc_err(e); };
    }
    if (stat(p, &st) == 0) {
        mode = st.st_mode & 0777;
        have_mode = 1;
        have_st = 1;
    }
    {
        int force = d->save_overwrite;
        int same_path = d->path.ptr && d->path.eq(path);
        d->save_overwrite = 0;
        if (same_path && d->disk_valid && !force && d->disk_changed())
            return cc_err(CC_ERR_IO, "file changed on disk");
        if (force) have_st = 0; /* --backup: no dirty-span onto a drifted inode */
    }
    if (rtx_save_backup) {
        char bak[4096];
        size_t lo = 0, hi = 0, oldn, newn, bak_to;
        int same = 0;
        if (n + 2 >= sizeof(bak)) return cc_err(CC_ERR_INVALID_ARG, "path too long");
        snprintf(bak, sizeof(bak), "%s~", p);
        /* --backup writes through `p`, which may be the inode find /
         * island lanes pread. Join them first. */
        rtx_find_join(&d->find);
        rtx_isle_handle_stop(&d->tree);
        oldn = d->tree.save_span(&lo, &hi);
        newn = d->tree.len();
        if (d->path.ptr && d->path.eq(path) && d->tree.store.orig_open &&
            have_st && (size_t)st.st_size == oldn && lo <= oldn)
            same = 1;
        bak_to = (newn == oldn && hi <= oldn) ? hi : oldn;
        if (access(p, F_OK) == 0) {
            if (same)
                rtx_save_copy_span(p, bak, lo, bak_to, oldn, mode, have_mode) !>(e) {
                    return cc_err(e);
                };
            else
                rtx_save_copy_path(p, bak, mode, have_mode) !>(e) {
                    return cc_err(e);
                };
        }
        if (same) {
            size_t flo = 0, fhi = 0, on;
            CCArena pin_a = {0};
            char *pin = NULL;
            on = d->tree.save_orig_span(lo, hi, &flo, &fhi);
            /* Streaming original pieces through the inode we are shifting
             * aliases unread tail bytes. Pin a small tail first; a large
             * one writes a full temp and copies onto the path. */
            if (on > (size_t)RTX_SAVE_PIN_MAX) {
                snprintf(tmp, sizeof(tmp), "%s.tmp.XXXXXX", p);
                fd = mkstemp(tmp);
                if (fd < 0) return cc_err(CC_ERR_IO, "save open");
                if (have_mode && fchmod(fd, mode) != 0) {
                    close(fd);
                    unlink(tmp);
                    return cc_err(CC_ERR_IO, "save fchmod");
                }
                d->tree.write_fd(fd) !>(e) {
                    close(fd);
                    unlink(tmp);
                    return cc_err(e);
                };
                if (fsync(fd) != 0) {
                    close(fd);
                    unlink(tmp);
                    return cc_err(CC_ERR_IO, "save fsync");
                }
                if (close(fd) != 0) {
                    unlink(tmp);
                    return cc_err(CC_ERR_IO, "save close");
                }
                rtx_save_copy_path(tmp, p, mode, have_mode) !>(e) {
                    unlink(tmp);
                    return cc_err(e);
                };
                unlink(tmp);
                rtx_save_fsync_dir(p, n);
                if (new_path.ptr) d->path = new_path;
                d->saved_head = d->hist.head;
                rtx_doc_ident_stamp(d, path);
                return cc_ok();
            }
            if (on) {
                pin_a = cc_arena_heap(on + 64);
                if (!pin_a.base)
                    return cc_err(CC_ERR_OUT_OF_MEMORY, "save pin");
                pin = (char *)cc_arena_alloc(pin_a, on, 1);
                if (!pin) {
                    pin_a.destroy();
                    return cc_err(CC_ERR_OUT_OF_MEMORY, "save pin");
                }
                RtxPageStore_pread(&d->tree.store, RTX_STORE_ORIG, flo, pin,
                                   on) !>(e) {
                    pin_a.destroy();
                    return cc_err(e);
                };
            }
            fd = open(p, O_WRONLY | O_CREAT, have_mode ? mode : 0666);
            if (fd < 0) {
                if (pin_a.base) pin_a.destroy();
                return cc_err(CC_ERR_IO, "save open");
            }
            if (have_mode && fchmod(fd, mode) != 0) {
                if (pin_a.base) pin_a.destroy();
                close(fd);
                return cc_err(CC_ERR_IO, "save fchmod");
            }
            if (lo && lseek(fd, (off_t)lo, SEEK_SET) < 0) {
                if (pin_a.base) pin_a.destroy();
                close(fd);
                return cc_err(CC_ERR_IO, "save lseek");
            }
            d->tree.write_fd_from_snap(fd, lo, hi, pin, flo, on) !>(e) {
                if (pin_a.base) pin_a.destroy();
                close(fd);
                return cc_err(e);
            };
            if (pin_a.base) pin_a.destroy();
            if (newn != (size_t)st.st_size) {
                if (ftruncate(fd, (off_t)newn) != 0) {
                    close(fd);
                    return cc_err(CC_ERR_IO, "save ftruncate");
                }
            }
        } else {
            fd = open(p, O_WRONLY | O_CREAT | O_TRUNC, have_mode ? mode : 0666);
            if (fd < 0) return cc_err(CC_ERR_IO, "save open");
            if (have_mode && fchmod(fd, mode) != 0) {
                close(fd);
                return cc_err(CC_ERR_IO, "save fchmod");
            }
            d->tree.write_fd(fd) !>(e) {
                close(fd);
                return cc_err(e);
            };
        }
        if (fsync(fd) != 0) {
            close(fd);
            return cc_err(CC_ERR_IO, "save fsync");
        }
        if (close(fd) != 0) return cc_err(CC_ERR_IO, "save close");
        rtx_save_fsync_dir(p, n);
        if (new_path.ptr) d->path = new_path;
        d->saved_head = d->hist.head;
        rtx_doc_ident_stamp(d, path);
        return cc_ok();
    }
    snprintf(tmp, sizeof(tmp), "%s.tmp.XXXXXX", p);
    fd = mkstemp(tmp);
    if (fd < 0) return cc_err(CC_ERR_IO, "save open");
    @defer(err) unlink(tmp);
    if (have_mode && fchmod(fd, mode) != 0) {
        close(fd);
        return cc_err(CC_ERR_IO, "save fchmod");
    }
    d->tree.write_fd(fd) !>(e) {
        close(fd);
        return cc_err(e);
    };
    if (fsync(fd) != 0) {
        close(fd);
        return cc_err(CC_ERR_IO, "save fsync");
    }
    if (close(fd) != 0) return cc_err(CC_ERR_IO, "save close");
    if (rename(tmp, p) != 0) return cc_err(CC_ERR_IO, "save rename");
    /* Best-effort directory fsync so the rename itself is durable. */
    rtx_save_fsync_dir(p, n);
    if (new_path.ptr) d->path = new_path;
    d->saved_head = d->hist.head;
    rtx_doc_ident_stamp(d, path);
    return cc_ok();
}

void !>(CCError) RtxDoc_save(RtxDoc *d) {
    if (!d) return cc_err(CC_ERR_INVALID_ARG, "null doc");
    if (!d->path.ptr || d->path.len == 0) return cc_err(CC_ERR_INVALID_ARG, "untitled");
    return d->save_as(cc_slice_cstr(d->path.ptr));
}

static void !>(CCError) rtx_doc_hl_bytes(RtxDoc *d, char[:] bytes, size_t start,
                                        size_t lo, const RtxTmCkpt *seed,
                                        RtxTmWalk walk, size_t saved_runs,
                                        size_t saved_ckpt, size_t *anchor,
                                        const RtxMdStart *ms) {
    size_t lex = 0;
    if (walk == RTX_TM_LOOKBACK && start > 0 && bytes.len && !(ms && ms->bol)) {
        @for (ch in bytes) {
            if (ch == '\n') break;
            lex++;
        }
        if (lex < bytes.len && start + lex < lo) lex++;
        else lex = 0;
    }
    if (anchor) *anchor = start + lex;
    rtx_hl_range(d, bytes.sub(lex, bytes.len), start + lex, lo, seed,
                 walk, ms) !>(e) {
        {
            rtx_doc_runs_cut(d, saved_runs);
            d->tm_ckpt.truncate(saved_ckpt);
            d->hl_cov.live = 0;
        }
        return cc_err(e);
    };
    return cc_ok();
}

/* `floor` is the section start: a section lexes from its own first byte
 * (as rtx_doc_highlight does), so neither a checkpoint nor the lookback
 * reaches into the section before it. A 16 KiB lookback per 300-byte
 * `=== code ===` block was 2 MB of lex per keystroke. */
static void !>(CCError) rtx_doc_highlight_span_raw(RtxDoc *d, size_t floor,
                                                  size_t lo, size_t hi,
                                                  RtxHlCov *cov) {
    size_t saved_runs;
    size_t saved_ckpt;
    size_t start;
    const RtxTmCkpt *seed;
    RtxTmWalk walk;
    const RtxTmRt *rt;
    RtxMdStart ms = {0};
    int md;
    if (!d || hi <= lo) return cc_ok();
    if (hi - lo > (size_t)RTX_HL_WIN_MAX) hi = lo + (size_t)RTX_HL_WIN_MAX;
    rt = rtx_tm_for_path(d->path.ptr);
    md = rt && rt->blocks;
    saved_runs = d->runs.len;
    saved_ckpt = d->tm_ckpt.len;
    rtx_doc_clip_runs(d, lo, hi, rtx_run_planted_tm) !>(e) {
        return cc_err(e);
    };
    saved_runs = d->runs.len;
    if (floor > lo) floor = lo;
    seed = rtx_tm_ckpt_find(d, lo);
    if (md) seed = rtx_md_seed_back(d, rt, seed);
    if (seed && seed->off < floor) seed = NULL;
    if (seed && lo - seed->off <= (size_t)RTX_TM_CATCHUP_MAX) {
        start = seed->off;
        walk = RTX_TM_CATCHUP;
    } else if (!seed && floor == 0 && lo <= (size_t)RTX_TM_CATCHUP_MAX) {
        start = 0;
        seed = NULL;
        walk = RTX_TM_CATCHUP;
    } else {
        start = lo - floor > (size_t)RTX_MARKUP_LOOKBACK
                    ? lo - (size_t)RTX_MARKUP_LOOKBACK
                    : floor;
        seed = NULL;
        walk = start == floor ? RTX_TM_CATCHUP : RTX_TM_LOOKBACK;
        if (md && start > floor) {
            /* The block pass needs a start it can trust: an anchor behind
             * the lookback (classified only up to it), else leftover. */
            size_t a = rtx_md_anchor(d, floor, start, &ms.flags);
            ms.inl = start;
            ms.bol = a < start || a == floor;
            start = a;
        }
    }
    if (md && !ms.inl) ms.inl = start;
    if (cov) {
        *cov = (RtxHlCov){0};
        cov->anchor = start;
        cov->lo = lo;
        cov->hi = hi;
        cov->bare = seed == NULL;
        cov->md_inl = ms.inl;
        cov->md_flags = ms.flags;
        /* Only this lex's checkpoints past its start (a seed sits at it). */
        rtx_tm_ckpt_drop_from(d, start + 1);
        saved_ckpt = d->tm_ckpt.len;
    }
    {
        size_t need = hi - start;
        CCArena frame = cc_arena_heap(need + 64);
        char[:] bytes;
        if (!frame.base) return cc_err(CC_ERR_OUT_OF_MEMORY, "hl frame");
        bytes = d->scratch_span(start, need, frame) !>(e) {
            frame.destroy();
            return cc_err(e);
        };
        rtx_doc_hl_bytes(d, bytes, start, lo, seed, walk, saved_runs,
                         saved_ckpt, cov ? &cov->anchor : NULL, md ? &ms : NULL) !>(e) {
            frame.destroy();
            return cc_err(e);
        };
        frame.destroy();
    }
    if (cov) cov->live = 1;
    return cc_ok();
}

void !>(CCError) rtx_doc_highlight_span(RtxDoc *d, size_t lo, size_t hi) {
    size_t s, n, a, b;
    if (!d || hi <= lo) return cc_ok();
    n = d->len();
    if (hi > n) hi = n;
    if (d->secs.len == 0) return rtx_doc_highlight_span_raw(d, 0, lo, hi, NULL);
    for (s = 0; s < d->secs.len; s++) {
        if (!rtx_sec_lexed(d->secs.data[s].kind)) continue;
        a = d->secs.data[s].start;
        b = (s + 1 < d->secs.len) ? d->secs.data[s + 1].start : n;
        if (b <= lo || a >= hi) continue;
        if (a < lo) a = lo;
        if (b > hi) b = hi;
        if (a < b) {
            rtx_doc_highlight_span_raw(d, rtx_doc_sec_floor(d, d->secs.data[s].start),
                                       a, b, NULL) !>(e) {
                return cc_err(e);
            };
        }
    }
    return cc_ok();
}

#define RTX_TM_RELEX_BACK 2048
#define RTX_TM_CONV_MAX 64

static int rtx_run_same_rule(const RtxRun *a, const RtxRun *b) {
    return a->style.scope == b->style.scope && a->style.bold == b->style.bold &&
           a->style.italic == b->style.italic && a->style.mono == b->style.mono &&
           a->style.strike == b->style.strike && a->style.hl == b->style.hl &&
           a->planter == b->planter && a->mark == b->mark && a->rule == b->rule;
}

/* A frame open across a relex edge `x` comes out as two runs: [open, x)
 * without a closer hint and [x, close) without an opener hint. Join them,
 * outermost with outermost, so the mark's extent is what a full lex gives. */
static void rtx_doc_runs_join_at(RtxDoc *d, size_t x);

/* Converged at `x` with frames open: each one's old run was clipped to
 * [x, close). Give it back the opener this lex found (outermost first,
 * same rule, latest close); a frame the old lex never emitted stays out.
 * An opener before `emit` (a window relex's lead-in) reaches `emit`
 * without its hint, as the window lex emitted it. */
static void rtx_doc_runs_reopen(RtxDoc *d, const RtxTmConv *cv, size_t x,
                                size_t emit) {
    size_t k, i;
    int any = 0;
    for (k = 0; k < cv->osp; k++) {
        size_t best = (size_t)-1;
        for (i = 0; i < d->runs.len; i++) {
            const RtxRun *r = &d->runs.data[i];
            if (r->start != x || !r->len || r->hint_a || !rtx_run_planted_tm(*r) ||
                r->rule != (unsigned short)cv->orule[k])
                continue;
            if (best == (size_t)-1 ||
                r->len > d->runs.data[best].len)
                best = i;
        }
        if (best == (size_t)-1 || cv->ooff[k] > x) continue;
        {
            RtxRun *r = &d->runs.data[best];
            size_t at = cv->ooff[k] < emit ? emit : cv->ooff[k];
            r->len += x - at;
            r->start = at;
            r->hint_a = at == cv->ooff[k] ? rtx_tm_hint(cv->oalen[k]) : 0;
            if (r->hint_a > r->len) r->hint_a = (unsigned char)r->len;
            /* Its start moved back: the sorted prefix ends before it. */
            if (d->runs_sorted > best) d->runs_sorted = best;
            if (d->runs_maxlen != (size_t)-1 && r->len > d->runs_maxlen)
                d->runs_maxlen = r->len;
            any = 1;
        }
    }
    if (any) rtx_doc_run_top_drop(d);
}

static void rtx_doc_runs_join_at(RtxDoc *d, size_t x) {
    size_t lc[RTX_TM_STACK], rc[RTX_TM_STACK];
    int used[RTX_TM_STACK];
    size_t nl = 0, nr = 0, i, j, w;
    int any = 0;
    for (i = 0; i < d->runs.len; i++) {
        const RtxRun *r = &d->runs.data[i];
        if (!r->len || !rtx_run_planted_tm(*r)) continue;
        if (r->start + r->len == x && r->hint_b == 0 && nl < (size_t)RTX_TM_STACK)
            lc[nl++] = i;
        else if (r->start == x && r->hint_a == 0 && nr < (size_t)RTX_TM_STACK)
            rc[nr++] = i;
    }
    if (!nl || !nr) return;
    for (j = 0; j < nr; j++) used[j] = 0;
    /* Outermost first: earliest start on the left, latest end on the right. */
    for (i = 0; i < nl; i++) {
        size_t k, best = (size_t)-1;
        for (k = i + 1; k < nl; k++) {
            if (d->runs.data[lc[k]].start < d->runs.data[lc[i]].start) {
                size_t t = lc[i];
                lc[i] = lc[k];
                lc[k] = t;
            }
        }
        for (j = 0; j < nr; j++) {
            const RtxRun *r = &d->runs.data[rc[j]];
            if (used[j] || !rtx_run_same_rule(&d->runs.data[lc[i]], r)) continue;
            if (best == (size_t)-1 ||
                r->start + r->len > d->runs.data[rc[best]].start +
                                        d->runs.data[rc[best]].len)
                best = j;
        }
        if (best == (size_t)-1) continue;
        used[best] = 1;
        d->runs.data[lc[i]].len += d->runs.data[rc[best]].len;
        d->runs.data[lc[i]].hint_b = d->runs.data[rc[best]].hint_b;
        d->runs.data[rc[best]].len = 0;
        if (d->runs_maxlen != (size_t)-1 && d->runs.data[lc[i]].len > d->runs_maxlen)
            d->runs_maxlen = d->runs.data[lc[i]].len;
        any = 1;
    }
    if (!any) return;
    w = 0;
    {
        size_t s_out = d->runs_sorted;
        for (i = 0; i < d->runs.len; i++) {
            int drop = 0;
            for (j = 0; j < nr; j++)
                if (used[j] && rc[j] == i) drop = 1;
            if (!drop) d->runs.data[w++] = d->runs.data[i];
            else if (i < d->runs_sorted) s_out--;
        }
        d->runs_sorted = s_out;
    }
    d->runs.truncate(w);
    rtx_doc_run_top_drop(d);
}

static int rtx_tm_ckpt_seedable(const RtxTmRt *rt, const RtxTmCkpt *c) {
    size_t k, n = (size_t)RTX_TM_CKPT_N(c);
    for (k = 0; k < n; k++) {
        if (rtx_tm_frame_pos_bound(rt, c->lang[k], c->rule[k])) return 0;
    }
    if (rt && rt->blocks) {
        /* Markdown: a line start outside a paragraph (a setext underline
         * restyles its paragraph behind it; an inline span may yet be
         * dropped and rewound past the seed). */
        size_t host = rtx_tm_lang_id(rt);
        if (!c->md || !rtx_mdb_seedable(&c->mdb)) return 0;
        for (k = 0; k < n; k++) {
            const RtxTmRule *fr;
            if (c->lang[k] != host) continue;
            fr = rtx_tm_rule_from_tag(rt, c->rule[k]);
            if (fr && !fr->block) return 0;
        }
    }
    return 1;
}

/* Grammar section [lo, hi) after an edit (d->span): lex from a checkpoint
 * a little before the edit and stop where the lex state meets a stale
 * checkpoint past it. The whole-section relex this replaces was most of a
 * keystroke on a 50 KiB C file. 0 when it does not apply (the caller
 * relexes the section).
 *
 * `win`: the window lex of a section over RTX_HL_FULL_MAX (d->hl_cov),
 * [lo, hi) its window. Seeds are that lex's checkpoints from its anchor
 * (lead-in ones included: the state there is what the same lex from the
 * anchor gives), or its bare anchor; runs are emitted from `lo` only, as
 * the window lex emitted them. No seed: 0, the fill relexes the window. */
static int !>(CCError) rtx_doc_relex_edit(RtxDoc *d, size_t lo, size_t hi,
                                         const RtxHlCov *win) {
    const RtxTmRt *rt;
    const RtxTmCkpt *seed = NULL;
    RtxTmCkpt conv[RTX_TM_CONV_MAX];
    RtxTmConv cv = {0};
    RtxHlCov keep = {0};
    RtxMdStart ms = {0};
    size_t i, start, emit, stop, saved_runs, nconv = 0, seed_lo;
    CCArena frame;
    char[:] bytes;
    if (!d || hi <= lo || !d->span.live || d->span.lo < lo || d->span.hi > hi)
        return cc_ok(0);
    rt = rtx_tm_for_path(d->path.ptr);
    if (!rt) return cc_ok(0);
    if (win) keep = *win;
    else if (lo > 0 && rtx_doc_sec_floor(d, lo) != lo) return cc_ok(0);
    seed_lo = win ? keep.anchor : lo;
    for (i = d->tm_ckpt.len; i > 0; i--) {
        const RtxTmCkpt *c = &d->tm_ckpt.data[i - 1];
        if (c->n & RTX_TM_CKPT_STALE) continue;
        if (!win && (c->n & RTX_TM_CKPT_WIN)) continue;
        if (c->off < seed_lo) break;
        if (c->off + (size_t)RTX_TM_RELEX_BACK <= d->span.lo &&
            rtx_tm_ckpt_seedable(rt, c)) {
            seed = c;
            break;
        }
    }
    if (win && !seed && !keep.bare) return cc_ok(0);
    start = seed ? seed->off : seed_lo;
    emit = start > lo ? start : lo;
    for (i = 0; i < d->tm_ckpt.len && nconv < (size_t)RTX_TM_CONV_MAX; i++) {
        const RtxTmCkpt *c = &d->tm_ckpt.data[i];
        if (!(c->n & RTX_TM_CKPT_STALE) || c->off < d->span.hi || c->off > hi)
            continue;
        conv[nconv++] = *c;
    }
    if (seed) {
        RtxTmCkpt one = *seed;
        conv[RTX_TM_CONV_MAX - 1] = one; /* seed outlives ckpt drops below */
        seed = &conv[RTX_TM_CONV_MAX - 1];
        if (nconv == (size_t)RTX_TM_CONV_MAX) nconv--;
    }
    cv.at = conv;
    cv.n = nconv;
    cv.hit = (size_t)-1;
    /* A bare anchor restart of a lookback lex is still a window state. */
    cv.plant = win && !seed ? (unsigned char)RTX_TM_CKPT_WIN : 0;
    frame = cc_arena_heap((hi - start) + 64);
    if (!frame.base) return cc_err(CC_ERR_OUT_OF_MEMORY, "relex frame");
    bytes = d->scratch_span(start, hi - start, frame) !>(e) {
        frame.destroy();
        return cc_err(e);
    };
    saved_runs = d->runs.len;
    /* The lex replants every checkpoint past `start`; the old ones it must
     * not leave behind between its own (conv holds the stale ones). */
    rtx_tm_ckpt_drop_from(d, start + 1);
    ms.inl = win ? keep.md_inl : start;
    ms.flags = win && !seed ? keep.md_flags : 0;
    ms.bol = 1;
    rtx_doc_lex(d, rt, bytes, start, emit, seed, RTX_TM_CATCHUP, &cv, &ms) !>(e) {
        rtx_doc_runs_cut(d, saved_runs);
        rtx_tm_ckpt_drop_from(d, start);
        frame.destroy();
        return cc_err(e);
    };
    frame.destroy();
    stop = cv.hit != (size_t)-1 ? conv[cv.hit].off : hi;
    if (stop > emit) {
        rtx_doc_clip_runs_upto(d, emit, stop, rtx_run_planted_tm, saved_runs) !>(e) {
            rtx_doc_runs_cut(d, saved_runs);
            return cc_err(e);
        };
    }
    if (cv.hit != (size_t)-1) rtx_doc_runs_reopen(d, &cv, stop, emit);
    if (start > lo) rtx_doc_runs_join_at(d, start);
    if (cv.hit != (size_t)-1) {
        /* The old lex from here on stands: its checkpoints are live again. */
        for (i = cv.hit; i < nconv; i++) {
            RtxTmCkpt c = conv[i];
            RtxTmCkpt *slot;
            c.n = (unsigned char)(c.n & (unsigned char)~RTX_TM_CKPT_STALE);
            if (d->tm_ckpt.len && d->tm_ckpt.data[d->tm_ckpt.len - 1].off >= c.off)
                continue;
            if (d->tm_ckpt.len >= RTX_TM_CKPT_MAX) break;
            slot = d->tm_ckpt.push_ptr();
            if (!slot) break;
            *slot = c;
        }
    }
    if (win) {
        keep.live = 1;
        d->hl_cov = keep;
    }
    return cc_ok(1);
}

static void !>(CCError) rtx_doc_reparse_edit_once(RtxDoc *d, size_t off,
                                                  int full_markup);

void !>(CCError) RtxDoc_reparse_edit(RtxDoc *d, size_t off, int full_markup) {
    /* A re-sweep first: the relex then resolves with the map as it is. */
    rtx_doc_mdref_update(d) !>(e) { return cc_err(e); };
    rtx_doc_reparse_edit_once(d, off, full_markup) !>(e) { return cc_err(e); };
    return rtx_doc_mdref_fix(d, off, 1);
}

static void !>(CCError) rtx_doc_reparse_edit_once(RtxDoc *d, size_t off,
                                                  int full_markup) {
    size_t s, lo, hi, n, win_lo, win_hi, sec_n;
    RtxSectionKind kind, done = RTX_SEC_UNKNOWN;
    if (!d) return cc_err(CC_ERR_INVALID_ARG, "null doc");
    /* Root section is path kind. Only `=` / a large delete can move === headers. */
    if (full_markup) return d->reparse();
    /* An edit in the front matter that turns `marp: true` on or off changes
     * every top-level break (slide / hr): the block state in every
     * checkpoint is stale, so lex again from scratch. */
    if (off < (size_t)RTX_MDB_MARP_PROBE && RtxDoc_is_markup(d) &&
        d->marp != RtxDoc_marp(d)) {
        d->marp = !d->marp;
        return d->reparse();
    }
    n = d->len();
    if (off > n) off = n;
    if (d->hl_cov.live && n > RTX_HL_FULL_MAX) {
        /* An edit inside the last window lex: relex it where it moved.
         * Its section is lexed (only a lexed window plants hl_cov). */
        RtxHlCov cov = d->hl_cov;
        int relexed = rtx_doc_relex_edit(d, cov.lo, cov.hi, &cov) !>(e) {
            d->hl_cov.live = 0;
            return cc_err(e);
        };
        if (!relexed) d->hl_cov.live = 0; /* the fill relexes the window */
        rtx_tm_ckpt_drop_stale(d);
        rtx_doc_sort_runs(d);
        if (relexed) return cc_ok();
    }
    lo = 0;
    hi = n;
    kind = d->section_at(off);
    for (s = 0; s < d->secs.len; s++) {
        if (d->secs.data[s].start <= off) {
            lo = d->secs.data[s].start;
            hi = (s + 1 < d->secs.len) ? d->secs.data[s + 1].start : n;
            done = d->secs.data[s].hl_done ? d->secs.data[s].kind : RTX_SEC_UNKNOWN;
        }
    }
    sec_n = hi > lo ? hi - lo : 0;
    /* A lexed small section keeps hl_done across the window rescan the
     * edit forces, while section_at (window cache, cleared by the edit)
     * reads UNKNOWN: relex it here, or nothing will. */
    if (sec_n <= RTX_HL_FULL_MAX && rtx_sec_lexed(done)) kind = done;
    if (sec_n > RTX_HL_FULL_MAX) {
        win_lo = off > (size_t)RTX_MARKUP_LOOKBACK ? off - (size_t)RTX_MARKUP_LOOKBACK
                                                   : 0;
        win_hi = off + (size_t)RTX_HL_WIN_MAX;
        if (win_lo < lo) win_lo = lo;
        if (win_hi > hi) win_hi = hi;
        lo = win_lo;
        hi = win_hi;
    }
    if (rtx_sec_lexed(kind)) {
        int relexed = 0;
        /* The relex stops where it converges and trusts the old runs past
         * that: only a section lexed whole has them (a trim, or a section
         * never on screen, has none). */
        if (sec_n <= RTX_HL_FULL_MAX && rtx_sec_lexed(done))
            relexed = rtx_doc_relex_edit(d, lo, hi, NULL) !>(e) { return cc_err(e); };
        if (!relexed) rtx_doc_highlight_span(d, lo, hi) !>(e) { return cc_err(e); };
        if (sec_n <= RTX_HL_FULL_MAX) {
            for (s = 0; s < d->secs.len; s++) {
                if (d->secs.data[s].start <= off &&
                    (s + 1 == d->secs.len || d->secs.data[s + 1].start > off)) {
                    d->secs.data[s].hl_done = 1;
                    break;
                }
            }
        }
    } else if (kind == RTX_SEC_PROSE) {
        rtx_doc_refresh_prose_runs(d, lo, hi) !>(e) { return cc_err(e); };
    }
    rtx_tm_ckpt_drop_stale(d);
    rtx_doc_sort_runs(d);
    return cc_ok();
}

/* Where a window lex over section `s` owns TM runs: the sections around it
 * with no `===` header between them are one lex (a window's own first
 * section starts at the window, not at a header), from the header or BOF
 * at or before it to the next header — short of a small section lexed
 * whole, whose runs are its own. Runs of sections the window cache has
 * let go are in it too. */
static void rtx_doc_lex_region(const RtxDoc *d, size_t s, size_t n, size_t *rlo,
                               size_t *rhi) {
    size_t k = s;
    for (;;) {
        size_t st = d->secs.data[k].start;
        if (st == 0 || rtx_doc_sec_floor(d, st) == st) {
            *rlo = st;
            break;
        }
        if (k == 0) {
            *rlo = 0;
            break;
        }
        if (d->secs.data[k - 1].hl_done && rtx_sec_lexed(d->secs.data[k - 1].kind)) {
            *rlo = st;
            break;
        }
        k--;
    }
    *rhi = n;
    for (k = s + 1; k < d->secs.len; k++) {
        size_t st = d->secs.data[k].start;
        if (rtx_doc_sec_floor(d, st) == st ||
            (d->secs.data[k].hl_done && rtx_sec_lexed(d->secs.data[k].kind))) {
            *rhi = st;
            break;
        }
    }
}

/* The window lex (d->hl_cov) grows down to `win_hi` from its own last
 * checkpoint at or below its end: a camera that scrolls on lexes the bytes
 * it has not lexed, not its lookback and the page again. The result is
 * the one lex from the same anchor to `win_hi` (a checkpoint is that lex's
 * state; the frames open at the seam are joined as an edit relex joins
 * them), so a catch-up lex stays exact and a lookback lex stays that
 * lookback's leftover. `keep` (a scratch or lookback fill) keeps the
 * window's top; a camera fill drops the runs above `win_lo`, as a fresh
 * lex of its window would have planted none there. 0: no checkpoint to
 * resume from (the caller lexes the window). */
static int !>(CCError) rtx_doc_hl_extend(RtxDoc *d, size_t rlo, size_t rhi,
                                        size_t win_lo, size_t win_hi, int keep) {
    const RtxTmRt *rt;
    RtxHlCov cov;
    RtxTmCkpt seed;
    RtxMdStart ms = {0};
    size_t i, start, emit, saved_runs;
    int found = 0, cut = 0;
    CCArena frame;
    char[:] bytes;
    if (!d || !d->hl_cov.live) return cc_ok(0);
    cov = d->hl_cov;
    rt = rtx_tm_for_path(d->path.ptr);
    if (!rt) return cc_ok(0);
    {
        /* The lex's end checkpoint is that lex's state only if its last
         * line was whole: a window cut mid-line (a capped fill) saw a
         * truncated line, so resume from the one before. */
        char pc = '\n';
        size_t got = 1;
        if (cov.hi > 0)
            got = d->read_at(cov.hi - 1, cc_slice_from_buffer(&pc, 1)) !>(e) {
                return cc_err(e);
            };
        if (got != 1 || pc != '\n') cut = 1;
    }
    for (i = d->tm_ckpt.len; i > 0; i--) {
        const RtxTmCkpt *c = &d->tm_ckpt.data[i - 1];
        if (c->off > cov.hi || (c->n & RTX_TM_CKPT_STALE)) continue;
        if (cut && c->off == cov.hi) continue;
        if (c->off < cov.anchor) break;
        if (rtx_tm_ckpt_seedable(rt, c)) {
            seed = *c;
            found = 1;
            break;
        }
    }
    /* Resume only near the window: past a lookback's worth of bytes a
     * fresh window lex is the cheaper one. */
    if (!found || seed.off + (size_t)RTX_MARKUP_LOOKBACK + (size_t)RTX_TM_CKPT_STRIDE < win_lo)
        return cc_ok(0);
    start = seed.off;
    frame = cc_arena_heap((win_hi - start) + 64);
    if (!frame.base) return cc_err(CC_ERR_OUT_OF_MEMORY, "hl extend");
    bytes = d->scratch_span(start, win_hi - start, frame) !>(e) {
        frame.destroy();
        return cc_err(e);
    };
    saved_runs = d->runs.len;
    rtx_tm_ckpt_drop_from(d, start + 1);
    ms.inl = cov.md_inl < start ? cov.md_inl : start;
    ms.bol = 1;
    emit = start > cov.lo ? start : cov.lo;
    rtx_doc_lex(d, rt, bytes, start, emit, &seed, RTX_TM_CATCHUP, NULL,
                rt->blocks ? &ms : NULL) !>(e) {
        rtx_doc_runs_cut(d, saved_runs);
        rtx_tm_ckpt_drop_from(d, start);
        d->hl_cov.live = 0;
        frame.destroy();
        return cc_err(e);
    };
    frame.destroy();
    rtx_doc_clip_runs_upto(d, emit, win_hi, rtx_run_planted_tm, saved_runs) !>(e) {
        d->hl_cov.live = 0;
        return cc_err(e);
    };
    if (start > cov.lo) rtx_doc_runs_join_at(d, start);
    if (!keep) {
        rtx_doc_clip_runs(d, rlo, win_lo, rtx_run_planted_tm) !>(e) {
            d->hl_cov.live = 0;
            return cc_err(e);
        };
        rtx_doc_clip_runs(d, win_hi, rhi, rtx_run_planted_tm) !>(e) {
            d->hl_cov.live = 0;
            return cc_err(e);
        };
    }
    if (!keep) cov.lo = win_lo;
    cov.hi = win_hi;
    cov.live = 1;
    d->hl_cov = cov;
    return cc_ok(1);
}

void !>(CCError) RtxDoc_ensure_hl(RtxDoc *d, RtxHlWin w) {
    size_t n;
    if (!d) return cc_err(CC_ERR_INVALID_ARG, "null doc");
    n = d->len();
    rtx_doc_mdref_update(d) !>(e) { return cc_err(e); };
    if (d->mdref.stale || d->mdref.npend || d->mdref.over || d->mdref.nlimbo) {
        rtx_doc_mdref_fix(d, w.from, 0) !>(e) { return cc_err(e); };
    }
    rtx_doc_ensure_hl_once(d, w) !>(e) { return cc_err(e); };
    if (d->mdref.npend || d->mdref.over || d->mdref.nlimbo) {
        /* This lex met a definition a label it asked about names (a
         * reference above its definition): once more, knowing it. */
        rtx_doc_mdref_fix(d, w.from, 0) !>(e) { return cc_err(e); };
        rtx_doc_ensure_hl_once(d, w) !>(e) { return cc_err(e); };
    }
    return cc_ok();
}

static void !>(CCError) rtx_doc_ensure_hl_once(RtxDoc *d, RtxHlWin w) {
    size_t s, n, lo, hi, from, to, win_lo, win_hi, sec_n;
    if (!d) return cc_err(CC_ERR_INVALID_ARG, "null doc");
    from = w.from;
    to = from + w.n;
    if (d->hl_full || to <= from) return cc_ok();
    n = d->len();
    if (from > n) from = n;
    if (to > n) to = n;
    if (to > from && to - from > (size_t)RTX_HL_WIN_MAX) {
        to = from + (size_t)RTX_HL_WIN_MAX;
    }
    if (n > RTX_MARKUP_SCAN_MAX) {
        rtx_doc_window_markup(d, from, to) !>(e) { return cc_err(e); };
    }
    for (s = 0; s < d->secs.len; s++) {
        if (d->secs.data[s].kind != RTX_SEC_PROSE) continue;
        lo = d->secs.data[s].start;
        hi = (s + 1 < d->secs.len) ? d->secs.data[s + 1].start : n;
        if (hi <= from || lo >= to) continue;
        rtx_doc_clip_runs(d, lo, hi, rtx_run_planted_tm) !>(e) {
            return cc_err(e);
        };
    }
    for (s = 0; s < d->secs.len; s++) {
        if (!rtx_sec_lexed(d->secs.data[s].kind) || d->secs.data[s].hl_done) continue;
        lo = d->secs.data[s].start;
        hi = (s + 1 < d->secs.len) ? d->secs.data[s + 1].start : n;
        if (hi <= from || lo >= to) continue;
        sec_n = hi > lo ? hi - lo : 0;
        if (sec_n <= RTX_HL_FULL_MAX) {
            rtx_doc_highlight_span(d, lo, hi) !>(e) { return cc_err(e); };
            d->secs.data[s].hl_done = 1;
        } else {
            RtxHlCov cov;
            size_t rlo, rhi;
            win_lo = from > lo ? from : lo;
            win_hi = to < hi ? to : hi;
            rtx_doc_lex_region(d, s, n, &rlo, &rhi);
            /* The window's last lex (edits relexed where they converge)
             * still stands: a keystroke lexes nothing here. A smaller
             * replacing window drops the runs outside it, as its own lex
             * from the same anchor would have emitted none there. */
            if (d->hl_cov.live && d->hl_cov.lo <= win_lo && win_hi <= d->hl_cov.hi) {
                if (!w.keep && (win_lo > d->hl_cov.lo || win_hi < d->hl_cov.hi)) {
                    rtx_doc_clip_runs(d, rlo, win_lo, rtx_run_planted_tm) !>(e) {
                        return cc_err(e);
                    };
                    rtx_doc_clip_runs(d, win_hi, rhi, rtx_run_planted_tm) !>(e) {
                        return cc_err(e);
                    };
                    d->hl_cov.lo = win_lo;
                    d->hl_cov.hi = win_hi;
                }
                continue;
            }
            /* The window moved on past the last lex: resume that lex. */
            if (d->hl_cov.live && d->hl_cov.lo <= win_lo && d->hl_cov.hi < win_hi &&
                d->hl_cov.anchor >= rlo && d->hl_cov.hi <= rhi) {
                int ext = rtx_doc_hl_extend(d, rlo, rhi, win_lo, win_hi, w.keep) !>(e) {
                    return cc_err(e);
                };
                if (ext) continue;
            }
            /* Window highlight: drop prior hl runs in this lex region or
             * scrolling a long CODE file (CSV) appends forever. Grid header
             * / held lookback pass keep so the window stays. */
            if (!w.keep) {
                rtx_doc_clip_runs(d, rlo, rhi, rtx_run_planted_tm) !>(e) {
                    return cc_err(e);
                };
            }
            rtx_doc_highlight_span_raw(d, rtx_doc_sec_floor(d, lo), win_lo, win_hi,
                                       &cov) !>(e) {
                return cc_err(e);
            };
            d->hl_cov = cov;
        }
    }
    rtx_doc_sort_runs(d);
    return cc_ok();
}


/* Zones [zl, zh) sorted by start, overlaps merged. */
static size_t rtx_trim_merge(size_t *zl, size_t *zh, size_t nz) {
    size_t i, j, o = 0;
    for (i = 1; i < nz; i++) {
        size_t l = zl[i], h = zh[i];
        for (j = i; j > 0 && zl[j - 1] > l; j--) {
            zl[j] = zl[j - 1];
            zh[j] = zh[j - 1];
        }
        zl[j] = l;
        zh[j] = h;
    }
    for (i = 0; i < nz; i++) {
        if (o && zl[i] <= zh[o - 1]) {
            if (zh[i] > zh[o - 1]) zh[o - 1] = zh[i];
            continue;
        }
        zl[o] = zl[i];
        zh[o] = zh[i];
        o++;
    }
    return o;
}

/* 1 when [a, b] sits inside one zone. */
static int rtx_trim_inside(const size_t *zl, const size_t *zh, size_t nz, size_t a,
                           size_t b) {
    size_t i;
    for (i = 0; i < nz; i++)
        if (zl[i] <= a && b <= zh[i]) return 1;
    return 0;
}

static size_t g_hl_trim_floor = RTX_HL_TRIM_MIN;

void rtx_hl_trim_floor(size_t n) {
    g_hl_trim_floor = n ? n : (size_t)RTX_HL_TRIM_MIN;
}

void RtxDoc_hl_trim(RtxDoc *d, const size_t *lo, const size_t *hi, size_t n) {
    size_t zl[RTX_HL_TRIM_WINS], zh[RTX_HL_TRIM_WINS];
    size_t nz = 0, i, w, j, len;
    int grew = 1;
    if (!d || d->hl_full || !lo || !hi || n == 0) return;
    if (d->runs.len <= g_hl_trim_floor || d->runs.len <= d->runs_trim) return;
    len = d->len();
    for (i = 0; i < n && nz < (size_t)RTX_HL_TRIM_WINS; i++) {
        size_t a = lo[i], b = hi[i] > lo[i] ? hi[i] : lo[i];
        zl[nz] = a > (size_t)RTX_HL_KEEP_MARGIN ? a - (size_t)RTX_HL_KEEP_MARGIN : 0;
        zh[nz] = b + (size_t)RTX_HL_KEEP_MARGIN < len ? b + (size_t)RTX_HL_KEEP_MARGIN : len;
        nz++;
    }
    nz = rtx_trim_merge(zl, zh, nz);
    /* A lexed section's runs are all or nothing: an edit there relexes
     * only to where the lex converges and trusts the old runs past it. */
    while (grew) {
        grew = 0;
        for (i = 0; i < d->secs.len; i++) {
            size_t a = d->secs.data[i].start;
            size_t b = i + 1 < d->secs.len ? d->secs.data[i + 1].start : len;
            if (!d->secs.data[i].hl_done || !rtx_sec_lexed(d->secs.data[i].kind)) continue;
            for (j = 0; j < nz; j++) {
                if (a < zh[j] && b > zl[j] && (a < zl[j] || b > zh[j])) {
                    if (a < zl[j]) zl[j] = a;
                    if (b > zh[j]) zh[j] = b;
                    grew = 1;
                }
            }
        }
        if (grew) nz = rtx_trim_merge(zl, zh, nz);
    }
    rtx_doc_sort_runs(d);
    /* Runs in start order, zones too: zone j is the first ending past the
     * run's start, and the run stays when it reaches into it. */
    w = 0;
    j = 0;
    for (i = 0; i < d->runs.len; i++) {
        RtxRun r = d->runs.data[i];
        while (j < nz && zh[j] <= r.start) j++;
        if (j < nz && zl[j] < r.start + r.len + (r.len == 0)) d->runs.data[w++] = r;
    }
    if (w < d->runs.len) {
        d->runs.truncate(w);
        rtx_doc_run_top_build(d);
        /* What planted the dropped runs forgets it did. */
        for (i = 0; i < (size_t)RTX_MARKUP_CACHE_WINDOWS; i++) {
            RtxMarkupWin *mw = &d->hl_win[i];
            if (mw->live && !rtx_trim_inside(zl, zh, nz, mw->from, mw->to))
                *mw = (RtxMarkupWin){0};
        }
        for (i = 0; i < d->secs.len; i++) {
            size_t a = d->secs.data[i].start;
            size_t b = i + 1 < d->secs.len ? d->secs.data[i + 1].start : len;
            if (d->secs.data[i].hl_done && !rtx_trim_inside(zl, zh, nz, a, b))
                d->secs.data[i].hl_done = 0;
        }
        if (d->hl_cov.live && !rtx_trim_inside(zl, zh, nz, d->hl_cov.lo, d->hl_cov.hi))
            d->hl_cov.live = 0;
    }
    d->runs_trim = 2 * d->runs.len;
}
