#!ccc ccs
/*
 * Help overlay copy (linked TU). Shared by TUI and GUI.
 *
 * The key lines are generated from the command table (cmd.cch) and the
 * live keymap (keymap.cch): letter, chords, title, then the row's notes.
 * Only the lines that are not commands (motion, mouse, Markdown typing)
 * are written out here. Built on first read, rebuilt when the keymap
 * generation or the row count moved (rtx_help_rebuild forces it).
 */
#include <ccc/std/prelude.cch>
#include <stddef.h>
#include <stdio.h>
#include <string.h>
#include "cmd.cch"
#include "keymap.cch"

#define RTX_APPLY_HELP 9
#define RTX_TABLE_HELP 12

static char g_apply_help[RTX_APPLY_HELP][80];
static size_t g_apply_help_n;
static char g_table_help[RTX_TABLE_HELP][80];
static size_t g_table_help_n;

void rtx_help_bind_apply(const char **names, size_t n) {
    size_t i;
    if (n > RTX_APPLY_HELP) n = RTX_APPLY_HELP;
    g_apply_help_n = n;
    for (i = 0; i < n; i++) {
        snprintf(g_apply_help[i], sizeof g_apply_help[i], "%zu  %s",
                 i + 1, names && names[i] ? names[i] : "");
    }
}

/* Table commands under the grammar's names while the caret is in a
 * Markdown table (n = 0 hides them). Keys are letters, not digits. */
void rtx_help_bind_table(const char **names, const int *keys, size_t n) {
    size_t i;
    if (n + 1 > RTX_TABLE_HELP) n = RTX_TABLE_HELP - 1;
    g_table_help_n = n ? n + 1 : 0;
    if (!n) return;
    snprintf(g_table_help[0], sizeof g_table_help[0], "table");
    for (i = 0; i < n; i++) {
        snprintf(g_table_help[i + 1], sizeof g_table_help[i + 1], "%c  %s",
                 keys ? (char)keys[i] : '?', names && names[i] ? names[i] : "");
    }
}

size_t rtx_apply_menu_n(void) {
    return g_apply_help_n + g_table_help_n;
}

const char *rtx_apply_menu_line(size_t i) {
    if (i < g_apply_help_n) return g_apply_help[i];
    i -= g_apply_help_n;
    if (i < g_table_help_n) return g_table_help[i];
    return NULL;
}

static const char *const rtx_help_head[] = {
    "wheel / arrows / PgUp PgDn  scroll this menu",
    "Esc          toggle this menu",
    "letter       run it (the letter column; Alt-letter too)",
    NULL
};

static const char *const rtx_help_tail[] = {
    "Enter        markdown: continue list / quote; empty item ends it",
    "S-Enter Alt-Enter  new line inside the item (no marker)",
    "Tab S-Tab    list item: nest / un-nest (renumbers 1. 2. 3.)",
    "( [ { \" ` * _  close themselves; type the closer to step over",
    "  a selection is wrapped; --no-autopair turns this off",
    "paste URL    over a selection: [selection](url)",
    "hex pane     0-9 a-f overwrite a nibble",
    "grid pane    sticky header; Tab / S-Tab next/prev column",
    "tab bar      click switch, middle-click or x close (asks if unsaved)",
    "divider      drag to resize panes",
    "arrows       move   shift-arrows select",
    "Alt-arrows   box (column) select",
    "End then up/down stays on each line end",
    "Cmd-arrows   start/end of line",
    "PgUp PgDn    page   Ctrl-Home / Ctrl-End  start / end of file",
    "click/drag   caret / selection   double word   triple line   Alt-drag box",
    "wheel        scroll   shift/alt-wheel, tilt, or wheel on the bottom bar = left/right",
    "scrollbar    jump by file bytes; long lines get a bottom bar",
    "keys.json    rebind (README: Keys and commands)",
    NULL
};

enum { RTX_HELP_MAX = 256, RTX_HELP_W = 100 };

static char g_help[RTX_HELP_MAX][RTX_HELP_W];
static size_t g_help_n;
static int g_help_built;

static void help_push(const char *s, size_t n) {
    if (g_help_n >= RTX_HELP_MAX) return;
    if (n >= RTX_HELP_W) n = RTX_HELP_W - 1;
    memcpy(g_help[g_help_n], s, n);
    g_help[g_help_n][n] = 0;
    g_help_n++;
}

static void help_push_c(const char *s) {
    help_push(s, strlen(s));
}

/* "g    Ctrl-G          Go to Line": letters, chords, title. The last
 * two-space gap is the key / action split (the painters read it). */
static void help_row(size_t i) {
    const RtxCmdDef *d = rtx_cmd_at(i);
    char key[64];
    char line[RTX_HELP_W];
    const char *hint;
    size_t k = 0;
    int w;
    if (!d || (d->flags & RTX_CMDF_NOHELP) || !rtx_cmd_available(d)) return;
    if (rtx_cmd_find(d->id) != (int)i) return;
    if (d->letters && d->letters[0]) {
        const char *l;
        for (l = d->letters; *l && k + 3 < sizeof key; l++) {
            if (k) key[k++] = '/';
            key[k++] = *l;
        }
    }
    while (k < 4) key[k++] = ' ';
    key[k] = 0;
    hint = rtx_keymap_hint((int)i);
    w = snprintf(line, sizeof line, "%s%s", key, hint && hint[0] ? hint : "");
    if (w < 0) return;
    /* Trim trailing spaces of the key part, pad to the column. */
    while (w > 0 && line[w - 1] == ' ') w--;
    while (w < 18 && w + 1 < (int)sizeof line) line[w++] = ' ';
    snprintf(line + w, sizeof line - (size_t)w, "  %s", d->title);
    help_push_c(line);
}

/* A "  words" note (no key column of its own) joins the command's line in
 * parentheses; a "key  words" note is a line of its own. */
static int help_is_gloss(const char *p, size_t n) {
    size_t i;
    if (n < 3 || p[0] != ' ' || p[1] != ' ' || p[2] == ' ') return 0;
    for (i = 2; i + 1 < n; i++)
        if (p[i] == ' ' && p[i + 1] == ' ') return 0;
    return 1;
}

static void help_notes(const char *notes, int joined) {
    const char *p = notes;
    while (p && *p) {
        const char *e = strchr(p, '\n');
        size_t n = e ? (size_t)(e - p) : strlen(p);
        if (joined && g_help_n && help_is_gloss(p, n)) {
            char *last = g_help[g_help_n - 1];
            size_t ln = strlen(last);
            if (ln + n + 2 < RTX_HELP_W)
                snprintf(last + ln, RTX_HELP_W - ln, " (%.*s)", (int)(n - 2), p + 2);
        } else {
            help_push(p, n);
        }
        p = e ? e + 1 : NULL;
    }
}

static unsigned g_help_gen;
static size_t g_help_rows;

static void help_build(void) {
    size_t i, n = rtx_cmd_n();
    g_help_n = 0;
    for (i = 0; rtx_help_head[i]; i++) help_push_c(rtx_help_head[i]);
    for (i = 0; i < n; i++) {
        const RtxCmdDef *d = rtx_cmd_at(i);
        if (!d || rtx_cmd_find(d->id) != (int)i) continue;
        {
            size_t before = g_help_n;
            help_row(i);
            if (d->notes && rtx_cmd_available(d))
                help_notes(d->notes, g_help_n > before);
        }
    }
    for (i = 0; rtx_help_tail[i]; i++) help_push_c(rtx_help_tail[i]);
    g_help_built = 1;
    g_help_gen = rtx_keymap_gen();
    g_help_rows = n;
}

/* Lazy: the lines are built when the overlay (or a test) first reads them
 * and again only after the keymap or the row table changed. Startup does
 * not pay for them. */
static void help_fresh(void) {
    if (!g_help_built || g_help_gen != rtx_keymap_gen() ||
        g_help_rows != rtx_cmd_n())
        help_build();
}

void rtx_help_rebuild(void) {
    g_help_built = 0;
}

const char *rtx_help_line(size_t i) {
    help_fresh();
    if (i >= g_help_n) return NULL;
    return g_help[i];
}

size_t rtx_help_n(void) {
    help_fresh();
    return g_help_n;
}
