#!ccc ccs
/*
 * Help overlay copy (linked TU). Strings stay out of the frontend include TU.
 */
#include <ccc/std/prelude.cch>
#include <stddef.h>

static const char *const rtx_help_tab[] = {
    "Esc          toggle this menu",
    "Esc =  Ctrl-=  engine stats (pages / lines / hl)",
    "g  Ctrl-G/J  jump to line (or N%)",
    "f  Ctrl-F    find",
    "k  Ctrl-K    next mark (this window)",
    "b  Ctrl-B    prev mark (this window)",
    "e  Ctrl-E    next invalid (this window)",
    "r  Ctrl-R    prev invalid (this window)",
    "t  Ctrl-T    fold/unfold (this window)",
    "o  Ctrl-O    browse files in this view",
    "  glob >     flatten this tree (then a normal glob)",
    "s  Ctrl-S    save",
    "a  Ctrl-A    select all",
    "z  Ctrl-Z    undo",
    "y  Ctrl-Y    redo",
    "x  Ctrl-X    cut",
    "c  Ctrl-C    copy",
    "v  Ctrl-V    paste",
    "w  Ctrl-W    other pane",
    "n  Ctrl-N    next file",
    "\\  Ctrl-\\    split",
    "l  Ctrl-L    cycle view (default / wrap / hex)",
    "hex pane     0-9 a-f overwrite a nibble",
    "u  Ctrl-U    follow lock (on / free scroll)",
    "q  Ctrl-Q    quit  (asks if unsaved)",
    "arrows       move   shift-arrows select",
    "Alt-arrows   box (column) select",
    "End then up/down stays on each line end",
    "Cmd-arrows   start/end of line",
    "click/drag   caret / selection   Alt-drag box",
    "wheel        scroll",
    "scrollbar    jump by file bytes",
    NULL
};

const char *rtx_help_line(size_t i) {
    if (i >= sizeof(rtx_help_tab) / sizeof(rtx_help_tab[0])) return NULL;
    return rtx_help_tab[i];
}
