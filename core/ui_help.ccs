#!ccc ccs
/*
 * Help overlay copy (linked TU). Shared copy for TUI and GUI.
 */
#include <ccc/std/prelude.cch>
#include <stddef.h>
#include <stdio.h>

#define RTX_APPLY_HELP 9

static char g_apply_help[RTX_APPLY_HELP][80];
static size_t g_apply_help_n;

void rtx_help_bind_apply(const char **names, size_t n) {
    size_t i;
    if (n > RTX_APPLY_HELP) n = RTX_APPLY_HELP;
    g_apply_help_n = n;
    for (i = 0; i < n; i++) {
        snprintf(g_apply_help[i], sizeof g_apply_help[i], "%zu  %s",
                 i + 1, names && names[i] ? names[i] : "");
    }
}

size_t rtx_apply_menu_n(void) {
    return g_apply_help_n;
}

const char *rtx_apply_menu_line(size_t i) {
    if (i >= g_apply_help_n) return NULL;
    return g_apply_help[i];
}

static const char *const rtx_help_tab[] = {
    "Esc          toggle this menu",
    "Esc =  Ctrl-=  engine stats (pages / lines / hl)",
    "g  Ctrl-G/J  jump to line (or N%)",
    "f  Ctrl-F    find",
    "k  Ctrl-K    next mark (this window)",
    "p  Ctrl-P    prev mark (this window)",
    "e  Ctrl-E    next invalid (this window)",
    "r  Ctrl-R    prev invalid (this window)",
    "t  Ctrl-T    fold/unfold (this window)",
    "h  Shift-Cmd-H  apply (cycle prefix / off)",
    ".  Cmd-.     apply menu  (then 1-9)",
    "1-9 Cmd-1-9  named apply",
    "b  Ctrl-B    browse",
    "o  Ctrl-O    browse (also)",
    "  glob       filter this dir, then flatten below",
    "  glob >     flatten this tree only",
    "  browse ^O  open selection in this app (new process)",
    "  browse ^E  open selection in the other app (cctext / ray)",
    "  browse ^L  cycle preview view (does not write the journal)",
    "  browse click preview / rail  open the file",
    "s  Ctrl-S    save  (asks if the file changed on disk)",
    "a  Ctrl-A    select all",
    "z  Ctrl-Z    undo",
    "y  Ctrl-Y    redo",
    "x  Ctrl-X    cut",
    "c  Ctrl-C    copy",
    "v  Ctrl-V    paste",
    "w  Ctrl-W    other pane",
    "n  Ctrl-N    next file",
    "\\  Ctrl-\\    split",
    "l  Ctrl-L    cycle view (default / wrap / hex / grid)",
    "d  Ctrl-D    rich / source (markup hints hidden / shown)",
    "hex pane     0-9 a-f overwrite a nibble",
    "grid pane    sticky header; Tab / S-Tab next/prev column",
    "u  Ctrl-U    follow lock (on / free scroll)",
    "q  Ctrl-Q    quit  (asks if unsaved)",
    "arrows       move   shift-arrows select",
    "Alt-arrows   box (column) select",
    "End then up/down stays on each line end",
    "Cmd-arrows   start/end of line",
    "click/drag   caret / selection   double word   triple line   Alt-drag box",
    "wheel        scroll   shift/alt-wheel, tilt, or wheel on the bottom bar = left/right",
    "scrollbar    jump by file bytes; long lines get a bottom bar",
    NULL
};

const char *rtx_help_line(size_t i) {
    if (i >= sizeof(rtx_help_tab) / sizeof(rtx_help_tab[0])) return NULL;
    return rtx_help_tab[i];
}
