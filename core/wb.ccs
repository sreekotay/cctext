#!ccc ccs
/*
 * Workbook engine (linked TU; see wb.cch, docs/workbook.md "W1: the lazy
 * engine" and "W1 as built").
 *
 * Computation follows the highlighter's lazy pattern: compute for the
 * view, keep checkpoints instead of results, stop at convergence, never
 * block a keystroke.
 *
 * Stored state (nothing per cell):
 *   - bytes (the document) and a position index per table: blocks of
 *     ~256 rows, each with its first byte and per row an offset, a length
 *     and a stable row id (row id -> block, slot);
 *   - the rule graph: one node per name (calc / params line), rule (a
 *     column's formula text, shared by every row that writes it), column
 *     (a hub: its literals and rules), aggregate (instances per outer-row
 *     parameter tuple) — edges carry a shape (same row, whole column ->
 *     aggregate, scalar, lookup, relative rows, membership);
 *   - per aggregate instance: the W2 partials (exact sums, counts, the
 *     per-block stop counts and min / max bests), per block id;
 *   - per table with a previous-row chain: checkpoints (the carried values
 *     at each block's end) and a frontier;
 *   - key indexes for equality lookups;
 *   - one value per name / instance (its last value) and a bounded view
 *     cache of painted cells.
 *
 * A row formula's value is recomputed from the row's bytes on demand. The
 * old value a delta subtracts comes from the edited rows' old bytes,
 * captured by the pre-edit hook (formulas are pure).
 *
 * Big work (an aggregate rebuild over a big table, a chain recompute, the
 * structural read of a big workbook) runs as cooperative jobs stepped
 * from the host's idle loop in bounded slices; values not yet recomputed
 * paint their last value, stale.
 *
 * Arenas: `ma` holds the model (tables' names, ASTs, rules, names), `va`
 * stored values (text / error bytes), `sa` scratch for one operation.
 * Growable per-row / per-block arrays live on the heap.
 */
#include <ccc/std/prelude.cch>
#include <stdarg.h>
#include <stdint.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <time.h>
#include <math.h>
#include "wb.cch"
#include "wb_num.cch"
#include "md_table.cch"
#include "sindex.cch"
#include "rtx_par.cch"
#include <errno.h>
#include <fcntl.h>
#include <pthread.h>
#include <sys/stat.h>
#include <unistd.h>

/* The parallel read's lane body and pre-read arm (the lowered @parallel
 * thunks are hoisted above the functions). */
static void wbp_lane_run(void *arg);
static void wbp_arm_run_v(void *a);

/* ------------------------------------------------------------------ values */

enum {
    WV_NULL = 0,
    WV_INT,
    WV_DEC,
    WV_FLOAT,
    WV_BOOL,
    WV_DATE,
    WV_TEXT,
    WV_ERR,
    WV_ROW, /* lookup result: code = table, u.i = row */
    WV_TAB, /* a table named as a value (count(T)) */
    WV_GRP  /* a group MA's result: u.i = MA index, n = content version */
};

enum {
    WE_DIV0 = 1,
    WE_REF,
    WE_NAME,
    WE_TYPE,
    WE_CYCLE,
    WE_DUP,
    WE_NUM,
    WE_PARSE,
    WE_SCHEMA
};

static const char *const g_we_tag[] = {"#err",  "#div0", "#ref", "#name", "#type",
                                       "#cycle", "#dup", "#num", "#parse", "#schema"};

typedef struct {
    uint8_t t;
    uint8_t sc;    /* WV_DEC scale */
    uint16_t code; /* WV_ERR code; WV_ROW table */
    uint32_t n;    /* WV_TEXT / WV_ERR bytes */
    union {
        int64_t i;
        double f;
        const char *s;
    } u;
} WVal;

static WVal wv_null(void) {
    WVal v;
    memset(&v, 0, sizeof v);
    return v;
}

static WVal wv_int(int64_t i) {
    WVal v = wv_null();
    v.t = WV_INT;
    v.u.i = i;
    return v;
}

static WVal wv_dec(int64_t i, int sc) {
    WVal v = wv_null();
    v.t = sc ? WV_DEC : WV_INT;
    v.sc = (uint8_t)sc;
    v.u.i = i;
    return v;
}

static WVal wv_float(double f) {
    WVal v = wv_null();
    v.t = WV_FLOAT;
    v.u.f = f;
    return v;
}

static WVal wv_bool(int b) {
    WVal v = wv_null();
    v.t = WV_BOOL;
    v.u.i = b ? 1 : 0;
    return v;
}

static WVal wv_date(int64_t days) {
    WVal v = wv_null();
    v.t = WV_DATE;
    v.u.i = days;
    return v;
}

static const int64_t g_pow10[19] = {
    1LL, 10LL, 100LL, 1000LL, 10000LL, 100000LL, 1000000LL, 10000000LL,
    100000000LL, 1000000000LL, 10000000000LL, 100000000000LL,
    1000000000000LL, 10000000000000LL, 100000000000000LL,
    1000000000000000LL, 10000000000000000LL, 100000000000000000LL,
    1000000000000000000LL};

/* Civil date <-> days since 1970-01-01 (proleptic Gregorian). */
static int64_t wb_days_from_civil(int64_t y, unsigned m, unsigned d) {
    int64_t era;
    unsigned yoe, doy, doe;
    y -= m <= 2;
    era = (y >= 0 ? y : y - 399) / 400;
    yoe = (unsigned)(y - era * 400);
    doy = (153 * (m + (m > 2 ? -3 : 9)) + 2) / 5 + d - 1;
    doe = yoe * 365 + yoe / 4 - yoe / 100 + doy;
    return era * 146097 + (int64_t)doe - 719468;
}

static void wb_civil_from_days(int64_t z, int64_t *y, unsigned *m, unsigned *d) {
    int64_t era;
    unsigned doe, yoe, doy, mp;
    z += 719468;
    era = (z >= 0 ? z : z - 146096) / 146097;
    doe = (unsigned)(z - era * 146097);
    yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365;
    *y = (int64_t)yoe + era * 400;
    doy = doe - (365 * yoe + yoe / 4 - yoe / 100);
    mp = (5 * doy + 2) / 153;
    *d = doy - (153 * mp + 2) / 5 + 1;
    *m = mp < 10 ? mp + 3 : mp - 9;
    *y += *m <= 2;
}

/* `YYYY-MM-DD` exactly (n == 10), a real day. */
static int wb_parse_date(const char *s, size_t n, int64_t *out) {
    int64_t y;
    unsigned m, d, mdays;
    static const unsigned dim[12] = {31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31};
    size_t i;
    if (n != 10 || s[4] != '-' || s[7] != '-') return 0;
    for (i = 0; i < 10; i++) {
        if (i == 4 || i == 7) continue;
        if (s[i] < '0' || s[i] > '9') return 0;
    }
    y = (s[0] - '0') * 1000 + (s[1] - '0') * 100 + (s[2] - '0') * 10 + (s[3] - '0');
    m = (unsigned)((s[5] - '0') * 10 + (s[6] - '0'));
    d = (unsigned)((s[8] - '0') * 10 + (s[9] - '0'));
    if (m < 1 || m > 12 || d < 1) return 0;
    mdays = dim[m - 1];
    if (m == 2 && ((y % 4 == 0 && y % 100 != 0) || y % 400 == 0)) mdays = 29;
    if (d > mdays) return 0;
    *out = wb_days_from_civil(y, m, d);
    return 1;
}

/* A number literal: `-?digits(.digits)?(e[+-]?digits)?`. kind 1 int, 2 dec
 * (scale *sc), 3 float. 0 = not a number (or out of range). */
static int wb_parse_num(const char *s, size_t n, int64_t *iv, int *sc, double *fv) {
    size_t i = 0, dig = 0, frac = 0;
    int neg = 0, dot = 0, ex = 0;
    __int128 acc = 0;
    char tmp[64];
    if (!n) return 0;
    if (s[0] == '-' || s[0] == '+') {
        neg = s[0] == '-';
        i = 1;
    }
    for (; i < n; i++) {
        char c = s[i];
        if (c >= '0' && c <= '9') {
            if (ex) continue;
            dig++;
            if (dot) frac++;
            if (acc < ((__int128)1 << 100)) acc = acc * 10 + (c - '0');
            continue;
        }
        if (c == '.' && !dot && !ex) {
            dot = 1;
            continue;
        }
        if ((c == 'e' || c == 'E') && !ex && dig) {
            ex = 1;
            if (i + 1 < n && (s[i + 1] == '+' || s[i + 1] == '-')) i++;
            if (i + 1 >= n || s[i + 1] < '0' || s[i + 1] > '9') return 0;
            continue;
        }
        return 0;
    }
    if (!dig) return 0;
    if (dot && frac == 0 && !ex) return 0; /* `12.` is text */
    if (ex || frac > 18) {
        if (n >= sizeof tmp) return 0;
        memcpy(tmp, s, n);
        tmp[n] = 0;
        *fv = strtod(tmp, NULL);
        return 3;
    }
    /* -9223372036854775808 is an int (its magnitude is not) */
    if (acc > (__int128)INT64_MAX + (neg ? 1 : 0)) return 0;
    *iv = neg ? (int64_t)(-acc) : (int64_t)acc;
    *sc = (int)frac;
    return dot ? 2 : 1;
}

/* No libm in the link: the few rounding helpers, exact for |x| < 2^52. */
static double wb_trunc(double x) {
    if (!(x > -4503599627370496.0 && x < 4503599627370496.0)) return x;
    return (double)(int64_t)x;
}

static double wb_floor(double x) {
    double t = wb_trunc(x);
    return t > x ? t - 1.0 : t;
}

static double wb_ceil(double x) {
    double t = wb_trunc(x);
    return t < x ? t + 1.0 : t;
}

/* Half away from zero. */
static double wb_round(double x) {
    double t = wb_trunc(x);
    if (x - t >= 0.5) return t + 1.0;
    if (t - x >= 0.5) return t - 1.0;
    return t;
}

static double wb_nan(void) {
    double f;
    uint64_t b = 0x7ff8000000000000ull;
    memcpy(&f, &b, sizeof f);
    return f;
}

/* x - trunc(x / y) * y, exactly (C fmod): the sign of x. Each step
 * subtracts y * 2^k with y * 2^k <= |x| < y * 2^(k+1), which is exact
 * (Sterbenz), so no quotient is ever rounded (`1e20 % 3` is 2). */
static double wb_fmod(double x, double y) {
    double ax = x < 0 ? -x : x, ay = y < 0 ? -y : y, t;
    if (x != x || y != y || y == 0 || ax == 1.0 / 0.0) return wb_nan();
    if (ay == 1.0 / 0.0 || ax < ay) return x;
    t = ay;
    while (t <= ax - t) t *= 2.0; /* the largest y * 2^k <= |x| (no overflow: t <= |x| / 2) */
    while (ax >= ay) {
        if (ax >= t) ax -= t;
        t *= 0.5;
    }
    return x < 0 ? -ax : ax;
}


/* ------------------------------------------------------------------ model */

#define WNONE ((size_t)-1)
#define WN32 UINT32_MAX

/* Literal kinds a column counts (type inference). */
enum { LK_EMPTY = 0, LK_INT, LK_DEC, LK_FLOAT, LK_BOOL, LK_DATE, LK_TEXT, LK_FORMULA, LK__N };

typedef struct {
    uint32_t k[LK__N];
    uint32_t sc[19]; /* LK_DEC cells per scale */
} WColStat;

typedef struct Ex Ex;

/* Blocks: the position index (docs/workbook.md "What is stored"). A block
 * is a run of consecutive rows with a stable id; its arrays are its own
 * (an insert moves at most one block's rows). */
#define WB_BLK 256     /* rows per block at build / after a split */
#define WB_BLK_MAX 512 /* a block splits above this */
#define WB_BLK_MIN 64  /* ... and merges into a neighbour below this */

typedef struct {
    size_t lo;         /* the first row's first byte (absolute) */
    uint32_t n, cap;   /* rows */
    uint32_t *rrel;    /* row start - lo */
    uint32_t *rlen;    /* row bytes (no NL) */
    uint32_t *rid;     /* row ids */
    uint32_t pos;      /* position in the table's block order */
    uint8_t live;
} WBlock;

typedef struct {
    uint32_t bid, slot; /* bid WN32: a dead row id */
} WRloc;

/* A key index (equality lookups, both sides of a keyed lookup): the key
 * of a column's cell -> the row ids holding it. */
typedef struct {
    uint64_t h;
    int64_t i;
    const char *s;
    uint32_t n;
    uint8_t t, sc;
} WKey;

typedef struct {
    WKey k;
    uint32_t rid;  /* first row id */
    uint32_t more; /* 1 + index into kx->ov (more row ids), 0: none */
    uint32_t cnt;
    uint8_t used;
} WKxEnt;

typedef struct {
    int32_t tab, col;
    uint8_t ok;       /* built and current */
    uint8_t want;     /* a reader asked for it */
    uint32_t bad;     /* rows whose key is not indexable (error / NaN / class mismatch) */
    uint8_t cls;      /* key class of the indexed values (KY_*; 0 none yet, 255 mixed) */
    WKxEnt *e;
    uint32_t cap, used;
    uint32_t *ov;     /* overflow lists: [count, cap, ids...] chunks */
    uint32_t nov, ovcap;
    CCArena ar;       /* key text */
} WKx;

/* A previous-row chain over a table (docs/workbook.md "Relative and
 * absolute references"): per block id, the carried values (the last K
 * rows of the chain columns) at the block's end. */
typedef struct {
    uint8_t on;
    uint8_t k;           /* rows carried (the deepest @col[-k]) */
    uint16_t cols;       /* chain columns (bit mask) */
    uint16_t dep;        /* columns whose values need the chain (chain + readers) */
    uint8_t ncols;
    uint8_t cidx[16];    /* chain column -> slot in a checkpoint */
    WVal *ck;            /* per block id: k * ncols values (va) */
    uint8_t *ckok;       /* per block id: checkpoint computed */
    uint32_t ckcap;
    uint32_t front;      /* blocks [0, front) (positions) are valid */
    uint32_t *marks;     /* block ids edited at / above the frontier (convergence may not skip them) */
    uint32_t nmark, markcap;
    uint8_t need;        /* an aggregate / anchored cell / lookup needs every block */
    uint32_t want_pos;   /* the view wants the chain valid through this block position */
    /* the window: chain values of rows [wlo, wlo + wn), this operation */
    WVal *wv;
    uint8_t *wstl;
    uint32_t wlo, wn, wcap;
    uint32_t wgen;       /* opgen it was filled in */
    uint8_t walking;     /* a walk is filling it */
    uint64_t walked;     /* rows the chain job walked (stats) */
} WChain;

typedef struct WTab {
    const char *name;
    uint32_t namen;
    int32_t sheet;
    int big;               /* over the row cap: refused */
    int clash;
    size_t lo, hi;         /* caption line .. table end */
    size_t cap_lo, cap_hi; /* the name in the caption (backticks incl.) */
    size_t body_lo;        /* the first body row's first byte (hi when none) */
    int32_t ncols;
    uint32_t nrows;
    uint8_t lastnl;        /* the last row ends in a NL */
    const char **cname;
    uint32_t *cnamen;
    uint8_t *cclash;
    size_t *hlo, *hhi;     /* header cells, trimmed */
    WColStat *cs;
    uint8_t *ct, *csc;     /* inferred column type / dec scale */
    uint32_t *cnode;       /* per column: its graph node */
    uint32_t nferr;        /* formula cells may hold an error naming their row: 1 */
    /* blocks */
    WBlock *blk;           /* by block id */
    uint32_t nbid, bidcap;
    uint32_t *bord;        /* position -> block id */
    uint32_t *bfirst;      /* position -> first row */
    uint32_t nb, bordcap;
    uint32_t *bfree;       /* free block ids */
    uint32_t nfree, freecap;
    WRloc *rloc;           /* row id -> location */
    uint32_t nrid, ridcap;
    uint8_t nomerge;       /* an aggregate build is in progress: blocks do not merge */
    /* readers */
    uint32_t *aggs;        /* aggregate nodes iterating this table */
    uint32_t naggs, aggcap;
    WKx **kx;              /* per column: key index or NULL */
    WKx anc;               /* anchor name -> row ids ({#name} in a row's first cell) */
    WChain ch;
    uint16_t relmask;      /* columns some rule reads at another row */
    uint8_t relb, relf;    /* deepest backward / forward reach (non-chain relative readers) */
    /* an external table (a ```table fence over a CSV / TSV file) */
    uint8_t ext;
    RtxDoc *src;           /* its rows' document (NULL: the workbook's) */
    struct WCsv *csv;
} WTab;

typedef struct {
    size_t lo, hi;         /* structural bytes */
    size_t ext_lo, ext_hi; /* plus the line before and after */
} WBlk;

typedef struct {
    int32_t scope;         /* -3 sheets, -2 tables, -1 params, >= 0 sheet */
    const char *s;
    uint32_t n;
    uint32_t id;
    uint8_t used;
} WMapEnt;

typedef struct {
    WMapEnt *e;
    uint32_t cap;
} WMap;

enum { SC_SHEET = -3, SC_TABLE = -2, SC_PARAM = -1 };

/* A calc / params line: a name (def) or inert text. */
typedef struct {
    uint8_t def;
    uint8_t clash;         /* duplicate / case clash */
    uint8_t lit;           /* the expression is a plain literal: no painted span */
    uint8_t pend;          /* value is stale */
    int32_t scope;         /* sheet, or SC_PARAM */
    size_t raw_lo, raw_hi; /* the line */
    size_t n_lo, n_hi;     /* the defined name token */
    size_t f_lo, f_hi;     /* painted span (the expression), f_lo == f_hi: none */
    size_t src_lo;         /* AST spans are relative to this */
    const char *name;
    uint32_t namen;
    const char *src;
    uint32_t srcn;
    Ex *ex;
    uint32_t node;         /* graph node (def) */
    uint32_t *aggs;        /* its aggregate nodes in AST order */
    uint32_t naggs;
    WVal v;                /* value (va) */
    uint32_t nread;        /* reader count (status) */
} WName;

/* A rule: one column's formula text. Every row whose cell in the column
 * holds that text shares it (one AST, one set of dependencies). */
typedef struct {
    int32_t tab, col;
    uint32_t node;
    const char *src;       /* text after `=` */
    uint32_t srcn;
    uint64_t h;
    Ex *ex;                /* bound */
    uint32_t refs;         /* rows using it */
    uint16_t rowmask;      /* own-row columns it reads (@col, T[@col]) */
    uint16_t relmask;      /* columns it reads at another row (@col[k]) */
    int8_t relmin, relmax; /* offsets it reads */
    uint8_t dead;
    uint8_t pend;          /* a scalar input is stale: its rows paint stale */
    uint8_t dskip;         /* this sync takes its lookup readers as row deltas */
    uint32_t *aggs;        /* its aggregate nodes in AST order */
    uint32_t naggs;
    uint32_t nin;          /* inputs (status) */
} WRule;

/* An anchored cell (docs/workbook.md "Anchors"): a scalar node whose
 * value is one cell of a table, in the row an anchor names (`T#q3.col`,
 * `T#q3[+2].col`, `T#first.col`, `T#last[-1].col`). The anchor resolves
 * through the table's anchor index (name -> row id). */
typedef struct {
    int32_t tab, col;
    const char *anc;       /* anchor name; "first" / "last" are implicit */
    uint32_t ancn;
    int32_t off;           /* rows after the anchor */
    uint32_t node;
    WVal v;
    uint8_t pend;
} WAbs;

/* A `uses` line (docs/workbook.md "Cross-workbook references"): an alias
 * for another workbook, read-only, namespaced (alias.name, alias.T#a.col,
 * sum(alias.T[#a .. #b].col)). */
enum { USE_OK = 0, USE_MISSING, USE_CYCLE, USE_BAD, USE_DUP };

typedef struct {
    const char *name;      /* the alias (model arena) */
    uint32_t namen;
    const char *path;      /* the path as written (relative to this file) */
    uint32_t pathn;
    size_t raw_lo, raw_hi;
    int state;
    WVal err;              /* #ref / #cycle / #dup for everything through it */
    char *real;            /* its realpath (heap), NULL when missing */
    /* the engine's stamp when its imports were last evaluated */
    RtxWb *seen;
    uint32_t seen_vgen, seen_mgen;
    int seen_busy;
} WUse;

/* One reference into another workbook: a name (`alias.name`,
 * `alias.Sheet.name`: kind IMP_NAME, txt its label) or any other form
 * evaluated there (IMP_EXPR: txt the formula text without the alias). A
 * graph node of its own; readers take it as a scalar. */
enum { IMP_NAME = 1, IMP_EXPR };

typedef struct {
    uint32_t use;
    uint8_t kind;
    uint8_t pend;          /* the other engine's value is stale (or not there yet) */
    uint8_t has;
    const char *txt;       /* model arena */
    uint32_t n;
    uint32_t node;
    WVal v;                /* va */
} WImp;

/* A workbook this one opened itself (not open elsewhere): kept across
 * rebuilds, re-read when its file changes. */
typedef struct {
    char *real;
    RtxDoc *d;
    RtxSiId id;
    int id_ok;
    int64_t read_ns;       /* when it was read (a source file: the index's trust) */
    uint8_t stale;         /* its file changed: dropped at the next rebuild */
} WPdoc;

/* A range end: an anchor and an offset. */
typedef struct {
    const char *anc;
    uint32_t ancn;
    int32_t off;
} WEnd;

enum { CN_SKIP = 0, CN_STOP, CN_VAL };

typedef struct {
    uint8_t k;
    WVal v; /* VAL: the value (null for count(T)); STOP: the error */
} WCon;

typedef struct {
    WVal v;
    uint32_t rid; /* the row (its id) */
    uint8_t has;
} WBest;

/* A value as a key (distinct, group, key indexes): numbers by exact value
 * (int 2, dec 2.00 and float 2.0 are one key; a float that is no decimal
 * of scale <= 18 keys by its bits), text by bytes, dates, bools; one NaN. */
enum { KY_NULL = 0, KY_NUM, KY_FLT, KY_NAN, KY_TEXT, KY_DATE, KY_BOOL };

typedef struct {
    WKey k;
    uint32_t cnt;
    uint8_t used;
} WDEnt;

typedef struct {
    WDEnt *e;
    uint32_t cap, used, live;
    CCArena ar;
} WDMap;

typedef struct {
    uint32_t cnt;       /* value rows */
    uint32_t stop;      /* rows that make the aggregate an error */
    uint32_t nsc[19];   /* int (scale 0) / dec(p) values per scale */
    uint32_t nflt, nnan, npinf, nninf;
    uint32_t ncls[4];   /* min / max: number, text, date, bool values */
    uint32_t nt, nf;    /* any / all */
    __int128 isum[19];  /* exact int / dec sum per scale */
    RtxXs *fx;          /* exact float sum (sum / avg) */
    WDMap *dm;          /* distinct */
} WAcc;

/* One aggregate: fn over tab rows of arg [where p]. */
typedef struct {
    const Ex *arg, *where;
    uint8_t fn, q, crow; /* crow: count(T) counts rows */
    uint8_t bad;         /* a table argument other than count(T) */
} WOut;

typedef struct {
    WKey k;
    uint32_t rows;
    WAcc *acc;   /* one per output */
    WBest *best; /* min / max outputs */
    uint8_t *bst; /* best row left: recompute */
    uint8_t used;
    struct WGBm *bm; /* min / max outputs: the best per block (heap; NULL: none yet) */
} WGEnt;

typedef struct {
    WGEnt *e;
    uint32_t cap, used, live;
} WGMap;

/* One instance of an aggregate: its partials for one tuple of outer-row
 * parameters (none for most). Per-block arrays are indexed by block id. */
typedef struct WInst {
    uint64_t kh;
    WVal *pv;            /* parameter values (va), npv of them */
    uint32_t used;       /* LRU stamp */
    uint8_t live;
    uint8_t has;         /* v holds a computed value */
    uint8_t pend;        /* v is stale (a build is running / planned / cancelled) */
    uint8_t building;    /* a build is in progress (blocks done[] so far) */
    uint8_t full;        /* rebuild at the next update */
    uint8_t bestok;      /* min / max: root best is current */
    uint8_t anyresc, gstale;
    uint8_t gbm_off;     /* group min / max: no per-block bests (too many, restored) */
    uint8_t gresc;       /* group min / max: a block's best row left */
    uint32_t gbm_n, gbm_nout; /* per-block best slots; outputs per key */
    WVal v;              /* published value (va) */
    WAcc a;              /* root partial (group: key stops in a.stop) */
    WBest best;          /* min / max: the root's best row */
    uint32_t *lstop;     /* per block id (NULL until a stop row appears) */
    WBest *lbest;        /* per block id (min / max) */
    uint8_t *lresc;      /* per block id: rescan */
    uint8_t *ldone;      /* per block id: built (while building) */
    WAcc *lacc;          /* block mode (a chain, a range): per block id partials */
    WAcc *seg;           /* block mode: a tree over block positions (lazy) */
    uint32_t segp;       /* its leaves (a power of two); 0: rebuild */
    uint32_t lcap;
    uint32_t nstop;      /* blocks with lstop != 0 */
    WGMap gm;            /* group */
    uint32_t gver;
    CCArena ar;          /* per-instance storage (partials' maps, best text) */
    uint64_t serial;       /* unique per instance (row deltas pair by it) */
} WInst;

/* An aggregate node: one aggregate (or group) in a formula. */
typedef struct {
    uint32_t node;         /* graph node */
    uint32_t owner;        /* graph node of the formula holding it */
    int32_t tab;           /* table iterated */
    int32_t otab;          /* owner rule's table (parameters), -1 */
    uint8_t live, grp;
    uint8_t blockmode;     /* reads chain values: block partials, recomputed by the chain job */
    uint8_t pend;          /* an input is stale, or an instance is building */
    uint8_t full;          /* every instance rebuilds at the next update */
    uint8_t wanted;        /* the view / status waits for it */
    uint8_t ranged;        /* over T[#a .. #b]: block partials, a range query */
    uint8_t keep;          /* restored from the index: the first recalc's input
                            * "changes" are the inputs it was built with */
    WEnd ra, rb;
    uint16_t rowmask;     /* iterated columns read per row */
    uint16_t pmask;        /* owner-row columns read (parameters) */
    const Ex *ex;
    WOut o;                /* plain */
    const Ex *key;         /* group */
    WOut *outs;
    uint32_t nout;
    WInst **inst;          /* instances (heap) */
    uint32_t ninst, instcap;
    uint32_t built;        /* instances built by a walk (counters) */
} WAgg;

enum { GN_NAME = 1, GN_RULE, GN_COL, GN_AGG, GN_ABS, GN_IMP, GN_DEAD };

/* Edge shapes (docs/workbook.md "The rule graph"). */
enum {
    SH_SCALAR = 0, /* the value of a name / aggregate / absolute cell */
    SH_ROW,        /* same row of a column */
    SH_REL,        /* another row of a column (@col[k]) */
    SH_ALL,        /* an aggregate reads a column per row */
    SH_LOOK,       /* a lookup (scan) reads a column */
    SH_KEY,        /* a keyed lookup reads a column */
    SH_ABS,        /* an absolute cell reads a column */
    SH_MEMB,       /* a column holds a rule */
    SH_PAGG        /* a rule reads a parameterized aggregate */
};

typedef struct {
    uint8_t kind;
    uint8_t cyc;           /* a static cycle member: value is wb->cyv[cyi] */
    uint8_t queued;
    uint8_t pend;          /* stale: an input is stale, or its own job runs */
    uint8_t chg;           /* queued with a wholesale change */
    int32_t tab, col;      /* RULE / COL: table, column */
    uint32_t ref;          /* index: names / rules / aggs / abs (COL: -) */
    uint32_t *deps;        /* dependencies, with a shape each */
    uint8_t *dsh;
    uint32_t ndeps;
    uint32_t rd0, rdn;     /* dependents in wb->rdeps (with wb->rdsh) */
    uint64_t topo;         /* evaluation order (dependencies first) */
    uint32_t cyi;
    uint32_t popped;       /* the heap round that last evaluated it */
    uint32_t scc;          /* its strongly connected component (first topo) */
} WGNode;

/* A painted cell's value (the view cache: bounded, like the highlighter's
 * window cache; dropped entries recompute). */
#define WB_VC_N 4096
typedef struct {
    int32_t tab;           /* -1: empty */
    uint32_t rid;
    uint8_t col;
    uint8_t stale;
    uint8_t n;
    uint32_t gen;
    char g[RTX_WB_VAL_MAX];
} WVc;

/* One row being evaluated: its bytes, cells and values (a per-row memo). */
typedef struct WRow {
    int32_t tab;
    int32_t pos;           /* position (old mode: old position) */
    uint32_t rid;
    uint8_t old;
    uint8_t nc;
    const char *b;
    uint32_t n;
    uint32_t clo[RTX_WB_COLS_MAX], chi[RTX_WB_COLS_MAX]; /* cells (raw, between pipes) */
    uint32_t alo, ahi;     /* the first cell's `{#name}`: the name (alo == ahi: none) */
    uint32_t mlo, mhi;     /* ... the mark Rich hides (`{#name}` and its blanks) */
    uint8_t st[RTX_WB_COLS_MAX];    /* 0 todo, 1 in progress, 2 done */
    uint8_t stl[RTX_WB_COLS_MAX];   /* the value is stale */
    uint8_t csv;           /* a CSV record: fields, not pipe cells */
    char quote;
    WVal v[RTX_WB_COLS_MAX];
    struct WRow *prev;     /* chain window: row pos - 1 (NULL: read it) */
    struct WRow *chainw;   /* chain window base (rows before, carried) */
} WRow;

/* Captured old bytes of the rows an edit touches (the pre-edit hook). */
typedef struct {
    uint8_t ok;
    int32_t tab;
    uint32_t pos;          /* first captured row (position before the edit) */
    uint32_t n;            /* rows */
    size_t lo;             /* byte of the first captured row (before the edit) */
    size_t at, erased;     /* the edit */
    char *b;               /* the rows' bytes (NLs included) */
    size_t bn, bcap;
    uint32_t *roff;        /* row starts in b, n + 1 of them */
    uint32_t *rid;         /* their row ids */
    uint32_t rcap;
} WCap;

/* The overlay old-mode evaluation reads (rows [a, a + nold) of tab are
 * the captured bytes; rows after shift by nnew - nold). */
typedef struct {
    uint8_t on;
    int32_t tab;
    uint32_t a, nold, nnew;
    size_t at, old_end;    /* the edit's old bytes [at, old_end) */
    ptrdiff_t delta;       /* new length - old length */
} WOver;

/* A per-sync row delta list for one instance. */
typedef struct WDelta {
    uint32_t inst;         /* instance index in the agg */
    uint32_t agg;
    uint32_t rid;
    uint8_t has_old, has_new;
    WCon ko, kn;           /* plain */
    struct WGRowS *go, *gn; /* group */
} WDelta;

struct RtxWb {
    RtxDerived hook;
    RtxDoc *doc;
    CCArena own;
    CCArena ma, va, sa;
    size_t ma_mark, va_mark; /* bytes allocated since the rebuild */
    size_t ma_base, va_base; /* ... by the rebuild itself */
    int off;
    int need_rebuild;
    /* the structural read (a job for a big workbook) */
    struct WScan *scan;
    /* edits noted since the last sync (one union, like RtxEditSpan) */
    int pend;
    size_t p_lo, p_old, p_new;
    int pre_open;            /* a pre-edit capture waits for its note */
    int pre_multi;           /* a group: several pre calls before the notes */
    WCap cap;
    size_t doc_len;          /* length the model describes */
    uint32_t mgen;           /* model stamp: bumps when bytes / structure change */
    uint32_t vgen;           /* value stamp: bumps when a value may have changed */
    /* model */
    WName *names;            /* names and inert calc / params lines, in byte order */
    uint32_t nnames, namecap;
    WTab *tabs;
    uint32_t ntab, tabcap;
    WBlk *blks;
    uint32_t nblk, blkcap;
    const char **sheets;
    uint32_t *sheetn;
    uint32_t nsheet, sheetcap;
    WMap map;
    WRule *rules;            /* heap */
    uint32_t nrules, rulecap;
    uint32_t *rmap;          /* (tab, col, text) -> rule: open addressing, heap */
    uint32_t rmapcap, rmapn;
    WAgg *aggs;              /* heap */
    uint32_t naggs, aggcap;
    WAbs *abs;
    uint32_t nabs, abscap;
    WGNode *g;               /* graph nodes (heap) */
    uint32_t ng, gcap;
    uint32_t *rdeps;         /* dependents (model arena, per regraph) */
    uint8_t *rdsh;
    size_t nrd;
    uint32_t nderived;       /* formulas with a painted span (names + formula cells) */
    uint32_t nform_cells;    /* formula cells */
    /* recalc */
    uint32_t *heap;
    uint32_t nheap, heapcap;
    uint32_t hround;       /* heap rounds (a node pops once per round: cycles end) */
    uint64_t dl_serial0;
    /* names' last values across a rebuild (the structural read): painted
     * stale until recomputed. key: the name's label; text / error owned */
    struct WLast *lastv;
    uint32_t nlastv;   /* instances made after this serial are newer than the op: no deltas */
    uint32_t changed[RTX_WB_CHANGED_MAX]; /* names whose value changed */
    uint32_t nchanged;
    int chg_all;
    int chg_cells;           /* cell values may have changed (the view cache decides) */
    WVal *cyv;               /* each cycle's #cycle(path) (model arena) */
    uint32_t ncyv, cyvcap;
    int graph_dirty;         /* rules / names changed: regraph before the recalc */
    /* bind scratch */
    uint32_t *bdeps;
    uint8_t *bdsh;
    uint32_t nbd, bdcap;
    /* deltas of one sync */
    WDelta *dl;
    uint32_t ndl, dlcap;
    WOver ov;
    int oldmode_fail;        /* an old-mode evaluation could not see the old state */
    /* jobs */
    int jobs;                /* work is planned (aggregate builds, chains) */
    int cancelled;           /* jobs were cancelled: values stale until replanned */
    size_t inline_left;      /* row evaluations a sync may still do inline */
    uint32_t pubs;           /* values published by jobs since the host last asked */
    long pub_ms;
    /* rows other formulas read (a bounded ring, per operation) */
    WRow *ring;
    uint32_t *ring_gen;
    uint32_t *ring_used;
    uint32_t ring_clock;
    uint32_t opgen;          /* bumps per public operation (ring, chain windows) */
    /* the view cache */
    WVc *vc;
    uint32_t vc_evict;       /* entries dropped since the last changed() */
    /* the persisted index (wb_persist.cch): the file's identity at open */
    struct WbiLoad *idx;     /* loaded, consumed by the next structural read */
    char *idx_path;          /* the .wbi file (NULL: not file-backed / off) */
    char *doc_real;          /* the doc's realpath */
    RtxSiId open_id;
    int64_t open_ns;         /* when the bytes were read */
    int open_id_ok;
    int idx_bad;             /* a section did not install: read again without it */
    uint32_t idx_wmgen;      /* the last write: model stamp and level */
    int idx_wlevel;
    /* imports (`uses`): per model the lines and references; the private
     * documents across rebuilds */
    WUse *uses;
    uint32_t nuses, usecap;
    WImp *imps;
    uint32_t nimps, impcap;
    WPdoc *pdocs;
    uint32_t npdocs, pdoccap;
    long pdoc_check_ms;
    int imp_busy;            /* another engine is reading this one (cycle guard) */
    /* reader-side key indexes (lookup readers as row deltas) */
    struct WRkx *rkx;
    uint32_t nrkx, rkxcap;
    int rkx_listed;
    uint32_t rkx_bindgen, bind_gen;
    RtxWbStats st;
};


/* ----------------------------------------------------------------- limits */

static size_t g_wb_max = RTX_WB_MAX;
static int32_t g_wb_rows_max = RTX_WB_ROWS_MAX;
static size_t g_wb_defer = RTX_WB_DEFER_BYTES;
static size_t g_wb_inline = RTX_WB_INLINE_WORK;
static long g_wb_slice_ms = RTX_WB_SLICE_MS;
static size_t g_wb_slice_rows; /* tests: rows per idle slice (0: the time slice only) */
static int g_wb_settling;      /* inside wb_settle: every job to the end */
static long g_wb_slice_pause_ms; /* tests: a pause after each idle slice (RTX_WB_SLICE_PAUSE_MS) */

void rtx_wb_limits(size_t max_bytes, size_t max_rows, size_t defer_bytes) {
    if (max_bytes) g_wb_max = max_bytes;
    if (max_rows) g_wb_rows_max = max_rows < (size_t)INT32_MAX / 2 ? (int32_t)max_rows : INT32_MAX / 2;
    if (defer_bytes) g_wb_defer = defer_bytes;
}

void rtx_wb_limits_get(size_t *max_bytes, size_t *max_rows, size_t *defer_bytes) {
    if (max_bytes) *max_bytes = g_wb_max;
    if (max_rows) *max_rows = (size_t)g_wb_rows_max;
    if (defer_bytes) *defer_bytes = g_wb_defer;
}

void rtx_wb_job_limits(size_t inline_work, long slice_ms) {
    if (inline_work) g_wb_inline = inline_work;
    if (slice_ms > 0) g_wb_slice_ms = slice_ms;
}

static long wb_now_ms(void) {
    struct timespec ts;
    clock_gettime(CLOCK_MONOTONIC, &ts);
    return (long)ts.tv_sec * 1000L + ts.tv_nsec / 1000000L;
}

static double wb_now_us(void) {
    struct timespec ts;
    clock_gettime(CLOCK_MONOTONIC, &ts);
    return (double)ts.tv_sec * 1e6 + (double)ts.tv_nsec / 1e3;
}

/* "over 8 MiB" for the messages. */
static void wb_cap_text(char *out, size_t cap) {
    if (g_wb_max >= ((size_t)1 << 20) && g_wb_max % ((size_t)1 << 20) == 0)
        snprintf(out, cap, "%zu MiB", g_wb_max >> 20);
    else
        snprintf(out, cap, "%zu bytes", g_wb_max);
}

/* ----------------------------------------------------------------- memory */

static void *wb_alloc(CCArena a, size_t n) {
    void *p = cc_arena_alloc(a, n ? n : 1, 16);
    if (p) memset(p, 0, n ? n : 1);
    return p;
}

static void *wb_ma(RtxWb *wb, size_t n) {
    wb->ma_mark += n;
    return wb_alloc(wb->ma, n);
}

static char *wb_strdup(RtxWb *wb, const char *s, size_t n) {
    char *p = (char *)wb_ma(wb, n + 1);
    if (!p) return NULL;
    if (n) memcpy(p, s, n);
    p[n] = 0;
    return p;
}

/* Grow *pp (elements of `el` bytes) to hold `need`; model arena. */
static int wb_grow(RtxWb *wb, void **pp, uint32_t *cap, uint32_t need, size_t el) {
    uint32_t nc;
    void *np;
    if (need <= *cap) return 1;
    nc = *cap ? *cap * 2 : 64;
    while (nc < need) nc *= 2;
    np = wb_ma(wb, (size_t)nc * el);
    if (!np) return 0;
    if (*pp && *cap) memcpy(np, *pp, (size_t)*cap * el);
    *pp = np;
    *cap = nc;
    return 1;
}

/* Grow a heap array (zeroed tail). */
static int wb_hgrow(void **pp, uint32_t *cap, uint32_t need, size_t el) {
    uint32_t nc;
    void *np;
    if (need <= *cap) return 1;
    nc = *cap ? *cap + *cap / 2 + 16 : 64;
    while (nc < need) nc = nc + nc / 2 + 16;
    np = realloc(*pp, (size_t)nc * el);
    if (!np) return 0;
    memset((char *)np + (size_t)*cap * el, 0, (size_t)(nc - *cap) * el);
    *pp = np;
    *cap = nc;
    return 1;
}

/* Text values: in the given arena (scratch while evaluating; `va` once
 * kept). */
static WVal wv_text_a(CCArena a, const char *s, size_t n) {
    WVal v = wv_null();
    char *p = (char *)cc_arena_alloc(a, n + 1, 1);
    v.t = WV_TEXT;
    if (!p) {
        v.u.s = "";
        return v;
    }
    if (n) memcpy(p, s, n);
    p[n] = 0;
    v.u.s = p;
    v.n = (uint32_t)n;
    return v;
}

static WVal wv_err_a(CCArena a, int code, const char *fmt, ...) {
    char buf[256];
    va_list ap;
    int k;
    WVal v;
    va_start(ap, fmt);
    k = vsnprintf(buf, sizeof buf, fmt, ap);
    va_end(ap);
    if (k < 0) k = 0;
    if ((size_t)k >= sizeof buf) k = (int)sizeof buf - 1;
    v = wv_text_a(a, buf, (size_t)k);
    v.t = WV_ERR;
    v.code = (uint16_t)code;
    return v;
}

/* A value stored past the operation: its bytes copied into `va`. */
static WVal wv_keep(RtxWb *wb, WVal v) {
    if ((v.t == WV_TEXT || v.t == WV_ERR) && v.n) {
        WVal k = wv_text_a(wb->va, v.u.s, v.n);
        wb->va_mark += v.n + 1;
        k.t = v.t;
        k.code = v.code;
        return k;
    }
    if (v.t == WV_TEXT || v.t == WV_ERR) v.u.s = "";
    return v;
}

/* ... into an instance's own arena. */
static WVal wv_keep_in(CCArena a, WVal v) {
    if ((v.t == WV_TEXT || v.t == WV_ERR) && v.n) {
        WVal k = wv_text_a(a, v.u.s, v.n);
        k.t = v.t;
        k.code = v.code;
        return k;
    }
    return v;
}

/* ------------------------------------------------------------ name lookup */

static uint64_t wb_hash(int32_t scope, const char *s, size_t n, int fold) {
    uint64_t h = 1469598103934665603ull ^ (uint64_t)(uint32_t)scope;
    size_t i;
    for (i = 0; i < n; i++) {
        unsigned char c = (unsigned char)s[i];
        if (fold && c >= 'A' && c <= 'Z') c = (unsigned char)(c + 32);
        h ^= c;
        h *= 1099511628211ull;
    }
    return h;
}

static int wb_ieq(const char *a, const char *b, size_t n) {
    size_t i;
    for (i = 0; i < n; i++) {
        unsigned char x = (unsigned char)a[i], y = (unsigned char)b[i];
        if (x >= 'A' && x <= 'Z') x = (unsigned char)(x + 32);
        if (y >= 'A' && y <= 'Z') y = (unsigned char)(y + 32);
        if (x != y) return 0;
    }
    return 1;
}

static int wb_map_init(RtxWb *wb, WMap *m, uint32_t n) {
    uint32_t cap = 64;
    while (cap < n * 2 + 16) cap *= 2;
    m->e = (WMapEnt *)wb_ma(wb, (size_t)cap * sizeof(WMapEnt));
    m->cap = m->e ? cap : 0;
    return m->e != NULL;
}

/* Case-folded probe: the entry spelled like `s` ignoring case, or NULL. */
static WMapEnt *wb_map_find(const WMap *m, int32_t scope, const char *s, size_t n) {
    uint32_t i;
    if (!m->cap) return NULL;
    i = (uint32_t)wb_hash(scope, s, n, 1) & (m->cap - 1);
    while (m->e[i].used) {
        const WMapEnt *e = &m->e[i];
        if (e->scope == scope && e->n == n && wb_ieq(e->s, s, n)) return &m->e[i];
        i = (i + 1) & (m->cap - 1);
    }
    return NULL;
}

/* Exact lookup: id, or -1 (absent or only a case variant exists). */
static int64_t wb_map_get(const WMap *m, int32_t scope, const char *s, size_t n) {
    const WMapEnt *e = wb_map_find(m, scope, s, n);
    if (!e || memcmp(e->s, s, n) != 0) return -1;
    return (int64_t)e->id;
}

/* Insert; returns the existing entry on a (case-folded) clash, else NULL. */
static WMapEnt *wb_map_put(WMap *m, int32_t scope, const char *s, size_t n, uint32_t id) {
    uint32_t i;
    WMapEnt *hit = wb_map_find(m, scope, s, n);
    if (hit) return hit;
    if (!m->cap) return NULL;
    i = (uint32_t)wb_hash(scope, s, n, 1) & (m->cap - 1);
    while (m->e[i].used) i = (i + 1) & (m->cap - 1);
    m->e[i].used = 1;
    m->e[i].scope = scope;
    m->e[i].s = s;
    m->e[i].n = (uint32_t)n;
    m->e[i].id = id;
    return NULL;
}

/* -------------------------------------------------------------- formatting */

static size_t wb_put(char *out, size_t cap, size_t at, const char *s, size_t n) {
    size_t k;
    if (!out || !cap || at + 1 >= cap) return at;
    k = n;
    if (at + k + 1 > cap) k = cap - 1 - at;
    memcpy(out + at, s, k);
    out[at + k] = 0;
    return at + k;
}

static size_t wb_puts(char *out, size_t cap, size_t at, const char *s) {
    return wb_put(out, cap, at, s, strlen(s));
}

/* Value text: numbers plain, dec with its scale, float shortest-ish
 * (%.15g), dates ISO, errors `#code` (full: `#code(message)`). */
static size_t wv_fmt(const WVal *v, char *out, size_t cap, int full) {
    char b[64];
    size_t at = 0;
    if (out && cap) out[0] = 0;
    switch (v->t) {
    case WV_NULL:
        return 0;
    case WV_INT:
        snprintf(b, sizeof b, "%lld", (long long)v->u.i);
        return wb_puts(out, cap, 0, b);
    case WV_DEC: {
        uint64_t mag = v->u.i < 0 ? (uint64_t)(-(v->u.i + 1)) + 1 : (uint64_t)v->u.i;
        uint64_t p = (uint64_t)g_pow10[v->sc];
        snprintf(b, sizeof b, "%s%llu.%0*llu", v->u.i < 0 ? "-" : "",
                 (unsigned long long)(mag / p), (int)v->sc,
                 (unsigned long long)(mag % p));
        return wb_puts(out, cap, 0, b);
    }
    case WV_FLOAT:
        if (isnan(v->u.f)) return wb_puts(out, cap, 0, "nan");
        if (isinf(v->u.f)) return wb_puts(out, cap, 0, v->u.f < 0 ? "-inf" : "inf");
        snprintf(b, sizeof b, "%.15g", v->u.f);
        return wb_puts(out, cap, 0, b);
    case WV_BOOL:
        return wb_puts(out, cap, 0, v->u.i ? "true" : "false");
    case WV_DATE: {
        int64_t y;
        unsigned m, d;
        wb_civil_from_days(v->u.i, &y, &m, &d);
        snprintf(b, sizeof b, "%04lld-%02u-%02u", (long long)y, m, d);
        return wb_puts(out, cap, 0, b);
    }
    case WV_TEXT:
        return wb_put(out, cap, 0, v->u.s, v->n);
    case WV_ERR:
        at = wb_puts(out, cap, 0, g_we_tag[v->code <= WE_SCHEMA ? v->code : 0]);
        if (full && v->n) {
            at = wb_puts(out, cap, at, "(");
            at = wb_put(out, cap, at, v->u.s, v->n);
            at = wb_puts(out, cap, at, ")");
        }
        return at;
    case WV_ROW:
        return wb_puts(out, cap, 0, "#type");
    case WV_TAB:
        return wb_puts(out, cap, 0, "#type");
    case WV_GRP:
        snprintf(b, sizeof b, "%u group%s", (unsigned)v->code, v->code == 1 ? "" : "s");
        return wb_puts(out, cap, 0, b);
    }
    return 0;
}

static int wb_id0(char c) {
    return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || c == '_';
}

static int wb_id1(char c) {
    return wb_id0(c) || (c >= '0' && c <= '9');
}

static int wb_ws(char c) {
    return c == ' ' || c == '\t';
}

static void wb_trim(const char *s, size_t *lo, size_t *hi) {
    while (*lo < *hi && (wb_ws(s[*lo]) || s[*lo] == '\r')) (*lo)++;
    while (*hi > *lo && (wb_ws(s[*hi - 1]) || s[*hi - 1] == '\r')) (*hi)--;
}

static size_t wb_read(const RtxDoc *d, size_t off, char *dst, size_t n) {
    size_t got = 0;
    while (got < n) {
        size_t k = RtxDoc_read_at(d, off + got, cc_slice_from_buffer(dst + got, n - got)) ?> 0;
        if (!k) break;
        got += k;
    }
    return got;
}

/* ------------------------------------------------------- external tables
 *
 * A ```` ```table Name ```` fence with `source:` binds a CSV / TSV file
 * (docs/workbook.md "External tables"): read-only, its own document (a
 * private one of this workbook, re-read when the file's identity
 * changes), its rows the same blocks as an embedded table's (offsets into
 * that document), read by the structural read (a job for a big file) and
 * kept in the persisted index with the file's identity.
 *
 *   ```table Sales
 *   source: data/sales.csv       # relative to the workbook
 *   format: csv; header: 1; quote: '"'; delim: ','   (tsv: tab)
 *   columns:
 *     id:     int     <- "Order ID"
 *     region: text    <- "Region"
 *     amount: dec(2)  <- @3        # bind by position (1-based)
 *   ```
 *
 * Records are RFC 4180: fields split at the delimiter outside quotes; a
 * quoted field may hold delimiters, newlines and doubled quotes (`""`);
 * CRLF or LF ends a record. Without `columns:` the header row names the
 * columns (the first 16); without a header, c1, c2, ... A bound header
 * that the file lacks makes that column `#schema(...)`. Types are
 * inferred per column as for embedded tables unless declared. A cell
 * starting with `=` is text. */

typedef struct WCsv {
    char delim, quote;
    int header;
    int32_t cmap[RTX_WB_COLS_MAX];   /* engine column -> field (-1: unbound) */
    WVal cerr[RTX_WB_COLS_MAX];      /* unbound columns' #schema */
    uint8_t dtype[RTX_WB_COLS_MAX];  /* declared type (0: inferred) */
    uint8_t dsc[RTX_WB_COLS_MAX];
    char *real;                      /* the file (heap) */
    RtxSiId id;
    int id_ok;
    int64_t read_ns;
    size_t pos;                      /* the read: next record */
    int done;
    size_t rows;
    WVal ncols_err;                  /* the file cannot be read: every reference */
} WCsv;

/* The fence being read (the scan). */
typedef struct WExtSpec {
    char name[256];
    size_t name_lo, name_hi;
    char source[1024];
    char delim, quote;
    int header, inlist;
    int ncol;
    char cname[RTX_WB_COLS_MAX][128];
    char bind[RTX_WB_COLS_MAX][256];   /* header text, or "" */
    int bpos[RTX_WB_COLS_MAX];         /* 1-based field, 0: by text / name */
    uint8_t ctype[RTX_WB_COLS_MAX], csc[RTX_WB_COLS_MAX];
} WExtSpec;

/* The fields of a record [s, s + n): spans (quotes kept), count. */
static int wb_csv_fields(const char *s, size_t n, char delim, char quote, uint32_t *lo, uint32_t *hi,
                         int max) {
    size_t i = 0;
    int k = 0;
    if (n && s[n - 1] == '\r') n--;
    for (;;) {
        size_t a = i;
        if (i < n && s[i] == quote) {
            i++;
            while (i < n) {
                if (s[i] == quote) {
                    if (i + 1 < n && s[i + 1] == quote) {
                        i += 2;
                        continue;
                    }
                    i++;
                    break;
                }
                i++;
            }
            while (i < n && s[i] != delim) i++;
        } else {
            const char *q = (const char *)memchr(s + i, delim, n - i);
            i = q ? (size_t)(q - s) : n;
        }
        if (k < max) {
            lo[k] = (uint32_t)a;
            hi[k] = (uint32_t)i;
        }
        k++;
        if (i >= n) break;
        i++; /* the delimiter */
    }
    return k;
}

/* A field's text: a quoted one unquoted (`""` is `"`). */
static const char *wb_csv_text(CCArena a, const char *s, size_t lo, size_t hi, char quote, uint32_t *n) {
    char *p;
    size_t i, k = 0;
    if (hi - lo < 2 || s[lo] != quote || s[hi - 1] != quote) {
        *n = (uint32_t)(hi - lo);
        return s + lo;
    }
    p = (char *)cc_arena_alloc(a, hi - lo, 1);
    if (!p) {
        *n = 0;
        return "";
    }
    for (i = lo + 1; i + 1 < hi; i++) {
        p[k++] = s[i];
        if (s[i] == quote && i + 2 < hi && s[i + 1] == quote) i++;
    }
    p[k] = 0;
    *n = (uint32_t)k;
    return p;
}

/* A CSV row's cells: the fields the engine's columns bind. */
static void wb_ext_end(RtxWb *wb, uint32_t ti);

static void wb_row_split_csv(WRow *r, const WCsv *cv, int32_t ncols) {
    uint32_t lo[256], hi[256];
    int nf = wb_csv_fields(r->b, r->n, cv->delim, cv->quote, lo, hi, 256), c;
    r->csv = 1;
    r->quote = cv->quote;
    r->nc = (uint8_t)(ncols < RTX_WB_COLS_MAX ? ncols : RTX_WB_COLS_MAX);
    for (c = 0; c < r->nc; c++) {
        int32_t f = cv->cmap[c];
        if (f >= 0 && f < nf && f < 256) {
            r->clo[c] = lo[f];
            r->chi[c] = hi[f];
        } else {
            r->clo[c] = r->chi[c] = 0;
        }
    }
    r->alo = r->ahi = r->mlo = r->mhi = 0;
    memset(r->st, 0, sizeof r->st);
    memset(r->stl, 0, sizeof r->stl);
}

/* The source document of table t's rows. */
static const RtxDoc *wb_tab_doc(const RtxWb *wb, const WTab *t) {
    return t->src ? t->src : wb->doc;
}

/* `format:` / `quote:` / `delim:` / `header:` pairs (`;`-separated). */
static void wb_ext_format(WExtSpec *x, const char *s, size_t n) {
    size_t i = 0;
    while (i < n) {
        size_t a = i, b, k, v0, v1;
        while (i < n && s[i] != ';') i++;
        b = i;
        i++;
        wb_trim(s, &a, &b);
        k = a;
        while (k < b && s[k] != ':') k++;
        if (k >= b) {
            if (b - a == 3 && !memcmp(s + a, "tsv", 3)) x->delim = '\t';
            if (b - a == 3 && !memcmp(s + a, "csv", 3)) x->delim = ',';
            continue;
        }
        v0 = k + 1;
        v1 = b;
        wb_trim(s, &v0, &v1);
        if (v1 - v0 >= 2 && (s[v0] == '\'' || s[v0] == '"') && s[v1 - 1] == s[v0]) {
            v0++;
            v1--;
        }
        if (k - a == 6 && !memcmp(s + a, "header", 6)) x->header = v1 > v0 && s[v0] != '0';
        else if (k - a == 5 && !memcmp(s + a, "quote", 5) && v1 > v0) x->quote = s[v0];
        else if (k - a == 5 && !memcmp(s + a, "delim", 5) && v1 > v0)
            x->delim = v1 - v0 == 2 && s[v0] == '\\' && s[v0 + 1] == 't' ? '\t' : s[v0];
        else if (k - a == 6 && !memcmp(s + a, "format", 6)) {
            if (v1 - v0 == 3 && !memcmp(s + v0, "tsv", 3)) x->delim = '\t';
            if (v1 - v0 == 3 && !memcmp(s + v0, "csv", 3)) x->delim = ',';
        }
    }
}

/* A type name: int / dec(p) / float / text / enum / bool / date. */
static void wb_ext_type(const char *s, size_t n, uint8_t *t, uint8_t *sc) {
    *t = 0;
    *sc = 0;
    if (n == 3 && !memcmp(s, "int", 3)) *t = WV_INT;
    else if (n == 5 && !memcmp(s, "float", 5)) *t = WV_FLOAT;
    else if ((n == 4 && !memcmp(s, "text", 4)) || (n == 4 && !memcmp(s, "enum", 4))) *t = WV_TEXT;
    else if (n == 4 && !memcmp(s, "bool", 4)) *t = WV_BOOL;
    else if (n == 4 && !memcmp(s, "date", 4)) *t = WV_DATE;
    else if (n >= 3 && !memcmp(s, "dec", 3)) {
        *t = WV_DEC;
        if (n > 5 && s[3] == '(') *sc = (uint8_t)atoi(s + 4);
        if (*sc > 18) *sc = 18;
    }
}

/* One line inside a ```` ```table ```` fence. */
static void wb_ext_line(WExtSpec *x, const char *s, size_t n) {
    size_t a = 0, b = n, k;
    int indented = n && (s[0] == ' ' || s[0] == '\t');
    {
        /* `#` starts a comment (outside quotes) */
        size_t i;
        char q = 0;
        for (i = 0; i < b; i++) {
            if (q) {
                if (s[i] == q) q = 0;
                continue;
            }
            if (s[i] == '"' || s[i] == '\'') q = s[i];
            else if (s[i] == '#') {
                b = i;
                break;
            }
        }
    }
    wb_trim(s, &a, &b);
    if (a >= b) return;
    k = a;
    while (k < b && s[k] != ':') k++;
    if (k >= b) return;
    if (indented && x->inlist) {
        /* `name: type <- "Header"` / `<- @k` */
        size_t n0 = a, n1 = k, v0 = k + 1, v1 = b, arrow;
        int c = x->ncol;
        if (c >= RTX_WB_COLS_MAX) return;
        wb_trim(s, &n0, &n1);
        if (n1 - n0 >= 2 && s[n0] == '`' && s[n1 - 1] == '`') {
            n0++;
            n1--;
        }
        snprintf(x->cname[c], sizeof x->cname[c], "%.*s", (int)(n1 - n0), s + n0);
        x->bind[c][0] = 0;
        x->bpos[c] = 0;
        for (arrow = v0; arrow + 1 < v1; arrow++)
            if (s[arrow] == '<' && s[arrow + 1] == '-') break;
        {
            size_t t0 = v0, t1 = arrow + 1 < v1 ? arrow : v1;
            wb_trim(s, &t0, &t1);
            wb_ext_type(s + t0, t1 - t0, &x->ctype[c], &x->csc[c]);
        }
        if (arrow + 1 < v1) {
            size_t b0 = arrow + 2, b1 = v1;
            wb_trim(s, &b0, &b1);
            if (b1 - b0 >= 2 && s[b0] == '"' && s[b1 - 1] == '"')
                snprintf(x->bind[c], sizeof x->bind[c], "%.*s", (int)(b1 - b0 - 2), s + b0 + 1);
            else if (b1 > b0 && s[b0] == '@')
                x->bpos[c] = atoi(s + b0 + 1);
        }
        x->ncol++;
        return;
    }
    x->inlist = 0;
    {
        size_t v0 = k + 1, v1 = b;
        wb_trim(s, &v0, &v1);
        if (k - a == 6 && !memcmp(s + a, "source", 6)) {
            if (v1 - v0 >= 2 && (s[v0] == '"' || s[v0] == '\'') && s[v1 - 1] == s[v0]) {
                v0++;
                v1--;
            }
            snprintf(x->source, sizeof x->source, "%.*s", (int)(v1 - v0), s + v0);
        } else if (k - a == 6 && !memcmp(s + a, "format", 6)) {
            wb_ext_format(x, s + k + 1, b - k - 1);
            /* `format: csv; header: 1` reads its first value as the format */
            {
                size_t f0 = v0, f1 = v0;
                while (f1 < v1 && s[f1] != ';') f1++;
                wb_trim(s, &f0, &f1);
                if (f1 - f0 == 3 && !memcmp(s + f0, "tsv", 3)) x->delim = '\t';
            }
        } else if (k - a == 7 && !memcmp(s + a, "columns", 7)) {
            x->inlist = 1;
        } else if ((k - a == 5 && !memcmp(s + a, "quote", 5)) || (k - a == 5 && !memcmp(s + a, "delim", 5)) ||
                   (k - a == 6 && !memcmp(s + a, "header", 6))) {
            wb_ext_format(x, s + a, b - a);
        }
    }
}

/* ---- reading the file's records */

typedef struct WCsvRdS {
    const RtxDoc *d;
    size_t len;
    char *buf;
    size_t blo, bn, bcap;
} WCsvRd;

/* The record at p: [p, p + *n) (no NL; CR kept), the next at *next. 0:
 * past the end. */
static int wb_csv_rec(WCsvRd *rd, size_t p, char quote, const char **rec, size_t *n, size_t *next) {
    size_t need = 64 << 10;
    for (;;) {
        size_t off, i;
        int inq = 0, whole = 0;
        if (p >= rd->len) return 0;
        size_t want0 = need < rd->len - p ? need : rd->len - p;
        if (!(p >= rd->blo && p < rd->blo + rd->bn && rd->blo + rd->bn - p >= want0)) {
            size_t want = need + (256 << 10);
            if (want > rd->len - p) want = rd->len - p;
            if (want + 1 > rd->bcap) {
                char *nb = (char *)realloc(rd->buf, want + 1);
                if (!nb) return 0;
                rd->buf = nb;
                rd->bcap = want + 1;
            }
            rd->bn = wb_read(rd->d, p, rd->buf, want);
            rd->blo = p;
            if (!rd->bn) return 0;
        }
        off = p - rd->blo;
        /* the common case: a line with no quote */
        {
            const char *nl = (const char *)memchr(rd->buf + off, '\n', rd->bn - off);
            size_t e = nl ? (size_t)(nl - rd->buf) : rd->bn;
            if (!memchr(rd->buf + off, quote, e - off)) {
                if (nl || rd->blo + rd->bn >= rd->len) {
                    *rec = rd->buf + off;
                    *n = e - off;
                    *next = rd->blo + (nl ? e + 1 : e);
                    return 1;
                }
                need = (rd->bn - off) * 2 + 4096;
                continue;
            }
        }
        for (i = off; i < rd->bn; i++) {
            char ch = rd->buf[i];
            if (ch == quote) inq = !inq;
            else if (ch == '\n' && !inq) {
                *rec = rd->buf + off;
                *n = i - off;
                *next = rd->blo + i + 1;
                whole = 1;
                break;
            }
        }
        if (whole) return 1;
        if (rd->blo + rd->bn >= rd->len) {
            *rec = rd->buf + off;
            *n = rd->bn - off;
            *next = rd->len;
            return 1;
        }
        need = (rd->bn - off) * 2 + 4096;
    }
}

/* ---------------------------------------------------------------- lexer */

enum { TK_END = 0, TK_NUM, TK_STR, TK_DATE, TK_DUR, TK_ID, TK_OP, TK_BAD, TK_ANC };
enum { OP_NE = 256, OP_LE, OP_GE, OP_DOTDOT };

typedef struct {
    uint8_t k;
    uint8_t bq;   /* backtick identifier */
    uint8_t minmag; /* NUM: 9223372036854775808 (as a dec: its scale), only after `-` */
    int op;
    uint32_t lo, hi;
    WVal v;       /* NUM / STR / DATE / DUR */
} Tok;

typedef struct {
    RtxWb *wb;
    const char *s;
    uint32_t n;
    uint32_t pos;
    Tok t;
    const char *err;
    uint32_t err_at;
} Lex;

static void lx_fail(Lex *L, const char *msg, uint32_t at) {
    if (!L->err) {
        L->err = msg;
        L->err_at = at;
    }
    L->t.k = TK_BAD;
}

static void lx_next(Lex *L) {
    const char *s = L->s;
    uint32_t n = L->n, i = L->pos, lo;
    Tok *t = &L->t;
    memset(t, 0, sizeof *t);
    while (i < n && (s[i] == ' ' || s[i] == '\t')) i++;
    lo = i;
    t->lo = lo;
    if (i >= n) {
        t->k = TK_END;
        t->hi = n;
        L->pos = n;
        return;
    }
    if (s[i] >= '0' && s[i] <= '9') {
        uint32_t j = i;
        int64_t d;
        while (j < n && ((s[j] >= '0' && s[j] <= '9') || s[j] == '-')) j++;
        if (j - i >= 10 && wb_parse_date(s + i, 10, &d) &&
            (i + 10 >= n || !(wb_id1(s[i + 10])))) {
            t->k = TK_DATE;
            t->v = wv_date(d);
            t->hi = i + 10;
            L->pos = i + 10;
            return;
        }
        j = i;
        while (j < n && s[j] >= '0' && s[j] <= '9') j++;
        if (j < n && s[j] == '.' && j + 1 < n && s[j + 1] >= '0' && s[j + 1] <= '9') {
            j++;
            while (j < n && s[j] >= '0' && s[j] <= '9') j++;
        }
        if (j < n && (s[j] == 'e' || s[j] == 'E')) {
            uint32_t k = j + 1;
            if (k < n && (s[k] == '+' || s[k] == '-')) k++;
            if (k < n && s[k] >= '0' && s[k] <= '9') {
                while (k < n && s[k] >= '0' && s[k] <= '9') k++;
                j = k;
            }
        }
        {
            int64_t iv = 0;
            int sc = 0;
            double fv = 0;
            int kind = wb_parse_num(s + i, j - i, &iv, &sc, &fv);
            t->minmag = 0;
            if (!kind && j - i < 40) {
                /* INT64_MIN's magnitude: a literal only after unary minus */
                char tmp[48];
                tmp[0] = '-';
                memcpy(tmp + 1, s + i, j - i);
                kind = wb_parse_num(tmp, j - i + 1, &iv, &sc, &fv);
                if (kind == 1 || kind == 2) t->minmag = 1;
                else kind = 0;
            }
            if (!kind) {
                lx_fail(L, "number out of range", i);
                return;
            }
            if (j < n && s[j] == 'd' && (j + 1 >= n || !wb_id1(s[j + 1]))) {
                if (kind != 1 || t->minmag) {
                    lx_fail(L, "a duration is whole days", i);
                    return;
                }
                t->k = TK_DUR;
                t->v = wv_int(iv);
                t->hi = j + 1;
                L->pos = j + 1;
                return;
            }
            if (j < n && wb_id1(s[j])) {
                lx_fail(L, "bad number", i);
                return;
            }
            t->k = TK_NUM;
            t->v = kind == 3 ? wv_float(fv) : wv_dec(iv, kind == 2 ? sc : 0);
            t->hi = j;
            L->pos = j;
            return;
        }
    }
    if (wb_id0(s[i])) {
        uint32_t j = i + 1;
        while (j < n && wb_id1(s[j])) j++;
        t->k = TK_ID;
        t->hi = j;
        L->pos = j;
        return;
    }
    if (s[i] == '`') {
        uint32_t j = i + 1;
        while (j < n && s[j] != '`') j++;
        if (j >= n || j == i + 1) {
            lx_fail(L, "unclosed `name`", i);
            return;
        }
        t->k = TK_ID;
        t->bq = 1;
        t->hi = j + 1;
        L->pos = j + 1;
        return;
    }
    if (s[i] == '#' && i + 1 < n && (wb_id0(s[i + 1]) || s[i + 1] == '`')) {
        /* an anchor: #name, #`name` */
        uint32_t j = i + 1;
        if (s[j] == '`') {
            j++;
            while (j < n && s[j] != '`') j++;
            if (j >= n || j == i + 2) {
                lx_fail(L, "unclosed #`anchor`", i);
                return;
            }
            t->bq = 1;
            j++;
        } else {
            while (j < n && wb_id1(s[j])) j++;
        }
        t->k = TK_ANC;
        t->hi = j;
        L->pos = j;
        return;
    }
    if (s[i] == '"') {
        uint32_t j = i + 1, k = 0;
        char *buf;
        while (j < n && s[j] != '"') {
            if (s[j] == '\\' && j + 1 < n) j++;
            j++;
        }
        if (j >= n) {
            lx_fail(L, "unclosed string", i);
            return;
        }
        buf = (char *)wb_ma(L->wb, j - i);
        if (!buf) {
            lx_fail(L, "out of memory", i);
            return;
        }
        {
            uint32_t q = i + 1;
            while (q < j) {
                if (s[q] == '\\' && q + 1 < j) q++;
                buf[k++] = s[q++];
            }
        }
        t->k = TK_STR;
        t->v = wv_null();
        t->v.t = WV_TEXT;
        t->v.u.s = buf;
        t->v.n = k;
        t->hi = j + 1;
        L->pos = j + 1;
        return;
    }
    t->k = TK_OP;
    t->op = (unsigned char)s[i];
    t->hi = i + 1;
    if (i + 1 < n) {
        char a = s[i], b = s[i + 1];
        if (a == '=' && b == '=') t->op = '=';
        else if (a == '!' && b == '=') t->op = OP_NE;
        else if (a == '<' && b == '>') t->op = OP_NE;
        else if (a == '<' && b == '=') t->op = OP_LE;
        else if (a == '>' && b == '=') t->op = OP_GE;
        else if (a == '.' && b == '.') t->op = OP_DOTDOT;
        if (t->op != (unsigned char)s[i] || (a == '=' && b == '=')) t->hi = i + 2;
    }
    if (!s[i] || !strchr("()[]{},.+-*/%&=<>@?!:", s[i]) ||
        (s[i] == '!' && t->op != OP_NE)) {
        lx_fail(L, "unexpected character", i);
        return;
    }
    L->pos = t->hi;
}

static int lx_kw(const Lex *L, const char *kw) {
    size_t n = strlen(kw);
    return L->t.k == TK_ID && !L->t.bq && L->t.hi - L->t.lo == n &&
           memcmp(L->s + L->t.lo, kw, n) == 0;
}

/* The current token is `if` followed by `(`: the function form, an
 * operand like any call (`if(c, a, b) + x`). */
static int lx_if_call(const Lex *L) {
    uint32_t i;
    if (L->t.k != TK_ID || L->t.bq || L->t.hi - L->t.lo != 2 || memcmp(L->s + L->t.lo, "if", 2))
        return 0;
    for (i = L->t.hi; i < L->n && (L->s[i] == ' ' || L->s[i] == '\t'); i++) {
    }
    return i < L->n && L->s[i] == '(';
}

static int lx_op(const Lex *L, int op) {
    return L->t.k == TK_OP && L->t.op == op;
}

static int wb_is_kw(const char *s, size_t n) {
    static const char *const kws[] = {"and", "or", "not", "if", "then", "else", "where",
                                      "true", "false", "null", NULL};
    size_t i;
    for (i = 0; kws[i]; i++)
        if (strlen(kws[i]) == n && memcmp(kws[i], s, n) == 0) return 1;
    return 0;
}

/* ----------------------------------------------------------------- parser */

enum {
    EX_LIT = 1,
    EX_IDENT,   /* id */
    EX_AT,      /* @id2 */
    EX_DOT,     /* a . id2 */
    EX_INDEX,   /* a [ b ] */
    EX_CALL,    /* id ( args [where] ) */
    EX_UN,      /* bin: '-' / '!' (not) */
    EX_BIN,
    EX_IF,      /* a ? b : c */
    EX_ANC,     /* #id2 (an anchor; a range end) */
    EX_TANC,    /* a # id2 (a table's anchored row) */
    /* bound */
    EX_ERR,
    EX_COL,     /* tab.col (a value only while iterating tab) */
    EX_ATCELL,  /* this row's cell (col) */
    EX_RELCELL, /* this row + off's cell (col; off in node) */
    EX_NAMEREF, /* name (node: names index) */
    EX_TABREF,  /* tab */
    EX_LOOKUP,  /* tab [ b ]: one row */
    EX_FIELD,   /* a . col */
    EX_AGG,     /* fn over tab rows: args[0] [where] (node: agg index) */
    EX_FN,      /* scalar function */
    EX_GROUP,   /* group tab by a { args[i]: agg (its name in id2) } */
    EX_GLOOKUP, /* group G (node: names index) [key = b] . output col */
    EX_ABS,     /* an anchored cell (node: abs index) */
    EX_IMP      /* a reference into another workbook (node: imports index, col: use) */
};

enum {
    FN_NONE = 0,
    FN_SUM, FN_COUNT, FN_AVG, FN_MIN, FN_MAX, FN_DISTINCT, FN_ANY, FN_ALL,
    FN_ABS, FN_ROUND, FN_FLOOR, FN_CEIL, FN_COALESCE, FN_LEN, FN_LOWER, FN_UPPER,
    FN_ISERROR, FN_IFERROR, FN_FIRST, FN_IF, FN_MIN2, FN_MAX2
};

struct Ex {
    uint8_t op;
    uint8_t isma;    /* EX_AGG / EX_GROUP: an aggregate node (node = its index) */
    uint8_t range;   /* EX_INDEX: T[#a .. #b] (b, c the ends) */
    uint8_t fn;
    uint8_t q;       /* `sum?` skips errors */
    uint8_t tabtok;  /* the table token is written (rename) */
    uint8_t first;   /* lookup through first(...) */
    uint8_t sheettok;
    int bin;
    uint16_t nargs;
    int32_t tab, col;
    uint32_t node;
    uint32_t lo, hi;   /* primary token (table / name / whole) */
    uint32_t lo2, hi2; /* member token (column / name after a sheet) */
    uint32_t slo, shi; /* the whole node's source (calls, postfix chains) */
    const char *id;
    uint32_t idn;
    const char *id2;
    uint32_t id2n;
    WVal v;
    Ex *a, *b, *c;
    Ex **args;
    Ex *where;
};

static Ex *ex_new(Lex *L, int op, uint32_t lo, uint32_t hi) {
    Ex *e = (Ex *)wb_ma(L->wb, sizeof(Ex));
    if (!e) {
        lx_fail(L, "out of memory", lo);
        return NULL;
    }
    e->op = (uint8_t)op;
    e->lo = lo;
    e->hi = hi;
    e->slo = lo;
    e->shi = hi;
    e->tab = -1;
    e->col = -1;
    return e;
}

/* The identifier's name bytes (backticks stripped). */
static void tok_name(const Lex *L, const Tok *t, const char **s, uint32_t *n) {
    *s = L->s + t->lo + t->bq;
    *n = t->hi - t->lo - 2u * t->bq;
}

static Ex *p_expr(Lex *L);

/* `group T by k { name: agg, ... }` (after the `group` token). */
static Ex *p_group(Lex *L, uint32_t lo) {
    Ex *e = ex_new(L, EX_GROUP, lo, lo);
    uint32_t cap = 4;
    if (!e) return NULL;
    if (L->t.k != TK_ID) {
        lx_fail(L, "group: expected a table", L->t.lo);
        return NULL;
    }
    e->lo = L->t.lo;
    e->hi = L->t.hi;
    tok_name(L, &L->t, &e->id, &e->idn);
    lx_next(L);
    if (!lx_kw(L, "by")) {
        lx_fail(L, "group: expected by", L->t.lo);
        return NULL;
    }
    lx_next(L);
    e->a = p_expr(L);
    if (!e->a) return NULL;
    if (!lx_op(L, '{')) {
        lx_fail(L, "group: expected {", L->t.lo);
        return NULL;
    }
    lx_next(L);
    e->args = (Ex **)wb_ma(L->wb, cap * sizeof(Ex *));
    if (!e->args) {
        lx_fail(L, "out of memory", lo);
        return NULL;
    }
    for (;;) {
        Tok nt = L->t;
        Ex *o;
        if (nt.k != TK_ID) {
            lx_fail(L, "group: expected an output name", nt.lo);
            return NULL;
        }
        lx_next(L);
        if (!lx_op(L, ':')) {
            lx_fail(L, "group: expected : after the output name", L->t.lo);
            return NULL;
        }
        lx_next(L);
        o = p_expr(L);
        if (!o) return NULL;
        tok_name(L, &nt, &o->id2, &o->id2n);
        o->lo2 = nt.lo;
        o->hi2 = nt.hi;
        if (e->nargs >= cap) {
            Ex **na = (Ex **)wb_ma(L->wb, cap * 2 * sizeof(Ex *));
            if (!na) {
                lx_fail(L, "out of memory", lo);
                return NULL;
            }
            memcpy(na, e->args, cap * sizeof(Ex *));
            e->args = na;
            cap *= 2;
        }
        e->args[e->nargs++] = o;
        if (lx_op(L, ',')) {
            lx_next(L);
            continue;
        }
        if (lx_op(L, '}')) {
            lx_next(L);
            return e;
        }
        lx_fail(L, "group: expected , or }", L->t.lo);
        return NULL;
    }
}

static Ex *p_primary(Lex *L) {
    Tok t = L->t;
    Ex *e;
    if (t.k == TK_BAD) return NULL;
    if (t.k == TK_ANC) {
        /* #name alone: a range end (T[#a .. #b]) */
        e = ex_new(L, EX_ANC, t.lo, t.hi);
        if (!e) return NULL;
        e->lo2 = t.lo;
        e->hi2 = t.hi;
        e->id2 = L->s + t.lo + 1 + t.bq;
        e->id2n = t.hi - t.lo - 1 - 2u * t.bq;
        lx_next(L);
        return e;
    }
    if (t.k == TK_NUM && t.minmag) {
        lx_fail(L, "number out of range", t.lo);
        return NULL;
    }
    if (t.k == TK_NUM || t.k == TK_STR || t.k == TK_DATE || t.k == TK_DUR) {
        e = ex_new(L, EX_LIT, t.lo, t.hi);
        if (!e) return NULL;
        e->v = t.v;
        lx_next(L);
        return e;
    }
    if (lx_op(L, '(')) {
        lx_next(L);
        e = p_expr(L);
        if (!e) return NULL;
        if (!lx_op(L, ')')) {
            lx_fail(L, "expected )", L->t.lo);
            return NULL;
        }
        lx_next(L);
        return e;
    }
    if (lx_op(L, '@')) {
        uint32_t lo = t.lo;
        lx_next(L);
        if (L->t.k != TK_ID) {
            lx_fail(L, "expected a column after @", L->t.lo);
            return NULL;
        }
        e = ex_new(L, EX_AT, lo, L->t.hi);
        if (!e) return NULL;
        e->lo2 = L->t.lo;
        e->hi2 = L->t.hi;
        tok_name(L, &L->t, &e->id2, &e->id2n);
        lx_next(L);
        return e;
    }
    if (t.k == TK_ID) {
        const char *s;
        uint32_t n;
        tok_name(L, &t, &s, &n);
        if (!t.bq) {
            if (lx_kw(L, "true") || lx_kw(L, "false")) {
                e = ex_new(L, EX_LIT, t.lo, t.hi);
                if (!e) return NULL;
                e->v = wv_bool(lx_kw(L, "true"));
                lx_next(L);
                return e;
            }
            if (lx_kw(L, "null")) {
                e = ex_new(L, EX_LIT, t.lo, t.hi);
                if (!e) return NULL;
                lx_next(L);
                return e;
            }
            if (wb_is_kw(s, n) && !lx_if_call(L)) {
                lx_fail(L, "unexpected keyword", t.lo);
                return NULL;
            }
        }
        lx_next(L);
        if (!t.bq && L->t.k == TK_ID && n == 5 && !memcmp(s, "group", 5)) return p_group(L, t.lo);
        if (!t.bq && L->t.k == TK_ID &&
            ((n == 4 && !memcmp(s, "join", 4)) || (n == 4 && !memcmp(s, "sort", 4)) ||
             (n == 3 && !memcmp(s, "top", 3)))) {
            lx_fail(L, "join / sort / top are views (workbook W4)", t.lo);
            return NULL;
        }
        if (!t.bq && (lx_op(L, '(') || lx_op(L, '?'))) {
            uint32_t cap = 4;
            int q = 0;
            if (lx_op(L, '?')) {
                q = 1;
                lx_next(L);
                if (!lx_op(L, '(')) {
                    lx_fail(L, "expected ( after ?", L->t.lo);
                    return NULL;
                }
            }
            e = ex_new(L, EX_CALL, t.lo, t.hi);
            if (!e) return NULL;
            e->id = s;
            e->idn = n;
            e->q = (uint8_t)q;
            e->args = (Ex **)wb_ma(L->wb, cap * sizeof(Ex *));
            lx_next(L);
            if (lx_op(L, ')')) {
                e->shi = L->t.hi;
                lx_next(L);
                return e;
            }
            for (;;) {
                Ex *a = p_expr(L);
                if (!a) return NULL;
                if (e->nargs >= cap) {
                    Ex **na = (Ex **)wb_ma(L->wb, cap * 2 * sizeof(Ex *));
                    if (!na) {
                        lx_fail(L, "out of memory", t.lo);
                        return NULL;
                    }
                    memcpy(na, e->args, cap * sizeof(Ex *));
                    e->args = na;
                    cap *= 2;
                }
                e->args[e->nargs++] = a;
                if (lx_kw(L, "where")) {
                    lx_next(L);
                    e->where = p_expr(L);
                    if (!e->where) return NULL;
                    if (!lx_op(L, ')')) {
                        lx_fail(L, "expected ) after where", L->t.lo);
                        return NULL;
                    }
                }
                if (lx_op(L, ')')) {
                    e->shi = L->t.hi;
                    lx_next(L);
                    return e;
                }
                if (!lx_op(L, ',')) {
                    lx_fail(L, "expected , or )", L->t.lo);
                    return NULL;
                }
                lx_next(L);
            }
        }
        e = ex_new(L, EX_IDENT, t.lo, t.hi);
        if (!e) return NULL;
        e->id = s;
        e->idn = n;
        return e;
    }
    if (t.k == TK_END) lx_fail(L, "unexpected end", t.lo);
    else lx_fail(L, "unexpected token", t.lo);
    return NULL;
}

/* An anchor token's name (the `#` and backticks stripped). */
static void tok_anc(const Lex *L, const Tok *t, const char **s, uint32_t *n) {
    *s = L->s + t->lo + 1 + t->bq;
    *n = t->hi - t->lo - 1 - 2u * t->bq;
}

static Ex *p_post(Lex *L) {
    Ex *e = p_primary(L);
    while (e) {
        if (L->t.k == TK_ANC &&
            (e->op == EX_IDENT || (e->op == EX_DOT && e->a && e->a->op == EX_IDENT))) {
            /* T#name: a table's anchored row (alias.T#name: another workbook's) */
            Ex *x = ex_new(L, EX_TANC, e->lo, e->hi);
            if (!x) return NULL;
            x->a = e;
            x->slo = e->slo;
            x->shi = L->t.hi;
            x->lo2 = L->t.lo;
            x->hi2 = L->t.hi;
            tok_anc(L, &L->t, &x->id2, &x->id2n);
            lx_next(L);
            e = x;
            continue;
        }
        if (lx_op(L, '.')) {
            Ex *d;
            lx_next(L);
            if (L->t.k != TK_ID) {
                lx_fail(L, "expected a name after .", L->t.lo);
                return NULL;
            }
            d = ex_new(L, EX_DOT, e->lo, L->t.hi);
            if (!d) return NULL;
            d->a = e;
            d->slo = e->slo;
            d->lo2 = L->t.lo;
            d->hi2 = L->t.hi;
            tok_name(L, &L->t, &d->id2, &d->id2n);
            lx_next(L);
            e = d;
            continue;
        }
        if (lx_op(L, '[')) {
            Ex *x;
            lx_next(L);
            x = ex_new(L, EX_INDEX, e->lo, e->hi);
            if (!x) return NULL;
            x->a = e;
            x->slo = e->slo;
            x->b = p_expr(L);
            if (!x->b) return NULL;
            if (lx_op(L, OP_DOTDOT)) {
                /* T[#a .. #b]: an anchor range */
                lx_next(L);
                x->c = p_expr(L);
                if (!x->c) return NULL;
                x->range = 1;
            }
            if (!lx_op(L, ']')) {
                lx_fail(L, "expected ]", L->t.lo);
                return NULL;
            }
            x->hi = L->t.hi;
            x->shi = L->t.hi;
            lx_next(L);
            e = x;
            continue;
        }
        break;
    }
    return e;
}

static Ex *p_unary(Lex *L) {
    if (lx_op(L, '-') || lx_op(L, '+')) {
        uint32_t lo = L->t.lo;
        int neg = lx_op(L, '-');
        Ex *e, *a;
        lx_next(L);
        if (neg && L->t.k == TK_NUM && L->t.minmag) {
            /* -9223372036854775808: the literal is INT64_MIN itself */
            e = ex_new(L, EX_LIT, lo, L->t.hi);
            if (!e) return NULL;
            e->v = L->t.v;
            lx_next(L);
            return e;
        }
        a = p_unary(L);
        if (!a || !neg) return a;
        e = ex_new(L, EX_UN, lo, a->hi);
        if (!e) return NULL;
        e->bin = '-';
        e->a = a;
        return e;
    }
    return p_post(L);
}

static Ex *p_binop(Lex *L, Ex *a, int op, Ex *(*rhs)(Lex *)) {
    Ex *e, *b;
    lx_next(L);
    b = rhs(L);
    if (!b) return NULL;
    e = ex_new(L, EX_BIN, a->lo, b->hi);
    if (!e) return NULL;
    e->bin = op;
    e->a = a;
    e->b = b;
    return e;
}

static Ex *p_mul(Lex *L) {
    Ex *e = p_unary(L);
    while (e && (lx_op(L, '*') || lx_op(L, '/') || lx_op(L, '%')))
        e = p_binop(L, e, L->t.op, p_unary);
    return e;
}

static Ex *p_add(Lex *L) {
    Ex *e = p_mul(L);
    while (e && (lx_op(L, '+') || lx_op(L, '-'))) e = p_binop(L, e, L->t.op, p_mul);
    return e;
}

static Ex *p_cat(Lex *L) {
    Ex *e = p_add(L);
    while (e && lx_op(L, '&')) e = p_binop(L, e, '&', p_add);
    return e;
}

static Ex *p_cmp(Lex *L) {
    Ex *e = p_cat(L);
    if (e && (lx_op(L, '=') || lx_op(L, OP_NE) || lx_op(L, '<') || lx_op(L, OP_LE) ||
              lx_op(L, '>') || lx_op(L, OP_GE)))
        e = p_binop(L, e, L->t.op, p_cat);
    return e;
}

static Ex *p_not(Lex *L) {
    if (lx_kw(L, "not")) {
        uint32_t lo = L->t.lo;
        Ex *e, *a;
        lx_next(L);
        a = p_not(L);
        if (!a) return NULL;
        e = ex_new(L, EX_UN, lo, a->hi);
        if (!e) return NULL;
        e->bin = '!';
        e->a = a;
        return e;
    }
    return p_cmp(L);
}

static Ex *p_and(Lex *L) {
    Ex *e = p_not(L);
    while (e && lx_kw(L, "and")) e = p_binop(L, e, 'a', p_not);
    return e;
}

static Ex *p_or(Lex *L) {
    Ex *e = p_and(L);
    while (e && lx_kw(L, "or")) e = p_binop(L, e, 'o', p_and);
    return e;
}

static Ex *p_expr(Lex *L) {
    if (lx_kw(L, "if") && !lx_if_call(L)) {
        uint32_t lo = L->t.lo;
        Ex *e;
        lx_next(L);
        e = ex_new(L, EX_IF, lo, lo);
        if (!e) return NULL;
        e->a = p_expr(L);
        if (!e->a) return NULL;
        if (!lx_kw(L, "then")) {
            lx_fail(L, "expected then", L->t.lo);
            return NULL;
        }
        lx_next(L);
        e->b = p_expr(L);
        if (!e->b) return NULL;
        if (!lx_kw(L, "else")) {
            lx_fail(L, "expected else", L->t.lo);
            return NULL;
        }
        lx_next(L);
        e->c = p_expr(L);
        if (!e->c) return NULL;
        e->hi = e->c->hi;
        return e;
    }
    return p_or(L);
}

/* Parse `s` (a formula without its `=`). A syntax error is an EX_ERR root
 * holding #parse(message at column). */
static Ex *wb_parse(RtxWb *wb, const char *s, uint32_t n) {
    Lex L;
    Ex *e;
    memset(&L, 0, sizeof L);
    L.wb = wb;
    L.s = s;
    L.n = n;
    lx_next(&L);
    e = p_expr(&L);
    if (e && !L.err && L.t.k != TK_END) lx_fail(&L, "unexpected text after the formula", L.t.lo);
    if (!e || L.err) {
        Ex *x = (Ex *)wb_ma(wb, sizeof(Ex));
        if (!x) return NULL;
        x->op = EX_ERR;
        x->lo = 0;
        x->hi = n;
        x->v = wv_err_a(wb->ma, WE_PARSE, "%s at column %u", L.err ? L.err : "syntax error",
                      (unsigned)L.err_at + 1);
        return x;
    }
    return e;
}

/* ------------------------------------------------------- literal typing */

static int wb_lit_kind(const char *s, size_t n, int *sc) {
    int64_t iv;
    double fv;
    int k;
    *sc = 0;
    if (!n) return LK_EMPTY;
    if ((n == 4 && !memcmp(s, "true", 4)) || (n == 5 && !memcmp(s, "false", 5)))
        return LK_BOOL;
    if (n == 10 && wb_parse_date(s, n, &iv)) return LK_DATE;
    k = wb_parse_num(s, n, &iv, sc, &fv);
    if (k == 1) return LK_INT;
    if (k == 2) return LK_DEC;
    if (k == 3) return LK_FLOAT;
    *sc = 0;
    return LK_TEXT;
}

static void wb_cs_add(WColStat *cs, int lk, int sc, int dir) {
    if (!cs || lk <= LK_EMPTY || lk > LK_FORMULA) return; /* formulas counted, not typed */
    cs->k[lk] = (uint32_t)((int)cs->k[lk] + dir);
    if (lk == LK_DEC && sc >= 0 && sc < 19) cs->sc[sc] = (uint32_t)((int)cs->sc[sc] + dir);
}

/* int ⊂ dec ⊂ float ⊂ text; a column mixing numbers, dates and bools is text. */
static void wb_col_type(const WColStat *s, uint8_t *t, uint8_t *sc) {
    int num = s->k[LK_INT] + s->k[LK_DEC] + s->k[LK_FLOAT] > 0;
    int classes = num + (s->k[LK_BOOL] > 0) + (s->k[LK_DATE] > 0);
    int i;
    *sc = 0;
    if (s->k[LK_TEXT] || classes > 1) *t = WV_TEXT;
    else if (num && s->k[LK_FLOAT]) *t = WV_FLOAT;
    else if (num && s->k[LK_DEC]) {
        *t = WV_DEC;
        for (i = 18; i > 0; i--)
            if (s->sc[i]) {
                *sc = (uint8_t)i;
                break;
            }
    } else if (num) *t = WV_INT;
    else if (s->k[LK_BOOL]) *t = WV_BOOL;
    else if (s->k[LK_DATE]) *t = WV_DATE;
    else *t = WV_TEXT;
}

/* A literal cell's value under its column's type; `s` is the trimmed,
 * unescaped cell text (text values point into it). */
static WVal wb_lit_value(CCArena a, const char *s, uint32_t n, int lk, int ct, int csc) {
    int64_t iv = 0;
    int sc = 0;
    double fv = 0;
    int k;
    WVal v;
    if (lk == LK_EMPTY) return wv_null();
    switch (ct) {
    case WV_INT:
    case WV_DEC:
        k = wb_parse_num(s, n, &iv, &sc, &fv);
        if (k != 1 && k != 2) break;
        if (csc > sc) {
            __int128 x = (__int128)iv * g_pow10[csc - sc];
            if (x > INT64_MAX || x < INT64_MIN)
                return wv_err_a(a, WE_NUM, "%.*s does not fit dec(%d)", (int)n, s, csc);
            iv = (int64_t)x;
        }
        return wv_dec(iv, csc);
    case WV_FLOAT:
        k = wb_parse_num(s, n, &iv, &sc, &fv);
        if (k == 3) return wv_float(fv);
        if (k == 1 || k == 2) return wv_float((double)iv / (double)g_pow10[sc]);
        break;
    case WV_BOOL:
        return wv_bool(n == 4);
    case WV_DATE:
        if (wb_parse_date(s, n, &iv)) return wv_date(iv);
        break;
    default:
        break;
    }
    (void)a;
    v = wv_null();
    v.t = WV_TEXT;
    v.u.s = s;
    v.n = n;
    return v;
}

/* ---- keys */

static uint64_t wk_mix(uint64_t h, uint64_t x) {
    h ^= x + 0x9E3779B97F4A7C15ull + (h << 6) + (h >> 2);
    return h * 1099511628211ull;
}

static void wb_key_of(const WVal *v, WKey *k) {
    memset(k, 0, sizeof *k);
    switch (v->t) {
    case WV_INT:
    case WV_DEC: {
        int64_t i = v->u.i;
        int sc = v->t == WV_DEC ? v->sc : 0;
        while (sc > 0 && i % 10 == 0) {
            i /= 10;
            sc--;
        }
        k->t = KY_NUM;
        k->i = i;
        k->sc = (uint8_t)sc;
        break;
    }
    case WV_FLOAT: {
        double f = v->u.f;
        uint64_t bits, m;
        int ex, e2, tz;
        if (f != f) {
            k->t = KY_NAN;
            break;
        }
        if (f == 0) {
            k->t = KY_NUM;
            break;
        }
        memcpy(&bits, &f, sizeof bits);
        ex = (int)((bits >> 52) & 0x7ff);
        k->t = KY_FLT;
        k->i = (int64_t)bits;
        if (ex == 0x7ff) break;
        m = bits & ((1ull << 52) - 1);
        if (ex) {
            m |= 1ull << 52;
            e2 = ex - 1075;
        } else {
            e2 = -1074;
        }
        tz = __builtin_ctzll(m);
        m >>= tz;
        e2 += tz;
        if (e2 >= 0) {
            if (e2 < 62 && (m >> (62 - e2)) == 0) {
                k->t = KY_NUM;
                k->i = (int64_t)(m << e2);
                if (bits >> 63) k->i = -k->i;
                k->sc = 0;
            }
        } else if (-e2 <= 18) {
            unsigned __int128 x = m;
            int s = -e2, j;
            for (j = 0; j < s; j++) x *= 5u;
            if (x <= (unsigned __int128)INT64_MAX) {
                k->t = KY_NUM;
                k->i = (int64_t)x;
                if (bits >> 63) k->i = -k->i;
                k->sc = (uint8_t)s;
            }
        }
        break;
    }
    case WV_TEXT:
        k->t = KY_TEXT;
        k->s = v->u.s;
        k->n = v->n;
        break;
    case WV_DATE:
        k->t = KY_DATE;
        k->i = v->u.i;
        break;
    case WV_BOOL:
        k->t = KY_BOOL;
        k->i = v->u.i;
        break;
    default:
        k->t = KY_NULL;
        break;
    }
    {
        uint64_t h = 1469598103934665603ull ^ k->t;
        if (k->t == KY_TEXT) {
            uint32_t j;
            for (j = 0; j < k->n; j++) h = (h ^ (unsigned char)k->s[j]) * 1099511628211ull;
        } else {
            h = wk_mix(h, (uint64_t)k->i);
            h = wk_mix(h, k->sc);
        }
        k->h = h ? h : 1;
    }
}

static int wb_key_eq(const WKey *a, const WKey *b) {
    if (a->h != b->h || a->t != b->t) return 0;
    if (a->t == KY_TEXT) return a->n == b->n && (!a->n || !memcmp(a->s, b->s, a->n));
    return a->i == b->i && a->sc == b->sc;
}

/* The key as a value (canonical: 2.50 shows as 2.5). */
static WVal wb_key_val(const WKey *k) {
    WVal v = wv_null();
    switch (k->t) {
    case KY_NUM:
        return wv_dec(k->i, k->sc);
    case KY_FLT: {
        double f;
        uint64_t b = (uint64_t)k->i;
        memcpy(&f, &b, sizeof f);
        return wv_float(f);
    }
    case KY_NAN: {
        double f;
        uint64_t b = 0x7ff8000000000000ull;
        memcpy(&f, &b, sizeof f);
        return wv_float(f);
    }
    case KY_TEXT:
        v.t = WV_TEXT;
        v.u.s = k->s;
        v.n = k->n;
        return v;
    case KY_DATE:
        return wv_date(k->i);
    case KY_BOOL:
        return wv_bool((int)k->i);
    default:
        return v;
    }
}

/* ---- exact value order (min / max, group listing) */

static int wb_vclass(const WVal *v) {
    switch (v->t) {
    case WV_INT:
    case WV_DEC:
    case WV_FLOAT:
        return 0;
    case WV_TEXT:
        return 1;
    case WV_DATE:
        return 2;
    default:
        return 3;
    }
}

/* Class, then value: numbers exactly (a dec against a float too), text
 * by bytes. NaN never reaches it. */
static int wb_vcmp(const WVal *a, const WVal *b) {
    int ca = wb_vclass(a), cb = wb_vclass(b);
    if (ca != cb) return ca < cb ? -1 : 1;
    if (ca == 0) {
        if (a->t == WV_FLOAT && b->t == WV_FLOAT) return a->u.f < b->u.f ? -1 : a->u.f > b->u.f;
        if (a->t == WV_FLOAT) return -rtx_num_cmp_dec_f(b->u.i, b->t == WV_DEC ? b->sc : 0, a->u.f);
        if (b->t == WV_FLOAT) return rtx_num_cmp_dec_f(a->u.i, a->t == WV_DEC ? a->sc : 0, b->u.f);
        {
            int sa = a->t == WV_DEC ? a->sc : 0, sb = b->t == WV_DEC ? b->sc : 0;
            int s = sa > sb ? sa : sb;
            __int128 x = (__int128)a->u.i * g_pow10[s - sa];
            __int128 y = (__int128)b->u.i * g_pow10[s - sb];
            return x < y ? -1 : x > y;
        }
    }
    if (ca == 1) {
        size_t m = a->n < b->n ? a->n : b->n;
        int r = m ? memcmp(a->u.s, b->u.s, m) : 0;
        if (r) return r < 0 ? -1 : 1;
        return a->n < b->n ? -1 : a->n > b->n;
    }
    return a->u.i < b->u.i ? -1 : a->u.i > b->u.i;
}

static int wb_key_cmp(const WKey *a, const WKey *b) {
    WVal x = wb_key_val(a), y = wb_key_val(b);
    if (a->t == KY_NULL || b->t == KY_NULL) return (a->t != KY_NULL) - (b->t != KY_NULL);
    if (a->t == KY_NAN || b->t == KY_NAN) return (a->t == KY_NAN) - (b->t == KY_NAN);
    {
        int r = wb_vcmp(&x, &y);
        if (r) return r;
    }
    return a->t < b->t ? -1 : a->t > b->t;
}

static int wv_isnan(const WVal *v) {
    return v->t == WV_FLOAT && v->u.f != v->u.f;
}

/* ---- distinct: per-value counts */

static WDEnt *wd_find(WDMap *m, const WKey *k) {
    uint32_t i;
    if (!m->cap) return NULL;
    i = (uint32_t)k->h & (m->cap - 1);
    while (m->e[i].used) {
        if (wb_key_eq(&m->e[i].k, k)) return &m->e[i];
        i = (i + 1) & (m->cap - 1);
    }
    return &m->e[i];
}

static int wd_grow(WDMap *m) {
    uint32_t nc = m->cap ? m->cap * 2 : 16, i;
    WDEnt *old = m->e, *ne;
    uint32_t oc = m->cap;
    ne = (WDEnt *)wb_alloc(m->ar, (size_t)nc * sizeof(WDEnt));
    if (!ne) return 0;
    m->e = ne;
    m->cap = nc;
    m->used = 0;
    for (i = 0; i < oc; i++) {
        WDEnt *s;
        if (!old[i].used || !old[i].cnt) continue;
        s = wd_find(m, &old[i].k);
        *s = old[i];
        m->used++;
    }
    return 1;
}

static void wd_add(WDMap *m, const WVal *v, int sign) {
    WKey k;
    WDEnt *e;
    wb_key_of(v, &k);
    if ((m->used + 1) * 4 >= m->cap * 3 && !wd_grow(m)) return;
    e = wd_find(m, &k);
    if (!e) return;
    if (!e->used) {
        if (sign < 0) return;
        e->used = 1;
        e->k = k;
        if (k.t == KY_TEXT && k.n) {
            char *p = (char *)cc_arena_alloc(m->ar, k.n, 1);
            if (p) memcpy(p, k.s, k.n);
            e->k.s = p ? p : "";
        }
        e->cnt = 0;
        m->used++;
    }
    if (sign > 0) {
        if (e->cnt++ == 0) m->live++;
    } else if (e->cnt) {
        if (--e->cnt == 0) m->live--;
    }
}

/* ---- the partial */

static void acc_reset(WAcc *a) {
    RtxXs *fx = a->fx;
    WDMap *dm = a->dm;
    memset(a, 0, sizeof *a);
    a->fx = fx;
    a->dm = dm;
    if (fx) rtx_xs_zero(fx);
    if (dm) {
        dm->e = NULL;
        dm->cap = dm->used = dm->live = 0;
    }
}

/* Storage the output's kind needs (sum / avg: the float sum; distinct: a
 * map), from `ar`. 0 on out of memory. */
static int acc_need(WAcc *a, const WOut *o, CCArena ar) {
    if ((o->fn == FN_SUM || o->fn == FN_AVG) && !a->fx) {
        a->fx = (RtxXs *)wb_alloc(ar, sizeof(RtxXs));
        if (!a->fx) return 0;
    }
    if (o->fn == FN_DISTINCT && !a->dm) {
        a->dm = (WDMap *)wb_alloc(ar, sizeof(WDMap));
        if (!a->dm) return 0;
        a->dm->ar = ar;
    }
    return 1;
}

static void acc_apply(WAcc *a, const WOut *o, const WCon *k, int sign) {
    const WVal *v = &k->v;
    if (k->k == CN_STOP) {
        a->stop += (uint32_t)sign;
        return;
    }
    if (k->k != CN_VAL) return;
    a->cnt += (uint32_t)sign;
    if (o->crow) return;
    switch (o->fn) {
    case FN_SUM:
    case FN_AVG:
        if (v->t == WV_FLOAT) {
            double f = v->u.f;
            a->nflt += (uint32_t)sign;
            if (f != f) a->nnan += (uint32_t)sign;
            else if (f == 1.0 / 0.0) a->npinf += (uint32_t)sign;
            else if (f == -1.0 / 0.0) a->nninf += (uint32_t)sign;
            else if (a->fx) rtx_xs_add(a->fx, f, sign);
        } else {
            int sc = v->t == WV_DEC ? v->sc : 0;
            a->nsc[sc] += (uint32_t)sign;
            a->isum[sc] += sign < 0 ? -(__int128)v->u.i : (__int128)v->u.i;
        }
        break;
    case FN_MIN:
    case FN_MAX:
        a->ncls[wb_vclass(v)] += (uint32_t)sign;
        if (wv_isnan(v)) a->nnan += (uint32_t)sign;
        break;
    case FN_DISTINCT:
        if (a->dm) wd_add(a->dm, v, sign);
        break;
    case FN_ANY:
    case FN_ALL:
        if (v->u.i) a->nt += (uint32_t)sign;
        else a->nf += (uint32_t)sign;
        break;
    default:
        break;
    }
}

static WVal wv_nan(void) {
    double f;
    uint64_t b = 0x7ff8000000000000ull;
    memcpy(&f, &b, sizeof f);
    return wv_float(f);
}

/* dst += sign * src: every count and exact sum (the invertible parts). */
static void acc_merge(WAcc *d, const WAcc *s, int sign) {
    int i;
    d->cnt += (uint32_t)((int)s->cnt * sign);
    d->stop += (uint32_t)((int)s->stop * sign);
    for (i = 0; i < 19; i++) {
        d->nsc[i] += (uint32_t)((int)s->nsc[i] * sign);
        d->isum[i] += sign < 0 ? -s->isum[i] : s->isum[i];
    }
    d->nflt += (uint32_t)((int)s->nflt * sign);
    d->nnan += (uint32_t)((int)s->nnan * sign);
    d->npinf += (uint32_t)((int)s->npinf * sign);
    d->nninf += (uint32_t)((int)s->nninf * sign);
    for (i = 0; i < 4; i++) d->ncls[i] += (uint32_t)((int)s->ncls[i] * sign);
    d->nt += (uint32_t)((int)s->nt * sign);
    d->nf += (uint32_t)((int)s->nf * sign);
    if (s->fx && d->fx) rtx_xs_merge(d->fx, s->fx, sign);
    if (s->dm && d->dm) {
        uint32_t j;
        for (j = 0; j < s->dm->cap; j++) {
            const WDEnt *e = &s->dm->e[j];
            uint32_t c;
            WVal kv;
            if (!e->used || !e->cnt) continue;
            kv = wb_key_val(&e->k);
            for (c = 0; c < e->cnt; c++) wd_add(d->dm, &kv, sign);
        }
    }
}


/* ------------------------------------------------------------ the tables
 *
 * The position index: blocks with stable ids in a position order; per
 * block its rows' offsets / lengths / ids. Row r is found by a binary
 * search over the blocks' first rows (bfirst), a row id by its location.
 */

static int blk_reserve(WBlock *b, uint32_t need) {
    uint32_t nc;
    if (need <= b->cap) return 1;
    nc = b->cap ? b->cap * 2 : WB_BLK;
    while (nc < need) nc *= 2;
    {
        uint32_t *a = (uint32_t *)realloc(b->rrel, (size_t)nc * sizeof(uint32_t));
        if (!a) return 0;
        b->rrel = a;
        a = (uint32_t *)realloc(b->rlen, (size_t)nc * sizeof(uint32_t));
        if (!a) return 0;
        b->rlen = a;
        a = (uint32_t *)realloc(b->rid, (size_t)nc * sizeof(uint32_t));
        if (!a) return 0;
        b->rid = a;
    }
    b->cap = nc;
    return 1;
}

/* A new (or recycled) block id, empty. */
static uint32_t tb_blk_new(WTab *t) {
    uint32_t bid;
    if (t->nfree) {
        bid = t->bfree[--t->nfree];
    } else {
        if (!wb_hgrow((void **)&t->blk, &t->bidcap, t->nbid + 1, sizeof(WBlock))) return WN32;
        bid = t->nbid++;
    }
    t->blk[bid].n = 0;
    t->blk[bid].lo = 0;
    t->blk[bid].pos = WN32;
    t->blk[bid].live = 1;
    if (!blk_reserve(&t->blk[bid], 16)) return WN32;
    return bid;
}

static void tb_blk_free(WTab *t, uint32_t bid) {
    t->blk[bid].live = 0;
    t->blk[bid].n = 0;
    if (wb_hgrow((void **)&t->bfree, &t->freecap, t->nfree + 1, sizeof(uint32_t)))
        t->bfree[t->nfree++] = bid;
}

/* Positions and first rows from block position k0 on. */
static void tb_reindex(WTab *t, uint32_t k0) {
    uint32_t k, at = k0 ? t->bfirst[k0 - 1] + t->blk[t->bord[k0 - 1]].n : 0;
    for (k = k0; k < t->nb; k++) {
        WBlock *b = &t->blk[t->bord[k]];
        b->pos = k;
        t->bfirst[k] = at;
        at += b->n;
    }
    t->nrows = at;
}

static int tb_bord_room(WTab *t, uint32_t need) {
    uint32_t c0 = t->bordcap;
    if (!wb_hgrow((void **)&t->bord, &t->bordcap, need, sizeof(uint32_t))) return 0;
    if (t->bordcap != c0) {
        uint32_t c1 = c0;
        if (!wb_hgrow((void **)&t->bfirst, &c1, t->bordcap, sizeof(uint32_t))) return 0;
    }
    return 1;
}

/* Insert block id `bid` at position k (positions after it move). */
static int tb_bord_ins(WTab *t, uint32_t k, uint32_t bid) {
    if (!tb_bord_room(t, t->nb + 1)) return 0;
    memmove(t->bord + k + 1, t->bord + k, (size_t)(t->nb - k) * sizeof(uint32_t));
    t->bord[k] = bid;
    t->nb++;
    return 1;
}

static void tb_bord_del(WTab *t, uint32_t k) {
    memmove(t->bord + k, t->bord + k + 1, (size_t)(t->nb - k - 1) * sizeof(uint32_t));
    t->nb--;
}

static int tb_rid_room(WTab *t, uint32_t need) {
    return wb_hgrow((void **)&t->rloc, &t->ridcap, need, sizeof(WRloc));
}

/* Row r's block position (binary search over first rows). */
static uint32_t tb_bpos(const WTab *t, uint32_t r) {
    uint32_t lo = 0, hi = t->nb;
    while (lo < hi) {
        uint32_t mid = lo + (hi - lo) / 2;
        if (t->bfirst[mid] <= r) lo = mid + 1;
        else hi = mid;
    }
    return lo ? lo - 1 : 0;
}

static const WBlock *tb_blk_of(const WTab *t, uint32_t r, uint32_t *slot) {
    uint32_t k = tb_bpos(t, r);
    const WBlock *b = &t->blk[t->bord[k]];
    *slot = r - t->bfirst[k];
    return b;
}

static size_t tb_row_lo(const WTab *t, uint32_t r) {
    uint32_t s;
    const WBlock *b = tb_blk_of(t, r, &s);
    return b->lo + b->rrel[s];
}

static uint32_t tb_row_len(const WTab *t, uint32_t r) {
    uint32_t s;
    const WBlock *b = tb_blk_of(t, r, &s);
    return b->rlen[s];
}

static uint32_t tb_row_rid(const WTab *t, uint32_t r) {
    uint32_t s;
    const WBlock *b = tb_blk_of(t, r, &s);
    return b->rid[s];
}

/* A live row id's position, or -1. */
static int32_t tb_rid_pos(const WTab *t, uint32_t rid) {
    const WRloc *l;
    if (rid >= t->nrid) return -1;
    l = &t->rloc[rid];
    if (l->bid == WN32 || l->bid >= t->nbid || !t->blk[l->bid].live) return -1;
    return (int32_t)(t->bfirst[t->blk[l->bid].pos] + l->slot);
}

/* Last row starting at or before `off`; -1 before the first. */
static int32_t tb_row_at(const WTab *t, size_t off) {
    uint32_t lo = 0, hi = t->nb, k;
    const WBlock *b;
    int32_t a, e;
    if (!t->nb || !t->nrows) return -1;
    while (lo < hi) {
        uint32_t mid = lo + (hi - lo) / 2;
        const WBlock *m = &t->blk[t->bord[mid]];
        if (m->n && m->lo <= off) lo = mid + 1;
        else if (!m->n && mid + 1 < t->nb && t->blk[t->bord[mid + 1]].lo <= off) lo = mid + 1;
        else hi = mid;
    }
    if (!lo) return -1;
    k = lo - 1;
    while (k > 0 && !t->blk[t->bord[k]].n) k--;
    b = &t->blk[t->bord[k]];
    if (!b->n) return -1;
    a = 0;
    e = (int32_t)b->n;
    while (a < e) {
        int32_t mid = a + (e - a) / 2;
        if (b->lo + b->rrel[mid] <= off) a = mid + 1;
        else e = mid;
    }
    if (!a) return -1;
    return (int32_t)(t->bfirst[k] + (uint32_t)(a - 1));
}

/* ------------------------------------------------------------- row bytes */

/* The bytes of row r of t (no NL) into the scratch arena; *n its length. */
static const char *wb_row_read(RtxWb *wb, const WTab *t, uint32_t r, uint32_t *n) {
    size_t lo = tb_row_lo(t, r);
    uint32_t len = tb_row_len(t, r);
    char *p = (char *)cc_arena_alloc(wb->sa, (size_t)len + 1, 1);
    if (!p) {
        *n = 0;
        return "";
    }
    if (wb_read(wb_tab_doc(wb, t), lo, p, len) != len) len = 0;
    p[len] = 0;
    *n = len;
    return p;
}

/* `{#name}` at the start of a first cell's trimmed text [lo, hi): the
 * name's span (backticks stripped) and the mark's end (its blanks too). */
static int wb_anchor_def(const char *s, size_t lo, size_t hi, size_t *nlo, size_t *nhi,
                         size_t *mend) {
    size_t i = lo, j;
    if (hi - lo < 4 || s[i] != '{' || s[i + 1] != '#') return 0;
    i += 2;
    if (i < hi && s[i] == '`') {
        j = i + 1;
        while (j < hi && s[j] != '`' && s[j] != '}') j++;
        if (j >= hi || s[j] != '`' || j == i + 1) return 0;
        *nlo = i + 1;
        *nhi = j;
        j++;
    } else {
        if (i >= hi || !wb_id0(s[i])) return 0;
        j = i + 1;
        while (j < hi && wb_id1(s[j])) j++;
        *nlo = i;
        *nhi = j;
    }
    if (j >= hi || s[j] != '}') return 0;
    j++;
    while (j < hi && wb_ws(s[j])) j++;
    *mend = j;
    return 1;
}

/* Split a row: its cells (raw spans between pipes) and its anchor. */
static void wb_row_split(WRow *r) {
    RtxMdCell cells[RTX_WB_COLS_MAX];
    size_t nc = rtx_md_row_split(r->b, r->n, cells, RTX_WB_COLS_MAX), c;
    if (nc > RTX_WB_COLS_MAX) nc = RTX_WB_COLS_MAX;
    r->nc = (uint8_t)nc;
    for (c = 0; c < nc; c++) {
        r->clo[c] = (uint32_t)cells[c].lo;
        r->chi[c] = (uint32_t)cells[c].hi;
    }
    r->alo = r->ahi = r->mlo = r->mhi = 0;
    if (nc) {
        size_t lo = r->clo[0], hi = r->chi[0], nlo, nhi, mend;
        wb_trim(r->b, &lo, &hi);
        if (wb_anchor_def(r->b, lo, hi, &nlo, &nhi, &mend)) {
            r->alo = (uint32_t)nlo;
            r->ahi = (uint32_t)nhi;
            r->mlo = (uint32_t)lo;
            r->mhi = (uint32_t)mend;
        }
    }
    memset(r->st, 0, sizeof r->st);
    memset(r->stl, 0, sizeof r->stl);
}

/* Cell c's trimmed text [lo, hi) (the first cell after its anchor). 0 when
 * the row has no such cell. */
static int wb_cell_span(const WRow *r, int c, size_t *lo, size_t *hi) {
    if (c < 0 || c >= r->nc) return 0;
    *lo = r->clo[c];
    *hi = r->chi[c];
    if (c == 0 && r->mhi > r->mlo) *lo = r->mhi;
    wb_trim(r->b, lo, hi);
    return 1;
}

/* A cell's formula (`=f` or `` `=f` ``): the source span after `=` and the
 * painted span. 0: a literal. */
static int wb_cell_formula(const char *s, size_t lo, size_t hi, size_t *slo, size_t *shi,
                           size_t *flo, size_t *fhi) {
    if (hi - lo >= 3 && s[lo] == '`' && s[lo + 1] == '=' && s[hi - 1] == '`') {
        *flo = lo;
        *fhi = hi;
        *slo = lo + 2;
        *shi = hi - 1;
        return 1;
    }
    if (hi > lo && s[lo] == '=') {
        *flo = lo;
        *fhi = hi;
        *slo = lo + 1;
        *shi = hi;
        return 1;
    }
    return 0;
}

/* A literal's text: `\|` is a pipe. Points into s when there is none. */
static const char *wb_lit_text(CCArena a, const char *s, size_t lo, size_t hi, uint32_t *n) {
    size_t i, k = 0;
    char *p;
    for (i = lo; i + 1 < hi; i++)
        if (s[i] == '\\' && s[i + 1] == '|') break;
    if (i + 1 >= hi) {
        *n = (uint32_t)(hi - lo);
        return s + lo;
    }
    p = (char *)cc_arena_alloc(a, hi - lo + 1, 1);
    if (!p) {
        *n = 0;
        return "";
    }
    for (i = lo; i < hi; i++) {
        if (s[i] == '\\' && i + 1 < hi && s[i + 1] == '|') continue;
        p[k++] = s[i];
    }
    p[k] = 0;
    *n = (uint32_t)k;
    return p;
}

/* The literal kind of a cell's text. */
static int wb_cell_kind_a(CCArena a, const char *s, size_t lo, size_t hi, int *sc) {
    uint32_t n;
    const char *p;
    size_t flo, fhi, slo, shi;
    *sc = 0;
    if (wb_cell_formula(s, lo, hi, &slo, &shi, &flo, &fhi)) return LK_FORMULA;
    p = wb_lit_text(a, s, lo, hi, &n);
    return wb_lit_kind(p, n, sc);
}

static int wb_cell_kind(RtxWb *wb, const char *s, size_t lo, size_t hi, int *sc) {
    return wb_cell_kind_a(wb->sa, s, lo, hi, sc);
}

/* ------------------------------------------------------------ key indexes */

static void kx_clear(WKx *x) {
    free(x->e);
    free(x->ov);
    x->e = NULL;
    x->ov = NULL;
    x->cap = x->used = x->nov = x->ovcap = 0;
    x->bad = 0;
    x->cls = 0;
    x->ok = 0;
    if (x->ar.base) x->ar.reset();
}

static void kx_free(WKx *x) {
    free(x->e);
    free(x->ov);
    x->e = NULL;
    x->ov = NULL;
    x->cap = x->used = x->nov = x->ovcap = 0;
    if (x->ar.base) x->ar.destroy();
    x->ar = (CCArena){0};
}

static WKxEnt *kx_slot(const WKx *x, const WKey *k) {
    uint32_t i;
    if (!x->cap) return NULL;
    i = (uint32_t)k->h & (x->cap - 1);
    while (x->e[i].used) {
        if (wb_key_eq(&x->e[i].k, k)) return &x->e[i];
        i = (i + 1) & (x->cap - 1);
    }
    return &x->e[i];
}

static WKxEnt *kx_get(const WKx *x, const WKey *k) {
    WKxEnt *e = kx_slot(x, k);
    return e && e->used ? e : NULL;
}

static int kx_grow(WKx *x) {
    uint32_t nc = x->cap ? x->cap * 2 : 64, oc = x->cap, i;
    WKxEnt *old = x->e, *ne = (WKxEnt *)calloc(nc, sizeof(WKxEnt));
    if (!ne) return 0;
    x->e = ne;
    x->cap = nc;
    x->used = 0;
    for (i = 0; i < oc; i++) {
        WKxEnt *s;
        if (!old[i].used || !old[i].cnt) continue;
        s = kx_slot(x, &old[i].k);
        *s = old[i];
        x->used++;
    }
    free(old);
    return 1;
}

/* Overflow list at `ov` index o: [n, cap, ids...]. */
static uint32_t *kx_ov(const WKx *x, uint32_t o) {
    return x->ov + o;
}

static int kx_ov_push(WKx *x, WKxEnt *e, uint32_t rid) {
    uint32_t o = e->more ? e->more - 1 : WN32, n, cap;
    if (o == WN32 || kx_ov(x, o)[0] == kx_ov(x, o)[1]) {
        /* a new chunk, twice as big; the old one is garbage */
        uint32_t ncap = o == WN32 ? 4 : kx_ov(x, o)[1] * 2, no = x->nov, k;
        if (!wb_hgrow((void **)&x->ov, &x->ovcap, x->nov + 2 + ncap, sizeof(uint32_t))) return 0;
        x->ov[no] = 0;
        x->ov[no + 1] = ncap;
        if (o != WN32) {
            n = x->ov[o];
            for (k = 0; k < n; k++) x->ov[no + 2 + k] = x->ov[o + 2 + k];
            x->ov[no] = n;
        }
        x->nov += 2 + ncap;
        e->more = no + 1;
        o = no;
    }
    n = x->ov[o];
    cap = x->ov[o + 1];
    (void)cap;
    x->ov[o + 2 + n] = rid;
    x->ov[o] = n + 1;
    return 1;
}

/* Room for n keys without a regrow (a restore knows its count). */
static void kx_reserve(WKx *x, uint32_t n) {
    uint32_t want = 64;
    while (want < (uint32_t)1 << 30 && (uint64_t)(n + 1) * 4 >= (uint64_t)want * 3) want *= 2;
    while (x->cap < want)
        if (!kx_grow(x)) return;
}

static void kx_add(WKx *x, const WKey *k, uint32_t rid) {
    WKxEnt *e;
    if ((x->used + 1) * 4 >= x->cap * 3 && !kx_grow(x)) return;
    e = kx_slot(x, k);
    if (!e) return;
    if (!e->used) {
        e->used = 1;
        e->k = *k;
        if (k->t == KY_TEXT && k->n) {
            char *p;
            if (!x->ar.base) x->ar = cc_arena_heap(64u << 10);
            p = x->ar.base ? (char *)cc_arena_alloc(x->ar, k->n, 1) : NULL;
            if (p) memcpy(p, k->s, k->n);
            e->k.s = p ? p : "";
        }
        e->cnt = 0;
        e->more = 0;
        x->used++;
    }
    if (e->cnt == 0) e->rid = rid;
    else kx_ov_push(x, e, rid);
    e->cnt++;
}

static void kx_del(WKx *x, const WKey *k, uint32_t rid) {
    WKxEnt *e = kx_get(x, k);
    uint32_t *ov, n, i;
    if (!e || !e->cnt) return;
    ov = e->more ? kx_ov(x, e->more - 1) : NULL;
    n = ov ? ov[0] : 0;
    if (e->rid == rid) {
        if (n) {
            e->rid = ov[2 + n - 1];
            ov[0] = n - 1;
        }
        e->cnt--;
        return;
    }
    for (i = 0; i < n; i++) {
        if (ov[2 + i] != rid) continue;
        ov[2 + i] = ov[2 + n - 1];
        ov[0] = n - 1;
        e->cnt--;
        return;
    }
}

/* The row ids holding key k: *n of them; ids[0] (and more via kx_more). */
static uint32_t kx_count(const WKx *x, const WKey *k, uint32_t *first) {
    const WKxEnt *e = kx_get(x, k);
    if (!e || !e->cnt) return 0;
    if (first) *first = e->rid;
    return e->cnt;
}

static uint32_t kx_ids(const WKx *x, const WKey *k, uint32_t *out, uint32_t cap) {
    const WKxEnt *e = kx_get(x, k);
    uint32_t n = 0, i;
    if (!e || !e->cnt) return 0;
    if (cap) out[n++] = e->rid;
    if (e->more) {
        const uint32_t *ov = kx_ov(x, e->more - 1);
        for (i = 0; i < ov[0] && n < cap; i++) out[n++] = ov[2 + i];
    }
    return e->cnt;
}

/* An anchor name's key. */
static void wb_anc_key(const char *s, uint32_t n, WKey *k) {
    WVal v = wv_null();
    v.t = WV_TEXT;
    v.u.s = s;
    v.n = n;
    wb_key_of(&v, k);
}

/* ------------------------------------------------------ table storage */

static void tb_free(WTab *t) {
    uint32_t i;
    for (i = 0; i < t->nbid; i++) {
        free(t->blk[i].rrel);
        free(t->blk[i].rlen);
        free(t->blk[i].rid);
    }
    free(t->blk);
    free(t->bord);
    free(t->bfirst);
    free(t->bfree);
    free(t->rloc);
    free(t->aggs);
    if (t->kx)
        for (i = 0; i < (uint32_t)t->ncols; i++)
            if (t->kx[i]) {
                kx_free(t->kx[i]);
                free(t->kx[i]);
            }
    free(t->kx);
    kx_free(&t->anc);
    free(t->ch.ck);
    free(t->ch.ckok);
    free(t->ch.marks);
    free(t->ch.wv);
    free(t->ch.wstl);
    memset(t, 0, sizeof *t);
}

/* Append a row to the table under construction (the scan): into the last
 * block, a new one past WB_BLK rows. */
static int tb_append_row(WTab *t, size_t lo, uint32_t len) {
    WBlock *b;
    uint32_t rid;
    if (!t->nb || t->blk[t->bord[t->nb - 1]].n >= WB_BLK) {
        uint32_t bid = tb_blk_new(t);
        if (bid == WN32 || !tb_bord_ins(t, t->nb, bid)) return 0;
        t->blk[bid].lo = lo;
        t->blk[bid].pos = t->nb - 1;
        t->bfirst[t->nb - 1] = t->nrows;
    }
    b = &t->blk[t->bord[t->nb - 1]];
    if (!blk_reserve(b, b->n + 1) || !tb_rid_room(t, t->nrid + 1)) return 0;
    rid = t->nrid++;
    b->rrel[b->n] = (uint32_t)(lo - b->lo);
    b->rlen[b->n] = len;
    b->rid[b->n] = rid;
    t->rloc[rid].bid = t->bord[t->nb - 1];
    t->rloc[rid].slot = b->n;
    b->n++;
    t->nrows++;
    return 1;
}


/* ------------------------------------------------------------------ binder
 *
 * Binding resolves a formula's names and records its dependencies on the
 * rule graph, each with a shape. The formula is a name (calc / params), a
 * rule (a column's formula text: `@col` is the row evaluating it), or a
 * one-off eval (no edges, aggregates scanned). Each aggregate becomes an
 * aggregate node; its per-row reads of the iterated table are SH_ALL
 * edges, the rest its scalar inputs; reads of the owner's row inside it
 * are its parameters (an instance per tuple of their values).
 */

enum { BK_NAME = 1, BK_RULE, BK_EVAL };

typedef struct {
    RtxWb *wb;
    int kind;
    uint32_t self;          /* graph node of the formula (WN32: eval) */
    int32_t own_tab, own_col;
    int32_t sheet;
    int32_t it_tab;
    int any_sheet;          /* eval: an unqualified name may live on any sheet */
    int nodeps;
    int dry;                /* rename check: nodeps, but groups bind (tokens) */
    uint32_t agg;           /* aggregate being bound (index; WN32: none) */
    uint32_t aggstk[16];    /* enclosing aggregates, innermost last */
    int naggstk;
    int nest;               /* lookups entered inside that aggregate */
    int grp_ok;             /* at the formula's root: a group may stand here */
    uint32_t *aggs;         /* the aggregates of this formula (AST order) */
    uint32_t naggs, aggcap;
    uint32_t *odeps;        /* owner-row edges met inside aggregates */
    uint8_t *odsh;
    uint32_t nodep, odcap;
    uint16_t rowmask, relmask;
    int8_t relmin, relmax;
    const char *src;        /* the formula's text (Ex spans are relative to it) */
    uint32_t srcn;
} BCtx;

static const char *const g_fn_name[] = {
    "", "sum", "count", "avg", "min", "max", "distinct", "any", "all",
    "abs", "round", "floor", "ceil", "coalesce", "len", "lower", "upper",
    "iserror", "iferror", "first", "if", NULL};

static int wb_fn_of(const char *s, size_t n) {
    int i;
    for (i = 1; g_fn_name[i]; i++)
        if (strlen(g_fn_name[i]) == n && !memcmp(g_fn_name[i], s, n)) return i;
    return FN_NONE;
}

static int wb_fn_agg(int fn) {
    return fn >= FN_SUM && fn <= FN_ALL;
}

static int wb_u32_cmp(const void *a, const void *b) {
    uint32_t x = *(const uint32_t *)a, y = *(const uint32_t *)b;
    return x < y ? -1 : x > y;
}

/* One edge of the formula (or of the aggregate being bound). */
static void bd_dep(BCtx *c, uint32_t node, int sh) {
    RtxWb *wb = c->wb;
    if (c->nodeps || node == WN32) return;
    if (wb->nbd >= wb->bdcap) {
        uint32_t nc = wb->bdcap ? wb->bdcap * 2 : 256;
        uint32_t *nd = (uint32_t *)realloc(wb->bdeps, (size_t)nc * sizeof(uint32_t));
        uint8_t *ns;
        if (!nd) return;
        wb->bdeps = nd;
        ns = (uint8_t *)realloc(wb->bdsh, nc);
        if (!ns) return;
        wb->bdsh = ns;
        wb->bdcap = nc;
    }
    wb->bdeps[wb->nbd] = node;
    wb->bdsh[wb->nbd++] = (uint8_t)sh;
}

/* An edge of the owner formula met inside an aggregate (its row's cells). */
static void bd_odep(BCtx *c, uint32_t node, int sh) {
    if (c->nodeps || node == WN32) return;
    if (c->nodep >= c->odcap) {
        uint32_t nc = c->odcap ? c->odcap * 2 : 16;
        uint32_t *nd = (uint32_t *)cc_arena_alloc(c->wb->sa, (size_t)nc * sizeof(uint32_t), 16);
        uint8_t *ns = (uint8_t *)cc_arena_alloc(c->wb->sa, nc, 1);
        if (!nd || !ns) return;
        if (c->nodep) {
            memcpy(nd, c->odeps, c->nodep * sizeof(uint32_t));
            memcpy(ns, c->odsh, c->nodep);
        }
        c->odeps = nd;
        c->odsh = ns;
        c->odcap = nc;
    }
    c->odeps[c->nodep] = node;
    c->odsh[c->nodep++] = (uint8_t)sh;
}

static Ex *bd_err(BCtx *c, Ex *e, int code, const char *fmt, const char *a, size_t an,
                  const char *b, size_t bn) {
    char msg[240];
    snprintf(msg, sizeof msg, fmt, (int)an, a ? a : "", (int)bn, b ? b : "");
    e->op = EX_ERR;
    e->v = wv_err_a(c->wb->ma, code, "%s", msg);
    return e;
}

/* Column `s` of table t: index, -1 absent, -2 ambiguous (a duplicate or
 * a case clash in the header). */
static int wb_col_of(const WTab *t, const char *s, size_t n) {
    int i;
    for (i = 0; i < t->ncols; i++) {
        if (t->cnamen[i] == n && !memcmp(t->cname[i], s, n)) return t->cclash[i] ? -2 : i;
    }
    return -1;
}

static int64_t wb_name_lookup(BCtx *c, const char *s, size_t n) {
    RtxWb *wb = c->wb;
    int64_t id = -1;
    uint32_t i;
    if (c->sheet >= 0) id = wb_map_get(&wb->map, c->sheet, s, n);
    if (id < 0) id = wb_map_get(&wb->map, SC_PARAM, s, n);
    if (id < 0 && c->any_sheet)
        for (i = 0; i < wb->nsheet && id < 0; i++) id = wb_map_get(&wb->map, (int32_t)i, s, n);
    return id;
}

static Ex *bd(BCtx *c, Ex *e);
static uint32_t wb_gnode_new(RtxWb *wb, int kind, uint32_t ref);
static int64_t bd_find_use(BCtx *c, const Ex *e);
static const char *bd_import_text(BCtx *c, const WUse *u, uint32_t lo, uint32_t hi, uint32_t *outn);
static Ex *bd_import(BCtx *c, Ex *e, uint32_t ui, int kind, const char *txt, uint32_t n);

static Ex *bd_table_ref(BCtx *c, Ex *e, int64_t tab) {
    WTab *t = &c->wb->tabs[tab];
    if (t->big) {
        char nb[24];
        snprintf(nb, sizeof nb, "%ld", (long)g_wb_rows_max);
        return bd_err(c, e, WE_REF, "%.*s has more than %.*s rows (W1 phase 2 indexes it)",
                      t->name, t->namen, nb, strlen(nb));
    }
    if (t->ext && !t->src) {
        /* an external table whose file cannot be read */
        const WCsv *cv = t->csv;
        if (cv && cv->ncols_err.t == WV_ERR) {
            e->op = EX_ERR;
            e->v = cv->ncols_err;
            return e;
        }
        return bd_err(c, e, WE_REF, "%.*s: its source cannot be read%.*s", t->name, t->namen, "", 0);
    }
    return NULL;
}

/* The owner-row read `@col` (off 0) / `@col[off]`: an edge of the rule; a
 * parameter of every aggregate it sits in. */
static void bd_own(BCtx *c, int col, int off) {
    WTab *t = &c->wb->tabs[c->own_tab];
    int k;
    int sh = off ? SH_REL : SH_ROW;
    if (off) {
        c->relmask = (uint16_t)(c->relmask | (1u << col));
        if (off < c->relmin) c->relmin = (int8_t)off;
        if (off > c->relmax) c->relmax = (int8_t)off;
    } else {
        c->rowmask = (uint16_t)(c->rowmask | (1u << col));
    }
    if (c->naggstk) {
        for (k = 0; k < c->naggstk; k++) {
            WAgg *a = &c->wb->aggs[c->aggstk[k]];
            a->pmask = (uint16_t)(a->pmask | (1u << col));
            a->otab = c->own_tab;
        }
        bd_odep(c, t->cnode[col], sh);
        return;
    }
    bd_dep(c, t->cnode[col], sh);
}

static Ex *bd_col(BCtx *c, Ex *e, int64_t tab, const char *cs, size_t cn) {
    WTab *t = &c->wb->tabs[tab];
    int col = wb_col_of(t, cs, cn);
    Ex *bad = bd_table_ref(c, e, tab);
    if (bad) return bad;
    if (col == -2)
        return bd_err(c, e, WE_DUP, "%.*s.%.*s names two columns", t->name, t->namen, cs, cn);
    if (col < 0)
        return bd_err(c, e, WE_REF, "%.*s has no column %.*s", t->name, t->namen, cs, cn);
    e->op = EX_COL;
    e->tab = (int32_t)tab;
    e->col = col;
    if (c->agg != WN32 && c->nest == 0) {
        WAgg *a = &c->wb->aggs[c->agg];
        if (a->tab == (int32_t)tab) {
            a->rowmask = (uint16_t)(a->rowmask | (1u << col));
            bd_dep(c, t->cnode[col], SH_ALL);
            return e;
        }
    }
    if (c->it_tab == (int32_t)tab) bd_dep(c, t->cnode[col], SH_LOOK);
    return e;
}

/* A new aggregate node over table `it` (grp: a group). */
static uint32_t bd_agg_open(BCtx *c, Ex *e, int32_t it, int grp) {
    RtxWb *wb = c->wb;
    uint32_t ai, node;
    WAgg *a;
    if (!wb_hgrow((void **)&wb->aggs, &wb->aggcap, wb->naggs + 1, sizeof(WAgg))) return WN32;
    ai = wb->naggs;
    node = wb_gnode_new(wb, GN_AGG, ai);
    if (node == WN32) return WN32;
    wb->naggs++;
    a = &wb->aggs[ai];
    memset(a, 0, sizeof *a);
    a->node = node;
    a->owner = c->self;
    a->tab = it;
    a->otab = -1;
    a->live = 1;
    a->grp = (uint8_t)grp;
    a->ex = e;
    a->full = 1;
    wb->g[node].tab = it;
    if (c->naggs >= c->aggcap) {
        uint32_t nc = c->aggcap ? c->aggcap * 2 : 8;
        uint32_t *nm = (uint32_t *)cc_arena_alloc(wb->sa, (size_t)nc * sizeof(uint32_t), 16);
        if (!nm) return WN32;
        if (c->naggs) memcpy(nm, c->aggs, c->naggs * sizeof(uint32_t));
        c->aggs = nm;
        c->aggcap = nc;
    }
    c->aggs[c->naggs++] = ai;
    return ai;
}

/* Sort + dedupe edges [base, nbd): same node twice keeps the first shape
 * by rank (ALL / ROW / REL over LOOK over SCALAR). */
static uint32_t bd_uniq(RtxWb *wb, uint32_t base) {
    uint32_t n = wb->nbd - base, i, j, k;
    uint32_t *d = wb->bdeps + base;
    uint8_t *s = wb->bdsh + base;
    /* insertion sort by node (edges per formula are few) */
    for (i = 1; i < n; i++) {
        uint32_t x = d[i];
        uint8_t y = s[i];
        for (j = i; j > 0 && (d[j - 1] > x || (d[j - 1] == x && s[j - 1] > y)); j--) {
            d[j] = d[j - 1];
            s[j] = s[j - 1];
        }
        d[j] = x;
        s[j] = y;
    }
    for (i = 0, k = 0; i < n; i++) {
        if (k && d[k - 1] == d[i] && s[k - 1] == s[i]) continue;
        d[k] = d[i];
        s[k] = s[i];
        k++;
    }
    wb->nbd = base + k;
    return k;
}

/* Close aggregate ai: its edges are those bound since `base`; the formula
 * reads it (a parameterized one per instance). */
static void bd_agg_close(BCtx *c, uint32_t ai, uint32_t base) {
    RtxWb *wb = c->wb;
    WAgg *a = &wb->aggs[ai];
    WGNode *g = &wb->g[a->node];
    uint32_t n = bd_uniq(wb, base);
    g->deps = (uint32_t *)wb_ma(wb, (size_t)(n ? n : 1) * sizeof(uint32_t));
    g->dsh = (uint8_t *)wb_ma(wb, n ? n : 1);
    if (g->deps && g->dsh && n) {
        memcpy(g->deps, wb->bdeps + base, n * sizeof(uint32_t));
        memcpy(g->dsh, wb->bdsh + base, n);
        g->ndeps = n;
    }
    wb->nbd = base;
    bd_dep(c, a->node, a->pmask ? SH_PAGG : SH_SCALAR);
}

static Ex *bd_ident(BCtx *c, Ex *e) {
    RtxWb *wb = c->wb;
    int64_t id;
    if (c->it_tab >= 0) {
        WTab *t = &wb->tabs[c->it_tab];
        int col = wb_col_of(t, e->id, e->idn);
        if (col != -1) {
            e->lo2 = e->lo;
            e->hi2 = e->hi;
            e->tabtok = 0;
            return bd_col(c, e, c->it_tab, e->id, e->idn);
        }
    }
    id = wb_name_lookup(c, e->id, e->idn);
    if (id >= 0) {
        e->op = EX_NAMEREF;
        e->node = (uint32_t)id;
        e->lo2 = e->lo;
        e->hi2 = e->hi;
        bd_dep(c, wb->names[id].node, SH_SCALAR);
        return e;
    }
    id = wb_map_get(&wb->map, SC_TABLE, e->id, e->idn);
    if (id >= 0) {
        Ex *bad = bd_table_ref(c, e, id);
        if (bad) return bad;
        e->op = EX_TABREF;
        e->tab = (int32_t)id;
        e->tabtok = 1;
        return e;
    }
    if (wb_map_get(&wb->map, SC_SHEET, e->id, e->idn) >= 0)
        return bd_err(c, e, WE_TYPE, "sheet %.*s is a namespace: write %.*s.name",
                      e->id, e->idn, e->id, e->idn);
    if (c->own_tab >= 0 && wb_col_of(&wb->tabs[c->own_tab], e->id, e->idn) >= 0)
        return bd_err(c, e, WE_NAME, "unknown name %.*s (this row's column is @%.*s)",
                      e->id, e->idn, e->id, e->idn);
    return bd_err(c, e, WE_NAME, "unknown name %.*s%.*s", e->id, e->idn, "", 0);
}

/* The table and range of `T[#a .. #b]`, or -1. */
static int64_t bd_range_tab(BCtx *c, const Ex *e) {
    if (!e || e->op != EX_INDEX || !e->range || !e->a || e->a->op != EX_IDENT) return -1;
    return wb_map_get(&c->wb->map, SC_TABLE, e->a->id, e->a->idn);
}

/* Table the aggregate argument iterates: the first `T.col` / `T` /
 * `T[#a .. #b]` in it (not inside a nested aggregate or lookup). -1 if
 * none. */
static int64_t bd_iter_tab(BCtx *c, const Ex *e) {
    int64_t t;
    uint16_t i;
    if (!e) return -1;
    switch (e->op) {
    case EX_IDENT:
        if (c->it_tab >= 0 && wb_col_of(&c->wb->tabs[c->it_tab], e->id, e->idn) != -1)
            return -1;
        return wb_map_get(&c->wb->map, SC_TABLE, e->id, e->idn);
    case EX_INDEX:
        return bd_range_tab(c, e);
    case EX_DOT:
        if (e->a && e->a->op == EX_IDENT) {
            t = wb_map_get(&c->wb->map, SC_TABLE, e->a->id, e->a->idn);
            if (t >= 0) return t;
            return -1;
        }
        if (e->a && e->a->op == EX_INDEX && e->a->range) return bd_range_tab(c, e->a);
        return bd_iter_tab(c, e->a);
    case EX_CALL: {
        int fn = wb_fn_of(e->id, e->idn);
        if (wb_fn_agg(fn) && !((fn == FN_MIN || fn == FN_MAX) && e->nargs > 1)) return -1;
        for (i = 0; i < e->nargs; i++) {
            t = bd_iter_tab(c, e->args[i]);
            if (t >= 0) return t;
        }
        return -1;
    }
    case EX_UN:
        return bd_iter_tab(c, e->a);
    case EX_BIN:
        t = bd_iter_tab(c, e->a);
        return t >= 0 ? t : bd_iter_tab(c, e->b);
    case EX_IF:
        t = bd_iter_tab(c, e->a);
        if (t < 0) t = bd_iter_tab(c, e->b);
        return t >= 0 ? t : bd_iter_tab(c, e->c);
    default:
        return -1;
    }
}

/* A whole number of rows (an offset literal): 1 and *k. */
static int bd_int_lit(const Ex *e, int64_t *k) {
    if (!e) return 0;
    if (e->op == EX_LIT && e->v.t == WV_INT) {
        *k = e->v.u.i;
        return 1;
    }
    if (e->op == EX_UN && e->bin == '-' && e->a && e->a->op == EX_LIT && e->a->v.t == WV_INT) {
        *k = -e->a->v.u.i;
        return 1;
    }
    return 0;
}

/* A range end `#a` / `#a[+k]`. */
static int bd_end(BCtx *c, const Ex *e, WEnd *out, const char **why) {
    int64_t k = 0;
    (void)c;
    if (e && e->op == EX_INDEX && !e->range && e->a && e->a->op == EX_ANC) {
        if (!bd_int_lit(e->b, &k) || k > RTX_WB_REL_MAX || k < -RTX_WB_REL_MAX) {
            *why = "an anchor offset is a whole number of rows, at most " RTX_WB_REL_MAX_S;
            return 0;
        }
        e = e->a;
    }
    if (!e || e->op != EX_ANC) {
        *why = "a range runs between anchors: T[#a .. #b]";
        return 0;
    }
    out->anc = e->id2;
    out->ancn = e->id2n;
    out->off = (int32_t)k;
    return 1;
}

/* The anchored cell node (tab, col, anchor, off): shared by every formula
 * naming it. */
static uint32_t bd_abs_node(BCtx *c, int32_t tab, int32_t col, const char *anc, uint32_t ancn,
                            int32_t off) {
    RtxWb *wb = c->wb;
    uint32_t i, node;
    WAbs *x;
    for (i = 0; i < wb->nabs; i++) {
        x = &wb->abs[i];
        if (x->tab == tab && x->col == col && x->off == off && x->ancn == ancn &&
            !memcmp(x->anc, anc, ancn) && wb->g[x->node].kind == GN_ABS)
            return i;
    }
    if (!wb_hgrow((void **)&wb->abs, &wb->abscap, wb->nabs + 1, sizeof(WAbs))) return WN32;
    node = wb_gnode_new(wb, GN_ABS, wb->nabs);
    if (node == WN32) return WN32;
    x = &wb->abs[wb->nabs];
    memset(x, 0, sizeof *x);
    x->tab = tab;
    x->col = col;
    x->anc = wb_strdup(wb, anc, ancn);
    x->ancn = ancn;
    x->off = off;
    x->node = node;
    x->pend = 1;
    wb->g[node].tab = tab;
    wb->g[node].col = col;
    {
        WGNode *g = &wb->g[node];
        g->deps = (uint32_t *)wb_ma(wb, sizeof(uint32_t));
        g->dsh = (uint8_t *)wb_ma(wb, 1);
        if (g->deps && g->dsh) {
            g->deps[0] = wb->tabs[tab].cnode[col];
            g->dsh[0] = SH_ABS;
            g->ndeps = 1;
        }
    }
    wb->graph_dirty = 1;
    return wb->nabs++;
}

/* T#a.col / T#a[+k].col: an anchored cell. `r` is the row part. */
static Ex *bd_anchored(BCtx *c, Ex *e, Ex *r) {
    RtxWb *wb = c->wb;
    Ex *ta = r;
    int64_t k = 0, tab;
    int col;
    WTab *t;
    uint32_t ai;
    if (r->op == EX_INDEX) {
        if (r->range || !bd_int_lit(r->b, &k) || k > RTX_WB_REL_MAX || k < -RTX_WB_REL_MAX)
            return bd_err(c, e, WE_REF, "T#anchor[k]: k is a whole number of rows, at most %.*s%.*s",
                          RTX_WB_REL_MAX_S, strlen(RTX_WB_REL_MAX_S), "", 0);
        ta = r->a;
    }
    tab = ta->a && ta->a->op == EX_IDENT ? wb_map_get(&wb->map, SC_TABLE, ta->a->id, ta->a->idn)
                                          : -1;
    if (tab < 0)
        return bd_err(c, e, WE_REF, "%.*s#%.*s: no such table", ta->a ? ta->a->id : "",
                      ta->a ? ta->a->idn : 0, ta->id2, ta->id2n);
    {
        Ex *bad = bd_table_ref(c, e, tab);
        if (bad) return bad;
    }
    t = &wb->tabs[tab];
    col = wb_col_of(t, e->id2, e->id2n);
    if (col == -2) return bd_err(c, e, WE_DUP, "%.*s.%.*s names two columns", t->name, t->namen, e->id2, e->id2n);
    if (col < 0) return bd_err(c, e, WE_REF, "%.*s has no column %.*s", t->name, t->namen, e->id2, e->id2n);
    if (c->nodeps) {
        /* eval: resolved on the fly */
        e->op = EX_ABS;
        e->tab = (int32_t)tab;
        e->col = col;
        e->node = WN32;
        e->a = ta;
        e->v = wv_int(k);
        return e;
    }
    ai = bd_abs_node(c, (int32_t)tab, col, ta->id2, ta->id2n, (int32_t)k);
    if (ai == WN32) return bd_err(c, e, WE_NUM, "out of memory%.*s%.*s", "", 0, "", 0);
    e->op = EX_ABS;
    e->tab = (int32_t)tab;
    e->col = col;
    e->node = ai;
    e->a = ta;
    e->lo = ta->a->lo;
    e->hi = ta->a->hi;
    e->tabtok = 1;
    bd_dep(c, wb->abs[ai].node, SH_SCALAR);
    return e;
}

/* The aggregate `e` (fn over the rows of `it`); a range binds its ends. */
static Ex *bd_call(BCtx *c, Ex *e) {
    int fn = wb_fn_of(e->id, e->idn);
    uint16_t i;
    if (fn == FN_NONE)
        return bd_err(c, e, WE_NAME, "unknown function %.*s%.*s", e->id, e->idn, "", 0);
    if (wb_fn_agg(fn) && !((fn == FN_MIN || fn == FN_MAX) && e->nargs > 1 && !e->where)) {
        /* an aggregate over another workbook's table: evaluated there */
        int64_t ui = bd_find_use(c, e);
        if (ui >= 0) {
            uint32_t n;
            const char *txt = bd_import_text(c, &c->wb->uses[ui], e->slo, e->shi, &n);
            return bd_import(c, e, (uint32_t)ui, IMP_EXPR, txt, n);
        }
    }
    if ((fn == FN_MIN || fn == FN_MAX) && e->nargs > 1 && !e->where)
        fn = fn == FN_MIN ? FN_MIN2 : FN_MAX2;
    if (wb_fn_agg(fn)) {
        int64_t it;
        int32_t save = c->it_tab;
        Ex *bad, *arg;
        const Ex *rx = NULL;
        WEnd ra, rb;
        if (e->nargs != 1)
            return bd_err(c, e, WE_TYPE, "%.*s takes one column (T.col) or table%.*s", e->id,
                          e->idn, "", 0);
        it = bd_iter_tab(c, e->args[0]);
        if (it < 0)
            return bd_err(c, e, WE_REF, "%.*s needs a table column (T.col)%.*s", e->id, e->idn,
                          "", 0);
        bad = bd_table_ref(c, e, it);
        if (bad) return bad;
        /* a range: T[#a .. #b] or T[#a .. #b].col as the argument */
        arg = e->args[0];
        if (arg->op == EX_INDEX && arg->range) rx = arg;
        else if (arg->op == EX_DOT && arg->a && arg->a->op == EX_INDEX && arg->a->range) rx = arg->a;
        if (rx) {
            const char *why = NULL;
            if (!bd_end(c, rx->b, &ra, &why) || !bd_end(c, rx->c, &rb, &why))
                return bd_err(c, e, WE_REF, "%.*s%.*s", why, strlen(why), "", 0);
            /* the argument reads the table: T (count) or T.col */
            if (arg == rx) {
                Ex *tr = rx->a;
                e->args[0] = tr;
                arg = tr;
            } else {
                arg->a = rx->a;
            }
            e->c = (Ex *)rx; /* its end tokens (rename) */
        }
        if (!c->nodeps) {
            uint32_t ai = bd_agg_open(c, e, (int32_t)it, 0), base = c->wb->nbd, save_agg = c->agg;
            int save_nest = c->nest;
            if (ai != WN32) {
                WAgg *a;
                if (c->naggstk < 16) c->aggstk[c->naggstk++] = ai;
                c->agg = ai;
                c->nest = 0;
                c->it_tab = (int32_t)it;
                e->args[0] = bd(c, e->args[0]);
                if (e->where) e->where = bd(c, e->where);
                c->it_tab = save;
                c->agg = save_agg;
                c->nest = save_nest;
                c->naggstk--;
                e->op = EX_AGG;
                e->fn = (uint8_t)fn;
                e->tab = (int32_t)it;
                e->isma = 1;
                e->node = ai;
                a = &c->wb->aggs[ai];
                memset(&a->o, 0, sizeof a->o);
                a->o.arg = e->args[0];
                a->o.where = e->where;
                a->o.fn = (uint8_t)fn;
                a->o.q = e->q;
                a->o.crow = e->args[0]->op == EX_TABREF && e->args[0]->tab == (int32_t)it &&
                            fn == FN_COUNT;
                a->o.bad = e->args[0]->op == EX_TABREF && !a->o.crow;
                if (rx) {
                    a->ranged = 1;
                    a->ra = ra;
                    a->rb = rb;
                    a->ra.anc = wb_strdup(c->wb, ra.anc, ra.ancn);
                    a->rb.anc = wb_strdup(c->wb, rb.anc, rb.ancn);
                }
                bd_agg_close(c, ai, base);
                return e;
            }
        }
        c->it_tab = (int32_t)it;
        e->args[0] = bd(c, e->args[0]);
        if (e->where) e->where = bd(c, e->where);
        c->it_tab = save;
        e->op = EX_AGG;
        e->fn = (uint8_t)fn;
        e->tab = (int32_t)it;
        if (rx) {
            /* eval: a scan over the resolved range */
            WEnd *pe = (WEnd *)wb_ma(c->wb, 2 * sizeof(WEnd));
            if (pe) {
                pe[0] = ra;
                pe[1] = rb;
                e->v.u.s = (const char *)pe;
                e->range = 1;
            }
        }
        return e;
    }
    if (e->where)
        return bd_err(c, e, WE_TYPE, "where belongs to an aggregate, not %.*s%.*s", e->id, e->idn,
                      "", 0);
    for (i = 0; i < e->nargs; i++) e->args[i] = bd(c, e->args[i]);
    if (fn == FN_FIRST) {
        Ex *a = e->nargs == 1 ? e->args[0] : NULL;
        if (!a || a->op != EX_LOOKUP)
            return bd_err(c, e, WE_TYPE, "first(T[condition]) takes a lookup%.*s%.*s", "", 0, "", 0);
        a->first = 1;
        return a;
    }
    if (fn == FN_IF) {
        if (e->nargs != 3)
            return bd_err(c, e, WE_TYPE, "if takes three arguments%.*s%.*s", "", 0, "", 0);
        e->op = EX_IF;
        e->a = e->args[0];
        e->b = e->args[1];
        e->c = e->args[2];
        return e;
    }
    {
        int lo = 1, hi = 1;
        if (fn == FN_ROUND) hi = 2;
        if (fn == FN_IFERROR) lo = hi = 2;
        if (fn == FN_COALESCE || fn == FN_MIN2 || fn == FN_MAX2) {
            lo = 1;
            hi = 64;
        }
        if (e->nargs < lo || e->nargs > hi)
            return bd_err(c, e, WE_TYPE, "%.*s: wrong number of arguments%.*s", e->id, e->idn, "", 0);
    }
    e->op = EX_FN;
    e->fn = (uint8_t)fn;
    return e;
}

/* Formula text that starts with the `group` keyword. */
static int wb_src_group(const char *s, size_t n) {
    size_t i = 0;
    while (i < n && (s[i] == ' ' || s[i] == '\t')) i++;
    return n - i >= 6 && memcmp(s + i, "group", 5) == 0 && !wb_id1(s[i + 5]);
}

static Ex *wb_parse(RtxWb *wb, const char *s, uint32_t n);

/* The unbound group a name defines (`g = group T by k { ... }`), else NULL. */
static const Ex *wb_group_sig(RtxWb *wb, uint32_t ni) {
    const WName *n = &wb->names[ni];
    const Ex *x;
    if (!n->def || !n->src || n->clash) return NULL;
    if (!wb_src_group(n->src, n->srcn)) return NULL;
    x = wb_parse(wb, n->src, n->srcn);
    return x && x->op == EX_GROUP ? x : NULL;
}

/* G[key = v]: a group's row by its key. */
static Ex *bd_glookup(BCtx *c, Ex *e, uint32_t ni, const Ex *sig) {
    Ex *b = e->a, *cond = e->b;
    const Ex *k = sig->a;
    if (!cond || cond->op != EX_BIN || cond->bin != '=' || !cond->a || cond->a->op != EX_IDENT ||
        !k || k->op != EX_IDENT || cond->a->idn != k->idn || memcmp(cond->a->id, k->id, k->idn))
        return bd_err(c, e, WE_TYPE, "%.*s[%.*s = value]: a group row is found by its key", b->id,
                      b->idn, k && k->op == EX_IDENT ? k->id : "key",
                      k && k->op == EX_IDENT ? k->idn : 3);
    e->op = EX_GLOOKUP;
    e->node = ni;
    e->lo = e->lo2 = b->lo;
    e->hi = e->hi2 = b->hi;
    e->b = bd(c, cond->b);
    e->a = (Ex *)sig;
    e->col = -1;
    bd_dep(c, c->wb->names[ni].node, SH_SCALAR);
    return e;
}

/* `group T by k { out: agg, ... }` at a name's root: one group aggregate. */
static Ex *bd_group(BCtx *c, Ex *e) {
    RtxWb *wb = c->wb;
    int64_t tab = wb_map_get(&wb->map, SC_TABLE, e->id, e->idn);
    uint32_t ai, base, save_agg = c->agg, i;
    int32_t save_it = c->it_tab;
    int save_nest = c->nest;
    WAgg *a;
    WOut *outs;
    if (tab < 0) return bd_err(c, e, WE_REF, "group: no table %.*s%.*s", e->id, e->idn, "", 0);
    {
        Ex *bad = bd_table_ref(c, e, tab);
        if (bad) return bad;
    }
    if (!e->a || e->a->op != EX_IDENT || wb_col_of(&wb->tabs[tab], e->a->id, e->a->idn) < 0)
        return bd_err(c, e, WE_TYPE, "group %.*s by a column of %.*s", e->id, e->idn, e->id, e->idn);
    for (i = 0; i < e->nargs; i++) {
        const Ex *o = e->args[i];
        int fn = o->op == EX_CALL ? wb_fn_of(o->id, o->idn) : FN_NONE;
        if (!wb_fn_agg(fn) || o->nargs > 1 || (!o->nargs && fn != FN_COUNT))
            return bd_err(c, e, WE_TYPE, "group output %.*s: an aggregate of %.*s columns",
                          o->id2, o->id2n, e->id, e->idn);
    }
    if (c->dry) {
        /* the rename check: resolve the names, build nothing */
        c->it_tab = (int32_t)tab;
        e->a = bd(c, e->a);
        for (i = 0; i < e->nargs; i++) {
            Ex *o = e->args[i];
            if (o->nargs) o->args[0] = bd(c, o->args[0]);
            if (o->where) o->where = bd(c, o->where);
        }
        c->it_tab = save_it;
        e->tab = (int32_t)tab;
        return e;
    }
    outs = (WOut *)wb_ma(wb, (size_t)(e->nargs ? e->nargs : 1) * sizeof(WOut));
    if (!outs) return bd_err(c, e, WE_NUM, "out of memory%.*s%.*s", "", 0, "", 0);
    ai = bd_agg_open(c, e, (int32_t)tab, 1);
    if (ai == WN32) return bd_err(c, e, WE_NUM, "out of memory%.*s%.*s", "", 0, "", 0);
    base = wb->nbd;
    if (c->naggstk < 16) c->aggstk[c->naggstk++] = ai;
    c->agg = ai;
    c->nest = 0;
    c->it_tab = (int32_t)tab;
    e->a = bd(c, e->a);
    for (i = 0; i < e->nargs; i++) {
        Ex *o = e->args[i];
        int fn = wb_fn_of(o->id, o->idn);
        if (o->nargs) o->args[0] = bd(c, o->args[0]);
        if (o->where) o->where = bd(c, o->where);
        o->op = EX_AGG;
        o->fn = (uint8_t)fn;
        o->tab = (int32_t)tab;
        outs[i].arg = o->nargs ? o->args[0] : NULL;
        outs[i].where = o->where;
        outs[i].fn = (uint8_t)fn;
        outs[i].q = o->q;
        outs[i].crow = !o->nargs || (o->args[0]->op == EX_TABREF && o->args[0]->tab == (int32_t)tab &&
                                     fn == FN_COUNT);
        outs[i].bad = o->nargs && o->args[0]->op == EX_TABREF && !outs[i].crow;
    }
    c->it_tab = save_it;
    c->agg = save_agg;
    c->nest = save_nest;
    c->naggstk--;
    a = &wb->aggs[ai];
    a->key = e->a;
    a->outs = outs;
    a->nout = e->nargs;
    e->tab = (int32_t)tab;
    e->isma = 1;
    e->node = ai;
    bd_agg_close(c, ai, base);
    return e;
}

/* ---- imports: references into another workbook (a `uses` alias) */

/* The `uses` alias named s, or -1. A local table, sheet, name or column
 * of that name wins (the alias is a namespace of last resort). */
static int64_t bd_use_of(BCtx *c, const char *s, size_t n) {
    RtxWb *wb = c->wb;
    uint32_t i;
    if (!wb->nuses) return -1;
    if (wb_map_get(&wb->map, SC_TABLE, s, n) >= 0 || wb_map_get(&wb->map, SC_SHEET, s, n) >= 0 ||
        wb_name_lookup(c, s, n) >= 0)
        return -1;
    if (c->it_tab >= 0 && wb_col_of(&wb->tabs[c->it_tab], s, n) != -1) return -1;
    for (i = 0; i < wb->nuses; i++)
        if (wb->uses[i].namen == n && !memcmp(wb->uses[i].name, s, n)) return (int64_t)i;
    return -1;
}

/* The alias at the root of a postfix chain (alias.x, alias.T#a.c, ...). */
static int64_t bd_chain_use(BCtx *c, const Ex *e) {
    const Ex *r = e;
    while (r && (r->op == EX_DOT || r->op == EX_TANC || r->op == EX_INDEX)) r = r->a;
    if (!r || r == e || r->op != EX_IDENT) return -1;
    return bd_use_of(c, r->id, r->idn);
}

/* Any alias-rooted chain inside e (an aggregate's argument / where). */
static int64_t bd_find_use(BCtx *c, const Ex *e) {
    int64_t u;
    uint16_t i;
    if (!e) return -1;
    if (e->op == EX_DOT || e->op == EX_TANC || e->op == EX_INDEX) {
        u = bd_chain_use(c, e);
        if (u >= 0) return u;
    }
    if ((u = bd_find_use(c, e->a)) >= 0 || (u = bd_find_use(c, e->b)) >= 0 ||
        (u = bd_find_use(c, e->c)) >= 0 || (u = bd_find_use(c, e->where)) >= 0)
        return u;
    for (i = 0; i < e->nargs; i++)
        if ((u = bd_find_use(c, e->args[i])) >= 0) return u;
    return -1;
}

/* The source [lo, hi) with every `alias.` prefix of use u dropped (not
 * inside quotes): the text the other workbook evaluates. */
static const char *bd_import_text(BCtx *c, const WUse *u, uint32_t lo, uint32_t hi, uint32_t *outn) {
    const char *s = c->src;
    char *out;
    uint32_t i, k = 0;
    char q = 0;
    if (!s || hi > c->srcn || lo > hi) {
        *outn = 0;
        return "";
    }
    out = (char *)wb_ma(c->wb, hi - lo + 1);
    if (!out) {
        *outn = 0;
        return "";
    }
    for (i = lo; i < hi; i++) {
        char ch = s[i];
        if (q) {
            out[k++] = ch;
            if (ch == '\\' && q == '"' && i + 1 < hi) {
                out[k++] = s[++i];
                continue;
            }
            if (ch == q) q = 0;
            continue;
        }
        if (ch == '"' || ch == '`') {
            q = ch;
            out[k++] = ch;
            continue;
        }
        if ((i == lo || !wb_id1(s[i - 1])) && i + u->namen < hi && !memcmp(s + i, u->name, u->namen) &&
            s[i + u->namen] == '.') {
            i += u->namen; /* skip `alias.` (the loop's ++ takes the dot) */
            continue;
        }
        out[k++] = ch;
    }
    out[k] = 0;
    *outn = k;
    return out;
}

/* e (a chain / an aggregate call) reads use u: an import node. */
static Ex *bd_import(BCtx *c, Ex *e, uint32_t ui, int kind, const char *txt, uint32_t n) {
    RtxWb *wb = c->wb;
    const WUse *u = &wb->uses[ui];
    uint32_t i, node;
    WImp *m;
    if (u->state != USE_OK) {
        e->op = EX_ERR;
        e->v = u->err;
        return e;
    }
    e->op = EX_IMP;
    e->col = (int32_t)ui;
    e->fn = (uint8_t)kind;
    e->id = txt;
    e->idn = n;
    if (c->nodeps) {
        e->node = WN32; /* an eval: read at once */
        return e;
    }
    for (i = 0; i < wb->nimps; i++) {
        m = &wb->imps[i];
        if (m->use == ui && m->kind == kind && m->n == n && !memcmp(m->txt, txt, n)) {
            e->node = i;
            bd_dep(c, m->node, SH_SCALAR);
            return e;
        }
    }
    if (!wb_hgrow((void **)&wb->imps, &wb->impcap, wb->nimps + 1, sizeof(WImp))) {
        e->op = EX_ERR;
        e->v = wv_err_a(wb->ma, WE_NUM, "out of memory");
        return e;
    }
    node = wb_gnode_new(wb, GN_IMP, wb->nimps);
    if (node == WN32) {
        e->op = EX_ERR;
        e->v = wv_err_a(wb->ma, WE_NUM, "out of memory");
        return e;
    }
    m = &wb->imps[wb->nimps];
    memset(m, 0, sizeof *m);
    m->use = ui;
    m->kind = (uint8_t)kind;
    m->txt = txt;
    m->n = n;
    m->node = node;
    m->pend = 1;
    e->node = wb->nimps++;
    wb->graph_dirty = 1;
    bd_dep(c, node, SH_SCALAR);
    return e;
}

/* A postfix chain rooted at an alias: `alias.name` / `alias.Sheet.name`
 * are its names; anything else is evaluated there. NULL: not an import. */
static Ex *bd_chain_import(BCtx *c, Ex *e) {
    int64_t ui = bd_chain_use(c, e);
    const Ex *b = e->a;
    uint32_t n;
    const char *txt;
    if (ui < 0) return NULL;
    if (e->op == EX_DOT && b && b->op == EX_IDENT) {
        /* alias.name */
        txt = wb_strdup(c->wb, e->id2, e->id2n);
        return bd_import(c, e, (uint32_t)ui, IMP_NAME, txt ? txt : "", txt ? e->id2n : 0);
    }
    if (e->op == EX_DOT && b && b->op == EX_DOT && b->a && b->a->op == EX_IDENT) {
        /* alias.Sheet.name: a name (a table's column alone is no value) */
        char lab[256];
        int k = snprintf(lab, sizeof lab, "%.*s.%.*s", (int)b->id2n, b->id2, (int)e->id2n, e->id2);
        if (k > 0 && (size_t)k < sizeof lab) {
            txt = wb_strdup(c->wb, lab, (size_t)k);
            if (txt) return bd_import(c, e, (uint32_t)ui, IMP_NAME, txt, (uint32_t)k);
        }
    }
    txt = bd_import_text(c, &c->wb->uses[ui], e->slo, e->shi, &n);
    return bd_import(c, e, (uint32_t)ui, IMP_EXPR, txt, n);
}

static Ex *bd(BCtx *c, Ex *e) {
    RtxWb *wb = c->wb;
    int gok = c->grp_ok;
    if (!e) return e;
    c->grp_ok = 0;
    switch (e->op) {
    case EX_GROUP:
        if (!gok || (c->nodeps && !c->dry) || c->kind != BK_NAME)
            return bd_err(c, e, WE_TYPE,
                          "group is a derived table: name it (g = group T by k { ... })%.*s%.*s", "",
                          0, "", 0);
        return bd_group(c, e);
    case EX_LIT:
    case EX_ERR:
        return e;
    case EX_IDENT:
        return bd_ident(c, e);
    case EX_ANC:
        return bd_err(c, e, WE_REF, "#%.*s alone names no table: write T#%.*s.column", e->id2,
                      e->id2n, e->id2, e->id2n);
    case EX_TANC: {
        Ex *im = bd_chain_import(c, e);
        if (im) return im;
        return bd_err(c, e, WE_TYPE, "%.*s#%.*s is a row: add .column", e->a ? e->a->id : "",
                      e->a ? e->a->idn : 0, e->id2, e->id2n);
    }
    case EX_AT: {
        WTab *t;
        int col;
        if (c->own_tab < 0)
            return bd_err(c, e, WE_REF, "@%.*s needs a table row%.*s", e->id2, e->id2n, "", 0);
        t = &wb->tabs[c->own_tab];
        col = wb_col_of(t, e->id2, e->id2n);
        if (col == -2)
            return bd_err(c, e, WE_DUP, "@%.*s names two columns%.*s", e->id2, e->id2n, "", 0);
        if (col < 0)
            return bd_err(c, e, WE_REF, "%.*s has no column %.*s", t->name, t->namen, e->id2,
                          e->id2n);
        e->op = EX_ATCELL;
        e->col = col;
        e->tab = c->own_tab;
        bd_own(c, col, 0);
        return e;
    }
    case EX_DOT: {
        Ex *b = e->a;
        {
            /* alias.name, alias.T#a.col, ...: another workbook's */
            Ex *im = bd_chain_import(c, e);
            if (im) return im;
        }
        if (b && (b->op == EX_TANC || (b->op == EX_INDEX && b->a && b->a->op == EX_TANC)))
            return bd_anchored(c, e, b);
        if (b && b->op == EX_IDENT) {
            int64_t id;
            int is_col = c->it_tab >= 0 &&
                         wb_col_of(&wb->tabs[c->it_tab], b->id, b->idn) != -1;
            id = is_col ? -1 : wb_map_get(&wb->map, SC_TABLE, b->id, b->idn);
            if (id >= 0) {
                e->tabtok = 1;
                e->lo = b->lo;
                e->hi = b->hi;
                return bd_col(c, e, id, e->id2, e->id2n);
            }
            id = is_col ? -1 : wb_map_get(&wb->map, SC_SHEET, b->id, b->idn);
            if (id >= 0 && wb_name_lookup(c, b->id, b->idn) < 0) {
                int64_t nd = wb_map_get(&wb->map, (int32_t)id, e->id2, e->id2n);
                if (nd < 0)
                    return bd_err(c, e, WE_NAME, "sheet %.*s has no name %.*s", b->id, b->idn,
                                  e->id2, e->id2n);
                e->op = EX_NAMEREF;
                e->node = (uint32_t)nd;
                e->sheettok = 1;
                e->lo = b->lo;
                e->hi = b->hi;
                bd_dep(c, wb->names[nd].node, SH_SCALAR);
                return e;
            }
        }
        e->a = bd(c, b);
        if (e->a && e->a->op == EX_GLOOKUP && e->a->col < 0) {
            const Ex *sig = e->a->a;
            uint16_t i;
            for (i = 0; i < sig->nargs; i++) {
                const Ex *o = sig->args[i];
                if (o->id2n == e->id2n && !memcmp(o->id2, e->id2, e->id2n)) {
                    e->a->col = i;
                    return e->a;
                }
            }
            return bd_err(c, e, WE_REF, "the group has no output %.*s%.*s", e->id2, e->id2n, "", 0);
        }
        if (e->a && e->a->op == EX_LOOKUP) {
            WTab *t = &wb->tabs[e->a->tab];
            int col = wb_col_of(t, e->id2, e->id2n);
            if (col < 0)
                return bd_err(c, e, col == -2 ? WE_DUP : WE_REF, "%.*s has no column %.*s",
                              t->name, t->namen, e->id2, e->id2n);
            e->op = EX_FIELD;
            e->tab = e->a->tab;
            e->col = col;
            bd_dep(c, t->cnode[col], SH_LOOK);
            return e;
        }
        if (e->a && e->a->op == EX_ERR) {
            e->op = EX_ERR;
            e->v = e->a->v;
            return e;
        }
        return bd_err(c, e, WE_TYPE, ".%.*s needs a table or a row (T[condition])%.*s", e->id2,
                      e->id2n, "", 0);
    }
    case EX_INDEX: {
        Ex *b = e->a;
        int64_t id = -1;
        int32_t save;
        {
            Ex *im = bd_chain_import(c, e);
            if (im) return im;
        }
        if (e->range)
            return bd_err(c, e, WE_TYPE, "T[#a .. #b] is a range of rows: aggregate it (sum(T[#a .. #b].col))%.*s%.*s",
                          "", 0, "", 0);
        if (b && b->op == EX_AT) {
            /* @col[k]: this row + k */
            int64_t k;
            WTab *t;
            int col;
            if (c->own_tab < 0)
                return bd_err(c, e, WE_REF, "@%.*s[k] needs a table row%.*s", b->id2, b->id2n, "", 0);
            if (!bd_int_lit(e->b, &k) || k > RTX_WB_REL_MAX || k < -RTX_WB_REL_MAX)
                return bd_err(c, e, WE_REF, "@%.*s[k]: k is a whole number of rows, at most %.*s",
                              b->id2, b->id2n, RTX_WB_REL_MAX_S, strlen(RTX_WB_REL_MAX_S));
            t = &wb->tabs[c->own_tab];
            col = wb_col_of(t, b->id2, b->id2n);
            if (col < 0)
                return bd_err(c, e, col == -2 ? WE_DUP : WE_REF, "%.*s has no column %.*s",
                              t->name, t->namen, b->id2, b->id2n);
            if (c->naggstk && k)
                return bd_err(c, e, WE_REF, "@%.*s[k] inside an aggregate: only this row (@%.*s)",
                              b->id2, b->id2n, b->id2, b->id2n);
            e->op = k ? EX_RELCELL : EX_ATCELL;
            e->col = col;
            e->tab = c->own_tab;
            e->node = (uint32_t)(int32_t)k;
            e->lo2 = b->lo2;
            e->hi2 = b->hi2;
            e->lo = b->lo;
            e->hi = b->hi;
            bd_own(c, col, (int)k);
            return e;
        }
        if (b && b->op == EX_DOT && b->a && b->a->op == EX_IDENT &&
            wb_map_get(&wb->map, SC_TABLE, b->a->id, b->a->idn) >= 0) {
            /* T.col[n]: a position — refused: rows are named by anchors */
            return bd_err(c, e, WE_REF,
                          "%.*s.%.*s[n]: rows are named by anchors, not positions (add {#name} to the row's first cell, then write T#name.col)",
                          b->a->id, b->a->idn, b->id2, b->id2n);
        }
        if (b && b->op == EX_IDENT) id = wb_map_get(&wb->map, SC_TABLE, b->id, b->idn);
        if (id < 0 && b && b->op == EX_IDENT && !c->nodeps) {
            int64_t nd = wb_name_lookup(c, b->id, b->idn);
            const Ex *sig = nd >= 0 ? wb_group_sig(wb, (uint32_t)nd) : NULL;
            if (sig) return bd_glookup(c, e, (uint32_t)nd, sig);
        }
        if (id < 0) return bd_err(c, e, WE_TYPE, "[ ] needs a table%.*s%.*s", "", 0, "", 0);
        {
            Ex *bad = bd_table_ref(c, e, id);
            if (bad) return bad;
        }
        e->lo = b->lo;
        e->hi = b->hi;
        e->tabtok = 1;
        e->tab = (int32_t)id;
        if (e->b && e->b->op == EX_AT) {
            /* T[@col]: this row of this table */
            WTab *t = &wb->tabs[id];
            int col;
            if (c->own_tab != (int32_t)id)
                return bd_err(c, e, WE_REF, "%.*s[@%.*s] names this row only inside the table",
                              t->name, t->namen, e->b->id2, e->b->id2n);
            col = wb_col_of(t, e->b->id2, e->b->id2n);
            if (col < 0)
                return bd_err(c, e, WE_REF, "%.*s has no column %.*s", t->name, t->namen,
                              e->b->id2, e->b->id2n);
            e->op = EX_ATCELL;
            e->col = col;
            e->lo2 = e->b->lo2;
            e->hi2 = e->b->hi2;
            bd_own(c, col, 0);
            return e;
        }
        {
            int64_t k;
            if (bd_int_lit(e->b, &k))
                return bd_err(c, e, WE_REF,
                              "%.*s[n]: rows are named by anchors, not positions (add {#name} to the row's first cell, then write T#name.col)%.*s",
                              b->id, b->idn, "", 0);
        }
        save = c->it_tab;
        c->it_tab = (int32_t)id;
        c->nest++;
        e->b = bd(c, e->b);
        c->nest--;
        c->it_tab = save;
        e->op = EX_LOOKUP;
        return e;
    }
    case EX_CALL:
        return bd_call(c, e);
    case EX_UN:
        e->a = bd(c, e->a);
        return e;
    case EX_BIN:
        e->a = bd(c, e->a);
        e->b = bd(c, e->b);
        return e;
    case EX_IF:
        e->a = bd(c, e->a);
        e->b = bd(c, e->b);
        e->c = bd(c, e->c);
        return e;
    default:
        return e;
    }
}

/* Bind a formula: `kind` BK_NAME (names[ref]) or BK_RULE (rules[ref]).
 * Its edges and aggregates land on its graph node. */
static void wb_bind(RtxWb *wb, int kind, uint32_t ref) {
    BCtx c;
    Ex *x;
    const char *src;
    uint32_t srcn, node, n, base;
    wb->bind_gen++;
    memset(&c, 0, sizeof c);
    c.wb = wb;
    c.kind = kind;
    c.own_tab = c.own_col = -1;
    c.it_tab = -1;
    c.sheet = -1;
    c.agg = WN32;
    c.relmin = c.relmax = 0;
    if (kind == BK_NAME) {
        WName *nm = &wb->names[ref];
        c.self = nm->node;
        c.sheet = nm->scope;
        c.grp_ok = 1;
        src = nm->src;
        srcn = nm->srcn;
    } else {
        WRule *r = &wb->rules[ref];
        c.self = r->node;
        c.own_tab = r->tab;
        c.own_col = r->col;
        c.sheet = wb->tabs[r->tab].sheet;
        src = r->src;
        srcn = r->srcn;
    }
    node = c.self;
    base = wb->nbd = 0;
    c.src = src;
    c.srcn = srcn;
    x = wb_parse(wb, src, srcn);
    x = bd(&c, x);
    /* owner-row edges from inside aggregates */
    {
        uint32_t i;
        for (i = 0; i < c.nodep; i++) bd_dep(&c, c.odeps[i], c.odsh[i]);
    }
    n = bd_uniq(wb, base);
    {
        WGNode *g = &wb->g[node];
        g->deps = (uint32_t *)wb_ma(wb, (size_t)(n ? n : 1) * sizeof(uint32_t));
        g->dsh = (uint8_t *)wb_ma(wb, n ? n : 1);
        g->ndeps = 0;
        if (g->deps && g->dsh && n) {
            memcpy(g->deps, wb->bdeps + base, n * sizeof(uint32_t));
            memcpy(g->dsh, wb->bdsh + base, n);
            g->ndeps = n;
        }
    }
    wb->nbd = 0;
    if (kind == BK_NAME) {
        WName *nm = &wb->names[ref];
        nm->ex = x;
        nm->aggs = NULL;
        nm->naggs = 0;
        if (c.naggs) {
            nm->aggs = (uint32_t *)wb_ma(wb, c.naggs * sizeof(uint32_t));
            if (nm->aggs) {
                memcpy(nm->aggs, c.aggs, c.naggs * sizeof(uint32_t));
                nm->naggs = c.naggs;
            }
        }
    } else {
        WRule *r = &wb->rules[ref];
        r->ex = x;
        r->rowmask = c.rowmask;
        r->relmask = c.relmask;
        r->relmin = c.relmin;
        r->relmax = c.relmax;
        r->aggs = NULL;
        r->naggs = 0;
        if (c.naggs) {
            r->aggs = (uint32_t *)wb_ma(wb, c.naggs * sizeof(uint32_t));
            if (r->aggs) {
                memcpy(r->aggs, c.aggs, c.naggs * sizeof(uint32_t));
                r->naggs = c.naggs;
            }
        }
        r->nin = n;
    }
    wb->graph_dirty = 1;
}


/* --------------------------------------------------------------- evaluator
 *
 * Values are computed on demand: a row's cells from its bytes (a per-row
 * memo holds them for one evaluation), names and aggregate instances from
 * their stored values. `old` mode sees the workbook before the edit being
 * synced: the edited table's captured rows (the overlay), every other row
 * at its old place, every stored value as it was (nothing is updated
 * until the old side is computed).
 */

typedef struct ECtx {
    RtxWb *wb;
    int old;                 /* old mode (the overlay) */
    int32_t self_tab;        /* the cell evaluating (error labels): table */
    int32_t self_pos;        /* ... its row (-1: the rule, no row) */
    int32_t self_col;
    uint32_t self_name;      /* the name evaluating (WN32: none) */
    WRow *own;               /* own row (a rule) */
    int32_t it_tab;          /* iterated table (aggregates, lookups) */
    WRow *it;
    const WAgg *pagg;        /* an instance's parameters stand for the owner row */
    const WVal *pv;
    uint8_t view;            /* the view is asking: chains past the frontier stay within a budget */
    uint8_t stale;           /* out: something read was stale */
    uint8_t nolast;          /* out: ... and had no last value */
    uint8_t oldfail;         /* out: old mode could not see the old state */
    CCArena ar;              /* transient text */
    int depth;
} ECtx;

static WVal wb_imp_read(ECtx *c, const Ex *e);
static void wb_imp_update(RtxWb *wb, uint32_t v);

static void ectx_init(ECtx *c, RtxWb *wb) {
    memset(c, 0, sizeof *c);
    c->wb = wb;
    c->self_tab = c->self_col = -1;
    c->self_pos = -1;
    c->self_name = WN32;
    c->it_tab = -1;
    c->ar = wb->sa;
}

static size_t wb_name_label(const RtxWb *wb, uint32_t ni, char *out, size_t cap) {
    const WName *n = &wb->names[ni];
    size_t at = 0;
    if (out && cap) out[0] = 0;
    if (n->scope > 0 && (uint32_t)n->scope < wb->nsheet) {
        at = wb_put(out, cap, at, wb->sheets[n->scope], wb->sheetn[n->scope]);
        at = wb_puts(out, cap, at, ".");
    }
    return wb_put(out, cap, at, n->name, n->namen);
}

/* `T.col[row]` (row 1-based; pos < 0: `T.col`). */
static size_t wb_cell_label(const RtxWb *wb, int32_t tab, int32_t pos, int32_t col, char *out,
                            size_t cap) {
    const WTab *t = &wb->tabs[tab];
    char b[24];
    size_t at = 0;
    if (out && cap) out[0] = 0;
    at = wb_put(out, cap, at, t->name, t->namen);
    at = wb_puts(out, cap, at, ".");
    at = wb_put(out, cap, at, t->cname[col], t->cnamen[col]);
    if (pos >= 0) {
        snprintf(b, sizeof b, "[%d]", (int)pos + 1);
        at = wb_puts(out, cap, at, b);
    }
    return at;
}

static const char *wb_self_label(ECtx *c, char *b, size_t n) {
    if (c->self_name != WN32) {
        wb_name_label(c->wb, c->self_name, b, n);
        return b;
    }
    if (c->self_tab >= 0 && c->self_col >= 0) {
        wb_cell_label(c->wb, c->self_tab, c->self_pos, c->self_col, b, n);
        return b;
    }
    return "eval";
}

static WVal ev_err(ECtx *c, int code, const char *what) {
    char lb[160];
    return wv_err_a(c->ar, code, "%s in %s", what, wb_self_label(c, lb, sizeof lb));
}

static WVal wv_text_c(ECtx *c, const char *s, size_t n) {
    return wv_text_a(c->ar, s, n);
}

/* ------------------------------------------------------------ row access */

/* Old mode: the row at old position p of table `tab` — its bytes' current
 * place (rows after the edit moved by its delta) or the overlay. */
static const char *wb_row_bytes_old(RtxWb *wb, int32_t tab, uint32_t p, uint32_t *n) {
    const WOver *ov = &wb->ov;
    const WTab *t = &wb->tabs[tab];
    if (ov->on && ov->tab == tab && p >= ov->a && p < ov->a + ov->nold) {
        const WCap *cp = &wb->cap;
        uint32_t k = p - cp->pos, lo = cp->roff[k], hi = cp->roff[k + 1];
        if (hi > lo && cp->b[hi - 1] == '\n') hi--;
        if (hi > lo && cp->b[hi - 1] == '\r') { /* keep: row_split trims CR */ }
        *n = hi - lo;
        return cp->b + lo;
    }
    {
        size_t lo = tb_row_lo(t, p);
        uint32_t len = tb_row_len(t, p);
        char *buf;
        if (ov->on && ov->delta && lo >= ov->old_end) lo = (size_t)((ptrdiff_t)lo + ov->delta);
        buf = (char *)cc_arena_alloc(wb->sa, (size_t)len + 1, 1);
        if (!buf) {
            *n = 0;
            return "";
        }
        if (wb_read(wb->doc, lo, buf, len) != len) len = 0;
        buf[len] = 0;
        *n = len;
        return buf;
    }
}

/* Rows in old mode: the table's row count before the edit. */
static uint32_t wb_nrows_mode(const RtxWb *wb, int32_t tab, int old) {
    const WTab *t = &wb->tabs[tab];
    (void)old;
    return t->nrows; /* the index is updated after the old side is computed */
}

/* Fill a row context for (tab, pos) in the mode. */
static void wb_row_load(RtxWb *wb, WRow *r, int32_t tab, uint32_t pos, int old) {
    const WTab *t = &wb->tabs[tab];
    memset(r, 0, offsetof(WRow, v));
    r->tab = tab;
    r->pos = (int32_t)pos;
    r->old = (uint8_t)old;
    if (t->ext) {
        /* a CSV record: no edits reach it, old and new are one */
        r->rid = tb_row_rid(t, pos);
        r->b = wb_row_read(wb, t, pos, &r->n);
        if (t->csv) wb_row_split_csv(r, t->csv, t->ncols);
        return;
    }
    if (old) {
        const WOver *ov = &wb->ov;
        if (ov->on && ov->tab == tab && pos >= ov->a && pos < ov->a + ov->nold)
            r->rid = wb->cap.rid[pos - wb->cap.pos];
        else
            r->rid = tb_row_rid(t, pos);
        r->b = wb_row_bytes_old(wb, tab, pos, &r->n);
    } else {
        r->rid = tb_row_rid(t, pos);
        r->b = wb_row_read(wb, t, pos, &r->n);
    }
    wb_row_split(r);
}

static WRow *wb_ring_get(ECtx *c, int32_t tab, uint32_t pos);

static WVal ev(ECtx *c, const Ex *e);

/* ---- value operations (W2) */

static int wv_num(const WVal *v) {
    return v->t == WV_INT || v->t == WV_DEC || v->t == WV_FLOAT;
}

static double wv_tod(const WVal *v) {
    if (v->t == WV_FLOAT) return v->u.f;
    if (v->t == WV_DEC) return (double)v->u.i / (double)g_pow10[v->sc];
    return (double)v->u.i;
}

static int wv_same(const WVal *a, const WVal *b) {
    if (a->t != b->t) return 0;
    switch (a->t) {
    case WV_NULL:
        return 1;
    case WV_INT:
    case WV_BOOL:
    case WV_DATE:
        return a->u.i == b->u.i;
    case WV_DEC:
        return a->sc == b->sc && a->u.i == b->u.i;
    case WV_FLOAT:
        return memcmp(&a->u.f, &b->u.f, sizeof(double)) == 0;
    case WV_TEXT:
        return a->n == b->n && (!a->n || memcmp(a->u.s, b->u.s, a->n) == 0);
    case WV_ERR:
        return a->code == b->code && a->n == b->n && (!a->n || memcmp(a->u.s, b->u.s, a->n) == 0);
    case WV_ROW:
        return a->code == b->code && a->u.i == b->u.i;
    case WV_GRP:
        return a->u.i == b->u.i && a->n == b->n && a->code == b->code;
    default:
        return 1;
    }
}

/* -1 / 0 / 1; *ok = 0 when the two do not compare (different kinds). */
static int wv_cmp(const WVal *a, const WVal *b, int *ok) {
    *ok = 1;
    if (wv_num(a) && wv_num(b)) {
        if (a->t == WV_FLOAT || b->t == WV_FLOAT) {
            double x = wv_tod(a), y = wv_tod(b);
            return x < y ? -1 : x > y;
        }
        {
            int sa = a->t == WV_DEC ? a->sc : 0, sb = b->t == WV_DEC ? b->sc : 0;
            int s = sa > sb ? sa : sb;
            __int128 x = (__int128)a->u.i * g_pow10[s - sa];
            __int128 y = (__int128)b->u.i * g_pow10[s - sb];
            return x < y ? -1 : x > y;
        }
    }
    if (a->t != b->t) {
        *ok = 0;
        return 0;
    }
    if (a->t == WV_TEXT) {
        size_t m = a->n < b->n ? a->n : b->n;
        int r = m ? memcmp(a->u.s, b->u.s, m) : 0;
        if (r) return r < 0 ? -1 : 1;
        return a->n < b->n ? -1 : a->n > b->n;
    }
    if (a->t == WV_DATE || a->t == WV_BOOL) return a->u.i < b->u.i ? -1 : a->u.i > b->u.i;
    if (a->t == WV_NULL) return 0;
    *ok = 0;
    return 0;
}

static const char *wv_kind(const WVal *v) {
    static const char *const k[] = {"null", "int", "dec", "float", "bool", "date", "text",
                                    "error", "row", "table", "group"};
    return v->t <= WV_GRP ? k[v->t] : "?";
}

/* An exact int / dec result at scale sc: past 12 fraction digits it is
 * rounded once, half away from zero, to 12 (never digit by digit: that
 * rounds twice); past int64 it is #num. */
static WVal wv_fit(ECtx *c, __int128 x, int sc) {
    if (sc > 12) {
        __int128 p = 1, q, r;
        int k;
        for (k = 12; k < sc; k++) p *= 10; /* sc <= 36: p <= 10^24 */
        q = x / p;
        r = x % p;
        if (r >= 0 ? r * 2 >= p : -r * 2 >= p) q += x < 0 ? -1 : 1;
        x = q;
        sc = 12;
    }
    if (x > INT64_MAX || x < INT64_MIN) return ev_err(c, WE_NUM, "number too large");
    return wv_dec((int64_t)x, sc);
}

static WVal wv_arith(ECtx *c, int op, const WVal *a, const WVal *b) {
    char msg[96];
    if (a->t == WV_NULL || b->t == WV_NULL) return wv_null();
    if (a->t == WV_DATE || b->t == WV_DATE) {
        int64_t r;
        int of = 0, kind = 0;
        if (op == '+' && ((a->t == WV_DATE && b->t == WV_INT) || (a->t == WV_INT && b->t == WV_DATE))) {
            of = __builtin_add_overflow(a->u.i, b->u.i, &r);
            kind = 1;
        } else if (op == '-' && a->t == WV_DATE && (b->t == WV_INT || b->t == WV_DATE)) {
            of = __builtin_sub_overflow(a->u.i, b->u.i, &r);
            kind = b->t == WV_DATE ? 2 : 1;
        }
        /* a day past +-25 million years is no date either */
        if (kind == 1 && (of || r > 9131132000LL || r < -9131132000LL))
            return ev_err(c, WE_NUM, "date out of range");
        if (kind == 2 && of) return ev_err(c, WE_NUM, "number too large");
        if (kind == 1) return wv_date(r);
        if (kind == 2) return wv_int(r);
        snprintf(msg, sizeof msg, "%s %c %s", wv_kind(a), op, wv_kind(b));
        return ev_err(c, WE_TYPE, msg);
    }
    if (!wv_num(a) || !wv_num(b)) {
        snprintf(msg, sizeof msg, "%s %c %s", wv_kind(a), op, wv_kind(b));
        return ev_err(c, WE_TYPE, msg);
    }
    if (op == '/') {
        double y = wv_tod(b);
        if (y == 0) return ev_err(c, WE_DIV0, "division by zero");
        return wv_float(wv_tod(a) / y);
    }
    if (a->t == WV_FLOAT || b->t == WV_FLOAT) {
        double x = wv_tod(a), y = wv_tod(b);
        if (op == '+') return wv_float(x + y);
        if (op == '-') return wv_float(x - y);
        if (op == '*') return wv_float(x * y);
        if (y == 0) return ev_err(c, WE_DIV0, "division by zero");
        return wv_float(wb_fmod(x, y));
    }
    {
        int sa = a->t == WV_DEC ? a->sc : 0, sb = b->t == WV_DEC ? b->sc : 0;
        int s = sa > sb ? sa : sb;
        __int128 x = (__int128)a->u.i * g_pow10[s - sa];
        __int128 y = (__int128)b->u.i * g_pow10[s - sb];
        if (op == '+') return wv_fit(c, x + y, s);
        if (op == '-') return wv_fit(c, x - y, s);
        if (op == '*') return wv_fit(c, (__int128)a->u.i * b->u.i, sa + sb);
        if (y == 0) return ev_err(c, WE_DIV0, "division by zero");
        return wv_fit(c, x % y, s);
    }
}

static WVal wv_concat(ECtx *c, const WVal *a, const WVal *b) {
    char x[256], y[256], buf[512];
    size_t xn = wv_fmt(a, x, sizeof x, 0), yn = wv_fmt(b, y, sizeof y, 0);
    memcpy(buf, x, xn);
    memcpy(buf + xn, y, yn);
    return wv_text_c(c, buf, xn + yn);
}

static WVal wv_row_err(ECtx *c, const WVal *v) {
    if (v->t == WV_ROW) return ev_err(c, WE_TYPE, "a row is not a value (add .column)");
    return ev_err(c, WE_TYPE, "a table is not a value (count it, or T[condition].column)");
}

static WVal ev_bin(ECtx *c, const Ex *e) {
    WVal a, b;
    int op = e->bin;
    if (op == 'a' || op == 'o') {
        a = ev(c, e->a);
        if (a.t == WV_ERR) return a;
        if (a.t != WV_BOOL && a.t != WV_NULL)
            return ev_err(c, WE_TYPE, "and / or need true / false");
        if (op == 'a' && a.t == WV_BOOL && !a.u.i) return wv_bool(0);
        if (op == 'o' && a.t == WV_BOOL && a.u.i) return wv_bool(1);
        b = ev(c, e->b);
        if (b.t == WV_ERR) return b;
        if (b.t != WV_BOOL && b.t != WV_NULL)
            return ev_err(c, WE_TYPE, "and / or need true / false");
        return wv_bool(b.t == WV_BOOL && b.u.i);
    }
    a = ev(c, e->a);
    if (a.t == WV_ERR) return a;
    b = ev(c, e->b);
    if (b.t == WV_ERR) return b;
    if (a.t == WV_ROW || a.t == WV_TAB) return wv_row_err(c, &a);
    if (b.t == WV_ROW || b.t == WV_TAB) return wv_row_err(c, &b);
    if (op == '&') return wv_concat(c, &a, &b);
    if (op == '=' || op == OP_NE || op == '<' || op == OP_LE || op == '>' || op == OP_GE) {
        int ok, r;
        if (a.t == WV_NULL || b.t == WV_NULL) return wv_null();
        /* NaN is unordered (IEEE): = false, != true, every ordering false */
        if ((a.t == WV_FLOAT && a.u.f != a.u.f) || (b.t == WV_FLOAT && b.u.f != b.u.f)) {
            if (!wv_num(&a) || !wv_num(&b)) {
                char msg[64];
                snprintf(msg, sizeof msg, "cannot compare %s with %s", wv_kind(&a), wv_kind(&b));
                return ev_err(c, WE_TYPE, msg);
            }
            return wv_bool(op == OP_NE);
        }
        r = wv_cmp(&a, &b, &ok);
        if (!ok) {
            char msg[64];
            snprintf(msg, sizeof msg, "cannot compare %s with %s", wv_kind(&a), wv_kind(&b));
            return ev_err(c, WE_TYPE, msg);
        }
        switch (op) {
        case '=':
            return wv_bool(r == 0);
        case OP_NE:
            return wv_bool(r != 0);
        case '<':
            return wv_bool(r < 0);
        case OP_LE:
            return wv_bool(r <= 0);
        case '>':
            return wv_bool(r > 0);
        default:
            return wv_bool(r >= 0);
        }
    }
    return wv_arith(c, op, &a, &b);
}

static size_t wb_utf8_count(const char *s, size_t n) {
    size_t i, k = 0;
    for (i = 0; i < n; i++)
        if (((unsigned char)s[i] & 0xC0) != 0x80) k++;
    return k;
}

static WVal ev_fn(ECtx *c, const Ex *e) {
    WVal a;
    uint16_t i;
    int fn = e->fn;
    if (fn == FN_COALESCE) {
        for (i = 0; i < e->nargs; i++) {
            a = ev(c, e->args[i]);
            if (a.t != WV_NULL) return a;
        }
        return wv_null();
    }
    if (fn == FN_MIN2 || fn == FN_MAX2) {
        WVal best = wv_null();
        for (i = 0; i < e->nargs; i++) {
            int ok, k;
            a = ev(c, e->args[i]);
            if (a.t == WV_ERR) return a;
            if (a.t == WV_NULL) continue;
            if (a.t == WV_FLOAT && a.u.f != a.u.f) {
                /* NaN: the result, as for min / max over a column */
                if (best.t != WV_NULL && !wv_num(&best)) return ev_err(c, WE_TYPE, "min / max over mixed kinds");
                best = a;
                continue;
            }
            if (best.t == WV_FLOAT && best.u.f != best.u.f) {
                if (!wv_num(&a)) return ev_err(c, WE_TYPE, "min / max over mixed kinds");
                continue;
            }
            if (best.t == WV_NULL) {
                best = a;
                continue;
            }
            k = wv_cmp(&a, &best, &ok);
            if (!ok) return ev_err(c, WE_TYPE, "min / max over mixed kinds");
            if ((fn == FN_MIN2 && k < 0) || (fn == FN_MAX2 && k > 0)) best = a;
        }
        return best;
    }
    if (fn == FN_ISERROR) {
        a = ev(c, e->args[0]);
        return wv_bool(a.t == WV_ERR);
    }
    if (fn == FN_IFERROR) {
        a = ev(c, e->args[0]);
        return a.t == WV_ERR ? ev(c, e->args[1]) : a;
    }
    a = ev(c, e->args[0]);
    if (a.t == WV_ERR || a.t == WV_NULL) return a;
    if (a.t == WV_ROW || a.t == WV_TAB) return wv_row_err(c, &a);
    switch (fn) {
    case FN_ABS:
        if (!wv_num(&a)) return ev_err(c, WE_TYPE, "abs needs a number");
        if (a.t == WV_FLOAT) return wv_float(fabs(a.u.f));
        if (a.u.i == INT64_MIN) return ev_err(c, WE_NUM, "number too large");
        a.u.i = a.u.i < 0 ? -a.u.i : a.u.i;
        return a;
    case FN_ROUND: {
        int64_t nd = 0;
        if (!wv_num(&a)) return ev_err(c, WE_TYPE, "round needs a number");
        if (e->nargs > 1) {
            WVal b = ev(c, e->args[1]);
            if (b.t == WV_ERR) return b;
            if (b.t != WV_INT || b.u.i < 0 || b.u.i > 12)
                return ev_err(c, WE_NUM, "round digits are 0..12");
            nd = b.u.i;
        }
        if (a.t == WV_FLOAT) {
            double p = (double)g_pow10[nd];
            return wv_float(wb_round(a.u.f * p) / p);
        }
        {
            int sc = a.t == WV_DEC ? a.sc : 0;
            __int128 x = a.u.i;
            if (nd >= sc) return wv_fit(c, x * g_pow10[nd - sc], (int)nd);
            {
                int64_t p = g_pow10[sc - nd];
                __int128 q = x / p, r = x % p;
                if (r * 2 >= p) q++;
                else if (r * 2 <= -p) q--;
                return wv_fit(c, q, (int)nd);
            }
        }
    }
    case FN_FLOOR:
    case FN_CEIL:
        if (!wv_num(&a)) return ev_err(c, WE_TYPE, "floor / ceil need a number");
        if (a.t == WV_FLOAT) {
            double f = fn == FN_FLOOR ? wb_floor(a.u.f) : wb_ceil(a.u.f);
            if (f >= -9.2e18 && f <= 9.2e18) return wv_int((int64_t)f);
            return wv_float(f);
        }
        if (a.t == WV_DEC) {
            int64_t p = g_pow10[a.sc], q = a.u.i / p, r = a.u.i % p;
            if (fn == FN_FLOOR && r < 0) q--;
            if (fn == FN_CEIL && r > 0) q++;
            return wv_int(q);
        }
        return a;
    case FN_LEN:
        if (a.t != WV_TEXT) return ev_err(c, WE_TYPE, "len needs text");
        return wv_int((int64_t)wb_utf8_count(a.u.s, a.n));
    case FN_LOWER:
    case FN_UPPER: {
        char *p;
        uint32_t k;
        if (a.t != WV_TEXT) return ev_err(c, WE_TYPE, "lower / upper need text");
        a = wv_text_c(c, a.u.s, a.n);
        p = (char *)a.u.s;
        for (k = 0; k < a.n; k++) {
            if (fn == FN_LOWER && p[k] >= 'A' && p[k] <= 'Z') p[k] = (char)(p[k] + 32);
            if (fn == FN_UPPER && p[k] >= 'a' && p[k] <= 'z') p[k] = (char)(p[k] - 32);
        }
        return a;
    }
    default:
        return ev_err(c, WE_NAME, "unknown function");
    }
}


/* ---- rows other formulas read: a bounded ring per operation */

static WRow *wb_ring_get(ECtx *c, int32_t tab, uint32_t pos) {
    RtxWb *wb = c->wb;
    uint32_t i, victim = WN32, vu = WN32;
    int old = c->old;
    if (!wb->ring) {
        wb->ring = (WRow *)calloc(RTX_WB_RING, sizeof(WRow));
        wb->ring_gen = (uint32_t *)calloc(RTX_WB_RING, sizeof(uint32_t));
        wb->ring_used = (uint32_t *)calloc(RTX_WB_RING, sizeof(uint32_t));
        if (!wb->ring || !wb->ring_gen || !wb->ring_used) return NULL;
    }
    for (i = 0; i < RTX_WB_RING; i++) {
        WRow *r = &wb->ring[i];
        if (wb->ring_gen[i] != wb->opgen) {
            if (victim == WN32 || vu != 0) {
                victim = i;
                vu = 0;
            }
            continue;
        }
        if (r->tab == tab && r->pos == (int32_t)pos && r->old == (uint8_t)old) {
            wb->ring_used[i] = ++wb->ring_clock;
            return r;
        }
        if (vu != 0 && (victim == WN32 || wb->ring_used[i] < vu)) {
            /* in progress: not a victim */
            int busy = 0, k;
            for (k = 0; k < r->nc && !busy; k++) busy = r->st[k] == 1;
            if (!busy) {
                victim = i;
                vu = wb->ring_used[i];
            }
        }
    }
    if (victim == WN32) return NULL;
    wb_row_load(wb, &wb->ring[victim], tab, pos, old);
    wb->ring_gen[victim] = wb->opgen;
    wb->ring_used[victim] = ++wb->ring_clock;
    return &wb->ring[victim];
}

/* ---- anchors */

static int wb_is_first(const char *s, uint32_t n) {
    return n == 5 && !memcmp(s, "first", 5);
}

static int wb_is_last(const char *s, uint32_t n) {
    return n == 4 && !memcmp(s, "last", 4);
}

/* The position an anchor (+ off) names in `tab`: >= 0; -1 an error in
 * *err (missing / duplicate anchor); -2 outside the table (null). */
static int32_t wb_anchor_pos(ECtx *c, int32_t tab, const char *anc, uint32_t ancn, int32_t off,
                             WVal *err) {
    RtxWb *wb = c->wb;
    const WTab *t = &wb->tabs[tab];
    int32_t n = (int32_t)wb_nrows_mode(wb, tab, c->old), base;
    if (wb_is_first(anc, ancn)) {
        if (!n) return -2;
        base = 0;
    } else if (wb_is_last(anc, ancn)) {
        if (!n) return -2;
        base = n - 1;
    } else {
        WKey k;
        uint32_t ids[2], cnt;
        wb_anc_key(anc, ancn, &k);
        cnt = kx_ids(&t->anc, &k, ids, 2);
        if (!cnt) {
            char msg[200];
            snprintf(msg, sizeof msg, "anchor %.*s not found in %.*s", (int)ancn, anc, (int)t->namen,
                     t->name);
            *err = wv_err_a(c->ar, WE_REF, "%s", msg);
            return -1;
        }
        if (cnt > 1) {
            /* the first two rows in table order (the message is the same
             * however the rows arrived) */
            char msg[200];
            int32_t p0 = INT32_MAX, p1 = INT32_MAX;
            uint32_t *all = cnt > 2 ? (uint32_t *)cc_arena_alloc(wb->sa, cnt * sizeof(uint32_t), 16) : ids;
            uint32_t q, got = all ? kx_ids(&t->anc, &k, all, cnt) : 0;
            if (!all) {
                all = ids;
                got = 2;
            }
            for (q = 0; q < got && q < cnt; q++) {
                int32_t p = tb_rid_pos(t, all[q]);
                if (p < 0) continue;
                if (p < p0) {
                    p1 = p0;
                    p0 = p;
                } else if (p < p1) {
                    p1 = p;
                }
            }
            snprintf(msg, sizeof msg, "anchor %.*s names rows %d and %d of %.*s", (int)ancn, anc,
                     (int)p0 + 1, (int)p1 + 1, (int)t->namen, t->name);
            *err = wv_err_a(c->ar, WE_DUP, "%s", msg);
            return -1;
        }
        base = tb_rid_pos(t, ids[0]);
        if (base < 0) {
            *err = ev_err(c, WE_REF, "anchor row lost");
            return -1;
        }
    }
    base += off;
    if (base < 0 || base >= n) return -2;
    return base;
}

/* ---- a row's cells */

static WVal wb_cell_eval(ECtx *c, WRow *r, int col);
static WVal wb_chain_val(ECtx *c, int32_t tab, int32_t pos, int col);
static int wb_rule_find(RtxWb *wb, int32_t tab, int32_t col, const char *s, uint32_t n);

/* A same-row cycle through cell `col` of row r: every member (its
 * strongly connected cells, W0's cycle) gets #cycle(path), the path from
 * the member first in the row. */
static WVal wb_row_cycle(ECtx *c, WRow *r, int col) {
    RtxWb *wb = c->wb;
    const WTab *t = &wb->tabs[r->tab];
    uint16_t dep[RTX_WB_COLS_MAX];
    int ncol = r->nc < t->ncols ? r->nc : t->ncols;
    int idx[RTX_WB_COLS_MAX], low[RTX_WB_COLS_MAX], stk[RTX_WB_COLS_MAX], on[RTX_WB_COLS_MAX];
    int comp[RTX_WB_COLS_MAX], sp = 0, next = 0, k, s0 = -1;
    char path[400], lb[96];
    size_t at = 0;
    WVal ev_;
    memset(dep, 0, sizeof dep);
    for (k = 0; k < ncol; k++) {
        size_t lo, hi, slo, shi, flo, fhi;
        int ri;
        idx[k] = -1;
        on[k] = 0;
        comp[k] = -1;
        if (!wb_cell_span(r, k, &lo, &hi)) continue;
        if (!wb_cell_formula(r->b, lo, hi, &slo, &shi, &flo, &fhi)) continue;
        ri = wb_rule_find(wb, r->tab, k, r->b + slo, (uint32_t)(shi - slo));
        if (ri >= 0) dep[k] = wb->rules[ri].rowmask;
    }
    /* Tarjan over the row's cells (recursive: at most 16) */
    {
        int fs[RTX_WB_COLS_MAX], fi[RTX_WB_COLS_MAX], fp = 0, v;
        for (v = 0; v < ncol; v++) {
            if (idx[v] >= 0) continue;
            fs[fp] = v;
            fi[fp++] = 0;
            idx[v] = low[v] = next++;
            stk[sp++] = v;
            on[v] = 1;
            while (fp) {
                int x = fs[fp - 1];
                if (fi[fp - 1] < ncol) {
                    int w = fi[fp - 1]++;
                    if (!(dep[x] & (1u << w))) continue;
                    if (idx[w] < 0) {
                        idx[w] = low[w] = next++;
                        stk[sp++] = w;
                        on[w] = 1;
                        fs[fp] = w;
                        fi[fp++] = 0;
                    } else if (on[w] && idx[w] < low[x]) {
                        low[x] = idx[w];
                    }
                    continue;
                }
                if (low[x] == idx[x]) {
                    int w;
                    do {
                        w = stk[--sp];
                        on[w] = 0;
                        comp[w] = x;
                    } while (w != x);
                }
                fp--;
                if (fp) {
                    int p = fs[fp - 1];
                    if (low[x] < low[p]) low[p] = low[x];
                }
            }
        }
    }
    for (k = 0; k < ncol; k++)
        if (comp[k] == comp[col]) {
            s0 = k;
            break;
        }
    /* BFS from s0 back to s0 inside the component (deps in column order) */
    {
        int par[RTX_WB_COLS_MAX], q[RTX_WB_COLS_MAX], qh = 0, qt = 0, last = -1, v, w, np = 0;
        int pth[RTX_WB_COLS_MAX + 1];
        for (k = 0; k < RTX_WB_COLS_MAX; k++) par[k] = -1;
        par[s0] = s0;
        q[qt++] = s0;
        while (qh < qt && last < 0) {
            v = q[qh++];
            for (w = 0; w < ncol; w++) {
                if (!(dep[v] & (1u << w)) || comp[w] != comp[s0]) continue;
                if (w == s0) {
                    last = v;
                    break;
                }
                if (par[w] >= 0) continue;
                par[w] = v;
                q[qt++] = w;
            }
        }
        v = last;
        while (v >= 0 && np < RTX_WB_COLS_MAX) {
            pth[np++] = v;
            if (v == s0) break;
            v = par[v];
        }
        for (k = np - 1; k >= 0; k--) {
            wb_cell_label(wb, r->tab, r->pos, pth[k], lb, sizeof lb);
            at = wb_puts(path, sizeof path, at, lb);
            at = wb_puts(path, sizeof path, at, " \xe2\x86\x92 ");
        }
        wb_cell_label(wb, r->tab, r->pos, s0, lb, sizeof lb);
        at = wb_puts(path, sizeof path, at, lb);
    }
    ev_ = wv_err_a(c->ar, WE_CYCLE, "%s", path);
    for (k = 0; k < ncol; k++) {
        if (comp[k] != comp[s0]) continue;
        /* a cycle of one cell without a self edge is no cycle */
        if (k == s0 && !(dep[k] & (1u << k))) {
            int m, many = 0;
            for (m = 0; m < ncol; m++) many += m != k && comp[m] == comp[s0];
            if (!many) continue;
        }
        r->v[k] = ev_;
        r->st[k] = 2;
    }
    return ev_;
}

/* A rule's static cycle value, or NULL. */
static const WVal *wb_rule_cyc(const RtxWb *wb, const WRule *ru) {
    const WGNode *g = &wb->g[ru->node];
    return g->cyc ? &wb->cyv[g->cyi] : NULL;
}

/* Cell `col` of row r: its literal, or its rule evaluated in the row. */
static WVal wb_cell_eval(ECtx *c, WRow *r, int col) {
    RtxWb *wb = c->wb;
    const WTab *t = &wb->tabs[r->tab];
    size_t lo, hi, slo, shi, flo, fhi;
    WVal v;
    if (col < 0 || col >= RTX_WB_COLS_MAX) return wv_null();
    if (r->st[col] == 2) {
        if (r->stl[col]) c->stale = 1;
        return r->v[col];
    }
    if (r->st[col] == 1) return wb_row_cycle(c, r, col);
    if (col >= t->ncols || !wb_cell_span(r, col, &lo, &hi)) {
        r->st[col] = 2;
        r->v[col] = wv_null();
        return r->v[col];
    }
    if (r->csv) {
        /* a CSV field: a literal (a leading = is text), unquoted */
        const WCsv *cv = t->csv;
        if (cv && cv->cmap[col] < 0) {
            v = cv->cerr[col];
        } else {
            uint32_t n;
            int sc = 0, lk;
            const char *p = wb_csv_text(c->ar, r->b, lo, hi, r->quote, &n);
            lk = wb_lit_kind(p, n, &sc);
            v = wb_lit_value(c->ar, p, n, lk, t->ct[col], t->csc[col]);
        }
        r->v[col] = v;
        r->st[col] = 2;
        return v;
    }
    if (wb_cell_formula(r->b, lo, hi, &slo, &shi, &flo, &fhi)) {
        int ri = wb_rule_find(wb, r->tab, col, r->b + slo, (uint32_t)(shi - slo));
        const WVal *cy;
        if (ri < 0) {
            v = ev_err(c, WE_PARSE, "formula not bound (reparse pending)");
        } else if ((cy = wb_rule_cyc(wb, &wb->rules[ri])) != NULL) {
            v = *cy;
        } else if (c->depth > 200) {
            v = ev_err(c, WE_NUM, "formula nesting too deep");
        } else {
            ECtx e = *c;
            uint8_t st0 = c->stale;
            r->st[col] = 1;
            e.self_tab = r->tab;
            e.self_pos = r->pos;
            e.self_col = col;
            e.self_name = WN32;
            e.own = r;
            e.it_tab = -1;
            e.it = NULL;
            e.pagg = NULL;
            e.pv = NULL;
            e.stale = 0;
            e.depth = c->depth + 1;
            v = ev(&e, wb->rules[ri].ex);
            if (v.t == WV_ROW || v.t == WV_TAB) v = wv_row_err(&e, &v);
            c->nolast |= e.nolast;
            c->oldfail |= e.oldfail;
            if (r->st[col] == 2) {
                /* a same-row cycle set it while we were inside */
                if (e.stale) r->stl[col] = 1;
                c->stale = st0 | e.stale | r->stl[col];
                return r->v[col];
            }
            r->stl[col] = e.stale;
            c->stale = st0 | e.stale;
        }
    } else {
        uint32_t n;
        int sc = 0, lk;
        const char *p = wb_lit_text(c->ar, r->b, lo, hi, &n);
        lk = wb_lit_kind(p, n, &sc);
        v = wb_lit_value(c->ar, p, n, lk, t->ct[col], t->csc[col]);
    }
    r->v[col] = v;
    r->st[col] = 2;
    return v;
}

/* ---- aggregates read by formulas (instances); defined with them */

static WVal ev_agg_node(ECtx *c, const Ex *e);
static WVal ev_group_node(ECtx *c, const Ex *e);
static WVal ev_glookup(ECtx *c, const Ex *e);
static WVal ev_agg_scan(ECtx *c, const Ex *e);
static WVal ev_lookup(ECtx *c, const Ex *e);

/* The anchored cell (graph node, or resolved now for an eval). */
static WVal ev_abs(ECtx *c, const Ex *e) {
    RtxWb *wb = c->wb;
    WVal err;
    int32_t p;
    WRow *r;
    if (e->node != WN32) {
        const WAbs *x = &wb->abs[e->node];
        if (x->pend) {
            c->stale = 1;
        }
        return x->v;
    }
    p = wb_anchor_pos(c, e->tab, e->a->id2, e->a->id2n, (int32_t)e->v.u.i, &err);
    if (p == -1) return err;
    if (p < 0) return wv_null();
    r = wb_ring_get(c, e->tab, (uint32_t)p);
    if (!r) return ev_err(c, WE_NUM, "out of memory");
    return wb_cell_eval(c, r, e->col);
}

/* An owner-row cell (@col): the instance's parameter when one stands for
 * it, else the own row's cell. */
static WVal ev_own(ECtx *c, int col) {
    if (c->pagg && c->pv && (c->pagg->pmask & (1u << col))) {
        int k, j = 0;
        for (k = 0; k < col; k++)
            if (c->pagg->pmask & (1u << k)) j++;
        return c->pv[j];
    }
    if (!c->own) return ev_err(c, WE_REF, "@column needs a table row");
    return wb_cell_eval(c, c->own, col);
}

/* @col[k]: row own + k (null outside the table). */
static WVal ev_rel(ECtx *c, const Ex *e) {
    RtxWb *wb = c->wb;
    int32_t k = (int32_t)e->node, p;
    const WTab *t;
    WRow *r;
    if (!c->own) return ev_err(c, WE_REF, "@column[k] needs a table row");
    t = &wb->tabs[c->own->tab];
    p = c->own->pos + k;
    if (p < 0 || p >= (int32_t)wb_nrows_mode(wb, c->own->tab, c->old)) return wv_null();
    if (t->ch.on && (t->ch.cols & (1u << e->col)) && !c->old)
        return wb_chain_val(c, c->own->tab, p, e->col);
    r = wb_ring_get(c, c->own->tab, (uint32_t)p);
    if (!r) return ev_err(c, WE_NUM, "out of memory");
    return wb_cell_eval(c, r, e->col);
}

static WVal ev(ECtx *c, const Ex *e) {
    RtxWb *wb = c->wb;
    if (!e) return wv_null();
    switch (e->op) {
    case EX_LIT:
    case EX_ERR:
        return e->v;
    case EX_NAMEREF: {
        const WName *n = &wb->names[e->node];
        if (n->pend) c->stale = 1;
        return n->v;
    }
    case EX_ATCELL:
        return ev_own(c, e->col);
    case EX_RELCELL:
        return ev_rel(c, e);
    case EX_COL:
        if (c->it_tab == e->tab && c->it) return wb_cell_eval(c, c->it, e->col);
        {
            const WTab *t = &wb->tabs[e->tab];
            char msg[160];
            snprintf(msg, sizeof msg, "%.*s.%.*s is a column: aggregate it (sum, count, ...)%s",
                     (int)t->namen, t->name, (int)t->cnamen[e->col], t->cname[e->col],
                     c->own && c->own->tab == e->tab ? " or use @column" : "");
            return ev_err(c, WE_TYPE, msg);
        }
    case EX_TABREF: {
        WVal v = wv_null();
        v.t = WV_TAB;
        v.code = (uint16_t)e->tab;
        return v;
    }
    case EX_LOOKUP:
        return ev_lookup(c, e);
    case EX_FIELD: {
        WVal r = ev(c, e->a);
        WRow *row;
        if (r.t == WV_ERR || r.t == WV_NULL) return r;
        if (r.t != WV_ROW) return ev_err(c, WE_TYPE, ".column needs a row");
        row = wb_ring_get(c, e->tab, (uint32_t)r.u.i);
        if (!row) return ev_err(c, WE_NUM, "out of memory");
        return wb_cell_eval(c, row, e->col);
    }
    case EX_ABS:
        return ev_abs(c, e);
    case EX_IMP:
        return wb_imp_read(c, e);
    case EX_AGG:
        if (e->isma) return ev_agg_node(c, e);
        return ev_agg_scan(c, e);
    case EX_GROUP:
        if (e->isma) return ev_group_node(c, e);
        return ev_err(c, WE_TYPE, "group is a derived table: name it (g = group T by k { ... })");
    case EX_GLOOKUP:
        return ev_glookup(c, e);
    case EX_FN:
        return ev_fn(c, e);
    case EX_UN: {
        WVal a = ev(c, e->a);
        if (a.t == WV_ERR || a.t == WV_NULL) return a;
        if (e->bin == '!') {
            if (a.t != WV_BOOL) return ev_err(c, WE_TYPE, "not needs true / false");
            return wv_bool(!a.u.i);
        }
        if (a.t == WV_FLOAT) return wv_float(-a.u.f);
        if (!wv_num(&a)) return ev_err(c, WE_TYPE, "- needs a number");
        if (a.u.i == INT64_MIN) return ev_err(c, WE_NUM, "number too large");
        a.u.i = -a.u.i;
        return a;
    }
    case EX_BIN:
        return ev_bin(c, e);
    case EX_IF: {
        WVal p = ev(c, e->a);
        if (p.t == WV_ERR) return p;
        if (p.t != WV_BOOL && p.t != WV_NULL) return ev_err(c, WE_TYPE, "if needs true / false");
        return ev(c, p.t == WV_BOOL && p.u.i ? e->b : e->c);
    }
    default:
        return ev_err(c, WE_PARSE, "unbound formula");
    }
}

/* ---- a row's contribution to an aggregate */

/* `base`: the formula's context with it_tab set; row: the iterated row. */
static void wb_con(ECtx *base, const WOut *o, WRow *row, WCon *out) {
    RtxWb *wb = base->wb;
    const WTab *t = &wb->tabs[base->it_tab];
    ECtx r = *base;
    WVal v;
    r.it = row;
    out->k = CN_SKIP;
    out->v = wv_null();
    wb->st.ma_rows++;
    if (o->bad) return;
    if (o->where) {
        WVal p = ev(&r, o->where);
        base->stale |= r.stale;
        base->oldfail |= r.oldfail;
        base->nolast |= r.nolast;
        if (p.t == WV_ERR) {
            if (!o->q) {
                out->k = CN_STOP;
                out->v = p;
            }
            return;
        }
        if (p.t == WV_NULL) return;
        if (p.t != WV_BOOL) {
            out->k = CN_STOP;
            out->v = ev_err(base, WE_TYPE, "where needs true / false");
            return;
        }
        if (!p.u.i) return;
    }
    if (o->crow) {
        out->k = CN_VAL;
        return;
    }
    r.stale = 0;
    v = ev(&r, o->arg);
    base->stale |= r.stale;
    base->oldfail |= r.oldfail;
    base->nolast |= r.nolast;
    if (v.t == WV_ERR) {
        if (!o->q) {
            out->k = CN_STOP;
            out->v = v;
        }
        return;
    }
    if (v.t == WV_NULL) return;
    if (v.t == WV_ROW || v.t == WV_TAB || v.t == WV_GRP) {
        out->k = CN_STOP;
        out->v = wv_row_err(base, &v);
        return;
    }
    switch (o->fn) {
    case FN_SUM:
    case FN_AVG:
        if (!wv_num(&v)) {
            char msg[128];
            snprintf(msg, sizeof msg, "%s over %s (%.*s row %d)", g_fn_name[o->fn], wv_kind(&v),
                     (int)t->namen, t->name, (int)row->pos + 1);
            out->k = CN_STOP;
            out->v = ev_err(base, WE_TYPE, msg);
            return;
        }
        break;
    case FN_ANY:
    case FN_ALL:
        if (v.t != WV_BOOL) {
            out->k = CN_STOP;
            out->v = ev_err(base, WE_TYPE, "any / all need true / false");
            return;
        }
        break;
    default:
        break;
    }
    out->k = CN_VAL;
    out->v = v;
}

static int con_same(const WCon *a, const WCon *b) {
    if (a->k != b->k) return 0;
    if (a->k == CN_SKIP) return 1;
    if (a->k == CN_STOP) return 1; /* the count is what the partial holds */
    return wv_same(&a->v, &b->v);
}

/* `a` beats `b` for min / max (ties: the earlier row). */
static int wb_better(const RtxWb *wb, int32_t tab, int fn, const WBest *a, const WBest *b) {
    int r;
    if (!a->has) return 0;
    if (!b->has) return 1;
    r = wb_vcmp(&a->v, &b->v);
    if (fn == FN_MAX) r = -r;
    if (r) return r < 0;
    return tb_rid_pos(&wb->tabs[tab], a->rid) < tb_rid_pos(&wb->tabs[tab], b->rid);
}

typedef struct WGRowS {
    uint8_t stop;  /* the key is an error */
    WVal kerr;
    WKey key;
    WCon *oc;      /* per output */
} WGRow;

static void wg_con(ECtx *base, const WAgg *m, WRow *row, WGRow *out) {
    ECtx r = *base;
    WVal kv;
    uint32_t j;
    r.it = row;
    out->stop = 0;
    kv = ev(&r, m->key);
    base->stale |= r.stale;
    base->oldfail |= r.oldfail;
    base->wb->st.ma_rows++;
    if (kv.t == WV_ERR || kv.t == WV_ROW || kv.t == WV_TAB || kv.t == WV_GRP) {
        out->stop = 1;
        out->kerr = kv.t == WV_ERR ? kv : wv_row_err(base, &kv);
        return;
    }
    wb_key_of(&kv, &out->key);
    for (j = 0; j < m->nout; j++) wb_con(base, &m->outs[j], row, &out->oc[j]);
}

static int wg_row_alloc(RtxWb *wb, const WAgg *m, WGRow *g) {
    g->oc = (WCon *)cc_arena_alloc(wb->sa, (size_t)(m->nout ? m->nout : 1) * sizeof(WCon), 16);
    return g->oc != NULL;
}

/* ---- lookups: T[condition] */

/* The equality a key index can answer: `col = expr` over the iterated
 * table with expr not reading it. col or -1. */
static int wb_lookup_key(const Ex *cond, int32_t tab, const Ex **probe);

static void wb_kx_build(RtxWb *wb, uint32_t ti, int32_t col);

static WVal ev_lookup(ECtx *c, const Ex *e) {
    RtxWb *wb = c->wb;
    const WTab *t = &wb->tabs[e->tab];
    ECtx r = *c;
    int32_t hit = -1, n = (int32_t)wb_nrows_mode(wb, e->tab, c->old), row;
    const Ex *probe = NULL;
    int kc = wb_lookup_key(e->b, e->tab, &probe);
    r.it_tab = e->tab;
    /* the key index is built on the first probe that needs it (one walk);
     * edits keep it (wb_kx_move); a wholesale change drops it until the
     * next probe. Old mode reads what it has, never builds. */
    if (kc >= 0 && t->kx && t->kx[kc] && !t->kx[kc]->ok && !c->old && t->nrows)
        wb_kx_build(wb, (uint32_t)e->tab, kc);
    if (kc >= 0 && t->kx && t->kx[kc] && t->kx[kc]->ok && !t->kx[kc]->bad) {
        /* the key index: the probe evaluated once, the rows holding it */
        WKx *x = t->kx[kc];
        WVal pv = ev(c, probe);
        WKey k;
        int cls;
        if (pv.t == WV_ERR) return pv;
        if (pv.t == WV_NULL) return wv_null();
        cls = pv.t == WV_INT || pv.t == WV_DEC ? KY_NUM
              : pv.t == WV_TEXT                ? KY_TEXT
              : pv.t == WV_DATE                ? KY_DATE
              : pv.t == WV_BOOL                ? KY_BOOL
                                               : 0;
        if (cls && (x->cls == 0 || x->cls == cls)) {
            uint32_t ids[64], cnt, i, m;
            int32_t p0 = -1, p1 = -1;
            wb->st.kx_probe++;
            wb_key_of(&pv, &k);
            cnt = kx_ids(x, &k, ids, 64);
            if (!cnt) return wv_null();
            m = cnt < 64 ? cnt : 64;
            for (i = 0; i < m; i++) {
                int32_t p = tb_rid_pos(t, ids[i]);
                if (p < 0) continue;
                if (p0 < 0 || p < p0) {
                    p1 = p0;
                    p0 = p;
                } else if (p1 < 0 || p < p1) {
                    p1 = p;
                }
            }
            if (cnt <= 64 && p0 >= 0) {
                if (p1 >= 0 && !e->first) {
                    char msg[128];
                    snprintf(msg, sizeof msg,
                             "%.*s[...] matches rows %d and %d (first(...) takes one)",
                             (int)t->namen, t->name, (int)p0 + 1, (int)p1 + 1);
                    return ev_err(c, WE_DUP, msg);
                }
                {
                    WVal v = wv_null();
                    v.t = WV_ROW;
                    v.code = (uint16_t)e->tab;
                    v.u.i = p0;
                    return v;
                }
            }
            /* more than 64 hits: the scan below finds the first two */
        }
    }
    for (row = 0; row < n; row++) {
        WVal p;
        WRow rr;
        wb_row_load(wb, &rr, e->tab, (uint32_t)row, c->old);
        r.it = &rr;
        r.stale = 0;
        p = ev(&r, e->b);
        c->stale |= r.stale;
        c->oldfail |= r.oldfail;
        if (p.t == WV_ERR) return p;
        if (p.t == WV_NULL) continue;
        if (p.t != WV_BOOL) return ev_err(c, WE_TYPE, "T[condition] needs true / false");
        if (!p.u.i) continue;
        if (hit >= 0) {
            char msg[128];
            snprintf(msg, sizeof msg, "%.*s[...] matches rows %d and %d (first(...) takes one)",
                     (int)t->namen, t->name, (int)hit + 1, (int)row + 1);
            return ev_err(c, WE_DUP, msg);
        }
        hit = row;
        if (e->first) break;
    }
    if (hit < 0) return wv_null();
    {
        WVal v = wv_null();
        v.t = WV_ROW;
        v.code = (uint16_t)e->tab;
        v.u.i = hit;
        return v;
    }
}

static int wb_ex_reads_tab(const Ex *e, int32_t tab) {
    uint16_t i;
    if (!e) return 0;
    if (e->op == EX_COL && e->tab == tab) return 1;
    if (e->op == EX_LOOKUP || e->op == EX_AGG) return 0; /* its own iteration */
    if (wb_ex_reads_tab(e->a, tab) || wb_ex_reads_tab(e->b, tab) || wb_ex_reads_tab(e->c, tab))
        return 1;
    if (e->op == EX_FN)
        for (i = 0; i < e->nargs; i++)
            if (wb_ex_reads_tab(e->args[i], tab)) return 1;
    return 0;
}

static int wb_lookup_key(const Ex *cond, int32_t tab, const Ex **probe) {
    if (!cond || cond->op != EX_BIN || cond->bin != '=') return -1;
    if (cond->a && cond->a->op == EX_COL && cond->a->tab == tab && !wb_ex_reads_tab(cond->b, tab)) {
        *probe = cond->b;
        return cond->a->col;
    }
    return -1;
}

/* ---- the scan: an aggregate evaluated once (rtx_wb_eval) */

static void wb_acc_best(RtxWb *wb, int32_t tab, const WOut *o, WBest *best, const WCon *k, uint32_t rid) {
    if ((o->fn == FN_MIN || o->fn == FN_MAX) && k->k == CN_VAL && !wv_isnan(&k->v)) {
        WBest x;
        x.v = k->v;
        x.rid = rid;
        x.has = 1;
        if (wb_better(wb, tab, o->fn, &x, best)) *best = x;
    }
}

static WVal acc_value(ECtx *c, const WOut *o, const WAcc *a, const WBest *best);

/* Positions [*lo, *hi] of a range T[#a .. #b]; 0 with *err on a missing or
 * reversed end. */
static int wb_range_pos(ECtx *c, int32_t tab, const WEnd *ra, const WEnd *rb, int32_t *lo,
                        int32_t *hi, WVal *err) {
    int32_t a = wb_anchor_pos(c, tab, ra->anc, ra->ancn, ra->off, err), b;
    const WTab *t = &c->wb->tabs[tab];
    if (a == -1) return 0;
    b = wb_anchor_pos(c, tab, rb->anc, rb->ancn, rb->off, err);
    if (b == -1) return 0;
    if (a == -2 || b == -2) {
        char msg[200];
        snprintf(msg, sizeof msg, "range #%.*s .. #%.*s runs outside %.*s", (int)ra->ancn, ra->anc,
                 (int)rb->ancn, rb->anc, (int)t->namen, t->name);
        *err = ev_err(c, WE_REF, msg);
        return 0;
    }
    if (a > b) {
        char msg[200];
        snprintf(msg, sizeof msg, "range #%.*s .. #%.*s is reversed (rows %d .. %d of %.*s)",
                 (int)ra->ancn, ra->anc, (int)rb->ancn, rb->anc, (int)a + 1, (int)b + 1,
                 (int)t->namen, t->name);
        *err = ev_err(c, WE_REF, msg);
        return 0;
    }
    *lo = a;
    *hi = b;
    return 1;
}

static WVal ev_agg_scan(ECtx *c, const Ex *e) {
    RtxWb *wb = c->wb;
    ECtx r = *c;
    WOut o;
    WAcc a;
    RtxXs fx;
    WDMap dm;
    WBest best;
    int32_t row, lo = 0, hi = (int32_t)wb_nrows_mode(wb, e->tab, c->old) - 1;
    memset(&o, 0, sizeof o);
    memset(&a, 0, sizeof a);
    memset(&dm, 0, sizeof dm);
    o.arg = e->args[0];
    o.where = e->where;
    o.fn = e->fn;
    o.q = e->q;
    o.crow = e->args[0]->op == EX_TABREF && e->args[0]->tab == e->tab && e->fn == FN_COUNT;
    o.bad = e->args[0]->op == EX_TABREF && !o.crow;
    if (o.bad) return acc_value(c, &o, &a, NULL);
    if (e->range && e->v.u.s) {
        const WEnd *pe = (const WEnd *)e->v.u.s;
        WVal err;
        if (!wb_range_pos(c, e->tab, &pe[0], &pe[1], &lo, &hi, &err)) return err;
    }
    rtx_xs_zero(&fx);
    a.fx = &fx;
    dm.ar = wb->sa;
    a.dm = &dm;
    memset(&best, 0, sizeof best);
    r.it_tab = e->tab;
    for (row = lo; row <= hi; row++) {
        WCon k;
        WRow rr;
        wb_row_load(wb, &rr, e->tab, (uint32_t)row, c->old);
        wb_con(&r, &o, &rr, &k);
        if (k.k == CN_STOP) return k.v;
        acc_apply(&a, &o, &k, 1);
        wb_acc_best(wb, e->tab, &o, &best, &k, rr.rid);
    }
    c->stale |= r.stale;
    return acc_value(c, &o, &a, &best);
}

/* The exact sum: int / dec at the widest scale present; with any float,
 * the exact real sum of every value rounded once (NaN / inf by count). */
static WVal acc_sum(ECtx *c, const WAcc *a) {
    int s, maxsc = 0, anyd = 0;
    RtxXd dx;
    rtx_xd_zero(&dx);
    for (s = 0; s < 19; s++) {
        if (a->nsc[s]) {
            maxsc = s;
            anyd = 1;
        }
        if (a->isum[s]) rtx_xd_add128(&dx, a->isum[s], s);
    }
    if (a->nflt) {
        if (a->nnan || (a->npinf && a->nninf)) return wv_nan();
        if (a->npinf) return wv_float(1.0 / 0.0);
        if (a->nninf) return wv_float(-1.0 / 0.0);
        if (!a->fx) return wv_float(0.0);
        return wv_float(anyd ? rtx_xs_round_mixed(a->fx, &dx) : rtx_xs_round(a->fx));
    }
    {
        int64_t out;
        if (!rtx_xd_get(&dx, maxsc, &out)) return ev_err(c, WE_NUM, "sum too large");
        return wv_dec(out, maxsc);
    }
}

/* The value of a partial with no stop row (callers answer stops). */
static WVal acc_value(ECtx *c, const WOut *o, const WAcc *a, const WBest *best) {
    if (o->bad) return ev_err(c, WE_TYPE, "a table aggregates as count(T) only");
    switch (o->fn) {
    case FN_SUM:
        return acc_sum(c, a);
    case FN_COUNT:
        return wv_int((int64_t)a->cnt);
    case FN_AVG: {
        WVal tot;
        if (!a->cnt) return wv_null();
        tot = acc_sum(c, a);
        if (tot.t == WV_ERR) return tot;
        return wv_float(wv_tod(&tot) / (double)a->cnt);
    }
    case FN_MIN:
    case FN_MAX: {
        int k, cls = 0;
        for (k = 0; k < 4; k++) cls += a->ncls[k] > 0;
        if (cls > 1) return ev_err(c, WE_TYPE, "min / max over mixed kinds");
        if (!a->cnt) return wv_null();
        if (a->nnan) return wv_nan();
        return best && best->has ? best->v : wv_null();
    }
    case FN_DISTINCT:
        return wv_int(a->dm ? (int64_t)a->dm->live : 0);
    case FN_ANY:
        return wv_bool(a->nt > 0);
    case FN_ALL:
        return wv_bool(a->nf == 0);
    default:
        return wv_null();
    }
}


/* ------------------------------------------------- aggregate instances
 *
 * An aggregate node holds one instance per tuple of outer-row parameters
 * (`count(A where g = @g)` in a row formula: one per distinct @g; most
 * aggregates read no @col and have one). An instance's partials are W2's:
 * the root WAcc (exact sums, counts, distinct counts), per block id the
 * stop-row count and the min / max best; "block mode" instances (over a
 * previous-row chain, or over an anchor range) keep a whole WAcc per block
 * and a tree over the block positions for range queries.
 *
 * A build walks the table's blocks (a job when big); while it runs the
 * instance keeps its last value (stale) and row deltas apply to the
 * blocks it has done. Row deltas: the old contribution (old mode, the
 * captured rows) out, the new one in.
 */

static void seg_merge_into(WAcc *d, const WAcc *l, const WAcc *r);

static int agg_blockmode(const RtxWb *wb, const WAgg *a) {
    (void)wb;
    return a->ranged || a->blockmode;
}

static int agg_best(const WAgg *a) {
    return !a->grp && (a->o.fn == FN_MIN || a->o.fn == FN_MAX);
}

static uint64_t wb_pv_hash(const WVal *pv, uint32_t n) {
    uint64_t h = 1469598103934665603ull;
    uint32_t i;
    for (i = 0; i < n; i++) {
        WKey k;
        wb_key_of(&pv[i], &k);
        h = wk_mix(h, k.h);
        h = wk_mix(h, pv[i].t);
    }
    return h ? h : 1;
}

static int wb_pv_eq(const WVal *a, const WVal *b, uint32_t n) {
    uint32_t i;
    for (i = 0; i < n; i++)
        if (!wv_same(&a[i], &b[i])) return 0;
    return 1;
}

static uint32_t wb_popcount16(uint16_t m) {
    return (uint32_t)__builtin_popcount((unsigned)m);
}

static void gbm_free(WInst *in);

static void inst_free(WInst *in) {
    if (!in) return;
    gbm_free(in);
    free(in->lstop);
    free(in->lbest);
    free(in->lresc);
    free(in->ldone);
    free(in->lacc);
    free(in->seg);
    if (in->ar.base) in->ar.destroy();
    free(in);
}

/* Per-block arrays sized to the table's block ids. */
static int inst_fit(RtxWb *wb, const WAgg *a, WInst *in) {
    const WTab *t = &wb->tabs[a->tab];
    uint32_t need = t->bidcap ? t->bidcap : 1, oc = in->lcap;
    if (need <= in->lcap) {
        /* big enough; the arrays a kind change (a chain appeared: block
         * mode; a best) now needs may still be missing */
        need = in->lcap;
        if (agg_best(a) && !in->lbest) {
            in->lbest = (WBest *)calloc(need, sizeof(WBest));
            if (!in->lbest) return 0;
        }
        if (agg_blockmode(wb, a) && !a->grp && !in->lacc) {
            uint32_t j;
            in->lacc = (WAcc *)calloc(need, sizeof(WAcc));
            if (!in->lacc) return 0;
            for (j = 0; j < need; j++) acc_need(&in->lacc[j], &a->o, in->ar);
        }
        return 1;
    }
#define WB_FIT(p, T)                                                                          \
    do {                                                                                      \
        if (p) {                                                                              \
            T *np_ = (T *)realloc((p), (size_t)need * sizeof(T));                              \
            if (!np_) return 0;                                                               \
            memset(np_ + oc, 0, (size_t)(need - oc) * sizeof(T));                             \
            (p) = np_;                                                                        \
        }                                                                                     \
    } while (0)
    WB_FIT(in->lstop, uint32_t);
    WB_FIT(in->lbest, WBest);
    WB_FIT(in->lresc, uint8_t);
    WB_FIT(in->ldone, uint8_t);
    if (in->lacc) {
        WAcc *np = (WAcc *)realloc(in->lacc, (size_t)need * sizeof(WAcc));
        uint32_t j;
        if (!np) return 0;
        memset(np + oc, 0, (size_t)(need - oc) * sizeof(WAcc));
        in->lacc = np;
        for (j = oc; j < need; j++)
            if (!a->grp) acc_need(&in->lacc[j], &a->o, in->ar);
    }
#undef WB_FIT
    in->lcap = need;
    if (agg_best(a) && !in->lbest) {
        in->lbest = (WBest *)calloc(need, sizeof(WBest));
        if (!in->lbest) return 0;
    }
    if (agg_blockmode(wb, a) && !a->grp && !in->lacc) {
        uint32_t j;
        in->lacc = (WAcc *)calloc(need, sizeof(WAcc));
        if (!in->lacc) return 0;
        for (j = 0; j < need; j++) acc_need(&in->lacc[j], &a->o, in->ar);
    }
    return 1;
}

static uint32_t *inst_lstop(RtxWb *wb, const WAgg *a, WInst *in) {
    if (!in->lstop) {
        in->lstop = (uint32_t *)calloc(in->lcap ? in->lcap : 1, sizeof(uint32_t));
        (void)wb;
        (void)a;
    }
    return in->lstop;
}

static uint8_t *inst_lresc(WInst *in) {
    if (!in->lresc) in->lresc = (uint8_t *)calloc(in->lcap ? in->lcap : 1, 1);
    return in->lresc;
}

static uint64_t g_wb_inst_serial;

static WInst *inst_new(RtxWb *wb, WAgg *a, const WVal *pv, uint32_t npv) {
    WInst *in = (WInst *)calloc(1, sizeof(WInst));
    uint32_t i;
    if (!in) return NULL;
    in->ar = cc_arena_heap(16u << 10);
    if (!in->ar.base) {
        free(in);
        return NULL;
    }
    if (npv) {
        in->pv = (WVal *)cc_arena_alloc(in->ar, npv * sizeof(WVal), 16);
        if (!in->pv) {
            inst_free(in);
            return NULL;
        }
        for (i = 0; i < npv; i++) in->pv[i] = wv_keep_in(in->ar, pv[i]);
    }
    in->kh = wb_pv_hash(pv, npv);
    in->live = 1;
    in->serial = ++g_wb_inst_serial;
    in->full = 1;
    in->pend = 1;
    if (!a->grp) acc_need(&in->a, &a->o, in->ar);
    if (!inst_fit(wb, a, in)) {
        inst_free(in);
        return NULL;
    }
    if (!wb_hgrow((void **)&a->inst, &a->instcap, a->ninst + 1, sizeof(WInst *))) {
        inst_free(in);
        return NULL;
    }
    a->inst[a->ninst++] = in;
    wb->st.insts++;
    return in;
}

/* The instance for parameters pv (npv of them), or NULL. */
static WInst *inst_find(WAgg *a, const WVal *pv, uint32_t npv) {
    uint64_t h = wb_pv_hash(pv, npv);
    uint32_t i;
    for (i = 0; i < a->ninst; i++) {
        WInst *in = a->inst[i];
        if (in && in->live && in->kh == h && wb_pv_eq(in->pv, pv, npv)) return in;
    }
    return NULL;
}

/* The context an instance's rows are evaluated in: its owner formula's
 * label, the parameters standing for the owner's row. */
static void inst_ctx(RtxWb *wb, const WAgg *a, const WInst *in, ECtx *c, int old) {
    const WGNode *og = a->owner != WN32 ? &wb->g[a->owner] : NULL;
    ectx_init(c, wb);
    c->old = old;
    if (og && og->kind == GN_NAME) {
        c->self_name = og->ref;
    } else if (og && og->kind == GN_RULE) {
        const WRule *r = &wb->rules[og->ref];
        c->self_tab = r->tab;
        c->self_col = r->col;
        c->self_pos = -1;
    }
    c->it_tab = a->tab;
    c->pagg = a;
    c->pv = in->pv;
}

/* A reader's context for the instance (the reader's label). */
static void inst_ctx_reader(const ECtx *reader, const WAgg *a, const WInst *in, ECtx *c) {
    *c = *reader;
    c->it_tab = a->tab;
    c->it = NULL;
    c->pagg = a;
    c->pv = in->pv;
    c->stale = 0;
}

/* ---- group partials (W2) */

static WGEnt *wg_find(WGMap *m, const WKey *k) {
    uint32_t i;
    if (!m->cap) return NULL;
    i = (uint32_t)k->h & (m->cap - 1);
    while (m->e[i].used) {
        if (wb_key_eq(&m->e[i].k, k)) return &m->e[i];
        i = (i + 1) & (m->cap - 1);
    }
    return &m->e[i];
}

static WGEnt *wg_get(RtxWb *wb, const WAgg *a, WInst *in, const WKey *k, int make) {
    WGMap *g = &in->gm;
    WGEnt *e;
    uint32_t j;
    (void)wb;
    if (make && (g->used + 1) * 4 >= g->cap * 3) {
        uint32_t nc = g->cap ? g->cap * 2 : 16, oc = g->cap, i;
        WGEnt *old = g->e, *ne = (WGEnt *)wb_alloc(in->ar, (size_t)nc * sizeof(WGEnt));
        if (!ne) return NULL;
        g->e = ne;
        g->cap = nc;
        g->used = 0;
        for (i = 0; i < oc; i++) {
            WGEnt *s;
            if (!old[i].used || !old[i].rows) continue;
            s = wg_find(g, &old[i].k);
            *s = old[i];
            g->used++;
        }
    }
    e = wg_find(g, k);
    if (!e || e->used || !make) return e && e->used ? e : NULL;
    e->used = 1;
    e->k = *k;
    if (k->t == KY_TEXT && k->n) {
        char *p = (char *)cc_arena_alloc(in->ar, k->n, 1);
        if (p) memcpy(p, k->s, k->n);
        e->k.s = p ? p : "";
    }
    e->rows = 0;
    e->acc = (WAcc *)wb_alloc(in->ar, (size_t)a->nout * sizeof(WAcc));
    e->best = (WBest *)wb_alloc(in->ar, (size_t)a->nout * sizeof(WBest));
    e->bst = (uint8_t *)wb_alloc(in->ar, a->nout);
    if (!e->acc || !e->best || !e->bst) return NULL;
    for (j = 0; j < a->nout; j++)
        if (!acc_need(&e->acc[j], &a->outs[j], in->ar)) return NULL;
    g->used++;
    return e;
}

/* ---- group min / max by block (docs/workbook.md "W1 phase 2 as built")
 *
 * Per group key and min / max output, the best row of each block the key
 * has rows in (a small map block id -> best). A row joining updates its
 * block's best; the block's best row leaving marks that block for a
 * rescan (its <= WB_BLK_MAX rows, for every key waiting on it); the key's
 * best is then the best of its blocks. So a key losing its extreme costs
 * a block, not a walk of the table. Memory: one slot per (key, block,
 * output) that has rows — at most the table's rows per output; past
 * max(64k, rows) slots in one instance the maps are dropped and that
 * instance loses its extremes the old way (a walk, a job when big). */

typedef struct WGBm {
    uint32_t *bid;  /* bid + 1; 0: empty */
    WBest *b;
    uint8_t *resc;  /* the block's best row left: rescan it */
    uint32_t cap, n;
} WGBm;

static void gbm_free_ent(uint32_t nout, WGEnt *e) {
    uint32_t j;
    if (!e->bm) return;
    for (j = 0; j < nout; j++) {
        free(e->bm[j].bid);
        free(e->bm[j].b);
        free(e->bm[j].resc);
    }
    free(e->bm);
    e->bm = NULL;
}

static void gbm_free(WInst *in) {
    uint32_t i;
    for (i = 0; i < in->gm.cap; i++)
        if (in->gm.e[i].used) gbm_free_ent(in->gbm_nout, &in->gm.e[i]);
    in->gbm_n = 0;
    in->gresc = 0;
}

static int agg_has_minmax(const WAgg *a) {
    uint32_t j;
    for (j = 0; j < a->nout; j++)
        if (a->outs[j].fn == FN_MIN || a->outs[j].fn == FN_MAX) return 1;
    return 0;
}

/* The slot of block bid in m (made when asked), or -1. */
static int32_t gbm_slot(WInst *in, WGBm *m, uint32_t bid, int make) {
    uint32_t i;
    if (m->cap) {
        i = (bid * 2654435761u) & (m->cap - 1);
        while (m->bid[i]) {
            if (m->bid[i] == bid + 1) return (int32_t)i;
            i = (i + 1) & (m->cap - 1);
        }
    }
    if (!make) return -1;
    if ((m->n + 1) * 2 > m->cap) {
        uint32_t nc = m->cap ? m->cap * 2 : 8, oc = m->cap, k;
        uint32_t *nb = (uint32_t *)calloc(nc, sizeof(uint32_t));
        WBest *nbs = (WBest *)calloc(nc, sizeof(WBest));
        uint8_t *nr = (uint8_t *)calloc(nc, 1);
        if (!nb || !nbs || !nr) {
            free(nb);
            free(nbs);
            free(nr);
            return -1;
        }
        for (k = 0; k < oc; k++) {
            uint32_t j;
            if (!m->bid[k]) continue;
            j = ((m->bid[k] - 1) * 2654435761u) & (nc - 1);
            while (nb[j]) j = (j + 1) & (nc - 1);
            nb[j] = m->bid[k];
            nbs[j] = m->b[k];
            nr[j] = m->resc[k];
        }
        free(m->bid);
        free(m->b);
        free(m->resc);
        m->bid = nb;
        m->b = nbs;
        m->resc = nr;
        m->cap = nc;
        i = (bid * 2654435761u) & (m->cap - 1);
        while (m->bid[i]) i = (i + 1) & (m->cap - 1);
    }
    m->bid[i] = bid + 1;
    memset(&m->b[i], 0, sizeof(WBest));
    m->resc[i] = 0;
    m->n++;
    in->gbm_n++;
    return (int32_t)i;
}

/* The group's maps are too many: dropped (the old way from here). */
static void gbm_drop(const WAgg *a, WInst *in) {
    (void)a;
    gbm_free(in);
    in->gbm_off = 1;
}

static uint32_t gbm_limit(const RtxWb *wb, const WAgg *a) {
    uint32_t r = wb->tabs[a->tab].nrows;
    return r > 65536 ? r : 65536;
}

/* One row in (+1) or out (-1) of key e, block bid: the block bests. */
static void gbm_row(RtxWb *wb, const WAgg *a, WInst *in, WGEnt *e, const WGRow *g, uint32_t rid,
                    uint32_t bid, int sign) {
    uint32_t j;
    if (in->gbm_off || bid == WN32) return;
    if (!e->bm) {
        in->gbm_nout = a->nout;
        e->bm = (WGBm *)calloc(a->nout, sizeof(WGBm));
        if (!e->bm) {
            gbm_drop(a, in);
            return;
        }
    }
    for (j = 0; j < a->nout; j++) {
        const WOut *o = &a->outs[j];
        const WCon *k = &g->oc[j];
        int32_t s;
        if ((o->fn != FN_MIN && o->fn != FN_MAX) || k->k != CN_VAL || wv_isnan(&k->v)) continue;
        s = gbm_slot(in, &e->bm[j], bid, sign > 0);
        if (s < 0) {
            if (sign > 0) {
                gbm_drop(a, in);
                return;
            }
            continue;
        }
        if (sign < 0) {
            if (e->bm[j].b[s].has && e->bm[j].b[s].rid == rid) {
                e->bm[j].resc[s] = 1;
                in->gresc = 1;
            }
        } else if (!e->bm[j].resc[s]) {
            WBest x;
            x.v = k->v;
            x.rid = rid;
            x.has = 1;
            if (wb_better(wb, a->tab, o->fn, &x, &e->bm[j].b[s])) {
                x.v = wv_keep_in(in->ar, k->v);
                e->bm[j].b[s] = x;
            }
        }
    }
    if (in->gbm_n > gbm_limit(wb, a)) gbm_drop(a, in);
}

/* Blocks split / merged: every key's slot for them rescans. */
static void gbm_blocks_moved(RtxWb *wb, const WAgg *a, WInst *in, uint32_t b1, uint32_t b2, int merge) {
    uint32_t i, j;
    if (!a->grp || in->gbm_off) return;
    for (i = 0; i < in->gm.cap; i++) {
        WGEnt *e = &in->gm.e[i];
        if (!e->used || !e->bm) continue;
        for (j = 0; j < a->nout; j++) {
            WGBm *m = &e->bm[j];
            int32_t s1 = gbm_slot(in, m, b1, 0), s2;
            if (s1 < 0) continue;
            if (merge) {
                /* b2 (into) takes b1's rows: rescan b2; b1 empties */
                s2 = gbm_slot(in, m, b2, 1);
                if (s2 < 0) {
                    gbm_drop(a, in);
                    return;
                }
                s1 = gbm_slot(in, m, b1, 0);
                m->resc[s2] = 1;
                m->b[s2].has = 0;
                m->b[s1].has = 0;
                m->resc[s1] = 0;
            } else {
                /* b1 split into b1 and b2: both rescan */
                s2 = gbm_slot(in, m, b2, 1);
                if (s2 < 0) {
                    gbm_drop(a, in);
                    return;
                }
                s1 = gbm_slot(in, m, b1, 0);
                m->resc[s1] = 1;
                m->resc[s2] = 1;
            }
            in->gresc = 1;
            /* the key's best may sit in a block being rescanned */
            e->bst[j] = 1;
            in->gstale = 1;
        }
    }
    (void)wb;
}

/* Rescan the marked blocks (each once, for every key waiting on it), then
 * each stale key's best from its blocks. */
static void gbm_resolve(RtxWb *wb, const WAgg *a, WInst *in) {
    const WTab *t = &wb->tabs[a->tab];
    uint8_t *want = NULL;
    uint32_t i, j, bid;
    ECtx c;
    WGRow g;
    if (in->gresc) {
        want = (uint8_t *)calloc(t->nbid ? t->nbid : 1, 1);
        if (!want || !wg_row_alloc(wb, a, &g)) {
            free(want);
            gbm_drop(a, in);
            return;
        }
        for (i = 0; i < in->gm.cap; i++) {
            WGEnt *e = &in->gm.e[i];
            if (!e->used || !e->bm) continue;
            for (j = 0; j < a->nout; j++) {
                WGBm *m = &e->bm[j];
                uint32_t s;
                for (s = 0; s < m->cap; s++)
                    if (m->bid[s] && m->resc[s]) {
                        m->b[s].has = 0;
                        if (m->bid[s] - 1 < t->nbid) want[m->bid[s] - 1] = 1;
                    }
            }
        }
        inst_ctx(wb, a, in, &c, 0);
        for (bid = 0; bid < t->nbid; bid++) {
            const WBlock *b = &t->blk[bid];
            uint32_t s, p0;
            if (!want[bid] || !b->live || b->pos == WN32) continue;
            p0 = t->bfirst[b->pos];
            wb->st.ma_rescan++;
            wb->st.grp_blocks++;
            for (s = 0; s < b->n; s++) {
                WRow rr;
                WGEnt *e;
                wb_row_load(wb, &rr, a->tab, p0 + s, 0);
                wg_con(&c, a, &rr, &g);
                if (g.stop) continue;
                e = wg_get(wb, a, in, &g.key, 0);
                if (!e || !e->bm) continue;
                for (j = 0; j < a->nout; j++) {
                    const WOut *o = &a->outs[j];
                    int32_t sl;
                    WBest x;
                    if ((o->fn != FN_MIN && o->fn != FN_MAX) || g.oc[j].k != CN_VAL || wv_isnan(&g.oc[j].v))
                        continue;
                    sl = gbm_slot(in, &e->bm[j], bid, 0);
                    if (sl < 0 || !e->bm[j].resc[sl]) continue;
                    x.v = g.oc[j].v;
                    x.rid = rr.rid;
                    x.has = 1;
                    if (wb_better(wb, a->tab, o->fn, &x, &e->bm[j].b[sl])) {
                        x.v = wv_keep_in(in->ar, x.v);
                        e->bm[j].b[sl] = x;
                    }
                }
            }
        }
        for (i = 0; i < in->gm.cap; i++) {
            WGEnt *e = &in->gm.e[i];
            if (!e->used || !e->bm) continue;
            for (j = 0; j < a->nout; j++) {
                WGBm *m = &e->bm[j];
                uint32_t s;
                for (s = 0; s < m->cap; s++) m->resc[s] = 0;
            }
        }
        free(want);
        in->gresc = 0;
    }
    /* the stale keys: the best of their blocks' bests */
    for (i = 0; i < in->gm.cap; i++) {
        WGEnt *e = &in->gm.e[i];
        if (!e->used) continue;
        for (j = 0; j < a->nout; j++) {
            WGBm *m;
            uint32_t s;
            if (!e->bst[j]) continue;
            e->bst[j] = 0;
            e->best[j].has = 0;
            if (!e->bm) continue;
            m = &e->bm[j];
            for (s = 0; s < m->cap; s++)
                if (m->bid[s] && m->b[s].has && wb_better(wb, a->tab, a->outs[j].fn, &m->b[s], &e->best[j]))
                    e->best[j] = m->b[s];
        }
    }
    in->gstale = 0;
    wb->st.grp_resolves++;
}

/* Add / remove one row's contribution to a group (row rid of block bid). */
static void wg_apply(RtxWb *wb, const WAgg *a, WInst *in, const WGRow *g, uint32_t rid, uint32_t bid,
                     int sign) {
    WGEnt *e;
    uint32_t j;
    if (g->stop) {
        in->a.stop += (uint32_t)sign;
        return;
    }
    e = wg_get(wb, a, in, &g->key, sign > 0);
    if (!e) return;
    gbm_row(wb, a, in, e, g, rid, bid, sign);
    e->rows += (uint32_t)sign;
    if (e->rows == 0 && sign < 0) in->gm.live--;
    if (e->rows == 1 && sign > 0) in->gm.live++;
    for (j = 0; j < a->nout; j++) {
        const WOut *o = &a->outs[j];
        const WCon *k = &g->oc[j];
        acc_apply(&e->acc[j], o, k, sign);
        if ((o->fn == FN_MIN || o->fn == FN_MAX) && k->k == CN_VAL && !wv_isnan(&k->v)) {
            if (sign < 0) {
                if (e->best[j].has && e->best[j].rid == rid) {
                    e->bst[j] = 1;
                    in->gstale = 1;
                }
            } else if (!e->bst[j]) {
                WBest x;
                x.v = wv_keep_in(in->ar, k->v);
                x.rid = rid;
                x.has = 1;
                if (wb_better(wb, a->tab, o->fn, &x, &e->best[j])) e->best[j] = x;
            }
        }
    }
}

/* Every key whose min / max row left: recompute those outputs with one
 * walk of the table. */
static void wg_restale(RtxWb *wb, const WAgg *a, WInst *in) {
    const WTab *t = &wb->tabs[a->tab];
    ECtx c;
    WGRow g;
    uint32_t i, j, r;
    if (!in->gstale) return;
    for (i = 0; i < in->gm.cap; i++) {
        WGEnt *e = &in->gm.e[i];
        if (!e->used) continue;
        for (j = 0; j < a->nout; j++)
            if (e->bst[j]) e->best[j].has = 0;
    }
    if (!wg_row_alloc(wb, a, &g)) return;
    inst_ctx(wb, a, in, &c, 0);
    wb->st.ma_rescan++;
    for (r = 0; r < t->nrows; r++) {
        WGEnt *e;
        WRow rr;
        wb_row_load(wb, &rr, a->tab, r, 0);
        wg_con(&c, a, &rr, &g);
        if (g.stop) continue;
        e = wg_get(wb, a, in, &g.key, 0);
        if (!e) continue;
        for (j = 0; j < a->nout; j++) {
            const WOut *o = &a->outs[j];
            if (!e->bst[j] || g.oc[j].k != CN_VAL || wv_isnan(&g.oc[j].v)) continue;
            {
                WBest x;
                x.v = g.oc[j].v;
                x.rid = rr.rid;
                x.has = 1;
                if (wb_better(wb, a->tab, o->fn, &x, &e->best[j])) {
                    x.v = wv_keep_in(in->ar, x.v);
                    e->best[j] = x;
                }
            }
        }
    }
    for (i = 0; i < in->gm.cap; i++) {
        WGEnt *e = &in->gm.e[i];
        if (!e->used) continue;
        for (j = 0; j < a->nout; j++) e->bst[j] = 0;
    }
    in->gstale = 0;
}

/* ---- build */

/* Start a (re)build: partials empty, no block done; the last value stays
 * (stale) until the build finishes. */
static void inst_begin(RtxWb *wb, WAgg *a, WInst *in) {
    const WTab *t = &wb->tabs[a->tab];
    uint32_t j;
    inst_fit(wb, a, in);
    acc_reset(&in->a);
    if (!a->grp) acc_need(&in->a, &a->o, in->ar);
    in->best.has = 0;
    in->bestok = 1;
    in->anyresc = 0;
    in->nstop = 0;
    if (in->lstop) memset(in->lstop, 0, (size_t)in->lcap * sizeof(uint32_t));
    if (in->lbest) memset(in->lbest, 0, (size_t)in->lcap * sizeof(WBest));
    if (in->lresc) memset(in->lresc, 0, in->lcap);
    if (in->lacc)
        for (j = 0; j < in->lcap; j++) acc_reset(&in->lacc[j]);
    in->segp = 0;
    if (!in->ldone) in->ldone = (uint8_t *)calloc(in->lcap ? in->lcap : 1, 1);
    else memset(in->ldone, 0, in->lcap);
    if (a->grp) {
        gbm_free(in);
        in->gbm_off = 0;
        memset(&in->gm, 0, sizeof in->gm);
        in->gver++;
        in->gstale = 0;
    }
    in->building = 1;
    in->full = 0;
    in->pend = 1;
    (void)t;
    wb->st.ma_full++;

}

/* One row into a building / built instance (sign +1) or out of it (-1),
 * block `bid` (its partials). */
static void inst_row(RtxWb *wb, const WAgg *a, WInst *in, uint32_t bid, const WCon *k,
                     uint32_t rid, int sign) {
    int bm = agg_blockmode(wb, a);
    if (bid >= in->lcap) inst_fit(wb, a, in);
    if (bid >= in->lcap) return;
    acc_apply(&in->a, &a->o, k, sign);
    if (bm && in->lacc) {
        acc_apply(&in->lacc[bid], &a->o, k, sign);
        if (in->segp) {
            /* the tree follows the block: its leaf, then the path up */
            uint32_t i = wb->tabs[a->tab].blk[bid].pos + in->segp;
            if (i < 2 * in->segp) {
                acc_reset(&in->seg[i]);
                acc_merge(&in->seg[i], &in->lacc[bid], 1);
                for (i /= 2; i >= 1; i /= 2) seg_merge_into(&in->seg[i], &in->seg[2 * i], &in->seg[2 * i + 1]);
            } else {
                in->segp = 0;
            }
        }
    }
    if (k->k == CN_STOP) {
        uint32_t *ls = inst_lstop(wb, a, in);
        if (ls) {
            if (sign > 0 && ls[bid]++ == 0) in->nstop++;
            if (sign < 0 && ls[bid] && --ls[bid] == 0) in->nstop--;
        }
        return;
    }
    if (!in->lbest || k->k != CN_VAL || wv_isnan(&k->v)) return;
    if (sign < 0) {
        if (in->lbest[bid].has && in->lbest[bid].rid == rid) {
            uint8_t *lr = inst_lresc(in);
            if (lr) lr[bid] = 1;
            in->anyresc = 1;
            in->lbest[bid].has = 0;
        }
        if (in->best.has && in->best.rid == rid) in->bestok = 0;
        return;
    }
    {
        WBest x;
        x.v = k->v;
        x.rid = rid;
        x.has = 1;
        if (!(in->lresc && in->lresc[bid]) && wb_better(wb, a->tab, a->o.fn, &x, &in->lbest[bid])) {
            x.v = wv_keep_in(in->ar, k->v);
            in->lbest[bid] = x;
        }
        if (in->bestok && wb_better(wb, a->tab, a->o.fn, &x, &in->best)) {
            x.v = wv_keep_in(in->ar, k->v);
            in->best = x;
        }
    }
}

/* Recount block bid's stop rows and best row (a best row left, a split). */
static void inst_block_rescan(RtxWb *wb, const WAgg *a, WInst *in, uint32_t bid) {
    const WTab *t = &wb->tabs[a->tab];
    const WBlock *b = &t->blk[bid];
    ECtx c;
    uint32_t s, p0 = t->bfirst[b->pos];
    WBest best;
    uint32_t stops = 0;
    inst_ctx(wb, a, in, &c, 0);
    memset(&best, 0, sizeof best);
    wb->st.ma_rescan++;
    for (s = 0; s < b->n; s++) {
        WRow rr;
        WCon k;
        wb_row_load(wb, &rr, a->tab, p0 + s, 0);
        if (a->grp) {
            WGRow g;
            if (!wg_row_alloc(wb, a, &g)) break;
            wg_con(&c, a, &rr, &g);
            if (g.stop) stops++;
            continue;
        }
        wb_con(&c, &a->o, &rr, &k);
        if (k.k == CN_STOP) stops++;
        else if (in->lbest && k.k == CN_VAL && !wv_isnan(&k.v)) {
            WBest x;
            x.v = k.v;
            x.rid = rr.rid;
            x.has = 1;
            if (wb_better(wb, a->tab, a->o.fn, &x, &best)) best = x;
        }
    }
    if (stops || in->lstop) {
        uint32_t *ls = inst_lstop(wb, a, in);
        if (ls) {
            if (ls[bid] && !stops) in->nstop--;
            if (!ls[bid] && stops) in->nstop++;
            ls[bid] = stops;
        }
    }
    if (in->lbest) {
        best.v = wv_keep_in(in->ar, best.v);
        in->lbest[bid] = best;
    }
    if (in->lresc) in->lresc[bid] = 0;
}

/* The root best from the blocks' bests. */
static void inst_best_fix(RtxWb *wb, const WAgg *a, WInst *in) {
    const WTab *t = &wb->tabs[a->tab];
    uint32_t k;
    if (!in->lbest) return;
    if (in->anyresc) {
        for (k = 0; k < t->nb; k++) {
            uint32_t bid = t->bord[k];
            if (in->lresc && in->lresc[bid]) inst_block_rescan(wb, a, in, bid);
        }
        in->anyresc = 0;
        in->bestok = 0;
    }
    if (in->bestok) return;
    in->best.has = 0;
    for (k = 0; k < t->nb; k++) {
        uint32_t bid = t->bord[k];
        if (wb_better(wb, a->tab, a->o.fn, &in->lbest[bid], &in->best)) in->best = in->lbest[bid];
    }
    in->bestok = 1;
}

/* Build block bid (current mode) into the instance. */
static void inst_block(RtxWb *wb, const WAgg *a, WInst *in, uint32_t bid, ECtx *c, WGRow *g) {
    const WTab *t = &wb->tabs[a->tab];
    const WBlock *b = &t->blk[bid];
    uint32_t s, p0 = t->bfirst[b->pos];
    for (s = 0; s < b->n; s++) {
        WRow rr;
        wb_row_load(wb, &rr, a->tab, p0 + s, 0);
        c->it = NULL;
        if (a->grp) {
            wg_con(c, a, &rr, g);
            if (g->stop) {
                uint32_t *ls = inst_lstop(wb, a, in);
                if (ls && ls[bid]++ == 0) in->nstop++;
            }
            wg_apply(wb, a, in, g, rr.rid, bid, 1);
            continue;
        }
        {
            WCon k;
            wb_con(c, &a->o, &rr, &k);
            inst_row(wb, a, in, bid, &k, rr.rid, 1);
        }
    }
    if (in->ldone && bid < in->lcap) in->ldone[bid] = 1;
}

/* ---- values */

/* The first stop row's error, in context c (its label); range-limited. */
static WVal inst_first_stop(ECtx *c, const WAgg *a, WInst *in, int32_t lo, int32_t hi) {
    RtxWb *wb = c->wb;
    const WTab *t = &wb->tabs[a->tab];
    uint32_t k, s;
    WGRow g;
    ECtx b = *c;
    b.it_tab = a->tab;
    if (a->grp && !wg_row_alloc(wb, a, &g)) return ev_err(c, WE_NUM, "out of memory");
    for (k = 0; k < t->nb; k++) {
        uint32_t bid = t->bord[k];
        const WBlock *bl = &t->blk[bid];
        int has = in->lstop && bid < in->lcap && in->lstop[bid] != 0;
        if (!has) continue;
        for (s = 0; s < bl->n; s++) {
            int32_t p = (int32_t)(t->bfirst[k] + s);
            WRow rr;
            if (p < lo || p > hi) continue;
            wb_row_load(wb, &rr, a->tab, (uint32_t)p, 0);
            if (a->grp) {
                wg_con(&b, a, &rr, &g);
                if (g.stop) return g.kerr;
            } else {
                WCon kk;
                wb_con(&b, &a->o, &rr, &kk);
                if (kk.k == CN_STOP) return kk.v;
            }
        }
    }
    return ev_err(c, WE_NUM, "aggregate state lost its stop row");
}

/* The tree over block positions (block mode): leaves are the blocks'
 * partials, inner nodes their sums; rebuilt when blocks moved. */
static void seg_merge_into(WAcc *d, const WAcc *l, const WAcc *r) {
    acc_reset(d);
    acc_merge(d, l, 1);
    acc_merge(d, r, 1);
}

static int inst_seg_build(RtxWb *wb, const WAgg *a, WInst *in) {
    const WTab *t = &wb->tabs[a->tab];
    uint32_t p = 1, i;
    while (p < t->nb) p *= 2;
    free(in->seg);
    in->seg = (WAcc *)calloc((size_t)p * 2, sizeof(WAcc));
    if (!in->seg) {
        in->segp = 0;
        return 0;
    }
    for (i = 1; i < 2 * p; i++) {
        if (a->o.fn == FN_SUM || a->o.fn == FN_AVG) {
            in->seg[i].fx = (RtxXs *)cc_arena_alloc(in->ar, sizeof(RtxXs), 16);
            if (in->seg[i].fx) rtx_xs_zero(in->seg[i].fx);
        }
    }
    for (i = 0; i < p; i++) {
        WAcc *d = &in->seg[p + i];
        acc_reset(d);
        if (i < t->nb) acc_merge(d, &in->lacc[t->bord[i]], 1);
    }
    for (i = p - 1; i >= 1; i--) seg_merge_into(&in->seg[i], &in->seg[2 * i], &in->seg[2 * i + 1]);
    in->segp = p;
    return 1;
}

/* dst += the blocks at positions [k0, k1] (the tree's cover). */
static void inst_seg_sum(const WInst *in, WAcc *dst, uint32_t k0, uint32_t k1) {
    uint32_t lo = k0 + in->segp, hi = k1 + in->segp + 1;
    while (lo < hi) {
        if (lo & 1) acc_merge(dst, &in->seg[lo++], 1);
        if (hi & 1) acc_merge(dst, &in->seg[--hi], 1);
        lo >>= 1;
        hi >>= 1;
    }
}

/* A range instance's value over positions [lo, hi]: the whole blocks
 * inside from the tree, the two edge blocks' rows walked. */
static WVal inst_range_value(ECtx *c, const WAgg *a, WInst *in) {
    RtxWb *wb = c->wb;
    const WTab *t = &wb->tabs[a->tab];
    int32_t lo, hi;
    WVal err;
    WAcc acc;
    RtxXs fx;
    WDMap dm;
    WBest best;
    uint32_t k0, k1, k;
    ECtx rc;
    if (!wb_range_pos(c, a->tab, &a->ra, &a->rb, &lo, &hi, &err)) return err;
    memset(&acc, 0, sizeof acc);
    memset(&dm, 0, sizeof dm);
    rtx_xs_zero(&fx);
    acc.fx = &fx;
    dm.ar = wb->sa;
    acc.dm = &dm;
    memset(&best, 0, sizeof best);
    wb->st.range_q++;
    inst_ctx_reader(c, a, in, &rc);
    k0 = tb_bpos(t, (uint32_t)lo);
    k1 = tb_bpos(t, (uint32_t)hi);
    {
        /* sums and counts: the inner blocks are one tree query (O(log n));
         * distinct and min / max merge the inner blocks' partials */
        int tree = a->o.fn != FN_DISTINCT && !agg_best(a);
        for (k = k0; k <= k1; k++) {
            uint32_t bid = t->bord[k];
            const WBlock *b = &t->blk[bid];
            uint32_t f = t->bfirst[k], s;
            int whole = (int32_t)f >= lo && (int32_t)(f + b->n) - 1 <= hi;
            if (whole) {
                if (tree && k > k0 && k < k1) continue;
                acc_merge(&acc, &in->lacc[bid], 1);
                if (in->lbest && wb_better(wb, a->tab, a->o.fn, &in->lbest[bid], &best))
                    best = in->lbest[bid];
                continue;
            }
            for (s = 0; s < b->n; s++) {
            int32_t p = (int32_t)(f + s);
            WRow rr;
            WCon kk;
            if (p < lo || p > hi) continue;
            wb_row_load(wb, &rr, a->tab, (uint32_t)p, 0);
                wb_con(&rc, &a->o, &rr, &kk);
                if (kk.k == CN_STOP) return kk.v;
                acc_apply(&acc, &a->o, &kk, 1);
                wb_acc_best(wb, a->tab, &a->o, &best, &kk, rr.rid);
            }
        }
        if (tree && k1 > k0 + 1) {
            if (!in->segp && !inst_seg_build(wb, a, in)) return ev_err(c, WE_NUM, "out of memory");
            inst_seg_sum(in, &acc, k0 + 1, k1 - 1);
        }
    }
    c->stale |= rc.stale;
    if (acc.stop) return inst_first_stop(&rc, a, in, lo, hi);
    return acc_value(&rc, &a->o, &acc, &best);
}

/* The instance's canonical value (its owner's label). */
static WVal inst_canon(RtxWb *wb, WAgg *a, WInst *in) {
    ECtx c;
    inst_ctx(wb, a, in, &c, 0);
    if (a->grp) {
        WVal v = wv_null();
        if (in->a.stop) return inst_first_stop(&c, a, in, 0, INT32_MAX);
        v.t = WV_GRP;
        v.u.i = (int64_t)(a - wb->aggs);
        v.n = in->gver;
        v.code = (uint16_t)(in->gm.live > 65535 ? 65535 : in->gm.live);
        return v;
    }
    if (a->ranged) return inst_range_value(&c, a, in);
    if (in->a.stop) return inst_first_stop(&c, a, in, 0, INT32_MAX);
    if (agg_best(a)) inst_best_fix(wb, a, in);
    return acc_value(&c, &a->o, &in->a, agg_best(a) ? &in->best : NULL);
}

/* Settle the instance's published value from its partials: 2 when the
 * value moved, 1 when only its stale mark went, 0 nothing. */
static int inst_publish(RtxWb *wb, WAgg *a, WInst *in) {
    WVal v;
    int ret = 0;
    if (a->grp && !in->gbm_off && (in->gstale || in->gresc)) {
        /* a key lost its min / max: its blocks' bests (a block rescan) */
        gbm_resolve(wb, a, in);
    }
    if (a->grp && in->gstale && !g_wb_settling &&
        (size_t)wb->tabs[a->tab].nrows > g_wb_inline / 4) {
        /* a key lost its min / max: finding the next one scans the table
         * (no per-key block bests): past the inline share that is a
         * rebuild job, the group stale meanwhile */
        in->gstale = 0;
        inst_begin(wb, a, in);
        a->wanted = 1;
        wb->jobs = 1;
        return in->has ? 1 : 0;
    }
    if (a->grp && in->gstale) wg_restale(wb, a, in);
    if (!a->grp && in->anyresc) inst_best_fix(wb, a, in);
    v = inst_canon(wb, a, in);
    if (!in->has || !wv_same(&v, &in->v)) {
        in->v = wv_keep_in(in->ar, v);
        ret = 2;
    } else if (in->pend) {
        ret = 1;
    }
    in->has = 1;
    in->pend = 0;
    return ret;
}

/* The value a reader sees (an error of a stop row names the reader). */
static WVal inst_read(ECtx *c, WAgg *a, WInst *in) {
    if (in->pend || in->building) {
        c->stale = 1;
        if (c->view) a->wanted = 1; /* the view waits on it: its build goes first */
        if (!in->has) {
            c->nolast = 1;
            return wv_null();
        }
        return in->v;
    }
    if (!a->grp && !a->ranged && in->a.stop) {
        ECtx rc;
        inst_ctx_reader(c, a, in, &rc);
        return inst_first_stop(&rc, a, in, 0, INT32_MAX);
    }
    if (a->ranged) {
        ECtx rc = *c;
        return inst_range_value(&rc, a, in);
    }
    return in->v;
}


/* ---- aggregates read by formulas */

static void wb_inst_build_now(RtxWb *wb, WAgg *a, WInst *in);

/* The instance's parameters from the reader's row (its @col values). */
static uint32_t wb_agg_params(ECtx *c, const WAgg *a, WVal *pv) {
    uint32_t j = 0;
    int col;
    for (col = 0; col < RTX_WB_COLS_MAX; col++) {
        if (!(a->pmask & (1u << col))) continue;
        pv[j++] = ev_own(c, col);
    }
    return j;
}

/* The instance a reader needs; made (and built, or its build planned) on
 * first use. NULL in old mode when it did not exist then. */
static WInst *wb_inst_get(ECtx *c, WAgg *a) {
    RtxWb *wb = c->wb;
    WVal pv[RTX_WB_COLS_MAX];
    uint32_t npv = a->pmask ? wb_agg_params(c, a, pv) : 0;
    WInst *in = inst_find(a, pv, npv);
    if (in) {
        in->used = ++wb->ring_clock;
        return in;
    }
    if (c->old) {
        c->oldfail = 1;
        return NULL;
    }
    in = inst_new(wb, a, pv, npv);
    if (!in) return NULL;
    in->used = ++wb->ring_clock;
    wb_inst_build_now(wb, a, in);
    return in;
}

static WVal ev_agg_node(ECtx *c, const Ex *e) {
    RtxWb *wb = c->wb;
    WAgg *a = &wb->aggs[e->node];
    WInst *in;
    if (!a->live) return ev_err(c, WE_PARSE, "aggregate not bound (reparse pending)");
    if (wb->g[a->node].cyc) return wb->cyv[wb->g[a->node].cyi];
    in = wb_inst_get(c, a);
    if (!in) return c->old ? wv_null() : ev_err(c, WE_NUM, "out of memory");
    if (wb->g[a->node].pend && !in->pend) {
        /* an input is stale: so is this */
        c->stale = 1;
    }
    return inst_read(c, a, in);
}

static WVal ev_group_node(ECtx *c, const Ex *e) {
    return ev_agg_node(c, e);
}

/* ---- one group output for a key (lookups into a group) */

static WVal wg_out_value(ECtx *c, const WAgg *a, WInst *in, WGEnt *e, uint32_t j) {
    RtxWb *wb = c->wb;
    ECtx b;
    inst_ctx(wb, a, in, &b, c->old);
    if (e->acc[j].stop) {
        /* the first stop row of this key for this output */
        const WTab *t = &wb->tabs[a->tab];
        WGRow g;
        uint32_t r;
        if (!wg_row_alloc(wb, a, &g)) return ev_err(c, WE_NUM, "out of memory");
        for (r = 0; r < t->nrows; r++) {
            WRow rr;
            wb_row_load(wb, &rr, a->tab, r, c->old);
            wg_con(&b, a, &rr, &g);
            if (!g.stop && wb_key_eq(&g.key, &e->k) && g.oc[j].k == CN_STOP) return g.oc[j].v;
        }
    }
    return acc_value(&b, &a->outs[j], &e->acc[j], &e->best[j]);
}

static WVal ev_glookup(ECtx *c, const Ex *e) {
    RtxWb *wb = c->wb;
    const WName *gn = &wb->names[e->node];
    WVal kv;
    WKey k;
    WAgg *a;
    WInst *in;
    WGEnt *g;
    if (gn->pend) c->stale = 1;
    if (gn->v.t == WV_ERR) return gn->v;
    if (gn->v.t != WV_GRP) return ev_err(c, WE_TYPE, "not a group");
    if (e->col < 0) return ev_err(c, WE_TYPE, "a group row is not a value (add .output)");
    kv = ev(c, e->b);
    if (kv.t == WV_ERR) return kv;
    a = &wb->aggs[gn->v.u.i];
    if (!a->live || !a->ninst || !a->inst[0]) return wv_null();
    in = a->inst[0];
    if (in->pend || in->building) c->stale = 1;
    wb_key_of(&kv, &k);
    g = wg_get(wb, a, in, &k, 0);
    if (!g || !g->rows) return wv_null();
    return wg_out_value(c, a, in, g, (uint32_t)e->col);
}


/* ------------------------------------------------------------ rule graph
 *
 * A few thousand nodes at most (names, rules, columns, aggregates,
 * anchored cells), so a regraph (reverse edges, Tarjan, order, cycles,
 * chains) runs whenever a rule or a name's edges change.
 */

static uint32_t wb_gnode_new(RtxWb *wb, int kind, uint32_t ref) {
    WGNode *g;
    if (!wb_hgrow((void **)&wb->g, &wb->gcap, wb->ng + 1, sizeof(WGNode))) return WN32;
    g = &wb->g[wb->ng];
    memset(g, 0, sizeof *g);
    g->kind = (uint8_t)kind;
    g->ref = ref;
    g->tab = g->col = -1;
    wb->graph_dirty = 1;
    return wb->ng++;
}

/* Hard edges make a cycle; same-row, relative-row and membership edges
 * inside one table are a row's business (chains, per-row cycles). */
static int wb_sh_soft(int sh) {
    return sh == SH_ROW || sh == SH_REL || sh == SH_MEMB;
}

/* The relative offset of rule `ru`'s edge to column node `cn` (the most
 * backward one it reads). */
static int wb_rule_rel_off(const RtxWb *wb, const WRule *ru, int32_t col, int *has_pos,
                           int *has_neg) {
    (void)wb;
    *has_pos = *has_neg = 0;
    if (!(ru->relmask & (1u << col))) return 0;
    if (ru->relmin < 0) *has_neg = 1;
    if (ru->relmax > 0) *has_pos = 1;
    return ru->relmin;
}

/* The first row whose cell in (tab, col) holds rule ri: its position, or
 * -1 (rank of cycle members, labels). */
static int32_t wb_rule_first_row(RtxWb *wb, uint32_t ri) {
    const WRule *ru = &wb->rules[ri];
    const WTab *t = &wb->tabs[ru->tab];
    uint32_t r;
    for (r = 0; r < t->nrows; r++) {
        WRow rr;
        size_t lo, hi, slo, shi, flo, fhi;
        wb_row_load(wb, &rr, ru->tab, r, 0);
        if (!wb_cell_span(&rr, ru->col, &lo, &hi)) continue;
        if (!wb_cell_formula(rr.b, lo, hi, &slo, &shi, &flo, &fhi)) continue;
        if (shi - slo == ru->srcn && !memcmp(rr.b + slo, ru->src, ru->srcn)) return (int32_t)r;
    }
    return -1;
}

/* A node's label in a cycle path. */
static size_t wb_gnode_label(RtxWb *wb, uint32_t v, char *out, size_t cap) {
    const WGNode *g = &wb->g[v];
    if (out && cap) out[0] = 0;
    switch (g->kind) {
    case GN_NAME:
        return wb_name_label(wb, g->ref, out, cap);
    case GN_RULE: {
        const WRule *ru = &wb->rules[g->ref];
        return wb_cell_label(wb, ru->tab, wb_rule_first_row(wb, g->ref), ru->col, out, cap);
    }
    case GN_COL:
        return wb_cell_label(wb, g->tab, -1, g->col, out, cap);
    case GN_ABS: {
        const WAbs *x = &wb->abs[g->ref];
        const WTab *t = &wb->tabs[x->tab];
        char b[160];
        snprintf(b, sizeof b, "%.*s#%.*s", (int)t->namen, t->name, (int)x->ancn, x->anc);
        if (x->off) snprintf(b + strlen(b), sizeof b - strlen(b), "[%+d]", (int)x->off);
        snprintf(b + strlen(b), sizeof b - strlen(b), ".%.*s", (int)t->cnamen[x->col], t->cname[x->col]);
        return wb_puts(out, cap, 0, b);
    }
    case GN_IMP: {
        const WImp *m = &wb->imps[g->ref];
        const WUse *u = &wb->uses[m->use];
        char b[200];
        snprintf(b, sizeof b, "%.*s.%.*s", (int)u->namen, u->name, (int)m->n, m->txt);
        return wb_puts(out, cap, 0, b);
    }
    default:
        return wb_puts(out, cap, 0, "(aggregate)");
    }
}

/* Document order of the nodes (cycle paths walk in it, so they do not
 * depend on node ids): names by position, a table's rules by (first row,
 * column), then its columns; aggregates last. */
typedef struct {
    size_t at;
    uint32_t a, b, c;
} WRank;

static int wb_rank_lt(const WRank *x, const WRank *y) {
    if (x->at != y->at) return x->at < y->at;
    if (x->a != y->a) return x->a < y->a;
    if (x->b != y->b) return x->b < y->b;
    return x->c < y->c;
}

static void wb_rank_of(RtxWb *wb, uint32_t v, WRank *r) {
    const WGNode *g = &wb->g[v];
    memset(r, 0, sizeof *r);
    switch (g->kind) {
    case GN_NAME:
        r->at = wb->names[g->ref].raw_lo;
        break;
    case GN_RULE: {
        const WRule *ru = &wb->rules[g->ref];
        int32_t fr = wb_rule_first_row(wb, g->ref);
        r->at = wb->tabs[ru->tab].lo;
        r->a = 1;
        r->b = fr < 0 ? UINT32_MAX - 1 : (uint32_t)fr;
        r->c = (uint32_t)ru->col;
        break;
    }
    case GN_COL:
        r->at = wb->tabs[g->tab].lo;
        r->a = 2;
        r->b = (uint32_t)g->col;
        break;
    case GN_ABS:
        r->at = (size_t)-2;
        r->a = g->ref;
        break;
    default:
        r->at = (size_t)-1;
        r->a = v;
        break;
    }
}

static void wb_cycle_path(RtxWb *wb, uint32_t s, const uint32_t *comp, uint32_t *par,
                          uint32_t *queue, char *out, size_t cap) {
    uint32_t qh = 0, qt = 0, v, k, last = WN32;
    uint32_t path[17], nb[64];
    int np = 0, i, first = -1;
    size_t at = 0;
    char lb[160];
    par[s] = s;
    queue[qt++] = s;
    while (qh < qt && last == WN32) {
        const WGNode *g;
        uint32_t nd, m = 0, a, b;
        v = queue[qh++];
        g = &wb->g[v];
        nd = g->ndeps;
        if (nd <= 64) {
            WRank ra, rb;
            for (k = 0; k < nd; k++) nb[m++] = g->deps[k];
            for (a = 1; a < m; a++)
                for (b = a; b > 0; b--) {
                    uint32_t x;
                    wb_rank_of(wb, nb[b - 1], &ra);
                    wb_rank_of(wb, nb[b], &rb);
                    if (!wb_rank_lt(&rb, &ra)) break;
                    x = nb[b];
                    nb[b] = nb[b - 1];
                    nb[b - 1] = x;
                }
        }
        for (k = 0; k < nd; k++) {
            uint32_t w = m ? nb[k] : g->deps[k];
            if (comp[w] != comp[s]) continue;
            if (w == s) {
                last = v;
                break;
            }
            if (par[w] != WN32) continue;
            par[w] = v;
            queue[qt++] = w;
        }
    }
    v = last;
    while (v != WN32 && np < 16) {
        path[np++] = v;
        if (v == s) break;
        v = par[v];
    }
    for (k = 0; k < qt; k++) par[queue[k]] = WN32;
    out[0] = 0;
    at = 0;
    /* aggregates are internal: the path names the cells, columns, names */
    for (i = np - 1; i >= 0; i--) {
        if (wb->g[path[i]].kind == GN_AGG) continue;
        if (first < 0) first = i;
        wb_gnode_label(wb, path[i], lb, sizeof lb);
        at = wb_puts(out, cap, at, lb);
        at = wb_puts(out, cap, at, " \xe2\x86\x92 ");
    }
    if (np >= 16 && path[np - 1] != s) at = wb_puts(out, cap, at, "\xe2\x80\xa6 \xe2\x86\x92 ");
    if (wb->g[s].kind != GN_AGG || first < 0) wb_gnode_label(wb, s, lb, sizeof lb);
    else wb_gnode_label(wb, path[first], lb, sizeof lb);
    at = wb_puts(out, cap, at, lb);
}

/* Chains: a table's previous-row loops (a soft component with a backward
 * edge). `comp` the components. Sets t->ch, the chain-dependent columns
 * and every aggregate's block mode. Refused shapes (a next-row edge in a
 * loop) mark their rules. */
static void wb_push(RtxWb *wb, uint32_t v, int chg);

static void wb_chains(RtxWb *wb, const uint32_t *comp, const uint8_t *hard) {
    uint32_t ti, v, k;
    for (ti = 0; ti < wb->ntab; ti++) {
        WTab *t = &wb->tabs[ti];
        uint16_t cols = 0, dep = 0;
        uint8_t kk = 0;
        int changed = 1, c;
        t->relmask = 0;
        t->relb = t->relf = 0;
        /* columns in a soft component that loops through a backward edge */
        for (v = 0; v < wb->ng; v++) {
            const WGNode *g = &wb->g[v];
            const WRule *ru;
            int hp, hn;
            if (g->kind != GN_RULE || g->cyc) continue;
            ru = &wb->rules[g->ref];
            if (ru->tab != (int32_t)ti || ru->dead || !ru->refs) continue;
            t->relmask |= ru->relmask;
            if (ru->relmin < 0 && (uint8_t)(-ru->relmin) > t->relb) t->relb = (uint8_t)(-ru->relmin);
            if (ru->relmax > 0 && (uint8_t)ru->relmax > t->relf) t->relf = (uint8_t)ru->relmax;
            for (k = 0; k < g->ndeps; k++) {
                uint32_t w = g->deps[k];
                const WGNode *d = &wb->g[w];
                if (g->dsh[k] != SH_REL || d->kind != GN_COL || comp[w] != comp[v] || hard[comp[v]])
                    continue;
                wb_rule_rel_off(wb, ru, d->col, &hp, &hn);
                if (hp) {
                    /* a next-row edge that feeds back: refused (its rows
                     * read an error that says so) */
                    WGNode *gm = &wb->g[v];
                    WVal cv = wv_err_a(wb->ma, WE_REF,
                                       "%.*s.%.*s reads later rows (@col[+k]) back into itself: only previous rows (@col[-k]) may feed a chain",
                                       (int)t->namen, t->name, (int)t->cnamen[ru->col], t->cname[ru->col]);
                    if (wb_grow(wb, (void **)&wb->cyv, &wb->cyvcap, wb->ncyv + 1, sizeof(WVal))) {
                        wb->cyv[wb->ncyv] = cv;
                        gm->cyc = 1;
                        gm->cyi = wb->ncyv++;
                    }
                    continue;
                }
                if (hn) {
                    cols |= (uint16_t)(1u << d->col);
                    cols |= (uint16_t)(1u << ru->col);
                    if ((uint8_t)(-ru->relmin) > kk) kk = (uint8_t)(-ru->relmin);
                }
            }
        }
        /* every column of those components */
        if (cols) {
            for (v = 0; v < wb->ng; v++) {
                const WGNode *g = &wb->g[v];
                uint32_t c2;
                if (g->kind != GN_COL || g->tab != (int32_t)ti) continue;
                for (c2 = 0; c2 < (uint32_t)t->ncols; c2++)
                    if ((cols & (1u << c2)) && comp[t->cnode[c2]] == comp[v]) cols |= (uint16_t)(1u << g->col);
            }
        }
        /* columns reading them (same row or other rows), transitively */
        dep = cols;
        while (changed) {
            changed = 0;
            for (v = 0; v < wb->ng; v++) {
                const WGNode *g = &wb->g[v];
                const WRule *ru;
                if (g->kind != GN_RULE) continue;
                ru = &wb->rules[g->ref];
                if (ru->tab != (int32_t)ti || ru->dead || !ru->refs) continue;
                if (dep & (1u << ru->col)) continue;
                if ((ru->rowmask | ru->relmask) & dep) {
                    dep |= (uint16_t)(1u << ru->col);
                    changed = 1;
                }
            }
        }
        if (cols != t->ch.cols || kk != t->ch.k) {
            /* the chain changed shape: its checkpoints start over */
            free(t->ch.ck);
            free(t->ch.ckok);
            t->ch.ck = NULL;
            t->ch.ckok = NULL;
            t->ch.ckcap = 0;
            t->ch.front = 0;
            t->ch.nmark = 0;
        }
        t->ch.on = cols != 0;
        t->ch.cols = cols;
        t->ch.dep = dep;
        t->ch.k = kk ? kk : 1;
        t->ch.ncols = 0;
        for (c = 0; c < RTX_WB_COLS_MAX; c++)
            if (cols & (1u << c)) t->ch.cidx[c] = t->ch.ncols++;
        if (t->relb > 64) t->relb = 64;
        if (t->relf > 64) t->relf = 64;
    }
    /* aggregates over chain values keep block partials */
    for (k = 0; k < wb->naggs; k++) {
        WAgg *a = &wb->aggs[k];
        const WTab *t;
        uint8_t bm;
        if (!a->live) continue;
        t = &wb->tabs[a->tab];
        bm = t->ch.on && ((a->rowmask & t->ch.dep) != 0);
        if (bm != a->blockmode) {
            a->blockmode = bm;
            a->full = 1;
            wb_push(wb, a->node, 1);
        }
    }
}

/* Reverse edges, Tarjan (order + cycles), chains. Seeds the heap with
 * every node whose cycle state changed. */
static void wb_push(RtxWb *wb, uint32_t v, int chg);
static void wb_heap_push(RtxWb *wb, uint32_t id);

static int wb_regraph(RtxWb *wb, int seed) {
    uint32_t nn = wb->ng, v, k, idx = 0, topo = 0, sp = 0, fp = 0, ti;
    uint32_t *cnt, *index, *low, *stk, *fv, *fi, *comp, *par = NULL, *queue = NULL;
    uint8_t *on, *was, *hard;
    size_t total = 0;
    wb->st.regraphs++;
    wb->st.cycles = 0;
    wb->ncyv = 0;
    wb->graph_dirty = 0;
    if (!nn) return 1;
    /* a column holds its live rules */
    for (ti = 0; ti < wb->ntab; ti++) {
        WTab *t = &wb->tabs[ti];
        int32_t c;
        for (c = 0; c < t->ncols; c++) {
            WGNode *g = &wb->g[t->cnode[c]];
            uint32_t n = 0, r;
            for (r = 0; r < wb->nrules; r++)
                if (!wb->rules[r].dead && wb->rules[r].refs && wb->rules[r].tab == (int32_t)ti &&
                    wb->rules[r].col == c)
                    n++;
            g->deps = (uint32_t *)wb_ma(wb, (size_t)(n ? n : 1) * sizeof(uint32_t));
            g->dsh = (uint8_t *)wb_ma(wb, n ? n : 1);
            g->ndeps = 0;
            if (!g->deps || !g->dsh) return 0;
            for (r = 0; r < wb->nrules; r++)
                if (!wb->rules[r].dead && wb->rules[r].refs && wb->rules[r].tab == (int32_t)ti &&
                    wb->rules[r].col == c) {
                    g->deps[g->ndeps] = wb->rules[r].node;
                    g->dsh[g->ndeps++] = SH_MEMB;
                }
        }
    }
    cnt = (uint32_t *)calloc((size_t)nn + 1, sizeof(uint32_t));
    index = (uint32_t *)malloc((size_t)nn * sizeof(uint32_t));
    low = (uint32_t *)malloc((size_t)nn * sizeof(uint32_t));
    stk = (uint32_t *)malloc((size_t)nn * sizeof(uint32_t));
    fv = (uint32_t *)malloc((size_t)nn * sizeof(uint32_t));
    fi = (uint32_t *)malloc((size_t)nn * sizeof(uint32_t));
    comp = (uint32_t *)malloc((size_t)nn * sizeof(uint32_t));
    on = (uint8_t *)calloc(nn, 1);
    was = (uint8_t *)calloc(nn, 1);
    hard = (uint8_t *)calloc(nn, 1);
    par = (uint32_t *)malloc((size_t)nn * sizeof(uint32_t));
    queue = (uint32_t *)malloc((size_t)nn * sizeof(uint32_t));
    if (!cnt || !index || !low || !stk || !fv || !fi || !comp || !on || !was || !hard || !par ||
        !queue)
        goto fail;
    memset(par, 0xff, (size_t)nn * sizeof(uint32_t));
    memset(comp, 0xff, (size_t)nn * sizeof(uint32_t));
    for (v = 0; v < nn; v++) {
        WGNode *n = &wb->g[v];
        was[v] = n->cyc;
        n->cyc = 0;
        index[v] = WN32;
        if (n->kind == GN_DEAD) continue;
        for (k = 0; k < n->ndeps; k++) cnt[n->deps[k]]++;
        total += n->ndeps;
    }
    wb->rdeps = (uint32_t *)wb_ma(wb, (total ? total : 1) * sizeof(uint32_t));
    wb->rdsh = (uint8_t *)wb_ma(wb, total ? total : 1);
    if (!wb->rdeps || !wb->rdsh) goto fail;
    wb->nrd = total;
    {
        uint32_t acc = 0;
        for (v = 0; v < nn; v++) {
            wb->g[v].rd0 = acc;
            wb->g[v].rdn = 0;
            acc += cnt[v];
        }
    }
    for (v = 0; v < nn; v++) {
        WGNode *n = &wb->g[v];
        if (n->kind == GN_DEAD) continue;
        for (k = 0; k < n->ndeps; k++) {
            WGNode *d = &wb->g[n->deps[k]];
            wb->rdeps[d->rd0 + d->rdn] = v;
            wb->rdsh[d->rd0 + d->rdn++] = n->dsh[k];
        }
    }
    /* Tarjan, iterative: components pop dependencies first */
    for (v = 0; v < nn; v++) {
        if (index[v] != WN32 || wb->g[v].kind == GN_DEAD) continue;
        fv[fp] = v;
        fi[fp] = 0;
        fp++;
        index[v] = low[v] = idx++;
        stk[sp++] = v;
        on[v] = 1;
        while (fp) {
            uint32_t x = fv[fp - 1];
            if (fi[fp - 1] < wb->g[x].ndeps) {
                uint32_t w = wb->g[x].deps[fi[fp - 1]++];
                if (wb->g[w].kind == GN_DEAD) continue;
                if (index[w] == WN32) {
                    index[w] = low[w] = idx++;
                    stk[sp++] = w;
                    on[w] = 1;
                    fv[fp] = w;
                    fi[fp] = 0;
                    fp++;
                } else if (on[w] && index[w] < low[x]) {
                    low[x] = index[w];
                }
                continue;
            }
            if (low[x] == index[x]) {
                uint32_t w, first = topo, size = 0, j, s0 = x, q;
                int is_hard = 0, self = 0;
                do {
                    w = stk[--sp];
                    on[w] = 0;
                    comp[w] = first;
                    wb->g[w].scc = first;
                    wb->g[w].topo = ((uint64_t)topo++ + 1) << 16;
                    size++;
                } while (w != x);
                /* the component's members sit just above sp */
                for (j = sp; j < sp + size; j++) {
                    const WGNode *g = &wb->g[stk[j]];
                    for (q = 0; q < g->ndeps; q++) {
                        if (g->deps[q] == stk[j]) self = 1;
                        if (comp[g->deps[q]] == first && !wb_sh_soft(g->dsh[q])) is_hard = 1;
                    }
                }
                if (size > 1 || self) {
                    hard[first] = (uint8_t)is_hard;
                    if (is_hard) {
                        char path[400];
                        WVal cv;
                        WRank r0, r1;
                        wb->st.cycles++;
                        /* start at the member first in document order */
                        wb_rank_of(wb, s0, &r0);
                        for (j = sp; j < sp + size; j++) {
                            wb_rank_of(wb, stk[j], &r1);
                            if (wb_rank_lt(&r1, &r0)) {
                                s0 = stk[j];
                                r0 = r1;
                            }
                        }
                        wb_cycle_path(wb, s0, comp, par, queue, path, sizeof path);
                        cv = wv_err_a(wb->ma, WE_CYCLE, "%s", path);
                        if (!wb_grow(wb, (void **)&wb->cyv, &wb->cyvcap, wb->ncyv + 1, sizeof(WVal)))
                            goto fail;
                        wb->cyv[wb->ncyv] = cv;
                        for (j = sp; j < sp + size; j++) {
                            wb->g[stk[j]].cyc = 1;
                            wb->g[stk[j]].cyi = wb->ncyv;
                        }
                        wb->ncyv++;
                    }
                }
            }
            fp--;
            if (fp) {
                uint32_t p = fv[fp - 1];
                if (low[x] < low[p]) low[p] = low[x];
            }
        }
    }
    wb_chains(wb, comp, hard);
    if (wb->nheap) {
        /* the order moved under queued nodes: queue them again */
        uint32_t q, nq = wb->nheap;
        uint32_t *keep = (uint32_t *)malloc((size_t)nq * sizeof(uint32_t));
        if (keep) {
            memcpy(keep, wb->heap, (size_t)nq * sizeof(uint32_t));
            wb->nheap = 0;
            for (q = 0; q < nq; q++) wb->g[keep[q]].queued = 0;
            for (q = 0; q < nq; q++)
                if (wb->g[keep[q]].kind != GN_DEAD) wb_heap_push(wb, keep[q]);
            free(keep);
        }
    }
    if (seed) {
        for (v = 0; v < nn; v++)
            if (wb->g[v].kind != GN_DEAD && (wb->g[v].cyc || was[v])) wb_push(wb, v, 1);
    }
    free(cnt);
    free(index);
    free(low);
    free(stk);
    free(fv);
    free(fi);
    free(comp);
    free(on);
    free(was);
    free(hard);
    free(par);
    free(queue);
    return 1;
fail:
    free(cnt);
    free(index);
    free(low);
    free(stk);
    free(fv);
    free(fi);
    free(comp);
    free(on);
    free(was);
    free(hard);
    free(par);
    free(queue);
    return 0;
}

/* ---------------------------------------------------------------- recalc */

static void wb_heap_push(RtxWb *wb, uint32_t id) {
    uint32_t i;
    if (wb->g[id].queued || ((wb->hround & 1) && wb->g[id].popped == wb->hround)) return;
    if (!wb_hgrow((void **)&wb->heap, &wb->heapcap, wb->nheap + 1, sizeof(uint32_t))) return;
    wb->g[id].queued = 1;
    i = wb->nheap++;
    while (i > 0) {
        uint32_t p = (i - 1) / 2;
        if (wb->g[wb->heap[p]].topo <= wb->g[id].topo) break;
        wb->heap[i] = wb->heap[p];
        i = p;
    }
    wb->heap[i] = id;
}

static uint32_t wb_heap_pop(RtxWb *wb) {
    uint32_t top = wb->heap[0], last = wb->heap[--wb->nheap], i = 0;
    uint32_t n = wb->nheap;
    while (n) {
        uint32_t l = 2 * i + 1, r = l + 1, m = i;
        uint64_t mt = wb->g[last].topo;
        if (l < n && wb->g[wb->heap[l]].topo < mt) {
            m = l;
            mt = wb->g[wb->heap[l]].topo;
        }
        if (r < n && wb->g[wb->heap[r]].topo < mt) m = r;
        if (m == i) break;
        wb->heap[i] = wb->heap[m];
        i = m;
    }
    if (n) wb->heap[i] = last;
    wb->g[top].queued = 0;
    return top;
}

/* Queue node v; chg: a wholesale change (a rule's every row, an
 * aggregate's rebuild, a column's every reader). */
static void wb_push(RtxWb *wb, uint32_t v, int chg) {
    if (v >= wb->ng || wb->g[v].kind == GN_DEAD) return;
    if (chg) wb->g[v].chg = 1;
    wb_heap_push(wb, v);
}


/* ------------------------------------------------------------- the chain
 *
 * A table's previous-row chain: checkpoints per block (the carried values
 * of its last K rows), a frontier below which they are known good, marks
 * where rows changed at / past it. Values past the frontier are computed
 * from the last good checkpoint on demand (a budget in the view), and the
 * chain job moves the frontier: it recomputes a block, compares its end
 * state with the old checkpoint, and stops (to the next mark) when they
 * are equal — the highlighter's relex that converges.
 */

enum { SEED_NONE = 0, SEED_CK, SEED_WIN };

static uint32_t ch_slots(const WChain *ch) {
    return (uint32_t)ch->k * ch->ncols;
}

static int ch_fit(WTab *t) {
    WChain *ch = &t->ch;
    uint32_t need = t->bidcap ? t->bidcap : 1, sl = ch_slots(ch), oc = ch->ckcap;
    if (need <= ch->ckcap) return 1;
    {
        WVal *nv = (WVal *)realloc(ch->ck, (size_t)need * (sl ? sl : 1) * sizeof(WVal));
        uint8_t *no;
        if (!nv) return 0;
        memset(nv + (size_t)oc * sl, 0, (size_t)(need - oc) * sl * sizeof(WVal));
        ch->ck = nv;
        no = (uint8_t *)realloc(ch->ckok, need);
        if (!no) return 0;
        memset(no + oc, 0, need - oc);
        ch->ckok = no;
    }
    ch->ckcap = need;
    return 1;
}

static int ch_window_room(WChain *ch, uint32_t rows) {
    uint32_t nc = ch->ncols ? ch->ncols : 1;
    if (rows <= ch->wcap) return 1;
    {
        uint32_t cap = rows + rows / 2 + 64;
        WVal *nv = (WVal *)realloc(ch->wv, (size_t)cap * nc * sizeof(WVal));
        uint8_t *ns;
        if (!nv) return 0;
        ch->wv = nv;
        ns = (uint8_t *)realloc(ch->wstl, cap);
        if (!ns) return 0;
        ch->wstl = ns;
        ch->wcap = cap;
    }
    return 1;
}

/* A chain mark: rows of block bid changed at / past the frontier. */
static void ch_mark(WTab *t, uint32_t bid) {
    WChain *ch = &t->ch;
    uint32_t i;
    for (i = 0; i < ch->nmark; i++)
        if (ch->marks[i] == bid) return;
    if (!wb_hgrow((void **)&ch->marks, &ch->markcap, ch->nmark + 1, sizeof(uint32_t))) {
        ch->nmark = 0;
        ch->front = 0; /* no marks: everything from the top */
        memset(ch->ckok, 0, ch->ckcap);
        return;
    }
    ch->marks[ch->nmark++] = bid;
}

static void ch_unmark(WTab *t, uint32_t bid) {
    WChain *ch = &t->ch;
    uint32_t i;
    for (i = 0; i < ch->nmark; i++)
        if (ch->marks[i] == bid) {
            ch->marks[i] = ch->marks[--ch->nmark];
            return;
        }
}

/* The next marked block position at or after k, or nb. */
static uint32_t ch_next_mark(const WTab *t, uint32_t k) {
    const WChain *ch = &t->ch;
    uint32_t i, best = t->nb;
    for (i = 0; i < ch->nmark; i++) {
        uint32_t b = ch->marks[i];
        if (b < t->nbid && t->blk[b].live && t->blk[b].pos >= k && t->blk[b].pos < best)
            best = t->blk[b].pos;
    }
    return best;
}

/* Rows of table ti changed in block position k: the chain is dirty from
 * there (its later checkpoints stand until a recompute disproves them). */
static void wb_chain_dirty(RtxWb *wb, uint32_t ti, uint32_t k) {
    WTab *t = &wb->tabs[ti];
    if (!t->ch.on || !t->nb) return;
    if (k >= t->nb) k = t->nb - 1;
    ch_mark(t, t->bord[k]);
    if (k < t->ch.front) t->ch.front = k;
    wb->jobs = 1;
    wb->st.chain_dirty++;
}

/* Everything from the top (a wholesale change of a chain column). */
static void wb_chain_reset(RtxWb *wb, uint32_t ti) {
    WTab *t = &wb->tabs[ti];
    if (!t->ch.on) return;
    t->ch.front = 0;
    t->ch.nmark = 0;
    if (t->ch.ckok) memset(t->ch.ckok, 0, t->ch.ckcap);
    wb->jobs = 1;
}

/* Walk block position k of table ti (rows 0 .. upto of it): the window
 * holds the chain values of the K rows before it and the rows walked.
 * seed: SEED_CK the checkpoint of block k-1 (stale past the frontier),
 * SEED_WIN the window's last K rows (a walk of block k-1 just ended),
 * SEED_NONE row 0. per_row sees each row after its chain values. */
static int wb_chain_walk(ECtx *c, uint32_t ti, uint32_t k, uint32_t upto, int seed,
                         void (*per_row)(void *, WRow *, uint32_t), void *ctx) {
    RtxWb *wb = c->wb;
    WTab *t = &wb->tabs[ti];
    WChain *ch = &t->ch;
    uint32_t nc = ch->ncols, K = ch->k, f = t->bfirst[k], n = t->blk[t->bord[k]].n, s, j, seedn;
    int32_t col;
    WRow rr;
    if (!n) return 1;
    if (upto >= n) upto = n - 1;
    if (!ch_window_room(ch, K + n + 1)) return 0;
    seedn = f < K ? f : K;
    if (seed == SEED_WIN && ch->wgen == wb->opgen && ch->wlo + ch->wn == f && ch->wn >= seedn) {
        memmove(ch->wv, ch->wv + (size_t)(ch->wn - seedn) * nc, (size_t)seedn * nc * sizeof(WVal));
        memmove(ch->wstl, ch->wstl + (ch->wn - seedn), seedn);
    } else if (f) {
        uint32_t pb = t->bord[k - 1];
        const WVal *ck = ch->ck && pb < ch->ckcap ? ch->ck + (size_t)pb * ch_slots(ch) : NULL;
        int ok = ck && ch->ckok[pb];
        int stale = !ok || k > ch->front;
        for (s = 0; s < seedn; s++) {
            for (j = 0; j < nc; j++)
                ch->wv[(size_t)s * nc + j] = ok ? ck[(size_t)(K - seedn + s) * nc + j] : wv_null();
            ch->wstl[s] = (uint8_t)stale;
        }
        if (stale) {
            c->stale = 1;
            if (!ok) c->nolast = 1;
        }
    }
    ch->wlo = f - seedn;
    ch->wn = seedn;
    ch->wgen = wb->opgen;
    ch->walking = 1;
    for (s = 0; s <= upto; s++) {
        uint8_t st0 = c->stale;
        wb_row_load(wb, &rr, (int32_t)ti, f + s, 0);
        c->stale = 0;
        for (col = 0; col < t->ncols; col++) {
            if (!(ch->cols & (1u << col))) continue;
            ch->wv[(size_t)ch->wn * nc + ch->cidx[col]] = wb_cell_eval(c, &rr, col);
        }
        ch->wstl[ch->wn] = c->stale;
        c->stale |= st0;
        ch->wn++;
        wb->st.chain_rows++;
        if (per_row) per_row(ctx, &rr, t->bord[k]);
    }
    ch->walking = 0;
    return 1;
}

/* Chain value of (ti, pos, col) (a chain column). */
static WVal wb_chain_val(ECtx *c, int32_t ti, int32_t pos, int col) {
    RtxWb *wb = c->wb;
    WTab *t = &wb->tabs[ti];
    WChain *ch = &t->ch;
    uint32_t k, target, kk;
    if (pos < 0 || (uint32_t)pos >= t->nrows) return wv_null();
    if (ch->wgen == wb->opgen && (uint32_t)pos >= ch->wlo && (uint32_t)pos < ch->wlo + ch->wn) {
        uint32_t i = (uint32_t)pos - ch->wlo;
        if (ch->wstl[i]) c->stale = 1;
        return ch->wv[(size_t)i * ch->ncols + ch->cidx[col]];
    }
    if (ch->walking || c->depth > 150) {
        /* a nested read far from the walk: the cell itself (recursion) */
        WRow *r = wb_ring_get(c, ti, (uint32_t)pos);
        ECtx e = *c;
        e.depth = c->depth + 8;
        if (!r) return ev_err(c, WE_NUM, "out of memory");
        return wb_cell_eval(&e, r, col);
    }
    k = tb_bpos(t, (uint32_t)pos);
    target = (uint32_t)pos - t->bfirst[k];
    if (k > ch->front && t->bfirst[k] - t->bfirst[ch->front] <= (uint32_t)RTX_WB_VIEW_CHAIN) {
        /* past the frontier, within reach: walk the blocks from it */
        for (kk = ch->front; kk < k; kk++)
            if (!wb_chain_walk(c, (uint32_t)ti, kk, WN32, kk == ch->front ? SEED_CK : SEED_WIN, NULL,
                               NULL))
                break;
        wb_chain_walk(c, (uint32_t)ti, k, target, SEED_WIN, NULL, NULL);
        wb->st.chain_view++;
    } else {
        /* at the frontier (its checkpoint is good), or too far to walk
         * inline: the old checkpoint, stale, and the job is wanted there
         * (a name reading it is stale until the job passes) */
        wb_chain_walk(c, (uint32_t)ti, k, target, SEED_CK, NULL, NULL);
        if (k > ch->front) {
            c->stale = 1;
            if (!ch->want_pos || k > ch->want_pos) ch->want_pos = k;
            wb->jobs = 1;
        }
    }
    if (ch->wgen == wb->opgen && (uint32_t)pos >= ch->wlo && (uint32_t)pos < ch->wlo + ch->wn) {
        uint32_t i = (uint32_t)pos - ch->wlo;
        if (ch->wstl[i]) c->stale = 1;
        return ch->wv[(size_t)i * ch->ncols + ch->cidx[col]];
    }
    return ev_err(c, WE_NUM, "chain value unavailable");
}


/* ------------------------------------------------ recalc and the jobs
 *
 * The heap pops nodes in dependency order. A name evaluates; a rule or a
 * column passes a wholesale change on by edge shape; an aggregate
 * applies its row deltas (already in its partials) or plans a rebuild.
 * Rebuilds and chain recomputes are jobs: done inline while the sync's
 * budget lasts (`inline_left` row evaluations), else stepped from the
 * host's idle loop. A node whose input is stale is stale (its last value
 * stays) until the input settles.
 */

static void wb_note_changed(RtxWb *wb, uint32_t ni) {
    const WName *n = &wb->names[ni];
    if (n->f_hi <= n->f_lo || n->f_lo == WNONE) return;
    if (wb->nchanged < RTX_WB_CHANGED_MAX) wb->changed[wb->nchanged++] = ni;
    else wb->chg_all = 1;
}

static int wb_deps_pend(const RtxWb *wb, uint32_t v) {
    const WGNode *g = &wb->g[v];
    uint32_t k;
    /* an edge inside its component (a row-level cycle: `@f` reading its
     * own column) carries no staleness: the component's inputs do */
    for (k = 0; k < g->ndeps; k++)
        if (wb->g[g->deps[k]].pend && wb->g[g->deps[k]].scc != g->scc) return 1;
    return 0;
}

static void wb_push_readers(RtxWb *wb, uint32_t v, int chg) {
    const WGNode *g = &wb->g[v];
    uint32_t k;
    for (k = 0; k < g->rdn; k++) wb_push(wb, wb->rdeps[g->rd0 + k], chg);
}

static void wb_values_moved(RtxWb *wb) {
    wb->vgen++;
    wb->opgen++;
}

static WVal wb_name_eval(RtxWb *wb, uint32_t ni, uint8_t *stale) {
    ECtx c;
    WVal v;
    const WName *n = &wb->names[ni];
    ectx_init(&c, wb);
    c.self_name = ni;
    v = ev(&c, n->ex);
    if (v.t == WV_ROW || v.t == WV_TAB) v = wv_row_err(&c, &v);
    *stale = c.stale;
    return v;
}

static WVal wb_abs_eval(RtxWb *wb, uint32_t ai, uint8_t *stale) {
    ECtx c;
    const WAbs *x = &wb->abs[ai];
    WVal err;
    int32_t p;
    WRow *r;
    WVal v;
    ectx_init(&c, wb);
    c.self_tab = x->tab;
    c.self_col = x->col;
    p = wb_anchor_pos(&c, x->tab, x->anc, x->ancn, x->off, &err);
    if (p == -1) return err;
    if (p < 0) return wv_null();
    r = wb_ring_get(&c, x->tab, (uint32_t)p);
    if (!r) return wv_null();
    v = wb_cell_eval(&c, r, x->col);
    *stale = c.stale;
    return v;
}

static void wb_agg_plan(RtxWb *wb, WAgg *a);
static size_t wb_chain_step(RtxWb *wb, uint32_t ti, double deadline_us, size_t budget);

/* One node off the heap. */
static void wb_node_update(RtxWb *wb, uint32_t v) {
    WGNode *g = &wb->g[v];
    int chg = g->chg, ipend;
    g->chg = 0;
    wb->st.visited++;
    ipend = wb_deps_pend(wb, v);
    switch (g->kind) {
    case GN_NAME: {
        WName *n = &wb->names[g->ref];
        WVal nv;
        uint8_t stl = 0;
        if (n->clash || !n->def) return;
        if (g->cyc) {
            nv = wb->cyv[g->cyi];
        } else if (ipend) {
            if (!n->pend) {
                n->pend = g->pend = 1;
                wb_push_readers(wb, v, 0);
                wb_values_moved(wb);
            }
            return;
        } else {
            nv = wb_name_eval(wb, g->ref, &stl);
        }
        if (stl && !g->cyc) {
            /* read a stale value not on its edges (a row of a chain past
             * the frontier): stale until the job settles it */
            if (!n->pend) {
                n->pend = g->pend = 1;
                wb_push_readers(wb, v, 0);
            }
            /* the last value stays what paints (dimmed, marked) */
            wb_values_moved(wb);
            return;
        }
        if (!wv_same(&nv, &n->v) || n->pend) {
            int moved = !wv_same(&nv, &n->v);
            n->v = wv_keep(wb, nv);
            n->pend = g->pend = 0;
            if (moved) wb_note_changed(wb, g->ref);
            wb_values_moved(wb);
            wb_push_readers(wb, v, moved);
        }
        return;
    }
    case GN_RULE: {
        WRule *r = &wb->rules[g->ref];
        uint8_t np = (uint8_t)(ipend && !g->cyc);
        if (!r->refs || r->dead) return; /* no row holds it: inert until gc */
        if (np != g->pend || chg) {
            g->pend = r->pend = np;
            wb->chg_cells = 1;
            wb_values_moved(wb);
            if (r->tab >= 0) wb_push(wb, wb->tabs[r->tab].cnode[r->col], chg);
        }
        return;
    }
    case GN_COL: {
        uint8_t np = (uint8_t)ipend;
        uint32_t k;
        WTab *t = &wb->tabs[g->tab];
        if (!chg && np == g->pend) return;
        g->pend = np;
        if (chg) {
            if (t->kx && t->kx[g->col]) t->kx[g->col]->ok = 0;
            if (t->ch.on && (t->ch.dep & (1u << g->col))) wb_chain_reset(wb, (uint32_t)g->tab);
            wb->chg_cells = 1;
        }
        for (k = 0; k < g->rdn; k++) {
            uint32_t w = wb->rdeps[g->rd0 + k];
            uint8_t sh = wb->rdsh[g->rd0 + k];
            if (chg && sh == SH_ALL && wb->g[w].kind == GN_AGG) wb->aggs[wb->g[w].ref].full = 1;
            if (chg && (sh == SH_LOOK || sh == SH_KEY) && wb->g[w].kind == GN_AGG)
                wb->aggs[wb->g[w].ref].full = 1;
            wb_push(wb, w, chg);
        }
        wb_values_moved(wb);
        return;
    }
    case GN_AGG: {
        WAgg *a = &wb->aggs[g->ref];
        uint32_t i;
        int moved = 0, building = 0;
        if (!a->live) return;
        if (chg && !a->keep) a->full = 1;
        if (g->cyc) {
            /* readers see the cycle; the partials wait */
            if (!g->pend) {
                g->pend = 0;
            }
            if (chg) wb_push_readers(wb, v, 1);
            return;
        }
        if (ipend) {
            if (!a->pend) {
                a->pend = g->pend = 1;
                wb_push_readers(wb, v, 0);
                wb_values_moved(wb);
            }
            return;
        }
        if (a->full) wb_agg_plan(wb, a);
        for (i = 0; i < a->ninst; i++) {
            WInst *in = a->inst[i];
            if (!in || !in->live) continue;
            if (in->building || in->full) {
                building = 1;
                continue;
            }
            if (a->blockmode && wb->tabs[a->tab].ch.front < wb->tabs[a->tab].nb) {
                /* the chain job owes blocks: stale until it passes */
                building = 1;
                in->pend = 1;
                continue;
            }
            if (inst_publish(wb, a, in) == 2) moved = 1;
            if (in->building) building = 1; /* publish turned a rescan into a job */
        }
        if (building) {
            if (!g->pend) {
                a->pend = g->pend = 1;
                wb_push_readers(wb, v, 0);
            }
            wb->jobs = 1;
            if (moved) wb_values_moved(wb);
            return;
        }
        if (moved || g->pend) {
            a->pend = g->pend = 0;
            wb_values_moved(wb);
            wb->chg_cells = 1;
            wb_push_readers(wb, v, moved);
        }
        return;
    }
    case GN_IMP:
        wb_imp_update(wb, v);
        return;
    case GN_ABS: {
        WAbs *x = &wb->abs[g->ref];
        WVal nv;
        uint8_t stl = 0;
        if (g->cyc) {
            nv = wb->cyv[g->cyi];
        } else if (ipend) {
            if (!x->pend) {
                x->pend = g->pend = 1;
                wb_push_readers(wb, v, 0);
            }
            return;
        } else {
            nv = wb_abs_eval(wb, g->ref, &stl);
        }
        if (stl) {
            /* the last value stays */
            if (!x->pend) {
                x->pend = g->pend = 1;
                wb_push_readers(wb, v, 0);
            }
            wb->jobs = 1;
            return;
        }
        if (!wv_same(&nv, &x->v) || x->pend) {
            int moved = !wv_same(&nv, &x->v);
            x->v = wv_keep(wb, nv);
            x->pend = g->pend = 0;
            wb_values_moved(wb);
            wb_push_readers(wb, v, moved);
        }
        return;
    }
    default:
        return;
    }
}

static void wb_recalc_heap(RtxWb *wb) {
    /* one round: a node re-queued after it popped is in a cycle (its
     * value is the cycle's, or its rows find the cycle when evaluated) */
    wb->hround++;
    while (wb->nheap) {
        uint32_t v = wb_heap_pop(wb);
        wb->g[v].popped = wb->hround;
        wb_node_update(wb, v);
    }
    wb->hround++;
}

/* ---- builds */

/* A rebuild of every instance of `a` (its inputs settled): planned; the
 * build step (inline or a job) walks the blocks. */
static void wb_agg_plan(RtxWb *wb, WAgg *a) {
    uint32_t i;
    WTab *t = &wb->tabs[a->tab];
    a->full = 0;
    for (i = 0; i < a->ninst; i++) {
        WInst *in = a->inst[i];
        if (!in || !in->live) continue;
        inst_begin(wb, a, in);
    }
    if (a->blockmode) wb_chain_reset(wb, (uint32_t)a->tab);
    t->nomerge = 1;
    wb->jobs = 1;
}

/* A new instance a reader needs: built at once when small (or settling),
 * else planned (a job, wanted by the view). */

static void wb_inst_build_now(RtxWb *wb, WAgg *a, WInst *in) {
    const WTab *t = &wb->tabs[a->tab];
    inst_begin(wb, a, in);
    if (a->blockmode) {
        /* the chain job builds block partials in order */
        wb_chain_reset(wb, (uint32_t)a->tab);
        a->wanted = 1;
        wb->jobs = 1;
        wb->tabs[a->tab].nomerge = 1;
        if (!g_wb_settling && t->nrows > g_wb_inline / 4) return;
    }
    if (g_wb_settling || t->nrows <= wb->inline_left || t->nrows <= 4096) {
        ECtx c;
        WGRow g;
        uint32_t k;
        size_t rows = 0;
        if (a->blockmode) {
            /* walk the chain now */
            wb_chain_step(wb, (uint32_t)a->tab, 0, (size_t)-1);
        } else {
            inst_ctx(wb, a, in, &c, 0);
            if (a->grp && !wg_row_alloc(wb, a, &g)) return;
            for (k = 0; k < t->nb; k++) {
                uint32_t bid = t->bord[k];
                if (in->ldone && in->ldone[bid]) continue;
                inst_block(wb, a, in, bid, &c, &g);
                rows += t->blk[bid].n;
            }
            in->building = 0;
            inst_publish(wb, a, in);
        }
        if (wb->inline_left > rows) wb->inline_left -= rows;
        else wb->inline_left = 0;
        return;
    }
    a->wanted = 1;
    wb->tabs[a->tab].nomerge = 1;
    wb->jobs = 1;
}


/* ---- the build job: every building instance over one table, one walk */

static int wb_deadline_hit(double deadline_us) {
    return deadline_us > 0 && wb_now_us() >= deadline_us;
}

/* Finish the instances over table ti whose builds are done: their nodes
 * publish at the next heap pass. */
static void wb_tab_builds_done(RtxWb *wb, uint32_t ti) {
    WTab *t = &wb->tabs[ti];
    uint32_t i, j, any = 0;
    for (i = 0; i < t->naggs; i++) {
        WAgg *a = &wb->aggs[t->aggs[i]];
        int done = 1;
        if (!a->live) continue;
        for (j = 0; j < a->ninst; j++) {
            WInst *in = a->inst[j];
            if (!in || !in->live || !in->building) continue;
            if (a->blockmode) {
                any = 1;
                continue;
            }
            {
                uint32_t k;
                for (k = 0; k < t->nb && done; k++)
                    if (!in->ldone || !in->ldone[t->bord[k]]) done = 0;
            }
            if (done) {
                in->building = 0;
                wb_push(wb, a->node, 0);
            } else {
                any = 1;
            }
        }
    }
    if (!any) t->nomerge = 0;
}

/* One step of the build job over table ti: every building instance (the
 * wanted ones only, when `wanted`), block by block in table order, a
 * chunk of instances at a time so a step ends near its deadline even
 * under a thousand aggregates. Returns work units done (row x instance
 * evaluations): the budget counts those, not rows. */
static size_t wb_tab_build_step(RtxWb *wb, uint32_t ti, double deadline_us, size_t budget,
                                int wanted) {
    WTab *t = &wb->tabs[ti];
    uint32_t i, j, n = 0, k, s;
    WAgg **ag;
    WInst **in;
    ECtx *cx;
    WGRow *gr;
    size_t work = 0;
    int stop = 0;
    for (i = 0; i < t->naggs; i++) {
        WAgg *a = &wb->aggs[t->aggs[i]];
        if (!a->live || a->blockmode || (wanted && !a->wanted)) continue;
        for (j = 0; j < a->ninst; j++)
            if (a->inst[j] && a->inst[j]->live && a->inst[j]->building) n++;
    }
    if (!n) return 0;
    ag = (WAgg **)cc_arena_alloc(wb->sa, n * sizeof(WAgg *), 16);
    in = (WInst **)cc_arena_alloc(wb->sa, n * sizeof(WInst *), 16);
    cx = (ECtx *)cc_arena_alloc(wb->sa, n * sizeof(ECtx), 16);
    gr = (WGRow *)cc_arena_alloc(wb->sa, n * sizeof(WGRow), 16);
    if (!ag || !in || !cx || !gr) return 0;
    n = 0;
    for (i = 0; i < t->naggs; i++) {
        WAgg *a = &wb->aggs[t->aggs[i]];
        if (!a->live || a->blockmode || (wanted && !a->wanted)) continue;
        for (j = 0; j < a->ninst; j++) {
            WInst *x = a->inst[j];
            if (!x || !x->live || !x->building) continue;
            inst_fit(wb, a, x);
            ag[n] = a;
            in[n] = x;
            inst_ctx(wb, a, x, &cx[n], 0);
            if (a->grp && !wg_row_alloc(wb, a, &gr[n])) return 0;
            n++;
        }
    }
    for (k = 0; k < t->nb && !stop; k++) {
        uint32_t bid = t->bord[k], i0, i1, chunk;
        const WBlock *b = &t->blk[bid];
        chunk = b->n ? (uint32_t)(65536 / b->n) : n;
        if (chunk < 1) chunk = 1;
        for (i0 = 0; i0 < n && !stop; i0 = i1) {
            uint32_t need = 0;
            i1 = i0 + chunk < n ? i0 + chunk : n;
            for (i = i0; i < i1; i++)
                if (!in[i]->ldone[bid]) need++;
            if (!need) continue;
            for (s = 0; s < b->n; s++) {
                WRow rr;
                wb_row_load(wb, &rr, (int32_t)ti, t->bfirst[k] + s, 0);
                for (i = i0; i < i1; i++) {
                    if (in[i]->ldone[bid]) continue;
                    if (ag[i]->grp) {
                        wg_con(&cx[i], ag[i], &rr, &gr[i]);
                        if (gr[i].stop) {
                            uint32_t *ls = inst_lstop(wb, ag[i], in[i]);
                            if (ls && ls[bid]++ == 0) in[i]->nstop++;
                        }
                        wg_apply(wb, ag[i], in[i], &gr[i], rr.rid, bid, 1);
                    } else {
                        WCon kk;
                        wb_con(&cx[i], &ag[i]->o, &rr, &kk);
                        inst_row(wb, ag[i], in[i], bid, &kk, rr.rid, 1);
                    }
                }
            }
            for (i = i0; i < i1; i++) in[i]->ldone[bid] = 1;
            work += (size_t)b->n * need;
            wb->st.job_rows += (size_t)b->n * need;
            if (work >= budget || wb_deadline_hit(deadline_us)) stop = 1;
        }
    }
    wb_tab_builds_done(wb, ti);
    return work;
}

/* ---- the chain job */

typedef struct {
    RtxWb *wb;
    uint32_t n;
    WAgg **ag;
    WInst **in;
    ECtx *cx;
    WAcc *tmp;
    WBest *tb;
    WGRow *gr;
} WChainJob;

static void wb_chain_row(void *p, WRow *r, uint32_t bid) {
    WChainJob *j = (WChainJob *)p;
    uint32_t i;
    (void)bid;
    for (i = 0; i < j->n; i++) {
        WCon kk;
        wb_con(&j->cx[i], &j->ag[i]->o, r, &kk);
        acc_apply(&j->tmp[i], &j->ag[i]->o, &kk, 1);
        wb_acc_best(j->wb, j->ag[i]->tab, &j->ag[i]->o, &j->tb[i], &kk, r->rid);
    }
}

/* Recompute the chain of table ti from its frontier (and the block
 * partials of the aggregates over it) until it converges, the table ends,
 * the view's want is met with nothing else needing more, or the budget /
 * deadline. Rows walked. */
static size_t wb_chain_step(RtxWb *wb, uint32_t ti, double deadline_us, size_t budget) {
    WTab *t = &wb->tabs[ti];
    WChain *ch = &t->ch;
    WChainJob job;
    ECtx c;
    uint32_t i, j, n = 0, sl, K, nc;
    int seed = SEED_CK, any_building = 0;
    size_t rows = 0;
    if (!ch->on || ch->front >= t->nb) return 0;
    if (!ch_fit(t)) return 0;
    memset(&job, 0, sizeof job);
    job.wb = wb;
    for (i = 0; i < t->naggs; i++) {
        WAgg *a = &wb->aggs[t->aggs[i]];
        if (!a->live || !a->blockmode || a->grp) continue;
        for (j = 0; j < a->ninst; j++)
            if (a->inst[j] && a->inst[j]->live) n++;
    }
    if (n) {
        job.ag = (WAgg **)cc_arena_alloc(wb->sa, n * sizeof(WAgg *), 16);
        job.in = (WInst **)cc_arena_alloc(wb->sa, n * sizeof(WInst *), 16);
        job.cx = (ECtx *)cc_arena_alloc(wb->sa, n * sizeof(ECtx), 16);
        job.tmp = (WAcc *)cc_arena_alloc(wb->sa, n * sizeof(WAcc), 16);
        job.tb = (WBest *)cc_arena_alloc(wb->sa, n * sizeof(WBest), 16);
        if (!job.ag || !job.in || !job.cx || !job.tmp || !job.tb) return 0;
        for (i = 0; i < t->naggs; i++) {
            WAgg *a = &wb->aggs[t->aggs[i]];
            if (!a->live || !a->blockmode || a->grp) continue;
            for (j = 0; j < a->ninst; j++) {
                WInst *x = a->inst[j];
                if (!x || !x->live) continue;
                inst_fit(wb, a, x);
                job.ag[job.n] = a;
                job.in[job.n] = x;
                inst_ctx(wb, a, x, &job.cx[job.n], 0);
                memset(&job.tmp[job.n], 0, sizeof(WAcc));
                acc_need(&job.tmp[job.n], &a->o, wb->sa);
                if (job.tmp[job.n].dm) job.tmp[job.n].dm->ar = wb->sa;
                if (x->building || x->full) any_building = 1;
                job.n++;
            }
        }
    }
    ectx_init(&c, wb);
    K = ch->k;
    nc = ch->ncols;
    sl = ch_slots(ch);
    while (ch->front < t->nb) {
        uint32_t k = ch->front, bid = t->bord[k], q;
        int conv, same = 1;
        WVal *ck;
        if (!g_wb_settling && !job.n && !ch->need && ch->want_pos < k && !any_building) break;
        for (i = 0; i < job.n; i++) {
            acc_reset(&job.tmp[i]);
            memset(&job.tb[i], 0, sizeof job.tb[i]);
        }
        if (!wb_chain_walk(&c, ti, k, WN32, seed, job.n ? wb_chain_row : NULL, &job)) break;
        rows += t->blk[bid].n;
        wb->st.job_rows += t->blk[bid].n;
        ch->walked += t->blk[bid].n;
        /* the end state: the window's last K rows */
        ck = ch->ck + (size_t)bid * sl;
        for (q = 0; q < K && same; q++) {
            int32_t wi = (int32_t)ch->wn - (int32_t)K + (int32_t)q;
            for (i = 0; i < nc && same; i++) {
                WVal v = wi >= 0 ? ch->wv[(size_t)wi * nc + i] : wv_null();
                if (!ch->ckok[bid] || !wv_same(&v, &ck[q * nc + i])) same = 0;
            }
        }
        conv = same && ch->ckok[bid];
        if (!conv) {
            for (q = 0; q < K; q++) {
                int32_t wi = (int32_t)ch->wn - (int32_t)K + (int32_t)q;
                for (i = 0; i < nc; i++)
                    ck[q * nc + i] = wv_keep(wb, wi >= 0 ? ch->wv[(size_t)wi * nc + i] : wv_null());
            }
            ch->ckok[bid] = 1;
            /* the next block's checkpoint was made from the old one: it
             * must be walked before a convergence may skip it */
            if (k + 1 < t->nb) ch_mark(t, t->bord[k + 1]);
        }
        /* the block partials: old out, new in */
        for (i = 0; i < job.n; i++) {
            WAgg *a = job.ag[i];
            WInst *x = job.in[i];
            if (bid >= x->lcap) inst_fit(wb, a, x);
            acc_merge(&x->a, &x->lacc[bid], -1);
            acc_reset(&x->lacc[bid]);
            acc_merge(&x->lacc[bid], &job.tmp[i], 1);
            acc_merge(&x->a, &x->lacc[bid], 1);
            if (x->lbest) {
                WBest bb = job.tb[i];
                bb.v = wv_keep_in(x->ar, bb.v);
                x->lbest[bid] = bb;
                x->bestok = 0;
            }
            {
                uint32_t st = job.tmp[i].stop;
                if (st || x->lstop) {
                    uint32_t *ls = inst_lstop(wb, a, x);
                    if (ls) {
                        if (ls[bid] && !st) x->nstop--;
                        if (!ls[bid] && st) x->nstop++;
                        ls[bid] = st;
                    }
                }
            }
            if (x->ldone) x->ldone[bid] = 1;
            if (x->segp) {
                uint32_t si = k + x->segp;
                if (si < 2 * x->segp) {
                    acc_reset(&x->seg[si]);
                    acc_merge(&x->seg[si], &x->lacc[bid], 1);
                    for (si /= 2; si >= 1; si /= 2)
                        seg_merge_into(&x->seg[si], &x->seg[2 * si], &x->seg[2 * si + 1]);
                } else {
                    x->segp = 0;
                }
            }
        }
        ch_unmark(t, bid);
        ch->front = k + 1;
        seed = SEED_WIN;
        if (conv && !any_building) {
            uint32_t nx = ch_next_mark(t, ch->front);
            if (nx > ch->front) {
                wb->st.chain_conv++;
                wb->st.chain_skip += nx - ch->front;
                ch->front = nx;
                seed = SEED_CK;
            }
        }
        if (rows >= budget || wb_deadline_hit(deadline_us)) break;
    }
    if (ch->front >= t->nb) {
        /* settled: the aggregates over it and its readers publish */
        ch->want_pos = 0;
        for (i = 0; i < job.n; i++) {
            job.in[i]->building = 0;
            job.in[i]->full = 0;
            wb_push(wb, job.ag[i]->node, 0);
        }
        for (i = 0; i < wb->nabs; i++)
            if (wb->abs[i].tab == (int32_t)ti && (ch->dep & (1u << wb->abs[i].col)))
                wb_push(wb, wb->abs[i].node, 0);
        for (i = 0; i < wb->nnames; i++)
            if (wb->names[i].def && wb->names[i].pend) wb_push(wb, wb->names[i].node, 0);
        wb->chg_cells = 1;
        wb_values_moved(wb);
        t->nomerge = 0;
    } else if (ch->front > ch->want_pos && !ch->need && !any_building) {
        wb_values_moved(wb);
    }
    return rows;
}

/* ---- scheduling */

/* Work left: 1 when any build or chain job remains. */
static int wb_jobs_left(RtxWb *wb) {
    uint32_t ti, i, j;
    if (wb->scan) return 1;
    for (ti = 0; ti < wb->ntab; ti++) {
        const WTab *t = &wb->tabs[ti];
        if (t->ch.on && t->ch.front < t->nb) {
            int bm = 0;
            for (i = 0; i < t->naggs && !bm; i++)
                bm = wb->aggs[t->aggs[i]].live && wb->aggs[t->aggs[i]].blockmode;
            if (bm || t->ch.need || t->ch.want_pos >= t->ch.front || g_wb_settling) return 1;
        }
        for (i = 0; i < t->naggs; i++) {
            const WAgg *a = &wb->aggs[t->aggs[i]];
            if (!a->live) continue;
            for (j = 0; j < a->ninst; j++)
                if (a->inst[j] && a->inst[j]->live && a->inst[j]->building) return 1;
        }
    }
    return 0;
}

static int wb_scan_step(RtxWb *wb, double deadline_us);

/* Step the jobs: wanted first (the view / status line waits on them),
 * then in table order. Until the deadline (0: none) or `budget` rows. 1
 * when work remains. */
static int wb_jobs_step(RtxWb *wb, double deadline_us, size_t budget) {
    size_t done = 0;
    int progress = 1;
    if (wb->cancelled) return 0;
    if (wb->scan) {
        if (!wb_scan_step(wb, deadline_us)) return 1;
        if (wb->scan) return 1;
    }
    while (progress) {
        uint32_t ti, pick = WN32, pass;
        progress = 0;
        for (pass = 0; pass < 2 && pick == WN32; pass++) {
            for (ti = 0; ti < wb->ntab && pick == WN32; ti++) {
                const WTab *t = &wb->tabs[ti];
                uint32_t i, j;
                for (i = 0; i < t->naggs && pick == WN32; i++) {
                    const WAgg *a = &wb->aggs[t->aggs[i]];
                    if (!a->live || (pass == 0 && !a->wanted)) continue;
                    for (j = 0; j < a->ninst; j++)
                        if (a->inst[j] && a->inst[j]->live && a->inst[j]->building) {
                            pick = ti;
                            break;
                        }
                }
                if (pick == WN32 && t->ch.on && t->ch.front < t->nb &&
                    (pass == 1 || t->ch.want_pos >= t->ch.front))
                    pick = ti;
            }
        }
        if (pick == WN32) break;
        {
            size_t left = budget > done ? budget - done : 0, r;
            if (!left) break;
            /* the aggregates the view / status wait on first */
            r = wb_tab_build_step(wb, pick, deadline_us, left, 1);
            if (!r) r = wb_tab_build_step(wb, pick, deadline_us, left, 0);
            if (wb->tabs[pick].ch.on && wb->tabs[pick].ch.front < wb->tabs[pick].nb)
                r += wb_chain_step(wb, pick, deadline_us, left > r ? left - r : 1);
            done += r;
            if (r) progress = 1;
        }
        wb_recalc_heap(wb);
        if (wb_deadline_hit(deadline_us) || done >= budget) break;
    }
    wb->jobs = wb_jobs_left(wb);
    if (!wb->jobs) {
        uint32_t i;
        for (i = 0; i < wb->naggs; i++) wb->aggs[i].wanted = 0;
    }
    return wb->jobs;
}

static void wb_uncancel(RtxWb *wb);

/* Every job to the end (explicit queries, --batch, tests). */
static void wb_settle(RtxWb *wb) {
    int guard = 0;
    g_wb_settling = 1;
    /* A cancel with no edit after it: nothing else replans what it left. */
    wb_uncancel(wb);
    while (guard++ < 1000000) {
        wb_recalc_heap(wb);
        if (!wb_jobs_step(wb, 0, (size_t)-1)) break;
    }
    wb_recalc_heap(wb);
    g_wb_settling = 0;
}

/* Cancel: the jobs stop; what they did not reach keeps its last value,
 * stale, until the next edit or Recalculate plans it again. */
static void wb_cancel(RtxWb *wb) {
    uint32_t i, j;
    for (i = 0; i < wb->naggs; i++) {
        WAgg *a = &wb->aggs[i];
        if (!a->live) continue;
        for (j = 0; j < a->ninst; j++) {
            WInst *in = a->inst[j];
            if (!in || !in->live || !in->building) continue;
            in->building = 0;
            in->full = 1; /* its partials are half built: rebuilt when replanned */
            in->pend = 1;
        }
        a->wanted = 0;
    }
    for (i = 0; i < wb->ntab; i++) {
        wb->tabs[i].ch.want_pos = 0;
        wb->tabs[i].nomerge = 0;
    }
    wb->cancelled = 1;
    wb->jobs = 0;
    wb->st.cancels++;
}

/* Replan after a cancel (the next edit, Recalculate): every instance the
 * cancel left half built rebuilds; chains resume from their frontier. */
static void wb_uncancel(RtxWb *wb) {
    uint32_t i, j;
    if (!wb->cancelled) return;
    wb->cancelled = 0;
    for (i = 0; i < wb->naggs; i++) {
        WAgg *a = &wb->aggs[i];
        if (!a->live) continue;
        for (j = 0; j < a->ninst; j++)
            if (a->inst[j] && a->inst[j]->live && a->inst[j]->full) {
                a->full = 1;
                wb_push(wb, a->node, 1);
                break;
            }
    }
    for (i = 0; i < wb->ntab; i++)
        if (wb->tabs[i].ch.on && wb->tabs[i].ch.front < wb->tabs[i].nb) wb->jobs = 1;
}


/* ------------------------------------------------------ the structural read
 *
 * One pass over the workbook bytes: sheets (H1), fences (params / calc
 * lines), captions and their tables (the position index, per-column
 * literal counts, the rules their formula cells name, anchors). A small
 * workbook reads in one go; a big one (RTX_WB_DEFER_BYTES and up) is a
 * job: chunks of the document, resumable at a line, values hidden until it
 * is done; an edit before its cursor starts it over.
 */

#define WB_LINE_MAX (256u * 1024u)
#define WB_SCAN_BACK 4096
#define WB_GARBAGE_MIN (64u << 20)
#define WB_SCAN_CHUNK ((size_t)1 << 20)

enum { WL_NONE = 0, WL_FENCE, WL_H1, WL_CAPTION };

static int wb_line_kind(const char *s, size_t n, char *fch, size_t *frun, size_t *ilo,
                        size_t *ihi) {
    size_t i = 0, j;
    while (i < n && i < 4 && s[i] == ' ') i++;
    if (i >= 4) return WL_NONE;
    if (i < n && (s[i] == '`' || s[i] == '~')) {
        char c = s[i];
        j = i;
        while (j < n && s[j] == c) j++;
        if (j - i >= 3) {
            size_t a = j, b = n;
            while (a < b && wb_ws(s[a])) a++;
            while (b > a && (wb_ws(s[b - 1]) || s[b - 1] == '\r')) b--;
            if (c == '`') {
                size_t k;
                for (k = a; k < b; k++)
                    if (s[k] == '`') return WL_NONE;
            }
            if (fch) *fch = c;
            if (frun) *frun = j - i;
            if (ilo) *ilo = a;
            if (ihi) *ihi = b;
            return WL_FENCE;
        }
        return WL_NONE;
    }
    if (i < n && s[i] == '#' && (i + 1 >= n || wb_ws(s[i + 1]) || s[i + 1] == '\r')) {
        if (ilo) *ilo = i + 1;
        if (ihi) *ihi = n;
        return WL_H1;
    }
    if (n - i >= 6 && !memcmp(s + i, "Table:", 6)) {
        if (ilo) *ilo = i + 6;
        if (ihi) *ihi = n;
        return WL_CAPTION;
    }
    return WL_NONE;
}

static int wb_blank(const char *s, size_t n) {
    size_t i;
    for (i = 0; i < n; i++)
        if (!wb_ws(s[i]) && s[i] != '\r') return 0;
    return 1;
}

static int wb_blk_add_ext(RtxWb *wb, size_t lo, size_t hi, size_t ext_lo, size_t ext_hi) {
    WBlk *b;
    if (!wb_grow(wb, (void **)&wb->blks, &wb->blkcap, wb->nblk + 1, sizeof(WBlk))) return 0;
    b = &wb->blks[wb->nblk++];
    b->lo = lo;
    b->hi = hi;
    b->ext_lo = ext_lo;
    b->ext_hi = ext_hi;
    return 1;
}

static int32_t wb_sheet_add(RtxWb *wb, const char *s, size_t n) {
    if (!wb_grow(wb, (void **)&wb->sheets, &wb->sheetcap, wb->nsheet + 1, sizeof(char *))) return 0;
    {
        uint32_t cap = wb->sheetcap;
        uint32_t *nn = (uint32_t *)wb_ma(wb, (size_t)cap * sizeof(uint32_t));
        if (!nn) return 0;
        if (wb->sheetn && wb->nsheet) memcpy(nn, wb->sheetn, wb->nsheet * sizeof(uint32_t));
        wb->sheetn = nn;
    }
    wb->sheets[wb->nsheet] = wb_strdup(wb, s, n);
    wb->sheetn[wb->nsheet] = (uint32_t)n;
    return (int32_t)wb->nsheet++;
}

static int wb_is_kw(const char *s, size_t n);

/* `name = expr` (a backticked name allowed); `# ` ends the line (a `#`
 * before a name is an anchor). Spans are relative to s. */
static int wb_def_parse(const char *s, size_t n, size_t *nlo, size_t *nhi, size_t *elo,
                        size_t *ehi) {
    size_t i = 0, j, k, a, b;
    char inq = 0;
    while (i < n && wb_ws(s[i])) i++;
    if (i < n && s[i] == '`') {
        j = i + 1;
        while (j < n && s[j] != '`') j++;
        if (j >= n || j == i + 1) return 0;
        *nlo = i;
        *nhi = j + 1;
        i = j + 1;
    } else if (i < n && wb_id0(s[i])) {
        j = i + 1;
        while (j < n && wb_id1(s[j])) j++;
        if (wb_is_kw(s + i, j - i)) return 0;
        *nlo = i;
        *nhi = j;
        i = j;
    } else {
        return 0;
    }
    while (i < n && wb_ws(s[i])) i++;
    if (i >= n || s[i] != '=' || (i + 1 < n && s[i + 1] == '=')) return 0;
    i++;
    for (k = i; k < n; k++) {
        char c = s[k];
        if (inq) {
            if (c == '\\' && inq == '"' && k + 1 < n) {
                k++;
                continue;
            }
            if (c == inq) inq = 0;
            continue;
        }
        if (c == '"' || c == '`') inq = c;
        else if (c == '#' && !(k + 1 < n && (wb_id0(s[k + 1]) || s[k + 1] == '`'))) break;
    }
    a = i;
    b = k;
    wb_trim(s, &a, &b);
    if (a >= b) return 0;
    *elo = a;
    *ehi = b;
    return 1;
}

static const char *wb_copy(RtxWb *wb, const char *s, size_t n, uint32_t *outn) {
    char *p = wb_strdup(wb, s, n);
    *outn = p ? (uint32_t)n : 0;
    return p ? p : "";
}

static void wb_name_copy(const char *s, size_t lo, size_t hi, const char **p, size_t *n) {
    if (hi - lo >= 2 && s[lo] == '`' && s[hi - 1] == '`') {
        lo++;
        hi--;
    }
    *p = s + lo;
    *n = hi - lo;
}

/* ------------------------------------------------------------- imports
 *
 * `uses prior = "../q2.wb.md"` (a ```` ```uses ```` fence of `name =
 * "path"` lines, paths relative to this file). The other workbook is its
 * own engine: the one of a document open anywhere in the process (a
 * pane: its live bytes, edits included) — the registry below — or else a
 * private read-only document this workbook opens itself (re-read when its
 * file's identity changes). References through the alias are import
 * nodes (one per distinct reference); the other engine owns its graph.
 *
 * Change: the other engine's stamp (its value and model generations, and
 * whether it is busy) is compared at every query, sync and idle slice;
 * when it moved, the imports through that alias re-read (cutoff at equal
 * values). While it is busy (jobs, a read) its values are stale, and so
 * are the imports and their readers (the same stale display).
 *
 * Cycles: opening workbooks nest (the attach stack) and live engines'
 * uses are walked before one is taken: a workbook reachable from itself
 * makes that `uses` line `#cycle(a → b → a)` (full paths), and every
 * reference through it carries it. A missing or unreadable file is
 * `#ref(...)` the same way. */

typedef struct {
    RtxWb *wb;
    int priv;
} WReg;

static WReg *g_wb_reg;
static long g_wb_use_poll_ms = 1000; /* private documents: their files checked this often */

void rtx_wb_uses_poll_ms(long ms) {
    g_wb_use_poll_ms = ms > 0 ? ms : 1000;
}
static uint32_t g_wb_nreg, g_wb_regcap;
static const char *g_wb_attach_stk[32]; /* realpaths being attached (outermost first) */
static int g_wb_nattach;
static int g_wb_attach_priv;            /* the attach in progress is a private import */

static void wb_reg_add(RtxWb *wb, int priv) {
    if (!wb_hgrow((void **)&g_wb_reg, &g_wb_regcap, g_wb_nreg + 1, sizeof(WReg))) return;
    g_wb_reg[g_wb_nreg].wb = wb;
    g_wb_reg[g_wb_nreg].priv = priv;
    g_wb_nreg++;
}

static void wb_reg_del(RtxWb *wb) {
    uint32_t i;
    for (i = 0; i < g_wb_nreg; i++)
        if (g_wb_reg[i].wb == wb) {
            g_wb_reg[i] = g_wb_reg[--g_wb_nreg];
            return;
        }
}

/* The engine for realpath `real`: a document open in the process wins
 * over a private copy. */
static RtxWb *wb_reg_find(const char *real, int *priv) {
    uint32_t i;
    RtxWb *best = NULL;
    int bp = 1;
    for (i = 0; i < g_wb_nreg; i++) {
        RtxWb *w = g_wb_reg[i].wb;
        if (!w->doc_real || strcmp(w->doc_real, real)) continue;
        if (!best || (bp && !g_wb_reg[i].priv)) {
            best = w;
            bp = g_wb_reg[i].priv;
        }
    }
    if (priv) *priv = bp;
    return best;
}

static void wb_pdocs_free(RtxWb *wb) {
    uint32_t i;
    for (i = 0; i < wb->npdocs; i++) {
        if (wb->pdocs[i].d) {
            RtxDoc_destroy(wb->pdocs[i].d);
            free(wb->pdocs[i].d);
        }
        free(wb->pdocs[i].real);
    }
    free(wb->pdocs);
    wb->pdocs = NULL;
    wb->npdocs = wb->pdoccap = 0;
}

static void wb_uses_free(RtxWb *wb) {
    uint32_t i;
    for (i = 0; i < wb->nuses; i++) free(wb->uses[i].real);
    free(wb->uses);
    wb->uses = NULL;
    wb->nuses = wb->usecap = 0;
    free(wb->imps);
    wb->imps = NULL;
    wb->nimps = wb->impcap = 0;
}

/* A `uses` line: `name = "path"` (a string); anything else is inert. */
static int wb_use_line(RtxWb *wb, const char *line, size_t bol, size_t le) {
    size_t nlo, nhi, elo, ehi;
    const char *nm;
    size_t nmn;
    WUse *u;
    if (!wb_def_parse(line, le - bol, &nlo, &nhi, &elo, &ehi)) return 1;
    if (ehi - elo < 2 || line[elo] != '"' || line[ehi - 1] != '"') return 1;
    if (!wb_hgrow((void **)&wb->uses, &wb->usecap, wb->nuses + 1, sizeof(WUse))) return 0;
    u = &wb->uses[wb->nuses];
    memset(u, 0, sizeof *u);
    wb_name_copy(line, nlo, nhi, &nm, &nmn);
    u->name = wb_strdup(wb, nm, nmn);
    u->namen = (uint32_t)nmn;
    u->path = wb_strdup(wb, line + elo + 1, ehi - elo - 2);
    u->pathn = (uint32_t)(ehi - elo - 2);
    u->raw_lo = bol;
    u->raw_hi = le;
    if (!u->name || !u->path) return 0;
    wb->nuses++;
    return 1;
}

/* Does engine `from` reach `target` through its uses? The path (full
 * paths, " → ") into out. */
static int wb_use_reaches(RtxWb *from, RtxWb *target, char *out, size_t cap, int depth) {
    uint32_t i;
    if (depth > 16) return 0;
    for (i = 0; i < from->nuses; i++) {
        const WUse *u = &from->uses[i];
        RtxWb *nx;
        size_t at;
        if (u->state != USE_OK || !u->real) continue;
        nx = wb_reg_find(u->real, NULL);
        if (!nx) continue;
        at = strlen(out);
        snprintf(out + at, cap - at, " \xe2\x86\x92 %s", u->real);
        if (nx == target) return 1;
        if (wb_use_reaches(nx, target, out, cap, depth + 1)) return 1;
        out[at] = 0;
    }
    return 0;
}

static RtxWb *wb_attach(RtxDoc *d, const char *path, int use_index);

/* A private read-only document of `real` (heap), NULL when it cannot be read. */
static RtxDoc *wb_open_private(const char *real) {
    RtxDoc *d = (RtxDoc *)calloc(1, sizeof(RtxDoc));
    @errhandler(CCError e) {
        (void)e;
        free(d);
        return NULL;
    }
    if (!d) return NULL;
    d->from_path(cc_slice_cstr(real)) !>;
    if (!rtx_wb_of(d)) {
        RtxDoc_destroy(d);
        free(d);
        return NULL;
    }
    return d;
}

/* The private document for realpath `real` (opened now when missing). */
static RtxWb *wb_pdoc_get(RtxWb *wb, const char *real) {
    uint32_t i;
    WPdoc *p;
    RtxDoc *d;
    struct stat st;
    for (i = 0; i < wb->npdocs; i++)
        if (!strcmp(wb->pdocs[i].real, real)) return wb->pdocs[i].d ? rtx_wb_of(wb->pdocs[i].d) : NULL;
    if (!wb_hgrow((void **)&wb->pdocs, &wb->pdoccap, wb->npdocs + 1, sizeof(WPdoc))) return NULL;
    p = &wb->pdocs[wb->npdocs++];
    memset(p, 0, sizeof *p);
    p->real = strdup(real);
    if (!p->real) return NULL;
    if (stat(real, &st) == 0) {
        rtx_si_id_of(&st, &p->id);
        p->id_ok = 1;
    }
    {
        int saved = g_wb_attach_priv;
        g_wb_attach_priv = 1;
        d = wb_open_private(real);
        g_wb_attach_priv = saved;
    }
    if (!d) return NULL;
    p->d = d;
    wb->st.uses_private++;
    return rtx_wb_of(d);
}

/* The engine behind use u now (a live one may have appeared or gone). */
static RtxWb *wb_use_engine(RtxWb *wb, WUse *u) {
    RtxWb *e;
    int priv = 1;
    if (u->state != USE_OK || !u->real) return NULL;
    e = wb_reg_find(u->real, &priv);
    if (e && e != wb) return e;
    return wb_pdoc_get(wb, u->real);
}

/* After the read, before the bind: each use's file, its cycles. */
static void wb_uses_resolve(RtxWb *wb) {
    uint32_t i, j;
    for (i = 0; i < wb->nuses; i++) {
        WUse *u = &wb->uses[i];
        char path[4096], real[4096], msg[1024];
        RtxWb *e;
        free(u->real);
        u->real = NULL;
        u->state = USE_OK;
        u->seen = NULL;
        for (j = 0; j < i; j++)
            if (wb->uses[j].namen == u->namen && !memcmp(wb->uses[j].name, u->name, u->namen)) {
                u->state = wb->uses[j].state = USE_DUP;
                u->err = wv_err_a(wb->va, WE_DUP, "uses %.*s is defined twice", (int)u->namen, u->name);
                wb->uses[j].err = u->err;
            }
        if (u->state != USE_OK) continue;
        if (u->path[0] == '/' || !wb->doc_real) {
            snprintf(path, sizeof path, "%.*s", (int)u->pathn, u->path);
        } else {
            const char *sl = strrchr(wb->doc_real, '/');
            size_t dn = sl ? (size_t)(sl - wb->doc_real) : 0;
            snprintf(path, sizeof path, "%.*s/%.*s", (int)dn, wb->doc_real, (int)u->pathn, u->path);
        }
        if (!realpath(path, real)) {
            u->state = USE_MISSING;
            u->err = wv_err_a(wb->va, WE_REF, "%.*s: %.*s not found", (int)u->namen, u->name, (int)u->pathn,
                              u->path);
            continue;
        }
        if (!rtx_wb_path(real, strlen(real))) {
            u->state = USE_BAD;
            u->err = wv_err_a(wb->va, WE_REF, "%.*s: %.*s is not a workbook (*.wb.md)", (int)u->namen,
                              u->name, (int)u->pathn, u->path);
            continue;
        }
        /* a cycle: this file, a file being opened around this one (the
         * attach stack ends with this one), or a live engine that reaches
         * this one */
        msg[0] = 0;
        if (wb->doc_real && !strcmp(real, wb->doc_real)) {
            snprintf(msg, sizeof msg, "%s \xe2\x86\x92 %s", wb->doc_real, real);
        } else {
            int k, on = -1;
            for (k = 0; k < g_wb_nattach; k++)
                if (!strcmp(g_wb_attach_stk[k], real)) on = k;
            if (on >= 0) {
                size_t at = 0;
                for (k = on; k < g_wb_nattach && at < sizeof msg; k++)
                    at += (size_t)snprintf(msg + at, sizeof msg - at, "%s%s", k > on ? " \xe2\x86\x92 " : "",
                                           g_wb_attach_stk[k]);
                if (at < sizeof msg) snprintf(msg + at, sizeof msg - at, " \xe2\x86\x92 %s", real);
            }
        }
        if (!msg[0] && wb->doc_real) {
            int priv = 1;
            e = wb_reg_find(real, &priv);
            if (e && e != wb) {
                char tail[1024];
                tail[0] = 0;
                if (wb_use_reaches(e, wb, tail, sizeof tail, 0))
                    snprintf(msg, sizeof msg, "%s \xe2\x86\x92 %s%s", wb->doc_real, real, tail);
            }
        }
        if (msg[0]) {
            u->state = USE_CYCLE;
            u->err = wv_err_a(wb->va, WE_CYCLE, "%s", msg);
            continue;
        }
        u->real = strdup(real);
        if (!u->real) {
            u->state = USE_BAD;
            u->err = wv_err_a(wb->va, WE_NUM, "out of memory");
            continue;
        }
        if (!wb_use_engine(wb, u)) {
            u->state = USE_BAD;
            u->err = wv_err_a(wb->va, WE_REF, "%.*s: %.*s could not be read", (int)u->namen, u->name,
                              (int)u->pathn, u->path);
        }
    }
}

static void wb_sync_ex(RtxWb *wb, const RtxDoc *d, int paint);
static int wb_imp_depth;

/* Name `label` (`name` or `Sheet.name`) of engine e, or -1. */
static int64_t wb_imp_name(RtxWb *e, const char *label, uint32_t n) {
    uint32_t i;
    char lb[160];
    /* `Sheet.name` first; an unqualified name: a param or a calc name on
     * any sheet (the first in document order), as an eval reads it */
    for (i = 0; i < e->nnames; i++) {
        const WName *nm = &e->names[i];
        size_t k;
        if (!nm->def || nm->clash) continue;
        k = wb_name_label(e, i, lb, sizeof lb);
        if (k == n && !memcmp(lb, label, n) && memchr(label, '.', n)) return i;
    }
    for (i = 0; i < e->nnames; i++) {
        const WName *nm = &e->names[i];
        if (!nm->def || nm->clash) continue;
        if (nm->namen == n && !memcmp(nm->name, label, n)) return i;
    }
    return -1;
}

/* Import m's value now, from its engine (never settled: a busy engine's
 * values are stale). Text copied into wb's value arena. */
static WVal wb_imp_eval(RtxWb *wb, uint32_t ui, int kind, const char *txt, uint32_t n, uint8_t *stale,
                        uint8_t *nolast) {
    WUse *u = &wb->uses[ui];
    RtxWb *e;
    WVal v;
    *stale = 0;
    *nolast = 0;
    if (u->state != USE_OK) return u->err;
    e = wb_use_engine(wb, u);
    if (!e) return u->err.t == WV_ERR ? u->err : wv_err_a(wb->va, WE_REF, "%.*s: not readable", (int)u->namen, u->name);
    if (e->imp_busy || wb_imp_depth > 16)
        return wv_err_a(wb->va, WE_CYCLE, "%.*s: the workbooks read each other", (int)u->namen, u->name);
    wb_imp_depth++;
    wb_sync_ex(e, e->doc, 1); /* its edits (and its own imports) first */
    e->imp_busy = 1;
    wb->st.imp_evals++;
    if (e->off) {
        v = wv_err_a(wb->va, WE_REF, "%.*s: %.*s is over the workbook size cap", (int)u->namen, u->name,
                     (int)u->pathn, u->path);
    } else if (e->scan) {
        /* being read: no values yet */
        *stale = 1;
        *nolast = 1;
        v = wv_null();
    } else if (kind == IMP_NAME) {
        int64_t ni = wb_imp_name(e, txt, n);
        if (ni < 0) {
            v = wv_err_a(wb->va, WE_REF, "%.*s has no name %.*s", (int)u->namen, u->name, (int)n, txt);
        } else {
            v = e->names[ni].v;
            if (e->names[ni].pend) *stale = 1;
            if (e->cancelled) *stale = 1;
        }
    } else {
        BCtx c;
        ECtx x;
        Ex *ex;
        uint32_t sn;
        memset(&c, 0, sizeof c);
        c.wb = e;
        c.kind = BK_EVAL;
        c.self = WN32;
        c.own_tab = c.own_col = c.it_tab = -1;
        c.sheet = 0;
        c.any_sheet = 1;
        c.nodeps = 1;
        c.agg = WN32;
        c.src = wb_copy(e, txt, n, &sn);
        c.srcn = n;
        ex = wb_parse(e, c.src, n);
        ex = bd(&c, ex);
        ectx_init(&x, e);
        v = ev(&x, ex);
        if (v.t == WV_ROW || v.t == WV_TAB) v = wv_row_err(&x, &v);
        if (x.stale) *stale = 1;
        if (x.nolast) *nolast = 1;
    }
    if (v.t == WV_GRP)
        v = wv_err_a(wb->va, WE_TYPE, "%.*s.%.*s is a group: read one key (g[k = v].out)", (int)u->namen,
                     u->name, (int)n, txt);
    v = wv_keep(wb, v);
    e->sa.reset();
    wb_imp_depth--;
    e->imp_busy = 0;
    return v;
}

/* EX_IMP in a formula: the node's value (or, in an eval, read now). */
static WVal wb_imp_read(ECtx *c, const Ex *e) {
    RtxWb *wb = c->wb;
    if (e->node == WN32) {
        uint8_t st = 0, nl = 0;
        WVal v = wb_imp_eval(wb, (uint32_t)e->col, e->fn, e->id, e->idn, &st, &nl);
        if (st) c->stale = 1;
        if (nl) c->nolast = 1;
        return v;
    }
    {
        const WImp *m = &wb->imps[e->node];
        if (m->pend) {
            c->stale = 1;
            if (!m->has) c->nolast = 1;
        }
        return m->v;
    }
}

/* The import node off the heap: its engine's value now. */
static void wb_imp_update(RtxWb *wb, uint32_t v) {
    WGNode *g = &wb->g[v];
    WImp *m = &wb->imps[g->ref];
    uint8_t st = 0, nl = 0;
    WVal nv = wb_imp_eval(wb, m->use, m->kind, m->txt, m->n, &st, &nl);
    int moved;
    if (st && nl) {
        /* nothing there yet: stale, the last value stays */
        if (!m->pend) {
            m->pend = g->pend = 1;
            wb_push_readers(wb, v, 0);
            wb_values_moved(wb);
        }
        return;
    }
    moved = !m->has || !wv_same(&nv, &m->v);
    if (moved || m->pend != st) {
        m->v = nv;
        m->has = 1;
        m->pend = g->pend = st;
        wb_values_moved(wb);
        wb_push_readers(wb, v, moved);
    }
}

/* Poll the uses' engines: the imports through one whose stamp moved are
 * queued. 1 when any was. Private documents are re-read when their file
 * changed (idle only: `files`). */
static int wb_imp_poll(RtxWb *wb, int files) {
    uint32_t i, k;
    int any = 0;
    if ((!wb->nuses && !wb->npdocs) || wb->off || wb->scan) return 0;
    if (files) {
        long now = wb_now_ms();
        if (now - wb->pdoc_check_ms >= g_wb_use_poll_ms) {
            wb->pdoc_check_ms = now;
            for (i = 0; i < wb->npdocs; i++) {
                WPdoc *p = &wb->pdocs[i];
                struct stat st;
                RtxSiId id;
                int same = 0;
                if (stat(p->real, &st) == 0) {
                    rtx_si_id_of(&st, &id);
                    same = p->id_ok && id.dev == p->id.dev && id.ino == p->id.ino && id.size == p->id.size &&
                           id.mtime_ns == p->id.mtime_ns && id.ctime_ns == p->id.ctime_ns;
                }
                if (same || !p->d || p->stale) continue;
                if (!rtx_wb_of(p->d)) {
                    /* a source file (an external table): the model reads it
                     * again (the document goes with the old model) */
                    p->stale = 1;
                    wb->need_rebuild = 1;
                    wb->st.uses_reread++;
                    any = 1;
                    continue;
                }
                /* changed on disk: read it again (a fresh engine) */
                RtxDoc_destroy(p->d);
                free(p->d);
                p->d = NULL;
                free(p->real);
                wb->pdocs[i] = wb->pdocs[--wb->npdocs];
                i--;
                /* the fresh engine may reuse the old one's address: every
                 * use looks again */
                for (k = 0; k < wb->nuses; k++) wb->uses[k].seen = NULL;
                wb->st.uses_reread++;
                any = 1;
            }
        }
    }
    for (i = 0; i < wb->nuses; i++) {
        WUse *u = &wb->uses[i];
        RtxWb *e;
        int busy;
        if (u->state != USE_OK) continue;
        e = wb_use_engine(wb, u);
        if (!e) continue;
        busy = e->scan || (e->jobs && !e->cancelled) || e->pend;
        if (e == u->seen && e->vgen == u->seen_vgen && e->mgen == u->seen_mgen && busy == u->seen_busy)
            continue;
        u->seen = e;
        u->seen_vgen = e->vgen;
        u->seen_mgen = e->mgen;
        u->seen_busy = busy;
        for (k = 0; k < wb->nimps; k++)
            if (wb->imps[k].use == i) {
                wb_push(wb, wb->imps[k].node, 0);
                any = 1;
            }
    }
    return any;
}

/* The uses' engines' own jobs (private documents: nobody else steps
 * them). 1 when any ran. */
static int wb_imp_idle(RtxWb *wb) {
    uint32_t i;
    int any = 0;
    for (i = 0; i < wb->npdocs; i++)
        if (wb->pdocs[i].d && rtx_wb_idle(wb->pdocs[i].d)) any = 1;
    return any;
}

static long wb_imp_due(RtxWb *wb) {
    uint32_t i;
    long best = -1;
    for (i = 0; i < wb->npdocs; i++) {
        long ms;
        if (!wb->pdocs[i].d) continue;
        ms = rtx_wb_due_ms(wb->pdocs[i].d);
        if (ms >= 0 && (best < 0 || ms < best)) best = ms;
    }
    for (i = 0; i < wb->nuses; i++) {
        WUse *u = &wb->uses[i];
        RtxWb *e;
        if (u->state != USE_OK) continue;
        e = wb_reg_find(u->real, NULL);
        if (e && (e != u->seen || e->vgen != u->seen_vgen || e->mgen != u->seen_mgen)) return 0;
    }
    if (wb->npdocs) {
        /* the files of private documents: checked once a second */
        long left = g_wb_use_poll_ms - (wb_now_ms() - wb->pdoc_check_ms);
        if (left < 0) left = 0;
        if (best < 0 || left < best) best = left;
    }
    return best;
}

/* ---- rules: (table, column, text) -> rule */

static uint64_t wb_rule_hash(int32_t tab, int32_t col, const char *s, uint32_t n) {
    uint64_t h = 1469598103934665603ull ^ ((uint64_t)(uint32_t)tab << 20) ^ (uint64_t)(uint32_t)col;
    uint32_t i;
    for (i = 0; i < n; i++) {
        h ^= (unsigned char)s[i];
        h *= 1099511628211ull;
    }
    return h ? h : 1;
}

static int wb_rmap_grow(RtxWb *wb) {
    uint32_t nc = wb->rmapcap ? wb->rmapcap * 2 : 256, i;
    uint32_t *nm = (uint32_t *)malloc((size_t)nc * sizeof(uint32_t));
    if (!nm) return 0;
    memset(nm, 0xff, (size_t)nc * sizeof(uint32_t));
    for (i = 0; i < wb->nrules; i++) {
        uint32_t j = (uint32_t)wb->rules[i].h & (nc - 1);
        while (nm[j] != WN32) j = (j + 1) & (nc - 1);
        nm[j] = i;
    }
    free(wb->rmap);
    wb->rmap = nm;
    wb->rmapcap = nc;
    return 1;
}

static int wb_rule_find(RtxWb *wb, int32_t tab, int32_t col, const char *s, uint32_t n) {
    uint64_t h;
    uint32_t j;
    if (!wb->rmapcap) return -1;
    h = wb_rule_hash(tab, col, s, n);
    j = (uint32_t)h & (wb->rmapcap - 1);
    while (wb->rmap[j] != WN32) {
        const WRule *r = &wb->rules[wb->rmap[j]];
        if (r->h == h && r->tab == tab && r->col == col && r->srcn == n && !memcmp(r->src, s, n))
            return (int)wb->rmap[j];
        j = (j + 1) & (wb->rmapcap - 1);
    }
    return -1;
}

static void wb_kx_want_ex(RtxWb *wb, const Ex *e);
static WInst *inst_new(RtxWb *wb, WAgg *a, const WVal *pv, uint32_t npv);

/* A rule bound now (an edit brought it): its aggregates planned. */
static void wb_rule_bound(RtxWb *wb, uint32_t ri) {
    uint32_t i;
    wb_bind(wb, BK_RULE, ri);
    wb_kx_want_ex(wb, wb->rules[ri].ex);
    for (i = 0; i < wb->rules[ri].naggs; i++) {
        WAgg *a = &wb->aggs[wb->rules[ri].aggs[i]];
        if (!a->pmask && !a->ninst) inst_new(wb, a, NULL, 0);
        a->full = 1;
        wb_push(wb, a->node, 1);
    }
}

/* The rule for text s in (tab, col): found or made (bound later / now). */
static int wb_rule_get(RtxWb *wb, int32_t tab, int32_t col, const char *s, uint32_t n, int bind) {
    int r = wb_rule_find(wb, tab, col, s, n);
    WRule *ru;
    uint32_t node;
    if (r >= 0) {
        if (wb->rules[r].dead) {
            /* a rule coming back: its aggregates died with it, bind again */
            wb->rules[r].dead = 0;
            wb->graph_dirty = 1;
            if (bind) wb_rule_bound(wb, (uint32_t)r);
        }
        return r;
    }
    if ((wb->nrules + 1) * 2 > wb->rmapcap && !wb_rmap_grow(wb)) return -1;
    if (!wb_hgrow((void **)&wb->rules, &wb->rulecap, wb->nrules + 1, sizeof(WRule))) return -1;
    node = wb_gnode_new(wb, GN_RULE, wb->nrules);
    if (node == WN32) return -1;
    ru = &wb->rules[wb->nrules];
    memset(ru, 0, sizeof *ru);
    ru->tab = tab;
    ru->col = col;
    ru->node = node;
    ru->src = wb_copy(wb, s, n, &ru->srcn);
    ru->h = wb_rule_hash(tab, col, s, n);
    wb->g[node].tab = tab;
    wb->g[node].col = col;
    {
        uint32_t j = (uint32_t)ru->h & (wb->rmapcap - 1);
        while (wb->rmap[j] != WN32) j = (j + 1) & (wb->rmapcap - 1);
        wb->rmap[j] = wb->nrules;
    }
    r = (int)wb->nrules++;
    if (bind) wb_rule_bound(wb, (uint32_t)r);
    wb->graph_dirty = 1;
    return r;
}

/* ---- one row's cells into the table's stats (sign +1 / -1) */

static void wb_row_account(RtxWb *wb, uint32_t ti, const WRow *r, int sign, int bind) {
    WTab *t = &wb->tabs[ti];
    int32_t c;
    for (c = 0; c < t->ncols; c++) {
        size_t lo, hi, slo, shi, flo, fhi;
        if (!wb_cell_span(r, c, &lo, &hi)) continue;
        if (wb_cell_formula(r->b, lo, hi, &slo, &shi, &flo, &fhi)) {
            int ri = sign > 0 ? wb_rule_get(wb, (int32_t)ti, c, r->b + slo, (uint32_t)(shi - slo), bind)
                              : wb_rule_find(wb, (int32_t)ti, c, r->b + slo, (uint32_t)(shi - slo));
            if (ri >= 0) {
                WRule *ru = &wb->rules[ri];
                uint32_t before = ru->refs;
                ru->refs = (uint32_t)((int32_t)ru->refs + sign);
                if ((before == 0) != (ru->refs == 0)) wb->graph_dirty = 1;
                /* a cycle's path names its rules' first rows */
                if (wb->ncyv && ru->node < wb->ng && wb->g[ru->node].cyc) wb->graph_dirty = 1;
            }
            wb->nform_cells = (uint32_t)((int32_t)wb->nform_cells + sign);
            wb->nderived = (uint32_t)((int32_t)wb->nderived + sign);
            wb_cs_add(&t->cs[c], LK_FORMULA, 0, sign);
        } else {
            int sc = 0;
            int lk = wb_cell_kind(wb, r->b, lo, hi, &sc);
            wb_cs_add(&t->cs[c], lk, sc, sign);
        }
    }
    if (r->ahi > r->alo) {
        WKey k;
        wb_anc_key(r->b + r->alo, r->ahi - r->alo, &k);
        if (sign > 0) kx_add(&t->anc, &k, r->rid);
        else kx_del(&t->anc, &k, r->rid);
    }
}

/* ---- the scan state */

enum { FK_OTHER = 0, FK_PARAMS, FK_CALC, FK_TABLE, FK_USES };

typedef struct WScan {
    size_t pos;            /* next line */
    size_t len;
    int32_t sheet;
    int fence, fkind;
    char fch;
    size_t frun, fbol, fnext;
    int cap;
    size_t cap_bol, cap_lo, cap_hi;
    char *capname;         /* the caption's text (it may leave the buffer) */
    size_t capn;
    /* a table in progress */
    int intab;             /* 1 named (building tabs[ti]), 2 unnamed (skipping) */
    uint32_t ti;
    /* the chunk */
    char *buf;
    size_t buf_lo, buf_n, buf_cap;
    size_t prev_bol;       /* the previous line's start (block extents) */
    int done;
    size_t rows;
    struct WParWin *par;   /* the parallel pre-read window, on the caller */
    struct WParArm *arm;   /* ... or ahead, in the background */
    uint8_t arm_off;       /* no arm for this read (it could not start) */
    uint8_t installed;     /* the table in progress came from the index */
    /* external tables: the fence being read, the files to read */
    struct WExtSpec *xs;
    uint32_t *xq;
    uint32_t nxq, xqcap, xi;
    struct WCsvRdS *xrdp;
    uint8_t ext_async;  /* a synchronous read leaves big files to a job */
    uint8_t lines_done;
} WScan;

static void wbp_win_free(struct WParWin *w);
static void wbp_arm_stop(RtxWb *wb, WScan *s);

static void wb_scan_free(WScan *s) {
    if (!s) return;
    wbp_arm_stop(NULL, s);
    wbp_win_free(s->par);
    free(s->xs);
    free(s->xq);
    if (s->xrdp) free(((WCsvRd *)s->xrdp)->buf);
    free(s->xrdp);
    free(s->buf);
    free(s->capname);
    free(s);
}

/* The line at s->pos: [bol, le) without NL, next line at *next. 0: past
 * the end. Keeps at least one whole line in the buffer. */
static int wb_scan_line(RtxWb *wb, WScan *s, const char **ln, size_t *n, size_t *next) {
    size_t off, e;
    if (s->pos >= s->len) return 0;
    for (;;) {
        if (s->pos >= s->buf_lo && s->pos < s->buf_lo + s->buf_n) {
            off = s->pos - s->buf_lo;
            e = off;
            while (e < s->buf_n && s->buf[e] != '\n') e++;
            if (e < s->buf_n || s->buf_lo + s->buf_n >= s->len) {
                *ln = s->buf + off;
                *n = e - off;
                if (*n && s->buf[off + *n - 1] == '\r') {
                    /* keep CR for row bytes; kind checks trim it */
                }
                *next = s->buf_lo + (e < s->buf_n ? e + 1 : e);
                return 1;
            }
            if (s->buf_n - off >= WB_LINE_MAX * 16) {
                /* a line longer than any chunk: treat the chunk end as its end */
                *ln = s->buf + off;
                *n = s->buf_n - off;
                *next = s->buf_lo + s->buf_n;
                return 1;
            }
        }
        /* refill from pos */
        {
            size_t want = WB_SCAN_CHUNK, got;
            size_t need = s->len - s->pos < want ? s->len - s->pos : want;
            if (s->pos >= s->buf_lo && s->pos < s->buf_lo + s->buf_n) {
                /* the line did not fit: a bigger chunk */
                size_t have = s->buf_lo + s->buf_n - s->pos;
                need = have * 2 + want;
                if (need > s->len - s->pos) need = s->len - s->pos;
            }
            if (need + 1 > s->buf_cap) {
                char *nb = (char *)realloc(s->buf, need + 1);
                if (!nb) return 0;
                s->buf = nb;
                s->buf_cap = need + 1;
            }
            got = wb_read(wb->doc, s->pos, s->buf, need);
            s->buf_lo = s->pos;
            s->buf_n = got;
            s->buf[got] = 0;
            if (!got) return 0;
        }
    }
}

/* The line at `next`, peeked (a table's separator). The buffer may move:
 * the caller keeps its own copy of the current line. */
static int wb_scan_peek(RtxWb *wb, WScan *s, size_t next, const char **ln, size_t *n) {
    size_t save = s->pos, nx;
    int ok;
    s->pos = next;
    ok = wb_scan_line(wb, s, ln, n, &nx);
    s->pos = save;
    return ok;
}

static int wb_def_line(RtxWb *wb, const char *line, size_t bol, size_t le, int32_t scope) {
    size_t nlo, nhi, elo, ehi;
    WName *n;
    int def = wb_def_parse(line, le - bol, &nlo, &nhi, &elo, &ehi);
    if (!wb_hgrow((void **)&wb->names, &wb->namecap, wb->nnames + 1, sizeof(WName))) return 0;
    n = &wb->names[wb->nnames];
    memset(n, 0, sizeof *n);
    n->def = (uint8_t)def;
    n->scope = scope;
    n->raw_lo = bol;
    n->raw_hi = le;
    n->n_lo = n->n_hi = n->f_lo = n->f_hi = n->src_lo = WNONE;
    n->node = WN32;
    if (def) {
        const char *nm;
        size_t nmn;
        wb_name_copy(line, nlo, nhi, &nm, &nmn);
        n->name = wb_strdup(wb, nm, nmn);
        n = &wb->names[wb->nnames];
        n->namen = (uint32_t)nmn;
        n->n_lo = bol + nlo;
        n->n_hi = bol + nhi;
        n->f_lo = bol + elo;
        n->f_hi = bol + ehi;
        n->src_lo = bol + elo;
        n->src = wb_copy(wb, line + elo, ehi - elo, &n->srcn);
        n = &wb->names[wb->nnames];
        n->node = wb_gnode_new(wb, GN_NAME, wb->nnames);
        if (n->node == WN32) return 0;
        n->pend = 1;
    }
    wb->nnames++;
    return 1;
}

/* A new table from its header line (named: the caption's name). */
static int wb_tab_begin(RtxWb *wb, WScan *s, const char *hdr, size_t hn, size_t hbol,
                        size_t sep_next, size_t sep_cells) {
    WTab *t;
    RtxMdCell cells[RTX_MD_TABLE_COLS];
    size_t nc, c;
    int32_t ncols;
    const char *nm;
    size_t nmn;
    if (!wb_grow(wb, (void **)&wb->tabs, &wb->tabcap, wb->ntab + 1, sizeof(WTab))) return 0;
    t = &wb->tabs[wb->ntab];
    memset(t, 0, sizeof *t);
    wb_name_copy(s->capname, 0, s->capn, &nm, &nmn);
    t->name = wb_strdup(wb, nm, nmn);
    t->namen = (uint32_t)nmn;
    t->sheet = s->sheet;
    t->lo = s->cap_bol;
    t->cap_lo = s->cap_lo;
    t->cap_hi = s->cap_hi;
    t->body_lo = sep_next;
    t->hi = sep_next;
    nc = rtx_md_row_split(hdr, hn, cells, RTX_MD_TABLE_COLS);
    /* the separator's cell count (the lens's table width) */
    ncols = (int32_t)(sep_cells < RTX_MD_TABLE_COLS ? sep_cells : RTX_MD_TABLE_COLS);
    if (ncols > RTX_WB_COLS_MAX) ncols = RTX_WB_COLS_MAX;
    t->ncols = ncols;
    t->cname = (const char **)wb_ma(wb, (size_t)(ncols + 1) * sizeof(char *));
    t->cnamen = (uint32_t *)wb_ma(wb, (size_t)(ncols + 1) * sizeof(uint32_t));
    t->cclash = (uint8_t *)wb_ma(wb, (size_t)(ncols + 1));
    t->hlo = (size_t *)wb_ma(wb, (size_t)(ncols + 1) * sizeof(size_t));
    t->hhi = (size_t *)wb_ma(wb, (size_t)(ncols + 1) * sizeof(size_t));
    t->cs = (WColStat *)wb_ma(wb, (size_t)(ncols + 1) * sizeof(WColStat));
    t->ct = (uint8_t *)wb_ma(wb, (size_t)(ncols + 1));
    t->csc = (uint8_t *)wb_ma(wb, (size_t)(ncols + 1));
    t->cnode = (uint32_t *)wb_ma(wb, (size_t)(ncols + 1) * sizeof(uint32_t));
    t->kx = (WKx **)calloc((size_t)ncols + 1, sizeof(WKx *));
    if (!t->cname || !t->cnamen || !t->cclash || !t->hlo || !t->hhi || !t->cs || !t->ct ||
        !t->csc || !t->cnode || !t->kx)
        return 0;
    for (c = 0; c < (size_t)ncols; c++) {
        size_t lo, hi;
        if (c >= nc) {
            t->cname[c] = "";
            t->hlo[c] = t->hhi[c] = WNONE;
            continue;
        }
        lo = cells[c].lo;
        hi = cells[c].hi;
        rtx_md_span_trim(hdr, &lo, &hi);
        t->hlo[c] = hbol + lo;
        t->hhi[c] = hbol + hi;
        wb_name_copy(hdr, lo, hi, &nm, &nmn);
        t->cname[c] = wb_strdup(wb, nm, nmn);
        t->cnamen[c] = (uint32_t)nmn;
    }
    for (c = 0; c < (size_t)ncols; c++) {
        size_t k;
        for (k = c + 1; k < (size_t)ncols; k++)
            if (t->cnamen[c] == t->cnamen[k] && wb_ieq(t->cname[c], t->cname[k], t->cnamen[c]))
                t->cclash[c] = t->cclash[k] = 1;
    }
    s->ti = wb->ntab++;
    for (c = 0; c < (size_t)ncols; c++) {
        uint32_t node = wb_gnode_new(wb, GN_COL, s->ti);
        if (node == WN32) return 0;
        wb->g[node].tab = (int32_t)s->ti;
        wb->g[node].col = (int32_t)c;
        wb->tabs[s->ti].cnode[c] = node;
    }
    return 1;
}

/* A body row of the table in progress. */
static int wb_tab_row(RtxWb *wb, WScan *s, const char *ln, size_t n, size_t bol) {
    WTab *t = &wb->tabs[s->ti];
    WRow r;
    if (t->big) return 1;
    if ((int64_t)t->nrows + 1 > (int64_t)g_wb_rows_max) {
        /* over the cap: refused (its rows are dropped) */
        uint32_t i;
        for (i = 0; i < t->nbid; i++) {
            free(t->blk[i].rrel);
            free(t->blk[i].rlen);
            free(t->blk[i].rid);
        }
        free(t->blk);
        free(t->bord);
        free(t->bfirst);
        free(t->rloc);
        t->blk = NULL;
        t->bord = t->bfirst = NULL;
        t->rloc = NULL;
        t->nbid = t->bidcap = t->nb = t->bordcap = t->nrid = t->ridcap = t->nfree = 0;
        t->nrows = 0;
        memset(t->cs, 0, (size_t)t->ncols * sizeof(WColStat));
        kx_free(&t->anc);
        t->big = 1;
        return 1;
    }
    if (!tb_append_row(t, bol, (uint32_t)n)) return 0;
    memset(&r, 0, offsetof(WRow, v));
    r.tab = (int32_t)s->ti;
    r.pos = (int32_t)(t->nrows - 1);
    r.rid = t->nrid - 1;
    r.b = ln;
    r.n = (uint32_t)n;
    wb_row_split(&r);
    wb_row_account(wb, s->ti, &r, 1, 0);
    s->rows++;
    return 1;
}

static void wb_tab_end(RtxWb *wb, WScan *s, size_t hi) {
    WTab *t = &wb->tabs[s->ti];
    int32_t c;
    t->hi = hi;
    if (t->nrows) {
        size_t last_lo = tb_row_lo(t, t->nrows - 1);
        uint32_t len = tb_row_len(t, t->nrows - 1);
        t->lastnl = last_lo + len < hi;
    }
    for (c = 0; c < t->ncols; c++) wb_col_type(&t->cs[c], &t->ct[c], &t->csc[c]);
    wb_blk_add_ext(wb, t->lo, hi, t->lo ? s->prev_bol : 0, 0);
    s->intab = 0;
    s->installed = 0;
}

static int wb_scan_cap_keep(WScan *s, const char *ln, size_t a, size_t b) {
    char *p = (char *)realloc(s->capname, b - a + 1);
    if (!p) return 0;
    memcpy(p, ln + a, b - a);
    p[b - a] = 0;
    s->capname = p;
    s->capn = b - a;
    return 1;
}

/*
 * Workbook parallel structural read (docs/workbook.md "W1 phase 2 as
 * built"): private to wb.ccs, included by it.
 *
 * The structural read is a line state machine (fences, sheets, captions,
 * tables) and stays one pass in document order. What costs is a table
 * body's rows: finding each line, splitting its cells, typing each
 * literal, naming each formula's rule. Those need no state but "this
 * line is a body row", so once the read is inside a table it pre-reads
 * a window ahead in parallel lanes (the `@parallel for` of core/proj.ccs'
 * pick shards, the pool brought up with rtx_par_pool_up; the document
 * read through read_uncached, which lanes may call): each lane cuts its
 * byte range at line starts into segments of consecutive pipe rows —
 * per segment the row lengths, the per-column literal counts (all 16
 * columns: the table's width is applied when merged), the formulas in
 * first-appearance order with counts, and the anchors. A line that is a
 * separator, or is followed by one (a header), is its own segment and
 * never bulk: the state machine reads it as before. The read then takes
 * a rows segment that starts exactly at its cursor while it is inside a
 * table, in one step (row appends, counts, rules in the order a serial
 * read makes them, anchors); anything else goes line by line as before.
 * So the model is the serial read's, bit for bit (wb_prop's `model`
 * property, several lane counts and tiny chunks).
 *
 * It is a job like the serial read: a slice pre-reads a window sized to
 * the slice (the lanes' measured rate) and applies it, then yields; an
 * edit before the cursor restarts it (stamped as before).
 */

#define WBP_MIN_BYTES ((size_t)256 << 10) /* smaller rest: serial */
#define WBP_LONG_LINE ((size_t)1 << 20)   /* longer lines: the state machine's */

typedef struct {
    uint32_t col, off, n, cnt;
} WParF;

typedef struct {
    uint32_t row, off, n;
} WParA;

typedef struct {
    size_t lo, hi;      /* first line start, the start after the last line */
    size_t last_bol;
    uint32_t n0, n;     /* rows: lane len[n0 .. n0 + n) */
    uint8_t rows;       /* 1: body-row candidates; 0: a single special line */
    uint32_t f0, nf;
    uint32_t a0, na;
    WColStat cs[RTX_WB_COLS_MAX];
} WParSeg;

struct WParLane {
    const RtxDoc *d;
    size_t a, b, len, wlo; /* lines starting in [a, b); wlo: the window start */
    char *buf;
    size_t blo, bn, bcap;
    WParSeg *seg;
    uint32_t nseg, segcap;
    uint32_t *ln;
    uint32_t nln, lncap;
    WParF *f;
    uint32_t nf, fcap;
    WParA *an;
    uint32_t na, acap;
    char *txt;
    size_t ntxt, txtcap;
    uint32_t *fh;       /* formula hash slots of the open segment: index + 1 */
    uint32_t fhcap;
    CCArena ar;
    int oom;
    double us, t0, t1;
    _Atomic int *cancel; /* the arm's: stop between lines */
    char pad_[192];      /* lanes sit in one array: no shared cache lines */
};

typedef struct WParWin {
    size_t lo, hi;      /* [window start, the next line after it) */
    struct WParLane *L;
    int nl;
    int li;             /* consumption cursor: lane, segment */
    uint32_t si;
    double rate;        /* bytes / us per lane (last window) */
} WParWin;

static int g_wbp_lanes;        /* 0 auto, 1 off, n lanes */
static size_t g_wbp_chunk;     /* 0 auto (bytes per lane per window) */

void rtx_wb_read_lanes(int lanes, size_t chunk) {
    g_wbp_lanes = lanes < 0 ? 0 : lanes;
    g_wbp_chunk = chunk;
}

static int wbp_lanes(void) {
    static int cores;
    if (g_wbp_lanes) return g_wbp_lanes;
    if (!cores) {
        long n = sysconf(_SC_NPROCESSORS_ONLN);
        if (n < 1) n = 1;
        if (n > 8) n = 8;
        cores = (int)n;
    }
    return cores;
}

static void wbp_lane_free(struct WParLane *L) {
    free(L->buf);
    free(L->seg);
    free(L->ln);
    free(L->f);
    free(L->an);
    free(L->txt);
    free(L->fh);
    if (L->ar.base) L->ar.destroy();
    memset(L, 0, sizeof *L);
}

static void wbp_win_free(WParWin *w) {
    int i;
    if (!w) return;
    for (i = 0; i < w->nl; i++) wbp_lane_free(&w->L[i]);
    free(w->L);
    free(w);
}

/* The lane's buffer holds [p, p + need) (fewer at the end of the doc). */
static int wbp_have(struct WParLane *L, size_t p, size_t need) {
    size_t want, got;
    if (p >= L->blo && p + need <= L->blo + L->bn) return 1;
    if (p >= L->len) return 0;
    want = need + ((size_t)64 << 10);
    if (want < ((size_t)256 << 10)) want = (size_t)256 << 10;
    if (want > L->len - p) want = L->len - p;
    if (want + 1 > L->bcap) {
        char *nb = (char *)realloc(L->buf, want + 1);
        if (!nb) {
            L->oom = 1;
            return 0;
        }
        L->buf = nb;
        L->bcap = want + 1;
    }
    got = RtxPieceTree_read_uncached(&L->d->tree, p, cc_slice_from_buffer(L->buf, want)) ?> 0;
    L->blo = p;
    L->bn = got;
    L->buf[got] = 0;
    return got > 0;
}

/* The line at p: its bytes (no NL) and the next line's start. 2: a line
 * longer than WBP_LONG_LINE (only *next is set: the state machine owns
 * it). 0: past the end. */
static int wbp_line(struct WParLane *L, size_t p, const char **ln, size_t *n, size_t *next) {
    size_t need = 4096;
    for (;;) {
        size_t off, e;
        const char *q;
        if (!wbp_have(L, p, need < L->len - p ? need : L->len - p)) return 0;
        off = p - L->blo;
        q = (const char *)memchr(L->buf + off, '\n', L->bn - off);
        e = q ? (size_t)(q - L->buf) : L->bn;
        if (e < L->bn || L->blo + L->bn >= L->len) {
            *ln = L->buf + off;
            *n = e - off;
            *next = L->blo + (e < L->bn ? e + 1 : e);
            return 1;
        }
        if (L->bn - off > WBP_LONG_LINE) {
            /* find its end without holding it */
            size_t at = L->blo + L->bn;
            for (;;) {
                if (at >= L->len || !wbp_have(L, at, (size_t)64 << 10)) {
                    *next = L->len;
                    return 2;
                }
                q = (const char *)memchr(L->buf, '\n', L->bn);
                if (q) {
                    *next = L->blo + (size_t)(q - L->buf) + 1;
                    return 2;
                }
                at = L->blo + L->bn;
            }
        }
        need = (L->bn - off) * 2 + 4096;
    }
}

static int wbp_grow(void **pp, uint32_t *cap, uint32_t need, size_t el, int *oom) {
    if (!wb_hgrow(pp, cap, need, el)) {
        *oom = 1;
        return 0;
    }
    return 1;
}

static uint32_t wbp_text(struct WParLane *L, const char *s, uint32_t n) {
    size_t at = L->ntxt;
    if (L->ntxt + n > L->txtcap) {
        size_t nc = L->txtcap ? L->txtcap * 2 : 4096;
        char *np;
        while (nc < L->ntxt + n) nc *= 2;
        np = (char *)realloc(L->txt, nc);
        if (!np) {
            L->oom = 1;
            return 0;
        }
        L->txt = np;
        L->txtcap = nc;
    }
    if (n) memcpy(L->txt + at, s, n);
    L->ntxt += n;
    return (uint32_t)at;
}

static void wbp_close(struct WParLane *L, WParSeg **cur) {
    if (*cur && L->fhcap) memset(L->fh, 0, (size_t)L->fhcap * sizeof(uint32_t));
    *cur = NULL;
}

static WParSeg *wbp_seg(struct WParLane *L, size_t lo, int rows) {
    WParSeg *g;
    if (!wbp_grow((void **)&L->seg, &L->segcap, L->nseg + 1, sizeof(WParSeg), &L->oom)) return NULL;
    g = &L->seg[L->nseg++];
    memset(g, 0, sizeof *g);
    g->lo = g->hi = g->last_bol = lo;
    g->rows = (uint8_t)rows;
    g->n0 = L->nln;
    g->f0 = L->nf;
    g->a0 = L->na;
    return g;
}

/* A formula cell of the open segment: counted, first appearance kept. */
static void wbp_formula(struct WParLane *L, WParSeg *g, uint32_t col, const char *s, uint32_t n) {
    uint64_t h = wb_rule_hash(0, (int32_t)col, s, n);
    uint32_t j;
    if ((g->nf + 1) * 2 > L->fhcap) {
        uint32_t nc = L->fhcap ? L->fhcap * 2 : 64, i;
        uint32_t *nh = (uint32_t *)calloc(nc, sizeof(uint32_t));
        if (!nh) {
            L->oom = 1;
            return;
        }
        for (i = 0; i < g->nf; i++) {
            const WParF *f = &L->f[g->f0 + i];
            uint32_t k = (uint32_t)wb_rule_hash(0, (int32_t)f->col, L->txt + f->off, f->n) & (nc - 1);
            while (nh[k]) k = (k + 1) & (nc - 1);
            nh[k] = i + 1;
        }
        free(L->fh);
        L->fh = nh;
        L->fhcap = nc;
    }
    j = (uint32_t)h & (L->fhcap - 1);
    while (L->fh[j]) {
        WParF *f = &L->f[g->f0 + L->fh[j] - 1];
        if (f->col == col && f->n == n && !memcmp(L->txt + f->off, s, n)) {
            f->cnt++;
            return;
        }
        j = (j + 1) & (L->fhcap - 1);
    }
    if (!wbp_grow((void **)&L->f, &L->fcap, L->nf + 1, sizeof(WParF), &L->oom)) return;
    L->f[L->nf].col = col;
    L->f[L->nf].n = n;
    L->f[L->nf].cnt = 1;
    L->f[L->nf].off = wbp_text(L, s, n);
    L->nf++;
    L->fh[j] = g->nf + 1;
    g->nf++;
}

/* One body row of the open segment: wb_row_account's work for every
 * column the row has (the table's width is applied at the merge). */
static void wbp_row(struct WParLane *L, WParSeg *g, const char *ln, size_t n, size_t bol) {
    WRow r;
    int c;
    if (!wbp_grow((void **)&L->ln, &L->lncap, L->nln + 1, sizeof(uint32_t), &L->oom)) return;
    L->ln[L->nln++] = (uint32_t)n;
    memset(&r, 0, offsetof(WRow, v));
    r.b = ln;
    r.n = (uint32_t)n;
    wb_row_split(&r);
    for (c = 0; c < r.nc; c++) {
        size_t lo, hi, slo, shi, flo, fhi;
        if (!wb_cell_span(&r, c, &lo, &hi)) continue;
        if (wb_cell_formula(r.b, lo, hi, &slo, &shi, &flo, &fhi)) {
            wbp_formula(L, g, (uint32_t)c, r.b + slo, (uint32_t)(shi - slo));
            wb_cs_add(&g->cs[c], LK_FORMULA, 0, 1);
        } else {
            int sc = 0;
            int lk = wb_cell_kind_a(L->ar, r.b, lo, hi, &sc);
            wb_cs_add(&g->cs[c], lk, sc, 1);
        }
    }
    if (r.ahi > r.alo) {
        if (wbp_grow((void **)&L->an, &L->acap, L->na + 1, sizeof(WParA), &L->oom)) {
            L->an[L->na].row = g->n;
            L->an[L->na].n = r.ahi - r.alo;
            L->an[L->na].off = wbp_text(L, r.b + r.alo, r.ahi - r.alo);
            L->na++;
            g->na++;
        }
    }
    g->n++;
    g->last_bol = bol;
    L->ar.reset();
}

static int wbp_blank_pipe(const char *ln, size_t n2) {
    return !wb_blank(ln, n2) && rtx_md_line_pipe(ln, n2);
}

/* One lane: its lines into segments. */
static void wbp_lane_run(void *arg) {
    struct WParLane *L = (struct WParLane *)arg;
    size_t p = L->a;
    WParSeg *cur = NULL;
    double t0 = wb_now_us();
    int known = 0, ksep = 0; /* the line at p is (not) a separator: known from the look ahead */
    if (!L->ar.base) L->ar = cc_arena_heap(64u << 10);
    if (!L->ar.base) {
        L->oom = 1;
        return;
    }
    if (p > L->wlo) {
        /* the first line starting at or after a */
        if (!wbp_have(L, p - 1, 1)) return;
        if (L->buf[p - 1 - L->blo] != '\n') {
            for (;;) {
                const char *q;
                if (p >= L->b || !wbp_have(L, p, 1)) {
                    L->us = wb_now_us() - t0;
                    return;
                }
                q = (const char *)memchr(L->buf + (p - L->blo), '\n', L->bn - (p - L->blo));
                if (q) {
                    p = L->blo + (size_t)(q - L->buf) + 1;
                    break;
                }
                p = L->blo + L->bn;
            }
        }
    }
    while (p < L->b && p < L->len && !L->oom) {
        const char *ln;
        size_t n, next, n2;
        int k, special = 0, sep;
        if (L->cancel && (L->nln & 255) == 0 && atomic_load_explicit(L->cancel, memory_order_acquire))
            break;
        k = wbp_line(L, p, &ln, &n, &next);
        if (!k) break;
        if (k == 2) {
            known = 0;
            wbp_close(L, &cur);
            p = next;
            continue;
        }
        n2 = n && ln[n - 1] == '\r' ? n - 1 : n;
        if (!wbp_blank_pipe(ln, n2)) {
            known = 0;
            wbp_close(L, &cur);
            p = next;
            continue;
        }
        sep = known ? ksep : rtx_md_line_is_sep(ln, n2);
        known = 0;
        if (sep) {
            special = 1;
        } else if (next < L->len && next > p + n) {
            /* followed by a separator: a table header (the state machine's).
             * The next line from the buffer when it is whole there; else
             * reading it may move the buffer: re-read this one. */
            const char *l2 = NULL, *q;
            size_t m = 0, m2, keep = p;
            size_t off2 = next - L->blo;
            if (next >= L->blo && off2 < L->bn &&
                (q = (const char *)memchr(L->buf + off2, '\n', L->bn - off2)) != NULL) {
                l2 = L->buf + off2;
                m = (size_t)(q - l2);
            } else {
                size_t nx2;
                if (wbp_line(L, next, &l2, &m, &nx2) != 1) l2 = NULL;
                if (wbp_line(L, keep, &ln, &n, &next) != 1) break;
                if (l2) {
                    /* the buffer moved back to this line: find the next again */
                    off2 = next - L->blo;
                    q = off2 < L->bn ? (const char *)memchr(L->buf + off2, '\n', L->bn - off2) : NULL;
                    l2 = off2 < L->bn ? L->buf + off2 : NULL;
                    m = q ? (size_t)(q - l2) : (l2 ? L->bn - off2 : 0);
                }
            }
            if (l2) {
                m2 = m && l2[m - 1] == '\r' ? m - 1 : m;
                ksep = rtx_md_line_is_sep(l2, m2);
                known = 1;
                if (ksep) special = 1;
            }
        }
        if (special) {
            WParSeg *g;
            wbp_close(L, &cur);
            g = wbp_seg(L, p, 0);
            if (!g) break;
            g->hi = next;
            g->last_bol = p;
            p = next;
            continue;
        }
        if (!cur) {
            cur = wbp_seg(L, p, 1);
            if (!cur) break;
        }
        wbp_row(L, cur, ln, n, p);
        cur->hi = next;
        p = next;
    }
    wbp_close(L, &cur);
    L->us = wb_now_us() - t0;
    L->t0 = t0;
    L->t1 = t0 + L->us;
}

static void wbp_run_lanes(struct WParLane *L, int n) {
    int s;
    if (n <= 1 || rtx_parallel_inline()) {
        for (s = 0; s < n; s++) wbp_lane_run(&L[s]);
        return;
    }
    rtx_par_pool_up();
    {
        char *base = (char *)L;
        size_t sz = sizeof(struct WParLane);
        @parallel for (s in 0..n) {
            wbp_lane_run(base + (size_t)s * sz);
        } !>.wait()!>;
    }
}

static int wbp_win_init(WParWin *w, int nl) {
    w->L = (struct WParLane *)calloc((size_t)nl, sizeof(struct WParLane));
    if (!w->L) return 0;
    w->nl = nl;
    return 1;
}

/* Fill window w: the lines starting in [lo, hi) (wlo: where the pre-read
 * began — a line start; later windows find their first line). 0: out of
 * memory or cancelled. */
static int wbp_fill(WParWin *w, const RtxDoc *d, size_t len, size_t wlo, size_t lo, size_t hi,
                    _Atomic int *cancel) {
    int i;
    for (i = 0; i < w->nl; i++) {
        struct WParLane *L = &w->L[i];
        L->d = d;
        L->len = len;
        L->wlo = wlo;
        L->a = lo + (hi - lo) * (size_t)i / (size_t)w->nl;
        L->b = lo + (hi - lo) * (size_t)(i + 1) / (size_t)w->nl;
        L->nseg = L->nln = L->nf = L->na = 0;
        L->ntxt = 0;
        L->oom = 0;
        L->bn = 0;
        L->blo = 0;
        L->us = 0;
        L->cancel = cancel;
    }
    wbp_run_lanes(w->L, w->nl);
    for (i = 0; i < w->nl; i++)
        if (w->L[i].oom) return 0;
    if (cancel && atomic_load_explicit(cancel, memory_order_acquire)) return 0;
    w->lo = lo;
    w->hi = hi;
    w->li = 0;
    w->si = 0;
    return 1;
}

/* Pre-read [s->pos, ...) on the caller (RTX_PARALLEL_INLINE, tests): one
 * window sized to the slice. 0: no window (serial). */
static int wbp_window(RtxWb *wb, WScan *s, double deadline_us) {
    int nl = wbp_lanes(), i;
    size_t chunk, lo = s->pos, hi;
    WParWin *w = s->par;
    double rate = w ? w->rate : 0, tl;
    if (nl <= 1) return 0;
    if (!g_wbp_chunk && (s->len < g_wb_defer || s->len - lo < WBP_MIN_BYTES)) return 0;
    if (g_wbp_chunk) {
        chunk = g_wbp_chunk;
    } else if (deadline_us <= 0) {
        chunk = (size_t)8 << 20;
    } else {
        double left = deadline_us - wb_now_us();
        if (left < 1000) left = 1000;
        chunk = rate > 0 ? (size_t)(rate * left * 0.8) : ((size_t)256 << 10);
        if (chunk < ((size_t)64 << 10)) chunk = (size_t)64 << 10;
        if (chunk > ((size_t)8 << 20)) chunk = (size_t)8 << 20;
    }
    hi = lo + chunk * (size_t)nl;
    if (hi > s->len || hi < lo) hi = s->len;
    if (!w) {
        w = (WParWin *)calloc(1, sizeof *w);
        if (!w) return 0;
        if (!wbp_win_init(w, nl)) {
            free(w);
            return 0;
        }
        s->par = w;
    }
    tl = wb_now_us();
    if (!wbp_fill(w, wb->doc, s->len, lo, lo, hi, NULL)) return 0;
    wb->st.par_us += (size_t)(wb_now_us() - tl);
    wb->st.par_bytes += hi - lo;
    {
        double us = 0;
        for (i = 0; i < w->nl; i++)
            if (w->L[i].us > us) us = w->L[i].us;
        if (us > 0) w->rate = (double)chunk / us;
    }
    wb->st.par_windows++;
    return 1;
}

/* ---- the background pre-read (dest-live): an arm fills a ring of
 * windows ahead of the read; the read takes them in order. The arm reads
 * the document while the UI does not write it: every tree write is
 * preceded by the derived hook's `pre`, which stops the arm (cancel +
 * join, bounded by a window's lines per lane); the read re-kicks one at
 * its next table row. */

#define WBP_RING 4
#define WBP_ARM_CHUNK ((size_t)2 << 20) /* bytes per lane per window */
#define WBP_ARM_MIN ((size_t)4 << 20)   /* a smaller rest reads on the caller */

typedef struct WParArm {
    CCParallel h;
    const RtxDoc *d;
    size_t start, len, chunk;
    int nl;
    WParWin win[WBP_RING];
    _Atomic uint32_t pub;   /* windows published (arm) */
    _Atomic uint32_t freed; /* windows the read is done with (UI) */
    uint32_t used;          /* UI's cursor */
    _Atomic int cancel;
    _Atomic int done;
    double us;              /* the arm's lane time (stats) */
    size_t bytes;
} WParArm;

static void wbp_arm_run(WParArm *A) {
    size_t lo = A->start;
    uint32_t k = 0;
    double t0;
    while (lo < A->len && !atomic_load_explicit(&A->cancel, memory_order_acquire)) {
        WParWin *w;
        size_t hi;
        while (k - atomic_load_explicit(&A->freed, memory_order_acquire) >= WBP_RING) {
            struct timespec ts = {0, 200000L};
            if (atomic_load_explicit(&A->cancel, memory_order_acquire)) goto out;
            nanosleep(&ts, NULL);
        }
        w = &A->win[k % WBP_RING];
        hi = lo + A->chunk * (size_t)A->nl;
        if (hi > A->len || hi < lo) hi = A->len;
        t0 = wb_now_us();
        if (!wbp_fill(w, A->d, A->len, A->start, lo, hi, &A->cancel)) break;
        A->us += wb_now_us() - t0;
        A->bytes += hi - lo;
        if (getenv("RTX_WB_PAR_DEBUG")) {
            int i;
            fprintf(stderr, "wbp arm: window %zu KiB in %.0f us; lanes (start, end) us:", (hi - lo) >> 10,
                    wb_now_us() - t0);
            for (i = 0; i < w->nl; i++)
                fprintf(stderr, " (%.0f, %.0f)", w->L[i].t0 - t0, w->L[i].t1 - t0);
            fprintf(stderr, "\n");
        }
        k++;
        atomic_store_explicit(&A->pub, k, memory_order_release);
        lo = hi;
    }
out:
    atomic_store_explicit(&A->done, 1, memory_order_release);
}

static void wbp_arm_run_v(void *a) {
    wbp_arm_run((WParArm *)a);
}

static void wbp_arm_free(WParArm *A) {
    int i, j;
    if (!A) return;
    for (i = 0; i < WBP_RING; i++) {
        for (j = 0; j < A->win[i].nl; j++) wbp_lane_free(&A->win[i].L[j]);
        free(A->win[i].L);
    }
    free(A);
}

/* Cancel and join the arm (edits, a restart, the end of the read). */
static void wbp_arm_stop(RtxWb *wb, WScan *s) {
    WParArm *A = s ? s->arm : NULL;
    if (!A) return;
    atomic_store_explicit(&A->cancel, 1, memory_order_release);
    if (A->h.live()) {
        if (A->h.paused()) A->h.resume() !>(e) { (void)e; };
        A->h.wait() !>(e) { (void)e; };
    }
    if (wb) {
        wb->st.par_us += (size_t)A->us;
        wb->st.par_bytes += A->bytes;
        wb->st.par_windows += atomic_load(&A->pub);
    }
    wbp_arm_free(A);
    s->arm = NULL;
}

static void !>(CCError) wbp_arm_kick(RtxWb *wb, WScan *s) {
    WParArm *A;
    void *arm;
    int nl = wbp_lanes(), i, noop = 0;
    A = (WParArm *)calloc(1, sizeof *A);
    if (!A) return cc_err(CC_ERR_OUT_OF_MEMORY, "wb pre-read");
    for (i = 0; i < WBP_RING; i++)
        if (!wbp_win_init(&A->win[i], nl)) {
            wbp_arm_free(A);
            return cc_err(CC_ERR_OUT_OF_MEMORY, "wb pre-read");
        }
    A->d = wb->doc;
    A->start = s->pos;
    A->len = s->len;
    A->nl = nl;
    A->chunk = g_wbp_chunk ? g_wbp_chunk : WBP_ARM_CHUNK;
    s->arm = A;
    rtx_par_pool_up();
    arm = A;
    A->h = @parallel {
        @serial { noop = 0; }
        wbp_arm_run_v(arm);
    } !>;
    (void)noop;
    return cc_ok();
}

static int wbp_kick(RtxWb *wb, WScan *s) {
    @errhandler(CCError e) {
        (void)e;
        return 0;
    }
    wbp_arm_kick(wb, s) !>;
    return s->arm != NULL;
}

/* The arm's window holding the line at s->pos: waits for it when the
 * arm is behind (until the deadline; 0: until it is there). NULL with
 * *wait set: out of time; NULL: the arm has nothing for it (serial). */
static WParWin *wbp_arm_win(WScan *s, double deadline_us, int *wait) {
    WParArm *A = s->arm;
    *wait = 0;
    for (;;) {
        uint32_t pub = atomic_load_explicit(&A->pub, memory_order_acquire);
        if (A->used < pub) {
            WParWin *w = &A->win[A->used % WBP_RING];
            if (s->pos >= w->hi) {
                A->used++;
                atomic_store_explicit(&A->freed, A->used, memory_order_release);
                continue;
            }
            return s->pos >= w->lo ? w : NULL;
        }
        if (atomic_load_explicit(&A->done, memory_order_acquire) &&
            A->used == atomic_load_explicit(&A->pub, memory_order_acquire))
            return NULL;
        if (deadline_us > 0 && wb_deadline_hit(deadline_us)) {
            *wait = 1;
            return NULL;
        }
        {
            struct timespec ts = {0, 50000L};
            nanosleep(&ts, NULL);
        }
    }
}

/* The segment starting at `pos` in the window, or NULL. */
static WParSeg *wbp_at(WParWin *w, size_t pos, struct WParLane **lane) {
    while (w->li < w->nl) {
        struct WParLane *L = &w->L[w->li];
        while (w->si < L->nseg && L->seg[w->si].lo < pos) w->si++;
        if (w->si < L->nseg) {
            if (L->seg[w->si].lo != pos) return NULL;
            *lane = L;
            return &L->seg[w->si];
        }
        w->li++;
        w->si = 0;
    }
    return NULL;
}

/* Inside a table: take the rows segment at the cursor in one step. 1:
 * taken (the cursor moved), 2: the pre-read is behind and the slice is
 * over, 0: the state machine reads the next line, -1: out of memory. */
static int wbp_bulk(RtxWb *wb, WScan *s, double deadline_us) {
    WParWin *w;
    WParSeg *g;
    struct WParLane *L = NULL;
    if (!s->intab || s->installed || g_wbp_lanes == 1) return 0;
    if (!s->arm && !rtx_parallel_inline() && wbp_lanes() > 1 && !s->arm_off &&
        (g_wbp_chunk || (s->len >= g_wb_defer && s->len - s->pos >= WBP_ARM_MIN))) {
        if (!wbp_kick(wb, s)) s->arm_off = 1;
    }
    if (s->arm) {
        int wait;
        w = wbp_arm_win(s, deadline_us, &wait);
        if (!w) return wait ? 2 : 0;
    } else {
        w = s->par;
        if (!w || s->pos >= w->hi || s->pos < w->lo) {
            if (!wbp_window(wb, s, deadline_us)) return 0;
            w = s->par;
        }
    }
    g = wbp_at(w, s->pos, &L);
    if (!g || !g->rows || !g->n) return 0;
    if (s->intab == 2) {
        s->prev_bol = g->last_bol;
        s->pos = g->hi;
        return 1;
    }
    {
        WTab *t = &wb->tabs[s->ti];
        uint32_t i, rid0, c;
        size_t bol = g->lo;
        if (t->big || (int64_t)t->nrows + g->n > (int64_t)g_wb_rows_max) return 0;
        rid0 = t->nrid;
        for (i = 0; i < g->n; i++) {
            uint32_t n = L->ln[g->n0 + i];
            if (!tb_append_row(t, bol, n)) return -1;
            bol += (size_t)n + 1;
        }
        for (c = 0; c < (uint32_t)t->ncols; c++) {
            int k;
            for (k = 0; k < LK__N; k++) t->cs[c].k[k] += g->cs[c].k[k];
            for (k = 0; k < 19; k++) t->cs[c].sc[k] += g->cs[c].sc[k];
        }
        for (i = 0; i < g->nf; i++) {
            const WParF *f = &L->f[g->f0 + i];
            int ri;
            if (f->col >= (uint32_t)t->ncols) continue;
            ri = wb_rule_get(wb, (int32_t)s->ti, (int32_t)f->col, L->txt + f->off, f->n, 0);
            if (ri >= 0) {
                WRule *ru = &wb->rules[ri];
                if (ru->refs == 0) wb->graph_dirty = 1;
                ru->refs += f->cnt;
            }
            wb->nform_cells += f->cnt;
            wb->nderived += f->cnt;
        }
        for (i = 0; i < g->na; i++) {
            const WParA *a = &L->an[g->a0 + i];
            WKey k;
            wb_anc_key(L->txt + a->off, a->n, &k);
            kx_add(&t->anc, &k, rid0 + a->row);
        }
        s->rows += g->n;
        s->prev_bol = g->last_bol;
        s->pos = g->hi;
        wb->st.par_rows += g->n;
    }
    return 1;
}
/*
 * Workbook persisted index (docs/workbook.md "W1 phase 2 as built"):
 * private to wb.ccs, included by it (it reads the engine's statics).
 *
 * File: `<cache>/w/<FNV-1a 64 of the doc's realpath>.wbi` (the cache dir
 * is the Safe dir: rtx_wb_set_cache_fn(rtx_safe_dir) from the
 * workspace; tests set a dir). Built in memory, written to a `.tmp`
 * sibling, fsync'ed, renamed — by a detached writer thread, so the UI
 * never waits on the disk. Layout: a header (magic, version, the file's
 * identity (dev, ino, size, mtime ns, ctime ns) as core/sindex keys it,
 * the time the bytes were read, the doc length, the caps the model
 * depends on, the realpath), a directory of table sections, the table
 * sections, the post section, a 64-bit checksum over every word before
 * it. Any mismatch (magic, version, sum, sizes, path, caps, identity,
 * a racily-clean stamp: sindex's rtx_si_trusted) and the file is
 * ignored; the next settle writes a new one.
 *
 * Table section (one per named table, in document order): name, body
 * start, columns, the per-column literal counts, the rules its formula
 * cells name (in rule order, with their row counts), the anchor index,
 * and the position index exactly (block ids, positions, free list, per
 * block its first byte, row lengths — u16 when they fit — and row ids,
 * both only when not implied). The structural read reads every line
 * outside table bodies as before; at a table whose header, name, columns
 * and body start match the next section it installs the section and
 * jumps past the body, so a reopen reads no body byte.
 *
 * Post section (after the bind, keyed by stable names — an aggregate by
 * its owner's label, the owner's text and its ordinal in the owner's AST,
 * so it survives any agg numbering): every settled aggregate instance's
 * partials (root WAcc, per-block stop counts, bests, block-mode partials,
 * group maps), complete chain checkpoints, and built key indexes. An
 * instance whose key is missing builds as before (a job).
 */


int RtxDoc_dirty(const RtxDoc *d);

#define WBI_MAGIC 0x31494257585452ull /* "RTXWBI1" */
#define WBI_VER 4u

/* ------------------------------------------------------------ settings */

static char g_wbi_dir[4096];
static int g_wbi_dir_set;
static int (*g_wbi_dir_fn)(char *, size_t);
static int g_wbi_off = -1; /* RTX_WB_INDEX=0 */
static int g_wbi_sync = -1; /* RTX_WB_INDEX_SYNC=1: write on the caller */
static _Atomic int g_wbi_writers;
static _Atomic unsigned g_wbi_written;

void rtx_wb_set_cache_dir(const char *dir) {
    if (!dir || !dir[0]) {
        g_wbi_dir[0] = 0;
        g_wbi_dir_set = 1;
        return;
    }
    snprintf(g_wbi_dir, sizeof g_wbi_dir, "%s", dir);
    g_wbi_dir_set = 1;
}

void rtx_wb_set_cache_fn(int (*fn)(char *, size_t)) {
    g_wbi_dir_fn = fn;
}

static int wbi_enabled(void) {
    if (g_wbi_off < 0) {
        const char *e = getenv("RTX_WB_INDEX");
        g_wbi_off = e && e[0] == '0';
    }
    return !g_wbi_off;
}

static int wbi_cache_dir(char *out, size_t cap) {
    if (g_wbi_dir_set) {
        if (!g_wbi_dir[0]) return 0;
        snprintf(out, cap, "%s", g_wbi_dir);
        return 1;
    }
    return g_wbi_dir_fn && g_wbi_dir_fn(out, cap);
}

static uint64_t wbi_fnv(const char *s, size_t n) {
    uint64_t h = 1469598103934665603ull;
    size_t i;
    for (i = 0; i < n; i++) {
        h ^= (unsigned char)s[i];
        h *= 1099511628211ull;
    }
    return h;
}

int rtx_wb_index_path(const char *doc_path, char *out, size_t cap) {
    char real[4096], dir[4096], d2[4200];
    if (!doc_path || !out || !cap || !wbi_enabled()) return 0;
    if (!realpath(doc_path, real)) return 0;
    if (!wbi_cache_dir(dir, sizeof dir)) return 0;
    if (snprintf(d2, sizeof d2, "%s/w", dir) >= (int)sizeof d2) return 0;
    if (mkdir(d2, 0700) != 0 && errno != EEXIST) return 0;
    return snprintf(out, cap, "%s/%016llx.wbi", d2, (unsigned long long)wbi_fnv(real, strlen(real))) <
           (int)cap;
}

void rtx_wb_index_flush(void) {
    while (atomic_load(&g_wbi_writers) > 0) {
        struct timespec ts = {0, 1000000L};
        nanosleep(&ts, NULL);
    }
}

unsigned rtx_wb_index_writes(void) {
    return atomic_load(&g_wbi_written);
}

static int64_t wbi_now_ns(void) {
    struct timespec ts;
    clock_gettime(CLOCK_REALTIME, &ts);
    return (int64_t)ts.tv_sec * 1000000000LL + ts.tv_nsec;
}

/* ------------------------------------------------------------ buffers */

typedef struct {
    uint8_t *p;
    size_t n, cap;
    int oom;
} WbiBuf;

static void wbi_put(WbiBuf *b, const void *s, size_t k) {
    if (b->oom) return;
    if (b->n + k > b->cap) {
        size_t nc = b->cap ? b->cap * 2 : (1u << 16);
        uint8_t *np;
        while (nc < b->n + k) nc *= 2;
        np = (uint8_t *)realloc(b->p, nc);
        if (!np) {
            b->oom = 1;
            return;
        }
        b->p = np;
        b->cap = nc;
    }
    if (k) memcpy(b->p + b->n, s, k);
    b->n += k;
}

static void wbi_u8(WbiBuf *b, uint8_t v) {
    wbi_put(b, &v, 1);
}
static void wbi_u32(WbiBuf *b, uint32_t v) {
    wbi_put(b, &v, 4);
}
static void wbi_u64(WbiBuf *b, uint64_t v) {
    wbi_put(b, &v, 8);
}
static void wbi_str(WbiBuf *b, const char *s, uint32_t n) {
    wbi_u32(b, n);
    wbi_put(b, s, n);
}
static void wbi_set64(WbiBuf *b, size_t at, uint64_t v) {
    if (!b->oom && at + 8 <= b->n) memcpy(b->p + at, &v, 8);
}

typedef struct {
    const uint8_t *p;
    size_t n, at;
    int bad;
} WbiRd;

static const void *wbi_get(WbiRd *r, size_t k) {
    const void *p;
    if (r->bad || k > r->n - r->at) {
        r->bad = 1;
        return NULL;
    }
    p = r->p + r->at;
    r->at += k;
    return p;
}
static uint8_t wbi_g8(WbiRd *r) {
    const uint8_t *p = (const uint8_t *)wbi_get(r, 1);
    return p ? *p : 0;
}
static uint32_t wbi_g32(WbiRd *r) {
    uint32_t v = 0;
    const void *p = wbi_get(r, 4);
    if (p) memcpy(&v, p, 4);
    return v;
}
static uint64_t wbi_g64(WbiRd *r) {
    uint64_t v = 0;
    const void *p = wbi_get(r, 8);
    if (p) memcpy(&v, p, 8);
    return v;
}
static const char *wbi_gstr(WbiRd *r, uint32_t *n) {
    *n = wbi_g32(r);
    return (const char *)wbi_get(r, *n);
}

/* Four interleaved lanes over 64-bit words: ~GB/s, order sensitive. */
static uint64_t wbi_sum(const uint8_t *p, size_t nw) {
    uint64_t h[4] = {0x9e3779b97f4a7c15ull, 0xc2b2ae3d27d4eb4full, 0x165667b19e3779f9ull,
                     0x27d4eb2f165667c5ull};
    size_t i;
    for (i = 0; i + 4 <= nw; i += 4) {
        uint64_t w[4];
        int k;
        memcpy(w, p + i * 8, 32);
        for (k = 0; k < 4; k++) {
            h[k] ^= w[k];
            h[k] *= 0x100000001b3ull ^ ((uint64_t)k << 40);
            h[k] ^= h[k] >> 29;
        }
    }
    for (; i < nw; i++) {
        uint64_t w;
        memcpy(&w, p + i * 8, 8);
        h[0] ^= w;
        h[0] *= 0x100000001b3ull;
        h[0] ^= h[0] >> 29;
    }
    return h[0] ^ (h[1] * 3) ^ (h[2] * 5) ^ (h[3] * 7) ^ (uint64_t)nw;
}

/* ------------------------------------------------------------ values */

static void wbi_val(WbiBuf *b, const WVal *v) {
    wbi_u8(b, v->t);
    wbi_u8(b, v->sc);
    wbi_put(b, &v->code, 2);
    if (v->t == WV_TEXT || v->t == WV_ERR) {
        wbi_str(b, v->n ? v->u.s : "", v->n);
    } else {
        wbi_u32(b, v->n);
        wbi_put(b, &v->u.i, 8);
    }
}

/* Text is copied into `a` (NULL: the model's value arena). */
static WVal wbi_gval(WbiRd *r, RtxWb *wb, CCArena *a) {
    WVal v = wv_null();
    v.t = wbi_g8(r);
    v.sc = wbi_g8(r);
    {
        const void *p = wbi_get(r, 2);
        if (p) memcpy(&v.code, p, 2);
    }
    if (v.t == WV_TEXT || v.t == WV_ERR) {
        uint32_t n;
        const char *s = wbi_gstr(r, &n);
        WVal t = wv_null();
        if (!s) return wv_null();
        t.t = v.t;
        t.code = v.code;
        t.u.s = s;
        t.n = n;
        v = a ? wv_keep_in(*a, t) : wv_keep(wb, t);
        if (!n) v.u.s = "";
    } else {
        const void *p;
        v.n = wbi_g32(r);
        p = wbi_get(r, 8);
        if (p) memcpy(&v.u.i, p, 8);
    }
    return v;
}

static void wbi_key(WbiBuf *b, const WKey *k) {
    wbi_u64(b, k->h);
    wbi_put(b, &k->i, 8);
    wbi_u8(b, k->t);
    wbi_u8(b, k->sc);
    wbi_str(b, k->t == KY_TEXT && k->n ? k->s : "", k->t == KY_TEXT ? k->n : 0);
    if (k->t != KY_TEXT) wbi_u32(b, k->n);
}

/* The key's text points into the file buffer: the callers copy it. */
static void wbi_gkey(WbiRd *r, WKey *k) {
    const void *p;
    uint32_t n;
    memset(k, 0, sizeof *k);
    k->h = wbi_g64(r);
    p = wbi_get(r, 8);
    if (p) memcpy(&k->i, p, 8);
    k->t = wbi_g8(r);
    k->sc = wbi_g8(r);
    k->s = wbi_gstr(r, &n);
    if (!k->s) k->s = "";
    k->n = n;
    if (k->t != KY_TEXT) {
        k->n = wbi_g32(r);
        k->s = NULL;
    }
}

static void wbi_acc(WbiBuf *b, const WAcc *a) {
    wbi_u32(b, a->cnt);
    wbi_u32(b, a->stop);
    wbi_put(b, a->nsc, sizeof a->nsc);
    wbi_u32(b, a->nflt);
    wbi_u32(b, a->nnan);
    wbi_u32(b, a->npinf);
    wbi_u32(b, a->nninf);
    wbi_put(b, a->ncls, sizeof a->ncls);
    wbi_u32(b, a->nt);
    wbi_u32(b, a->nf);
    wbi_put(b, a->isum, sizeof a->isum);
    wbi_u8(b, a->fx != NULL);
    if (a->fx) wbi_put(b, a->fx, sizeof(RtxXs));
    wbi_u8(b, a->dm != NULL);
    if (a->dm) {
        uint32_t j, n = 0;
        for (j = 0; j < a->dm->cap; j++)
            if (a->dm->e[j].used && a->dm->e[j].cnt) n++;
        wbi_u32(b, n);
        for (j = 0; j < a->dm->cap; j++) {
            const WDEnt *e = &a->dm->e[j];
            if (!e->used || !e->cnt) continue;
            wbi_key(b, &e->k);
            wbi_u32(b, e->cnt);
        }
    }
}

/* A distinct entry with its count (restore; the map grows as wd_add's). */
static int wd_put(WDMap *m, const WKey *k, uint32_t cnt) {
    WDEnt *e;
    if ((m->used + 1) * 4 >= m->cap * 3 && !wd_grow(m)) return 0;
    e = wd_find(m, k);
    if (!e || e->used) return 0;
    e->used = 1;
    e->k = *k;
    if (k->t == KY_TEXT && k->n) {
        char *p = (char *)cc_arena_alloc(m->ar, k->n, 1);
        if (!p) return 0;
        memcpy(p, k->s, k->n);
        e->k.s = p;
    } else if (k->t == KY_TEXT) {
        e->k.s = "";
    }
    e->cnt = cnt;
    m->used++;
    if (cnt) m->live++;
    return 1;
}

/* Into an accumulator that already has the storage its output needs
 * (acc_need): the file must agree on fx / dm. */
static int wbi_gacc(WbiRd *r, WAcc *a) {
    RtxXs *fx = a->fx;
    WDMap *dm = a->dm;
    const void *p;
    acc_reset(a);
    a->cnt = wbi_g32(r);
    a->stop = wbi_g32(r);
    if ((p = wbi_get(r, sizeof a->nsc))) memcpy(a->nsc, p, sizeof a->nsc);
    a->nflt = wbi_g32(r);
    a->nnan = wbi_g32(r);
    a->npinf = wbi_g32(r);
    a->nninf = wbi_g32(r);
    if ((p = wbi_get(r, sizeof a->ncls))) memcpy(a->ncls, p, sizeof a->ncls);
    a->nt = wbi_g32(r);
    a->nf = wbi_g32(r);
    if ((p = wbi_get(r, sizeof a->isum))) memcpy(a->isum, p, sizeof a->isum);
    if (wbi_g8(r)) {
        p = wbi_get(r, sizeof(RtxXs));
        if (!fx || !p) return 0;
        memcpy(fx, p, sizeof(RtxXs));
    } else if (fx) {
        return 0;
    }
    if (wbi_g8(r)) {
        uint32_t n = wbi_g32(r), j;
        if (!dm) return 0;
        for (j = 0; j < n && !r->bad; j++) {
            WKey k;
            uint32_t cnt;
            wbi_gkey(r, &k);
            cnt = wbi_g32(r);
            if (!wd_put(dm, &k, cnt)) return 0;
        }
    } else if (dm) {
        return 0;
    }
    return !r->bad;
}

static void wbi_best(WbiBuf *b, const WBest *x) {
    wbi_u8(b, x->has);
    if (!x->has) return;
    wbi_u32(b, x->rid);
    wbi_val(b, &x->v);
}

static void wbi_gbest(WbiRd *r, WBest *x, CCArena ar) {
    memset(x, 0, sizeof *x);
    x->has = wbi_g8(r);
    if (!x->has) return;
    x->rid = wbi_g32(r);
    x->v = wbi_gval(r, NULL, &ar);
}

/* ------------------------------------------------------------ keys of aggregates */

/* A stable key for aggregate ai: its owner (a name's label, or a rule's
 * table / column), the owner's formula text and the aggregate's ordinal
 * among the owner's aggregates. 0: none (not persisted). */
static uint64_t wbi_agg_key(RtxWb *wb, uint32_t ai) {
    const WAgg *a = &wb->aggs[ai];
    const WGNode *g;
    uint64_t h;
    uint32_t i, ord = WN32;
    char lb[160];
    size_t n;
    if (!a->live || a->owner == WN32 || a->owner >= wb->ng) return 0;
    g = &wb->g[a->owner];
    if (g->kind == GN_NAME) {
        const WName *nm = &wb->names[g->ref];
        if (!nm->def || nm->clash) return 0;
        for (i = 0; i < nm->naggs; i++)
            if (nm->aggs[i] == ai) ord = i;
        n = wb_name_label(wb, g->ref, lb, sizeof lb);
        h = wbi_fnv(lb, n < sizeof lb ? n : sizeof lb - 1);
        h ^= wbi_fnv(nm->src, nm->srcn) * 31;
    } else if (g->kind == GN_RULE) {
        const WRule *ru = &wb->rules[g->ref];
        const WTab *t;
        if (ru->dead || ru->tab < 0) return 0;
        t = &wb->tabs[ru->tab];
        for (i = 0; i < ru->naggs; i++)
            if (ru->aggs[i] == ai) ord = i;
        h = wbi_fnv(t->name, t->namen) ^ ((uint64_t)(uint32_t)ru->col * 0x9e3779b97f4a7c15ull);
        h ^= wbi_fnv(ru->src, ru->srcn) * 31;
        h ^= 0x5bd1e995ull;
    } else {
        return 0;
    }
    if (ord == WN32) return 0;
    h = h * 1099511628211ull + ord + 1;
    return h ? h : 1;
}

/* An instance whose partials are complete and current. */
static int wbi_inst_settled(const RtxWb *wb, const WAgg *a, const WInst *in) {
    const WTab *t = &wb->tabs[a->tab];
    if (!in || !in->live || !in->has || in->pend || in->building || in->full || in->anyresc ||
        in->gstale)
        return 0;
    if (agg_best(a) && !in->bestok) return 0;
    if (in->lcap < t->nbid) return 0;
    if (agg_blockmode(wb, a) && !a->grp && !in->lacc) return 0;
    if (a->blockmode && t->ch.on && t->ch.front < t->nb) return 0;
    return 1;
}

/* ------------------------------------------------------------ writing */

static void wbi_table(RtxWb *wb, WbiBuf *b, uint32_t ti) {
    const WTab *t = &wb->tabs[ti];
    uint32_t i, nr = 0, bid;
    wbi_str(b, t->name, t->namen);
    wbi_u64(b, t->body_lo);
    wbi_u32(b, (uint32_t)t->ncols);
    wbi_u8(b, (uint8_t)t->big);
    wbi_u8(b, (uint8_t)t->ext);
    if (t->ext) {
        const WCsv *cv = t->csv;
        wbi_str(b, cv && cv->real ? cv->real : "", cv && cv->real ? (uint32_t)strlen(cv->real) : 0);
        wbi_u64(b, cv ? cv->id.dev : 0);
        wbi_u64(b, cv ? cv->id.ino : 0);
        wbi_u64(b, cv ? cv->id.size : 0);
        wbi_u64(b, cv ? (uint64_t)cv->id.mtime_ns : 0);
        wbi_u64(b, cv ? (uint64_t)cv->id.ctime_ns : 0);
        wbi_u64(b, cv ? (uint64_t)cv->read_ns : 0);
    }
    wbi_u32(b, t->nrows);
    /* the body ends where the table does (the next line; a refused
     * table's rows too) */
    wbi_u64(b, t->hi);
    wbi_put(b, t->cs, (size_t)t->ncols * sizeof(WColStat));
    /* rules of this table, in rule order */
    for (i = 0; i < wb->nrules; i++)
        if (wb->rules[i].tab == (int32_t)ti && !wb->rules[i].dead && wb->rules[i].refs) nr++;
    wbi_u32(b, nr);
    for (i = 0; i < wb->nrules; i++) {
        const WRule *ru = &wb->rules[i];
        if (ru->tab != (int32_t)ti || ru->dead || !ru->refs) continue;
        wbi_u32(b, (uint32_t)ru->col);
        wbi_str(b, ru->src, ru->srcn);
        wbi_u32(b, ru->refs);
    }
    /* anchors */
    {
        const WKx *x = &t->anc;
        uint32_t n = 0;
        for (i = 0; i < x->cap; i++)
            if (x->e[i].used && x->e[i].cnt) n++;
        wbi_u32(b, n);
        for (i = 0; i < x->cap; i++) {
            const WKxEnt *e = &x->e[i];
            uint32_t ids[1], k;
            if (!e->used || !e->cnt) continue;
            wbi_key(b, &e->k);
            wbi_u32(b, e->cnt);
            wbi_u32(b, e->rid);
            if (e->more) {
                const uint32_t *ov = kx_ov(x, e->more - 1);
                for (k = 0; k < ov[0]; k++) wbi_u32(b, ov[2 + k]);
            }
            (void)ids;
        }
    }
    /* the position index */
    wbi_u32(b, t->nbid);
    wbi_u32(b, t->nb);
    wbi_u32(b, t->nrid);
    wbi_u32(b, t->nfree);
    for (bid = 0; bid < t->nbid; bid++) {
        const WBlock *k = &t->blk[bid];
        uint32_t s;
        uint8_t mode = 0;
        wbi_u8(b, k->live);
        if (!k->live) continue;
        wbi_u64(b, k->lo);
        wbi_u32(b, k->n);
        for (s = 0; s < k->n; s++) {
            if (k->rlen[s] > 0xffff) mode |= 4;
            if (s == 0 ? k->rrel[0] != 0 : k->rrel[s] != k->rrel[s - 1] + k->rlen[s - 1] + 1)
                mode |= 1;
            if (s && k->rid[s] != k->rid[0] + s) mode |= 2;
        }
        wbi_u8(b, mode);
        if (!k->n) continue;
        if (mode & 4) {
            wbi_put(b, k->rlen, (size_t)k->n * 4);
        } else {
            uint16_t tmp[WB_BLK_MAX + 1];
            uint32_t s0 = 0;
            while (s0 < k->n) {
                uint32_t m = k->n - s0 < WB_BLK_MAX ? k->n - s0 : WB_BLK_MAX;
                for (s = 0; s < m; s++) tmp[s] = (uint16_t)k->rlen[s0 + s];
                wbi_put(b, tmp, (size_t)m * 2);
                s0 += m;
            }
        }
        if (mode & 1) wbi_put(b, k->rrel, (size_t)k->n * 4);
        if (mode & 2) wbi_put(b, k->rid, (size_t)k->n * 4);
        else wbi_u32(b, k->rid[0]);
    }
    wbi_put(b, t->bord, (size_t)t->nb * 4);
    wbi_put(b, t->bfree, (size_t)t->nfree * 4);
}

static void wbi_post(RtxWb *wb, WbiBuf *b) {
    uint32_t i, j, ti, nag = 0;
    size_t at;
    /* aggregates */
    at = b->n;
    wbi_u32(b, 0);
    for (i = 0; i < wb->naggs; i++) {
        WAgg *a = &wb->aggs[i];
        const WTab *t;
        uint64_t key;
        uint32_t nin = 0;
        size_t at0, at2;
        if (!a->live || a->pend || a->full || a->tab < 0 || (a->node < wb->ng && wb->g[a->node].cyc))
            continue;
        key = wbi_agg_key(wb, i);
        if (!key) continue;
        t = &wb->tabs[a->tab];
        wbi_u64(b, key);
        at0 = b->n;
        wbi_u64(b, 0); /* the record's length: an unknown key skips it */
        wbi_u32(b, t->nbid);
        at2 = b->n;
        wbi_u32(b, 0);
        for (j = 0; j < a->ninst; j++) {
            WInst *in = a->inst[j];
            uint32_t k, npv = (uint32_t)wb_popcount16(a->pmask);
            if (!wbi_inst_settled(wb, a, in)) continue;
            nin++;
            wbi_u32(b, npv);
            for (k = 0; k < npv; k++) wbi_val(b, &in->pv[k]);
            if (!a->grp) {
                wbi_acc(b, &in->a);
            } else {
                wbi_u32(b, in->a.stop);
            }
            wbi_best(b, &in->best);
            wbi_u8(b, in->lstop != NULL);
            if (in->lstop) wbi_put(b, in->lstop, (size_t)t->nbid * 4);
            wbi_u8(b, in->lbest != NULL);
            if (in->lbest)
                for (k = 0; k < t->nbid; k++) wbi_best(b, &in->lbest[k]);
            wbi_u8(b, in->lacc != NULL);
            if (in->lacc)
                for (k = 0; k < t->nbid; k++) wbi_acc(b, &in->lacc[k]);
            if (a->grp) {
                uint32_t n = 0, o;
                for (k = 0; k < in->gm.cap; k++)
                    if (in->gm.e[k].used && in->gm.e[k].rows) n++;
                wbi_u32(b, n);
                for (k = 0; k < in->gm.cap; k++) {
                    const WGEnt *e = &in->gm.e[k];
                    if (!e->used || !e->rows) continue;
                    wbi_key(b, &e->k);
                    wbi_u32(b, e->rows);
                    for (o = 0; o < a->nout; o++) {
                        wbi_acc(b, &e->acc[o]);
                        wbi_best(b, &e->best[o]);
                    }
                }
            }
        }
        if (!b->oom) memcpy(b->p + at2, &nin, 4);
        wbi_set64(b, at0, (uint64_t)(b->n - at0 - 8));
        nag++;
    }
    if (!b->oom) memcpy(b->p + at, &nag, 4);
    /* chains and key indexes, per table */
    wbi_u32(b, wb->ntab);
    for (ti = 0; ti < wb->ntab; ti++) {
        const WTab *t = &wb->tabs[ti];
        const WChain *ch = &t->ch;
        int keep = ch->on && ch->front >= t->nb && !ch->nmark && ch->ckcap >= t->nbid;
        wbi_u8(b, (uint8_t)keep);
        if (keep) {
            uint32_t sl = ch_slots(ch), bid, q;
            wbi_u32(b, ch->k);
            wbi_u32(b, ch->ncols);
            wbi_u32(b, ch->cols);
            wbi_u32(b, t->nbid);
            for (bid = 0; bid < t->nbid; bid++) {
                wbi_u8(b, ch->ckok[bid]);
                if (!ch->ckok[bid]) continue;
                for (q = 0; q < sl; q++) wbi_val(b, &ch->ck[(size_t)bid * sl + q]);
            }
        }
        wbi_u32(b, (uint32_t)t->ncols);
        for (j = 0; j < (uint32_t)t->ncols; j++) {
            const WKx *x = t->kx ? t->kx[j] : NULL;
            uint32_t k, n = 0;
            int ok = x && x->ok;
            wbi_u8(b, (uint8_t)ok);
            if (!ok) continue;
            wbi_u32(b, x->bad);
            wbi_u8(b, x->cls);
            for (k = 0; k < x->cap; k++)
                if (x->e[k].used && x->e[k].cnt) n++;
            wbi_u32(b, n);
            for (k = 0; k < x->cap; k++) {
                const WKxEnt *e = &x->e[k];
                uint32_t q;
                if (!e->used || !e->cnt) continue;
                wbi_key(b, &e->k);
                wbi_u32(b, e->cnt);
                wbi_u32(b, e->rid);
                if (e->more) {
                    const uint32_t *ov = kx_ov(x, e->more - 1);
                    for (q = 0; q < ov[0]; q++) wbi_u32(b, ov[2 + q]);
                }
            }
        }
    }
}

typedef struct {
    char path[4200];
    uint8_t *p;
    size_t n;
    uint64_t seq;
} WbiJob;

/* Writers run one at a time; a job older than the last one written to
 * its path (a level-1 index racing the settle's level-2) is dropped. */
static pthread_mutex_t g_wbi_mu = PTHREAD_MUTEX_INITIALIZER;
static _Atomic uint64_t g_wbi_seq;
#define WBI_SEQ_SLOTS 64
static uint64_t g_wbi_last_h[WBI_SEQ_SLOTS], g_wbi_last_seq[WBI_SEQ_SLOTS];

static int wbi_write_file(const char *path, const uint8_t *p, size_t n) {
    char tmp[4300];
    int fd;
    size_t off = 0;
    snprintf(tmp, sizeof tmp, "%s.%ld.tmp", path, (long)getpid());
    fd = open(tmp, O_WRONLY | O_CREAT | O_TRUNC, 0600);
    if (fd < 0) return 0;
    while (off < n) {
        ssize_t w = write(fd, p + off, n - off);
        if (w <= 0) {
            if (w < 0 && errno == EINTR) continue;
            break;
        }
        off += (size_t)w;
    }
    if (off != n || fsync(fd) != 0) {
        close(fd);
        unlink(tmp);
        return 0;
    }
    close(fd);
    if (rename(tmp, path) != 0) {
        unlink(tmp);
        return 0;
    }
    return 1;
}

static void *wbi_writer(void *arg) {
    WbiJob *j = (WbiJob *)arg;
    uint64_t h = wbi_fnv(j->path, strlen(j->path));
    uint32_t k = (uint32_t)(h % WBI_SEQ_SLOTS);
    pthread_mutex_lock(&g_wbi_mu);
    if (g_wbi_last_h[k] != h || g_wbi_last_seq[k] < j->seq) {
        if (wbi_write_file(j->path, j->p, j->n)) atomic_fetch_add(&g_wbi_written, 1);
        g_wbi_last_h[k] = h;
        g_wbi_last_seq[k] = j->seq;
    }
    pthread_mutex_unlock(&g_wbi_mu);
    free(j->p);
    free(j);
    atomic_fetch_sub(&g_wbi_writers, 1);
    return NULL;
}

/* Serialise the model for the file at open identity wb->open_id: level 1
 * the position index only, 2 with the partials. 1: handed to the writer. */
static int wbi_write(RtxWb *wb, int level) {
    WbiBuf b;
    size_t dir, i;
    uint32_t ti;
    WbiJob *j;
    uint64_t sum;
    memset(&b, 0, sizeof b);
    wbi_u64(&b, WBI_MAGIC);
    wbi_u32(&b, WBI_VER);
    wbi_u32(&b, (uint32_t)level);
    wbi_u64(&b, wb->open_id.dev);
    wbi_u64(&b, wb->open_id.ino);
    wbi_u64(&b, wb->open_id.size);
    wbi_u64(&b, (uint64_t)wb->open_id.mtime_ns);
    wbi_u64(&b, (uint64_t)wb->open_id.ctime_ns);
    wbi_u64(&b, (uint64_t)wb->open_ns);
    wbi_u64(&b, (uint64_t)RtxDoc_len(wb->doc));
    wbi_u32(&b, (uint32_t)g_wb_rows_max);
    wbi_u32(&b, (uint32_t)(RTX_WB_COLS_MAX | (WB_BLK << 8)));
    wbi_str(&b, wb->doc_real, (uint32_t)strlen(wb->doc_real));
    wbi_u32(&b, wb->ntab);
    dir = b.n;
    for (ti = 0; ti <= wb->ntab; ti++) wbi_u64(&b, 0);
    for (ti = 0; ti < wb->ntab; ti++) {
        wbi_set64(&b, dir + (size_t)ti * 8, b.n);
        wbi_table(wb, &b, ti);
    }
    wbi_set64(&b, dir + (size_t)wb->ntab * 8, level >= 2 ? b.n : 0);
    if (level >= 2) wbi_post(wb, &b);
    while (b.n % 8) wbi_u8(&b, 0);
    if (b.oom) {
        free(b.p);
        return 0;
    }
    sum = wbi_sum(b.p, b.n / 8);
    wbi_u64(&b, sum);
    if (b.oom) {
        free(b.p);
        return 0;
    }
    j = (WbiJob *)calloc(1, sizeof *j);
    if (!j) {
        free(b.p);
        return 0;
    }
    snprintf(j->path, sizeof j->path, "%s", wb->idx_path);
    j->p = b.p;
    j->n = b.n;
    j->seq = atomic_fetch_add(&g_wbi_seq, 1) + 1;
    wb->st.idx_bytes = b.n;
    atomic_fetch_add(&g_wbi_writers, 1);
    if (g_wbi_sync < 0) g_wbi_sync = getenv("RTX_WB_INDEX_SYNC") && getenv("RTX_WB_INDEX_SYNC")[0] == '1';
    if (!g_wbi_sync) {
        pthread_t th;
        pthread_attr_t at;
        pthread_attr_init(&at);
        pthread_attr_setdetachstate(&at, PTHREAD_CREATE_DETACHED);
        if (pthread_create(&th, &at, wbi_writer, j) == 0) {
            pthread_attr_destroy(&at);
            return 1;
        }
        pthread_attr_destroy(&at);
    }
    wbi_writer(j);
    (void)i;
    return 1;
}

/* The model describes the file's bytes (no edit since open or since the
 * last save of those bytes) and they are the bytes read at open. */
static int wbi_can_write(RtxWb *wb) {
    struct stat st;
    RtxSiId id;
    RtxDoc *d = wb->doc;
    if (!wb->idx_path || !wb->open_id_ok || wb->off || wb->scan || wb->pend || wb->need_rebuild)
        return 0;
    if (RtxDoc_dirty(d) || wb->doc_len != RtxDoc_len(d)) return 0;
    if ((uint64_t)RtxDoc_len(d) != wb->open_id.size) return 0;
    if (!rtx_si_trusted(&wb->open_id, wb->open_ns)) return 0;
    {
        /* external tables: their files as read, and trusted */
        uint32_t ti;
        for (ti = 0; ti < wb->ntab; ti++) {
            const WTab *t = &wb->tabs[ti];
            const WCsv *cv = t->csv;
            if (!t->ext) continue;
            /* a missing file: the section says so (a reopen checks it
             * is still missing) */
            if (cv && !cv->real && cv->done && !t->nrows) continue;
            if (!cv || !cv->real || !cv->id_ok || !cv->done || !rtx_si_trusted(&cv->id, cv->read_ns)) return 0;
            if (stat(cv->real, &st) != 0) return 0;
            rtx_si_id_of(&st, &id);
            if (id.dev != cv->id.dev || id.ino != cv->id.ino || id.size != cv->id.size ||
                id.mtime_ns != cv->id.mtime_ns || id.ctime_ns != cv->id.ctime_ns)
                return 0;
        }
    }
    if (stat(wb->doc_real, &st) != 0) return 0;
    rtx_si_id_of(&st, &id);
    return id.dev == wb->open_id.dev && id.ino == wb->open_id.ino && id.size == wb->open_id.size &&
           id.mtime_ns == wb->open_id.mtime_ns && id.ctime_ns == wb->open_id.ctime_ns;
}

/* After a read or a settle: write the index when it would say more than
 * the last one for this model. */
static void wbi_maybe_write(RtxWb *wb) {
    int level;
    if (!wb->idx_path) return;
    /* 1: positions; 2: with the partials; 3: and every chain complete
     * (chains are lazy: a settle completes them) */
    level = wb->jobs || wb->cancelled ? 1 : 2;
    if (level == 2) {
        uint32_t ti;
        int all = 1;
        for (ti = 0; ti < wb->ntab; ti++)
            if (wb->tabs[ti].ch.on && (wb->tabs[ti].ch.front < wb->tabs[ti].nb || wb->tabs[ti].ch.nmark))
                all = 0;
        if (all) level = 3;
    }
    if (wb->idx_wmgen == wb->mgen && wb->idx_wlevel >= level) return;
    if (!wbi_can_write(wb)) return;
    wb->idx_wmgen = wb->mgen;
    wb->idx_wlevel = level;
    if (wbi_write(wb, level)) wb->st.idx_writes++;
}

/* ------------------------------------------------------------ loading */

typedef struct WbiLoad {
    uint8_t *p;
    size_t n;
    int level;
    uint32_t ntab, next_tab;
    uint64_t *toff;       /* ntab + 1 section offsets (the last: post, 0 none) */
    int failed;
} WbiLoad;

static void wbi_free(WbiLoad *l) {
    if (!l) return;
    free(l->p);
    free(l);
}

static const char *const g_wbi_why[] = {"none",     "loaded",   "no file",  "bad file", "version",
                                        "checksum", "path",     "identity", "racy",     "caps",
                                        "length",   "mismatch", "disabled"};

/* Load the index for the doc (identity at open in wb->open_id). */
static WbiLoad *wbi_load(RtxWb *wb) {
    int fd;
    struct stat st;
    WbiLoad *l;
    WbiRd r;
    uint32_t n, ti;
    const char *s;
    RtxSiId id;
    int64_t built;
    double t0 = wb_now_us();
    wb->st.idx_state = 2;
    fd = open(wb->idx_path, O_RDONLY);
    if (fd < 0) return NULL;
    if (fstat(fd, &st) != 0 || st.st_size < 64 || (st.st_size % 8)) {
        close(fd);
        wb->st.idx_state = 3;
        return NULL;
    }
    l = (WbiLoad *)calloc(1, sizeof *l);
    if (!l) {
        close(fd);
        return NULL;
    }
    l->n = (size_t)st.st_size;
    l->p = (uint8_t *)malloc(l->n);
    if (!l->p) {
        close(fd);
        wbi_free(l);
        return NULL;
    }
    {
        size_t off = 0;
        while (off < l->n) {
            ssize_t k = read(fd, l->p + off, l->n - off);
            if (k <= 0) {
                if (k < 0 && errno == EINTR) continue;
                break;
            }
            off += (size_t)k;
        }
        close(fd);
        if (off != l->n) {
            wb->st.idx_state = 3;
            wbi_free(l);
            return NULL;
        }
    }
    memset(&r, 0, sizeof r);
    r.p = l->p;
    r.n = l->n - 8;
    if (wbi_g64(&r) != WBI_MAGIC) {
        wb->st.idx_state = 3;
        wbi_free(l);
        return NULL;
    }
    if (wbi_g32(&r) != WBI_VER) {
        wb->st.idx_state = 4;
        wbi_free(l);
        return NULL;
    }
    {
        uint64_t sum;
        memcpy(&sum, l->p + l->n - 8, 8);
        if (wbi_sum(l->p, l->n / 8 - 1) != sum) {
            wb->st.idx_state = 5;
            wbi_free(l);
            return NULL;
        }
    }
    l->level = (int)wbi_g32(&r);
    id.dev = wbi_g64(&r);
    id.ino = wbi_g64(&r);
    id.size = wbi_g64(&r);
    id.mtime_ns = (int64_t)wbi_g64(&r);
    id.ctime_ns = (int64_t)wbi_g64(&r);
    built = (int64_t)wbi_g64(&r);
    if (!wb->open_id_ok || id.dev != wb->open_id.dev || id.ino != wb->open_id.ino ||
        id.size != wb->open_id.size || id.mtime_ns != wb->open_id.mtime_ns ||
        id.ctime_ns != wb->open_id.ctime_ns) {
        wb->st.idx_state = 7;
        wbi_free(l);
        return NULL;
    }
    if (wbi_g64(&r) != (uint64_t)RtxDoc_len(wb->doc)) {
        wb->st.idx_state = 10;
        wbi_free(l);
        return NULL;
    }
    if (wbi_g32(&r) != (uint32_t)g_wb_rows_max || wbi_g32(&r) != (uint32_t)(RTX_WB_COLS_MAX | (WB_BLK << 8))) {
        wb->st.idx_state = 9;
        wbi_free(l);
        return NULL;
    }
    s = wbi_gstr(&r, &n);
    if (!s || n != strlen(wb->doc_real) || memcmp(s, wb->doc_real, n)) {
        wb->st.idx_state = 6;
        wbi_free(l);
        return NULL;
    }
    /* racily clean: the stamps must predate the bytes' read by the
     * granularity, or a same-tick rewrite could hide behind them */
    if (!rtx_si_trusted(&id, built)) {
        wb->st.idx_state = 8;
        wbi_free(l);
        return NULL;
    }
    l->ntab = wbi_g32(&r);
    if (r.bad || l->ntab > (1u << 24)) {
        wb->st.idx_state = 3;
        wbi_free(l);
        return NULL;
    }
    l->toff = (uint64_t *)calloc((size_t)l->ntab + 1, 8);
    if (!l->toff) {
        wbi_free(l);
        return NULL;
    }
    for (ti = 0; ti <= l->ntab; ti++) {
        l->toff[ti] = wbi_g64(&r);
        if (l->toff[ti] >= l->n) r.bad = 1;
    }
    if (r.bad) {
        free(l->toff);
        wb->st.idx_state = 3;
        wbi_free(l);
        return NULL;
    }
    wb->st.idx_load_us = (size_t)(wb_now_us() - t0);
    return l;
}

static void wbi_drop(RtxWb *wb, int why) {
    if (!wb->idx) return;
    free(wb->idx->toff);
    wbi_free(wb->idx);
    wb->idx = NULL;
    if (why) wb->st.idx_state = why;
}

/* The structural read reached a table whose header just began (s->ti,
 * its body at s->pos): install the next section when it describes this
 * table, and move the read past its body. 1: installed. */
static int wbi_section(RtxWb *wb, WScan *s, uint32_t ti, int ext);

static int wbi_body(RtxWb *wb, WScan *s) {
    return wbi_section(wb, s, s->ti, 0);
}

/* An external table (its fence just closed): its rows from the index when
 * the section's file identity is the file's now. 1: installed. */
static int wbi_ext(RtxWb *wb, WScan *s, uint32_t ti) {
    return wbi_section(wb, s, ti, 1);
}

static int wbi_section(RtxWb *wb, WScan *s, uint32_t ti, int ext) {
    WbiLoad *l = wb->idx;
    WTab *t = &wb->tabs[ti];
    WbiRd r;
    uint32_t n, i, bid;
    const char *nm;
    size_t body_lo, body_hi;
    uint32_t ncols, nrows, big, isext;
    if (!l || l->next_tab >= l->ntab) {
        if (l) wbi_drop(wb, 11);
        return 0;
    }
    memset(&r, 0, sizeof r);
    r.p = l->p;
    r.n = l->n - 8;
    r.at = (size_t)l->toff[l->next_tab++];
    nm = wbi_gstr(&r, &n);
    body_lo = (size_t)wbi_g64(&r);
    ncols = wbi_g32(&r);
    big = wbi_g8(&r);
    isext = wbi_g8(&r);
    if (isext) {
        /* the file it was read from, as it was */
        const WCsv *cv = t->csv;
        uint32_t rn;
        const char *rp = wbi_gstr(&r, &rn);
        RtxSiId id;
        int64_t rns;
        id.dev = wbi_g64(&r);
        id.ino = wbi_g64(&r);
        id.size = wbi_g64(&r);
        id.mtime_ns = (int64_t)wbi_g64(&r);
        id.ctime_ns = (int64_t)wbi_g64(&r);
        rns = (int64_t)wbi_g64(&r);
        if (ext && cv && !cv->real && rp && !rn) {
            /* missing then and now */
        } else if (!ext || !cv || !cv->real || !cv->id_ok || !rp || rn != strlen(cv->real) ||
            memcmp(rp, cv->real, rn) || id.dev != cv->id.dev || id.ino != cv->id.ino ||
            id.size != cv->id.size || id.mtime_ns != cv->id.mtime_ns || id.ctime_ns != cv->id.ctime_ns ||
            !rtx_si_trusted(&id, rns)) {
            wbi_drop(wb, 11);
            return 0;
        }
    }
    nrows = wbi_g32(&r);
    body_hi = (size_t)wbi_g64(&r);
    if (r.bad || !nm || n != t->namen || memcmp(nm, t->name, n) || (int)isext != ext ||
        body_lo != (ext ? t->body_lo : s->pos) || ncols != (uint32_t)t->ncols || body_hi < body_lo ||
        body_hi > s->len) {
        wbi_drop(wb, 11);
        return 0;
    }
    {
        const void *p = wbi_get(&r, (size_t)ncols * sizeof(WColStat));
        if (!p) goto bad;
        memcpy(t->cs, p, (size_t)ncols * sizeof(WColStat));
    }
    /* rules, in their order: graph nodes as the read would make them */
    n = wbi_g32(&r);
    for (i = 0; i < n && !r.bad; i++) {
        uint32_t col = wbi_g32(&r), sn, refs;
        const char *src = wbi_gstr(&r, &sn);
        int ri;
        refs = wbi_g32(&r);
        if (!src || col >= ncols) goto bad;
        ri = wb_rule_get(wb, (int32_t)ti, (int32_t)col, src, sn, 0);
        if (ri < 0) goto bad;
        wb->rules[ri].refs += refs;
        wb->nform_cells += refs;
        wb->nderived += refs;
        wb->graph_dirty = 1;
    }
    /* anchors */
    n = wbi_g32(&r);
    for (i = 0; i < n && !r.bad; i++) {
        WKey k;
        uint32_t cnt, q;
        wbi_gkey(&r, &k);
        cnt = wbi_g32(&r);
        for (q = 0; q < cnt && !r.bad; q++) kx_add(&t->anc, &k, wbi_g32(&r));
    }
    /* positions */
    {
        uint32_t nbid = wbi_g32(&r), nb = wbi_g32(&r), nrid = wbi_g32(&r), nfree = wbi_g32(&r);
        uint32_t total = 0;
        if (r.bad || nb > nbid || nfree > nbid) goto bad;
        if (big) {
            t->big = 1;
            goto done;
        }
        if (nbid && !wb_hgrow((void **)&t->blk, &t->bidcap, nbid, sizeof(WBlock))) goto bad;
        t->nbid = nbid;
        if (!tb_rid_room(t, nrid ? nrid : 1)) goto bad;
        for (i = 0; i < nrid; i++) t->rloc[i].bid = WN32;
        t->nrid = nrid;
        for (bid = 0; bid < nbid; bid++) {
            WBlock *k = &t->blk[bid];
            uint8_t live = wbi_g8(&r), mode;
            uint32_t cnt, sl;
            memset(k, 0, sizeof *k);
            k->pos = WN32;
            if (!live) continue;
            k->live = 1;
            k->lo = (size_t)wbi_g64(&r);
            cnt = wbi_g32(&r);
            mode = wbi_g8(&r);
            if (r.bad || cnt > (1u << 24)) goto bad;
            if (!blk_reserve(k, cnt > 16 ? cnt : 16)) goto bad;
            k->n = cnt;
            if (!cnt) continue;
            if (mode & 4) {
                const void *p = wbi_get(&r, (size_t)cnt * 4);
                if (!p) goto bad;
                memcpy(k->rlen, p, (size_t)cnt * 4);
            } else {
                const uint8_t *p = (const uint8_t *)wbi_get(&r, (size_t)cnt * 2);
                if (!p) goto bad;
                for (sl = 0; sl < cnt; sl++) {
                    uint16_t v;
                    memcpy(&v, p + (size_t)sl * 2, 2);
                    k->rlen[sl] = v;
                }
            }
            if (mode & 1) {
                const void *p = wbi_get(&r, (size_t)cnt * 4);
                if (!p) goto bad;
                memcpy(k->rrel, p, (size_t)cnt * 4);
            } else {
                uint32_t at = 0;
                for (sl = 0; sl < cnt; sl++) {
                    k->rrel[sl] = at;
                    at += k->rlen[sl] + 1;
                }
            }
            if (mode & 2) {
                const void *p = wbi_get(&r, (size_t)cnt * 4);
                if (!p) goto bad;
                memcpy(k->rid, p, (size_t)cnt * 4);
            } else {
                uint32_t r0 = wbi_g32(&r);
                for (sl = 0; sl < cnt; sl++) k->rid[sl] = r0 + sl;
            }
            for (sl = 0; sl < cnt; sl++) {
                uint32_t rid = k->rid[sl];
                if (rid >= nrid) goto bad;
                t->rloc[rid].bid = bid;
                t->rloc[rid].slot = sl;
            }
        }
        if (!tb_bord_room(t, nb ? nb : 1)) goto bad;
        {
            const void *p = wbi_get(&r, (size_t)nb * 4);
            if (!p && nb) goto bad;
            if (nb) memcpy(t->bord, p, (size_t)nb * 4);
        }
        t->nb = nb;
        for (i = 0; i < nb; i++) {
            if (t->bord[i] >= nbid || !t->blk[t->bord[i]].live) goto bad;
            total += t->blk[t->bord[i]].n;
        }
        if (total != nrows) goto bad;
        tb_reindex(t, 0);
        if (nfree) {
            if (!wb_hgrow((void **)&t->bfree, &t->freecap, nfree, sizeof(uint32_t))) goto bad;
            {
                const void *p = wbi_get(&r, (size_t)nfree * 4);
                if (!p) goto bad;
                memcpy(t->bfree, p, (size_t)nfree * 4);
            }
            t->nfree = nfree;
        }
        if (r.bad) goto bad;
        if (nrows && !ext) {
            /* the last row ends where the section says the body does */
            size_t lo = tb_row_lo(t, nrows - 1);
            uint32_t len = tb_row_len(t, nrows - 1);
            if (lo + len != body_hi && lo + len + 1 != body_hi) goto bad;
            s->prev_bol = lo;
        }
        if (nrows && ext) {
            /* the rows are in the file */
            size_t lo = tb_row_lo(t, nrows - 1);
            if (lo + tb_row_len(t, nrows - 1) > RtxDoc_len(t->src)) goto bad;
        }
    }
done:
    s->rows += nrows;
    wb->st.idx_rows += nrows;
    if (ext) {
        t->csv->rows = nrows;
        wb_ext_end(wb, ti);
        return 1;
    }
    s->pos = body_hi;
    s->installed = 1;
    return 1;
bad:
    /* a section that does not parse: this table is half installed, so
     * the read starts over without the index */
    wbi_drop(wb, 11);
    wb->idx_bad = 1;
    s->pos = s->len;
    return 1;
}

/* Node v reads another workbook, directly or through its inputs (memo:
 * 0 unknown, 1 no, 2 yes, 3 on the walk). */
static int wbi_reads_import(RtxWb *wb, uint32_t v, uint8_t *memo, int depth) {
    const WGNode *g = &wb->g[v];
    uint32_t k;
    if (memo[v] == 1 || memo[v] == 3) return 0;
    if (memo[v] == 2) return 1;
    if (g->kind == GN_IMP) {
        memo[v] = 2;
        return 1;
    }
    if (depth > 4096) return 1; /* too deep to tell: do not trust it */
    memo[v] = 3;
    for (k = 0; k < g->ndeps; k++)
        if (wbi_reads_import(wb, g->deps[k], memo, depth + 1)) {
            memo[v] = 2;
            return 1;
        }
    memo[v] = 1;
    return 0;
}

/* After the bind (wb_build_finish): the post section's partials into the
 * instances whose keys match, chains and key indexes. An aggregate that
 * reads another workbook (a `uses` import) is not restored: that file may
 * have moved since. */
static void wbi_post_load(RtxWb *wb) {
    WbiLoad *l = wb->idx;
    WbiRd r;
    uint32_t nag, i, j, ti;
    uint64_t *keys = NULL;
    uint8_t *memo = NULL;
    if (!l || !l->toff[l->ntab] || l->level < 2) return;
    if (l->next_tab != l->ntab || l->ntab != wb->ntab) return;
    memset(&r, 0, sizeof r);
    r.p = l->p;
    r.n = l->n - 8;
    r.at = (size_t)l->toff[l->ntab];
    /* this model's aggregates by key */
    keys = (uint64_t *)calloc(wb->naggs + 1, sizeof(uint64_t));
    if (!keys) return;
    for (i = 0; i < wb->naggs; i++) keys[i] = wbi_agg_key(wb, i);
    if (wb->nimps) {
        memo = (uint8_t *)calloc(wb->ng + 1, 1);
        for (i = 0; i < wb->naggs; i++)
            if (!memo || (wb->aggs[i].node < wb->ng && wbi_reads_import(wb, wb->aggs[i].node, memo, 0)))
                keys[i] = 0;
        free(memo);
    }
    nag = wbi_g32(&r);
    for (i = 0; i < nag && !r.bad; i++) {
        uint64_t key = wbi_g64(&r), rlen = wbi_g64(&r);
        size_t rend = r.at + (size_t)rlen;
        uint32_t nbid, nin, q, hit = WN32;
        WAgg *a = NULL;
        const WTab *t;
        int ok = 1;
        if (r.bad || rlen > r.n - r.at) break;
        nbid = wbi_g32(&r);
        nin = wbi_g32(&r);
        for (q = 0; q < wb->naggs; q++)
            if (keys[q] == key) {
                hit = q;
                break;
            }
        if (hit == WN32 || wb->aggs[hit].tab < 0 || nbid != wb->tabs[wb->aggs[hit].tab].nbid) {
            /* an aggregate this model lacks (or over another shape): skip */
            r.at = rend;
            continue;
        }
        a = &wb->aggs[hit];
        t = &wb->tabs[a->tab];
        (void)t;
        for (j = 0; j < nin && !r.bad && ok; j++) {
            uint32_t npv = wbi_g32(&r), k;
            WVal pv[RTX_WB_COLS_MAX];
            WInst *in;
            if (npv != wb_popcount16(a->pmask) || npv > RTX_WB_COLS_MAX) {
                ok = 0;
                break;
            }
            for (k = 0; k < npv; k++) pv[k] = wbi_gval(&r, wb, NULL);
            if (!a->pmask) {
                in = a->ninst ? a->inst[0] : NULL;
            } else {
                in = inst_find(a, pv, npv);
                if (!in) in = inst_new(wb, a, pv, npv);
            }
            if (!in || !inst_fit(wb, a, in)) {
                ok = 0;
                break;
            }
            if (!a->grp) {
                if (!wbi_gacc(&r, &in->a)) {
                    ok = 0;
                    break;
                }
            } else {
                acc_reset(&in->a);
                in->a.stop = wbi_g32(&r);
            }
            wbi_gbest(&r, &in->best, in->ar);
            in->nstop = 0;
            if (wbi_g8(&r)) {
                const void *p = wbi_get(&r, (size_t)nbid * 4);
                uint32_t *ls = inst_lstop(wb, a, in);
                if (!p || !ls) {
                    ok = 0;
                    break;
                }
                memcpy(ls, p, (size_t)nbid * 4);
                for (k = 0; k < nbid; k++)
                    if (ls[k]) in->nstop++;
            }
            if (wbi_g8(&r)) {
                if (!in->lbest) {
                    ok = 0;
                    break;
                }
                for (k = 0; k < nbid; k++) wbi_gbest(&r, &in->lbest[k], in->ar);
            }
            if (wbi_g8(&r)) {
                if (!in->lacc) {
                    ok = 0;
                    break;
                }
                for (k = 0; k < nbid && ok; k++)
                    if (!wbi_gacc(&r, &in->lacc[k])) ok = 0;
                if (!ok) break;
            }
            if (a->grp) {
                uint32_t ne = wbi_g32(&r), e, o;
                memset(&in->gm, 0, sizeof in->gm);
                for (e = 0; e < ne && !r.bad && ok; e++) {
                    WKey kk;
                    WGEnt *ge;
                    uint32_t rows;
                    wbi_gkey(&r, &kk);
                    rows = wbi_g32(&r);
                    ge = wg_get(wb, a, in, &kk, 1);
                    if (!ge) {
                        ok = 0;
                        break;
                    }
                    ge->rows = rows;
                    if (rows) in->gm.live++;
                    for (o = 0; o < a->nout && ok; o++) {
                        if (!wbi_gacc(&r, &ge->acc[o])) ok = 0;
                        wbi_gbest(&r, &ge->best[o], in->ar);
                        ge->bst[o] = 0;
                    }
                }
                in->gver++;
            }
            if (!ok) break;
            in->building = 0;
            in->full = 0;
            in->anyresc = 0;
            in->gstale = 0;
            /* the per-block bests of groups are not kept in the file: a key
             * losing its extreme walks (until the next build) */
            if (a->grp) in->gbm_off = 1;
            in->bestok = 1;
            in->segp = 0;
            in->pend = 1;
            in->has = 0;
            in->v = wv_null();
            wb->st.idx_insts++;
        }
        if (!ok || r.bad || r.at != rend) {
            /* an instance half restored: the aggregate rebuilds */
            for (j = 0; j < a->ninst; j++)
                if (a->inst[j]) a->inst[j]->full = 1;
            a->full = 1;
            r.bad = 0;
            r.at = rend;
            continue;
        }
        {
            /* every instance restored: the aggregate publishes, no build */
            int all = 1;
            for (j = 0; j < a->ninst; j++)
                if (a->inst[j] && a->inst[j]->live && a->inst[j]->full) all = 0;
            if (all) {
                /* queued by the bind as a wholesale change: publish instead */
                a->full = 0;
                a->keep = 1;
                if (a->node < wb->ng) wb->g[a->node].chg = 0;
            }
        }
    }
    free(keys);
    if (i < nag || r.bad) return;
    /* chains and key indexes may hold values read from another workbook */
    if (wb->nimps) return;
    /* chains and key indexes */
    if (wbi_g32(&r) != wb->ntab) return;
    for (ti = 0; ti < wb->ntab && !r.bad; ti++) {
        WTab *t = &wb->tabs[ti];
        WChain *ch = &t->ch;
        uint32_t nc;
        if (wbi_g8(&r)) {
            uint32_t k = wbi_g32(&r), ncols = wbi_g32(&r), cols = wbi_g32(&r), nbid = wbi_g32(&r);
            uint32_t bid, q, sl;
            int ok = ch->on && ch->k == k && ch->ncols == ncols && ch->cols == cols && nbid == t->nbid;
            if (!ok) return;
            if (!ch_fit(t)) return;
            sl = ch_slots(ch);
            for (bid = 0; bid < nbid && !r.bad; bid++) {
                ch->ckok[bid] = wbi_g8(&r);
                if (!ch->ckok[bid]) continue;
                for (q = 0; q < sl; q++) ch->ck[(size_t)bid * sl + q] = wbi_gval(&r, wb, NULL);
            }
            if (r.bad) return;
            ch->front = t->nb;
            ch->nmark = 0;
            wb->st.idx_chains++;
        }
        nc = wbi_g32(&r);
        if (nc != (uint32_t)t->ncols) return;
        for (j = 0; j < nc && !r.bad; j++) {
            WKx *x;
            uint32_t bad, ne, e;
            uint8_t cls;
            if (!wbi_g8(&r)) continue;
            bad = wbi_g32(&r);
            cls = wbi_g8(&r);
            ne = wbi_g32(&r);
            x = t->kx ? t->kx[j] : NULL;
            if (!x) {
                /* not wanted by this model: skip the entries */
                for (e = 0; e < ne && !r.bad; e++) {
                    WKey kk;
                    uint32_t cnt;
                    wbi_gkey(&r, &kk);
                    cnt = wbi_g32(&r);
                    wbi_get(&r, (size_t)cnt * 4);
                }
                continue;
            }
            kx_clear(x);
            x->tab = (int32_t)ti;
            x->col = (int32_t)j;
            if (ne <= r.n - r.at) kx_reserve(x, ne);
            for (e = 0; e < ne && !r.bad; e++) {
                WKey kk;
                uint32_t cnt, q;
                wbi_gkey(&r, &kk);
                cnt = wbi_g32(&r);
                for (q = 0; q < cnt && !r.bad; q++) kx_add(x, &kk, wbi_g32(&r));
            }
            if (r.bad) {
                kx_clear(x);
                return;
            }
            x->bad = bad;
            x->cls = cls;
            x->ok = 1;
            wb->st.idx_kx++;
        }
    }
}

/* The private document of a source file (opened now when missing). */
static RtxDoc *wb_src_doc(RtxWb *wb, const char *real, RtxSiId *id, int *id_ok, int64_t *read_ns) {
    uint32_t i;
    WPdoc *p;
    RtxDoc *d = NULL;
    struct stat st;
    for (i = 0; i < wb->npdocs; i++)
        if (!wb->pdocs[i].stale && !strcmp(wb->pdocs[i].real, real)) {
            p = &wb->pdocs[i];
            *id = p->id;
            *id_ok = p->id_ok;
            *read_ns = p->read_ns;
            return p->d;
        }
    if (!wb_hgrow((void **)&wb->pdocs, &wb->pdoccap, wb->npdocs + 1, sizeof(WPdoc))) return NULL;
    p = &wb->pdocs[wb->npdocs];
    memset(p, 0, sizeof *p);
    p->real = strdup(real);
    if (!p->real) return NULL;
    if (stat(real, &st) == 0) {
        rtx_si_id_of(&st, &p->id);
        p->id_ok = 1;
    }
    p->read_ns = wbi_now_ns();
    {
        @errhandler(CCError e) {
            (void)e;
            free(d);
            d = NULL;
        }
        d = (RtxDoc *)calloc(1, sizeof(RtxDoc));
        if (d) d->from_path(cc_slice_cstr(real)) !>;
    }
    if (!d) {
        free(p->real);
        return NULL;
    }
    if (p->id_ok && (uint64_t)RtxDoc_len(d) != p->id.size) p->id_ok = 0;
    p->d = d;
    wb->npdocs++;
    *id = p->id;
    *id_ok = p->id_ok;
    *read_ns = p->read_ns;
    return d;
}

/* The per-column arrays of a new table (as wb_tab_begin's). */
static int wb_tab_cols(RtxWb *wb, WTab *t, int32_t ncols) {
    t->ncols = ncols;
    t->cname = (const char **)wb_ma(wb, (size_t)(ncols + 1) * sizeof(char *));
    t->cnamen = (uint32_t *)wb_ma(wb, (size_t)(ncols + 1) * sizeof(uint32_t));
    t->cclash = (uint8_t *)wb_ma(wb, (size_t)(ncols + 1));
    t->hlo = (size_t *)wb_ma(wb, (size_t)(ncols + 1) * sizeof(size_t));
    t->hhi = (size_t *)wb_ma(wb, (size_t)(ncols + 1) * sizeof(size_t));
    t->cs = (WColStat *)wb_ma(wb, (size_t)(ncols + 1) * sizeof(WColStat));
    t->ct = (uint8_t *)wb_ma(wb, (size_t)(ncols + 1));
    t->csc = (uint8_t *)wb_ma(wb, (size_t)(ncols + 1));
    t->cnode = (uint32_t *)wb_ma(wb, (size_t)(ncols + 1) * sizeof(uint32_t));
    t->kx = (WKx **)calloc((size_t)ncols + 1, sizeof(WKx *));
    return t->cname && t->cnamen && t->cclash && t->hlo && t->hhi && t->cs && t->ct && t->csc &&
           t->cnode && t->kx;
}

static int wbi_ext(RtxWb *wb, WScan *s, uint32_t ti);

/* The fence closed: the table over its file; its read queued (or its
 * index installed). 1 unless out of memory. */
static int wb_ext_begin(RtxWb *wb, WScan *s, size_t fbol, size_t fend) {
    WExtSpec *x = s->xs;
    char path[4096], real[4096];
    WTab *t;
    WCsv *cv;
    RtxDoc *d = NULL;
    RtxSiId id;
    int id_ok = 0, nf = 0;
    int64_t rns = 0;
    uint32_t hlo[256], hhi[256], ti;
    const char *hrec = NULL;
    size_t hn = 0, hnext = 0;
    int32_t c, ncols;
    WCsvRd rd;
    memset(&id, 0, sizeof id);
    memset(&rd, 0, sizeof rd);
    if (!x->name[0]) return 1;
    if (x->source[0] == '/' || !wb->doc_real) {
        snprintf(path, sizeof path, "%s", x->source);
    } else {
        const char *sl = strrchr(wb->doc_real, '/');
        size_t dn = sl ? (size_t)(sl - wb->doc_real) : 0;
        snprintf(path, sizeof path, "%.*s/%s", (int)dn, wb->doc_real, x->source);
    }
    if (realpath(path, real)) d = wb_src_doc(wb, real, &id, &id_ok, &rns);
    if (!wb_grow(wb, (void **)&wb->tabs, &wb->tabcap, wb->ntab + 1, sizeof(WTab))) return 0;
    ti = wb->ntab;
    t = &wb->tabs[ti];
    memset(t, 0, sizeof *t);
    t->name = wb_strdup(wb, x->name, strlen(x->name));
    t->namen = (uint32_t)strlen(x->name);
    t->sheet = s->sheet;
    t->lo = fbol;
    t->hi = fend;
    t->body_lo = fend;
    t->cap_lo = x->name_lo;
    t->cap_hi = x->name_hi;
    t->ext = 1;
    t->src = d;
    cv = (WCsv *)wb_ma(wb, sizeof(WCsv));
    if (!cv || !t->name) return 0;
    t->csv = cv;
    cv->delim = x->delim ? x->delim : ',';
    cv->quote = x->quote ? x->quote : '"';
    cv->header = x->header;
    cv->id = id;
    cv->id_ok = id_ok;
    cv->read_ns = rns;
    cv->real = d ? strdup(real) : NULL;
    /* the header record */
    if (d) {
        rd.d = d;
        rd.len = RtxDoc_len(d);
        if (cv->header && wb_csv_rec(&rd, 0, cv->quote, &hrec, &hn, &hnext))
            nf = wb_csv_fields(hrec, hn, cv->delim, cv->quote, hlo, hhi, 256);
        if (nf > 256) nf = 256;
        cv->pos = cv->header ? hnext : 0;
        if (!cv->header && wb_csv_rec(&rd, 0, cv->quote, &hrec, &hn, &hnext)) {
            uint32_t tl[256], th[256];
            nf = wb_csv_fields(hrec, hn, cv->delim, cv->quote, tl, th, 256);
            if (nf > 256) nf = 256;
            hrec = NULL;
        }
    }
    ncols = x->ncol ? x->ncol : (nf < RTX_WB_COLS_MAX ? nf : RTX_WB_COLS_MAX);
    if (ncols < 1) ncols = 1;
    if (!wb_tab_cols(wb, t, ncols)) {
        free(rd.buf);
        return 0;
    }
    for (c = 0; c < ncols; c++) {
        char nm[160];
        int32_t f = -1;
        t->hlo[c] = t->hhi[c] = WNONE;
        cv->cerr[c] = wv_null();
        if (x->ncol) {
            snprintf(nm, sizeof nm, "%s", x->cname[c]);
            cv->dtype[c] = x->ctype[c];
            cv->dsc[c] = x->csc[c];
            if (x->bpos[c] > 0) {
                f = x->bpos[c] - 1 < nf || !cv->header ? x->bpos[c] - 1 : -1;
            } else {
                const char *want = x->bind[c][0] ? x->bind[c] : x->cname[c];
                size_t wn = strlen(want);
                int k;
                for (k = 0; hrec && k < nf; k++) {
                    size_t a = hlo[k], b = hhi[k];
                    uint32_t tn;
                    const char *tx;
                    wb_trim(hrec, &a, &b);
                    tx = wb_csv_text(wb->sa, hrec, a, b, cv->quote, &tn);
                    if (tn == wn && !memcmp(tx, want, wn)) {
                        f = k;
                        break;
                    }
                }
                if (f < 0 && !cv->header && !x->bind[c][0]) f = c;
                if (f < 0)
                    cv->cerr[c] = wv_err_a(wb->ma, WE_SCHEMA, "%s: %s has no column %s", want,
                                           x->source, want);
            }
        } else if (hrec && c < nf) {
            size_t a = hlo[c], b = hhi[c];
            uint32_t tn;
            const char *tx;
            wb_trim(hrec, &a, &b);
            tx = wb_csv_text(wb->sa, hrec, a, b, cv->quote, &tn);
            snprintf(nm, sizeof nm, "%.*s", (int)(tn < 150 ? tn : 150), tx);
            f = c;
        } else {
            snprintf(nm, sizeof nm, "c%d", (int)c + 1);
            f = c;
        }
        cv->cmap[c] = f;
        t->cname[c] = wb_strdup(wb, nm, strlen(nm));
        t->cnamen[c] = (uint32_t)strlen(nm);
    }
    free(rd.buf);
    for (c = 0; c < ncols; c++) {
        int32_t k;
        for (k = c + 1; k < ncols; k++)
            if (t->cnamen[c] == t->cnamen[k] && wb_ieq(t->cname[c], t->cname[k], t->cnamen[c]))
                t->cclash[c] = t->cclash[k] = 1;
    }
    wb->ntab++;
    for (c = 0; c < ncols; c++) {
        uint32_t node = wb_gnode_new(wb, GN_COL, ti);
        if (node == WN32) return 0;
        wb->g[node].tab = (int32_t)ti;
        wb->g[node].col = c;
        wb->tabs[ti].cnode[c] = node;
    }
    t = &wb->tabs[ti];
    if (!d) {
        char msg[1200];
        snprintf(msg, sizeof msg, "%s: cannot read %s", x->name, x->source);
        for (c = 0; c < ncols; c++) cv->cerr[c] = wv_err_a(wb->ma, WE_REF, "%s", msg);
        cv->ncols_err = cv->cerr[0];
        cv->done = 1;
        /* the index's section for it (missing then too, or the index goes) */
        if (wb->idx) (void)wbi_ext(wb, s, ti);
        return 1;
    }
    /* the persisted index: the table's rows without reading the file */
    if (wb->idx && wbi_ext(wb, s, ti)) return 1;
    if (!wb_hgrow((void **)&s->xq, &s->xqcap, s->nxq + 1, sizeof(uint32_t))) return 0;
    s->xq[s->nxq++] = ti;
    return 1;
}

/* Table ti's read done: types (declared ones win). */
static void wb_ext_end(RtxWb *wb, uint32_t ti) {
    WTab *t = &wb->tabs[ti];
    WCsv *cv = t->csv;
    int32_t c;
    for (c = 0; c < t->ncols; c++) {
        wb_col_type(&t->cs[c], &t->ct[c], &t->csc[c]);
        if (cv->dtype[c]) {
            t->ct[c] = cv->dtype[c];
            t->csc[c] = cv->dsc[c];
        }
    }
    cv->done = 1;
}

/* The queued files' records, until the deadline. 1 done, 0 more, -1 fail. */
static int wb_ext_step(RtxWb *wb, WScan *s, double deadline_us) {
    while (s->xi < s->nxq) {
        uint32_t ti = s->xq[s->xi];
        WTab *t = &wb->tabs[ti];
        WCsv *cv = t->csv;
        uint32_t k = 0;
        WCsvRd *rd;
        if (!s->xrdp) {
            s->xrdp = (struct WCsvRdS *)calloc(1, sizeof(WCsvRd));
            if (!s->xrdp) return -1;
        }
        rd = (WCsvRd *)s->xrdp;
        if (!rd->d || rd->d != t->src) {
            free(rd->buf);
            memset(rd, 0, sizeof *rd);
            rd->d = t->src;
            rd->len = RtxDoc_len(t->src);
        }
        if (deadline_us <= 0 && s->ext_async && rd->len - cv->pos >= g_wb_defer) return 0;
        for (;;) {
            const char *rec;
            size_t n, next;
            uint32_t lo[RTX_WB_COLS_MAX * 4], hi[RTX_WB_COLS_MAX * 4];
            int nf, c;
            if (!wb_csv_rec(rd, cv->pos, cv->quote, &rec, &n, &next)) break;
            if (n == 0 || (n == 1 && rec[0] == '\r')) {
                /* a blank line ends nothing: skipped (no row) */
                cv->pos = next;
                continue;
            }
            if (t->big) {
                cv->pos = next;
                continue;
            }
            if ((int64_t)t->nrows + 1 > (int64_t)g_wb_rows_max) {
                t->big = 1;
                cv->pos = next;
                continue;
            }
            if (!tb_append_row(t, cv->pos, (uint32_t)n)) return -1;
            nf = wb_csv_fields(rec, n, cv->delim, cv->quote, lo, hi, RTX_WB_COLS_MAX * 4);
            for (c = 0; c < t->ncols; c++) {
                int32_t f = cv->cmap[c];
                size_t a, b;
                uint32_t tn;
                const char *tx;
                int sc = 0, lk;
                if (f < 0 || f >= nf || f >= RTX_WB_COLS_MAX * 4) continue;
                a = lo[f];
                b = hi[f];
                wb_trim(rec, &a, &b);
                tx = wb_csv_text(wb->sa, rec, a, b, cv->quote, &tn);
                lk = wb_lit_kind(tx, tn, &sc);
                wb_cs_add(&t->cs[c], lk, sc, 1);
            }
            cv->pos = next;
            cv->rows++;
            s->rows++;
            if ((++k & 1023) == 0) {
                wb->sa.reset();
                if (wb_deadline_hit(deadline_us)) return 0;
            }
        }
        wb_ext_end(wb, ti);
        s->xi++;
    }
    return 1;
}

/* Lines until the end or the deadline. 1: done, 0: more to do, -1: fail. */
static int wb_scan_run(RtxWb *wb, WScan *s, double deadline_us) {
    const char *ln;
    size_t n, next;
    uint32_t lines = 0;
    s->len = RtxDoc_len(wb->doc);
    for (;;) {
        size_t bol, le;
        char ch = 0;
        size_t run = 0, ilo = 0, ihi = 0;
        int kind;
        size_t n2;
        if (s->intab) {
            /* inside a table: a pre-read segment of rows in one step */
            int b = wbp_bulk(wb, s, deadline_us);
            if (b < 0) return -1;
            if (b == 2) return 0; /* the pre-read is behind: the next slice */
            if (b > 0) {
                if (wb_deadline_hit(deadline_us)) return 0;
                continue;
            }
        }
        if (!wb_scan_line(wb, s, &ln, &n, &next)) break;
        bol = s->pos;
        le = bol + n;
        n2 = n;
        if (n2 && ln[n2 - 1] == '\r') n2--;
        if ((++lines & 1023) == 0 && wb_deadline_hit(deadline_us)) return 0;
        if (s->intab) {
            if (!wb_blank(ln, n2) && rtx_md_line_pipe(ln, n2)) {
                if (s->intab == 1 && !wb_tab_row(wb, s, ln, n, bol)) return -1;
                s->prev_bol = bol;
                s->pos = next;
                continue;
            }
            if (s->intab == 1) wb_tab_end(wb, s, bol);
            else s->intab = 0;
        }
        if (s->fence) {
            kind = wb_line_kind(ln, n2, &ch, &run, &ilo, &ihi);
            if (kind == WL_FENCE && ch == s->fch && run >= s->frun && ilo == ihi) {
                if (s->fkind == FK_TABLE && s->xs && s->xs->source[0]) {
                    /* an external table: its file is read after the lines */
                    if (!wb_ext_begin(wb, s, s->fbol, next)) return -1;
                }
                if (s->fkind == FK_OTHER) {
                    if (!wb_blk_add_ext(wb, s->fbol, s->fnext, s->fbol, s->fnext)) return -1;
                    if (!wb_blk_add_ext(wb, bol, next, bol, next)) return -1;
                } else if (!wb_blk_add_ext(wb, s->fbol, next, s->fbol, next)) {
                    return -1;
                }
                s->fence = 0;
            } else if (s->fkind == FK_PARAMS || s->fkind == FK_CALC) {
                if (!wb_def_line(wb, ln, bol, bol + n2, s->fkind == FK_PARAMS ? SC_PARAM : s->sheet))
                    return -1;
            } else if (s->fkind == FK_USES) {
                if (!wb_use_line(wb, ln, bol, bol + n2)) return -1;
            } else if (s->fkind == FK_TABLE && s->xs) {
                wb_ext_line(s->xs, ln, n2);
            }
            s->prev_bol = bol;
            s->pos = next;
            continue;
        }
        kind = wb_line_kind(ln, n2, &ch, &run, &ilo, &ihi);
        if (kind != WL_NONE && s->cap) {
            if (!wb_blk_add_ext(wb, s->cap_bol, bol, s->cap_bol, bol)) return -1;
            s->cap = 0;
        }
        if (kind == WL_FENCE) {
            size_t w = ilo;
            while (w < ihi && !wb_ws(ln[w])) w++;
            s->fence = 1;
            s->fch = ch;
            s->frun = run;
            s->fbol = bol;
            s->fnext = next;
            s->fkind = FK_OTHER;
            if (w - ilo == 6 && !memcmp(ln + ilo, "params", 6)) s->fkind = FK_PARAMS;
            else if (w - ilo == 4 && !memcmp(ln + ilo, "calc", 4)) s->fkind = FK_CALC;
            else if (w - ilo == 5 && !memcmp(ln + ilo, "table", 5)) {
                /* ```table Name: its spec follows */
                size_t a = w, b = ihi;
                s->fkind = FK_TABLE;
                if (!s->xs) s->xs = (WExtSpec *)malloc(sizeof(WExtSpec));
                if (s->xs) {
                    memset(s->xs, 0, sizeof *s->xs);
                    s->xs->header = 1;
                    while (a < b && wb_ws(ln[a])) a++;
                    wb_trim(ln, &a, &b);
                    s->xs->name_lo = bol + a;
                    s->xs->name_hi = bol + b;
                    if (b - a >= 2 && ln[a] == '`' && ln[b - 1] == '`') {
                        a++;
                        b--;
                    }
                    snprintf(s->xs->name, sizeof s->xs->name, "%.*s", (int)(b - a), ln + a);
                }
            }
            else if (w - ilo == 4 && !memcmp(ln + ilo, "uses", 4)) s->fkind = FK_USES;
            s->prev_bol = bol;
            s->pos = next;
            continue;
        }
        if (kind == WL_H1) {
            size_t a = ilo, b = ihi;
            wb_trim(ln, &a, &b);
            {
                size_t k = b;
                while (k > a && ln[k - 1] == '#') k--;
                if (k < b && (k == a || wb_ws(ln[k - 1]))) {
                    b = k;
                    wb_trim(ln, &a, &b);
                }
            }
            {
                const char *nm;
                size_t nmn;
                wb_name_copy(ln, a, b, &nm, &nmn);
                s->sheet = wb_sheet_add(wb, nm, nmn);
            }
            if (!wb_blk_add_ext(wb, bol, next, bol, next)) return -1;
            s->prev_bol = bol;
            s->pos = next;
            continue;
        }
        if (kind == WL_CAPTION) {
            size_t a = ilo, b = ihi;
            wb_trim(ln, &a, &b);
            if (a < b) {
                s->cap = 1;
                s->cap_bol = bol;
                s->cap_lo = bol + a;
                s->cap_hi = bol + b;
                if (!wb_scan_cap_keep(s, ln, a, b)) return -1;
            } else if (!wb_blk_add_ext(wb, bol, next, bol, next)) {
                return -1;
            }
            s->prev_bol = bol;
            s->pos = next;
            continue;
        }
        if (rtx_md_line_pipe(ln, n2) && next > bol + n) {
            /* a table: this header, a separator next, cells matching */
            const char *sep;
            size_t sn;
            char *hdr = NULL;
            if (n2 < WB_LINE_MAX) {
                hdr = (char *)cc_arena_alloc(wb->sa, n2 + 1, 1);
                if (hdr) memcpy(hdr, ln, n2);
            }
            if (hdr && wb_scan_peek(wb, s, next, &sep, &sn)) {
                size_t sn2 = sn && sep[sn - 1] == '\r' ? sn - 1 : sn;
                size_t sepc = rtx_md_row_split(sep, sn2, NULL, 0);
                if (rtx_md_line_is_sep(sep, sn2) &&
                    rtx_md_line_cells(hdr, n2) == rtx_md_line_cells(sep, sn2) && sepc > 0) {
                    size_t sep_next = next + sn + (next + sn < s->len ? 1 : 0);
                    if (s->cap) {
                        if (!wb_tab_begin(wb, s, hdr, n2, bol, sep_next, sepc)) return -1;
                        s->intab = 1;
                        s->cap = 0;
                    } else {
                        s->intab = 2;
                    }
                    s->prev_bol = next;
                    s->pos = sep_next;
                    /* a persisted index: the body installed, the read jumps past it */
                    if (s->intab == 1 && wb->idx) (void)wbi_body(wb, s);
                    continue;
                }
            }
        }
        if (!wb_blank(ln, n2) && s->cap) {
            if (!wb_blk_add_ext(wb, s->cap_bol, bol, s->cap_bol, bol)) return -1;
            s->cap = 0;
        }
        s->prev_bol = bol;
        s->pos = next;
    }
    if (!s->lines_done) {
        if (s->intab == 1) wb_tab_end(wb, s, s->len);
        s->intab = 0;
        if (s->cap && !wb_blk_add_ext(wb, s->cap_bol, s->len, s->cap_bol, s->len)) return -1;
        if (s->fence && !wb_blk_add_ext(wb, s->fbol, s->len, s->fbol, s->len)) return -1;
        s->lines_done = 1;
    }
    {
        /* then the external tables' files */
        int r = wb_ext_step(wb, s, deadline_us);
        if (r <= 0) return r;
    }
    s->done = 1;
    return 1;
}


/* ---- the model: reset, names, finish */

static void wb_aggs_free(RtxWb *wb) {
    uint32_t i, j;
    for (i = 0; i < wb->naggs; i++) {
        WAgg *a = &wb->aggs[i];
        for (j = 0; j < a->ninst; j++) inst_free(a->inst[j]);
        free(a->inst);
        a->inst = NULL;
        a->ninst = a->instcap = 0;
    }
}

static void wb_rkx_free(RtxWb *wb);
static void wb_uses_free(RtxWb *wb);

static void wb_reset_model(RtxWb *wb) {
    uint32_t i;
    wb_rkx_free(wb);
    wb_uses_free(wb);
    wb_aggs_free(wb);
    for (i = 0; i < wb->ntab; i++)
        if (wb->tabs[i].csv) free(wb->tabs[i].csv->real);
    {
        /* source files that changed: their documents go with the model */
        uint32_t k;
        for (k = 0; k < wb->npdocs; k++) {
            WPdoc *p = &wb->pdocs[k];
            if (!p->stale) continue;
            if (p->d) {
                RtxDoc_destroy(p->d);
                free(p->d);
            }
            free(p->real);
            wb->pdocs[k--] = wb->pdocs[--wb->npdocs];
        }
    }
    for (i = 0; i < wb->ntab; i++) tb_free(&wb->tabs[i]);
    free(wb->aggs);
    wb->aggs = NULL;
    wb->naggs = wb->aggcap = 0;
    free(wb->rules);
    wb->rules = NULL;
    wb->nrules = wb->rulecap = 0;
    free(wb->rmap);
    wb->rmap = NULL;
    wb->rmapcap = 0;
    free(wb->abs);
    wb->abs = NULL;
    wb->nabs = wb->abscap = 0;
    free(wb->g);
    wb->g = NULL;
    wb->ng = wb->gcap = 0;
    free(wb->names);
    wb->names = NULL;
    wb->nnames = wb->namecap = 0;
    free(wb->heap);
    wb->heap = NULL;
    wb->nheap = wb->heapcap = 0;
    wb->ma.reset();
    wb->va.reset();
    wb->sa.reset();
    wb->ma_mark = wb->va_mark = 0;
    wb->cyv = NULL;
    wb->ncyv = wb->cyvcap = 0;
    wb->tabs = NULL;
    wb->ntab = wb->tabcap = 0;
    wb->blks = NULL;
    wb->nblk = wb->blkcap = 0;
    wb->sheets = NULL;
    wb->sheetn = NULL;
    wb->nsheet = wb->sheetcap = 0;
    memset(&wb->map, 0, sizeof wb->map);
    wb->rdeps = NULL;
    wb->rdsh = NULL;
    wb->nrd = 0;
    wb->nderived = 0;
    wb->nform_cells = 0;
    wb->ndl = 0;
    wb->graph_dirty = 0;
    wb->jobs = 0;
    wb->cancelled = 0;
    wb->opgen++;
    wb->vgen++;
    wb->mgen++;
    if (wb->vc) memset(wb->vc, 0xff, (size_t)WB_VC_N * sizeof(WVc));
}

/* Name tables: sheets, tables, params, calc names. A name that differs
 * from another only in case, or repeats it, is an error on both. */
static int wb_names(RtxWb *wb) {
    uint32_t i, total = wb->nsheet + wb->ntab + wb->nnames;
    if (!wb_map_init(wb, &wb->map, total)) return 0;
    for (i = 1; i < wb->nsheet; i++)
        (void)wb_map_put(&wb->map, SC_SHEET, wb->sheets[i], wb->sheetn[i], i);
    for (i = 0; i < wb->ntab; i++) {
        WMapEnt *hit = wb_map_put(&wb->map, SC_TABLE, wb->tabs[i].name, wb->tabs[i].namen, i);
        if (hit) {
            wb->tabs[i].clash = 1;
            wb->tabs[hit->id].clash = 1;
        }
    }
    for (i = 0; i < wb->nnames; i++) {
        WName *n = &wb->names[i];
        WMapEnt *hit;
        if (!n->def) continue;
        hit = wb_map_put(&wb->map, n->scope, n->name, n->namen, i);
        if (hit) {
            WName *o = &wb->names[hit->id];
            n->clash = o->clash = 1;
            n->v = wv_err_a(wb->va, WE_DUP, "%.*s is defined twice (names differ in case at most)",
                            (int)n->namen, n->name);
            o->v = n->v;
            n->pend = o->pend = 0;
        }
    }
    return 1;
}

static int wb_ex_literal(const Ex *e) {
    return e && (e->op == EX_LIT || (e->op == EX_UN && e->bin == '-' && e->a && e->a->op == EX_LIT));
}

/* The line before lo / after hi: a block's reach for the prose path. */
static void wb_blks_ext(RtxWb *wb) {
    uint32_t i;
    size_t len = RtxDoc_len(wb->doc);
    for (i = 0; i < wb->nblk; i++) {
        WBlk *b = &wb->blks[i];
        char tmp[WB_SCAN_BACK];
        size_t lo = b->lo, back = lo < WB_SCAN_BACK ? lo : WB_SCAN_BACK, got, p;
        b->ext_lo = lo;
        if (lo > 0) {
            got = wb_read(wb->doc, lo - back, tmp, back);
            p = got ? got - 1 : 0; /* tmp[got - 1] is lo - 1 (a NL) */
            while (p > 0 && tmp[p - 1] != '\n') p--;
            b->ext_lo = lo - back + p;
        }
        b->ext_hi = b->hi;
        if (b->hi < len) {
            size_t fwd = len - b->hi < WB_SCAN_BACK ? len - b->hi : WB_SCAN_BACK;
            got = wb_read(wb->doc, b->hi, tmp, fwd);
            p = 0;
            while (p < got && tmp[p] != '\n') p++;
            b->ext_hi = b->hi + (p < got ? p + 1 : p);
        }
    }
}

/* Per table: the aggregates iterating it. */
static void wb_tab_aggs(RtxWb *wb) {
    uint32_t i;
    for (i = 0; i < wb->ntab; i++) wb->tabs[i].naggs = 0;
    for (i = 0; i < wb->naggs; i++) {
        WAgg *a = &wb->aggs[i];
        WTab *t;
        if (!a->live || a->tab < 0 || (uint32_t)a->tab >= wb->ntab) continue;
        t = &wb->tabs[a->tab];
        if (wb_hgrow((void **)&t->aggs, &t->aggcap, t->naggs + 1, sizeof(uint32_t)))
            t->aggs[t->naggs++] = i;
    }
}

/* Key indexes a lookup condition can use: `T[col = expr]`. */
static void wb_kx_want_ex(RtxWb *wb, const Ex *e) {
    uint16_t i;
    if (!e) return;
    if (e->op == EX_LOOKUP) {
        const Ex *probe;
        int kc = wb_lookup_key(e->b, e->tab, &probe);
        WTab *t = &wb->tabs[e->tab];
        if (kc >= 0 && t->kx && !t->kx[kc]) {
            t->kx[kc] = (WKx *)calloc(1, sizeof(WKx));
            if (t->kx[kc]) {
                t->kx[kc]->tab = e->tab;
                t->kx[kc]->col = kc;
            }
        }
    }
    wb_kx_want_ex(wb, e->a);
    wb_kx_want_ex(wb, e->b);
    wb_kx_want_ex(wb, e->c);
    wb_kx_want_ex(wb, e->where);
    for (i = 0; i < e->nargs; i++) wb_kx_want_ex(wb, e->args[i]);
}

/* After the scan: names, bindings, the graph, every value planned. */
static void wb_last_apply(RtxWb *wb);

static int wb_build_finish(RtxWb *wb) {
    uint32_t i, ti;
    wb_blks_ext(wb);
    if (!wb_names(wb)) return 0;
    wb_uses_resolve(wb);
    for (i = 0; i < wb->nnames; i++) {
        WName *n = &wb->names[i];
        if (!n->def || n->clash) continue;
        wb_bind(wb, BK_NAME, i);
        n = &wb->names[i];
        if (wb_ex_literal(n->ex)) {
            n->lit = 1;
            n->f_lo = n->f_hi = WNONE;
        } else {
            wb->nderived++;
        }
        wb_kx_want_ex(wb, n->ex);
    }
    for (i = 0; i < wb->nrules; i++) {
        wb_bind(wb, BK_RULE, i);
        wb_kx_want_ex(wb, wb->rules[i].ex);
    }
    wb_tab_aggs(wb);
    if (!wb_regraph(wb, 0)) return 0;
    /* every aggregate that reads no outer row has its one instance */
    for (i = 0; i < wb->naggs; i++) {
        WAgg *a = &wb->aggs[i];
        if (!a->live || a->pmask) continue;
        if (!a->ninst) inst_new(wb, a, NULL, 0);
        a->full = 1;
    }
    for (ti = 0; ti < wb->ntab; ti++) wb_chain_reset(wb, ti);
    wb_last_apply(wb);
    for (i = 0; i < wb->ng; i++)
        if (wb->g[i].kind == GN_NAME || wb->g[i].kind == GN_AGG || wb->g[i].kind == GN_ABS)
            wb_push(wb, i, 1);
    wb->chg_all = 1;
    wb->chg_cells = 1;
    return 1;
}

/* Key index for (ti, col): built by one walk (current values). */
static void wb_kx_build(RtxWb *wb, uint32_t ti, int32_t col) {
    WTab *t = &wb->tabs[ti];
    WKx *x = t->kx[col];
    uint32_t r;
    ECtx c;
    if (!x) return;
    kx_clear(x);
    x->tab = (int32_t)ti;
    x->col = col;
    ectx_init(&c, wb);
    for (r = 0; r < t->nrows; r++) {
        WRow rr;
        WVal v;
        WKey k;
        int cls;
        wb_row_load(wb, &rr, (int32_t)ti, r, 0);
        v = wb_cell_eval(&c, &rr, col);
        if (v.t == WV_NULL) continue;
        cls = v.t == WV_INT || v.t == WV_DEC ? KY_NUM
              : v.t == WV_TEXT                ? KY_TEXT
              : v.t == WV_DATE                ? KY_DATE
              : v.t == WV_BOOL                ? KY_BOOL
                                              : 0;
        if (!cls) {
            x->bad++;
            continue;
        }
        if (!x->cls) x->cls = (uint8_t)cls;
        else if (x->cls != cls) x->cls = 255;
        wb_key_of(&v, &k);
        kx_add(x, &k, rr.rid);
    }
    if (x->cls == 255) x->bad++;
    x->ok = 1;
    wb->st.kx_builds++;
}

/* ---- rebuild: the structural read, then everything planned */

static void wb_recalc_run(RtxWb *wb, int inline_all);

static void wb_rebuild(RtxWb *wb, int async);

static int wb_scan_step(RtxWb *wb, double deadline_us) {
    WScan *s = wb->scan;
    int r;
    if (!s) return 1;
    r = wb_scan_run(wb, s, deadline_us);
    if (r == 0) return 0;
    wbp_arm_stop(wb, s);
    wb->scan = NULL;
    if (wb->idx_bad) {
        /* the index installed a table half: read the bytes instead */
        wb->idx_bad = 0;
        wbi_drop(wb, 11);
        wb_scan_free(s);
        wb_rebuild(wb, 1);
        return wb->scan == NULL;
    }
    if (r < 0 || !wb_build_finish(wb)) {
        wb_scan_free(s);
        wbi_drop(wb, 0);
        wb_reset_model(wb);
        wb->off = 1;
        return 1;
    }
    if (wb->idx) {
        /* the partials, chains and key indexes the index kept */
        wbi_post_load(wb);
        if (wb->idx->next_tab == wb->idx->ntab) {
            uint32_t i;
            int lvl = wb->idx->level;
            wb->st.idx_state = 1;
            for (i = 0; i < wb->naggs; i++)
                if (wb->aggs[i].live && wb->aggs[i].full) {
                    lvl = 1; /* something builds */
                    if (getenv("RTX_WB_INDEX_DEBUG"))
                        fprintf(stderr, "wbi: aggregate %u (owner node %u, key %llx) not restored\n", i,
                                wb->aggs[i].owner, (unsigned long long)wbi_agg_key(wb, i));
                }
            wb->idx_wmgen = wb->mgen + 1; /* the stamp it gets below */
            wb->idx_wlevel = lvl;
        }
        wbi_drop(wb, 0);
    }
    wb->st.scan_rows = s->rows;
    wb_scan_free(s);
    wb->doc_len = RtxDoc_len(wb->doc);
    wb->ma_base = wb->ma_mark;
    wb->va_base = wb->va_mark;
    wb->mgen++;
    wb_values_moved(wb);
    return 1;
}

/* Reparse from bytes. async: a big workbook's read is a job (values hidden
 * until it is done); else it runs here, and the values settle within the
 * inline budget (the rest are jobs). */
/* ---- last values across a rebuild */

typedef struct WLast {
    char key[96];
    WVal v;
    char *txt;
} WLast;

static void wb_last_free(RtxWb *wb) {
    uint32_t i;
    for (i = 0; i < wb->nlastv; i++) free(wb->lastv[i].txt);
    free(wb->lastv);
    wb->lastv = NULL;
    wb->nlastv = 0;
}

/* The complete model's name values, before it is reset (a rebuild that
 * restarts a read keeps the earlier snapshot). */
static void wb_last_save(RtxWb *wb) {
    uint32_t i, n = 0;
    WLast *l;
    if (wb->scan || wb->off || !wb->nnames) return;
    l = (WLast *)calloc(wb->nnames, sizeof(WLast));
    if (!l) return;
    for (i = 0; i < wb->nnames; i++) {
        const WName *nm = &wb->names[i];
        WLast *e = &l[n];
        if (!nm->def || nm->clash || nm->lit || nm->v.t == WV_NULL || nm->v.t == WV_ROW ||
            nm->v.t == WV_TAB || nm->v.t == WV_GRP)
            continue;
        wb_name_label(wb, i, e->key, sizeof e->key);
        e->v = nm->v;
        if ((nm->v.t == WV_TEXT || nm->v.t == WV_ERR) && nm->v.n) {
            e->txt = (char *)malloc(nm->v.n);
            if (!e->txt) continue;
            memcpy(e->txt, nm->v.u.s, nm->v.n);
            e->v.u.s = e->txt;
        }
        n++;
    }
    wb_last_free(wb);
    wb->lastv = l;
    wb->nlastv = n;
}

/* After the read: each name that had a value paints it, stale, until its
 * recompute lands. */
static void wb_last_apply(RtxWb *wb) {
    uint32_t i, j;
    char key[96];
    if (!wb->nlastv) return;
    for (i = 0; i < wb->nnames; i++) {
        WName *nm = &wb->names[i];
        if (!nm->def || nm->clash || nm->lit || nm->node == WN32) continue;
        wb_name_label(wb, i, key, sizeof key);
        for (j = 0; j < wb->nlastv; j++)
            if (!strcmp(key, wb->lastv[j].key)) {
                nm->v = wv_keep(wb, wb->lastv[j].v);
                nm->pend = 1;
                wb->g[nm->node].pend = 1;
                break;
            }
    }
    wb_last_free(wb);
}

static void wb_rebuild(RtxWb *wb, int async) {
    size_t len = RtxDoc_len(wb->doc);
    WScan *s;
    wb_last_save(wb);
    if (wb->scan) {
        wb_scan_free(wb->scan);
        wb->scan = NULL;
    }
    wb_reset_model(wb);
    wb->st.rebuilds++;
    wb->doc_len = len;
    wb->off = 0;
    wb->chg_all = 1;
    wb->nchanged = 0;
    wb->pend = 0;
    wb->need_rebuild = 0;
    if (len > g_wb_max) {
        wb->off = 1;
        return;
    }
    s = (WScan *)calloc(1, sizeof(WScan));
    if (!s) {
        wb->off = 1;
        return;
    }
    s->sheet = wb_sheet_add(wb, "", 0);
    wb->scan = s;
    if (async && len >= g_wb_defer) {
        wb->jobs = 1;
        return;
    }
    /* a big external file: its read is a job (the rest reads here) */
    s->ext_async = (uint8_t)async;
    wb_scan_step(wb, 0);
    if (wb->scan) {
        wb->scan->ext_async = 0;
        wb->jobs = 1;
        return;
    }
    if (!wb->off) wb_recalc_run(wb, 0);
}


/* ------------------------------------------------------------------ edits
 *
 * The document tells the workbook each replace twice: `pre` before (the
 * bytes the edit will remove are still there: the rows it touches are
 * captured) and `note` after (the union of the edits since the last
 * sync). The next query syncs: a cell edit, a whole-row edit (insert /
 * delete / move), a calc / params line, prose, or a reparse. A row edit's
 * old side is computed first (old mode: the captured rows, every stored
 * value as it was), then the model moves, then the new side; aggregates
 * take the difference as row deltas.
 */

static size_t wb_shx(size_t x, size_t at, size_t old_n, ptrdiff_t delta, int end) {
    size_t e = at + old_n;
    if (x == WNONE) return x;
    if (x > e || (x == e && (end || old_n))) return (size_t)((ptrdiff_t)x + delta);
    return x;
}

/* The name / line whose raw_lo is last at or before off, or -1. */
static int64_t wb_name_find(const RtxWb *wb, size_t off) {
    uint32_t lo = 0, hi = wb->nnames;
    while (lo < hi) {
        uint32_t mid = lo + (hi - lo) / 2;
        if (wb->names[mid].raw_lo <= off) lo = mid + 1;
        else hi = mid;
    }
    return (int64_t)lo - 1;
}

/* The table holding byte off (caption .. end), or -1. */
static int32_t wb_tab_at(const RtxWb *wb, size_t off) {
    uint32_t lo = 0, hi = wb->ntab;
    while (lo < hi) {
        uint32_t mid = lo + (hi - lo) / 2;
        if (wb->tabs[mid].lo <= off) lo = mid + 1;
        else hi = mid;
    }
    if (!lo) return -1;
    /* an external table's rows are in its file: its fence is structure */
    if (wb->tabs[lo - 1].ext) return -1;
    return off <= wb->tabs[lo - 1].hi ? (int32_t)(lo - 1) : -1;
}

/* Offsets from byte `at` on move by delta (wb_shx's rule), except the
 * rows of table skip_tab from row skip_row (the caller places them). */
static void wb_shift(RtxWb *wb, size_t at, size_t old_n, ptrdiff_t delta) {
    int64_t k;
    uint32_t i, c, j;
    if (!delta) return;
    k = wb_name_find(wb, at);
    if (k < 0) k = 0;
    for (i = (uint32_t)k; i < wb->nnames; i++) {
        WName *n = &wb->names[i];
        n->raw_lo = wb_shx(n->raw_lo, at, old_n, delta, 0);
        n->raw_hi = wb_shx(n->raw_hi, at, old_n, delta, 1);
        n->f_lo = wb_shx(n->f_lo, at, old_n, delta, 0);
        n->f_hi = wb_shx(n->f_hi, at, old_n, delta, 1);
        n->n_lo = wb_shx(n->n_lo, at, old_n, delta, 0);
        n->n_hi = wb_shx(n->n_hi, at, old_n, delta, 1);
        n->src_lo = wb_shx(n->src_lo, at, old_n, delta, 0);
    }
    for (i = 0; i < wb->ntab; i++) {
        WTab *t = &wb->tabs[i];
        int32_t r;
        uint32_t k0 = 0;
        if (t->hi < at) continue;
        r = !t->ext && t->nrows && at >= tb_row_lo(t, 0) ? tb_row_at(t, at) : -1;
        if (t->ext) k0 = t->nb; /* its blocks are offsets into its file */
        if (r >= 0) {
            /* the row holding `at`: its length; the rows after it in its
             * block (their offsets in it) */
            uint32_t kb = tb_bpos(t, (uint32_t)r), s = (uint32_t)r - t->bfirst[kb];
            WBlock *b = &t->blk[t->bord[kb]];
            size_t rlo = b->lo + b->rrel[s];
            b->rlen[s] = (uint32_t)(wb_shx(rlo + b->rlen[s], at, old_n, delta, 1) - rlo);
            for (j = s + 1; j < b->n; j++)
                b->rrel[j] = (uint32_t)(wb_shx(b->lo + b->rrel[j], at, old_n, delta, 0) - b->lo);
            k0 = kb + 1;
        }
        for (j = k0; j < t->nb; j++) {
            WBlock *b = &t->blk[t->bord[j]];
            b->lo = wb_shx(b->lo, at, old_n, delta, 0);
        }
        t->lo = wb_shx(t->lo, at, old_n, delta, 0);
        t->hi = wb_shx(t->hi, at, old_n, delta, 0);
        t->body_lo = wb_shx(t->body_lo, at, old_n, delta, 0);
        t->cap_lo = wb_shx(t->cap_lo, at, old_n, delta, 0);
        t->cap_hi = wb_shx(t->cap_hi, at, old_n, delta, 1);
        for (c = 0; c < (uint32_t)t->ncols; c++) {
            t->hlo[c] = wb_shx(t->hlo[c], at, old_n, delta, 0);
            t->hhi[c] = wb_shx(t->hhi[c], at, old_n, delta, 1);
        }
    }
    for (i = 0; i < wb->nblk; i++) {
        WBlk *b = &wb->blks[i];
        if (b->ext_hi < at) continue;
        b->lo = wb_shx(b->lo, at, old_n, delta, 0);
        b->hi = wb_shx(b->hi, at, old_n, delta, 0);
        b->ext_lo = wb_shx(b->ext_lo, at, old_n, delta, 0);
        b->ext_hi = wb_shx(b->ext_hi, at, old_n, delta, 0);
    }
}

/* Every offset at or after `at` moves by delta (a row window's end),
 * except table skip's blocks (placed by the caller). */
static void wb_shift_ge(RtxWb *wb, size_t at, ptrdiff_t delta, uint32_t skip) {
    uint32_t i, c, j;
    int64_t k;
#define WB_SGE(x)                                                                      \
    do {                                                                               \
        if ((x) != WNONE && (x) >= at) (x) = (size_t)((ptrdiff_t)(x) + delta);          \
    } while (0)
    if (!delta) return;
    k = wb_name_find(wb, at ? at - 1 : 0);
    for (i = k < 0 ? 0 : (uint32_t)k; i < wb->nnames; i++) {
        WName *n = &wb->names[i];
        WB_SGE(n->raw_lo);
        WB_SGE(n->raw_hi);
        WB_SGE(n->f_lo);
        WB_SGE(n->f_hi);
        WB_SGE(n->n_lo);
        WB_SGE(n->n_hi);
        WB_SGE(n->src_lo);
    }
    for (i = 0; i < wb->ntab; i++) {
        WTab *t = &wb->tabs[i];
        if (t->hi < at) continue;
        WB_SGE(t->lo);
        WB_SGE(t->hi);
        WB_SGE(t->body_lo);
        WB_SGE(t->cap_lo);
        WB_SGE(t->cap_hi);
        for (c = 0; c < (uint32_t)t->ncols; c++) {
            WB_SGE(t->hlo[c]);
            WB_SGE(t->hhi[c]);
        }
        if (i != skip && !t->ext)
            for (j = 0; j < t->nb; j++) WB_SGE(t->blk[t->bord[j]].lo);
    }
    for (i = 0; i < wb->nblk; i++) {
        WBlk *b = &wb->blks[i];
        if (b->ext_hi < at) continue;
        WB_SGE(b->lo);
        WB_SGE(b->hi);
        WB_SGE(b->ext_lo);
        WB_SGE(b->ext_hi);
    }
#undef WB_SGE
}

static char *wb_read_tmp(RtxWb *wb, size_t lo, size_t n) {
    char *p;
    if (n > WB_LINE_MAX * 64) return NULL;
    p = (char *)cc_arena_alloc(wb->sa, n + 1, 16);
    if (!p || wb_read(wb->doc, lo, p, n) != n) return NULL;
    p[n] = 0;
    return p;
}

/* ---- the capture (pre hook) */

static void wb_sync_ex(RtxWb *wb, const RtxDoc *d, int paint);

/* Before a replace [at, at + erased): the rows of the table there, with a
 * margin for rows that read their neighbours, while their bytes exist. */
static void wb_capture(RtxWb *wb, size_t at, size_t erased) {
    WCap *cp = &wb->cap;
    int32_t ti;
    WTab *t;
    int32_t ra, rb, m;
    size_t lo, hi, n;
    uint32_t i, k;
    cp->ok = 0;
    cp->at = at;
    cp->erased = erased;
    if (wb->off || wb->scan || !wb->ntab) return;
    ti = wb_tab_at(wb, at);
    if (ti < 0) return;
    t = &wb->tabs[ti];
    if (t->big || !t->nrows || at < tb_row_lo(t, 0)) return;
    ra = tb_row_at(t, at);
    rb = tb_row_at(t, at + erased);
    if (ra < 0) ra = 0;
    if (rb < ra) rb = ra;
    m = 1 + (t->relb > t->relf ? t->relb : t->relf);
    ra = ra > m ? ra - m : 0;
    rb = rb + m + 1 < (int32_t)t->nrows ? rb + m + 1 : (int32_t)t->nrows - 1;
    if (rb - ra > 65536) return;
    lo = tb_row_lo(t, (uint32_t)ra);
    hi = tb_row_lo(t, (uint32_t)rb) + tb_row_len(t, (uint32_t)rb);
    if (hi < t->hi) hi++; /* its NL */
    n = hi - lo;
    if (n > ((size_t)16 << 20)) return;
    if (n + 1 > cp->bcap) {
        char *nb = (char *)realloc(cp->b, n + 1);
        if (!nb) return;
        cp->b = nb;
        cp->bcap = n + 1;
    }
    if ((uint32_t)(rb - ra + 2) > cp->rcap) {
        uint32_t nc = (uint32_t)(rb - ra + 2) * 2;
        uint32_t *o = (uint32_t *)realloc(cp->roff, (size_t)nc * sizeof(uint32_t));
        if (!o) return;
        cp->roff = o;
        o = (uint32_t *)realloc(cp->rid, (size_t)nc * sizeof(uint32_t));
        if (!o) return;
        cp->rid = o;
        cp->rcap = nc;
    }
    if (wb_read(wb->doc, lo, cp->b, n) != n) return;
    cp->b[n] = 0;
    cp->bn = n;
    cp->lo = lo;
    cp->tab = ti;
    cp->pos = (uint32_t)ra;
    cp->n = (uint32_t)(rb - ra + 1);
    for (i = 0, k = (uint32_t)ra; k <= (uint32_t)rb; i++, k++) {
        cp->roff[i] = (uint32_t)(tb_row_lo(t, k) - lo);
        cp->rid[i] = tb_row_rid(t, k);
    }
    cp->roff[cp->n] = (uint32_t)n;
    cp->ok = 1;
}

static void wb_hook_pre(void *ctx, const RtxDoc *d, size_t at, size_t erased) {
    RtxWb *wb = (RtxWb *)ctx;
    /* the pre-read arm reads the tree: it stops before the tree is written */
    if (wb->scan && wb->scan->arm) wbp_arm_stop(wb, wb->scan);
    if (wb->pre_open) {
        /* a group: several writes before the notes; no capture */
        wb->pre_multi = 1;
        wb->cap.ok = 0;
        return;
    }
    if (wb->pend) wb_sync_ex(wb, d, 1);
    wb->pre_open = 1;
    wb->pre_multi = 0;
    wb_capture(wb, at, erased);
}

static void wb_hook_note(void *ctx, size_t at, size_t erased, size_t inserted) {
    RtxWb *wb = (RtxWb *)ctx;
    size_t lo, hi_cur, hi_old, cur_hi;
    if (wb->cap.ok && (!wb->pre_open || wb->pre_multi || wb->cap.at != at ||
                       wb->cap.erased != erased || wb->pend))
        wb->cap.ok = 0;
    wb->pre_open = 0;
    if (!wb->pend) {
        wb->pend = 1;
        wb->p_lo = at;
        wb->p_old = erased;
        wb->p_new = inserted;
        return;
    }
    cur_hi = wb->p_lo + wb->p_new;
    lo = at < wb->p_lo ? at : wb->p_lo;
    hi_cur = cur_hi > at + erased ? cur_hi : at + erased;
    hi_old = wb->p_lo + wb->p_old + (hi_cur - cur_hi);
    wb->p_old = hi_old - lo;
    wb->p_new = hi_cur - erased + inserted - lo;
    wb->p_lo = lo;
}

static void wb_rules_gc(RtxWb *wb);

/* ---- row deltas */

typedef struct {
    uint32_t ai;       /* the aggregate (index: the array may move) */
    WInst *in;         /* checked against serial before use (dl_inst) */
    uint64_t serial;
    uint32_t rid, bid;
    uint8_t side; /* 0 old, 1 new */
    uint8_t dead;
    WCon k;
    WGRow g;
} WDl;

typedef struct {
    WDl *e;
    uint32_t n, cap;
} WDlv;

static WDl *dl_push(WDlv *v) {
    if (v->n >= v->cap) {
        uint32_t nc = v->cap ? v->cap * 2 : 256;
        WDl *ne = (WDl *)realloc(v->e, (size_t)nc * sizeof(WDl));
        if (!ne) return NULL;
        v->e = ne;
        v->cap = nc;
    }
    memset(&v->e[v->n], 0, sizeof(WDl));
    return &v->e[v->n++];
}

static int wb_agg_deltas(const RtxWb *wb, const WAgg *a) {
    return a->live && !a->blockmode && !a->full && !wb->g[a->node].cyc;
}

/* The block id of row id rid (current index). */
static uint32_t tb_rid_bid(const WTab *t, uint32_t rid) {
    return rid < t->nrid ? t->rloc[rid].bid : WN32;
}

/* Contributions of rows [p0, p1) of table ti (positions in `old` mode)
 * to every delta-maintained instance over it. */
static void wb_dl_rows(RtxWb *wb, uint32_t ti, uint32_t p0, uint32_t p1, int old, int side,
                       WDlv *out, uint16_t colmask) {
    WTab *t = &wb->tabs[ti];
    uint32_t p, i, j;
    for (p = p0; p < p1; p++) {
        WRow rr;
        uint32_t bid;
        wb_row_load(wb, &rr, (int32_t)ti, p, old);
        bid = tb_rid_bid(t, rr.rid);
        for (i = 0; i < t->naggs; i++) {
            WAgg *a = &wb->aggs[t->aggs[i]];
            if (!wb_agg_deltas(wb, a)) continue;
            /* it reads none of the columns that can have moved: its
             * contribution is the same on both sides */
            if (!(a->rowmask & colmask) && colmask != 0xffff) continue;
            for (j = 0; j < a->ninst; j++) {
                WInst *in = a->inst[j];
                ECtx c;
                WDl *d;
                /* one made during this op was built from the new rows: no delta */
                if (!in || !in->live || in->full || in->serial > wb->dl_serial0) continue;
                inst_ctx(wb, a, in, &c, old);
                d = dl_push(out);
                if (!d) {
                    in->full = 1;
                    continue;
                }
                d->ai = t->aggs[i];
                d->in = in;
                d->serial = in->serial;
                d->rid = rr.rid;
                d->bid = bid;
                d->side = (uint8_t)side;
                if (a->grp) {
                    if (!wg_row_alloc(wb, a, &d->g)) {
                        d->dead = 1;
                        in->full = 1;
                        continue;
                    }
                    wg_con(&c, a, &rr, &d->g);
                } else {
                    wb_con(&c, &a->o, &rr, &d->k);
                }
                if (c.oldfail) {
                    /* old mode could not see its state: rebuild it */
                    in->full = 1;
                    d->dead = 1;
                }
                wb->st.ma_rows += 0;
            }
        }
    }
}

static int wg_same(const WAgg *a, const WGRow *x, const WGRow *y) {
    uint32_t j;
    if (x->stop != y->stop) return 0;
    if (x->stop) return 1;
    if (!wb_key_eq(&x->key, &y->key)) return 0;
    for (j = 0; j < a->nout; j++)
        if (!con_same(&x->oc[j], &y->oc[j])) return 0;
    return 1;
}

/* The entry's instance if it still lives (a rule gone mid-sync frees its
 * aggregates), else NULL. */
static WInst *dl_inst(RtxWb *wb, const WDl *d) {
    const WAgg *a;
    uint32_t j;
    if (d->ai >= wb->naggs) return NULL;
    a = &wb->aggs[d->ai];
    if (!a->live) return NULL;
    for (j = 0; j < a->ninst; j++)
        if (a->inst[j] == d->in) return d->in->serial == d->serial ? d->in : NULL;
    return NULL;
}

/* Apply one entry: an old contribution out (-1) or a new one in (+1). */
static void wb_dl_apply(RtxWb *wb, WDl *d, int sign) {
    WAgg *a = &wb->aggs[d->ai];
    WInst *in = dl_inst(wb, d);
    if (!in || d->dead || in->full || !in->live) return;
    if (d->bid == WN32) return;
    if (d->bid >= in->lcap) inst_fit(wb, a, in);
    if (in->building && (!in->ldone || d->bid >= in->lcap || !in->ldone[d->bid])) return;
    wb->st.ma_delta++;
    if (a->grp) {
        if (d->g.stop) {
            uint32_t *ls = inst_lstop(wb, a, in);
            if (ls) {
                if (sign > 0 && ls[d->bid]++ == 0) in->nstop++;
                if (sign < 0 && ls[d->bid] && --ls[d->bid] == 0) in->nstop--;
            }
        }
        wg_apply(wb, a, in, &d->g, d->rid, d->bid, sign);
        in->gver++;
        return;
    }
    inst_row(wb, a, in, d->bid, &d->k, d->rid, sign);
}

static int dl_cmp(const void *x, const void *y) {
    const WDl *a = (const WDl *)x, *b = (const WDl *)y;
    if (a->serial != b->serial) return a->serial < b->serial ? -1 : 1;
    if (a->rid != b->rid) return a->rid < b->rid ? -1 : 1;
    return (int)a->side - (int)b->side;
}

/* Pair old and new entries of the same (instance, row): equal ones cancel;
 * the rest apply. Every touched aggregate node is queued. */
static void wb_dl_settle(RtxWb *wb, WDlv *v) {
    uint32_t i;
    if (!v->n) return;
    qsort(v->e, v->n, sizeof(WDl), dl_cmp);
    for (i = 0; i < v->n; i++) {
        WDl *d = &v->e[i];
        WAgg *da = &wb->aggs[d->ai];
        WInst *din = dl_inst(wb, d);
        if (!din) {
            /* its aggregate died with a rule: nothing to apply */
            if (i + 1 < v->n && v->e[i + 1].serial == d->serial && v->e[i + 1].rid == d->rid) i++;
            continue;
        }
        if (i + 1 < v->n && d->side == 0 && v->e[i + 1].side == 1 && v->e[i + 1].serial == d->serial &&
            v->e[i + 1].rid == d->rid) {
            WDl *e = &v->e[i + 1];
            int same = da->grp ? wg_same(da, &d->g, &e->g) : con_same(&d->k, &e->k);
            if (same && d->bid == e->bid) {
                if (da->grp) {
                    /* a stop row's error text may have moved: lookups
                     * into the group read it, so they recompute */
                    int st = e->g.stop;
                    uint32_t j;
                    for (j = 0; j < da->nout && !st; j++) st = e->g.oc[j].k == CN_STOP;
                    if (st) {
                        din->gver++;
                        wb_push(wb, da->node, 0);
                    }
                } else if (d->k.k == CN_STOP && !wv_same(&d->k.v, &e->k.v)) {
                    /* the same count, another error text: the first
                     * stop's message may be the value */
                    wb_push(wb, da->node, 0);
                }
                i++;
                continue;
            }
            wb_dl_apply(wb, d, -1);
            wb_dl_apply(wb, e, 1);
            wb_push(wb, da->node, 0);
            i++;
            continue;
        }
        wb_dl_apply(wb, d, d->side ? 1 : -1);
        wb_push(wb, da->node, 0);
    }
    for (i = 0; i < v->n; i++) {
        WInst *in = dl_inst(wb, &v->e[i]);
        if (in && in->full) wb_push(wb, wb->aggs[v->e[i].ai].node, 1);
    }
    v->n = 0;
}

/* Values of every cell of row p (the mode's), into out. */
static void wb_row_values(RtxWb *wb, uint32_t ti, uint32_t p, int old, WVal *out, uint16_t *nulls) {
    const WTab *t = &wb->tabs[ti];
    WRow rr;
    ECtx c;
    int32_t col;
    ectx_init(&c, wb);
    c.old = old;
    wb_row_load(wb, &rr, (int32_t)ti, p, old);
    *nulls = 0;
    for (col = 0; col < t->ncols; col++) {
        if (old && t->ch.on && (t->ch.dep & (1u << col))) {
            /* chain values have no old mode: counted as changed */
            out[col] = wv_err_a(wb->sa, WE_NUM, "chain");
            *nulls |= (uint16_t)(1u << col);
            continue;
        }
        out[col] = wb_cell_eval(&c, &rr, col);
        if (out[col].t == WV_TEXT || out[col].t == WV_ERR) out[col] = wv_keep_in(wb->sa, out[col]);
    }
}

/* A table's columns changed as a whole (retyped) or in some rows: their
 * readers by shape. mask: the columns; whole: every row. */
static void wb_rkx_touch(RtxWb *wb, uint32_t ti, uint16_t mask);

static void wb_cols_changed(RtxWb *wb, uint32_t ti, uint16_t mask, int whole) {
    WTab *t = &wb->tabs[ti];
    int32_t c;
    uint32_t k;
    if (whole) wb_rkx_touch(wb, ti, mask);
    for (c = 0; c < t->ncols; c++) {
        const WGNode *g;
        if (!(mask & (1u << c))) continue;
        g = &wb->g[t->cnode[c]];
        if (whole) {
            wb_push(wb, t->cnode[c], 1);
            continue;
        }
        for (k = 0; k < g->rdn; k++) {
            uint32_t w = wb->rdeps[g->rd0 + k];
            uint8_t sh = wb->rdsh[g->rd0 + k];
            if (sh == SH_LOOK || sh == SH_KEY) {
                /* a rule whose readers took this edit as row deltas */
                if (wb->g[w].kind == GN_RULE && wb->rules[wb->g[w].ref].dskip) continue;
                if (wb->g[w].kind == GN_AGG) wb->aggs[wb->g[w].ref].full = 1;
                wb_push(wb, w, 1);
            } else if (sh == SH_ABS) {
                wb_push(wb, w, 0);
            }
        }
    }
    /* anchored cells, ranges: they re-read (cutoff at their values) */
    for (k = 0; k < wb->nabs; k++)
        if (wb->abs[k].tab == (int32_t)ti) wb_push(wb, wb->abs[k].node, 0);
    for (k = 0; k < t->naggs; k++) {
        WAgg *a = &wb->aggs[t->aggs[k]];
        if (a->live && (a->ranged || a->blockmode)) wb_push(wb, a->node, 0);
    }
    wb->chg_cells = 1;
    wb_values_moved(wb);
}

/* Key indexes over table ti: row rid's key in column c left (old value)
 * and arrived (new value). A value an index cannot hold drops it. */
static void wb_kx_move(RtxWb *wb, uint32_t ti, int32_t c, uint32_t rid, const WVal *ov,
                       const WVal *nv) {
    WTab *t = &wb->tabs[ti];
    WKx *x = t->kx ? t->kx[c] : NULL;
    int k;
    if (!x || !x->ok) return;
    for (k = 0; k < 2; k++) {
        const WVal *v = k ? nv : ov;
        WKey key;
        int cls;
        if (!v || v->t == WV_NULL) continue;
        cls = v->t == WV_INT || v->t == WV_DEC ? KY_NUM
              : v->t == WV_TEXT                ? KY_TEXT
              : v->t == WV_DATE                ? KY_DATE
              : v->t == WV_BOOL                ? KY_BOOL
                                               : 0;
        if (!cls || (x->cls && x->cls != cls)) {
            x->ok = 0; /* rebuilt at the next lookup */
            return;
        }
        if (!x->cls) x->cls = (uint8_t)cls;
        wb_key_of(v, &key);
        if (k) kx_add(x, &key, rid);
        else kx_del(x, &key, rid);
    }
}

/* ---- reader-side key indexes (docs/workbook.md "W1 phase 2 as built")
 *
 * A rule whose rows look a key up in another table (`=K[id = @cust].w +
 * @x`) is read by aggregates over its column. An edit of K row k's
 * non-key cell changes that rule's value only in the reader rows whose
 * probe equals k's key. The reader index maps probe key -> reader row ids
 * (built on the first edit that needs it, one walk of the reader table);
 * the edit then takes those rows as row deltas (old side through the
 * captured K row, new side after) instead of every aggregate over the
 * column rebuilding. Eligible: a probe of this row's literal cells,
 * literals and scalar operators (so only an edit of the reader table
 * moves it: those drop the index), a literal key column in K, another
 * table, no relative readers in the reader table. Anything else keeps
 * the wholesale path. */

typedef struct WRkx {
    uint32_t rule;
    const Ex *probe;
    int32_t ktab, kcol, rtab, rcol;
    uint16_t pmask;       /* reader columns the probe reads */
    uint8_t all;          /* every lookup of the rule into ktab is one of these */
    uint16_t seq;         /* its place among the rule's lookups (a rebind keeps it) */
    WKx x;                /* probe key -> reader row ids (x.ok) */
} WRkx;

/* A probe only this row's literal cells move. */
static int wb_rkx_probe_ok(const Ex *e, uint16_t *mask) {
    uint16_t i;
    if (!e) return 1;
    switch (e->op) {
    case EX_LIT:
        return 1;
    case EX_ATCELL:
        if (e->col < 0 || e->col >= RTX_WB_COLS_MAX) return 0;
        *mask = (uint16_t)(*mask | (1u << e->col));
        return 1;
    case EX_UN:
    case EX_BIN:
    case EX_IF:
    case EX_FN:
        if (!wb_rkx_probe_ok(e->a, mask) || !wb_rkx_probe_ok(e->b, mask) || !wb_rkx_probe_ok(e->c, mask))
            return 0;
        for (i = 0; i < e->nargs; i++)
            if (!wb_rkx_probe_ok(e->args[i], mask)) return 0;
        return 1;
    default:
        return 0;
    }
}

static void wb_rkx_free(RtxWb *wb) {
    uint32_t i;
    for (i = 0; i < wb->nrkx; i++) kx_free(&wb->rkx[i].x);
    free(wb->rkx);
    wb->rkx = NULL;
    wb->nrkx = wb->rkxcap = 0;
    wb->rkx_listed = 0;
}

/* The lookups of rule ri (outside aggregates: those iterate their own
 * table): eligible ones listed; per looked-up table, whether all were. */
static void wb_rkx_walk(RtxWb *wb, uint32_t ri, const Ex *e, int32_t *tabs, int *ntabs, int *bad) {
    uint16_t i;
    if (!e) return;
    if (e->op == EX_AGG || e->op == EX_GROUP) return;
    if (e->op == EX_LOOKUP && e->tab >= 0) {
        const WRule *ru = &wb->rules[ri];
        const Ex *probe = NULL;
        int kc = wb_lookup_key(e->b, e->tab, &probe);
        uint16_t pm = 0;
        int j, seen = 0;
        for (j = 0; j < *ntabs; j++)
            if (tabs[j] == e->tab) seen = 1;
        if (!seen && *ntabs < 16) {
            tabs[*ntabs] = e->tab;
            bad[*ntabs] = 0;
            (*ntabs)++;
        }
        for (j = 0; j < *ntabs; j++) {
            if (tabs[j] != e->tab) continue;
            if (kc < 0 || e->tab == ru->tab || !wb_rkx_probe_ok(probe, &pm)) {
                bad[j] = 1;
            } else if (wb_hgrow((void **)&wb->rkx, &wb->rkxcap, wb->nrkx + 1, sizeof(WRkx))) {
                WRkx *k = &wb->rkx[wb->nrkx++];
                memset(k, 0, sizeof *k);
                k->seq = (uint16_t)(wb->nrkx - 1);
                k->rule = ri;
                k->probe = probe;
                k->ktab = e->tab;
                k->kcol = kc;
                k->rtab = ru->tab;
                k->rcol = ru->col;
                k->pmask = pm;
            } else {
                bad[j] = 1;
            }
        }
        wb_rkx_walk(wb, ri, e->b, tabs, ntabs, bad);
        return;
    }
    wb_rkx_walk(wb, ri, e->a, tabs, ntabs, bad);
    wb_rkx_walk(wb, ri, e->b, tabs, ntabs, bad);
    wb_rkx_walk(wb, ri, e->c, tabs, ntabs, bad);
    wb_rkx_walk(wb, ri, e->where, tabs, ntabs, bad);
    for (i = 0; i < e->nargs; i++) wb_rkx_walk(wb, ri, e->args[i], tabs, ntabs, bad);
}

/* The list for the current bindings (rebuilt after any bind). A rule is
 * its text, so a rebound rule's lookups are the same: built indexes carry
 * over by (rule, place). */
static void wb_rkx_list(RtxWb *wb) {
    uint32_t ri, i, j, nold = wb->nrkx;
    WRkx *old = wb->rkx;
    if (wb->rkx_listed && wb->rkx_bindgen == wb->bind_gen) return;
    wb->rkx = NULL;
    wb->nrkx = wb->rkxcap = 0;
    for (ri = 0; ri < wb->nrules; ri++) {
        const WRule *ru = &wb->rules[ri];
        int32_t tabs[16];
        int bad[16], ntabs = 0, j;
        uint32_t k0 = wb->nrkx, k;
        if (ru->dead || !ru->refs || !ru->ex || ru->tab < 0) continue;
        wb_rkx_walk(wb, ri, ru->ex, tabs, &ntabs, bad);
        for (k = k0; k < wb->nrkx; k++) {
            WRkx *x = &wb->rkx[k];
            x->all = 1;
            x->seq = (uint16_t)(k - k0);
            for (j = 0; j < ntabs; j++)
                if (tabs[j] == x->ktab && bad[j]) x->all = 0;
        }
    }
    for (i = 0; i < nold; i++) {
        int kept = 0;
        for (j = 0; j < wb->nrkx && !kept; j++) {
            WRkx *x = &wb->rkx[j];
            if (x->rule == old[i].rule && x->seq == old[i].seq && x->ktab == old[i].ktab &&
                x->kcol == old[i].kcol && x->rtab == old[i].rtab && x->pmask == old[i].pmask &&
                !x->x.cap && !x->x.ar.base) {
                x->x = old[i].x;
                kept = 1;
            }
        }
        if (!kept) kx_free(&old[i].x);
    }
    free(old);
    wb->rkx_listed = 1;
    wb->rkx_bindgen = wb->bind_gen;
}

/* Reader table ti's cells in `mask` changed (or its rows moved: 0xffff):
 * indexes whose probe or rule cell they are drop. */
static void wb_rkx_touch(RtxWb *wb, uint32_t ti, uint16_t mask) {
    uint32_t i;
    for (i = 0; i < wb->nrkx; i++) {
        WRkx *k = &wb->rkx[i];
        if (k->rtab == (int32_t)ti && (mask & (k->pmask | (1u << k->rcol)))) k->x.ok = 0;
    }
}

/* One walk of the reader table (the mode's rows). */
static int wb_rkx_build(RtxWb *wb, WRkx *k, int old) {
    WTab *t = &wb->tabs[k->rtab];
    uint32_t r, n = wb_nrows_mode(wb, k->rtab, old);
    kx_clear(&k->x);
    for (r = 0; r < n; r++) {
        WRow rr;
        ECtx c;
        WVal v;
        WKey key;
        size_t lo, hi, slo, shi, flo, fhi;
        wb_row_load(wb, &rr, k->rtab, r, old);
        if (!wb_cell_span(&rr, k->rcol, &lo, &hi) || !wb_cell_formula(rr.b, lo, hi, &slo, &shi, &flo, &fhi))
            continue;
        if (wb_rule_find(wb, k->rtab, k->rcol, rr.b + slo, (uint32_t)(shi - slo)) != (int)k->rule) continue;
        ectx_init(&c, wb);
        c.old = old;
        c.own = &rr;
        c.self_tab = k->rtab;
        c.self_pos = (int32_t)r;
        c.self_col = k->rcol;
        v = ev(&c, k->probe);
        if (v.t == WV_NULL || v.t == WV_ERR) continue;
        wb_key_of(&v, &key);
        kx_add(&k->x, &key, rr.rid);
    }
    (void)t;
    k->x.ok = 1;
    wb->st.rkx_builds++;
    return 1;
}

typedef struct {
    int32_t tab;
    uint32_t pos;
} WRkRow;

static int rkrow_cmp(const void *x, const void *y) {
    const WRkRow *a = (const WRkRow *)x, *b = (const WRkRow *)y;
    if (a->tab != b->tab) return a->tab < b->tab ? -1 : 1;
    return a->pos < b->pos ? -1 : a->pos > b->pos;
}

/* An edit of cell ecol of row r in table ti (old mode is on): the reader
 * rows whose values it moves through handled rules, into *out (sorted,
 * unique; heap). Handled rules get dskip (their wholesale change is not
 * pushed). The count, or 0. */
static uint32_t wb_rkx_rows(RtxWb *wb, uint32_t ti, uint32_t r, int32_t ecol, WRkRow **out) {
    WTab *t = &wb->tabs[ti];
    uint32_t i, n = 0, cap = 0, limit;
    WRkRow *v = NULL;
    WRow kr;
    ECtx c;
    WVal kv;
    WKey key;
    *out = NULL;
    uint8_t *handled;
    if (!wb->nrules) return 0;
    wb_rkx_list(wb);
    if (!wb->nrkx) return 0;
    handled = (uint8_t *)calloc(wb->nrkx, 1);
    if (!handled) return 0;
    wb_row_load(wb, &kr, (int32_t)ti, r, 1);
    ectx_init(&c, wb);
    c.old = 1;
    for (i = 0; i < wb->nrkx; i++) {
        WRkx *k = &wb->rkx[i];
        WTab *rt;
        uint32_t cnt, m, j, *ids;
        if (k->ktab != (int32_t)ti || !k->all || ecol == k->kcol) continue;
        if (t->cs[k->kcol].k[LK_FORMULA]) continue;
        rt = &wb->tabs[k->rtab];
        if (rt->relmask || rt->big) continue;
        {
            uint16_t pm = k->pmask;
            int32_t col, lit = 1;
            for (col = 0; col < rt->ncols; col++)
                if ((pm & (1u << col)) && rt->cs[col].k[LK_FORMULA]) lit = 0;
            if (!lit) continue;
        }
        if (!k->x.ok) wb_rkx_build(wb, k, 1);
        kv = wb_cell_eval(&c, &kr, k->kcol);
        limit = (uint32_t)(rt->nrows / 4 + 64);
        if (kv.t == WV_NULL || kv.t == WV_ERR) {
            cnt = 0;
        } else {
            wb_key_of(&kv, &key);
            cnt = kx_count(&k->x, &key, NULL);
        }
        if (cnt > limit) continue; /* most of the table: the wholesale rebuild */
        if (!cnt) {
            handled[i] = 1;
            continue;
        }
        ids = (uint32_t *)malloc((size_t)cnt * sizeof(uint32_t));
        if (!ids) continue;
        m = kx_ids(&k->x, &key, ids, cnt);
        if (m > cnt) m = cnt;
        if (n + m > cap) {
            uint32_t nc = cap ? cap * 2 : 64;
            WRkRow *nv;
            while (nc < n + m) nc *= 2;
            nv = (WRkRow *)realloc(v, (size_t)nc * sizeof(WRkRow));
            if (!nv) {
                free(ids);
                continue;
            }
            v = nv;
            cap = nc;
        }
        for (j = 0; j < m; j++) {
            int32_t p = tb_rid_pos(rt, ids[j]);
            if (p < 0) continue;
            v[n].tab = k->rtab;
            v[n].pos = (uint32_t)p;
            n++;
        }
        free(ids);
        handled[i] = 1;
    }
    /* a rule is handled when every lookup of it into ti is */
    for (i = 0; i < wb->nrkx; i++)
        if (wb->rkx[i].ktab == (int32_t)ti && handled[i]) wb->rules[wb->rkx[i].rule].dskip = 1;
    for (i = 0; i < wb->nrkx; i++)
        if (wb->rkx[i].ktab == (int32_t)ti && !handled[i]) wb->rules[wb->rkx[i].rule].dskip = 0;
    free(handled);
    if (n > 1) {
        uint32_t w = 1;
        qsort(v, n, sizeof(WRkRow), rkrow_cmp);
        for (i = 1; i < n; i++)
            if (v[i].tab != v[w - 1].tab || v[i].pos != v[w - 1].pos) v[w++] = v[i];
        n = w;
    }
    *out = v;
    wb->st.rkx_rows += n;
    return n;
}

/* The reader rows' contributions (one side) to the instances over their tables. */
static void wb_rkx_side(RtxWb *wb, const WRkRow *v, uint32_t n, int old, int side, WDlv *dl) {
    uint32_t i;
    for (i = 0; i < n; i++) {
        const WTab *t = &wb->tabs[v[i].tab];
        uint16_t fm = 0;
        int32_t c;
        for (c = 0; c < t->ncols; c++)
            if (t->cs[c].k[LK_FORMULA]) fm = (uint16_t)(fm | (1u << c));
        wb_dl_rows(wb, (uint32_t)v[i].tab, v[i].pos, v[i].pos + 1, old, side, dl, fm ? fm : 0xffff);
    }
}

/* After the deltas: the reader tables' other readers (lookups into them,
 * anchored cells, ranges, chains, key indexes over their formula columns),
 * and the handled rules' marks cleared. */
static void wb_rkx_after(RtxWb *wb, const WRkRow *v, uint32_t n) {
    uint32_t i;
    for (i = 0; i < n; i++) {
        WTab *t;
        uint16_t fm = 0;
        int32_t c;
        if (i && v[i].tab == v[i - 1].tab) continue;
        t = &wb->tabs[v[i].tab];
        for (c = 0; c < t->ncols; c++)
            if (t->cs[c].k[LK_FORMULA]) fm = (uint16_t)(fm | (1u << c));
        wb_cols_changed(wb, (uint32_t)v[i].tab, fm, 0);
        if (t->kx)
            for (c = 0; c < t->ncols; c++)
                if (t->kx[c] && (fm & (1u << c))) t->kx[c]->ok = 0;
        if (t->ch.on && (t->ch.dep & fm)) wb_chain_dirty(wb, (uint32_t)v[i].tab, tb_bpos(t, v[i].pos));
    }
    for (i = 0; i < wb->nrules; i++) wb->rules[i].dskip = 0;
}

/* ---- the cell path */

static int wb_type_snapshot(const WTab *t, uint8_t *ct, uint8_t *csc) {
    int32_t c;
    for (c = 0; c < t->ncols; c++) {
        ct[c] = t->ct[c];
        csc[c] = t->csc[c];
    }
    return 1;
}

/* A cell edit: the union lies inside one body cell. 0: not this path. */
static int wb_fast_cell(RtxWb *wb, uint32_t ti, uint32_t r) {
    WTab *t = &wb->tabs[ti];
    WCap *cp = &wb->cap;
    size_t lo = wb->p_lo, old_n = wb->p_old, new_n = wb->p_new;
    ptrdiff_t delta = (ptrdiff_t)new_n - (ptrdiff_t)old_n;
    size_t rlo = tb_row_lo(t, r);
    uint32_t rlen = tb_row_len(t, r), rid = tb_row_rid(t, r), w0, w1, i;
    size_t nlen;
    char *nb;
    WRow orow, nrow;
    uint8_t ot[RTX_WB_COLS_MAX], osc[RTX_WB_COLS_MAX];
    WVal ov[RTX_WB_COLS_MAX], nv[RTX_WB_COLS_MAX];
    uint16_t nz, chg = 0, colmask = 0, emask = 0;
    int32_t c, ecol = -1;
    int kxs = 0;
    WDlv dl;
    WRkRow *rk = NULL;
    uint32_t nrk = 0;
    if (!cp->ok || cp->tab != (int32_t)ti || r < cp->pos || r >= cp->pos + cp->n) return 0;
    if (lo < rlo || lo + old_n > rlo + rlen) return 0;
    /* the new row: one line, the same number of cells */
    if ((ptrdiff_t)rlen + delta < 0) return 0;
    nlen = (size_t)((ptrdiff_t)rlen + delta);
    nb = wb_read_tmp(wb, rlo, nlen);
    if (!nb) return 0;
    for (i = 0; i < nlen; i++)
        if (nb[i] == '\n') return 0;
    {
        WRow tmp;
        uint32_t k = r - cp->pos;
        memset(&orow, 0, offsetof(WRow, v));
        orow.b = cp->b + cp->roff[k];
        orow.n = cp->roff[k + 1] - cp->roff[k];
        if (orow.n && orow.b[orow.n - 1] == '\n') orow.n--;
        wb_row_split(&orow);
        memset(&tmp, 0, offsetof(WRow, v));
        tmp.b = nb;
        tmp.n = (uint32_t)nlen;
        wb_row_split(&tmp);
        if (tmp.nc != orow.nc) return 0;
        /* the edit stays inside one cell of the old row */
        {
            size_t e0 = lo - rlo, e1 = e0 + old_n;
            int in1 = 0;
            for (c = 0; c < orow.nc; c++)
                if (e0 >= orow.clo[c] && e1 <= orow.chi[c]) {
                    in1 = 1;
                    colmask = (uint16_t)(colmask | (1u << c));
                    if (ecol < 0) ecol = c;
                }
            if (!in1) return 0;
            emask = colmask;
            /* the anchor tag (first cell) is no column value */
            /* the anchor mark must not change shape (its span is structure) */
            if ((orow.ahi > orow.alo) != (tmp.ahi > tmp.alo)) {
                /* an anchor added / removed: still a cell edit (anchors
                 * are index entries) */
            }
        }
    }
    memset(&dl, 0, sizeof dl);
    /* the columns whose values this edit can move: its own, and every
     * column holding a formula (one may read it, or read a neighbour) */
    for (c = 0; c < t->ncols; c++)
        if (t->cs[c].k[LK_FORMULA]) colmask = (uint16_t)(colmask | (1u << c));
    if (!colmask) colmask = 0xffff;
    wb->st.fast_cell++;
    wb->dl_serial0 = g_wb_inst_serial;
    /* --- the old side */
    wb->ov.on = 1;
    wb->ov.tab = (int32_t)ti;
    wb->ov.a = r;
    wb->ov.nold = wb->ov.nnew = 1;
    wb->ov.at = lo;
    wb->ov.old_end = lo + old_n;
    wb->ov.delta = delta;
    wb->opgen++;
    w0 = r > t->relf ? r - t->relf : 0;
    w1 = r + 1 + t->relb < t->nrows ? r + 1 + t->relb : t->nrows;
    wb_dl_rows(wb, ti, w0, w1, 1, 0, &dl, colmask);
    /* lookup readers in other tables: only the rows whose probe is this
     * row's key (old side: the lookup sees the captured row) */
    nrk = wb_rkx_rows(wb, ti, r, ecol, &rk);
    wb_rkx_side(wb, rk, nrk, 1, 0, &dl);
    wb_row_values(wb, ti, r, 1, ov, &nz);
    wb_type_snapshot(t, ot, osc);
    /* --- the model moves */
    wb->ov.on = 0;
    wb->opgen++;
    wb_shift(wb, lo, old_n, delta);
    memset(&orow, 0, offsetof(WRow, v));
    {
        uint32_t k = r - cp->pos;
        orow.b = cp->b + cp->roff[k];
        orow.n = cp->roff[k + 1] - cp->roff[k];
        if (orow.n && orow.b[orow.n - 1] == '\n') orow.n--;
        orow.tab = (int32_t)ti;
        orow.pos = (int32_t)r;
        orow.rid = rid;
        wb_row_split(&orow);
    }
    wb_row_load(wb, &nrow, (int32_t)ti, r, 0);
    wb_row_account(wb, ti, &orow, -1, 0);
    wb_row_account(wb, ti, &nrow, 1, 1);
    for (c = 0; c < t->ncols; c++) wb_col_type(&t->cs[c], &t->ct[c], &t->csc[c]);
    if (wb->graph_dirty) {
        wb_rules_gc(wb);
        wb_tab_aggs(wb);
        if (!wb_regraph(wb, 1)) {
            free(rk);
            free(dl.e);
            return 0;
        }
    }
    /* --- the new side */
    wb->opgen++;
    wb_row_values(wb, ti, r, 0, nv, &nz);
    for (c = 0; c < t->ncols; c++) {
        if (!wv_same(&ov[c], &nv[c])) chg |= (uint16_t)(1u << c);
        if (t->kx && t->kx[c] && !wv_same(&ov[c], &nv[c])) {
            wb_kx_move(wb, ti, c, rid, &ov[c], &nv[c]);
            kxs = 1;
        }
    }
    (void)kxs;
    /* the key indexes hold the new keys before the new side reads them
     * (a table whose rows read their neighbours: rebuilt at the next probe) */
    if (t->relmask && t->kx)
        for (c = 0; c < t->ncols; c++)
            if (t->kx[c]) t->kx[c]->ok = 0;
    wb_dl_rows(wb, ti, w0, w1, 0, 1, &dl, colmask);
    wb_rkx_side(wb, rk, nrk, 0, 1, &dl);
    wb_dl_settle(wb, &dl);
    free(dl.e);
    /* a reader table's own edit moves its probes */
    wb_rkx_touch(wb, ti, emask);
    /* relative readers: their rows may have moved too */
    if (t->relmask && chg) {
        chg |= (uint16_t)0xffff;
        /* neighbours' values moved without an edit in their rows: key
         * indexes over this table rebuild at their next probe */
        if (t->kx)
            for (c = 0; c < t->ncols; c++)
                if (t->kx[c]) t->kx[c]->ok = 0;
    }
    wb_cols_changed(wb, ti, chg, 0);
    wb_rkx_after(wb, rk, nrk);
    free(rk);
    for (c = 0; c < t->ncols; c++)
        if (t->ct[c] != ot[c] || t->csc[c] != osc[c]) wb_cols_changed(wb, ti, (uint16_t)(1u << c), 1);
    if (t->ch.on) {
        wb_chain_dirty(wb, ti, tb_bpos(t, r));
        for (i = 0; i < t->naggs; i++)
            if (wb->aggs[t->aggs[i]].live && wb->aggs[t->aggs[i]].blockmode)
                wb_push(wb, wb->aggs[t->aggs[i]].node, 0);
    }
    wb->mgen++;
    return 1;
}


/* ---- the rows path: whole body rows replaced by pipe rows */

/* Every instance over table ti: block `from` merged into block `into`
 * (their counts add, the better best stays). */
static void wb_inst_merge_blocks(RtxWb *wb, uint32_t ti, uint32_t into, uint32_t from) {
    WTab *t = &wb->tabs[ti];
    uint32_t i, j;
    for (i = 0; i < t->naggs; i++) {
        WAgg *a = &wb->aggs[t->aggs[i]];
        if (!a->live) continue;
        for (j = 0; j < a->ninst; j++) {
            WInst *in = a->inst[j];
            if (!in || !in->live) continue;
            inst_fit(wb, a, in);
            if (in->lstop && in->lstop[from]) {
                if (!in->lstop[into]) in->nstop++;
                in->lstop[into] += in->lstop[from];
                in->lstop[from] = 0;
                in->nstop--;
            }
            if (in->lbest && wb_better(wb, a->tab, a->o.fn, &in->lbest[from], &in->lbest[into]))
                in->lbest[into] = in->lbest[from];
            if (in->lbest) in->lbest[from].has = 0;
            if (a->grp) gbm_blocks_moved(wb, a, in, from, into, 1);
            if (in->lresc && in->lresc[from]) {
                in->lresc[into] = 1;
                in->anyresc = 1;
                in->lresc[from] = 0;
            }
            if (in->lacc) {
                acc_merge(&in->lacc[into], &in->lacc[from], 1);
                acc_reset(&in->lacc[from]);
            }
            if (in->ldone && in->ldone[into] != in->ldone[from]) {
                /* a block half built: that build starts over */
                in->full = 1;
            }
            in->segp = 0;
        }
    }
    if (t->ch.on && t->ch.ck) {
        /* the merged block ends where `from` ended */
        uint32_t sl = ch_slots(&t->ch);
        if (from < t->ch.ckcap && into < t->ch.ckcap) {
            memcpy(t->ch.ck + (size_t)into * sl, t->ch.ck + (size_t)from * sl, sl * sizeof(WVal));
            t->ch.ckok[into] = t->ch.ckok[from];
            t->ch.ckok[from] = 0;
        }
    }
}

/* Block bid split: pieces (new ids) rescanned at the next publish. */
static void wb_inst_split_block(RtxWb *wb, uint32_t ti, uint32_t bid, uint32_t nbid) {
    WTab *t = &wb->tabs[ti];
    uint32_t i, j;
    for (i = 0; i < t->naggs; i++) {
        WAgg *a = &wb->aggs[t->aggs[i]];
        if (!a->live) continue;
        for (j = 0; j < a->ninst; j++) {
            WInst *in = a->inst[j];
            if (!in || !in->live) continue;
            inst_fit(wb, a, in);
            if (a->grp) gbm_blocks_moved(wb, a, in, bid, nbid, 0);
            if (in->ldone) in->ldone[nbid] = in->ldone[bid];
            if (in->lstop && in->lstop[bid]) {
                uint8_t *lr = inst_lresc(in);
                if (lr) lr[bid] = lr[nbid] = 1;
                in->anyresc = 1;
            }
            if (in->lbest) {
                uint8_t *lr = inst_lresc(in);
                if (lr) lr[bid] = lr[nbid] = 1;
                in->anyresc = 1;
            }
            if (in->lacc) {
                /* the pieces' partials: recounted from their rows */
                uint8_t *lr = inst_lresc(in);
                if (lr) lr[bid] = lr[nbid] = 1;
                in->anyresc = 1;
            }
            in->segp = 0;
        }
    }
    if (t->ch.on && t->ch.ckok) {
        ch_fit(t);
        /* the second piece ends where the block ended */
        {
            uint32_t sl = ch_slots(&t->ch);
            memcpy(t->ch.ck + (size_t)nbid * sl, t->ch.ck + (size_t)bid * sl, sl * sizeof(WVal));
            t->ch.ckok[nbid] = t->ch.ckok[bid];
            t->ch.ckok[bid] = 0;
            ch_mark(t, bid);
            ch_mark(t, nbid);
        }
    }
}

/* Recount block bid of instance `in` (stops, best, the block partial). */
static void inst_block_recount(RtxWb *wb, const WAgg *a, WInst *in, uint32_t bid) {
    if (a->blockmode) return; /* the chain job recounts it */
    if (in->lacc && !a->grp) {
        const WTab *t = &wb->tabs[a->tab];
        const WBlock *b = &t->blk[bid];
        ECtx c;
        uint32_t s, p0 = t->bfirst[b->pos];
        WBest best;
        inst_ctx(wb, a, in, &c, 0);
        acc_merge(&in->a, &in->lacc[bid], -1);
        acc_reset(&in->lacc[bid]);
        memset(&best, 0, sizeof best);
        for (s = 0; s < b->n; s++) {
            WRow rr;
            WCon k;
            wb_row_load(wb, &rr, a->tab, p0 + s, 0);
            wb_con(&c, &a->o, &rr, &k);
            acc_apply(&in->lacc[bid], &a->o, &k, 1);
            wb_acc_best(wb, a->tab, &a->o, &best, &k, rr.rid);
        }
        acc_merge(&in->a, &in->lacc[bid], 1);
        if (in->lbest) {
            best.v = wv_keep_in(in->ar, best.v);
            in->lbest[bid] = best;
        }
        {
            uint32_t st = in->lacc[bid].stop;
            if (st || in->lstop) {
                uint32_t *ls = inst_lstop(wb, a, in);
                if (ls) {
                    if (ls[bid] && !st) in->nstop--;
                    if (!ls[bid] && st) in->nstop++;
                    ls[bid] = st;
                }
            }
        }
        in->bestok = 0;
        in->segp = 0;
        if (in->lresc) in->lresc[bid] = 0;
        return;
    }
    inst_block_rescan(wb, a, in, bid);
}

/* The rescans a split / a lost best left: done before a value is read. */
static void wb_inst_rescans(RtxWb *wb, uint32_t ti) {
    WTab *t = &wb->tabs[ti];
    uint32_t i, j, k;
    for (i = 0; i < t->naggs; i++) {
        WAgg *a = &wb->aggs[t->aggs[i]];
        if (!a->live) continue;
        for (j = 0; j < a->ninst; j++) {
            WInst *in = a->inst[j];
            if (!in || !in->live || !in->anyresc || in->full) continue;
            for (k = 0; k < t->nb; k++) {
                uint32_t bid = t->bord[k];
                if (in->lresc && in->lresc[bid]) {
                    if (in->building && in->ldone && !in->ldone[bid]) {
                        in->lresc[bid] = 0;
                        continue;
                    }
                    inst_block_recount(wb, a, in, bid);
                }
            }
            in->anyresc = 0;
            in->bestok = 0;
        }
    }
}

/* Replace rows [a, a + nold) of table ti by nnew rows starting at the
 * absolute offsets nst (lengths nlen); bytes after the old window moved
 * by delta. New row ids into rids. The blocks the window touches are
 * rebuilt as one and split again. */
static int tb_rows_replace(RtxWb *wb, uint32_t ti, uint32_t a, uint32_t nold, const size_t *nst,
                           const uint32_t *nlen, uint32_t nnew, ptrdiff_t delta, uint32_t *rids) {
    WTab *t = &wb->tabs[ti];
    uint32_t k0, k1, k, total = 0, i, bid0, at = 0;
    size_t *st = NULL;
    uint32_t *ln = NULL, *ri = NULL;
    if (!t->nb) {
        uint32_t bid = tb_blk_new(t);
        if (bid == WN32 || !tb_bord_ins(t, 0, bid)) return 0;
        tb_reindex(t, 0);
    }
    if (a >= t->nrows) {
        k0 = k1 = t->nb - 1;
    } else {
        k0 = tb_bpos(t, a);
        k1 = nold ? tb_bpos(t, a + nold - 1) : k0;
    }
    for (k = k0; k <= k1; k++) total += t->blk[t->bord[k]].n;
    total = total - nold + nnew;
    st = (size_t *)cc_arena_alloc(wb->sa, (size_t)(total + 1) * sizeof(size_t), 16);
    ln = (uint32_t *)cc_arena_alloc(wb->sa, (size_t)(total + 1) * sizeof(uint32_t), 16);
    ri = (uint32_t *)cc_arena_alloc(wb->sa, (size_t)(total + 1) * sizeof(uint32_t), 16);
    if (!st || !ln || !ri) return 0;
    if (!tb_rid_room(t, t->nrid + nnew)) return 0;
    /* the dropped rows' ids die */
    for (i = a; i < a + nold && i < t->nrows; i++) t->rloc[tb_row_rid(t, i)].bid = WN32;
    /* the rows of blocks k0..k1: before a, the new ones, after the window */
    at = 0;
    for (k = k0; k <= k1; k++) {
        const WBlock *b = &t->blk[t->bord[k]];
        uint32_t s;
        for (s = 0; s < b->n; s++) {
            uint32_t r = t->bfirst[k] + s;
            if (r >= a) break;
            st[at] = b->lo + b->rrel[s];
            ln[at] = b->rlen[s];
            ri[at++] = b->rid[s];
        }
    }
    for (i = 0; i < nnew; i++) {
        uint32_t rid = t->nrid++;
        st[at] = nst[i];
        ln[at] = nlen[i];
        ri[at++] = rid;
        t->rloc[rid].bid = WN32;
        if (rids) rids[i] = rid;
    }
    for (k = k0; k <= k1; k++) {
        const WBlock *b = &t->blk[t->bord[k]];
        uint32_t s;
        for (s = 0; s < b->n; s++) {
            uint32_t r = t->bfirst[k] + s;
            if (r < a + nold) continue;
            st[at] = (size_t)((ptrdiff_t)(b->lo + b->rrel[s]) + delta);
            ln[at] = b->rlen[s];
            ri[at++] = b->rid[s];
        }
    }
    /* blocks k0+1..k1 merge into k0 (their per-instance state too) */
    bid0 = t->bord[k0];
    for (k = k1; k > k0; k--) {
        uint32_t b = t->bord[k];
        wb_inst_merge_blocks(wb, ti, bid0, b);
        tb_bord_del(t, k);
        tb_blk_free(t, b);
    }
    {
        WBlock *b = &t->blk[bid0];
        if (!blk_reserve(b, at ? at : 1)) return 0;
        b->n = at;
        b->lo = at ? st[0] : b->lo;
        for (i = 0; i < at; i++) {
            b->rrel[i] = (uint32_t)(st[i] - b->lo);
            b->rlen[i] = ln[i];
            b->rid[i] = ri[i];
            t->rloc[ri[i]].bid = bid0;
            t->rloc[ri[i]].slot = i;
        }
    }
    /* the blocks after the window: their bytes moved */
    for (k = k0 + 1; k < t->nb; k++) {
        WBlock *b = &t->blk[t->bord[k]];
        b->lo = (size_t)((ptrdiff_t)b->lo + delta);
    }
    /* an empty block goes (unless it is the only one) */
    if (!t->blk[bid0].n && t->nb > 1) {
        uint32_t nb2 = k0 + 1 < t->nb ? t->bord[k0 + 1] : t->bord[k0 - 1];
        wb_inst_merge_blocks(wb, ti, nb2, bid0);
        tb_bord_del(t, k0);
        tb_blk_free(t, bid0);
        if (k0 >= t->nb) k0 = t->nb - 1;
        tb_reindex(t, k0 ? k0 - 1 : 0);
        return 1;
    }
    /* split above WB_BLK_MAX */
    while (t->blk[bid0].n > WB_BLK_MAX) {
        WBlock *b = &t->blk[bid0];
        uint32_t keep = WB_BLK, move = b->n - keep, nb = tb_blk_new(t), s;
        WBlock *nbk;
        if (nb == WN32) return 0;
        b = &t->blk[bid0];
        nbk = &t->blk[nb];
        if (!blk_reserve(nbk, move)) return 0;
        nbk->lo = b->lo + b->rrel[keep];
        for (s = 0; s < move; s++) {
            nbk->rrel[s] = (uint32_t)(b->lo + b->rrel[keep + s] - nbk->lo);
            nbk->rlen[s] = b->rlen[keep + s];
            nbk->rid[s] = b->rid[keep + s];
            t->rloc[nbk->rid[s]].bid = nb;
            t->rloc[nbk->rid[s]].slot = s;
        }
        nbk->n = move;
        b->n = keep;
        if (!tb_bord_ins(t, k0 + 1, nb)) return 0;
        tb_reindex(t, k0);
        wb_inst_split_block(wb, ti, bid0, nb);
        /* the rest may still be too big: split it next */
        k0++;
        bid0 = nb;
    }
    /* merge a small block into a neighbour (not while a build runs) */
    if (!t->nomerge && t->blk[bid0].n < WB_BLK_MIN && t->nb > 1) {
        uint32_t kk = t->blk[bid0].pos;
        uint32_t nbr = kk + 1 < t->nb ? t->bord[kk + 1] : t->bord[kk - 1];
        uint32_t first = kk + 1 < t->nb ? bid0 : nbr, second = kk + 1 < t->nb ? nbr : bid0;
        if (t->blk[first].n + t->blk[second].n <= WB_BLK_MAX) {
            WBlock *f = &t->blk[first], *sc = &t->blk[second];
            uint32_t s, base = f->n;
            if (!blk_reserve(f, f->n + sc->n)) return 0;
            for (s = 0; s < sc->n; s++) {
                f->rrel[base + s] = (uint32_t)(sc->lo + sc->rrel[s] - f->lo);
                f->rlen[base + s] = sc->rlen[s];
                f->rid[base + s] = sc->rid[s];
                t->rloc[sc->rid[s]].bid = first;
                t->rloc[sc->rid[s]].slot = base + s;
            }
            f->n += sc->n;
            sc->n = 0;
            wb_inst_merge_blocks(wb, ti, first, second);
            tb_bord_del(t, t->blk[second].pos);
            tb_blk_free(t, second);
        }
    }
    tb_reindex(t, 0);
    return 1;
}

/* Whole rows of one table replaced by new pipe rows (an insert, a delete,
 * a move, several at once). 0: not this path. */
static int wb_fast_rows(RtxWb *wb) {
    size_t lo = wb->p_lo, old_n = wb->p_old, new_n = wb->p_new, end = lo + old_n;
    ptrdiff_t delta = (ptrdiff_t)new_n - (ptrdiff_t)old_n;
    WCap *cp = &wb->cap;
    uint32_t ti, nk = 0, k, n, w0, w1, a, b, i;
    WTab *t = NULL;
    size_t pos, wn, x0, x1, *nst;
    uint32_t *nlen, *rids;
    char *buf;
    uint8_t ot[RTX_WB_COLS_MAX], osc[RTX_WB_COLS_MAX];
    int32_t c;
    WDlv dl;
    for (ti = 0; ti < wb->ntab; ti++) {
        WTab *x = &wb->tabs[ti];
        if (x->big || !x->nrows) continue;
        if (lo >= tb_row_lo(x, 0) && end <= x->hi) {
            t = x;
            break;
        }
    }
    if (!t || !cp->ok || cp->tab != (int32_t)ti) return 0;
    n = t->nrows;
    if (!t->lastnl) return 0; /* the last row ends the file without a NL */
    /* old window: whole rows a .. b-1 */
    {
        int32_t ra = tb_row_at(t, lo);
        if (ra < 0) return 0;
        a = (uint32_t)ra;
    }
    b = a;
    while (b < n && tb_row_lo(t, b) < end) b++;
    x0 = tb_row_lo(t, a);
    for (;;) {
        x1 = b < n ? tb_row_lo(t, b) : t->hi;
        if (x1 < end) return 0;
        wn = (size_t)((ptrdiff_t)(x1 - x0) + delta);
        buf = wb_read_tmp(wb, x0, wn);
        if (!buf) return 0;
        if (!wn || buf[wn - 1] == '\n') break;
        if (b >= n) return 0;
        b++;
    }
    /* the captured rows cover the window and the neighbours' margin */
    if (a < cp->pos || b > cp->pos + cp->n) return 0;
    /* the new lines: pipe rows, each ending in NL */
    for (pos = 0; pos < wn;) {
        size_t e = pos, ce;
        while (e < wn && buf[e] != '\n') e++;
        ce = e;
        if (ce > pos && buf[ce - 1] == '\r') ce--;
        if (wb_blank(buf + pos, ce - pos) || !rtx_md_line_pipe(buf + pos, ce - pos)) return 0;
        nk++;
        pos = e + 1;
    }
    if (!nk && a == b) return 0;
    if ((int64_t)n - (b - a) + nk < 1 || (int64_t)n - (b - a) + nk > g_wb_rows_max) return 0;
    nst = (size_t *)cc_arena_alloc(wb->sa, (size_t)(nk + 1) * sizeof(size_t), 16);
    nlen = (uint32_t *)cc_arena_alloc(wb->sa, (size_t)(nk + 1) * sizeof(uint32_t), 16);
    rids = (uint32_t *)cc_arena_alloc(wb->sa, (size_t)(nk + 1) * sizeof(uint32_t), 16);
    if (!nst || !nlen || !rids) return 0;
    for (pos = 0, k = 0; k < nk; k++) {
        size_t e = pos;
        while (e < wn && buf[e] != '\n') e++;
        nst[k] = x0 + pos;
        nlen[k] = (uint32_t)(e - pos);
        pos = e + 1;
    }
    memset(&dl, 0, sizeof dl);
    wb->st.fast_rows++;
    wb->dl_serial0 = g_wb_inst_serial;
    /* --- the old side: the window and its neighbours leave */
    wb->ov.on = 1;
    wb->ov.tab = (int32_t)ti;
    wb->ov.a = a;
    wb->ov.nold = b - a;
    wb->ov.nnew = nk;
    wb->ov.at = x0;
    wb->ov.old_end = x1;
    wb->ov.delta = delta;
    wb->opgen++;
    w0 = a > t->relf ? a - t->relf : 0;
    w1 = b + t->relb < n ? b + t->relb : n;
    /* the overlay covers the captured rows: rows the capture holds read
     * from it */
    wb->ov.a = cp->pos;
    wb->ov.nold = cp->n;
    wb_dl_rows(wb, ti, w0, w1, 1, 0, &dl, 0xffff);
    for (i = 0; i < dl.n; i++) wb_dl_apply(wb, &dl.e[i], -1);
    for (i = 0; i < dl.n; i++) wb_push(wb, wb->aggs[dl.e[i].ai].node, 0);
    dl.n = 0;
    /* old keys out of the key indexes, old rows out of the stats */
    for (i = a; i < b; i++) {
        uint32_t kk = i - cp->pos;
        WRow orow;
        memset(&orow, 0, offsetof(WRow, v));
        orow.b = cp->b + cp->roff[kk];
        orow.n = cp->roff[kk + 1] - cp->roff[kk];
        if (orow.n && orow.b[orow.n - 1] == '\n') orow.n--;
        orow.tab = (int32_t)ti;
        orow.pos = (int32_t)i;
        orow.rid = cp->rid[kk];
        orow.old = 1;
        wb_row_split(&orow);
        if (t->kx) {
            WVal ov[RTX_WB_COLS_MAX];
            uint16_t nz;
            wb_row_values(wb, ti, i, 1, ov, &nz);
            for (c = 0; c < t->ncols; c++)
                if (t->kx[c]) wb_kx_move(wb, ti, c, orow.rid, &ov[c], NULL);
        }
        wb_row_account(wb, ti, &orow, -1, 0);
    }
    wb_type_snapshot(t, ot, osc);
    /* --- the model moves */
    wb->ov.on = 0;
    wb->opgen++;
    if (!tb_rows_replace(wb, ti, a, b - a, nst, nlen, nk, delta, rids)) return 0;
    t = &wb->tabs[ti];
    wb_shift_ge(wb, x1, delta, ti);
    for (k = 0; k < nk; k++) {
        WRow nrow;
        wb_row_load(wb, &nrow, (int32_t)ti, a + k, 0);
        wb_row_account(wb, ti, &nrow, 1, 1);
    }
    for (c = 0; c < t->ncols; c++) wb_col_type(&t->cs[c], &t->ct[c], &t->csc[c]);
    /* a cycle's path names rows: they moved */
    if (wb->ncyv) wb->graph_dirty = 1;
    if (wb->graph_dirty) {
        wb_rules_gc(wb);
        wb_tab_aggs(wb);
        if (!wb_regraph(wb, 1)) return 0;
    }
    wb_inst_rescans(wb, ti);
    /* --- the new side: the window and its neighbours arrive */
    wb->opgen++;
    {
        uint32_t n2 = t->nrows, v0 = a > t->relf ? a - t->relf : 0;
        uint32_t v1 = a + nk + t->relb < n2 ? a + nk + t->relb : n2;
        /* the key indexes take the new rows before the new side reads */
        if (t->kx && t->relmask) {
            for (c = 0; c < t->ncols; c++)
                if (t->kx[c]) t->kx[c]->ok = 0;
        } else if (t->kx) {
            for (k = 0; k < nk; k++) {
                WVal nv[RTX_WB_COLS_MAX];
                uint16_t nz;
                wb_row_values(wb, ti, a + k, 0, nv, &nz);
                for (c = 0; c < t->ncols; c++)
                    if (t->kx[c]) wb_kx_move(wb, ti, c, rids[k], NULL, &nv[c]);
            }
        }
        wb_dl_rows(wb, ti, v0, v1, 0, 1, &dl, 0xffff);
        for (i = 0; i < dl.n; i++) wb_dl_apply(wb, &dl.e[i], 1);
        for (i = 0; i < dl.n; i++) wb_push(wb, wb->aggs[dl.e[i].ai].node, 0);
        for (i = 0; i < dl.n; i++)
            if (dl_inst(wb, &dl.e[i]) && dl.e[i].in->full) wb_push(wb, wb->aggs[dl.e[i].ai].node, 1);
        dl.n = 0;
    }
    free(dl.e);
    wb_inst_rescans(wb, ti);
    /* rows came and went: reader indexes over this table rebuild */
    wb_rkx_touch(wb, ti, 0xffff);
    if (t->relmask && t->kx) {
        /* rows around the edit read their neighbours: key indexes rebuild */
        int32_t kc;
        for (kc = 0; kc < t->ncols; kc++)
            if (t->kx[kc]) t->kx[kc]->ok = 0;
    }
    wb_cols_changed(wb, ti, (uint16_t)0xffff, 0);
    for (c = 0; c < t->ncols; c++)
        if (t->ct[c] != ot[c] || t->csc[c] != osc[c]) wb_cols_changed(wb, ti, (uint16_t)(1u << c), 1);
    if (t->ch.on) {
        uint32_t k0 = a < t->nrows ? tb_bpos(t, a) : t->nb - 1;
        wb_chain_dirty(wb, ti, k0);
        if (wb->ov.nold != wb->ov.nnew && t->ch.ck && t->nb) {
            /* rows moved: a carried error names its row by position, so a
             * block whose checkpoint holds one cannot be skipped by a
             * convergence above it (its text changes with the shift) */
            uint32_t k, q, sl = ch_slots(&t->ch);
            for (k = k0 + 1; k < t->nb; k++) {
                uint32_t bid = t->bord[k];
                if (bid >= t->ch.ckcap || !t->ch.ckok[bid]) continue;
                for (q = 0; q < sl; q++)
                    if (t->ch.ck[(size_t)bid * sl + q].t == WV_ERR) {
                        ch_mark(t, bid);
                        break;
                    }
            }
        }
        for (i = 0; i < t->naggs; i++)
            if (wb->aggs[t->aggs[i]].live && wb->aggs[t->aggs[i]].blockmode)
                wb_push(wb, wb->aggs[t->aggs[i]].node, 0);
    }
    /* a block right after the table: its line-before is the last row */
    for (i = 0; i < wb->nblk; i++) {
        WBlk *bk = &wb->blks[i];
        if (bk->lo == t->hi && bk->ext_lo < t->hi) bk->ext_lo = tb_row_lo(t, t->nrows - 1);
    }
    wb->mgen++;
    return 1;
}


/* ---- lines, prose, the dispatcher */

/* Aggregates of a formula that is gone or re-bound: dead (instances freed). */
static void wb_aggs_kill(RtxWb *wb, const uint32_t *aggs, uint32_t n) {
    uint32_t i, j;
    for (i = 0; i < n; i++) {
        WAgg *a = &wb->aggs[aggs[i]];
        if (!a->live) continue;
        a->live = 0;
        for (j = 0; j < a->ninst; j++) inst_free(a->inst[j]);
        free(a->inst);
        a->inst = NULL;
        a->ninst = a->instcap = 0;
        wb->g[a->node].kind = GN_DEAD;
        wb->g[a->node].ndeps = 0;
        wb->graph_dirty = 1;
    }
}

/* Rules no row uses any more: their aggregates die with them (a rule that
 * comes back re-binds). */
static void wb_rules_gc(RtxWb *wb) {
    uint32_t i;
    for (i = 0; i < wb->nrules; i++) {
        WRule *r = &wb->rules[i];
        if (r->refs || r->dead) continue;
        wb_aggs_kill(wb, r->aggs, r->naggs);
        r->aggs = NULL;
        r->naggs = 0;
        r->dead = 1;
        wb->g[r->node].ndeps = 0;
    }
}

/* A params / calc line edit that keeps the line's name. */
static int wb_fast_line(RtxWb *wb, uint32_t ni) {
    WName *n = &wb->names[ni];
    size_t old_n = wb->p_old, new_n = wb->p_new;
    ptrdiff_t delta = (ptrdiff_t)new_n - (ptrdiff_t)old_n;
    size_t nhi = (size_t)((ptrdiff_t)n->raw_hi + delta), rn, i;
    size_t nlo, nhi2, elo, ehi;
    char *raw;
    int def, had;
    if (nhi < n->raw_lo) return 0;
    rn = nhi - n->raw_lo;
    raw = wb_read_tmp(wb, n->raw_lo, rn);
    if (!raw) return 0;
    for (i = 0; i < rn; i++)
        if (raw[i] == '\n') return 0;
    if (rn && raw[rn - 1] == '\r') rn--;
    def = wb_def_parse(raw, rn, &nlo, &nhi2, &elo, &ehi);
    if (!n->def) {
        char ch;
        size_t run, a, b;
        if (def) return 0;
        if (wb_line_kind(raw, rn, &ch, &run, &a, &b) == WL_FENCE) return 0;
        wb_shift(wb, wb->p_lo, old_n, delta);
        wb->names[ni].raw_hi = nhi;
        wb->st.fast_line++;
        return 1;
    }
    if (!def) return 0;
    {
        const char *nm;
        size_t nmn;
        wb_name_copy(raw, nlo, nhi2, &nm, &nmn);
        if (nmn != n->namen || memcmp(nm, n->name, nmn) != 0) return 0;
    }
    had = !n->lit && n->f_hi > n->f_lo;
    wb_shift(wb, wb->p_lo, old_n, delta);
    n = &wb->names[ni];
    n->raw_hi = nhi;
    n->n_lo = n->raw_lo + nlo;
    n->n_hi = n->raw_lo + nhi2;
    n->src_lo = n->raw_lo + elo;
    n->f_lo = n->raw_lo + elo;
    n->f_hi = n->raw_lo + ehi;
    wb->st.fast_line++;
    if (n->clash) return 1;
    if (ehi - elo == n->srcn && !memcmp(raw + elo, n->src, n->srcn)) {
        if (n->lit) n->f_lo = n->f_hi = WNONE;
        return 1;
    }
    /* a group's readers bound its outputs by name: a group edit reparses */
    if (wb_group_sig(wb, ni) || wb_src_group(raw + elo, ehi - elo)) return 0;
    n = &wb->names[ni];
    wb_aggs_kill(wb, n->aggs, n->naggs);
    n->src = wb_copy(wb, raw + elo, ehi - elo, &n->srcn);
    wb_bind(wb, BK_NAME, ni);
    n = &wb->names[ni];
    n->lit = (uint8_t)wb_ex_literal(n->ex);
    if (n->lit) n->f_lo = n->f_hi = WNONE;
    if (had != (!n->lit)) wb->nderived += had ? (uint32_t)-1 : 1u;
    wb_kx_want_ex(wb, n->ex);
    for (i = 0; i < n->naggs; i++) {
        WAgg *a = &wb->aggs[n->aggs[i]];
        if (!a->pmask && !a->ninst) inst_new(wb, a, NULL, 0);
        a->full = 1;
        wb_push(wb, a->node, 1);
    }
    wb_push(wb, n->node, 1);
    wb->mgen++;
    return 1;
}

/* An edit clear of every block (and of the line before / after each):
 * offsets shift, nothing recalcs — unless the new lines start structure. */
static int wb_fast_prose(RtxWb *wb) {
    size_t lo = wb->p_lo, old_n = wb->p_old, new_n = wb->p_new, len = RtxDoc_len(wb->doc);
    ptrdiff_t delta = (ptrdiff_t)new_n - (ptrdiff_t)old_n;
    uint32_t a = 0, b = wb->nblk;
    size_t ls, le, back, fwd, i;
    char *s;
    while (a < b) {
        uint32_t m = a + (b - a) / 2;
        if (wb->blks[m].ext_hi <= lo) a = m + 1;
        else b = m;
    }
    if (a < wb->nblk && wb->blks[a].ext_lo <= lo + old_n) return 0;
    back = lo < WB_SCAN_BACK ? lo : WB_SCAN_BACK;
    fwd = len - (lo + new_n) < WB_SCAN_BACK ? len - (lo + new_n) : WB_SCAN_BACK;
    if (back + new_n + fwd > WB_LINE_MAX) return 0;
    s = wb_read_tmp(wb, lo - back, back + new_n + fwd);
    if (!s) return 0;
    ls = back;
    while (ls > 0 && s[ls - 1] != '\n') ls--;
    if (ls == 0 && lo - back > 0) return 0;
    le = back + new_n;
    while (le < back + new_n + fwd && s[le] != '\n') le++;
    if (le == back + new_n + fwd && lo + new_n + fwd < len) return 0;
    for (i = ls; i < le;) {
        size_t e = i;
        char ch;
        size_t run, x, y;
        while (e < le && s[e] != '\n') e++;
        if (wb_line_kind(s + i, e - i, &ch, &run, &x, &y) != WL_NONE) return 0;
        if (e > i && rtx_md_line_pipe(s + i, e - i)) return 0; /* a table may start */
        i = e + 1;
    }
    wb_shift(wb, lo, old_n, delta);
    wb->st.fast_prose++;
    return 1;
}

static int wb_fast(RtxWb *wb) {
    size_t len = RtxDoc_len(wb->doc), lo = wb->p_lo, old_n = wb->p_old;
    int64_t k;
    int32_t ti;
    if (len > g_wb_max) return 0;
    if (wb->doc_len < old_n || wb->doc_len - old_n + wb->p_new != len) return 0;
    if (lo + old_n > wb->doc_len) return 0;
    k = wb_name_find(wb, lo);
    if (k >= 0) {
        const WName *n = &wb->names[k];
        if (lo >= n->raw_lo && lo + old_n <= n->raw_hi) return wb_fast_line(wb, (uint32_t)k);
    }
    ti = wb_tab_at(wb, lo);
    if (ti >= 0) {
        WTab *t = &wb->tabs[ti];
        if (!t->big && t->nrows && lo >= tb_row_lo(t, 0)) {
            int32_t r = tb_row_at(t, lo);
            if (r >= 0 && lo + old_n <= tb_row_lo(t, (uint32_t)r) + tb_row_len(t, (uint32_t)r) &&
                wb_fast_cell(wb, (uint32_t)ti, (uint32_t)r))
                return 1;
        }
    }
    if (wb_fast_rows(wb)) return 1;
    return wb_fast_prose(wb);
}

/* The recalc after a sync: regraph if rules moved, the heap, then jobs
 * while the inline budget lasts. */
static void wb_recalc_run(RtxWb *wb, int inline_all) {
    wb->inline_left = g_wb_inline;
    if (wb->graph_dirty) {
        wb_rules_gc(wb);
        wb_tab_aggs(wb);
        wb_regraph(wb, 1);
    }
    wb_recalc_heap(wb);
    /* the inline share: a budget of work units and a time box */
    wb_jobs_step(wb, inline_all ? 0 : wb_now_us() + (double)g_wb_slice_ms * 1000.0, wb->inline_left);
    if (inline_all) wb_settle(wb);
    wb->jobs = wb_jobs_left(wb);
}

/* Debug (RTX_WB_CHECK=1): the model's invariants after a sync — every
 * formula cell's rule is live with the right count, every column holds
 * exactly its live rules. The first break goes to stderr. */
static int g_wb_check = -1;

static void wb_check(RtxWb *wb, const char *where) {
    uint32_t ti, i, *cnt;
    if (g_wb_check < 0) g_wb_check = getenv("RTX_WB_CHECK") != NULL;
    if (!g_wb_check || wb->scan || wb->off) return;
    cnt = (uint32_t *)calloc(wb->nrules + 1, sizeof(uint32_t));
    if (!cnt) return;
    for (ti = 0; ti < wb->ntab; ti++) {
        const WTab *t = &wb->tabs[ti];
        uint32_t r;
        if (t->big || t->ext) continue;
        for (r = 0; r < t->nrows; r++) {
            WRow rr;
            int32_t c;
            wb_row_load(wb, &rr, (int32_t)ti, r, 0);
            for (c = 0; c < t->ncols; c++) {
                size_t lo, hi, slo, shi, flo, fhi;
                int ri;
                if (!wb_cell_span(&rr, c, &lo, &hi)) continue;
                if (!wb_cell_formula(rr.b, lo, hi, &slo, &shi, &flo, &fhi)) continue;
                ri = wb_rule_find(wb, (int32_t)ti, c, rr.b + slo, (uint32_t)(shi - slo));
                if (ri < 0 || wb->rules[ri].dead) {
                    fprintf(stderr, "wb_check(%s): %.*s row %u col %d: rule %s\n", where,
                            (int)t->namen, t->name, r + 1, c, ri < 0 ? "missing" : "dead");
                    continue;
                }
                cnt[ri]++;
            }
        }
    }
    for (i = 0; i < wb->nrules; i++) {
        const WRule *ru = &wb->rules[i];
        if (ru->dead) continue;
        if (ru->refs != cnt[i])
            fprintf(stderr, "wb_check(%s): rule %u (%.*s) refs %u, rows %u\n", where, i,
                    (int)ru->srcn, ru->src, ru->refs, cnt[i]);
    }
    if (!wb->graph_dirty) {
        for (ti = 0; ti < wb->ntab; ti++) {
            const WTab *t = &wb->tabs[ti];
            int32_t c;
            for (c = 0; c < t->ncols; c++) {
                const WGNode *g = &wb->g[t->cnode[c]];
                for (i = 0; i < wb->nrules; i++) {
                    const WRule *ru = &wb->rules[i];
                    uint32_t k;
                    int in = 0;
                    if (ru->dead || !ru->refs || ru->tab != (int32_t)ti || ru->col != c) continue;
                    for (k = 0; k < g->ndeps; k++)
                        if (g->deps[k] == ru->node) in = 1;
                    if (!in)
                        fprintf(stderr, "wb_check(%s): column %.*s.%d lacks rule %u (%.*s)\n", where,
                                (int)t->namen, t->name, c, i, (int)ru->srcn, ru->src);
                }
            }
        }
    }
    free(cnt);
}

/* paint: a caller on the keystroke path (the derived hooks, the status
 * line): a big workbook's reparse there is a job, never done inline. */
static void wb_sync_ex(RtxWb *wb, const RtxDoc *d, int paint) {
    double t0;
    int ok = 0;
    if (!wb || !d) return;
    if (wb->nuses && !wb->pend && !wb->need_rebuild && !wb->scan && !wb->off && !wb->imp_busy) {
        /* another workbook this one uses moved: its imports re-read */
        wb->imp_busy = 1;
        if (wb_imp_poll(wb, 0)) {
            wb->opgen++;
            wb_recalc_heap(wb);
            wb->opgen++;
        }
        wb->imp_busy = 0;
    }
    if (!wb->pend && !wb->need_rebuild) return;
    t0 = wb_now_us();
    wb->opgen++;
    if (wb->cancelled && wb->pend) wb_uncancel(wb);
    if (wb->scan) {
        /* a structural read runs: an edit past its cursor is read later */
        if (wb->pend && !wb->need_rebuild && wb->p_lo >= wb->scan->pos) {
            wb->pend = 0;
            wb->cap.ok = 0;
            return;
        }
        wb_rebuild(wb, paint);
        return;
    }
    wb->nchanged = 0;
    wb->chg_all = 0;
    wb->st.visited = 0;
    if (!wb->need_rebuild && !wb->off &&
        wb->ma_mark - wb->ma_base < (wb->ma_base > WB_GARBAGE_MIN ? wb->ma_base : WB_GARBAGE_MIN) &&
        wb->va_mark - wb->va_base < (wb->va_base > WB_GARBAGE_MIN ? wb->va_base : WB_GARBAGE_MIN))
        ok = wb_fast(wb);
    wb->pend = 0;
    wb->need_rebuild = 0;
    wb->cap.ok = 0;
    wb->ov.on = 0;
    if (!ok) {
        wb_rebuild(wb, paint);
    } else {
        wb->doc_len = RtxDoc_len(d);
        wb_recalc_run(wb, 0);
    }
    if (g_wb_check) wb_check(wb, ok ? "fast" : "rebuild");
    wb->sa.reset();
    wb->opgen++;
    wb->st.last_us = (size_t)(wb_now_us() - t0);
}


/* ------------------------------------------------------------ view cache
 *
 * The values painted cells showed (bounded, like the highlighter's window
 * cache): a cell asked for again in the same value generation is not
 * evaluated again; after a recalc, the entries are re-evaluated to find
 * which painted values changed (the layout relays only those).
 */

static uint32_t vc_slot(int32_t tab, uint32_t rid, int col) {
    uint64_t h = ((uint64_t)(uint32_t)tab * 0x9E3779B97F4A7C15ull) ^ ((uint64_t)rid << 5) ^ (uint64_t)col;
    h ^= h >> 29;
    h *= 0xBF58476D1CE4E5B9ull;
    h ^= h >> 32;
    return (uint32_t)h & (WB_VC_N - 1);
}

static int wb_vc_init(RtxWb *wb) {
    if (wb->vc) return 1;
    wb->vc = (WVc *)malloc((size_t)WB_VC_N * sizeof(WVc));
    if (!wb->vc) return 0;
    memset(wb->vc, 0xff, (size_t)WB_VC_N * sizeof(WVc));
    return 1;
}

/* The painted value (full: an error with its message — the annotation). */
static size_t wb_value_text(const WVal *v, char *g, size_t cap, int full) {
    char tmp[256];
    size_t n = wv_fmt(v, tmp, sizeof tmp, full);
    if (!g || !cap) return 0;
    if (n + 1 > cap) {
        size_t k = cap >= 4 ? cap - 4 : 0;
        while (k > 0 && ((unsigned char)tmp[k] & 0xC0) == 0x80) k--;
        memcpy(g, tmp, k);
        memcpy(g + k, "\xe2\x80\xa6", cap - 1 - k >= 3 ? 3 : 0);
        n = k + (cap - 1 - k >= 3 ? 3 : 0);
        g[n] = 0;
        return n;
    }
    memcpy(g, tmp, n + 1);
    return n;
}

#define WB_STALE_MARK "\xe2\x89\x88" /* ≈ */

/* A stale value's text: `≈` then the last value (`≈…` without one). */
static size_t wb_stale_text(const WVal *v, int nolast, char *g, size_t cap, int full) {
    size_t n;
    if (!g || cap < 8) return 0;
    memcpy(g, WB_STALE_MARK, 3);
    if (nolast) {
        memcpy(g + 3, "\xe2\x80\xa6", 3);
        g[6] = 0;
        return 6;
    }
    n = wb_value_text(v, g + 3, cap - 3, full);
    return n + 3;
}

/* Cell (tab, row pos, col): its painted text; 2 when stale. */
static int wb_cell_view(RtxWb *wb, int32_t tab, uint32_t pos, int col, char *g, size_t cap,
                        size_t *gn, int full) {
    const WTab *t = &wb->tabs[tab];
    uint32_t rid = tb_row_rid(t, pos), s = vc_slot(tab, rid, col);
    WVc *e = wb->vc ? &wb->vc[s] : NULL;
    ECtx c;
    WRow *r;
    WVal v;
    size_t n;
    if (!full && e && e->tab == tab && e->rid == rid && e->col == (uint8_t)col && e->gen == wb->vgen) {
        n = e->n < cap ? e->n : (cap ? cap - 1 : 0);
        if (g && cap) {
            memcpy(g, e->g, n);
            g[n] = 0;
        }
        if (gn) *gn = n;
        wb->st.vc_hit++;
        return e->stale ? 2 : 1;
    }
    ectx_init(&c, wb);
    c.view = 1;
    r = wb_ring_get(&c, tab, pos);
    if (!r) return 0;
    v = wb_cell_eval(&c, r, col);
    wb->st.cells_eval++;
    if (c.stale) {
        char tmp[RTX_WB_VAL_MAX + 8];
        n = wb_stale_text(&v, c.nolast, full ? g : tmp, full ? cap : sizeof tmp, full);
        if (!full) {
            if (g && cap) {
                size_t k = n < cap ? n : cap - 1;
                memcpy(g, tmp, k);
                g[k] = 0;
                n = k;
            }
        }
    } else {
        n = wb_value_text(&v, g, cap, full);
    }
    if (gn) *gn = n;
    if (!full && e && g) {
        if (e->tab >= 0 && e->gen == wb->vgen && !(e->tab == tab && e->rid == rid && e->col == (uint8_t)col))
            wb->vc_evict++;
        e->tab = tab;
        e->rid = rid;
        e->col = (uint8_t)col;
        e->gen = wb->vgen;
        e->stale = c.stale;
        e->n = (uint8_t)(n < sizeof e->g ? n : sizeof e->g - 1);
        memcpy(e->g, g, e->n);
    }
    return c.stale ? 2 : 1;
}

/* A small cache of the last rows' cell spans (the layout asks for spans
 * byte by byte). */
typedef struct {
    size_t lo;
    uint32_t gen;
    int32_t tab;
    uint32_t pos;
    WRow r;
    char b[512];
} WSpanRow;

static WSpanRow g_wb_spanrow[4];
static uint32_t g_wb_spanrow_i;

/* The row (tab, pos) parsed for spans (bytes copied when short). */
static const WRow *wb_span_row(RtxWb *wb, int32_t tab, uint32_t pos) {
    const WTab *t = &wb->tabs[tab];
    size_t lo = tb_row_lo(t, pos);
    uint32_t len = tb_row_len(t, pos), i;
    WSpanRow *sr;
    for (i = 0; i < 4; i++) {
        sr = &g_wb_spanrow[i];
        if (sr->gen == wb->mgen + 1 && sr->lo == lo && sr->tab == tab && sr->pos == pos &&
            sr->r.b == sr->b)
            return &sr->r;
    }
    if (len >= sizeof g_wb_spanrow[0].b) {
        static WRow big;
        wb_row_load(wb, &big, tab, pos, 0);
        return &big;
    }
    sr = &g_wb_spanrow[g_wb_spanrow_i++ & 3];
    if (wb_read(wb->doc, lo, sr->b, len) != len) return NULL;
    sr->b[len] = 0;
    memset(&sr->r, 0, offsetof(WRow, v));
    sr->r.tab = tab;
    sr->r.pos = (int32_t)pos;
    sr->r.rid = tb_row_rid(t, pos);
    sr->r.b = sr->b;
    sr->r.n = len;
    wb_row_split(&sr->r);
    sr->lo = lo;
    sr->tab = tab;
    sr->pos = pos;
    sr->gen = wb->mgen + 1;
    return &sr->r;
}

/* The formula span of the cell at `off` (absolute), its row / column. */
static int wb_cell_at_off(RtxWb *wb, size_t off, int32_t *tab, uint32_t *pos, int *col,
                          size_t *flo, size_t *fhi) {
    int32_t ti = wb_tab_at(wb, off), r, c;
    const WTab *t;
    const WRow *rw;
    size_t base;
    if (ti < 0) return 0;
    t = &wb->tabs[ti];
    if (t->big || !t->nrows || off < tb_row_lo(t, 0)) return 0;
    r = tb_row_at(t, off);
    if (r < 0) return 0;
    base = tb_row_lo(t, (uint32_t)r);
    if (off > base + tb_row_len(t, (uint32_t)r)) return 0;
    rw = wb_span_row(wb, ti, (uint32_t)r);
    if (!rw) return 0;
    for (c = 0; c < rw->nc && c < t->ncols; c++) {
        size_t lo, hi, slo, shi, a, b;
        if (off < base + rw->clo[c] || off > base + rw->chi[c]) continue;
        if (!wb_cell_span(rw, c, &lo, &hi)) continue;
        if (!wb_cell_formula(rw->b, lo, hi, &slo, &shi, &a, &b)) return 0;
        *tab = ti;
        *pos = (uint32_t)r;
        *col = c;
        *flo = base + a;
        *fhi = base + b;
        return 1;
    }
    return 0;
}

/* ------------------------------------------------------------------ hooks */

static int wb_hook_at(void *ctx, const RtxDoc *d, size_t off, int incl, size_t *lo, size_t *hi,
                      char *g, size_t cap, size_t *gn) {
    RtxWb *wb = (RtxWb *)ctx;
    int64_t k;
    int32_t tab;
    uint32_t pos;
    int col;
    size_t flo, fhi;
    wb_sync_ex(wb, d, 1);
    if (wb->off || wb->scan || !wb->nderived) return 0;
    wb->opgen++;
    k = wb_name_find(wb, off);
    if (k >= 0) {
        const WName *n = &wb->names[k];
        if (n->def && n->f_lo != WNONE && n->f_hi > n->f_lo && off >= n->f_lo &&
            (off < n->f_hi || (off == n->f_hi && incl))) {
            int stale = n->pend;
            if (stale && n->node != WN32) {
                /* painted stale: the aggregates it reads build first */
                const WGNode *gn = &wb->g[n->node];
                uint32_t q;
                for (q = 0; q < gn->ndeps; q++)
                    if (wb->g[gn->deps[q]].kind == GN_AGG) wb->aggs[wb->g[gn->deps[q]].ref].wanted = 1;
            }
            if (lo) *lo = n->f_lo;
            if (hi) *hi = n->f_hi;
            if (g && cap) {
                size_t w = stale ? wb_stale_text(&n->v, n->v.t == WV_NULL, g, cap, (incl & 2) != 0)
                                 : wb_value_text(&n->v, g, cap, (incl & 2) != 0);
                if (gn) *gn = w;
            }
            return stale ? 2 : 1;
        }
    }
    if (!wb_cell_at_off(wb, off, &tab, &pos, &col, &flo, &fhi)) return 0;
    if (off < flo || off > fhi || (off == fhi && !incl)) return 0;
    if (lo) *lo = flo;
    if (hi) *hi = fhi;
    if (g && cap) {
        size_t w = 0;
        int r = wb_cell_view(wb, tab, pos, col, g, cap, &w, (incl & 2) != 0);
        if (gn) *gn = w;
        wb->sa.reset();
        return r ? r : 1;
    }
    return 1;
}

static size_t wb_hook_edges(void *ctx, const RtxDoc *d, size_t lo, size_t hi, size_t *out,
                            size_t cap) {
    RtxWb *wb = (RtxWb *)ctx;
    int64_t k;
    size_t m = 0;
    uint32_t i;
    wb_sync_ex(wb, d, 1);
    if (wb->off || wb->scan || !wb->nderived) return 0;
    k = wb_name_find(wb, lo);
    if (k < 0) k = 0;
    for (i = (uint32_t)k; i < wb->nnames; i++) {
        const WName *n = &wb->names[i];
        if (n->raw_lo != WNONE && n->raw_lo > hi) break;
        if (!n->def || n->f_lo == WNONE || n->f_hi <= n->f_lo) continue;
        if (n->f_lo > lo && n->f_lo < hi) {
            if (m >= cap) return (size_t)-1;
            out[m++] = n->f_lo;
        }
        if (n->f_hi > lo && n->f_hi < hi) {
            if (m >= cap) return (size_t)-1;
            out[m++] = n->f_hi;
        }
    }
    for (i = 0; i < wb->ntab; i++) {
        const WTab *t = &wb->tabs[i];
        int32_t r;
        if (t->hi <= lo || t->lo >= hi || !t->nrows || t->big) continue;
        r = tb_row_at(t, lo);
        if (r < 0) r = 0;
        for (; r < (int32_t)t->nrows; r++) {
            size_t base = tb_row_lo(t, (uint32_t)r);
            const WRow *rw;
            int32_t c;
            if (base > hi) break;
            rw = wb_span_row(wb, (int32_t)i, (uint32_t)r);
            if (!rw) continue;
            for (c = 0; c < rw->nc && c < t->ncols; c++) {
                size_t clo, chi, slo, shi, a, b;
                if (!wb_cell_span(rw, c, &clo, &chi)) continue;
                if (!wb_cell_formula(rw->b, clo, chi, &slo, &shi, &a, &b)) continue;
                a += base;
                b += base;
                if (a > lo && a < hi) {
                    if (m >= cap) return (size_t)-1;
                    out[m++] = a;
                }
                if (b > lo && b < hi) {
                    if (m >= cap) return (size_t)-1;
                    out[m++] = b;
                }
            }
        }
    }
    return m;
}

/* Spans whose painted value changed since the view cache saw them. */
static size_t wb_hook_changed(void *ctx, const RtxDoc *d, size_t *lo, size_t *hi, size_t cap) {
    RtxWb *wb = (RtxWb *)ctx;
    uint32_t i;
    size_t m = 0;
    wb_sync_ex(wb, d, 1);
    if (wb->off || wb->scan) return 0;
    if (wb->chg_all || wb->vc_evict) {
        wb->chg_all = 0;
        wb->vc_evict = 0;
        wb->nchanged = 0;
        return (size_t)-1;
    }
    for (i = 0; i < wb->nchanged; i++) {
        const WName *n = &wb->names[wb->changed[i]];
        if (!n->def || n->f_lo == WNONE || n->f_hi <= n->f_lo) continue;
        if (m >= cap) return (size_t)-1;
        lo[m] = n->f_lo;
        hi[m] = n->f_hi;
        m++;
    }
    wb->nchanged = 0;
    if (wb->vc && wb->chg_cells) {
        for (i = 0; i < WB_VC_N; i++) {
            WVc *e = &wb->vc[i];
            WVc old;
            int32_t p;
            char g[RTX_WB_VAL_MAX];
            size_t gn = 0;
            if (e->tab < 0 || (uint32_t)e->tab >= wb->ntab || e->gen == wb->vgen) continue;
            p = tb_rid_pos(&wb->tabs[e->tab], e->rid);
            if (p < 0) {
                e->tab = -1;
                continue;
            }
            old = *e;
            wb_cell_view(wb, e->tab, (uint32_t)p, e->col, g, sizeof g, &gn, 0);
            if (gn != old.n || memcmp(g, old.g, gn) != 0 || e->stale != old.stale) {
                const WRow *rw = wb_span_row(wb, old.tab, (uint32_t)p);
                size_t clo, chi, slo, shi, a, b, base = tb_row_lo(&wb->tabs[old.tab], (uint32_t)p);
                if (!rw || !wb_cell_span(rw, old.col, &clo, &chi) ||
                    !wb_cell_formula(rw->b, clo, chi, &slo, &shi, &a, &b))
                    continue;
                if (m >= cap) return (size_t)-1;
                lo[m] = base + a;
                hi[m] = base + b;
                m++;
            }
        }
        wb->chg_cells = 0;
        wb->sa.reset();
    }
    return m;
}

static int wb_hook_any(void *ctx, const RtxDoc *d) {
    RtxWb *wb = (RtxWb *)ctx;
    wb_sync_ex(wb, d, 1);
    return !wb->off && !wb->scan && wb->nderived > 0;
}

/* The anchor tag at `off` (`{#name}` at a row's start): 1 and [lo, hi).
 * 0: none there; *hi then the next place one may start (a row's end). */
static int wb_hook_style(void *ctx, const RtxDoc *d, size_t off, size_t *lo, size_t *hi) {
    RtxWb *wb = (RtxWb *)ctx;
    int32_t ti, r;
    const WTab *t;
    const WRow *rw;
    size_t base;
    wb_sync_ex(wb, d, 1);
    if (hi) *hi = (size_t)-1;
    if (wb->off || wb->scan || !wb->ntab) return 0;
    ti = wb_tab_at(wb, off);
    if (ti < 0) {
        /* the next table's first row */
        uint32_t i;
        for (i = 0; i < wb->ntab; i++)
            if (wb->tabs[i].body_lo > off) {
                if (hi) *hi = wb->tabs[i].body_lo;
                break;
            }
        return 0;
    }
    t = &wb->tabs[ti];
    if (t->big || !t->nrows) return 0;
    if (off < tb_row_lo(t, 0)) {
        if (hi) *hi = tb_row_lo(t, 0);
        return 0;
    }
    r = tb_row_at(t, off);
    if (r < 0) return 0;
    base = tb_row_lo(t, (uint32_t)r);
    rw = wb_span_row(wb, ti, (uint32_t)r);
    if (!rw) return 0;
    if (rw->ahi > rw->alo) {
        size_t tlo = base + rw->mlo, thi = base + rw->ahi + 1 + (rw->b[rw->ahi] == '`' ? 1 : 0);
        if (off >= tlo && off < thi) {
            if (lo) *lo = tlo;
            if (hi) *hi = thi;
            return 1;
        }
        if (off < tlo) {
            if (hi) *hi = tlo;
            return 0;
        }
    }
    if (hi) *hi = base + tb_row_len(t, (uint32_t)r) + 1;
    return 0;
}

static void wb_hook_destroy(void *ctx) {
    RtxWb *wb = (RtxWb *)ctx;
    CCArena own;
    if (!wb) return;
    own = wb->own;
    if (wb->scan) wb_scan_free(wb->scan);
    wb->scan = NULL;
    wb_reset_model(wb);
    wb_last_free(wb);
    free(wb->dl);
    free(wb->bdeps);
    free(wb->bdsh);
    free(wb->cap.b);
    free(wb->cap.roff);
    free(wb->cap.rid);
    free(wb->ring);
    free(wb->ring_gen);
    free(wb->ring_used);
    free(wb->vc);
    wbi_drop(wb, 0);
    wb_reg_del(wb);
    wb_pdocs_free(wb);
    free(wb->idx_path);
    free(wb->doc_real);
    wb->ma.destroy();
    wb->va.destroy();
    wb->sa.destroy();
    own.destroy();
}


/* -------------------------------------------------------------------- API */

/* `*.wb.md` in any case (Q3.WB.MD). */
int rtx_wb_path(const char *path, size_t n) {
    static const char suf[] = ".wb.md";
    size_t i;
    if (!path || n < 6) return 0;
    for (i = 0; i < 6; i++) {
        char c = path[n - 6 + i];
        if (c >= 'A' && c <= 'Z') c = (char)(c - 'A' + 'a');
        if (c != suf[i]) return 0;
    }
    return 1;
}

RtxWb *rtx_wb_of(const RtxDoc *d) {
    if (!d || !d->derived || d->derived->note != wb_hook_note) return NULL;
    return (RtxWb *)d->derived->ctx;
}

RtxWb *rtx_wb_attach(RtxDoc *d) {
    return wb_attach(d, NULL, 0);
}

RtxWb *rtx_wb_attach_path(RtxDoc *d, const char *path) {
    return wb_attach(d, path, 1);
}

RtxWb *rtx_wb_attach_named(RtxDoc *d, const char *path) {
    return wb_attach(d, path, 0);
}

/* The file behind the bytes: its identity now (the bytes were just read)
 * and the index for it, when there is one that matches. */
static void wb_open_ident(RtxWb *wb, const char *path, int use_index) {
    char real[4096], ip[4300];
    struct stat st;
    if (!path || !path[0] || !realpath(path, real)) return;
    wb->doc_real = strdup(real);
    if (!wb->doc_real || !use_index) return;
    if (stat(real, &st) == 0 && (uint64_t)st.st_size == (uint64_t)RtxDoc_len(wb->doc)) {
        rtx_si_id_of(&st, &wb->open_id);
        wb->open_ns = wbi_now_ns();
        wb->open_id_ok = 1;
    }
    if (!rtx_wb_index_path(real, ip, sizeof ip)) return;
    wb->idx_path = strdup(ip);
    if (wb->idx_path && wb->open_id_ok) wb->idx = wbi_load(wb);
}

static RtxWb *wb_attach(RtxDoc *d, const char *path, int use_index) {
    CCArena own;
    RtxWb *wb;
    int pushed = 0, priv = g_wb_attach_priv;
    if (!d || d->derived) return NULL;
    g_wb_attach_priv = 0;
    {
        /* tests (the PTY stale display) shrink the inline budget / slice */
        static int env_once;
        if (!env_once) {
            const char *iw = getenv("RTX_WB_INLINE_WORK"), *sm = getenv("RTX_WB_SLICE_MS"),
                       *sr = getenv("RTX_WB_SLICE_ROWS");
            if (sr) g_wb_slice_rows = (size_t)strtoull(sr, NULL, 10);
            if (getenv("RTX_WB_SLICE_PAUSE_MS")) g_wb_slice_pause_ms = atol(getenv("RTX_WB_SLICE_PAUSE_MS"));
            env_once = 1;
            rtx_wb_job_limits(iw ? (size_t)strtoull(iw, NULL, 10) : 0, sm ? atol(sm) : 0);
        }
    }
    own = cc_arena_heap(sizeof(RtxWb) + 1024);
    if (!own.base) return NULL;
    wb = (RtxWb *)wb_alloc(own, sizeof(RtxWb));
    if (!wb) {
        own.destroy();
        return NULL;
    }
    wb->own = own;
    wb->ma = cc_arena_heap(1u << 20);
    wb->va = cc_arena_heap(256u << 10);
    wb->sa = cc_arena_heap(1u << 20);
    if (!wb->ma.base || !wb->va.base || !wb->sa.base || !wb_vc_init(wb)) {
        wb_hook_destroy(wb);
        return NULL;
    }
    wb->doc = d;
    wb->hook.ctx = wb;
    wb->hook.note = wb_hook_note;
    wb->hook.pre = wb_hook_pre;
    wb->hook.at = wb_hook_at;
    wb->hook.edges = wb_hook_edges;
    wb->hook.changed = wb_hook_changed;
    wb->hook.any = wb_hook_any;
    wb->hook.style = wb_hook_style;
    wb->hook.destroy = wb_hook_destroy;
    d->derived = &wb->hook;
    wb_open_ident(wb, path, use_index);
    if (wb->doc_real) {
        /* other workbooks find it here (live imports); nested opens of
         * its imports see it on the stack (cycles) */
        wb_reg_add(wb, priv);
        if (g_wb_nattach < 32) {
            g_wb_attach_stk[g_wb_nattach++] = wb->doc_real;
            pushed = 1;
        }
    }
    /* a big workbook reads as a job: the first screen does not wait —
     * unless its index is valid: then the read skips every table body
     * and the values are there at once */
    wb_rebuild(wb, wb->idx ? 0 : 1);
    if (pushed) g_wb_nattach--;
    {
        /* the first recalc is over: restored aggregates take changes again */
        uint32_t i;
        for (i = 0; i < wb->naggs; i++) wb->aggs[i].keep = 0;
    }
    if (!wb->scan) wbi_maybe_write(wb);
    wb->sa.reset();
    return wb;
}

void rtx_wb_sync(RtxWb *wb, const RtxDoc *d) {
    if (!wb) return;
    if (wb->scan) {
        /* an explicit query: the read finishes now */
        g_wb_settling = 1;
        while (wb->scan) wb_scan_step(wb, 0);
        g_wb_settling = 0;
        if (!wb->off) wb_recalc_run(wb, 0);
    }
    wb_sync_ex(wb, d, 0);
}

void rtx_wb_settle(RtxWb *wb, const RtxDoc *d) {
    uint32_t i;
    if (!wb) return;
    /* the workbooks it uses first: their values are what it reads */
    for (i = 0; i < wb->nuses && !wb->imp_busy; i++) {
        RtxWb *e = wb_use_engine(wb, &wb->uses[i]);
        if (!e || e->imp_busy) continue;
        wb->imp_busy = 1;
        rtx_wb_settle(e, e->doc);
        wb->imp_busy = 0;
    }
    rtx_wb_sync(wb, d);
    wb_settle(wb);
    wb->jobs = wb_jobs_left(wb);
    wbi_maybe_write(wb);
    wb->sa.reset();
}

int rtx_wb_index_write(RtxWb *wb, const RtxDoc *d) {
    unsigned w0;
    if (!wb || !d) return 0;
    rtx_wb_sync(wb, d);
    w0 = (unsigned)wb->st.idx_writes;
    wb->idx_wmgen = 0;
    wb->idx_wlevel = 0;
    wbi_maybe_write(wb);
    return wb->st.idx_writes != w0;
}

static uint64_t wb_mh(uint64_t h, const void *p, size_t n) {
    const unsigned char *s = (const unsigned char *)p;
    size_t i;
    for (i = 0; i < n; i++) {
        h ^= s[i];
        h *= 1099511628211ull;
    }
    return h;
}

#define WB_MH(h, x) ((h) = wb_mh((h), &(x), sizeof(x)))

uint64_t rtx_wb_model_hash(RtxWb *wb, const RtxDoc *d) {
    uint64_t h = 1469598103934665603ull;
    uint32_t i, ti, k;
    if (!wb) return 0;
    rtx_wb_sync(wb, d);
    WB_MH(h, wb->off);
    WB_MH(h, wb->nsheet);
    for (i = 0; i < wb->nsheet; i++) h = wb_mh(h, wb->sheets[i], wb->sheetn[i]);
    WB_MH(h, wb->nblk);
    for (i = 0; i < wb->nblk; i++) {
        WB_MH(h, wb->blks[i].lo);
        WB_MH(h, wb->blks[i].hi);
    }
    WB_MH(h, wb->nnames);
    for (i = 0; i < wb->nnames; i++) {
        const WName *n = &wb->names[i];
        WB_MH(h, n->def);
        WB_MH(h, n->scope);
        WB_MH(h, n->raw_lo);
        WB_MH(h, n->raw_hi);
        WB_MH(h, n->node);
        if (n->def) h = wb_mh(h, n->src, n->srcn);
    }
    WB_MH(h, wb->nrules);
    for (i = 0; i < wb->nrules; i++) {
        const WRule *r = &wb->rules[i];
        WB_MH(h, r->tab);
        WB_MH(h, r->col);
        WB_MH(h, r->refs);
        WB_MH(h, r->dead);
        WB_MH(h, r->node);
        h = wb_mh(h, r->src, r->srcn);
    }
    WB_MH(h, wb->ng);
    for (i = 0; i < wb->ng; i++) WB_MH(h, wb->g[i].kind);
    WB_MH(h, wb->nform_cells);
    WB_MH(h, wb->nderived);
    WB_MH(h, wb->ntab);
    for (ti = 0; ti < wb->ntab; ti++) {
        const WTab *t = &wb->tabs[ti];
        uint64_t ah = 0;
        h = wb_mh(h, t->name, t->namen);
        WB_MH(h, t->ncols);
        WB_MH(h, t->nrows);
        WB_MH(h, t->big);
        WB_MH(h, t->lo);
        WB_MH(h, t->hi);
        WB_MH(h, t->body_lo);
        WB_MH(h, t->lastnl);
        WB_MH(h, t->nb);
        WB_MH(h, t->nrid);
        h = wb_mh(h, t->cs, (size_t)t->ncols * sizeof(WColStat));
        h = wb_mh(h, t->ct, (size_t)t->ncols);
        h = wb_mh(h, t->csc, (size_t)t->ncols);
        for (k = 0; k < t->nb; k++) {
            const WBlock *b = &t->blk[t->bord[k]];
            WB_MH(h, b->lo);
            WB_MH(h, b->n);
            WB_MH(h, t->bfirst[k]);
            h = wb_mh(h, b->rrel, (size_t)b->n * 4);
            h = wb_mh(h, b->rlen, (size_t)b->n * 4);
            h = wb_mh(h, b->rid, (size_t)b->n * 4);
        }
        for (k = 0; k < t->anc.cap; k++) {
            const WKxEnt *e = &t->anc.e[k];
            uint64_t eh = 1469598103934665603ull;
            uint32_t ids[64], m, q;
            if (!e->used || !e->cnt) continue;
            eh = wb_mh(eh, e->k.s ? e->k.s : "", e->k.n);
            m = kx_ids(&t->anc, &e->k, ids, 64);
            for (q = 0; q < m && q < 64; q++) WB_MH(eh, ids[q]);
            ah += eh;
        }
        WB_MH(h, ah);
    }
    return h;
}

const char *rtx_wb_index_why(int state) {
    if (state < 0 || state >= (int)(sizeof g_wbi_why / sizeof g_wbi_why[0])) return "?";
    return g_wbi_why[state];
}

void rtx_wb_recalc_all(RtxWb *wb, const RtxDoc *d) {
    if (!wb || !d) return;
    wb->need_rebuild = 1;
    rtx_wb_sync(wb, d);
}

long rtx_wb_due_ms(const RtxDoc *d) {
    RtxWb *wb = rtx_wb_of(d);
    long imp = -1;
    if (!wb) return -1;
    if (wb->pend || wb->need_rebuild) return 0; /* edits to read: the idle slice syncs */
    if ((wb->nuses || wb->npdocs) && !wb->imp_busy) {
        wb->imp_busy = 1;
        imp = wb_imp_due(wb);
        wb->imp_busy = 0;
        if (imp == 0) return 0;
    }
    if (wb->cancelled) return imp;
    if (wb->jobs || wb->scan) return 0;
    return imp;
}

/* A slice of the jobs (the host's idle loop). 2: values moved (relayout),
 * 1: progress only (repaint the status), 0: nothing to do. */
int rtx_wb_idle(const RtxDoc *d) {
    RtxWb *wb = rtx_wb_of(d);
    uint32_t v0;
    int had_scan;
    if (!wb) return 0;
    if ((wb->nuses || wb->npdocs) && !wb->pend && !wb->need_rebuild && !wb->imp_busy) {
        /* the workbooks it uses: their jobs (private ones), their moves */
        int any;
        uint32_t g0 = wb->vgen;
        wb->imp_busy = 1;
        any = wb_imp_idle(wb);
        if (!wb->scan && !wb->off && wb_imp_poll(wb, 1)) {
            wb->opgen++;
            wb_recalc_heap(wb);
            wb->sa.reset();
            wb->opgen++;
            any = 1;
        }
        wb->imp_busy = 0;
        if (!wb->jobs && !wb->scan) return wb->vgen != g0 ? 2 : any;
    }
    if (wb->pend || wb->need_rebuild) {
        uint32_t g0 = wb->vgen;
        wb_sync_ex(wb, d, 1);
        if (wb->cancelled || (!wb->jobs && !wb->scan)) return wb->vgen != g0 ? 2 : 0;
    }
    if (wb->cancelled || (!wb->jobs && !wb->scan)) return 0;
    v0 = wb->vgen;
    had_scan = wb->scan != NULL;
    wb->opgen++;
    wb_jobs_step(wb, wb_now_us() + (double)g_wb_slice_ms * 1000.0, g_wb_slice_rows ? g_wb_slice_rows : (size_t)-1);
    if (had_scan && !wb->scan && !wb->off) wb_recalc_run(wb, 0);
    wb->sa.reset();
    wb->opgen++;
    wb->st.slices++;
    if (g_wb_slice_pause_ms > 0) {
        /* tests: a job that outlasts a burst of keys */
        struct timespec ts = {g_wb_slice_pause_ms / 1000, (g_wb_slice_pause_ms % 1000) * 1000000L};
        nanosleep(&ts, NULL);
    }
    /* the read done, or every job: the index says what this model knows */
    if (!wb->scan && (had_scan || !wb->jobs)) wbi_maybe_write(wb);
    if (wb->vgen != v0 || (had_scan && !wb->scan)) return 2;
    return 1;
}

int rtx_wb_deferred(const RtxDoc *d) {
    RtxWb *wb = rtx_wb_of(d);
    return wb && wb->scan != NULL;
}

int rtx_wb_busy(const RtxDoc *d) {
    RtxWb *wb = rtx_wb_of(d);
    if (!wb) return 0;
    wb_sync_ex(wb, d, 1);
    return !wb->cancelled && (wb->jobs || wb->scan);
}

int rtx_wb_cancel(RtxDoc *d) {
    RtxWb *wb = rtx_wb_of(d);
    if (!wb) return 0;
    wb_sync_ex(wb, d, 1);
    if (!wb->jobs && !wb->scan) return 0;
    if (wb->scan) {
        /* the read cannot stop halfway: it restarts at the next edit */
        return 0;
    }
    wb_cancel(wb);
    return 1;
}

/* Progress of the jobs: 0..100 (100 when none). */
int rtx_wb_progress(const RtxDoc *d) {
    RtxWb *wb = rtx_wb_of(d);
    double done = 0, total = 0;
    uint32_t ti, i, j, k;
    if (!wb) return 100;
    wb_sync_ex(wb, d, 1);
    if (wb->scan) {
        size_t len = RtxDoc_len(d);
        return len ? (int)((double)wb->scan->pos * 100.0 / (double)len) : 0;
    }
    for (ti = 0; ti < wb->ntab; ti++) {
        const WTab *t = &wb->tabs[ti];
        if (t->ch.on && t->ch.front < t->nb) {
            total += t->nrows;
            done += t->nb ? t->bfirst[t->ch.front < t->nb ? t->ch.front : t->nb - 1] : 0;
        }
        for (i = 0; i < t->naggs; i++) {
            const WAgg *a = &wb->aggs[t->aggs[i]];
            if (!a->live) continue;
            for (j = 0; j < a->ninst; j++) {
                const WInst *in = a->inst[j];
                if (!in || !in->live || !in->building) continue;
                total += t->nrows;
                for (k = 0; k < t->nb; k++)
                    if (in->ldone && in->ldone[t->bord[k]]) done += t->blk[t->bord[k]].n;
            }
        }
    }
    if (total <= 0) return 100;
    return (int)(done * 100.0 / total);
}

void rtx_wb_stats(RtxWb *wb, const RtxDoc *d, RtxWbStats *out) {
    uint32_t i;
    if (!out) return;
    memset(out, 0, sizeof *out);
    if (!wb) return;
    rtx_wb_sync(wb, d);
    wb->st.tables = wb->ntab;
    wb->st.names = 0;
    wb->st.formulas = wb->nform_cells;
    wb->st.cells = 0;
    wb->st.rules = 0;
    wb->st.nodes = 0;
    wb->st.edges = 0;
    wb->st.mas = 0;
    wb->st.insts = 0;
    wb->st.errors = 0;
    for (i = 0; i < wb->ntab; i++) wb->st.cells += (size_t)wb->tabs[i].nrows * (size_t)wb->tabs[i].ncols;
    for (i = 0; i < wb->nnames; i++)
        if (wb->names[i].def) {
            wb->st.names++;
            if (!wb->names[i].clash && wb->names[i].src) wb->st.formulas++;
            if (wb->names[i].v.t == WV_ERR) wb->st.errors++;
        }
    for (i = 0; i < wb->nrules; i++)
        if (!wb->rules[i].dead && wb->rules[i].refs) wb->st.rules++;
    for (i = 0; i < wb->ng; i++) {
        if (wb->g[i].kind == GN_DEAD) continue;
        wb->st.nodes++;
        wb->st.edges += wb->g[i].ndeps;
    }
    for (i = 0; i < wb->naggs; i++) {
        uint32_t j;
        if (!wb->aggs[i].live) continue;
        wb->st.mas++;
        for (j = 0; j < wb->aggs[i].ninst; j++)
            if (wb->aggs[i].inst[j] && wb->aggs[i].inst[j]->live) wb->st.insts++;
    }
    wb->st.off = wb->off;
    wb->st.jobs = (size_t)(wb->jobs || wb->scan);
    wb->st.mem_model = wb->ma_mark;
    wb->st.mem_values = wb->va_mark;
    {
        size_t idx = 0, part = 0;
        uint32_t ti;
        for (ti = 0; ti < wb->ntab; ti++) {
            const WTab *t = &wb->tabs[ti];
            uint32_t b;
            idx += (size_t)t->ridcap * sizeof(WRloc) + (size_t)t->bidcap * sizeof(WBlock) +
                   (size_t)t->bordcap * 2 * sizeof(uint32_t);
            for (b = 0; b < t->nbid; b++) idx += (size_t)t->blk[b].cap * 3 * sizeof(uint32_t);
            if (t->ch.ck) part += (size_t)t->ch.ckcap * ch_slots(&t->ch) * sizeof(WVal);
            if (t->kx) {
                int32_t c;
                for (c = 0; c < t->ncols; c++)
                    if (t->kx[c]) idx += (size_t)t->kx[c]->cap * sizeof(WKxEnt) + (size_t)t->kx[c]->ovcap * 4;
            }
            idx += (size_t)t->anc.cap * sizeof(WKxEnt);
        }
        for (i = 0; i < wb->naggs; i++) {
            uint32_t j;
            for (j = 0; j < wb->aggs[i].ninst; j++) {
                const WInst *in = wb->aggs[i].inst[j];
                if (!in) continue;
                part += sizeof(WInst) + (size_t)in->lcap *
                                            ((in->lstop ? 4 : 0) + (in->lbest ? sizeof(WBest) : 0) +
                                             (in->lresc ? 1 : 0) + (in->ldone ? 1 : 0) +
                                             (in->lacc ? sizeof(WAcc) + sizeof(RtxXs) : 0));
                if (in->seg) part += (size_t)in->segp * 2 * sizeof(WAcc);
            }
        }
        wb->st.mem_index = idx;
        wb->st.mem_partials = part;
        wb->st.mem_nodes = (size_t)wb->gcap * sizeof(WGNode) + (size_t)wb->rulecap * sizeof(WRule) +
                           (size_t)wb->aggcap * sizeof(WAgg);
    }
    wb->st.mem_model += wb->st.mem_nodes;
    *out = wb->st;
}

void rtx_wb_counters(RtxWb *wb, const RtxDoc *d, RtxWbStats *out) {
    if (!out) return;
    memset(out, 0, sizeof *out);
    if (!wb) return;
    rtx_wb_sync(wb, d);
    wb->st.off = wb->off;
    wb->st.jobs = (size_t)(wb->jobs || wb->scan);
    *out = wb->st;
}

int rtx_wb_cell_at(RtxWb *wb, const RtxDoc *d, const char *table, size_t row, int col,
                   size_t *lo, size_t *hi) {
    uint32_t i;
    size_t tn = table ? strlen(table) : 0;
    if (!wb) return 0;
    rtx_wb_sync(wb, d);
    if (wb->off) return 0;
    for (i = 0; i < wb->ntab; i++) {
        const WTab *t = &wb->tabs[i];
        WRow r;
        size_t base;
        if (t->namen != tn || memcmp(t->name, table, tn) || t->big) continue;
        if (row >= t->nrows || col < 0 || col >= t->ncols) return 0;
        wb_row_load(wb, &r, (int32_t)i, (uint32_t)row, 0);
        if (col >= r.nc) return 0;
        base = tb_row_lo(t, (uint32_t)row);
        if (lo) *lo = base + r.clo[col];
        if (hi) *hi = base + r.chi[col];
        wb->sa.reset();
        return 1;
    }
    return 0;
}

size_t rtx_wb_rows(RtxWb *wb, const RtxDoc *d, const char *table) {
    uint32_t i;
    size_t tn = table ? strlen(table) : 0;
    if (!wb) return 0;
    rtx_wb_sync(wb, d);
    for (i = 0; i < wb->ntab; i++)
        if (wb->tabs[i].namen == tn && !memcmp(wb->tabs[i].name, table, tn))
            return (size_t)wb->tabs[i].nrows;
    return 0;
}

static size_t wb_fmt_dump(const WVal *v, char *out, size_t cap) {
    size_t at = 0;
    if (v->t == WV_NULL) return wb_puts(out, cap, 0, "null");
    if (v->t == WV_TEXT) {
        at = wb_puts(out, cap, 0, "\"");
        at = wb_put(out, cap, at, v->u.s, v->n);
        return wb_puts(out, cap, at, "\"");
    }
    return wv_fmt(v, out, cap, 1);
}

static void wb_dry_ctx(BCtx *c, RtxWb *wb);

int rtx_wb_eval(RtxWb *wb, const RtxDoc *d, const char *expr, size_t n, char *out, size_t cap) {
    BCtx c;
    ECtx e;
    Ex *x;
    WVal v;
    uint32_t sn;
    if (out && cap) out[0] = 0;
    if (!wb) return 0;
    rtx_wb_settle(wb, d);
    if (wb->off) return 0;
    memset(&c, 0, sizeof c);
    c.wb = wb;
    c.kind = BK_EVAL;
    c.self = WN32;
    c.own_tab = c.own_col = c.it_tab = -1;
    c.sheet = 0;
    c.any_sheet = 1;
    c.nodeps = 1;
    c.agg = WN32;
    c.src = wb_copy(wb, expr, n, &sn);
    c.srcn = (uint32_t)n;
    x = wb_parse(wb, c.src, (uint32_t)n);
    x = bd(&c, x);
    ectx_init(&e, wb);
    g_wb_settling = 1;
    v = ev(&e, x);
    g_wb_settling = 0;
    if (v.t == WV_ROW || v.t == WV_TAB) v = wv_row_err(&e, &v);
    wb_fmt_dump(&v, out, cap);
    wb->sa.reset();
    wb->opgen++;
    return 1;
}

static int wb_gent_cmp(const void *a, const void *b) {
    const WGEnt *x = *(const WGEnt *const *)a, *y = *(const WGEnt *const *)b;
    return wb_key_cmp(&x->k, &y->k);
}

/* A group's rows in key order: `{k: out=v, ...; k2: ...}`. */
static size_t wb_group_text(RtxWb *wb, const WVal *v, char *out, size_t cap) {
    WAgg *a;
    WInst *in;
    WGEnt **rows;
    uint32_t i, n = 0, j;
    size_t at;
    char vb[256];
    if (v->t != WV_GRP || v->u.i < 0 || (uint32_t)v->u.i >= wb->naggs) return wv_fmt(v, out, cap, 1);
    a = &wb->aggs[v->u.i];
    if (!a->ninst || !a->inst[0]) return wv_fmt(v, out, cap, 1);
    in = a->inst[0];
    rows = (WGEnt **)cc_arena_alloc(wb->sa, (size_t)(in->gm.cap ? in->gm.cap : 1) * sizeof(WGEnt *), 16);
    if (!rows) return wv_fmt(v, out, cap, 1);
    for (i = 0; i < in->gm.cap; i++)
        if (in->gm.e[i].used && in->gm.e[i].rows) rows[n++] = &in->gm.e[i];
    qsort(rows, n, sizeof(WGEnt *), wb_gent_cmp);
    at = wb_puts(out, cap, 0, "{");
    for (i = 0; i < n; i++) {
        WVal kv = wb_key_val(&rows[i]->k);
        if (i) at = wb_puts(out, cap, at, "; ");
        wb_fmt_dump(&kv, vb, sizeof vb);
        at = wb_puts(out, cap, at, vb);
        at = wb_puts(out, cap, at, ":");
        for (j = 0; j < a->nout; j++) {
            ECtx c;
            WVal ov;
            ectx_init(&c, wb);
            ov = wg_out_value(&c, a, in, rows[i], j);
            at = wb_puts(out, cap, at, j ? ", " : " ");
            at = wb_put(out, cap, at, a->ex->args[j]->id2, a->ex->args[j]->id2n);
            at = wb_puts(out, cap, at, "=");
            wb_fmt_dump(&ov, vb, sizeof vb);
            at = wb_puts(out, cap, at, vb);
        }
    }
    return wb_puts(out, cap, at, "}");
}

static size_t wb_dump_val(RtxWb *wb, const WVal *v, int flags, char *out, size_t cap, size_t at) {
    char vb[4096];
    if (v->t == WV_GRP) wb_group_text(wb, v, vb, sizeof vb);
    else wb_fmt_dump(v, vb, sizeof vb);
    at = wb_puts(out, cap, at, vb);
    if ((flags & RTX_WB_DUMP_BITS) && v->t == WV_FLOAT) {
        uint64_t b;
        memcpy(&b, &v->u.f, sizeof b);
        snprintf(vb, sizeof vb, " [%016llx]", (unsigned long long)b);
        at = wb_puts(out, cap, at, vb);
    }
    return at;
}

/* The aggregates of a formula, read by `c` (the cell / name). */
static size_t wb_dump_aggs(RtxWb *wb, ECtx *c, const uint32_t *aggs, uint32_t n, int flags,
                           char *out, size_t cap, size_t at) {
    uint32_t k;
    char lb[32];
    for (k = 0; k < n; k++) {
        WAgg *a = &wb->aggs[aggs[k]];
        WVal v;
        if (!a->live) continue;
        if (wb->g[a->node].cyc) {
            v = wb->cyv[wb->g[a->node].cyi];
        } else {
            WInst *in = wb_inst_get(c, a);
            v = in ? inst_read(c, a, in) : wv_null();
        }
        snprintf(lb, sizeof lb, "  ma%u = ", (unsigned)k);
        at = wb_puts(out, cap, at, lb);
        at = wb_dump_val(wb, &v, flags, out, cap, at);
        at = wb_puts(out, cap, at, "\n");
    }
    return at;
}

size_t rtx_wb_dump_ex(RtxWb *wb, const RtxDoc *d, int flags, char *out, size_t cap) {
    size_t at = 0;
    uint32_t i, ti = 0;
    char lb[200], vb[64];
    if (out && cap) out[0] = 0;
    if (!wb) return 0;
    rtx_wb_settle(wb, d);
    if (wb->off) return wb_puts(out, cap, 0, "(off)\n");
    g_wb_settling = 1;
    for (i = 0; i <= wb->nnames; i++) {
        const WName *n = i < wb->nnames ? &wb->names[i] : NULL;
        if (n && !n->def) continue;
        while (ti < wb->ntab && (!n || wb->tabs[ti].lo < n->raw_lo)) {
            const WTab *t = &wb->tabs[ti];
            uint32_t r;
            int32_t c;
            for (r = 0; r < t->nrows; r++) {
                WRow rr;
                ECtx e;
                size_t base = tb_row_lo(t, r);
                wb->opgen++;
                wb->sa.reset();
                ectx_init(&e, wb);
                wb_row_load(wb, &rr, (int32_t)ti, r, 0);
                for (c = 0; c < t->ncols; c++) {
                    WVal v = wb_cell_eval(&e, &rr, c);
                    size_t lo, hi, slo, shi, flo, fhi;
                    int form = 0;
                    wb_cell_label(wb, (int32_t)ti, (int32_t)r, c, lb, sizeof lb);
                    at = wb_puts(out, cap, at, lb);
                    at = wb_puts(out, cap, at, " = ");
                    at = wb_dump_val(wb, &v, flags, out, cap, at);
                    if (wb_cell_span(&rr, c, &lo, &hi))
                        form = wb_cell_formula(rr.b, lo, hi, &slo, &shi, &flo, &fhi);
                    if ((flags & RTX_WB_DUMP_SPANS) && c < rr.nc) {
                        snprintf(vb, sizeof vb, " @%zu..%zu", base + rr.clo[c], base + rr.chi[c]);
                        at = wb_puts(out, cap, at, vb);
                        if (form) {
                            snprintf(vb, sizeof vb, " f%zu..%zu", base + flo, base + fhi);
                            at = wb_puts(out, cap, at, vb);
                        }
                    }
                    at = wb_puts(out, cap, at, "\n");
                    if ((flags & RTX_WB_DUMP_MAS) && form) {
                        int ri = wb_rule_find(wb, (int32_t)ti, c, rr.b + slo, (uint32_t)(shi - slo));
                        if (ri >= 0) {
                            ECtx ce = e;
                            ce.self_tab = (int32_t)ti;
                            ce.self_pos = (int32_t)r;
                            ce.self_col = c;
                            ce.own = &rr;
                            at = wb_dump_aggs(wb, &ce, wb->rules[ri].aggs, wb->rules[ri].naggs, flags,
                                              out, cap, at);
                        }
                    }
                }
            }
            ti++;
        }
        if (n) {
            ECtx e;
            wb_name_label(wb, i, lb, sizeof lb);
            at = wb_puts(out, cap, at, lb);
            at = wb_puts(out, cap, at, " = ");
            at = wb_dump_val(wb, &n->v, flags, out, cap, at);
            if ((flags & RTX_WB_DUMP_SPANS) && n->raw_lo != WNONE) {
                snprintf(vb, sizeof vb, " @%zu..%zu", n->raw_lo, n->raw_hi);
                at = wb_puts(out, cap, at, vb);
                if (n->f_lo != WNONE && n->f_hi > n->f_lo) {
                    snprintf(vb, sizeof vb, " f%zu..%zu", n->f_lo, n->f_hi);
                    at = wb_puts(out, cap, at, vb);
                }
            }
            at = wb_puts(out, cap, at, "\n");
            if ((flags & RTX_WB_DUMP_MAS) && n->naggs) {
                ectx_init(&e, wb);
                e.self_name = i;
                at = wb_dump_aggs(wb, &e, n->aggs, n->naggs, flags, out, cap, at);
            }
        }
    }
    g_wb_settling = 0;
    wb->sa.reset();
    wb->opgen++;
    return at;
}

size_t rtx_wb_dump(RtxWb *wb, const RtxDoc *d, char *out, size_t cap) {
    return rtx_wb_dump_ex(wb, d, 0, out, cap);
}

/* The rule-graph nodes a change at `off` may reach (the node there and
 * everything reading it, transitively). */
size_t rtx_wb_reach(RtxWb *wb, const RtxDoc *d, size_t off) {
    uint32_t *queue, qh = 0, qt = 0, j, start = WN32;
    uint8_t *seen;
    size_t n;
    int64_t k;
    int32_t tab;
    uint32_t pos;
    int col;
    size_t flo, fhi;
    if (!wb) return 0;
    rtx_wb_sync(wb, d);
    if (wb->off || !wb->ng) return 0;
    k = wb_name_find(wb, off);
    if (k >= 0 && wb->names[k].def && off <= wb->names[k].raw_hi && off >= wb->names[k].raw_lo)
        start = wb->names[k].node;
    if (start == WN32) {
        int32_t ti = wb_tab_at(wb, off);
        if (ti >= 0 && wb->tabs[ti].nrows && off >= tb_row_lo(&wb->tabs[ti], 0)) {
            int32_t r = tb_row_at(&wb->tabs[ti], off);
            if (r >= 0) {
                if (wb_cell_at_off(wb, off, &tab, &pos, &col, &flo, &fhi)) start = wb->tabs[ti].cnode[col];
                else {
                    const WRow *rw = wb_span_row(wb, ti, (uint32_t)r);
                    size_t base = tb_row_lo(&wb->tabs[ti], (uint32_t)r);
                    int32_t c;
                    for (c = 0; rw && c < rw->nc && c < wb->tabs[ti].ncols; c++)
                        if (off >= base + rw->clo[c] && off <= base + rw->chi[c]) start = wb->tabs[ti].cnode[c];
                }
            }
        }
    }
    if (start == WN32) return 0;
    seen = (uint8_t *)calloc(wb->ng, 1);
    queue = (uint32_t *)malloc((size_t)wb->ng * sizeof(uint32_t));
    if (!seen || !queue) {
        free(seen);
        free(queue);
        return 0;
    }
    seen[start] = 1;
    queue[qt++] = start;
    while (qh < qt) {
        const WGNode *x = &wb->g[queue[qh++]];
        for (j = 0; j < x->rdn; j++) {
            uint32_t w = wb->rdeps[x->rd0 + j];
            if (!seen[w]) {
                seen[w] = 1;
                queue[qt++] = w;
            }
        }
        if (x->kind == GN_RULE && x->tab >= 0) {
            uint32_t w = wb->tabs[x->tab].cnode[x->col];
            if (!seen[w]) {
                seen[w] = 1;
                queue[qt++] = w;
            }
        }
    }
    n = qt;
    free(seen);
    free(queue);
    return n;
}


/* ---------------------------------------------------------------- rename
 *
 * A table, column, name or anchor: the definition and every reference,
 * one edit group (one undo step). A rename that would make any other
 * reference resolve differently (a capture) is refused BEFORE anything is
 * written: every formula is re-bound, dry, against the renamed model and
 * its references compared — so a refusal leaves bytes and history alone.
 */

enum { RT_NONE = 0, RT_TAB, RT_COL, RT_NAME, RT_ANC };

typedef struct {
    int kind;
    int32_t tab, col;
    uint32_t node; /* names index */
    const char *anc;
    uint32_t ancn;
} WTarget;

typedef struct {
    int kind;
    int32_t tab, col;
    uint32_t node;
    const char *anc;
    uint32_t ancn;
    uint32_t lo, hi; /* relative to the formula's source */
} WTok;

typedef struct {
    WTok *t;
    uint32_t n, cap;
} WToks;

static void tk_push(WToks *v, int kind, int32_t tab, int32_t col, uint32_t node, const char *anc,
                    uint32_t ancn, uint32_t lo, uint32_t hi) {
    WTok *x;
    if (v->n >= v->cap) {
        uint32_t nc = v->cap ? v->cap * 2 : 32;
        WTok *nt = (WTok *)realloc(v->t, (size_t)nc * sizeof(WTok));
        if (!nt) return;
        v->t = nt;
        v->cap = nc;
    }
    x = &v->t[v->n++];
    x->kind = kind;
    x->tab = tab;
    x->col = col;
    x->node = node;
    x->anc = anc;
    x->ancn = ancn;
    x->lo = lo;
    x->hi = hi;
}

/* An anchor token `#name` / `#`name``: its name part. */
static void tk_anc(WToks *v, int32_t tab, const Ex *a) {
    uint32_t lo = a->lo2 + 1, hi = a->hi2;
    tk_push(v, RT_ANC, tab, -1, 0, a->id2, a->id2n, lo, hi);
}

static void tk_end(WToks *v, int32_t tab, const Ex *e) {
    if (!e) return;
    if (e->op == EX_INDEX && e->a && e->a->op == EX_ANC) e = e->a;
    if (e->op == EX_ANC) tk_anc(v, tab, e);
}

/* Every reference token of a bound formula, in AST order. */
static void tk_walk(WToks *v, const Ex *e) {
    uint16_t i;
    if (!e) return;
    switch (e->op) {
    case EX_COL:
        if (e->tabtok) tk_push(v, RT_TAB, e->tab, -1, 0, NULL, 0, e->lo, e->hi);
        tk_push(v, RT_COL, e->tab, e->col, 0, NULL, 0, e->lo2, e->hi2);
        return;
    case EX_ATCELL:
    case EX_RELCELL:
        if (e->tabtok) tk_push(v, RT_TAB, e->tab, -1, 0, NULL, 0, e->lo, e->hi);
        tk_push(v, RT_COL, e->tab, e->col, 0, NULL, 0, e->lo2, e->hi2);
        return;
    case EX_NAMEREF:
        tk_push(v, RT_NAME, -1, -1, e->node, NULL, 0, e->lo2, e->hi2);
        return;
    case EX_TABREF:
        tk_push(v, RT_TAB, e->tab, -1, 0, NULL, 0, e->lo, e->hi);
        return;
    case EX_LOOKUP:
        tk_push(v, RT_TAB, e->tab, -1, 0, NULL, 0, e->lo, e->hi);
        tk_walk(v, e->b);
        return;
    case EX_FIELD:
        tk_walk(v, e->a);
        tk_push(v, RT_COL, e->tab, e->col, 0, NULL, 0, e->lo2, e->hi2);
        return;
    case EX_ABS:
        tk_push(v, RT_TAB, e->tab, -1, 0, NULL, 0, e->lo, e->hi);
        if (e->a) tk_anc(v, e->tab, e->a);
        tk_push(v, RT_COL, e->tab, e->col, 0, NULL, 0, e->lo2, e->hi2);
        return;
    case EX_AGG:
        if (e->nargs) tk_walk(v, e->args[0]);
        tk_walk(v, e->where);
        if (e->c && e->c->op == EX_INDEX && e->c->range) {
            tk_end(v, e->tab, e->c->b);
            tk_end(v, e->tab, e->c->c);
        }
        return;
    case EX_GROUP:
        tk_push(v, RT_TAB, e->tab, -1, 0, NULL, 0, e->lo, e->hi);
        tk_walk(v, e->a);
        for (i = 0; i < e->nargs; i++) tk_walk(v, e->args[i]);
        return;
    case EX_GLOOKUP:
        tk_push(v, RT_NAME, -1, -1, e->node, NULL, 0, e->lo, e->hi);
        tk_walk(v, e->b);
        return;
    case EX_FN:
        for (i = 0; i < e->nargs; i++) tk_walk(v, e->args[i]);
        return;
    case EX_UN:
        tk_walk(v, e->a);
        return;
    case EX_BIN:
        tk_walk(v, e->a);
        tk_walk(v, e->b);
        return;
    case EX_IF:
        tk_walk(v, e->a);
        tk_walk(v, e->b);
        tk_walk(v, e->c);
        return;
    default:
        return;
    }
}

static int tk_is(const WTok *k, const WTarget *t) {
    if (k->kind != t->kind) return 0;
    switch (t->kind) {
    case RT_TAB:
        return k->tab == t->tab;
    case RT_COL:
        return k->tab == t->tab && k->col == t->col;
    case RT_NAME:
        return k->node == t->node;
    case RT_ANC:
        return k->tab == t->tab && k->ancn == t->ancn && !memcmp(k->anc, t->anc, t->ancn);
    default:
        return 0;
    }
}

/* Bind `src` dry (no nodes) as formula (kind, ref) and list its tokens. */
static void wb_dry_toks(RtxWb *wb, int kind, uint32_t ref, const char *src, uint32_t srcn,
                        WToks *out) {
    BCtx c;
    Ex *x;
    memset(&c, 0, sizeof c);
    c.wb = wb;
    c.kind = kind;
    c.self = WN32;
    c.own_tab = c.own_col = -1;
    c.it_tab = -1;
    c.sheet = -1;
    c.agg = WN32;
    c.nodeps = 1;
    c.dry = 1;
    if (kind == BK_NAME) {
        c.sheet = wb->names[ref].scope;
        c.grp_ok = 1;
    } else {
        c.own_tab = wb->rules[ref].tab;
        c.own_col = wb->rules[ref].col;
        c.sheet = wb->tabs[c.own_tab].sheet;
    }
    x = wb_parse(wb, src, srcn);
    x = bd(&c, x);
    out->n = 0;
    tk_walk(out, x);
}

/* The target at `off`: a caption, a header cell, a name, an anchor
 * definition, or a reference token in a formula. */
static int wb_target_at(RtxWb *wb, size_t off, WTarget *out) {
    uint32_t i;
    int32_t c;
    int64_t k;
    WToks tv;
    memset(out, 0, sizeof *out);
    memset(&tv, 0, sizeof tv);
    for (i = 0; i < wb->ntab; i++) {
        const WTab *t = &wb->tabs[i];
        if (off >= t->cap_lo && off <= t->cap_hi) {
            out->kind = RT_TAB;
            out->tab = (int32_t)i;
            return 1;
        }
        for (c = 0; c < t->ncols; c++) {
            if (t->hlo[c] != WNONE && off >= t->hlo[c] && off <= t->hhi[c]) {
                out->kind = RT_COL;
                out->tab = (int32_t)i;
                out->col = c;
                return 1;
            }
        }
    }
    k = wb_name_find(wb, off);
    if (k >= 0 && wb->names[k].def && off >= wb->names[k].raw_lo && off <= wb->names[k].raw_hi) {
        WName *n = &wb->names[k];
        if (off >= n->n_lo && off <= n->n_hi) {
            out->kind = RT_NAME;
            out->node = (uint32_t)k;
            return 1;
        }
        if (n->ex && n->src_lo != WNONE && off >= n->src_lo) {
            tk_walk(&tv, n->ex);
            for (i = 0; i < tv.n; i++) {
                if (off < n->src_lo + tv.t[i].lo || off > n->src_lo + tv.t[i].hi) continue;
                out->kind = tv.t[i].kind;
                out->tab = tv.t[i].tab;
                out->col = tv.t[i].col;
                out->node = tv.t[i].node;
                out->anc = tv.t[i].anc;
                out->ancn = tv.t[i].ancn;
                free(tv.t);
                return 1;
            }
            free(tv.t);
        }
        return 0;
    }
    {
        int32_t ti = wb_tab_at(wb, off);
        const WTab *t;
        int32_t r;
        const WRow *rw;
        size_t base;
        if (ti < 0) return 0;
        t = &wb->tabs[ti];
        if (!t->nrows || off < tb_row_lo(t, 0)) return 0;
        r = tb_row_at(t, off);
        if (r < 0) return 0;
        rw = wb_span_row(wb, ti, (uint32_t)r);
        if (!rw) return 0;
        base = tb_row_lo(t, (uint32_t)r);
        if (rw->ahi > rw->alo && off >= base + rw->mlo && off <= base + rw->ahi + 1) {
            out->kind = RT_ANC;
            out->tab = ti;
            out->anc = wb_strdup(wb, rw->b + rw->alo, rw->ahi - rw->alo);
            out->ancn = rw->ahi - rw->alo;
            return 1;
        }
        for (c = 0; c < rw->nc && c < t->ncols; c++) {
            size_t lo, hi, slo, shi, flo, fhi;
            int ri;
            if (!wb_cell_span(rw, c, &lo, &hi) || !wb_cell_formula(rw->b, lo, hi, &slo, &shi, &flo, &fhi))
                continue;
            if (off < base + slo || off > base + shi) continue;
            ri = wb_rule_find(wb, ti, c, rw->b + slo, (uint32_t)(shi - slo));
            if (ri < 0 || !wb->rules[ri].ex) return 0;
            tk_walk(&tv, wb->rules[ri].ex);
            for (i = 0; i < tv.n; i++) {
                if (off < base + slo + tv.t[i].lo || off > base + slo + tv.t[i].hi) continue;
                out->kind = tv.t[i].kind;
                out->tab = tv.t[i].tab;
                out->col = tv.t[i].col;
                out->node = tv.t[i].node;
                out->anc = tv.t[i].anc;
                out->ancn = tv.t[i].ancn;
                free(tv.t);
                return 1;
            }
            free(tv.t);
            return 0;
        }
    }
    return 0;
}

static size_t wb_target_name(const RtxWb *wb, const WTarget *t, char *out, size_t cap) {
    if (t->kind == RT_TAB) return wb_put(out, cap, 0, wb->tabs[t->tab].name, wb->tabs[t->tab].namen);
    if (t->kind == RT_COL)
        return wb_put(out, cap, 0, wb->tabs[t->tab].cname[t->col], wb->tabs[t->tab].cnamen[t->col]);
    if (t->kind == RT_NAME) return wb_put(out, cap, 0, wb->names[t->node].name, wb->names[t->node].namen);
    if (t->kind == RT_ANC) return wb_put(out, cap, 0, t->anc, t->ancn);
    if (out && cap) out[0] = 0;
    return 0;
}

int rtx_wb_rename_target(RtxWb *wb, const RtxDoc *d, size_t off, char *out, size_t cap) {
    WTarget t;
    if (out && cap) out[0] = 0;
    if (!wb) return 0;
    rtx_wb_sync(wb, d);
    if (wb->off || !wb_target_at(wb, off, &t)) return 0;
    wb_target_name(wb, &t, out, cap);
    wb->sa.reset();
    return 1;
}

/* A new name is free in its own scope (case-insensitive). Capture across
 * scopes is found by the dry re-bind. */
static int wb_name_taken(RtxWb *wb, const WTarget *t, const char *s, size_t n) {
    uint32_t i;
    int32_t c;
    if (t->kind == RT_TAB) {
        for (i = 0; i < wb->nsheet; i++)
            if (wb->sheetn[i] == n && wb_ieq(wb->sheets[i], s, n)) return 1;
        for (i = 0; i < wb->ntab; i++)
            if ((int32_t)i != t->tab && wb->tabs[i].namen == n && wb_ieq(wb->tabs[i].name, s, n))
                return 1;
        return 0;
    }
    if (t->kind == RT_COL) {
        const WTab *tb = &wb->tabs[t->tab];
        for (c = 0; c < tb->ncols; c++)
            if (c != t->col && tb->cnamen[c] == n && wb_ieq(tb->cname[c], s, n)) return 1;
        return 0;
    }
    if (t->kind == RT_ANC) {
        WKey k;
        if (wb_is_first(s, (uint32_t)n) || wb_is_last(s, (uint32_t)n)) return 1;
        wb_anc_key(s, (uint32_t)n, &k);
        return kx_count(&wb->tabs[t->tab].anc, &k, NULL) != 0;
    }
    for (i = 0; i < wb->nnames; i++) {
        const WName *x = &wb->names[i];
        if (i == t->node || !x->def || x->namen != n || !wb_ieq(x->name, s, n)) continue;
        if (x->scope == wb->names[t->node].scope || x->scope == SC_PARAM ||
            wb->names[t->node].scope == SC_PARAM)
            return 1;
    }
    return 0;
}

static int wb_is_kw(const char *s, size_t n);

static int wb_is_ident(const char *s, size_t n) {
    size_t i;
    if (!n || !wb_id0(s[0])) return 0;
    for (i = 1; i < n; i++)
        if (!wb_id1(s[i])) return 0;
    return !wb_is_kw(s, n);
}

static void wb_msg(char *msg, size_t n, const char *s) {
    if (msg && n) snprintf(msg, n, "%s", s);
}

typedef struct {
    size_t lo, hi;
    int plain; /* 1: header cell text (never backticked) */
} WSite;

static int wb_site_cmp(const void *a, const void *b) {
    const WSite *x = (const WSite *)a, *y = (const WSite *)b;
    return x->lo < y->lo ? -1 : x->lo > y->lo;
}

typedef struct {
    WSite *s;
    size_t n, cap;
} WSites;

static int ws_push(WSites *v, size_t lo, size_t hi, int plain) {
    if (v->n >= v->cap) {
        size_t nc = v->cap ? v->cap * 2 : 64;
        WSite *ns = (WSite *)realloc(v->s, nc * sizeof(WSite));
        if (!ns) return 0;
        v->s = ns;
        v->cap = nc;
    }
    v->s[v->n].lo = lo;
    v->s[v->n].hi = hi;
    v->s[v->n].plain = plain;
    v->n++;
    return 1;
}

/* A formula's text with the target's tokens renamed; the old tokens'
 * starts mapped into it. */
static char *wb_rename_text(const char *src, uint32_t srcn, const WToks *tv, const WTarget *t,
                            const char *nm, size_t nmn, uint32_t *outn, int32_t *shift) {
    size_t cap = srcn + 1 + (size_t)tv->n * (nmn + 2), at = 0, from = 0;
    char *p = (char *)malloc(cap);
    uint32_t i;
    int32_t acc = 0;
    if (!p) return NULL;
    for (i = 0; i < tv->n; i++) {
        const WTok *k = &tv->t[i];
        shift[i] = acc;
        if (!tk_is(k, t)) continue;
        memcpy(p + at, src + from, k->lo - from);
        at += k->lo - from;
        memcpy(p + at, nm, nmn);
        at += nmn;
        from = k->hi;
        acc += (int32_t)nmn - (int32_t)(k->hi - k->lo);
    }
    memcpy(p + at, src + from, srcn - from);
    at += srcn - from;
    p[at] = 0;
    *outn = (uint32_t)at;
    return p;
}

/* Apply / undo the model's rename (dry runs). */
static void wb_model_rename(RtxWb *wb, const WTarget *t, const char *s, uint32_t n,
                            const char **save, uint32_t *saven) {
    if (t->kind == RT_TAB) {
        *save = wb->tabs[t->tab].name;
        *saven = wb->tabs[t->tab].namen;
        wb->tabs[t->tab].name = s;
        wb->tabs[t->tab].namen = n;
        wb_names(wb);
    } else if (t->kind == RT_COL) {
        *save = wb->tabs[t->tab].cname[t->col];
        *saven = wb->tabs[t->tab].cnamen[t->col];
        wb->tabs[t->tab].cname[t->col] = s;
        wb->tabs[t->tab].cnamen[t->col] = n;
    } else if (t->kind == RT_NAME) {
        *save = wb->names[t->node].name;
        *saven = wb->names[t->node].namen;
        wb->names[t->node].name = s;
        wb->names[t->node].namen = n;
        wb_names(wb);
    }
}

/* 1: renaming changes no other reference's target. */
static int wb_rename_dry(RtxWb *wb, const WTarget *t, const char *nm, size_t nmn, const char *qn,
                         size_t qnn) {
    uint32_t i, j, pass;
    int ok = 1;
    const char *save = NULL;
    uint32_t saven = 0;
    WToks a, b;
    if (t->kind == RT_ANC) return 1; /* anchors only follow `T#` and `[#` */
    memset(&a, 0, sizeof a);
    memset(&b, 0, sizeof b);
    for (pass = 0; pass < 2 && ok; pass++) {
        uint32_t nf = pass ? wb->nrules : wb->nnames;
        for (i = 0; i < nf && ok; i++) {
            const char *src;
            uint32_t srcn, nn;
            char *ns;
            int32_t *shift;
            int kind = pass ? BK_RULE : BK_NAME;
            if (pass) {
                if (wb->rules[i].dead || !wb->rules[i].refs) continue;
                src = wb->rules[i].src;
                srcn = wb->rules[i].srcn;
            } else {
                if (!wb->names[i].def || wb->names[i].clash) continue;
                src = wb->names[i].src;
                srcn = wb->names[i].srcn;
            }
            wb_dry_toks(wb, kind, i, src, srcn, &a);
            shift = (int32_t *)malloc(((size_t)a.n + 1) * sizeof(int32_t));
            if (!shift) {
                ok = 0;
                break;
            }
            ns = wb_rename_text(src, srcn, &a, t, qn, qnn, &nn, shift);
            if (!ns) {
                free(shift);
                ok = 0;
                break;
            }
            wb_model_rename(wb, t, nm, (uint32_t)nmn, &save, &saven);
            wb_dry_toks(wb, kind, i, ns, nn, &b);
            {
                const char *x;
                uint32_t xn;
                wb_model_rename(wb, t, save, saven, &x, &xn);
            }
            if (a.n != b.n) ok = 0;
            for (j = 0; j < a.n && ok; j++) {
                const WTok *p = &a.t[j], *q = &b.t[j];
                if (p->kind != q->kind || p->tab != q->tab || p->col != q->col || p->node != q->node ||
                    (int64_t)p->lo + shift[j] != (int64_t)q->lo)
                    ok = 0;
                if (ok && p->kind == RT_ANC && (p->ancn != q->ancn || memcmp(p->anc, q->anc, p->ancn)))
                    ok = 0;
            }
            free(ns);
            free(shift);
        }
    }
    free(a.t);
    free(b.t);
    wb->sa.reset();
    return ok;
}

size_t !>(CCError) rtx_wb_rename(RtxDoc *d, size_t off, const char *name, size_t n, char *msg,
                                 size_t msgn) {
    RtxWb *wb = rtx_wb_of(d);
    WTarget t;
    WSites ss;
    WToks tv;
    RtxEdit *eds;
    size_t ns, i, k;
    char old[128];
    char *bq;
    const char *qn;
    size_t qnn;
    uint32_t ti, r;
    wb_msg(msg, msgn, "");
    if (!wb) {
        wb_msg(msg, msgn, "not a workbook");
        return cc_ok((size_t)0);
    }
    rtx_wb_sync(wb, d);
    if (wb->off) {
        char cb[40], mb[80];
        wb_cap_text(cb, sizeof cb);
        snprintf(mb, sizeof mb, "workbook over %s: values are off", cb);
        wb_msg(msg, msgn, mb);
        return cc_ok((size_t)0);
    }
    if (!wb_target_at(wb, off, &t)) {
        wb_msg(msg, msgn, "no table, column, name or anchor at the caret");
        return cc_ok((size_t)0);
    }
    wb_target_name(wb, &t, old, sizeof old);
    if (!n || n > 120) {
        wb_msg(msg, msgn, "rename: empty or too long");
        return cc_ok((size_t)0);
    }
    for (i = 0; i < n; i++) {
        if (name[i] == '`' || name[i] == '|' || name[i] == '\n' || name[i] == '\r' ||
            name[i] == '#' || name[i] == '"' || (t.kind == RT_ANC && (name[i] == '}' || name[i] == '{'))) {
            wb_msg(msg, msgn, "rename: a name has no ` | # \" { } or newline");
            return cc_ok((size_t)0);
        }
    }
    if (t.kind == RT_ANC && !wb_is_ident(name, n)) {
        wb_msg(msg, msgn, "rename: an anchor is a plain name (letters, digits, _)");
        return cc_ok((size_t)0);
    }
    if (wb_ws(name[0]) || wb_ws(name[n - 1])) {
        wb_msg(msg, msgn, "rename: no leading or trailing blanks");
        return cc_ok((size_t)0);
    }
    if (strlen(old) == n && !memcmp(old, name, n)) {
        wb_msg(msg, msgn, "rename: same name");
        return cc_ok((size_t)0);
    }
    if (wb_name_taken(wb, &t, name, n)) {
        if (msg && msgn) snprintf(msg, msgn, "rename: %.*s is taken", (int)n, name);
        return cc_ok((size_t)0);
    }
    bq = (char *)malloc(n + 3);
    if (!bq) return cc_err(CC_ERR_OUT_OF_MEMORY, "rename");
    bq[0] = '`';
    memcpy(bq + 1, name, n);
    bq[n + 1] = '`';
    qn = wb_is_ident(name, n) ? name : bq;
    qnn = wb_is_ident(name, n) ? n : n + 2;
    if (!wb_rename_dry(wb, &t, name, n, qn, qnn)) {
        free(bq);
        wb_msg(msg, msgn, "rename would capture another reference: nothing changed");
        return cc_ok((size_t)0);
    }
    memset(&ss, 0, sizeof ss);
    memset(&tv, 0, sizeof tv);
    /* the definition(s) */
    if (t.kind == RT_TAB) ws_push(&ss, wb->tabs[t.tab].cap_lo, wb->tabs[t.tab].cap_hi, 0);
    else if (t.kind == RT_COL) ws_push(&ss, wb->tabs[t.tab].hlo[t.col], wb->tabs[t.tab].hhi[t.col], 1);
    else if (t.kind == RT_NAME) ws_push(&ss, wb->names[t.node].n_lo, wb->names[t.node].n_hi, 0);
    /* names' references */
    for (i = 0; i < wb->nnames; i++) {
        const WName *x = &wb->names[i];
        if (!x->def || !x->ex || x->src_lo == WNONE) continue;
        tv.n = 0;
        tk_walk(&tv, x->ex);
        for (k = 0; k < tv.n; k++)
            if (tk_is(&tv.t[k], &t)) ws_push(&ss, x->src_lo + tv.t[k].lo, x->src_lo + tv.t[k].hi, 0);
    }
    /* every formula cell (a rule's tokens at each row using it); anchors */
    for (ti = 0; ti < wb->ntab; ti++) {
        const WTab *tb = &wb->tabs[ti];
        for (r = 0; r < tb->nrows; r++) {
            WRow rr;
            size_t base = tb_row_lo(tb, r);
            int32_t c;
            wb_row_load(wb, &rr, (int32_t)ti, r, 0);
            if (t.kind == RT_ANC && t.tab == (int32_t)ti && rr.ahi > rr.alo &&
                rr.ahi - rr.alo == t.ancn && !memcmp(rr.b + rr.alo, t.anc, t.ancn)) {
                int bqd = rr.alo > 0 && rr.b[rr.alo - 1] == '`';
                ws_push(&ss, base + rr.alo - (size_t)bqd, base + rr.ahi + (size_t)bqd, 0);
            }
            for (c = 0; c < rr.nc && c < tb->ncols; c++) {
                size_t lo, hi, slo, shi, flo, fhi;
                int ri;
                if (!wb_cell_span(&rr, c, &lo, &hi) || !wb_cell_formula(rr.b, lo, hi, &slo, &shi, &flo, &fhi))
                    continue;
                ri = wb_rule_find(wb, (int32_t)ti, c, rr.b + slo, (uint32_t)(shi - slo));
                if (ri < 0 || !wb->rules[ri].ex) continue;
                tv.n = 0;
                tk_walk(&tv, wb->rules[ri].ex);
                for (k = 0; k < tv.n; k++)
                    if (tk_is(&tv.t[k], &t))
                        ws_push(&ss, base + slo + tv.t[k].lo, base + slo + tv.t[k].hi, 0);
            }
            if ((r & 1023) == 0) wb->sa.reset();
        }
    }
    free(tv.t);
    wb->sa.reset();
    qsort(ss.s, ss.n, sizeof(WSite), wb_site_cmp);
    for (i = 1, k = 1; i < ss.n; i++)
        if (ss.s[i].lo != ss.s[k - 1].lo) ss.s[k++] = ss.s[i];
    ns = ss.n ? k : 0;
    for (i = 1; i < ns; i++) {
        if (ss.s[i].lo < ss.s[i - 1].hi) {
            free(ss.s);
            free(bq);
            wb_msg(msg, msgn, "rename: overlapping sites");
            return cc_ok((size_t)0);
        }
    }
    eds = (RtxEdit *)malloc((ns ? ns : 1) * sizeof(RtxEdit));
    if (!eds) {
        free(ss.s);
        free(bq);
        return cc_err(CC_ERR_OUT_OF_MEMORY, "rename");
    }
    for (i = 0; i < ns; i++) {
        int plain = ss.s[i].plain || wb_is_ident(name, n);
        eds[i].off = ss.s[i].lo;
        eds[i].n = ss.s[i].hi - ss.s[i].lo;
        eds[i].ins = cc_slice_from_buffer(plain ? (char *)name : bq, plain ? n : n + 2);
    }
    RtxDoc_replace_batch(d, eds, ns) !>(e) {
        free(eds);
        free(ss.s);
        free(bq);
        return cc_err(e);
    };
    free(eds);
    free(ss.s);
    free(bq);
    rtx_wb_sync(wb, d);
    if (msg && msgn)
        snprintf(msg, msgn, "renamed %s to %.*s: %zu site%s, one undo step", old, (int)n, name, ns,
                 ns == 1 ? "" : "s");
    return cc_ok(ns);
}

/* ------------------------------------------------------------- anchors */

/* The anchor name the row at `off` suggests: its first cell's text as an
 * identifier (made unique in the table). */
static void wb_anchor_suggest(RtxWb *wb, int32_t ti, const WRow *rw, char *out, size_t cap) {
    const WTab *t = &wb->tabs[ti];
    size_t lo, hi, i, k = 0;
    char base[48];
    int n;
    base[0] = 0;
    if (wb_cell_span(rw, 0, &lo, &hi)) {
        for (i = lo; i < hi && k + 1 < sizeof base; i++) {
            char ch = rw->b[i];
            if (wb_id1(ch)) base[k++] = (char)(ch >= 'A' && ch <= 'Z' ? ch + 32 : ch);
            else if ((ch == ' ' || ch == '-' || ch == '.' || ch == '_') && k && base[k - 1] != '_')
                base[k++] = '_';
        }
        while (k && base[k - 1] == '_') k--;
        base[k] = 0;
    }
    if (!k || !wb_id0(base[0]) || wb_is_kw(base, k) || wb_is_first(base, (uint32_t)k) ||
        wb_is_last(base, (uint32_t)k)) {
        char tmp[48];
        snprintf(tmp, sizeof tmp, "r%s", k ? base : "ow");
        snprintf(base, sizeof base, "%s", tmp);
        k = strlen(base);
    }
    for (n = 1; n < 100000; n++) {
        WKey key;
        if (n == 1) snprintf(out, cap, "%s", base);
        else snprintf(out, cap, "%s%d", base, n);
        wb_anc_key(out, (uint32_t)strlen(out), &key);
        if (!kx_count(&t->anc, &key, NULL)) return;
    }
}

size_t !>(CCError) rtx_wb_anchor_row(RtxDoc *d, size_t off, char *msg, size_t msgn,
                                     size_t *caret) {
    RtxWb *wb = rtx_wb_of(d);
    int32_t ti, r;
    const WTab *t;
    WRow rw;
    size_t lo, hi, base;
    char nm[64], ins[80];
    wb_msg(msg, msgn, "");
    if (!wb) {
        wb_msg(msg, msgn, "not a workbook");
        return cc_ok((size_t)0);
    }
    rtx_wb_sync(wb, d);
    ti = wb->off ? -1 : wb_tab_at(wb, off);
    if (ti < 0 || !wb->tabs[ti].nrows || off < tb_row_lo(&wb->tabs[ti], 0)) {
        wb_msg(msg, msgn, "anchor: put the caret on a row of a named table");
        return cc_ok((size_t)0);
    }
    t = &wb->tabs[ti];
    r = tb_row_at(t, off);
    if (r < 0) {
        wb_msg(msg, msgn, "anchor: put the caret on a row of a named table");
        return cc_ok((size_t)0);
    }
    wb_row_load(wb, &rw, ti, (uint32_t)r, 0);
    base = tb_row_lo(t, (uint32_t)r);
    if (rw.ahi > rw.alo) {
        if (msg && msgn)
            snprintf(msg, msgn, "row already has anchor #%.*s", (int)(rw.ahi - rw.alo), rw.b + rw.alo);
        if (caret) *caret = base + rw.alo;
        return cc_ok((size_t)0);
    }
    if (!rw.nc) {
        wb_msg(msg, msgn, "anchor: the row has no cell");
        return cc_ok((size_t)0);
    }
    wb_anchor_suggest(wb, ti, &rw, nm, sizeof nm);
    lo = rw.clo[0];
    hi = rw.chi[0];
    wb_trim(rw.b, &lo, &hi);
    snprintf(ins, sizeof ins, "{#%s}%s", nm, lo < hi ? " " : "");
    if (lo == hi && lo > rw.clo[0]) {
        /* an empty first cell: the anchor alone */
    }
    RtxDoc_replace(d, base + lo, 0, cc_slice_from_buffer(ins, strlen(ins))) !>(e) {
        return cc_err(e);
    };
    if (caret) *caret = base + lo + 2;
    if (msg && msgn) snprintf(msg, msgn, "anchored the row: #%s (F2 renames it)", nm);
    return cc_ok((size_t)1);
}

int rtx_wb_row_ref(RtxWb *wb, const RtxDoc *d, size_t off, char *out, size_t cap, char *msg,
                   size_t msgn) {
    int32_t ti, r, c, col = 0;
    const WTab *t;
    WRow rw;
    size_t base;
    char tn[140], cn[140], an[140];
    if (out && cap) out[0] = 0;
    wb_msg(msg, msgn, "");
    if (!wb) {
        wb_msg(msg, msgn, "not a workbook");
        return 0;
    }
    rtx_wb_sync(wb, d);
    ti = wb->off ? -1 : wb_tab_at(wb, off);
    if (ti < 0 || !wb->tabs[ti].nrows || off < tb_row_lo(&wb->tabs[ti], 0)) {
        wb_msg(msg, msgn, "put the caret on a row of a named table");
        return 0;
    }
    t = &wb->tabs[ti];
    r = tb_row_at(t, off);
    if (r < 0) return 0;
    wb_row_load(wb, &rw, ti, (uint32_t)r, 0);
    base = tb_row_lo(t, (uint32_t)r);
    if (rw.ahi <= rw.alo) {
        wb_msg(msg, msgn, "row has no anchor \xe2\x80\x94 use Workbook: Anchor Row");
        return 0;
    }
    for (c = 0; c < rw.nc && c < t->ncols; c++)
        if (off >= base + rw.clo[c] && off <= base + rw.chi[c]) col = c;
#define WB_Q(dst, s, n)                                                                  \
    do {                                                                                 \
        if (wb_is_ident((s), (n))) snprintf((dst), sizeof(dst), "%.*s", (int)(n), (s));   \
        else snprintf((dst), sizeof(dst), "`%.*s`", (int)(n), (s));                       \
    } while (0)
    WB_Q(tn, t->name, t->namen);
    WB_Q(cn, t->cname[col], t->cnamen[col]);
    WB_Q(an, rw.b + rw.alo, rw.ahi - rw.alo);
#undef WB_Q
    snprintf(out, cap, "%s#%s.%s", tn, an, cn);
    if (msg && msgn) snprintf(msg, msgn, "copied %s", out);
    wb->sa.reset();
    return 1;
}

/* ---------------------------------------------------------------- status */

static int wb_describe_at(RtxWb *wb, const RtxDoc *d, size_t off, char *out, size_t cap) {
    int64_t k;
    char lb[160], vb[320], tail[64];
    uint32_t i;
    int32_t c;
    int32_t tab;
    uint32_t pos;
    int col;
    size_t flo, fhi;
    if (out && cap) out[0] = 0;
    if (!wb) return 0;
    wb_sync_ex(wb, d, 1);
    tail[0] = 0;
    if (wb->scan) {
        snprintf(out, cap, "workbook: recalculating \xe2\x80\x94 reading %d%%", rtx_wb_progress(d));
        return 1;
    }
    if (wb->off) {
        char cb[40];
        wb_cap_text(cb, sizeof cb);
        snprintf(out, cap, "workbook over %s: values off", cb);
        return 1;
    }
    wb->opgen++;
    k = wb_name_find(wb, off);
    if (k >= 0 && wb->names[k].def && off >= wb->names[k].raw_lo && off <= wb->names[k].raw_hi) {
        const WName *n = &wb->names[k];
        const WGNode *g = n->node != WN32 ? &wb->g[n->node] : NULL;
        wb_name_label(wb, (uint32_t)k, lb, sizeof lb);
        wv_fmt(&n->v, vb, sizeof vb, 1);
        if (n->v.t == WV_ERR) snprintf(out, cap, "%s %s%s", lb, vb, tail);
        else
            snprintf(out, cap, "%s = %s%s  (%s; %u input%s, %u dependent%s)%s", lb,
                     n->pend ? WB_STALE_MARK : "", n->v.t == WV_NULL ? "(empty)" : vb, wv_kind(&n->v),
                     g ? (unsigned)g->ndeps : 0, g && g->ndeps == 1 ? "" : "s", g ? (unsigned)g->rdn : 0,
                     g && g->rdn == 1 ? "" : "s", tail);
        return 1;
    }
    if (wb_cell_at_off(wb, off, &tab, &pos, &col, &flo, &fhi) || 0) {
        char g[RTX_WB_VAL_MAX + 8];
        size_t gn = 0;
        ECtx e;
        WRow *r;
        WVal v;
        int ri;
        const WRow *rw = wb_span_row(wb, tab, pos);
        size_t lo, hi, slo, shi, a, b;
        (void)g;
        (void)gn;
        ectx_init(&e, wb);
        e.view = 1;
        r = wb_ring_get(&e, tab, pos);
        v = r ? wb_cell_eval(&e, r, col) : wv_null();
        wb_cell_label(wb, tab, (int32_t)pos, col, lb, sizeof lb);
        wv_fmt(&v, vb, sizeof vb, 1);
        ri = -1;
        if (rw && wb_cell_span(rw, col, &lo, &hi) && wb_cell_formula(rw->b, lo, hi, &slo, &shi, &a, &b))
            ri = wb_rule_find(wb, tab, col, rw->b + slo, (uint32_t)(shi - slo));
        if (v.t == WV_ERR) {
            snprintf(out, cap, "%s %s%s", lb, vb, tail);
        } else {
            const WRule *ru = ri >= 0 ? &wb->rules[ri] : NULL;
            const WGNode *cg = &wb->g[wb->tabs[tab].cnode[col]];
            snprintf(out, cap, "%s = %s%s  (%s; %u input%s, %u dependent%s)%s", lb,
                     e.stale ? WB_STALE_MARK : "", v.t == WV_NULL ? "(empty)" : vb, wv_kind(&v),
                     ru ? (unsigned)ru->nin : 0, ru && ru->nin == 1 ? "" : "s", (unsigned)(cg->rdn + 1),
                     cg->rdn + 1 == 1 ? "" : "s", tail);
        }
        wb->sa.reset();
        return 1;
    }
    for (i = 0; i < wb->ntab; i++) {
        const WTab *t = &wb->tabs[i];
        if (off < t->lo || off > t->hi) continue;
        for (c = 0; c < t->ncols; c++) {
            if (t->hlo[c] != WNONE && off >= t->hlo[c] && off <= t->hhi[c]) {
                WVal z = wv_null();
                z.t = t->ct[c];
                snprintf(out, cap, "column %.*s.%.*s  (%s%s)%s", (int)t->namen, t->name,
                         (int)t->cnamen[c], t->cname[c], t->cclash[c] ? "#dup " : "", wv_kind(&z), tail);
                return 1;
            }
        }
        if (t->nrows && off >= tb_row_lo(t, 0)) {
            int32_t r = tb_row_at(t, off);
            const WRow *rw = r >= 0 ? wb_span_row(wb, (int32_t)i, (uint32_t)r) : NULL;
            size_t base = r >= 0 ? tb_row_lo(t, (uint32_t)r) : 0;
            if (rw && rw->ahi > rw->alo && off >= base + rw->mlo && off <= base + rw->ahi + 1) {
                WKey key;
                uint32_t cnt;
                wb_anc_key(rw->b + rw->alo, rw->ahi - rw->alo, &key);
                cnt = kx_count(&t->anc, &key, NULL);
                snprintf(out, cap, "anchor %.*s#%.*s  (row %d%s)%s", (int)t->namen, t->name,
                         (int)(rw->ahi - rw->alo), rw->b + rw->alo, (int)r + 1,
                         cnt > 1 ? "; #dup: another row has it" : "", tail);
                return 1;
            }
            if (rw) {
                int32_t cc;
                for (cc = 0; cc < rw->nc && cc < t->ncols; cc++) {
                    if (off < base + rw->clo[cc] || off > base + rw->chi[cc]) continue;
                    {
                        ECtx e;
                        WRow *rr;
                        WVal v;
                        ectx_init(&e, wb);
                        e.view = 1;
                        rr = wb_ring_get(&e, (int32_t)i, (uint32_t)r);
                        v = rr ? wb_cell_eval(&e, rr, cc) : wv_null();
                        wb_cell_label(wb, (int32_t)i, r, cc, lb, sizeof lb);
                        wv_fmt(&v, vb, sizeof vb, 1);
                        snprintf(out, cap, "%s = %s  (%s)%s", lb, v.t == WV_NULL ? "(empty)" : vb,
                                 wv_kind(&v), tail);
                        wb->sa.reset();
                        return 1;
                    }
                }
            }
        }
        snprintf(out, cap, "table %.*s  (%d column%s, %u row%s)%s%s", (int)t->namen, t->name,
                 (int)t->ncols, t->ncols == 1 ? "" : "s", (unsigned)t->nrows, t->nrows == 1 ? "" : "s",
                 t->big ? "  over the row cap: refused" : "", tail);
        return 1;
    }
    if (tail[0]) {
        snprintf(out, cap, "workbook:%s", tail);
        return 1;
    }
    return 0;
}


/* The status: the progress first (a narrow status line keeps it), then
 * the element at the caret. */
int rtx_wb_describe(RtxWb *wb, const RtxDoc *d, size_t off, char *out, size_t cap) {
    char pre[80];
    int r;
    size_t pn, on;
    if (out && cap) out[0] = 0;
    if (!wb || !out || !cap) return 0;
    wb_sync_ex(wb, d, 1);
    pre[0] = 0;
    if (!wb->scan && !wb->off) {
        if (wb->cancelled)
            snprintf(pre, sizeof pre, "recalculation cancelled (stale values)  ");
        else if (wb->jobs && rtx_wb_busy(d))
            snprintf(pre, sizeof pre, "recalculating %d%%  ", rtx_wb_progress(d));
    }
    r = wb_describe_at(wb, d, off, out, cap);
    pn = strlen(pre);
    if (!pn) return r;
    if (!r) {
        /* no element at the caret: the progress alone */
        pre[pn - 2] = 0;
        snprintf(out, cap, "workbook: %s", pre);
        return 1;
    }
    on = strlen(out);
    if (pn + on + 1 > cap) on = cap > pn + 1 ? cap - pn - 1 : 0;
    memmove(out + pn, out, on);
    memcpy(out, pre, pn < cap ? pn : cap - 1);
    out[pn + on < cap ? pn + on : cap - 1] = 0;
    return 1;
}
