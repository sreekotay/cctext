static volatile int g_light;
static volatile unsigned g_gen = 1;

uint32_t rtx_pal_of(int light, RtxPalId id) {
    if ((unsigned)id >= (unsigned)RTX_P__N) return 0;
    return light ? g_pal[id].light : g_pal[id].dark;
}

uint32_t rtx_pal(RtxPalId id) { return rtx_pal_of(g_light, id); }

const char *rtx_pal_sgr_of(int light, RtxPalId id) {
    if ((unsigned)id >= (unsigned)RTX_P__N) return NULL;
    return light ? g_pal[id].sgr_light : g_pal[id].sgr_dark;
}

const char *rtx_pal_sgr(RtxPalId id) { return rtx_pal_sgr_of(g_light, id); }

const char *rtx_pal_name(RtxPalId id) {
    if ((unsigned)id >= (unsigned)RTX_P__N) return "";
    return g_pal[id].name;
}

int rtx_theme_light(void) { return g_light; }

int rtx_theme_set(int light) {
    light = light != 0;
    if (light == g_light) return 0;
    g_light = light;
    g_gen++;
    return 1;
}

unsigned rtx_theme_gen(void) { return g_gen; }

static volatile int g_mode = RTX_THEME_AUTO;
static volatile int32_t g_term_bg = -1;

int rtx_theme_mode(void) { return g_mode; }

void rtx_theme_mode_set(int mode) {
    if (mode >= RTX_THEME_DARK && mode <= RTX_THEME_AUTO) g_mode = mode;
}

int32_t rtx_theme_term_bg(void) { return g_term_bg; }

void rtx_theme_term_bg_set(int32_t rgb) { g_term_bg = rgb < 0 ? -1 : (rgb & 0xffffff); }

int rtx_theme_mode_parse(const char *s) {
    if (!s) return -1;
    if (!strcmp(s, "dark")) return RTX_THEME_DARK;
    if (!strcmp(s, "light")) return RTX_THEME_LIGHT;
    if (!strcmp(s, "auto")) return RTX_THEME_AUTO;
    return -1;
}

const char *rtx_theme_mode_name(int mode) {
    return mode == RTX_THEME_LIGHT ? "light" : mode == RTX_THEME_DARK ? "dark" : "auto";
}

/* x^2.4 for x in (0, 1] without libm: x^2 * fifth root of x^2 (Newton). */
static double pal_pow24(double x) {
    double a = x * x, y = 1.0;
    int i;
    for (i = 0; i < 60; i++) {
        double y4 = y * y * y * y;
        double ny = y - (y4 * y - a) / (5.0 * y4);
        if (ny == y) break;
        y = ny;
    }
    return a * y;
}

static double pal_lin(unsigned c) {
    double v = (double)c / 255.0;
    return v <= 0.04045 ? v / 12.92 : pal_pow24((v + 0.055) / 1.055);
}

double rtx_rgb_luminance(uint32_t rgb) {
    return 0.2126 * pal_lin((rgb >> 16) & 255) + 0.7152 * pal_lin((rgb >> 8) & 255) +
           0.0722 * pal_lin(rgb & 255);
}

double rtx_rgb_contrast(uint32_t a, uint32_t b) {
    double la = rtx_rgb_luminance(a), lb = rtx_rgb_luminance(b);
    if (la < lb) {
        double t = la;
        la = lb;
        lb = t;
    }
    return (la + 0.05) / (lb + 0.05);
}

int rtx_rgb_is_light(uint32_t rgb) {
    /* (Y + .05) / .05 > 1.05 / (Y + .05)  <=>  Y > sqrt(.0525) - .05 (0.1791) */
    return rtx_rgb_luminance(rgb) > 0.1791;
}

size_t rtx_pal_pairs(const RtxPalPair **out) {
    if (out) *out = g_pairs;
    return sizeof g_pairs / sizeof g_pairs[0];
}

double rtx_pal_pair_min(int kind) { return kind == RTX_PAL_TEXT ? 4.5 : 3.0; }

static int pal_hex(int c) {
    if (c >= '0' && c <= '9') return c - '0';
    if (c >= 'a' && c <= 'f') return c - 'a' + 10;
    if (c >= 'A' && c <= 'F') return c - 'A' + 10;
    return -1;
}

/* One channel of 1-4 hex digits, scaled to 8 bits. */
static int pal_chan(const char *s, size_t n, size_t *at, unsigned *out) {
    unsigned v = 0;
    size_t k = 0;
    while (*at + k < n && k < 5 && pal_hex((unsigned char)s[*at + k]) >= 0) {
        v = v * 16u + (unsigned)pal_hex((unsigned char)s[*at + k]);
        k++;
    }
    if (k < 1 || k > 4) return 0;
    {
        unsigned max = (1u << (4 * k)) - 1u;
        *out = (v * 255u + max / 2u) / max;
    }
    *at += k;
    return 1;
}

int rtx_theme_parse_rgb(const char *s, size_t n, uint32_t *rgb) {
    size_t at = 0;
    unsigned c[3];
    int i;
    if (!s || !rgb) return 0;
    if (n >= 4 && !memcmp(s, "rgb:", 4)) {
        at = 4;
    } else if (n >= 5 && !memcmp(s, "rgba:", 5)) {
        at = 5;
    } else if (n == 7 && s[0] == '#') {
        for (i = 0; i < 6; i++)
            if (pal_hex((unsigned char)s[1 + i]) < 0) return 0;
        *rgb = (uint32_t)strtoul(s + 1, NULL, 16) & 0xffffffu;
        return 1;
    } else if (n == 4 && s[0] == '#') {
        unsigned v = 0;
        for (i = 0; i < 3; i++) {
            int h = pal_hex((unsigned char)s[1 + i]);
            if (h < 0) return 0;
            v = (v << 8) | (unsigned)(h * 17);
        }
        *rgb = v;
        return 1;
    } else {
        return 0;
    }
    for (i = 0; i < 3; i++) {
        if (i && (at >= n || s[at++] != '/')) return 0;
        if (!pal_chan(s, n, &at, &c[i])) return 0;
    }
    *rgb = ((uint32_t)c[0] << 16) | ((uint32_t)c[1] << 8) | (uint32_t)c[2];
    return 1;
}

int rtx_theme_osc11(const unsigned char *b, size_t n, uint32_t *rgb) {
    size_t e;
    if (!b || n < 7 || b[0] != 0x1b || b[1] != ']' || b[2] != '1' || b[3] != '1' || b[4] != ';')
        return 0;
    for (e = 5; e < n; e++)
        if (b[e] == 0x07 || b[e] == 0x1b) break;
    if (e >= n) return 0;
    return rtx_theme_parse_rgb((const char *)b + 5, e - 5, rgb);
}

int rtx_theme_colorfgbg(const char *v) {
    const char *last;
    char *end;
    long bg;
    if (!v || !v[0]) return -1;
    last = strrchr(v, ';');
    if (!last || !last[1]) return -1;
    last++;
    if (!strcmp(last, "default")) return -1;
    bg = strtol(last, &end, 10);
    if (end == last || *end || bg < 0 || bg > 255) return -1;
    /* rxvt's convention: 0-6 and 8 are dark backgrounds, 7 and 9-15
     * light; beyond 15 the palette colour decides. */
    if (bg < 16) return (bg == 7 || bg >= 9) ? 1 : 0;
    return rtx_rgb_is_light(rtx_theme_x256((int)bg));
}

uint32_t rtx_theme_x256(int i) {
    static const uint32_t ansi[16] = {0x000000, 0xcd0000, 0x00cd00, 0xcdcd00, 0x0000ee, 0xcd00cd,
                                      0x00cdcd, 0xe5e5e5, 0x7f7f7f, 0xff0000, 0x00ff00, 0xffff00,
                                      0x5c5cff, 0xff00ff, 0x00ffff, 0xffffff};
    static const unsigned lv[6] = {0, 95, 135, 175, 215, 255};
    if (i < 0) i = 0;
    if (i > 255) i = 255;
    if (i < 16) return ansi[i];
    if (i < 232) {
        i -= 16;
        return ((uint32_t)lv[i / 36] << 16) | ((uint32_t)lv[(i / 6) % 6] << 8) | lv[i % 6];
    }
    {
        uint32_t g = (uint32_t)(8 + 10 * (i - 232));
        return (g << 16) | (g << 8) | g;
    }
}

void rtx_pal_sgr_rgb(const char *sgr, int32_t *fg, int32_t *bg) {
    long par[16];
    int np = 0, i;
    const char *s = sgr;
    *fg = -1;
    *bg = -1;
    if (!s) return;
    while (*s) {
        if (s[0] == 0x1b && s[1] == '[') {
            char *end;
            s += 2;
            np = 0;
            for (;;) {
                long v = strtol(s, &end, 10);
                if (end == s) v = 0;
                if (np < 16) par[np++] = v;
                s = end;
                if (*s == ';') {
                    s++;
                    continue;
                }
                break;
            }
            if (*s != 'm') continue;
            s++;
            for (i = 0; i < np; i++) {
                long v = par[i];
                if ((v == 38 || v == 48) && i + 2 < np && par[i + 1] == 5) {
                    uint32_t c = rtx_theme_x256((int)par[i + 2]);
                    if (v == 38) *fg = (int32_t)c;
                    else *bg = (int32_t)c;
                    i += 2;
                } else if (v == 0) {
                    *fg = -1;
                    *bg = -1;
                } else if (v >= 30 && v <= 37) {
                    *fg = (int32_t)rtx_theme_x256((int)v - 30);
                } else if (v >= 90 && v <= 97) {
                    *fg = (int32_t)rtx_theme_x256((int)v - 90 + 8);
                } else if (v >= 40 && v <= 47) {
                    *bg = (int32_t)rtx_theme_x256((int)v - 40);
                } else if (v >= 100 && v <= 107) {
                    *bg = (int32_t)rtx_theme_x256((int)v - 100 + 8);
                }
            }
        } else {
            s++;
        }
    }
}
