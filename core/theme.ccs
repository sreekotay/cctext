#!ccc ccs
/*
 * Editor themes (theme.cch). The palette is data: one row a role, dark and
 * light colours and SGRs. Linked into rtx_scope (every host has it).
 */
#include "theme.cch"

#include <stdlib.h>
#include <string.h>

