#!ccc cch
/*
 * Headless command runner (--batch). Semantic verbs, not keystrokes.
 * Bodies in batch.ccs (linked TU).
 */
#ifndef RTX_BATCH_H
#define RTX_BATCH_H

#include <stdio.h>
#include "workspace.cch"

enum {
    RTX_BATCH_OK = 0,
    RTX_BATCH_QUIT = 1,
    RTX_BATCH_ERR = 2
};

/* Run one script line. Blank / # comments → OK. quit → QUIT. */
int rtx_batch_exec(RtxWs *w, const char *line, FILE *out, FILE *err);

/* Run cmds[0..n). Stops on quit or first error. 0 ok, 1 error. */
int rtx_batch_run(RtxWs *w, char **cmds, int n, FILE *out, FILE *err);

/* Read lines from fp until EOF. 0 ok, 1 error. */
int rtx_batch_run_fp(RtxWs *w, FILE *fp, FILE *out, FILE *err);

/* project-files / project-search root (--project DIR); "" = the git
 * root above the active buffer, else the cwd. */
void rtx_batch_set_project(const char *dir);
/* Join and free the batch project (rtx_batch_run does this at the end). */
void rtx_batch_project_close(void);

/* Same fields as Esc/= engine stats; raw counts for scripts. */
void rtx_batch_write_stats_json(FILE *fp, const RtxBuf *b);

#endif /* RTX_BATCH_H */
