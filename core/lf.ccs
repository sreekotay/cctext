#!ccc ccs
/*
 * Line-feed counting (linked TU; see lf.cch).
 *
 * Count: compare a vector with '\n' (0xFF per match), subtract into byte
 * accumulators for up to 255 rounds, then sum the bytes (SAD on x86,
 * vaddlvq on arm64). No popcount instruction is needed on the SSE2 path.
 *
 * Nth: count whole 1 KiB chunks until the k-th newline is inside one,
 * then walk 64-byte (x86) / 16-byte (arm64) / 8-byte (SWAR) match masks.
 *
 * SWAR mask: x = w ^ 0x0A..; ((x & 0x7F..) + 0x7F..) | x has the high bit
 * clear exactly in the bytes where x == 0 (the add never carries into the
 * next byte), so there are no false matches to correct.
 */
#include <ccc/std/prelude.cch>
#include <stddef.h>
#include <stdint.h>
#include <string.h>
#include "lf.cch"

#if defined(__x86_64__)
#define LF_X86 1
#include <immintrin.h>
#elif defined(__aarch64__) && defined(__ARM_NEON)
#define LF_NEON 1
#include <arm_neon.h>
#endif

#if defined(__BYTE_ORDER__) && __BYTE_ORDER__ == __ORDER_LITTLE_ENDIAN__
#define LF_LE 1
#endif

#define LF_ONES 0x0101010101010101ULL
#define LF_HIGH 0x8080808080808080ULL
#define LF_LOW7 0x7F7F7F7F7F7F7F7FULL
#define LF_PAT 0x0A0A0A0A0A0A0A0AULL
#define LF_CHUNK 1024
#define LF_NONE ((size_t)-1)

static inline uint64_t lf_load64(const unsigned char *p) {
    uint64_t v;
    memcpy(&v, p, 8);
    return v;
}

/* 0x80 in each byte of w that is '\n', else 0. */
static inline uint64_t lf_swar_mask(uint64_t w) {
    uint64_t x = w ^ LF_PAT;
    uint64_t t = ((x & LF_LOW7) + LF_LOW7) | x;
    return ~t & LF_HIGH;
}

#if defined(__x86_64__)
/* Bits set in a 64-bit mask, no popcnt instruction. */
static inline size_t lf_pop64(uint64_t m) {
    m = m - ((m >> 1) & 0x5555555555555555ULL);
    m = (m & 0x3333333333333333ULL) + ((m >> 2) & 0x3333333333333333ULL);
    m = (m + (m >> 4)) & 0x0F0F0F0F0F0F0F0FULL;
    return (size_t)((m * LF_ONES) >> 56);
}
#endif

/* Index of the r-th (0-based) set bit of m; m has more than r bits. */
static inline unsigned lf_select64(uint64_t m, size_t r) {
    while (r--) m &= m - 1;
    return (unsigned)__builtin_ctzll(m);
}

/* ------------------------------------------------------------- SWAR */

static size_t lf_count_swar(const unsigned char *p, size_t n) {
    size_t c = 0;
    while (n >= 8) {
        size_t w = n / 8, i;
        uint64_t acc = 0;
        if (w > 255) w = 255;
        n -= w * 8;
        for (i = 0; i < w; i++) {
            acc += lf_swar_mask(lf_load64(p)) >> 7;
            p += 8;
        }
        acc = (acc & 0x00FF00FF00FF00FFULL) + ((acc >> 8) & 0x00FF00FF00FF00FFULL);
        c += (size_t)((acc * 0x0001000100010001ULL) >> 48);
    }
    while (n--) c += *p++ == '\n';
    return c;
}

/* nth from p[0, n); `s` newlines already seen before p. */
static size_t lf_nth_swar(const unsigned char *p, size_t n, size_t k, size_t *s) {
    size_t i = 0;
#ifdef LF_LE
    for (; i + 8 <= n; i += 8) {
        uint64_t m = lf_swar_mask(lf_load64(p + i));
        size_t c;
        if (!m) continue;
        c = (size_t)(((m >> 7) * LF_ONES) >> 56);
        if (*s + c >= k) {
            unsigned b = lf_select64(m, k - *s - 1);
            *s = k;
            return i + (b >> 3);
        }
        *s += c;
    }
#endif
    for (; i < n; i++) {
        if (p[i] == '\n' && ++*s == k) return i;
    }
    return LF_NONE;
}

static size_t lf_last_swar(const unsigned char *p, size_t n) {
    size_t i = n;
#ifdef LF_LE
    while (i >= 8) {
        uint64_t m = lf_swar_mask(lf_load64(p + i - 8));
        if (m) return i - 8 + ((63u - (unsigned)__builtin_clzll(m)) >> 3);
        i -= 8;
    }
#endif
    while (i > 0) {
        i--;
        if (p[i] == '\n') return i;
    }
    return LF_NONE;
}

/* ------------------------------------------------------------ x86-64 */

#ifdef LF_X86
static size_t lf_count_sse2(const unsigned char *p, size_t n) {
    const __m128i nl = _mm_set1_epi8('\n');
    const __m128i z = _mm_setzero_si128();
    size_t c = 0;
    while (n >= 64) {
        size_t b = n / 64;
        __m128i a0 = z, a1 = z, a2 = z, a3 = z, s;
        if (b > 255) b = 255;
        n -= b * 64;
        while (b--) {
            a0 = _mm_sub_epi8(a0, _mm_cmpeq_epi8(_mm_loadu_si128((const __m128i *)p), nl));
            a1 = _mm_sub_epi8(a1, _mm_cmpeq_epi8(_mm_loadu_si128((const __m128i *)(p + 16)), nl));
            a2 = _mm_sub_epi8(a2, _mm_cmpeq_epi8(_mm_loadu_si128((const __m128i *)(p + 32)), nl));
            a3 = _mm_sub_epi8(a3, _mm_cmpeq_epi8(_mm_loadu_si128((const __m128i *)(p + 48)), nl));
            p += 64;
        }
        s = _mm_add_epi64(_mm_add_epi64(_mm_sad_epu8(a0, z), _mm_sad_epu8(a1, z)),
                          _mm_add_epi64(_mm_sad_epu8(a2, z), _mm_sad_epu8(a3, z)));
        c += (size_t)_mm_cvtsi128_si64(s) +
             (size_t)_mm_cvtsi128_si64(_mm_unpackhi_epi64(s, s));
    }
    return c + lf_count_swar(p, n);
}

static inline uint64_t lf_mask64_sse2(const unsigned char *p, __m128i nl) {
    uint64_t m0 = (uint32_t)_mm_movemask_epi8(
        _mm_cmpeq_epi8(_mm_loadu_si128((const __m128i *)p), nl));
    uint64_t m1 = (uint32_t)_mm_movemask_epi8(
        _mm_cmpeq_epi8(_mm_loadu_si128((const __m128i *)(p + 16)), nl));
    uint64_t m2 = (uint32_t)_mm_movemask_epi8(
        _mm_cmpeq_epi8(_mm_loadu_si128((const __m128i *)(p + 32)), nl));
    uint64_t m3 = (uint32_t)_mm_movemask_epi8(
        _mm_cmpeq_epi8(_mm_loadu_si128((const __m128i *)(p + 48)), nl));
    return m0 | (m1 << 16) | (m2 << 32) | (m3 << 48);
}

static size_t lf_nth_sse2(const unsigned char *p, size_t n, size_t k, size_t *s) {
    const __m128i nl = _mm_set1_epi8('\n');
    size_t i = 0, r;
    for (; i + 64 <= n; i += 64) {
        uint64_t m = lf_mask64_sse2(p + i, nl);
        size_t c;
        if (!m) continue;
        c = lf_pop64(m);
        if (*s + c >= k) {
            unsigned b = lf_select64(m, k - *s - 1);
            *s = k;
            return i + b;
        }
        *s += c;
    }
    r = lf_nth_swar(p + i, n - i, k, s);
    return r == LF_NONE ? LF_NONE : i + r;
}

static size_t lf_last_sse2(const unsigned char *p, size_t n) {
    const __m128i nl = _mm_set1_epi8('\n');
    size_t i = n;
    while (i >= 16) {
        unsigned m = (unsigned)_mm_movemask_epi8(
            _mm_cmpeq_epi8(_mm_loadu_si128((const __m128i *)(p + i - 16)), nl));
        if (m) return i - 16 + (31u - (unsigned)__builtin_clz(m));
        i -= 16;
    }
    return lf_last_swar(p, i);
}

__attribute__((target("avx2")))
static size_t lf_count_avx2(const unsigned char *p, size_t n) {
    const __m256i nl = _mm256_set1_epi8('\n');
    const __m256i z = _mm256_setzero_si256();
    size_t c = 0;
    while (n >= 128) {
        size_t b = n / 128;
        __m256i a0 = z, a1 = z, a2 = z, a3 = z, s;
        __m128i h;
        if (b > 255) b = 255;
        n -= b * 128;
        while (b--) {
            a0 = _mm256_sub_epi8(a0, _mm256_cmpeq_epi8(_mm256_loadu_si256((const __m256i *)p), nl));
            a1 = _mm256_sub_epi8(a1, _mm256_cmpeq_epi8(_mm256_loadu_si256((const __m256i *)(p + 32)), nl));
            a2 = _mm256_sub_epi8(a2, _mm256_cmpeq_epi8(_mm256_loadu_si256((const __m256i *)(p + 64)), nl));
            a3 = _mm256_sub_epi8(a3, _mm256_cmpeq_epi8(_mm256_loadu_si256((const __m256i *)(p + 96)), nl));
            p += 128;
        }
        s = _mm256_add_epi64(_mm256_add_epi64(_mm256_sad_epu8(a0, z), _mm256_sad_epu8(a1, z)),
                             _mm256_add_epi64(_mm256_sad_epu8(a2, z), _mm256_sad_epu8(a3, z)));
        h = _mm_add_epi64(_mm256_castsi256_si128(s), _mm256_extracti128_si256(s, 1));
        c += (size_t)_mm_cvtsi128_si64(h) + (size_t)_mm_cvtsi128_si64(_mm_unpackhi_epi64(h, h));
    }
    return c + lf_count_sse2(p, n);
}

__attribute__((target("avx2,popcnt")))
static size_t lf_nth_avx2(const unsigned char *p, size_t n, size_t k, size_t *s) {
    const __m256i nl = _mm256_set1_epi8('\n');
    size_t i = 0, r;
    for (; i + 64 <= n; i += 64) {
        uint64_t lo = (uint32_t)_mm256_movemask_epi8(
            _mm256_cmpeq_epi8(_mm256_loadu_si256((const __m256i *)(p + i)), nl));
        uint64_t hi = (uint32_t)_mm256_movemask_epi8(
            _mm256_cmpeq_epi8(_mm256_loadu_si256((const __m256i *)(p + i + 32)), nl));
        uint64_t m = lo | (hi << 32);
        size_t c;
        if (!m) continue;
        c = (size_t)__builtin_popcountll(m);
        if (*s + c >= k) {
            unsigned b = lf_select64(m, k - *s - 1);
            *s = k;
            return i + b;
        }
        *s += c;
    }
    r = lf_nth_swar(p + i, n - i, k, s);
    return r == LF_NONE ? LF_NONE : i + r;
}
#endif

/* ------------------------------------------------------------- arm64 */

#ifdef LF_NEON
static size_t lf_count_neon(const unsigned char *p, size_t n) {
    const uint8x16_t nl = vdupq_n_u8('\n');
    size_t c = 0;
    while (n >= 64) {
        size_t b = n / 64;
        uint8x16_t a0 = vdupq_n_u8(0), a1 = a0, a2 = a0, a3 = a0;
        if (b > 255) b = 255;
        n -= b * 64;
        while (b--) {
            a0 = vsubq_u8(a0, vceqq_u8(vld1q_u8(p), nl));
            a1 = vsubq_u8(a1, vceqq_u8(vld1q_u8(p + 16), nl));
            a2 = vsubq_u8(a2, vceqq_u8(vld1q_u8(p + 32), nl));
            a3 = vsubq_u8(a3, vceqq_u8(vld1q_u8(p + 48), nl));
            p += 64;
        }
        c += (size_t)vaddlvq_u8(a0) + (size_t)vaddlvq_u8(a1) +
             (size_t)vaddlvq_u8(a2) + (size_t)vaddlvq_u8(a3);
    }
    return c + lf_count_swar(p, n);
}

/* One bit (the top of each nibble) per matching byte: bit 4*i + 3. */
static inline uint64_t lf_mask16_neon(const unsigned char *p, uint8x16_t nl) {
    uint8x8_t sh = vshrn_n_u16(vreinterpretq_u16_u8(vceqq_u8(vld1q_u8(p), nl)), 4);
    return vget_lane_u64(vreinterpret_u64_u8(sh), 0) & 0x8888888888888888ULL;
}

static size_t lf_nth_neon(const unsigned char *p, size_t n, size_t k, size_t *s) {
    const uint8x16_t nl = vdupq_n_u8('\n');
    size_t i = 0, r;
    for (; i + 16 <= n; i += 16) {
        uint64_t m = lf_mask16_neon(p + i, nl);
        size_t c;
        if (!m) continue;
        c = (size_t)__builtin_popcountll(m);
        if (*s + c >= k) {
            unsigned b = lf_select64(m, k - *s - 1);
            *s = k;
            return i + (b >> 2);
        }
        *s += c;
    }
    r = lf_nth_swar(p + i, n - i, k, s);
    return r == LF_NONE ? LF_NONE : i + r;
}

static size_t lf_last_neon(const unsigned char *p, size_t n) {
    const uint8x16_t nl = vdupq_n_u8('\n');
    size_t i = n;
    while (i >= 16) {
        uint64_t m = lf_mask16_neon(p + i - 16, nl);
        if (m) return i - 16 + ((63u - (unsigned)__builtin_clzll(m)) >> 2);
        i -= 16;
    }
    return lf_last_swar(p, i);
}
#endif

/* ---------------------------------------------------------- dispatch */

#ifdef LF_X86
static int lf_best_cache;
#endif
static int lf_cap;

static int lf_best(void) {
#ifdef LF_X86
    int v = __atomic_load_n(&lf_best_cache, __ATOMIC_RELAXED);
    if (!v) {
        __builtin_cpu_init();
        v = __builtin_cpu_supports("avx2") ? RTX_LF_WIDE : RTX_LF_SIMD;
        __atomic_store_n(&lf_best_cache, v, __ATOMIC_RELAXED);
    }
    return v;
#elif defined(LF_NEON)
    return RTX_LF_SIMD;
#else
    return RTX_LF_SWAR;
#endif
}

static inline int lf_level(void) {
    int b = lf_best();
    int c = __atomic_load_n(&lf_cap, __ATOMIC_RELAXED);
    return c && c < b ? c : b;
}

int rtx_lf_force(int level) {
    if (level < RTX_LF_BEST || level > lf_best()) return 0;
    __atomic_store_n(&lf_cap, level, __ATOMIC_RELAXED);
    return 1;
}

const char *rtx_lf_impl(void) {
    switch (lf_level()) {
    case RTX_LF_WIDE:
        return "avx2";
    case RTX_LF_SIMD:
#ifdef LF_NEON
        return "neon";
#else
        return "sse2";
#endif
    default:
        return "swar";
    }
}

static size_t lf_count_at(int lv, const unsigned char *p, size_t n) {
#ifdef LF_X86
    if (lv >= RTX_LF_WIDE) return lf_count_avx2(p, n);
    if (lv >= RTX_LF_SIMD) return lf_count_sse2(p, n);
#elif defined(LF_NEON)
    if (lv >= RTX_LF_SIMD) return lf_count_neon(p, n);
#endif
    (void)lv;
    return lf_count_swar(p, n);
}

size_t rtx_count_lf(const char *p, size_t n) {
    if (!p || !n) return 0;
    return lf_count_at(lf_level(), (const unsigned char *)p, n);
}

size_t rtx_nth_lf(const char *p, size_t n, size_t k, size_t *seen) {
    const unsigned char *u = (const unsigned char *)p;
    size_t s = 0, i = 0, r;
    int lv;
    if (!p || !k) {
        if (seen) *seen = 0;
        return LF_NONE;
    }
    lv = lf_level();
    /* Whole chunks that end short of the k-th newline: count only. */
    while (n - i > LF_CHUNK) {
        size_t c = lf_count_at(lv, u + i, LF_CHUNK);
        if (s + c >= k) break;
        s += c;
        i += LF_CHUNK;
    }
#ifdef LF_X86
    if (lv >= RTX_LF_WIDE) r = lf_nth_avx2(u + i, n - i, k, &s);
    else if (lv >= RTX_LF_SIMD) r = lf_nth_sse2(u + i, n - i, k, &s);
    else r = lf_nth_swar(u + i, n - i, k, &s);
#elif defined(LF_NEON)
    if (lv >= RTX_LF_SIMD) r = lf_nth_neon(u + i, n - i, k, &s);
    else r = lf_nth_swar(u + i, n - i, k, &s);
#else
    r = lf_nth_swar(u + i, n - i, k, &s);
#endif
    if (seen) *seen = s;
    return r == LF_NONE ? LF_NONE : i + r;
}

size_t rtx_last_lf(const char *p, size_t n) {
    const unsigned char *u = (const unsigned char *)p;
    if (!p || !n) return LF_NONE;
#ifdef LF_X86
    if (lf_level() >= RTX_LF_SIMD) return lf_last_sse2(u, n);
#elif defined(LF_NEON)
    if (lf_level() >= RTX_LF_SIMD) return lf_last_neon(u, n);
#endif
    return lf_last_swar(u, n);
}
