#!ccc cch
/*
 * Measure-generic wrap + hit-test. Width and height are abstract units
 * (pixels or cells). The frontend supplies measure/line_height.
 */
#ifndef RTX_LAYOUT_H
#define RTX_LAYOUT_H

#include "hex.cch"

/* RtxDoc + RtxDocLayout come from document.cch. */

typedef struct {
    double (*measure)(void *ctx, char[:] bytes, RtxStyle style, RtxSectionKind sec);
    double (*line_height)(void *ctx, RtxStyle style, RtxSectionKind sec);
    void *ctx;
} RtxMeasure;

/* Goal column for up/down. `eol` sticks to each line/row end (End key). */
typedef struct {
    double x;     /* measure units; wrap on */
    size_t col;   /* bytes from physical line start; wrap off */
    int ok;
    int eol;
} RtxPref;

typedef struct {
    size_t byte_start;
    size_t byte_len;
    size_t line;
    double width;
    double height;
    RtxSectionKind sec;
} RtxVisRow;

enum {
    RTX_VIEW_DEFAULT = 0,
    RTX_VIEW_WRAP = 1,
    RTX_VIEW_HEX = 2
};

typedef struct {
    CCArena store;         /* layout epoch: vis rows until width/edit reset */
    RtxVisRow *rows;
    size_t len;
    size_t cap;
    double total_height;
    size_t from_line;
    size_t nlines;
    int view;              /* RTX_VIEW_* */
    int wrap;              /* 1 iff view == RTX_VIEW_WRAP (existing call sites) */
} RtxLayout;

static void rtx_layout_set_view(RtxLayout *L, int view) {
    if (!L) return;
    if (view < RTX_VIEW_DEFAULT || view > RTX_VIEW_HEX) view = RTX_VIEW_DEFAULT;
    L->view = view;
    L->wrap = (view == RTX_VIEW_WRAP);
}

static void rtx_layout_cycle_view(RtxLayout *L) {
    if (!L) return;
    if (L->view == RTX_VIEW_DEFAULT) rtx_layout_set_view(L, RTX_VIEW_WRAP);
    else if (L->view == RTX_VIEW_WRAP) rtx_layout_set_view(L, RTX_VIEW_HEX);
    else rtx_layout_set_view(L, RTX_VIEW_DEFAULT);
}

static int rtx_layout_is_hex(const RtxLayout *L) {
    return L && L->view == RTX_VIEW_HEX;
}

static const char *rtx_layout_view_name(const RtxLayout *L) {
    if (!L) return "default";
    if (L->view == RTX_VIEW_WRAP) return "wrap";
    if (L->view == RTX_VIEW_HEX) return "hex";
    return "default";
}

static int RtxLayout_ensure(RtxLayout *L) {
    if (!L) return 0;
    if (L->store.base) return 1;
    L->store = cc_arena_heap(kilobytes(8));
    return L->store.base != NULL;
}

static void RtxLayout_reset(RtxLayout *L) {
    if (!L) return;
    if (L->store.base) L->store.reset();
    L->rows = NULL;
    L->len = 0;
    L->cap = 0;
    L->total_height = 0;
}

static void RtxLayout_destroy(RtxLayout *L) {
    if (!L) return;
    if (L->store.base) L->store.destroy();
    memset(L, 0, sizeof(*L));
}

static int rtx_layout_push(RtxLayout *L, RtxVisRow row) {
    rtx_arena_grow(&L->store, (void **)&L->rows, &L->cap, L->len + 1,
                   sizeof(RtxVisRow)) !>(e) {
        (void)e;
        return 0;
    };
    L->rows[L->len++] = row;
    L->total_height += row.height;
    return 1;
}

static RtxStyle RtxDoc_style_at(const RtxDoc *d, size_t off) {
    RtxStyle z = {0};
    size_t lo, hi, i;
    if (!d || d->run_len == 0) return z;
    lo = 0;
    hi = d->run_len;
    while (lo + 1 < hi) {
        size_t mid = lo + (hi - lo) / 2;
        if (d->runs[mid].start <= off) lo = mid;
        else hi = mid;
    }
    i = lo;
    while (i > 0 && d->runs[i - 1].start + d->runs[i - 1].len > off) i--;
    for (; i < d->run_len && d->runs[i].start <= off; i++) {
        if (off < d->runs[i].start + d->runs[i].len) {
            if (d->runs[i].style.bold) z.bold = 1;
            if (d->runs[i].style.italic) z.italic = 1;
            if (d->runs[i].style.mono) z.mono = 1;
            if (d->runs[i].style.scope != RTX_SCOPE_NONE) {
                z.scope = d->runs[i].style.scope;
            }
        }
    }
    /* Lex leftover from a CODE-to-EOF window must not paint in prose. */
    if (z.scope != RTX_SCOPE_NONE && d->section_at(off) != RTX_SEC_CODE) {
        z.scope = RTX_SCOPE_NONE;
    }
    return z;
}

static size_t RtxLayout_row_of(const RtxLayout *L, size_t off);

static int rtx_layout_is_break(char c) {
    return c == ' ' || c == '\t';
}

static int rtx_layout_push_row(RtxLayout *L, const RtxMeasure *m,
                               size_t byte_start, size_t byte_len, size_t phys,
                               double w, double h, RtxSectionKind sec) {
    RtxVisRow row;
    RtxStyle z = {0};
    row.byte_start = byte_start;
    row.byte_len = byte_len;
    row.line = phys;
    row.width = w;
    row.height = h > 0 ? h : m->line_height(m->ctx, z, sec);
    row.sec = sec;
    if (!rtx_layout_push(L, row)) {
        L->reset();
        return 0;
    }
    return 1;
}

/* Walk already-copied bytes. Heap fallback lives in RtxLayout_range. */
static void !>(CCError) rtx_layout_range_walk(RtxLayout *L, RtxDocLayout d,
                                             const RtxMeasure *m, size_t from,
                                             size_t n, double max_width, int wrap,
                                             char[:] bytes) {
    size_t i = 0;
    /* Callers set L->from_line (exact for lines(); fill_off guess is a
     * gutter label, not a camera). */
    size_t phys = L->from_line;
    while (i < n) {
        RtxSectionKind sec = d->section_at(from + i);
        size_t line_end = i;
        RtxStyle z = {0};
        while (line_end < n && bytes.ptr[line_end] != '\n') line_end++;
        if (d->fold_covers(from + i)) {
            i = line_end;
            if (i < n && bytes.ptr[i] == '\n') {
                i++;
                phys++;
            }
            continue;
        }
        if (!wrap) {
            char[:] line = bytes.sub(i, line_end);
            double w = m->measure(m->ctx, line, z, sec);
            double h = m->line_height(m->ctx, z, sec);
            if (!rtx_layout_push_row(L, m, from + i, line_end - i, phys,
                                     w, h, sec)) {
                return cc_err(CC_ERR_OUT_OF_MEMORY, "layout row");
            }
            i = line_end;
        } else {
            if (i == line_end) {
                double h = m->line_height(m->ctx, z, sec);
                if (!rtx_layout_push_row(L, m, from + i, 0, phys, 0, h, sec)) {
                    return cc_err(CC_ERR_OUT_OF_MEMORY, "layout row");
                }
            }
            while (i < line_end) {
                size_t row_start = i;
                double w = 0;
                double h = 0;
                size_t last_br = i;
                double last_br_w = 0;
                double last_br_h = 0;
                while (i < line_end) {
                    RtxUtf8Cl cl = rtx_utf8_cluster(bytes, i);
                    size_t step = cl.n ? cl.n : 1;
                    RtxStyle st = d->style_at(from + i);
                    char[:] one = bytes.sub(i, i + step);
                    double gw = m->measure(m->ctx, one, st, sec);
                    double gh = m->line_height(m->ctx, st, sec);
                    if (w > 0 && w + gw > max_width) {
                        if (last_br > row_start) {
                            i = last_br;
                            w = last_br_w;
                            h = last_br_h;
                        }
                        break;
                    }
                    w += gw;
                    if (gh > h) h = gh;
                    i += step;
                    if (step == 1 && rtx_layout_is_break(one.ptr[0])) {
                        last_br = i;
                        last_br_w = w;
                        last_br_h = h;
                    }
                }
                if (i == row_start) {
                    RtxUtf8Cl cl = rtx_utf8_cluster(bytes, i);
                    size_t step = cl.n ? cl.n : 1;
                    RtxStyle st = d->style_at(from + i);
                    char[:] one = bytes.sub(i, i + step);
                    w = m->measure(m->ctx, one, st, sec);
                    h = m->line_height(m->ctx, st, sec);
                    i += step;
                }
                if (!rtx_layout_push_row(L, m, from + row_start, i - row_start,
                                         phys, w, h, sec)) {
                    return cc_err(CC_ERR_OUT_OF_MEMORY, "layout row");
                }
            }
        }
        if (i < n && bytes.ptr[i] == '\n') {
            i++;
            phys++;
        }
    }
    return cc_ok();
}

/* Wrap [from, from+n). Off: one visual row per physical line. On: last
 * whitespace if a token fits after it, else a hard break at max_width. */
static void !>(CCError) RtxLayout_range(RtxLayout *L, RtxDocLayout d, const RtxMeasure *m,
                            size_t from, size_t n, double max_width) {
    size_t end;
    char[:] bytes;
    int wrap;
    if (!L || !d || !m || !m->measure || !m->line_height) {
        return cc_err(CC_ERR_INVALID_ARG, "layout range");
    }
    if (!L->ensure()) return cc_err(CC_ERR_OUT_OF_MEMORY, "layout store");
    wrap = L->wrap && max_width > 0;
    {
        size_t dlen = d->len();
        if (from >= dlen) return cc_ok();
        if (n > dlen - from) n = dlen - from;
        end = from + n;
    }
    if (from >= end) return cc_ok();
    n = end - from;
    if (n <= (size_t)RTX_FRAME_SCRATCH) {
        cc_arena_stack(scratch, RTX_FRAME_SCRATCH);
        bytes = d->scratch_span(&scratch, from, n) !>(e) {
            return cc_err(e);
        };
        return rtx_layout_range_walk(L, d, m, from, n, max_width, wrap, bytes);
    }
    {
        CCArena frame = cc_arena_heap(n + 64);
        if (!frame.base) return cc_err(CC_ERR_OUT_OF_MEMORY, "layout span");
        bytes = d->scratch_span(&frame, from, n) !>(e) {
            frame.destroy();
            return cc_err(e);
        };
        rtx_layout_range_walk(L, d, m, from, n, max_width, wrap, bytes) !>(e) {
            frame.destroy();
            return cc_err(e);
        };
        frame.destroy();
        return cc_ok();
    }
}

static void !>(CCError) RtxLayout_doc(RtxLayout *L, RtxDocLayout d, const RtxMeasure *m, double max_width) {
    if (!L || !L->ensure()) return cc_err(CC_ERR_OUT_OF_MEMORY, "layout store");
    L->reset();
    L->from_line = 0;
    L->nlines = d ? d->line_count() : 0;
    if (!d) return cc_ok();
    return L->range(d, m, 0, d->len(), max_width);
}

/* Layout a window of physical lines. Used so a giant file does not hang. */
static void !>(CCError) RtxLayout_lines(RtxLayout *L, RtxDocLayout d, const RtxMeasure *m,
                            double max_width, size_t from_line, size_t nlines) {
    size_t total, from, to;
    @errhandler(CCError e) {
        return cc_err(e);
    }
    @errhandler(RtxIndexErr ie) {
        return cc_err(CC_ERR_IO, ie.message ? ie.message : "line index");
    }
    if (!L || !d || !L->ensure()) return cc_err(CC_ERR_INVALID_ARG, "layout lines");
    total = d->line_count();
    if (from_line >= total) from_line = total ? total - 1 : 0;
    if (from_line + nlines > total) nlines = total - from_line;
    from = d->line_start(from_line) !>;
    if (from_line + nlines >= total) to = d->len();
    else to = d->line_start(from_line + nlines) !>;
    d->ensure_hl(rtx_hl_span(from, to)) !>;
    L->reset();
    L->from_line = from_line;
    L->nlines = nlines;
    return L->range(d, m, from, to - from, max_width);
}

/* Keep adding physical lines until at least `min_rows` visual rows exist. */
static void !>(CCError) RtxLayout_fill(RtxLayout *L, RtxDocLayout d, const RtxMeasure *m,
                           double max_width, size_t from_line, size_t min_rows) {
    size_t total;
    size_t nphys;
    size_t guard = 0;
    if (!L || !d || !m) return cc_err(CC_ERR_INVALID_ARG, "layout fill");
    total = d->line_count();
    if (min_rows == 0) min_rows = 1;
    nphys = min_rows;
    for (;;) {
        L->lines(d, m, max_width, from_line, nphys) !>(e) { return cc_err(e); };
        if (L->len >= min_rows) return cc_ok();
        if (from_line + nphys >= total) return cc_ok();
        nphys += min_rows - L->len;
        if (++guard > 24) return cc_ok();
    }
}

#define RTX_FILL_OFF_CAP (64 * 1024)

/* Layout a window starting at a byte (not a line index). Used so a
 * scrollbar seek does not scan the prefix. */
static void !>(CCError) RtxLayout_fill_off(RtxLayout *L, RtxDocLayout d, const RtxMeasure *m,
                               double max_width, size_t from, size_t min_rows) {
    char buf[512];
    size_t len;
    size_t off;
    size_t seen;
    size_t n;
    if (!L || !d || !m) return cc_err(CC_ERR_INVALID_ARG, "layout fill_off");
    if (min_rows == 0) min_rows = 1;
    len = d->len();
    if (from > len) from = len;
    off = from;
    seen = 0;
    @errhandler(CCError e) { return cc_err(e); }
    while (off < len && seen < min_rows && (off - from) < (size_t)RTX_FILL_OFF_CAP) {
        size_t take = len - off;
        size_t got, i;
        if (take > sizeof(buf)) take = sizeof(buf);
        if (take > (size_t)RTX_FILL_OFF_CAP - (off - from))
            take = (size_t)RTX_FILL_OFF_CAP - (off - from);
        got = d->read_at(off, buf, take) !>;
        if (!got) break;
        for (i = 0; i < got; i++) {
            if (buf[i] == '\n') {
                seen++;
                if (seen >= min_rows) {
                    off += i + 1;
                    got = 0;
                    break;
                }
            }
        }
        if (got) off += got;
    }
    n = off - from;
    if (n == 0 && from < len) n = 1;
    d->ensure_hl(rtx_hl_win(from, n)) !>(e) { return cc_err(e); };
    L->reset();
    /* Gutter label until seek_label; not a camera origin. */
    L->from_line = d->line_guess(from);
    L->nlines = seen ? seen : 1;
    return L->range(d, m, from, n, max_width);
}

static size_t !>(CCError) rtx_layout_hit_bytes(const RtxVisRow *r, RtxDocLayout d,
                                              const RtxMeasure *m, double x,
                                              char[:] bytes) {
    size_t k = 0;
    size_t hit = r->byte_start + r->byte_len;
    double cx = 0;
    while (k < bytes.len) {
        RtxUtf8Cl cl = rtx_utf8_cluster(bytes, k);
        size_t step = cl.n ? cl.n : 1;
        RtxStyle st = d->style_at(r->byte_start + k);
        char[:] one = bytes.sub(k, k + step);
        double gw = m->measure(m->ctx, one, st, r->sec);
        if (cx + gw / 2.0 >= x) {
            hit = r->byte_start + k;
            break;
        }
        cx += gw;
        k += step;
    }
    return cc_ok(hit);
}

static size_t !>(CCError) rtx_layout_hit_row(const RtxVisRow *r, RtxDocLayout d,
                                            const RtxMeasure *m, double x) {
    if (!r || !d || !m) return cc_ok(0);
    if (r->byte_len <= (size_t)RTX_FRAME_SCRATCH) {
        cc_arena_stack(scratch, RTX_FRAME_SCRATCH);
        char[:] bytes = d->scratch_span(&scratch, r->byte_start, r->byte_len) !>(e) {
            return cc_err(e);
        };
        {
            size_t hit = rtx_layout_hit_bytes(r, d, m, x, bytes) !>(e) {
                return cc_err(e);
            };
            return cc_ok(hit);
        }
    }
    {
        CCArena frame = cc_arena_heap(r->byte_len + 64);
        char[:] bytes;
        size_t hit;
        if (!frame.base) return cc_err(CC_ERR_OUT_OF_MEMORY, "layout span");
        bytes = d->scratch_span(&frame, r->byte_start, r->byte_len) !>(e) {
            frame.destroy();
            return cc_err(e);
        };
        hit = rtx_layout_hit_bytes(r, d, m, x, bytes) !>(e) {
            frame.destroy();
            return cc_err(e);
        };
        frame.destroy();
        return cc_ok(hit);
    }
}

static double rtx_layout_x_of_bytes(const RtxVisRow *r, RtxDocLayout d,
                                    const RtxMeasure *m, size_t off,
                                    char[:] bytes) {
    size_t k = 0;
    double x = 0;
    while (k < bytes.len && r->byte_start + k < off) {
        RtxUtf8Cl cl = rtx_utf8_cluster(bytes, k);
        size_t step = cl.n ? cl.n : 1;
        if (r->byte_start + k + step > off) break;
        {
            RtxStyle st = d->style_at(r->byte_start + k);
            char[:] one = bytes.sub(k, k + step);
            x += m->measure(m->ctx, one, st, r->sec);
        }
        k += step;
    }
    return x;
}

static double !>(CCError) RtxLayout_x_of(const RtxLayout *L, RtxDocLayout d, const RtxMeasure *m,
                             size_t off) {
    size_t i;
    const RtxVisRow *r;
    if (!L || !d || !m || L->len == 0) return cc_ok(0);
    i = L->row_of(off);
    r = &L->rows[i];
    if (off <= r->byte_start) return cc_ok(0);
    if (r->byte_len <= (size_t)RTX_FRAME_SCRATCH) {
        cc_arena_stack(scratch, RTX_FRAME_SCRATCH);
        char[:] bytes = d->scratch_span(&scratch, r->byte_start, r->byte_len) !>(e) {
            return cc_err(e);
        };
        return cc_ok(rtx_layout_x_of_bytes(r, d, m, off, bytes));
    }
    {
        CCArena frame = cc_arena_heap(r->byte_len + 64);
        char[:] bytes;
        double x;
        if (!frame.base) return cc_err(CC_ERR_OUT_OF_MEMORY, "layout span");
        bytes = d->scratch_span(&frame, r->byte_start, r->byte_len) !>(e) {
            frame.destroy();
            return cc_err(e);
        };
        x = rtx_layout_x_of_bytes(r, d, m, off, bytes);
        frame.destroy();
        return cc_ok(x);
    }
}

/* Hit-test: y is in measure units from the top of L. Returns byte offset. */
static size_t !>(CCError) RtxLayout_hit(const RtxLayout *L, RtxDocLayout d, const RtxMeasure *m,
                             double x, double y) {
    size_t i;
    double acc = 0;
    if (!L || !d || !m || L->len == 0) return cc_ok(0);
    for (i = 0; i < L->len; i++) {
        RtxVisRow *r = &L->rows[i];
        if (y < acc + r->height || i + 1 == L->len) {
            return rtx_layout_hit_row(r, d, m, x);
        }
        acc += r->height;
    }
    return cc_ok(d->len());
}

static size_t RtxLayout_rows_for_line(const RtxLayout *L, size_t phys) {
    size_t i;
    size_t n = 0;
    if (!L) return 0;
    for (i = 0; i < L->len; i++) {
        if (L->rows[i].line == phys) n++;
    }
    return n;
}

/* Visual row containing `off`. Caret on a newline sits at the end of the
 * preceding row. At a wrap boundary, prefers the later row. */
static size_t RtxLayout_row_of(const RtxLayout *L, size_t off) {
    size_t i;
    size_t at_end = (size_t)-1;
    if (!L || L->len == 0) return 0;
    for (i = 0; i < L->len; i++) {
        size_t a = L->rows[i].byte_start;
        size_t b = a + L->rows[i].byte_len;
        if (off >= a && off < b) return i;
        if (off == b) at_end = i;
    }
    if (at_end != (size_t)-1) {
        if (at_end + 1 < L->len && L->rows[at_end + 1].byte_start == off) {
            return at_end + 1;
        }
        return at_end;
    }
    if (off >= L->rows[L->len - 1].byte_start) return L->len - 1;
    return 0;
}

static void RtxLayout_move_row_edge(RtxLayout *L, RtxDoc *d, int to_end, int shift) {
    size_t i;
    size_t a, b;
    if (!L || !d || L->len == 0) return;
    i = L->row_of(d->caret);
    a = L->rows[i].byte_start;
    b = a + L->rows[i].byte_len;
    if (!shift) d->sel_anchor = to_end ? b : a;
    d->caret = to_end ? b : a;
    d->break_coalesce();
}

/* Visual-row up/down when wrap is on; physical lines when it is off.
 * `pref` keeps the goal column (or EOL) across short lines.
 * Byte camera: floor / next, never line_of. */
static void !>(CCError) RtxLayout_move_vert(RtxLayout *L, RtxDoc *d, const RtxMeasure *m,
                                double width, int dir, int shift, RtxPref *pref) {
    size_t start;
    size_t row;
    int capture;
    RtxLayout one = {0} @destroy;
    @errhandler(CCError e) {
        return cc_err(e);
    }
    @errhandler(RtxIndexErr ie) {
        return cc_err(CC_ERR_IO, ie.message ? ie.message : "line index");
    }
    if (!L || !d || !m || !pref) return cc_err(CC_ERR_INVALID_ARG, "move vert");
    if (!shift) {
        d->sel_anchor = d->caret;
        d->sel_box = 0;
    }
    start = rtx_doc_line_floor(d, d->caret) !>;
    capture = !pref->ok;
    if (capture) {
        pref->col = d->caret - start;
        pref->ok = 1;
    }
    if (!L->wrap) {
        size_t ns = start;
        size_t nend, nlen, next;
        int has;
        if (dir < 0) {
            if (start == 0) {
                if (!shift) d->sel_anchor = d->caret;
                d->break_coalesce();
                return cc_ok();
            }
            ns = rtx_doc_line_floor(d, start - 1) !>;
        } else {
            has = rtx_doc_next_line_start(d, start, &next) !>;
            if (!has) {
                if (!shift) d->sel_anchor = d->caret;
                d->break_coalesce();
                return cc_ok();
            }
            ns = next;
        }
        nend = rtx_doc_line_end_caret(d, ns) !>;
        nlen = nend - ns;
        if (pref->eol) d->caret = nend;
        else d->caret = ns + (pref->col < nlen ? pref->col : nlen);
        d->caret = d->cluster_align(d->caret) !>(e) { return cc_err(e); };
        if (d->caret < ns) d->caret = ns;
        if (d->caret > nend) d->caret = nend;
        d->caret = d->fold_snap(d->caret, dir);
        if (!shift) d->sel_anchor = d->caret;
        d->break_coalesce();
        return cc_ok();
    }
    one.wrap = 1;
    one.fill_off(d, m, width, start, 1) !>;
    if (one.len == 0) return cc_ok();
    row = one.row_of(d->caret);
    if (capture && !pref->eol) {
        double x = one.x_of(d, m, d->caret) !>;
        pref->x = x;
    }
    if (dir < 0) {
        if (row > 0) row--;
        else if (start == 0) {
            if (!shift) d->sel_anchor = d->caret;
            d->break_coalesce();
            return cc_ok();
        } else {
            size_t prev = rtx_doc_line_floor(d, start - 1) !>;
            one.reset();
            one.wrap = 1;
            one.fill_off(d, m, width, prev, 1) !>;
            row = one.len ? one.len - 1 : 0;
        }
    } else {
        if (row + 1 < one.len) row++;
        else {
            size_t next;
            int has = rtx_doc_next_line_start(d, start, &next) !>;
            if (!has) {
                if (!shift) d->sel_anchor = d->caret;
                d->break_coalesce();
                return cc_ok();
            }
            one.reset();
            one.wrap = 1;
            one.fill_off(d, m, width, next, 1) !>;
            row = 0;
        }
    }
    if (row >= one.len) row = one.len ? one.len - 1 : 0;
    if (pref->eol) {
        d->caret = one.rows[row].byte_start + one.rows[row].byte_len;
    } else {
        size_t at = rtx_layout_hit_row(&one.rows[row], d, m, pref->x) !>;
        d->caret = at;
    }
    d->caret = d->fold_snap(d->caret, dir);
    if (!shift) d->sel_anchor = d->caret;
    d->break_coalesce();
    return cc_ok();
}

/* Derived geometry: reset the layout epoch and rebuild the current window. */
static void !>(CCError) RtxLayout_after_edit(RtxLayout *L, RtxDocLayout d, const RtxMeasure *m,
                                 double max_width, size_t off) {
    size_t fl, nl;
    (void)off;
    if (!L || !d || !m) return cc_err(CC_ERR_INVALID_ARG, "layout after edit");
    fl = L->from_line;
    nl = L->nlines;
    if (nl == 0) nl = d->line_count();
    return L->lines(d, m, max_width, fl, nl);
}

static void !>(CCError) RtxLayout_view_after_edit(RtxLayout *L, RtxDoc *d, const RtxMeasure *m, double width) {
    size_t fl, nl;
    if (!d || !L || !m) return cc_err(CC_ERR_INVALID_ARG, "view after edit");
    fl = L->from_line;
    nl = L->nlines ? L->nlines : 64;
    d->reparse_edit(d->last_off, d->last_markup) !>(e) {
        return cc_err(e);
    };
    return L->lines(d, m, width, fl, nl);
}

/* Shift row.line when a seek window's from_line becomes an exact line_of. */
static void rtx_layout_reline(RtxLayout *L, size_t from_line) {
    size_t i, old;
    if (!L || L->from_line == from_line) return;
    old = L->from_line;
    L->from_line = from_line;
    for (i = 0; i < L->len; i++) {
        if (L->rows[i].line >= old)
            L->rows[i].line = from_line + (L->rows[i].line - old);
        else
            L->rows[i].line = from_line;
    }
}

@typehooks on RtxLayout {
    .destroy = RtxLayout_destroy,
};

#endif /* RTX_LAYOUT_H */
