#!ccc cch
/*
 * Measure-generic wrap + hit-test. Width and height are abstract units
 * (pixels or cells). The frontend supplies measure/line_height.
 * Face: RtxLayout_* plus view / grid helpers other TUs call.
 * Walk / push helpers stay in layout.ccs.
 */
#ifndef RTX_LAYOUT_H
#define RTX_LAYOUT_H

#include <ccc/std/prelude.cch>
#include "hex.cch"
#include "grid.cch"
#include "md_table.cch"

/* RtxDoc + RtxDocLayout come from document.cch. */

typedef struct {
    double (*measure)(void *ctx, char[:] bytes, RtxStyle style, RtxSectionKind sec);
    double (*line_height)(void *ctx, RtxStyle style, RtxSectionKind sec);
    void *ctx;
} RtxMeasure;

/* Goal column for up/down. `eol` sticks to each line/row end (End key). */
typedef struct {
    double x;     /* measure units from row start; -1 = use col */
    size_t col;   /* bytes from physical line start; grid, box, capped row */
    int ok;
    int eol;
} RtxPref;

typedef struct {
    size_t byte_start;
    size_t byte_len;
    size_t line;
    size_t wrap_i; /* grid: wrap line of this vis row; 0 otherwise */
    double width;
    double height;
    double pad;    /* Rich list: left indent / hang. 0 otherwise */
    RtxSectionKind sec;
    size_t gen;    /* unique per laid-out row; a patch keeps a kept row's (its
                    * bytes and runs did not move): paint may replay it */
} RtxVisRow;

enum {
    RTX_VIEW_DEFAULT = 0,
    RTX_VIEW_WRAP = 1,     /* legacy journal only; set_view migrates → DEFAULT + wrap */
    RTX_VIEW_HEX = 2,
    RTX_VIEW_GRID = 3
};

/* MD table records: one per header / body vis row, built by the layout
 * walk and dropped with the rows (layout epoch, on L->store). The split,
 * the trimmed spans and each cell's wrap lines from
 * rtx_layout_md_cell_wrap — the one wrap oracle, computed once per fill;
 * row height, paint, x_of, hit, caret and cell motion read it. Spans are
 * row-relative; wrap lines are relative to the trimmed cell start. */
typedef struct {
    RtxMdCell raw;         /* rtx_md_row_split cell */
    RtxMdCell trim;        /* GFM-trimmed content */
    size_t line;           /* first wrap line in md_lines */
    size_t nl;             /* wrap lines; 0 when the pane does not wrap */
} RtxMdRecCell;

typedef struct {
    size_t row;            /* vis row byte_start (sort key) */
    size_t len;            /* vis row byte_len */
    int ti;                /* table in md_tab */
    int tall;              /* most wrap lines of any cell (1 when unwrapped) */
    size_t nc;             /* split count; cells hold min(nc, RTX_MD_TABLE_COLS) */
    size_t cell;           /* first cell in md_cells */
} RtxMdRec;

/* A record to read: the fill's (cells / lines in md_cells / md_lines) or
 * one built into RtxMdRecTmp from a row edited since the fill. Cell c is
 * cells[c]; its wrap lines are lines + cells[c].line. */
typedef struct {
    const RtxMdRec *rec;
    const RtxMdRecCell *cells;
    const RtxMdCell *lines;
} RtxMdRecView;

typedef struct {
    RtxMdRec rec;
    RtxMdRecCell cells[RTX_MD_TABLE_COLS];
    RtxMdCell lines[RTX_MD_REC_LINES];
    RtxMdRecView view;     /* points into this struct: do not copy it */
} RtxMdRecTmp;

typedef struct {
    CCArena store;         /* layout epoch: vis rows until width/edit reset */
    Vec::[RtxVisRow] rows;
    double total_height;
    size_t from_line;
    size_t nlines;
    int view;              /* RTX_VIEW_DEFAULT | HEX | GRID (WRAP migrates on set) */
    int wrap;              /* soft-wrap bit; orthogonal to view (like rich). Default on.
                            * Grid cell-wraps regardless; hex ignores. */
    int wrap_char;         /* 1: break at the pane width. 0: break at the last
                            * space so a word stays whole (editor). Preview sets
                            * this — a word break leaves the rest of the row blank. */
    int rich;              /* markup lens: Source(0) / Rich(1). Per pane, not in `view`
                            * (set_view / cycle_view leave it). docs/md_view.md */
    int has_marks;         /* fill epoch: rich && doc has hinted runs; gates every hint check */
    size_t reveal_lo;      /* mark whose hints paint (caret / anchor inside); [lo, hi) */
    size_t reveal_hi;      /* set by rtx_layout_reveal before a fill; 0/0 = none */
    char grid_delim;       /* sticky; 0 = probe the next fill */
    RtxGridGeom grid;      /* fill epoch; valid when view == GRID */
    size_t grid_hdr_end;   /* first-record bytes (no NL); 0 if none */
    int grid_hdr_on;       /* 1: paint a sticky header row */
    int md_ntab;           /* fill-epoch GFM tables; Rich default/wrap only */
    int md_keep;           /* scratch: keep parent's tables across reset */
    int hl_keep;           /* scratch (motion): lex with rtx_hl_keep — never
                            * replaces or shrinks the pane's window lex */
    int md_px;             /* 1: measure units are pixels (GUI); TUI stays 0 */
    RtxMdTable md_tab[RTX_MD_TABLE_FILL];
    int md_colw[RTX_MD_TABLE_FILL][RTX_MD_TABLE_COLS];
    int md_colpx[RTX_MD_TABLE_FILL][RTX_MD_TABLE_COLS];
    Vec::[RtxMdRec] md_recs;         /* layout epoch, row order (see RtxMdRec) */
    Vec::[RtxMdRecCell] md_cells;
    Vec::[RtxMdCell] md_lines;
    int md_natw[RTX_MD_TABLE_FILL];  /* widest natural column (pre-fit): md_px vote */
    int md_natpx[RTX_MD_TABLE_FILL];
    /* Fill epoch of `lines()`: rows are exactly lines [from_line, +nlines)
     * over bytes [win_lo, win_hi) at doc edit_stamp fill_gen. Anything else
     * (fill_off, doc, a capped window) leaves fill_lined 0: no patch. */
    int fill_lined;
    size_t fill_gen;
    size_t win_lo;
    size_t win_hi;
    size_t patched;        /* stat: edits absorbed by a patch, not a refill */
} RtxLayout;

void rtx_layout_set_view(RtxLayout *L, int view);
void rtx_layout_cycle_view(RtxLayout *L);
void rtx_layout_set_wrap(RtxLayout *L, int on);
int rtx_layout_is_hex(const RtxLayout *L);
int rtx_layout_is_grid(const RtxLayout *L);
/* Vis-row Home/End / move_row_edge. True for wrap bit or grid (cell wrap). */
int rtx_layout_soft_wrap(const RtxLayout *L);
/* left_col camera. Soft-wrap and hex have none; default (unwrap) and grid do. */
int rtx_layout_uses_left(const RtxLayout *L);
const char *rtx_layout_view_name(const RtxLayout *L);

/* Rich pane. hidden_to: `off` is a hidden hint byte → the hint's end (skip to);
 * 0 when Source, no marks, content, or the mark is revealed. reveal: set the
 * reveal span from caret / anchor (union of their marks); returns 1 when it
 * changed, so the pane refills. Both are one compare when !has_marks. */
size_t rtx_layout_hidden_to(const RtxLayout *L, RtxDocLayout d, size_t off);
int rtx_layout_reveal(RtxLayout *L, RtxDocLayout d, size_t caret, size_t anchor);
/* Rich chip: dest is hidden (or a wrapped pair is not revealed). */
int rtx_layout_link_chip(const RtxLayout *L, RtxDocLayout d, size_t off);

/* Hidden list / task hint → painted stand-in (`•  `, `1. `, `[ ]`).
 * Other hidden hints stay zero width. `skip` is source bytes to advance. */
#define RTX_HINT_STANDIN_MAX 16
typedef struct {
    size_t skip;
    size_t gn;
    char g[RTX_HINT_STANDIN_MAX];
} RtxHintVis;
int rtx_layout_hint_vis(const RtxLayout *L, RtxDocLayout d, size_t off,
                        const char *row, size_t rel, size_t row_n,
                        RtxHintVis *out);
/* Forward cursor for hidden_to over one walk (a fill, a row paint):
 * hidden_to is constant between the edges of hinted / path runs and the
 * reveal span (RtxDoc_mark_edges), so a table of those edges over the
 * next couple of KiB answers each cluster with a pointer step instead of
 * three run lookups. Results equal hidden_to at every byte. Frame
 * scratch: zero it, use it within one walk (runs and reveal fixed). One
 * compare when !has_marks. */
#define RTX_HIDE_CUR_MAX 48
typedef struct {
    size_t lo, hi;          /* table covers [lo, hi) */
    size_t reveal_lo, reveal_hi;
    int ok;
    int slow;               /* edges not provable: plain hidden_to */
    int n, i;
    size_t e[RTX_HIDE_CUR_MAX]; /* e[0] = lo, ascending */
    size_t v[RTX_HIDE_CUR_MAX]; /* hidden_to on [e[k], e[k+1]) */
} RtxHideCur;
size_t rtx_layout_hidden_cur(const RtxLayout *L, RtxDocLayout d, RtxHideCur *hc,
                             size_t off);
/* hint_vis through a hide cursor (hc may be NULL). */
int rtx_layout_hint_vis_cur(const RtxLayout *L, RtxDocLayout d, RtxHideCur *hc,
                            size_t off, const char *row, size_t rel, size_t row_n,
                            RtxHintVis *out);
int rtx_hint_standin_cols(const char *g, size_t n);

/* Fill-epoch table that contains `off`, or -1. Source / grid / hex: -1. */
int rtx_layout_md_index(const RtxLayout *L, size_t off);
/* Display columns to `off` on a table vis row. -1 if this row is not a table. */
int rtx_layout_md_x_cols(const RtxLayout *L, RtxDocLayout d, const RtxVisRow *r,
                         char[:] bytes, size_t off);
/* Rich table: `|` and unpainted cell pad are not a caret landing. */
size_t rtx_layout_md_snap(const RtxLayout *L, RtxDocLayout d, size_t off,
                          int dir);
/* Trimmed content of the cell that owns `off` (a `|` belongs to the cell
 * it closes). 1 if `off` is on a header/body row. */
int rtx_layout_md_cell_span(const RtxLayout *L, RtxDocLayout d, size_t off,
                            size_t *clo, size_t *chi);
/* Next / previous cell landing on this row. Previous from the first cell
 * is the last cell of the record above (the sep row is not a record);
 * `off` at the table's first cell or past the row's last cell. */
size_t rtx_layout_md_step_cell(const RtxLayout *L, RtxDocLayout d, size_t off,
                               int dir);
/* 0-based column that owns `off`, or -1. */
int rtx_layout_md_col_at(const RtxLayout *L, RtxDocLayout d, size_t off);
/* Soft-wrap one trimmed cell into `out` (spans relative to `lo`). Uses
 * md_colpx when L->md_px, else md_colw. Paint / hit / x_of / caret share this. */
size_t rtx_layout_md_cell_wrap(const RtxLayout *L, RtxDocLayout d,
                               const RtxMeasure *m, size_t row_base,
                               char[:] bytes, size_t lo, size_t hi, int ti,
                               int col, RtxSectionKind sec, RtxMdCell *out,
                               size_t cap);
/* Wrap-line index of `off` inside its MD cell (0 if N/A). */
int rtx_layout_md_wrap_li(const RtxLayout *L, RtxDocLayout d, const RtxMeasure *m,
                          size_t off);
/* The fill's record for the table vis row that starts at `row`, or NULL.
 * Pointers live until the next fill or patch. */
const RtxMdRec *rtx_layout_md_rec(const RtxLayout *L, size_t row);
/* Record to read for table vis row `r` (`bytes` its current bytes): the
 * fill's when the rows are current for the doc (fill_gen == edit_stamp),
 * else the same oracle over `bytes` into `tmp` (a command asking between
 * an edit and after_edit). 0: not a header / body row. */
int rtx_layout_md_view(const RtxLayout *L, RtxDocLayout d, const RtxMeasure *m,
                       const RtxVisRow *r, char[:] bytes, RtxMdRecTmp *tmp,
                       RtxMdRecView *out);
/* Cell `c` of a view, or NULL past the stored split; `lines` gets its wrap
 * lines (cell->nl of them, relative to cell->trim.lo; NULL when none). */
static inline const RtxMdRecCell *rtx_md_view_cell(const RtxMdRecView *v, int c,
                                                   const RtxMdCell **lines) {
    size_t stored;
    if (lines) *lines = NULL;
    if (!v || !v->rec || c < 0) return NULL;
    stored = v->rec->nc < (size_t)RTX_MD_TABLE_COLS ? v->rec->nc
                                                     : (size_t)RTX_MD_TABLE_COLS;
    if ((size_t)c >= stored) return NULL;
    if (lines && v->cells[c].nl) *lines = v->lines + v->cells[c].line;
    return &v->cells[c];
}

int RtxLayout_ensure(RtxLayout *L);
void RtxLayout_reset(RtxLayout *L);
void RtxLayout_destroy(RtxLayout *L);
static inline void RtxLayout_clear_rows(RtxLayout *L) {
    Vec::[RtxVisRow] *rows;
    if (!L) return;
    rows = &L->rows;
    rows->clear();
    L->md_recs.clear();
    L->md_cells.clear();
    L->md_lines.clear();
    L->fill_lined = 0;
}

#define RTX_FILL_OFF_CAP RTX_GRID_REC_CAP

/* DESIGN: record break / gap is unheld. STRING face is a cell. */
int rtx_layout_grid_gap_at(RtxDocLayout d, size_t off, char delim);
/* Unheld-NL length of the record at `from`. Cap is leftover, not a silent cut. */
size_t !>(CCError) rtx_layout_grid_rec_len(RtxDocLayout d, size_t from);
int rtx_layout_grid_rec_in(const RtxLayout *L, size_t off, size_t *start,
                                 size_t *rec_n);
size_t rtx_layout_grid_rel(size_t off, size_t start, size_t rec_n);
/* Byte after this record's trailing CR/NL (next record, or dlen). */
size_t rtx_layout_grid_after_rec(RtxDocLayout d, size_t start, size_t rec_n);
/* Mid-field camera → record start: previous unheld NL. Walk is
 * RTX_MARKUP_LOOKBACK (DESIGN). `nls_back` is gutter lines, not line_of. */
size_t !>(CCError) rtx_layout_grid_cam_lo(RtxDocLayout d, size_t off,
                                                size_t *nls_back);
/* Next/prev record line. Embedded string NLs are not a step. */
size_t !>(CCError) rtx_layout_grid_next_line(RtxDocLayout d, size_t from_line);
size_t !>(CCError) rtx_layout_grid_prev_line(RtxDocLayout d, size_t from_line);
size_t !>(CCError) rtx_layout_grid_hit_row(const RtxLayout *L, const RtxVisRow *r,
                                                 RtxDocLayout d, double x);
size_t rtx_layout_grid_row_of(const RtxLayout *L, RtxDocLayout d, size_t off);

/* Wrap [from, from+n). Off: one visual row per physical line. On: last
 * whitespace if a token fits after it, else a hard break at max_width. */
void !>(CCError) RtxLayout_range(RtxLayout *L, RtxDocLayout d, const RtxMeasure *m,
                            size_t from, size_t n, double max_width);
void !>(CCError) RtxLayout_doc(RtxLayout *L, RtxDocLayout d, const RtxMeasure *m, double max_width);
void !>(CCError) RtxLayout_lines(RtxLayout *L, RtxDocLayout d, const RtxMeasure *m,
                            double max_width, size_t from_line, size_t nlines);
void !>(CCError) RtxLayout_fill(RtxLayout *L, RtxDocLayout d, const RtxMeasure *m,
                           double max_width, size_t from_line, size_t min_rows);
void !>(CCError) RtxLayout_fill_off(RtxLayout *L, RtxDocLayout d, const RtxMeasure *m,
                               double max_width, size_t from, size_t min_rows);
double !>(CCError) RtxLayout_x_of(const RtxLayout *L, RtxDocLayout d, const RtxMeasure *m,
                             size_t off);
size_t !>(CCError) RtxLayout_hit(const RtxLayout *L, RtxDocLayout d, const RtxMeasure *m,
                             double x, double y);
size_t RtxLayout_rows_for_line(const RtxLayout *L, size_t phys);
/* Caret on a newline sits at the end of the preceding row. */
size_t RtxLayout_row_of(const RtxLayout *L, size_t off);
void RtxLayout_move_row_edge(RtxLayout *L, RtxDoc *d, int to_end, int shift);
/* Visual-row up/down when wrap is on; physical lines when it is off. */
void !>(CCError) RtxLayout_move_vert(RtxLayout *L, RtxDoc *d, const RtxMeasure *m,
                                double width, int dir, int shift, RtxPref *pref);
/* `n` rows of move_vert (PageUp / PageDown) with one scratch fill — or
 * none when `L`'s own rows (laid out at `width`: `rows_ok`) hold the
 * target. Grid steps row by row. */
void !>(CCError) RtxLayout_page_vert(RtxLayout *L, RtxDoc *d, const RtxMeasure *m,
                                double width, int dir, size_t n, int shift,
                                RtxPref *pref, int rows_ok);
/*
 * Incremental relayout across the doc's edit span (DESIGN Edits: every
 * matching camera's vis rows are made current — by a patch that is exact,
 * or by a refill). Two phases because one reparse serves every camera:
 *
 *   plan  (after the edit, before reparse): window geometry from the new
 *         bytes and the old rows; snapshot of the runs / sections the rows
 *         were laid out with (already shifted by the edit).
 *   patch (after reparse): diff runs, sections, marks gate, reveal, MD
 *         tables; relay out only the edited lines plus lines whose runs,
 *         reveal or table widths changed; reuse the rest (byte / line
 *         shifted). Tables re-measure only when touched.
 *
 * `ok == 0` after either phase: the caller refills (clear rows). Width is
 * the caller's check (layout_width). Plan storage lives on `a`.
 */
typedef struct {
    int ok;
    size_t elo, eold, enew;   /* old [elo, elo+eold) is new [elo, elo+enew) */
    int after;                /* edit is past the window: identity map */
    int eof;                  /* new window runs to doc end */
    size_t from, to;          /* new window bytes */
    size_t nlines;            /* new window line count */
    size_t rlo, rhi;          /* edited lines, new bytes; rhi = line end */
    size_t pre_n;             /* old rows [0, pre_n) keep */
    size_t post_i, post_n;    /* old rows [post_i, post_i+post_n) shift */
    size_t phys_rlo;          /* line number at rlo */
    size_t region_nl;         /* newlines in new [rlo, rhi) */
    size_t tail_lo, tail_hi;  /* extra lines past the old window (join) */
    size_t snap_lo;           /* run snapshot [snap_lo, to]: window + MD lookback */
    Vec::[RtxRun] runs;       /* runs over [from, to) before reparse */
    Vec::[RtxSection] secs;   /* sections that decide section_at in [from, to) */
} RtxLayoutPatch;

void !>(CCError) rtx_layout_patch_plan(RtxLayout *L, RtxDoc *d, RtxLayoutPatch *p,
                                       CCArena a);
void !>(CCError) rtx_layout_patch(RtxLayout *L, RtxDoc *d, const RtxMeasure *m,
                                  double max_width, RtxLayoutPatch *p, CCArena a);
/* One camera: plan, reparse, patch; refill (lines) when the patch declines. */
void !>(CCError) RtxLayout_after_edit(RtxLayout *L, RtxDoc *d, const RtxMeasure *m,
                                 double max_width);
void !>(CCError) RtxLayout_view_after_edit(RtxLayout *L, RtxDoc *d, const RtxMeasure *m, double width);
/* Shift row.line when a seek window's from_line becomes an exact line_of. */
void rtx_layout_reline(RtxLayout *L, size_t from_line);

@typehooks on RtxLayout {
    .destroy = RtxLayout_destroy,
};

#endif /* RTX_LAYOUT_H */
