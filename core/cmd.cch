/*
 * Command table (owner: cmd.ccs). Plain C decls: ui_plat.c builds the
 * cctext-ui menus from it.
 *
 * One row per command: a stable id ("file.save"), a title, a category,
 * the CMD_* the hosts dispatch (or a `run` hook), default chords per host,
 * the Esc-overlay letters, and when it is enabled. Key dispatch in both
 * hosts, the help overlay, the GUI menus and the command palette all read
 * this table; nothing else lists commands.
 *
 * Adding a command: add a row to g_cmd_rows in cmd.ccs (and a CMD_* in
 * ui_cmd.cch the hosts dispatch), or, from another TU, call
 * rtx_cmd_register() with a row that carries its own `run` before the
 * keymap loads (rtx_keymap_setup). A row whose id matches a RESERVED row
 * replaces it: its chords, which keys.json may already name, go live.
 */
#ifndef RTX_CMD_H
#define RTX_CMD_H

#include <stddef.h>
#include <stdint.h>
#include "ui_cmd.cch"

/* ---- chords ------------------------------------------------------------
 * A chord is one key plus modifiers in a uint32_t. The key is a lowercase
 * ASCII byte ('a', '.', '\\', ' ') or an RTX_KEY_* past 0x100. Cmd/Super
 * folds into CTRL: both hosts treat Cmd and Ctrl as the command modifier
 * (the GUI shows it as Cmd on macOS). Text: "ctrl+shift+p", "alt+m",
 * "f1", "ctrl+pgdn", "ctrl+tab"; "cmd+" / "super+" / "mod+" = "ctrl+". */
enum {
    RTX_KEY_TAB = 0x101,
    RTX_KEY_ENTER,
    RTX_KEY_ESC,
    RTX_KEY_BACKSPACE,
    RTX_KEY_DELETE,
    RTX_KEY_INSERT,
    RTX_KEY_HOME,
    RTX_KEY_END,
    RTX_KEY_PGUP,
    RTX_KEY_PGDN,
    RTX_KEY_UP,
    RTX_KEY_DOWN,
    RTX_KEY_LEFT,
    RTX_KEY_RIGHT,
    RTX_KEY_F1 = 0x120 /* .. RTX_KEY_F1 + 11 = F12 */
};

#define RTX_CHORD_KEY_MASK 0xFFFFu
#define RTX_CHORD_CTRL 0x10000u
#define RTX_CHORD_SHIFT 0x20000u
#define RTX_CHORD_ALT 0x40000u

enum { RTX_HOST_TUI = 0, RTX_HOST_GUI = 1, RTX_HOSTS = 2 };

/* Parse one chord ("ctrl+shift+p"). 0 = not a chord. */
uint32_t rtx_chord_parse(const char *s, size_t n);
/* "Ctrl-Shift-P" (TUI / GUI off macOS) or "Shift-Cmd-P" (GUI on macOS).
 * Returns the length written. */
size_t rtx_chord_label(uint32_t chord, int host, char *dst, size_t n);
/* "ctrl+shift+p": the keys.json spelling. */
size_t rtx_chord_name(uint32_t chord, char *dst, size_t n);

/* ---- context -----------------------------------------------------------
 * Hosts fill these bits (rtx_ui_cmd_ctx in ui.cch) when they ask whether a
 * row is enabled: the palette lists enabled rows only. */
enum {
    RTX_CTX_DOC = 1u << 0,    /* the focused pane is an editor, not browse */
    RTX_CTX_BROWSE = 1u << 1, /* the focused pane is browsing */
    RTX_CTX_FIND = 1u << 2,   /* find panel open */
    RTX_CTX_REPL = 1u << 3,   /* its replace row is shown */
    RTX_CTX_TABLE = 1u << 4,  /* caret in a Markdown table */
    RTX_CTX_MARKUP = 1u << 5, /* the grammar has a markup lens (Rich) */
    RTX_CTX_SEL = 1u << 6,    /* a selection */
    RTX_CTX_SPLIT = 1u << 7,  /* two panes */
    RTX_CTX_APPLY = 1u << 8,  /* the grammar lists apply entries */
    RTX_CTX_MULTI = 1u << 9,  /* more than one buffer */
    RTX_CTX_DIRTY = 1u << 10, /* unsaved edits in this buffer */
    RTX_CTX_GUI = 1u << 11    /* cctext-ui (else the terminal) */
};

typedef struct RtxCmdCtx {
    unsigned flags; /* RTX_CTX_* */
    int host;       /* RTX_HOST_* */
    void *ws;       /* RtxWs * */
    void *ui;       /* RtxUi * */
    void *act;      /* RtxBuf * (focused) */
    void *hostp;    /* host-private */
    int changed;    /* run hook: 1 = text changed (host relayouts) */
    char status[160]; /* run hook: status-bar message ("" = none) */
} RtxCmdCtx;

/* Row flags. */
enum {
    RTX_CMDF_RESERVED = 1u << 0, /* id held for a command not built yet:
                                  * inert, "(unavailable)" in the palette */
    RTX_CMDF_HIDDEN = 1u << 1,   /* not in the palette */
    RTX_CMDF_NOHELP = 1u << 2,   /* no help-overlay line */
    RTX_CMDF_LOCAL = 1u << 3,    /* keys are a mode's own (find field, apply
                                  * menu): shown, not in the global keymap */
    RTX_CMDF_SEP = 1u << 4,      /* GUI menu: separator before this item */
    RTX_CMDF_SLOTS = 1u << 5     /* GUI menu: the apply slots follow */
};

typedef int (*RtxCmdRun)(RtxCmdCtx *c);        /* 1 = handled */
typedef int (*RtxCmdEnabled)(const RtxCmdCtx *c);

typedef struct {
    const char *id;       /* stable: "file.save", keys.json names it */
    const char *title;    /* "Save" */
    const char *cat;      /* "File": palette group, help, GUI menu */
    int cmd;              /* CMD_* the hosts dispatch; CMD_NONE with `run` */
    const char *tui;      /* default chords, space separated; a leading '^'
                           * claims the chord over older rows while this row
                           * is available (see rtx_keymap_lookup) */
    const char *gui;
    const char *letters;  /* Esc-overlay / help letters ("bo"); NULL none */
    unsigned need;        /* RTX_CTX_* all required */
    unsigned deny;        /* RTX_CTX_* none allowed */
    unsigned flags;       /* RTX_CMDF_* */
    const char *menu;     /* GUI menu ("File"); NULL = not in a menu */
    const char *notes;    /* help lines after this one ('\n' separated) */
    RtxCmdEnabled enabled; /* extra predicate; NULL = need/deny only */
    RtxCmdRun run;         /* NULL = the host dispatches `cmd` */
} RtxCmdDef;

enum { RTX_CMD_MAX = 192 };

size_t rtx_cmd_n(void);
const RtxCmdDef *rtx_cmd_at(size_t i);
/* Index of the live row for id (a real row beats a RESERVED one), or -1. */
int rtx_cmd_find(const char *id);
/* First row dispatching CMD_* `cmd`, or -1. */
int rtx_cmd_of(int cmd);
/* Add a row (copied; strings must outlive the process). A RESERVED row
 * with the same id stays but is shadowed. -1 = table full / bad row. */
int rtx_cmd_register(const RtxCmdDef *d);
/* Not RESERVED and has something to run. */
int rtx_cmd_available(const RtxCmdDef *d);
/* Available and need / deny / enabled hold for ctx (NULL ctx: available). */
int rtx_cmd_enabled(const RtxCmdDef *d, const RtxCmdCtx *ctx);
/* Esc-overlay letter → CMD_* (table driven). CMD_NONE if unbound. */
int rtx_cmd_letter(int c);
/* Row for an Esc-overlay letter, or -1. */
int rtx_cmd_letter_row(int c);

/* Recently run (palette puts these first). Newest first. */
void rtx_cmd_note_run(int row);
size_t rtx_cmd_recent(int *rows, size_t cap);
void rtx_cmd_recent_clear(void);

/* Menus for ui_plat.c: rows with menu == name, in table order. */
size_t rtx_cmd_menu_rows(const char *menu, int *rows, size_t cap);

#endif /* RTX_CMD_H */
