#!ccc cch
/*
 * Workbook W0 (docs/workbook.md): a `*.wb.md` Markdown file of named
 * tables (a `Table: Name` caption over a GFM table), `params` / `calc`
 * fences, and formulas that name tables, columns, rows and scalars —
 * never A1 cells. Owner: wb.ccs (links with the document TU).
 *
 * Bytes are truth. The parsed workbook (names, typed columns, formula
 * ASTs, the dependency graph) and every value are derived state on the
 * document's `derived` hook: rebuilt from a whole-workbook parse (capped
 * at RTX_WB_MAX) when the structure changes, and patched from the edit
 * delta otherwise — a keystroke in a cell, a calc line or prose re-reads
 * that cell / line, re-binds at most that one formula, and recalcs only
 * its dependents in topological order with early cutoff. Tarjan SCC at
 * bind makes every cycle member `#cycle(path)`. No volatile functions.
 *
 * The Rich lens paints a formula's value in place of its bytes (the
 * md_view "Derived value" child); the formula is revealed on entry.
 */
#ifndef RTX_WB_H
#define RTX_WB_H

#include <stddef.h>
#include <stdint.h>
#include "document.cch"

#define RTX_WB_MAX (8u << 20)        /* whole-workbook parse cap (bytes) */
#define RTX_WB_ROWS_MAX 10000        /* embedded table rows (W1 indexes more) */
#define RTX_WB_COLS_MAX 16            /* = RTX_MD_TABLE_COLS: the lens caps a GFM table */
#define RTX_WB_CHANGED_MAX 256       /* value spans one recalc reports */
#define RTX_WB_VAL_MAX 48            /* painted value text (bytes, NUL incl) */

typedef struct RtxWb RtxWb;

/* `*.wb.md` (case-sensitive suffix). */
int rtx_wb_path(const char *path, size_t n);
/* Parse, bind and calc `d`; install the derived hook. NULL when `d` is
 * NULL, already a workbook, or out of memory. */
RtxWb *rtx_wb_attach(RtxDoc *d);
/* The document's workbook, or NULL. */
RtxWb *rtx_wb_of(const RtxDoc *d);
/* Apply edits noted since the last sync (lazy: every query syncs). */
void rtx_wb_sync(RtxWb *wb, const RtxDoc *d);
/* Reparse, rebind and recalc everything now (palette: Recalculate). */
void rtx_wb_recalc_all(RtxWb *wb, const RtxDoc *d);

typedef struct {
    size_t tables, names, cells, formulas, nodes, edges, cycles, errors;
    size_t rebuilds;     /* whole-workbook parses (attach counts one) */
    size_t fast_cell;    /* syncs served by a cell re-read */
    size_t fast_line;    /* ... by a calc / params line re-read */
    size_t fast_prose;   /* ... by an offset shift (edit outside blocks) */
    size_t regraphs;     /* dependency graph rebuilds (Tarjan + order) */
    size_t visited;      /* nodes the last recalc evaluated */
    size_t visited_total;
    size_t last_us;      /* last sync, microseconds */
    int off;             /* 1: over RTX_WB_MAX, values off */
} RtxWbStats;
void rtx_wb_stats(RtxWb *wb, const RtxDoc *d, RtxWbStats *out);

/* Evaluate `expr` in the workbook (calc scope of the first sheet, no row)
 * and format it (errors as `#code(message)`). Returns 1 unless the
 * workbook is off. */
int rtx_wb_eval(RtxWb *wb, const RtxDoc *d, const char *expr, size_t n,
                char *out, size_t cap);
/* Every cell of every table, then every name, one per line:
 * `Table.col[row] = value` / `name = value` (`Sheet.name` off the first
 * sheet). Returns bytes written (NUL kept; output is clipped at cap). */
size_t rtx_wb_dump(RtxWb *wb, const RtxDoc *d, char *out, size_t cap);
/* The node at `off` (a cell or a name line) plus everything that reads
 * it, transitively: the most a recalc after an edit there may visit.
 * 0 when `off` is on no node. */
size_t rtx_wb_reach(RtxWb *wb, const RtxDoc *d, size_t off);
/* Status text for the caret: the cell / name there, its value or error
 * message. 0 when `off` is on no workbook element. */
int rtx_wb_describe(RtxWb *wb, const RtxDoc *d, size_t off, char *out,
                    size_t cap);
/* The table / column / name at `off` (a definition or a reference inside
 * a formula) — the rename target — as its current name. 0 if none. */
int rtx_wb_rename_target(RtxWb *wb, const RtxDoc *d, size_t off, char *out,
                         size_t cap);
/* Rename the target at `off` to `name` across the workbook: the
 * definition and every reference, one edit group (one undo step). A name
 * that is taken, not a name, or would change any value is refused with
 * `msg`, and nothing is edited. Returns sites written, 0 on refusal. */
size_t !>(CCError) rtx_wb_rename(RtxDoc *d, size_t off, const char *name,
                                 size_t n, char *msg, size_t msgn);

#endif /* RTX_WB_H */
